// @run: true
/// @synth
/// <reference lib="es2015" />

declare const console: { log(...args: any[]): void }

const log: string[] = []

function lifo(): number {
    log.push('lifo')
    defer log.push('a')
    defer log.push('b')
    return 1
}

function beforeDefer(early: boolean): number {
    if (early) return 0
    defer log.push('late')
    return 2
}

function returnValueFirst(): number {
    let x = 3
    defer x = 100
    return x
}

function nested(flag: boolean): number {
    defer log.push('outer')
    {
        defer log.push('inner')
        if (flag) return 4
        log.push('inner-end')
    }
    return 5
}

function shadowed(): number {
    const name = 'outer'
    defer log.push(name)
    {
        const name = 'inner'
        log.push(name)
        return 6
    }
}

function blockPayload(): number {
    defer {
        log.push('block-1')
        log.push('block-2')
    }
    return 8
}

function fallThrough(): void {
    defer log.push('fell')
    log.push('body')
}

function loop(): void {
    for (let i = 0; i < 2; i++) {
        defer log.push(`iter${i}`)
        log.push(`body${i}`)
    }
}

function innerFunction(): number {
    defer log.push('outer-fn')
    const f = () => { return 9 }
    return f()
}

const results = [lifo(), beforeDefer(true), beforeDefer(false), returnValueFirst(), nested(true), nested(false), shadowed(), blockPayload(), innerFunction()]
fallThrough()
loop()
function equal(actual: any, expected: any) {
    if (JSON.stringify(actual) !== JSON.stringify(expected)) {
        throw new Error(`expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`)
    }
}

equal(results, [1, 0, 2, 3, 4, 5, 6, 8, 9])
equal(log, ['lifo', 'b', 'a', 'late', 'inner', 'outer', 'inner-end', 'inner', 'outer', 'inner', 'outer', 'block-1', 'block-2', 'outer-fn', 'body', 'fell', 'body0', 'iter0', 'body1', 'iter1'])
log.length = 0

function temporaryNames() {
    const __dret = 17
    const __dret0 = 18
    defer log.push(`${__dret}:${__dret0}`)
    return __dret + __dret0
}
equal(temporaryNames(), 35)
equal(log, ['17:18'])
log.length = 0

function conditional(flag: boolean) {
    defer log.push('always')
    if (flag) defer log.push('conditional')
    return 19
}
equal(conditional(false), 19)
equal(conditional(true), 19)
equal(log, ['always', 'conditional', 'always'])
log.length = 0

function nestedConditional(flag: boolean) {
    defer log.push('outer')
    {
        if (flag) defer log.push('conditional')
    }
    return 20
}
equal(nestedConditional(false), 20)
equal(nestedConditional(true), 20)
equal(log, ['outer', 'conditional', 'outer'])
log.length = 0

function deferredReturn() {
    defer log.push('outer')
    defer {
        log.push('inner')
        return
    }
    return 21
}
equal(deferredReturn(), 21)
equal(log, ['inner', 'outer'])
log.length = 0

function deferredVar() {
    var value = 22
    defer {
        var value = 100
        log.push(`${value}`)
    }
    return value
}
equal(deferredVar(), 22)
equal(log, ['100'])
log.length = 0

function deferredFunction() {
    defer {
        const f = () => { return 'nested-function' }
        log.push(f())
    }
    return 23
}
equal(deferredFunction(), 23)
equal(log, ['nested-function'])
log.length = 0

function shadowedCatch() {
    const name = 'outer'
    defer log.push(name)
    try {
        throw 'inner'
    } catch (name: any) {
        log.push(name.message)
        return 24
    }
}
equal(shadowedCatch(), 24)
equal(log, ['inner', 'outer'])
log.length = 0

function mixedFinally() {
    defer finally { log.push('finally') }
    defer log.push('plain')
    {
        defer log.push('inner')
        return 25
    }
}
equal(mixedFinally(), 25)
equal(log, ['inner', 'plain', 'finally'])
log.length = 0

function ordinaryThrow() {
    defer log.push('unreached')
    throw new Error('ordinary')
}
function finallyThrow() {
    defer finally { log.push('finally') }
    throw new Error('finally')
}
try { ordinaryThrow() } catch (e) {}
try { finallyThrow() } catch (e) {}
equal(log, ['finally'])
log.length = 0

function shadowedEnum() {
    const value = 26
    defer log.push(`${value}`)
    {
        enum value { inner = 1 }
        return value.inner
    }
}
equal(shadowedEnum(), 1)
equal(log, ['26'])
log.length = 0

function overriddenReturn() {
    defer log.push('once')
    try {
        return 27
    } finally {
        return 28
    }
}
equal(overriddenReturn(), 28)
equal(log, ['once'])
log.length = 0

function caughtCleanup() {
    let attempts = 0
    defer {
        log.push('cleanup')
        if (++attempts === 1) throw new Error('cleanup')
    }
    try {
        return 29
    } catch (e) {
        log.push('caught')
        return 30
    }
}
equal(caughtCleanup(), 30)
equal(log, ['cleanup', 'caught'])
log.length = 0

function deferredEval() {
    const label = 'outer'
    defer eval("log.push(label)")
    {
        const label = 'inner'
        return 31
    }
}
equal(deferredEval(), 31)
equal(log, ['outer'])
log.length = 0

function deferredDeclaration() {
    var value = () => 'outer'
    defer {
        function value() { return 'inner' }
        log.push(value())
    }
    return () => value()
}
equal(deferredDeclaration()(), 'outer')
equal(log, ['inner'])
