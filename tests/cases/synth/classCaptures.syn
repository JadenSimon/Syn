let outer = 5
const e = 1
class Z {
    z = 1
    e = e
    getFn() {
        outer = 6
        const f = () => this.z
        return f
    }
    getFn2() {
        return function (this: any) {
            console.log(outer)
            return this
        }
    }
    static getFn2() {
        return function (this: any) {
            console.log(outer)
            return this
        }
    }
    [getValSym]() {
        return outer
    }
    static [getValSym]() {
        return outer
    }
    get x() {
        return this.e
    }
}
