/// @synth
/// <reference lib="es2015" />

function it(name: string, fn: () => void) {}
function expectEqual(actual: unknown, expected: any, message?: string) {}

class A {
    foo() { return 'foo' }
}

it('constructor', () => {
    expectEqual(new A().foo(), 'foo')
})

const B = class {
    foo() { return 'foo' }
}

it('anonymous class', () => {
    expectEqual(new B().foo(), 'foo')
})

const foo = new B().foo
it('anonymous class (method)', () => {
    expectEqual(foo(), 'foo')
})

const getValSym = Symbol.for('getVal')

