{
    const suffix = '!'

    class D {
        constructor(public readonly val: string) {}
        
        getVal() {
            return `${this.val}${suffix}`
        }
    }

    const d = new D('bar4')
    const getVal4 = d.getVal
    it('methods (captured)', () => {
        expectEqual(getVal4.call({ val: 'bar4' }), 'bar4!')
    })

    class E {
        constructor(public readonly val: string) {}
        
        getVal(count: number) {
            return `${this.val}${suffix}`.repeat(count)
        }
    }

    const e = new E('bar5')
    const getVal5 = e.getVal
    it('methods (captured with args)', () => {
        expectEqual(getVal5.call({ val: 'bar5' }, 2), 'bar5!bar5!')
    })
}

{
    const y = 2
    class F {
        static readonly x = 1
        static foo() {
            return this.x + y
        }
    }
    
    it('static methods', () => {
        expectEqual(F.foo(), 3)
    })
}

{
    class X {
        #foo = 1

        static m() {
            const x = new this()
            x.#foo = 2

            return x
        }

        m() {
            return this.#foo
        }

        m2() {
            return this.#foo.toString()
        }

        #privateMethod() {
            return this.#foo + 1
        }

        plusOne() {
            return this.#privateMethod()
        }
    }

    const x = new X()
    it('private members', () => {
        expectEqual(x.m(), 1)
    })

    it('private members (nested)', () => {
        expectEqual(x.m2(), '1')
    })

    it('private method', () => {
        expectEqual(x.plusOne(), 2)
    })
}

