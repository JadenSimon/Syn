if (!(callArg as any)[key] || !(newArg as any)[key] || !(arrayElement as any)[key]
    || !(propertyValue as any)[key] || !(shorthand as any)[key] || !(assigned as any)[key]
    || !(array[1] as any)[key] || !(object.inline as any)[key]) {
