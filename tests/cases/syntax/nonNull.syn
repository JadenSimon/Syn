// @run: true
"use wrapped";

function assert(a: any, b: any) {
    if (a !== b) {
        throw new Error(`${a} !== ${b}`)
    }
}

function message(fn: () => any): string {
    try {
        fn()
    } catch (e) {
        return e instanceof TypeError ? e.message : 'wrong error'
    }
    return 'no error'
}

class Box {
    value!: number
}

const m = new Map<string, { x: number }>([['a', { x: 1 }]])

function direct(k: string) {
    const v = m.get(k)!
    return v.x
}

function nested(k: string) {
    return m.get(k)!.x
}

let late!: number
late = 0
const zero: number | undefined = late
const box = new Box()
box.value = 2

assert(zero!, 0)
assert(box.value!, 2)
assert(direct('a'), 1)
assert(nested('a'), 1)
assert(message(() => direct('b')), 'm.get(k) was nullish')
assert(message(() => nested('b')), 'm.get(k) was nullish')
assert(message(() => m.get("q\"")!), 'm.get("q\\"") was nullish')
