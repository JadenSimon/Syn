// @run: true
/// <reference lib="machine" />
// <reference lib="reify" /> // FIXME: can't load this due to index signature in class decl, parser fails

function assert(cond: boolean) {
    if (!cond) throw "Assertion failed"
} 

interface MyStruct {
    a: u32
    b: i32
}

assert((reify MyStruct)['a'] === reify u32)
assert((reify MyStruct)['b'] === reify i32)

assert((reify MyStruct)['a'] as unknown !== reify i32)

interface MyStruct2 {
    a: u32
    b: MyStruct[]
    c: [MyStruct, i8]
}

const structInfo = reify MyStruct2
assert(Type.isArrayType(structInfo.b))
assert(structInfo.c[0] === reify MyStruct)