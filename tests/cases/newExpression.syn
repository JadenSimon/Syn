/// <reference lib="es2015" />

interface Span {
    readonly start: number
}

export function getSpan() {
    const m = new Map<string, Span>()

    return m.get('aaa')
}

export function getAllSpans() {
    const m = new Map<string, Span>()

    return [...m.values()]
}

export function getSortedSpans() {
    return getAllSpans().sort((a, b) => a.start - b.start)
}

interface Class {
    new (a: string): number
    new (a: number): string
    (a: string): void
    new <T>(a: boolean, b: T): { w: T }
}

declare var x: Class

export function f1() {
    return new x('a')
}

export function f2() {
    return new x(true, { a: 1 })
}

interface Class2 {
    new (a: string): boolean
}

declare var x2: Class | Class2

export function f3() {
    return new x2('a')
}

interface Class3 {
    new (a: string, b: string): string
}

// intersections effectively add more overloads
declare var x3: Class & Class3

export function f4() {
    return new x3('a', 'b')
}
