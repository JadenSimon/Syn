/// <reference lib="jsx" />
/// <reference lib="es2015" />

<#component TextBoxList() {
  const items: Element[] = []
}>
  <ul @ list>
    {...items}
    <input
      type="button"
      value="Add an item"
      on:click() {        
        const item = <li>
          <input
            type="text"
            placeholder="change me!"
          />
        </li>

        update list {
          items.push(item)
        }
      }
    />
  </ul>
</>

document.body.append(
  <div>
    <p>
      Existing inputs are never recreated because the code doesn't say to do that
    </p>
    <TextBoxList />
  </div>
)


<#component PeopleEditor() {
  interface Person {
    first: string
    last: string
    id?: number
    element?: HTMLOptionElement
  }

  const people: Person[] = [
    { first: 'Hans', last: 'Emil' },
    { first: 'Max', last: 'Mustermann' },
    { first: 'Roman', last: 'Tisch' }
  ]

  let ids = 0
  for (let i = 0; i < people.length; i++) {
    people[i].id = ids++
  }

  let selected: Person | undefined

  let prefix = ''
}>
  <input
    placeholder="filter prefix"
    value={prefix}
    on:input() {
      update root {
        prefix = this.value
      }
    }
  />

  <div .layout @ root>
    <#run>
      const filtered = prefix
        ? people.filter(p => {
            const name = `${p.last}, ${p.first}`.toLowerCase()
            return name.startsWith(prefix.toLowerCase())
          })
        : people
    </>

    <select
      size=5
      on:change() {
        // value={selected?.id}

        const n = Number(this.value)
        const p = people.find(x => x.id === n)
        update form {
          selected = p
        }
      }
    >
      <#run>
        for (const p of filtered) {
          if (const el = p.element) update el
        }
      </>
      {...filtered.map(p => p.element ??= (
        <option value={p.id}>
          {p.last}, {p.first}
        </option>
      ))}
    </select>

    <div @ form>
      <#run>
        let first = selected?.first ?? ''
        let last = selected?.last ?? ''

        const isSelectedMounted = !!selected?.element?.parentElement
      </>
      <label>
        <input
          value={first}
          placeholder="first"
          on:input={ev => {
            update buttons {
              first = ev.currentTarget.value
            }
          }}
        />
      </label>

      <label>
        <input
          value={last}
          placeholder="last"
          on:input={ev => {
            update buttons {
              last = ev.currentTarget.value
            }
          }}
        />
      </label>

      <div .buttons @ buttons>
        <button
          disabled={!first || !last}
          on:click={() => {
            update root {
              const id = ids++
              people.push(selected = { first, last, id })
            }
          }}
        >
          create
        </button>

        <button
          disabled={!first || !last || !isSelectedMounted}
          on:click={() => {
            if (!selected?.element) return
            update selected.element {
              selected.first = first
              selected.last = last
            }
          }}
        >
          update
        </button>

        <button
          disabled={!isSelectedMounted}
          on:click={() => {
            if (!selected) return
            const idx = people.indexOf(selected)
            if (idx === -1) {
              update root {
                selected = undefined
              }
              return
            }

            update root {
              people.splice(idx, 1)
              const el = selected.element
              selected = undefined
              if (const prev = el?.previousElementSibling) {
                selected = people.find(x => x.element === prev)
                if (selected) return
                if (const fallback = prev.parentElement?.firstElementChild) {
                  selected = people.find(x => x.element === fallback)
                }
              }
            }
          }}
        >
          delete
        </button>
      </div>
    </div>
  </div>

  <#style>
    .layout {}

    input {
      display: block;
      margin: 0 0 0.5em 0;
    }

    select {
      float: left;
      margin: 0 1em 1em 0;
      width: 14em;
    }

    .buttons {
      clear: both;
    }
  </>
</>


//     <p>Every time you add a new text box to the list, we "re-render" the whole list, but any text entered in the text boxes is left untouched because React is smart enough to just append the new text box instead of blowing away the old DOM nodes.</p>
