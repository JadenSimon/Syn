/// <reference lib="jsx" />

function spreadMapped() {
    let currentSubNav: any
    const subnav: any[] = []
    return <div>
        {...subnav.map(s => <a href={s.href} on:click() {
            if (currentSubNav) currentSubNav.classList.remove('cur', 'jumped-to')
            currentSubNav = this
            this.classList.add('cur', 'jumped-to')
        }>{s.label}</a>)}
    </div>
}