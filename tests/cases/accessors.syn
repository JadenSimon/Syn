interface A {
    get x1(): string

    // testing various permutations of ordering

    set x2(value: number)
    get x2()

    set x3(value)
    get x3(): 1

    get x4(): 2
    set x4(value)

    get x5()
    set x5(value: 3)

    get x6(): 4
    set x6(value: 4)

    // accessors can have different types, which must be chosen based on ctx for type checking
    get x7(): 5
    set x7(value: '6')

    // intervening decl
    get x8()
    _x8: number
    set x8(value: 7)
}

declare const a: A
export const f1 = () => a.x1
export const f2 = () => a.x2
export const f3 = () => a.x3
export const f4 = () => a.x4
export const f5 = () => a.x5
export const f6 = () => a.x6
// export const f7 = () => (a.x7 = '6', a.x7)
export const f8 = () => a.x8


