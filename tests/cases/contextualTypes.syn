/// <reference lib="es2015" />

type Len = (a: string) => number
interface Foo1 {
    bar: (a: string) => number
    tuple: [{ f: Len }]
    array: { f: Len }[]
}
const o1: Foo1 = {
    bar: a => a.length,
    tuple: [{ f: a => a.length }],
    array: [{ f: a => a.length }],
}

type Q1 = { kind: 1, f: Len }
type Q2 = { kind: 2, f: (a: number) => string }
type Q = Q1 | Q2
const o2: Q = {
    kind: 1,
    f: a => a.length,
}
const o3: Q = {
    kind: 2,
    f: a => a.toFixed(1),
}
