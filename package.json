{
    "name": "syn-typescript",
    "version": "0.0.1",
    "exports": "./src/typescript.ts",
    "devDependencies": {
        "typescript": "5.9.3"
    },
    "scripts": {
        "build": "\"$npm_node_execpath\" --disable-warning=ExperimentalWarning src/build.mts",
        "engine": "\"$npm_node_execpath\" --experimental-vm-modules --disable-warning=ExperimentalWarning out/testRunner.js --engine",
        "package": "npm run build && synapse compile && synapse publish --archive out/package.tgz --include out/lib"
    },
    "synapse": {
        "devTools": {
            "zig": "0.13.0"
        }
    }
}