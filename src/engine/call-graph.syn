/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import type { Graph, GraphNode } from './lowering2'
import type { FastTraced } from './fast-trace'
import { NodeOp, NodeFlags, countIds, getBlock, getNode, getRef, isThisParam, nodeUsers, allNodes, nodeEntries, nodeIds } from './graph-node'

export const Kinds = { int: 1, double: 2, string: 4, boolean: 8, undefined: 16, null: 32, object: 64, function: 128 }
export const anyKinds = 255

export type Layout = string[]

export interface Host {
    trace(fn: Function): FastTraced | undefined
    unit(cell: number): Function | undefined
    bound(fn: Function, count: number): Function | undefined
    direct(traced: FastTraced, n: GraphNode): Function | undefined
    symbol(fn: Function): number
    signature(fn: Function): Signature | undefined
    version(name: string): number
    units(from: number): [fn: Function, traced: FastTraced | undefined][]
    reach(found: (fn: Function) => void): (graph: Graph) => void
}

export interface Signature {
    params: number
    rest: boolean
}

export interface CallGraph<T> {
    order: T[]
    component: Map<T, number>
    callees: Map<T, Map<number, T>>
    callers: Map<T, [caller: T, call: number][]>
    edges: number
}

export interface ParamContract {
    kind: number
    layout: Layout | undefined
    rep: number
    proto: number
}

export interface Contract {
    unit: Function
    params: ParamContract[]
    ret: number
    retProto: number
    returnsInt: boolean
}

export interface Version {
    symbol: number
    name: string
    contract: Contract
    used: boolean
}

export interface Program {
    host: Host
    calls: CallGraph<Function>
    uses: Map<Function, boolean>
    versions: Map<string, Version>
    bySymbol: Map<number, Version>
    pending: Version[]
    stats: Map<string, number>
}

export function count(p: Program, key: string, by = 1): void {
    if (!by) return
    p.stats.set(key, (p.stats.get(key) ?? 0) + by)
}

export function usesCallee(p: Program, fn: Function): boolean {
    const known = p.uses.get(fn)
    if (known !== undefined) return known
    let uses = true
    const traced = p.host.trace(fn)
    if (traced) {
        uses = false
        for (const n of allNodes(traced.graph)) {
            if (n.op === NodeOp.callContext) uses = true
        }
    }
    p.uses.set(fn, uses)
    return uses
}

export function calleeOf(p: Program, traced: FastTraced, n: GraphNode): Function | undefined {
    if (n.op !== NodeOp.call || (n.flags & NodeFlags.spread)) return
    const unit = p.host.direct(traced, n)
    if (!unit) return
    const bound = p.host.bound(unit, countIds(n) - 3)
    if (bound !== undefined && bound !== unit) return
    const signature = p.host.signature(unit)
    if (!signature || signature.rest) return
    return unit
}

export function createProgram(host: Host, roots: Function[]): Program {
    const p: Program = { host, calls: undefined!, uses: new Map(), versions: new Map(), bySymbol: new Map(), pending: [], stats: new Map() }
    const created: Function[] = []
    const reach = host.reach(fn => created.push(fn))
    const calleesOf = (fn: Function): [number, Function][] => {
        const traced = host.trace(fn)
        if (!traced) return []
        reach(traced.graph)
        const out: [number, Function][] = []
        for (const [id, n] of nodeEntries(traced.graph)) {
            const callee = calleeOf(p, traced, n)
            if (callee) out.push([id, callee])
        }
        return out
    }
    p.calls = buildCallGraph<Function>(roots, calleesOf)
    const reached = new Set(p.calls.order)
    while (created.length) {
        const fn = created.pop()!
        if (reached.has(fn)) continue
        reached.add(fn)
        for (const [, callee] of calleesOf(fn)) created.push(callee)
    }
    return p
}

export function buildCallGraph<T>(roots: T[], calleesOf: (unit: T) => [call: number, callee: T][]): CallGraph<T> {
    const callees = new Map<T, Map<number, T>>()
    const callers = new Map<T, [caller: T, call: number][]>()
    const index = new Map<T, number>()
    const low = new Map<T, number>()
    const onStack = new Set<T>()
    const stack: T[] = []
    const order: T[] = []
    const component = new Map<T, number>()
    let edges = 0
    let next = 0
    let components = 0
    function edgesOf(unit: T): T[] {
        const out = new Map<number, T>()
        for (const [call, callee] of calleesOf(unit)) {
            out.set(call, callee)
            let list = callers.get(callee)
            if (!list) callers.set(callee, list = [])
            list.push([unit, call])
            edges++
        }
        callees.set(unit, out)
        return [...new Set(out.values())]
    }
    function enter(unit: T, frames: [unit: T, targets: T[], at: number][]): void {
        index.set(unit, next)
        low.set(unit, next)
        next++
        stack.push(unit)
        onStack.add(unit)
        frames.push([unit, edgesOf(unit), 0])
    }
    for (const root of roots) {
        if (index.has(root)) continue
        const frames: [unit: T, targets: T[], at: number][] = []
        enter(root, frames)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            const [unit, targets] = frame
            if (frame[2] < targets.length) {
                const target = targets[frame[2]]
                frame[2]++
                if (!index.has(target)) {
                    enter(target, frames)
                    continue
                }
                if (onStack.has(target)) low.set(unit, Math.min(low.get(unit)!, index.get(target)!))
                continue
            }
            frames.pop()
            if (frames.length) {
                const parent = frames[frames.length - 1][0]
                low.set(parent, Math.min(low.get(parent)!, low.get(unit)!))
            }
            if (low.get(unit) !== index.get(unit)) continue
            let member: T
            do {
                member = stack.pop()!
                onStack.delete(member)
                component.set(member, components)
                order.push(member)
            } while (member !== unit)
            components++
        }
    }
    return { order, component, callees, callers, edges }
}

export function calleesFirst<T, F>(graph: CallGraph<T>, summarize: (unit: T, outer: (call: number) => F | undefined) => F): Map<T, F> {
    const facts = new Map<T, F>()
    for (const unit of graph.order) {
        const callees = graph.callees.get(unit)
        const component = graph.component.get(unit)
        facts.set(unit, summarize(unit, call => {
            const callee = callees?.get(call)
            if (callee === undefined || graph.component.get(callee) === component) return
            return facts.get(callee)
        }))
    }
    return facts
}

export function callersFirst<T, V>(graph: CallGraph<T>, params: (unit: T) => number, argsOf: (unit: T, agreed: (V | undefined)[]) => ((call: number, index: number) => V | undefined) | undefined, join: (a: V, b: V) => V | undefined): Map<T, (V | undefined)[]> {
    const votes = new Map<T, (V | null | undefined)[]>()
    const agreed = new Map<T, (V | undefined)[]>()
    const visited = new Set<T>()
    for (let u = graph.order.length - 1; u >= 0; u--) {
        const unit = graph.order[u]
        visited.add(unit)
        const list = votes.get(unit) ?? []
        const own: (V | undefined)[] = []
        for (let i = 0; i < params(unit); i++) own.push(list[i] ?? undefined)
        agreed.set(unit, own)
        const argOf = argsOf(unit, own)
        if (!argOf) continue
        for (const [call, callee] of graph.callees.get(unit) ?? []) {
            if (visited.has(callee)) continue
            let into = votes.get(callee)
            if (!into) votes.set(callee, into = [])
            for (let k = 0; k < params(callee); k++) {
                const before = into[k]
                if (before === null) continue
                const have = argOf(call, k)
                if (have === undefined) {
                    into[k] = null
                    continue
                }
                if (before === undefined) {
                    into[k] = have
                    continue
                }
                into[k] = join(before, have) ?? null
            }
        }
    }
    return agreed
}

export function emptyParam(): ParamContract {
    return { kind: anyKinds, layout: undefined, rep: 0, proto: 0 }
}

export function baseContract(p: Program, unit: Function): Contract {
    const params: ParamContract[] = [emptyParam()]
    const count = p.host.signature(unit)?.params ?? 0
    for (let i = 0; i < count; i++) params.push(emptyParam())
    return { unit, params, ret: 0, retProto: 0, returnsInt: false }
}

export function copyContract(c: Contract): Contract {
    return { ...c, params: c.params.map(p => ({ ...p })) }
}

function repTag(p: ParamContract): string {
    if (p.rep) return p.rep === intrinsics.Types.i64 ? 'I' : 'F'
    if (p.layout) return 'o'
    if (p.kind === Kinds.int) return 'i'
    return '_'
}

export function versionOf(p: Program, c: Contract): Version {
    const parts: string[] = []
    for (const p of c.params) parts.push(`${p.kind}:${p.layout?.join('.') ?? ''}:${p.rep}:${p.proto}`)
    const key = `${p.host.symbol(c.unit)}#${parts.join('|')}>${c.ret}:${c.retProto}:${c.returnsInt ? 1 : 0}`
    const known = p.versions.get(key)
    if (known) return known
    const ret = c.returnsInt ? 'i' : c.ret ? (c.ret === intrinsics.Types.i64 ? 'I' : 'F') : ''
    const name = `${c.unit.name || 'anonymous'}/${c.params.map(repTag).join('')}${ret}`
    const v: Version = { symbol: p.host.version(name), name, contract: c, used: false }
    p.versions.set(key, v)
    p.bySymbol.set(v.symbol, v)
    return v
}

export function useVersion(p: Program, v: Version): number {
    if (!v.used) {
        v.used = true
        p.pending.push(v)
    }
    return v.symbol
}

export const tokenOps = new Set<NodeOp>([NodeOp.getProp, NodeOp.setProp, NodeOp.call, NodeOp.rt, NodeOp.load, NodeOp.store])

export interface UseGraph {
    src: Graph
    users: Map<number, [user: number, slot: number][]>
    positions: Map<number, number>
    params: number[]
    blockOf: Map<number, [block: number, index: number]>
    arrivals: Map<number, number[]>
}

export function useGraph(src: Graph): UseGraph {
    const users = nodeUsers(src, nodeIds(src), true)
    const positions = new Map<number, number>()
    const params: number[] = []
    const entry = src.blocks[0]
    let index = 1
    for (const p of entry.params) {
        if (isThisParam(getNode(src, p)!)) {
            positions.set(p, 0)
            params[0] = p
            continue
        }
        positions.set(p, index)
        params[index] = p
        index++
    }
    const blockOf = new Map<number, [number, number]>()
    for (const b of src.blocks) {
        if (b.id === entry.id) continue
        b.params.forEach((p, i) => blockOf.set(p, [b.id, i]))
    }
    const arrivals = new Map<number, number[]>()
    for (const [id, n] of nodeEntries(src)) {
        if (n.op !== NodeOp.apply) continue
        let list = arrivals.get(getRef(n, 0))
        if (!list) arrivals.set(getRef(n, 0), list = [])
        list.push(id)
    }
    return { src, users, positions, params, blockOf, arrivals }
}

export function strip(src: Graph, ref: number): number {
    let at = ref
    while (at) {
        const n = getNode(src, at)
        if (!n || n.op !== NodeOp.after) return at
        at = getRef(n, countIds(n) - 1)
    }
    return at
}

export function blockParamAt(src: Graph, apply: GraphNode, slot: number): number {
    return getBlock(src, getRef(apply, 0))?.params[slot - 1] ?? 0
}

export function valueUses(u: UseGraph, id: number): [user: number, slot: number][] {
    const out: [number, number][] = []
    const work = [id]
    const seen = new Set<number>(work)
    while (work.length) {
        const x = work.pop()!
        for (const [user, slot] of u.users.get(x) ?? []) {
            const m = getNode(u.src, user)!
            if (m.op === NodeOp.after) {
                if (slot === countIds(m) - 1 && !seen.has(user)) {
                    seen.add(user)
                    work.push(user)
                }
                continue
            }
            if (slot === 0 && tokenOps.has(m.op)) continue
            out.push([user, slot])
        }
    }
    return out
}

export interface Walk {
    members: Set<number>
    merged: number[]
    escape: string
    member(ref: number): boolean
    alias(id: number): void
    fail(why: string): void
}

export function walkUses(u: UseGraph, roots: number[], visit: (w: Walk, user: number, slot: number, n: GraphNode) => void): Walk {
    const work = [...roots]
    const w: Walk = {
        members: new Set(roots),
        merged: [],
        escape: '',
        member: ref => !!ref && (w.members.has(ref) || w.members.has(strip(u.src, ref))),
        alias: id => {
            if (w.members.has(id)) return
            w.members.add(id)
            work.push(id)
        },
        fail: why => {
            if (!w.escape) w.escape = why
        },
    }
    while (work.length && !w.escape) {
        const x = work.pop()!
        for (const [user, slot] of u.users.get(x) ?? []) {
            if (w.escape) break
            const n = getNode(u.src, user)!
            if (n.op === NodeOp.after) {
                if (slot === countIds(n) - 1) w.alias(user)
                continue
            }
            if (slot === 0 && tokenOps.has(n.op)) continue
            if (n.op === NodeOp.apply && slot > 0) {
                const p = blockParamAt(u.src, n, slot)
                if (!p) {
                    w.fail('apply')
                    break
                }
                if (!w.members.has(p)) w.merged.push(p)
                w.alias(p)
                continue
            }
            visit(w, user, slot, n)
        }
    }
    for (const p of w.merged) {
        if (w.escape) break
        const [block, index] = u.blockOf.get(p)!
        for (const apply of u.arrivals.get(block) ?? []) {
            if (!w.member(getRef(getNode(u.src, apply)!, index + 1))) w.fail('merge')
        }
    }
    return w
}
