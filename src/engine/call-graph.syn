/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import * as rt from './rt'
import type { Graph, GraphNode } from './lowering2'
import type { FastTraced } from './fast-trace'
import { NodeOp, NodeFlags, countIds, getBlock, getLiteral, getNode, getRef, isThisParam, nodeUsers } from './graph-node'

type Handle = intrinsics.Handle

export const Kinds = { int: 1, double: 2, string: 4, boolean: 8, undefined: 16, null: 32, object: 64, function: 128 }
export const anyKinds = 255

export type Layout = string[]

export interface Host {
    trace(fn: Function): FastTraced | undefined
    unit(cell: number): Function | undefined
    bound(fn: Function, count: number): Function | undefined
    direct(traced: FastTraced, n: GraphNode): Function | undefined
    symbol(fn: Function): number
    signature(fn: Function): Signature | undefined
    version(name: string): number
    template(cell: number): boolean
    runtime(op: number): Function | undefined
}

export interface Signature {
    params: number
    rest: boolean
}

export interface CallGraph<T> {
    order: T[]
    component: Map<T, number>
    callees: Map<T, Map<number, T>>
    callers: Map<T, [caller: T, call: number][]>
    edges: number
}

export interface ParamContract {
    kind: number
    layout: Layout | undefined
    rep: number
    proto: number
}

export interface Contract {
    unit: Function
    params: ParamContract[]
    ret: number
    retProto: number
    returnsInt: boolean
}

export interface Version {
    symbol: number
    name: string
    contract: Contract
    used: boolean
}

export interface Program {
    host: Host
    calls: CallGraph<Function>
    uses: Map<Function, boolean>
    versions: Map<string, Version>
    bySymbol: Map<number, Version>
    pending: Version[]
    stats: Map<string, number>
}

export function count(p: Program, key: string, by = 1): void {
    if (!by) return
    p.stats.set(key, (p.stats.get(key) ?? 0) + by)
}

export function usesCallee(p: Program, fn: Function): boolean {
    const known = p.uses.get(fn)
    if (known !== undefined) return known
    let uses = true
    const traced = p.host.trace(fn)
    if (traced) {
        uses = false
        for (const n of traced.graph.nodes.values()) {
            if (n.op === NodeOp.callContext) uses = true
        }
    }
    p.uses.set(fn, uses)
    return uses
}

export function calleeOf(p: { host: Host }, traced: FastTraced, n: GraphNode): Function | undefined {
    if (n.op !== NodeOp.call || (n.flags & NodeFlags.spread)) return
    const unit = p.host.direct(traced, n)
    if (!unit) return
    const bound = p.host.bound(unit, countIds(n) - 3)
    if (bound !== undefined && bound !== unit) return
    const signature = p.host.signature(unit)
    if (!signature || signature.rest) return
    return unit
}

export function createProgram(host: Host, roots: Function[]): Program {
    const p: Program = { host, calls: undefined!, uses: new Map(), versions: new Map(), bySymbol: new Map(), pending: [], stats: new Map() }
    p.calls = buildCallGraph<Function>(roots, fn => {
        const traced = host.trace(fn)
        if (!traced) return []
        const out: [number, Function][] = []
        for (const [id, n] of traced.graph.nodes) {
            const callee = calleeOf(p, traced, n)
            if (callee) out.push([id, callee])
        }
        return out
    })
    return p
}

export interface Reach {
    host: Host
    units: Function[]
    hubs: Map<Function, Set<Function>>
    names: Map<string, Function>
    sites: Map<Function, Map<number, Function>>
    flows: Map<Function, [hub: Function, member: Function][]>
    ids: Map<Function, number>
}

function hubOf(r: Reach, name: string): Function {
    const known = r.names.get(name)
    if (known) return known
    const hub = Object.defineProperty(function hub() {}, 'name', { value: `hub:${name}` })
    r.names.set(name, hub)
    r.hubs.set(hub, new Set())
    return hub
}

function keyHub(r: Reach, kind: string, key: number): Function {
    const name = `${kind}:${key}`
    const known = r.names.get(name)
    if (known) return known
    const hub = hubOf(r, name)
    if (kind === 'key') {
        joinHub(r, hub, hubOf(r, 'dynstore'))
        joinHub(r, hubOf(r, heap.keyIndex(key as Handle) !== undefined ? 'index' : 'keys'), hub)
    }
    if (kind === 'get' || kind === 'set') {
        joinHub(r, hub, hubOf(r, `proxy:${kind}`))
        joinHub(r, hubOf(r, `${kind}:*`), hub)
    }
    if (kind === 'call') joinHub(r, hub, keyHub(r, 'key', key))
    return hub
}

function joinHub(r: Reach, hub: Function, member: Function): void {
    r.hubs.get(hub)!.add(member)
}

function endHub(r: Reach, fn: Function, end: string): Function {
    let id = r.ids.get(fn)
    if (id === undefined) r.ids.set(fn, id = r.ids.size)
    return hubOf(r, `${end}:${fn.name}#${id}`)
}

function paramHub(r: Reach, fn: Function, position: number): Function {
    const hub = endHub(r, fn, `param${position}`)
    joinHub(r, hub, endHub(r, fn, 'args'))
    return hub
}

function nonEmptyHubs(r: Reach): Set<Function> {
    const out = new Set<Function>()
    const within = new Map<Function, Function[]>()
    const work: Function[] = []
    for (const [hub, members] of r.hubs) {
        for (const m of members) {
            if (!r.hubs.has(m)) {
                if (!out.has(hub)) {
                    out.add(hub)
                    work.push(hub)
                }
                continue
            }
            let list = within.get(m)
            if (!list) within.set(m, list = [])
            list.push(hub)
        }
    }
    while (work.length) {
        for (const outer of within.get(work.pop()!) ?? []) {
            if (out.has(outer)) continue
            out.add(outer)
            work.push(outer)
        }
    }
    return out
}

const scalarOps = new Set<NodeOp>([
    NodeOp.literal, NodeOp.void, NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.subsat, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr,
    NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.not, NodeOp.neg, NodeOp.nonzero, NodeOp.typeof, NodeOp.convert, NodeOp.bitconvert, NodeOp.box, NodeOp.clz, NodeOp.crc32,
    NodeOp.localTarget, NodeOp.syscallTarget, NodeOp.poolEntry, NodeOp.frameAddress, NodeOp.pstack, NodeOp.alloca, NodeOp.stackalloc, NodeOp.stackfree, NodeOp.mem, NodeOp.block, NodeOp.nilEffect,
])
const quietOps = new Set<NodeOp>([NodeOp.typeof, NodeOp.eq, NodeOp.ne])
const scalarRuntime = new Set<number>([
    rt.Op.addOrConcat, rt.Op.concat, rt.Op.toString, rt.Op.toNumber, rt.Op.typeof, rt.Op.strictEqual, rt.Op.compare, rt.Op.handleHash, rt.Op.create, rt.Op.truthy, rt.Op.ownKeys,
    rt.Op.handleof, rt.Op.stringOf, rt.Op.heapaddr, rt.Op.pstackaddr, rt.Op.hasPrototype, rt.Op.slice,
])
const quietRuntime = new Set<number>([rt.Op.truthy, rt.Op.typeof, rt.Op.strictEqual, rt.Op.handleHash])

export type NumericKey = (fn: Function, traced: FastTraced, ref: number) => boolean

export function discoverReach(host: Host, roots: Function[], numericKey: NumericKey): Reach {
    const r: Reach = { host, units: [], hubs: new Map(), names: new Map(), sites: new Map(), flows: new Map(), ids: new Map() }
    r.units = discover(r, roots, numericKey)
    return r
}

export function liveUnits(r: Reach, roots: Function[]): Set<Function> {
    const top = hubOf(r, 'top')
    const seen = new Set<Function>()
    const opened = new Set<Function>()
    const live = new Set<Function>()
    const work: Function[] = []
    function reach(fn: Function): void {
        if (seen.has(fn)) return
        seen.add(fn)
        work.push(fn)
    }
    function join(hub: Function, member: Function): void {
        r.hubs.get(hub)!.add(member)
        if (seen.has(hub)) reach(member)
    }
    function open(fn: Function): void {
        if (opened.has(fn)) return
        opened.add(fn)
        join(endHub(r, fn, 'args'), top)
        join(top, endHub(r, fn, 'ret'))
    }
    for (const root of roots) {
        reach(root)
        open(root)
    }
    while (work.length) {
        const fn = work.pop()!
        const members = r.hubs.get(fn)
        if (members) {
            for (const m of members) {
                reach(m)
                if (!r.hubs.has(m)) open(m)
            }
            continue
        }
        live.add(fn)
        for (const [hub, member] of r.flows.get(fn) ?? []) join(hub, member)
        for (const callee of r.sites.get(fn)?.values() ?? []) reach(callee)
    }
    return live
}

function discover(r: Reach, roots: Function[], numericKey: NumericKey): Function[] {
    const top = hubOf(r, 'top')
    joinHub(r, top, hubOf(r, 'dynstore'))
    joinHub(r, hubOf(r, 'access:*'), hubOf(r, 'get:*'))
    joinHub(r, hubOf(r, 'access:*'), hubOf(r, 'set:*'))
    const queued = new Set<Function>()
    const units: Function[] = []
    const read = new Set<number>()
    const deferred = new Map<number, [value: number, hub: Function][]>()
    const walked = new Set<number>()
    const cells: number[] = []
    function unit(fn: Function): void {
        if (queued.has(fn)) return
        queued.add(fn)
        units.push(fn)
    }
    function found(value: number, hub: Function): void {
        if (!value) return
        const fn = heap.isCell(value as Handle) && heap.isCallable(heap.deref(value as Handle)) ? r.host.unit(value) : undefined
        if (fn) {
            joinHub(r, hub, fn)
            unit(fn)
        }
        cells.push(value)
    }
    function readKey(key: number): void {
        if (read.has(key)) return
        read.add(key)
        const later = deferred.get(key)
        if (!later) return
        deferred.delete(key)
        for (const [value, hub] of later) found(value, hub)
    }
    function member(key: number, value: number, hub: Function): void {
        if (read.has(key) || key === heap.prototypeKey || heap.keyIndex(key as Handle) !== undefined) {
            found(value, hub)
            return
        }
        let later = deferred.get(key)
        if (!later) deferred.set(key, later = [])
        later.push([value, hub])
    }
    function walk(at: number): void {
        if (!at || walked.has(at) || heap.isOddballHandle(at as Handle) || heap.isBoxedF64(at as Handle)) return
        walked.add(at)
        if (heap.isFrameProxy(at as Handle) || heap.isTypeDescriptor(at as Handle)) return
        if (!heap.isCell(at as Handle)) return
        const state = heap.deref(at as Handle)
        if (state !== at) cells.push(state)
        if (heap.isString(state)) {
            cells.push(heap.getPrototypeOf(state))
            return
        }
        if (heap.isCallable(state) && r.host.template(at)) return
        if (heap.isProxy(state)) {
            found(heap.getProxyGetter(state), hubOf(r, 'proxy:get'))
            found(heap.getProxySetter(state), hubOf(r, 'proxy:set'))
            return
        }
        if (!heap.isOrdinaryObject(state) && !heap.isCallable(state) && !heap.isArray(state)) return
        cells.push(heap.getPrototypeOf(state))
        for (let i: u32 = 0; i < heap.ownPropertyCount(state); i++) {
            const key = heap.ownPropertyKeyAt(state, i) as number
            const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.ownPropertyAt(state, i)))
            if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) {
                member(key, d.slot0 as number, keyHub(r, 'get', key))
                member(key, d.slot1 as number, keyHub(r, 'set', key))
                continue
            }
            member(key, d.slot0 as number, keyHub(r, 'key', key))
        }
    }
    function flow(owner: Function, hub: Function, member: Function | undefined): void {
        if (!member || member === hub) return
        let list = r.flows.get(owner)
        if (!list) r.flows.set(owner, list = [])
        list.push([hub, member])
    }
    function classify(fn: Function): void {
        const sites = new Map<number, Function>()
        r.sites.set(fn, sites)
        const traced = r.host.trace(fn)
        if (!traced) return
        const g = traced.graph
        const u = useGraph(g)
        const sources = new Map<number, Function | undefined>()
        const concrete = new Map<number, Function | undefined>()
        function readHub(numeric: boolean): Function {
            const hub = hubOf(r, numeric ? 'read:index' : 'read:keys')
            joinHub(r, hub, hubOf(r, numeric ? 'index' : 'keys'))
            return hub
        }
        function sourceOf(id: number): Function | undefined {
            const n = getNode(g, id)
            if (!n) return
            const position = u.positions.get(id)
            if (position !== undefined) return paramHub(r, fn, position)
            if (n.op === NodeOp.heapHandle) {
                if (getRef(n, 0)) return top
                const cell = getLiteral(g, n, 0)
                if (!heap.isCell(cell as Handle) || !heap.isCallable(heap.deref(cell as Handle))) return
                return r.host.unit(cell)
            }
            if (n.op === NodeOp.getProp) return getRef(n, 2) ? readHub(numericKey(fn, traced, getRef(n, 2))) : keyHub(r, 'call', getLiteral(g, n, 2))
            if (n.op === NodeOp.call) {
                const direct = r.host.direct(traced, n)
                return direct ? endHub(r, direct, 'ret') : top
            }
            if (n.op === NodeOp.static) {
                const target = valueOf(getRef(n, 0))
                return target && !r.hubs.has(target) ? endHub(r, target, 'ret') : top
            }
            if (n.op === NodeOp.rt) {
                const op = getLiteral(g, n, 1)
                const impl = r.host.runtime(op)
                if (impl) return endHub(r, impl, 'ret')
                if (scalarRuntime.has(op)) return
                if (op === rt.Op.getprop) return readHub(!getRef(n, 3) || numericKey(fn, traced, getRef(n, 3)))
                return top
            }
            if (scalarOps.has(n.op)) return
            return top
        }
        function valueOf(ref: number): Function | undefined {
            const id = strip(g, ref)
            if (sources.has(id)) return sources.get(id)
            const hub = sourceOf(id)
            sources.set(id, hub)
            return hub
        }
        function concreteOf(id: number, n: GraphNode): Function | undefined {
            if (concrete.has(id)) return concrete.get(id)
            const callee = calleeOf(r, traced, n)
            concrete.set(id, callee)
            return callee
        }
        function sinkOf(user: number, slot: number): Function | undefined {
            const m = getNode(g, user)!
            if (m.op === NodeOp.call) {
                if (slot === 1) return
                const callee = concreteOf(user, m)
                return callee ? paramHub(r, callee, slot - 2) : top
            }
            if (m.op === NodeOp.setProp && slot === 3) return getRef(m, 2) ? hubOf(r, 'dynstore') : keyHub(r, 'key', getLiteral(g, m, 2))
            if (m.op === NodeOp.ret && slot === 0) return endHub(r, fn, 'ret')
            if (m.op === NodeOp.static || quietOps.has(m.op)) return
            if (m.op === NodeOp.rt && quietRuntime.has(getLiteral(g, m, 1))) return
            return top
        }
        for (const [id, n] of g.nodes) {
            if (n.op === NodeOp.heapHandle && !getRef(n, 0)) {
                const cell = getLiteral(g, n, 0)
                const callee = heap.isCell(cell as Handle) && heap.isCallable(heap.deref(cell as Handle)) ? r.host.unit(cell) : undefined
                if (callee) unit(callee)
                cells.push(cell)
                continue
            }
            if (n.op === NodeOp.static) {
                const target = valueOf(getRef(n, 0))
                if (target && !r.hubs.has(target)) sites.set(id, target)
                continue
            }
            if (n.op === NodeOp.getProp || n.op === NodeOp.setProp) {
                const keyRef = getRef(n, 2)
                const get = n.op === NodeOp.getProp
                if (!keyRef) readKey(getLiteral(g, n, 2))
                sites.set(id, keyRef ? hubOf(r, get ? 'get:*' : 'set:*') : keyHub(r, get ? 'get' : 'set', getLiteral(g, n, 2)))
                continue
            }
            if (n.op === NodeOp.call) {
                const direct = r.host.direct(traced, n)
                if (direct) {
                    unit(direct)
                    sites.set(id, direct)
                    if (concreteOf(id, n) !== direct) flow(fn, endHub(r, direct, 'args'), top)
                    continue
                }
                sites.set(id, valueOf(getRef(n, 1)) ?? top)
                continue
            }
            if (n.op === NodeOp.rt) {
                const op = getLiteral(g, n, 1)
                const impl = r.host.runtime(op)
                if (impl) {
                    unit(impl)
                    sites.set(id, impl)
                    flow(fn, endHub(r, impl, 'args'), top)
                    continue
                }
                if (op === rt.Op.getprop || op === rt.Op.ownKeys) {
                    sites.set(id, hubOf(r, 'get:*'))
                    continue
                }
                if (op === rt.Op.setprop) {
                    sites.set(id, hubOf(r, 'set:*'))
                    continue
                }
                if (op !== rt.Op.assign) continue
                sites.set(id, hubOf(r, 'access:*'))
                flow(fn, top, hubOf(r, 'keys'))
            }
        }
        for (const [id, n] of g.nodes) {
            if (n.op === NodeOp.after) continue
            const value = valueOf(id)
            if (!value) continue
            for (const [user, slot] of valueUses(u, id)) {
                const sink = sinkOf(user, slot)
                if (sink) flow(fn, sink, value)
            }
        }
    }
    for (const root of roots) unit(root)
    let next = 0
    while (next < units.length || cells.length) {
        if (cells.length) {
            walk(cells.pop()!)
            continue
        }
        classify(units[next++])
    }
    const filled = nonEmptyHubs(r)
    for (const [name, hub] of r.names) {
        if (name.startsWith('read:') && filled.has(hubOf(r, 'get:*'))) joinHub(r, hub, top)
        if (!name.startsWith('call:')) continue
        const getters = r.names.get(`get:${name.slice(5)}`)
        if (getters && filled.has(getters)) joinHub(r, hub, top)
    }
    return units
}

export function buildCallGraph<T>(roots: T[], calleesOf: (unit: T) => [call: number, callee: T][]): CallGraph<T> {
    const callees = new Map<T, Map<number, T>>()
    const callers = new Map<T, [caller: T, call: number][]>()
    const index = new Map<T, number>()
    const low = new Map<T, number>()
    const onStack = new Set<T>()
    const stack: T[] = []
    const order: T[] = []
    const component = new Map<T, number>()
    let edges = 0
    let next = 0
    let components = 0
    function edgesOf(unit: T): T[] {
        const out = new Map<number, T>()
        for (const [call, callee] of calleesOf(unit)) {
            out.set(call, callee)
            let list = callers.get(callee)
            if (!list) callers.set(callee, list = [])
            list.push([unit, call])
            edges++
        }
        callees.set(unit, out)
        return [...new Set(out.values())]
    }
    function enter(unit: T, frames: [unit: T, targets: T[], at: number][]): void {
        index.set(unit, next)
        low.set(unit, next)
        next++
        stack.push(unit)
        onStack.add(unit)
        frames.push([unit, edgesOf(unit), 0])
    }
    for (const root of roots) {
        if (index.has(root)) continue
        const frames: [unit: T, targets: T[], at: number][] = []
        enter(root, frames)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            const [unit, targets] = frame
            if (frame[2] < targets.length) {
                const target = targets[frame[2]]
                frame[2]++
                if (!index.has(target)) {
                    enter(target, frames)
                    continue
                }
                if (onStack.has(target)) low.set(unit, Math.min(low.get(unit)!, index.get(target)!))
                continue
            }
            frames.pop()
            if (frames.length) {
                const parent = frames[frames.length - 1][0]
                low.set(parent, Math.min(low.get(parent)!, low.get(unit)!))
            }
            if (low.get(unit) !== index.get(unit)) continue
            let member: T
            do {
                member = stack.pop()!
                onStack.delete(member)
                component.set(member, components)
                order.push(member)
            } while (member !== unit)
            components++
        }
    }
    return { order, component, callees, callers, edges }
}

export function calleesFirst<T, F>(graph: CallGraph<T>, summarize: (unit: T, outer: (call: number) => F | undefined) => F): Map<T, F> {
    const facts = new Map<T, F>()
    for (const unit of graph.order) {
        const callees = graph.callees.get(unit)
        const component = graph.component.get(unit)
        facts.set(unit, summarize(unit, call => {
            const callee = callees?.get(call)
            if (callee === undefined || graph.component.get(callee) === component) return
            return facts.get(callee)
        }))
    }
    return facts
}

export function callersFirst<T, V>(graph: CallGraph<T>, params: (unit: T) => number, argsOf: (unit: T, agreed: (V | undefined)[]) => ((call: number, index: number) => V | undefined) | undefined, join: (a: V, b: V) => V | undefined): Map<T, (V | undefined)[]> {
    const votes = new Map<T, (V | null | undefined)[]>()
    const agreed = new Map<T, (V | undefined)[]>()
    const visited = new Set<T>()
    for (let u = graph.order.length - 1; u >= 0; u--) {
        const unit = graph.order[u]
        visited.add(unit)
        const list = votes.get(unit) ?? []
        const own: (V | undefined)[] = []
        for (let i = 0; i < params(unit); i++) own.push(list[i] ?? undefined)
        agreed.set(unit, own)
        const argOf = argsOf(unit, own)
        if (!argOf) continue
        for (const [call, callee] of graph.callees.get(unit) ?? []) {
            if (visited.has(callee)) continue
            let into = votes.get(callee)
            if (!into) votes.set(callee, into = [])
            for (let k = 0; k < params(callee); k++) {
                const before = into[k]
                if (before === null) continue
                const have = argOf(call, k)
                if (have === undefined) {
                    into[k] = null
                    continue
                }
                if (before === undefined) {
                    into[k] = have
                    continue
                }
                into[k] = join(before, have) ?? null
            }
        }
    }
    return agreed
}

export function emptyParam(): ParamContract {
    return { kind: anyKinds, layout: undefined, rep: 0, proto: 0 }
}

export function baseContract(p: Program, unit: Function): Contract {
    const params: ParamContract[] = [emptyParam()]
    const count = p.host.signature(unit)?.params ?? 0
    for (let i = 0; i < count; i++) params.push(emptyParam())
    return { unit, params, ret: 0, retProto: 0, returnsInt: false }
}

export function copyContract(c: Contract): Contract {
    return { ...c, params: c.params.map(p => ({ ...p })) }
}

function repTag(p: ParamContract): string {
    if (p.rep) return p.rep === intrinsics.Types.i64 ? 'I' : 'F'
    if (p.layout) return 'o'
    if (p.kind === Kinds.int) return 'i'
    return '_'
}

export function versionOf(p: Program, c: Contract): Version {
    const parts: string[] = []
    for (const p of c.params) parts.push(`${p.kind}:${p.layout?.join('.') ?? ''}:${p.rep}:${p.proto}`)
    const key = `${p.host.symbol(c.unit)}#${parts.join('|')}>${c.ret}:${c.retProto}:${c.returnsInt ? 1 : 0}`
    const known = p.versions.get(key)
    if (known) return known
    const ret = c.returnsInt ? 'i' : c.ret ? (c.ret === intrinsics.Types.i64 ? 'I' : 'F') : ''
    const name = `${c.unit.name || 'anonymous'}/${c.params.map(repTag).join('')}${ret}`
    const v: Version = { symbol: p.host.version(name), name, contract: c, used: false }
    p.versions.set(key, v)
    p.bySymbol.set(v.symbol, v)
    return v
}

export function useVersion(p: Program, v: Version): number {
    if (!v.used) {
        v.used = true
        p.pending.push(v)
    }
    return v.symbol
}

export const tokenOps = new Set<NodeOp>([NodeOp.getProp, NodeOp.setProp, NodeOp.call, NodeOp.rt, NodeOp.load, NodeOp.store])

export interface UseGraph {
    src: Graph
    users: Map<number, [user: number, slot: number][]>
    positions: Map<number, number>
    params: number[]
    blockOf: Map<number, [block: number, index: number]>
    arrivals: Map<number, number[]>
}

export function useGraph(src: Graph): UseGraph {
    const users = nodeUsers(src, src.nodes.keys(), true)
    const positions = new Map<number, number>()
    const params: number[] = []
    const entry = src.blocks[0]
    let index = 1
    for (const p of entry.params) {
        if (isThisParam(getNode(src, p)!)) {
            positions.set(p, 0)
            params[0] = p
            continue
        }
        positions.set(p, index)
        params[index] = p
        index++
    }
    const blockOf = new Map<number, [number, number]>()
    for (const b of src.blocks) {
        if (b.id === entry.id) continue
        b.params.forEach((p, i) => blockOf.set(p, [b.id, i]))
    }
    const arrivals = new Map<number, number[]>()
    for (const [id, n] of src.nodes) {
        if (n.op !== NodeOp.apply) continue
        let list = arrivals.get(getRef(n, 0))
        if (!list) arrivals.set(getRef(n, 0), list = [])
        list.push(id)
    }
    return { src, users, positions, params, blockOf, arrivals }
}

export function strip(src: Graph, ref: number): number {
    let at = ref
    while (at) {
        const n = getNode(src, at)
        if (!n || n.op !== NodeOp.after) return at
        at = getRef(n, countIds(n) - 1)
    }
    return at
}

export function blockParamAt(src: Graph, apply: GraphNode, slot: number): number {
    return getBlock(src, getRef(apply, 0))?.params[slot - 1] ?? 0
}

export function valueUses(u: UseGraph, id: number): [user: number, slot: number][] {
    const out: [number, number][] = []
    const work = [id]
    const seen = new Set<number>(work)
    while (work.length) {
        const x = work.pop()!
        for (const [user, slot] of u.users.get(x) ?? []) {
            const m = getNode(u.src, user)!
            if (m.op === NodeOp.after) {
                if (slot === countIds(m) - 1 && !seen.has(user)) {
                    seen.add(user)
                    work.push(user)
                }
                continue
            }
            if (slot === 0 && tokenOps.has(m.op)) continue
            out.push([user, slot])
        }
    }
    return out
}

export interface Walk {
    members: Set<number>
    merged: number[]
    escape: string
    member(ref: number): boolean
    alias(id: number): void
    fail(why: string): void
}

export function walkUses(u: UseGraph, roots: number[], visit: (w: Walk, user: number, slot: number, n: GraphNode) => void): Walk {
    const work = [...roots]
    const w: Walk = {
        members: new Set(roots),
        merged: [],
        escape: '',
        member: ref => !!ref && (w.members.has(ref) || w.members.has(strip(u.src, ref))),
        alias: id => {
            if (w.members.has(id)) return
            w.members.add(id)
            work.push(id)
        },
        fail: why => {
            if (!w.escape) w.escape = why
        },
    }
    while (work.length && !w.escape) {
        const x = work.pop()!
        for (const [user, slot] of u.users.get(x) ?? []) {
            if (w.escape) break
            const n = getNode(u.src, user)!
            if (n.op === NodeOp.after) {
                if (slot === countIds(n) - 1) w.alias(user)
                continue
            }
            if (slot === 0 && tokenOps.has(n.op)) continue
            if (n.op === NodeOp.apply && slot > 0) {
                const p = blockParamAt(u.src, n, slot)
                if (!p) {
                    w.fail('apply')
                    break
                }
                if (!w.members.has(p)) w.merged.push(p)
                w.alias(p)
                continue
            }
            visit(w, user, slot, n)
        }
    }
    for (const p of w.merged) {
        if (w.escape) break
        const [block, index] = u.blockOf.get(p)!
        for (const apply of u.arrivals.get(block) ?? []) {
            if (!w.member(getRef(getNode(u.src, apply)!, index + 1))) w.fail('merge')
        }
    }
    return w
}
