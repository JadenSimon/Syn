"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import * as rt from './rt'
import { Op as RtOp } from './rt'
import { firstNonOrderingSlot, stronglyConnected, type Graph, type GraphNode } from './lowering2'
import { addNode, countIds, getLiteral, getNode, getOperand, getRef, NodeOp, putNode, regionUp, typeOf, type Operand, type RegionTree, nodeEntries } from './graph-node'
import { globals as builtinGlobals } from './builtins'
import { fixedField, fixedState, selfOf, usersOf, valueTail, type AccessHost, type PlannedUnit, type Type, type ValueTypes } from './value-types'

type Handle = intrinsics.Handle

const Types = intrinsics.Types

export interface ProofScope {
    g: Graph
    regions: RegionTree
    charge(n: number): void
    skipKey(key: number): void
    proofs: Map<number, boolean>
    segRoots: Map<number, number>
    keyRoots: Map<number, Map<number, number>>
}

export interface Relation {
    index: number
    length: number
    below: boolean
}

export const pureRt = new Set<number>([RtOp.typeof, RtOp.toString, RtOp.handleof, RtOp.heapaddr, RtOp.pstackaddr, RtOp.hasPrototype, RtOp.hasProperty, RtOp.nullish, RtOp.paramCount, RtOp.restIndex, RtOp.handleHash, RtOp.stringOf])

let lengthKey = 0

export function condition(g: Graph, cond: number, positive: boolean): [number, boolean] {
    let id = cond
    let yes = positive
    for (;;) {
        const n = id ? getNode(g, id) : undefined
        if (!n) return [0, yes]
        if (n.op === NodeOp.after) {
            id = getRef(n, countIds(n) - 1)
            continue
        }
        if (n.op !== NodeOp.select || countIds(n) !== 3) return [id, yes]
        const a = armTruth(g, n, 1)
        const b = armTruth(g, n, 2)
        if (a === undefined || b === undefined) return [id, yes]
        if (a === 0 && b === 1) yes = !yes
        else if (!(a === 1 && b === 0)) return [0, yes]
        id = getRef(n, 0)
    }
}

function armTruth(g: Graph, n: GraphNode, at: number): number | undefined {
    const ref = getRef(n, at)
    if (!ref) return getLiteral(g, n, at)
    const arm = getNode(g, ref)
    if (!arm || arm.op !== NodeOp.literal || typeOf(arm) !== Types.bool) return
    return getLiteral(g, arm, 0)
}

export function lengthOwner(g: Graph, id: number): number {
    const n = id ? getNode(g, id) : undefined
    if (n?.op !== NodeOp.getProp || getRef(n, 2)) return 0
    if (!lengthKey) lengthKey = heap.fromJsString('length') as number
    return getLiteral(g, n, 2) === lengthKey ? getRef(n, 1) : 0
}

function flipped(op: NodeOp, positive: boolean): NodeOp {
    if (positive) return op
    return op === NodeOp.lt ? NodeOp.ge : op === NodeOp.le ? NodeOp.gt : op === NodeOp.gt ? NodeOp.le : op === NodeOp.ge ? NodeOp.lt : op
}

export function relationOf(g: Graph, cond: number, yes: boolean): Relation | undefined {
    const [id, positive] = condition(g, cond, yes)
    if (!id) return undefined
    const n = getNode(g, id)!
    const a = getRef(n, 0)
    const b = getRef(n, 1)
    if (!a || !b) return undefined
    const op = flipped(n.op, positive)
    if (lengthOwner(g, b)) {
        if (op === NodeOp.lt) return { index: a, length: b, below: true }
        if (op === NodeOp.ge || op === NodeOp.gt) return { index: a, length: b, below: false }
    }
    if (lengthOwner(g, a)) {
        if (op === NodeOp.gt) return { index: b, length: a, below: true }
        if (op === NodeOp.le || op === NodeOp.lt) return { index: b, length: a, below: false }
    }
    return undefined
}

export function inBounds(scope: ProofScope, node: number, index: number, recv: number): boolean {
    const known = scope.proofs.get(node)
    if (known !== undefined) return known
    const g = scope.g
    const regions = scope.regions
    if (!lengthKey) lengthKey = heap.fromJsString('length') as number
    const token = keyRoot(scope, getRef(getNode(g, node)!, 0), lengthKey)
    let proved = false
    let at = regions.of.get(node) ?? -1
    while (at >= 0 && !proved) {
        scope.charge(1)
        if (regions.depth[at] > 0) {
            const rel = relationOf(g, getRef(getNode(g, regions.origin[at])!, 0), regions.slot[at] === 1)
            if (rel?.below && sameValue(scope, rel.index, index) && sameValue(scope, lengthOwner(g, rel.length), recv) && keyRoot(scope, getRef(getNode(g, rel.length)!, 0), lengthKey) === token) proved = true
        }
        at = regionUp(regions, at)
    }
    scope.proofs.set(node, proved)
    return proved
}

function sameValue(scope: ProofScope, a: number, ref: number): boolean {
    if (a === ref) return true
    if (!a || !ref) return false
    const g = scope.g
    const m = getNode(g, ref)
    const n = getNode(g, a)
    if (m?.op !== NodeOp.getProp || n?.op !== NodeOp.getProp) return false
    if (!sameValue(scope, getRef(m, 1), getRef(n, 1)) || getRef(m, 2) || getRef(n, 2) || getLiteral(g, m, 2) !== getLiteral(g, n, 2)) return false
    const key = getLiteral(g, m, 2)
    return keyRoot(scope, getRef(m, 0), key) === keyRoot(scope, getRef(n, 0), key)
}

function keyRoot(scope: ProofScope, tok: number, key: number): number {
    const g = scope.g
    let memo = scope.keyRoots.get(key)
    if (!memo) scope.keyRoots.set(key, memo = new Map())
    const path: number[] = []
    let at = tok
    let root = 0
    for (;;) {
        const known = at ? memo.get(at) : 0
        if (known !== undefined) {
            root = known
            break
        }
        const seg = segRoot(scope, at)
        const t = seg ? getNode(g, seg) : undefined
        const other = t?.op === NodeOp.setProp && !getRef(t, 2) ? getLiteral(g, t, 2) : key
        if (other === key || heap.keyIndex(other as Handle) !== undefined) {
            root = seg
            break
        }
        scope.charge(1)
        scope.skipKey(other)
        path.push(at)
        at = getRef(t!, 0)
    }
    for (const q of path) memo.set(q, root)
    return root
}

export function segRoot(scope: ProofScope, tok: number): number {
    const g = scope.g
    const path: number[] = []
    let at = tok
    let root = 0
    for (;;) {
        const known = at ? scope.segRoots.get(at) : 0
        if (known !== undefined) {
            root = known
            break
        }
        const t = getNode(g, at)
        const read = t !== undefined && (t.op === NodeOp.getProp || t.op === NodeOp.after || (t.op === NodeOp.rt && pureRt.has(getLiteral(g, t, 1))))
        if (!read) {
            root = at
            break
        }
        scope.charge(1)
        path.push(at)
        at = getRef(t!, 0)
    }
    for (const q of path) scope.segRoots.set(q, root)
    return root
}

function hasSetter(proto: Handle, key: Handle): boolean {
    let at = proto
    while (at) {
        const descriptor = heap.getOwnProperty(at, key)
        if (descriptor) return (heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor)).flags & heap.PropFlags.has_setter) !== 0
        at = heap.getPrototypeOf(at)
    }
    return false
}

export function initializer(g: Graph, proto: Handle): boolean {
    const self = selfOf(g)
    if (!self) return false
    for (const [id, n] of nodeEntries(g)) {
        if (n.op === NodeOp.call || n.op === NodeOp.static || n.op === NodeOp.inlined) return false
        if (n.op === NodeOp.rt && rt.sliceOf(g, n) === undefined) return false
        for (let slot = 0; slot < countIds(n); slot++) {
            if (getRef(n, slot) !== self) continue
            if (n.op === NodeOp.setProp && slot === 1 && !getRef(n, 2) && !hasSetter(proto, getLiteral(g, n, 2) as Handle)) continue
            if (n.op === NodeOp.after && slot === countIds(n) - 1) continue
            if (n.op === NodeOp.ret && slot === 0) continue
            return false
        }
    }
    return true
}

export function killedAfter(g: Graph, call: number, allocated: number, key: Handle, proto: Handle, self: boolean, regionOf: (id: number) => number | undefined): boolean {
    const c = getNode(g, call)
    if (c?.op !== NodeOp.call || valueTail(g, getRef(c, 2)) !== allocated) return false
    const objects = self ? [allocated, call] : [allocated]
    const region = regionOf(call)
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.setProp || getRef(n, 2) || getLiteral(g, n, 2) !== key) continue
        if (!objects.includes(valueTail(g, getRef(n, 1)))) continue
        if (regionOf(id) !== region) continue
        if (unobserved(g, getRef(n, 0), call, objects, proto)) return true
    }
    return false
}

function unobserved(g: Graph, from: number, call: number, objects: number[], proto: Handle): boolean {
    let reached = false
    const visited = new Set<number>()
    const work = [from]
    while (work.length) {
        const id = work.pop()!
        if (!id || visited.has(id)) continue
        visited.add(id)
        if (id === call) {
            reached = true
            continue
        }
        const n = getNode(g, id)
        if (!n) return false
        if (n.op === NodeOp.nilEffect) continue
        if (n.op === NodeOp.after) {
            for (let i = 0; i < countIds(n) - 1; i++) work.push(getRef(n, i))
            continue
        }
        const escapes = (at: number) => !!getRef(n, at) && objects.includes(valueTail(g, getRef(n, at)))
        const own = escapes(1)
        if (n.op === NodeOp.setProp) {
            if (escapes(3) || (own && (getRef(n, 2) || hasSetter(proto, getLiteral(g, n, 2) as Handle)))) return false
        } else if (n.op === NodeOp.getProp) {
            if (own) return false
        } else if (n.op === NodeOp.store) {
            if (escapes(3)) return false
        } else if (n.op === NodeOp.rt && rt.sliceOf(g, n) !== undefined) {
            if (escapes(4)) return false
        } else if (n.op !== NodeOp.load && n.op !== NodeOp.pstack) return false
        work.push(getRef(n, 0))
    }
    return reached
}

export enum ValueKind {
    undef = 1,
    int = 2,
    float = 4,
    text = 8,
    other = 16,
}

export interface DynamicView {
    accesses(visit: (site: number, store: boolean, keyed: boolean, object: number, key: number, value: number) => void): void
    origins(slot: number): number[]
    kinds(slot: number): number
    candidate(origin: number): boolean
    text(origin: number): boolean
    allocSlots(origin: number): number[]
    bind(slot: number, fn: Function, params: intrinsics.Types[]): void
}

function accessor(view: DynamicView, dynamic: Set<number>, slot: number, store: boolean): [Function, intrinsics.Types[]] | undefined {
    if (store && slot < 0) return [heap.deleteHandleProperty, [Types.u32, Types.u32]]
    const kinds = view.kinds(slot)
    if (kinds & ValueKind.other) return undefined
    let handles = (kinds & ValueKind.text) !== 0
    for (const origin of view.origins(slot)) {
        if (!view.text(origin) && !dynamic.has(origin)) return undefined
        handles = true
    }
    const numbers = (kinds & (ValueKind.int | ValueKind.float)) !== 0
    if (numbers && (handles || (store && (kinds & ValueKind.undef)))) return undefined
    if (!numbers) return store ? [heap.setHandleProperty, [Types.u32, Types.u32, Types.u32]] : [heap.getHandleProperty, [Types.u32, Types.u32]]
    if (kinds & ValueKind.float) return store ? [heap.setFloatProperty, [Types.u32, Types.u32, Types.f64]] : [heap.getFloatProperty, [Types.u32, Types.u32]]
    return store ? [heap.setIntProperty, [Types.u32, Types.u32, Types.i64]] : [heap.getIntProperty, [Types.u32, Types.u32]]
}

export function markDynamic(view: DynamicView): Set<number> {
    const dynamic = new Set<number>()
    const stored = new Map<number, number[]>()
    const sites: number[] = []
    const work: number[] = []
    const mark = (origin: number) => {
        if (dynamic.has(origin) || !view.candidate(origin)) return
        dynamic.add(origin)
        work.push(origin)
    }
    view.accesses((site, store, keyed, object, key, value) => {
        sites.push(site, store ? 1 : 0, object, value)
        if (store) {
            for (const origin of view.origins(object)) {
                let list = stored.get(origin)
                if (!list) stored.set(origin, list = [])
                list.push(value)
            }
        }
        if (!keyed) return
        if (!(view.kinds(key) & ~(ValueKind.int | ValueKind.float)) && !view.origins(key).length) return
        for (const origin of view.origins(object)) mark(origin)
    })
    while (work.length) {
        const origin = work.pop()!
        for (const value of stored.get(origin) ?? []) {
            for (const inner of view.origins(value)) mark(inner)
        }
    }
    if (!dynamic.size) return dynamic
    for (const origin of dynamic) {
        for (const slot of view.allocSlots(origin)) view.bind(slot, heap.makePlainObject, [])
    }
    for (let i = 0; i < sites.length; i += 4) {
        if (!view.origins(sites[i + 2]).some(origin => dynamic.has(origin))) continue
        const chosen = accessor(view, dynamic, sites[i + 3], sites[i + 1] === 1)
        if (chosen) view.bind(sites[i], chosen[0], chosen[1])
    }
    return dynamic
}

export interface MethodView {
    calls(visit: (unit: number, member: number, receiver: number, key: number) => void): void
    numberOnly(receiver: number): boolean
    method(key: number): boolean
}

export function numberPrototype(host: AccessHost): Handle {
    return heap.deref(heap.getPrototypeProperty(heap.deref(host.session.linkFunction(builtinGlobals.Number) as Handle)))
}

export function dataMethod(proto: Handle, key: number): number {
    const addr = heap.getPropertyDescriptor(proto, key as Handle)
    if (!addr) return -1
    const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
    if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return -1
    return desc.slot0
}

export function numberMembers(view: MethodView): [unit: number, member: number][] {
    const verdicts = new Map<number, Map<number, boolean>>()
    view.calls((unit, member, receiver, key) => {
        let verdict = verdicts.get(unit)
        if (!verdict) verdicts.set(unit, verdict = new Map())
        const number = view.numberOnly(receiver) && view.method(key)
        verdict.set(member, (verdict.get(member) ?? true) && number)
    })
    const out: [unit: number, member: number][] = []
    for (const [unit, verdict] of verdicts) {
        for (const [member, number] of verdict) {
            if (number) out.push([unit, member])
        }
    }
    return out
}

export enum GenericKind {
    number = 1,
    other = 2,
}

export interface GenericFlow {
    sources: (number[] | undefined)[]
    kinds: Uint8Array
    params: number[][]
    names: string[]
    numeric: number[]
    self: number
    fields: Map<number, [string, number][]>
    objects: Map<number, number[]>
    units: Function[]
}

export interface GenericShape {
    params: { name: string, paths: string[] }[]
    paths: string[]
    lines: string[]
}

function close(flow: GenericFlow, sets: Uint32Array, width: number): void {
    for (const group of stronglyConnected(flow.kinds.keys(), v => flow.sources[v] ?? [])) {
        const acc = new Uint32Array(width)
        for (const w of group) {
            for (let i = 0; i < width; i++) acc[i] |= sets[w * width + i]
            for (const s of flow.sources[w] ?? []) for (let i = 0; i < width; i++) acc[i] |= sets[s * width + i]
        }
        for (const w of group) sets.set(acc, w * width)
    }
}

export function genericShape(flow: GenericFlow, numberKey: string, constantIndex: (key: string) => boolean): GenericShape {
    const syms: number[] = []
    for (const list of flow.params) for (const slot of list) syms.push(slot)
    const width = (syms.length + 2 + 31) >> 5
    const sets = new Uint32Array(flow.kinds.length * width)
    for (let s = 0; s < flow.kinds.length; s++) sets[s * width] = flow.kinds[s]
    syms.forEach((slot, k) => {
        const bit = k + 2
        sets[slot * width] &= ~3
        sets[slot * width + (bit >> 5)] |= 1 << (bit & 31)
    })
    close(flow, sets, width)
    const has = (s: number, k: number) => (sets[s * width + ((k + 2) >> 5)] & (1 << ((k + 2) & 31))) !== 0
    const numeric = new Uint8Array(syms.length)
    for (const s of flow.numeric) for (let k = 0; k < syms.length; k++) if (has(s, k)) numeric[k] = 1
    const pathOf = new Map<number, string>([[flow.self, '']])
    const order = [flow.self]
    const contents = new Map<string, number[]>()
    const holdsObjects = new Set<string>()
    for (let i = 0; i < order.length; i++) {
        const prefix = pathOf.get(order[i])!
        const fields = flow.fields.get(order[i]) ?? []
        const indexed = fields.some(([key]) => key === numberKey)
        for (const [key, slot] of fields) {
            const path = `${prefix}${prefix ? '.' : ''}${indexed && constantIndex(key) ? numberKey : key}`
            let list = contents.get(path)
            if (!list) contents.set(path, list = [])
            list.push(slot)
            for (const inner of flow.objects.get(slot) ?? []) {
                holdsObjects.add(path)
                if (pathOf.has(inner)) continue
                pathOf.set(inner, path)
                order.push(inner)
            }
        }
    }
    const parent = syms.map((_, k) => k)
    const find = (k: number) => {
        let at = k
        while (parent[at] !== at) at = parent[at] = parent[parent[at]]
        return at
    }
    const symsAt = (path: string) => {
        const out: number[] = []
        for (let k = 0; k < syms.length; k++) if (contents.get(path)!.some(s => has(s, k))) out.push(k)
        return out
    }
    for (const path of contents.keys()) {
        const vars = symsAt(path).filter(k => !numeric[k])
        for (const k of vars.slice(1)) parent[find(k)] = find(vars[0])
    }
    const names = new Map<number, string>()
    const params: { name: string, paths: string[] }[] = []
    for (const [path] of contents) for (const k of symsAt(path)) {
        if (numeric[k]) continue
        let name = names.get(find(k))
        if (name === undefined) {
            names.set(find(k), name = `T${names.size}`)
            params.push({ name, paths: [] })
        }
        const param = params.find(p => p.name === name)!
        if (!param.paths.includes(path)) param.paths.push(path)
    }
    const kindsAt = (path: string) => contents.get(path)!.reduce((k, s) => k | sets[s * width] & 3, 0)
    const label = (k: number) => numeric[k] ? `number(${flow.names[k]})` : names.get(find(k)) ?? flow.names[k]
    const lines = params.map(p => `  param ${p.name}: ${p.paths.join(' ')}`)
    lines.push(`  paths ${[...contents.keys()].sort().join(' ')}`)
    for (const path of contents.keys()) {
        const kinds = kindsAt(path)
        const origins = [...new Set(symsAt(path).map(label))]
        if (kinds & GenericKind.number) origins.push('number')
        if (kinds & GenericKind.other) origins.push(holdsObjects.has(path) ? 'object' : 'other')
        lines.push(`  ${path}: ${origins.join(' | ') || 'never'}`)
    }
    return { params, paths: [...contents.keys()], lines }
}

export interface SetTest {
    keys: number[]
    low: number
    high: number
}

export type SetUse = 'construct' | 'lookup' | SetTest

const maxSetKey = 256

function stableMethod(types: ValueTypes, host: AccessHost, proto: Handle | undefined, key: Handle, method: Function): boolean {
    let at = proto
    while (at) {
        if (!fixedField(types, at, key) || !fixedField(types, at, heap.protoSlotKey)) return false
        const descriptor = heap.getOwnProperty(at, key)
        if (descriptor) {
            const property = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
            if (property.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return false
            return host.functionOf(property.slot0 as u32) === method
        }
        at = heap.getPrototypeOf(at)
    }
    return false
}

function smallKeys(values: number[]): boolean {
    for (const value of values) {
        if (!Number.isInteger(value) || value < 0 || value >= maxSetKey) return false
    }
    return true
}

function setContents(types: ValueTypes, host: AccessHost, g: Graph, id: number, iterator: Handle): number[] | undefined {
    const call = getNode(g, id)!
    const arrayIterator = builtinGlobals.Array.prototype[Symbol.iterator]
    const array = valueTail(g, getRef(call, 3))
    const n = getNode(g, array)
    if (n?.op === NodeOp.heapHandle && !getRef(n, 0)) {
        const state = heap.deref(getLiteral(g, n, 0) as Handle)
        const elements = host.constantElements?.(state)
        if (!elements || elements.length > maxSetKey || !fixedState(types, state) || !elements.every(heap.isBoxedF64)) return
        if (!stableMethod(types, host, heap.getPrototypeOf(state), iterator, arrayIterator)) return
        const values = elements.map(heap.unboxF64)
        return smallKeys(values) ? values : undefined
    }
    if (n?.op !== NodeOp.rt || getLiteral(g, n, 1) !== RtOp.arrayLiteral || getRef(n, 2)) return
    const arrayProto = heap.deref(heap.getPrototypeProperty(heap.deref(host.session.linkFunction(builtinGlobals.Array) as Handle)))
    if (!stableMethod(types, host, arrayProto, iterator, arrayIterator)) return
    const size = getLiteral(g, n, 2)
    if (!Number.isInteger(size) || size < 0 || size > maxSetKey) return
    const values: number[] = []
    const elements = new Set<number>()
    let token = getRef(call, 0)
    let i = size - 1
    while (i >= 0) {
        const element = getNode(g, token)
        if (element?.op !== NodeOp.rt || getLiteral(g, element, 1) !== RtOp.arrayElement || getRef(element, 2) !== array) return
        if (getRef(element, 3) || getLiteral(g, element, 3) !== i || getRef(element, 4)) return
        values.push(getLiteral(g, element, 4))
        elements.add(token)
        token = getRef(element, 0)
        i--
    }
    if ((size > 0 && token !== array) || !smallKeys(values)) return
    for (const [user, slot] of usersOf(g).get(array) ?? []) {
        if (slot < firstNonOrderingSlot(getNode(g, user)!)) continue
        if (elements.has(user) && slot === 2) continue
        if (user === id && slot === 3) continue
        return
    }
    return values
}

function internKeys(interned: Map<string, number[]>, values: number[]): number[] {
    const keys = [...new Set(values)].sort((x, y) => x - y)
    const name = keys.join()
    const known = interned.get(name)
    if (known) return known
    interned.set(name, keys)
    return keys
}

function keyWords(keys: number[], base: number, length: number): number[] {
    const words: number[] = Array(length).fill(0)
    for (const key of keys) {
        const at = (key - base) >>> 5
        words[at] = (words[at] | (1 << ((key - base) & 31))) >>> 0
    }
    return words
}

function onlySets(type: Type | undefined, bits: Map<number, number[]>): boolean {
    if (!type || type.unknown || type.undefined || type.bools || type.float || type.range || type.literals.length || type.strings.length || type.functions.length || type.closures.length) return false
    return type.objects.length > 0 && type.objects.every(o => bits.has(o))
}

function integerRange(type: Type | undefined): [low: number, high: number] | undefined {
    if (!type || type.unknown || type.undefined || type.bools || type.float || type.objects.length || type.strings.length || type.functions.length || type.closures.length) return
    if (!type.range && !type.literals.length) return
    let low = type.range ? type.range[0] : Infinity
    let high = type.range ? type.range[1] : -Infinity
    for (const literal of type.literals) {
        if (!Number.isInteger(literal)) return
        low = Math.min(low, literal)
        high = Math.max(high, literal)
    }
    return [low, high]
}

function opaqueNode(g: Graph, unit: PlannedUnit, id: number, n: GraphNode, nodes: Map<number, Type>, host: AccessHost): boolean {
    if (n.op === NodeOp.call) {
        if (getNode(g, getRef(n, 1))?.op === NodeOp.syscallTarget) return false
        const callee = nodes.get(getRef(n, 1))
        return !unit.calls.has(id) || !callee || callee.unknown || callee.functions.some(fn => !host.traceable(fn))
    }
    if (unit.calls.has(id)) return false
    if (n.op === NodeOp.static) return true
    if (n.op !== NodeOp.rt) return false
    const op = getLiteral(g, n, 1)
    return !rt.shallowOps.has(op) && !rt.allocOps.has(op) && !rt.targetWriteOps.has(op) && rt.sliceOf(g, n) === undefined && op !== RtOp.assign
}

export function planSmallSets(types: ValueTypes, host: AccessHost, units: Iterable<PlannedUnit>, roots: Function[]): Map<PlannedUnit, Map<number, SetUse>> {
    const out = new Map<PlannedUnit, Map<number, SetUse>>()
    if (intrinsics.argv().includes('no-small-sets')) return out
    const ctor = builtinGlobals.Set
    if (!types.frames.some(frame => frame.unit === ctor)) return out
    const has = ctor.prototype.has
    const hasKey = heap.fromJsString('has')
    const iterator = host.session.fromJsValue(Symbol.iterator) as Handle
    const interned = new Map<string, number[]>()
    const bits = new Map<number, number[]>()
    const rejected = new Set<number>()
    for (const frame of types.frames) {
        if (frame.unit !== ctor) continue
        const objects = frame.params.find(p => p.label === 'this')?.type.objects ?? []
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            const g = host.graphOf(site.unit)
            const call = getNode(g, site.node)!
            const values = call.op === NodeOp.call && countIds(call) === 4 ? setContents(types, host, g, site.node, iterator) : undefined
            const known = values && internKeys(interned, values)
            for (const object of objects) {
                if (!known || (bits.has(object) && bits.get(object) !== known) || !stableMethod(types, host, types.objects[object].proto, hasKey, has)) rejected.add(object)
                else bits.set(object, known)
            }
        }
    }
    for (const object of rejected) bits.delete(object)
    if (!bits.size) return out
    const exposed: number[] = []
    const rootSet = new Set(roots)
    for (const frame of types.frames) {
        if (!rootSet.has(frame.unit)) continue
        for (const id of frame.returns.objects) exposed.push(id)
        for (const id of frame.returns.closures) exposed.push(id)
    }
    const uses: [unit: PlannedUnit, node: number, use: SetUse, objects: number[]][] = []
    for (const unit of units) {
        if (unit.fn === ctor || unit.fn === has) continue
        const g = host.graphOf(unit.fn)
        const nodes = types.resolve(unit.frames).nodes
        const aliases = new Map<number, number[]>()
        for (const [node, type] of nodes) {
            const objects = type.objects.filter(o => bits.has(o))
            if (objects.length) aliases.set(node, objects)
        }
        for (const [id, n] of nodeEntries(g)) {
            const opaque = opaqueNode(g, unit, id, n, nodes, host)
            if (opaque) {
                for (let slot = firstNonOrderingSlot(n); slot < countIds(n); slot++) {
                    const type = nodes.get(getRef(n, slot))
                    if (!type) continue
                    for (const o of type.objects) exposed.push(o)
                    for (const o of type.closures) exposed.push(o)
                }
            }
            if (!aliases.size || n.op === NodeOp.after || n.op === NodeOp.apply || n.op === NodeOp.select || n.op === NodeOp.ret) continue
            const involved = new Set<number>()
            for (let slot = firstNonOrderingSlot(n); slot < countIds(n); slot++) {
                for (const object of aliases.get(getRef(n, slot)) ?? []) involved.add(object)
            }
            if (!involved.size) continue
            const objects = [...involved]
            if (n.op === NodeOp.getProp) {
                const target = nodes.get(id)
                let called = true
                for (const [user, slot] of usersOf(g).get(id) ?? []) {
                    const u = getNode(g, user)!
                    if (slot >= firstNonOrderingSlot(u) && (u.op !== NodeOp.call || slot !== 1 || getRef(u, 2) !== getRef(n, 1))) called = false
                }
                if (called && target && !target.unknown && !target.objects.length && target.functions.length === 1 && target.functions[0] === has) {
                    uses.push([unit, id, 'lookup', objects])
                    continue
                }
            }
            const targets = n.op === NodeOp.call && !opaque ? unit.calls.get(id) : undefined
            if (targets) {
                let ctors = 0
                let lookups = 0
                for (const target of targets) {
                    if (target.fn === ctor) ctors++
                    else if (target.fn === has) lookups++
                }
                if (ctors === targets.size && onlySets(nodes.get(getRef(n, 2)), bits)) {
                    uses.push([unit, id, 'construct', objects])
                    continue
                }
                if (lookups === targets.size && onlySets(nodes.get(getRef(n, 2)), bits)) {
                    const known = bits.get(objects[0])!
                    const literal = getLiteral(g, n, 3)
                    const range = getRef(n, 3) ? integerRange(nodes.get(getRef(n, 3))) : Number.isInteger(literal) ? [literal, literal] : undefined
                    if (range && countIds(n) === 4 && objects.every(o => bits.get(o) === known)) {
                        uses.push([unit, id, { keys: known, low: range[0], high: range[1] }, objects])
                        continue
                    }
                }
                if (!ctors && !lookups) continue
            }
            for (const object of objects) rejected.add(object)
        }
    }
    const exposing = exposed.slice()
    const reached = new Set(exposed)
    while (exposing.length) {
        const object = types.objects[exposing.pop()!]
        for (const field of object.fields.values()) {
            for (const id of field.type.objects.concat(field.type.closures)) {
                if (reached.has(id)) continue
                reached.add(id)
                exposing.push(id)
            }
        }
    }
    for (const object of bits.keys()) {
        if (reached.has(object)) rejected.add(object)
    }
    const linked = new Map<number, number[][]>()
    for (const [, , , objects] of uses) {
        if (objects.length < 2) continue
        for (const object of objects) {
            const list = linked.get(object)
            if (list) list.push(objects)
            else linked.set(object, [objects])
        }
    }
    const pending = [...rejected]
    while (pending.length) {
        for (const objects of linked.get(pending.pop()!) ?? []) {
            for (const object of objects) {
                if (rejected.has(object)) continue
                rejected.add(object)
                pending.push(object)
            }
        }
    }
    for (const [unit, node, use, objects] of uses) {
        if (objects.some(o => rejected.has(o))) continue
        let nodes = out.get(unit)
        if (!nodes) out.set(unit, nodes = new Map())
        nodes.set(node, use)
    }
    return out
}

export function rewriteSmallSets(g: Graph, uses: Map<number, SetUse>, wordsSlot: (words: number[]) => number): void {
    for (const [id, use] of uses) {
        const n = getNode(g, id)!
        const T = typeOf(n)
        const token = getOperand(g, n, 0)
        if (use === 'construct') {
            putNode(g, id, NodeOp.after, [token, getOperand(g, n, 2)], T)
            continue
        }
        if (use === 'lookup') {
            putNode(g, id, NodeOp.after, [token, { literal: 0 }], T)
            continue
        }
        const keys = use.keys
        let top = keys.length ? keys[keys.length - 1] : 0
        const base = top >= 32 && use.low < 0 ? keys[0] : 0
        if (top - base >= 32 && use.low >= 0) top = Math.max(top, Math.min(use.high, maxSetKey - 1))
        let length = 1
        while (length * 32 <= top - base) length *= 2
        const words = keyWords(keys, base, length)
        const low = use.low - base
        const high = use.high - base
        const input = getOperand(g, n, 3)
        const value = base ? addNode(g, NodeOp.sub, [input, { literal: base }], Types.u64) : input
        let word: Operand = { literal: words[0] }
        if (length > 1) {
            const pointer = addNode(g, NodeOp.poolEntry, [{ literal: wordsSlot(words) }], Types.u64)
            const index = addNode(g, NodeOp.ushr, [value, { literal: 3 }], Types.u64)
            const offset = addNode(g, NodeOp.and, [index, { literal: (length - 1) * 4 }], Types.u64)
            word = addNode(g, NodeOp.load, [addNode(g, NodeOp.nilEffect, []), pointer, offset], Types.u32)
        }
        const bit = addNode(g, NodeOp.and, [addNode(g, NodeOp.ushr, [word, value], Types.u32), { literal: 1 }], Types.bool)
        if (low >= 0 && high < length * 32) {
            putNode(g, id, NodeOp.after, [token, bit], T)
            continue
        }
        let bounded: Operand = addNode(g, NodeOp.lt, [value, { literal: length * 32 }], Types.bool)
        if (!base && low < 0) bounded = addNode(g, NodeOp.and, [bounded, addNode(g, NodeOp.ge, [value, { literal: 0 }], Types.bool)], Types.bool)
        putNode(g, id, NodeOp.after, [token, addNode(g, NodeOp.and, [bounded, bit], Types.bool)], T)
    }
}
