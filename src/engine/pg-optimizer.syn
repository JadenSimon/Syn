"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import * as rt from './rt'
import { Op as RtOp } from './rt'
import { countedLoopShape, expectForm, firstNonOrderingSlot, type Graph, type GraphBlock, type GraphNode } from './lowering2'
import { tailOf, withNodes, copyNodes, addCopy, addGraphBlock, addNode, countIds, countNodes, getBlock, getLiteral, getNode, getOperand, getRef, NodeOp, OrderedValues, putNode, regionUp, within, childRegion, typeOf, type Operand, type GraphRegions, nodeEntries, nodeIds, nodeUsers, getArgIds, getOperands, graphRegions, dirtyIndex, graphIndex, type GraphIndex, spreadsLast } from './graph-node'
import { globals as builtinGlobals } from './builtins'
import { AllocKind, constructorOf, emptyType, fixedField, fixedState, inhabited, regionRets, selfOf, usersOf, type AccessHost, type PlannedUnit, type Type, type ValueTypes } from './value-types'

type Handle = intrinsics.Handle

const Types = intrinsics.Types

export interface ProofScope {
    g: Graph
    regions: GraphRegions
    charge(n: number): void
    skipKey(key: number): void
    proofs: Map<number, boolean>
    segRoots: Map<number, number>
    keyRoots: Map<number, Map<number, number>>
    inlinedRets?: Map<number, number[]>
    rest?: number
    arrivals?: number[][]
    restPrivate?: boolean
    privateKeyRoots?: Map<number, Map<number, number>>
    openKeyRoots?: Map<number, Map<number, number>>
    openProofs?: Map<number, number[] | null>
    guardLengths?: number[]
    arrivalOrders?: Map<number, number[]>
    blockIndex?: Map<number, number>
    preserves?(node: number, key: number, owner: number): boolean
    effectKeyRoots?: Map<number, Map<number, Map<number, number>>>
    setterKeys?: Set<number>
    writesNoKeys?(node: number): boolean
    allocatedLength?(call: number, key: number): number
}

export interface Relation {
    index: number
    length: number
    key: number
    below: boolean
    inclusive?: boolean
}

export const pureRt = new Set<number>([RtOp.typeof, RtOp.toString, RtOp.handleof, RtOp.heapaddr, RtOp.pstackaddr, RtOp.hasPrototype, RtOp.hasProperty, RtOp.nullish, RtOp.paramCount, RtOp.restIndex, RtOp.handleHash, RtOp.stringOf])

export function condition(g: Graph, cond: number, positive: boolean): [number, boolean] {
    let id = cond
    let yes = positive
    for (;;) {
        const n = id ? getNode(g, id) : undefined
        if (!n) return [0, yes]
        if (n.op === NodeOp.after) {
            id = getRef(n, countIds(n) - 1)
            continue
        }
        if (n.op !== NodeOp.select || countIds(n) !== 3) return [id, yes]
        const a = armTruth(g, n, 1)
        const b = armTruth(g, n, 2)
        if (a === undefined || b === undefined) return [id, yes]
        if (a === 0 && b === 1) yes = !yes
        else if (!(a === 1 && b === 0)) return [0, yes]
        id = getRef(n, 0)
    }
}

function armTruth(g: Graph, n: GraphNode, at: number): number | undefined {
    const ref = getRef(n, at)
    if (!ref) return getLiteral(g, n, at)
    const arm = getNode(g, ref)
    if (!arm || arm.op !== NodeOp.literal || typeOf(arm) !== Types.bool) return
    return getLiteral(g, arm, 0)
}

export function fieldOwner(g: Graph, id: number): number {
    const n = id ? getNode(g, id) : undefined
    if (n?.op !== NodeOp.getProp || getRef(n, 2)) return 0
    return getRef(n, 1)
}

function flipped(op: NodeOp, positive: boolean): NodeOp {
    if (positive) return op
    return op === NodeOp.lt ? NodeOp.ge : op === NodeOp.le ? NodeOp.gt : op === NodeOp.gt ? NodeOp.le : op === NodeOp.ge ? NodeOp.lt : op
}

export function relationOf(g: Graph, cond: number, yes: boolean): Relation | undefined {
    const [id, positive] = condition(g, cond, yes)
    if (!id) return undefined
    const n = getNode(g, id)!
    const a = getRef(n, 0)
    const b = getRef(n, 1)
    if (!a || !b) return undefined
    const op = flipped(n.op, positive)
    if (fieldOwner(g, b)) {
        const key = getLiteral(g, getNode(g, b)!, 2)
        if (op === NodeOp.lt) return { index: a, length: b, key, below: true }
        if (op === NodeOp.ge || op === NodeOp.gt) return { index: a, length: b, key, below: false }
    }
    if (fieldOwner(g, a)) {
        const key = getLiteral(g, getNode(g, a)!, 2)
        if (op === NodeOp.gt) return { index: b, length: a, key, below: true }
        if (op === NodeOp.le || op === NodeOp.lt) return { index: b, length: a, key, below: false }
        return undefined
    }
    if (fieldOwner(g, b)) return undefined
    if (op === NodeOp.lt) return { index: a, length: b, key: 0, below: true }
    if (op === NodeOp.le) return { index: a, length: b, key: 0, below: true, inclusive: true }
    return undefined
}

export function inBounds(scope: ProofScope, node: number, index: number, recv: number, key: number): number[] | undefined {
    const g = scope.g
    return crossingsAt(scope, node, key, recv, (cond, yes, token, open) => {
        const rel = relationOf(g, cond, yes)
        if (rel?.below && !rel.key) return token === recv && atMost(scope, index, rel.index) && allocatedAbove(scope, rel.length, token, key, !!rel.inclusive)
        if (!rel?.below || rel.key !== key || !atMost(scope, index, rel.index) || !sameValue(scope, fieldOwner(g, rel.length), recv)) return false
        if (keyRoot(scope, getRef(getNode(g, rel.length)!, 0), key, recv, open) !== token) return false
        if (open) scope.guardLengths!.push(rel.length)
        return true
    }, token => token === recv && allocatedAbove(scope, index, token, key, true))
}

export function constantInBounds(scope: ProofScope, node: number, index: number, recv: number, key: number): number[] | undefined {
    const g = scope.g
    return crossingsAt(scope, node, key, recv, (cond, yes, token, open) => {
        const floor = lengthFloor(g, cond, yes)
        if (!floor || floor[1] <= index) return false
        const length = getNode(g, floor[0])!
        if (getLiteral(g, length, 2) !== key || !sameValue(scope, getRef(length, 1), recv)) return false
        if (keyRoot(scope, getRef(length, 0), key, recv, open) !== token) return false
        if (open) scope.guardLengths!.push(floor[0])
        return true
    })
}

type Holds = (cond: number, yes: boolean, token: number, open: boolean) => boolean
type Guard = (cond: number, yes: boolean, token: number) => boolean

function crossingsAt(scope: ProofScope, node: number, key: number, recv: number, holds: Holds, unguarded?: (token: number) => boolean): number[] | undefined {
    if (provedAt(scope, node, key, recv, holds, false, unguarded)) return []
    const memo = scope.openProofs ??= new Map()
    const known = memo.get(node)
    if (known !== undefined) return known ?? undefined
    memo.set(node, null)
    const lengths: number[] = []
    scope.guardLengths = lengths
    if (!provedAt(scope, node, key, recv, holds, true, unguarded)) return
    const g = scope.g
    const tok = getRef(getNode(g, node)!, 0)
    const root = keyRoot(scope, tok, key, recv, true)
    const calls: number[] = []
    const seen = new Set<number>()
    const single = lengths.length === 1 ? lengths[0] : 0
    if (crossedCalls(scope, tok, single, root, calls, seen) || !single) {
        for (const length of lengths) crossedCalls(scope, getRef(getNode(g, length)!, 0), 0, root, calls, seen)
    }
    memo.set(node, calls)
    return calls
}

function crossedCalls(scope: ProofScope, tok: number, length: number, root: number, calls: number[], seen: Set<number>): boolean {
    const g = scope.g
    let at = tok
    while (at) {
        if (at === length || seen.has(at)) return false
        seen.add(at)
        scope.charge(1)
        if (at === root) return true
        const t = getNode(g, at)!
        if (t.op === NodeOp.startOf && getRef(t, 0) !== g.blocks[0].id) {
            let reached = false
            for (const order of arrivalOrders(scope, getRef(t, 0)) ?? []) {
                if (crossedCalls(scope, order, length, root, calls, seen)) reached = true
            }
            return reached
        }
        if (t.op === NodeOp.inlined) {
            let reached = false
            for (const ret of inlinedRets(scope, at)) {
                if (crossedCalls(scope, getRef(getNode(g, ret)!, 0), length, root, calls, seen)) reached = true
            }
            return reached
        }
        if (!chainPasses(g, t)) return true
        if (t.op === NodeOp.call && !calls.includes(at)) calls.push(at)
        at = getRef(t, 0)
    }
    return true
}

function chainPasses(g: Graph, t: GraphNode): boolean {
    return t.op === NodeOp.getProp || t.op === NodeOp.after || t.op === NodeOp.setProp || t.op === NodeOp.call || (t.op === NodeOp.rt && pureRt.has(getLiteral(g, t, 1)))
}

export function priorRead(scope: ProofScope, read: number, calls: number[], passed: number[], reach: number): number {
    const g = scope.g
    const n = getNode(g, read)!
    const key = getLiteral(g, n, 2)
    const owner = getRef(n, 1)
    const root = keyRoot(scope, getRef(n, 0), key, owner, true)
    let at = getRef(n, 0)
    let steps = 0
    while (at && at !== root && steps < reach) {
        steps++
        scope.charge(1)
        const t = getNode(g, at)!
        if (t.op === NodeOp.getProp && !getRef(t, 2) && getLiteral(g, t, 2) === key && getRef(t, 1) === owner) return at
        if (!chainPasses(g, t)) return 0
        if (t.op === NodeOp.call) calls.push(at)
        if (t.op === NodeOp.getProp) passed.push(at)
        at = getRef(t, 0)
    }
    return 0
}

export function lastOrderedUses(scope: ProofScope): Map<number, number> {
    const g = scope.g
    const users = nodeUsers(g, nodeIds(g))
    scope.charge(countNodes(g))
    const places = new Map<number, number[] | null>()
    const out = new Map<number, number>()
    for (const [value, uses] of users) {
        scope.charge(uses.length)
        const last = lastUse(g, uses, places)
        if (!last) continue
        const start = places.get(last)![0]
        const block = getBlock(g, getRef(getNode(g, start)!, 0))
        if (chainPlace(g, value, places)?.[0] === start || block?.params.includes(value)) out.set(value, last)
    }
    return out
}

function lastUse(g: Graph, uses: [number, number][], places: Map<number, number[] | null>): number {
    let last = 0
    let at: number[] | null = null
    let tied = false
    for (const [u, slot] of uses) {
        const n = getNode(g, u)!
        if (slot === 0 && OrderedValues.has(n.op)) continue
        if (n.op === NodeOp.after && slot < countIds(n) - 1) continue
        const place = OrderedValues.has(n.op) ? chainPlace(g, u, places) : null
        if (!place) return 0
        if (at && place[0] !== at[0]) return 0
        if (at && place[1] === at[1]) tied = true
        if (!at || place[1] > at[1]) {
            last = u
            at = place
            tied = false
        }
    }
    return tied ? 0 : last
}

function chainPlace(g: Graph, id: number, places: Map<number, number[] | null>): number[] | null {
    const path: number[] = []
    let at = id
    let place = places.get(at)
    while (place === undefined) {
        const n = getNode(g, at)
        if (n?.op === NodeOp.startOf) {
            place = [at, 0]
            places.set(at, place)
        } else if (!n || !(OrderedValues.has(n.op) || n.op === NodeOp.after)) {
            place = null
        } else {
            path.push(at)
            at = getRef(n, 0)
            place = places.get(at)
        }
    }
    let i = path.length - 1
    while (i >= 0) {
        if (place) place = [place[0], place[1] + 1]
        places.set(path[i], place)
        i--
    }
    return places.get(id) ?? null
}

function provedAt(scope: ProofScope, node: number, key: number, recv: number, holds: Holds, open: boolean, unguarded?: (token: number) => boolean): boolean {
    const memo = open ? new Map<number, boolean>() : scope.proofs
    const known = memo.get(node)
    if (known !== undefined) return known
    const tok = getRef(getNode(scope.g, node)!, 0)
    const token = keyRoot(scope, tok, key, recv, open)
    const at = (cond: number, yes: boolean, token: number) => holds(cond, yes, token, open)
    const proved = !!unguarded?.(token) || guardedAt(scope, scope.regions.of.get(node) ?? -1, at, token) || guardedBefore(scope, tok, at, token, new Map())
    memo.set(node, proved)
    return proved
}

function lengthFloor(g: Graph, cond: number, yes: boolean): [length: number, floor: number] | undefined {
    const [id, positive] = condition(g, cond, yes)
    if (!id) return
    const n = getNode(g, id)!
    if (n.op === NodeOp.getProp) return positive && lengthRead(g, id) ? [id, 1] : undefined
    const side = fieldOwner(g, getRef(n, 0)) ? 0 : fieldOwner(g, getRef(n, 1)) ? 1 : -1
    if (side < 0 || getRef(n, 1 - side)) return
    const c = getLiteral(g, n, 1 - side)
    if (!Number.isFinite(c)) return
    const nonzero = (n.op === NodeOp.ne && positive) || (n.op === NodeOp.eq && !positive)
    if (nonzero && c === 0 && lengthRead(g, getRef(n, side))) return [getRef(n, side), 1]
    if ((n.op === NodeOp.eq && positive) || (n.op === NodeOp.ne && !positive)) return [getRef(n, side), c]
    let op = flipped(n.op, positive)
    if (side === 1) op = op === NodeOp.lt ? NodeOp.gt : op === NodeOp.le ? NodeOp.ge : op === NodeOp.gt ? NodeOp.lt : op === NodeOp.ge ? NodeOp.le : op
    if (op === NodeOp.gt) return [getRef(n, side), Math.floor(c) + 1]
    if (op === NodeOp.ge) return [getRef(n, side), Math.ceil(c)]
    return
}

function lengthRead(g: Graph, id: number): boolean {
    return !!fieldOwner(g, id) && getLiteral(g, getNode(g, id)!, 2) === heap.arrayLengthKey
}

function guardedBefore(scope: ProofScope, tok: number, holds: Guard, token: number, seen: Map<number, boolean>): boolean {
    const g = scope.g
    let at = tok
    let t = at ? getNode(g, at) : undefined
    while (t && (t.op === NodeOp.getProp || t.op === NodeOp.after || (t.op === NodeOp.rt && pureRt.has(getLiteral(g, t, 1))))) {
        scope.charge(1)
        at = getRef(t, 0)
        t = at ? getNode(g, at) : undefined
    }
    if (t?.op === NodeOp.startOf && getRef(t, 0) !== g.blocks[0].id) return guardedEntry(scope, at, getRef(t, 0), holds, token, seen)
    if (t?.op !== NodeOp.inlined) return false
    const known = seen.get(at)
    if (known !== undefined) return known
    seen.set(at, false)
    const rets = inlinedRets(scope, at)
    let proved = rets.length > 0
    let i = 0
    while (proved && i < rets.length) {
        const ret = rets[i]
        proved = guardedAt(scope, scope.regions.of.get(ret) ?? -1, holds, token) || guardedBefore(scope, getRef(getNode(g, ret)!, 0), holds, token, seen)
        i++
    }
    seen.set(at, proved)
    return proved
}

function guardedEntry(scope: ProofScope, start: number, block: number, holds: Guard, token: number, seen: Map<number, boolean>): boolean {
    const known = seen.get(start)
    if (known !== undefined) return known
    seen.set(start, false)
    const index = blockAt(scope, block)
    const regions = scope.regions
    let entered = 0
    for (const apply of index === undefined ? [] : scope.arrivals?.[index] ?? []) {
        const from = regions.of.get(apply) ?? -1
        if (within(regions, from, regions.roots[index!], scope.charge)) continue
        if (guardedAt(scope, from, holds, token)) {
            entered++
            continue
        }
        const orders = applyOrders(scope, apply) ?? []
        if (!orders.length || !orders.every(order => guardedBefore(scope, order, holds, token, seen))) return false
        entered++
    }
    seen.set(start, entered > 0)
    return entered > 0
}

function guardedAt(scope: ProofScope, from: number, holds: Guard, token: number): boolean {
    const g = scope.g
    const regions = scope.regions
    let at = from
    while (at >= 0) {
        scope.charge(1)
        if (regions.depth[at] > 0 && holds(getRef(getNode(g, regions.origin[at])!, 0), regions.slot[at] === 1, token)) return true
        at = regionUp(regions, at)
    }
    return false
}

function inlinedRets(scope: ProofScope, inlined: number): number[] {
    if (!scope.inlinedRets) {
        scope.inlinedRets = new Map()
        for (const [ret, root] of regionRets(scope.g)) {
            let list = scope.inlinedRets.get(root)
            if (!list) scope.inlinedRets.set(root, list = [])
            list.push(ret)
        }
    }
    return scope.inlinedRets.get(inlined) ?? []
}

function atMost(scope: ProofScope, index: number, bound: number): boolean {
    const g = scope.g
    let at = index
    while (at) {
        let b = bound
        while (b) {
            scope.charge(1)
            if (sameValue(scope, b, at)) return true
            b = offsetBase(g, b, NodeOp.add)
        }
        at = offsetBase(g, at, NodeOp.sub)
    }
    return false
}

function allocatedAbove(scope: ProofScope, bound: number, call: number, key: number, inclusive: boolean): boolean {
    const length = scope.allocatedLength?.(call, key)
    if (!length) return false
    if (!inclusive) return atMost(scope, bound, length)
    const n = getNode(scope.g, length)
    if (n?.op !== NodeOp.add || getRef(n, 1) || !(getLiteral(scope.g, n, 1) >= 1)) return false
    return atMost(scope, bound, getRef(n, 0))
}

function offsetBase(g: Graph, id: number, op: NodeOp): number {
    const n = getNode(g, id)
    if (n?.op !== op || getRef(n, 1) || !(getLiteral(g, n, 1) >= 0)) return 0
    return getRef(n, 0)
}

function sameValue(scope: ProofScope, a: number, ref: number): boolean {
    if (a === ref) return true
    if (!a || !ref) return false
    const g = scope.g
    const m = getNode(g, ref)
    const n = getNode(g, a)
    if (m?.op !== NodeOp.getProp || n?.op !== NodeOp.getProp) return false
    if (!sameValue(scope, getRef(m, 1), getRef(n, 1)) || getRef(m, 2) || getRef(n, 2) || getLiteral(g, m, 2) !== getLiteral(g, n, 2)) return false
    const key = getLiteral(g, m, 2)
    return keyRoot(scope, getRef(m, 0), key, getRef(m, 1)) === keyRoot(scope, getRef(n, 0), key, getRef(n, 1))
}

function keyRoot(scope: ProofScope, tok: number, key: number, owner: number, open = false): number {
    const g = scope.g
    const free = privateObject(scope, owner)
    let memos = free ? scope.privateKeyRoots ??= new Map() : open ? scope.openKeyRoots ??= new Map() : scope.keyRoots
    if (scope.preserves) {
        const owners = scope.effectKeyRoots ??= new Map()
        let keys = owners.get(owner)
        if (!keys) owners.set(owner, keys = new Map())
        memos = keys
    }
    let memo = memos.get(key)
    if (!memo) memos.set(key, memo = new Map())
    const path: number[] = []
    let at = tok
    let root = 0
    for (;;) {
        const known = at ? memo.get(at) : 0
        if (known !== undefined) {
            root = known
            break
        }
        const seg = segRoot(scope, at)
        const t = seg ? getNode(g, seg) : undefined
        const effectFree = t && firstNonOrderingSlot(t) === 1 && scope.preserves?.(seg, key, owner)
        if (effectFree || (t?.op === NodeOp.call && (free || open) && seg !== owner)) {
            scope.charge(1)
            path.push(at)
            at = getRef(t, 0)
            continue
        }
        if (t?.op === NodeOp.startOf && getRef(t, 0) !== g.blocks[0].id) {
            path.push(at)
            root = mergedKeyRoot(scope, seg, getRef(t, 0), key, owner, memo, open)
            break
        }
        const other = t?.op === NodeOp.setProp && !getRef(t, 2) ? getLiteral(g, t, 2) : key
        const accessed = !free && heap.isPrivateName(other as Handle) && !heap.isPrivateName(key as Handle)
        const element = t?.op === NodeOp.setProp && (!!getRef(t, 2) || heap.keyIndex(other as Handle) !== undefined)
        const keyless = element && heap.keyIndex(key as Handle) === undefined && !!scope.writesNoKeys?.(seg)
        if (!keyless && (other === key || accessed || element || scope.setterKeys?.has(other))) {
            root = seg
            break
        }
        scope.charge(1)
        if (!keyless) scope.skipKey(other)
        path.push(at)
        at = getRef(t!, 0)
    }
    let settled = root ? memo.get(root) : undefined
    while (settled !== undefined && settled !== root) {
        root = settled
        settled = memo.get(root)
    }
    for (const q of path) memo.set(q, root)
    return root
}

function mergedKeyRoot(scope: ProofScope, start: number, block: number, key: number, owner: number, memo: Map<number, number>, open: boolean): number {
    const known = memo.get(start)
    if (known !== undefined) return known
    memo.set(start, start)
    const orders = arrivalOrders(scope, block)
    let root = -1
    let agree = !!orders
    let i = 0
    while (agree && i < orders!.length) {
        scope.charge(1)
        const r = keyRoot(scope, orders![i], key, owner, open)
        i++
        if (r === start) continue
        if (root >= 0 && r !== root) agree = false
        root = r
    }
    const merged = agree && root >= 0 ? root : start
    memo.set(start, merged)
    return merged
}

function blockAt(scope: ProofScope, block: number): number | undefined {
    if (!scope.blockIndex) {
        scope.blockIndex = new Map()
        scope.g.blocks.forEach((b, i) => scope.blockIndex!.set(b.id, i))
    }
    return scope.blockIndex.get(block)
}

function arrivalOrders(scope: ProofScope, block: number, entered?: Set<number>): number[] | undefined {
    if (!scope.arrivals) return
    const index = blockAt(scope, block)
    const applies = index === undefined ? undefined : scope.arrivals[index]
    if (!applies || !applies.length) return
    const out: number[] = []
    for (const apply of applies) {
        const orders = applyOrders(scope, apply) ?? enteredOrders(scope, apply, entered ?? new Set([index!]))
        if (!orders || !orders.length) return
        for (const o of orders) out.push(o)
    }
    return out
}

function enteredOrders(scope: ProofScope, apply: number, entered: Set<number>): number[] | undefined {
    const home = scope.regions.blockOf.get(apply)
    if (!home || scope.regions.shared.has(apply) || entered.has(home)) return
    entered.add(home)
    scope.charge(1)
    return arrivalOrders(scope, scope.g.blocks[home].id, entered)
}

export function applyOrders(scope: ProofScope, apply: number): number[] | undefined {
    const g = scope.g
    if (!scope.arrivalOrders) {
        scope.arrivalOrders = new Map()
        for (const [, n] of nodeEntries(g)) {
            if (n.op !== NodeOp.after) continue
            const last = countIds(n) - 1
            const value = getRef(n, last)
            if (getNode(g, value)?.op !== NodeOp.apply) continue
            let list = scope.arrivalOrders.get(value)
            if (!list) scope.arrivalOrders.set(value, list = [])
            for (let k = 0; k < last; k++) list.push(getRef(n, k))
        }
    }
    return scope.arrivalOrders.get(apply)
}

function privateObject(scope: ProofScope, owner: number): boolean {
    if (!owner || owner !== scope.rest) return false
    if (scope.restPrivate === undefined) {
        scope.restPrivate = true
        for (const [user, slot] of usersOf(scope.g).get(owner) ?? []) {
            if (getNode(scope.g, user)?.op !== NodeOp.getProp || slot !== 1) scope.restPrivate = false
        }
    }
    return scope.restPrivate
}

export function segRoot(scope: ProofScope, tok: number): number {
    const g = scope.g
    const path: number[] = []
    let at = tok
    let root = 0
    for (;;) {
        const known = at ? scope.segRoots.get(at) : 0
        if (known !== undefined) {
            root = known
            break
        }
        const t = getNode(g, at)
        const read = t !== undefined && (t.op === NodeOp.getProp || t.op === NodeOp.after || (t.op === NodeOp.rt && pureRt.has(getLiteral(g, t, 1))))
        if (t?.op === NodeOp.inlined) {
            path.push(at)
            root = inlinedRoot(scope, at)
            break
        }
        if (!read) {
            root = at
            break
        }
        scope.charge(1)
        path.push(at)
        at = getRef(t!, 0)
    }
    for (const q of path) scope.segRoots.set(q, root)
    return root
}

function inlinedRoot(scope: ProofScope, inlined: number): number {
    scope.segRoots.set(inlined, inlined)
    let root = 0
    for (const ret of inlinedRets(scope, inlined)) {
        scope.charge(1)
        const r = segRoot(scope, getRef(getNode(scope.g, ret)!, 0))
        if (root && r !== root) return inlined
        root = r
    }
    return root || inlined
}

function hasSetter(proto: Handle, key: Handle): boolean {
    let at = proto
    while (at) {
        const descriptor = heap.getOwnProperty(at, key)
        if (descriptor) return (heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor)).flags & heap.PropFlags.has_setter) !== 0
        at = heap.getPrototypeOf(at)
    }
    return false
}

function stablePrototype(program: ValueTypes, proto: Handle): boolean {
    let at = proto
    while (at) {
        if (!fixedState(program, at)) return false
        at = heap.getPrototypeOf(at)
    }
    return true
}

interface InitializationView {
    nodes: Map<number, Type>
    users: Map<number, [number, number][]>
    regions: ReturnType<typeof graphRegions>
    charge(n: number): boolean
    index: GraphIndex
    proof?: ProofScope
    loops?: InitializationLoop[]
}

function initializationView(g: Graph, program: ValueTypes, instances: number[]): InitializationView {
    const nodes = program.resolve(instances).nodes
    const ids = [...nodeIds(g)]
    let budget = ids.length * 64 + 256
    return {
        nodes,
        index: graphIndex(g),
        users: nodeUsers(g, ids),
        regions: graphRegions(g),
        charge(n: number): boolean {
            budget -= n
            return budget >= 0
        },
    }
}

function plainProperty(g: Graph, n: GraphNode, program: ValueTypes, view: InitializationView, proto: Handle): boolean {
    if (n.op !== NodeOp.getProp) return false
    if (getRef(n, 2)) return false
    const type = view.nodes.get(tailOf(g, getRef(n, 1)))
    if (!type || type.unknown || type.undefined || type.bools || type.literals.length || type.range || type.float) return false
    if (type.strings.length || type.functions.length || type.closures.length || !type.objects.length) return false
    const key = getLiteral(g, n, 2) as Handle
    for (const id of type.objects) {
        if (!view.charge(1)) return false
        const object = program.objects[id]
        if (object.kind === AllocKind.scope) continue
        if (heap.keyIndex(key) !== undefined) return false
        if (object.proto === undefined || object.dynamic || object.native) return false
        if (!stablePrototype(program, object.proto)) return false
        const own = object.state === undefined ? undefined : heap.getPropertyDescriptor(object.state, key)
        const descriptor = own || heap.getPropertyDescriptor(object.proto, key)
        const getter = descriptor && heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor)).flags & heap.PropFlags.has_getter
        if (getter && descriptor !== heap.getPropertyDescriptor(proto, key)) return false
        const name = program.keyNames.get(key)
        if (!descriptor && (name === undefined || !object.fields.has(name))) return false
    }
    return true
}

function isArrayPush(g: Graph, n: GraphNode, view: InitializationView): boolean {
    if (n.op !== NodeOp.call || countIds(n) <= 3 || spreadsLast(n)) return false
    const type = view.nodes.get(tailOf(g, getRef(n, 1)))
    return !!type && !type.unknown && type.functions.length === 1 && type.functions[0] === builtinGlobals.Array.prototype.push
}

function initializationProof(g: Graph, view: InitializationView): ProofScope {
    if (view.proof) return view.proof
    const scope: ProofScope = {
        g, regions: view.regions, arrivals: view.regions.arrivals,
        charge: view.charge, skipKey: () => {}, proofs: new Map(), segRoots: new Map(), keyRoots: new Map(),
        preserves(id: number, key: number, owner: number): boolean {
            const n = getNode(g, id)!
            if (n.op === NodeOp.rt) {
                const op = getLiteral(g, n, 1)
                return op === RtOp.arrayElement || op === RtOp.arrayLiteral || op === RtOp.slice
            }
            if (!isArrayPush(g, n, view)) return false
            const read = view.nodes.get(tailOf(g, owner))
            const written = view.nodes.get(tailOf(g, getRef(n, 2)))
            if (!read || !written || read.unknown || written.unknown || !read.objects.length || !written.objects.length) return false
            return !read.objects.some(object => written.objects.includes(object))
        },
    }
    view.proof = scope
    return scope
}

interface InitializationLoop {
    block: GraphBlock
    entries: number[]
    back: number
    select: number
    stay: number
    compare: GraphNode
    counter: number
    boundSlot: number
}

const arrayBoundOps = new Set([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.convert, NodeOp.trunc, NodeOp.floor, NodeOp.ceil])

interface ArrayPush {
    call: number
    count: number
}

interface ArrayPresizing {
    array: number
    initial: number
    counter: number
    start: number
    clamp: boolean
    bound: Operand
    lifted: Set<number>
    body: ArrayPush[]
    tail: ArrayPush[]
}

function arrivalAfters(g: Graph, users: Map<number, [number, number][]>, apply: number): number[] | undefined {
    const parents = users.get(apply) ?? []
    if (!parents.length) return
    const afters: number[] = []
    for (const [parent, slot] of parents) {
        const n = getNode(g, parent)!
        if (n.op !== NodeOp.after || slot !== countIds(n) - 1) return
        afters.push(parent)
    }
    return afters
}

function blockArrivals(g: Graph, users: Map<number, [number, number][]>, block: number): number[] {
    return (users.get(block) ?? []).filter(([id, slot]) => slot === 0 && getNode(g, id)?.op === NodeOp.apply).map(([id]) => id)
}

function arrayAliases(g: Graph, users: Map<number, [number, number][]>, array: number): Set<number> {
    const aliases = new Set([array])
    for (const alias of aliases) {
        for (const [id, slot] of users.get(alias) ?? []) {
            const n = getNode(g, id)!
            if (n.op === NodeOp.after && slot === countIds(n) - 1) aliases.add(id)
        }
    }
    return aliases
}

function bodyBlock(g: Graph, view: InitializationView, apply: number): number {
    if (view.users.get(apply)?.length) return 0
    const index = view.regions.blockOf.get(apply)
    if (index === undefined) return 0
    const block = g.blocks[index]
    return tailOf(g, block.bodyId) === apply ? block.id : 0
}

function arrayOrdering(g: Graph, view: InitializationView, target: number): (id: number) => boolean {
    const { users, charge } = view
    const visiting = new Set<number>()
    const known = new Map<number, boolean>()
    let assumptions = 0
    function walk(id: number): boolean {
        if (!charge(1)) return false
        if (id === target) return true
        if (!id) return false
        const memo = known.get(id)
        if (memo !== undefined) return memo
        if (visiting.has(id)) {
            assumptions++
            return true
        }
        if (visiting.size >= 256) return false
        const before = assumptions
        visiting.add(id)
        const n = getNode(g, id)!
        let yes = false
        if (n.op === NodeOp.startOf) {
            yes = walk(getRef(n, 0))
        } else if (n.op === NodeOp.block) {
            const entries = blockArrivals(g, users, id)
            yes = entries.length > 0 && entries.every(apply => {
                const afters = arrivalAfters(g, users, apply)
                if (afters) return afters.every(after => getArgIds(getNode(g, after)!).slice(0, -1).some(walk))
                return walk(bodyBlock(g, view, apply))
            })
        } else if (n.op === NodeOp.after) {
            const orders = getArgIds(n).filter(ref => {
                const value = getNode(g, ref)
                return !!value && value.op !== NodeOp.literal && value.op !== NodeOp.param && value.op !== NodeOp.heapHandle && value.op !== NodeOp.void
            })
            yes = orders.some(walk)
        } else if (n.op === NodeOp.select) {
            yes = walk(getRef(n, 0)) || (walk(getRef(n, 1)) && walk(getRef(n, 2)))
        } else if (firstNonOrderingSlot(n) === 1) {
            yes = walk(getRef(n, 0))
        } else if (n.op !== NodeOp.param) {
            yes = getArgIds(n).some(walk)
        }
        visiting.delete(id)
        if (!yes || assumptions === before) known.set(id, yes)
        return yes
    }
    return walk
}

function arrayPushOrder(g: Graph, view: InitializationView, pushes: ArrayPush[]): ArrayPush[] | undefined {
    const ordered: ArrayPush[] = []
    const byCall = new Map(pushes.map(push => [push.call, push]))
    const precedes = new Map<number, Set<number>>()
    for (const push of pushes) {
        const prior = new Set<number>()
        const seen = new Set<number>()
        const work = [getRef(getNode(g, push.call)!, 0)]
        while (work.length) {
            if (!view.charge(1)) return
            const id = work.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            if (byCall.has(id)) {
                prior.add(id)
                continue
            }
            const n = getNode(g, id)!
            if (n.op === NodeOp.after) work.push(...getArgIds(n))
            else if (firstNonOrderingSlot(n) === 1) work.push(getRef(n, 0))
        }
        precedes.set(push.call, prior)
    }
    const remaining = new Map(byCall)
    while (remaining.size) {
        if (!view.charge(remaining.size)) return
        const ready = [...remaining.keys()].filter(id => ![...precedes.get(id)!].some(prior => remaining.has(prior)))
        if (ready.length !== 1) return
        const next = remaining.get(ready[0])!
        if (ordered.length && !arrayOrdering(g, view, ordered[ordered.length - 1].call)(getRef(getNode(g, next.call)!, 0))) return
        ordered.push(next)
        remaining.delete(next.call)
    }
    return ordered
}

function initializationLoop(g: Graph, view: InitializationView, block: GraphBlock): InitializationLoop | undefined {
    if (!view.charge(block.params.length + 1)) return
    const shape = countedLoopShape(g, view.index, block)
    if (shape?.selfApps.length !== 1) return
    const select = tailOf(g, block.bodyId)
    const tail = getNode(g, select)
    if (tail?.op !== NodeOp.select || countIds(tail) !== 3) return
    const back = shape.selfApps[0]
    const stay = tailOf(g, getRef(tail, 1)) === back ? 1 : 2
    if (tailOf(g, getRef(tail, stay)) !== back) return
    const [id, positive] = condition(g, getRef(tail, 0), stay === 1)
    const compare = getNode(g, id)
    if (!compare) return
    const op = flipped(compare.op, positive)
    const boundSlot = op === NodeOp.lt ? 1 : op === NodeOp.gt ? 0 : -1
    if (boundSlot < 0) return
    const counter = block.params.indexOf(tailOf(g, getRef(compare, boundSlot ^ 1)))
    if (counter < 0 || shape.steps[counter] !== 1) return
    return { block, entries: shape.entries.map(([, apply]) => apply), back, select, stay, compare, counter, boundSlot }
}

function initializationLoops(g: Graph, view: InitializationView): InitializationLoop[] {
    if (view.loops) return view.loops
    const loops: InitializationLoop[] = []
    for (const block of g.blocks) {
        const loop = initializationLoop(g, view, block)
        if (loop) loops.push(loop)
    }
    view.loops = loops
    return loops
}

function mandatoryOps(g: Graph, view: InitializationView, loop: InitializationLoop): number[] | undefined {
    const ops: number[] = []
    const visited = new Set<number>()
    let mandatory = true
    function walk(id: number): void {
        if (!view.charge(1)) mandatory = false
        if (!id || visited.has(id) || !mandatory) return
        visited.add(id)
        const n = getNode(g, id)!
        if (n.op === NodeOp.startOf && getRef(n, 0) === loop.block.id) return
        if (n.op === NodeOp.apply) {
            if (id !== loop.back) mandatory = false
            return
        }
        if (n.op === NodeOp.after) {
            for (const ref of getArgIds(n)) walk(ref)
            return
        }
        if (firstNonOrderingSlot(n) !== 1) {
            mandatory = false
            return
        }
        walk(getRef(n, 0))
        ops.push(id)
    }
    walk(getRef(getNode(g, loop.select)!, loop.stay))
    return mandatory ? ops : undefined
}

function constant(g: Graph, n: GraphNode, slot: number): number | undefined {
    const ref = getRef(n, slot)
    if (!ref) return getLiteral(g, n, slot)
    const value = getNode(g, tailOf(g, ref))
    return value?.op === NodeOp.literal ? getLiteral(g, value, 0) : undefined
}

function arrayType(program: ValueTypes, type: Type | undefined, proto: Handle): boolean {
    if (!type || type.unknown || type.undefined) return false
    if (type.bools || type.range || type.float || type.literals.length) return false
    if (type.strings.length || type.functions.length || type.closures.length) return false
    if (!type.objects.length) return false
    return type.objects.every(id => {
        const object = program.objects[id]
        return object.proto === proto && !object.dynamic && !object.native
    })
}

function planArrayPresizing(g: Graph, host: AccessHost, program: ValueTypes, view: InitializationView): ArrayPresizing[] {
    const out: ArrayPresizing[] = []
    const proto = arrayPrototype(host)
    if (!stablePrototype(program, proto)) return out
    const { nodes: types, users, regions } = view
    const isArray = (id: number): boolean => arrayType(program, types.get(tailOf(g, id)), proto)
    const scope = initializationProof(g, view)
    for (const [array, allocation] of nodeEntries(g)) {
        let initial: number
        if (allocation.op === NodeOp.rt && getLiteral(g, allocation, 1) === RtOp.arrayLiteral && !getRef(allocation, 2)) initial = getLiteral(g, allocation, 2)
        else if (allocation.op === NodeOp.call && countIds(allocation) === 3) {
            const callee = getNode(g, tailOf(g, getRef(allocation, 1)))
            const receiver = getNode(g, getRef(allocation, 2))
            if (callee?.op !== NodeOp.heapHandle || getRef(callee, 0)) continue
            if (host.binder.functionOf(getLiteral(g, callee, 0) as u32) !== builtinGlobals.Array) continue
            if (receiver?.op !== NodeOp.heapHandle || countIds(receiver) < 2) continue
            const receiverUses = users.get(getRef(allocation, 2)) ?? []
            if (!receiverUses.every(([user, slot]) => user === array && slot === 2)) continue
            initial = 0
        } else continue
        if (!Number.isSafeInteger(initial) || initial < 0 || !isArray(array)) continue
        if (!view.charge(users.size)) return out
        const aliases = arrayAliases(g, users, array)
        const pushes = new Map<number, ArrayPush>()
        const seeds = new Set<number>()
        const observations = new Set<number>()
        let safe = true
        for (const alias of aliases) {
            for (const [id, slot] of users.get(alias) ?? []) {
                const n = getNode(g, id)!
                if (slot < firstNonOrderingSlot(n) || (n.op === NodeOp.after && slot === countIds(n) - 1)) continue
                if (n.op === NodeOp.rt && getLiteral(g, n, 1) === RtOp.arrayElement && slot === 2) {
                    const index = constant(g, n, 3)
                    if (index === undefined || !Number.isSafeInteger(index) || index < 0 || index >= initial) {
                        safe = false
                        break
                    }
                    seeds.add(id)
                    continue
                }
                if (n.op === NodeOp.getProp && slot === 1 && plainProperty(g, n, program, view, proto) && types.get(id)?.functions.length === 1 && types.get(id)!.functions[0] === builtinGlobals.Array.prototype.push) continue
                if (slot === 2 && isArrayPush(g, n, view)) {
                    pushes.set(id, { call: id, count: countIds(n) - 3 })
                    continue
                }
                observations.add(id)
            }
        }
        if (!safe || !pushes.size) continue
        const observation = {
            charge: view.charge,
            users,
            permits(id: number, n: GraphNode): boolean {
                if (pushes.has(id) || seeds.has(id) || observations.has(id)) return true
                if (n.op === NodeOp.getProp && plainProperty(g, n, program, view, proto)) {
                    const type = types.get(id)
                    if (type?.functions.length === 1 && type.functions[0] === builtinGlobals.Array.prototype.push) return true
                }
                if (firstNonOrderingSlot(n) !== 1) return false
                return getArgIds(n).slice(firstNonOrderingSlot(n)).every(ref => !aliases.has(tailOf(g, ref)))
            },
        }
        const orderedAfter = (from: number, target: number) => unobserved(g, from, target, [...aliases], proto, observation)
        function observedAfter(id: number, target: number): boolean {
            const n = getNode(g, id)!
            const from = firstNonOrderingSlot(n) === 1 ? getRef(n, 0) : id
            return orderedAfter(from, target)
        }
        const seedIndices = new Set([...seeds].map(id => constant(g, getNode(g, id)!, 3)!))
        if (seedIndices.size !== initial) continue
        const straight = arrayPushOrder(g, view, [...pushes.values()])
        if (straight && straight.every(push => regions.of.get(push.call) === regions.of.get(array))
            && [...seeds, array].every(seed => orderedAfter(getRef(getNode(g, straight[0].call)!, 0), seed))
            && [...observations].every(id => observedAfter(id, straight[straight.length - 1].call))) {
            out.push({ array, initial, counter: 0, start: 0, clamp: false, bound: { literal: 0 }, lifted: new Set(), body: [], tail: straight })
            continue
        }
        for (const loop of initializationLoops(g, view)) {
            const { block, select, compare: comparison, stay, boundSlot, counter: index } = loop
            const counter = block.params[index]
            let start: number | undefined
            let entered = true
            for (const id of loop.entries) {
                if (!view.charge(1)) return out
                const value = constant(g, getNode(g, id)!, index + 1)
                if (value === undefined || !Number.isSafeInteger(value) || value < 0 || (start !== undefined && value !== start)) {
                    entered = false
                    break
                }
                start = value
                const afters = arrivalAfters(g, users, id)
                if (!afters?.every(parent => [...seeds, array].every(seed => orderedAfter(parent, seed)))) {
                    entered = false
                    break
                }
            }
            if (!entered) continue
            const ops = mandatoryOps(g, view, loop)
            if (!ops) continue
            const body: ArrayPush[] = []
            for (const id of ops) {
                const push = pushes.get(id)
                if (push) body.push(push)
            }
            if (!body.length || body.some(push => !within(regions, regions.of.get(push.call) ?? -1, childRegion(regions, regions.of.get(select)!, select, stay)))) continue
            const bodyCalls = new Set(body.map(push => push.call))
            const rest = [...pushes.values()].filter(push => !bodyCalls.has(push.call))
            const exitRegion = childRegion(regions, regions.of.get(select)!, select, 3 - stay)
            if (rest.some(push => !within(regions, regions.of.get(push.call) ?? -1, exitRegion))) continue
            const following = arrayPushOrder(g, view, rest)
            if (!following) continue
            const frontier = following.length ? following[following.length - 1].call : 0
            if ([...observations].some(id => !within(regions, regions.of.get(id) ?? -1, childRegion(regions, regions.of.get(select)!, select, 3 - stay)) || (frontier && !observedAfter(id, frontier)))) continue
            const bound = getOperand(g, comparison, boundSlot)
            const boundId = typeof bound === 'number' ? tailOf(g, bound) : 0
            const boundNode = getNode(g, boundId)
            let minimum: number | undefined
            let maximum: number | undefined
            const boundType = boundId ? types.get(boundId) : undefined
            if (!boundId) minimum = maximum = (bound as { literal: number }).literal
            else if (boundNode?.op === NodeOp.literal) minimum = maximum = getLiteral(g, boundNode, 0)
            else {
                const range = integerRange(boundType)
                if (range && range[0] >= 0 && range.every(Number.isSafeInteger)) {
                    minimum = range[0]
                    maximum = range[1]
                }
            }
            if (maximum === undefined && lengthRead(g, boundId) && !aliases.has(getRef(boundNode!, 1)) && isArray(getRef(boundNode!, 1)) && plainProperty(g, boundNode!, program, view, proto)) {
                minimum = 0
                maximum = 0xffffffff
            }
            const perIteration = body.reduce((n, push) => n + push.count, 0)
            const trailing = following.reduce((n, push) => n + push.count, 0)
            if (maximum === undefined || !Number.isSafeInteger(maximum)) continue
            if (maximum < 0 || maximum > 0xffffffff) continue
            const maximumBytes = (initial + Math.max(0, maximum - start!) * perIteration + trailing) * 8
            if (!Number.isSafeInteger(maximumBytes)) continue
            const available = new Map<number, boolean>()
            const lifted = new Set<number>()
            function canLift(ref: number, depth = 0): boolean {
                ref = tailOf(g, ref)
                if (!ref) return true
                const known = available.get(ref)
                if (known !== undefined) return known
                available.set(ref, false)
                if (depth > 8 || block.params.includes(ref)) return false
                const n = getNode(g, ref)!
                let yes = false
                if (n.op === NodeOp.literal || n.op === NodeOp.heapHandle) yes = true
                else if (n.op === NodeOp.param) {
                    const home = g.blocks[regions.paramBlock.get(ref) ?? -1]
                    yes = !!home && arrayOrdering(g, view, home.id)(getRef(allocation, 0))
                } else if (firstNonOrderingSlot(n) === 1) {
                    if (arrayOrdering(g, view, ref)(getRef(allocation, 0))) yes = true
                    else if (lengthRead(g, ref) && isArray(getRef(n, 1)) && plainProperty(g, n, program, view, proto) && canLift(getRef(n, 1), depth + 1)) {
                        const owner = getRef(n, 1)
                        const key = getLiteral(g, n, 2)
                        const root = keyRoot(scope, getRef(n, 0), key, owner)
                        yes = root === keyRoot(scope, getRef(allocation, 0), key, owner)
                        if (frontier) yes &&= root === keyRoot(scope, getRef(getNode(g, frontier)!, 0), key, owner)
                        if (yes) lifted.add(ref)
                    }
                } else if (arrayBoundOps.has(n.op)) {
                    yes = getArgIds(n).every(id => {
                        if (!id) return true
                        const value = types.get(id) ?? types.get(tailOf(g, id))
                        if (!value || value.unknown) return false
                        if (value.objects.length || value.functions.length || value.closures.length) return false
                        return canLift(id, depth + 1)
                    })
                }
                available.set(ref, yes)
                return yes
            }
            if (!canLift(boundId)) continue
            out.push({ array, initial, counter, start: start!, clamp: minimum! < start!, bound, lifted, body, tail: following })
            break
        }
    }
    return out
}

function rewriteArrayPresizing(g: Graph, plans: ArrayPresizing[]): Map<number, number> {
    expectForm(g, 'rewriteArrayPresizing', undefined)
    const indices = new Map<number, number>()
    function constant(value: number): number {
        return addNode(g, NodeOp.literal, [{ literal: value }])
    }
    function add(value: number, amount: number): number {
        return amount ? addNode(g, NodeOp.add, [value, { literal: amount }]) : value
    }
    for (const plan of plans) {
        const allocation = getNode(g, plan.array)!
        let token = getRef(allocation, 0)
        const lifted = new Map<number, number>()
        function lift(ref: number): number {
            ref = tailOf(g, ref)
            const known = lifted.get(ref)
            if (known !== undefined) return known
            const n = getNode(g, ref)!
            let value = ref
            if (n.op === NodeOp.getProp && plan.lifted.has(ref)) {
                const operands = getOperands(g, n)
                operands[0] = token
                value = addCopy(g, n, operands)
                token = value
            } else if (arrayBoundOps.has(n.op)) {
                const operands = getOperands(g, n)
                let i = 0
                while (i < operands.length) {
                    if (getRef(n, i)) operands[i] = lift(getRef(n, i))
                    i++
                }
                value = addCopy(g, n, operands)
            }
            lifted.set(ref, value)
            return value
        }
        const bound = typeof plan.bound === 'number' ? lift(plan.bound) : constant(plan.bound.literal)
        let count = bound
        if (plan.clamp) {
            const greater = addNode(g, NodeOp.gt, [bound, { literal: plan.start }], Types.bool)
            count = addNode(g, NodeOp.select, [greater, addNode(g, NodeOp.sub, [bound, { literal: plan.start }]), { literal: 0 }])
        }
        const perIteration = plan.body.reduce((n, push) => n + push.count, 0)
        const trailing = plan.tail.reduce((n, push) => n + push.count, 0)
        if (perIteration !== 1) count = addNode(g, NodeOp.mul, [count, { literal: perIteration }])
        const loopLength = add(count, plan.initial - (plan.clamp ? 0 : plan.start * perIteration))
        putNode(g, plan.array, NodeOp.rt, [token, { literal: RtOp.arrayLiteral }, add(loopLength, trailing)])
        let offset = plan.initial - plan.start * perIteration
        const base = plan.body.length ? perIteration === 1 ? plan.counter : addNode(g, NodeOp.mul, [plan.counter, { literal: perIteration }]) : 0
        for (const push of plan.body) {
            indices.set(push.call, add(base, offset))
            offset += push.count
        }
        offset = 0
        for (const push of plan.tail) {
            indices.set(push.call, add(loopLength, offset))
            offset += push.count
        }
    }
    if (plans.length) dirtyIndex(g)
    return indices
}

interface FilterCount {
    call: number
    reads: number[]
}

function soleFunction(type: Type | undefined, fn: Function): boolean {
    if (!type || type.unknown || type.undefined || type.null || type.bools || type.range || type.float || type.literals.length) return false
    if (type.objects.length || type.strings.length) return false
    return type.functions.length === 1 && type.functions[0] === fn
}

function inheritedGetter(program: ValueTypes, type: Type, key: Handle, proto: Handle): boolean {
    const descriptor = heap.getPropertyDescriptor(proto, key)
    if (!descriptor || !(heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor)).flags & heap.PropFlags.has_getter)) return false
    const name = program.keyNames.get(key)
    return type.objects.every(id => {
        const object = program.objects[id]
        const own = object.state === undefined ? undefined : heap.getPropertyDescriptor(object.state, key)
        if (own && own !== descriptor) return false
        return name === undefined || !object.fields.has(name)
    })
}

function planFilterCounts(g: Graph, host: AccessHost, program: ValueTypes, view: InitializationView, calls: Set<number>, arrays: ArrayPresizing[]): FilterCount[] {
    const out: FilterCount[] = []
    const proto = arrayPrototype(host)
    if (!stablePrototype(program, proto)) return out
    const lifted = new Set<number>()
    for (const plan of arrays) for (const id of plan.lifted) lifted.add(id)
    for (const call of calls) {
        const n = getNode(g, call)!
        if (countIds(n) < 4 || spreadsLast(n) || !getRef(n, 2) || !getRef(n, 3)) continue
        if (!soleFunction(view.nodes.get(tailOf(g, getRef(n, 1))), builtinGlobals.Array.prototype.filter)) continue
        const receiver = view.nodes.get(tailOf(g, getRef(n, 2)))
        if (!arrayType(program, receiver, proto) || !inheritedGetter(program, receiver!, heap.arrayLengthKey as Handle, proto)) continue
        const reads: number[] = []
        let lengthOnly = true
        for (const alias of arrayAliases(g, view.users, call)) {
            for (const [id, slot] of view.users.get(alias) ?? []) {
                const user = getNode(g, id)!
                if (slot < firstNonOrderingSlot(user) || (user.op === NodeOp.after && slot === countIds(user) - 1)) continue
                if (slot === 1 && lengthRead(g, id) && !lifted.has(id) && plainProperty(g, user, program, view, proto)) reads.push(id)
                else lengthOnly = false
            }
        }
        if (lengthOnly) out.push({ call, reads })
    }
    return out
}

function rewriteFilterCounts(g: Graph, plans: FilterCount[]): void {
    for (const plan of plans) {
        const n = getNode(g, plan.call)!
        const ordering = getOperand(g, n, 0)
        const array = getRef(n, 2)
        const loop = addNode(g, NodeOp.block, [])
        const count = addNode(g, NodeOp.param, [])
        const index = addNode(g, NodeOp.param, [])
        const length = addNode(g, NodeOp.getProp, [addNode(g, NodeOp.startOf, [loop]), array, { literal: heap.arrayLengthKey }], Types.unknown_number)
        const value = addNode(g, NodeOp.getProp, [length, array, index], Types.unknown_number)
        const missing = addNode(g, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }], Types.unknown_number)
        const kept = addNode(g, NodeOp.call, [value, getRef(n, 3), missing, value, index, array], Types.unknown_number)
        const next = addNode(g, NodeOp.add, [index, { literal: 1 }], Types.unknown_number)
        const more = addNode(g, NodeOp.add, [count, { literal: 1 }], Types.unknown_number)
        const counted = addNode(g, NodeOp.after, [kept, addNode(g, NodeOp.apply, [loop, more, next])])
        const skipped = addNode(g, NodeOp.after, [kept, addNode(g, NodeOp.apply, [loop, count, next])])
        const done = addNode(g, NodeOp.ret, [addNode(g, NodeOp.after, [length, count]), loop])
        const inside = addNode(g, NodeOp.lt, [index, length], Types.bool)
        const body = addNode(g, NodeOp.select, [inside, addNode(g, NodeOp.select, [kept, counted, skipped]), done])
        addGraphBlock(g, { id: loop, params: [count, index], bodyId: body, bodyConst: 0 })
        const entry = addNode(g, NodeOp.apply, [loop, { literal: 0 }, { literal: 0 }])
        putNode(g, plan.call, NodeOp.inlined, [typeof ordering === 'number' ? addNode(g, NodeOp.after, [ordering, entry]) : entry, { literal: plan.call }])
        for (const read of plan.reads) {
            const r = getNode(g, read)!
            putNode(g, read, NodeOp.after, [getOperand(g, r, 0), getRef(r, 1)])
        }
    }
}

export function rewriteInitializations(program: ValueTypes, host: AccessHost): (g: Graph, instances: number[]) => Graph | undefined {
    return (g, instances) => {
        expectForm(g, 'rewriteInitializations', undefined)
        let allocation = false
        let calls = false
        const counted = new Set<number>()
        for (const [id, n] of nodeEntries(g)) {
            if (n.op === NodeOp.rt && getLiteral(g, n, 1) === RtOp.arrayLiteral) allocation = true
            if (n.op === NodeOp.call) {
                calls = true
                const target = getNode(g, tailOf(g, getRef(n, 1)))
                const receiver = getNode(g, getRef(n, 2))
                if (target?.op === NodeOp.heapHandle && !getRef(target, 0) && receiver?.op === NodeOp.heapHandle) allocation = true
            }
            if (!lengthRead(g, id)) continue
            const owner = tailOf(g, getRef(n, 1))
            if (getNode(g, owner)?.op === NodeOp.call) counted.add(owner)
        }
        const presize = allocation && calls
        if (!presize && !counted.size) return
        const view = initializationView(g, program, instances)
        const arrays = presize ? planArrayPresizing(g, host, program, view) : []
        const filters = counted.size ? planFilterCounts(g, host, program, view, counted, arrays) : []
        if (!view.charge(0) || (!arrays.length && !filters.length)) return
        const graph = withNodes(g, copyNodes(g))
        const pushes = rewriteArrayPresizing(graph, arrays)
        for (const [id, index] of pushes) {
            const n = getNode(graph, id)!
            let token = getOperand(graph, n, 0)
            for (let slot = 3; slot < countIds(n); slot++) {
                const at = slot === 3 ? index : addNode(graph, NodeOp.add, [index, { literal: slot - 3 }])
                token = addNode(graph, NodeOp.rt, [token, { literal: RtOp.arrayElement }, getOperand(graph, n, 2), at, getOperand(graph, n, slot)])
            }
            const length = addNode(graph, NodeOp.add, [index, { literal: countIds(n) - 3 }])
            putNode(graph, id, NodeOp.after, [token, length])
        }
        rewriteFilterCounts(graph, filters)
        dirtyIndex(graph)
        return graph
    }
}

export function initializer(g: Graph, proto: Handle): boolean {
    const self = selfOf(g)
    if (!self) return false
    for (const [id, n] of nodeEntries(g)) {
        if (n.op === NodeOp.call || n.op === NodeOp.static || n.op === NodeOp.inlined) return false
        if (n.op === NodeOp.rt && rt.sliceOf(g, n) === undefined && !pureRt.has(getLiteral(g, n, 1))) return false
        for (let slot = 0; slot < countIds(n); slot++) {
            if (getRef(n, slot) !== self) continue
            if (n.op === NodeOp.setProp && slot === 1 && !getRef(n, 2) && !hasSetter(proto, getLiteral(g, n, 2) as Handle)) continue
            if (n.op === NodeOp.after && slot === countIds(n) - 1) continue
            if (n.op === NodeOp.ret && slot === 0) continue
            return false
        }
    }
    return true
}

export function killedAfter(g: Graph, call: number, allocated: number, key: Handle, proto: Handle, self: boolean, regionOf: (id: number) => number | undefined): boolean {
    const c = getNode(g, call)
    if (c?.op !== NodeOp.call || tailOf(g, getRef(c, 2)) !== allocated) return false
    const objects = self ? [allocated, call] : [allocated]
    const region = regionOf(call)
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.setProp || getRef(n, 2) || getLiteral(g, n, 2) !== key) continue
        if (!objects.includes(tailOf(g, getRef(n, 1)))) continue
        if (regionOf(id) !== region) continue
        if (unobserved(g, getRef(n, 0), call, objects, proto)) return true
    }
    return false
}

function unobserved(g: Graph, from: number, call: number, objects: number[], proto: Handle, proof?: {
    charge(n: number): boolean | void
    permits(id: number, n: GraphNode): boolean
    users?: Map<number, [number, number][]>
}): boolean {
    const known = new Map<number, boolean>()
    const visiting = new Set<number>()
    let safe = true
    let assumptions = 0
    function walk(id: number): boolean {
        if (proof?.charge(1) === false) return false
        if (id === call) return true
        if (!id || !safe) return false
        const memo = known.get(id)
        if (memo !== undefined) return memo
        if (visiting.has(id)) {
            assumptions++
            return true
        }
        if (visiting.size >= 256) return false
        const n = getNode(g, id)
        if (!n) return false
        const before = assumptions
        visiting.add(id)
        let reached = false
        if (n.op === NodeOp.startOf) {
            const users = proof?.users
            const arrivals = users ? blockArrivals(g, users, getRef(n, 0)) : []
            reached = arrivals.length > 0 && arrivals.every(apply => !!arrivalAfters(g, users!, apply)?.every(walk))
        } else if (n.op === NodeOp.after) {
            let slot = 0
            while (slot < countIds(n) - 1) {
                if (walk(getRef(n, slot))) reached = true
                slot++
            }
        } else if (proof?.permits(id, n)) {
            reached = walk(getRef(n, 0))
        } else {
            const escapes = (at: number) => !!getRef(n, at) && objects.includes(tailOf(g, getRef(n, at)))
            const own = escapes(1)
            if (n.op === NodeOp.setProp) {
                if (escapes(3)) safe = false
                if (own && (getRef(n, 2) || hasSetter(proto, getLiteral(g, n, 2) as Handle))) safe = false
            } else if (n.op === NodeOp.getProp) {
                if (own) safe = false
            } else if (n.op === NodeOp.store) {
                if (escapes(3)) safe = false
            } else if (n.op === NodeOp.rt && rt.sliceOf(g, n) !== undefined) {
                if (escapes(4)) safe = false
            } else if (n.op !== NodeOp.load && n.op !== NodeOp.pstack) safe = false
            if (safe) reached = walk(getRef(n, 0))
        }
        visiting.delete(id)
        if (!reached || assumptions === before) known.set(id, reached)
        return reached
    }
    const reached = walk(from)
    return safe && reached
}

export enum ValueKind {
    undef = 1,
    int = 2,
    float = 4,
    text = 8,
    other = 16,
}

export interface DynamicView {
    accesses(visit: (site: number, store: boolean, keyed: boolean, object: number, key: number, value: number) => void): void
    origins(slot: number): number[]
    kinds(slot: number): number
    candidate(origin: number): boolean
    text(origin: number): boolean
    allocSlots(origin: number): number[]
    bind(slot: number, fn: Function, params: intrinsics.Types[]): void
}

function accessor(view: DynamicView, dynamic: Set<number>, slot: number, store: boolean): [Function, intrinsics.Types[]] | undefined {
    if (store && slot < 0) return [heap.deleteHandleProperty, [Types.u32, Types.u32]]
    const kinds = view.kinds(slot)
    if (kinds & ValueKind.other) return undefined
    let handles = (kinds & ValueKind.text) !== 0
    for (const origin of view.origins(slot)) {
        if (!view.text(origin) && !dynamic.has(origin)) return undefined
        handles = true
    }
    const numbers = (kinds & (ValueKind.int | ValueKind.float)) !== 0
    if (numbers && (handles || (store && (kinds & ValueKind.undef)))) return undefined
    if (!numbers) return store ? [heap.setHandleProperty, [Types.u32, Types.u32, Types.u32]] : [heap.getHandleProperty, [Types.u32, Types.u32]]
    if (kinds & ValueKind.float) return store ? [heap.setFloatProperty, [Types.u32, Types.u32, Types.f64]] : [heap.getFloatProperty, [Types.u32, Types.u32]]
    return store ? [heap.setIntProperty, [Types.u32, Types.u32, Types.i64]] : [heap.getIntProperty, [Types.u32, Types.u32]]
}

export function markDynamic(view: DynamicView): Set<number> {
    const dynamic = new Set<number>()
    const stored = new Map<number, number[]>()
    const sites: number[] = []
    const work: number[] = []
    const mark = (origin: number) => {
        if (dynamic.has(origin) || !view.candidate(origin)) return
        dynamic.add(origin)
        work.push(origin)
    }
    view.accesses((site, store, keyed, object, key, value) => {
        sites.push(site, store ? 1 : 0, object, value)
        if (store) {
            for (const origin of view.origins(object)) {
                let list = stored.get(origin)
                if (!list) stored.set(origin, list = [])
                list.push(value)
            }
        }
        if (!keyed) return
        if (!(view.kinds(key) & ~(ValueKind.int | ValueKind.float)) && !view.origins(key).length) return
        for (const origin of view.origins(object)) mark(origin)
    })
    while (work.length) {
        const origin = work.pop()!
        for (const value of stored.get(origin) ?? []) {
            for (const inner of view.origins(value)) mark(inner)
        }
    }
    if (!dynamic.size) return dynamic
    for (const origin of dynamic) {
        for (const slot of view.allocSlots(origin)) view.bind(slot, heap.makePlainObject, [])
    }
    for (let i = 0; i < sites.length; i += 4) {
        if (!view.origins(sites[i + 2]).some(origin => dynamic.has(origin))) continue
        const chosen = accessor(view, dynamic, sites[i + 3], sites[i + 1] === 1)
        if (chosen) view.bind(sites[i], chosen[0], chosen[1])
    }
    return dynamic
}

export interface MethodView {
    calls(visit: (unit: number, member: number, receiver: number, key: number) => void): void
    numberOnly(receiver: number): boolean
    method(key: number): boolean
}

export function numberPrototype(host: AccessHost): Handle {
    return heap.deref(heap.getPrototypeProperty(heap.deref(host.session.linkFunction(builtinGlobals.Number) as Handle)))
}

export function arrayPrototype(host: AccessHost): Handle {
    return heap.deref(heap.getPrototypeProperty(heap.deref(host.session.linkFunction(builtinGlobals.Array) as Handle)))
}

export function objectPrototype(host: AccessHost): Handle {
    return heap.deref(heap.getPrototypeProperty(heap.deref(host.session.linkFunction(builtinGlobals.Object) as Handle)))
}

export function dataMethod(proto: Handle, key: number): number {
    const addr = heap.getPropertyDescriptor(proto, key as Handle)
    if (!addr) return -1
    const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
    if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return -1
    return desc.slot0
}

export function numberMembers(view: MethodView): [unit: number, member: number][] {
    const verdicts = new Map<number, Map<number, boolean>>()
    view.calls((unit, member, receiver, key) => {
        let verdict = verdicts.get(unit)
        if (!verdict) verdicts.set(unit, verdict = new Map())
        const number = view.numberOnly(receiver) && view.method(key)
        verdict.set(member, (verdict.get(member) ?? true) && number)
    })
    const out: [unit: number, member: number][] = []
    for (const [unit, verdict] of verdicts) {
        for (const [member, number] of verdict) {
            if (number) out.push([unit, member])
        }
    }
    return out
}

export interface SetTest {
    keys: number[]
    low: number
    high: number
}

export type SetUse = 'construct' | 'lookup' | SetTest

const maxSetKey = 256

function stableMethod(types: ValueTypes, host: AccessHost, proto: Handle | undefined, key: Handle, method: Function): boolean {
    let at = proto
    while (at) {
        if (!fixedField(types, at, key) || !fixedField(types, at, heap.protoSlotKey)) return false
        const descriptor = heap.getOwnProperty(at, key)
        if (descriptor) {
            const property = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
            if (property.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return false
            return host.binder.functionOf(property.slot0 as u32) === method
        }
        at = heap.getPrototypeOf(at)
    }
    return false
}

function smallKeys(values: number[]): boolean {
    for (const value of values) {
        if (!Number.isInteger(value) || value < 0 || value >= maxSetKey) return false
    }
    return true
}

function setContents(types: ValueTypes, host: AccessHost, g: Graph, id: number, iterator: Handle): number[] | undefined {
    const call = getNode(g, id)!
    const arrayIterator = builtinGlobals.Array.prototype[Symbol.iterator]
    const array = tailOf(g, getRef(call, 3))
    const n = getNode(g, array)
    if (n?.op === NodeOp.heapHandle && !getRef(n, 0)) {
        const state = heap.deref(getLiteral(g, n, 0) as Handle)
        const elements = host.constantElements?.(state)
        if (!elements || elements.length > maxSetKey || !fixedState(types, state) || !elements.every(heap.isBoxedF64)) return
        if (!stableMethod(types, host, heap.getPrototypeOf(state), iterator, arrayIterator)) return
        const values = elements.map(heap.unboxF64)
        return smallKeys(values) ? values : undefined
    }
    if (n?.op !== NodeOp.rt || getLiteral(g, n, 1) !== RtOp.arrayLiteral || getRef(n, 2)) return
    const arrayProto = arrayPrototype(host)
    if (!stableMethod(types, host, arrayProto, iterator, arrayIterator)) return
    const size = getLiteral(g, n, 2)
    if (!Number.isInteger(size) || size < 0 || size > maxSetKey) return
    const values: number[] = []
    const elements = new Set<number>()
    let token = getRef(call, 0)
    let i = size - 1
    while (i >= 0) {
        const element = getNode(g, token)
        if (element?.op !== NodeOp.rt || getLiteral(g, element, 1) !== RtOp.arrayElement || getRef(element, 2) !== array) return
        if (getRef(element, 3) || getLiteral(g, element, 3) !== i || getRef(element, 4)) return
        values.push(getLiteral(g, element, 4))
        elements.add(token)
        token = getRef(element, 0)
        i--
    }
    if ((size > 0 && token !== array) || !smallKeys(values)) return
    for (const [user, slot] of usersOf(g).get(array) ?? []) {
        if (slot < firstNonOrderingSlot(getNode(g, user)!)) continue
        if (elements.has(user) && slot === 2) continue
        if (user === id && slot === 3) continue
        return
    }
    return values
}

function internKeys(interned: Map<string, number[]>, values: number[]): number[] {
    const keys = [...new Set(values)].sort((x, y) => x - y)
    const name = keys.join()
    const known = interned.get(name)
    if (known) return known
    interned.set(name, keys)
    return keys
}

function keyWords(keys: number[], base: number, length: number): number[] {
    const words: number[] = Array(length).fill(0)
    for (const key of keys) {
        const at = (key - base) >>> 5
        words[at] = (words[at] | (1 << ((key - base) & 31))) >>> 0
    }
    return words
}

function onlySets(type: Type | undefined, bits: Map<number, number[]>): boolean {
    if (!type || type.unknown || type.undefined || type.bools || type.float || type.range || type.literals.length || type.strings.length || type.functions.length || type.closures.length) return false
    return type.objects.length > 0 && type.objects.every(o => bits.has(o))
}

function integerRange(type: Type | undefined): [low: number, high: number] | undefined {
    if (!type || type.unknown || type.undefined || type.bools || type.float || type.objects.length || type.strings.length || type.functions.length || type.closures.length) return
    if (!type.range && !type.literals.length) return
    let low = type.range ? type.range[0] : Infinity
    let high = type.range ? type.range[1] : -Infinity
    for (const literal of type.literals) {
        if (!Number.isInteger(literal)) return
        low = Math.min(low, literal)
        high = Math.max(high, literal)
    }
    return [low, high]
}

function opaqueNode(g: Graph, unit: PlannedUnit, id: number, n: GraphNode, nodes: Map<number, Type>, host: AccessHost): boolean {
    if (n.op === NodeOp.call) {
        if (getNode(g, getRef(n, 1))?.op === NodeOp.syscallTarget) return false
        const callee = nodes.get(getRef(n, 1))
        return !unit.calls.has(id) || !callee || callee.unknown || callee.functions.some(fn => !host.binder.traceable(fn))
    }
    if (unit.calls.has(id)) return false
    if (n.op === NodeOp.static) return true
    if (n.op !== NodeOp.rt) return false
    const op = getLiteral(g, n, 1)
    return !rt.shallowOps.has(op) && !rt.allocOps.has(op) && !rt.targetWriteOps.has(op) && rt.sliceOf(g, n) === undefined && op !== RtOp.assign
}

function exposedObjects(types: ValueTypes, host: AccessHost, units: PlannedUnit[], roots: Function[], skip: (fn: Function) => boolean): Set<number> {
    const exposed: number[] = []
    const rootSet = new Set(roots)
    for (const instance of types.instances) {
        if (!rootSet.has(instance.unit)) continue
        for (const id of instance.returns.objects) exposed.push(id)
        for (const id of instance.returns.closures) exposed.push(id)
    }
    for (const unit of units) {
        if (skip(unit.fn)) continue
        const g = host.binder.graphOf(unit.fn)
        const nodes = types.resolve(unit.instances).nodes
        for (const [id, n] of nodeEntries(g)) {
            if (!opaqueNode(g, unit, id, n, nodes, host)) continue
            for (let slot = firstNonOrderingSlot(n); slot < countIds(n); slot++) {
                const type = nodes.get(getRef(n, slot))
                if (!type) continue
                for (const o of type.objects) exposed.push(o)
                for (const o of type.closures) exposed.push(o)
            }
        }
    }
    const reached = new Set(exposed)
    while (exposed.length) {
        const object = types.objects[exposed.pop()!]
        for (const field of object.fields.values()) {
            for (const id of field.type.objects.concat(field.type.closures)) {
                if (reached.has(id)) continue
                reached.add(id)
                exposed.push(id)
            }
        }
    }
    return reached
}

export function planSmallSets(types: ValueTypes, host: AccessHost, units: Iterable<PlannedUnit>, roots: Function[]): Map<PlannedUnit, Map<number, SetUse>> {
    const out = new Map<PlannedUnit, Map<number, SetUse>>()
    if (intrinsics.argv().includes('no-small-sets')) return out
    const ctor = builtinGlobals.Set
    if (!types.instances.some(instance => instance.unit === ctor)) return out
    const has = ctor.prototype.has
    const hasKey = heap.fromJsString('has')
    const iterator = host.session.fromJsValue(Symbol.iterator) as Handle
    const interned = new Map<string, number[]>()
    const bits = new Map<number, number[]>()
    const rejected = new Set<number>()
    for (const instance of types.instances) {
        if (instance.unit !== ctor) continue
        const objects = instance.params.find(p => p.receiver)?.type.objects ?? []
        for (const site of instance.sites) {
            if (site.instance === undefined) continue
            const g = host.binder.graphOf(site.unit)
            const call = getNode(g, site.node)!
            const values = call.op === NodeOp.call && countIds(call) === 4 ? setContents(types, host, g, site.node, iterator) : undefined
            const known = values && internKeys(interned, values)
            for (const object of objects) {
                if (!known || (bits.has(object) && bits.get(object) !== known) || !stableMethod(types, host, types.objects[object].proto, hasKey, has)) rejected.add(object)
                else bits.set(object, known)
            }
        }
    }
    for (const object of rejected) bits.delete(object)
    if (!bits.size) return out
    const scanned = [...units]
    const reached = exposedObjects(types, host, scanned, roots, fn => fn === ctor || fn === has)
    const uses: [unit: PlannedUnit, node: number, use: SetUse, objects: number[]][] = []
    for (const unit of scanned) {
        if (unit.fn === ctor || unit.fn === has) continue
        const g = host.binder.graphOf(unit.fn)
        const nodes = types.resolve(unit.instances).nodes
        const aliases = new Map<number, number[]>()
        for (const [node, type] of nodes) {
            const objects = type.objects.filter(o => bits.has(o))
            if (objects.length) aliases.set(node, objects)
        }
        for (const [id, n] of nodeEntries(g)) {
            const opaque = opaqueNode(g, unit, id, n, nodes, host)
            if (!aliases.size || n.op === NodeOp.after || n.op === NodeOp.apply || n.op === NodeOp.select || n.op === NodeOp.ret) continue
            const involved = new Set<number>()
            for (let slot = firstNonOrderingSlot(n); slot < countIds(n); slot++) {
                for (const object of aliases.get(getRef(n, slot)) ?? []) involved.add(object)
            }
            if (!involved.size) continue
            const objects = [...involved]
            if (n.op === NodeOp.getProp) {
                const target = nodes.get(id)
                let called = true
                for (const [user, slot] of usersOf(g).get(id) ?? []) {
                    const u = getNode(g, user)!
                    if (slot >= firstNonOrderingSlot(u) && (u.op !== NodeOp.call || slot !== 1 || getRef(u, 2) !== getRef(n, 1))) called = false
                }
                if (called && target && !target.unknown && !target.objects.length && target.functions.length === 1 && target.functions[0] === has) {
                    uses.push([unit, id, 'lookup', objects])
                    continue
                }
            }
            const targets = n.op === NodeOp.call && !opaque ? unit.calls.get(id) : undefined
            if (targets) {
                let ctors = 0
                let lookups = 0
                for (const target of targets) {
                    if (target.fn === ctor) ctors++
                    else if (target.fn === has) lookups++
                }
                if (ctors === targets.size && onlySets(nodes.get(getRef(n, 2)), bits)) {
                    uses.push([unit, id, 'construct', objects])
                    continue
                }
                if (lookups === targets.size && onlySets(nodes.get(getRef(n, 2)), bits)) {
                    const known = bits.get(objects[0])!
                    const literal = getLiteral(g, n, 3)
                    const range = getRef(n, 3) ? integerRange(nodes.get(getRef(n, 3))) : Number.isInteger(literal) ? [literal, literal] : undefined
                    if (range && countIds(n) === 4 && objects.every(o => bits.get(o) === known)) {
                        uses.push([unit, id, { keys: known, low: range[0], high: range[1] }, objects])
                        continue
                    }
                }
                if (!ctors && !lookups) continue
            }
            for (const object of objects) rejected.add(object)
        }
    }
    for (const object of bits.keys()) {
        if (reached.has(object)) rejected.add(object)
    }
    const linked = new Map<number, number[][]>()
    for (const [, , , objects] of uses) {
        if (objects.length < 2) continue
        for (const object of objects) {
            const list = linked.get(object)
            if (list) list.push(objects)
            else linked.set(object, [objects])
        }
    }
    const pending = [...rejected]
    while (pending.length) {
        for (const objects of linked.get(pending.pop()!) ?? []) {
            for (const object of objects) {
                if (rejected.has(object)) continue
                rejected.add(object)
                pending.push(object)
            }
        }
    }
    for (const [unit, node, use, objects] of uses) {
        if (objects.some(o => rejected.has(o))) continue
        let nodes = out.get(unit)
        if (!nodes) out.set(unit, nodes = new Map())
        nodes.set(node, use)
    }
    return out
}

export function rewriteSmallSets(g: Graph, uses: Map<number, SetUse>, wordsSlot: (words: number[]) => number): void {
    for (const [id, use] of uses) {
        const n = getNode(g, id)!
        const T = typeOf(n)
        const token = getOperand(g, n, 0)
        if (use === 'construct') {
            putNode(g, id, NodeOp.after, [token, getOperand(g, n, 2)], T)
            continue
        }
        if (use === 'lookup') {
            putNode(g, id, NodeOp.after, [token, { literal: 0 }], T)
            continue
        }
        const keys = use.keys
        let top = keys.length ? keys[keys.length - 1] : 0
        const base = top >= 32 && use.low < 0 ? keys[0] : 0
        if (top - base >= 32 && use.low >= 0) top = Math.max(top, Math.min(use.high, maxSetKey - 1))
        let length = 1
        while (length * 32 <= top - base) length *= 2
        const words = keyWords(keys, base, length)
        const low = use.low - base
        const high = use.high - base
        const input = getOperand(g, n, 3)
        const value = base ? addNode(g, NodeOp.sub, [input, { literal: base }], Types.u64) : input
        let word: Operand = { literal: words[0] }
        if (length > 1) {
            const pointer = addNode(g, NodeOp.poolEntry, [{ literal: wordsSlot(words) }], Types.u64)
            const index = addNode(g, NodeOp.ushr, [value, { literal: 3 }], Types.u64)
            const offset = addNode(g, NodeOp.and, [index, { literal: (length - 1) * 4 }], Types.u64)
            word = addNode(g, NodeOp.load, [addNode(g, NodeOp.startOf, []), pointer, offset], Types.u32)
        }
        const bit = addNode(g, NodeOp.and, [addNode(g, NodeOp.ushr, [word, value], Types.u32), { literal: 1 }], Types.bool)
        if (low >= 0 && high < length * 32) {
            putNode(g, id, NodeOp.after, [token, bit], T)
            continue
        }
        let bounded: Operand = addNode(g, NodeOp.lt, [value, { literal: length * 32 }], Types.bool)
        if (!base && low < 0) bounded = addNode(g, NodeOp.and, [bounded, addNode(g, NodeOp.ge, [value, { literal: 0 }], Types.bool)], Types.bool)
        putNode(g, id, NodeOp.after, [token, addNode(g, NodeOp.and, [bounded, bit], Types.bool)], T)
    }
}

export type MissedLookup = 'false' | 'undefined'

function numbersMeet(a: Type, b: Type): boolean {
    const numeric = (t: Type) => t.float || t.range !== undefined || t.literals.length > 0
    if (!numeric(a) || !numeric(b)) return false
    if (a.float || b.float) return true
    if (a.range && b.range && a.range[0] <= b.range[1] && b.range[0] <= a.range[1]) return true
    const inRange = (x: number, t: Type) => t.range !== undefined && Number.isInteger(x) && x >= t.range[0] && x <= t.range[1]
    for (const x of a.literals) {
        if (inRange(x, b)) return true
        if (b.literals.some(y => x === y || (x !== x && y !== y))) return true
    }
    for (const y of b.literals) if (inRange(y, a)) return true
    return false
}

function stringsMeet(a: Type, b: Type): boolean {
    if (!a.strings.length || !b.strings.length) return false
    if (a.strings.includes(0) || b.strings.includes(0)) return true
    const texts = new Set(a.strings.map(h => heap.stringToJs(h as Handle)))
    return b.strings.some(h => texts.has(heap.stringToJs(h as Handle)))
}

function lookupMisses(key: Type, stored: Type): boolean {
    if (key.unknown || stored.unknown) return false
    if (key.undefined && stored.undefined) return false
    if (key.bools & stored.bools) return false
    if (numbersMeet(key, stored) || stringsMeet(key, stored)) return false
    const callable = (t: Type) => t.functions.length > 0 || t.closures.length > 0
    if (callable(key) && (callable(stored) || stored.objects.length)) return false
    if (callable(stored) && key.objects.length) return false
    return !key.objects.some(o => stored.objects.includes(o))
}

export function planMissedLookups(types: ValueTypes, host: AccessHost, units: Iterable<PlannedUnit>, roots: Function[], taken: Map<PlannedUnit, Map<number, SetUse>>): Map<PlannedUnit, Map<number, MissedLookup>> {
    const out = new Map<PlannedUnit, Map<number, MissedLookup>>()
    const set = builtinGlobals.Set
    const map = builtinGlobals.Map
    if (!types.instances.some(instance => instance.unit === set || instance.unit === map)) return out
    const methods = new Map<Function, MissedLookup>([[set.prototype.has, 'false'], [set.prototype.delete, 'false'], [map.prototype.has, 'false'], [map.prototype.get, 'undefined'], [map.prototype.delete, 'false']])
    const classes = new Map<Handle, boolean>()
    const builtinClass = (proto: Handle): boolean => {
        let known = classes.get(proto)
        if (known === undefined) {
            const ctor = constructorOf(proto, host)
            known = ctor === set || ctor === map
            classes.set(proto, known)
        }
        return known
    }
    const storedOf = (id: number): Type | undefined => {
        const object = types.objects[id]
        if (!object.proto || object.constant || !builtinClass(object.proto)) return undefined
        const type = types.instanceArgs[id]?.[0]
        return type && inhabited(type) ? type : undefined
    }
    const scanned = [...units]
    let exposed: Set<number> | undefined
    for (const unit of scanned) {
        const g = host.binder.graphOf(unit.fn)
        let nodes: Map<number, Type> | undefined
        for (const [id, targets] of unit.calls) {
            if (taken.get(unit)?.has(id)) continue
            let use: MissedLookup | undefined
            let mixed = false
            for (const target of targets) {
                const miss = methods.get(target.fn)
                if (!miss || (use !== undefined && use !== miss)) mixed = true
                use = miss
            }
            if (mixed || use === undefined) continue
            const n = getNode(g, id)
            if (n?.op !== NodeOp.call || countIds(n) !== 4) continue
            nodes ??= types.resolve(unit.instances).nodes
            const receiver = nodes.get(getRef(n, 2))
            if (!receiver || receiver.unknown || receiver.undefined || !receiver.objects.length) continue
            const key = getRef(n, 3) ? nodes.get(getRef(n, 3)) : { ...emptyType(), literals: [getLiteral(g, n, 3)] }
            if (!key) continue
            if (!receiver.objects.every(o => {
                const within = storedOf(o)
                return within !== undefined && lookupMisses(key, within)
            })) continue
            exposed ??= exposedObjects(types, host, scanned, roots, fn => fn === set || fn === map)
            if (receiver.objects.some(o => exposed!.has(o))) continue
            let found = out.get(unit)
            if (!found) out.set(unit, found = new Map())
            found.set(id, use)
        }
    }
    return out
}

export function rewriteConstantReads(g: Graph, reads: Map<number, number>): void {
    for (const [id, literal] of reads) {
        const n = getNode(g, id)!
        putNode(g, id, NodeOp.after, [getOperand(g, n, 0), { literal }], typeOf(n))
    }
}

export function rewriteEqualReads(g: Graph, reads: Map<number, number>): void {
    for (const [id, prior] of reads) {
        const n = getNode(g, id)!
        putNode(g, id, NodeOp.after, [getOperand(g, n, 0), prior], typeOf(n))
    }
}

export function rewriteMissedLookups(g: Graph, uses: Map<number, MissedLookup>): void {
    for (const [id, use] of uses) {
        const n = getNode(g, id)!
        const T = typeOf(n)
        const token = getOperand(g, n, 0)
        const value: Operand = use === 'false' ? { literal: 0 } : addNode(g, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
        putNode(g, id, NodeOp.after, [token, value], T)
    }
}
