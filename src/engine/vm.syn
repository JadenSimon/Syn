/// @synth

/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const inRange = intrinsics.inRange
const assert = intrinsics.assert

type usize = u32
type Handle = heap.Handle

export function isVmHandle(value: u32): boolean {
    return (value & 1) !== 0
}

export function tagVmHandle(value: Handle): u32 {
    return ((value << 1) | 1) as u32
}

export function tagVmScalar(value: u32): u32 {
    return (value << 1) as u32
}

export function tagVmValue(value: any, handle: boolean = false): u32 {
    if (intrinsics.getNanId(value)) {
        return tagVmHandle(heap.boxF64(value))
    }
    return handle ? tagVmHandle(value) : tagVmScalar(value)
}

export function vmHandle(value: u32): Handle {
    return (value >>> 1) as Handle
}

export function vmPayload(value: u32): any {
    return isVmHandle(value) ? vmHandle(value) : value >> 1
}

export function vmValue(value: u32): any {
    if (!isVmHandle(value)) return vmPayload(value)
    const handle = vmHandle(value)
    return heap.isBoxedF64(handle) ? heap.unboxF64(handle) : handle
}

export const Op = {
    Mov: 0x00, // TODO: maybe make this Nop...
    Star: 0x01,
    Star0: 0x02, Star1: 0x03, Star2: 0x04, Star3: 0x05,
    Star4: 0x06, Star5: 0x07, Star6: 0x08, Star7: 0x09,
    Star8: 0x0A, Star9: 0x0B, Star10: 0x0C, Star11: 0x0D,
    Star12: 0x0E, Star13: 0x0F, Star14: 0x10, Star15: 0x11,
    StoreFrame: 0x20, MovPacked: 0x21,


    LdaImm: 0x22, LdaZero: 0x23, LdaConst: 0x24, LoadFrame: 0x25,
    LdaUndefined: 0x26, LdaNull: 0x27, LdaTrue: 0x28, LdaFalse: 0x29,
    Ldar: 0x2A, Ldar0: 0x2B, Ldar1: 0x2C, Ldar2: 0x2D, Ldar3: 0x2E,

    Add: 0x30, Sub: 0x31, Mul: 0x32, Div: 0x33, Mod: 0x34, Exp: 0x35,
    BitOr: 0x36, BitAnd: 0x37, BitXor: 0x38,
    ShiftLeft: 0x39, ShiftRight: 0x3A, ShiftRightLogical: 0x3B,
    TestNotStrictEqual: 0x3C, TestStrictEqual: 0x3D,
    TestLessThan: 0x3E, TestGreaterThan: 0x3F,
    TestLessThanOrEqual: 0x40, TestGreaterThanOrEqual: 0x41,
    IncPost: 0x42, DecPost: 0x43, // some specializations

    Inc: 0x4A, Dec: 0x4B, Negate: 0x4C, BitNot: 0x4D, LogicalNot: 0x4E,
    LogicalNotNot: 0x50,

    // FIXME: we need jumps that can read from a separate label table so we can have known-sized emits
    
    Jump: 0x5A, 
    JumpIfNull: 0x5B, JumpIfUndefined: 0x5C, JumpIfNullish: 0x5D, JumpIfToBooleanFalse: 0x5E,
    JumpIfNotNull: 0x5F, JumpIfNotUndefined: 0x60, JumpIfNotNullish: 0x61, JumpIfToBooleanTrue: 0x62, 
    JumpAcc: 0x63, // adds acc (unsigned) to pc
    JumpLabel: 0x64,

    Call: 0x67,
    CallConst: 0x68,
    Construct: 0x69,
    ConstructConst: 0x6A,

    Throw: 0x77, ReThrow: 0x78, // ReThrow won't contribute to the stack trace
    Return: 0x79, ReturnVoid: 0x7A,

    GetProperty: 0x80, SetProperty: 0x81,
    GetPropertyConst: 0x82, SetPropertyConst: 0x83, // keys are in const pool
    GetPropertyImm: 0x84, SetPropertyImm: 0x85, // unsigned, used for arrays

    CreateEmptyObject: 0xA0,
    CreateObjectConst: 0xA1, // loads a template from const pool
    CreateEmptyArray: 0xA2,
    CreateClosure: 0xA3,

    Width2: 0xF0, Width4: 0xF1, Width8: 0xF2,
    Nop: 0xF3,
}

const FRAME_HEADER_SLOTS = 2

export function frameSize(registerCount: u32, extraSlots: u32 = 0): u32 {
    return (FRAME_HEADER_SLOTS + registerCount + extraSlots) * 4
}

export function frameFunction(frame: usize): usize { return frame }
export function frameArg(frame: usize, index: u32): usize { return frame + (1 + index) * 4 }
export function frameRegs(frame: usize): usize { return frameArg(frame, 1) }

export function createInterpreter(nativeMode: boolean, extraFrameSlots: u32 = 0) {
    const constantBytes = nativeMode ? 8 : 4
    const constantType = nativeMode ? Types.u64 : Types.u32
    function regLoadTagged(regs: usize, i: u32): u32 {
        return Intrinsics.load(regs, i * 4, Types.u32)
    }
    function regLoad(regs: usize, i: u32): any {
        return vmValue(regLoadTagged(regs, i))
    }
    function regStoreTagged(regs: usize, i: u32, value: u32): void {
        Intrinsics.store(regs, i * 4, value, Types.u32)
    }
    function regStore(regs: usize, i: u32, value: any, handle: boolean = false): void {
        regStoreTagged(regs, i, tagVmValue(value, handle))
    }
    function toBool(value: u32): boolean {
        if (!isVmHandle(value)) return (value >> 1) as any as boolean
        const v = vmPayload(value)
        if (heap.isBoxedF64(v)) return heap.unboxF64(v) as any as boolean
        return v !== 0
    }
    function fromBool(b: boolean): u32 {
        return b as any as u32
    }
    const frames: [pc: u32, fp: u32][] = []
    function findEh() {
        while (const f = frames.pop()) {
            const callee = Intrinsics.load(frameFunction(f[1]), 0, Types.u32)
            const bc = heap.FunctionBytecode(heap.resolveHeapCell(callee as Handle))
            if (!bc.labels) continue
            const labels = heap.FunctionBytecodeLabels(heap.resolveHeapCell(bc.labels))
            const ehCount = labels.ehRangesCount
            for (let i: u32 = 0; i < ehCount; i++) {
                const range = heap.CoveredRange(heap.resolveHeapCell(labels.ehRanges) + i * heap.CoveredRange.sizeof)
                if (f[0] >= range.start && f[0] <= range.end) {
                    return [f, range.handler] as const
                }
            }
        }
    }
    function interpret(fn: Handle, thisArg: Handle, args: usize, argCount: u32): u32 {
        const nt = Types.u32
        const bc = heap.FunctionBytecode(heap.resolveHeapCell(fn))
        const regCount = bc.registerCount
        const code = heap.resolveHeapCell(bc.bytecode)
        const codeLen = bc.bytecodeLen
        const constants = heap.resolveHeapCell(bc.constants)
        const labels = bc.labels ? heap.FunctionBytecodeLabels(heap.resolveHeapCell(bc.labels)) : undefined
        const frameBytes = frameSize(regCount, extraFrameSlots)
        const frame = Intrinsics.stackalloc(frameBytes)
        Intrinsics.store(frameFunction(frame), 0, fn, Types.u32)
        Intrinsics.store(frameArg(frame, 0), 0, tagVmHandle(thisArg), Types.u32)
        const regs = frameRegs(frame)
        for (let i: u32 = 0; i < argCount; i++) {
            regStoreTagged(regs, i, Intrinsics.load(args, i * 4, Types.u32))
        }

        let acc = tagVmHandle(thisArg)
        let pc: u32 = 0

        function scalar(): any {
            return vmValue(acc)
        }

        function setScalar(value: any): any {
            acc = tagVmValue(value)
            return value
        }

        function setHandle(value: Handle): Handle {
            acc = tagVmHandle(value)
            return value
        }

        function setValue(value: any, handle: boolean = false): any {
            acc = tagVmValue(value, handle)
            return value
        }

        function setTagged(value: u32) {
            acc = value
        }

        function heapAcc(): Handle {
            return isVmHandle(acc) ? vmHandle(acc) : heap.boxF64(vmPayload(acc))
        }

        function loadReg(index: u32) {
            setTagged(regLoadTagged(regs, index))
        }

        function strictEqual(value: u32): boolean {
            const lhsHandle = isVmHandle(acc)
            const rhsHandle = isVmHandle(value)
            const lhs = vmPayload(acc)
            const rhs = vmPayload(value)
            if (lhsHandle && rhsHandle) {
                const lhsBoxed = heap.isBoxedF64(lhs)
                const rhsBoxed = heap.isBoxedF64(rhs)
                if (!lhsBoxed || !rhsBoxed) return lhs === rhs
                return Intrinsics.eq(heap.unboxF64(lhs), heap.unboxF64(rhs), Types.f64, Types.f64)
            }
            if (lhsHandle) {
                if (!heap.isBoxedF64(lhs)) return false
                return Intrinsics.eq(heap.unboxF64(lhs), rhs, Types.f64, nt)
            }
            if (rhsHandle) {
                if (!heap.isBoxedF64(rhs)) return false
                return Intrinsics.eq(lhs, heap.unboxF64(rhs), nt, Types.f64)
            }
            return Intrinsics.eq(lhs, rhs, nt, nt)
        }

        function strictNotEqual(value: u32): boolean {
            const lhsHandle = isVmHandle(acc)
            const rhsHandle = isVmHandle(value)
            const lhs = vmPayload(acc)
            const rhs = vmPayload(value)
            if (lhsHandle && rhsHandle) {
                const lhsBoxed = heap.isBoxedF64(lhs)
                const rhsBoxed = heap.isBoxedF64(rhs)
                if (!lhsBoxed || !rhsBoxed) return lhs !== rhs
                return Intrinsics.ne(heap.unboxF64(lhs), heap.unboxF64(rhs), Types.f64, Types.f64)
            }
            if (lhsHandle) {
                if (!heap.isBoxedF64(lhs)) return true
                return Intrinsics.ne(heap.unboxF64(lhs), rhs, Types.f64, nt)
            }
            if (rhsHandle) {
                if (!heap.isBoxedF64(rhs)) return true
                return Intrinsics.ne(lhs, heap.unboxF64(rhs), nt, Types.f64)
            }
            return Intrinsics.ne(lhs, rhs, nt, nt)
        }

        function nextByte(): u32 {
            intrinsics.assert(pc < codeLen)
            const b = Intrinsics.load(code, pc, Types.u8)
            pc = pc + 1
            return b
        }

        function next2Byte(): u32 {
            intrinsics.assert(pc < codeLen)
            const b = Intrinsics.load(code, pc, Types.u16)
            pc = pc + 2
            return b
        }

        function loadConstantTagged(index: u32): u32 {
            return Intrinsics.load(constants, index * constantBytes, constantType) as u32
        }

        function loadConstantHandle(index: u32): Handle {
            const value = loadConstantTagged(index)
            assert(isVmHandle(value))
            return vmHandle(value)
        }

        function doCall(target: Handle, rargStart: u32, nargs: u32) {
            frames.push([pc, frame])
            const result = Intrinsics.call(target, scalar(), regs + rargStart * 4, nargs, interpret)
            frames.pop()
            setTagged(result)
        }

        function doConstruct(target: Handle, rargStart: u32, nargs: u32) {
            const proto = heap.getPrototypeProperty(target)
            setHandle(heap.makeObject(proto))
            doCall(target, rargStart, nargs)
        }

        function assertSym(val: any) {
            assert(val || intrinsics.getNanId(val))
        }

        function getProperty(obj: Handle, key: Handle): Handle {
            const id = intrinsics.getNanId(obj)
            if (id !== 0) throw `vm: symbolic property receiver ${id} at pc ${pc}`
            if (heap.isArray(obj) && heap.isArrayLengthKey(key)) return heap.arrayLength(obj)
            const addr = heap.getPropertyDescriptor(obj, key)
            if (!addr) {
                const proxy = heap.getPropertyProxy(obj)
               //assertSym(proxy)
                const argv = Intrinsics.stackalloc(8)
                Intrinsics.store(argv, 0, tagVmHandle(obj), Types.u32)
                Intrinsics.store(argv, 4, tagVmHandle(key), Types.u32)
                const result = vmHandle(Intrinsics.call(heap.getProxyGetter(proxy), 0, argv, 2, interpret))
                Intrinsics.stackfree(8)
                return result
            }
            const desc = heap.FullPropertyDescriptor(addr)
            if (!(desc.flags & heap.PropFlags.has_getter)) return desc.slot0
            assertSym(desc.slot0)
            return vmHandle(Intrinsics.call(desc.slot0, obj, regs, 0, interpret))
        }

        function setProperty(obj: Handle, key: Handle, value: Handle): void {
            const id = intrinsics.getNanId(obj)
            if (id !== 0) throw `vm: symbolic property store receiver ${id} at pc ${pc}`
            const addr = heap.getPropertyDescriptor(obj, key)
            if (addr) {
                const desc = heap.FullPropertyDescriptor(addr)
                if (desc.flags & heap.PropFlags.has_setter) {
                    assertSym(desc.slot1)
                    const argv = Intrinsics.stackalloc(4)
                    Intrinsics.store(argv, 0, tagVmHandle(value), Types.u32)
                    Intrinsics.call(desc.slot1, obj, argv, 1, interpret)
                    Intrinsics.stackfree(4)
                    return
                }
                if (desc.flags & heap.PropFlags.has_getter) {
                    throw "todo: throw VM error on readonly property"
                }
            }
            heap.setProperty(obj, key, value)
        }

        function loadConst1Wide() {
            return loadConstantTagged(nextByte())
        }

        function loadConst2Wide() {
            return loadConstantTagged(next2Byte())
        }

        for (;;) {
            pc = Intrinsics.dispatch(pc) // records this decoding step
            const op = nextByte()
            switch (op) {
                case Op.Mov: const rsrc = nextByte(); regStoreTagged(regs, nextByte(), regLoadTagged(regs, rsrc))
                case Op.Star: regStoreTagged(regs, nextByte(), acc)
                case Op.Star0: regStoreTagged(regs, 0, acc)
                case Op.Star1: regStoreTagged(regs, 1, acc)
                case Op.Star2: regStoreTagged(regs, 2, acc)
                case Op.Star3: regStoreTagged(regs, 3, acc)
                case Op.Star4: regStoreTagged(regs, 4, acc)
                case Op.Star5: regStoreTagged(regs, 5, acc)
                case Op.Star6: regStoreTagged(regs, 6, acc)
                case Op.Star7: regStoreTagged(regs, 7, acc)
                case Op.Star8: regStoreTagged(regs, 8, acc)
                case Op.Star9: regStoreTagged(regs, 9, acc)
                case Op.Star10: regStoreTagged(regs, 10, acc)
                case Op.Star11: regStoreTagged(regs, 11, acc)
                case Op.Star12: regStoreTagged(regs, 12, acc)
                case Op.Star13: regStoreTagged(regs, 13, acc)
                case Op.Star14: regStoreTagged(regs, 14, acc)
                case Op.Star15: regStoreTagged(regs, 15, acc)

                case Op.MovPacked: const r = nextByte(); regStoreTagged(regs, r & 0xF, regLoadTagged(regs, r >> 4))
                case Op.StoreFrame:
                    const scope = loadConstantHandle(nextByte())
                    regStoreTagged(frameRegs(Intrinsics.load(scope, 0, Types.u32)), nextByte(), acc)

                case Op.LdaZero: setScalar(0)
                case Op.LdaImm: const n = nextByte(); setScalar(Intrinsics.convert(n, Types.i8, Types.u32)) // sign-extend the signed byte
                case Op.LdaConst: setTagged(loadConst1Wide())
                case Op.LoadFrame:
                    const scope = loadConstantHandle(nextByte())
                    setTagged(regLoadTagged(frameRegs(Intrinsics.load(scope, 0, Types.u32)), nextByte()))
                case Op.LdaUndefined: setHandle(0)
                case Op.LdaNull: setHandle(0)
                case Op.LdaTrue: setScalar(fromBool(true))
                case Op.LdaFalse: setScalar(fromBool(false))

                case Op.Ldar: loadReg(nextByte())
                case Op.Ldar0: loadReg(0)
                case Op.Ldar1: loadReg(1)
                case Op.Ldar2: loadReg(2)
                case Op.Ldar3: loadReg(3)

                case Op.Add: setValue(Intrinsics.add(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.Sub: setValue(Intrinsics.sub(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.Mul: setValue(Intrinsics.mul(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.Div: setValue(Intrinsics.div(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.Mod: setValue(Intrinsics.rem(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.Exp: setValue(Intrinsics.pow(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.BitOr: setValue(Intrinsics.or(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.BitAnd: setValue(Intrinsics.and(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.BitXor: setValue(Intrinsics.xor(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.ShiftLeft: setValue(Intrinsics.shl(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.ShiftRight: setValue(Intrinsics.shr(scalar(), regLoad(regs, nextByte()), nt, nt))
                case Op.ShiftRightLogical: setValue(Intrinsics.ushr(scalar(), regLoad(regs, nextByte()), nt, nt))

                case Op.TestNotStrictEqual: setScalar(fromBool(strictNotEqual(regLoadTagged(regs, nextByte()))))
                case Op.TestStrictEqual: setScalar(fromBool(strictEqual(regLoadTagged(regs, nextByte()))))
                case Op.TestLessThan: setScalar(fromBool(Intrinsics.lt(scalar(), regLoad(regs, nextByte()), nt, nt)))
                case Op.TestGreaterThan: setScalar(fromBool(Intrinsics.gt(scalar(), regLoad(regs, nextByte()), nt, nt)))
                case Op.TestLessThanOrEqual: setScalar(fromBool(Intrinsics.le(scalar(), regLoad(regs, nextByte()), nt, nt)))
                case Op.TestGreaterThanOrEqual: setScalar(fromBool(Intrinsics.ge(scalar(), regLoad(regs, nextByte()), nt, nt)))

                case Op.IncPost:
                    const idx = nextByte()
                    const val = regLoad(regs, idx)
                    regStore(regs, idx, Intrinsics.add(val, 1, nt, nt) as u32)
                    setValue(val)

                case Op.DecPost:
                    const idx = nextByte()
                    const val = regLoad(regs, idx)
                    regStore(regs, idx, Intrinsics.sub(val, 1, nt, nt) as u32)
                    setValue(val)

                case Op.Inc: setValue(Intrinsics.add(scalar(), 1, nt, nt))
                case Op.Dec: setValue(Intrinsics.sub(scalar(), 1, nt, nt))
                case Op.Negate: setValue(Intrinsics.neg(scalar(), nt))
                case Op.BitNot: setValue(Intrinsics.not(scalar(), nt))
                case Op.LogicalNot: setScalar(Intrinsics.eq(scalar(), 0, nt, nt) as any)
                case Op.LogicalNotNot: setScalar(Intrinsics.ne(scalar(), 0, nt, nt) as any)

                case Op.Jump: const off = Intrinsics.convert(nextByte(), Types.i8, Types.u32); pc = Intrinsics.jmp(pc, off)
                case Op.JumpIfNull:
                case Op.JumpIfUndefined:
                case Op.JumpIfNullish:
                case Op.JumpIfToBooleanFalse: const off = Intrinsics.convert(nextByte(), Types.i8, Types.u32); pc = Intrinsics.branch(toBool(acc), pc, pc + off)
                case Op.JumpIfNotNull:
                case Op.JumpIfNotUndefined:
                case Op.JumpIfNotNullish:
                case Op.JumpIfToBooleanTrue: const off = Intrinsics.convert(nextByte(), Types.i8, Types.u32); pc = Intrinsics.branch(toBool(acc), pc + off, pc)
                case Op.JumpAcc: pc = Intrinsics.jmp(pc, scalar())
                case Op.JumpLabel: pc = Intrinsics.jmp(Intrinsics.load(heap.resolveHeapCell(labels!.jumpLabels), nextByte() * 4, Types.u32), 0)

                case Op.Call:
                    const callee = regLoad(regs, nextByte())
                    doCall(callee, nextByte(), nextByte())

                case Op.CallConst:
                    doCall(vmValue(loadConst1Wide()), nextByte(), nextByte())

                case Op.Construct:
                    const callee = regLoad(regs, nextByte())
                    doConstruct(callee, nextByte(), nextByte())

                case Op.ConstructConst:
                    doConstruct(vmValue(loadConst1Wide()), nextByte(), nextByte())

                case Op.Throw:
                case Op.ReThrow:
                    frames.push([pc, frame])
                    if (const eh = findEh()) {
                        if (eh[0][1] === frame) {
                            pc = eh[1]
                        } else {
                            Intrinsics.panic('todo')
                        }
                    } else {
                        if (Intrinsics.canexit(acc)) Intrinsics.panic(scalar())
                        else setHandle(0)
                    }
                    
                case Op.Return:
                    if (!Intrinsics.canexit(acc)) {
                        setHandle(0)
                        continue
                    }
                    Intrinsics.stackfree(frameBytes)
                    return Intrinsics.ret(acc, nt)

                case Op.ReturnVoid:
                    const rv = Intrinsics.voidvalue()
                    const taggedVoid = tagVmValue(rv)
                    if (!Intrinsics.canexit(taggedVoid)) {
                        setHandle(0)
                        continue
                    }
                    Intrinsics.stackfree(frameBytes)
                    return Intrinsics.ret(taggedVoid, nt)

                case Op.CreateEmptyObject: setHandle(heap.makeObject(0))
                case Op.CreateEmptyArray: setHandle(heap.makeArray())
                case Op.CreateClosure: setHandle(heap.makeClosure(vmHandle(loadConst1Wide()), fn, frame))
                // TODO: will create an obj w/ owned properties already set
                // case Op.CreateObjectConst: acc = heap.makeObject(0)

                case Op.GetProperty: setHandle(getProperty(vmHandle(acc), regLoad(regs, nextByte())))
                case Op.SetProperty:
                    const robj = nextByte()
                    const rkey = nextByte()
                    setProperty(regLoad(regs, robj), regLoad(regs, rkey), heapAcc())

                case Op.GetPropertyConst: setHandle(getProperty(vmHandle(acc), vmHandle(loadConst1Wide())))
                case Op.SetPropertyConst:
                    const robj = nextByte()
                    setProperty(regLoad(regs, robj), vmHandle(loadConst1Wide()), heapAcc())

                case Op.GetPropertyImm: setHandle(heap.arrayGet(vmHandle(acc), nextByte()))
                case Op.SetPropertyImm: heap.arraySet(regLoad(regs, nextByte()), nextByte(), heapAcc())

                case Op.Width2:
                    const w2 = nextByte()
                    switch (w2) {
                        case Op.LdaImm: setScalar(Intrinsics.convert(Intrinsics.load(code, pc, Types.i16), Types.i16, Types.u32)); pc = pc + 2
                        case Op.LdaConst: setTagged(loadConstantTagged(Intrinsics.load(code, pc, Types.u16))); pc = pc + 2
                        case Op.Jump: const off = Intrinsics.convert(Intrinsics.load(code, pc, Types.i16), Types.i16, Types.u32); pc = pc + 2 + off
                        case Op.JumpIfNull:
                        case Op.JumpIfUndefined:
                        case Op.JumpIfNullish:
                        case Op.JumpIfToBooleanFalse: const off = Intrinsics.load(code, pc, Types.i16) as u32; pc = Intrinsics.branch(toBool(acc), pc + 2, pc + 2 + off)
                        case Op.JumpIfNotNull:
                        case Op.JumpIfNotUndefined:
                        case Op.JumpIfNotNullish:
                        case Op.JumpIfToBooleanTrue: const off = Intrinsics.load(code, pc, Types.i16) as u32; pc = Intrinsics.branch(toBool(acc), pc + 2 + off, pc + 2)
                        case Op.GetPropertyConst: setHandle(getProperty(vmHandle(acc), vmHandle(loadConst2Wide())))
                        case Op.SetPropertyConst: setProperty(regLoad(regs, next2Byte()), vmHandle(loadConst2Wide()), heapAcc())
                        default: throw `vm: unhandled 2-byte op ${w2}`
                    }
                case Op.Width4:
                    const w4 = nextByte()
                    switch (w4) {
                        case Op.LdaImm: setScalar(Intrinsics.load(code, pc, Types.u32)); pc = pc + 4
                        case Op.LdaConst: setTagged(loadConstantTagged(Intrinsics.load(code, pc, Types.u32))); pc = pc + 4
                        case Op.Jump: const off = Intrinsics.load(code, pc, Types.i32) as u32; pc = pc + 4 + off
                        case Op.JumpIfToBooleanTrue: const off = Intrinsics.load(code, pc, Types.i32) as u32; pc = Intrinsics.branch(toBool(acc), pc + 4 + off, pc + 4)
                        case Op.JumpIfToBooleanFalse: const off = Intrinsics.load(code, pc, Types.i32) as u32; pc = Intrinsics.branch(toBool(acc), pc + 4, pc + 4 + off)
                        default: throw `vm: unhandled 4-byte op ${w4}`
                    }
                case Op.Width8: throw "vm: 8-byte operands don't fit the native word"
                case Op.Nop: continue
                default: throw `vm: unknown opcode ${op} (pc: ${pc})`
            }
        }
    }

    return interpret
}

export function makeFunctionFromBytes(
    bytes: number[],
    paramCount: u16,
    registerCount: u32,
    constants: number[] = [],
    constantHandles: boolean[] = [],
    nativeMode = true,
    finish = true,
): Handle {
    const codeLen = bytes.length
    const handle = heap.allocateHeapCell(heap.FunctionBytecode.sizeof)
    const fn = heap.FunctionBytecode(heap.resolveHeapCell(handle))
    const codeHandle = heap.allocateHeapCell(codeLen as usize)
    const codePtr = heap.resolveHeapCell(codeHandle)
    for (let j = 0; j < codeLen; j++) {
        Intrinsics.store(codePtr, j as usize, bytes[j] as usize, Types.u8)
    }

    const constantBytes = nativeMode ? 8 : 4
    const constantType = nativeMode ? Types.u64 : Types.u32
    heap.finishHeapCell(codeHandle)
    const constHandle = heap.allocateHeapCell((constants.length === 0 ? 1 : constants.length * constantBytes) as usize)
    const constPtr = heap.resolveHeapCell(constHandle)
    for (let k = 0; k < constants.length; k++) {
        const value = tagVmValue(constants[k] ?? 0, constantHandles[k] ?? false)
        Intrinsics.store(constPtr, (k * constantBytes) as usize, value as usize, constantType)
    }

    heap.finishHeapCell(constHandle)
    fn.source = 0
    fn.flags = nativeMode ? heap.FunctionBytecodeFlags.assumes_native_mode : 0
    fn.paramCount = paramCount
    fn.registerCount = registerCount
    fn.bytecode = codeHandle
    fn.bytecodeLen = codeLen as u32
    fn.constants = constHandle
    fn.constantsLen = constants.length as u32
    fn.scopeBindings = 0
    fn.scopeBindingsCount = 0
    fn.labels = 0
    if (finish) heap.finishHeapCell(handle)
    return handle
}

export function makeFunction(code: number[], paramCount: u16, registerCount: u32, constants: number[] = [], constantHandles: boolean[] = []): Handle {
    const bytes: number[] = []
    let i = 0
    while (i < code.length) {
        const b = code[i]; i = i + 1
        bytes.push(b & 0xFF)

        let width = 0
        if (b === Op.Width2) width = 2
        else if (b === Op.Width4) width = 4
        else if (b === Op.Width8) width = 8

        if (width !== 0) {
            bytes.push(code[i] & 0xFF); i = i + 1 // the real op
            const operand = code[i]; i = i + 1
            for (let k = 0; k < width; k++) bytes.push((operand >>> (k * 8)) & 0xFF) // little-endian
        }
    }
    return makeFunctionFromBytes(bytes, paramCount, registerCount, constants, constantHandles)
}

// ---- self test --------------------------------------
{
    const assert = intrinsics.assert
    const interpret = createInterpreter(true) // native mode

    // add(a, b) => a + b      (r0=a, r1=b)
    const addFn = makeFunction([
        Op.Ldar, 0,
        Op.Add, 1,
        Op.Return,
    ], 2, 2)

    const args = Intrinsics.stackalloc(2 * 4)
    Intrinsics.store(args, 0, tagVmScalar(2), Types.u32)
    Intrinsics.store(args, 4, tagVmScalar(3), Types.u32)
    assert(vmValue(interpret(addFn, 0, args, 2)) === 5)
    Intrinsics.stackfree(2 * 4)

    // sumTo(n) => 0 + 1 + ... + (n-1)     (r0=n, r1=acc, r2=i)
    const sumToFn = makeFunction([
        /*  0 */ Op.LdaZero,
        /*  1 */ Op.Star1,                    // acc = 0
        /*  2 */ Op.Star2,                    // i = 0
        /*  3 */ Op.Ldar2,                    // loop: acc = i
        /*  4 */ Op.TestLessThan, 0,          // acc = i < n
        /*  6 */ Op.JumpIfToBooleanFalse, 9,  // exit (-> byte 17, +9 from next pc)
        /*  8 */ Op.Ldar1,
        /*  9 */ Op.Add, 2,                   // acc = acc + i
        /* 11 */ Op.Star1,
        /* 12 */ Op.Ldar2,
        /* 13 */ Op.Inc,                      // i += 1
        /* 14 */ Op.Star2,
        /* 15 */ Op.Jump, -14,               // loop (-> byte 3, -14 from next pc)
        /* 17 */ Op.Ldar1,
        /* 18 */ Op.Return,
    ], 1, 3)

    const nArg = Intrinsics.stackalloc(8)
    Intrinsics.store(nArg, 0, tagVmScalar(5), Types.u32)
    assert(vmValue(interpret(sumToFn, 0, nArg, 1)) === 10) // 0+1+2+3+4
    Intrinsics.stackfree(8)

    // obj => { const o = {}; o.x = 42; return o.x }    (r0=o, r1="x")
    const objFn = makeFunction([
        /*  0 */ Op.CreateEmptyObject,
        /*  1 */ Op.Star0,                    // o
        /*  2 */ Op.LdaConst, 0,              // "x"
        /*  4 */ Op.Star1,
        /*  5 */ Op.LdaImm, 42,
        /*  7 */ Op.SetProperty, 0, 1,        // o["x"] = 42
        /* 10 */ Op.Ldar0,
        /* 11 */ Op.GetProperty, 1,           // acc = o["x"]
        /* 13 */ Op.Return,
    ], 0, 2, [heap.fromJsString("x")], [true])

    const noArgs = Intrinsics.stackalloc(4)
    assert(vmValue(interpret(objFn, 0, noArgs, 0)) === 42)

    const wideFn = makeFunction([
        Op.Width2, Op.LdaImm, 1000,
        Op.Return,
    ], 0, 1)
    assert(vmValue(interpret(wideFn, 0, noArgs, 0)) === 1000)
    Intrinsics.stackfree(4)

    console.log("vm native self-test passed")
}
