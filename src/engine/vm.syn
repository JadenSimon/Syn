/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const inRange = intrinsics.inRange
const assert = intrinsics.assert

type usize = u32
type Handle = heap.Handle

export const Op = {
    Mov: 0x00,
    Star: 0x01,
    Star0: 0x02, Star1: 0x03, Star2: 0x04, Star3: 0x05,
    Star4: 0x06, Star5: 0x07, Star6: 0x08, Star7: 0x09,
    Star8: 0x0A, Star9: 0x0B, Star10: 0x0C, Star11: 0x0D,
    Star12: 0x0E, Star13: 0x0F, Star14: 0x10, Star15: 0x11,
    MovPacked: 0x21,


    LdaImm: 0x22, LdaZero: 0x23, LdaConst: 0x24,
    LdaUndefined: 0x26, LdaNull: 0x27, LdaTrue: 0x28, LdaFalse: 0x29,
    Ldar: 0x2A, Ldar0: 0x2B, Ldar1: 0x2C, Ldar2: 0x2D, Ldar3: 0x2E,

    Add: 0x30, Sub: 0x31, Mul: 0x32, Div: 0x33, Mod: 0x34, Exp: 0x35,
    BitOr: 0x36, BitAnd: 0x37, BitXor: 0x38,
    ShiftLeft: 0x39, ShiftRight: 0x3A, ShiftRightLogical: 0x3B,
    TestNotStrictEqual: 0x3C, TestStrictEqual: 0x3D,
    TestLessThan: 0x3E, TestGreaterThan: 0x3F,
    TestLessThanOrEqual: 0x40, TestGreaterThanOrEqual: 0x41,
    IncPost: 0x42, DecPost: 0x43, // some specializations

    Inc: 0x4A, Dec: 0x4B, Negate: 0x4C, BitNot: 0x4D, LogicalNot: 0x4E,
    LogicalNotNot: 0x50,

    // FIXME: we need jumps that can read from a separate label table so we can have known-sized emits
    
    Jump: 0x5A, 
    JumpIfNull: 0x5B, JumpIfUndefined: 0x5C, JumpIfNullish: 0x5D, JumpIfToBooleanFalse: 0x5E,
    JumpIfNotNull: 0x5F, JumpIfNotUndefined: 0x60, JumpIfNotNullish: 0x61, JumpIfToBooleanTrue: 0x62, 
    JumpAcc: 0x63, // adds acc (unsigned) to pc
    JumpLabel: 0x64,

    Call: 0x67,
    CallConst: 0x68,
    Construct: 0x69,
    ConstructConst: 0x6A,

    CallConstFrom: 0x6B, // "From" means we setup the frame

    Throw: 0x77, ReThrow: 0x78, // ReThrow won't contribute to the stack trace
    Return: 0x79,

    GetProperty: 0x80, SetProperty: 0x81,
    GetPropertyConst: 0x82, SetPropertyConst: 0x83, // keys are in const pool
    GetPropertyImm: 0x84, SetPropertyImm: 0x85, // unsigned, used for arrays

    CreateEmptyObject: 0xA0,
    CreateObjectConst: 0xA1, // loads a template from const pool

    Width2: 0xF0, Width4: 0xF1, Width8: 0xF2,
}

export function createInterpreter(nativeMode: boolean, useCallerRegs = false, calleeInFrame = false) {
    function regLoad(regs: usize, i: u32): u32 {
        const o = useCallerRegs ? -(i * 4) : i * 4
        if (nativeMode) return Intrinsics.load(regs, o as any, Types.u32)
        throw "vm: tagged register load not implemented"
    }
    function regStore(regs: usize, i: u32, v: u32): void {
        const o = useCallerRegs ? -(i * 4) : i * 4
        if (nativeMode) { Intrinsics.store(regs, o as any, v, Types.u32); return }
        throw "vm: tagged register store not implemented"
    }
    function toBool(v: u32): boolean {
        if (nativeMode) return v as any as boolean // Intrinsics.ne(v, 0, Types.u32, Types.u32)
        throw "vm: tagged truthiness not implemented"
    }
    function fromBool(b: boolean): u32 {
        if (nativeMode) return b as any as u32 // Intrinsics.select(b, 1, 0, Types.u32)
        throw "vm: tagged boolean not implemented"
    }
    const frames: [pc: u32, fp: u32][] = []
    function findEh() {
        while (const f = frames.pop()) {
            const callee = Intrinsics.load(f[1], 0, Types.u32)
            const bc = heap.FunctionBytecode(callee)
            if (!bc.labels) continue
            const ehCount = bc.labels.ehRangesCount
            for (let i: u32 = 0; i < ehCount; i++) {
                const range = bc.labels.ehRanges[i]
                if (f[0] >= range.start && f[0] <= range.end) {
                    return [f, range.handler] as const
                }
            }
        }
    }
    function interpret(fn: Handle, thisArg: Handle, args: usize, argCount: u32): u32 {
        if (fn === 0) {
            fn = Intrinsics.load(args, argCount*4, Types.u32)
        }
        const nt = Types.u32
        const bc = heap.FunctionBytecode(fn)
        const regCount = bc.registerCount
        const code = bc.bytecode
        const codeLen = bc.bytecodeLen
        const constants = bc.constants
        const labels = bc.labels
        const frameSize = useCallerRegs 
            ? Intrinsics.subsat(regCount, argCount, nt, nt) as u32 * 4
            : regCount * 4
        const cur = Intrinsics.stackalloc(frameSize)
        const regs = useCallerRegs ? args-4+argCount*4 : cur
        if (!useCallerRegs) {
            for (let i: u32 = 0; i < argCount; i++) {
                regStore(regs, i, Intrinsics.load(args, i * 4, Types.u32))
            }
        }

        let acc: u32 = thisArg
        let pc: u32 = 0

        function nextByte(): u32 {
            intrinsics.assert(pc < codeLen)
            const b = Intrinsics.load(code, pc, Types.u8)
            pc = pc + 1
            return b
        }

        function next2Byte(): u32 {
            intrinsics.assert(pc < codeLen)
            const b = Intrinsics.load(code, pc, Types.u16)
            pc = pc + 2
            return b
        }

        function doCall(target: Handle, rargStart: u32, nargs: u32) {
            if (calleeInFrame) {
                frames.push([pc, args+argCount*4])
                const o = -((rargStart + nargs) * 4)
                acc = Intrinsics.call(target, acc, regs + o, nargs, interpret)
                frames.pop()
                return
            }
            const o = useCallerRegs ? -(rargStart * 4) : rargStart * 4
            acc = Intrinsics.call(target, acc, regs + o, nargs, interpret)
        }

        function doConstruct(target: Handle, rargStart: u32, nargs: u32) {
            const proto = heap.getPrototypeProperty(target)
            acc = heap.makeObject(proto)
            doCall(target, rargStart, nargs)
        }

        function loadConst1Wide() {
            const idx = nextByte() * 4
            return Intrinsics.load(constants, idx, Types.u32)
        }

        function loadConst2Wide() {
            return Intrinsics.load(constants, next2Byte() * 4, Types.u32)
        }

        for (;;) {
            pc = Intrinsics.dispatch(pc) // records this decoding step
            const op = nextByte()
            switch (op) {
                case Op.Mov: const rsrc = nextByte(); regStore(regs, nextByte(), regLoad(regs, rsrc))
                case Op.Star: regStore(regs, nextByte(), acc)
                case Op.Star0: regStore(regs, 0, acc)
                case Op.Star1: regStore(regs, 1, acc)
                case Op.Star2: regStore(regs, 2, acc)
                case Op.Star3: regStore(regs, 3, acc)
                case Op.Star4: regStore(regs, 4, acc)
                case Op.Star5: regStore(regs, 5, acc)
                case Op.Star6: regStore(regs, 6, acc)
                case Op.Star7: regStore(regs, 7, acc)
                case Op.Star8: regStore(regs, 8, acc)
                case Op.Star9: regStore(regs, 9, acc)
                case Op.Star10: regStore(regs, 10, acc)
                case Op.Star11: regStore(regs, 11, acc)
                case Op.Star12: regStore(regs, 12, acc)
                case Op.Star13: regStore(regs, 13, acc)
                case Op.Star14: regStore(regs, 14, acc)
                case Op.Star15: regStore(regs, 15, acc)

                case Op.MovPacked: const r = nextByte(); regStore(regs, r & 0xF, regLoad(regs, r >> 4))

                case Op.LdaZero: acc = 0
                case Op.LdaImm: const n = nextByte(); acc = Intrinsics.convert(n, Types.i8, Types.u32) // sign-extend the signed byte
                case Op.LdaConst: acc = loadConst1Wide()
                case Op.LdaUndefined: acc = 0
                case Op.LdaNull: acc = 0
                case Op.LdaTrue: acc = fromBool(true)
                case Op.LdaFalse: acc = fromBool(false)

                case Op.Ldar: acc = regLoad(regs, nextByte())
                case Op.Ldar0: acc = regLoad(regs, 0)
                case Op.Ldar1: acc = regLoad(regs, 1)
                case Op.Ldar2: acc = regLoad(regs, 2)
                case Op.Ldar3: acc = regLoad(regs, 3)

                case Op.Add: acc = Intrinsics.add(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.Sub: acc = Intrinsics.sub(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.Mul: acc = Intrinsics.mul(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.Div: acc = Intrinsics.div(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.Mod: acc = Intrinsics.rem(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.Exp: acc = Intrinsics.pow(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.BitOr: acc = Intrinsics.or(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.BitAnd: acc = Intrinsics.and(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.BitXor: acc = Intrinsics.xor(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.ShiftLeft: acc = Intrinsics.shl(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.ShiftRight: acc = Intrinsics.shr(acc, regLoad(regs, nextByte()), nt, nt) as u32
                case Op.ShiftRightLogical: acc = Intrinsics.ushr(acc, regLoad(regs, nextByte()), nt, nt) as u32

                case Op.TestNotStrictEqual: acc = fromBool(Intrinsics.ne(acc, regLoad(regs, nextByte()), nt, nt))
                case Op.TestStrictEqual: acc = fromBool(Intrinsics.eq(acc, regLoad(regs, nextByte()), nt, nt))
                case Op.TestLessThan: acc = fromBool(Intrinsics.lt(acc, regLoad(regs, nextByte()), nt, nt))
                case Op.TestGreaterThan: acc = fromBool(Intrinsics.gt(acc, regLoad(regs, nextByte()), nt, nt))
                case Op.TestLessThanOrEqual: acc = fromBool(Intrinsics.le(acc, regLoad(regs, nextByte()), nt, nt))
                case Op.TestGreaterThanOrEqual: acc = fromBool(Intrinsics.ge(acc, regLoad(regs, nextByte()), nt, nt))

                case Op.IncPost:
                    const idx = nextByte()
                    const val = regLoad(regs, idx)
                    regStore(regs, idx, Intrinsics.add(val, 1, nt, nt) as u32)
                    acc = val

                case Op.DecPost:
                    const idx = nextByte()
                    const val = regLoad(regs, idx)
                    regStore(regs, idx, Intrinsics.sub(val, 1, nt, nt) as u32)
                    acc = val

                case Op.Inc: acc = Intrinsics.add(acc, 1, nt, nt) as u32
                case Op.Dec: acc = Intrinsics.sub(acc, 1, nt, nt) as u32
                case Op.Negate: acc = Intrinsics.neg(acc, nt) as u32
                case Op.BitNot: acc = Intrinsics.not(acc, nt) as u32
                case Op.LogicalNot: acc = Intrinsics.select(toBool(acc), 0, 1, Types.u32)
                case Op.LogicalNotNot: acc = Intrinsics.select(toBool(acc), 1, 0, Types.u32)

                case Op.Jump: const off = Intrinsics.convert(nextByte(), Types.i8, Types.u32); pc = Intrinsics.jmp(pc, off)
                case Op.JumpIfNull:
                case Op.JumpIfUndefined:
                case Op.JumpIfNullish:
                case Op.JumpIfToBooleanFalse: const off = Intrinsics.convert(nextByte(), Types.i8, Types.u32); pc = Intrinsics.branch(toBool(acc), pc, pc + off)
                case Op.JumpIfNotNull:
                case Op.JumpIfNotUndefined:
                case Op.JumpIfNotNullish:
                case Op.JumpIfToBooleanTrue: const off = Intrinsics.convert(nextByte(), Types.i8, Types.u32); pc = Intrinsics.branch(toBool(acc), pc + off, pc)
                case Op.JumpAcc: pc = Intrinsics.jmp(pc, acc)
                case Op.JumpLabel: pc = Intrinsics.jmp(labels!.jumpLabels[nextByte()], 0)

                case Op.Call:
                    const callee = calleeInFrame ? 0 : regLoad(regs, nextByte())
                    doCall(callee, nextByte(), nextByte())

                case Op.CallConst:
                    doCall(loadConst1Wide(), nextByte(), nextByte())

                case Op.Construct:
                    const callee = calleeInFrame ? 0 : regLoad(regs, nextByte())
                    doConstruct(callee, nextByte(), nextByte())

                case Op.ConstructConst:
                    doConstruct(loadConst1Wide(), nextByte(), nextByte())

                case Op.CallConstFrom:
                    acc = 0 // LdaUndefined
                    const target = loadConst1Wide()
                    const frameStart = nextByte()
                    regStore(regs, frameStart, target)
                    const regStart = nextByte()
                    const nargs = nextByte()
                    for (let i = 0; i < nargs; i++) regStore(regs, frameStart+(nargs-i), regLoad(regs, regStart+i))
                    doCall(0, frameStart, nargs)
                
                case Op.Throw:
                case Op.ReThrow:
                    const fp = args+argCount*4
                    frames.push([pc, fp])
                    if (const eh = findEh()) {
                        if (eh[0][1] === fp) {
                            pc = eh[1]
                        } else {
                            throw 'todo'
                        }
                    } else {
                        if (Intrinsics.canexit(acc)) throw acc
                        else acc = 0
                    }
                    
                case Op.Return:
                    if (!Intrinsics.canexit(acc)) {
                        acc = 0
                        continue
                    }
                    Intrinsics.stackfree(frameSize)
                    return Intrinsics.ret(acc, nt)

                case Op.CreateEmptyObject: acc = heap.makeObject(0)
                // TODO: will create an obj w/ owned properties already set
                // case Op.CreateObjectConst: acc = heap.makeObject(0)

                case Op.GetProperty: acc = heap.getProperty(acc, regLoad(regs, nextByte()))
                case Op.SetProperty:
                    const robj = nextByte()
                    const rkey = nextByte()
                    heap.setProperty(regLoad(regs, robj), regLoad(regs, rkey), acc)

                case Op.GetPropertyConst: acc = heap.getProperty(acc, loadConst1Wide())
                case Op.SetPropertyConst:
                    const robj = nextByte()
                    heap.setProperty(regLoad(regs, robj), loadConst1Wide(), acc)

                case Op.GetPropertyImm: acc = heap.getProperty(acc, nextByte())
                case Op.SetPropertyImm: heap.setProperty(regLoad(regs, nextByte()), nextByte(), acc)

                case Op.Width2:
                    const w2 = nextByte()
                    switch (w2) {
                        case Op.LdaImm: acc = Intrinsics.convert(Intrinsics.load(code, pc, Types.i16), Types.i16, Types.u32); pc = pc + 2
                        case Op.LdaConst: acc = Intrinsics.load(constants, Intrinsics.load(code, pc, Types.u16) * 4, Types.u32); pc = pc + 2
                        case Op.Jump: const off = Intrinsics.convert(Intrinsics.load(code, pc, Types.i16), Types.i16, Types.u32); pc = pc + 2 + off
                        case Op.JumpIfNull:
                        case Op.JumpIfUndefined:
                        case Op.JumpIfNullish:
                        case Op.JumpIfToBooleanFalse: const off = Intrinsics.load(code, pc, Types.i16) as u32; pc = Intrinsics.branch(toBool(acc), pc + 2, pc + 2 + off)
                        case Op.JumpIfNotNull:
                        case Op.JumpIfNotUndefined:
                        case Op.JumpIfNotNullish:
                        case Op.JumpIfToBooleanTrue: const off = Intrinsics.load(code, pc, Types.i16) as u32; pc = Intrinsics.branch(toBool(acc), pc + 2 + off, pc + 2)
                        case Op.GetPropertyConst: acc = heap.getProperty(acc, loadConst2Wide())
                        case Op.SetPropertyConst: heap.setProperty(regLoad(regs, next2Byte()), loadConst2Wide(), acc)
                        default: throw `vm: unhandled 2-byte op ${w2}`
                    }
                case Op.Width4:
                    const w4 = nextByte()
                    switch (w4) {
                        case Op.LdaImm: acc = Intrinsics.load(code, pc, Types.u32); pc = pc + 4
                        case Op.LdaConst: acc = Intrinsics.load(constants, Intrinsics.load(code, pc, Types.u32) * 4, Types.u32); pc = pc + 4
                        case Op.Jump: const off = Intrinsics.load(code, pc, Types.i32) as u32; pc = pc + 4 + off
                        case Op.JumpIfToBooleanTrue: const off = Intrinsics.load(code, pc, Types.i32) as u32; pc = Intrinsics.branch(toBool(acc), pc + 4 + off, pc + 4)
                        case Op.JumpIfToBooleanFalse: const off = Intrinsics.load(code, pc, Types.i32) as u32; pc = Intrinsics.branch(toBool(acc), pc + 4, pc + 4 + off)
                        default: throw `vm: unhandled 4-byte op ${w4}`
                    }
                case Op.Width8: throw "vm: 8-byte operands don't fit the native word"

                default: throw `vm: unknown opcode ${op}`
            }
        }
    }

    return interpret
}

export function makeFunctionFromBytes(bytes: number[], paramCount: u16, registerCount: u32, constants: number[] = []): Handle {
    const codeLen = bytes.length
    const codePtr = Intrinsics.alloc(codeLen as usize)
    for (let j = 0; j < codeLen; j++) {
        Intrinsics.store(codePtr, j as usize, bytes[j] as usize, Types.u8)
    }

    const constPtr = Intrinsics.alloc((constants.length === 0 ? 1 : constants.length * 4) as usize)
    for (let k = 0; k < constants.length; k++) {
        Intrinsics.store(constPtr, (k * 4) as usize, constants[k] as usize, Types.u32)
    }

    const fn = intrinsics.New(heap.FunctionBytecode)
    fn.source = 0
    fn.flags = 0
    fn.paramCount = paramCount
    fn.registerCount = registerCount
    fn.bytecode = codePtr
    fn.bytecodeLen = codeLen as u32
    fn.constants = constPtr
    fn.constantsLen = constants.length as u32
    return Intrinsics.addressof(fn)
}

export function makeFunction(code: number[], paramCount: u16, registerCount: u32, constants: number[] = []): Handle {
    const bytes: number[] = []
    let i = 0
    while (i < code.length) {
        const b = code[i]; i = i + 1
        bytes.push(b & 0xFF)

        let width = 0
        if (b === Op.Width2) width = 2
        else if (b === Op.Width4) width = 4
        else if (b === Op.Width8) width = 8

        if (width !== 0) {
            bytes.push(code[i] & 0xFF); i = i + 1 // the real op
            const operand = code[i]; i = i + 1
            for (let k = 0; k < width; k++) bytes.push((operand >>> (k * 8)) & 0xFF) // little-endian
        }
    }
    return makeFunctionFromBytes(bytes, paramCount, registerCount, constants)
}

// ---- self test --------------------------------------
{
    const useCallerRegs = true
    const assert = intrinsics.assert
    const interpret = createInterpreter(true, useCallerRegs) // native mode

    // add(a, b) => a + b      (r0=a, r1=b)
    const addFn = makeFunction([
        Op.Ldar, 0,
        Op.Add, 1,
        Op.Return,
    ], 2, 2)

    const args = Intrinsics.stackalloc(3 * 4)
    if (useCallerRegs) {
        Intrinsics.store(args, 4, 2, Types.u32)
        Intrinsics.store(args, 0, 3, Types.u32)
    } else {
        Intrinsics.store(args, 0, 2, Types.u32)
        Intrinsics.store(args, 4, 3, Types.u32)
    }
    assert(interpret(addFn, 0, args, 2) === 5)
    Intrinsics.stackfree(3 * 4)

    // sumTo(n) => 0 + 1 + ... + (n-1)     (r0=n, r1=acc, r2=i)
    const sumToFn = makeFunction([
        /*  0 */ Op.LdaZero,
        /*  1 */ Op.Star1,                    // acc = 0
        /*  2 */ Op.Star2,                    // i = 0
        /*  3 */ Op.Ldar2,                    // loop: acc = i
        /*  4 */ Op.TestLessThan, 0,          // acc = i < n
        /*  6 */ Op.JumpIfToBooleanFalse, 9,  // exit (-> byte 17, +9 from next pc)
        /*  8 */ Op.Ldar1,
        /*  9 */ Op.Add, 2,                   // acc = acc + i
        /* 11 */ Op.Star1,
        /* 12 */ Op.Ldar2,
        /* 13 */ Op.Inc,                      // i += 1
        /* 14 */ Op.Star2,
        /* 15 */ Op.Jump, -14,               // loop (-> byte 3, -14 from next pc)
        /* 17 */ Op.Ldar1,
        /* 18 */ Op.Return,
    ], 1, 3)

    const nArg = Intrinsics.stackalloc(8)
    Intrinsics.store(nArg, 0, 5, Types.u32)
    assert(interpret(sumToFn, 0, nArg, 1) === 10) // 0+1+2+3+4
    Intrinsics.stackfree(8)

    // obj => { const o = {}; o.x = 42; return o.x }    (r0=o, r1="x")
    const objFn = makeFunction([
        /*  0 */ Op.CreateEmptyObject,
        /*  1 */ Op.Star0,                    // o
        /*  2 */ Op.LdaConst, 0,              // "x"
        /*  4 */ Op.Star1,
        /*  5 */ Op.LdaImm, 42,
        /*  7 */ Op.SetProperty, 0, 1,        // o["x"] = 42
        /* 10 */ Op.Ldar0,
        /* 11 */ Op.GetProperty, 1,           // acc = o["x"]
        /* 13 */ Op.Return,
    ], 0, 2, [heap.fromJsString("x")])

    const noArgs = Intrinsics.stackalloc(4)
    assert(interpret(objFn, 0, noArgs, 0) === 42)

    const wideFn = makeFunction([
        Op.Width2, Op.LdaImm, 1000,
        Op.Return,
    ], 0, 1)
    assert(interpret(wideFn, 0, noArgs, 0) === 1000)
    Intrinsics.stackfree(4)

    {
        const interpret = createInterpreter(true, useCallerRegs, true)
        const noArgsWithCallee = Intrinsics.stackalloc(4)
        Intrinsics.store(noArgsWithCallee, 0, wideFn, Types.u32)
        defer Intrinsics.stackfree(4)
        assert(interpret(0, 0, noArgsWithCallee, 0) === 1000)
    }

    console.log("vm native self-test passed")
}
