/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'

type usize = u32

interface Cell {
    count: u32
}
const View = intrinsics.DefineStructView(reify Cell)

function pickView(ptr: usize, k: u32) {
    if (k > 5) return View(ptr + 8)
    intrinsics.assert(k > 0)
    return View(ptr + k * 4)
}
intrinsics.tagNoInline(pickView)

function notify(ptr: usize, k: u32): void {
    View(ptr).count = k
}
intrinsics.tagNoInline(notify)

function effJoin(ptr: usize, k: u32): u32 {
    if (k > 3) {
        notify(ptr, k)
        return k + 1
    }
    notify(ptr, k + 1)
    return k + 2
}
intrinsics.tagInline(effJoin)

function bump(ptr: usize, kind: u32, k: u32): u32 {
    if (kind < 2) return k + 1
    if (kind === 2) return 0
    const cell = pickView(ptr, k)
    const local = cell.count + 1
    intrinsics.assert(local <= 255)
    cell.count = local
    if (local === 1) notify(ptr, k)
    return local
}
intrinsics.tagInline(bump)

function effJoinCarried(ptr: usize, a: u32, b: u32): u32 {
    const x = effJoin(ptr, a)
    if (b > 2) notify(ptr, b)
    return x * 2
}

function effJoinThenView(ptr: usize, a: u32, b: u32): u32 {
    const x = effJoin(ptr, a)
    const c = bump(ptr, a, b)
    return (x + c) * 2
}

function viewJoinCarried(ptr: usize, a: u32, b: u32): u32 {
    const x = bump(ptr, a, b)
    if (b > 2) notify(ptr, b)
    return x * 2
}

function viewJoinTwice(ptr: usize, a: u32, b: u32): u32 {
    const x = bump(ptr, a, b)
    if (b > 2) notify(ptr, b)
    if (a > 7) notify(ptr, a)
    return x * 2 + a
}

function edge(ptr: usize, a: u32, b: u32): void {
    intrinsics.assert(a > 0 && b > 0)
    if (a === b) { bump(ptr, a, b); return }
    if (a > 100) return
    const t = a + b
    if (t > 50) { bump(ptr, a, t); return }
    intrinsics.assert(t > 0)
    if (t === 1) bump(ptr, b, t)
}

async function main() {
    const native = await import('./native')
    const cases: Record<string, Function> = {
        effJoinCarried, effJoinThenView, viewJoinCarried, viewJoinTwice, edge,
    }
    let failures = 0
    for (const name of Object.keys(cases)) {
        try {
            const compiled = native.createNatives({ [name]: cases[name] })
            if (intrinsics.argv().includes('repro-run')) {
                const memory = new Uint32Array(16)
                const ptr = (ts as any).getArrayBufferPtr(memory.buffer)
                for (const a of [1, 2, 3, 4, 8, 101]) for (const b of [1, 2, 3, 6, 12]) {
                    for (const initial of [0, 7]) {
                        memory.fill(initial)
                        const expected = new Uint32Array(memory)
                        function write(k: number): void { expected[0] = k }
                        function expectedBump(kind: number, k: number): number {
                            if (kind < 2) return k + 1
                            if (kind === 2) return 0
                            const at = k > 5 ? 2 : k
                            const local = expected[at] + 1
                            expected[at] = local
                            if (local === 1) write(k)
                            return local
                        }
                        let result = 0
                        if (name === 'edge') {
                            if (a === b) expectedBump(a, b)
                            else if (a <= 100) {
                                const t = a + b
                                if (t > 50) expectedBump(a, t)
                                else if (t === 1) expectedBump(b, t)
                            }
                        } else {
                            let x = 0
                            if (name === 'effJoinCarried' || name === 'effJoinThenView') {
                                write(a > 3 ? a : a + 1)
                                x = a > 3 ? a + 1 : a + 2
                            } else x = expectedBump(a, b)
                            if (name === 'effJoinThenView') result = (x + expectedBump(a, b)) * 2
                            else {
                                if (b > 2) write(b)
                                if (name === 'viewJoinTwice' && a > 7) write(a)
                                result = x * 2 + (name === 'viewJoinTwice' ? a : 0)
                            }
                        }
                        const actual = Number(compiled[name](ptr, a, b))
                        if (name !== 'edge' && actual !== result) throw `result ${a},${b},${initial}: ${actual} != ${result}`
                        for (let i = 0; i < memory.length; i++) {
                            if (memory[i] !== expected[i]) throw `memory ${a},${b},${initial} at ${i}: ${memory[i]} != ${expected[i]}`
                        }
                    }
                }
                console.log('checked 60 executions', name)
            }
            console.log('ok   ', name)
        } catch (e) {
            failures++
            console.log('FAIL ', name, String(e).split('\n')[0])
        }
    }
    if (intrinsics.argv().includes('repro-run') && failures) throw `${failures} repros failed`
}

await main()
