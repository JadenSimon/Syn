    function fnTyperLoopCopy(n: u32): number {
        const nodes = new Map<number, GraphNode>()
        nodes.set(1, opaqueLike())
        nodes.set(2, opaqueLike(1))
        const g = createGraph({ nodes, ids: { next: 3 } })
        let s = 0
        for (const [id, node] of nodeEntries(g)) {
            if (id !== 2) continue
            putCopy(g, id, node, [1, { literal: n }])
            s++
        }
        return s + countNodes(g)
    }
