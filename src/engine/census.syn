    function tbLoopPutCopy(n: u32): number {
        const g = rawGraph(n)
        let s = 0
        for (const [id, node] of nodeEntries(g)) {
            if (id !== 4) continue
            putCopy(g, id, node, [1, { literal: 2 }])
            s++
        }
        return s
    }

