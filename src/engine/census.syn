const Types = intrinsics.Types

function stageOf(e: unknown): string {
    const error = e as native.CompileError
    return `stage=${error?.stage ?? 'none'} unit=${error?.unit || '-'} node=${error?.node ?? '-'}`
}

function firstLine(e: unknown): string {
    return String(e).split('\n')[0].slice(0, 240)
}

function relayedCell(k: number): Uint32Array {
    const a = new Uint32Array(2)
    a[k] = k
    return a
}

type Entry = [group: string, fn: Function, ...argSets: number[][]]

function runCensus(entries: Entry[]): void {
    const errorType: any = Error
    errorType.stackTraceLimit = 200
    const stacks = intrinsics.argv().includes('census-stacks')
    const groups = intrinsics.argv().filter(a => a.startsWith('group:')).map(a => a.slice(6))
    if (harness.benching()) {
        const benches = harness.createBenches()
        for (const [group, fn, args] of entries) {
            if (args && harness.selected(fn.name) && (!groups.length || groups.includes(group))) benches.bench(fn, args)
        }
        benches.run()
        return
    }
    for (const [group, fn, ...argSets] of entries) {
        if (groups.length && !groups.includes(group)) continue
        harness.test(fn.name, () => {
            const expected: unknown[] = []
            let jsFailure = ''
            for (const args of argSets) {
                try {
                    expected.push((fn as any)(...args))
                } catch (e) {
                    jsFailure = firstLine(e)
                    break
                }
            }
            const start = performance.now()
            let run: any
            try {
                run = (native.createNatives({ [fn.name]: fn }) as any)[fn.name]
            } catch (e) {
                harness.fail(`CENSUS ${group} ${fn.name} NOCOMPILE ${stageOf(e)} ${firstLine(e)}`)
                if (stacks) console.log((e as any)?.stack)
                return
            }
            const ms = Math.round(performance.now() - start)
            if (jsFailure) {
                harness.fail(`CENSUS ${group} ${fn.name} compiled (JSFAIL ${jsFailure}) [${ms}ms]`)
                return
            }
            let status = 'ok'
            for (let i = 0; i < argSets.length; i++) {
                try {
                    const actual = run(...argSets[i])
                    if (!harness.sameResult(actual, expected[i])) status = `MISMATCH (${argSets[i].join(',')}) native=${actual} js=${expected[i]}`
                } catch (e) {
                    status = `RUNFAIL ${firstLine(e)}`
                }
                if (status !== 'ok') break
            }
            if (status !== 'ok') harness.fail(`CENSUS ${group} ${fn.name} ${status} [${ms}ms]`)
            else console.log(`CENSUS ${group} ${fn.name} ok [${ms}ms]`)
        })
    }
}

function rawNode(op: NodeOp, values: number[]): GraphNode {
    const slots = new Uint32Array(values.length)
    for (let i = 0; i < values.length; i++) slots[i] = values[i] as u32
    return makeNodeFromSlots(op, slots)
}

function rawGraph(n: u32): Graph {
    const nodes = new Map<number, GraphNode>()
    nodes.set(1, rawNode(NodeOp.block, []))
    nodes.set(2, rawNode(NodeOp.param, [Types.u32]))
    nodes.set(3, rawNode(NodeOp.add, [refSlot(2), n, Types.u32]))
    nodes.set(4, rawNode(NodeOp.mul, [refSlot(3), 2, Types.u32]))
    nodes.set(5, rawNode(NodeOp.ret, [refSlot(4), refSlot(1)]))
    return createGraph({ nodes, ids: { next: 6 }, root: 1, blocks: [{ id: 1, params: [2], bodyId: 5, bodyConst: 0 }] })
}

function rawBranchGraph(n: u32): Graph {
    const nodes = new Map<number, GraphNode>()
    nodes.set(1, rawNode(NodeOp.block, []))
    nodes.set(2, rawNode(NodeOp.param, [Types.u32]))
    nodes.set(3, rawNode(NodeOp.block, []))
    nodes.set(4, rawNode(NodeOp.block, []))
    nodes.set(5, rawNode(NodeOp.param, [Types.u32]))
    nodes.set(6, rawNode(NodeOp.lt, [refSlot(2), n, Types.u32]))
    nodes.set(7, rawNode(NodeOp.apply, [refSlot(3), refSlot(2)]))
    nodes.set(8, rawNode(NodeOp.apply, [refSlot(4)]))
    nodes.set(9, rawNode(NodeOp.select, [refSlot(6), refSlot(7), refSlot(8)]))
    nodes.set(10, rawNode(NodeOp.add, [refSlot(5), 1, Types.u32]))
    nodes.set(11, rawNode(NodeOp.ret, [refSlot(10), refSlot(3)]))
    nodes.set(12, rawNode(NodeOp.ret, [7, refSlot(4)]))
    return createGraph({
        nodes, ids: { next: 13 }, root: 1, blocks: [
            { id: 1, params: [2], bodyId: 9, bodyConst: 0 },
            { id: 3, params: [5], bodyId: 11, bodyConst: 0 },
            { id: 4, params: [], bodyId: 12, bodyConst: 0 },
        ],
    })
}

const reproLabels: string[] = []
for (const key of ['alpha', 'beta']) reproLabels.push(key.replace(/a/g, 'A'))
const reproPlain: string[] = ['alpha', 'beta']

function refOrNumber(x: number | { ref: number }): number {
    return typeof x === 'number' ? x + 1 : x.ref
}

function refOrDefault(x: number | { ref: number } = 5): number {
    return typeof x === 'number' ? x + 1 : x.ref
}

function forwardDefault(x: number | { ref: number } = 5): number {
    return refOrNumber(x)
}

function subA(g: Graph, by: Map<number, gn.Operand>): number {
    function resolve(id: number): gn.Operand {
        let at: gn.Operand = id
        while (typeof at === 'number' && by.has(at)) at = by.get(at)!
        return at
    }
    let s = 0
    for (const [id, n] of nodeEntries(g)) {
        const r = resolve(getRef(n, 0))
        s += typeof r === 'number' ? r : r.literal
    }
    return s
}

function subB(g: Graph, by: Map<number, gn.Operand>): number {
    let s = 0
    for (const [id, n] of nodeEntries(g)) {
        if (by.has(id)) continue
        let operands: gn.Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (!by.has(getRef(n, i))) continue
            operands ??= getOperands(g, n)
            operands[i] = by.get(getRef(n, i))!
        }
        if (operands) s += operands.length
    }
    return s
}

function subC(g: Graph, by: Map<number, gn.Operand>): number {
    let s = 0
    for (const [id, n] of nodeEntries(g)) {
        if (!by.has(id)) continue
        putCopy(g, id, n, [1, { literal: 2 }])
        s++
    }
    return s
}

function subD(by: Map<number, gn.Operand>): number {
    let at: gn.Operand = 1
    while (typeof at === 'number' && by.has(at)) at = by.get(at)!
    return typeof at === 'number' ? at : at.literal
}

function unionOf(n: number): number | { ref: number } {
    return n > 2 ? { ref: n } : n
}

function opaqueLike(...refs: number[]): GraphNode {
    const slots = new Uint32Array(refs.length)
    for (let i = 0; i < refs.length; i++) slots[i] = 2 ** 29 + refs[i]
    return { op: NodeOp.opaque, slots, flags: 0, scratchFlags: 0, epoch: 0 } as GraphNode
}

function spreadCopy(o: { a: number, b: number }): { a: number, b: number } {
    return { ...o, b: 3 }
}

function explicitGraph(n: u32): Graph {
    const g = createGraph({ ids: { next: 1 } })
    const root = addNode(g, NodeOp.block, [], Types.u64)
    const p = addNode(g, NodeOp.param, [], Types.u32)
    const a = addNode(g, NodeOp.add, [p, { literal: n }], Types.u32)
    const m = addNode(g, NodeOp.mul, [a, { literal: 3 }], Types.u32)
    const r = addNode(g, NodeOp.ret, [m, root], Types.u64)
    g.root = root
    setGraphBlocks(g, [{ id: root, params: [p], bodyId: r, bodyConst: 0 }])
    return g
}

function makeGraph(n: u32): Graph {
    const g = createGraph()
    const root = addNode(g, NodeOp.block, [])
    const p = addNode(g, NodeOp.param, [], Types.u32)
    const a = addNode(g, NodeOp.add, [p, { literal: n }], Types.u32)
    const m = addNode(g, NodeOp.mul, [a, { literal: 3 }], Types.u32)
    const r = addNode(g, NodeOp.ret, [m, root])
    g.root = root
    setGraphBlocks(g, [{ id: root, params: [p], bodyId: r, bodyConst: 0 }])
    return g
}

function makeBranchGraph(n: u32): Graph {
    const g = createGraph()
    const root = addNode(g, NodeOp.block, [])
    const p = addNode(g, NodeOp.param, [], Types.u32)
    const yes = addNode(g, NodeOp.block, [])
    const no = addNode(g, NodeOp.block, [])
    const yp = addNode(g, NodeOp.param, [], Types.u32)
    const c = addNode(g, NodeOp.lt, [p, { literal: n }], Types.u32)
    const ay = addNode(g, NodeOp.apply, [yes, p])
    const an = addNode(g, NodeOp.apply, [no])
    const s = addNode(g, NodeOp.select, [c, ay, an])
    const ry = addNode(g, NodeOp.ret, [addNode(g, NodeOp.add, [yp, { literal: 1 }], Types.u32), yes])
    const rn = addNode(g, NodeOp.ret, [{ literal: 7 }, no])
    g.root = root
    setGraphBlocks(g, [
        { id: root, params: [p], bodyId: s, bodyConst: 0 },
        { id: yes, params: [yp], bodyId: ry, bodyConst: 0 },
        { id: no, params: [], bodyId: rn, bodyConst: 0 },
    ])
    return g
}

export function suite() {
    function arrSlice(n: u32): number {
        const a = [n, n + 1, n + 2, n + 3]
        return a.slice(1, 3).length * 100 + a.slice(1)[0]
    }
    function arrIndexOf(n: u32): number {
        const a = [1, n, 3]
        return a.indexOf(n) + a.indexOf(99) * 10
    }
    function arrIncludes(n: u32): number {
        const a = [1, n, 3]
        return (a.includes(n) ? 1 : 0) + (a.includes(99) ? 10 : 0)
    }
    function arrConcat(n: u32): number {
        return [1, n].concat([3, 4]).length
    }
    function arrFind(n: u32): number {
        const a = [1, n, 3]
        return a.find(x => x > 2) ?? 0
    }
    function arrFindIndex(n: u32): number {
        return [1, n, 3].findIndex(x => x === n)
    }
    function arrForEach(n: u32): number {
        let s = 0
        const a = [1, n, 3]
        a.forEach(x => {
            s += x
        })
        return s
    }
    function arrReduce(n: u32): number {
        return [1, n, 3].reduce((a, b) => a + b, 0)
    }
    function arrSplice(n: u32): number {
        const a = [1, n, 3, 4]
        a.splice(1, 1)
        return a.length * 100 + a[1]
    }
    function arrFill(n: u32): number {
        const a = new Array(n).fill(2)
        return a.length + a[0]
    }
    function arrNewArray(n: u32): number {
        const a = new Array(n)
        for (let i = 0; i < n; i++) a[i] = i
        return a.length + a[n - 1]
    }
    function arrAt(n: u32): number {
        return [1, 2, n].at(-1)!
    }
    function arrShiftUnshift(n: u32): number {
        const a = [1, 2, n]
        a.unshift(9)
        const x = a.shift()!
        return x * 10 + a.length
    }
    function arrLastIndexOf(n: u32): number {
        return [n, 1, n].lastIndexOf(n)
    }
    function arrFrom(n: u32): number {
        return Array.from({ length: n }, (_, i) => i * 2)[n - 1]
    }
    function arrSpread(n: u32): number {
        const a = [1, n]
        return [...a, 3].length
    }
    function arrPushMany(n: u32): number {
        const a: number[] = []
        a.push(n, n + 1)
        return a.length
    }
    function arrLengthReset(n: u32): number {
        const a = [1, 2, n]
        a.length = 0
        return a.length
    }
    function arrSortNumbers(n: u32): number {
        const a = [3, n, 1]
        a.sort((x, y) => x - y)
        return a[0] * 100 + a[1] * 10 + a[2]
    }
    function arrJoin(n: u32): number {
        return [1, n, 3].join(',').length
    }
    function arrFilterMap(n: u32): number {
        return [1, n, 3].filter(x => x > 1).map(x => x * 2)[0]
    }
    function arrFlatMap(n: u32): number {
        return [1, n].flatMap(x => [x, x]).length
    }
    function arrEntries(n: u32): number {
        let s = 0
        for (const [i, x] of [1, n].entries()) s += i * x
        return s
    }
    function arrKeys(n: u32): number {
        let s = 0
        for (const i of [1, n, 3].keys()) s += i
        return s
    }
    function arrIsArray(n: u32): number {
        return Array.isArray([n]) ? 1 : 0
    }
    function arrOfArrays(n: u32): number {
        const rows: number[][] = []
        for (let i: u32 = 0; i < n; i++) rows.push([i, i + 1])
        let s = 0
        for (const row of rows) s += row[1]
        return s
    }
    function arrDestructure(n: u32): number {
        const [a, b] = [n, n + 1]
        return a * 10 + b
    }

    function mapGetSet(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        m.set(2, n * 2)
        return m.get(2)! + (m.has(3) ? 1 : 0) + m.size
    }
    function mapDelete(n: u32): number {
        const m = new Map<number, number>()
        for (let i: u32 = 0; i < n; i++) m.set(i, i)
        m.delete(1)
        return m.size
    }
    function mapForEach(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        let s = 0
        m.forEach((v, k) => {
            s += v + k
        })
        return s
    }
    function mapEntriesIter(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        m.set(2, 3)
        let s = 0
        for (const [k, v] of m.entries()) s += k * v
        return s
    }
    function mapClear(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        m.clear()
        return m.size
    }
    function mapCtorEntries(n: u32): number {
        const m = new Map<number, number>([[1, n], [2, 3]])
        return m.get(1)!
    }
    function mapStringKeys(n: u32): number {
        const m = new Map<string, number>()
        m.set('a', n)
        m.set('b', 2)
        return m.get('a')!
    }
    function mapSpreadKeys(n: u32): number {
        const m = new Map<number, number>()
        m.set(n, 1)
        return [...m.keys()][0]
    }
    function mapOfArrays(n: u32): number {
        const m = new Map<number, number[]>()
        m.set(1, [n])
        m.get(1)!.push(2)
        return m.get(1)!.length
    }
    function mapGetOrDefault(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        return (m.get(1) ?? 0) + (m.get(2) ?? 5)
    }
    function setAddHas(n: u32): number {
        const s = new Set<number>()
        s.add(n)
        s.add(1)
        return (s.has(n) ? 1 : 0) + s.size
    }
    function setDelete(n: u32): number {
        const s = new Set<number>()
        for (let i: u32 = 0; i < n; i++) s.add(i)
        s.delete(0)
        return s.size
    }
    function setCtorArray(n: u32): number {
        return new Set([1, n, 1]).size
    }
    function setForEach(n: u32): number {
        const s = new Set<number>()
        s.add(n)
        let t = 0
        s.forEach(x => {
            t += x
        })
        return t
    }
    function setSpread(n: u32): number {
        const s = new Set<number>()
        s.add(n)
        s.add(2)
        return [...s].length
    }
    function setClear(n: u32): number {
        const s = new Set<number>()
        s.add(n)
        s.clear()
        return s.size
    }
    function setOfStrings(n: u32): number {
        const s = new Set<string>()
        s.add('a')
        s.add(n > 2 ? 'b' : 'a')
        return s.size
    }

    function mathOps(n: u32): number {
        return Math.max(n, 3) + Math.min(n, 3) + Math.abs(-4) + Math.floor(n / 2) + Math.ceil(n / 2)
    }
    function mathRound(n: u32): number {
        return Math.round(n / 3) + Math.trunc(n / 3) + Math.sign(n)
    }
    function mathSqrt(n: u32): number {
        return Math.sqrt(n * n)
    }
    function mathMaxSpread(n: u32): number {
        return Math.max(...[1, n, 3])
    }
    function mathClz(n: u32): number {
        return Math.clz32(n) + Math.imul(n, 3)
    }
    function numberInteger(n: u32): number {
        return (Number.isInteger(n / 2) ? 1 : 0) + (Number.isSafeInteger(n) ? 10 : 0)
    }
    function numberAsUint(n: u32): number {
        return Number.asUintN(8, n + 256) + Number.asIntN(8, 255)
    }
    function numberCall(n: u32): number {
        return Number(n > 2) + Number(n)
    }
    function numberIsNaN(n: u32): number {
        return (Number.isNaN(n / 0) ? 1 : 0) + (isNaN(n) ? 10 : 0)
    }
    function bigIntOps(n: u32): number {
        return Number(BigInt(n) << BigInt(3))
    }
    function stringLength(n: u32): number {
        return (n > 2 ? 'abc' : 'de').length
    }
    function stringCharCode(n: u32): number {
        return 'abc'.charCodeAt(n % 3)
    }
    function stringSlice(n: u32): number {
        return 'abcdef'.slice(n % 3).length
    }
    function stringStartsWith(n: u32): number {
        return (`x${n}`.startsWith('x') ? 1 : 0)
    }
    function stringIndexOf(n: u32): number {
        return `ab${n}`.indexOf('b')
    }
    function stringSplit(n: u32): number {
        return `a,b,${n}`.split(',').length
    }
    function stringEquals(n: u32): number {
        const s = n > 2 ? 'abc' : 'de'
        return s === 'abc' ? 1 : 0
    }
    function stringNumber(n: u32): number {
        return Number(`${n}`) + 1
    }
    function stringReplace(n: u32): number {
        return `a-${n}`.replace(/-/g, '_').length
    }
    function stringToUpper(n: u32): number {
        return `a${n}`.toUpperCase().length
    }
    function stringPadStart(n: u32): number {
        return `${n}`.padStart(5, '0').length
    }
    function stringRepeat(n: u32): number {
        return 'ab'.repeat(n).length
    }
    function stringIncludes(n: u32): number {
        return `ab${n}`.includes('b') ? 1 : 0
    }
    function stringFromCharCode(n: u32): number {
        return String.fromCharCode(65 + n).length
    }
    function stringToFixed(n: u32): number {
        return (n / 3).toFixed(2).length
    }
    function stringConcatLoop(n: u32): number {
        let s = ''
        for (let i: u32 = 0; i < n; i++) s += 'x'
        return s.length
    }
    function stringKeyedObject(n: u32): number {
        const o: Record<string, number> = {}
        o[`k${n}`] = n
        return o[`k${n}`]
    }
    function typedSlice(n: u32): number {
        const a = new Uint32Array(n)
        a[1] = 5
        return a.slice(1).length + a.slice(1)[0]
    }
    function typedSort(n: u32): number {
        const a = new Uint32Array([3, n, 1])
        a.sort()
        return a[0] * 100 + a[1] * 10 + a[2]
    }
    function typedSet(n: u32): number {
        const a = new Uint32Array(4)
        a.set([n, 2], 1)
        return a[1] + a[2]
    }
    function typedSubarray(n: u32): number {
        const a = new Uint32Array(n)
        a[2] = 7
        return a.subarray(1)[1]
    }
    function typedFill(n: u32): number {
        const a = new Int32Array(n).fill(3)
        return a[n - 1]
    }
    function typedFloat(n: u32): number {
        const a = new Float64Array(n)
        a[0] = n / 2
        return a[0] * 2
    }
    function typedUint16(n: u32): number {
        const a = new Uint16Array(n)
        a[0] = n
        return a[0]
    }
    function typedUint8Slice(n: u32): number {
        const a = new Uint8Array(n)
        a[0] = 200
        return a.slice(0, 1)[0]
    }
    function typedFromArray(n: u32): number {
        return new Int32Array([1, -2, n])[1]
    }
    function typedLengthLoop(n: u32): number {
        const a = new Uint32Array(n)
        let s = 0
        for (let i = 0; i < a.length; i++) s += a[i] + i
        return s
    }
    function objectKeys(n: u32): number {
        const o = { a: n, b: 2 }
        return Object.keys(o).length
    }
    function objectEntries(n: u32): number {
        const o = { a: n, b: 2 }
        let s = 0
        for (const [, v] of Object.entries(o)) s += v
        return s
    }
    function objectAssign(n: u32): number {
        const o = Object.assign({ a: 1 }, { b: n })
        return o.a + o.b
    }
    function objectSpread(n: u32): number {
        const a = { x: n, y: 2 }
        const b = { ...a, y: 3 }
        return b.x + b.y
    }
    function objectInOperator(n: u32): number {
        const o: { a?: number } = n > 2 ? { a: 1 } : {}
        return 'a' in o ? 1 : 0
    }
    function objectFreeze(n: u32): number {
        const o = Object.freeze({ a: n })
        return o.a
    }
    function instanceofOp(n: u32): number {
        const a: any = n > 2 ? [1] : new Map()
        return a instanceof Map ? 1 : 2
    }
    function typeofOp(n: u32): number {
        const a: number | string = n > 2 ? 1 : 'x'
        return typeof a === 'number' ? 1 : 2
    }
    function tryCatch(n: u32): number {
        try {
            if (n > 2) throw 'big'
            return 1
        } catch (e) {
            return 2
        }
    }
    function throwOnly(n: u32): number {
        if (n > 100) throw `too big ${n}`
        return n
    }
    function finallyBlock(n: u32): number {
        let s = 0
        try {
            s = n
        } finally {
            s += 1
        }
        return s
    }
    function localClass(n: u32): number {
        class P {
            x: number
            constructor(x: number) {
                this.x = x
            }
            twice() {
                return this.x * 2
            }
        }
        return new P(n).twice()
    }
    function closureCounter(n: u32): number {
        let c = 0
        const inc = () => {
            c++
        }
        for (let i: u32 = 0; i < n; i++) inc()
        return c
    }
    function recursion(n: u32): number {
        function fib(k: number): number {
            return k < 2 ? k : fib(k - 1) + fib(k - 2)
        }
        return fib(n)
    }
    function optionalChain(n: u32): number {
        const o: { a?: { b: number } } = n > 2 ? { a: { b: n } } : {}
        return o.a?.b ?? 9
    }
    function switchStmt(n: u32): number {
        switch (n % 3) {
            case 0:
                return 10
            case 1:
                return 20
            default:
                return 30
        }
    }
    function labeledBreak(n: u32): number {
        let s = 0
        outer: for (let i: u32 = 0; i < n; i++) {
            for (let j: u32 = 0; j < n; j++) {
                if (i * j > 4) break outer
                s++
            }
        }
        return s
    }
    function forInLoop(n: u32): number {
        const o = { a: n, b: 2 }
        let s = 0
        for (const k in o) s += (o as any)[k]
        return s
    }
    function restParams(n: u32): number {
        function sum(...xs: number[]): number {
            let s = 0
            for (const x of xs) s += x
            return s
        }
        return sum(1, n, 3)
    }
    function defaultParams(n: u32): number {
        function f(a: number, b = 3): number {
            return a + b
        }
        return f(n) + f(n, 1)
    }
    function destructureObj(n: u32): number {
        const { a, b = 4 } = { a: n } as { a: number, b?: number }
        return a + b
    }
    function nullishAssign(n: u32): number {
        const o: { a?: number } = {}
        o.a ??= n
        return o.a
    }
    function bitOps(n: u32): number {
        return ((n << 3) | 1) ^ (n >>> 1) & 0xff
    }
    function floatDivision(n: u32): number {
        return Math.floor((n / 7) * 1000)
    }
    function negativeMod(n: u32): number {
        return (-(n as number)) % 3 + 5
    }
    function u64Math(n: u32): number {
        const x: u64 = n as u64
        return Number((x * (x as u64)) >> (1 as u64))
    }

    function gnCreateGraph(n: u32): number {
        const g = createGraph()
        return g.ids.next + countNodes(g) + n
    }
    function gnMakeGraph(n: u32): number {
        const g = makeGraph(n)
        return countNodes(g) * 100 + g.blocks.length * 10 + g.root
    }
    function gnAddNode(n: u32): number {
        const g = createGraph()
        const id = addNode(g, NodeOp.add, [{ literal: n }, { literal: 2 }], Types.u32)
        return id * 10 + getNode(g, id)!.slots.length
    }
    function gnBigLiteral(n: u32): number {
        const g = createGraph()
        const id = addNode(g, NodeOp.add, [{ literal: n * 2 ** 30 }, { literal: -1 }], Types.u32)
        const node = getNode(g, id)!
        return getLiteral(g, node, 0) / 2 ** 30 + getLiteral(g, node, 1)
    }
    function gnArgIds(n: u32): number {
        const g = makeGraph(n)
        let s = 0
        for (const id of nodeIds(g)) s += getArgIds(getNode(g, id)!).length
        return s
    }
    function gnOpName(n: u32): number {
        return opName(n > 2 ? NodeOp.add : NodeOp.sub).length
    }
    function gnNodeOp(n: u32): number {
        return nodeOp(n > 2 ? 'add' : 'sub') + maybeNodeOp('zzz')
    }
    function gnInternNode(n: u32): number {
        const g = createGraph()
        const table = new Map<number, number>()
        const a = internNode(g, table, NodeOp.add, [literalSlot(g, n), literalSlot(g, 2)], Types.u32)
        const b = internNode(g, table, NodeOp.add, [literalSlot(g, n), literalSlot(g, 2)], Types.u32)
        return a === b ? a : 0
    }
    function gnSlots(n: u32): number {
        const g = createGraph()
        const s = encodeSlot(g, n, 0)
        const l = literalSlot(g, n + 1)
        return slotRef(s) * 100 + slotLiteral(g, l) + slotRef(refSlot(3))
    }
    function gnSlotKey(n: u32): number {
        const g = makeGraph(n)
        const node = getNode(g, 3)!
        return slotKey(node.op, node.slots).length
    }
    function gnFacts(n: u32): number {
        const g = makeGraph(n)
        const node = getNode(g, 3)!
        setFact(node, n)
        return factOf(node) * 10 + countIds(node)
    }
    function gnTypes(n: u32): number {
        const g = makeGraph(n)
        let s = 0
        for (const node of allNodes(g)) s += typeOf(node) + resultType(g, node)
        return s
    }
    function gnOperandType(n: u32): number {
        const g = makeGraph(n)
        return operandType(g, getNode(g, 3)!, 0) + operandType(g, getNode(g, 3)!, 1)
    }
    function gnFnType(n: u32): number {
        const g = createGraph()
        const t = createFnType(g, Types.u32, [n, 2])
        const r = fnReturn(t)
        return (typeof r === 'number' ? r : 0) + fnLocations(t).length * 100
    }
    function gnRecordType(n: u32): number {
        const g = createGraph()
        const t = createRecordType(g, [{ key: n, type: Types.u32 }, { key: 2, type: Types.f64 }])
        return recordFields(g, t).length * 100 + recordFields(g, t)[0].key
    }
    function gnThisParam(n: u32): number {
        const g = createGraph()
        const t = createThisParam(g)
        const l = createLocatedParam(g, n)
        return (isThisParam(t) ? 1 : 0) + (isThisParam(l) ? 10 : 0)
    }
    function gnCopyNode(n: u32): number {
        const g = makeGraph(n)
        const c = copyNode(g, getNode(g, 3)!, [1, { literal: 5 }])
        return getLiteral(g, c, 1) + countIds(c) * 10
    }
    function gnSwap(n: u32): number {
        const g = makeGraph(n)
        const node = getNode(g, 3)!
        swapBinaryOperands(node)
        return getRef(node, 1)
    }
    function gnEnumerateRefs(n: u32): number {
        const g = makeGraph(n)
        let s = 0
        for (const r of enumerateRefs(getNode(g, 4)!)) s += r
        return s
    }
    function gnArgConsts(n: u32): number {
        const g = makeGraph(n)
        return getArgConsts(g, getNode(g, 3)!)[1]
    }
    function gnCloneRefs(n: u32): number {
        const g = makeGraph(n)
        return cloneRefs(getNode(g, 4)!).length + getLiteral(g, getNode(g, 3)!, 1)
    }
    function gnGetOperands(n: u32): number {
        const g = makeGraph(n)
        const ops = getOperands(g, getNode(g, 3)!)
        const x = ops[1]
        return typeof x === 'number' ? x : x.literal
    }
    function gnWithRefs(n: u32): number {
        const g = makeGraph(n)
        return withRefs(g, getNode(g, 3)!, [0, 0]).length
    }
    function gnSetOperands(n: u32): number {
        const g = makeGraph(n)
        const node = getNode(g, 3)!
        setOperand(g, node, 1, { literal: n * 2 })
        setRef(node, 0, 2)
        setLiteral(g, node, 1, n + 9)
        return getLiteral(g, node, 1) + getRef(node, 0) * 100
    }
    function gnPushRefs(n: u32): number {
        const g = makeGraph(n)
        const node = getNode(g, 5)!
        pushRefs(node, [1, n])
        const before = countIds(node)
        clearOperands(node)
        return before * 10 + countIds(node)
    }
    function gnDebugLabel(n: u32): number {
        const g = makeGraph(n)
        setDebugLabel(g, 3, 'x')
        return getDebugLabel(g, 3)!.length + (getDebugLabel(g, 4) === undefined ? 10 : 0)
    }
    function gnPutCopy(n: u32): number {
        const g = makeGraph(n)
        const id = newId(g)
        putNode(g, id, NodeOp.sub, [3, { literal: 1 }], Types.u32)
        const c = addCopy(g, getNode(g, id)!)
        putCopy(g, c, getNode(g, 3)!, [2, { literal: n }])
        return id * 100 + c + (hasNode(g, c) ? 1000 : 0)
    }
    function gnDeleteNode(n: u32): number {
        const g = makeGraph(n)
        const id = insertNode(g, makeNode(g, NodeOp.add, [{ literal: n }, { literal: 1 }], Types.u32))
        deleteNode(g, id)
        return countNodes(g) + (hasNode(g, id) ? 100 : 0)
    }
    function gnRetype(n: u32): number {
        const g = makeGraph(n)
        retypeNode(g, 3, Types.u64)
        return typeOf(getNode(g, 3)!)
    }
    function gnWithOperand(n: u32): number {
        const g = makeGraph(n)
        return withOperand(g, getNode(g, 3)!, 1, { literal: n }).length
    }
    function gnBlocks(n: u32): number {
        const g = makeBranchGraph(n)
        const b = getBlock(g, g.root)!
        return b.params.length + g.blocks.length * 10
    }
    function gnAddBlock(n: u32): number {
        const g = makeGraph(n)
        const id = addNode(g, NodeOp.block, [])
        addGraphBlock(g, { id, params: [], bodyId: 0, bodyConst: n })
        return g.blocks.length * 10 + g.blockIndex.size
    }
    function gnWithNodes(n: u32): number {
        const g = makeGraph(n)
        const h = withNodes(g, copyNodes(g))
        return countNodes(h) + h.blocks.length
    }

    function l2StronglyConnected(n: u32): number {
        const edges = (v: number): number[] => v < n ? [v + 1, 0] : []
        return lowering2.stronglyConnected([0], edges).length
    }
    function l2GraphLoops(n: u32): number {
        const g = makeBranchGraph(n)
        const loops = lowering2.graphLoops(g)
        return loops.loopDepth.size
    }
    function l2TailOf(n: u32): number {
        const g = makeGraph(n)
        return lowering2.tailOf(g, 5)
    }
    function l2IsParam(n: u32): number {
        const g = makeGraph(n)
        return (lowering2.isParam(g, 2) ? 1 : 0) + (lowering2.isParam(g, 3) ? 10 : 0)
    }
    function l2FloatValues(n: u32): number {
        return lowering2.floatValues(makeGraph(n)).size
    }
    function l2ImpureValues(n: u32): number {
        return lowering2.impureValues(makeBranchGraph(n)).size
    }
    function l2WideLiteral(n: u32): number {
        return (lowering2.wideLiteral(n * 2 ** 40) ? 1 : 0) + (lowering2.wideLiteral(n) ? 10 : 0)
    }
    function l2TypeName(n: u32): number {
        return lowering2.typeName(n > 2 ? Types.u32 : Types.f64).length
    }
    function l2FirstSlot(n: u32): number {
        const g = makeGraph(n)
        return lowering2.firstNonOrderingSlot(getNode(g, 3)!) + (lowering2.liftableSlot(NodeOp.add, 1) ? 10 : 0)
    }
    function l2SweepBlocks(n: u32): number {
        const g = makeBranchGraph(n)
        lowering2.sweepBlocks(g)
        return countNodes(g)
    }
    function l2DumpGraph(n: u32): number {
        return lowering2.dumpGraph(makeGraph(n)).length
    }
    function l2Substitute(n: u32): number {
        const g = makeGraph(n)
        const by = new Map<number, gn.Operand>()
        by.set(3, { literal: n })
        lowering2.substitute(g, by)
        return countNodes(g)
    }
    function l2CloneExits(n: u32): number {
        return countNodes(lowering2.cloneExits(makeBranchGraph(n)))
    }
    function l2MemAnalysis(n: u32): number {
        const m = lowering2.memAnalysis(makeGraph(n))
        return m ? 1 : 0
    }
    function l2IsJumbo(n: u32): number {
        return lowering2.isJumbo(makeGraph(n)) ? 1 : 0
    }
    function l2ResolveNumberTypes(n: u32): number {
        const g = makeGraph(n)
        lowering2.resolveNumberTypes(g)
        return countNodes(g)
    }
    function l2Normalize(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeGraph(n)))
    }
    function l2NormalizeBranch(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeBranchGraph(n)))
    }
    function l2Lower(n: u32): number {
        return lowering2.lowerValueGraph(lowering2.normalizeValueGraph(makeGraph(n))).words.length
    }

    function asmRet(n: u32): number {
        const a = lowering.createAarch64Assembler()
        a.ret()
        return a.words().length + n
    }
    function asmMovRet(n: u32): number {
        const a = lowering.createAarch64Assembler()
        a.movImm(0, n)
        a.ret()
        return a.words()[0] & 0xffff
    }
    function asmIsSigned(n: u32): number {
        return lowering.isSignedType(n > 2 ? Types.i32 : Types.u32) ? 1 : 0
    }
    function asmTargetFor(n: u32): number {
        return lowering.targetFor('darwin', 'arm64').name.length + n
    }

    function bcCompile(n: u32): number {
        return bytecode.compile(`function f(x) { return x + ${n} }`).code.length
    }
    function bcCodeIterator(n: u32): number {
        const it = bytecode.createCodeIterator([0, 0, n])
        return it ? 1 : 0
    }


    function gnEmptyGraph(n: u32): number {
        const g = createGraph({})
        return g.ids.next + n
    }
    function gnGraphIds(n: u32): number {
        const g = createGraph({ ids: { next: n } })
        return g.ids.next
    }
    function gnRawGraph(n: u32): number {
        const g = rawGraph(n)
        return countNodes(g) * 100 + g.blocks.length * 10 + g.root
    }
    function gnRawArgIds(n: u32): number {
        const g = rawGraph(n)
        let s = 0
        for (const node of allNodes(g)) s += getArgIds(node).length
        return s
    }
    function gnRawRefs(n: u32): number {
        const g = rawGraph(n)
        const node = getNode(g, 3)!
        return getRef(node, 0) * 100 + getLiteral(g, node, 1) + countIds(node) * 1000
    }
    function gnRawTypeOf(n: u32): number {
        const g = rawGraph(n)
        let s = 0
        for (const node of allNodes(g)) s += typeOf(node)
        return s
    }
    function gnRawResultType(n: u32): number {
        const g = rawGraph(n)
        let s = 0
        for (const node of allNodes(g)) s += resultType(g, node)
        return s
    }
    function gnRawFact(n: u32): number {
        const g = rawGraph(n)
        const node = withFact(getNode(g, 3)!, n)
        return factOf(node) * 10 + countIds(node)
    }
    function gnRawSwap(n: u32): number {
        const g = rawGraph(n)
        const node = getNode(g, 3)!
        swapBinaryOperands(node)
        return getRef(node, 1) + getLiteral(g, node, 0) * 10
    }
    function gnRawCloneRefs(n: u32): number {
        const g = rawGraph(n)
        return cloneRefs(getNode(g, 5)!).length * 10 + getLiteral(g, getNode(g, 3)!, 1)
    }
    function gnRawPushRefs(n: u32): number {
        const g = rawGraph(n)
        const node = getNode(g, 5)!
        pushRefs(node, [1, n])
        const before = countIds(node)
        clearOperands(node)
        return before * 10 + countIds(node)
    }
    function gnRawSetRef(n: u32): number {
        const g = rawGraph(n)
        const node = getNode(g, 4)!
        setRef(node, 0, n)
        setLiteral(g, node, 1, n * 3)
        return getRef(node, 0) * 100 + getLiteral(g, node, 1)
    }
    function gnRawArgConsts(n: u32): number {
        const g = rawGraph(n)
        return getArgConsts(g, getNode(g, 3)!)[1]
    }
    function gnRawSlotKey(n: u32): number {
        const g = rawGraph(n)
        const node = getNode(g, 3)!
        return slotKey(node.op, node.slots).length
    }
    function gnRawEnumerate(n: u32): number {
        const g = rawGraph(n)
        let s = 0
        const it = enumerateRefs(getNode(g, 5)!)
        for (let r = it.next(); !r.done; r = it.next()) s += r.value
        return s + n
    }
    function gnRawBlocks(n: u32): number {
        const g = rawBranchGraph(n)
        return getBlock(g, 3)!.params.length + g.blocks.length * 10 + g.blockIndex.size * 100
    }
    function gnRawIntern(n: u32): number {
        const g = rawGraph(n)
        const table = new Map<number, number>()
        const a = internNode(g, table, NodeOp.sub, [refSlot(2), literalSlot(g, n)], Types.u32)
        const b = internNode(g, table, NodeOp.sub, [refSlot(2), literalSlot(g, n)], Types.u32)
        return a === b ? a : 0
    }
    function gnRawDelete(n: u32): number {
        const g = rawGraph(n)
        deleteNode(g, 4)
        return countNodes(g) + (hasNode(g, 4) ? 100 : 0) + newId(g)
    }
    function gnRawOpName(n: u32): number {
