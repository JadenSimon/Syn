    }
    function tbSubD(n: u32): number {
        const by = new Map<number, gn.Operand>()
        by.set(1, { literal: n })
        return subD(by)
    }
    function tbSubDEmpty(n: u32): number {
        return subD(new Map<number, gn.Operand>()) + n
    }

    function tbPutCopy(n: u32): number {
        const g = rawGraph(n)
        putCopy(g, 4, getNode(g, 4)!, [1, { literal: 2 }])
        return countNodes(g)
