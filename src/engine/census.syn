        setDebugLabel(g, 3, n > 2 ? 'abc' : 'x')
        return getDebugLabel(g, 3)!.length
    }
    function vtScalarType(n: u32): number {
        return (valueTypes.scalarType(n > 2 ? Types.u32 : Types.u64) ? 1 : 0)
