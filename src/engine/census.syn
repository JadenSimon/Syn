    function l2RawJoinEffects(n: u32): number {
        const g = rawGraph(n)
        return lowering2.joinEffects(g, [3, 4])
    }
    function l2RawHotCold(n: u32): number {
        const g = rawBranchGraph(n)
        const h = lowering2.hotCold(g, lowering2.graphLoops(g))
        return h ? 1 : 0
    }
    function l2RawResolveNumbers(n: u32): number {
        const g = rawGraph(n)
        lowering2.resolveNumberTypes(g)
