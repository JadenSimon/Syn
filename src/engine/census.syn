    }
    function recSnapshots(n: u32): number {
        const g = rawGraph(n)
        records.recordSnapshots(g)
        return countNodes(g)
    }
    function recFlatten(n: u32): number {
        return countNodes(records.flattenRecords(rawGraph(n)))
    }
    function vmTags(n: u32): number {
        return vm.tagVmScalar(n) + vm.tagVmHandle(n as intrinsics.Handle) + (vm.isVmHandle(n) ? 1000 : 0)
    }
    function vmFrameSize(n: u32): number {
        return vm.frameSize(n) + vm.frameArg(16, n)
    }
    function rtOpName(n: u32): number {
        return rtModule.opName(n as rtModule.Op).length
    }
    function heapBoxF64(n: u32): number {
        const h = heap.boxF64(n / 4)
        return heap.isBoxedF64(h) ? heap.unboxF64(h) * 4 : 0
    }
    function heapIndirect(n: u32): number {
        const target = heap.boxF64(n + 0.5)
        const cell = heap.makeIndirect(target)
        return heap.isIndirect(cell) && heap.indirectTarget(cell) === target ? 1 : 0
    }
    function heapFromJsString(n: u32): number {
        const h = heap.fromJsString(n > 2 ? 'abcd' : 'x')
        return heap.isString(h) ? heap.HeapString(heap.resolveHeapCell(h)).length * 10 + n : 0
    }
    function heapNumberString(n: u32): number {
        return heap.stringToJs(heap.numberToString(n as u64)).length
    }
    function cgReleaseArena(n: u32): number {
        const h = cg.createHeap(32, 0)
        const root = cg.rootSc(h)
        const arena = cg.createArenaSc(h, root, 1)
        for (let i: u32 = 0; i < n; i++) cg.allocCell(h, arena, 8)
        cg.releaseArena(h, arena)
        return cg.scDepth(h, root) + n
    }
    function cgConvertArena(n: u32): number {
        const h = cg.createHeap(32, 0)
        const root = cg.rootSc(h)
        const arena = cg.createArenaSc(h, root, 1)
        const a = cg.allocCell(h, arena, 8)
        const b = cg.allocCell(h, arena, 8)
        cg.setSingleEdge(h, a, b)
        cg.convertArena(h, arena)
        return cg.localRefCount(h, b) + n
    }
    function cgBuild(n: u32): number {
        const h = cg.createHeap(32, 0)
        const root = cg.rootSc(h)
        const sc = cg.createPoolSc(h, root, 1, 16)
        const build = cg.allocate(4096)
        cg.initBuild(build)
        const parent = cg.beginBuild(h, build, sc, 16)
        const child = cg.beginBuild(h, build, sc, 16)
        cg.finishBuild(h, build, child)
        cg.setSingleEdgeRaw(h, parent, child)
        cg.finishBuild(h, build, parent)
        const out = cg.localRefCount(h, child) + n
        return out
    }
    function bcRegReads(n: u32): number {
        const inst: bytecode.CodeInstruction = { pos: 0, width: 1, opcode: n, opname: 'x', regs: [1, 2], readsAcc: true }
        return bytecode.getRegReads(inst).length * 10 + bytecode.getRegWrites(inst).length
    }
    function bcIterate(n: u32): number {
        const it = bytecode.createCodeIterator([n, 0, 0, 0])
        const first = it.next()
        return first ? first.opcode + first.width * 100 : 0
    }

    function nsRecordsNamed(n: u32): number {
        const g = rawGraph(n)
        recordSnapshots(g)
        return countNodes(g)
    }
    function nsL2After(n: u32): number {
        const g = rawGraph(n)
        return lowering2.tailOf(g, 5) + n
    }
    function nsVtNamed(n: u32): number {
        const users = usersOf(rawGraph(n))
        return users.size * 10 + users.get(2)!.length
    }
    function nsVtScalarNamed(n: u32): number {
        return scalarType(n > 2 ? Types.u32 : Types.u64) ? 1 : 0
    }
    function nsBcNamed(n: u32): number {
        const inst: bytecode.CodeInstruction = { pos: 0, width: 1, opcode: n, opname: 'x', regs: [1, 2], readsAcc: true }
        return getRegReads(inst).length
    }
    function nsLoweringNamed(n: u32): number {
        return isSignedType(n > 2 ? Types.i32 : Types.u32) ? 1 : 0
    }
    function nsVmAfterCall(n: u32): number {
        const g = rawGraph(n)
        return vm.tagVmScalar(countNodes(g))
    }

    function rpTypeofNumberArm(n: u32): number {
        return refOrNumber(n)
    }
    function rpNumberObjectUnion(n: u32): number {
        return refOrNumber(n) + refOrNumber({ ref: n * 2 })
    }
    function rpComputedLabels(n: u32): number {
        return reproLabels[n % 2].length
    }
    function rpPlainLabels(n: u32): number {
        return reproPlain[n % 2].length
    }
    function rpMapStringValue(n: u32): number {
        const m = new Map<number, string>()
        m.set(1, n > 2 ? 'abc' : 'x')
        return m.get(1)!.length
    }
    function rpSpreadParam(n: u32): number {
        const c = spreadCopy({ a: n, b: 1 })
        return c.a + c.b
    }
    function rpRelayedRecord(n: u32): number {
        const cells = [relayedCell(0), relayedCell(1)]
        let s = n
        for (const c of cells) {
            s += c[0]
        }
        return s
    }
    function rpLargeFrame(n: u32): number {
        const cells = [new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32), new Uint32Array(32)]
        let s = n
        for (const c of cells) {
            s += c[0]
        }
        return s
    }
    function rpPushSpread(n: u32): number {
        const a = [1]
        const b = [n, n]
        a.push(...b)
        return a.length
    }
    function rpNegMod(n: u32): number {
        const x = -n
        return x % 3 + 5
    }
    function rpNeg(n: u32): number {
        return -n + 10
    }
    function rpShiftAfterMul(n: u32): number {
        return (n * n) >> 1
    }
    function rpNumberOfBool(n: u32): number {
        return Number(n > 2)
    }
    function rpNumberOfNumber(n: u32): number {
        return Number(n) + 1
    }
    function rpMixedFloatElement(n: u32): number {
        const a: number[] = [n, 2.5]
        return a[n & 1]
    }
    function rpMixedFloatCompare(n: u32): number {
        const a: number[] = [n, 2.5]
        return a[n & 1] !== n ? 1 : 0
    }
    function rpDivide(n: u32): number {
        return (n / 2) * 2
    }
    function rpTypeofUnion(n: u32): number {
        const a: number | string = n > 2 ? 1 : 'x'
        return typeof a === 'number' ? 1 : 2
    }
    function rpTypeofObject(n: u32): number {
        const a: number | { x: number } = n > 2 ? 1 : { x: n }
        return typeof a === 'number' ? 1 : 2
    }
    function rpOptionalParamObject(n: u32): number {
        function make(init?: { next: number }): number {
            return init?.next ?? 7
        }
        return make() + make({ next: n })
    }
    function rpOptionalAbsent(n: u32): number {
        function make(init?: { next: number }): { next: number } {
            return { next: init?.next ?? n }
        }
        return make().next
    }

    function rpDefaultArm(n: u32): number {
        return refOrDefault(n) + refOrDefault()
    }
    function rpDefaultArmPassed(n: u32): number {
        return refOrDefault(n)
    }
    function rpForwardDefault(n: u32): number {
        return forwardDefault(n) + forwardDefault()
