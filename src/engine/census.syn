    function gxGraph(n: u32): number {
        const g = explicitGraph(n)
        return countNodes(g) * 100 + g.blocks.length * 10 + g.root
    }
    function gxArgIds(n: u32): number {
        const g = explicitGraph(n)
        let s = 0
        for (const node of allNodes(g)) s += getArgIds(node).length
        return s
    }
    function gxCopyNode(n: u32): number {
        const g = explicitGraph(n)
        const c = copyNode(g, getNode(g, 3)!, [1, { literal: 5 }], NodeOp.add)
        return getLiteral(g, c, 1) + countIds(c) * 10
    }
    function gxPutNode(n: u32): number {
        const g = explicitGraph(n)
        const id = newId(g)
        putNode(g, id, NodeOp.sub, [3, { literal: n }], Types.u32)
        return getLiteral(g, getNode(g, id)!, 1) + id * 100
    }
    function gxOperands(n: u32): number {
        const g = explicitGraph(n)
        const ops = getOperands(g, getNode(g, 3)!, 0, 2)
        const x = ops[1]
        return typeof x === 'number' ? x : x.literal
    }
    function gxIntern(n: u32): number {
        const g = explicitGraph(n)
        const table = new Map<number, number>()
        const a = internNode(g, table, NodeOp.add, [literalSlot(g, n), literalSlot(g, 2)], Types.u32)
        const b = internNode(g, table, NodeOp.add, [literalSlot(g, n), literalSlot(g, 2)], Types.u32)
        return a === b ? a : 0
    }
    function gxTailOf(n: u32): number {
        return lowering2.tailOf(explicitGraph(n), 5) + n
    }
    function gxSweep(n: u32): number {
        const g = explicitGraph(n)
        lowering2.sweepBlocks(g)
        return countNodes(g)
    }
    function gxFloatValues(n: u32): number {
        return lowering2.floatValues(explicitGraph(n)).size + n
    }
    function gxCaptureFact(n: u32): number {
        const g = explicitGraph(n)
        return lowering2.captureFact(g, 4, 0)
    }
    function gxPanicOrdering(n: u32): number {
        return lowering2.panicOrdering(rawGraph(n), 4).length + n
    }
    function gxInlineBlocks(n: u32): number {
        const g = rawBranchGraph(n)
        lowering2.inlineBlocks(g)
        return countNodes(g)
    }
    function gxPackageBlocks(n: u32): number {
        return countNodes(lowering2.packageBlocksFINAL(rawBranchGraph(n)))
    }
    function gxAnalyze(n: u32): number {
        const a = lowering2.analyzeValueGraph(rawGraph(n))
        return a ? 1 : 0
    }
    function gxSolvePlacements(n: u32): number {
        const g = rawBranchGraph(n)
        const choices = new Map<number, number[]>()
        choices.set(3, [1, 3])
        choices.set(10, [3])
        return solvePlacements(g, choices).parameterCount
    }

    function tbResolveLoop(n: u32): number {
        const by = new Map<number, number>()
        by.set(1, n)
        by.set(n, n + 1)
        function resolve(id: number): number {
            let at = id
            while (by.has(at)) at = by.get(at)!
            return at
        }
        return resolve(1)
    }
    function tbSpreadEntries(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        let s = 0
        for (const [k, v] of [...m]) s += k + v
        return s
    }
    function tbSubstitute(n: u32): number {
        const g = rawGraph(n)
        const by = new Map<number, gn.Operand>()
        lowering2.substitute(g, by)
        return countNodes(g)
    }
    function tbDeleteLoop(n: u32): number {
        const g = rawGraph(n)
        const by = new Map<number, number>()
        by.set(4, 1)
        for (const id of by.keys()) deleteNode(g, id)
        return countNodes(g)
    }
    function tbBlocksLoop(n: u32): number {
        const g = rawGraph(n)
        const by = new Map<number, number>()
        by.set(5, 4)
        for (const b of g.blocks) {
            if (!by.has(b.bodyId)) continue
            b.bodyId = by.get(b.bodyId)!
        }
        return g.blocks[0].bodyId
    }
    function tbNodesSpread(n: u32): number {
        const g = rawGraph(n)
        let s = 0
        for (const [id, node] of [...nodeEntries(g)]) s += id + countIds(node)
        return s
    }
    function hostArgv(n: u32): number {
        return intrinsics.argv().includes('nope') ? 1 : n
    }
    function hostPerformance(n: u32): number {
        const t = performance.now()
        return t >= 0 ? n : 0
    }
    function hostConsole(n: u32): number {
        if (n > 100) console.log('big', n)
        return n
    }

