    }
    function l2RawIsParam(n: u32): number {
        const g = rawGraph(n)
        return (lowering2.isParam(g, 2) ? 1 : 0) + (lowering2.isParam(g, 3) ? 10 : 0)
    }
    function l2RawGraphLoops(n: u32): number {
        return lowering2.graphLoops(rawBranchGraph(n)).loopDepth.size
    }
    function l2RawTailPositions(n: u32): number {
        return lowering2.tailPositions(rawBranchGraph(n), 9).length
    }
    function l2RawFloatValues(n: u32): number {
        return lowering2.floatValues(rawGraph(n)).size + n
    }
    function l2RawImpure(n: u32): number {
        return lowering2.impureValues(rawBranchGraph(n)).size + n
    }
    function l2RawFirstSlot(n: u32): number {
