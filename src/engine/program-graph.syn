/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import { argForm, ArgForm, getLiteral, getNode, isThisParam, NodeOp, unknownLayout, type Layout, type NodeSpace } from './graph-node'
import type { Graph, GraphNode } from './lowering2'
import { usedCaptures, type EmitResult } from './bytecode-emitter'
import type { CompiledSource, TraceSession } from './trace2'

export interface Code {
    input: string | EmitResult
    captures: any[]
    ambient?: string[]
    source: CompiledSource
    scope?: EmitResult['scopeBindings']
}

export interface Unit {
    fn: Function
    origin?: Function
    symbol?: number
    code?: Code
    source?: CompiledSource
    deps?: Function[]
    scheduled?: boolean
    graph?: Graph
    tracing?: boolean
    restExtras?: number
    spreadFixed?: number
    spreadRest?: boolean
    variantOf?: Function
}

interface Clock {
    timed<T>(phase: string, run: () => T, unit?: string): T
}

const arityVariants = new WeakMap<Function, Map<number, Function>>()
const spreadVariants = new WeakMap<Function, Function>()

export function namedStub(name: string): Function {
    return Object.defineProperty(function stub() {}, 'name', { value: name })
}

export function isLocalStub(f: any): boolean {
    return Number.isSafeInteger(f?.__localTarget)
}

export function createBinder(fns: Record<string, Function>, session: TraceSession, clock: Clock) {
    const unitsByFn = new Map<Function, Unit>()
    function unitOf(fn: Function): Unit {
        let unit = unitsByFn.get(fn)
        if (!unit) unitsByFn.set(fn, unit = { fn })
        return unit
    }
    const functions: Function[] = []
    const roots = new Map<string, number>()
    function constructsOutOfLine(fn: Function): boolean {
        return session.isConstructor(originOf(fn))
    }
    function intern(f: Function): number {
        const unit = unitOf(f)
        if (unit.symbol !== undefined) return unit.symbol
        const id = functions.length
        unit.symbol = id
        functions.push(f)
        return id
    }
    const templateFunctions = new Map<EmitResult, Function>()
    const stubSources = new Map<Function, EmitResult>()
    function codeOf(fn: Function): Code | undefined {
        const unit = unitOf(fn)
        if (unit.code) return unit.code
        if (typeof (fn as any)[Symbol.for('toComputation')] !== 'function') return
        unit.code = clock.timed('bytecode', () => ({ ...session.functionCode(fn) }), fn.name)
        return unit.code
    }
    function traceable(fn: Function): boolean {
        return !!codeOf(fn)
    }
    function closureBody(handle: u32, name: string): Function {
        const template = session.templateOf(handle)!
        const known = templateFunctions.get(template.compiled)
        if (known) return known
        const fn = namedStub(template.compiled.name || `${name}/closure`)
        templateFunctions.set(template.compiled, fn)
        stubSources.set(fn, template.compiled)
        unitOf(fn).code = {
            input: template.compiled, captures: template.captures,
            source: session.compileTemplate(template.compiled), scope: template.compiled.scopeBindings,
        }
        return fn
    }
    function closureFunction(handle: u32, name: string): Function {
        const fn = closureBody(handle, name)
        intern(fn)
        discover(fn)
        schedule(fn)
        closureSymbols.set(handle, unitOf(fn).symbol!)
        return fn
    }
    function linkedValues(fn: Function): any[] {
        const code = codeOf(fn)
        if (!code) throw new Error(`link: ${fn.name || 'anonymous function'} has no computation`)
        const used = usedCaptures(code.source.compiled)
        const captures = code.captures.filter((_, i) => used.has(i))
        if (!code.ambient) return captures
        return [...captures, ...code.ambient.map(name => session.globals[name])]
    }
    const discovered: Function[] = []
    function discover(fn: Function): void {
        const unit = unitOf(fn)
        if (unit.deps) return
        intern(fn)
        discovered.push(fn)
        const deps: Function[] = []
        unit.deps = deps
        const inlined: any[] = []
        for (const capture of linkedValues(fn)) {
            if (typeof capture !== 'function') continue
            const linked: any = capture
            if (linked.shouldInline) {
                inlined.push(capture)
                continue
            }
            if (Number.isSafeInteger(linked.__syscall)
                || Number.isSafeInteger(linked.__native)
                || linked.__external === true) continue
            const original = isLocalStub(linked) ? functions[linked.__localTarget] : capture
            deps.push(original)
            discover(original)
        }
        if (!inlined.length) return
        const seen = new Set<any>(deps)
        while (inlined.length) {
            const f = inlined.pop()
            seen.add(f)
            for (const x of linkedValues(f)) {
                if (typeof x !== 'function') continue
                if (Number.isSafeInteger(x.__syscall)
                    || Number.isSafeInteger(x.__native)
                    || x.__external === true) continue
                if (seen.has(x)) continue
                seen.add(x)
                if (x.shouldInline) {
                    inlined.push(x)
                    continue
                }
                const original = isLocalStub(x) ? functions[x.__localTarget] : x
                deps.push(original)
                discover(original)
            }
        }
    }
    const order: Function[] = []
    function schedule(fn: Function): void {
        const unit = unitOf(fn)
        if (unit.scheduled) return
        unit.scheduled = true
        order.push(fn)
    }
    function layoutOfFn(fn: Function): Layout {
        const compiled = codeOf(fn)?.source.compiled
        if (!compiled) return unknownLayout
        return { params: compiled.paramCount, rest: compiled.rest ? compiled.paramCount - 1 : -1 }
    }
    function variantsAllowed(fn: Function): boolean {
        return !!codeOf(fn)?.source.compiled.rest && !(fn as any).shouldNotInline && !constructsOutOfLine(fn)
    }
    function variantOf(fn: Function, count: number): Function {
        const code = codeOf(fn)!
        const rest = code.source.compiled.paramCount - 1
        const extras = count > rest ? count - rest : 0
        let variants = arityVariants.get(fn)
        if (!variants) arityVariants.set(fn, variants = new Map())
        let variant: any = variants.get(extras)
        if (!variant) {
            variant = namedStub(`${fn.name || 'anon'}/${rest + extras}`)
            for (const k of Object.keys(fn)) variant[k] = (fn as any)[k]
            variants.set(extras, variant)
        }
        const own = unitOf(variant)
        if (own.variantOf) return variant
        own.code = { ...code, source: { ...code.source, compiled: { ...code.source.compiled, paramCount: rest + extras, rest: false } } }
        own.restExtras = extras
        own.variantOf = fn
        return variant
    }
    function spreadVariantOf(fn: Function): Function {
        const code = codeOf(fn)!
        const rest = !!code.source.compiled.rest
        const fixed = rest ? code.source.compiled.paramCount - 1 : code.source.compiled.paramCount
        let variant: any = spreadVariants.get(fn)
        if (!variant) {
            variant = namedStub(`${fn.name || 'anon'}/...`)
            for (const k of Object.keys(fn)) variant[k] = (fn as any)[k]
            spreadVariants.set(fn, variant)
        }
        const own = unitOf(variant)
        if (own.variantOf) return variant
        own.code = { ...code, source: { ...code.source, compiled: { ...code.source.compiled, paramCount: 1, rest: true } } }
        own.spreadFixed = fixed
        own.spreadRest = rest
        own.variantOf = fn
        return variant
    }
    function boundTarget(fn: Function, count: number, spread: boolean): Function {
        const layout = layoutOfFn(fn)
        const form = argForm(layout, count, spread, variantsAllowed(fn))
        if (form === ArgForm.arity) return variantOf(fn, count)
        if (form === ArgForm.unbound && count === 1 && layout.rest > 0 && variantsAllowed(fn)) return spreadVariantOf(fn)
        if (form === ArgForm.unpack && count === 1 && !(fn as any).shouldNotInline && !constructsOutOfLine(fn)) return spreadVariantOf(fn)
        if (form === ArgForm.pack) throw `native: ${fn.name || 'anonymous'} takes rest arguments the call does not pack`
        if (form === ArgForm.unpack || form === ArgForm.unbound) throw `native: a spread call into ${fn.name || 'anonymous'} needs its arguments unpacked`
        return fn
    }
    function link(fn: Function): number {
        if (!session.reached(fn)) session.typeRoots([fn], false)
        const symbol = intern(fn)
        discover(fn)
        schedule(fn)
        return symbol
    }
    const closureSymbols = new Map<u32, number>()
    function originOf(fn: Function): Function {
        return unitOf(fn).origin ?? fn
    }
    function derive(fn: Function, name: string): Function {
        const origin = originOf(fn)
        const specialized = namedStub(name)
        const unit = unitOf(specialized)
        unit.code = codeOf(origin)!
        unit.origin = origin
        return specialized
    }
    function isRoot(fn: Function): boolean {
        for (const symbol of roots.values()) if (functions[symbol] === fn) return true
        return false
    }
    function sourceOfLinked(fn: Function): CompiledSource | undefined {
        return codeOf(fn)?.source
    }
    function usesReceiver(fn: Function): boolean {
        const source = sourceOfLinked(fn)
        return !!source && source.blocks.liveIn[0].has(source.compiled.registerCount)
    }
    function thisParamOf(graph: Graph): number | undefined {
        return graph.blocks[0].params.find(p => {
            const n = getNode(graph, p)
            return !!n && isThisParam(n)
        })
    }
    function calleeOf(g: NodeSpace, target: GraphNode): Function | undefined {
        const handle = getLiteral(g, target, 0)
        if (target.op === NodeOp.localTarget) {
            const fn = functions[handle]
            return fn && !usesReceiver(fn) ? fn : undefined
        }
        return functionOfCell(handle)
    }
    function functionOfCell(handle: number): Function | undefined {
        const stub = session.stubFunctions.get(handle as u32)
        if (stub) return stub
        if (!session.templateOf(handle as u32)) return
        const fn = closureFunction(handle as u32, 'closure')
        return codeOf(fn)!.scope?.length ? undefined : fn
    }
    function functionOf(handle: u32): Function | undefined {
        const stub = session.stubFunctions.get(handle) as any
        if (stub) return isLocalStub(stub) ? functions[stub.__localTarget] : stub
        return session.templateOf(handle) ? closureBody(handle, 'closure') : undefined
    }
    function symbolOfClosure(handle: u32): number | undefined {
        return closureSymbols.get(handle) ?? (session.templateOf(handle) ? unitOf(closureFunction(handle, 'closure')).symbol : undefined)
    }
    const traced: Function[] = []
    let trace: ((fn: Function) => Graph) | undefined
    let frozen = false
    function traceWith(tracer: (fn: Function) => Graph): void {
        trace = tracer
    }
    function freeze(): void {
        frozen = true
    }
    function adopt(fn: Function, graph: Graph): void {
        const unit = unitOf(fn)
        graph.unit = intern(fn)
        unit.graph = graph
        unit.source = codeOf(fn)!.source
        traced.push(fn)
    }
    function graphOf(fn: Function): Graph {
        const unit = unitOf(fn)
        if (unit.graph) return unit.graph
        intrinsics.assert(!frozen, `native: ${fn.name} is traced after planning`)
        intrinsics.assert(!unit.tracing, `native: ${fn.name} is already being traced`)
        unit.tracing = true
        defer unit.tracing = false
        adopt(fn, trace!(fn))
        return unit.graph!
    }
    for (const [name, fn] of Object.entries(fns)) {
        intrinsics.assert(typeof fn === 'function')
        roots.set(name, intern(fn))
    }
    for (const fn of Object.values(fns)) discover(fn)
    for (const fn of Object.values(fns)) schedule(fn)
    const identityOf = (fn: Function): unknown => stubSources.get(fn) ?? fn
    return {
        session, functions, roots, order, traced, identityOf, discovered, unitOf, originOf, intern, constructsOutOfLine, codeOf, traceable, layoutOfFn, variantsAllowed, boundTarget, closureBody, closureFunction, functionOfCell, functionOf, symbolOfClosure,
        discover, schedule, link, derive, isRoot, sourceOfLinked, usesReceiver, thisParamOf, calleeOf, graphOf, adopt, traceWith, freeze,
    }
}

export type Binder = ReturnType<typeof createBinder>
