/// @synth

"use wrapped";

import ts from 'typescript' // XXX: used for `api.zig`
import * as intrinsics from './intrinsics'
import * as bytecode from './bytecode-emitter'
import {
    Op, createInterpreter, frameSize, frameRegs, isVmHandle, tagVmHandle, tagVmValue, vmHandle,
    vmValue,
} from './vm'
import * as lowering from './lowering'
import * as lowering2 from './lowering2'
import * as heap from './heap'
import { createHeapRecords, type HeapRecords, type HeapState } from './heap-records'
import * as native from './native'
import * as syscalls from './syscalls'

type usize = u32

const dumpEveryListing = intrinsics.argv().includes('lower-debug')
let anonymousGraphs = 0
function lowerValueGraph(
    g: lowering2.Graph,
    opts: lowering2.LowerGraphOptions = {},
): lowering2.LowerGraphResult {
    const result = lowering2.lowerValueGraph(g, opts)
    if (dumpEveryListing && !opts.debug) {
        console.log(`--- ${g.name ?? `anonymous#${++anonymousGraphs}`} listing ---\n`, result.listing)
    }
    return result
}

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const assert = intrinsics.assert

const TerminalOpcodes = new Set<number>([Op.Return, Op.ReturnVoid, Op.Throw, Op.ReThrow])
const CondJumpOpcodes = new Set<number>([
    Op.JumpIfNull, Op.JumpIfUndefined, Op.JumpIfNullish, Op.JumpIfToBooleanFalse,
    Op.JumpIfNotNull, Op.JumpIfNotUndefined, Op.JumpIfNotNullish, Op.JumpIfToBooleanTrue,
])

function findLeaders(code: readonly u8[], codeLen: number): number[] {
    const set = new Set<number>([0])
    const it = bytecode.createCodeIterator(code)
    const insts: bytecode.CodeInstruction[] = []
    while (const inst = it.next()) {
        if (inst.pos >= codeLen) break
        insts.push(inst)
    }
    for (let i = 0; i < insts.length; i++) {
        const inst = insts[i]
        const after = i + 1 < insts.length ? insts[i + 1].pos : codeLen
        if (TerminalOpcodes.has(inst.opcode)) { set.add(after); continue }
        if (inst.jumpTarget !== undefined) {
            set.add(inst.jumpTarget)
            set.add(after)
        }
    }
    const out: number[] = []
    for (const l of set) {
        if (l < codeLen) out.push(l)
    }
    out.sort((a, b) => a - b)
    return out
}

interface Blocks {
    leaders: number[]
    order: number[]
    succs: number[][]
    preds: number[][]
    insts: bytecode.CodeInstruction[][]
    inCycle: boolean[]
    symPred: boolean[]
    symbolicJoins: Set<number>
    symIn: Set<number>[]
    writes: Set<number>[]
    cycleWrites: Set<number>[]
    readSlots: number[][]
    liveIn: Set<number>[]
    cycles: Set<number>[]
    exits: number[][]
}

interface Step {
    kind: string
    from: number
    outs: Float64Array
    target: number
    condId: number
    condConst: number
    thenPc: number
    elsePc: number
    valueId: number
    valueConst: number
}

interface Node {
    op: string
    argIds: number[]
    argConsts?: Float64Array
    label: string
    types?: intrinsics.Types[]
}

interface TraceFrame {
    dispatch(pc: number): number
    branch(cond: any, v1: number, v2: number): number
    canexit(acc: any): boolean
    voidvalue(): any
    panic(acc: any): void
    call(target: any, thisArg: any, regStart: number, nargs: number, cb: any): any
}

interface SessionBlock {
    params: number[]
    inputs: number[]
    argumentIndices: number[]
    consumesEffectToken: boolean
    body: any
}

interface TraceRuntime {
    tracer: any
    mem: Float64Array
    heapOverlay: Map<number, any>
    nodes: Map<number, Node>
    nodeCache: Map<string, number>
    blocks: Map<number, SessionBlock>
    frames: TraceFrame[]
    objects: HeapRecords
    nilEffect?: any
    memoryLoad?: (ptr: number, offset: number, T: number) => any
    depth: number
}

const CompareOps = new Set<string>(['lt', 'le', 'gt', 'ge', 'eq', 'ne'])

const CallOpcodes = new Set<number>([
    Op.Call, Op.CallConst, Op.Construct, Op.ConstructConst,
])

const LoadOpcodes = new Set<number>([
    Op.GetProperty, Op.GetPropertyConst, Op.GetPropertyImm,
])

const StoreOpcodes = new Set<number>([
    Op.SetProperty, Op.SetPropertyConst, Op.SetPropertyImm,
])

function deriveBlocks(
    code: readonly u8[], codeLen: number, paramCount: number,
    accSlot: number, tokenSlot: number,
): Blocks {
    function readsToken(opcode: number): boolean {
        return CallOpcodes.has(opcode) || LoadOpcodes.has(opcode) || StoreOpcodes.has(opcode)
    }
    function writesToken(opcode: number): boolean {
        return readsToken(opcode)
    }
    function readsOf(inst: bytecode.CodeInstruction): number[] {
        const out: number[] = []
        for (const r of bytecode.getRegReads(inst)) out.push(r === -1 ? accSlot : r)
        if (readsToken(inst.opcode)) out.push(tokenSlot)
        return out
    }
    function writesOf(inst: bytecode.CodeInstruction): number[] {
        const out: number[] = []
        for (const r of bytecode.getRegWrites(inst)) out.push(r === -1 ? accSlot : r)
        if (writesToken(inst.opcode)) out.push(tokenSlot)
        return out
    }

    const leaders = findLeaders(code, codeLen)
    const n = leaders.length
    const at = new Map<number, number>()
    for (let i = 0; i < n; i++) at.set(leaders[i], i)

    const all: bytecode.CodeInstruction[] = []
    {
        const it = bytecode.createCodeIterator(code)
        while (const inst = it.next()) {
            if (inst.pos >= codeLen) break
            all.push(inst)
        }
    }
    const insts: bytecode.CodeInstruction[][] = []
    for (let i = 0; i < n; i++) insts.push([])
    {
        let bi = 0
        for (const inst of all) {
            while (bi + 1 < n && inst.pos >= leaders[bi + 1]) bi++
            insts[bi].push(inst)
        }
    }

    const succs: number[][] = []
    for (let i = 0; i < n; i++) {
        const own = insts[i]
        const last = own[own.length - 1]
        const after = i + 1 < n ? leaders[i + 1] : codeLen
        const s: number[] = []
        function to(pc: number): void {
            const t = at.get(pc)
            if (t !== undefined) s.push(t)
        }
        if (!TerminalOpcodes.has(last.opcode)) {
            if (last.jumpTarget !== undefined) {
                if (CondJumpOpcodes.has(last.opcode)) to(after)
                to(last.jumpTarget)
            } else if (after < codeLen) to(after)
        }
        succs.push(s)
    }
    const preds: number[][] = []
    for (let i = 0; i < n; i++) preds.push([])
    for (let i = 0; i < n; i++) {
        for (const target of succs[i]) preds[target].push(i)
    }
    const order: number[] = []
    const visited = new Set<number>()
    function visit(b: number): void {
        if (visited.has(b)) return
        visited.add(b)
        for (const next of succs[b]) visit(next)
        order.push(b)
    }
    visit(0)
    order.reverse()
    const inCycle: boolean[] = []
    for (let i = 0; i < n; i++) {
        const seen = new Set<number>()
        const stack = succs[i].slice()
        let hit = false
        while (stack.length) {
            const x = stack.pop()!
            if (x === i) { hit = true; break }
            if (seen.has(x)) continue
            seen.add(x)
            for (const y of succs[x]) stack.push(y)
        }
        inCycle.push(hit)
    }

    const symIn: Set<number>[] = []
    const writes: Set<number>[] = []
    for (let i = 0; i < n; i++) {
        symIn.push(new Set<number>())
        const w = new Set<number>()
        for (const inst of insts[i]) {
            for (const r of writesOf(inst)) w.add(r)
        }
        writes.push(w)
    }
    for (let i = 0; i < paramCount; i++) symIn[0].add(i)

    const readSlots: number[][] = []
    for (let i = 0; i < n; i++) {
        const rs = new Set<number>()
        const defined = new Set<number>()
        for (const inst of insts[i]) {
            for (const r of readsOf(inst)) if (!defined.has(r)) rs.add(r)
            for (const r of writesOf(inst)) defined.add(r)
        }
        readSlots.push([...rs])
    }

    const symPred: boolean[] = []
    for (let i = 0; i < n; i++) symPred.push(false)
    const symbolicJoins = new Set<number>()
    const joins: { source: number, block: number, writes: Set<number> }[] = []
    for (let source = 0; source < n; source++) {
        if (succs[source].length < 2) continue
        const arms = succs[source].map(start => {
            const reach = new Set<number>()
            const pending = [start]
            while (pending.length) {
                const b = pending.pop()!
                if (b === source || reach.has(b)) continue
                reach.add(b)
                for (const next of succs[b]) pending.push(next)
            }
            return reach
        })
        const count = (b: number) => arms.filter(arm => arm.has(b)).length
        for (let block = 0; block < n; block++) {
            if (preds[block].length < 2 || count(block) < 2
                || !preds[block].some(pred => count(pred) < 2)) continue
            const written = new Set<number>()
            const seen = new Set<number>()
            const pending = succs[source].slice()
            while (pending.length) {
                const b = pending.pop()!
                if (b === source || b === block || seen.has(b)) continue
                seen.add(b)
                for (const slot of writes[b]) written.add(slot)
                for (const next of succs[b]) pending.push(next)
            }
            joins.push({ source, block, writes: written })
        }
    }
    const symOut: Set<number>[] = []
    for (let i = 0; i < n; i++) symOut.push(new Set<number>())

    function cycleRegion(h: number): Set<number> {
        const out = new Set<number>([h])
        const stack: number[] = []
        for (const s of succs[h]) if (s < h) stack.push(s)
        while (stack.length) {
            const b = stack.pop()!
            if (out.has(b) || b > h) continue
            out.add(b)
            for (const s of succs[b]) if (s <= h) stack.push(s)
        }
        return out
    }

    let changed = true
    while (changed) {
        changed = false
        for (let i = 0; i < n; i++) {
            const live = new Set<number>(symIn[i])
            let predSym = false
            const own = insts[i]
            for (let k = 0; k < own.length; k++) {
                const inst = own[k]
                let tainted = false
                for (const r of readsOf(inst)) {
                    if (live.has(r)) { tainted = true; break }
                }
                for (const w of writesOf(inst)) {
                    if (tainted) live.add(w)
                    else live.delete(w)
                }
                if (k === own.length - 1 && CondJumpOpcodes.has(inst.opcode)) {
                    predSym = live.has(accSlot)
                }
            }
            if (predSym !== symPred[i]) { symPred[i] = predSym; changed = true }
            for (const r of live) {
                if (symOut[i].has(r)) continue
                symOut[i].add(r)
                changed = true
            }
            for (const t of succs[i]) {
                for (const r of symOut[i]) {
                    if (symIn[t].has(r)) continue
                    symIn[t].add(r)
                    changed = true
                }
            }
        }
        for (const join of joins) {
            if (!symPred[join.source]) continue
            symbolicJoins.add(join.block)
            for (const slot of join.writes) {
                if (symIn[join.block].has(slot)) continue
                symIn[join.block].add(slot)
                changed = true
            }
        }
        if (changed) continue
        // TODO: some writes are always known despite being in a symbolic block
        for (let i = 0; i < n; i++) {
            if (!inCycle[i]) continue
            const region = cycleRegion(i)
            if (![...region].some(block => symPred[block]
                || readSlots[block].some(slot => symIn[block].has(slot)))) continue
            for (const x of region) {
                for (const w of writes[x]) {
                    if (symIn[i].has(w)) continue
                    symIn[i].add(w)
                    changed = true
                }
            }
        }
    }

    const liveIn: Set<number>[] = []
    for (let i = 0; i < n; i++) liveIn.push(new Set<number>())
    {
        let going = true
        while (going) {
            going = false
            for (let i = n - 1; i >= 0; i--) {
                const live = new Set<number>()
                for (const t of succs[i]) {
                    for (const r of liveIn[t]) live.add(r)
                }
                const own = insts[i]
                for (let k = own.length - 1; k >= 0; k--) {
                    for (const w of writesOf(own[k])) live.delete(w)
                    for (const r of readsOf(own[k])) live.add(r)
                }
                let same = live.size === liveIn[i].size
                if (same) {
                    for (const r of live) {
                        if (liveIn[i].has(r)) continue
                        same = false
                        break
                    }
                }
                if (same) continue
                liveIn[i] = live
                going = true
            }
        }
    }

    const cycleWrites: Set<number>[] = []
    for (let i = 0; i < n; i++) {
        const w = new Set<number>()
        if (inCycle[i]) {
            for (const x of cycleRegion(i)) {
                for (const r of writes[x]) w.add(r)
            }
            for (const r of writes[i]) w.add(r)
        }
        cycleWrites.push(w)
    }

    const cycles: Set<number>[] = []
    const exits: number[][] = []
    for (let i = 0; i < n; i++) {
        const region = inCycle[i] ? cycleRegion(i) : new Set<number>()
        cycles.push(region)
        const out = new Set<number>()
        for (const b of region) {
            for (const target of succs[b]) if (!region.has(target)) out.add(target)
        }
        exits.push([...out])
    }

    return {
        leaders, order, succs, preds, insts, inCycle, symPred, symbolicJoins, symIn, writes, cycleWrites,
        liveIn, readSlots, cycles, exits,
    }
}

export interface TraceSession {
    intrinsicContext: Record<string, any>
    moduleContext: Record<string, any>
    objectBuiltins: Record<string, any>
    intrinsicFns: Map<number, string>
    functionStubs: Map<Function, number>
    stubFunctions: Map<number, Function>
    compiledFunctions: Map<Function, number>
    symbolicMemory: Set<number>
    traceHandles: Set<u32>
    symbolicDispatch: Function
    symbolicJmp: Function
    symbolicBranch: Function
    symbolicPanic: Function
    symbolicError: Function
    runtime?: TraceRuntime
    mk(op: string, args: Float64Array, label?: string, types?: intrinsics.Types[]): any
    fromJsValue(v: any): u32
    linkFunction(f: Function): u32
    finalize(compiled: bytecode.EmitResult, captures?: any[]): u32
    enterTrace(): TraceRuntime
    leaveTrace(): void
}

const symbolicMemoryTag = Symbol('trace.symbolicMemory')

interface SymbolicMemory {
    [symbolicMemoryTag]: true
    ptr: number
}

export function symbolicMemory(ptr: number | bigint): usize {
    return { [symbolicMemoryTag]: true, ptr: Number(ptr) } as any
}

function isSymbolicMemory(v: any): v is SymbolicMemory {
    return !!v?.[symbolicMemoryTag]
}

let cachedTypesHeapObj: any
function getCachedTypes() {
    if (cachedTypesHeapObj) return cachedTypesHeapObj
    const h = heap.fromJsObject(Types)
    return cachedTypesHeapObj = heap.createHeapHandle(h) 
}

let cachedIntrinsicsHeapObj: {
    stubs: Map<number, string>
    wrapper: any
}
function getCachedIntrinsics() {
    if (cachedIntrinsicsHeapObj) return cachedIntrinsicsHeapObj
    const stubs = new Map<number, string>()
    const o: any = {}
    for (const [name, value] of Object.entries(Intrinsics)) {
        const stub = heap.makeFunctionObject()
        stubs.set(stub, name)
        o[name] = heap.createHeapHandle(stub)
    }
    const h = heap.fromJsObject(o)
    return cachedIntrinsicsHeapObj = {
        stubs,
        wrapper: heap.createHeapHandle(h),
    }
}

let sharedTraceBuffer: ArrayBuffer | undefined
let traceMemLow = 0

function noteTraceMemLow(addr: number): void {
    if (addr < traceMemLow) traceMemLow = addr
}

export function createTraceSession(): TraceSession {
    const intrinsicNames = new Map<Function, string>()
    function symbolicDispatch(pc: number): number { return pc }
    function symbolicJmp(pc: number, off: number): number { return pc + off }
    function symbolicBranch(cond: boolean, v1: usize, v2: usize) {
        return cond ? v1 : v2
    }
    function symbolicPanic(err: any, T: any) {}
    function symbolicError(message: any) {}
    const intrinsicContext: Record<string, any> = { ...Intrinsics }
    for (const [name, value] of Object.entries(Intrinsics)) {
        if (typeof value !== 'function') continue
        intrinsicNames.set(value, name)
        const forward = (...args: any[]) => (Intrinsics as any)[name](...args)
        intrinsicNames.set(forward, name)
        intrinsicContext[name] = forward
    }
    intrinsicContext.branch = symbolicBranch
    intrinsicContext.dispatch = symbolicDispatch
    intrinsicContext.jmp = symbolicJmp
    intrinsicContext.branch = symbolicBranch
    intrinsicContext.panic = symbolicPanic
    const moduleContext = { ...intrinsics, Intrinsics: getCachedIntrinsics().wrapper }
    const objectBuiltins = { setPrototypeOf: Object.setPrototypeOf }
    const math = {
        floor: intrinsics.tagInline((v: number) => v),
    }
    const intrinsicFns = getCachedIntrinsics().stubs
    const functionStubs = new Map<Function, number>()
    const stubFunctions = new Map<number, Function>()
    const compiledFunctions = new Map<Function, number>()
    const symbolicMemory = new Set<number>()
    let runtime: TraceRuntime | undefined

    function context(captures: any[] = []): Record<string, any> {
        const ctx: Record<string, any> = {
            Intrinsics: intrinsicContext, Math: math, Object: objectBuiltins, Error: symbolicError,
            intrinsics: moduleContext, heap, syscalls,
        }
        for (let i = 0; i < captures.length; i++) {
            const capture = captures[i]
            ctx[`$${i}`] = capture === Intrinsics ? getCachedIntrinsics().wrapper
                : capture === intrinsics ? moduleContext 
                : capture === Types ? getCachedTypes() : capture
        }
        return ctx
    }

    function linkFunction(f: Function): u32 {
        const prev = functionStubs.get(f)
        if (prev !== undefined) return prev as u32
        const stub = heap.makeFunctionObject()
        functionStubs.set(f, stub)
        stubFunctions.set(stub, f)
        const intrinsicName = intrinsicNames.get(f)
        if (intrinsicName !== undefined) intrinsicFns.set(stub, intrinsicName)
        return stub
    }

    const convertJsValue = heap.createJsValueConverter(linkFunction)
    function fromJsValue(v: any): u32 {
        if (!isSymbolicMemory(v)) return convertJsValue(v)
        symbolicMemory.add(v.ptr)
        return heap.boxF64(v.ptr as f64)
    }

    function mk(op: string, args: Float64Array, label: string = '', types?: intrinsics.Types[]): any {
        const r = runtime
        if (!r) throw 'trace: mk requires an open trace'
        const tracer = r.tracer
        const argIds: number[] = []
        const argConsts = new Float64Array(args.length)
        const parts: string[] = [op, label]
        if (types) for (const T of types) parts.push(`t${T}`)
        for (let i = 0; i < args.length; i++) {
            const id = tracer.getNanId(args[i])
            argIds.push(id)
            argConsts[i] = args[i]
            parts.push(id ? `v${id}` : `c${args[i]}`)
        }
        tracer.assertIsTaggedNanStill(args)
        const key = parts.join('|')
        if (const hit = r.nodeCache.get(key)) return intrinsics.getNanFromId(hit) as any
        const v = tracer.createUniqueNan()
        const id = tracer.getNanId(v)
        r.nodeCache.set(key, id)
        r.nodes.set(id, { op, argIds, argConsts, label, types })
        tracer.assertIsTaggedNanStill(r.nodes.get(id), label)
        return v
    }

    function finalize(compiled: bytecode.EmitResult, captures?: any[]): u32 {
        return bytecode.finalize(
            compiled,
            bytecode.createCtx(context(captures)),
            linkFunction,
            fromJsValue,
        )
    }

    function enterTrace(): TraceRuntime {
        if (!runtime) {
            const slots = intrinsics.heapMaxAddress * 2
            if (!sharedTraceBuffer) {
                sharedTraceBuffer = new ArrayBuffer(slots * 8)
                traceMemLow = slots
            }
            const mem = new Float64Array(sharedTraceBuffer)
            if (traceMemLow < slots) mem.fill(0, traceMemLow, slots)
            traceMemLow = slots
            const heapOverlay = new Map<number, any>()
            const nodes = new Map<number, Node>()
            const nodeCache = new Map<string, number>()
            const blocks = new Map<number, SessionBlock>()
            const frames: TraceFrame[] = []
            let tracer: any
            function frame(): TraceFrame {
                const f = frames[frames.length - 1]
                if (!f) throw 'trace2: intrinsic used without an active trace frame'
                return f
            }
            tracer = intrinsics.createIntrinsicsTracer(Intrinsics, {
                load: (ptr, offset, T) => {
                    if (symbolicMemory.has(ptr)) {
                        const result = runtime!.memoryLoad!(ptr, offset, T)
                        tracer.markHandled()
                        return result
                    }
                    if (ptr > intrinsics.heapMaxAddress) {
                        tracer.markHandled()
                        return mem[ptr + offset]
                    }
                    const overlaid = heapOverlay.get(ptr + offset)
                    if (overlaid !== undefined) {
                        tracer.markHandled()
                        return overlaid
                    }
                    return tracer.saved.load(ptr, offset, T)
                },
                store: (ptr, offset, val, T) => {
                    if (symbolicMemory.has(ptr)) {
                        throw "???"
                    }
                    if (ptr <= intrinsics.heapMaxAddress) {
                        const addr = ptr + offset
                        if (tracer.getNanId(val)) {
                            heapOverlay.set(addr, val)
                            tracer.markHandled()
                            return
                        }
                        heapOverlay.delete(addr)
                        return tracer.saved.store(ptr, offset, val, T)
                    }
                    noteTraceMemLow(ptr + offset)
                    mem[ptr + offset] = val as any
                    tracer.markHandled()
                },
                panic: (acc) => frame().panic(acc),
                dispatch: pc => frame().dispatch(pc),
                branch: (cond, v1, v2) => frame().branch(cond, v1, v2),
                canexit: acc => frame().canexit(acc),
                voidvalue: () => frame().voidvalue(),
                call: (target, thisArg, regStart, nargs, cb) => frame().call(target, thisArg, regStart, nargs, cb),
            })
            runtime = {
                tracer, mem, heapOverlay, nodes, nodeCache, blocks, frames,
                objects: createHeapRecords(tracer, mk, nodes),
                depth: 0,
            }
            session.runtime = runtime
        }
        runtime.depth++
        return runtime
    }

    function leaveTrace(): void {
        const r = runtime!
        if (--r.depth) return
        r.tracer.dispose()
        runtime = undefined
        session.runtime = undefined
    }

    const traceHandles = new Set<u32>()

    const session: TraceSession = {
        intrinsicContext,
        moduleContext,
        objectBuiltins,
        intrinsicFns,
        functionStubs,
        stubFunctions,
        compiledFunctions,
        symbolicMemory,
        traceHandles,
        symbolicBranch,
        symbolicDispatch,
        symbolicJmp,
        symbolicPanic,
        mk,
        symbolicError,
        runtime,
        fromJsValue,
        linkFunction,
        finalize,
        enterTrace,
        leaveTrace,
    }
    return session
}

export interface TraceOptions {
    verbose?: boolean
    captures?: any[]
    mapCapture?: (capture: any) => any
    shouldInline?: (fn: Function) => boolean
    session?: TraceSession
    inputs?: { thisArg: any, args: Float64Array, effect: any }
    name?: string
}

let logTraceCalls = intrinsics.argv().includes('trace-calls')

export function trace2(input: string | Function, opts: TraceOptions = {}) {
    let code: string
    let captures = opts.captures
    if (typeof input === 'function') {
        const computation = intrinsics.getComputation(input)
        code = computation[0]
        captures = computation[1]
    } else {
        code = input
    }
    if (captures && opts.mapCapture) captures = captures.map(opts.mapCapture)
    const traceName = opts.name ?? (typeof input === 'function' ? input.name : '')
    const session = opts.session ?? createTraceSession()
    const debugTrace = typeof input === 'function'
        && intrinsics.argv().includes(`trace-debug:${input.name}`)
    const compiled = bytecode.compile(code)
    const codeLen = compiled.code.length
    const ACC = compiled.registerCount
    const TOKEN = ACC + 1
    const slotCount = ACC + 2
    const SYN_RET = codeLen
    const SYN_LDAR = codeLen + 1
    ;(compiled.code as u8[]).push(Op.Return as u8, Op.Ldar as u8, ACC as u8)

    const B = deriveBlocks(compiled.code as u8[], codeLen, compiled.paramCount, ACC, TOKEN)
    const leaders = B.leaders
    const isLeader = new Set<number>(leaders)
    const blockOf = new Map<number, number>()
    for (let i = 0; i < leaders.length; i++) blockOf.set(leaders[i], i)

    if (opts.verbose || logTraceCalls) {
        console.log(bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount))
        for (let i = 0; i < leaders.length; i++) {
            console.log(`B${i} @${leaders[i]} -> ${B.succs[i].map(x => 'B' + x).join(',')}`
                + `${B.inCycle[i] ? '  cyclic' : ''}${B.symPred[i] ? '  unfoldable-branch' : ''}`)
            console.log('   ins: ', ...B.liveIn[i])
        }
    }

    const finalized = session.finalize(compiled, captures)
    // defer Intrinsics.free(finalized)
    if (debugTrace) {
        const fn = heap.FunctionBytecode(heap.resolveHeapCell(finalized))
        const constants: any[] = []
        for (let i: u32 = 0; i < fn.constantsLen; i++) {
            const tagged = Intrinsics.load(heap.resolveHeapCell(fn.constants), i * 8, Types.u64) as u32
            constants.push({ tagged, hex: tagged.toString(16), value: vmValue(tagged) })
        }
        console.log('trace finalized', {
            name: input.name, finalized, constants,
            bytecode: bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount),
        })
    }
    const interpret = createInterpreter(true, 3)
    const runtime = session.enterTrace()
    defer session.leaveTrace()
    const tracer = runtime.tracer
    const mem = runtime.mem
    const nodes = runtime.nodes
    const objects = runtime.objects
    const sp = Intrinsics.sp

    const mk = session.mk

    function after(v: any, token: any): any {
        const tokenId = tracer.getNanId(token)
        if (!tokenId || tokenId === tracer.getNanId(nilEffect)) return v
        if (tracer.getNanId(v) === tokenId) return v
        const a = new Float64Array(2)
        a[0] = token
        a[1] = v
        return mk('after', a)
    }

   function valToString(v: any) {
        if (const id = tracer.getNanId(v)) {
            const o = nodes.get(id) ?? tracer.getTraceById(id)
            if (!o) return names.get(id) ?? `p@${id}`
            const parts: string[] = [`[s@${id}] ${o.op}`]
            if (o.op === 'heap-handle' && o.argConsts[0]) {
                parts.push(`${o.argConsts[0]}`)
                return `(${parts.join(', ')})`
            }
            for (let i = 0; i < o.argIds.length; i++) {
                const u = o.argIds[i]
                if (u) parts.push(valToString(intrinsics.getNanFromId(u)))
                else parts.push(o.argConsts?.[i] ?? o.args?.[i] ?? '?')
            }
            return `(${parts.join(', ')})`
        } else {
            return v
        }
    }

    function resultPart(v: any): any {
        const n = nodes.get(tracer.getNanId(v))
        if (!n || n.op !== 'after') return v
        return n.argIds[1] ? intrinsics.getNanFromId(n.argIds[1]) : n.argConsts![1]
    }

    let nilEffect: any

    const spBefore = sp()
    const args = Intrinsics.stackalloc(Math.max(compiled.paramCount, 1) * 4 as u32)
    const frame = sp() - frameSize(compiled.registerCount as u32, 3)
    noteTraceMemLow(frame)
    const regsBase = frameRegs(frame)
    const thisArg = opts.inputs ? objects.intern(opts.inputs.thisArg) : 0
    function slotAddr(r: number): number { return regsBase + r * 4 }
    function readToken(): any { return vmValue(mem[slotAddr(TOKEN)] as u32) }
    function writeToken(v: any): void { mem[slotAddr(TOKEN)] = tagVmValue(v) as any }

    function operand(n: Node, i: number): any {
        return n.argIds[i] ? intrinsics.getNanFromId(n.argIds[i]) : n.argConsts![i]
    }

    function lastWrite(token: any): any {
        const n = nodes.get(tracer.getNanId(token))
        if (!n) return token
        if (n.op === 'after' || n.op === 'load') return lastWrite(operand(n, 0))
        if (n.op !== 'select') return token
        const a = lastWrite(operand(n, 1))
        const b = lastWrite(operand(n, 2))
        const ai = tracer.getNanId(a)
        const bi = tracer.getNanId(b)
        if (isTerminalValue(a)) return b
        if (isTerminalValue(b)) return a
        return ai && ai === bi ? a : token
    }

    function memoryLoad(ptr: any, offset: any, T: number): any {
        const token = readToken()
        const args = new Float64Array(3)
        args[0] = lastWrite(token)
        args[1] = ptr
        args[2] = offset
        const loaded = mk('load', args, '', [T as intrinsics.Types])
        writeToken(after(loaded, token))
        return loaded
    }
    runtime.memoryLoad = memoryLoad

    interface Reified {
        header: number
        inputs: number[]
        selfId: number
        paramIds: number[]
        incoming?: Float64Array
        symbolic: Set<number>
        traced: boolean
        heap: Map<u32, { incoming: number, param: number, symbolic: boolean }>
    }
    const reified = new Map<number, Reified>()
    const regionalParams = new Set<number>()

    function watch(b: number): boolean {
        for (const r of B.readSlots[b]) {
            const value = vmValue(mem[slotAddr(r)] as u32)
            if (tracer.getNanId(value)) return true
        }
        return false
    }

    let phase = 0
    let resumePc = 0
    let injectedRet = false
    let stopNext = false
    const tracedBlocks = new Map<number, string>()

    function noteTracedBlock(block: number, pc: number, owner: string): void {
        const first = tracedBlocks.get(block)
        if (first !== undefined) {
            throw `trace2: bytecode block B${block} @${pc} traced twice (${first}; ${owner})`
        }
        tracedBlocks.set(block, owner)
    }
    const emptyState = new Float64Array(0)
    let step: Step = { kind: '', from: 0, outs: emptyState, target: 0, condId: 0, condConst: 0, thenPc: 0, elsePc: 0, valueId: 0, valueConst: 0 }

    function callArg(regStart: number, index: number): any {
        return vmValue(mem[regStart + index * 4] as u32)
    }

    function toGraphValue(value: any): any {
        //if (tracer.getNanId(value)) return value
        const tagged = value as u32
        if (isVmHandle(tagged)) {
            const handle = vmHandle(tagged)
            if (handle <= 1) return handle
            if (!heap.isBoxedF64(handle)) return handleValue(handle)
        }
        return vmValue(tagged)
    }

    function fromGraphValue(value: any): u32 {
        const id = tracer.getNanId(value)
        if (id) {
            const n = nodes.get(id)
            if (n && n.op === 'heap-handle' && !n.argIds[0] && n.argConsts) {
                return tagVmHandle(n.argConsts[0] as any)
            }
        }
        return tagVmValue(value)
    }

    function graphCallArg(regStart: number, index: number): any {
        return toGraphValue(mem[regStart + index * 4])
    }

    function tagCallResult(value: any, handle: boolean = false): u32 {
        const tagged = handle ? fromGraphValue(value) : tagVmValue(value)
        tracer.markHandled()
        return tagged
    }

    function isHeapValue(value: any, seen: Set<number> = new Set()): boolean {
        const id = tracer.getNanId(value)
        if (!id || seen.has(id)) return false
        seen.add(id)
        const n = nodes.get(id)
        if (!n) return false
        if (n.op === 'heap-handle') return true
        if (n.op === 'ret' || n.op === 'inlined') {
            const inner = n.argIds[0]
            return inner ? isHeapValue(intrinsics.getNanFromId(inner), seen) : false
        }
        if (n.op === 'after') {
            const inner = n.argIds[1]
            return inner ? isHeapValue(intrinsics.getNanFromId(inner), seen) : false
        }
        if (n.op !== 'select' || n.argIds.length < 2) return false
        for (let i = 1; i < n.argIds.length; i++) {
            if (!n.argIds[i] || !isHeapValue(intrinsics.getNanFromId(n.argIds[i]), new Set(seen))) return false
        }
        return true
    }

    function boxedSlot(handle: u32, key: u32): f64 | undefined {
        const descriptor = heap.getOwnProperty(handle, key)
        if (!descriptor) return
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
        if (!heap.isBoxedF64(d.slot0)) return
        return heap.unboxF64(d.slot0)
    }

    function unifyHeapHandles(value: any): any {
        const rootId = tracer.getNanId(value)
        if (!rootId || nodes.get(rootId)?.op === 'heap-handle') return value

        const leafOf = new Map<number, u32>()
        const spine = new Map<number, boolean>()
        function collect(id: number): boolean {
            if (!id) return false
            const known = spine.get(id)
            if (known !== undefined) return known
            spine.set(id, false)
            const n = nodes.get(id)
            let ok = false
            if (!n) {
                // fall through
            } else if (n.op === 'heap-handle') {
                const handle = heapHandleOf(intrinsics.getNanFromId(id))
                if (handle && traceHandles.has(handle)) { leafOf.set(id, handle); ok = true }
            } else if (n.op === 'after') {
                ok = collect(n.argIds[1])
            } else if (n.op === 'ret' || n.op === 'inlined') {
                ok = collect(n.argIds[0])
            } else if (n.op === 'select' && n.argIds.length > 1) {
                ok = true
                for (let i = 1; i < n.argIds.length; i++) if (!collect(n.argIds[i])) { ok = false; break }
            }
            spine.set(id, ok)
            return ok
        }
        if (!collect(rootId) || leafOf.size < 1) return value
        const members = new Set<number>()
        function mark(id: number): void {
            if (members.has(id)) return
            members.add(id)
            if (leafOf.has(id)) return
            const n = nodes.get(id)!
            if (n.op === 'after') { 
                mark(n.argIds[1])
                return 
            }
            if (n.op === 'ret' || n.op === 'inlined') {
                mark(n.argIds[0])
                return
            }
            for (let i = 1; i < n.argIds.length; i++) mark(n.argIds[i])
        }
        mark(rootId)

        for (const [id, n] of nodes) {
            if (members.has(id)) continue
            for (const arg of n.argIds) if (leafOf.has(arg)) return value
        }

        const leaves = [...leafOf.values()]
        const first = leaves[0]
        if (!heap.isOrdinaryObject(first)) return value
        const proto = heap.getPrototypeOf(first)
        const descriptor = heap.typeDescriptorOf(first)
        const count = heap.ownPropertyCount(first)
        const keys: u32[] = []
        for (let i: u32 = 0; i < count; i++) keys.push(heap.ownPropertyKeyAt(first, i))
        for (const leaf of leaves) {
            if (!heap.isOrdinaryObject(leaf)) return value
            if (heap.getPrototypeOf(leaf) !== proto) return value
            if (heap.typeDescriptorOf(leaf) !== descriptor) return value
            if (heap.ownPropertyCount(leaf) !== count) return value
            for (let i = 0; i < keys.length; i++) {
                if (heap.ownPropertyKeyAt(leaf, i as u32) !== keys[i]) return value
                if (boxedSlot(leaf, keys[i]) === undefined) return value
            }
        }

        function rebuild(id: number, key: u32, memo: Map<number, any>): any {
            const prev = memo.get(id)
            if (prev !== undefined) return prev
            const n = nodes.get(id)!
            let out: any
            const leaf = leafOf.get(id)
            if (leaf !== undefined) {
                out = boxedSlot(leaf, key)!
            } else if (n.op === 'after') {
                out = after(rebuild(n.argIds[1], key, memo),
                    intrinsics.getNanFromId(n.argIds[0]))
            } else if (n.op === 'ret') {
                out = ret(rebuild(n.argIds[0], key, memo))
            } else if (n.op === 'inlined') {
                out = inlined(rebuild(n.argIds[0], key, memo))
            } else {
                const shared: number[] = []
                let arms = n.argIds.slice(1)
                for (;;) {
                    const head = nodes.get(arms[0])
                    if (!head || head.op !== 'after') break
                    const effect = head.argIds[0]
                    let common = true
                    for (const arm of arms) {
                        const a = nodes.get(arm)
                        if (!a || a.op !== 'after' || a.argIds[0] !== effect) { common = false; break }
                    }
                    if (!common) break
                    shared.push(effect)
                    arms = arms.map(arm => nodes.get(arm)!.argIds[1])
                }
                const args = new Float64Array(1 + arms.length)
                args[0] = n.argIds[0] ? intrinsics.getNanFromId(n.argIds[0]) : n.argConsts![0]
                for (let i = 0; i < arms.length; i++) args[i + 1] = rebuild(arms[i], key, memo)
                out = mk('select', args)
                for (let i = shared.length - 1; i >= 0; i--) {
                    out = after(out, intrinsics.getNanFromId(shared[i]))
                }
            }
            memo.set(id, out)
            return out
        }

        const unified = heap.shallowClone(first as intrinsics.Handle) as u32
        for (const key of keys) {
            const merged = rebuild(rootId, key, new Map<number, any>())
            heap.setProperty(unified as intrinsics.Handle, key as intrinsics.Handle,
                heap.boxF64(merged))
        }
        const cell = heap.makeIndirect(unified as intrinsics.Handle) as u32
        traceHandles.add(unified)
        return handleValue(cell)
    }

    function callLinked(linked: Function, thisArg: any, regStart: number, nargs: number): { value: any, handle?: boolean } | undefined {
        const native = linked as any
        const isLocal = Number.isSafeInteger(native.__localTarget)
        if ((isLocal || Number.isSafeInteger(native.__native))
            && Array.isArray(native.__args)
            && Number.isSafeInteger(native.__returns)) {
            if (nargs !== native.__args.length) {
                throw `trace2: native fn expected ${native.__args.length} args, got ${nargs}`
            }
            const args = new Float64Array(3 + nargs)
            args[0] = readToken()
            const lt = isLocal ? new Float64Array(1) : undefined
            if (lt) lt[0] = native.__localTarget
            args[1] = isLocal
                ? mk('local-target', lt!, native.__name ?? '', [Types.fnptr])
                : native.__native
            args[2] = 0
            for (let i = 0; i < nargs; i++) args[i + 3] = graphCallArg(regStart, i)
            const value = tracer.traceOp('call', args, native.__returns)
            writeToken(value)
            tracer.markHandled()
            return { value }
        }
        if (linked === session.symbolicPanic) {
            traceFrame.panic(callArg(regStart, 0))
            return { value: 0 }
        }
        if (linked === session.symbolicError) {
            tracer.markHandled()
            return { value: 0 }
        }
        if (linked === session.symbolicJmp) {
            const value = Intrinsics.add(
                callArg(regStart, 0), callArg(regStart, 1), Types.usize, Types.usize,
            )
            tracer.markHandled()
            return { value }
        }
        if (linked === session.symbolicBranch) {
            let hasUnknown = false
            for (let i = regStart; i < regStart + 12; i += 4) {
                if (tracer.getNanId(vmValue(mem[i] as u32))) {
                    hasUnknown = true
                    break
                }
            }
            if (!hasUnknown) {
                tracer.markHandled()
                return { value: callArg(regStart, 0) ? callArg(regStart, 1) : callArg(regStart, 2) }
            }
            throw "???"
            const args = new Float64Array(3)
            args[0] = callArg(regStart, 0)
            args[1] = callArg(regStart, 1)
            args[2] = callArg(regStart, 2)
            const value = tracer.traceOp()
            tracer.markHandled()
            return { value }
        }
        if (linked === session.symbolicDispatch) {
            const pc = callArg(regStart, 0)
            tracer.markHandled()
            if (tracer.getNanId(pc)) return { value: pc }
            const args = new Float64Array(1)
            args[0] = pc
            return { value: mk('dispatch', args) }
        }
        if (linked === session.objectBuiltins.setPrototypeOf) {
            const obj = callArg(regStart, 0)
            heap.setPrototypeOf(heap.isIndirect(obj) ? heap.prepareWrite(obj) : obj as u32, callArg(regStart, 1) as u32)
            tracer.markHandled()
            return { value: handleValue(obj), handle: true }
        }
        if (((linked as any).shouldInline || opts.shouldInline?.(linked))
            && typeof (linked as any)[Symbol.for('toComputation')] === 'function') {
            const args = new Float64Array(nargs)
            for (let i = 0; i < nargs; i++) args[i] = callArg(regStart, i)
            const effect = readToken()
            let nested: any
            tracer.setActive(false)
            try {
                try {
                    nested = trace2(linked, {
                        session,
                        mapCapture: opts.mapCapture,
                        shouldInline: opts.shouldInline,
                        inputs: { thisArg, args, effect },
                    })
                } catch (e) {
                    console.log(linked.toString(), e)
                    throw `trace2: while tracing ${linked.name || '<anonymous>'}: ${e}`
                }
            } finally {
                tracer.setActive(true)
            }
            if (intrinsics.argv().includes('assert-inline') && linked === intrinsics.assert) {
                console.log('inline assert', {
                    arg: args[0], argId: tracer.getNanId(args[0]),
                    value: nested.value, valueId: tracer.getNanId(nested.value),
                    graph: nested.text,
                })
            }

            const value = inlined(nested.result)
            writeToken(getOrderingFromInlined(value))
            tracer.markHandled()

            if (isHeapValue(value)) {
                return { value: unifyHeapHandles(value), handle: true }
            }

            return { value, handle: false }
        }
        const syscall = linked as any
        if (Number.isSafeInteger(syscall.__syscall)
            && Array.isArray(syscall.__args)
            && Number.isSafeInteger(syscall.__returns)) {
            if (nargs !== syscall.__args.length) {
                throw `trace2: syscall ${syscall.__syscall} expected ${syscall.__args.length} args, got ${nargs}`
            }
            const signatureArgs = new Float64Array(1)
            signatureArgs[0] = syscall.__syscall
            const target = mk('syscall-target', signatureArgs, '', [syscall.__returns, ...syscall.__args])
            const args = new Float64Array(3 + nargs)
            args[0] = readToken()
            args[1] = target
            args[2] = 0
            for (let i = 0; i < nargs; i++) args[i + 3] = graphCallArg(regStart, i)
            const value = tracer.traceOp('call', args, syscall.__returns)
            writeToken(value)
            tracer.markHandled()
            return { value }
        }
    }

    const traceFrame: TraceFrame = {
        dispatch: (pc) => {
            if (phase === 0) { phase = 1; return SYN_LDAR }
            if (phase === 1) { phase = 2; return resumePc }
            if (pc >= codeLen) {
                injectedRet = true
                step.target = pc
                return SYN_RET
            }
            if (stopNext) {
                if (debugTrace) console.log('trace dispatch stop-next', { pc, block: blockOf.get(pc), from: step.from })
                injectedRet = true
                step.target = pc
                return SYN_RET
            }
            if (!isLeader.has(pc)) return pc
            if (!reified.has(blockOf.get(pc)!)) {
                const block = blockOf.get(pc)!
                const symbolic = watch(block)
                if (tracer.getActive() || symbolic) {
                    noteTracedBlock(block, pc, `dispatch from B${step.from}`)
                }
                tracer.setActive(symbolic)
                return pc
            }
            injectedRet = true
            step.target = pc
            return SYN_RET
        },
        branch: (cond, v1, v2) => {
            tracer.markHandled()
            const id = tracer.getNanId(cond as any)
            if (debugTrace) console.log('trace branch intrinsic', { cond, id, v1, v2 })
            if (!id) return cond ? v1 : v2
            const kn = nodes.get(id)
            if (kn && kn.op === 'nonzero') return v1
            step.kind = 'branch'
            step.condId = id
            step.thenPc = v1
            step.elsePc = v2
            stopNext = true
            return v1
        },
        canexit: (acc) => {
            tracer.markHandled()
            const value = toGraphValue(acc)
            if (step.kind === 'panic') {
                step.valueId = tracer.getNanId(value)
                step.valueConst = step.valueId ? 0 : value
                return true
            }
            if (injectedRet) {
                if (step.kind !== 'branch') step.kind = 'goto'
                mem[slotAddr(ACC)] = acc as any
            } else {
                step.kind = 'ret'
                step.valueId = tracer.getNanId(value)
                step.valueConst = step.valueId ? 0 : value
            }
            return true
        },
        voidvalue: () => {
            tracer.markHandled()
            return mk('void', emptyState, '', [Types.u32])
        },
        panic: (acc): void => {
            tracer.markHandled()
            step.kind = 'panic'
            stopNext = true
            const value = toGraphValue(acc)
            step.valueId = tracer.getNanId(value)
            step.valueConst = step.valueId ? 0 : value
        },
        call: (target: any, thisArg: any, regStart: any, nargs: any, cb: any) => {
            if (!Number.isSafeInteger(nargs) || nargs < 0 || nargs > 0xFF) {
                throw `trace: invalid call arg count ${nargs} (nan ${tracer.getNanId(nargs)})`
            }
            const callee = target
            const intrinsicName = session.intrinsicFns.get(callee)
            const linked = session.stubFunctions.get(callee) as any
            if (logTraceCalls) {
                const nanId = tracer.getNanId(callee)
                const bytecodeFn = !nanId && !intrinsicName && !linked
                    ? heap.FunctionBytecode(heap.resolveHeapCell(callee)) : undefined
                const callArgs: any[] = []
                for (let i = 0; i < nargs; i++) {
                    const value = callArg(regStart, i)
                    callArgs.push({ value, nanId: tracer.getNanId(value) })
                }
                console.log('trace2 call', {
                    target: intrinsicName ?? linked?.name ?? callee,
                    inline: linked?.shouldInline,
                    native: linked?.__native,
                    nargs,
                    nanId,
                    callback: cb?.name,
                    bytecodeLen: bytecodeFn?.bytecodeLen,
                    registerCount: bytecodeFn?.registerCount,
                    args: callArgs,
                })
            }
            if (intrinsicName) {
                const iargs = new Float64Array(nargs)
                for (let i = 0; i < nargs; i++) iargs[i] = callArg(regStart, i)
                if (intrinsicName === 'callcontext') {
                    tracer.markHandled()
                    return tagCallResult(mk('call-context', new Float64Array(0), '', [Types.usize]))
                }
                if (intrinsicName === 'load' && iargs[2] === Types.fnptr) {
                    const loaded = memoryLoad(iargs[0], iargs[1], Types.fnptr)
                    let context = iargs[0]
                    if (tracer.getNanId(iargs[1]) || iargs[1] !== 0) {
                        const addressArgs = new Float64Array(2)
                        addressArgs[0] = iargs[0]
                        addressArgs[1] = iargs[1]
                        context = mk('add', addressArgs, '', [Types.usize, Types.usize])
                    }
                    const targetArgs = new Float64Array(2)
                    targetArgs[0] = loaded
                    targetArgs[1] = context
                    tracer.markHandled()
                    return tagCallResult(mk('indirect-target', targetArgs, '', [Types.fnptr]), true)
                }
                if (intrinsicName === 'store') {
                    const sargs = new Float64Array(4)
                    sargs[0] = readToken()
                    sargs[1] = iargs[0]
                    sargs[2] = iargs[1]
                    sargs[3] = iargs[2]
                    const v = mk('store', sargs, '', [iargs[3] as intrinsics.Types])
                    writeToken(v)
                    tracer.markHandled()
                    return tagCallResult(0)
                }
                if (intrinsicName === 'load') {
                    const loaded = memoryLoad(iargs[0], iargs[1], iargs[2])
                    tracer.markHandled()
                    return tagCallResult(loaded, iargs[2] === Types.fnptr)
                }
                const result = (Intrinsics as any)[intrinsicName](...iargs)
                tracer.markHandled()
                return tagCallResult(result)
            }
            if (linked) {
                const result = callLinked(linked, thisArg, regStart, nargs)
                if (result) return tagCallResult(result.value, result.handle)
            }
            const cargs = new Float64Array(3 + nargs)
            cargs[0] = readToken()
            const a = new Float64Array(1)
            a[0] = callee
            cargs[1] = tracer.getNanId(callee) ? callee : mk('heap-handle', a, '', [Types.handle])
            cargs[2] = thisArg
            for (let i = 0; i < nargs; i++) cargs[3+i] = graphCallArg(regStart, i)
            const v = tracer.traceOp('call', cargs, Types.u32)
            writeToken(v)
            tracer.markHandled()
            return tagCallResult(v)
        },
    }
    runtime.frames.push(traceFrame)
    tracer.setActive(true)
    defer {
        assert(runtime.frames.pop() === traceFrame)
    }


    const shapeTrace = intrinsics.argv().includes(`shape-trace:${traceName}`)
    const fnId = tracer.getNanCount()

    function showShapeValue(v: any): string {
        const id = tracer.getNanId(v)
        if (!id) return `#${v}`
        const n = nodes.get(id)
        if (!n) return `%${id}`
        if (n.op === 'heap-handle' && !n.argIds[0]) return showShapeHandle(n.argConsts![0] as u32)
        const args: string[] = []
        for (let i = 0; i < n.argIds.length; i++) args.push(showShapeValue(operand(n, i)))
        return args.length ? `([s@${id}] ${n.op} ${args.join(' ')})` : `${n.op}@${id}`
    }

    function showShapeHandle(h: u32): string {
        const base = heap.isIndirect(h) ? heap.indirectTarget(h) : h
        const parts: string[] = []
        for (const key of dataKeys(base)) {
            const slot = slotOf(base, key)
            const inner = heap.isBoxedF64(slot) ? showShapeValue(heap.unboxF64(slot)) : `h${slot}`
            parts.push(`${heap.stringToJs(key)}: ${inner}`)
        }
        return `${heap.isIndirect(h) ? '&' : ''}obj${base}{ ${parts.join(', ')} }`
    }

    function dumpShapes(label: string, st: Float64Array): void {
        const seen = new Set<u32>()
        const parts: string[] = []
        for (let i = 0; i < st.length; i++) {
            const raw = cellOf(st[i])
            if (!raw) continue
            if (seen.has(raw)) continue
            seen.add(raw)
            const name = i === ACC ? 'acc' : i === TOKEN ? 'token' : `s${i}`
            parts.push(`${name}=${showShapeHandle(raw)}`)
        }
        if (parts.length) console.log(`  shape ${label} ${parts.join('  ')}`)
    }

    function runBlock(b: number, ins: Float64Array): Step {
        dispatches++
        noteTracedBlock(b, leaders[b], 'entry')
        if (shapeTrace) dumpShapes(`B${b} in `, ins)
        for (let r = 0; r <= ACC; r++) mem[slotAddr(r)] = fromGraphValue(ins[r]) as any
        writeToken(ins[TOKEN])
        for (let i = 0; i < compiled.paramCount; i++) mem[args + i * 4] = fromGraphValue(ins[i]) as any
        if (debugTrace && b === 0) {
            console.log('trace frame input', {
                sp: sp(), args, frame, regsBase, memLength: mem.length,
                inputIds: Array.from({ length: compiled.paramCount }, (_, i) => tracer.getNanId(ins[i])),
                argIds: Array.from({ length: compiled.paramCount }, (_, i) => tracer.getNanId(mem[args + i * 4])),
                regIds: Array.from({ length: compiled.paramCount }, (_, i) => tracer.getNanId(mem[slotAddr(i)])),
                selectWrapped: Intrinsics.select !== tracer.saved.select,
            })
        }
        phase = 0
        resumePc = leaders[b]
        injectedRet = false
        stopNext = false
        step = { kind: '', from: b, outs: emptyState, target: 0, condId: 0, condConst: 0, thenPc: 0, elsePc: 0, valueId: 0, valueConst: 0 }
        let concrete = !tracer.getNanId(thisArg) && runtime.heapOverlay.size === 0
        if (concrete) {
            for (const r of B.readSlots[b]) {
                if (tracer.getNanId(ins[r])) { concrete = false; break }
            }
        }
        if (concrete) tracer.setActive(false)
        const saved = sp()
        interpret(finalized, thisArg, args, compiled.paramCount as u32)
        tracer.setActive(true)
        sp(saved)
        const outs = new Float64Array(slotCount)
        for (let r = 0; r <= ACC; r++) outs[r] = toGraphValue(mem[slotAddr(r)])
        outs[TOKEN] = readToken()
        if (shapeTrace) dumpShapes(`B${b} out`, outs)
        if (debugTrace) {
            const show = (state: Float64Array) => Array.from(state, value => {
                const id = tracer.getNanId(value)
                return id ? `v${id}` : value
            })
            console.log('trace block state', { block: b, in: show(ins), out: show(outs) })
        }
        step.outs = outs
        return step
    }

    interface EvalResult {
        value: f64
        ordering: f64
    }

    let dispatches = 0

    function reifyBlocks(): Reified[] {
        for (let b = 0; b < leaders.length; b++) {
            if (b === 0 && !B.inCycle[b]) continue
            if (B.preds[b].length < 2 && b !== 0) continue
            let symbolic = B.symPred[b] || B.symbolicJoins.has(b)
            if (!symbolic) {
                for (const member of B.cycles[b]) {
                    if (!B.symPred[member]) continue
                    symbolic = true
                    break
                }
            }
            if (!symbolic) continue
            const loopWrites = new Set<number>()
            for (let h = 0; h < leaders.length; h++) {
                if (!B.cycles[h].has(b)) continue
                for (const slot of B.cycleWrites[h]) loopWrites.add(slot)
            }
            const inputSet = new Set<number>(B.liveIn[b])
            inputSet.add(TOKEN)
            const inputs = [...inputSet]
            inputs.sort((x, y) => x - y)

            const selfId = tracer.getNanId(tracer.createUniqueNan())
            nodes.set(selfId, {
                op: 'block', argIds: [], argConsts: new Float64Array(0), label: `B${b}`,
            })
            const paramIds: number[] = []
            for (const slot of inputs) {
                const id = tracer.getNanId(tracer.createUniqueNan())
                const name = slot === ACC ? 'acc' : slot === TOKEN ? 'token' : `s${slot}`
                names.set(id, name)
                nodes.set(id, {
                    op: 'param', argIds: [], argConsts: new Float64Array(0), label: name,
                })
                regionalParams.add(id)
                paramIds.push(id)
            }
            reified.set(b, {
                header: b, inputs, selfId, paramIds,
                symbolic: loopWrites, traced: false,
                heap: new Map(),
            })
        }
        const order = B.order.filter(b => reified.has(b)).map(b => reified.get(b)!)
        if (intrinsics.argv().includes(`trace-blocks:${traceName}`)) {
            console.log('trace order:', order.map(R => `B${R.header}`).join(', '))
        }
        return order
    }

    function application(R: Reified, ins: Float64Array): any {
        const heapState = captureHeap(ins, R.inputs)
        if (!R.incoming) {
            R.incoming = ins.slice()
            for (const [cell, value] of heapState) {
                const param = objects.parameter(cell, `h${R.heap.size}`)
                regionalParams.add(param)
                R.heap.set(cell, { incoming: value, param, symbolic: startsCycle[R.header] })
            }
        } else {
            for (const slot of R.inputs) {
                if (sameValue(R.incoming[slot], ins[slot])) continue
                assert(!cellOf(R.incoming[slot]) && !cellOf(ins[slot]), 'heap record: block input changes identity')
                if (R.symbolic.has(slot)) continue
                assert(!R.traced, `trace2: input s${slot} of B${R.header} changed after tracing`)
                R.symbolic.add(slot)
            }
            assert(heapState.size === R.heap.size, 'heap record: block input changes object graph')
            for (const [cell, binding] of R.heap) {
                const value = heapState.get(cell)
                assert(value !== undefined, 'heap record: block input changes object graph')
                if (binding.symbolic || sameValue(value, binding.incoming)) continue
                assert(!R.traced, 'heap record: entry contents changed after tracing')
                binding.symbolic = true
            }
        }
        const args = new Float64Array(R.inputs.length + R.heap.size + 1)
        args[0] = intrinsics.getNanFromId(R.selfId) as any
        for (let i = 0; i < R.inputs.length; i++) args[i + 1] = ins[R.inputs[i]]
        let i = R.inputs.length + 1
        for (const [cell] of R.heap) args[i++] = heapState.get(cell)!
        return mk('apply', args)
    }

    function captureHeap(ins: Float64Array, slots: number[]): HeapState {
        const roots: u32[] = [thisArg as u32]
        for (const slot of slots) {
            const cell = cellOf(ins[slot])
            if (cell) roots.push(cell)
        }
        return objects.capture(roots)
    }

    function cellOf(value: any): u32 {
        const n = nodes.get(tracer.getNanId(value))
        if (!n || n.op !== 'heap-handle' || n.argIds[0]) return 0
        return n.argConsts![0] as u32
    }

    function heapHandleOf(value: any): u32 {
        const n = nodes.get(tracer.getNanId(value))
        if (!n || n.op !== 'heap-handle' || n.argIds[0]) return 0
        const h = n.argConsts![0] as u32
        return h && heap.isIndirect(h) ? heap.indirectTarget(h) : h
    }

    const traceHandles = session.traceHandles

    function handleValue(handle: u32): any {
        handle = objects.intern(handle)
        if (heap.isIndirect(handle)) traceHandles.add(heap.indirectTarget(handle))
        const args = new Float64Array(1)
        args[0] = handle as f64
        return mk('heap-handle', args, '', [Types.handle])
    }

    function dataKeys(handle: u32): u32[] {
        const out: u32[] = []
        const count = heap.ownPropertyCount(handle)
        for (let i: u32 = 0; i < count; i++) {
            const key = heap.ownPropertyKeyAt(handle, i)
            if (!key) continue
            const descriptor = heap.getOwnProperty(handle, key)
            if (!descriptor) continue
            const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
            if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
            out.push(key)
        }
        return out
    }

    function slotOf(handle: u32, key: u32): u32 {
        const descriptor = heap.getOwnProperty(handle, key)
        if (!descriptor) return 0
        return heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor)).slot0 as u32
    }

    function regionalValue(id: number, seen = new Set<number>()): boolean {
        if (!id || seen.has(id)) return false
        seen.add(id)
        const n = nodes.get(id) ?? tracer.getTraceById(id)
        if (!n) return false
        if (n.op === 'param') return regionalParams.has(id)
        if (n.op === 'heap-handle' || n.op === 'block') return false
        for (let i = 0; i < n.argIds.length; i++) {
            if (regionalValue(n.argIds[i], seen)) return true
        }
        return false
    }

    function bindInputs(R: Reified): Float64Array {
        assert(!R.traced)
        assert(R.incoming)
        const ins = R.incoming!.slice()
        for (let i = 0; i < R.inputs.length; i++) {
            const slot = R.inputs[i]
            if (cellOf(ins[slot])) {
                R.symbolic.delete(slot)
                continue
            }
            if ((slot === TOKEN && !sameValue(ins[slot], nilEffect))
                || regionalValue(tracer.getNanId(ins[slot]))) {
                R.symbolic.add(slot)
            }
            if (R.symbolic.has(slot)) ins[slot] = intrinsics.getNanFromId(R.paramIds[i])
        }
        for (const [cell, binding] of R.heap) {
            if (regionalValue(tracer.getNanId(binding.incoming))) binding.symbolic = true
            objects.install(cell, binding.symbolic ? intrinsics.getNanFromId(binding.param) : binding.incoming)
        }
        R.traced = true
        return ins
    }

    function isNil(v: any) {
        const id = tracer.getNanId(v)
        if (!id) return false
        return nodes.get(id)?.op === 'nil-effect'
    }

    function isUnreachable(v: any) {
        const id = tracer.getNanId(v)
        if (!id) return false
        return nodes.get(id)?.op === 'unreachable'
    }

    function panic(v: any, token: any) {
        if (isTerminalValue(v)) return v
        const args = new Float64Array(1)
        args[0] = after(v, token)
        return mk('panic', args)
    }

    function ret(v: any, tag = fnId) {
        const id = tracer.getNanId(v)
        const n = id ? nodes.get(id) : undefined
        if (n?.op === 'ret') return v
        if (n?.op === 'after') {
            const uid = n!.argIds[1]
            const u = uid ? nodes.get(uid) : undefined
            if (u?.op === 'ret' && n.argIds[0]) {
                return ret(after(operand(u, 0), intrinsics.getNanFromId(n.argIds[0])), tag)
            }
        }
        const args = new Float64Array(2)
        args[0] = v
        args[1] = tag
        return mk('ret', args)
    }

    function inlined(v: any): any {
        const id = tracer.getNanId(v)
        if (!id) return v
        const n = nodes.get(id)
        if (n?.op === 'ret') {
            const seen = new Set<number>()
            const pending = [n.argIds[0]]
            let simple = true
            while (pending.length) {
                const id = pending.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const node = nodes.get(id)
                const trace = node ? undefined : tracer.getTraceById(id)
                const op = node?.op ?? trace?.op
                if (op === 'inlined') continue
                if (op === 'apply' || op === 'select' || op === 'ret') {
                    simple = false
                    break
                }
                if (node) {
                    for (const arg of node.argIds) pending.push(arg)
                } else if (trace) {
                    for (const i of lowering.operandIndices(trace)) pending.push(trace.argIds[i] ?? 0)
                }
            }
            if (simple) return operand(n, 0)
        }
        if (n?.op === 'panic') return v
        const args = new Float64Array(1)
        args[0] = v
        return mk('inlined', args)
    }

    function selectValues(cond: any, a: any, b: any): any {
        const union = unionValues(a, b)
        if (union !== undefined) return union
        const args = new Float64Array(3)
        args[0] = cond
        args[1] = a
        args[2] = b
        return mk('select', args)
    }

    function isTerminalValue(val: any) {
        const n = nodes.get(tracer.getNanId(val))
        if (!n) return false
        return n.op === 'panic' || n.op == 'ret' || n.op === 'unreachable'
    }

    function unreachable() {
        return mk('unreachable', new Float64Array(0))
    }

    function getOrderingFromInlined(val: any): any {
        const id = tracer.getNanId(val)
        if (!id) return nilEffect
        const n = nodes.get(id) ?? tracer.getTraceById(id)
        if (!n) return nilEffect
        if (n.op === 'select') {
            const rem = new Float64Array(n.argIds.length)
            rem[0] = operand(n, 0)
            let changed = false
            for (let i = 1; i < n.argIds.length; i++) {
                const nv = getOrderingFromInlined(operand(n, i))
                rem[i] = nv
                if (!changed && tracer.getNanId(nv) !== n.argIds[i]) {
                    changed = true
                }
            }
            if (!changed) return val
            return mk('select', rem)
        }
        if (n.op === 'ret') {
            const x = getOrderingFromInlined(operand(n, 0))
            if (sameValue(x, nilEffect) || nodes.get(tracer.getNanId(x))?.op === 'panic' || isUnreachable(x)) return x
            return ret(x, n.argConsts?.[1])
        }
        if (n.op === 'inlined') {
            const x = getOrderingFromInlined(operand(n, 0))
            if (sameValue(x, nilEffect) || nodes.get(tracer.getNanId(x))?.op === 'panic' || isUnreachable(x)) return x
            return val // must preserve
        }
        if (n.op === 'after') {
            const x = getOrderingFromInlined(operand(n, 1))
            if (!sameValue(x, nilEffect)) return x
            return getOrderingFromInlined(operand(n, 0))
        }
        if (n.op === 'load' || n.op === 'store' || n.op === 'call') {
            return val
        }
        if (n.op === 'apply') return val
        if (n.op === 'unreachable') return val
        if (n.op === 'panic') return unreachable()
        return nilEffect
    }

    function evalFrom(b: number, ins: Float64Array): EvalResult {
        const R = reified.get(b)
        return R ? { value: application(R, ins), ordering: ins[TOKEN] } : traceFrom(b, ins)
    }

    function traceFrom(b: number, ins: Float64Array): EvalResult {
        return continueFrom(runBlock(b, ins))
    }

    function continueFrom(r: Step): EvalResult {
        assert(r.kind)
        if (r.kind === 'panic') {
            const v = r.valueId ? intrinsics.getNanFromId(r.valueId) : r.valueConst
            return { value: panic(v, r.outs[TOKEN]), ordering: r.outs[TOKEN] }
        }
        if (r.kind === 'ret') {
            const v = r.valueId ? intrinsics.getNanFromId(r.valueId) : r.valueConst
            return { value: ret(after(v, r.outs[TOKEN])), ordering: r.outs[TOKEN] }
        }
        if (r.kind === 'goto') return evalFrom(blockOf.get(r.target)!, r.outs)

        const branch = branchInputs(r)
        const marks = objects.mark()
        const a = evalFrom(blockOf.get(r.thenPc)!, branch[0])
        const thenChanges = objects.take(marks)
        const c = evalFrom(blockOf.get(r.elsePc)!, branch[1])
        const elseChanges = objects.take(marks)
        objects.merge(intrinsics.getNanFromId(r.condId), marks, thenChanges, elseChanges)

        if (debugTrace) {
            console.log('trace branch', {
                from: r.from, cond: r.condId, thenPc: r.thenPc, elsePc: r.elsePc,
                thenValue: tracer.getNanId(a.value), elseValue: tracer.getNanId(c.value),
                thenToken: tracer.getNanId(a.ordering), elseToken: tracer.getNanId(c.ordering),
            })
        }

        const cond = intrinsics.getNanFromId(r.condId)
        return {
            value: selectValues(cond, a.value, c.value),
            ordering: selectValues(cond, a.ordering, c.ordering),
        }
    }

    function branchInputs(r: Step): [Float64Array, Float64Array] {
        const ct = tracer.getTraceById(r.condId)
        const exactTrue = ct !== undefined && CompareOps.has(ct.op)

        let thenIn = r.outs
        if (exactTrue) thenIn = known(r.outs, r.condId, 1)
        else thenIn = knownValue(r.outs, r.condId, nonzeroOf(r.condId))
        let elseIn = known(r.outs, r.condId, 0)

        if (ct && (ct.op === 'eq' || ct.op === 'ne')) {
            const z = againstZero(ct)
            if (z) {
                if (ct.op === 'eq') elseIn = knownValue(elseIn, z, nonzeroOf(z))
                else thenIn = knownValue(thenIn, z, nonzeroOf(z))
            }
        }
        if (ct && ct.op === 'eq') thenIn = intersectEqual(thenIn, ct)
        if (ct && ct.op === 'ne') elseIn = intersectEqual(elseIn, ct)
        return [thenIn, elseIn]
    }

    function unionValues(a: any, b: any): any | undefined {
        if (sameValue(a, b)) return a
        const an = nonzeroInput(a)
        if (an && (b === 0 || tracer.getNanId(b) === an)) return intrinsics.getNanFromId(an)
        const bn = nonzeroInput(b)
        if (bn && (a === 0 || tracer.getNanId(a) === bn)) return intrinsics.getNanFromId(bn)
    }

    function nonzeroInput(v: any): number {
        const n = nodes.get(tracer.getNanId(v))
        return n?.op === 'nonzero' ? n.argIds[0] : 0
    }

    function intersectEqual(st: Float64Array, t: any): Float64Array {
        const ia = t.argIds[0] ?? 0
        const ib = t.argIds[1] ?? 0
        if (ia && !ib) return knownValue(st, ia, t.args[1])
        if (ib && !ia) return knownValue(st, ib, t.args[0])
        // XXX: only valid after equality check
        if (ia && ib) {
            if (regionalValue(ia) && !regionalValue(ib)) {
                return knownValue(st, ia, intrinsics.getNanFromId(ib) as any)
            }
            return knownValue(st, ib, intrinsics.getNanFromId(ia) as any)
        }
        return st
    }

    function nonzeroOf(id: number): any {
        const one = new Float64Array(1)
        one[0] = intrinsics.getNanFromId(id) as any
        return mk('nonzero', one)
    }

    function againstZero(t: any): number {
        const ia = t.argIds[0] ?? 0
        const ib = t.argIds[1] ?? 0
        if (ia && !ib && t.args[1] === 0) return ia
        if (ib && !ia && t.args[0] === 0) return ib
        return 0
    }

    function known(st: Float64Array, id: number, v: number): Float64Array {
        return knownValue(st, id, v)
    }
    function knownValue(st: Float64Array, id: number, v: any): Float64Array {
        let hit = false
        for (let i = 0; i < TOKEN; i++) {
            if (tracer.getNanId(st[i]) === id) { hit = true; break }
        }
        if (!hit) return st
        const out = new Float64Array(slotCount)
        for (let i = 0; i < TOKEN; i++) {
            out[i] = tracer.getNanId(st[i]) === id ? v : st[i]
        }
        out[TOKEN] = st[TOKEN]
        return out
    }

    function sameValue(a: any, b: any): boolean {
        if (a === b) return true
        const ia = tracer.getNanId(a)
        return ia && ia === tracer.getNanId(b)
    }

    const paramIds: number[] = []
    const names = new Map<number, string>()
    const ins = new Float64Array(slotCount)
    for (let i = 0; i < compiled.paramCount; i++) {
        if (opts.inputs) {
            ins[i] = i < opts.inputs.args.length ? opts.inputs.args[i] : 0
        } else {
            const v = tracer.createUniqueNan()
            const id = tracer.getNanId(v)
            paramIds.push(id)
            names.set(id, `p${i}`)
            nodes.set(id, {
                op: 'param', argIds: [], argConsts: new Float64Array(0), label: `p${i}`,
            })
            ins[i] = v
        }
    }
    if (runtime.nilEffect === undefined) runtime.nilEffect = mk('nil-effect', new Float64Array(0))
    nilEffect = runtime.nilEffect
    ins[ACC] = thisArg
    ins[TOKEN] = opts.inputs?.effect ?? nilEffect

    const traceOrder = reifyBlocks()
    const rpo = new Map<number, number>()
    for (const R of traceOrder) {
        rpo.set(R.header, rpo.size)
        const succs = B.succs[R.header]
        for (let i = 0; i < succs.length; i++) {
            const b = succs[i]
            if (!rpo.has(b)) {
                rpo.set(b, rpo.size)
            }
        }
    }
    const startsCycle = new Array(B.preds.length)
    for (let i = 0; i < B.preds.length; i++) {
        const o = rpo.get(i)
        if (o === undefined) {
            startsCycle[i] = false
            continue
        }
        startsCycle[i] = B.preds[i].some(p => rpo.has(p) && rpo.get(p)! >= o)
    }

    function doTrace() {
        try {
            const entry = evalFrom(0, ins)
            for (const R of traceOrder) {
                if (!R.incoming) continue
                const body = traceFrom(R.header, bindInputs(R)).value
                const argumentIndices: number[] = []
                const inputs: number[] = []
                const params: number[] = []
                for (let i = 0; i < R.inputs.length; i++) {
                    if (R.inputs[i] === TOKEN || !R.symbolic.has(R.inputs[i])) continue
                    argumentIndices.push(i + 1)
                    inputs.push(R.inputs[i])
                    params.push(R.paramIds[i])
                }
                let i = 0
                for (const [, binding] of R.heap) {
                    if (binding.symbolic) {
                        argumentIndices.push(R.inputs.length + i + 1)
                        inputs.push(slotCount + i)
                        params.push(binding.param)
                    }
                    i++
                }
                if (R.symbolic.has(TOKEN)) {
                    const index = R.inputs.indexOf(TOKEN)
                    argumentIndices.push(index + 1)
                    inputs.push(TOKEN)
                    params.push(R.paramIds[index])
                }
                runtime.blocks.set(R.selfId, {
                    params, inputs, argumentIndices, body,
                    consumesEffectToken: R.symbolic.has(TOKEN),
                })
            }
            for (const R of traceOrder) assert(!R.incoming || R.traced, `trace2: missed B${R.header} in trace order`)
            return entry
        } catch (e) {
            console.log(code)
            console.log('\n--- registers ---\n')
            for (let i = 0; i < compiled.registerCount; i++) {
                const regName = i < compiled.paramCount ? `p${i}` : `r${i-compiled.paramCount}`
                const u = mem[slotAddr(i)]
                const id = tracer.getNanId(u)
                if (id) {
                    console.log(`  ${regName}: [symbolic ${id}]`, nodes.get(id) ?? tracer.getTraceById(id) ?? 'param')
                } else {
                    console.log(`  ${regName}: ${u}`)
                }
            }
            console.log('\n--- --------- ---\n')
            console.log(bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount))
            const referencedSymbol = String(e.message ?? e).match(/symbolic property (?:store )?receiver (\d+)/)?.[1]
            if (referencedSymbol) {
                const id = Number(referencedSymbol)
                console.log(valToString(intrinsics.getNanFromId(id)))
                console.log(`\n  symbolic ${id} -->\n`, nodes.get(id) ?? tracer.getTraceById(id) ?? 'param')
            }
            throw e
        }
    }

    const finalState = doTrace()
    const result = finalState.value
    sp(spBefore)

    let _lines: string
    function printLines() {
        if (_lines) return _lines
        const graph = buildGraph()
        const labels = new Map<number, string>()
        const refs = new Map<number, number>()
        const order: number[] = []
        const shared = new Map<number, string>()
        for (let i = 0; i < graph.params.length; i++) labels.set(graph.params[i], `p${i}`)
        for (const b of graph.blocks) {
            if (!b.id) continue
            const name = `B${b.id}`
            labels.set(b.id, name)
            for (let i = 0; i < b.params.length; i++) {
                const param = graph.nodes.get(b.params[i])?.label || `p${i}`
                labels.set(b.params[i], `${name}.${param}`)
            }
        }
        function survey(id: number): void {
            if (!id || labels.has(id)) return
            const count = (refs.get(id) ?? 0) + 1
            refs.set(id, count)
            if (count > 1) return
            const n = graph.nodes.get(id)
            if (!n) return
            for (const arg of n.argIds) survey(arg)
            order.push(id)
        }
        for (const b of graph.blocks) survey(b.bodyId)
        let nextValue = 1
        for (const id of order) {
            if ((refs.get(id) ?? 0) > 1 && graph.nodes.get(id)!.op !== 'nil-effect') {
                shared.set(id, `V${nextValue++}`)
            }
        }
        let currentBlock: lowering2.GraphBlock | undefined
        function render(id: number, constant: any): string {
            if (!id) return String(constant)
            if (currentBlock?.params.includes(id)) {
                return expand(id)
            }
            return labels.get(id) ?? shared.get(id) ?? expand(id)
        }
        function expand(id: number): string {
            const n = graph.nodes.get(id)
            if (!n) return `?${id}`
            if (n.op === 'nil-effect') return 'nil'
            if (n.op === 'param') return n.label ?? `s${id}`
            const parts: string[] = [n.op]
            for (let i = 0; i < n.argIds.length; i++) {
                parts.push(render(n.argIds[i], n.argConsts[i]))
            }
            return `(${parts.join(', ')})`
        }
        const lines: string[] = []
        for (const id of order) {
            if (shared.has(id)) lines.push(`${shared.get(id)}: ${expand(id)}`)
        }
        for (const b of graph.blocks) {
            if (!b.id) continue
            currentBlock = b
            lines.push(`${labels.get(b.id)}(${b.params.map(id => expand(id)).join(', ')}) = ${render(b.bodyId, b.bodyConst)}`)
        }
        const entry = graph.blocks[0]
        currentBlock = entry
        lines.push(`= ${render(entry.bodyId, entry.bodyConst)}`)
        return _lines = lines.join('\n')
    }

    function buildGraph(extraRoots: number[] = []): lowering2.Graph {
        const out = new Map<number, lowering2.GraphNode>()
        const seen = new Set<number>()

        function resolve(id: number): number {
            for (;;) {
                const n = nodes.get(id)
                if (n && n.op === 'nonzero') { id = n.argIds[0]; continue }
                return id
            }
        }

        function visit(id0: number): number {
            const id = resolve(id0)
            if (!id || seen.has(id)) return id
            seen.add(id)
            const n = nodes.get(id)
            if (n) {
                if (n.op === 'block') {
                    const block = runtime.blocks.get(id)
                    if (block) {
                        const r = tail(block.body)
                        blocks.push({
                            id, params: block.params.slice(), inputs: block.inputs.slice(),
                            bodyId: r[0], bodyConst: r[1], consumesEffectToken: block.consumesEffectToken,
                        })
                    }
                }
                const argIds: number[] = []
                const indices = n.op === 'apply'
                    ? [0, ...runtime.blocks.get(n.argIds[0])!.argumentIndices]
                    : n.argIds.map((_, i) => i)
                const argConsts = new Float64Array(indices.length)
                for (let i = 0; i < indices.length; i++) {
                    argIds.push(visit(n.argIds[indices[i]]))
                    argConsts[i] = n.argConsts![indices[i]]
                }
                if (n.op === 'heap-handle' && !argIds[0] && heap.isIndirect(argConsts[0] as u32)) {
                    argConsts[0] = heap.indirectTarget(argConsts[0] as u32) as f64
                    const base = argConsts[0] as u32
                    for (const key of dataKeys(base)) {
                        const slot = slotOf(base, key)
                        if (heap.isBoxedF64(slot)) {
                            if (const id = tracer.getNanId(heap.unboxF64(slot))) {
                                visit(id)
                            }
                        }
                    }
                }
                out.set(id, {
                    op: n.op, argIds, argConsts,
                    label: n.label,
                    T: (n as any).T ?? n.types?.[0] ?? Types.u64,
                    U: (n as any).U ?? n.types?.[1] ?? Types.u64,
                    types: n.types,
                })
                return id
            }
            const t = tracer.getTraceById(id)
            if (!t) return id
            const idx = lowering.operandIndices(t)
            const argIds: number[] = []
            const argConsts = new Float64Array(idx.length)
            for (let k = 0; k < idx.length; k++) {
                argIds.push(visit(t.argIds[idx[k]] ?? 0))
                argConsts[k] = t.args[idx[k]]
            }
            out.set(id, {
                op: t.op, argIds, argConsts,
                T: (t as any).T ?? Types.u64,
                U: (t as any).U ?? (t as any).T ?? Types.u64,
            })
            return id
        }

        function tail(v: any): number[] {
            const id = tracer.getNanId(v)
            return id ? [visit(id), 0] : [0, v]
        }

        const blocks: lowering2.GraphBlock[] = []
        const er = tail(finalState.value)
        for (const id of extraRoots) visit(id)
        blocks.unshift({ id: 0, params: paramIds.slice(), bodyId: er[0], bodyConst: er[1] })
        for (const b of blocks) for (const id of b.params) visit(id)
        if (intrinsics.argv().includes(`trace-blocks:${traceName}`)) {
            for (const b of blocks) {
                console.log('graph block', b.id, {
                    params: b.params,
                    inputs: b.inputs,
                    bodyId: b.bodyId,
                    body: out.get(b.bodyId),
                })
            }
        }
        const maxId = tracer.getNanCount() + 1
        const name = opts.name ?? (typeof input === 'function' ? input.name : undefined)
        return { maxId, nodes: out, params: paramIds, blocks, name }
    }

    let _graph
    const returnValue = resultPart(result)
    return {
        get graph() { return _graph ??= buildGraph() },
        graphWithRoots(roots: number[]) { return buildGraph(roots) },
        get text() { return printLines() },
        result, value: returnValue,
        effect: finalState.ordering,
        dispatches,
        session,
    }
}

if (intrinsics.argv()[0] === 'trace2') {
    function show(fn: Function, verbose = false, listing = false) {
        console.log(`--- ${fn.name} ---`)
        const r = trace2(fn, {
            verbose: verbose || intrinsics.argv().includes(`trace-blocks:${fn.name}`),
        })
        console.log(r.text)
        if (listing) {
            console.log(lowerValueGraph(r.graph, { debug: true }).listing)
        }
    }

    function testSyscallLowering() {
        const syscall = intrinsics.makeSyscallFn(reify (a: u32, b: u32) => u32, 123)
        {
            function syscallTrace(a: u32, b: u32): u32 { return syscall(a, b) }
            const traced = trace2(syscallTrace)
            const lowered = lowerValueGraph(traced.graph)
            assert(lowered.listing.includes('svc #128'))
            assert(!lowered.listing.includes('blr '))
        }
        {
            function syscallTrace2(a: u32, b: u32): u32 { 
                return syscall(a+b, b+a) + a
            }
            const traced = trace2(syscallTrace2)
            const lowered = lowerValueGraph(traced.graph)
            console.log(lowered.listing)
        }
    }
    testSyscallLowering()

    function testMmapSyscall() {
        function mapConcrete(): usize {
            return syscalls.mmap(
                0, 4096,
                syscalls.PROT_READ | syscalls.PROT_WRITE,
                syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
                -1 as any, 0,
            )
        }
        const concreteTrace = trace2(mapConcrete)
        assert([...concreteTrace.graph.nodes.values()].some(n => n.op === 'call'))
        function mapMemory(length: usize): usize {
            return syscalls.mmap(
                0, length,
                syscalls.PROT_READ | syscalls.PROT_WRITE,
                syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
                0, 0,
            )
        }
        function writeMemory(ptr: usize): u32 {
            Intrinsics.store(ptr, 0, 0x12345678, Types.u32)
            return 0
        }
        function readMemory(ptr: usize): u32 {
            return Intrinsics.load(ptr, 0, Types.u32)
        }
        function unmapMemory(ptr: usize, length: usize): u32 {
            return syscalls.munmap(ptr, length)
        }
        const map = createNative(mapMemory).native
        const write = createNative(writeMemory).native
        const read = createNative(readMemory).native
        const unmap = createNative(unmapMemory).native
        assert(map.codePage === write.codePage)
        assert(map.codePage === read.codePage)
        assert(map.codePage === unmap.codePage)
        const length = 4096
        const ptr = map(length)
        write(ptr)
        assert(read(ptr) === 0x12345678)
        assert(unmap(ptr, length) === 0)
    }
    testMmapSyscall()

    function testStaticMemory() {
        function allocate(): usize {
            return syscalls.mmap(
                0, 4096,
                syscalls.PROT_READ | syscalls.PROT_WRITE,
                syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
                0, 0,
            )
        }
        const ptr = createNative(allocate).native()
        const memory = symbolicMemory(ptr)
        function increment(): u32 {
            const next = Intrinsics.load(memory, 0, Types.u32) + 1
            Intrinsics.store(memory, 0, next, Types.u32)
            return next
        }
        function readInline(): u32 {
            return Intrinsics.load(memory, 0, Types.u32) as u32
        }
        intrinsics.tagInline(readInline)
        function readThroughConcreteCall(): u32 {
            return readInline() + 1
        }
        function release(): u32 {
            return syscalls.munmap(ptr, 4096)
        }
        const counter = createNative(increment)
        const free = createNative(release).native
        assert(counter.graph.params.length === 0)
        assert(counter.native() === 1)
        assert(counter.native() === 2)
        const reader = createNative(readThroughConcreteCall)
        assert([...reader.graph.nodes.values()].some(n => n.op === 'load'))
        assert(reader.native() === 3)
        assert(free() === 0)
    }
    testStaticMemory()

    function testArrayViews() {
        const OneByteArray = intrinsics.DefineStructView(reify u8[])
        function oneByte(s: usize) {
            const v = OneByteArray(s)
            return v[2]
        }
        const d1 = new Uint8Array([1,2,3,4,5])
        const d1Ptr = (ts as any).getArrayBufferPtr(d1.buffer)
        const nativeOneByte = createNative(oneByte)
        assert(nativeOneByte.native(d1Ptr) == d1[2])
        const FourByteArray = intrinsics.DefineStructView(reify u32[])
        function fourByte(s: usize) {
            const v = FourByteArray(s)
            v[4] = 99
            return v[3]
        }
        const d2 = new Uint32Array([1,2,3,4,5])
        const d2Ptr = (ts as any).getArrayBufferPtr(d2.buffer)
        const nativeFourByte = createNative(fourByte)
        assert(nativeFourByte.native(d2Ptr) == d2[3])
        assert(d2[4] == 99)
    }
    testArrayViews()

    function testIndirectCallContext() {
        function nestedCallee(): u32 {
            return 0
        }
        function indirectCallee(expected: usize): u32 {
            return Intrinsics.callcontext() === expected ? 1 : 0
        }
        function indirectCalleeAcrossCall(expected: usize, nestedSlot: usize): u32 {
            const fn = Intrinsics.load(nestedSlot, 0, Types.fnptr) as any
            fn()
            return Intrinsics.callcontext() === expected ? 1 : 0
        }
        function indirectCaller(slot: usize): u32 {
            const fn = Intrinsics.load(slot, 0, Types.fnptr) as any
            return fn(slot) + 1
        }
        function indirectOffsetCaller(base: usize): u32 {
            const fn = Intrinsics.load(base, 8, Types.fnptr) as any
            return fn(base + 8) + 1
        }
        function indirectCallerAcrossCall(slot: usize, nestedSlot: usize): u32 {
            const fn = Intrinsics.load(slot, 0, Types.fnptr) as any
            return fn(slot, nestedSlot) + 1
        }

        const callee = createNative(indirectCallee)
        const nested = createNative(nestedCallee)
        const across = createNative(indirectCalleeAcrossCall)
        const cell = new BigUint64Array(2)
        cell[0] = BigInt(callee.native.ptr)
        cell[1] = BigInt(callee.native.ptr)
        const nestedCell = new BigUint64Array(1)
        nestedCell[0] = BigInt(nested.native.ptr)
        const acrossCell = new BigUint64Array(1)
        acrossCell[0] = BigInt(across.native.ptr)
        const slot = Number((ts as any).getArrayBufferPtr(cell.buffer))
        const nestedSlot = Number((ts as any).getArrayBufferPtr(nestedCell.buffer))
        const acrossSlot = Number((ts as any).getArrayBufferPtr(acrossCell.buffer))
        const caller = createNative(indirectCaller)
        const offsetCaller = createNative(indirectOffsetCaller)
        const acrossCaller = createNative(indirectCallerAcrossCall)
        assert([...caller.graph.nodes.values()].some(n => n.op === 'indirect-target'))
        assert(caller.code.listing.includes('x15'))
        assert(caller.native(slot) === 2)
        assert(offsetCaller.native(slot) === 2)
        const acrossResult = acrossCaller.native(acrossSlot, nestedSlot)
        if (intrinsics.argv().includes('indirect-context')) {
            console.log(lowering2.dumpGraph(across.graph))
            console.log(across.code.listing)
            console.log(lowering2.dumpGraph(acrossCaller.graph))
            console.log(acrossCaller.code.listing)
            console.log('indirect context across call', acrossResult)
        }
        assert(acrossResult === 2)

        type FnHolder = { c: u64, f: intrinsics.FnPtr<(a: u64, b: u64) => u64> }
        const FnHolder = intrinsics.DefineStructView(reify FnHolder)
        function f(a: u64, b: u64): u64 {
            const ctx = Intrinsics.callcontext()
            const c = Intrinsics.load(ctx, -8, Types.u64)
            return a + b + c
        }
        function f2(ref: usize): u64 {
            const v = FnHolder(ref)
            return v.f(1, 2)
        }
        const fNative = createNative(f)
        const f2Native = createNative(f2)
        if (intrinsics.argv().includes('indirect-context')) {
            console.log(lowering2.dumpGraph(f2Native.graph))
            console.log(f2Native.code.listing)
        }
        const cell2 = new BigUint64Array(2)
        cell2[0] = BigInt(3)
        cell2[1] = BigInt(fNative.native.ptr)
        assert(f2Native.native((ts as any).getArrayBufferPtr(cell2.buffer)) === 6)
    }
    testIndirectCallContext()

    function testPassedNativeValue() {
        type Unary = intrinsics.FnPtr<(value: u32) => u32>
        function callee(value: u32): u32 {
            return value + 7
        }
        function pass(fn: Unary, value: u32): u32 {
            if (!fn) throw 'unreachable'
            return fn(value)
        }
        function caller(value: u32): u32 {
            const holder = { fn: callee }
            return pass(holder.fn as any, value)
        }
        const result: any = native.createNatives({ caller, pass, callee })
        assert(result.caller(5) === 12)
    }
    testPassedNativeValue()

    function testPassedHeapValue() {
        const handle = heap.fromJsString('native heap value')
        const captured = heap.createHeapHandle(handle)
        function passHandle(value: intrinsics.Handle): intrinsics.Handle {
            return value
        }
        function capturedHandle(fn: intrinsics.FnPtr<(value: intrinsics.Handle) => intrinsics.Handle>): intrinsics.Handle {
            return fn(captured)
        }
        const handles: any = native.createNatives({ capturedHandle, passHandle })
        assert(handles.capturedHandle(handles.passHandle.ptr) === handle)

        interface Cell { value: u32 }
        const Cell = intrinsics.DefineStructView(reify Cell)
        function readCell(ptr: usize): u32 {
            return Cell(ptr).value
        }
        const result: any = native.createNatives({ readCell })
        const cell = new Uint32Array([37])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(result.readCell(ptr) === 37)
    }
    testPassedHeapValue()

    function testStructViewAcrossBranch() {
        const View = intrinsics.DefineStructView(reify { x: u32 })
        function expensive(ptr: usize) {
            const x = View(ptr).x
            const z = ((x * x)+1)*x
            return (x + x) % z
        }
        intrinsics.tagNoInline(expensive)
        function viewHelper(ptr: usize) {
            if (expensive(ptr) > 99999) return View(0)
            return View(ptr)
        }
        intrinsics.tagNoInline(viewHelper)
        function f(ptr: usize) {
            if (View(ptr).x === 0) return 99
            const v = viewHelper(ptr)
            v.x = v.x + 1
            return v.x
        }
        const result: any = native.createNatives({ f })
        const cell = new Uint32Array([37])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(result.f(ptr) === 38)
        cell[0] = 0
        assert(result.f(ptr) === 99)
        function viewHelperInline(ptr: usize) {
            if (expensive(ptr) > 99999) return View(0)
            return View(ptr)
        }
        function f2(ptr: usize) {
            if (View(ptr).x === 0) return 99
            const v = viewHelperInline(ptr)
            v.x = v.x + 1
            return v.x
        }
        const result2: any = native.createNatives({ f2 })
        const cell2 = new Uint32Array([37])
        const ptr2 = (ts as any).getArrayBufferPtr(cell2.buffer)
        assert(result2.f2(ptr2) === 38)
        cell2[0] = 0
        assert(result2.f2(ptr2) === 99)
    }
    testStructViewAcrossBranch()

    function testTraceBindings() {
        function constantArmLoop(flag: u32): u32 {
            let value = 2
            if (flag) value = 5
            for (let i = 0; i < 3; i++) value = (value + i) % 7
            return value as u32
        }
        const loop = createNative(constantArmLoop).native
        assert(loop(0) === 5)
        assert(loop(1) === 1)

        function prunedJoin(flag: u32, value: u32): u32 {
            const fixed = 2
            let result = 0
            if (flag) result = value + 1
            else if (fixed + 5 !== 9) result = value + 2
            else if (value > 0) result = 6
            else result = 7
            return result * 3 as u32
        }
        const join = createNative(prunedJoin).native
        assert(join(1, 4) === 15)
        assert(join(0, 4) === 18)

        function identicalComputedInputs(flag: u32, value: u32): u32 {
            let factor = 0
            if (flag) {
                for (let i = 0; i < 3; i++) factor += i
            } else {
                factor = 9
                for (let i = 0; i < 3; i++) factor -= 2
            }
            return (factor === 3 ? value : 0) as u32
        }
        const identical = trace2(identicalComputedInputs)
        // The join must see both computed 3s before tracing its comparison.
        // This checks specialization in the trace, before lowering optimizes it.
        for (const b of identical.graph.blocks) if (b.id) assert(b.params.length === 0)
        for (const n of identical.graph.nodes.values()) assert(n.op !== 'eq')
        const specialized = createNative(identicalComputedInputs).native
        assert(specialized(0, 17) === 17)
        assert(specialized(1, 23) === 23)

        function identicalForwardInputs(flag: u32, value: u32): u32 {
            let factor: number
            if (flag) {
                if (value) factor = 1
                else factor = 1
                factor *= 3
            } else {
                if (value) factor = 9
                else factor = 9
                factor -= 6
            }
            return (factor === 3 ? value : 0) as u32
        }
        const forward = trace2(identicalForwardInputs)
        // Both shared predecessors must specialize factor before the final join.
        // The separate refinements of value can still require parameters.
        for (const n of forward.graph.nodes.values()) assert(n.op !== 'eq')
        const joined = createNative(identicalForwardInputs).native
        assert(joined(0, 17) === 17)
        assert(joined(1, 23) === 23)
        assert(joined(1, 0) === 0)

        function writeLoop(ptr: usize, count: u32): void {
            for (let i = 0; i < count; i++) Intrinsics.store(ptr, 0, i + 1, Types.u32)
        }
        intrinsics.tagInline(writeLoop)
        function readAfterLoop(ptr: usize, count: u32): u32 {
            writeLoop(ptr, count)
            return Intrinsics.load(ptr, 0, Types.u32)
        }
        const read = createNative(readAfterLoop).native
        const cell = new Uint32Array([91])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(read(ptr, 0) === 91)
        assert(read(ptr, 4) === 4)

        function reserve(ptr: usize, count: u32): u32 {
            const start = Intrinsics.load(ptr, 0, Types.u32)
            if (count === 0 || start + count > 16) return 0
            Intrinsics.store(ptr, 0, start + count, Types.u32)
            return start
        }
        const alloc = createNative(reserve).native
        assert(alloc(ptr, 2) === 4)
        assert(cell[0] === 6)
        assert(alloc(ptr, 0) === 0)
        assert(alloc(ptr, 20) === 0)
        assert(cell[0] === 6)
        assert(alloc(ptr, 10) === 6)
        assert(cell[0] === 16)
    }
    testTraceBindings()

    let totalInst = 0
    process.on('beforeExit', () => console.log('TOTAL INST COUNT', totalInst))
    function testNativeCompile(fn: Function, inputs: number[][], name: string = fn.name, regBudget?: number) {
        console.log(`=== compile ${name} ===`)
        const c = createNative(fn, regBudget)
        console.log(c.trace.text)
        if (intrinsics.argv().includes(`lower-debug:${name}`)) console.log(c.code.listing)
        const native = c.native
        console.log(`  ${c.code.words.length} instructions`)
        totalInst += c.code.words.length
        let failed = false
        for (const args of inputs) {
            const expected = fn(...args)
            const actual = native(...args)
            const ok = actual === expected
            if (!ok) failed = true
            console.log(`  ${ok ? 'ok  ' : 'BAD '} ${name}(${args.join(', ')}) = ${actual}, expected ${expected}`)
        }
        if (failed) {
            console.log(c.code.listing)
            throw `trace2: ${name} does not agree with itself`
        }
        return c.code
    }

