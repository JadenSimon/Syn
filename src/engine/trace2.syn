type usize = u32

const dumpEveryListing = intrinsics.argv().includes('lower-debug')
let anonymousGraphs = 0
function lowerValueGraph(
    g: lowering2.Graph,
    opts: lowering2.LowerGraphOptions = {},
): lowering2.LowerGraphResult {
    const result = lowering2.lowerValueGraph(g, opts)
    if (dumpEveryListing && !opts.debug) {
        console.log(`--- ${g.name ?? `anonymous#${++anonymousGraphs}`} listing ---\n`, result.listing)
    }
    return result
}

const Types = intrinsics.Types

const Intrinsics = intrinsics.Intrinsics
const assert = intrinsics.assert

const TerminalOpcodes = new Set<number>([Op.Return, Op.ReturnVoid, Op.Throw, Op.ReThrow])
const CondJumpOpcodes = new Set<number>([
    Op.JumpIfNull, Op.JumpIfUndefined, Op.JumpIfNullish, Op.JumpIfToBooleanFalse,
    Op.JumpIfNotNull, Op.JumpIfNotUndefined, Op.JumpIfNotNullish, Op.JumpIfToBooleanTrue,
])

function findLeaders(code: readonly u8[], codeLen: number) {
    const set = new Set<number>([0])
    const it = bytecode.createCodeIterator(code)
    const insts: bytecode.CodeInstruction[] = []
    while (const inst = it.next()) {
        if (inst.pos >= codeLen) break
        insts.push(inst)
    }
    for (let i = 0; i < insts.length; i++) {
        const inst = insts[i]
        const after = i + 1 < insts.length ? insts[i + 1].pos : codeLen
        if (TerminalOpcodes.has(inst.opcode)) { set.add(after); continue }
        if (inst.jumpTarget !== undefined) {
            set.add(inst.jumpTarget)
            set.add(after)
            continue
        }
        if (CallLikeOpcodes.has(inst.opcode)) set.add(after)
    }
    const out: number[] = []
    for (const l of set) {
        if (l < codeLen) out.push(l)
    }
    out.sort((a, b) => a - b)
    return { out, insts }
}

interface Blocks {
    leaders: number[]
    order: number[]
    succs: number[][]
    preds: number[][]
    insts: bytecode.CodeInstruction[][]
    backPreds: number[][]
    readSlots: number[][]
    liveIn: Set<number>[]
    cycles: Set<number>[] // loop header -> members, empty for other blocks
    cycleWrites: Set<number>[]
    cycleReads: Set<number>[]
    retCount: number
}

interface Step {
    kind: string
    from: number
    outs: Float64Array
    target: number
    condId: number
    thenPc: number
    elsePc: number
    valueId: number
    valueConst: number
}

type Node = lowering2.GraphNode

const binaryOps = new Set([
    'add', 'sub', 'mul', 'div', 'rem', 'pow', 'lt', 'le', 'gt', 'ge', 'eq', 'ne',
    'or', 'and', 'xor', 'ushr', 'shr', 'shl', 'mem',
])
const unaryOps = new Set(['neg', 'not', 'convert', 'bitconvert', 'typeof'])

function lowOperands(op: string, arity: number): number {
    if (binaryOps.has(op)) return 2
    if (unaryOps.has(op)) return 1
    if (op === 'call') return arity
    if (op === 'select' || op === 'store') return 3
    if (op === 'load') return 2
    if (op === 'ret' || op === 'stackalloc' || op === 'stackfree') return 1
    return 0
}

function fromOpTrace(g: NodeSpace, t: intrinsics.OpTrace): Node {
    if (t.op === 'rt') throw 'trace: rt ops are built with their ordering value in the rt hook'
    const arity = lowOperands(t.op, t.args.length)
    const operands: Operand[] = []
    for (let i = 0; i < arity; i++) operands.push(t.argIds[i] || { literal: t.args[i] })
    return makeNode(g, gn.nodeOp(t.op), operands, intrinsics.resultTypeOf(t.op, t.args[arity], t.args[arity + 1]))
}

interface TraceFrame {
    dispatch(pc: number): number
    branch(cond: any, v1: number, v2: number): number
    canexit(acc: any): boolean
    voidvalue(): any
    shapeof(value: any): any
    rt(op: number, args: any[]): any
    panic(acc: any): void
    trap(code: any): void
    call(target: any, thisArg: any, regStart: number, nargs: number, cb: any): any
}

interface SessionBlock {
    params: number[]
    inputs: number[]
    argumentIndices: number[]
    body: any
}

interface Proxied {
    param?: any
    cell?: u32
    joined?: Joined
    group?: number
    union?: Union
}

interface Union {
    param: any
    arm: any
    record: any
    shape: u32
    fields: u32[]
    object?: u32
}

interface TraceRuntime {
    tracer: any
    ids: intrinsics.IdSpace
    nodes: Map<number, Node>
    literals: gn.LiteralPool
    debugLabels: Map<number, string>
    blocks: Map<number, SessionBlock>
    frames: TraceFrame[]
    objects: HeapRecords
    opaque: Map<number, u32>
    groupObjects: Map<Group, u32>
    proxied: Map<u32, Proxied>
    unions: Map<number, Union>
    memory: Map<number, MemoryFacts>
    applications: Map<number, number[]>
    nilEffect?: any
    depth: number
}

interface KnownMemory {
    value: any
    T: number
}

type MemoryFacts = Map<number, Map<number, KnownMemory>>

const CompareOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne])

const CallOpcodes = new Set<number>([
    Op.Call, Op.CallConst, Op.Construct, Op.ConstructConst, Op.CallArray, Op.CreateEmptyArray, Op.CreateArrayLiteral,
])

const LoadOpcodes = new Set<number>([
    Op.GetProperty, Op.GetPropertyConst, Op.GetPropertyImm,
])

const StoreOpcodes = new Set<number>([
    Op.SetProperty, Op.SetPropertyConst, Op.SetPropertyImm,
])

const CallLikeOpcodes = new Set<number>([...CallOpcodes, ...LoadOpcodes, ...StoreOpcodes])

const FrameSyncOpcodes = new Set<number>([...CallLikeOpcodes, Op.LoadFrame, Op.StoreFrame])

function deriveBlocks(
    code: readonly u8[], codeLen: number,
    accSlot: number, tokenSlot: number,
    captured: bytecode.FrameCaptures,
    handlers: { start: number, end: number, handler: number }[],
): Blocks {
    function readsToken(opcode: number): boolean {
        if (TerminalOpcodes.has(opcode)) return true
        return writesToken(opcode)
    }
    function writesToken(opcode: number): boolean {
        return CallOpcodes.has(opcode) || LoadOpcodes.has(opcode) || StoreOpcodes.has(opcode)
    }
    function readsOf(inst: bytecode.CodeInstruction): number[] {
        const out: number[] = []
        for (const r of bytecode.getRegReads(inst)) out.push(r === -1 ? accSlot : r)
        if (readsToken(inst.opcode)) out.push(tokenSlot)
        if (FrameSyncOpcodes.has(inst.opcode)) for (const r of captured.reads) out.push(r)
        return out
    }
    function writesOf(inst: bytecode.CodeInstruction): number[] {
        const out: number[] = []
        for (const r of bytecode.getRegWrites(inst)) out.push(r === -1 ? accSlot : r)
        if (writesToken(inst.opcode)) out.push(tokenSlot)
        if (FrameSyncOpcodes.has(inst.opcode)) for (const r of captured.writes) out.push(r)
        return out
    }

    const leadersResult = findLeaders(code, codeLen)
    const leaders = leadersResult.out
    const n = leaders.length
    const at = new Map<number, number>()
    for (let i = 0; i < n; i++) at.set(leaders[i], i)

    const insts: bytecode.CodeInstruction[][] = []
    for (let i = 0; i < n; i++) insts.push([])
    {
        let currentLeader = 0
        for (const inst of leadersResult.insts) {
            if (inst.pos >= codeLen) break
            while (currentLeader + 1 < n && inst.pos >= leaders[currentLeader + 1]) {
                currentLeader += 1
            }
            insts[currentLeader].push(inst)
        }
    }

    let retCount = 0
    const succs: number[][] = []
    for (let i = 0; i < n; i++) {
        const own = insts[i]
        const last = own[own.length - 1]
        const after = i + 1 < n ? leaders[i + 1] : codeLen
        const s: number[] = []
        function to(pc: number): void {
            const t = at.get(pc)
            if (t !== undefined) s.push(t)
        }
        if (!TerminalOpcodes.has(last.opcode)) {
            if (last.jumpTarget !== undefined) {
                if (CondJumpOpcodes.has(last.opcode)) to(after)
                to(last.jumpTarget)
            } else if (after < codeLen) to(after)
        } else if (last.opcode === Op.Return || last.opcode === Op.ReturnVoid) {
            retCount += 1
        }
        succs.push(s)
    }
    const preds: number[][] = []
    for (let i = 0; i < n; i++) preds.push([])
    for (let i = 0; i < n; i++) {
        for (const target of succs[i]) preds[target].push(i)
    }
    const throwsTo: number[][] = preds.map(() => [])
    for (const range of handlers) {
        const handler = at.get(range.handler)
        intrinsics.assert(handler !== undefined, `trace2: EH handler pc ${range.handler} is not a block leader`)
        for (let i = 0; i < n; i++) {
            const end = i + 1 < n ? leaders[i + 1] : codeLen
            if (leaders[i] < range.end && end > range.start) throwsTo[i].push(handler)
        }
    }
    const order: number[] = []
    const visited = new Set<number>()
    const active = new Set<number>()
    const backPreds: number[][] = preds.map(() => [])
    function visit(b: number): void {
        if (visited.has(b)) return
        visited.add(b)
        active.add(b)
        for (const next of succs[b]) {
            if (active.has(next)) backPreds[next].push(b)
            else visit(next)
        }
        for (const handler of throwsTo[b]) visit(handler)
        active.delete(b)
        order.push(b)
    }
    visit(0)
    order.reverse()

    const readSlots: number[][] = []
    const writes: Set<number>[] = []
    for (const own of insts) {
        const reads = new Set<number>()
        const defined = new Set<number>()
        for (const inst of own) {
            for (const r of readsOf(inst)) if (!defined.has(r)) reads.add(r)
            for (const r of writesOf(inst)) defined.add(r)
        }
        readSlots.push([...reads])
        writes.push(defined)
    }

    function readsBeforeWrite(start: number, slot: number, region?: Set<number>): boolean {
        const seen = new Set<number>()
        const pending = [start]
        while (pending.length) {
            const b = pending.pop()!
            if (seen.has(b) || (region && !region.has(b))) continue
            seen.add(b)
            if (readSlots[b].includes(slot)) return true
            if (!writes[b].has(slot)) for (const next of succs[b]) pending.push(next)
        }
        return false
    }
    const liveIn: Set<number>[] = readSlots.map(slots => new Set<number>(slots))
    const pendingLiveness = order.slice()
    const queuedLiveness = new Set<number>(pendingLiveness)
    while (pendingLiveness.length) {
        const b = pendingLiveness.pop()!
        queuedLiveness.delete(b)
        for (const pred of preds[b]) {
            let changed = false
            for (const slot of liveIn[b]) {
                if (writes[pred].has(slot) || liveIn[pred].has(slot)) continue
                liveIn[pred].add(slot)
                changed = true
            }
            if (changed && !queuedLiveness.has(pred)) {
                queuedLiveness.add(pred)
                pendingLiveness.push(pred)
            }
        }
    }
    const cycles: Set<number>[] = insts.map(() => new Set<number>())
    const cycleWrites: Set<number>[] = insts.map(() => new Set<number>())
    const cycleReads: Set<number>[] = insts.map(() => new Set<number>())
    for (const b of order) {
        if (!backPreds[b].length) continue
        const region = cycles[b]
        region.add(b)
        const pending = backPreds[b].slice()
        while (pending.length) {
            const member = pending.pop()!
            if (region.has(member)) continue
            region.add(member)
            for (const pred of preds[member]) pending.push(pred)
        }
        for (const member of region) {
            for (const slot of writes[member]) cycleWrites[b].add(slot)
        }
        for (const slot of liveIn[b]) {
            if (readsBeforeWrite(b, slot, region)) cycleReads[b].add(slot)
        }
    }

    const loopOrder: number[] = []
    const placed = new Set<number>()
    for (const b of order) {
        if (placed.has(b)) continue
        loopOrder.push(b)
        placed.add(b)
        if (!backPreds[b].length) continue
        for (const member of order) {
            if (placed.has(member) || !cycles[b].has(member)) continue
            loopOrder.push(member)
            placed.add(member)
        }
    }

    return { leaders, order: loopOrder, succs, preds, insts, backPreds, readSlots, liveIn, cycles, cycleWrites, cycleReads, retCount }
}

export interface TraceSession {
    intrinsicContext: Record<string, any>
    moduleContext: Record<string, any>
    globals: Record<string, any>
    intrinsicFns: Map<number, string>
    functionStubs: Map<Function, number>
    stubFunctions: Map<number, Function>
    symbolicDispatch: Function
    symbolicJmp: Function
    symbolicBranch: Function
    symbolicPanic: Function
    symbolicProxyGet: Function
    symbolicProxySet: Function
    runtime?: TraceRuntime
    mk(op: NodeOp, args: number[], label?: string, type?: gn.TypeOperand, unique?: boolean): any
    fromJsValue(v: any): u32
    linkFunction(f: Function): u32
    compileSource(code: string): CompiledSource
    compileTemplate(compiled: bytecode.EmitResult): CompiledSource
    functionCode(fn: Function): FunctionCode
    typeRoots(fns: Function[], numeric: boolean): typer.Typer
    reached(fn: Function): boolean
    templateOf(closure: u32): Template | undefined
    finalize(compiled: bytecode.EmitResult, captures?: any[]): u32
    enterTrace(): TraceRuntime
    leaveTrace(): void
    constructions: Map<u32, Construction>
    sealed: Set<intrinsics.Handle>
    fold(rebuild: Function): heap.Handle
    typesWrapper: any
}

export interface Construction {
    rebuild: Function
    graph: lowering2.Graph
}

export interface Template {
    compiled: bytecode.EmitResult
    captures?: any[]
}

export interface CompiledSource {
    compiled: bytecode.EmitResult
    codeLen: number
    blocks: Blocks
    captured: bytecode.FrameCaptures
}

export interface FunctionCode {
    input: string | bytecode.EmitResult
    captures: any[]
    ambient?: string[]
    source: CompiledSource
}

const symbolicMemoryTag = Symbol('trace.symbolicMemory')

interface SymbolicMemory {
    [symbolicMemoryTag]: true
    ptr: number
}

export function symbolicMemory(ptr: number | bigint): usize {
    return { [symbolicMemoryTag]: true, ptr: Number(ptr) } as any
}

function isSymbolicMemory(v: any): v is SymbolicMemory {
    return !!v?.[symbolicMemoryTag]
}

let cachedTypesHeapObj: any
function getCachedTypes() {
    if (cachedTypesHeapObj) return cachedTypesHeapObj
    const h = heap.fromJsObject(Types)
    return cachedTypesHeapObj = heap.createHeapHandle(h) 
}

let cachedIntrinsicsHeapObj: {
    stubs: Map<number, string>
    wrapper: any
}
function getCachedIntrinsics() {
    if (cachedIntrinsicsHeapObj) return cachedIntrinsicsHeapObj
    const stubs = new Map<number, string>()
    const o: any = {}
    for (const [name, value] of Object.entries(Intrinsics)) {
        const stub = heap.makeIndirect(heap.makeFunctionObject())
        stubs.set(stub, name)
        o[name] = heap.createHeapHandle(stub)
    }
    const h = heap.fromJsObject(o)
    return cachedIntrinsicsHeapObj = {
        stubs,
        wrapper: heap.createHeapHandle(h),
    }
}

function createTraceMemory(top: number, window: number) {
    const base = top - window
    const view = new Float64Array(window)
    let low = top
    return {
        get(addr: number): any {
            return view[addr - base]
        },
        set(addr: number, value: any): void {
            view[addr - base] = value
        },
        reserve(addr: number): void {
            assert(addr >= base, 'trace: trace stack overflows the trace memory window')
            if (addr < low) low = addr
        },
        reset(): void {
            if (low < top) view.fill(0, low - base, window)
            low = top
        },
    }
}

const traceMem = createTraceMemory(intrinsics.heapMaxAddress * 2, 1 << 16)

const constructors = new Map<Function, boolean>()
const emittedSources = new Map<string, bytecode.EmitResult>()
export function isConstructor(f: Function): boolean {
    const known = constructors.get(f)
    if (known !== undefined) return known
    const computation = (f as any)[Symbol.for('toComputation')]
    const result = typeof computation === 'function' && /^class\b/.test(computation()[0].trimStart())
    constructors.set(f, result)
    return result
}

class TracedError {
    constructor(public readonly message: string) {}
}

function frozenData(module: Record<string, any>): Record<string, any> {
    const out: Record<string, any> = {}
    for (const [key, value] of Object.entries(module)) {
        const object = value !== null && typeof value === 'object'
        const plain = object && Object.getPrototypeOf(value) === Object.prototype
        assert(!object || plain, `trace2: module export '${key}' is a ${value?.constructor?.name ?? 'non-plain object'}; traced code reads module exports as frozen plain data`)
        out[key] = plain ? Object.freeze({ ...value }) : value
    }
    return out
}

export function createTraceSession(): TraceSession {
    const intrinsicNames = new Map<Function, string>()
    function symbolicDispatch(pc: number): number { return pc }
    function symbolicJmp(pc: number, off: number): number { return pc + off }
    function symbolicBranch(cond: boolean, v1: usize, v2: usize) {
        return cond ? v1 : v2
    }
    function symbolicPanic(err: any, T: any) {}
    function symbolicProxyGet(key: any) {}
    function symbolicProxySet(key: any, value: any) {}
    const intrinsicContext: Record<string, any> = { ...Intrinsics }
    for (const [name, value] of Object.entries(Intrinsics)) {
        if (typeof value !== 'function') continue
        intrinsicNames.set(value, name)
        const forward = (...args: any[]) => (Intrinsics as any)[name](...args)
        intrinsicNames.set(forward, name)
        intrinsicContext[name] = forward
    }
    intrinsicContext.branch = symbolicBranch
    intrinsicContext.dispatch = symbolicDispatch
    intrinsicContext.jmp = symbolicJmp
    intrinsicContext.branch = symbolicBranch
    intrinsicContext.panic = symbolicPanic
    const moduleContext = Object.freeze({
        ...frozenData(intrinsics),
        Intrinsics: getCachedIntrinsics().wrapper,
        isNative: intrinsics.tagConcrete(() => true),
    })
    const intrinsicFns = getCachedIntrinsics().stubs
    const functionStubs = new Map<Function, number>()
    const stubFunctions = new Map<number, Function>()
    const compiledSources = new Map<string, CompiledSource>()
    const compiledTemplates = new Map<bytecode.EmitResult, CompiledSource>()
    const templates = new Map<u32, Template>()
    const finalizedFunctions = new Map<bytecode.EmitResult, { captures?: any[], fn: u32 }[]>()
    const functionCodes = new Map<Function, FunctionCode>()
    const memberOwners = new Map<Function, Function>()
    const classMembers = new Map<Function, [cls: Function, member: bytecode.EmitResult]>()
    const memberClasses = new Map<bytecode.EmitResult, Function>()
    let runtime: TraceRuntime | undefined
    let nodeCache: Map<string, number> | undefined

    const ctx: Record<string, any> = {
        Intrinsics: intrinsicContext, Error: TracedError,
        Symbol: heap.symbolConstants, ...builtinGlobals,
        intrinsics: moduleContext, heap, syscalls,
    }
    for (const value of Object.values(builtinGlobals)) if (typeof value === 'function' && isConstructor(value)) noteMembers(value)

    function context(captures: any[] = []): Record<string, any> {
        for (let i = 0; i < captures.length; i++) {
            const capture = captures[i]
            ctx[`$${i}`] = capture === Symbol ? heap.symbolConstants
                : capture === Intrinsics ? getCachedIntrinsics().wrapper
                : capture === intrinsics ? moduleContext 
                : capture === Types ? getCachedTypes()
                : capture === intrinsics.isNative ? moduleContext.isNative : capture

        }
        return ctx
    }

    function linkFunction(f: Function): u32 {
        const prev = functionStubs.get(f)
        if (prev !== undefined) return prev as u32
        const stub = heap.makeIndirect(heap.makeFunctionObject())
        functionStubs.set(f, stub)
        stubFunctions.set(stub, f)
        if (isConstructor(f)) noteMembers(f)
        const intrinsicName = intrinsicNames.get(f)
        if (intrinsicName !== undefined) intrinsicFns.set(stub, intrinsicName)
        const proto = (f as any).prototype
        if (proto !== null && typeof proto === 'object') heap.setProperty(heap.indirectTarget(stub), heap.prototypeKey, fromJsValue(proto) as intrinsics.Handle)
        for (const key of Reflect.ownKeys(f)) {
            if (key === 'length' || key === 'name' || key === 'prototype') continue
            heap.setProperty(heap.indirectTarget(stub), fromJsValue(key) as intrinsics.Handle, fromJsValue((f as any)[key]) as intrinsics.Handle)
        }
        return stub
    }

    const constructions = new Map<u32, Construction>()
    const sealed = new Set<intrinsics.Handle>()
    const statics = new Map<heap.Handle, Function>()
    function fillStatic(box: heap.Handle, rebuild: Function): void {
        heap.setBoxedF64(box, heap.unboxF64(vmHandle(Intrinsics.static(rebuild) as u32)))
    }
    function construct(rebuild: Function): heap.Handle {
        const box = heap.boxF64(0)
        statics.set(box, rebuild)
        if (runtime) fillStatic(box, rebuild)
        return box
    }
    function fold(rebuild: Function): heap.Handle {
        const r = enterTrace()
        defer leaveTrace()
        const traced = trace2(rebuild, { session, shouldInline: () => true, foldEffects: true })
        const result = traced.returns[0]
        const returned = getNode(r, symbolOf(result))
        assert(traced.returns.every(x => x === result) && returned?.op === NodeOp.heapHandle && !getRef(returned, 0),
            `trace2: the construction ${rebuild.name || '<anonymous>'} did not return a single heap value`)
        const handle = getLiteral(r, returned!, 0) as heap.Handle
        constructions.set(handle, { rebuild, graph: traced.graph })
        r.objects.seal(handle)
        return handle
    }
    const convertJsValue = heap.createJsValueConverter(linkFunction, construct)
    function fromJsValue(v: any): u32 {
        if (!isSymbolicMemory(v)) return convertJsValue(v)
        return heap.boxF64(v.ptr as f64)
    }
    heap.setStringPrototype(heap.deref(heap.getPrototypeProperty(heap.deref(linkFunction(builtinGlobals.String) as intrinsics.Handle))))

    function mk(op: NodeOp, args: number[], label: string = '', type?: gn.TypeOperand, unique = false): any {
        const r = runtime
        if (!r) throw 'trace: mk requires an open trace'
        const typeSlots = gn.typeSlots(op)
        const slots = new Uint32Array(args.length + typeSlots)
        for (let i = 0; i < args.length; i++) {
            const id = symbolOf(args[i])
            slots[i] = gn.encodeSlot(r, id, id ? 0 : vmValue(args[i] as u32)) as u32
        }
        if (typeSlots) slots[args.length] = gn.encodeType(type ?? Types.unknown_number) as u32
        const key = unique ? '' : gn.slotKey(op, slots)
        if (key) {
            if (const hit = nodeCache!.get(key)) return hit
        }
        const id = newSymbolId(r.tracer)
        const handle = symbolValue(id)
        if (key) nodeCache!.set(key, handle)
        setNode(r, id, gn.makeNodeFromSlots(op, slots))
        if (label) setDebugLabel(r, id, label)
        return handle
    }

    function compileSource(code: string): CompiledSource {
        const known = compiledSources.get(code)
        if (known) return known
        traceStats.compileMisses++
        let emitted = emittedSources.get(code)
        if (!emitted) emittedSources.set(code, emitted = bytecode.compile(code))
        const source = prepareSource({ ...emitted, code: emitted.code.slice() })
        compiledSources.set(code, source)
        return source
    }

    function compileTemplate(template: bytecode.EmitResult): CompiledSource {
        const known = compiledTemplates.get(template)
        if (known) return known
        const source = prepareSource({ ...template, code: template.code.slice() })
        compiledTemplates.set(template, source)
        return source
    }

    function noteTemplates(compiled: bytecode.EmitResult, fn: u32, captures?: any[]): void {
        const bc = heap.functionBytecode(fn as intrinsics.Handle)
        for (let i = 0; i < compiled.constants.length; i++) {
            if (compiled.constantKinds[i] !== bytecode.ConstantKind.nested_function) continue
            const nested = vmHandle(heap.constantAt(bc, i as u32))
            const nestedBytecode = heap.FunctionBytecode(heap.resolveHeapCell(heap.functionBytecode(nested))).bytecode
            templates.set(nestedBytecode as u32, { compiled: compiled.constants[i], captures })
            noteTemplates(compiled.constants[i], nested as u32, captures)
        }
    }

    function templateOf(closure: u32): Template | undefined {
        const bc = heap.functionBytecode(heap.deref(closure as intrinsics.Handle))
        return templates.get(heap.FunctionBytecode(heap.resolveHeapCell(bc)).bytecode as u32)
    }

    function noteMembers(cls: Function): void {
        for (const holder of [cls, (cls as any).prototype]) {
            for (const key of Reflect.ownKeys(holder)) {
                const d = Object.getOwnPropertyDescriptor(holder, key)!
                for (const member of [d.value, d.get, d.set]) if (typeof member === 'function' && member !== cls) memberOwners.set(member, cls)
            }
        }
    }

    function bindMembers(cls: Function, holder: any, expandos: bytecode.Expandos): void {
        for (const [key, value] of expandos) {
            if (holder === cls && key === 'prototype') {
                bindMembers(cls, holder.prototype, value as bytecode.Expandos)
                continue
            }
            const d = Object.getOwnPropertyDescriptor(holder, key)
            assert(d !== undefined, `trace2: ${cls.name} has no member ${String(key)}`)
            if ('code' in value) {
                classMembers.set(d!.value, [cls, value as bytecode.EmitResult])
                continue
            }
            const accessor = value as bytecode.ClassAccessor
            if (accessor.getter) classMembers.set(d!.get!, [cls, accessor.getter])
            if (accessor.setter) classMembers.set(d!.set!, [cls, accessor.setter])
        }
    }

    function functionCode(fn: Function): FunctionCode {
        const known = functionCodes.get(fn)
        if (known) return known
        const owner = memberOwners.get(fn)
        if (owner) functionCode(owner)
        const member = classMembers.get(fn)
        let code: FunctionCode
        if (member) {
            const [cls, result] = member
            const classCode = functionCode(cls)
            code = { input: result, captures: classCode.captures, ambient: classCode.ambient, source: compileTemplate(result) }
            memberClasses.set(code.source.compiled, cls)
        } else {
            const computation = intrinsics.getComputation(fn)
            code = { input: computation[0], captures: computation[1], ambient: computation[2], source: compileSource(computation[0]) }
            if (code.source.compiled.expandos) bindMembers(fn, fn, code.source.compiled.expandos)
        }
        functionCodes.set(fn, code)
        return code
    }

    const typings: typer.Typer[] = []
    function typeRoots(fns: Function[], numeric: boolean): typer.Typer {
        const typed = typer.typeRoots(session, fns, numeric)
        typings.push(typed)
        return typed
    }

    function reached(fn: Function): boolean {
        return typings.some(typed => typed.reached(fn))
    }

    function prepareSource(compiled: bytecode.EmitResult): CompiledSource {
        const codeLen = compiled.code.length
        const ACC = compiled.registerCount
        ;(compiled.code as u8[]).push(Op.Return as u8, Op.Ldar as u8, ACC as u8)
        const captured = bytecode.frameCaptures(compiled)
        const blocks = deriveBlocks(compiled.code as u8[], codeLen, ACC, ACC + 1, captured, compiled.labels?.eh ?? [])
        return { compiled, codeLen, blocks, captured }
    }

    const captureBits = new Float64Array(2)
    const captureWords = new Uint32Array(captureBits.buffer)
    function sameCaptures(a: any[] | undefined, b: any[] | undefined): boolean {
        if (a === b) return true
        if (!a || !b || a.length !== b.length) return false
        for (let i = 0; i < a.length; i++) {
            if (a[i] === b[i]) continue
            if (typeof a[i] !== 'number' || typeof b[i] !== 'number') return false
            captureBits[0] = a[i]
            captureBits[1] = b[i]
            if (captureWords[0] !== captureWords[2] || captureWords[1] !== captureWords[3]) return false
        }
        return true
    }

    function finalize(compiled: bytecode.EmitResult, captures?: any[]): u32 {
        let known = finalizedFunctions.get(compiled)
        if (!known) finalizedFunctions.set(compiled, known = [])
        for (const entry of known) {
            if (sameCaptures(entry.captures, captures)) return entry.fn
        }
        traceStats.finalizeMisses++
        const cls = memberClasses.get(compiled)
        const fn = bytecode.finalize(
            compiled,
            bytecode.createCtx(context(captures)),
            linkFunction,
            fromJsValue,
            cls && linkFunction(cls) as intrinsics.Handle,
        )
        known.push({ captures, fn })
        noteTemplates(compiled, fn, captures)
        return fn
    }

    function enterTrace(): TraceRuntime {
        if (!runtime) {
            heap.clearNanCache()
            traceMem.reset()
            nodeCache = new Map()
            const nodes = new Map<number, Node>()
            const literals = gn.createLiteralPool()
            const debugLabels = new Map<number, string>()
            const blocks = new Map<number, SessionBlock>()
            const frames: TraceFrame[] = []
            let tracer: any
            const ids: intrinsics.IdSpace = { next: 1 }
            function frame(): TraceFrame {
                const f = frames[frames.length - 1]
                if (!f) throw 'trace2: intrinsic used without an active trace frame'
                return f
            }
            tracer = intrinsics.createIntrinsicsTracer(Intrinsics, {
                load: (ptr, offset, T) => {
                    if (ptr > intrinsics.heapMaxAddress) {
                        return traceMem.get(ptr + offset)
                    }
                    tracer.markUnhandled()
                    return tracer.saved.load(ptr, offset, T)
                },
                store: (ptr, offset, val, T) => {
                    if (ptr <= intrinsics.heapMaxAddress) {
                        tracer.markUnhandled()
                        return tracer.saved.store(ptr, offset, val, T)
                    }
                    traceMem.reserve(ptr + offset)
                    traceMem.set(ptr + offset, val)
                },
                panic: (acc) => frame().panic(acc),
                trap: (code) => frame().trap(code),
                dispatch: pc => frame().dispatch(pc),
                branch: (cond, v1, v2) => frame().branch(cond, v1, v2),
                canexit: acc => frame().canexit(acc),
                voidvalue: () => frame().voidvalue(),
                shapeof: value => frame().shapeof(value),
                rt: (op: number, ...args: any[]) => {
                    if (frames.length) return frame().rt(op, args)
                    tracer.markUnhandled()
                    return tracer.saved.rt(op, ...args)
                },
                call: (target, thisArg, regStart, nargs, cb) => frame().call(target, thisArg, regStart, nargs, cb),
                static: (fn: any) => mk(NodeOp.static, [mk(NodeOp.heapHandle, [traceValue(typeof fn === 'function' ? linkFunction(fn) : fn)])]),
            }, ids)
            runtime = {
                tracer, ids, nodes, literals, debugLabels, blocks, frames,
                objects: createHeapRecords(tracer, mk, { nodes, ids, literals }, blocks, sealed),
                opaque: new Map(),
                groupObjects: new Map(),
                proxied: new Map(),
                unions: new Map(),
                memory: new Map(),
                applications: new Map(),
                depth: 0,
            }
            session.runtime = runtime
            for (const [box, rebuild] of statics) fillStatic(box, rebuild)
        }
        runtime.depth++
        return runtime
    }

    function leaveTrace(): void {
        const r = runtime!
        if (--r.depth) return
        r.tracer.dispose()
        runtime = undefined
        session.runtime = undefined
        finalizedFunctions.clear()
    }

    const session: TraceSession = {
        intrinsicContext,
        moduleContext,
        globals: ctx,
        intrinsicFns,
        functionStubs,
        stubFunctions,
        symbolicBranch,
        symbolicDispatch,
        symbolicJmp,
        symbolicPanic,
        symbolicProxyGet,
        symbolicProxySet,
        mk,
        runtime,
        fromJsValue,
        linkFunction,
        compileSource,
        compileTemplate,
        functionCode,
        typeRoots,
        reached,
        templateOf,
        finalize,
        enterTrace,
        leaveTrace,
        constructions,
        sealed,
        fold,
        typesWrapper: getCachedTypes(),
    }
    return session
}

export interface Continuation {
    (value: any, token: any): any
    target: number
    multi: boolean
    used: boolean
}

export interface TraceOptions {
    verbose?: boolean
    captures?: any[]
    mapCapture?: (capture: any) => any
    shouldInline?: (fn: Function) => boolean
    returnTypeOf?: (fn: Function) => intrinsics.Types
    foldEffects?: boolean
    session?: TraceSession
    inputs?: { thisArg: any, args: number[], effect: any }
    continuation?: Continuation
    paramTypes?: Map<number, intrinsics.Types>
    name?: string
    self?: Function
    env?: boolean
    receiver?: boolean
}

let nestedElapsed = 0
const layouts = new Map<Function, { params: number, rest: number }>()
function layoutOf(fn: Function, session: TraceSession): { params: number, rest: number } {
    const linked = fn as any
    if (Number.isSafeInteger(linked.__localTarget)) return { params: linked.__args.length, rest: linked.__rest }
    if (Number.isSafeInteger(linked.__native)) return { params: linked.__args.length, rest: -1 }
    if (Number.isSafeInteger(linked.__syscall) || linked.concrete) return { params: -1, rest: -1 }
    const known = layouts.get(fn)
    if (known) return known
    const compiled = session.functionCode(fn).source.compiled
    const layout = { params: compiled.paramCount, rest: compiled.rest ? compiled.paramCount - 1 : -1 }
    layouts.set(fn, layout)
    return layout
}
let logTraceCalls = intrinsics.argv().includes('trace-calls')
export const traceStats = {
    calls: 0, nested: 0, compileMisses: 0, finalizeMisses: 0,
    bySource: new Map<string, { name: string, count: number, self: number }>(),
}

let blockOrderOn = false
let blockOrderStep = 0
let blockOrderDepth = 0

export function trace2(input: string | Function | bytecode.EmitResult, opts: TraceOptions = {}) {
    const session = opts.session ?? createTraceSession()
    let captures = opts.captures
    let resolved: string | bytecode.EmitResult = input as string | bytecode.EmitResult
    if (typeof input === 'function') {
        const fnCode = session.functionCode(input)
        resolved = fnCode.input
        captures = fnCode.captures
    }
    const template = typeof resolved === 'string' ? undefined : resolved
    const code = typeof resolved === 'string' ? resolved : `<template ${opts.name ?? (typeof input === 'function' ? input.name : '')}>`
    if (captures && opts.mapCapture) captures = captures.map(opts.mapCapture)
    const traceName = opts.name ?? (typeof input === 'function' ? input.name : '')
    const debugTrace = typeof input === 'function'
        && intrinsics.argv().includes(`trace-debug:${input.name}`)
    const debugBlocks = intrinsics.argv().includes(`trace-blocks:${traceName}`)
    traceStats.calls++
    if (opts.inputs) traceStats.nested++
    let statEntry = traceStats.bySource.get(code)
    if (!statEntry) traceStats.bySource.set(code, statEntry = { name: traceName || code.slice(0, 60), count: 0, self: 0 })
    statEntry.count++
    const selfStart = performance.now()
    const outerNested = nestedElapsed
    nestedElapsed = 0
    const source = template ? session.compileTemplate(template) : session.compileSource(code)
    const compiled = source.compiled
    const codeLen = source.codeLen
    const ACC = compiled.registerCount
    const TOKEN = ACC + 1
    const slotCount = ACC + 2
    const SYN_RET = codeLen
    const SYN_LDAR = codeLen + 1
    const B = source.blocks
    const leaders = B.leaders
    const blockOf = new Map<number, number>()
    for (let i = 0; i < leaders.length; i++) blockOf.set(leaders[i], i)

    if (opts.verbose || logTraceCalls) {
        console.log(code)
        console.log(bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount))
        for (let i = 0; i < leaders.length; i++) {
            console.log(`B${i} @${leaders[i]} -> ${B.succs[i].map(x => 'B' + x).join(',')}`
                + `${B.backPreds[i].length ? '  loop header' : ''}`)
            console.log('   ins: ', ...B.liveIn[i])
        }
    }

    const finalized = session.finalize(compiled, captures)
    // defer Intrinsics.free(finalized)
    if (debugTrace) {
        const fn = heap.FunctionBytecode(heap.resolveHeapCell(heap.functionBytecode(finalized as intrinsics.Handle)))
        const constants: any[] = []
        for (let i: u32 = 0; i < fn.constantsLen; i++) {
            const tagged = Intrinsics.load(heap.resolveHeapCell(fn.constants), i * 8, Types.u64) as u32
            constants.push({ tagged, hex: tagged.toString(16), value: vmValue(tagged) })
        }
        console.log('trace finalized', {
            name: input.name, finalized, constants,
            bytecode: bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount),
        })
    }
    const runtime = session.enterTrace()
    defer finally {
        session.leaveTrace()
    }
    const tracer = runtime.tracer
    const interpret = createInterpreter(true, 3, tracer.saved, false)
    const objects = runtime.objects
    const sp = Intrinsics.sp

    const mk = session.mk

    function after(v: any, token: any): any {
        const tokenId = symbolOf(token)
        if (!tokenId || getNode(runtime, tokenId)?.op === NodeOp.nilEffect) return v
        const vid = symbolOf(v)
        if (vid === tokenId) return v
        const n = getNode(runtime, vid)
        if (n && gn.countIds(n) && lowering2.OrderedValues.has(n.op) && gn.getRef(n, 0) === tokenId) return v
        return mk(NodeOp.after, [token, v])
    }

   function valToString(v: any) {
        const id = symbolOf(v)
        if (!id) return String(id)
        const o = nodeOf(id)
        if (!o) return getDebugLabel(runtime, id) ?? `p@${id}`
        const parts: string[] = [`[s@${id}] ${opName(o.op)}`]
        if (o.op === NodeOp.heapHandle && getLiteral(runtime, o, 0)) {
            parts.push(`${getLiteral(runtime, o, 0)}`)
            return `(${parts.join(', ')})`
        }
        if (o.op === NodeOp.inlined && gn.getLiteral(runtime, o, 1) !== id) {
            parts.push(`COPY OF ${gn.getLiteral(runtime, o, 1)}`)
        }
        for (let i = 0; i < countIds(o); i++) {
            const u = getRef(o, i)
            if (u) parts.push(valToString(symbolValue(u)))
            else parts.push(`${getLiteral(runtime, o, i) ?? '?'}`)
        }
        return `(${parts.join(', ')})`
    }

    let nilEffect: f64
    let returned = false
    const returns: any[] = []
    const continuation = opts.continuation
    if (continuation) {
        if (B.retCount > 1) continuation.multi = true
    }

    const spBefore = sp()
    const args = Intrinsics.stackalloc(Math.max(compiled.paramCount, 1) * 4 as u32)
    const frame = sp() - frameSize(compiled.registerCount as u32, 3)
    traceMem.reserve(frame)
    const regsBase = frameRegs(frame)
    const constructed = !opts.inputs && compiled.expandos !== undefined
    const receiverId = opts.receiver ? newSymbolId(tracer) : 0
    const thisValue = receiverId ? symbolValue(receiverId)
        : opts.inputs ? (B.liveIn[0].has(ACC) ? opts.inputs.thisArg : 0)
        : constructed ? handleValue(heap.makeObject(heap.deref(heap.getPrototypeProperty(finalized as intrinsics.Handle))) as u32)
        : 0
    const thisArg = cellOf(thisValue) || thisValue
    function slotAddr(r: number): number { return regsBase + r * 4 }
    function readToken(): any { return traceMem.get(slotAddr(TOKEN)) }
    function writeToken(v: any): void { traceMem.set(slotAddr(TOKEN), v) }

    defer heap.releaseFrameProxy(frame)
    const frames = new Map<u32, number>()
    function frameEnvironment(): any {
        const proxy = heap.liveFrameProxy(frame)
        if (proxy === undefined) return
        frames.set(proxy as u32, bytecode.frameSize(captured))
        return mk(NodeOp.heapHandle, [traceValue(proxy)])
    }
    function liveFrames(): Map<u32, number> {
        const own = heap.liveFrameProxy(frame)
        if (own !== undefined) frames.set(own as u32, bytecode.frameSize(captured))
        return frames
    }
    const captured = source.captured
    const vmStubs = new Set<Function>([
        session.symbolicPanic, session.symbolicJmp, session.symbolicBranch, session.symbolicDispatch,
    ])
    function syncsFrame(linked: any): boolean {
        if (!linked) return true
        if (linked.concrete) return false
        return !vmStubs.has(linked)
    }
    let synced = new Map<number, any>()
    function syncOut(env: any): void {
        for (const r of captured.reads) {
            const value = toGraphValue(traceMem.get(slotAddr(r)))
            if (synced.has(r) && sameValue(synced.get(r), value)) continue
            writeToken(mk(NodeOp.setProp, [readToken(), env, traceValue(heap.indexKey(r as u32)), value]))
            synced.set(r, value)
        }
    }
    function syncIn(env: any): void {
        if (!captured.writes.size) return
        if (step.kind === 'inline-cont') return
        for (const r of captured.writes) {
            const value = mk(NodeOp.getProp, [readToken(), env, traceValue(heap.indexKey(r as u32))])
            writeToken(value)
            traceMem.set(slotAddr(r), fromGraphValue(value))
            synced.set(r, toGraphValue(traceMem.get(slotAddr(r))))
        }
    }
    const envs: number[] = []
    if (opts.env) {
        const bindings = compiled.scopeBindings
        const context = mk(NodeOp.callContext, [])
        runtime.nilEffect ??= mk(NodeOp.nilEffect, [])
        const bc = heap.functionBytecode(finalized as intrinsics.Handle)
        for (let i = 0; i < bindings.length; i++) {
            const env = mk(NodeOp.getProp, [runtime.nilEffect, context, traceValue(heap.closureScopeKey(i as u32))])
            envs.push(symbolOf(env))
            heap.setConstant(bc, bindings[i].slot as u32, env)
        }
    }

    const lowNodes = new Map<number, Node>()
    function nodeOf(id: number): Node | undefined {
        const known = getNode(runtime, id) ?? lowNodes.get(id)
        if (known) return known
        const t = tracer.getTraceById(id)
        if (!t) return
        const made = fromOpTrace(runtime, t)
        lowNodes.set(id, made)
        return made
    }

    function operand(n: Node, i: number): any {
        return getRef(n, i) ? symbolValue(getRef(n, i)) : traceValue(getLiteral(runtime, n, i))
    }

    function calleeType(linked: any): gn.TypeOperand | undefined {
        if (!linked || !opts.returnTypeOf) return
        const T = opts.returnTypeOf(linked)
        if (T === Types.u64) return
        return { ref: symbolOf(mk(NodeOp.fnType, [traceValue(T)])) }
    }

    function stackPointer(v: any): number {
        let id = symbolOf(v)
        while (id && getNode(runtime, id)?.op === NodeOp.after) id = getRef(getNode(runtime, id)!, 1)
        return id && getNode(runtime, id)?.op === NodeOp.pstack ? id : 0
    }

    function allocationOf(ptr: any): number {
        const id = stackPointer(ptr)
        if (!id) return 0
        const n = getNode(runtime, id)!
        if (getRef(n, 2) || getLiteral(runtime, n, 2)) return 0
        return getRef(n, 3) || getLiteral(runtime, n, 3) ? id : 0
    }

    function factsOf(token: any): MemoryFacts | undefined {
        return runtime.memory.get(symbolOf(token))
    }

    function setFacts(token: any, facts: MemoryFacts | undefined): void {
        const id = symbolOf(token)
        assert(id, 'trace2: memory token is concrete')
        if (facts) runtime.memory.set(id, facts)
    }

    function forwardable(value: any, T: number): boolean {
        if (T === Types.vm_value) return true
        if (T >= Types.f16 && T <= Types.f64) return false
        const id = symbolOf(value)
        if (id) return getNode(runtime, id) !== undefined && gn.typeOf(getNode(runtime, id)!) === T
        const raw = vmValue(value as u32)
        return Number.isInteger(raw) && intrinsics.inRange(T as intrinsics.Types, raw)
    }

    function withContent(facts: MemoryFacts | undefined, allocation: number, offset: number, T: number, value?: any): MemoryFacts {
        const next = new Map(facts)
        const contents = new Map(next.get(allocation))
        const end = offset + Math.ceil(intrinsics.intrinsicBitWidth(T as intrinsics.Types) / 8)
        for (const [at, known] of contents) {
            if (at < end && offset < at + Math.ceil(intrinsics.intrinsicBitWidth(known.T as intrinsics.Types) / 8)) contents.delete(at)
        }
        if (value !== undefined && forwardable(value, T)) contents.set(offset, { value, T })
        next.set(allocation, contents)
        return next
    }

    function memoryLoad(ptr: any, offset: any, T: number): f64 {
        const token = readToken()
        const allocation = symbolOf(offset) ? 0 : allocationOf(ptr)
        const at = vmValue(offset as u32)
        const facts = factsOf(token)
        const known = allocation ? facts?.get(allocation)?.get(at) : undefined
        if (known && known.T === T) return known.value
        const loaded = mk(NodeOp.load, [token, ptr, offset], '', T as intrinsics.Types)
        const next = after(loaded, token)
        writeToken(next)
        setFacts(next, allocation ? withContent(facts, allocation, at, T, loaded) : facts)
        return loaded
    }

    function memoryStore(ptr: any, offset: any, value: any, T: number): void {
        const token = readToken()
        const stored = mk(NodeOp.store, [token, ptr, offset, value], '', T as intrinsics.Types)
        writeToken(stored)
        const allocation = allocationOf(ptr)
        if (!allocation) return
        const facts = factsOf(token)
        if (!symbolOf(offset)) return setFacts(stored, withContent(facts, allocation, vmValue(offset as u32), T, value))
        const next = new Map(facts)
        next.delete(allocation)
        setFacts(stored, next)
    }

    function stackOperation(stack: any, mark: any, size: any): any {
        const token = readToken()
        const v = mk(NodeOp.pstack, [token, stack, mark, size])
        writeToken(v)
        if (!symbolOf(mark) && !vmValue(mark as u32)) setFacts(v, factsOf(token))
        return v
    }

    interface Arrival {
        from: number
        values: Float64Array
        heap: HeapState
        apply: number
        synced: Map<number, any>
    }
    interface Reified {
        header: number
        inputs: number[]
        selfId: number
        paramIds: number[]
        arrivals: Arrival[]
        symbolic: Set<number>
        heap: Map<u32, { incoming: number, param: number, symbolic: boolean }>
        extras: number[]
        direct: boolean
    }
    const reified = new Map<number, Reified>()
    const regionalParams = new Set<number>()
    const paramOwner = new Map<number, number>()
    const rootBlockOrder = intrinsics.argv().includes(`block-order:${traceName}`)
    if (rootBlockOrder) {
        blockOrderOn = true
        blockOrderStep = 0
        blockOrderDepth = 0
    }
    defer if (rootBlockOrder) blockOrderOn = false
    if (blockOrderOn && !rootBlockOrder) blockOrderDepth++
    defer if (blockOrderOn && !rootBlockOrder) blockOrderDepth--
    const refinements: number[] = []
    let current = 0
    let folding: Set<number> | undefined

    function watch(b: number): boolean {
        if (envs.length && B.insts[b].some(inst => inst.opcode === Op.LoadFrame || inst.opcode === Op.StoreFrame)) return true
        for (const slot of B.readSlots[b]) {
            if (symbolOf(traceMem.get(slotAddr(slot)))) return true
        }
        return false
    }

    let phase = 0
    let resumePc = 0
    let injectedRet = false
    let stopNext = false
    const tracedBlocks = new Map<number, string>()
    const settled = new Set<number>(leaders.map((_, b) => b))
    for (const b of B.order) settled.delete(b)

    function noteTracedBlock(block: number, pc: number, owner: string): void {
        const first = tracedBlocks.get(block)
        if (first !== undefined) {
            throw `trace2: bytecode block B${block} @${pc} traced twice (${first}; ${owner})`
        }
        tracedBlocks.set(block, owner)
    }
    const emptyState = new Float64Array(0)
    let step: Step = { kind: '', from: 0, outs: emptyState, target: 0, condId: 0, thenPc: 0, elsePc: 0, valueId: 0, valueConst: 0 }

    function callArg(regStart: number, index: number): any {
        return vmValue(traceMem.get(regStart + index * 4) as u32)
    }

    function toGraphValue(value: any): any {
        if (!isVmHandle(value)) return value
        const handle = vmHandle(value)
        if (!handle) return nullishValue()
        if (handle === 1) return traceValue(handle)
        return heap.isBoxedF64(handle) ? value : handleValue(handle)
    }

    function identityOf(value: any): u32 {
        const cell = cellOf(value)
        return heap.isString(cell as intrinsics.Handle) ? 0 : cell
    }

    function textual(cell: intrinsics.Handle): boolean {
        if (heap.isString(cell)) return true
        let n = getNode(runtime, heap.boxedNanId(cell))
        while (n?.op === NodeOp.after) n = getNode(runtime, getRef(n, countIds(n) - 1))
        if (n?.op === NodeOp.rt) return getLiteral(runtime, n, 1) === RtOp.concat
        return n?.op === NodeOp.heapHandle && !getRef(n, 0) && heap.isString(getLiteral(runtime, n, 0) as intrinsics.Handle)
    }

    function concatCell(op: number, cells: intrinsics.Handle[]): intrinsics.Handle {
        if (op === RtOp.addOrConcat && !cells.some(textual)) {
            return heap.boxF64(Intrinsics.add(heap.unboxF64(cells[0]), heap.unboxF64(cells[1])))
        }
        const text = cells.map(cell => heap.boxedNanId(cell) ? traceValue(heap.unboxF64(cell)) : handleValue(tracer.saved.rt(RtOp.toString, cell)))
        const value = mk(NodeOp.rt, [readToken(), traceValue(RtOp.concat), text[0], text[1]])
        writeToken(value)
        return vmHandle(value)
    }

    let nullish: any
    function nullishValue(): any {
        if (nullish === undefined) nullish = mk(NodeOp.heapHandle, [traceValue(0)])
        return nullish
    }

    function fromGraphValue(value: any): u32 {
        const n = getNode(runtime, symbolOf(value))
        if (n && n.op === NodeOp.heapHandle && !getRef(n, 0)) return tagVmHandle(getLiteral(runtime, n, 0) as any)
        return value as u32
    }

    function graphCallArg(regStart: number, index: number): any {
        return toGraphValue(traceMem.get(regStart + index * 4))
    }

    function escapedArg(regStart: number, index: number): any {
        return escapedValue(graphCallArg(regStart, index))
    }

    function isObjectSlot(slot: intrinsics.Handle): boolean {
        if (!slot || heap.isBoxedF64(slot) || heap.isString(slot) || heap.isCallable(slot)) return false
        return heap.isOrdinaryObject(heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot)
    }

    function escapedValue(value: any, visiting = new Set<u32>()): any {
        const cell = cellOf(value)
        if (!cell || visiting.has(cell)) return value
        const state = objects.snapshot(cell as intrinsics.Handle)
        if (!state) return value
        visiting.add(cell)
        const keys = dataKeys(state as u32)
        const args = [traceValue(cell), traceValue(state)]
        for (const key of keys) {
            const slot = slotOf(state as u32, key) as intrinsics.Handle
            if (isObjectSlot(slot)) args.push(escapedValue(handleValue(slot as u32), visiting))
            else args.push(traceValue(heap.isBoxedF64(slot) ? heap.unboxF64(slot) : slot))
        }
        visiting.delete(cell)
        return mk(NodeOp.heapHandle, args)
    }

    function syncEscaped(snapshot: any): void {
        const n = getNode(runtime, symbolOf(snapshot))
        if (!n || n.op !== NodeOp.heapHandle || getRef(n, 0) || getRef(n, 1) || gn.countIds(n) < 2) return
        const cell = getLiteral(runtime, n, 0) as intrinsics.Handle
        const state = getLiteral(runtime, n, 1) as intrinsics.Handle
        let target = 0 as intrinsics.Handle
        const keys = dataKeys(state)
        for (let i = 0; i < keys.length; i++) {
            const key = keys[i]
            const descriptor = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(state, key as intrinsics.Handle)))
            const slot = descriptor.slot0 as intrinsics.Handle
            if (isObjectSlot(slot)) {
                if (getRef(n, 2 + i)) syncEscaped(symbolValue(getRef(n, 2 + i)))
                continue
            }
            if (!(descriptor.flags & heap.PropFlags.writable)) continue
            if (slot && !heap.isBoxedF64(slot) && !heap.isString(slot)) continue
            const value = mk(NodeOp.getProp, [readToken(), snapshot, traceValue(key)])
            writeToken(value)
            target ||= heap.isIndirect(cell) ? heap.prepareWrite(cell) : cell
            heap.setProperty(target, key as intrinsics.Handle, traceCell(fromGraphValue(value)) as intrinsics.Handle)
        }
    }

    function graphReceiver(value: any): any {
        return intrinsics.getNanId(value) ? traceValue(value) : toGraphValue(tagVmHandle(value))
    }

    function tagCallResult(value: any): u32 {
        const tagged = fromGraphValue(value)
        return tagged
    }

    function callLinked(linked: Function, thisArg: any, regStart: number, nargs: number, env: any): { value: any } | undefined {
        const native = linked as any
        if (native.concrete) {
            const args: any[] = []
            for (let i = 0; i < nargs; i++) {
                if (symbolOf(traceMem.get(regStart + i * 4))) {
                    throw `trace: ${linked.name || '<anonymous>'} is concrete but argument ${i} is symbolic`
                }
                args.push(callArg(regStart, i))
            }
            return { value: traceValue(linked(...args)) }
        }
        const isLocal = !!native.__localTarget
        if ((isLocal || native.__native)
            && Array.isArray(native.__args)
            && Number.isSafeInteger(native.__returns)) {
            if (nargs > native.__args.length) {
                throw `trace: native fn expected ${native.__args.length} args, got ${nargs}`
            }
            const target = isLocal
                ? mk(NodeOp.localTarget, [traceValue(native.__localTarget), traceValue(2)], native.__name ?? '', native.__returns)
                : traceValue(native.__native)
            const args = [readToken(), target, 0]
            for (let i = 0; i < nargs; i++) args.push(escapedArg(regStart, i))
            const value = mk(NodeOp.call, args)
            writeToken(value)
            for (let i = 3; i < args.length; i++) syncEscaped(args[i])
            return { value }
        }
        if (linked === session.symbolicProxyGet) {
            const receiver = thisArg as intrinsics.Handle
            const key = heap.unproxyKey(callArg(regStart, 0) as intrinsics.Handle)
            const target = runtime.proxied.get(heap.getPropertyProxy(receiver, key) as u32)!
            const value = proxyRead(target, key)
            return { value }
        }
        if (linked === session.symbolicProxySet) {
            const receiver = thisArg as intrinsics.Handle
            const key = heap.unproxyKey(callArg(regStart, 0) as intrinsics.Handle)
            const target = runtime.proxied.get(heap.getPropertyProxy(receiver, key) as u32)!
            proxyWrite(target, key, regStart)
            return { value: 0 }
        }
        if (linked === session.symbolicPanic) {
            traceFrame.panic(traceMem.get(regStart))
            return { value: 0 }
        }
        if (linked === session.symbolicJmp) {
            const value = traceValue(Intrinsics.add(
                callArg(regStart, 0), callArg(regStart, 1), Types.usize,
            ))
            return { value }
        }
        if (linked === session.symbolicBranch) {
            let hasUnknown = false
            for (let i = regStart; i < regStart + 12; i += 4) {
                if (symbolOf(traceMem.get(i))) {
                    hasUnknown = true
                    break
                }
            }
            if (!hasUnknown) {
                return { value: callArg(regStart, 0) ? traceMem.get(regStart + 4) : traceMem.get(regStart + 8) }
            }
            throw "???"
        }
        if (linked === session.symbolicDispatch) {
            const pc = callArg(regStart, 0)
            if (intrinsics.getNanId(pc)) return { value: traceValue(pc) }
            return { value: mk(NodeOp.dispatch, [traceValue(pc)]) }
        }
        if (((linked as any).shouldInline || opts.shouldInline?.(linked))
            && typeof (linked as any)[Symbol.for('toComputation')] === 'function') {
            const args: number[] = []
            for (let i = 0; i < nargs; i++) args.push(graphCallArg(regStart, i))
            const effect = readToken()
            const cont = folding ? undefined : continuationFor(env)
            let nested: ReturnType<typeof trace2> | undefined
            tracer.setActive(false)
            try {
                try {
                    nested = trace2(linked, {
                        session,
                        mapCapture: opts.mapCapture,
                        shouldInline: opts.shouldInline,
                        returnTypeOf: opts.returnTypeOf,
                        foldEffects: opts.foldEffects,
                        inputs: { thisArg: graphReceiver(thisArg), args, effect },
                        continuation: cont,
                    })
                } catch (e) {
                    console.log(linked.toString(), e)
                    throw `trace2: while tracing ${linked.name || '<anonymous>'}: ${e}`
                }
            } finally {
                tracer.setActive(true)
            }
            for (const [proxy, size] of nested.frames) frames.set(proxy, size)

            if (!nested.returned) {
                step.kind = 'inline-cont'
                step.valueId = symbolOf(nested.result)
                step.valueConst = step.valueId ? 0 : nested.result
                stopNext = true
                return { value: nested.result }
            }

            assert(cont || nested.returns.length === 1,
                `trace2: ${linked.name || '<anonymous>'} returns from ${nested.returns.length} paths inside concrete loop B${current}`)
            if (cont?.multi) {
                assert(cont.used, `trace2: multi-ret callee never applied continuation B${cont.target}`)
                const result = nested.result
                step.kind = 'inline-cont'
                step.valueId = symbolOf(result)
                step.valueConst = step.valueId ? 0 : result
                stopNext = true
                return { value: 0 }
            }

            const value = inlined(nested.result)
            const unified = objects.unify(value)
            writeToken(getOrderingFromInlined(unified ? unified.result : value, effect))
            return { value: unified ? unified.value : orderedValue(value) }
        }
        const syscall = linked as any
        if (Number.isSafeInteger(syscall.__syscall)
            && Array.isArray(syscall.__args)
            && Number.isSafeInteger(syscall.__returns)) {
            if (nargs !== syscall.__args.length) {
                throw `trace2: syscall ${syscall.__syscall} expected ${syscall.__args.length} args, got ${nargs}`
            }
            const target = mk(NodeOp.syscallTarget, [traceValue(syscall.__syscall)])
            const args = [readToken(), target, 0]
            for (let i = 0; i < nargs; i++) args.push(graphCallArg(regStart, i))
            const value = mk(NodeOp.call, args)
            writeToken(value)
            return { value }
        }
    }

    const traceFrame: TraceFrame = {
        dispatch: (pc) => {
            if (phase === 0) { phase = 1; return SYN_LDAR }
            if (phase === 1) { phase = 2; return resumePc }
            if (pc >= codeLen) {
                injectedRet = true
                step.target = pc
                return SYN_RET
            }
            if (stopNext) {
                if (debugTrace) console.log('trace dispatch stop-next', { pc, block: blockOf.get(pc), from: step.from })
                injectedRet = true
                step.target = pc
                return SYN_RET
            }
            const block = blockOf.get(pc)
            if (block === undefined) return pc
            const own = B.insts[current]
            if (own[own.length - 1].opcode === Op.ReThrow) {
                traceFrame.panic(0)
                injectedRet = true
                step.target = pc
                return SYN_RET
            }
            if (folding?.has(block)) {
                tracer.setActive(watch(block))
                if (!tracedBlocks.has(block)) noteTracedBlock(block, pc, 'concrete loop')
                current = block
                return pc
            }
            injectedRet = true
            step.target = pc
            return SYN_RET
        },
        branch: (cond, v1, v2) => {
            const id = intrinsics.getNanId(cond as any)
            if (debugTrace) console.log('trace branch intrinsic', { cond, id, v1, v2 })
            if (!id) return cond ? v1 : v2
            if (knownNonzero(id)) return v1
            const kn = nodeOf(id)
            const zero = kn && (kn.op === NodeOp.eq || kn.op === NodeOp.ne) ? againstZero(kn) : 0
            if (zero && knownNonzero(zero)) return kn!.op === NodeOp.ne ? v1 : v2
            assert(folding === undefined, `trace2: symbolic branch inside concrete loop B${current} [${traceName || '?'}] %${id}`)
            step.kind = 'branch'
            step.condId = id
            step.thenPc = v1
            step.elsePc = v2
            stopNext = true
            return v1
        },
        canexit: (acc) => {
            if (step.kind === 'inline-cont' || step.kind === 'trap') return true
            const value = toGraphValue(acc)
            if (step.kind === 'panic') {
                step.valueId = symbolOf(value)
                step.valueConst = step.valueId ? 0 : value
                return true
            }
            if (injectedRet) {
                if (step.kind !== 'branch') step.kind = 'goto'
                traceMem.set(slotAddr(ACC), acc)
            } else {
                const env = frameEnvironment()
                if (env) syncOut(env)
                const returned = returnedValue(value)
                step.kind = 'ret'
                step.valueId = symbolOf(returned)
                step.valueConst = step.valueId ? 0 : returned
            }
            return true
        },
        voidvalue: () => {
            return rawValue(mk(NodeOp.void, []))
        },
        shapeof: (value) => {
            const shape = shapeOfValue(traceValue(intrinsics.getNanId(value) ? value : heap.unboxF64(value)))
            return shape
        },
        rt: (op, args) => {
            if ((op === RtOp.concat || op === RtOp.addOrConcat) && args.some(cell => heap.boxedNanId(cell))) {
                return concatCell(op, args)
            }
            if (op === RtOp.restArray || op === RtOp.paramCount) {
                const linked = session.stubFunctions.get(args[0]) as any
                if (linked && (typeof linked[Symbol.for('toComputation')] === 'function' || Number.isSafeInteger(linked.__localTarget))) {
                    const layout = layoutOf(linked, session)
                    if (op === RtOp.paramCount) return heap.boxF64(layout.params)
                    return layout.rest < 0 ? 0 as intrinsics.Handle : session.linkFunction(builtinGlobals.Array) as intrinsics.Handle
                }
            }
            if (op === RtOp.getprop) {
                const value = mk(NodeOp.getProp, [readToken(), escapedValue(toGraphValue(args[0])), toGraphValue(args[1])])
                writeToken(value)
                return value
            }
            if (bindingOf(op)?.impl) {
                const value = mk(NodeOp.rt, [readToken(), traceValue(op), ...args.map(arg => escapedValue(toGraphValue(arg)))])
                writeToken(value)
                return value
            }
            if (op === RtOp.nullish) {
                const id = heap.boxedNanId(args[0])
                const bit = presentBits.get(id)
                if (bit === undefined) return heap.boxF64(rawValue(mk(NodeOp.eq, [symbolValue(id), nullishValue()], '', Types.bool)))
                return heap.boxF64(Intrinsics.eq(Intrinsics.and(Intrinsics.shr(rawValue(presence), bit), 1), 0))
            }
            if (op === RtOp.typeof && numberParams.has(intrinsics.getNanId(args[0]))) return heap.typeNames.number
            if (op !== RtOp.typeof || !objects.joinOf(traceValue(args[0]))) {
                for (const arg of args) if (intrinsics.getNanId(arg)) return rawValue(mk(NodeOp.rt, [nilEffect, traceValue(op), ...args.map(traceValue)]))
                tracer.markUnhandled()
                return tracer.saved.rt(op, ...args)
            }
            return heap.typeNames.object
        },
        panic: (acc): void => {
            step.kind = 'panic'
            stopNext = true
            const value = toGraphValue(acc)
            step.valueId = symbolOf(value)
            step.valueConst = step.valueId ? 0 : value
        },
        trap: (code): void => {
            step.kind = 'trap'
            stopNext = true
            step.valueId = 0
            step.valueConst = code
        },
        call: (target: any, thisArg: any, regStart: any, nargs: any, cb: any) => {
            if (!Number.isSafeInteger(nargs) || nargs < 0 || nargs > 0xFF) {
                throw `trace: invalid call arg count ${nargs} (nan ${intrinsics.getNanId(nargs)})`
            }
            const callee = target
            if (intrinsics.argv().includes(`calls:${traceName}`)) {
                const l = session.stubFunctions.get(callee) as any
                console.log(`CALL ${traceName} -> ${l?.name || session.intrinsicFns.get(callee) || '<anon>'}`)
            }
            const intrinsicName = session.intrinsicFns.get(callee)
            let linked = session.stubFunctions.get(callee) as any
            if (!linked && !intrinsics.getNanId(callee) && heap.functionBytecode(heap.deref(callee)) === finalized) {
                const self = typeof input === 'function' ? input : opts.self
                if (self) linked = opts.mapCapture ? opts.mapCapture(self) : self
            }
            if (logTraceCalls) {
                const nanId = intrinsics.getNanId(callee)
                const bytecodeFn = !nanId && !intrinsicName && !linked
                    ? heap.FunctionBytecode(heap.resolveHeapCell(heap.functionBytecode(heap.deref(callee)))) : undefined
                const callArgs: any[] = []
                for (let i = 0; i < nargs; i++) {
                    const value = callArg(regStart, i)
                    callArgs.push({ value, nanId: intrinsics.getNanId(value) })
                }
                console.log('trace2 call', {
                    target: intrinsicName ?? linked?.name ?? callee,
                    inline: linked?.shouldInline,
                    native: linked?.__native,
                    nargs,
                    nanId,
                    callback: cb?.name,
                    bytecodeLen: bytecodeFn?.bytecodeLen,
                    registerCount: bytecodeFn?.registerCount,
                    args: callArgs,
                })
            }
            if (intrinsicName) {
                const iargs: number[] = []
                for (let i = 0; i < nargs; i++) iargs.push(traceMem.get(regStart + i * 4))
                if (intrinsicName === 'callcontext') {
                    return tagCallResult(mk(NodeOp.callContext, []))
                }
                if (intrinsicName === 'load' && vmValue(iargs[2] as u32) === Types.fnptr) {
                    const loaded = memoryLoad(iargs[0], iargs[1], Types.fnptr)
                    let context = iargs[0]
                    if (symbolOf(iargs[1]) || vmValue(iargs[1] as u32) !== 0) {
                        context = mk(NodeOp.add, [iargs[0], iargs[1]], '', Types.usize)
                    }
                    return tagCallResult(mk(NodeOp.indirectTarget, [loaded, context]))
                }
                if (intrinsicName === 'typeof') {
                    const id = symbolOf(iargs[0])
                    const node = id ? getNode(runtime, id) : undefined
                    const T = entryTypes.get(id) ?? (node && gn.typeOf(node) === Types.f64 ? Types.f64 : undefined)
                    if (T !== undefined) return tagCallResult(traceValue(T))
                }
                if (intrinsicName === 'store') {
                    memoryStore(iargs[0], iargs[1], graphOperand(iargs[2]), vmValue(iargs[3] as u32))
                    return tagCallResult(0)
                }
                if (intrinsicName === 'rt') {
                    const op = vmValue(iargs[0] as u32)
                    if (heapOps.has(op)) return tagCallResult(heapOperation(op, iargs.slice(1)))
                    if (!bindingOf(op)?.impl) return tagCallResult(mk(NodeOp.rt, [nilEffect, ...iargs.map(graphOperand)]))
                    const value = mk(NodeOp.rt, [readToken(), ...iargs.map(graphOperand)])
                    writeToken(value)
                    return tagCallResult(value)
                }
                if (intrinsicName === 'pstack') {
                    const v = stackOperation(iargs[0], iargs[1], iargs[2])
                    return tagCallResult(v)
                }
                if (intrinsicName === 'static') {
                    return tagCallResult(Intrinsics.static(vmHandle(iargs[0] as u32)))
                }
                if (intrinsicName === 'load') {
                    const loaded = memoryLoad(iargs[0], iargs[1], vmValue(iargs[2] as u32))
                    return tagCallResult(loaded)
                }
                const result = (Intrinsics as any)[intrinsicName](...iargs.map(rawValue))
                return tagCallResult(traceValue(result))
            }
            const env = syncsFrame(linked) ? frameEnvironment() : undefined
            if (env) syncOut(env)
            const result = linked ? callLinked(linked, thisArg, regStart, nargs, env) : undefined
            let value = result?.value
            if (!result) {
                const calleeValue = intrinsics.getNanId(callee)
                    ? traceValue(callee)
                    : calleeHandle(objects.intern(target), calleeType(linked))
                const cargs = [readToken(), calleeValue, escapedValue(graphReceiver(thisArg))]
                for (let i = 0; i < nargs; i++) cargs.push(escapedArg(regStart, i))
                value = mk(NodeOp.call, cargs)
                writeToken(value)
                for (let i = 2; i < cargs.length; i++) syncEscaped(cargs[i])
            }
            if (env) syncIn(env)
            return tagCallResult(value)
        },
    }
    runtime.frames.push(traceFrame)
    tracer.setActive(true)
    defer finally {
        assert(runtime.frames.pop() === traceFrame)
        if (!runtime.frames.length) objects.release()
    }


    const shapeTrace = intrinsics.argv().includes(`shape-trace:${traceName}`)
    const rootId = addNode(runtime, NodeOp.block, [])
    let currentBlockId = rootId

    function showShapeValue(v: any): string {
        const id = symbolOf(v)
        if (!id) return `#${v}`
        const n = getNode(runtime, id)
        if (!n) return `%${id}`
        if (n.op === NodeOp.heapHandle && !getRef(n, 0)) return showShapeHandle(getLiteral(runtime, n, 0) as u32)
        const args: string[] = []
        for (let i = 0; i < countIds(n); i++) args.push(showShapeValue(operand(n, i)))
        return args.length ? `([s@${id}] ${opName(n.op)} ${args.join(' ')})` : `${opName(n.op)}@${id}`
    }

    function showShapeHandle(h: u32): string {
        const base = heap.isIndirect(h) ? heap.indirectTarget(h) : h
        const parts: string[] = []
        for (const key of dataKeys(base)) {
            const slot = slotOf(base, key)
            const inner = heap.isBoxedF64(slot) ? showShapeValue(heap.unboxF64(slot)) : `h${slot}`
            parts.push(`${heap.stringToJs(key)}: ${inner}`)
        }
        return `${heap.isIndirect(h) ? '&' : ''}obj${base}{ ${parts.join(', ')} }`
    }

    function dumpShapes(label: string, st: Float64Array): void {
        const seen = new Set<u32>()
        const parts: string[] = []
        for (let i = 0; i < st.length; i++) {
            const raw = cellOf(st[i])
            if (!raw) continue
            if (seen.has(raw)) continue
            seen.add(raw)
            const name = i === ACC ? 'acc' : i === TOKEN ? 'token' : `s${i}`
            parts.push(`${name}=${showShapeHandle(raw)}`)
        }
        if (parts.length) console.log(`  shape ${label} ${parts.join('  ')}`)
    }

    function runBlock(b: number, ins: Float64Array): Step {
        for (const pred of B.preds[b]) {
            assert(B.backPreds[b].includes(pred) || tracedBlocks.has(pred) || settled.has(pred),
                `trace2: B${b} entered before predecessor B${pred}`)
        }
        dispatches++
        noteTracedBlock(b, leaders[b], folding ? 'concrete loop' : 'entry')
        current = b
        if (shapeTrace) dumpShapes(`B${b} in `, ins)
        tracer.inactive(() => {
            for (let r = 0; r <= ACC; r++) traceMem.set(slotAddr(r), fromGraphValue(ins[r]))
            writeToken(ins[TOKEN])
            for (let i = 0; i < compiled.paramCount; i++) traceMem.set(args + i * 4, fromGraphValue(ins[i]))
        })
        if (debugTrace && b === 0) {
            console.log('trace frame input', {
                sp: sp(), args, frame, regsBase,
                inputIds: Array.from({ length: compiled.paramCount }, (_, i) => symbolOf(ins[i])),
                argIds: Array.from({ length: compiled.paramCount }, (_, i) => symbolOf(traceMem.get(args + i * 4))),
                regIds: Array.from({ length: compiled.paramCount }, (_, i) => symbolOf(traceMem.get(slotAddr(i)))),
                selectWrapped: Intrinsics.select !== tracer.saved.select,
            })
        }
        phase = B.liveIn[b].has(ACC) ? 0 : 1
        resumePc = leaders[b]
        injectedRet = false
        stopNext = false
        step = { kind: '', from: b, outs: emptyState, target: 0, condId: 0, thenPc: 0, elsePc: 0, valueId: 0, valueConst: 0 }
        const concrete = folding !== undefined || (!symbolOf(thisArg) && !watch(b))
        if (debugBlocks) {
            console.log(`run B${b} @${leaders[b]}: ${folding ? 'concrete loop' : concrete ? 'concrete' : 'symbolic'}`)
        }
        const saved = sp()
        tracer.setActive(!concrete)
        interpret(finalized, thisArg, args, compiled.paramCount as u32)
        tracer.setActive(false)
        sp(saved)
        const outs = new Float64Array(slotCount)
        for (let r = 0; r <= ACC; r++) outs[r] = toGraphValue(traceMem.get(slotAddr(r)))
        outs[TOKEN] = readToken()
        if (shapeTrace) dumpShapes(`B${b} out`, outs)
        if (debugTrace) {
            const show = (state: Float64Array) => Array.from(state, value => {
                const id = symbolOf(value)
                return id ? `v${id}` : value
            })
            console.log('trace block state', { block: b, in: show(ins), out: show(outs) })
        }
        step.from = current
        step.outs = outs
        return step
    }

    let dispatches = 0

    function reifyBlocks(): void {
        for (const b of B.order) {
            const deferredInterior = (h: number) => [...B.cycles[h]].some(m =>
                m !== h && (B.preds[m].length >= 2 || B.backPreds[m].length > 0))
            const exitsLoop = B.preds[b].some(p =>
                B.backPreds[p].length > 0 && !B.cycles[p].has(b) && deferredInterior(p))
            if (B.preds[b].length < 2 && !B.backPreds[b].length && !exitsLoop) continue
            reifyBlock(b)
        }
    }

    function reifyBlock(b: number): Reified {
        const known = reified.get(b)
        if (known) return known
        const inputs = [...B.liveIn[b]].sort((x, y) => x - y)
        const selfId = addNode(runtime, NodeOp.block, [])
        setDebugLabel(runtime, selfId, `B${b}`)
        const paramIds: number[] = []
        for (const slot of inputs) {
            if (slot === TOKEN) {
                paramIds.push(0)
                continue
            }
            const id = newSymbolId(tracer)
            setDebugLabel(runtime, id, slot === ACC ? 'acc' : `s${slot}`)
            putNode(runtime, id, NodeOp.param, [])
            regionalParams.add(id)
            paramIds.push(id)
        }
        const R: Reified = {
            header: b, inputs, selfId, paramIds, arrivals: [],
            symbolic: new Set(), heap: new Map(), extras: [], direct: false,
        }
        reified.set(b, R)
        runtime.applications.set(selfId, [])
        return R
    }

    function continuationFor(env: any): Continuation {
        assert(folding === undefined, `trace2: continuation for a call inside concrete loop B${current}`)
        const own = B.insts[current]
        const last = own[own.length - 1]
        assert(CallLikeOpcodes.has(last.opcode),
            `trace2: call in B${current} but the block ends in ${last.opname}`)
        const writesAcc = !!last.writesAcc
        const succs = B.succs[current]
        assert(succs.length === 1, `trace2: call block B${current} has ${succs.length} successors`)
        const target = succs[0]
        const back = B.backPreds[target].includes(current)
        assert(back || (!tracedBlocks.has(target) && !settled.has(target)),
            `trace2: continuation B${target} of B${current} was already traced`
            + ` (traced=${tracedBlocks.get(target)} settled=${settled.has(target)}`
            + ` preds=[${B.preds[target].join(',')}] [${traceName || '?'}])`)
        const from = current
        const saved = new Float64Array(slotCount)
        tracer.inactive(() => {
            for (let r = 0; r <= ACC; r++) saved[r] = toGraphValue(traceMem.get(slotAddr(r)))
        })
        const cont = ((value: any, token: any) => {
            assert(cont.multi || !cont.used,
                `trace2: single-use continuation B${target} of B${from} applied twice [${traceName || '?'}]`)
            cont.used = true
            if (cont.multi) reifyBlock(target)
            const ins = saved.slice()
            if (writesAcc) ins[ACC] = toGraphValue(value)
            if (env) {
                for (const r of captured.writes) {
                    token = mk(NodeOp.getProp, [token, env, traceValue(heap.indexKey(r as u32))])
                    ins[r] = token
                }
            }
            ins[TOKEN] = token
            return arrive(target, ins, from)
        }) as Continuation
        cont.target = target
        cont.multi = false
        cont.used = false
        return cont
    }

    function settleApplication(id: number, value: any): void {
        const target = symbolOf(value)
        assert(target, `trace2: application %${id} settles to a concrete value`)
        putCopy(runtime, id, nodeOf(target)!)
        const n = getNode(runtime, id)!
        const block = appliedBlock(n)
        if (block) addApplication(block, id)
    }

    function appliedBlock(n: Node): number {
        const tail = n.op === NodeOp.after ? getNode(runtime, getRef(n, countIds(n) - 1)) : n
        return tail?.op === NodeOp.apply ? getRef(tail, 0) : 0
    }

    function addApplication(block: number, id: number): void {
        const applies = runtime.applications.get(block)
        assert(applies, `trace2: %${id} applies %${block}, which is not a reified block`)
        if (!applies.includes(id)) applies.push(id)
    }

    function applyArgs(R: Reified, values: Float64Array, heapState: HeapState): any[] {
        const args = [symbolValue(R.selfId)]
        for (const slot of R.inputs) args.push(values[slot])
        for (const value of heapState.values()) args.push(value)
        if (!R.inputs.includes(TOKEN)) args.push(values[TOKEN])
        return args
    }

    function application(R: Reified, edge: Float64Array, from: number): any {
        const ins = edge // unrefine(edge, R.inputs)
        if (intrinsics.argv().includes('probe-heap')) {
            for (const slot of R.inputs) {
                if (sameValue(ins[slot], edge[slot])) continue
                const before = cellOf(edge[slot])
                const after = cellOf(ins[slot])
                if (before !== after) {
                    console.log(`PROBE unrefine -> B${R.header} from B${from} s${slot}: cell ${before} -> ${after}`)
                }
            }
        }
        const heapState = captureHeap(ins, R.inputs)
        const back = B.backPreds[R.header].includes(from)
        if (!back) assert(!tracedBlocks.has(R.header), `trace2: B${from} arrived after B${R.header} was traced`)
        if (back && R.arrivals.length) {
            const entry = R.arrivals[0]
            for (const slot of R.inputs) {
                const before = cellOf(entry.values[slot])
                const now = cellOf(ins[slot])
                if (!before || !now || before === now) continue
                throw `heap record: input s${slot} of B${R.header} changes identity across the back edge from B${from}`
            }
            for (const [cell, value] of heapState) {
                const incoming = entry.heap.get(cell)
                if (incoming !== undefined && !objects.sameShape(incoming, value)) throw `heap record: B${R.header} changes object shape across the back edge from B${from}`
            }
        }
        const args = applyArgs(R, ins, heapState)
        const apply = mk(NodeOp.apply, args)
        const applied = after(apply, ins[TOKEN])
        if (!back) R.arrivals.push({ from, values: ins.slice(), heap: heapState, apply: symbolOf(apply), synced: new Map(synced) })
        addApplication(R.selfId, symbolOf(applied))
        if (intrinsics.argv().includes('probe-heap')) {
            const shown = args.map(a => {
                const sid = symbolOf(a)
                const owner = paramOwner.get(sid)
                return owner === undefined ? `%${sid}` : `%${sid}@B${owner}`
            })
            console.log(`PROBE apply %${symbolOf(applied)} -> B${R.header} from B${from}: ${shown.join(' ')}`)
        }
        return applied
    }

    function captureHeap(ins: Float64Array, slots: number[]): HeapState {
        const receiver = cellOf(thisValue) || (!intrinsics.getNanId(thisValue) && isVmHandle(thisValue) ? vmHandle(thisValue) : 0)
        const roots: u32[] = receiver ? [receiver as u32] : []
        for (const slot of slots) {
            const cell = cellOf(ins[slot])
            if (cell) roots.push(cell)
        }
        return objects.capture(roots)
    }

    function cellOf(value: any): u32 {
        const n = getNode(runtime, symbolOf(value))
        if (!n || n.op !== NodeOp.heapHandle || getRef(n, 0)) return 0
        return getLiteral(runtime, n, 0) as u32
    }

    function returnedValue(value: any): any {
        if (!opts.inputs || !reified.size) return value
        const cell = cellOf(value)
        if (!cell) return value
        const state = objects.snapshot(cell as intrinsics.Handle)
        if (!state) return value
        return mk(NodeOp.heapHandle, [traceValue(cell), traceValue(state)])
    }

    function makeProxy(proto: u32): u32 {
        const getter = session.linkFunction(session.symbolicProxyGet) as intrinsics.Handle
        const setter = session.linkFunction(session.symbolicProxySet) as intrinsics.Handle
        return heap.makeProxy(getter, setter, proto as intrinsics.Handle) as u32
    }

    function opaqueObject(value: any): u32 {
        const id = symbolOf(value)
        const known = runtime.opaque.get(id)
        if (known !== undefined) return known
        const proxy = makeProxy(0 as u32)
        const cell = objects.intern(heap.makeObject(proxy as intrinsics.Handle)) as u32
        runtime.opaque.set(id, cell)
        runtime.proxied.set(proxy, { param: value, cell })
        return cell
    }

    function joinedObject(joined: Joined, g: number): u32 {
        const group = joined.groups[g]
        const known = runtime.groupObjects.get(group)
        if (known !== undefined) return known
        const proxy = makeProxy(heap.getPrototypeOf(heap.indirectTarget(group.members[0])) as u32)
        const obj = heap.makeObject(proxy as intrinsics.Handle) as u32
        runtime.groupObjects.set(group, obj)
        runtime.proxied.set(proxy, { joined, group: g })
        return obj
    }

    function unionObject(union: Union): u32 {
        if (union.object !== undefined) return union.object
        const proxy = makeProxy(0 as u32)
        union.object = heap.makeObject(proxy as intrinsics.Handle) as u32
        runtime.proxied.set(proxy, { union })
        return union.object
    }

    function unionRead(union: Union, key: intrinsics.Handle): any {
        const own = dataKeys(union.shape).includes(key as u32)
        if (own && !union.fields.includes(key as u32)) throw `trace2: reads object field ${heap.stringToJs(key)} through an object joined with an unknown value`
        if (!own && heap.getPropertyDescriptor(union.shape as intrinsics.Handle, key)) throw `trace2: reads inherited ${heap.stringToJs(key)} through an object joined with an unknown value`
        const unknown = mk(NodeOp.getProp, [readToken(), union.param, traceValue(key)])
        writeToken(unknown)
        const known = union.fields.includes(key as u32) ? mk(NodeOp.get, [union.record, traceValue(key)]) : handleValue(0)
        return mk(NodeOp.select, [mk(NodeOp.eq, [union.arm, traceValue(0)], '', Types.bool), known, unknown])
    }

    function shapeOfValue(value: any): u32 {
        const union = runtime.unions.get(symbolOf(value))
        if (union) return unionObject(union)
        const joined = objects.joinOf(value)
        if (joined) return joinedObject(joined, 0)
        return opaqueObject(value)
    }

    function proxyRead(target: Proxied, key: intrinsics.Handle): any {
        if (target.union) return unionRead(target.union, key)
        if (!target.joined) {
            const value = mk(NodeOp.getProp, [readToken(), target.param, traceValue(key)])
            writeToken(value)
            return value
        }
        const read = objects.readJoined(target.joined, target.group!, key)
        if (read.group !== undefined) return handleValue(joinedObject(target.joined, read.group))
        if (read.handle !== undefined) return handleValue(read.handle as u32)
        if (symbolOf(read.value)) return read.value
        return handleValue(traceCell(read.value))
    }

    function proxyWrite(target: Proxied, key: intrinsics.Handle, regStart: number): void {
        if (target.union) throw `trace2: writes ${heap.stringToJs(key)} through an object joined with an unknown value`
        if (!target.joined) {
            writeToken(mk(NodeOp.setProp, [readToken(), target.param, traceValue(key), escapedArg(regStart, 1)]))
            return
        }
        const value = vmHandle(traceMem.get(regStart + 4) as u32)
        assert(heap.isBoxedF64(value), 'trace2: structural write through a joined object')
        objects.writeJoined(target.joined, target.group!, key, heap.unboxF64(value))
    }

    function calleeHandle(cell: u32, type: gn.TypeOperand | undefined): any {
        const state = objects.snapshot(cell as intrinsics.Handle)
        return mk(NodeOp.heapHandle, state ? [traceValue(cell), traceValue(state)] : [traceValue(cell)], '', type)
    }

    function handleValue(handle: u32): any {
        const cell = objects.intern(handle) as u32
        if (cell !== handle) {
            const raw = tagVmHandle(handle)
            for (let r = 0; r <= ACC; r++) {
                if (traceMem.get(slotAddr(r)) === raw) traceMem.set(slotAddr(r), tagVmHandle(cell))
            }
        }
        handle = cell
        return mk(NodeOp.heapHandle, [traceValue(handle)])
    }

    function dataKeys(handle: u32): u32[] {
        const out: u32[] = []
        const count = heap.ownPropertyCount(handle)
        for (let i: u32 = 0; i < count; i++) {
            const key = heap.ownPropertyKeyAt(handle, i)
            if (!key) continue
            const descriptor = heap.getOwnProperty(handle, key)
            if (!descriptor) continue
            const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
            if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
            out.push(key)
        }
        return out
    }

    function slotOf(handle: u32, key: u32): u32 {
        const descriptor = heap.getOwnProperty(handle, key)
        if (!descriptor) return 0
        return heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor)).slot0 as u32
    }

    function regionalValue(id: number, seen = new Set<number>()): boolean {
        if (!id || seen.has(id)) return false
        seen.add(id)
        const n = nodeOf(id)
        if (!n) return false
        if (n.op === NodeOp.param) return regionalParams.has(id)
        if (n.op === NodeOp.heapHandle || n.op === NodeOp.block) return false
        for (let i = 0; i < countIds(n); i++) {
            if (regionalValue(getRef(n, i), seen)) return true
        }
        return false
    }

    function describeArrivals(R: Reified): string {
        const object = (cell: u32) => `cell ${cell} {${dataKeys(heap.indirectTarget(cell as intrinsics.Handle) as u32).map(k => heap.stringToJs(k as intrinsics.Handle)).join(', ')}}`
        const value = (v: any) => cellOf(v) ? `cell ${cellOf(v)}` : symbolOf(v) ? `%${symbolOf(v)}` : `${vmValue(v)}`
        const lines: string[] = []
        for (const a of R.arrivals) {
            const held = (cell: u32) => R.inputs.filter(slot => slot !== TOKEN && cellOf(a.values[slot]) === cell).map(slot => `s${slot}`)
            const objects = [...a.heap.keys()].map(cell => `${object(cell)}${held(cell).length ? ` in ${held(cell).join(', ')}` : ''}`)
            lines.push(`  from B${a.from}: ${objects.join('; ') || 'no objects'}`)
        }
        for (const slot of R.inputs) {
            if (slot === TOKEN) continue
            const values = R.arrivals.map(a => a.values[slot])
            if (values.every(v => sameValue(v, values[0]))) continue
            lines.push(`  s${slot} differs: ${R.arrivals.map((a, i) => `B${a.from}=${value(values[i])}`).join(', ')}`)
        }
        return lines.join('\n')
    }

    function joinUnknownObjects(R: Reified): Map<number, u32> {
        const found = new Map<number, u32>()
        for (const slot of R.inputs) {
            if (slot === TOKEN) continue
            const cells = R.arrivals.map(a => identityOf(a.values[slot]))
            if (cells.every(c => c) || !cells.some(c => c)) continue
            if (R.arrivals.some((a, i) => !cells[i] && !symbolOf(a.values[slot]))) continue
            const cell = cells.find(c => c)!
            if (cells.some(c => c && c !== cell)) throw `trace2: s${slot} of B${R.header} joins several objects with an unknown value\n${describeArrivals(R)}`
            found.set(slot, cell)
        }
        if (!found.size) return found
        if (B.backPreds[R.header].length) throw `trace2: B${R.header} joins an object with an unknown value around a loop\n${describeArrivals(R)}`
        const held = new Set(found.values())
        for (const a of R.arrivals) {
            for (const slot of R.inputs) {
                if (!found.has(slot) && held.has(cellOf(a.values[slot]))) throw `trace2: s${slot} of B${R.header} also holds an object that joins with an unknown value\n${describeArrivals(R)}`
            }
        }
        const records = new Map<number, number>()
        for (const a of R.arrivals) {
            for (const [slot, cell] of found) if (cellOf(a.values[slot]) === cell) records.set(slot, a.heap.get(cell)!)
        }
        for (const a of R.arrivals) {
            const extras: any[] = []
            for (const [slot, cell] of found) {
                const own = cellOf(a.values[slot]) === cell
                if (own) a.heap.delete(cell)
                const record = own ? records.get(slot)! : mk(NodeOp.record, fieldKeys(heap.indirectTarget(cell as intrinsics.Handle) as u32).flatMap(key => [traceValue(key), traceValue(0)]))
                extras.push(traceValue(own ? 0 : 1), record)
            }
            putCopy(runtime, a.apply, nodeOf(symbolOf(mk(NodeOp.apply, [...applyArgs(R, a.values, a.heap), ...extras], '', undefined, true)))!)
        }
        for (const [slot, cell] of found) {
            const arm = addNode(runtime, NodeOp.param, [])
            setDebugLabel(runtime, arm, `arm${slot}`)
            const record = objects.parameter(records.get(slot)!)
            R.extras.push(arm, record)
            const param = R.paramIds[R.inputs.indexOf(slot)]
            const shape = heap.indirectTarget(cell as intrinsics.Handle) as u32
            runtime.unions.set(param, {
                param: symbolValue(param),
                arm: symbolValue(arm),
                record: symbolValue(record),
                shape,
                fields: fieldKeys(shape),
            })
        }
        return found
    }

    function opaqueObjects(R: Reified): Set<number> {
        const found = new Set<number>()
        for (const slot of R.inputs) {
            if (slot === TOKEN) continue
            const cells = R.arrivals.map(a => identityOf(a.values[slot]))
            if (!cells.some(c => c) || cells.every(c => c === cells[0])) continue
            if (R.arrivals.some((a, i) => !cells[i] && symbolOf(a.values[slot]))) continue
            const states = R.arrivals.map((a, i) => a.heap.get(cells[i]))
            if (cells.every(c => c) && states.every(state => state !== undefined && objects.sameShape(states[0]!, state))) continue
            found.add(slot)
        }
        if (!found.size) return found
        for (const a of R.arrivals) {
            for (const slot of found) a.heap.delete(identityOf(a.values[slot]))
            putCopy(runtime, a.apply, nodeOf(symbolOf(mk(NodeOp.apply, applyArgs(R, a.values, a.heap), '', undefined, true)))!)
        }
        return found
    }

    function fieldKeys(target: u32): u32[] {
        return dataKeys(target).filter(key => heap.isBoxedF64(slotOf(target, key)))
    }

    function bindInputs(R: Reified): Float64Array {
        assert(!tracedBlocks.has(R.header) && R.arrivals.length > 0)
        synced = new Map()
        const first = R.arrivals[0]
        const ins = first.values.slice()
        const unions = joinUnknownObjects(R)
        for (const [slot] of unions) {
            R.symbolic.add(slot)
            ins[slot] = symbolValue(R.paramIds[R.inputs.indexOf(slot)])
        }
        const opaque = opaqueObjects(R)
        for (const slot of opaque) {
            R.symbolic.add(slot)
            ins[slot] = symbolValue(R.paramIds[R.inputs.indexOf(slot)])
        }
        for (const [cell, value] of first.heap) {
            const param = objects.parameter(value)
            paramOwner.set(param, R.header)
            if (intrinsics.argv().includes('probe-heap')) {
                console.log(`PROBE param %${param} created for B${R.header} cell=${cell}`)
            }
            setDebugLabel(runtime, param, `h${R.heap.size}`)
            regionalParams.add(param)
            R.heap.set(cell, { incoming: value, param, symbolic: B.backPreds[R.header].length > 0 })
        }
        for (const arrival of R.arrivals.slice(1)) {
            if (arrival.heap.size !== R.heap.size) throw `heap record: B${R.header} input changes object graph\n${describeArrivals(R)}`
            const edge = [...arrival.heap]
            const joined = new Map<u32, u32>()
            let at = 0
            for (const [cell] of R.heap) joined.set(cell, edge[at++][0])
            for (const slot of R.inputs) {
                if (unions.has(slot) || opaque.has(slot) || sameValue(ins[slot], arrival.values[slot])) continue
                const incoming = identityOf(ins[slot])
                const other = identityOf(arrival.values[slot])
                if (incoming && other) {
                    if (joined.get(incoming) === other) continue
                    throw `heap record: input s${slot} of B${R.header} cannot join cells ${incoming} (B${first.from}) and ${other} (B${arrival.from})`
                }
                if (incoming || other) throw `heap record: input s${slot} of B${R.header} changes identity`
                R.symbolic.add(slot)
            }
            at = 0
            for (const [cell, binding] of R.heap) {
                const [other, value] = edge[at++]
                if (!objects.sameShape(binding.incoming, value)) throw `heap record: B${R.header} input changes object shape`
                if (!sameValue(value, binding.incoming)) binding.symbolic = true
            }
        }

        let folds = false
        if (B.backPreds[R.header].length) {
            const reads = B.cycleReads[R.header]
            const effects = !!opts.foldEffects
            const concrete = (effects || !B.cycleWrites[R.header].has(TOKEN))
                && [...reads].every(slot => slot === TOKEN || (effects && (cellOf(ins[slot]) || stackPointer(ins[slot]))) || (!R.symbolic.has(slot) && !symbolOf(ins[slot])))
            if (concrete) {
                folds = true
                folding = B.cycles[R.header]
                if (effects) for (const [, binding] of R.heap) binding.symbolic = false
            } else {
                for (const slot of B.cycleWrites[R.header]) R.symbolic.add(slot)
            }
        }

        if (intrinsics.argv().includes(`bind-debug:${traceName}`)) {
            for (const [cell, binding] of R.heap) {
                const arrivals = R.arrivals.map(a => {
                    const v = [...a.heap.values()][[...R.heap.keys()].indexOf(cell)]
                    return `B${a.from}=%${symbolOf(v)}`
                })
                console.log(`BIND B${R.header} cell=${cell} symbolic=${binding.symbolic}`
                    + ` param=%${binding.param} incoming=%${symbolOf(binding.incoming)} arrivals=[${arrivals.join(' ')}]`
                    + ` backPreds=[${B.backPreds[R.header].join(',')}]`)
            }
            console.log(`BIND B${R.header} regs symbolic=[${[...R.symbolic].join(',')}] inputs=[${R.inputs.join(',')}]`)
        }
        const parameterized = R.inputs.some(slot => slot !== TOKEN && R.symbolic.has(slot) && !cellOf(ins[slot]))
            || [...R.heap.values()].some(binding => binding.symbolic)
        if (!folds) {
            for (const [r, value] of first.synced) {
                if (captured.writes.has(r) || R.symbolic.has(r) || !R.inputs.includes(r)) continue
                if (R.arrivals.every(a => sameValue(a.synced.get(r), value) && sameValue(value, toGraphValue(a.values[r])))) synced.set(r, value)
            }
        }
        R.direct = R.arrivals.length === 1 && (folds || !B.backPreds[R.header].length) && !parameterized
        if (!R.direct) {
            const entry = mk(NodeOp.nilEffect, [symbolValue(R.selfId)])
            if (!R.symbolic.has(TOKEN)) setFacts(entry, factsOf(ins[TOKEN]))
            ins[TOKEN] = entry
        }
        R.symbolic.delete(TOKEN)
        for (let i = 0; i < R.inputs.length; i++) {
            const slot = R.inputs[i]
            if (identityOf(ins[slot])) R.symbolic.delete(slot)
            if (R.symbolic.has(slot)) ins[slot] = symbolValue(R.paramIds[i])
        }
        for (const [cell, binding] of R.heap) {
            const value = binding.symbolic ? symbolValue(binding.param) : binding.incoming
            objects.install(cell, value, binding.incoming)
        }
        if (debugBlocks || opts.verbose) {
            console.log(`bind B${R.header}`, {
                predecessors: R.arrivals.map(a => a.from),
                backEdges: B.backPreds[R.header],
                direct: R.inputs.filter(slot => !R.symbolic.has(slot)),
                symbolic: R.inputs.filter(slot => R.symbolic.has(slot)),
                symbolicHeap: [...R.heap].filter(([, binding]) => binding.symbolic).map(([cell]) => cell),
                concreteLoop: !!folding,
            })
        }
        return ins
    }

    function isUnreachable(v: any) {
        const id = symbolOf(v)
        if (!id) return false
        return getNode(runtime, id)?.op === NodeOp.unreachable
    }

    function panic(v: any, token: any) {
        if (isTerminalValue(v)) return v
        return mk(NodeOp.panic, [after(v, token)])
    }

    function trap(code: any, token: any) {
        return mk(NodeOp.trap, [token, traceValue(code)])
    }

    function ret(v: any, tag = currentBlockId) {
        const id = symbolOf(v)
        const n = id ? getNode(runtime, id) : undefined
        if (n?.op === NodeOp.ret) return v
        if (n?.op === NodeOp.after) {
            const uid = getRef(n!, 1)
            const u = uid ? getNode(runtime, uid) : undefined
            if (u?.op === NodeOp.ret && getRef(n, 0)) {
                return ret(after(operand(u, 0), symbolValue(getRef(n, 0))), tag)
            }
        }
        return mk(NodeOp.ret, [v, symbolValue(tag)])
    }

    function inlined(v: any): any {
        const id = symbolOf(v)
        if (!id) return v
        const n = getNode(runtime, id)
        if (n?.op === NodeOp.ret) {
            const seen = new Set<number>()
            const pending = [getRef(n, 0)]
            let simple = true
            while (pending.length) {
                const id = pending.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const node = nodeOf(id)
                const op = node?.op
                if (op === NodeOp.inlined) continue
                if (op === NodeOp.apply || op === NodeOp.select || op === NodeOp.ret || op === NodeOp.join || op === NodeOp.trap) {
                    simple = false
                    break
                }
                if (node) for (const arg of getArgIds(node)) pending.push(arg)
            }
            if (simple) return operand(n, 0)
        }
        if (n?.op === NodeOp.panic) return v
        const handle = mk(NodeOp.inlined, [v, 0], '', undefined, true)
        const self = symbolOf(handle)
        gn.setLiteral(runtime, getNode(runtime, self)!, 1, self)
        return handle
    }

    function orderedValue(v: any): any {
        const n = getNode(runtime, symbolOf(v))
        return n?.op === NodeOp.after && !getRef(n, 1) ? operand(n, 1) : v
    }

    function selectValues(cond: any, a: any, b: any): any {
        const union = unionValues(a, b)
        if (union !== undefined) return union
        return mk(NodeOp.select, [cond, a, b])
    }

    function isTerminalValue(val: any) {
        const n = getNode(runtime, symbolOf(val))
        if (!n) return false
        return n.op === NodeOp.panic || n.op === NodeOp.trap || n.op == NodeOp.ret || n.op === NodeOp.unreachable
    }

    function unreachable() {
        return mk(NodeOp.unreachable, [])
    }

    function getOrderingFromInlined(val: any, incoming: any): any {
        const id = symbolOf(val)
        if (!id) return incoming
        if (sameValue(val, incoming)) return val
        const n = nodeOf(id)
        if (!n) return incoming
        if (n.op === NodeOp.select) {
            const rem: number[] = [operand(n, 0)]
            let changed = false
            for (let i = 1; i < countIds(n); i++) {
                const nv = getOrderingFromInlined(operand(n, i), incoming)
                rem.push(nv)
                if (!changed && symbolOf(nv) !== getRef(n, i)) {
                    changed = true
                }
            }
            if (!changed) return val
            if (rem.length === 3 && sameValue(rem[1], rem[2])) return rem[1]
            return mk(NodeOp.select, rem)
        }
        if (n.op === NodeOp.ret) {
            const x = getOrderingFromInlined(operand(n, 0), incoming)
            if (sameValue(x, nilEffect) || getNode(runtime, symbolOf(x))?.op === NodeOp.panic || isUnreachable(x)) return x
            return ret(x, getRef(n, 1))
        }
        if (n.op === NodeOp.inlined) {
            const x = getOrderingFromInlined(operand(n, 0), incoming)
            if (sameValue(x, nilEffect) || getNode(runtime, symbolOf(x))?.op === NodeOp.panic || isUnreachable(x)) return x
            return val // must preserve
        }
        if (n.op === NodeOp.after) {
            if (appliedBlock(n)) return val
            return getOrderingFromInlined(operand(n, 0), incoming)
        }
        if (n.op === NodeOp.join) {
            return getOrderingFromInlined(operand(n, countIds(n) - 1), incoming)
        }
        if (lowering2.OrderedValues.has(n.op)) return sameValue(operand(n, 0), nilEffect) ? incoming : val
        if (n.op === NodeOp.apply) return val
        if (n.op === NodeOp.unreachable) return val
        if (n.op === NodeOp.panic || n.op === NodeOp.trap) return unreachable()
        return incoming
    }

    function arrive(b: number, ins: Float64Array, from: number): f64 {
        const R = reified.get(b)
        if (!R) assert(!tracedBlocks.has(b), `trace: B${b} of ${traceName || '?'} arrives again from B${from} after it was traced without a reified entry (preds ${B.preds[b].join(',')})`)
        if (blockOrderOn) {
            const kind = R ? (tracedBlocks.has(b) ? 'back edge' : 'first arrival ') : 'trace  '
            const self = R ? `%${R.selfId}` : '%?'
            const src = reified.get(from)
            console.log(`${`${blockOrderStep++}`.padStart(3)} ${'  '.repeat(blockOrderDepth)}${kind} B${b} ${self} from B${from} ${src ? `%${src.selfId}` : '%?'}  [${traceName || '?'}]`)
        }
        return R ? application(R, ins, from) : tracePath(b, ins)
    }

    function tracePath(b: number, ins: Float64Array): f64 {
        const result = runBlock(b, ins)
        folding = undefined
        return finishStep(result)
    }

    function finishStep(r: Step): f64 {
        assert(r.kind)
        if (r.kind === 'panic') {
            const v = r.valueId ? symbolValue(r.valueId) : r.valueConst
            return panic(v, r.outs[TOKEN])
        }
        if (r.kind === 'trap') {
            return trap(r.valueConst, r.outs[TOKEN])
        }
        if (r.kind === 'inline-cont') {
            return r.valueId ? symbolValue(r.valueId) : r.valueConst as f64
        }
        if (r.kind === 'ret') {
            returned = true
            const v = r.valueId ? symbolValue(r.valueId) : r.valueConst
            returns.push(v)
            if (continuation && continuation.multi) return continuation(v, r.outs[TOKEN])
            // if (objects.shouldJoin()) return ret(objects.joinChanges(v, r.outs[TOKEN]))
            return ret(after(v, r.outs[TOKEN]))
        }
        if (r.kind === 'goto') return arrive(blockOf.get(r.target)!, r.outs, r.from)

        const branch = branchInputs(r)
        const marks = tracer.inactive(() => objects.mark())
        const depth = refinements.length
        const syncedAtBranch = synced
        synced = new Map(syncedAtBranch)
        refine(r.outs, branch[0])
        const a = arrive(blockOf.get(r.thenPc)!, branch[0], r.from)
        refinements.length = depth
        const thenChanges = tracer.inactive(() => objects.take(marks))
        synced = syncedAtBranch
        refine(r.outs, branch[1])
        const c = arrive(blockOf.get(r.elsePc)!, branch[1], r.from)
        synced = new Map()
        refinements.length = depth
        const elseChanges = tracer.inactive(() => objects.take(marks))
        if (intrinsics.argv().includes('probe-merge') && (thenChanges.size || elseChanges.size)) {
            const aDead = isTerminalValue(a) || isUnreachable(a)
            const cDead = isTerminalValue(c) || isUnreachable(c)
            if (aDead || cDead) {
                const which = aDead && cDead ? 'both arms' : aDead ? 'then arm' : 'else arm'
                const n = getNode(runtime, symbolOf(aDead ? a : c))
                console.log(`PROBE merge with dead ${which} (${opName(n?.op)}) [${traceName || '?'}]`
                    + ` thenChanges=${thenChanges.size} elseChanges=${elseChanges.size}`)
            }
        }
        tracer.inactive(() => objects.merge(symbolValue(r.condId), marks, thenChanges, elseChanges))

        if (debugTrace) {
            console.log('trace branch', {
                from: r.from, cond: r.condId, thenPc: r.thenPc, elsePc: r.elsePc,
                thenValue: symbolOf(a), elseValue: symbolOf(c),
            })
        }

        const cond = symbolValue(r.condId)
        return selectValues(cond, a, c)
    }

    function refine(before: Float64Array, after: Float64Array): void {
        if (before === after) return
        for (let i = 0; i < TOKEN; i++) {
            const id = symbolOf(before[i])
            if (!id || sameValue(before[i], after[i])) continue
            if (CompareOps.has(getNode(runtime, id)?.op ?? gn.maybeNodeOp(tracer.getTraceById(id)?.op ?? ''))) continue
            const valueId = symbolOf(after[i])
            refinements.push(i, id, valueId, valueId ? 0 : after[i])
        }
    }

    function unrefine(ins: Float64Array, slots: number[]): Float64Array {
        if (!refinements.length) return ins
        let out = ins
        for (const slot of slots) {
            const values = new Float64Array(1)
            values[0] = ins[slot]
            for (let i = refinements.length - 4; i >= 0; i -= 4) {
                if (refinements[i] !== slot) continue
                const valueId = symbolOf(values[0])
                const matches = valueId
                    ? refinements[i + 2] === valueId
                    : refinements[i + 2] === 0 && refinements[i + 3] === values[0]
                if (!matches) continue
                values[0] = symbolValue(refinements[i + 1])
            }
            if (sameValue(values[0], ins[slot])) continue
            if (out === ins) out = ins.slice()
            out[slot] = values[0]
        }
        return out
    }

    function branchInputs(r: Step): [Float64Array, Float64Array] {
        const ct = nodeOf(r.condId)
        const exactTrue = ct !== undefined && CompareOps.has(ct.op)

        let thenIn = r.outs
        if (exactTrue) thenIn = known(r.outs, r.condId, 1)
        else thenIn = knownValue(r.outs, r.condId, nonzeroOf(r.condId))
        let elseIn = known(r.outs, r.condId, 0)

        if (ct && (ct.op === NodeOp.eq || ct.op === NodeOp.ne)) {
            const z = againstZero(ct)
            if (z) {
                if (ct.op === NodeOp.eq) elseIn = knownValue(elseIn, z, nonzeroOf(z))
                else thenIn = knownValue(thenIn, z, nonzeroOf(z))
            }
        }
        if (ct && ct.op === NodeOp.eq) thenIn = intersectEqual(thenIn, ct)
        if (ct && ct.op === NodeOp.ne) elseIn = intersectEqual(elseIn, ct)
        return [thenIn, elseIn]
    }

    function unionValues(a: any, b: any): any | undefined {
        if (sameValue(a, b)) return a
        const an = nonzeroInput(a)
        if (an && (b === 0 || symbolOf(b) === an)) return symbolValue(an)
        const bn = nonzeroInput(b)
        if (bn && (a === 0 || symbolOf(a) === bn)) return symbolValue(bn)
    }

    function knownNonzero(id: number): boolean {
        return nodeOf(id)?.op === NodeOp.nonzero || stackPointer(symbolValue(id)) !== 0
    }

    function nonzeroInput(v: any): number {
        const n = getNode(runtime, symbolOf(v))
        return n?.op === NodeOp.nonzero ? getRef(n, 0) : 0
    }

    function intersectEqual(st: Float64Array, t: Node): Float64Array {
        const ia = getRef(t, 0)
        const ib = getRef(t, 1)
        if (ia && !ib) return knownValue(st, ia, traceValue(getLiteral(runtime, t, 1)))
        if (ib && !ia) return knownValue(st, ib, traceValue(getLiteral(runtime, t, 0)))
        // XXX: only valid after equality check
        if (ia && ib) {
            if (regionalValue(ia) && !regionalValue(ib)) {
                return knownValue(st, ia, symbolValue(ib) as any)
            }
            return knownValue(st, ib, symbolValue(ia) as any)
        }
        return st
    }

    function nonzeroOf(id: number): any {
        return mk(NodeOp.nonzero, [symbolValue(id)])
    }

    function againstZero(t: Node): number {
        const ia = getRef(t, 0)
        const ib = getRef(t, 1)
        if (ia && !ib && getLiteral(runtime, t, 1) === 0) return ia
        if (ib && !ia && getLiteral(runtime, t, 0) === 0) return ib
        return 0
    }

    function known(st: Float64Array, id: number, v: number): Float64Array {
        return knownValue(st, id, traceValue(v))
    }
    function knownValue(st: Float64Array, id: number, v: any): Float64Array {
        let hit = false
        for (let i = 0; i < TOKEN; i++) {
            if (symbolOf(st[i]) === id) { hit = true; break }
        }
        if (!hit) return st
        const out = new Float64Array(slotCount)
        for (let i = 0; i < TOKEN; i++) {
            out[i] = symbolOf(st[i]) === id ? v : st[i]
        }
        out[TOKEN] = st[TOKEN]
        return out
    }

    function heapOperation(op: RtOp, values: any[]): any {
        const cells = values.map(value => cellOf(value) || vmValue(value as u32))
        if (!cells.some(cell => intrinsics.getNanId(cell))) return handleValue(tracer.saved.rt(op, ...cells))
        const value = mk(NodeOp.rt, [readToken(), traceValue(op), ...values.map(v => escapedValue(toGraphValue(v)))])
        if (effectOps.has(op)) writeToken(value)
        return value
    }

    function graphOperand(value: any): any {
        return isVmHandle(value as u32) && !heap.isBoxedF64(vmHandle(value as u32)) ? mk(NodeOp.heapHandle, [traceValue(vmHandle(value as u32))]) : value
    }

    function sameValue(a: any, b: any): boolean {
        if (a === b) return true
        const ia = symbolOf(a)
        return ia !== 0 && ia === symbolOf(b)
    }


    const paramIds: number[] = []
    const presentBits = new Map<number, number>()
    const entryTypes = new Map<number, intrinsics.Types>()
    const numberParams = new Set<number>()
    let presence: any = 0
    const ins = new Float64Array(slotCount)
    for (let i = 0; i < compiled.paramCount; i++) {
        if (opts.inputs) {
            ins[i] = i < opts.inputs.args.length ? opts.inputs.args[i] as f64 : tagVmHandle(0) as f64
        } else {
            const id = newSymbolId(tracer)
            paramIds.push(id)
            setDebugLabel(runtime, id, `p${i}`)
            const T = opts.paramTypes?.get(i) === Types.f64 ? Types.f64 : Types.u64
            putNode(runtime, id, NodeOp.param, [], T)
            entryTypes.set(id, T)
            if (opts.paramTypes?.has(i)) numberParams.add(id)
            presentBits.set(id, i)
            ins[i] = symbolValue(id)
        }
    }
    if (receiverId) {
        paramIds.push(receiverId)
        setDebugLabel(runtime, receiverId, 'this')
        setNode(runtime, receiverId, gn.createThisParam(runtime))
    }
    if (!opts.inputs && compiled.defaults) {
        const id = newSymbolId(tracer)
        paramIds.push(id)
        setDebugLabel(runtime, id, 'present')
        putNode(runtime, id, NodeOp.param, [])
        presence = symbolValue(id)
    } else {
        presentBits.clear()
    }
    if (runtime.nilEffect === undefined) runtime.nilEffect = mk(NodeOp.nilEffect, [])
    nilEffect = runtime.nilEffect
    ins[ACC] = thisValue
    ins[TOKEN] = opts.inputs?.effect ?? mk(NodeOp.nilEffect, [symbolValue(rootId)])

    reifyBlocks()
    function doTrace() {
        try {
            if (debugBlocks) console.log('forward order:', B.order.map(b => `B${b}`).join(', '))
            const entry = arrive(0, ins, -1)
            for (const b of B.order) {
                settled.add(b)
                const R = reified.get(b)
                if (!R || !R.arrivals.length) continue
                currentBlockId = R.selfId
                const body = tracePath(R.header, bindInputs(R))
                if (R.direct) {
                    for (const id of runtime.applications.get(R.selfId)!) settleApplication(id, body)
                    continue
                }
                const argumentIndices: number[] = []
                const inputs: number[] = []
                const params: number[] = []
                for (let i = 0; i < R.inputs.length; i++) {
                    if (!R.symbolic.has(R.inputs[i])) continue
                    argumentIndices.push(i + 1)
                    inputs.push(R.inputs[i])
                    params.push(R.paramIds[i])
                }
                let i = 0
                for (const [, binding] of R.heap) {
                    if (binding.symbolic) {
                        argumentIndices.push(R.inputs.length + i + 1)
                        inputs.push(slotCount + i)
                        params.push(binding.param)
                    }
                    i++
                }
                const extrasAt = 1 + R.inputs.length + R.heap.size + (R.inputs.includes(TOKEN) ? 0 : 1)
                R.extras.forEach((param, k) => {
                    argumentIndices.push(extrasAt + k)
                    inputs.push(-1)
                    params.push(param)
                })
                runtime.blocks.set(R.selfId, { params, inputs, argumentIndices, body })
            }
            for (const R of reified.values()) assert(!R.arrivals.length || tracedBlocks.has(R.header), `trace2: missed B${R.header} in trace order`)
            return entry
        } catch (e) {
            console.log(code)
            console.log('\n--- registers ---\n')
            for (let i = 0; i < compiled.registerCount; i++) {
                const regName = i < compiled.paramCount ? `p${i}` : `r${i-compiled.paramCount}`
                const u = traceMem.get(slotAddr(i))
                const id = symbolOf(u)
                if (id) {
                    console.log(`  ${regName}: [symbolic ${id}]`, nodeOf(id) ?? 'param')
                } else {
                    console.log(`  ${regName}: ${u}`)
                }
            }
            console.log('\n--- --------- ---\n')
            console.log(bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount))
            const referencedSymbol = String(e.message ?? e).match(/symbolic property (?:store )?receiver (\d+)/)?.[1]
            if (referencedSymbol) {
                const id = Number(referencedSymbol)
                console.log(valToString(symbolValue(id)))
                console.log(`\n  symbolic ${id} -->\n`, getNode(runtime, id) ?? tracer.getTraceById(id) ?? 'param')
            }
            throw e
        }
    }

    const result = doTrace()
    sp(spBefore)

    let _lines: string
    function printLines() {
        if (_lines) return _lines
        const graph = buildGraph()
        const labels = new Map<number, string>()
        const refs = new Map<number, number>()
        const order: number[] = []
        const shared = new Map<number, string>()
        const rootBlock = graph.blocks[0]
        for (let i = 0; i < rootBlock.params.length; i++) labels.set(rootBlock.params[i], `p${i}`)
        for (const b of graph.blocks) {
            if (b.id === graph.root) continue
            const name = `B${b.id}`
            labels.set(b.id, name)
            for (let i = 0; i < b.params.length; i++) {
                const param = getDebugLabel(graph, b.params[i]) || `p${i}`
                labels.set(b.params[i], `${name}.${param}`)
            }
        }
        function survey(id: number): void {
            if (!id || labels.has(id)) return
            const n = getNode(graph, id)
            if (n?.op === NodeOp.block) {
                labels.set(id, `B${id}`)
                return
            }
            const count = (refs.get(id) ?? 0) + 1
            refs.set(id, count)
            if (count > 1) return
            if (!n) return
            for (const arg of getArgIds(n)) survey(arg)
            order.push(id)
        }
        for (const b of graph.blocks) survey(b.bodyId)
        let nextValue = 1
        for (const id of order) {
            if ((refs.get(id) ?? 0) > 1 && getNode(graph, id)!.op !== NodeOp.nilEffect) {
                shared.set(id, `V${nextValue++}`)
            }
        }
        let currentBlock: lowering2.GraphBlock | undefined
        function render(id: number, constant: any): string {
            if (!id) return String(constant)
            if (currentBlock?.params.includes(id)) {
                return expand(id)
            }
            return labels.get(id) ?? shared.get(id) ?? expand(id)
        }
        function expand(id: number): string {
            const n = getNode(graph, id)
            if (!n) return `?${id}`
            if (n.op === NodeOp.nilEffect) return 'nil'
            if (n.op === NodeOp.param) return getDebugLabel(graph, id) ?? `s${id}`
            const parts: string[] = [opName(n.op)]
            for (let i = 0; i < countIds(n); i++) {
                parts.push(render(getRef(n, i), getLiteral(graph, n, i)))
            }
            return `(${parts.join(', ')})`
        }
        const lines: string[] = []
        for (const id of order) {
            if (shared.has(id)) lines.push(`${shared.get(id)}: ${expand(id)}`)
        }
        for (const b of graph.blocks) {
            if (b.id === graph.root) continue
            currentBlock = b
            lines.push(`${labels.get(b.id)}(${b.params.map(id => expand(id)).join(', ')}) = ${render(b.bodyId, b.bodyConst)}`)
        }
        const entry = graph.blocks[0]
        currentBlock = entry
        lines.push(`= ${render(entry.bodyId, entry.bodyConst)}`)
        return _lines = lines.join('\n')
    }

    function buildGraph(): lowering2.Graph {
        const name = opts.name ?? (typeof input === 'function' ? input.name : undefined)
        const graph = createGraph({ ids: runtime.ids, literals: runtime.literals, root: rootId, debugLabels: runtime.debugLabels, name })
        const seen = new Set<number>()

        function resolve(id: number): number {
            for (;;) {
                const n = getNode(runtime, id)
                if (n && n.op === NodeOp.nonzero) { id = getRef(n, 0); continue }
                return id
            }
        }

        function visit(id0: number): number {
            const id = resolve(id0)
            if (!id || seen.has(id)) return id
            seen.add(id)
            const n = nodeOf(id)
            if (n) {
                if (n.op === NodeOp.block) {
                    const block = runtime.blocks.get(id)
                    if (block) {
                        const r = tail(block.body)
                        blocks.push({
                            id, params: block.params.slice(),
                            bodyId: r[0], bodyConst: r[1],
                        })
                    }
                }
                const indices = n.op === NodeOp.apply
                    ? [0, ...runtime.blocks.get(getRef(n, 0))!.argumentIndices]
                    : getArgIds(n).map((_, i) => i)
                const operands: Operand[] = []
                for (const i of indices) operands.push(visit(getRef(n, i)) || { literal: getLiteral(graph, n, i) })
                visit(typeRefOf(n))
                if (n.op === NodeOp.heapHandle && !getRef(n, 0) && heap.isIndirect(getLiteral(graph, n, 0) as u32) && !objects.isSealed(getLiteral(graph, n, 0) as intrinsics.Handle)) {
                    visitSlots((countIds(n) > 1 ? getLiteral(graph, n, 1) : heap.indirectTarget(getLiteral(graph, n, 0) as u32)) as u32)
                }
                putCopy(graph, id, n, operands)
                return id
            }
            return id
        }

        const seenCells = new Set<number>()
        function visitSlots(base: u32): void {
            if (seenCells.has(base)) return
            seenCells.add(base)
            for (const key of dataKeys(base)) {
                const slot = slotOf(base, key)
                if (heap.isBoxedF64(slot)) {
                    const id = heap.boxedNanId(slot)
                    if (!id) continue
                    const resolved = visit(id)
                    if (resolved !== id) heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(base, key))).slot0 = heap.boxSymbol(resolved)
                } else if (slot && heap.isIndirect(slot) && !objects.isSealed(slot as intrinsics.Handle)) {
                    visitSlots(heap.indirectTarget(slot) as u32)
                }
            }
        }

        function tail(v: any): number[] {
            const id = symbolOf(v)
            return id ? [visit(id), 0] : [0, vmValue(v as u32)]
        }

        const blocks: lowering2.GraphBlock[] = []
        const er = tail(result)
        blocks.unshift({ id: visit(rootId), params: paramIds, bodyId: er[0], bodyConst: er[1] })
        for (const b of blocks) for (const id of b.params) visit(id)
        if (intrinsics.argv().includes(`trace-blocks:${traceName}`)) {
            for (const b of blocks) {
                console.log('graph block', b.id, {
                    params: b.params,
                    bodyId: b.bodyId,
                    body: getNode(graph, b.bodyId),
                })
            }
        }
        setGraphBlocks(graph, blocks)
        recordSnapshots(graph)
        return graph
    }
    const selfTotal = performance.now() - selfStart
    statEntry.self += selfTotal - nestedElapsed
    nestedElapsed = outerNested + selfTotal

    let _graph: lowering2.Graph
    return {
        get graph() { return _graph ??= buildGraph() },
        get text() { return printLines() },
        frameProxy: heap.liveFrameProxy(frame) as u32 | undefined,
        frames: liveFrames(),
        envs,
        result,
        returned,
        returns,
        dispatches,
        session,
    }
}

if (intrinsics.argv()[0] === 'trace2') {
    function show(fn: Function, verbose = false, listing = false) {
        console.log(`--- ${fn.name} ---`)
        const r = trace2(fn, {
            verbose: verbose || intrinsics.argv().includes(`trace-blocks:${fn.name}`),
        })
        console.log(r.text)
        if (listing) {
            console.log(lowerValueGraph(r.graph, { debug: true }).listing)
        }
    }

    function nativeOf(fn: Function): any {
        return (native.createNatives({ [fn.name]: fn }) as any)[fn.name]
    }

    function listingOf(f: any): string {
        return f.units.map((u: any) => u.code.listing).join('\n')
    }

    function rootCode(f: any, name: string): any {
        const unit = f.units.find((u: any) => u.name === name)
        intrinsics.assert(unit, `trace2: no root unit ${name}`)
        return unit.code
    }

    function testSyscallLowering() {
        const syscall = intrinsics.makeSyscallFn(reify (a: u32, b: u32) => u32, 123)
        {
            function syscallTrace(a: u32, b: u32): u32 { return syscall(a, b) }
            const traced = trace2(syscallTrace)
            const lowered = lowerValueGraph(traced.graph)
            assert(lowered.listing.includes('svc #128'))
            assert(!lowered.listing.includes('blr '))
        }
        {
            function syscallTrace2(a: u32, b: u32): u32 { 
                return syscall(a+b, b+a) + a
            }
            const traced = trace2(syscallTrace2)
            const lowered = lowerValueGraph(traced.graph)
            console.log(lowered.listing)
        }
    }
    testSyscallLowering()

    function testMmapSyscall() {
        function mapConcrete(): usize {
            return syscalls.mmap(
                0, 4096,
                syscalls.PROT_READ | syscalls.PROT_WRITE,
                syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
                -1 as any, 0,
            )
        }
        const concreteTrace = trace2(mapConcrete)
        assert([...concreteTrace.graph.nodes.values()].some(n => n.op === NodeOp.call))
        function mapMemory(length: usize): usize {
            return syscalls.mmap(
                0, length,
                syscalls.PROT_READ | syscalls.PROT_WRITE,
                syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
                0, 0,
            )
        }
        function writeMemory(ptr: usize): u32 {
            Intrinsics.store(ptr, 0, 0x12345678, Types.u32)
            return 0
        }
        function readMemory(ptr: usize): u32 {
            return Intrinsics.load(ptr, 0, Types.u32)
        }
        function unmapMemory(ptr: usize, length: usize): u32 {
            return syscalls.munmap(ptr, length)
        }
        const memoryFns: any = native.createNatives({ mapMemory, writeMemory, readMemory, unmapMemory })
        const map = memoryFns.mapMemory
        const write = memoryFns.writeMemory
        const read = memoryFns.readMemory
        const unmap = memoryFns.unmapMemory
        assert(map.codePage === write.codePage)
        assert(map.codePage === read.codePage)
        assert(map.codePage === unmap.codePage)
        const length = 4096
        const ptr = map(length)
        write(ptr)
        assert(read(ptr) === 0x12345678)
        assert(unmap(ptr, length) === 0)
    }
    testMmapSyscall()

    function testSpecializedFactoryFn() {
        function factory(o?: { fn: (a: number) => number }) {
            function res(n: number) {
                let i = 0
                for (let j = 0; j < n; j++) i += n
                if (o !== undefined) {
                    return n + o.fn(2)
                }
                return n + i
            }
            return res
        }
        const f1 = factory()
        const f2 = factory({ fn: (a: number) => a+a })
        function caller(a: number, b: number) {
            return f1(a) + f2(b)
        }
        const fns = native.createNatives({ caller })
        assert(fns.caller(1, 2) === caller(1, 2))
        assert(fns.caller(2, 5) === caller(2, 5))

        function factoryWithAssert(o?: { fn: (a: number) => number }) {
            function test(n: number) {
                intrinsics.assert(o !== undefined)
                return o.fn(n)
            }
            intrinsics.tagNoInline(test)
            function res(n: number) {
                if (o) return test(n)
                return n + 1
            }
            return res
        }
        {
            const f1 = factoryWithAssert()
            const f2 = factoryWithAssert({ fn: (a: number) => a+a })
            function caller(a: number, b: number) {
                return f1(a) + f2(b)
            }
            const fns = native.createNatives({ caller })
            assert(fns.caller(1, 2) === caller(1, 2))
            assert(fns.caller(2, 5) === caller(2, 5))
        }
    }
    testSpecializedFactoryFn()
    
    function testStaticMemory() {
        function allocate(): usize {
            return syscalls.mmap(
                0, 4096,
                syscalls.PROT_READ | syscalls.PROT_WRITE,
                syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
                0, 0,
            )
        }
        const ptr = nativeOf(allocate)()
        const memory = symbolicMemory(ptr)
        function increment(): u32 {
            const next = Intrinsics.load(memory, 0, Types.u32) + 1
            Intrinsics.store(memory, 0, next, Types.u32)
            return next
        }
        function readInline(): u32 {
            return Intrinsics.load(memory, 0, Types.u32) as u32
        }
        intrinsics.tagInline(readInline)
        function readThroughConcreteCall(): u32 {
            return readInline() + 1
        }
        function release(): u32 {
            return syscalls.munmap(ptr, 4096)
        }
        const counter = nativeOf(increment)
        const free = nativeOf(release)
        assert(trace2(increment).graph.blocks[0].params.length === 0)
        assert(counter() === 1)
        assert(counter() === 2)
        const reader = nativeOf(readThroughConcreteCall)
        assert([...trace2(readThroughConcreteCall).graph.nodes.values()].some(n => n.op === NodeOp.load))
        assert(reader() === 3)
        assert(free() === 0)
    }
    testStaticMemory()

    function testArrayViews() {
        const OneByteArray = intrinsics.DefineStructView(reify u8[])
        function oneByte(s: usize) {
            const v = OneByteArray(s)
            return v[2]
        }
        const d1 = new Uint8Array([1,2,3,4,5])
        const d1Ptr = (ts as any).getArrayBufferPtr(d1.buffer)
        const nativeOneByte = nativeOf(oneByte)
        assert(nativeOneByte(d1Ptr) == d1[2])
        const FourByteArray = intrinsics.DefineStructView(reify u32[])
        function fourByte(s: usize) {
            const v = FourByteArray(s)
            v[4] = 99
            return v[3]
        }
        const d2 = new Uint32Array([1,2,3,4,5])
        const d2Ptr = (ts as any).getArrayBufferPtr(d2.buffer)
        const nativeFourByte = nativeOf(fourByte)
        assert(nativeFourByte(d2Ptr) == d2[3])
        assert(d2[4] == 99)
    }
    testArrayViews()

    function testIndirectCallContext() {
        function nestedCallee(): u32 {
            return 0
        }
        function indirectCallee(expected: usize): u32 {
            return Intrinsics.callcontext() === expected ? 1 : 0
        }
        function indirectCalleeAcrossCall(expected: usize, nestedSlot: usize): u32 {
            const fn = Intrinsics.load(nestedSlot, 0, Types.fnptr) as any
            fn()
            return Intrinsics.callcontext() === expected ? 1 : 0
        }
        function indirectCaller(slot: usize): u32 {
            const fn = Intrinsics.load(slot, 0, Types.fnptr) as any
            return fn(slot) + 1
        }
        function indirectOffsetCaller(base: usize): u32 {
            const fn = Intrinsics.load(base, 8, Types.fnptr) as any
            return fn(base + 8) + 1
        }
        function indirectCallerAcrossCall(slot: usize, nestedSlot: usize): u32 {
            const fn = Intrinsics.load(slot, 0, Types.fnptr) as any
            return fn(slot, nestedSlot) + 1
        }

        const callee = nativeOf(indirectCallee)
        const nested = nativeOf(nestedCallee)
        const across = nativeOf(indirectCalleeAcrossCall)
        const cell = new BigUint64Array(2)
        cell[0] = BigInt(callee.ptr)
        cell[1] = BigInt(callee.ptr)
        const nestedCell = new BigUint64Array(1)
        nestedCell[0] = BigInt(nested.ptr)
        const acrossCell = new BigUint64Array(1)
        acrossCell[0] = BigInt(across.ptr)
        const slot = Number((ts as any).getArrayBufferPtr(cell.buffer))
        const nestedSlot = Number((ts as any).getArrayBufferPtr(nestedCell.buffer))
        const acrossSlot = Number((ts as any).getArrayBufferPtr(acrossCell.buffer))
        const caller = nativeOf(indirectCaller)
        const offsetCaller = nativeOf(indirectOffsetCaller)
        const acrossCaller = nativeOf(indirectCallerAcrossCall)
        assert([...trace2(indirectCaller).graph.nodes.values()].some(n => n.op === NodeOp.indirectTarget))
        assert(listingOf(caller).includes('x15'))
        assert(caller(slot) === 2)
        assert(offsetCaller(slot) === 2)
        const acrossResult = acrossCaller(acrossSlot, nestedSlot)
        if (intrinsics.argv().includes('indirect-context')) {
            console.log(listingOf(across))
            console.log(listingOf(acrossCaller))
            console.log('indirect context across call', acrossResult)
        }
        assert(acrossResult === 2)

        type FnHolder = { c: u64, f: intrinsics.FnPtr<(a: u64, b: u64) => u64> }
        const FnHolder = intrinsics.DefineStructView(reify FnHolder)
        function f(a: u64, b: u64): u64 {
            const ctx = Intrinsics.callcontext()
            const c = Intrinsics.load(ctx, -8, Types.u64)
            return a + b + c
        }
        function f2(ref: usize): u64 {
            const v = FnHolder(ref)
            return v.f(1, 2)
        }
        const fNative = nativeOf(f)
        const f2Native = nativeOf(f2)
        if (intrinsics.argv().includes('indirect-context')) console.log(listingOf(f2Native))
        const cell2 = new BigUint64Array(2)
        cell2[0] = BigInt(3)
        cell2[1] = BigInt(fNative.ptr)
        assert(f2Native((ts as any).getArrayBufferPtr(cell2.buffer)) === 6)
    }
    testIndirectCallContext()

    function testPassedNativeValue() {
        type Unary = intrinsics.FnPtr<(value: u32) => u32>
        function callee(value: u32): u32 {
            return value + 7
        }
        function pass(fn: Unary, value: u32): u32 {
            if (!fn) throw 'unreachable'
            return fn(value)
        }
        function caller(value: u32): u32 {
            const holder = { fn: callee }
            return pass(holder.fn as any, value)
        }
        const result: any = native.createNatives({ caller, pass, callee })
        assert(result.caller(5) === 12)
    }
    testPassedNativeValue()

    function testPassedHeapValue() {
        const handle = heap.fromJsSymbol(Symbol('opaque'))
        const captured = heap.createHeapHandle(handle)
        function passHandle(value: intrinsics.Handle): intrinsics.Handle {
            return value
        }
        function capturedHandle(fn: intrinsics.FnPtr<(value: intrinsics.Handle) => intrinsics.Handle>): intrinsics.Handle {
            return fn(captured)
        }
        const handles: any = native.createNatives({ capturedHandle, passHandle })
        assert(handles.capturedHandle(handles.passHandle.ptr) === handle)

        interface Cell { value: u32 }
        const Cell = intrinsics.DefineStructView(reify Cell)
        function readCell(ptr: usize): u32 {
            return Cell(ptr).value
        }
        const result: any = native.createNatives({ readCell })
        const cell = new Uint32Array([37])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(result.readCell(ptr) === 37)
    }
    testPassedHeapValue()

    function testTrap() {
        function mayTrap(x: u32): u32 {
            if (x > 10) Intrinsics.trap(7)
            return (x + 1) as u32
        }
        const compiled: any = native.createNatives({ mayTrap })
        assert(compiled.mayTrap(5) === 6)
    }
    testTrap()

    function testErrorGlobal() {
        class Error {
            constructor(public readonly message: string) {}
        }
        function mightFail(x: u32): u32 {
            if (x > 10) throw new Error('too big')
            return (x + 1) as u32
        }
        const compiled: any = native.createNatives({ mightFail }, { globals: { Error } })
        assert(compiled.mightFail(5) === 6)
    }
    testErrorGlobal()

    function testStructViewAcrossBranch() {
        const View = intrinsics.DefineStructView(reify { x: u32 })
        function expensive(ptr: usize) {
            const x = View(ptr).x
            const z = ((x * x)+1)*x
            return (x + x) % z
        }
        intrinsics.tagNoInline(expensive)
        function viewHelper(ptr: usize) {
            if (expensive(ptr) > 99999) return View(0)
            return View(ptr)
        }
        intrinsics.tagNoInline(viewHelper)
        function f(ptr: usize) {
            if (View(ptr).x === 0) return 99
            const v = viewHelper(ptr)
            v.x = v.x + 1
            return v.x
        }
        const result: any = native.createNatives({ f })
        const cell = new Uint32Array([37])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(result.f(ptr) === 38)
        cell[0] = 0
        assert(result.f(ptr) === 99)
        function viewHelperInline(ptr: usize) {
            if (expensive(ptr) > 99999) return View(0)
            return View(ptr)
        }
        function f2(ptr: usize) {
            if (View(ptr).x === 0) return 99
            const v = viewHelperInline(ptr)
            v.x = v.x + 1
            return v.x
        }
        const result2: any = native.createNatives({ f2 })
        const cell2 = new Uint32Array([37])
        const ptr2 = (ts as any).getArrayBufferPtr(cell2.buffer)
        assert(result2.f2(ptr2) === 38)
        cell2[0] = 0
        assert(result2.f2(ptr2) === 99)
    }
    testStructViewAcrossBranch()

    function testCapturedTernaryObject() {
        type Self = { v: u32 }
        function defineBox(flag?: object) {
            const properties = Object.defineProperties({}, {
                value: {
                    get: intrinsics.tagInline(function(this: Self) { return this.v }),
                    set: intrinsics.tagInline(function(this: Self, v: u32) { this.v = v }),
                    enumerable: true,
                    configurable: true,
                },
            })
            const ternary = function(x: u32) {
                const v = flag !== undefined && x === 0 ? 1 : x
                return Object.setPrototypeOf({ v }, properties) as { value: u32 }
            }
            ternary.shouldInline = true
            return ternary
        }
        const Box = defineBox()
        function capturedTernary(n: u32): u32 {
            const b = Box(n)
            b.value = b.value + 1
            return b.value
        }
        const result: any = native.createNatives({ capturedTernary })
        assert(result.capturedTernary(10) === 11)
        assert(result.capturedTernary(0) === 1)

        const Box2 = defineBox(0 as any)
        function capturedTernary2(n: u32): u32 {
            const b = Box2(n)
            b.value = b.value + 1
            return b.value
        }
        const result2: any = native.createNatives({ capturedTernary2 })
        assert(result2.capturedTernary2(10) === 11)
        assert(result2.capturedTernary2(0) === 2)
    }
    testCapturedTernaryObject()

    function testObjectSpread() {
        function spread(value: u32): u32 {
            const source = { x: value, y: 2 as u32 }
            const result = { x: 1, ...(source as any), y: 3 as u32, ...{ z: value + 1 } }
            return result.x * 100 + result.y * 10 + result.z
        }
        const result: any = native.createNatives({ spread })
        assert(result.spread(4) === 435)
    }
    testObjectSpread()

    function testCapturedStringComparison() {
        const o = { x: 'aaa' }
        function f(a: u32): u32 {
            return o.x === 'aaa' ? a + 1 : a
        }
        const result: any = native.createNatives({ f })
        assert(result.f(41) === 42)
    }
    testCapturedStringComparison()

    function testNativeDetection() {
        assert(!intrinsics.isNative())
        function pick(a: u32): u32 {
            return intrinsics.isNative() ? a + 1 : a + 100
        }
        const result: any = native.createNatives({ pick })
        assert(result.pick(41) === 42)
        assert(pick(41) === 141)

        const isNative = intrinsics.isNative
        function pickCaptured(a: u32): u32 {
            return isNative() ? a + 1 : a + 100
        }
        const captured: any = native.createNatives({ pickCaptured })
        assert(captured.pickCaptured(41) === 42)
        assert(pickCaptured(41) === 141)
    }
    testNativeDetection()

    function testOptionalChaining() {
        const present = { x: 5 as u32 }
        const missing: { x: u32 } | undefined = undefined
        function optionalPresent(value: u32): u32 {
            return present?.x ? value + 1 : value
        }
        function optionalMissing(value: u32): u32 {
            return missing?.x ? value + 1 : value
        }
        const result: any = native.createNatives({ optionalPresent, optionalMissing })
        assert(result.optionalPresent(5) === 6)
        assert(result.optionalMissing(5) === 5)
    }
    testOptionalChaining()

    function testTupleReturn() {
        function tuple(a: number, b: number) {
            return [a, b]
        }
        intrinsics.tagNoInline(tuple)
        show(tuple)
        function tupleCaller(a: number, b: number) {
            const r = tuple(a, b)
            return r[0] + r[1]
        }
        const tupleResult = native.createNatives({ tupleCaller })
        assert(tupleResult.tupleCaller(1, 2) === tupleCaller(1, 2))
    }
    testTupleReturn()

    function testMaybeZero() {
        function maybeZero(flag: u32): u32 | undefined {
            if (flag) return 0
            return undefined
        }
        intrinsics.tagNoInline(maybeZero)
        show(maybeZero)

        function distinguishMaybeZero(flag: u32): u32 {
            const value = maybeZero(flag)
            return value === undefined ? 22 : 11
        }

        const result: any = native.createNatives({ distinguishMaybeZero, maybeZero })
        assert(result.distinguishMaybeZero(1) === 11)
        assert(result.distinguishMaybeZero(0) === 22)
    }
    testMaybeZero()

    function testMutatedHeapCellAfterLoop() {
        function v(x: number) {
            return x
        }
        intrinsics.tagNoInline(v)
        function mutate(c: { x: number }) {
            c.x += 1
        }
        intrinsics.tagInline(mutate)
        function withLoop(c: { x: number }, n: number) {
            let sum = 0
            for (let i = 0; i < n; i++) {
                sum += c.x
            }
            mutate(c)
            mutate(c)
            return sum + c.x + v(c.x)
        }
        intrinsics.tagInline(withLoop)
        function cellWithLoop(x: number, n: number) {
            const c = { x }
            if (n) withLoop(c, n)
            return c.x
        }
        const res = native.createNatives({ cellWithLoop })
        assert(res.cellWithLoop(2, 3) === cellWithLoop(2, 3))
    }
    testMutatedHeapCellAfterLoop()

    function testObjectJoins() {
        function joinedObject(flag: u32, value: u32): u32 {
            let o: { y: u32 }
            if (flag) o = { y: value + 1 }
            else o = { y: value + 2 }
            return o.y
        }
        const joined = nativeOf(joinedObject)
        assert(joined(1, 4) === 5)
        assert(joined(0, 4) === 6)

        function joinedObjectLoop(flag: u32, n: u32): u32 {
            let o: { y: u32 }
            if (flag) o = { y: 1 as u32 }
            else o = { y: 2 as u32 }
            for (let i: u32 = 0; i < n; i++) o.y = o.y + i
            return o.y
        }
        const loop = nativeOf(joinedObjectLoop)
        assert(loop(1, 3) === 4)
        assert(loop(0, 3) === 5)
        assert(loop(1, 0) === 1)

        const pick = function(flag: u32, value: u32) {
            if (flag) return { y: value }
            return { y: value + 10 }
        }
        pick.shouldInline = true
        function joinedWrite(flag: u32, value: u32): u32 {
            const o = pick(flag, value)
            o.y = o.y + 1
            return o.y
        }
        const write = nativeOf(joinedWrite)
        assert(write(1, 4) === 5)
        assert(write(0, 4) === 15)
    }
    testObjectJoins()

    function testObjectJoinAlias() {
        const choose = function(flag: u32, base: { y: u32 }) {
            if (flag) return base
            return { y: 100 as u32 }
        }
        choose.shouldInline = true
        function joinedAlias(flag: u32, value: u32): u32 {
            const base = { y: value }
            const o = choose(flag, base)
            o.y = o.y + 1
            return base.y
        }
        const alias = nativeOf(joinedAlias)
        assert(alias(1, 4) === 5)
        assert(alias(0, 4) === 4)
    }
    // testObjectJoinAlias()

    function testShapedCall() {
        function readY(o: { y: u32 }): u32 {
            return o.y + 1
        }
        (readY as any).shouldNotInline = true
        function callsReadY(flag: u32, value: u32): u32 {
            const o = { y: value }
            if (flag) o.y = value + 2
            return readY(o)
        }
        const shaped: any = native.createNatives({ callsReadY })
        assert(shaped.callsReadY(1, 4) === 7)
        assert(shaped.callsReadY(0, 4) === 5)

        const doubled = Object.defineProperties({}, {
            twice: {
                get: intrinsics.tagInline(function(this: { v: u32 }): u32 { return this.v * 2 }),
                enumerable: true,
                configurable: true,
            },
        })
        function readTwice(o: { twice: u32 }): u32 {
            return o.twice + 1
        }
        (readTwice as any).shouldNotInline = true
        function callsReadTwice(value: u32): u32 {
            const o = Object.setPrototypeOf({ v: value }, doubled) as { twice: u32 }
            return readTwice(o)
        }
        const accessor: any = native.createNatives({ callsReadTwice })
        assert(accessor.callsReadTwice(5) === 11)
    }
    testShapedCall()

    function testNestedFunctionCapture() {
        function countUp(n: u32): u32 {
            let next: u32 = 0
            function take(): u32 {
                const index = next++
                return index
            }
            let total: u32 = 0
            for (let i: u32 = 0; i < n; i++) total += take()
            return total * 10 + next
        }
        const compiled: any = native.createNatives({ countUp })
        assert(compiled.countUp(4) === 64)
    }
    testNestedFunctionCapture()

    function testTokenAfterLoop() {
        const Cell = intrinsics.DefineStructView(reify { value: u32 })
        function bump(ptr: usize): void {
            Cell(ptr).value = Cell(ptr).value + 1
        }
        intrinsics.tagNoInline(bump)
        const step = intrinsics.tagInline(function(i: u32): u32 { return i + 1 })
        function resetAfterLoop(ptr: usize, n: u32): u32 {
            const mark = Cell(ptr).value
            for (let i: u32 = 0; i < n; i = step(i)) bump(ptr)
            Cell(ptr).value = mark
            return Cell(ptr).value
        }
        const result: any = native.createNatives({ resetAfterLoop })
        const cell = new Uint32Array([5])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        const value = result.resetAfterLoop(ptr, 3)
        assert(value === 5)
        assert(cell[0] === 5)
    }
    testTokenAfterLoop()

    function testCapturedMapNative() {
        const x = new Map([[1, 1]])
        function capturedMapHas(key: u32): u32 {
            return x.has(key) ? 1 : 0
        }
        const session = createTraceSession()
        session.enterTrace()
        const graph = trace2(capturedMapHas, { session }).graph
        session.leaveTrace()
        assert(![...graph.nodes.values()].some(n => n.op === NodeOp.pstack || n.op === NodeOp.store),
            'trace2: a captured construction spills its contents into the trace that uses it')
        function capturedMapSet(key: u32): u32 {
            x.set(key, key)
            return 0
        }
        const compiled: any = native.createNatives({ capturedMapSet, capturedMapHas })
        assert(compiled.capturedMapHas(1) === 1, 'trace2: native lookup in a captured Map misses a present key')
        assert(compiled.capturedMapHas(2) === 0, 'trace2: native lookup in a captured Map finds an absent key')
        assert(compiled.capturedMapSet(5) === 0 && compiled.capturedMapHas(5) === 1, 'trace2: a write to a captured Map is not visible to a later native lookup')
    }
    testCapturedMapNative()

    {
        function readY(o: { y: u32 }): u32 {
            return o.y + 1
        }
        function callsReadY(flag: u32, value: u32): u32 {
            const o = { y: value }
            if (flag) o.y = value + 2
            return readY(o)
        }
        function callsReadYDirect(value: u32): u32 {
            const o = { y: value + 1 }
            o.y = o.y * 2
            return readY(o)
        }
        const fns = native.createNatives({
            callsReadY,
            callsReadYDirect,
        })
        assert(fns.callsReadY(0, 1) === callsReadY(0, 1))
        assert(fns.callsReadYDirect(1) === callsReadYDirect(1))
    }

    function testTraceBindings() {
        function constantArmLoop(flag: u32): u32 {
            let value = 2
            if (flag) value = 5
            for (let i = 0; i < 3; i++) value = (value + i) % 7
            return value as u32
        }
        const loop = nativeOf(constantArmLoop)
        assert(loop(0) === 5)
        assert(loop(1) === 1)

        function prunedJoin(flag: u32, value: u32): u32 {
            const fixed = 2
            let result = 0
            if (flag) result = value + 1
            else if (fixed + 5 !== 9) result = value + 2
            else if (value > 0) result = 6
            else result = 7
            return result * 3 as u32
        }
        const join = nativeOf(prunedJoin)
        assert(join(1, 4) === 15)
        assert(join(0, 4) === 18)

        function identicalComputedInputs(flag: u32, value: u32): u32 {
            let factor = 0
            if (flag) {
                for (let i = 0; i < 3; i++) factor += i
            } else {
                factor = 9
                for (let i = 0; i < 3; i++) factor -= 2
            }
            return (factor === 3 ? value : 0) as u32
        }
        const identical = trace2(identicalComputedInputs)
        assertOn(identical.text, () => {
            for (const b of identical.graph.blocks) if (b.id !== identical.graph.root) assert(b.params.length === 0)
            for (const n of identical.graph.nodes.values()) assert(n.op !== NodeOp.eq)
            const specialized = nativeOf(identicalComputedInputs)
            assertOn(listingOf(specialized), () => {
                assert(specialized(0, 17) === 17)
                assert(specialized(1, 23) === 23)
            })
        })

        function identicalForwardInputs(flag: u32, value: u32): u32 {
            let factor: number
            if (flag) {
                if (value) factor = 1
                else factor = 1
                factor *= 3
            } else {
                if (value) factor = 9
                else factor = 9
                factor -= 6
            }
            return (factor === 3 ? value : 0) as u32
        }
        const forward = trace2(identicalForwardInputs)
        for (const n of forward.graph.nodes.values()) assert(n.op !== NodeOp.eq)
        const joined = nativeOf(identicalForwardInputs)
        assert(joined(0, 17) === 17)
        assert(joined(1, 23) === 23)
        assert(joined(1, 0) === 0)

        function agreedLoopInputs(n: u32): u32 {
            let sum: u32 = 0
            for (let i: u32 = 0; i < n; i++) {
                let value: u32
                if (i & 1) value = i
                else value = i
                sum += value
            }
            return sum
        }
        const agreedLoop = trace2(agreedLoopInputs)
        assert(agreedLoop.graph.blocks.filter(b => b.id !== agreedLoop.graph.root && b.params.length > 0).length === 1)
        const agreedLoopNative = nativeOf(agreedLoopInputs)
        for (const n of [0, 1, 2, 7]) assert(agreedLoopNative(n) === agreedLoopInputs(n as u32))

        function agreedHeapInputs(flag: u32, value: u32): u32 {
            const box = { value }
            if (flag) box.value = value + 1
            else box.value = value + 1
            return box.value
        }
        const agreedHeap = trace2(agreedHeapInputs)
        for (const b of agreedHeap.graph.blocks) if (b.id !== agreedHeap.graph.root) assert(b.params.length === 0)
        const agreedHeapNative = nativeOf(agreedHeapInputs)
        assert(agreedHeapNative(0, 7) === 8)
        assert(agreedHeapNative(1, 19) === 20)

        function nestedJoinHeapWrite(cond: u32, cond2: u32, value: u32): u32 {
            const box = { x: 0 as u32 }
            if (cond) {
                const baz = value + 1
                const v = cond2 ? value * 2 : value * 3
                box.x = (v + baz) as u32
            }
            return box.x
        }
        const nestedJoin = nativeOf(nestedJoinHeapWrite)
        for (const c of [0, 1]) {
            for (const c2 of [0, 1]) {
                for (const v of [0, 3, 7]) {
                    const got = nestedJoin(c, c2, v)
                    const want = nestedJoinHeapWrite(c as u32, c2 as u32, v as u32)
                    if (got !== want) console.log(`nestedJoinHeapWrite(${c}, ${c2}, ${v}) got=${got} want=${want}`)
                    assert(got === want)
                }
            }
        }

        function singleJoinHeapWrite(cond: u32, value: u32): u32 {
            const box = { x: 0 as u32 }
            if (cond) box.x = (value + 1) as u32
            return box.x
        }
        const singleJoin = nativeOf(singleJoinHeapWrite)
        for (const c of [0, 1]) {
            for (const v of [0, 3]) assert(singleJoin(c, v) === singleJoinHeapWrite(c as u32, v as u32))
        }

        function hoistedSelectHeapWrite(cond: u32, cond2: u32, value: u32): u32 {
            const box = { x: 0 as u32 }
            const v = cond2 ? value * 2 : value * 3
            if (cond) box.x = (v + value + 1) as u32
            return box.x
        }
        const hoistedSelect = nativeOf(hoistedSelectHeapWrite)
        for (const c of [0, 1]) {
            for (const c2 of [0, 1]) assert(hoistedSelect(c, c2, 3) === hoistedSelectHeapWrite(c as u32, c2 as u32, 3 as u32))
        }

        function loopJoinHeapWrite(cond: u32, n: u32): u32 {
            const box = { x: 0 as u32 }
            if (cond) {
                let sum: u32 = 0
                for (let i: u32 = 0; i < n; i++) sum += i
                box.x = sum
            }
            return box.x
        }
        const loopJoin = nativeOf(loopJoinHeapWrite)
        for (const c of [0, 1]) {
            for (const n of [0, 1, 4]) assert(loopJoin(c, n) === loopJoinHeapWrite(c as u32, n as u32))
        }

        function writeLoop(ptr: usize, count: u32): void {
            for (let i = 0; i < count; i++) Intrinsics.store(ptr, 0, i + 1, Types.u32)
        }
        intrinsics.tagInline(writeLoop)
        function readAfterLoop(ptr: usize, count: u32): u32 {
            writeLoop(ptr, count)
            return Intrinsics.load(ptr, 0, Types.u32)
        }
        const read = nativeOf(readAfterLoop)
        const cell = new Uint32Array([91])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(read(ptr, 0) === 91)
        assert(read(ptr, 4) === 4)

        function reserve(ptr: usize, count: u32): u32 {
            const start = Intrinsics.load(ptr, 0, Types.u32)
            if (count === 0 || start + count > 16) return 0
            Intrinsics.store(ptr, 0, start + count, Types.u32)
            return start
        }
        const alloc = nativeOf(reserve)
        assert(alloc(ptr, 2) === 4)
        assert(cell[0] === 6)
        assert(alloc(ptr, 0) === 0)
        assert(alloc(ptr, 20) === 0)
        assert(cell[0] === 6)
        assert(alloc(ptr, 10) === 6)
        assert(cell[0] === 16 as any)
    }
    testTraceBindings()

    function testOrderingAcrossInlinedJoins() {
        function reserveCell(ptr: usize, count: u32): u32 {
            const start = Intrinsics.load(ptr, 0, Types.u32)
            Intrinsics.store(ptr, 0, start + count, Types.u32)
            return start
        }
        intrinsics.tagNoInline(reserveCell)
        function makeView(fallback?: () => u32) {
            return intrinsics.tagInline(function(value: u32) {
                if (fallback !== undefined && value === 0) value = fallback()
                return { value }
            })
        }
        const view = makeView()
        function reserveThree(ptr: usize, flag: u32): u32 {
            if (!flag) return 99
            const count = Intrinsics.load(ptr, 4, Types.u32)
            const a = view(reserveCell(ptr, count))
            const b = view(reserveCell(ptr, count))
            const c = view(reserveCell(ptr, count))
            return (a.value * 100 + b.value * 10 + c.value) as u32
        }
        const compiled = native.createNatives({ reserveThree })
        const cell = new Uint32Array([0, 2])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(compiled.reserveThree(ptr, 0) === 99)
        assert(cell[0] === 0)
        assert(cell[1] === 2)
        assert(compiled.reserveThree(ptr, 1) === 24)
        assert(cell[0] === 6 as u32)
    }
    testOrderingAcrossInlinedJoins()

    function testHeapCellCycles() {
        function compile(entry: any): any {
            const name = Object.keys(entry)[0]
            return (native.createNatives(entry) as any)[name]
        }

        function boxWrittenInLoop(n: u32): u32 {
            const box = { total: 0 as u32 }
            for (let i: u32 = 0; i < n; i++) box.total = box.total + i
            return box.total
        }
        const written = compile({ boxWrittenInLoop })
        for (const n of [0, 1, 4]) assert(written(n) === boxWrittenInLoop(n as u32))

        function viewFn(a: u32) {
            return { a }
        }
        function conditionalInit(n: u32, b: u32): u32 {
            let q = viewFn(n)
            if (n > 10) {
                q = viewFn(b)
            }
            return q.a
        }
        const test = native.createNatives({ f: conditionalInit })
        for (const n of [0, 1, 4, 11]) assert(test.f(n, 3) === conditionalInit(n as u32, 3))

        function boxDrivesLoop(n: u32): u32 {
            const box = { count: n, total: 0 as u32 }
            while (box.count !== 0) {
                box.total = box.total + box.count
                box.count = box.count - 1
            }
            return box.total
        }
        const driven = compile({ boxDrivesLoop })
        for (const n of [0, 1, 5]) assert(driven(n) === boxDrivesLoop(n as u32))

        function nestedBoxLoops(n: u32): u32 {
            const box = { total: 0 as u32 }
            for (let i: u32 = 0; i < n; i++) {
                for (let k: u32 = 0; k < i; k++) box.total = box.total + 1
            }
            return box.total
        }
        const nested = compile({ nestedBoxLoops })
        for (const n of [0, 1, 4]) assert(nested(n) === nestedBoxLoops(n as u32))

        function cellPerIteration(n: u32): u32 {
            let total: u32 = 0
            for (let i: u32 = 0; i < n; i++) {
                const box = { v: i }
                total = total + box.v
            }
            return total
        }
        const perIteration = compile({ cellPerIteration })
        for (const n of [0, 1, 4]) assert(perIteration(n) === cellPerIteration(n as u32))

        function joinedBoxLoop(flag: u32, n: u32): u32 {
            const a = { v: 1 as u32 }
            const b = { v: 2 as u32 }
            const o = flag ? a : b
            for (let i: u32 = 0; i < n; i++) o.v = o.v + 1
            return (a.v * 10 + b.v) as u32
        }
        function check(entry: any, args: number[][]) {
            const name = Object.keys(entry)[0]
            const fn = entry[name]
            const compiled = compile(entry)
            for (const a of args) assert(compiled(...a) === fn(...a))
            console.log(`heap cell ${name}: ok`)
        }

        check({ joinedBoxLoop }, [[0, 0], [0, 2], [1, 0], [1, 2]])

        function perIterationAlias(n: u32): u32 {
            const a = { v: 0 as u32 }
            const b = { v: 0 as u32 }
            for (let i: u32 = 0; i < n; i++) {
                const target = (i & 1) ? a : b
                target.v = target.v + 1
            }
            return (a.v * 10 + b.v) as u32
        }
        check({ perIterationAlias }, [[0], [1], [4]])

        function reassignedAcrossBackEdge(n: u32): u32 {
            const a = { v: 1 as u32 }
            const b = { v: 2 as u32 }
            let o = a
            for (let i: u32 = 0; i < n; i++) {
                o.v = o.v + 1
                o = b
            }
            return (a.v * 10 + b.v) as u32
        }
        check({ reassignedAcrossBackEdge }, [[0], [1], [3]])

        function nestedCellWrites(n: u32): u32 {
            const inner = { v: 0 as u32 }
            const outer = { inner, count: 0 as u32 }
            for (let i: u32 = 0; i < n; i++) {
                outer.inner.v = outer.inner.v + 1
                outer.count = outer.count + 1
            }
            return (outer.inner.v * 10 + outer.count) as u32
        }
        check({ nestedCellWrites }, [[0], [1], [3]])

        function worklistPair(n: u32): u32 {
            const work = { len: n }
            const out = { len: 0 as u32 }
            while (work.len !== 0) {
                work.len = work.len - 1
                out.len = out.len + 1
            }
            return out.len
        }
        check({ worklistPair }, [[0], [1], [5]])

        function armLoopWritesCell(flag: u32, n: u32): u32 {
            const box = { v: 0 as u32 }
            if (flag) {
                for (let i: u32 = 0; i < n; i++) box.v = box.v + i
            }
            return box.v
        }
        check({ armLoopWritesCell }, [[0, 3], [1, 0], [1, 3]])

        function armLoopWritesTwoCells(flag: u32, n: u32): u32 {
            const a = { v: 0 as u32 }
            const b = { v: 1 as u32 }
            if (flag) {
                for (let i: u32 = 0; i < n; i++) {
                    a.v = a.v + i
                    b.v = b.v + a.v
                }
            } else {
                a.v = 5
            }
            return (a.v * 100 + b.v) as u32
        }
        check({ armLoopWritesTwoCells }, [[0, 3], [1, 0], [1, 3]])

        function armLoopCellReadInLoop(flag: u32, n: u32): u32 {
            const box = { v: 1 as u32 }
            if (flag) {
                for (let i: u32 = 0; i < n; i++) box.v = box.v + i
            }
            let total: u32 = 0
            for (let k: u32 = 0; k < n; k++) total = total + box.v
            return total
        }
        check({ armLoopCellReadInLoop }, [[0, 3], [1, 0], [1, 3]])

        const readsCellInLoop = intrinsics.tagInline(function (box: { v: u32 }, n: u32): u32 {
            let total: u32 = 0
            for (let i: u32 = 0; i < n; i++) total = total + box.v
            return total
        })
        function outerLoopInlinedCellRead(n: u32): u32 {
            const box = { v: 2 as u32 }
            let total: u32 = 0
            for (let k: u32 = 0; k < n; k++) total = total + readsCellInLoop(box, n)
            return total
        }
        check({ outerLoopInlinedCellRead }, [[0], [1], [3]])

        const bumpsCellInLoop = intrinsics.tagInline(function (box: { v: u32 }, n: u32): u32 {
            for (let i: u32 = 0; i < n; i++) box.v = box.v + 1
            return box.v
        })
        function outerLoopInlinedCellWrite(n: u32): u32 {
            const box = { v: 1 as u32 }
            let total: u32 = 0
            for (let k: u32 = 0; k < n; k++) total = total + bumpsCellInLoop(box, n)
            return total
        }
        native.createNatives({ outerLoopInlinedCellWrite })
        check({ outerLoopInlinedCellWrite }, [[0], [1], [3]])

        const bumpCellOnce = intrinsics.tagInline(function (box: { v: u32 }, by: u32): u32 {
            box.v = box.v + by
            return box.v
        })
        function inlinedCellWriteNoLoop(n: u32): u32 {
            const box = { v: 1 as u32 }
            const first = bumpCellOnce(box, n)
            const second = bumpCellOnce(box, n)
            return (first * 100 + second * 10 + box.v) as u32
        }
        check({ inlinedCellWriteNoLoop }, [[0], [1], [3]])

        function escapesAfterJoin(flag: u32, value: u32): u32 {
            const a = { v: value }
            const b = { v: value + 1 }
            const o = flag ? a : b
            o.v = o.v + 10
            return (a.v * 100 + b.v) as u32
        }
        check({ escapesAfterJoin }, [[0, 3], [1, 3]])

        function earlyReturnWrite(flag: u32, value: u32): u32 {
            const box = { v: value }
            if (flag) {
                box.v = value + 5
                return (box.v * 2) as u32
            }
            return (box.v + 1) as u32
        }
        const earlyReturn = nativeOf(earlyReturnWrite)
        for (const flag of [0, 1]) assert(earlyReturn(flag, 4) === earlyReturnWrite(flag as u32, 4))
    }
    testHeapCellCycles()

    function testInlinedHeapCellMutation() {
        function repro(box: { p: usize }, key: u32): void {
            if (key === 7) return
            if (key >= 256) box.p = (box.p + 8) as usize
            Intrinsics.store(box.p, 8, key, Types.u32)
        }
        intrinsics.tagInline(repro)

        function twoBoxes(ptr: usize, n: u32): u32 {
            const a = { p: ptr }
            const b = { p: ptr }
            repro(a, n)
            repro(b, n + 1)
            return (Intrinsics.load(a.p, 0, Types.u32) + Intrinsics.load(b.p, 0, Types.u32)) as u32
        }
        const cases = native.createNatives({ twoBoxes })
        const cell = new Uint32Array([1,3,3,4,5,6,7,8])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(cases.twoBoxes(ptr, 5) === 2)
        assert(cases.twoBoxes(ptr, 6) === 2)
        assert(cases.twoBoxes(ptr, 7) === 2)
    }
    testInlinedHeapCellMutation()

    function testCallsAfterLoop() {
        const bumpCounter = intrinsics.tagNoInline(function bumpCounter(p: usize): u32 {
            Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 1, Types.u32)
            return 1
        })
        function armsCall(p: usize, n: u32): u32 {
            Intrinsics.store(p, 0, 0, Types.u32)
            let current = n
            while (current !== 0) {
                bumpCounter(p)
                current = current - 1
            }
            if (n > 5) bumpCounter(p)
            return Intrinsics.load(p, 0, Types.u32)
        }
        const compiled = native.createNatives({ armsCall })
        const cell = new Uint32Array([9, 9])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(compiled.armsCall(ptr, 0) === 0)
        assert(compiled.armsCall(ptr, 3) === 3)
        assert(compiled.armsCall(ptr, 7) === 8)
        assert(cell[0] === 8 as u32)
    }
    testCallsAfterLoop()

    function testInlinedMergeReturn() {
        const tagMergeReturn = intrinsics.tagInline(function tagMergeReturn(p: usize, key: u32): boolean {
            const n = Intrinsics.load(p, 0, Types.u32)
            if (key === 0) return false
            if (n !== 0) {
                Intrinsics.store(p, 4, key, Types.u32)
            }
            Intrinsics.store(p, 0, n + 1, Types.u32)
            return true
        })
        function spliceMergeReturn(p: usize, k: u32): u32 {
            Intrinsics.store(p, 0, 1, Types.u32)
            intrinsics.assert(tagMergeReturn(p, k))
            return Intrinsics.load(p, 0, Types.u32) * 10 + Intrinsics.load(p, 4, Types.u32)
        }
        const compiled = native.createNatives({ spliceMergeReturn })
        const cell = new Uint32Array([0, 0])
        const ptr = (ts as any).getArrayBufferPtr(cell.buffer)
        assert(compiled.spliceMergeReturn(ptr, 3) === 23)
        assert(cell[1] === 3 as u32)
    }
    testInlinedMergeReturn()

    let totalInst = 0
    process.on('beforeExit', () => console.log('TOTAL INST COUNT', totalInst))
    function testNativeFn(fn: Function, inputs: number[][], name: string = fn.name) {
        console.log(`=== compile ${name} ===`)
        const compiled: any = native.createNatives({ [name]: fn })
        let failed = false
        for (const args of inputs) {
            const expected = fn(...args)
            const actual = compiled[name](...args)
            const ok = actual === expected
            if (!ok) failed = true
            console.log(`  ${ok ? 'ok  ' : 'BAD '} ${name}(${args.join(', ')}) = ${actual}, expected ${expected}`)
        }
        if (failed) throw `trace2: ${name} does not agree with itself`
    }

    function testNativeCompile(fn: Function, inputs: number[][]) {
        const name = fn.name
        console.log(`=== compile ${name} ===`)
        const compiled = nativeOf(fn)
        const code = rootCode(compiled, name)
        console.log(`  ${code.words.length} instructions`)
        totalInst += code.words.length
        let failed = false
        for (const args of inputs) {
            const expected = fn(...args)
            const actual = compiled(...args)
            const ok = actual === expected
            if (!ok) failed = true
            console.log(`  ${ok ? 'ok  ' : 'BAD '} ${name}(${args.join(', ')}) = ${actual}, expected ${expected}`)
        }
        if (failed) {
            console.log(listingOf(compiled))
            throw `trace2: ${name} does not agree with itself`
        }
        return code
    }

    show(function linear(n: number) {
        const a = n * 3
        const b = a + 1
        return b - n
    })

    show(function folds() {
        let s = 0
        for (let i = 0; i < 10; i++) s += i
        return s * 2
    })

    show(function sameBranchedAssignment(n: number, a: any) {
        let x: number
        if (n > 0) {
            x = a
        } else {
            x = a
        }
        return x
    })

    show(function differentBranches(n: number, a: any) {
        let x: number
        if (n > 0) {
            x = a + 1
        } else {
            x = a
        }
        return x
    })

    show(function symbolicLoop(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) s = s + i
        return s
    })

    show(function infiniteSymbolicSwitch(f: any) {
        for (;;) {
            switch (f()) {
                case 0: return 0
                case 1: break
                default: break
            }
        }
    })

    show(function constantInterior(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) {
            s = s + i
            let d = 0
            for (let j = 0; j < 3; j++) d += j
            s += d
        }
        return s
    })

    show(function loopProjection(bar: any, m: number) {
        let j = m
        let x = 0
        while (j > 0) {
            j -= 1
            x += j
        }
        return bar(x)
    })

    show(function afterCall(f: any, a: any, b: any) {
        const m = a * b
        f(m, a)
        let c = 0
        let j = m
        while (j > 0) j -= 1
        if (m > 0) {
            f(m, a)
            return 1
        } else {
            c = 2
        }
        return c
    })

    show(function equalityCheck(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) {
            if (i === 5) {
                return i
            }
        }
        return s
    })


