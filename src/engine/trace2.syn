    testNativeCompile(function cSpillRotate(n: number, a: number, b: number, c: number) {
        let d = a + 7
        let e = b + 11
        const f = c + 13
        for (let i = 0; i < n; i++) {
            const saved = a
            a = b
            b = c
            c = d
            d = e
            e = saved
        }
        return a + b * 3 + c * 5 + d * 7 + e * 11 + f * 13
    }, [[0, 2, 3, 5], [1, 2, 3, 5], [2, 2, 3, 5], [5, 7, 11, 17], [6, 7, 11, 17], [19, 2, 3, 5]], 'cSpillRotate @2 regs', 2)

    testNativeCompile(function cSpillNested(n: number) {
