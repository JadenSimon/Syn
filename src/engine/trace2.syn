    function makeRandom(seed: number) {
        let s = (seed >>> 0) || 1
        return function next(n: number): number {
            s = (Math.imul(s, 1664525) + 1013904223) >>> 0
            return s % n
        }
    }

    function genSource(next: (n: number) => number, name: string, params: string[]): string {
        const lines: string[] = []
        let loops = 0
        function pad(d: number): string {
            let out = '    '
            for (let i = 0; i < d; i++) out += '    '
            return out
        }
        function expr(read: string[], d: number): string {
            const r = d >= 2 ? next(4) : next(10)
            if (r < 2) return read[next(read.length)]
            if (r < 4) return String(next(20))
            const a = expr(read, d + 1)
            const b = expr(read, d + 1)
            const k = next(4)
            if (k === 0) return `(${a} + ${b})`
            if (k === 1) return `((${a} * ${b}) % 10007)`
            if (k === 2) return `(${a} % (${b} + 1))`
            return `(${a} + ${b} * 3)`
        }
        const CmpText = ['<', '>', '<=', '>=', '===', '!==']
        function cond(read: string[]): string {
            return `${expr(read, 1)} ${CmpText[next(CmpText.length)]} ${expr(read, 1)}`
        }
        function block(read: string[], write: string[], d: number): void {
            const n = 1 + next(2)
            for (let i = 0; i < n; i++) {
                const r = d >= 1 ? next(5) : next(10)
                if (r < 4) {
                    lines.push(`${pad(d)}${write[next(write.length)]} = ${expr(read, 0)} % 10007`)
                } else if (r < 6) {
                    lines.push(`${pad(d)}if (${cond(read)}) {`)
                    block(read, write, d + 1)
                    lines.push(`${pad(d)}} else {`)
                    block(read, write, d + 1)
                    lines.push(`${pad(d)}}`)
                } else if (r < 8) {
                    const iv = `q${loops++}`
                    lines.push(`${pad(d)}for (let ${iv} = 0; ${iv} < ${1 + next(5)}; ${iv}++) {`)
                    block(read.concat([iv]), write, d + 1)
                    lines.push(`${pad(d)}}`)
                } else {
                    lines.push(`${pad(d)}return ${expr(read, 0)} % 10007`)
                }
            }
        }
        const write = ['s0', 's1'].concat(params)
        lines.push(`function ${name}(${params.join(', ')}) {`)
        lines.push(`    let s0 = 1`)
        lines.push(`    let s1 = 2`)
        block(params.concat(['s0', 's1']), write, 0)
        lines.push(`    return (s0 + s1) % 10007`)
        lines.push(`}`)
        return lines.join('\n')
    }

    function testGenerated(count: number, seed: number) {
        console.log(`=== generated (${count} programs, seed ${seed}) ===`)
        const next = makeRandom(seed)
        let checks = 0
        let failed = 0
        for (let k = 0; k < count; k++) {
            const params = ['a', 'b']
            const src = genSource(next, `gen${k}`, params)
            const fn = (new Function(`return ${src}`) as any)()
            const inputs: number[][] = []
            for (let t = 0; t < 4; t++) {
                const args: number[] = []
                for (let i = 0; i < params.length; i++) args.push(next(20))
                inputs.push(args)
            }
            let r: any
            try {
                r = trace2(src, { name: fn.name, verbose: intrinsics.argv().includes(`trace-blocks:${fn.name}`) })
            } catch (e) { console.log(src); throw e }
            for (const budget of [0, 1, 2, 3, 4]) {
                let l: any
                try {
                    l = lowerValueGraph(r.graph, { regBudget: budget ? budget : undefined })
                } catch (e) { console.log(src); throw e }
                const native = (ts as any).createNativeFn(new Uint8Array(l.bytes))
                let bad = false
                for (const args of inputs) {
                    const expected = fn(...args)
                    const actual = native(...args)
                    checks++
                    if (actual === expected) continue
                    if (!bad) {
                        bad = true
                        failed++
                        console.log(`  BAD  gen${k} @${budget || 'full'} (${args.join(', ')})`
                            + ` = ${actual}, expected ${expected}`)
                        if (failed <= 2) {
                            console.log(src)
                            if (intrinsics.argv().includes(`gen${k}`)) {
                                console.log(r.text)
                                console.log(lowerValueGraph(r.graph, {
                                    regBudget: budget ? budget : undefined,
                                    debug: true,
                                }).listing)
                            }
                            console.log(l.listing)
                        }
                    }
                }
            }
        }
        if (failed) throw `trace2: ${failed} generated programs disagree with themselves`
        console.log(`  ok   ${count} programs, ${checks} answers agree`)
    }

    if (intrinsics.argv().includes('generated')) {
        testGenerated(50, 64912)
        testGenerated(50, 61111)
        testGenerated(200, 12345)
        // TODO: add `seed: 12345 k: 149` as an ungated regression check for block packaging
    }

    testNativeCompile(function cSpillLoop(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) s = s + i * 3 + (i % 7)
        return s
    }, [[0], [1], [9], [40]], 'cSpillLoop', 9)

    testNativeCompile(function cSpillLoop2(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) s = s + i * 3 + (i % 7)
        return s
    }, [[0], [1], [9], [40]], 'cSpillLoop @4 regs', 4)

    testNativeCompile(function cSpillLoop3(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) s = s + i * 3 + (i % 7)
        return s
    }, [[0], [1], [9], [40]], 'cSpillLoop @2 regs', 2)

    testNativeCompile(function cSpillLoop4(n: number) {
        let s = 0
        for (let i = 0; i < n; i++) s = s + i * 3 + (i % 7)
        return s
    }, [[0], [1], [9], [40]], 'cSpillLoop @1 reg', 1)

    testNativeCompile(function cSpillNested(n: number) {
        let s = 0
        for (let i = 0; i < n; i = i + 1) {
            for (let j = 0; j < i; j = j + 1) {
                for (let k = 0; k < j; k = k + 1) s = s + k + i
            }
        }
        return s
    }, [[0], [1], [2], [4], [9]], 'cSpillNested @3 regs', 3)

    testNativeCompile(function cSpillBranch(n: number, a: number, b: number) {
        let x: number
        if (n > 0) x = a
        else x = b
        return x * 2 + 7
    }, [[1, 3, 4], [0, 3, 4], [6, 11, 13]], 'cSpillBranch @2 regs', 2)

    function countBlr(bytes: number[]): number {
        let n = 0
        for (let i = 0; i + 3 < bytes.length; i += 4) {
            const w = (bytes[i] as number) | ((bytes[i + 1] as number) << 8)
                | ((bytes[i + 2] as number) << 16) | ((bytes[i + 3] as number) << 24)
            if ((w & 0xFFFFFC1F) >>> 0 === 0xD63F0000 || (w & 0xFFFFFC1F) >>> 0 === 0xD61F0000) n++
        }
        return n
    }

    function nestedBranch(x: number): number {
        if (x > 10) return x - 3
        return x + 5
    }
    intrinsics.tagInline(nestedBranch)

    function nestedBranchCaller(x: number): number {
        return nestedBranch(x) * 2
    }

    function nestedLoop(n: number): number {
        let sum = 0
        for (let i = 0; i < n; i++) sum += i
        return sum
    }
    intrinsics.tagInline(nestedLoop)

    function nestedLoopCaller(n: number): number {
        return nestedLoop(n)
    }

    function nestedLoopValue(n: number): number {
        return nestedLoop(n) + 3
    }

    function createNative(fn: Function, regBudget?: number, session: TraceSession = createTraceSession()) {
        const debug = intrinsics.argv().includes(`trace-debug:${fn.name}`)
        const trace = trace2(fn, { session, verbose: debug })
        if (debug) {
            console.log(trace.text)
            console.log(lowering2.dumpGraph(trace.graph))
        }
        const graph = trace.graph
        const code = lowerValueGraph(trace.graph, { regBudget })
        if (debug) console.log(code.listing)
        const r = graph.params.length <= 5
            ? native.installNative(code.bytes)
            : (ts as any).createNativeFn(new Uint8Array(code.bytes))
        return { trace, graph, code, native: r }
    }

    function assertOn<T>(subject: T, cb: (subject: T) => void): T {
        try {
            cb(subject)
        } catch (e) {
            console.log(subject)
            throw e
        }
        return subject
    }

    function heapProxy(fn: any, idx: u32) {
        const bc = heap.FunctionBytecode(heap.resolveHeapCell(fn))
        const labels = heap.FunctionBytecodeLabels(heap.resolveHeapCell(bc.labels!))
        return Intrinsics.load(heap.resolveHeapCell(labels.jumpLabels), idx * 4, Types.u32)
    }
    createNative(heapProxy)

    function heapProxyLoop(l: any, fn: any, idx: u32) {
        const bc = heap.FunctionBytecode(heap.resolveHeapCell(fn))
        const labels = heap.FunctionBytecodeLabels(heap.resolveHeapCell(bc.labels!))
        for (;;) {
            switch (l()) {
                case 0: return Intrinsics.load(heap.resolveHeapCell(labels.jumpLabels), idx * 4, Types.u32)
            }
        }
    }
    console.log(createNative(heapProxyLoop).trace.text)

    {
        type TestShape = { owner: u32 }
        const TestShape = intrinsics.DefineStructView(reify TestShape)
        function inlinedFn(s: TestShape) {
            return s.owner
        }
        intrinsics.tagInline(inlinedFn)
        function structInLoop(f: () => usize) {
            let res: any
            while (!res) {
                const v = TestShape(f())
                if (v.owner === 3) continue
                res = inlinedFn(v)
            }
        }
        createNative(structInLoop)
    }


    if (intrinsics.argv().includes('interpret')) {
        const interpret = createInterpreter(true)
        const computation = intrinsics.getComputation(interpret)
        console.log(`=== trace interpret (${computation[1].length} captures) ===`)
        const result = createNative(interpret)
        console.log(result.trace.text)
        console.log(`${result.code.words.length} instructions`)
    }

    function testNative(fn: Function, cases: number[][], blrs: number = -1, name: string = fn.name, regBudget?: number) {
        console.log(`=== compile ${name} ===`)
        const { trace, graph, code, native } = createNative(fn, regBudget)
        console.log(trace.text)
        console.log(`  ${code.words.length} instructions`)
        totalInst += code.words.length
        let failed = false
        for (const c of cases) {
            const args = c.slice(0, c.length - 1)
            const expected = c[c.length - 1]
            const actual = native(...args)
            const ok = actual === expected
            if (!ok) failed = true
            console.log(`  ${ok ? 'ok  ' : 'BAD '} ${name}(${args.join(', ')}) = ${actual}, expected ${expected}`)
        }
        if (blrs >= 0) {
            const got = countBlr(code.bytes)
            const ok = got === blrs
            if (!ok) failed = true
            console.log(`  ${ok ? 'ok  ' : 'BAD '} ${name} makes ${got} calls, expected ${blrs}`)
        }
        if (failed) {
            console.log(code.listing)
            throw `trace2: ${name} does not agree with itself`
        }
        return code
    }

    {
        const accessorSession = createTraceSession()
        const trace = trace2(heap.typeDescriptorOf, { session: accessorSession })
        const code = lowerValueGraph(trace.graph)
        const readInlineCell = (ts as any).createNativeFn(new Uint8Array(code.bytes))
        const writeTrace = trace2(heap.setTypeDescriptorOf, { session: accessorSession })
        const writeCode = lowerValueGraph(writeTrace.graph)
        const writeInlineCell = (ts as any).createNativeFn(new Uint8Array(writeCode.bytes))
        assert(!code.listing.includes('blr'))
        assert(!writeCode.listing.includes('blr'))
        assert(writeCode.listing.includes('str w'))
        const inlineCellPtr = (ts as any).rawAlloc(4)
        defer { (ts as any).rawFree(inlineCellPtr) }
        writeInlineCell(inlineCellPtr, 0x12345678)
        assert(readInlineCell(inlineCellPtr) === 0x12345678)

        testNative(nestedBranchCaller, [[0, 10], [7, 24], [11, 16], [100, 194]], 0)
        testNative(nestedLoopCaller, [[0, 0], [1, 0], [5, 10], [20, 190]], 0)
        testNative(nestedLoopValue, [[0, 3], [1, 3], [5, 13], [20, 193]], 0)

        {
            const trace = trace2(heap.setPrototypeOf, { session: accessorSession })
            let calls = 0
            for (const n of trace.graph.nodes.values()) if (n.op === 'call') calls++
            assert(calls === 1)
        }

        {
            const accessorSession = createTraceSession()
            const trace = trace2(heap.getOwnProperty, { session: accessorSession })
            // const code = lowerValueGraph(trace.graph)
            // console.log('getOwnProperty', code.words.length)
            // assert(!code.listing.includes('csel'))
        }

        const repeatedAdd = testNative(function repeatedAdd(n: number, k: number) {
            let j = 0
            for (let i = 0; i < n; i++) j += k
            return j
        }, [[0, 7, 0], [1, 7, 7], [9, 7, 63], [100, 13, 1300]])
        assert(repeatedAdd.listing.includes('mul'))

        const sub2 = testNativeCompile(function cSub2(a: number, b: number) { return a - b },
            [[9, 2], [1, 1]])
        const addr = (ts as any).toNativePtrAddr((ts as any).createNativeFn(new Uint8Array(sub2.bytes)))

        const bitfield = testNativeCompile(function cBitfield(x: u32) {
            return (x >>> 16) & 0xFFFF
        }, [[0], [0x12345678], [0xFFFF0000]])
        assert(bitfield.listing.includes('ubfx'))

        const logicalImm = testNativeCompile(function cLogicalImmediate(x: u32) {
            return x & 0xFFFF
        }, [[0], [0x12345678], [0xFFFF0000]])
        assert(logicalImm.listing.includes('and') && logicalImm.listing.includes('#65535'))
        assert(!logicalImm.listing.includes('movz'))

        const shiftImm = testNativeCompile(function cShiftImmediate(x: u32) {
            return x >>> 16
        }, [[0], [0x12345678], [0xFFFF0000]])
        assert(shiftImm.listing.includes('lsr') && !shiftImm.listing.includes('lsrv'))

        const shiftedCompare = testNativeCompile(function cShiftedCompare(a: u32, b: u32): u32 {
            const result: any = a === (b >>> 16)
            return result * 1 as u32
        }, [[0x1234, 0x12345678], [0x5678, 0x12345678], [0, 0]])
        assert(shiftedCompare.listing.includes('cmp') && shiftedCompare.listing.includes('lsr #16'))
        assert(!shiftedCompare.listing.split('\n').some(line => line.trim().includes('lsr ') && !line.includes('cmp')))

        const doubleNot = testNativeCompile(function cDoubleNot(a: number, b: number) {
            const result: any = (a === b) === false
            return result * 1
        }, [[0, 0], [1, 0], [7, 7]])
        assert(doubleNot.listing.includes('cset') && doubleNot.listing.includes('ne'))

        testNativeCompile(function cLogicalNotThird(a: u32, b: u32, value: u32): u32 {
            return !value ? a : b
        }, [[11, 22, 0], [11, 22, 1]])

        function cConditionalPanic(cond: number, value: number) {
            let result = value
            if (cond) {
                result = 99
                Intrinsics.panic(result)
            }
            return result + 1
        }
        const panicTrace = trace2(cConditionalPanic)
        let panicId = 0
        for (const [id, n] of panicTrace.graph.nodes) {
            if (n.op !== 'panic') continue
            panicId = id
        }
        assert(panicId)
        for (const n of panicTrace.graph.nodes.values()) {
            if (n.argIds.includes(panicId)) assert(n.op === 'select')
        }
        testNativeCompile(cConditionalPanic, [[0, 4], [0, 20]])

        function cInlineAssert(value: u32): u32 {
            intrinsics.assert(value !== 0)
            return value + 1
        }
        show(cInlineAssert, true)
        const assertTrace = trace2(cInlineAssert)
        if (intrinsics.argv().includes('assert-inline')) {
            console.log('assert helper:', trace2(intrinsics.assert).text)
            console.log('assert caller:', assertTrace.text)
        }
        assert([...assertTrace.graph.nodes.values()].some(n => n.op === 'panic'))
        testNativeCompile(cInlineAssert, [[1], [20]])

        function cAssertRange(value: u32): u32 {
            intrinsics.assert(value > 1 && value < 10)
            return value + 1
        }
        assert(![...trace2(cAssertRange).graph.nodes.values()].some(n => n.op === 'call'))
        testNativeCompile(cAssertRange, [[2], [9]])

        function cAssertShortCircuit(value: u32, other: u32, fn: () => u32): u32 {
            intrinsics.assert(value > 0 && other > 0)
            return fn()
        }
        const shortAssert = trace2(cAssertShortCircuit)
        assert([...shortAssert.graph.nodes.values()].filter(n => n.op === 'call').length === 1)

        const rotated = testNativeCompile(function cRotateDoWhile(n: u32): u32 {
            let i: u32 = 0
            let sum: u32 = 0
            do {
                sum += i
                i++
            } while (i < n)
            return sum
        }, [[0], [1], [5]])
        console.log(rotated.listing)

        type StrengthView = { key: u32, value: u32 }
        const StrengthView = intrinsics.DefineStructView(reify StrengthView)
        function cStrengthReduce(ptr: usize, n: u32, key: u32): u32 {
            for (let i: u32 = 0; i < n; i++) {
                const value = StrengthView(ptr + i * 8)
                if (value.key === key) return value.value
            }
            throw 'unreachable'
        }
        const strength = createNative(cStrengthReduce)
        const strengthData = new Uint32Array([2, 20, 7, 70, 9, 90])
        const strengthPtr = (ts as any).getArrayBufferPtr(strengthData.buffer)
        assert(strength.native(strengthPtr, 3, 7) === 70)
        assert(strength.native(strengthPtr, 3, 9) === 90)
        assert(!strength.code.listing.includes('mul'))
        assert(!strength.code.listing.includes('lsl'))
        assert(strength.code.listing.includes('#8'))

        function cPointerInduction(ptr: usize, n: u32): u32 {
            let sum: u32 = 0
            for (let i: u32 = 0; i < n; i++) {
                sum += Intrinsics.load(ptr, i * 8, Types.u32) as u32
            }
            return sum
        }
        const inductionData = new Uint32Array([2, 0, 7, 0, 9, 0])
        const inductionPtr = (ts as any).getArrayBufferPtr(inductionData.buffer)
        const induction = createNative(cPointerInduction)
        assert(induction.native(inductionPtr, 0) === 0)
        assert(induction.native(inductionPtr, 1) === 2)
        assert(induction.native(inductionPtr, 3) === 18)
        const inductionLoop = induction.code.listing.indexOf('L')
        assert(inductionLoop >= 0)
        assert(induction.code.listing.indexOf('lsl') < inductionLoop)
        assert(!induction.code.listing.slice(inductionLoop).includes('lsl'))
        assert(induction.code.listing.slice(inductionLoop).includes('#8'))

        function loopUnreachableTail(n: number, f: () => number) {
            for (let i = 0; i < n; i++) {
                if (f() === 1) return 1
            }
            intrinsics.assert(false)
        }
        const unreachableTail = createNative(loopUnreachableTail)
        assertOn(unreachableTail.code.listing, listing => {
            assert(listing.split('cmp').length - 1 === 1)
            assert(!listing.includes('movz x0, #0'))
        })

        function cVoidStore(ptr: usize, x: u32): void {
            Intrinsics.store(ptr, 0, x, Types.u32)
        }
        const voidData = new Uint32Array([0, 0])
        const voidPtr = (ts as any).getArrayBufferPtr(voidData.buffer)
        const voidStore = createNative(cVoidStore)
        voidStore.native(voidPtr, 7)
        assert(voidData[0] === 7)
        assert(voidStore.code.listing.includes('str'))
        assert(!voidStore.code.listing.includes('movz x0'))

        function cVoidEarlyReturn(ptr: usize, x: u32): void {
            if (x === 0) return
            Intrinsics.store(ptr, 0, x, Types.u32)
        }
        const voidEarly = createNative(cVoidEarlyReturn)
        voidEarly.native(voidPtr + 4, 11)
        assert(voidData[1] === 11)
        voidEarly.native(voidPtr + 4, 0)
        assert(voidData[1] === 11)
        assert(!voidEarly.code.listing.includes('movz x0'))

        const cVoidArrowBody = (ptr: usize, x: u32) => { Intrinsics.store(ptr, 0, x, Types.u32) }
        const voidArrow = lowerValueGraph(trace2(cVoidArrowBody).graph)
        assert(voidArrow.listing === lowerValueGraph(trace2(cVoidStore).graph).listing)

        function cMixedVoidReturn(x: u32) {
            if (x === 1) return 1
        }
        const mixedVoid = createNative(cMixedVoidReturn)
        assert(mixedVoid.native(1) === 1)
        assert(mixedVoid.native(0) === 0)

        testNative(function cCallTwice(f: any, x: number) {
            const v1 = f(x, 2)
            return f(v1, 3)
        }, [[addr, 10, 5], [addr, 100, 95]], 2)

        testNative(function cSharedCall(f: any, x: number) {
            const v = f(x, 2)
            if (v === 0) return 0
            return v + v
        }, [[addr, 10, 16], [addr, 2, 0]], 1)

        testNative(function cRematerialize(f: any, x: number) {
            const y = x + 1
            return f(y, 2) + y + x
        }, [[addr, 10, 30], [addr, 1, 3]], 1)

        testNative(function cRematerializeLeaf(f: any, x: number) {
            const y = x + 1
            return f(y, 2) + y
        }, [[addr, 10, 20], [addr, 1, 2]], 1)

        testNative(function cRematerializeShared(f: any, x: number) {
            const y = x + 1
            const z = f(y, 2)
            return (z + y) + (z * y)
        }, [[addr, 10, 119], [addr, 1, 2]], 1)

        testNative(function cConditionalCall(f: any, n: number) {
            if (n > 0) f(n, 1)
            return f(n + 10, 2)
        }, [[addr, 5, 13], [addr, 0, 8]], 2)

        testNative(function cBranchedSameCall(f: any, cond: number) {
            if (cond) return f(10, 1)
            else return f(10, 1)
        }, [[addr, 1, 9], [addr, 0, 9]], 1)

        testNative(function cBranchedSameCallEffects(f: any, cond: number) {
            if (cond) return f(10, 1)
            f(10, 2)
            return f(10, 3)
        }, [[addr, 1, 9], [addr, 0, 7]], 2)

        testNative(function cBranchedSameCallEffectsNested(f: any, cond: number, cond2: number) {
            if (cond) return f(10, 1)
            if (cond2) f(10, 2)
            return f(10, 1)
        }, [[addr, 1, 0, 9], [addr, 0, 1, 9], [addr, 0, 0, 9]], 2)

        testNative(function cWithCall(f: any, x: number) {
            const a = x * 8
            const b = x * 2
            return f(a, b) + f(a, b)
        }, [[addr, 1, 12], [addr, 5, 60]], 2)

        testNative(function cCallCse(f: any, n: number) {
            if (n > 0) f((n * 5) + 5, 1)
            return f((n * 5) + 5, 2)
        }, [[addr, 1, 8], [addr, 0, 3]], 2)

        testNative(function cCallDce(f: any, cond: number) {
            if (cond) return f(10, 1)
            if (cond) f(10, 2)
            return f(10, 1)
        }, [[addr, 1, 9], [addr, 0, 9]], 1)

        testNative(function cRefinedEarlyExit(f: any, x: number) {
            if (x === 0) return 0
            return x ? f(x, 1) : 999
        }, [[addr, 0, 0], [addr, 7, 6]], 1)

        testNative(function cSpillCallInLoop(f: any, n: number) {
            let s = 100
            for (let i = 0; i < n; i++) s = f(s, i)
            return s
        }, [[addr, 0, 100], [addr, 1, 100], [addr, 5, 90]], 1, 'cSpillCallInLoop @1 reg', 1)

        const callInLoop = testNative(function cCallInLoop(f: any, n: number) {
            let s = 100
            for (let i = 0; i < n; i++) s = f(s, i)
            return s
        }, [[addr, 0, 100], [addr, 1, 100], [addr, 5, 90]], 1)
        console.log(callInLoop.listing)
        assert(!callInLoop.listing.includes('mov x0,'))

        testNative(function condEffects(f: any, x: number) {
            let r = 0
            if (x) {
                f()
                r = 1
            }
            return r
        }, [[addr, 0, 0], [addr, 1, 1]], 1)
        const memset = createNative(intrinsics.memsetByte)
        console.log(memset.code.listing)
        assert(memset.code.listing.includes('strb'))
        assert(memset.code.listing.includes('strh'))
        assert(memset.code.listing.includes('str w'))
        assert(memset.code.listing.includes('str x'))

        const readByte = createNative(function readByte(ptr: usize, offset: usize): u8 {
            return Intrinsics.load(ptr, offset, Types.u8)
        })

        const numBytes = 19
        const rawPtr = (ts as any).rawAlloc(numBytes)
        defer { (ts as any).rawFree(rawPtr) }
        memset.native(rawPtr, numBytes, 0xA5)
        for (const i of [0, 1, 7, 8, 18]) {
            assert(readByte.native(rawPtr, i) === 0xA5)
        }
        memset.native(rawPtr, numBytes, 0)
        for (const i of [0, 1, 7, 8, 18]) {
            assert(readByte.native(rawPtr, i) === 0)
        }
        {
            const pairWrite = createNative(function pairWrite(ptr: usize, a: usize, b: usize) {
                Intrinsics.store(ptr, 0, a, Types.u64)
                Intrinsics.store(ptr, 8, b, Types.u64)
            })
            const rawPtr = (ts as any).rawAlloc(16)
            defer { (ts as any).rawFree(rawPtr) }
            pairWrite.native(rawPtr, 100, 200)
            assert(readByte.native(rawPtr, 0) === 100)
            assert(readByte.native(rawPtr, 8) === 200)
        }
        {
            const unscaled = createNative(function unscaled(ptr: usize, value: u32): u32 {
                Intrinsics.store(ptr, 1, value, Types.u32)
                return Intrinsics.load(ptr, 1, Types.u32)
            })
            console.log(unscaled.code.listing)
            assert(unscaled.code.listing.includes('stur w'))
            assert(unscaled.code.listing.includes('ldur w'))
            const rawPtr = (ts as any).rawAlloc(8)
            defer { (ts as any).rawFree(rawPtr) }
            assert(unscaled.native(rawPtr, 0x12345678) === 0x12345678)
        }

        show(function x(cond: boolean, a: number, f: any) {
            const z = f(a)
            if (cond) return z
            return z > 1 ? z + a : z
        }, undefined, true)

        function nativeDependency(x: number): number {
            return x + 3
        }
        function nativeDependencyRoot(x: number): number {
            return nativeDependency(x) * 2
        }
        const linkedNative: any = native.createNative(nativeDependencyRoot)
        assert(linkedNative(7) === 20)

        const pooledValue = native.pool(0x12345678)
        function nativePooledValue(): usize {
            return pooledValue
        }
        const pooledNative: any = native.createNative(nativePooledValue)
        assert(pooledNative() === 0x12345678)
        assert(pooledNative.units[0].code.relocations.some((x: any) => x.kind === 'aarch64-pool'))

        function initLoadOrder(ptr: usize): void {
            Intrinsics.store(ptr, 0, 12, Types.u32)
            Intrinsics.store(ptr, 4, 7, Types.u32)
        }
        function readAcrossStore(ptr: usize): u32 {
            const first = Intrinsics.load(ptr, 0, Types.u32)
            Intrinsics.store(ptr, 0, 99, Types.u32)
            return first * 100 + Intrinsics.load(ptr, 4, Types.u32)
        }
        const loadOrderNative: any = native.createNatives({
            init: initLoadOrder,
            read: readAcrossStore,
        })
        const loadOrderMemory = (ts as any).rawAlloc(8)
        defer { (ts as any).rawFree(loadOrderMemory) }
        loadOrderNative.init(loadOrderMemory)
        assert(loadOrderNative.read(loadOrderMemory) === 1207)
        console.log('load/store ordering self-test passed')

        interface NestedView { value: u32 }
        const NestedView = intrinsics.DefineStructView(reify NestedView)
        function nestedViewAddress(ptr: usize): usize {
            return ptr
        }
        function inlineNestedView(ptr: usize): u32 {
            return NestedView(nestedViewAddress(ptr)).value
        }
        intrinsics.tagInline(inlineNestedView)
        function readNestedView(ptr: usize): u32 {
            return inlineNestedView(ptr)
        }
        function initNestedView(ptr: usize): void {
            Intrinsics.store(ptr, 0, 37, Types.u32)
        }
        const nestedViewNative: any = native.createNatives({
            init: initNestedView,
            read: readNestedView,
        })
        const nestedViewMemory = (ts as any).rawAlloc(4)
        defer { (ts as any).rawFree(nestedViewMemory) }
        nestedViewNative.init(nestedViewMemory)
        assert(nestedViewNative.read(nestedViewMemory) === 37)

        interface HandleView {
            scalar: u32
            handle: intrinsics.Handle
            optional?: intrinsics.Handle
        }
        const handleType = reify intrinsics.Handle
        // assert(handleType is Type.Object)
        assert((handleType as any).__handle === true)
        assert(Type.getBase(handleType) === reify u32)
        const HandleView = intrinsics.DefineStructView(reify HandleView)
        const handleViewMemory = Intrinsics.alloc(HandleView.sizeof)
        defer { Intrinsics.free(handleViewMemory) }
        const handleView = HandleView(handleViewMemory)
        handleView.scalar = 0xcccc
        handleView.handle = 0x1234 as intrinsics.Handle
        handleView.optional = 0x5678 as intrinsics.Handle
        assert(HandleView.enumerateSlots(handleViewMemory, 0) === 0x1234)
        assert(HandleView.enumerateSlots(handleViewMemory, 1) === 0x5678)
        assert(HandleView.enumerateSlots(handleViewMemory, 2) === 0)
        console.log('handle slot enumeration self-test passed')

        if (intrinsics.argv().includes('symbolic-view-select')) {
            interface SelectedView { value: u32 }
            const SelectedView = intrinsics.DefineStructView(reify SelectedView)
            function selectView(cond: boolean, a: usize, b: usize) {
                return cond ? SelectedView(a) : SelectedView(b)
            }
            intrinsics.tagInline(selectView)
            function readSelectedView(cond: boolean, a: usize, b: usize): u32 {
                return selectView(cond, a, b).value
            }
            // XXX: symbolic control cannot currently join struct-view identities
            createNative(readSelectedView)
        }

        interface AliasRoot {
            first: u64
            second: u64
        }
        interface AliasCell {
            value: u32
        }
        const AliasRoot = intrinsics.DefineStructView(reify AliasRoot)
        const AliasCell = intrinsics.DefineStructView(reify AliasCell)
        function initAliasViews(ptr: usize): void {
            const root = AliasRoot(ptr)
            root.first = ptr + 16
            root.second = ptr + 24
            AliasCell(ptr + 16).value = 12
            AliasCell(ptr + 24).value = 7
        }
        function readAliasViews(ptr: usize): u32 {
            const root = AliasRoot(ptr)
            const first = AliasCell(root.first as usize)
            const second = AliasCell(root.second as usize)
            return first.value * 100 + second.value
        }
        const aliasNative: any = native.createNatives({
            init: initAliasViews,
            read: readAliasViews,
        })
        const aliasMemory = (ts as any).rawAlloc(32)
        defer { (ts as any).rawFree(aliasMemory) }
        aliasNative.init(aliasMemory)
        assert(aliasNative.read(aliasMemory) === 1207)
        console.log('struct view alias self-test passed')
    }
}
