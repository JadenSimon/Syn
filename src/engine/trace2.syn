    if (intrinsics.argv().includes('shape-tests')) {
        function shapeCase(fn: Function, inputs: number[][]) {
            let c: any
            try {
                c = createNative(fn)
            } catch (e: any) {
                console.log(`  SHAPE ${fn.name.padEnd(18)} NOCOMPILE  ${`${e}`.split('\n')[0]}`)
                if (intrinsics.argv().includes('shape-why')) {
                    console.log(lowering2.dumpGraph(trace2(fn as any).graph))
                }
                return
            }
            const bad: string[] = []
            for (const args of inputs) {
                const want = fn(...args)
                const got = c.native(...args)
                if (got !== want) bad.push(`(${args.join(',')}) want ${want} got ${got}`)
            }
            console.log(`  SHAPE ${fn.name.padEnd(18)} ${bad.length ? 'WRONG      ' + bad.join('  ') : 'ok'}`)
            if (bad.length && intrinsics.argv().includes('shape-why')) console.log(c.trace.text)
        }

        console.log('=== shape analysis cases ===')
        if (intrinsics.argv().includes('shape-dis')) {
            show(function sObjBranchNoLoop(n: number) {
                const o = { a: n }
                if (n > 2) o.a = o.a + 8
                return o.a
            }, true)
        }

        shapeCase(function sObjReadLoop(n: number) {
            const o = { a: n }
            let total = 0
            for (let i = 0; i < n; i++) total += o.a
            return total
        }, [[0], [1], [5]])

        shapeCase(function sObjLeafLoop(n: number) {
            const o = { a: n }
            let total = 0
            for (let i = 0; i < n; i++) {
                o.a = o.a + 1
                total += o.a
            }
            return total
        }, [[0], [1], [5]])

        shapeCase(function sObjLeafBranch(n: number) {
            const o = { a: n }
            let total = 0
            for (let i = 0; i < n; i++) {
                if ((i & 1) !== 0) o.a = o.a + 8
                total += o.a
            }
            return total
        }, [[0], [1], [5], [6]])

        shapeCase(function sObjTwoLeaves(n: number) {
            const o = { a: n, b: 1 }
            let total = 0
            for (let i = 0; i < n; i++) {
                o.a = o.a + i
                o.b = o.b + 1
                total += o.a + o.b
            }
            return total
        }, [[0], [1], [5]])

        shapeCase(function sObjShapeMerge(n: number) {
            const o = { a: n } as any
            if (n > 5) o.b = n * 2
            return o.a + (o.b === undefined ? 0 : o.b)
        }, [[0], [3], [6], [10]])

        shapeCase(function sObjShapeMerge2(n: number) {
            const o = { a: n } as any
            if (n > 5) o.b = n * 2
            if (n < 5) o.c = n * 3
            return o.a + (!o.b ? o.c : o.b)
        }, [[0], [3], [6], [10]])

        shapeCase(function sObjShapeMergeBoth(n: number) {
            const o = { a: n } as any
            if (n > 5) o.b = n * 2
            else o.b = n + 1
            return o.a + o.b
        }, [[0], [3], [6], [10]])

        shapeCase(function sObjAliasSymMerge(n: number) {
            const o = { a: n } as any
            const o2 = o
            if (n > 5) o.a = n * 3
            return (o === o2 ? 1 : 0) * o2.a
        }, [[0], [3], [6], [10]])

        shapeCase(function sObjTwoBranchKeys(n: number) {
            const o = { a: n } as any
            if (n > 5) o.b = n * 2
            if (n < 5) o.c = n * 3
            return o.a + (!o.b ? o.c : o.b)
        }, [[0], [3], [6], [10]])

        shapeCase(function sObjLeafNoLoop(n: number) {
            const o = { a: n }
            o.a = o.a + 1
            return o.a
        }, [[0], [3]])

        shapeCase(function sObjBranchNoLoop(n: number) {
            const o = { a: n }
            if (n > 2) o.a = o.a + 8
            return o.a
        }, [[0], [3]])
    }

