                m2 = m2 + (j ^ 2)
                m3 = m3 + (j ^ 3)
                m4 = m4 + (j ^ 4)
                m5 = m5 + (j ^ 5)
                m6 = m6 + (j ^ 6)
                m7 = m7 + (j ^ 7)
                m8 = m8 + (j ^ 8)
                for (let k = 0; k < j; k = k + 1) {
                    t0 = t0 + (k ^ 0)
                    t1 = t1 + (k ^ 1)
                    t2 = t2 + (k ^ 2)
                    t3 = t3 + (k ^ 3)
                    t4 = t4 + (k ^ 4)
                    t5 = t5 + (k ^ 5)
                    t6 = t6 + (k ^ 6)
                    t7 = t7 + (k ^ 7)
                    t8 = t8 + (k ^ 8)
                }
            }
        }
        return o0 + o1 * 3 + o2 * 4 + o3 * 5 + o4 * 6 + o5 * 7 + o6 * 8 + o7 * 2 + o8 * 3 + m0 * 4 + m1 * 5 + m2 * 6 + m3 * 7 + m4 * 8 + m5 * 2 + m6 * 3 + m7 * 4 + m8 * 5 + t0 * 6 + t1 * 7 + t2 * 8 + t3 * 2 + t4 * 3 + t5 * 4 + t6 * 5 + t7 * 6 + t8 * 7
    }, [[0], [1], [2], [4], [9]])

