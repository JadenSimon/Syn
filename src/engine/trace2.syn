        let t1 = 19
        let t2 = 20
        let t3 = 21
        let t4 = 22
        let t5 = 23
        let t6 = 24
        let t7 = 25
        let t8 = 26
        for (let i = 0; i < n; i = i + 1) {
            o0 = o0 + (i ^ 0)
            o1 = o1 + (i ^ 1)
            o2 = o2 + (i ^ 2)
            o3 = o3 + (i ^ 3)
            o4 = o4 + (i ^ 4)
