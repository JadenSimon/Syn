            const type = partial ? { ...merged, undefined: true } : merged
            if (partial) absent.add(k)
            if (merged.undefined) nullish.add(k)
            const buffers = [...new Set([...type.objects].filter(id => owners[id] !== undefined && !genericFor(id)))]
            if (buffers.length && buffers.length === type.objects.length) {
                const nullable = type.undefined || type.literals.includes(0)
