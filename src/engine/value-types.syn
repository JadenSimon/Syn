                fields.push([k, { kind: 'buffer', element: heldElement(buffers), members: 0, shapes: [], nullable }])
            } else fields.push([k, bitValued(type) ? { ...repOf(type), bit: true } : repOf(type)])
        }
        if (order.length) fields.sort((x, y) => (order.indexOf(x[0]) + 1 || order.length + 1) - (order.indexOf(y[0]) + 1 || order.length + 1))
        shapePending.delete(key)
        let id = referenced.has(reserved) ? undefined : [...shapes].find(([known, sig]) => sig.name === object.name && sig.proto === object.proto && sameFields(createdFields.get(known)!, fields))?.[0]
        if (!id) {
            shapes.set(id = reserved, { name: object.name, proto: object.proto, fields, members: [], absent: new Set(), nullish: new Set() })
            createdFields.set(id, fields)
        }
        const sig = shapes.get(id)!
        sig.members.push(...entry.members)
        for (const k of absent) sig.absent.add(k)
        for (const k of nullish) sig.nullish.add(k)
        const byField = mapOf(heldBuffers, id)
        for (const [k, buffers] of held) {
            listOf(byField, k).push(...buffers)
            if (!bufferMembers) joinBuffers(byField.get(k)!)
        }
        if (bufferMembers) layOutShape(id)
        shapeIds.set(key, id)
        return id
    }
    const reps = new Map<Type, Rep>()
    const addressed = new Set<string>()
    function repOf(type: Type): Rep {
        const known = reps.get(type)
        if (known) return known
        const found = repFor(type)
        const functionsOnly = type.functions.length > 0 && type.closures.every(id => functionObject(types, id)) && !type.objects.length && !type.strings.length && !numericType(type)
        const functional = functionsOnly ? { ...found, functions: type.functions } : found
        const states = type.closures.map(id => types.objects[id].state)
        const rep = states.length && states.every(state => state !== undefined) ? { ...functional, states: states as Handle[] } : functional
        reps.set(type, rep)
        return rep
    }
    function repFor(type: Type): Rep {
        if (type.unknown) return { kind: 'any', members: 0, shapes: [], nullable: false }
        if (type.bools && !boolPartners(type)) {
            const numbered = repOf(boolNumbers(type))
            return { ...numbered, bools: type.bools }
        }
        const numeric = numericType(type)
        const objects = type.objects.filter(id => !types.objects[id].native && !types.objects[id].dynamic)
        const shapes = [...new Set(objects.filter(id => !raw(id)).map(id => shapeId(keyOf(id))))].sort()
        let members = objects.some(raw) ? RepMember.buffer : 0
        if (type.strings.length) members |= RepMember.string
        if (type.objects.some(id => types.objects[id].dynamic)) members |= RepMember.dynamic
        const known = type.functions.length === 1 && type.closures.every(id => functionObject(types, id))
        const nativeIds = [...known ? [] : type.closures, ...type.objects.filter(id => types.objects[id].native)]
        const natives = [...new Set(nativeIds.map(id => types.objects[id].state))]
        const plain = known || (type.functions.length > 0 && !type.closures.length)
        const nativeShapes = !plain ? [...new Set(nativeIds.map(id => shapeId(keyOf(id))))] : []
        const closure = natives.length === 1 && natives[0] !== undefined && !plain && !shapes.length && !members ? natives[0] : undefined
        if (closure === undefined && nativeShapes.length) shapes.push(...nativeShapes.sort())
        else if (closure === undefined && (type.functions.length || natives.length)) members |= RepMember.function
        const some = shapes.length > 0 || members !== 0 || closure !== undefined
        if (some && floatType(type)) {
            for (const shape of shapes) addressed.add(shape)
            const other = repOf({ ...type, literals: [], range: undefined, float: false })
            return { kind: 'union', members, shapes, closure, nullable: type.undefined, float: true, other }
        }
        if (type.bools) {
            for (const shape of shapes) addressed.add(shape)
            return { kind: 'union', members, shapes, closure, nullable: type.undefined, bools: type.bools }
        }
        if (!some && numeric) {
            const format = floatType(type) ? undefined : intFormat(numberSpan(type)!)
            return { kind: 'number', format, members: 0, shapes: [], nullable: type.undefined }
        }
        if (!some) return type.undefined ? { kind: 'undefined', members: 0, shapes: [], nullable: true, constant: { handle: heap.undefinedHandle } } : { kind: 'never', members: 0, shapes: [], nullable: false }
        const nulls = nullsOnly(type)
        const kinds = type.strings.length > 0 && shapes.length > 0
        if (numeric || type.undefined || kinds) for (const shape of shapes) addressed.add(shape)
        if ((numeric || kinds) && !nulls) return { kind: 'union', members, shapes, closure, nullable: type.undefined }
        const fresh = !nativeIds.length && !type.functions.length && !type.strings.length && objects.length > 0 && objects.every(id => !types.objects[id].constant && !raw(id))
        return { kind: 'pointer', members, shapes, closure, nullable: type.undefined || nulls, zero: nulls || undefined, fresh }
    }
    for (const key of table.keys()) if (!owners[table.get(key)!.members[0]] && types.objects[table.get(key)!.members[0]].kind !== AllocKind.buffer && !types.objects[table.get(key)!.members[0]].dynamic) shapeId(key)
    const constantShapes = new Map<Handle, string>()
    types.objects.forEach((object, id) => {
        if (!object.constant || object.state === undefined || !joinable(id) || recordMembers.get(findRecord(id))!.length < 2) return
        constantShapes.set(object.state, shapeId(keyOf(id)))
    })
    function layOut(observed: Set<number>, inlined = new Map<number, intrinsics.Types[]>()): void {
        intrinsics.assert(bufferMembers === undefined, 'value-types: elements laid out twice')
        tagged = observed
        inlineGroups = inlined
        const groups = groupBuffers()
        bufferMembers = groups
        const holderWidths = new Map<string, number>()
        const freeGroups = new Map<number, string>()
        for (const [id, byField] of heldBuffers) for (const [k, buffers] of byField) {
            const group = bufferGroup(buffers[0])
            const members = groups.get(group)!
            const at = `${shapes.get(id)!.proto}/${k}`
            if (elementRep(members).encoded && !elementRep(members, true).encoded) freeGroups.set(group, at)
            else holderWidths.set(at, Math.min(holderWidths.get(at) ?? 8, elementWidth(elementRep(members))))
        }
        for (const [group, at] of freeGroups) if (holderWidths.get(at) === 8) wideGroups.add(group)
        for (const id of shapes.keys()) layOutShape(id)
    }
    return { keys, table, shapes, constantShapes, addressed, repOf: type => repOf(type), elementOf, bufferGroups: groupBuffers, bufferGroup, collapses, joinBuffers, layOut, shapeOf: id => types.objects[id].dynamic || types.objects[id].kind === AllocKind.buffer || (owners[id] !== undefined && !genericFor(id)) ? undefined : shapeId(keyOf(id)) }
}
interface PlannedSignature {
    params: { label: string, rep: Rep }[]
    returns: Rep
    made: string[]
}

export interface PlannedUnit {
    fn: Function
    codecs: Map<number, SlotCodec>
    allocations: Map<number, string>
    frames: number[]
    params: { label: string, rep: Rep }[]
    returns: Rep
    returnsSelf: boolean
    nodes: Map<number, Rep>
    slices: Map<number, Rep>
    blocks: Set<number>
    deadArms: Map<number, number[]>
    calls: Map<number, Set<PlannedUnit>>
    coercions: Map<number, number>
    receivers: Map<number, Rep>
    observed: Set<number>
}

function framesOf(object: Allocation): number[] {
    if (object.frames) return object.frames
    return object.frame === undefined ? [] : [object.frame]
}

function functionObject(types: ValueTypes, id: number): boolean {
    return types.objects[id].function !== undefined
}

function singleValued(types: ValueTypes, type: Type): boolean {
    if (type.unknown || opaqueNumber(type) || type.closures.some(id => !functionObject(types, id)) || type.strings.includes(0)) return false
    const bools = type.bools === 3 ? 2 : type.bools ? 1 : 0
    return (type.undefined ? 1 : 0) + bools + type.literals.length + type.functions.length + type.objects.length + type.strings.length === 1
}

function functionRep(types: ValueTypes, inst: Instantiations, type: Type): Rep | undefined {
    if (!singleValued(types, type) || !type.functions.length) return
    return { ...inst.repOf(type), constant: { fn: type.functions[0] } }
}

function valueRep(types: ValueTypes, inst: Instantiations, type: Type, oneObject: (state: Handle) => boolean): Rep | undefined {
    if (!singleValued(types, type)) return
    const rep = inst.repOf(type)
    if (type.strings.length) return { ...rep, constant: { handle: type.strings[0] as Handle } }
    if (type.bools) return { ...rep, constant: { literal: type.bools === 2 ? 1 : 0 } }
    const literal = type.literals[0]
    if (literal !== undefined && !Number.isNaN(literal)) return { ...rep, constant: { literal } }
    const object = type.objects.length ? types.objects[type.objects[0]] : undefined
    if (object?.constant && object.handle && oneObject(object.state!)) return { ...rep, constant: { handle: object.handle } }
}

export function planUnits(types: ValueTypes, genericOf: (proto: Handle) => Generic | undefined, oneObject: (state: Handle) => boolean, graphOf: (fn: Function) => Graph, keepsReturn: (fn: Function) => boolean): { inst: Instantiations, plan: Map<Function, PlannedUnit[]>, codecOf: (allocation: number, key: string) => SlotCodec } {
    const callees = new Map<string, number[]>()
    const outgoing = types.frames.map(() => [] as [node: number, callee: number][])
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            outgoing[site.frame].push([site.node, id])
            const k = `${site.frame}|${site.node}`
            const from = listOf(callees, k)
            from.push(id)
        }
    })
    const find = congruence(types, callees)
    const congruent = new Map<number, number[]>()
    types.frames.forEach((_, id) => {
        const root = find(id)
        listOf(congruent, root).push(id)
    })
    const joins: number[][] = []
    const bySite = new Map<string, number[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native) return
        for (const frame of framesOf(object)) {
            const k = `${find(frame)}|${object.site.node}`
            const list = bySite.get(k)
            if (!list) bySite.set(k, [id])
            else if (!list.includes(id)) list.push(id)
        }
    })
    for (const list of bySite.values()) if (list.length > 1) joins.push(list)
    for (const frame of types.frames) joins.push(...frame.merges)
    for (const members of congruent.values()) {
        if (members.length < 2) continue
        types.frames[members[0]].params.forEach((_, i) => joins.push(members.flatMap(f => types.frames[f].params[i].type.objects)))
        joins.push(members.flatMap(f => types.frames[f].returns.objects))
    }
    const storage = planStorage(types, congruent, graphOf)
    const inst = instantiate(types, genericOf, joins, storage.fieldType)
    const created = new Map<number, string[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = object.dynamic ? 'heap' : inst.shapeOf(id)
        if (shape === undefined) return
        for (const frame of framesOf(object)) {
            let list = created.get(find(frame))
            if (!list) created.set(find(frame), list = [])
            list.push(`%${object.site.node}=${shape}`)
        }
    })
    const signatureOf = (params: { label: string, type: Type }[], returns: Type, allocations: string[] = [], returned = inst.repOf(returns)): PlannedSignature => {
        const reps = params.map(param => ({ label: param.label, rep: functionRep(types, inst, param.type) ?? inst.repOf(param.type) }))
        return { params: reps, returns: returned, made: [...new Set(allocations)].sort() }
    }
    const sameSignature = (a: PlannedSignature, b: PlannedSignature) => {
        if (a.params.length !== b.params.length || a.made.length !== b.made.length || !sameRep(a.returns, b.returns, true)) return false
        if (a.made.some((made, i) => made !== b.made[i])) return false
        return a.params.every((param, i) => param.label === b.params[i].label && sameRep(param.rep, b.params[i].rep, true))
    }
    const joinedOf = (members: number[]) => {
        const joined = joinedSignature(members.map(f => types.frames[f]), unionAll)
        return signatureOf(joined.params, joined.returns, created.get(find(members[0])))
    }
    let classOf = new Map<number, number>()
    const initial = new Map<string, { signature: PlannedSignature, id: number }[]>()
    let classCount = 0
    for (const [root, members] of congruent) {
        const tags = [...new Set(members.flatMap(f => [...storage.frames[f]]))].sort((a, b) => a - b)
        const joined = joinedOf(members)
        const known = listOf(initial, `${unitIdentity(types.frames[root].unit)}|${tags.join(',')}`)
        let entry = known.find(other => sameSignature(other.signature, joined))
        if (!entry) known.push(entry = { signature: joined, id: classCount++ })
        classOf.set(root, entry.id)
    }
    const calleesOf = new Map<number, [site: string, callee: number][]>()
    for (const [root, members] of congruent) {
        const out: [string, number][] = []
        for (const f of members) for (const [node, callee] of outgoing[f]) out.push([`${node}:${unitIdentity(types.frames[callee].unit)}`, find(callee)])
        calleesOf.set(root, out)
    }
    const membersOf = new Map<number, number[]>()
    const dependsOn = new Map<number, Set<number>>()
    for (const [root, out] of calleesOf) {
        const c = classOf.get(root)!
        let members = membersOf.get(c)
        if (!members) {
            membersOf.set(c, members = [])
            dependsOn.set(c, new Set())
        }
        members.push(root)
        for (const [, callee] of out) dependsOn.get(c)!.add(classOf.get(callee)!)
    }
    const settled = new Map<number, number>()
    for (const scc of stronglyConnected(membersOf.keys(), c => [...dependsOn.get(c)!])) {
        const inside = new Set(scc)
        for (const c of scc) {
            const groups: Map<string, number>[] = []
            for (const root of membersOf.get(c)!) {
                const calls = new Map<string, number>()
                for (const [site, callee] of calleesOf.get(root)!) calls.set(site, inside.has(classOf.get(callee)!) ? -1 - classOf.get(callee)! : settled.get(callee)!)
                let group = groups.findIndex(known => [...calls].every(([k, v]) => !known.has(k) || known.get(k) === v))
                if (group < 0) {
                    group = groups.length
                    groups.push(new Map())
                }
                for (const [k, v] of calls) groups[group].set(k, v)
                settled.set(root, c * congruent.size + group)
            }
        }
    }
    classOf = settled
    const classRoot = new Map<number, number>()
    for (const root of congruent.keys()) if (!classRoot.has(classOf.get(root)!)) classRoot.set(classOf.get(root)!, root)
    const unitRoot = (id: number) => classRoot.get(classOf.get(find(id))!)!
    const plan = new Map<Function, PlannedUnit[]>()
    const unitOfRoot = new Map<number, PlannedUnit>()
    const touchedOf = new Map<PlannedUnit, Map<number, number[]>>()
    const unitOfFrame: PlannedUnit[] = []
    types.frames.forEach((frame, id) => {
        const root = unitRoot(id)
        let unit = unitOfRoot.get(root)
        if (!unit) {
            unitOfRoot.set(root, unit = { fn: frame.unit, codecs: new Map(), allocations: new Map(), frames: [], params: [], returns: { kind: 'never', members: 0, shapes: [], nullable: false }, returnsSelf: false, nodes: new Map(), slices: new Map(), blocks: new Set(), deadArms: new Map(), calls: new Map(), coercions: new Map(), receivers: new Map(), observed: new Set() })
            const units = listOf(plan, frame.unit)
            units.push(unit)
        }
        unit.frames.push(id)
        unitOfFrame[id] = unit
    })
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            const caller = unitOfFrame[site.frame]
            const set = setOf(caller.calls, site.node)
            set.add(unitOfFrame[id])
            if (site.operand !== undefined) caller.coercions.set(site.node, (caller.coercions.get(site.node) ?? 0) | (1 << site.operand))
        }
    })
    const conventionOf = sharedConventions([...unitOfRoot.values()])
    const truth = { ...inst.repOf({ ...emptyType(), bools: 3 }), tested: true }
    const testedOf = new Map<PlannedUnit, Set<number>>()
    const resolvedOf = new Map<PlannedUnit, Map<number, Type>>()
    for (const unit of unitOfRoot.values()) {
        const resolved = types.resolve(unit.frames)
        for (const [node, type] of resolved.nodes) unit.nodes.set(node, inst.repOf(type))
        for (const [node, type] of resolved.receivers) unit.receivers.set(node, inst.repOf(type))
        for (const target of comparedTargets(graphOf(unit.fn), node => unit.nodes.get(node))) inst.addressed.add(target)
        testedOf.set(unit, truthDemand(graphOf(unit.fn), resolved.nodes, false))
        resolvedOf.set(unit, resolved.nodes)
        touchedOf.set(unit, resolved.slices)
        for (const b of resolved.blocks) unit.blocks.add(b)
        for (const [select, arms] of resolved.selects) {
            const dead = arms.flatMap((x, i) => x ? [] : [i + 1])
            if (dead.length) unit.deadArms.set(select, dead)
        }
    }
    const truthful = new Set(truthReturns(types, [...unitOfRoot.values()], conventionOf, unitOfFrame, caller => testedOf.get(caller)!, keepsReturn))
    for (const unit of truthful) for (const f of unit.frames) for (const site of types.frames[f].sites) unitOfFrame[site.frame!].nodes.set(site.node, truth)
    for (const unit of unitOfRoot.values()) {
        const g = graphOf(unit.fn)
        const tested = truthful.has(unit) ? truthDemand(g, resolvedOf.get(unit)!, true) : testedOf.get(unit)!
        for (const node of tested) if (getNode(g, node)!.op !== NodeOp.call) unit.nodes.set(node, truth)
        const signature = joinedSignature(unit.frames.map(f => types.frames[f]), unionAll)
        const peers = conventionOf.get(unit) ?? [unit]
        const returns = unionAll(peers.flatMap(peer => peer.frames.map(f => types.frames[f].returns)))
        const joined = signatureOf(signature.params, returns, [], truthful.has(unit) ? truth : inst.repOf(returns))
        unit.returnsSelf = peers.length === 1 && unit.frames.every(f => {
            const r = types.frames[f].returns
            return r.objects.length > 0 && !r.undefined && !r.strings.length && !r.unknown && !numericType(r) && !r.functions.length && !r.closures.length
        }) && returnsSelf(graphOf(unit.fn))
        unit.params = joined.params
        unit.returns = joined.returns
    }
    for (const touched of touchedOf.values()) for (const buffers of touched.values()) inst.joinBuffers(buffers)
    const conflicted: [PlannedUnit, number][] = []
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = object.dynamic ? 'heap' : inst.shapeOf(id)
        if (shape === undefined) return
        for (const frame of framesOf(object)) {
            const unit = unitOfFrame[frame]
            const known = unit.allocations.get(object.site.node)
            if (known !== undefined && known !== shape) conflicted.push([unit, object.site.node])
            unit.allocations.set(object.site.node, shape)
        }
    })
    for (const [unit, node] of conflicted) unit.allocations.delete(node)
    for (const units of plan.values()) {
        const frames = units.flatMap(unit => unit.frames)
        units[0].params.forEach((_, i) => {
            if (units.some(unit => unit.params[i].rep.constant)) return
            const rep = valueRep(types, inst, unionAll(frames.map(f => types.frames[f].params[i].type)), oneObject)
            if (!rep) return
            for (const unit of units) unit.params[i] = { label: unit.params[i].label, rep }
        })
    }
    const inlined = intrinsics.argv().some(flag => flag.startsWith('inline-records')) ? inlineRecords(types, inst, [...unitOfRoot.values()], resolvedOf, touchedOf, graphOf) : undefined
    inst.layOut(observeUndefined(types, [...unitOfRoot.values()], touchedOf, graphOf, storage.group, inst), intrinsics.argv().includes('inline-records') ? inlined : undefined)
    for (const [unit, touched] of touchedOf) {
        const words = new Set(unit.frames.flatMap(f => [...storage.frames[f]]))
        for (const [node, buffers] of touched) {
            const element = inst.elementOf(buffers)
            unit.slices.set(node, element)
            unit.codecs.set(node, slotCodec(element, words.has(node)))
            words.delete(node)
        }
        intrinsics.assert(!words.size, `value-types: ${unit.fn.name} tags word accesses %${[...words].join(', %')} that touch no buffer`)
    }
    if (intrinsics.argv().includes('element-debug')) {
        for (const line of storage.lines()) console.log(line)
        for (const unit of unitOfRoot.values()) {
            const nodes = [...new Set(unit.frames.flatMap(f => types.frames[f].accesses.filter(access => !access.field).map(access => access.node)))].sort((a, b) => a - b)
            if (!nodes.length) continue
            console.log(`ELEMENT-UNIT ${unit.fn.name || '<anon>'}${unitSignatureText(unit)} ${nodes.map(node => `%${node}:${unit.codecs.get(node)?.text ?? '-'}:${repText(unit.nodes.get(node), '-')}`).join(' ')}`)
        }
    }
    return { inst, plan, codecOf: (allocation, key) => slotCodec(inst.elementOf([allocation]), !!storage.tagged.get(allocation)?.has(key)) }
}

interface StoragePlan {
    tagged: Map<number, Set<string>>
    frames: Set<number>[]
    fieldType(allocation: number, key: string, type: Type): Type
    lines(): string[]
    group(slot: number): number
}

function planStorage(types: ValueTypes, congruent: Map<number, number[]>, graphOf: (fn: Function) => Graph): StoragePlan {
    const slotRoot = types.slots.map((_, i) => i)
    const slotGroup = (a: number) => rootOf(slotRoot, a)
    const joinSlots = (a: number, b: number) => {
        slotRoot[slotGroup(b)] = slotGroup(a)
    }
    const joinKeys = (lists: number[][]) => {
        const byKey = new Map<string, number>()
        for (const slots of lists) for (const slot of slots) {
            joinSlots(slots[0], slot)
            const first = byKey.get(types.slots[slot].key)
            if (first === undefined) byKey.set(types.slots[slot].key, slot)
            else joinSlots(first, slot)
        }
    }
    const byAllocation = new Map<string, number>()
    types.slots.forEach((slot, i) => {
        const k = `${slot.allocation}:${slot.key}`
        const first = byAllocation.get(k)
        if (first === undefined) byAllocation.set(k, i)
        else joinSlots(first, i)
    })
    const copies = new Map<Function, { reads: Map<number, number[]>, moved: Set<number> }>()
    const copiesOf = (fn: Function) => {
        let known = copies.get(fn)
        if (!known) {
            const reads = copiedWords(graphOf(fn))
            copies.set(fn, known = { reads, moved: new Set([...reads.keys(), ...[...reads.values()].flat()]) })
        }
        return known
    }
    for (const frame of types.frames) {
        const { reads } = copiesOf(frame.unit)
        if (!reads.size) continue
        const byAccess = new Map(frame.accesses.map(access => [access.node, access.members]))
        for (const [read, stores] of reads) {
            const from = byAccess.get(read)
            for (const store of stores) {
                const into = byAccess.get(store)
                if (!from || !into) continue
                from.forEach((slots, i) => {
                    const both = [...slots, ...into[i] ?? []]
                    for (const slot of both) joinSlots(both[0], slot)
                })
            }
        }
    }
    const shared: number[][][] = []
    for (const members of congruent.values()) {
        const nodes = new Map<number, number[][]>()
        for (const f of members) {
            const { moved } = copiesOf(types.frames[f].unit)
            for (const access of types.frames[f].accesses) if (!moved.has(access.node)) listOf(nodes, access.node).push(...access.members.filter(slots => slots.length))
        }
        for (const lists of nodes.values()) {
            joinKeys(lists)
            if (lists.length) shared.push(lists)
        }
    }
    const groupKinds = new Map<number, number>()
    types.slots.forEach((slot, i) => groupKinds.set(slotGroup(i), (groupKinds.get(slotGroup(i)) ?? 0) | slot.kinds))
    const shareRoot = types.slots.map((_, i) => i)
    const shareGroup = (a: number) => rootOf(shareRoot, slotGroup(a))
    for (const lists of shared) for (const slots of lists) for (const slot of slots) shareRoot[shareGroup(slot)] = shareGroup(lists[0][0])
    const mixedShares = new Set<number>()
    for (const [root, kinds] of groupKinds) if (mixedKinds(kinds)) mixedShares.add(shareGroup(root))
    const taggedSlot = (slot: number) => mixedShares.has(shareGroup(slot))
    const tagged = new Map<number, Set<string>>()
    types.slots.forEach((slot, i) => {
        if (!taggedSlot(i)) return
        const keys = tagged.get(slot.allocation)
        if (keys) keys.add(slot.key)
        else tagged.set(slot.allocation, new Set([slot.key]))
    })
    const frames = types.frames.map(frame => {
        const { moved } = copiesOf(frame.unit)
        const nodes = new Set<number>()
        for (const access of frame.accesses) if (!access.field && !moved.has(access.node) && access.members.some(slots => slots.some(taggedSlot))) nodes.add(access.node)
        return nodes
    })
    function lines(): string[] {
        const accessed = new Set(types.frames.flatMap(frame => frame.accesses.filter(access => !access.field).flatMap(access => access.members.flat().map(slotGroup))))
        const groups = new Map<number, string[]>()
        types.slots.forEach((slot, i) => {
            if (!accessed.has(slotGroup(i))) return
            const object = types.objects[slot.allocation]
            const text = `${object.name}#${slot.allocation}@${object.site.unit.name || '<anon>'}:%${object.site.node}${slot.key === numberKey ? '' : slot.key}`
            const list = listOf(groups, slotGroup(i))
            if (!list.includes(text)) list.push(text)
        })
        const out = [...groups].map(([root, members]) => `ELEMENT-GROUP ${root} ${taggedSlot(root) ? 'tagged' : 'raw'} kinds ${groupKinds.get(root)} shared ${shareGroup(root)} members ${members.join(' ')}`)
        const fieldGroups = new Set(types.frames.flatMap(frame => frame.accesses.filter(access => access.field).flatMap(access => access.members.flat().map(slotGroup))))
        const allocations = new Map<number, Set<number>>()
        types.slots.forEach((slot, i) => {
            if (fieldGroups.has(slotGroup(i))) setOf(allocations, slotGroup(i)).add(slot.allocation)
        })
        for (const [root, ids] of allocations) {
            if (ids.size < 2) continue
            const names = [...ids].map(id => `${types.objects[id].name}#${id}@${types.objects[id].site.unit.name || '<anon>'}:%${types.objects[id].site.node}`)
            out.push(`FIELD-GROUP ${root} ${types.slots[root].key} kinds ${groupKinds.get(root)} type ${formatType(types, fieldType(types.slots[root].allocation, types.slots[root].key, emptyType()))} members ${names.join(' ')}`)
        }
        return out
    }
    let groupTypes: Map<number, Type> | undefined
    const fieldKinds = new Map<number, number>()
    function fieldType(allocation: number, key: string, type: Type): Type {
        const slot = byAllocation.get(`${allocation}:${key}`)
        if (slot === undefined) return type
        if (!groupTypes) {
            const lists = new Map<number, Type[]>()
            types.slots.forEach((other, i) => {
                listOf(lists, slotGroup(i)).push(other.type)
                fieldKinds.set(slotGroup(i), (fieldKinds.get(slotGroup(i)) ?? 0) | (nullsOnly(other.type) ? 0 : other.kinds))
            })
            groupTypes = new Map()
            for (const [group, list] of lists) if (list.length > 1) groupTypes.set(group, unionAll(list))
        }
        const joined = groupTypes.get(slotGroup(slot))
        if (!joined) return type
        if (mixedKinds(fieldKinds.get(slotGroup(slot))!)) return union(type, joined)
        return union(type, { ...joined, objects: [], functions: [], closures: [], strings: [] })
    }
    return { tagged, frames, fieldType, lines, group: slotGroup }
}


function recordElements(types: ValueTypes, inst: Instantiations, buffers: number[]): { shape: string, words: intrinsics.Types[], elements: Set<number> } | string {
    let element = emptyType()
    for (const id of buffers) {
        const buffer = types.objects[id]
        if (buffer.kind !== AllocKind.buffer || buffer.constant || buffer.native || buffer.dynamic || buffer.copied) return 'buffer'
        for (const [k, field] of buffer.fields) {
            if (k !== numberKey && !constantIndex(k)) continue
            if (field.forms.some(form => form !== 'vm_value')) return `form:${field.forms.join('|')}`
            element = union(element, field.type)
        }
    }
    if (element.unknown || element.undefined || element.bools || numericType(element) || element.strings.length || element.functions.length || element.closures.length || !element.objects.length) return 'mixed'
    let shape: string | undefined
    for (const id of element.objects) {
        const object = types.objects[id]
        if (object.kind !== AllocKind.object || object.constant || object.native || object.dynamic || object.copied || object.function !== undefined) return 'object'
        const own = inst.shapeOf(id)
        if (own === undefined || (shape !== undefined && own !== shape)) return 'shapes'
        shape = own
    }
    const sig = inst.shapes.get(shape!)!
    if (!sig.fields.length || sig.fields.some(([, rep]) => rep.kind !== 'number' || rep.nullable || rep.bit || rep.bools)) return `fields:${shapeSignatureText(sig)}`
    return { shape: shape!, words: sig.fields.map(([, rep]) => numberName(rep) === 'f64' ? Types.f64 : Types.u64), elements: new Set(element.objects) }
}

function exposedObjects(types: ValueTypes): Set<number> {
    const exposed = new Set<number>()
    const work: number[] = []
    const expose = (type: Type) => {
        for (const id of type.objects) {
            if (exposed.has(id)) continue
            exposed.add(id)
            work.push(id)
        }
    }
    for (const frame of types.frames) {
        if (frame.sites.some(site => site.frame !== undefined)) continue
        expose(frame.returns)
        for (const param of frame.params) expose(param.type)
    }
    while (work.length) {
        for (const field of types.objects[work.pop()!].fields.values()) expose(field.type)
    }
    return exposed
}

function inlineRecords(types: ValueTypes, inst: Instantiations, units: PlannedUnit[], resolvedOf: Map<PlannedUnit, Map<number, Type>>, touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph): Map<number, intrinsics.Types[]> {
    const out = new Map<number, intrinsics.Types[]>()
    const debug = intrinsics.argv().includes('inline-records-debug')
    const exposed = exposedObjects(types)
    const callers = new Map<PlannedUnit, PlannedUnit[]>()
    for (const unit of units) for (const callees of unit.calls.values()) for (const callee of callees) listOf(callers, callee).push(unit)
    for (const [group, buffers] of inst.bufferGroups()) {
        const found = recordElements(types, inst, buffers)
        const why = typeof found === 'string' ? found : buffers.some(id => exposed.has(id)) || [...found.elements].some(id => exposed.has(id)) ? 'reaches-host' : elementUses(types, units, callers, resolvedOf, touchedOf, graphOf, new Set(buffers), found.elements, found.shape)
        if (debug) console.log(`INLINE-RECORDS group ${group} [${buffers.join(',')}] ${typeof found === 'string' ? '' : `${found.shape} stride ${8 * found.words.length} `}${why || 'inline'}`)
        if (!why && typeof found !== 'string') out.set(group, found.words)
    }
    return out
}

function elementUses(types: ValueTypes, units: PlannedUnit[], callers: Map<PlannedUnit, PlannedUnit[]>, resolvedOf: Map<PlannedUnit, Map<number, Type>>, touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph, buffers: Set<number>, elements: Set<number>, shape: string): string {
    const writesGroup = (allocations: number[] | undefined) => !!allocations && allocations.some(id => buffers.has(id))
    const freshData = (g: Graph, n: GraphNode) => rt.sliceOf(g, getNode(g, valueTail(g, getRef(n, 2)))!) === rt.Op.slice
    const holders = new Set<number>(buffers)
    let grew = true
    while (grew) {
        grew = false
        types.objects.forEach((object, id) => {
            if (holders.has(id) || ![...object.fields.values()].some(field => field.type.objects.some(inner => holders.has(inner)))) return
            holders.add(id)
            grew = true
        })
    }
    const pinned = [...holders].some(id => types.objects[id].constant || types.objects[id].native || types.objects[id].dynamic)
    const unknownCall = (unit: PlannedUnit, g: Graph, id: number, n: GraphNode) => {
        if (n.op !== NodeOp.call || unit.calls.has(id)) return false
        if (pinned) return true
        const nodes = resolvedOf.get(unit)!
        for (let i = 1; i < countIds(n); i++) {
            if (getRef(n, i) && nodes.get(getRef(n, i))?.objects.some(object => holders.has(object))) return true
        }
        return false
    }
    const carriers = new Set<number>(elements)
    let boxed = true
    while (boxed) {
        boxed = false
        types.objects.forEach((object, id) => {
            if (carriers.has(id) || object.kind !== AllocKind.object || object.constant || object.native || object.dynamic || object.copied || object.function !== undefined) return
            if (![...object.fields.values()].some(field => field.type.objects.some(inner => carriers.has(inner)))) return
            carriers.add(id)
            boxed = true
        })
    }
    const movers = new Set<PlannedUnit>()
    const work: PlannedUnit[] = []
    for (const unit of units) {
        const g = graphOf(unit.fn)
        let moves = false
        for (const [node, allocations] of touchedOf.get(unit)!) {
            const n = getNode(g, node)!
            if (rt.sliceOf(g, n) === rt.Op.sliceWrite && writesGroup(allocations) && !freshData(g, n)) moves = true
        }
        for (const [id, n] of nodeEntries(g)) {
            if (unknownCall(unit, g, id, n)) moves = true
        }
        if (moves) {
            movers.add(unit)
            work.push(unit)
        }
    }
    while (work.length) {
        for (const caller of callers.get(work.pop()!) ?? []) {
            if (movers.has(caller)) continue
            movers.add(caller)
            work.push(caller)
        }
    }
    for (const unit of units) {
        const g = graphOf(unit.fn)
        const nodes = resolvedOf.get(unit)!
        const touched = touchedOf.get(unit)!
        const users = usersOf(g)
        const slots = paramSlots(g)
        const name = `${unit.fn.name || '<anon>'}`
        const typed = (id: number) => !!nodes.get(id)?.objects.some(object => carriers.has(object))
        const budget = 64 * countNodes(g)
        let steps = 0
        const moving = new Set<number>()
        for (const [id, n] of nodeEntries(g)) {
            const slice = rt.sliceOf(g, n)
            if (slice === rt.Op.sliceWrite && writesGroup(touched.get(id))) moving.add(id)
            else if (slice !== undefined) continue
            else if (unknownCall(unit, g, id, n)) moving.add(id)
            else if ([...unit.calls.get(id) ?? []].some(callee => movers.has(callee))) moving.add(id)
        }
        const blockMoves = new Map<number, boolean>()
        function moverIn(block: Block): boolean {
            const known = blockMoves.get(block.id)
            if (known !== undefined) return known
            let found = false
            for (const id of bodyNodes(g, block.bodyId)) if (moving.has(id)) found = true
            blockMoves.set(block.id, found)
            return found
        }
        function homeOf(id: number): Block | undefined {
            const slot = slots.get(id)
            if (slot) return slot[0]
            const n = getNode(g, id)!
            if (n.op === NodeOp.ret) return getBlock(g, getRef(n, 1))
            const roots = new Set<number>()
            const seen = new Set<number>()
            const stack = [id]
            while (stack.length) {
                const at = stack.pop()!
                if (seen.has(at)) continue
                seen.add(at)
                const m = getNode(g, at)
                if (!m) continue
                if (m.op === NodeOp.startOf) roots.add(getRef(m, 0))
                for (let i = 0; i < firstNonOrderingSlot(m); i++) if (getRef(m, i)) stack.push(getRef(m, i))
            }
            if (roots.size === 1) return getBlock(g, [...roots][0])
            if (roots.size) return
            const containing = g.blocks.filter(b => bodyNodes(g, b.bodyId).has(id))
            return containing.length === 1 ? containing[0] : undefined
        }
        function reachable(from: Block): Set<number> {
            const seen = new Set<number>()
            const stack = successorsOf(g, from)
            while (stack.length) {
                const next = stack.pop()!
                if (seen.has(next.id)) continue
                seen.add(next.id)
                stack.push(...successorsOf(g, next))
            }
            return seen
        }
        function liveAcross(origin: number, x: number): string {
            const n = getNode(g, x)!
            const home = homeOf(origin)
            const at = homeOf(x)
            if (!home || !at) return `unplaced:${name}%${x}`
            if (OrderedValues.has(n.op) || n.op === NodeOp.after) {
                const seen = new Set<number>()
                const stack: number[] = []
                for (let i = 0; i < firstNonOrderingSlot(n); i++) if (getRef(n, i)) stack.push(getRef(n, i))
                while (stack.length) {
                    const id = stack.pop()!
                    if (id === origin || seen.has(id)) continue
                    seen.add(id)
                    if (++steps > budget) return `budget:${name}`
                    if (moving.has(id)) return `live-across-slot-write:${name}%${origin}@%${id}->%${x}`
                    const m = getNode(g, id)
                    if (!m) continue
                    for (let i = 0; i < firstNonOrderingSlot(m); i++) if (getRef(m, i)) stack.push(getRef(m, i))
                }
            } else if (moverIn(at)) return `live-across-slot-write-in-block:${name}%${x}`
            if (home.id === at.id) return ''
            if (moverIn(home)) return `live-across-slot-write-after-origin:${name}%${origin}`
            const after = reachable(home)
            for (const id of after) {
                const b = getBlock(g, id)!
                if (id !== at.id && reachable(b).has(at.id) && moverIn(b)) return `live-across-slot-write-on-path:${name}%${origin}->%${x}`
            }
            if (reachable(at).has(at.id) && moverIn(at)) return `live-across-slot-write-in-loop:${name}%${x}`
            return ''
        }
        function constructs(n: GraphNode): boolean {
            if (getRef(n, 2)) return false
            const base = valueTail(g, getRef(n, 1))
            const k = types.keyNames.get(getLiteral(g, n, 2) as Handle)
            if (allocated.has(base)) return true
            const objects = nodes.get(base)?.objects ?? []
            return k !== undefined && objects.length > 0 && objects.every(id => carriers.has(id) && types.objects[id].fields.get(k)?.constructed)
        }
        function boxes(n: GraphNode): boolean {
            const base = valueTail(g, getRef(n, 1))
            return allocated.has(base) && !!nodes.get(base)?.objects.every(id => carriers.has(id) && !elements.has(id))
        }
        function constructedBefore(origin: number, x: number): string {
            const home = homeOf(origin)
            if (!home || home.id !== homeOf(x)?.id) return liveAcross(origin, x)
            const seen = new Set<number>()
            const stack = [getRef(getNode(g, x)!, 0)]
            while (stack.length) {
                const id = stack.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                if (++steps > budget) return `budget:${name}`
                const m = getNode(g, id)
                if (!m) continue
                for (let i = firstNonOrderingSlot(m); i < countIds(m); i++) {
                    const base = (m.op === NodeOp.getProp || m.op === NodeOp.setProp) && i === 1
                    if (!base && getRef(m, i) && valueTail(g, getRef(m, i)) === origin) return `aliased-mutation:${name}%${x}`
                }
                for (let i = 0; i < firstNonOrderingSlot(m); i++) stack.push(getRef(m, i))
            }
            return ''
        }
        function nullishOperand(n: GraphNode, slot: number): boolean {
            if (!getRef(n, slot)) return false
            const m = getNode(g, valueTail(g, getRef(n, slot)))
            return m?.op === NodeOp.heapHandle && countIds(m) === 1 && !getRef(m, 0) && heap.isNullishHandle(getLiteral(g, m, 0) as Handle)
        }
        const allocated = new Set<number>()
        types.objects.forEach((object, id) => {
            if (carriers.has(id) && object.site.unit === unit.fn) allocated.add(object.site.node)
        })
        function consumersOf(origin: number, value: number): string {
            const walk = (o: number, x: number) => !allocated.has(o) ? liveAcross(o, x) : getNode(g, x)!.op === NodeOp.setProp ? constructedBefore(o, x) : ''
            for (const [u, slot] of users.get(value) ?? []) {
                const n = getNode(g, u)!
                if (slot < firstNonOrderingSlot(n)) continue
                let why = ''
                if (n.op === NodeOp.after || (n.op === NodeOp.select && slot > 0)) why = consumersOf(origin, u)
                else if (n.op === NodeOp.eq || n.op === NodeOp.ne) why = nullishOperand(n, 1 - slot) ? '' : `identity-compared:${name}%${u}`
                else if (n.op === NodeOp.getProp) why = slot === 1 ? walk(origin, u) : `key:${name}%${u}`
                else if (n.op === NodeOp.setProp && slot === 3) why = boxes(n) ? walk(origin, u) : `stored-into-field:${name}%${u}`
                else if (n.op === NodeOp.setProp) why = slot !== 1 ? `key:${name}%${u}` : !constructs(n) ? `aliased-mutation:${name}%${u}` : walk(origin, u)
                else if (n.op === NodeOp.call) why = slot === 1 ? `call-target:${name}%${u}` : walk(origin, u)
                else if (rt.sliceOf(g, n) === rt.Op.sliceWrite) why = slot === 4 && (touched.get(u) ?? []).every(id => buffers.has(id)) ? walk(origin, u) : `other-buffer:${name}%${u}`
                else if (n.op === NodeOp.rt && (getLiteral(g, n, 1) === rt.Op.typeof || getLiteral(g, n, 1) === rt.Op.hasPrototype)) why = ''
                else if (n.op === NodeOp.rt && unit.calls.has(u)) why = walk(origin, u)
                else if (n.op === NodeOp.ret && slot === 0) why = walk(origin, u)
                else if (n.op === NodeOp.apply) why = walk(origin, u)
                else why = `${n.op === NodeOp.rt ? rt.opName(getLiteral(g, n, 1)) : opName(n.op)}:${name}%${u}`
                if (why) return why
            }
            return ''
        }
        for (const id of nodes.keys()) {
            if (!typed(id) || !getNode(g, id)) continue
            const param = g.blocks[0].params.indexOf(id)
            const rep = param >= 0 ? unit.params[param]?.rep : unit.nodes.get(id)
            if (rep && nodes.get(id)!.objects.some(object => elements.has(object)) && (rep.kind !== 'pointer' || rep.encoded || memberCount(rep) !== 1 || rep.shapes[0] !== shape)) return `rep:${repText(rep)}@${name}%${id}`
            const why = consumersOf(id, id)
            if (why) return why
        }
    }
    return ''
}

function comparedTargets(g: Graph, repAt: (node: number) => Rep | undefined): string[] {
    const targets: string[] = []
    for (const n of allNodes(g)) {
        if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) continue
        for (let i = 0; i < countIds(n); i++) {
            const rep = getRef(n, i) ? repAt(getRef(n, i)) : undefined
            if (rep) targets.push(...rep.shapes)
        }
    }
    return targets
}

function truthReturns(types: ValueTypes, units: PlannedUnit[], conventionOf: Map<PlannedUnit, PlannedUnit[]>, unitOfFrame: PlannedUnit[], testedIn: (unit: PlannedUnit) => Set<number>, keepsReturn: (fn: Function) => boolean): PlannedUnit[] {
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const parent = units.map((_, i) => i)
    const join = (a: PlannedUnit, b: PlannedUnit) => {
        parent[rootOf(parent, index.get(a)!)] = rootOf(parent, index.get(b)!)
    }
    for (const unit of units) {
        for (const peer of conventionOf.get(unit) ?? []) join(unit, peer)
        for (const callees of unit.calls.values()) {
            const first = [...callees][0]
            for (const callee of callees) join(first, callee)
        }
    }
    const qualifies = (unit: PlannedUnit) => !keepsReturn(unit.fn) && truthTested(unionAll(unit.frames.map(f => types.frames[f].returns))) && unit.frames.every(f => {
        const sites = types.frames[f].sites
        return sites.length > 0 && sites.every(site => site.frame !== undefined && site.operand === undefined && testedIn(unitOfFrame[site.frame]).has(site.node))
    })
    const failed = new Set<number>()
    for (const unit of units) if (!qualifies(unit)) failed.add(rootOf(parent, index.get(unit)!))
    return units.filter(unit => !failed.has(rootOf(parent, index.get(unit)!)))
}

function sharedConventions(units: PlannedUnit[]): Map<PlannedUnit, PlannedUnit[]> {
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const parent = units.map((_, i) => i)
    for (const unit of units) {
        for (const callees of unit.calls.values()) {
            if (callees.size < 2) continue
            const first = index.get([...callees][0])!
            for (const callee of callees) parent[rootOf(parent, index.get(callee)!)] = rootOf(parent, first)
        }
    }
    const groups = new Map<number, PlannedUnit[]>()
    units.forEach((unit, i) => listOf(groups, rootOf(parent, i)).push(unit))
    const out = new Map<PlannedUnit, PlannedUnit[]>()
    for (const members of groups.values()) {
        if (members.length < 2) continue
        for (const unit of members) out.set(unit, members)
    }
    return out
}

export function floatUnion(rep: Rep | undefined): boolean {
    return rep?.kind === 'union' && !!rep.float
}

export function nullableNumber(rep: Rep | undefined): boolean {
    return rep?.kind === 'number' && rep.nullable
}

export function falsyCollapsible(rep: Rep | undefined): boolean {
    return nullableNumber(rep) || (isStringRep(rep) && rep!.nullable)
}

export function nonzeroLiteral(g: Graph, n: GraphNode, at: number): boolean {
    const ref = getRef(n, at)
    if (!ref) return getLiteral(g, n, at) !== 0
    const m = getNode(g, ref)
    return m?.op === NodeOp.literal && getLiteral(g, m, 0) !== 0
}

function undefinedCarrier(rep: Rep | undefined): boolean {
    return falsyCollapsible(rep) || (rep?.kind === 'union' && rep.nullable && !rep.float)
}

const arithmeticRt = new Set<number>([rt.Op.exp, rt.Op.mod, rt.Op.trunc])

function truthTest(g: Graph, n: GraphNode): boolean {
    return n.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.truthy
}

function firstArg(call: GraphNode, plain: number): number {
    if (call.op === NodeOp.call) return 3
    if (call.op === NodeOp.rt) return 2
    if (call.op === NodeOp.getProp || call.op === NodeOp.setProp) return countIds(call) - plain
    return -1
}

function observeUndefined(types: ValueTypes, units: PlannedUnit[], touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph, slotGroup: (slot: number) => number, inst: Instantiations): Set<number> {
    const observed = new Set<number>()
    const bufferGroup = inst.bufferGroup
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, u) => index.set(unit, u))
    const graphs = units.map(unit => graphOf(unit.fn))
    const at = (u: number, node: number) => u * nodeSpan + node
    const callers = units.map(() => [] as [number, number][])
    const readers = new Map<number, [number, number][]>()
    const writers = new Map<number, [number, number][]>()
    function add(map: Map<number, [number, number][]>, k: number, item: [number, number]): void {
        listOf(map, k).push(item)
    }
    units.forEach((unit, u) => {
        for (const [node, callees] of unit.calls) for (const callee of callees) callers[index.get(callee)!].push([u, node])
        for (const [node, touched] of touchedOf.get(unit)!) {
            const slice = rt.sliceOf(graphs[u], getNode(graphs[u], node)!)
            for (const allocation of touched) {
                if (slice === rt.Op.sliceRead) add(readers, bufferGroup(allocation), [u, node])
                if (slice === rt.Op.sliceWrite) add(writers, bufferGroup(allocation), [u, getRef(getNode(graphs[u], node)!, 4)])
            }
        }
    })
    const fieldReaders = new Map<number, [number, number][]>()
    const fieldWriters = new Map<number, [number, number][]>()
    const fieldGroups = new Map<number, number[]>()
    const fieldBuffers = new Map<number, number[]>()
    const bufferGroups = inst.bufferGroups()
    const buffered = new Set<number>()
    for (const members of bufferGroups.values()) for (const id of members) buffered.add(id)
    units.forEach((unit, u) => {
        for (const f of unit.frames) for (const access of types.frames[f].accesses) {
            if (!access.field || fieldGroups.has(at(u, access.node))) continue
            const slots = access.members.flat()
            const groups = [...new Set(slots.map(slotGroup))]
            const buffers = [...new Set(slots.map(slot => types.slots[slot].allocation).filter(id => buffered.has(id)).map(bufferGroup))]
            fieldGroups.set(at(u, access.node), groups)
            fieldBuffers.set(at(u, access.node), buffers)
            const item: [number, number] = access.store ? [u, getRef(getNode(graphs[u], access.node)!, 3)] : [u, access.node]
            for (const group of groups) add(access.store ? fieldWriters : fieldReaders, group, item)
            for (const group of buffers) add(access.store ? writers : readers, group, item)
        }
    })
    const observedFields = new Set<number>()
    const rooted = units.map(unit => unit.frames.some(f => !types.frames[f].sites.length))
    const plains = new Map<Graph, number[]>()
    function plainOf(g: Graph): number[] {
        let known = plains.get(g)
        if (!known) plains.set(g, known = g.blocks[0].params.filter(p => !isThisParam(getNode(g, p)!)))
        return known
    }
    function calleeTargets(u: number, node: number, n: GraphNode, slot: number): [number, number][] | undefined {
        const callees = units[u].calls.get(node)
        if (!callees) return
        const out: [number, number][] = []
        for (const callee of callees) {
            const c = index.get(callee)!
            const plain = plainOf(graphs[c])
            const first = firstArg(n, plain.length)
            if (first < 0 || slot < first) return
            if (slot - first >= plain.length) continue
            const param = callee.nodes.get(plain[slot - first])
            if (param && !param.nullable) continue
            if (!undefinedCarrier(param)) return
            out.push([c, plain[slot - first]])
        }
        return out
    }
    function targetsOf(u: number, node: number, slot: number): [number, number][] | undefined {
        const g = graphs[u]
        const n = getNode(g, node)!
        if (effect(n.op) && slot === 0) return []
        if (n.op === NodeOp.after) return slot === countIds(n) - 1 ? [[u, node]] : []
        if (n.op === NodeOp.select) return slot > 0 ? [[u, node]] : []
        if (n.op === NodeOp.mem || n.op === NodeOp.inlined) return slot === 0 ? [[u, node]] : undefined
        if (n.op === NodeOp.apply) return slot > 0 ? [[u, getBlock(g, getRef(n, 0))!.params[slot - 1]]] : undefined
        if (n.op === NodeOp.ret) {
            const region = regionRets(g).get(node)
            if (region !== undefined) return [[u, region]]
            return rooted[u] ? [] : callers[u]
        }
        if (n.op === NodeOp.eq || n.op === NodeOp.ne) return countIds(n) === 2 && nonzeroLiteral(g, n, 1 - slot) ? [] : undefined
        if (n.op === NodeOp.add && typeOf(n) === Types.unknown_number && units[u].nodes.get(node)?.kind !== 'number') return
        if (NumericOps.has(n.op) || n.op === NodeOp.convert || n.op === NodeOp.bitconvert) return []
        if (n.op === NodeOp.load) return slot === 1 || slot === 2 ? [] : undefined
        const slice = rt.sliceOf(g, n)
        if (slice === rt.Op.slice) return slot === 2 ? [] : undefined
        if (slice === rt.Op.sliceRead) return slot === 3 ? [] : undefined
        if (slice === rt.Op.sliceWrite) {
            if (slot === 3) return []
            const touched = touchedOf.get(units[u])!.get(node)
            if (slot !== 4 || !touched) return
            return touched.flatMap(allocation => readers.get(bufferGroup(allocation)) ?? [])
        }
        if (slot < firstNonOrderingSlot(n)) return []
        if (truthTest(g, n) || (n.op === NodeOp.rt && arithmeticRt.has(getLiteral(g, n, 1)))) return []
        if (n.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.addOrConcat && (slot === 2 || slot === 3) && numericOperand(u, n, 5 - slot)) return []
        if (n.op === NodeOp.store && slot === 3 && typeOf(n) !== Types.vm_value) return []
        if (n.op === NodeOp.getProp && slot === 1) return []
        if (n.op === NodeOp.setProp && slot === 3 && fieldGroups.has(at(u, node))) return [...fieldGroups.get(at(u, node))!.flatMap(group => fieldReaders.get(group) ?? []), ...fieldBuffers.get(at(u, node))!.flatMap(group => readers.get(group) ?? [])]
        if (n.op === NodeOp.setProp && slot === 3 && types.fieldStores.has(`${unitIdentity(units[u].fn)}:${node}`)) return
        if (n.op === NodeOp.call || n.op === NodeOp.rt || n.op === NodeOp.getProp || n.op === NodeOp.setProp) return calleeTargets(u, node, n, slot)
    }
    function numericOperand(u: number, n: GraphNode, at: number): boolean {
        const ref = getRef(n, at)
        if (!ref) return typeof getLiteral(graphs[u], n, at) === 'number'
        return getNode(graphs[u], ref)?.op === NodeOp.literal || units[u].nodes.get(ref)?.kind === 'number'
    }
    function observes(u: number, node: number, slot: number): boolean {
        const targets = targetsOf(u, node, slot)
        if (!targets) return true
        for (const [t, id] of targets) {
            const rep = units[t].nodes.get(id)
            if (rep && rep.nullable && !undefinedCarrier(rep) && rep.kind !== 'undefined') return true
        }
        return false
    }
    const seen = new Set<number>()
    const work: [number, number][] = []
    function need(u: number, id: number): void {
        if (!id || !undefinedCarrier(units[u].nodes.get(id))) return
        if (seen.has(at(u, id))) return
        seen.add(at(u, id))
        units[u].observed.add(id)
        work.push([u, id])
    }
    const observedGroups = new Set<number>()
    function observe(group: number): void {
        if (observedGroups.has(group)) return
        observedGroups.add(group)
        for (const [w, value] of writers.get(group) ?? []) need(w, value)
    }
    for (const [group, members] of bufferGroups) {
        if (members.some(id => types.objects[id].constant) || !inst.collapses(members)) observe(group)
    }
    units.forEach((unit, u) => {
        const users = usersOf(graphs[u])
        for (const [id, rep] of unit.nodes) {
            if (!undefinedCarrier(rep)) continue
            for (const [user, slot] of users.get(id) ?? []) {
                if (!observes(u, user, slot)) continue
                need(u, id)
                break
            }
        }
    })
    while (work.length) {
        const [u, id] = work.pop()!
        const unit: PlannedUnit = units[u]
        const g = graphs[u]
        const n = getNode(g, id)
        if (!n) continue
        if (n.op === NodeOp.param) {
            const slotOf = paramSlots(g).get(id)
            if (!slotOf) continue
            const [block, i] = slotOf
            for (const apply of predsOf(g, block)) need(u, getRef(getNode(g, apply)!, i + 1))
            if (block !== g.blocks[0]) continue
            const position = plainOf(g).indexOf(id)
            if (position < 0) continue
            const incoming: [number, number][] = callers[u]
            for (const [caller, node] of incoming) {
                const call = getNode(graphs[caller], node)!
                if (truthTest(graphs[caller], call)) continue
                const first = firstArg(call, plainOf(g).length)
                if (first >= 0 && first + position < countIds(call)) need(caller, getRef(call, first + position))
            }
            continue
        }
        if (n.op === NodeOp.after) {
            need(u, getRef(n, countIds(n) - 1))
            continue
        }
        if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) need(u, getRef(n, i))
            continue
        }
        if (n.op === NodeOp.mem) {
            need(u, getRef(n, 0))
            continue
        }
        if (n.op === NodeOp.inlined) {
            need(u, getRef(n, 0))
            for (const [ret, root] of regionRets(g)) if (root === id) need(u, getRef(getNode(g, ret)!, 0))
            continue
        }
        const slice = rt.sliceOf(g, n)
        if (slice === rt.Op.sliceRead) {
            for (const allocation of touchedOf.get(unit)!.get(id) ?? []) observe(bufferGroup(allocation))
            continue
        }
        if (slice !== undefined) continue
        if (n.op === NodeOp.getProp && fieldGroups.has(at(u, id))) {
            for (const group of fieldGroups.get(at(u, id))!) {
                if (observedFields.has(group)) continue
                observedFields.add(group)
                for (const [w, value] of fieldWriters.get(group) ?? []) need(w, value)
            }
            for (const group of fieldBuffers.get(at(u, id))!) observe(group)
        }
        for (const callee of unit.calls.get(id) ?? []) {
            const c = index.get(callee)!
            for (const ret of retsOf(graphs[c])) if (!regionRets(graphs[c]).has(ret)) need(c, getRef(getNode(graphs[c], ret)!, 0))
        }
    }
    types.objects.forEach((_, id) => {
        if (observedGroups.has(bufferGroup(id))) observed.add(id)
    })
    return observed
}

function numericType(type: Type): boolean {
    return type.literals.length > 0 || opaqueNumber(type)
}

function opaqueNumber(type: Type): boolean {
    return !!type.range || type.float
}

function congruence(types: ValueTypes, callees: Map<string, number[]>): (a: number) => number {
    const parent = types.frames.map((_, i) => i)
    const find = (a: number) => rootOf(parent, a)
    const sitesOf = new Map<number, Map<string, number>>()
    const pending: [number, number][] = []
    const indirect = new Map<string, number>()
    for (const list of callees.values()) {
        const fns = new Set(list.map(id => unitIdentity(types.frames[id].unit)))
        if (fns.size < 2) continue
        for (const id of list) {
            const frame = types.frames[id]
            const receiver = frame.params.find(p => p.label === 'this')?.type.objects ?? []
            const value = `${unitIdentity(frame.unit)}|${receiver.join(',')}`
            const known = indirect.get(value)
            if (known === undefined) indirect.set(value, id)
            else pending.push([known, id])
        }
    }
    for (const [k, list] of callees) {
        const [caller, node] = k.split('|')
        const sites = mapOf(sitesOf, Number(caller))
        for (const id of list) {
            const site = `${node}|${unitIdentity(types.frames[id].unit)}`
            const known = sites.get(site)
            if (known === undefined) sites.set(site, id)
            else pending.push([known, id])
        }
    }
    function drain(): void {
        while (pending.length) {
            const [x, y] = pending.pop()!
            const rx = find(x)
            const ry = find(y)
            if (rx === ry) continue
            parent[ry] = rx
            const from = sitesOf.get(ry)
            sitesOf.delete(ry)
            if (!from) continue
            const into = sitesOf.get(rx)
            if (!into) {
                sitesOf.set(rx, from)
                continue
            }
            for (const [site, f] of from) {
                const known = into.get(site)
                if (known === undefined) into.set(site, f)
                else pending.push([known, f])
            }
        }
    }
    drain()
    return find
}

export interface Embeddings {
    fields: Map<string, Map<string, string>>
    sites: Map<PlannedUnit, Map<number, string>>
}

export function planEmbeddings(types: ValueTypes, inst: Instantiations, plan: Map<Function, PlannedUnit[]>): Embeddings {
    const holders = new Map<number, [number, string][]>()
    types.objects.forEach((object, id) => {
        for (const [key, field] of object.fields) for (const inner of field.type.objects) {
            const list = listOf(holders, inner)
            list.push([id, key])
        }
    })
    const returned = new Set(types.frames.flatMap(frame => frame.returns.objects.filter(id => receiverOf(frame) !== id)))
    const sameSite = (a: number, b: number) => types.objects[a].site.unit === types.objects[b].site.unit && types.objects[a].site.node === types.objects[b].site.node
    const onlyObjects = (t: Type) => !t.undefined && !t.strings.length && !t.unknown && !numericType(t) && !t.functions.length && !t.closures.length && t.objects.length > 0
    function owner(inner: number): [number, string] | undefined {
        const object = types.objects[inner]
        if (object.constant || object.native || object.kind === AllocKind.buffer || returned.has(inner)) return
        const holding = holders.get(inner) ?? []
        const held = holding.filter(([id]) => framesOf(object).some(frame => receiverOf(types.frames[frame]) === id))
        if (held.length !== 1) return
        const [parent, key] = held[0]
        const outer = types.objects[parent]
        if (outer.constant || outer.native || (holding.length > 1 && !outer.fields.get(key)?.constructed)) return
        const type = outer.fields.get(key)!.type
        if (!onlyObjects(type) || !type.objects.every(id => sameSite(id, inner))) return
        return [parent, key]
    }
    const fields = new Map<string, Map<string, string>>()
    for (const [holderShape, sig] of inst.shapes) {
        const byKey = new Map<string, string>()
        for (const [key] of sig.fields) {
            let inner: string | undefined
            const embeds = sig.members.length > 0 && sig.members.every(m => {
                const t = types.objects[m].fields.get(key)?.type
                return !!t && onlyObjects(t) && t.objects.every(id => {
                    const heldShape = inst.shapeOf(id)
                    if (owner(id)?.[0] !== m || heldShape === undefined || heldShape === holderShape || (inner !== undefined && inner !== heldShape)) return false
                    inner = heldShape
                    return true
                })
            })
            if (embeds && inner !== undefined) byKey.set(key, inner)
        }
        if (byKey.size) fields.set(holderShape, byKey)
    }
    const unitOfFrame = new Map<number, PlannedUnit>()
    const unitIndex = new Map<PlannedUnit, number>()
    for (const units of plan.values()) for (const unit of units) {
        unitIndex.set(unit, unitIndex.size)
        for (const f of unit.frames) unitOfFrame.set(f, unit)
    }
    const keys = new Map<string, Set<string>>()
    const placed = new Map<string, [PlannedUnit, number]>()
    types.objects.forEach((object, id) => {
        for (const frame of framesOf(object)) {
            const unit = unitOfFrame.get(frame)
            if (!unit || !unit.allocations.has(object.site.node)) continue
            const k = `${unitIndex.get(unit)}|${object.site.node}`
            const found = owner(id)
            const holderShape = found ? inst.shapeOf(found[0]) : undefined
            const key = found && holderShape !== undefined && fields.get(holderShape)?.get(found[1]) === inst.shapeOf(id) ? `${holderShape}.${found[1]}` : ''
            let set = keys.get(k)
            if (!set) keys.set(k, set = new Set())
            set.add(key)
            placed.set(k, [unit, object.site.node])
        }
    })
    for (const set of keys.values()) {
        if (set.size < 2) continue
        for (const key of set) {
            if (!key) continue
            const [holderShape, field] = [key.slice(0, key.indexOf('.')), key.slice(key.indexOf('.') + 1)]
            fields.get(holderShape)?.delete(field)
        }
    }
    const sites = new Map<PlannedUnit, Map<number, string>>()
    for (const [k, set] of keys) {
        const [key] = [...set]
        if (set.size !== 1 || !key || !fields.get(key.slice(0, key.indexOf('.')))?.has(key.slice(key.indexOf('.') + 1))) continue
        const [unit, node] = placed.get(k)!
        const map = mapOf(sites, unit)
        map.set(node, key.slice(key.indexOf('.') + 1))
    }
    return { fields, sites }
}
interface Moves {
    words: Set<number>
    elements: ElementReads
}

export type ElementReads = Set<Handle> | 'all'

function movesOf(g: Graph): Moves {
    const known = moveSets.get(g)
    if (known) return known
    const users = usersOf(g)
    function movedBy(passing: boolean): (id: number) => boolean {
        const memo = new Map<number, boolean>()
        function moved(id: number): boolean {
            const done = memo.get(id)
            if (done !== undefined) return done
            memo.set(id, false)
            const result = (users.get(id) ?? []).every(([user, slot]) => {
                const n = getNode(g, user)!
                if (n.op === NodeOp.after) return slot < countIds(n) - 1 || moved(user)
                if (slot === 0 && (n.op === NodeOp.load || n.op === NodeOp.store || n.op === NodeOp.getProp || n.op === NodeOp.setProp || n.op === NodeOp.call || rt.sliceOf(g, n) !== undefined)) return true
                if (n.op === NodeOp.store) return slot === 3 && resultType(g, n) === Types.vm_value
                if (rt.sliceOf(g, n) === rt.Op.sliceWrite) return slot === 4 && wordStore(g, n)
                if (n.op === NodeOp.setProp) return passing && slot === 3
                if (n.op === NodeOp.call) return passing && slot >= 3
                return n.op === NodeOp.ret && slot === 0
            })
            memo.set(id, result)
            return result
        }
        return moved
    }
    const moved = movedBy(true)
    const kept = movedBy(false)
    const words = new Set<number>()
    let elements: ElementReads = new Set<Handle>()
    for (const [id, n] of nodeEntries(g)) {
        const load = wordLoad(g, n)
        const read = n.op === NodeOp.load || rt.sliceOf(g, n) === rt.Op.sliceRead
        if (read && elements !== 'all' && !(load && kept(id))) {
            const base = getNode(g, getRef(n, n.op === NodeOp.load ? 1 : 2))
            if (base?.op === NodeOp.load || (base && rt.sliceOf(g, base) === rt.Op.sliceRead)) elements = 'all'
            else if (base?.op === NodeOp.getProp && !getRef(base, 2)) elements.add(getLiteral(g, base, 2) as Handle)
        }
        if ((load || n.op === NodeOp.getProp || n.op === NodeOp.call || g.blocks[0].params.includes(id)) && moved(id)) words.add(id)
    }
    const out = { words, elements }
    moveSets.set(g, out)
    return out
}
const moveSets = new WeakMap<Graph, Moves>()

function shapeTarget(target: string): boolean {
    return target.startsWith('S')
}

export function dereferenceableRep(rep: Rep | undefined): boolean {
    return !!rep && rep.kind === 'pointer' && !rep.nullable && !rep.encoded && memberCount(rep) === 1 && rep.shapes.length === 1
}

function rawElement(element: Rep): boolean {
    if (element.kind === 'number') return (!element.format || element.format.bits === 64) && !element.nullable
    return element.kind === 'pointer' && element.shapes.length > 0 && memberCount(element) === element.shapes.length && !element.constant
}

export function elementTagged(element: Rep): boolean {
    return !element.encoded && element.kind === 'number' && element.nullable
}

export interface SlotCodec {
    text: string
    word: boolean
    boxed: boolean
    nullable: 'tag' | 'word' | undefined
    float: boolean
}

const slotCodecs = new Map<string, SlotCodec>()

export function slotCodec(element: Rep, word: boolean): SlotCodec {
    const boxed = !!element.encoded && element.kind === 'number' && numberName(element) === 'f64'
    const nullable = elementTagged(element) ? 'tag' : element.encoded && element.nullable ? 'word' : undefined
    const float = floatUnion(element)
    const text = `${word ? 'word' : 'raw'}${boxed ? ' boxed' : ''}${nullable ? ` nullable:${nullable}` : ''}${float ? ' float' : ''}`
    let known = slotCodecs.get(text)
    if (!known) slotCodecs.set(text, known = { text, word, boxed, nullable, float })
    return known
}

export function elementWidth(element: Rep): number {
    if (element.inline) return 8 * element.inline.length
    if (element.encoded) return 4
    if (floatUnion(element)) return 24
    if (elementTagged(element)) return 16
    if (element.kind === 'number' && element.format) return 8
    return rawElement(element) ? 8 : 4
}

export function isStringRep(rep: Rep | undefined): boolean {
    return rep?.kind === 'pointer' && rep.members === RepMember.string && memberCount(rep) === 1
}

export function memberCount(rep: Rep): number {
    let count = rep.shapes.length
    if (rep.closure !== undefined) count++
    let bits = rep.members
    while (bits) {
        count += bits & 1
        bits >>= 1
    }
    return count
}

function memberNames(rep: Rep, shape: (id: string) => string, closure: (state: Handle) => string): string[] {
    const names = rep.shapes.map(shape)
    if (rep.members & RepMember.buffer) names.push('buf')
    if (rep.members & RepMember.string) names.push('str')
    if (rep.members & RepMember.dynamic) names.push('heap')
    if (rep.closure !== undefined) names.push(closure(rep.closure))
    if (rep.members & RepMember.function) names.push('fn')
    return names
}

function closureName(state: Handle): string {
    return `clo@${state}`
}

export function sameRep(a: Rep, b: Rep, integers = false): boolean {
    if (a === b) return true
    if (!!a.encoded !== !!b.encoded || !!a.inline !== !!b.inline || !!a.bit !== !!b.bit || !!a.tested !== !!b.tested) return false
    if (a.inline) return a.shapes[0] === b.shapes[0]
    if (a.bit) return true
    const fn = a.constant?.fn
    if (fn || b.constant?.fn) return fn === b.constant?.fn
    if (a.tested) return a.nullable === b.nullable
    const literal = a.constant?.literal
    if (literal !== undefined || b.constant?.literal !== undefined) return literal === b.constant?.literal && !!a.bools === !!b.bools && a.nullable === b.nullable
    if (a.kind !== b.kind) return false
    if (a.kind !== 'undefined' && a.constant?.handle !== b.constant?.handle) return false
    if (a.forms || b.forms) return !!a.forms && !!b.forms && a.nullable === b.nullable && a.forms.length === b.forms.length && a.forms.every((form, i) => form === b.forms![i])
    switch (a.kind) {
        case 'number': return a.nullable === b.nullable && !!a.bools === !!b.bools && (!!a.bools || (integers ? !a.format === !b.format : numberName(a) === numberName(b)))
        case 'union': return a.float ? !!b.float && sameRep(a.other!, b.other!, integers) : !b.float && !!a.bools === !!b.bools && sameTargets(a, b)
        case 'pointer': return a.nullable === b.nullable && !!a.zero === !!b.zero && sameTargets(a, b)
        case 'buffer': return a.nullable === b.nullable && sameRep(a.element!, b.element!)
        default: return true
    }
}

function sameFields(a: [string, Rep][], b: [string, Rep][]): boolean {
    return a.length === b.length && a.every(([k, rep], i) => b[i][0] === k && sameRep(rep, b[i][1]))
}

function sameTargets(a: Rep, b: Rep): boolean {
    return a.members === b.members && a.closure === b.closure && a.shapes.length === b.shapes.length && a.shapes.every((shape, i) => shape === b.shapes[i])
}

export function repText(rep: Rep | undefined, missing = 'no rep'): string {
    if (!rep) return missing
    if (rep.encoded) return `enc<${repText({ ...rep, encoded: undefined })}>`
    if (rep.inline) return `rec<${rep.shapes[0]}>`
    if (rep.bit) return 'u1'
    if (rep.constant?.fn) return `fn@${rep.constant.fn.name || '<anon>'}`
    const nullable = rep.nullable ? '?' : ''
    if (rep.tested) return `truth${nullable}`
    const literal = rep.constant?.literal
    if (literal !== undefined) return `${!rep.bools ? `#${literal}` : literal ? '#true' : '#false'}${nullable}`
    if (rep.constant?.handle !== undefined && rep.kind !== 'undefined') return `${repText({ ...rep, constant: undefined })}@${rep.constant.handle}`
    if (rep.forms) return `${rep.forms.join('|')}${nullable}`
    const names = memberNames(rep, id => id, closureName)
    const targets = names.join('|')
    switch (rep.kind) {
        case 'number': return `${rep.bools ? 'bool' : numberText(rep.format)}${nullable}`
        case 'union': return rep.float ? `union<f64|${repText(rep.other!)}>` : `union<${rep.bools ? [...names, 'bool'].join('|') : targets}>`
        case 'pointer': return `ptr<${targets}>${rep.zero ? '|0' : nullable}`
        case 'buffer': return `buf<${rep.element ? repText(rep.element) : ''}>${nullable}`
        default: return rep.kind
    }
}

export function shapeSignatureText(sig: ShapeSignature): string {
    return `${sig.name}{${sig.fields.map(([k, rep]) => `${k}: ${repText(rep)}`).join(', ')}}`
}

export function unitSignatureText(unit: PlannedUnit): string {
    const made = [...new Set([...unit.allocations].map(([node, shape]) => `%${node}=${shape}`))].sort()
    return `(${unit.params.map(param => `${param.label}: ${repText(param.rep)}`).join(', ')}) -> ${repText(unit.returns)}${made.length ? ` new ${made.join(' ')}` : ''}`
}

export enum Representation {
    none,
    constant,
    int,
    f64,
    flag,
    condition,
    string,
    object,
    tagged,
    taggedNumber,
    narrowNumber,
    floatRecord,
    dynamic,
    wildcard,
    handle,
}

export enum Address {
    pstack,
    memory,
    heap,
    embedded,
}

export enum Storage {
    record,
    dictionary,
    buffer,
    function,
}

export interface ObjectRepresentation {
    address: Address
    storage: Storage
    layout?: string
    state?: Handle
    element?: BoundaryRepresentation
}

export interface BoundaryRepresentation {
    representation: Representation
    format?: IntFormat
    width?: number
    absent?: boolean
    objects?: ObjectRepresentation[]
    inner?: BoundaryRepresentation
}

const representationNames = ['none', 'constant', 'int', 'f64', 'flag', 'condition', 'string', 'object', 'tagged', 'taggedNumber', 'narrowNumber', 'floatRecord', 'dynamic', 'wildcard', 'handle']
const addressNames = ['pstack', 'memory', 'heap', 'embedded']
const storageNames = ['record', 'dictionary', 'buffer', 'function']

function objectRepresentations(rep: Rep): ObjectRepresentation[] {
    const objects: ObjectRepresentation[] = rep.shapes.map(layout => ({ address: Address.pstack, storage: Storage.record, layout }))
    if (rep.members & RepMember.buffer) objects.push({ address: Address.memory, storage: Storage.buffer })
    if (rep.members & RepMember.dynamic) objects.push({ address: Address.heap, storage: Storage.dictionary })
    if (rep.closure !== undefined) objects.push({ address: Address.pstack, storage: Storage.record, state: rep.closure })
    if (rep.members & RepMember.function) objects.push({ address: Address.pstack, storage: Storage.function })
    return objects
}

export function representationOf(rep: Rep): BoundaryRepresentation {
    if (rep.tested) return { representation: Representation.condition }
    if (rep.bit) return { representation: Representation.flag }
    if (rep.encoded) return { representation: Representation.tagged, objects: objectRepresentations(rep) }
    if (rep.inline) return { representation: Representation.object, objects: [{ address: Address.embedded, storage: Storage.record, layout: rep.shapes[0] }] }
    if (rep.kind === 'never') return { representation: Representation.none }
    if (rep.kind === 'undefined') return { representation: Representation.constant }
    if (rep.kind === 'any') return { representation: Representation.dynamic }
    if (rep.kind === 'number') {
        const value = rep.format ? { representation: Representation.int, format: rep.format } : { representation: Representation.f64 }
        return rep.nullable ? { representation: Representation.taggedNumber, inner: value } : value
    }
    if (rep.kind === 'union' && rep.float) return { representation: Representation.floatRecord, inner: representationOf(rep.other!) }
    if (rep.kind === 'union') return { representation: Representation.tagged, objects: objectRepresentations(rep) }
    if (rep.kind === 'buffer') return { representation: Representation.object, absent: rep.nullable, objects: [{ address: Address.memory, storage: Storage.buffer, element: representationOf(rep.element!) }] }
    if (rep.members & RepMember.string && memberCount(rep) > 1) return { representation: Representation.tagged, objects: objectRepresentations(rep) }
    if (rep.members & RepMember.string) return { representation: Representation.string, absent: rep.nullable }
    return { representation: Representation.object, absent: rep.nullable, objects: objectRepresentations(rep) }
}

export function sameRepresentation(a: BoundaryRepresentation | undefined, b: BoundaryRepresentation | undefined): boolean {
    if (!a || !b) return a === b
    if (a.representation !== b.representation || a.width !== b.width || !!a.absent !== !!b.absent) return false
    if (a.format?.bits !== b.format?.bits || a.format?.signed !== b.format?.signed) return false
    if (!sameRepresentation(a.inner, b.inner)) return false
    const x = a.objects ?? []
    const y = b.objects ?? []
    return x.length === y.length && x.every((object, i) => object.address === y[i].address && object.storage === y[i].storage && object.layout === y[i].layout && object.state === y[i].state && sameRepresentation(object.element, y[i].element))
}

export function representationText(boundary: BoundaryRepresentation | undefined): string {
    if (!boundary) return '-'
    const format = boundary.format ? `${boundary.format.signed ? 'i' : 'u'}${boundary.format.bits}` : ''
    const inner = boundary.inner ? `<${representationText(boundary.inner)}>` : ''
    const objects = boundary.objects?.length ? `[${boundary.objects.map(objectText).join(' | ')}]` : ''
    return `${representationNames[boundary.representation]}${format}${inner}${objects}${boundary.width !== undefined ? `/${boundary.width}` : ''}${boundary.absent ? '?' : ''}`
}

function objectText(object: ObjectRepresentation): string {
    const layout = object.layout ?? (object.state !== undefined ? `@${object.state}` : '')
    return `${addressNames[object.address]}:${storageNames[object.storage]}${layout ? ` ${layout}` : ''}${object.element ? ` of ${representationText(object.element)}` : ''}`
}

function movedClass(rep: Rep, param: boolean, reduced: (shape: string) => boolean, boxed: boolean): string {
    if (boxed && isStringRep(rep)) return 'string-word'
    if (boxed && rep.kind === 'number' && rep.bools) return 'bool-word'
    if (numberName(rep) === 'int' || (rep.kind === 'undefined' && !param) || isStringRep(rep)) return 'word'
    if (rep.kind === 'number') return numberText(rep.format)
    return `${repKey(rep, id => reduced(id) ? 'SR' : 'S', state => reducedShape(state) ? 'cloR' : 'clo')}${rep.fresh ? '!' : ''}`
}

export function argumentKey(rep: Rep): string {
    return repKey(rep.kind === 'pointer' ? { ...rep, nullable: false } : rep, id => id, closureName)
}

function repKey(rep: Rep, shape: (id: string) => string, closure: (state: Handle) => string): string {
    const nullable = rep.zero ? '|0' : rep.nullable ? '?' : ''
    const targets = memberNames(rep, shape, closure).join('|')
    switch (rep.kind) {
        case 'number': return `${numberText(rep.format)}${nullable}`
        case 'pointer': return !rep.constant ? `ptr<${targets}>${nullable}` : rep.constant.fn ? `fn@${unitIdentity(rep.constant.fn)}` : `ptr<${memberNames(rep, id => id, closureName).join('|')}>${nullable}@${rep.constant.handle}`
        case 'union': return `union<${targets}>`
        case 'buffer': return `buf<${rep.element!.encoded ? `enc<${repKey(rep.element!, shape, closure)}>` : repKey(rep.element!, shape, closure)}>${nullable}`
        case 'any': return rep.forms ? rep.forms.join('|') : 'any'
        default: return rep.kind
    }
}

export function shareClasses(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => string, reduced: (shape: string) => boolean, sites: Map<PlannedUnit, Map<number, Handle>>, abiOf: (unit: PlannedUnit) => string, graphOf: (fn: Function) => Graph): Map<PlannedUnit, number> {
    const byNode = <T>(map: Map<number, T>, show: (value: T) => string) => [...map].sort((a, b) => a[0] - b[0]).map(([node, value]) => `%${node}:${show(value)}`).join(' ')
    const units = [...plan.values()].flat()
    const intern = (keyOf: (unit: PlannedUnit) => string): [Map<PlannedUnit, number>, number] => {
        const ids = new Map<string, number>()
        const out = new Map<PlannedUnit, number>()
        for (const unit of units) {
            const k = keyOf(unit)
            let id = ids.get(k)
            if (id === undefined) ids.set(k, id = ids.size)
            out.set(unit, id)
        }
        return [out, ids.size]
    }
    const parts = (unit: PlannedUnit) => {
        const g = graphOf(unit.fn)
        const { words: moved, elements } = movesOf(g)
        const view = (rep: Rep) => `${repKey(rep, id => layoutOf(id, elements), closureName)}${rep.fresh ? '!' : ''}`
        const value = (rep: Rep) => rep.kind === 'number' ? numberText(rep.format) : view(rep)
        const node = (rep: Rep) => rep.kind === 'pointer' && rep.members === RepMember.buffer && memberCount(rep) === 1 ? 'int' : value(rep)
        const opaque = (rep: Rep, param: boolean) => movedClass(rep, param, reduced, [...unit.codecs.values()].some(codec => codec.word))
        const entry = g.blocks[0].params
        const wide = (id: number) => unit.slices.has(id) && elementWidth(unit.slices.get(id)!) === 8
        const read = (id: number) => getNode(g, id)!.op === NodeOp.load || rt.sliceOf(g, getNode(g, id)!) === rt.Op.sliceRead
        const decoded = (id: number) => !!unit.codecs.get(id)?.word && read(id) && unit.nodes.get(id)!.kind !== 'union'
        const keyed = (id: number) => !moved.has(id) || !read(id) || wide(id) || decoded(id)
        return [
            unitIdentity(unit.fn), byNode(unit.codecs, codec => codec.text), unit.returnsSelf, !!unit.returns.tested,
            `${unit.params.map((p, i) => `${p.label}:${moved.has(entry[i]) ? opaque(p.rep, true) : value(p.rep)}`).join(',')}->${abiOf(unit)}${floatUnion(unit.returns) ? view(unit.returns) : ''}`,
            byNode(unit.allocations, shape => shapeTarget(shape) ? layoutOf(shape, elements) : shape), byNode(sites.get(unit) ?? new Map<number, Handle>(), k => String(k)),
            [...unit.blocks].sort((a, b) => a - b).join(','), byNode(unit.deadArms, arms => arms.join(',')), byNode(unit.coercions, mask => String(mask)), byNode(unit.slices, element => `${elementWidth(element)}${numberName(element) === 'f64' ? 'f' : ''}`), byNode(new Map([...unit.nodes].filter(([id]) => keyed(id)).map(([id, rep]) => [id, decoded(id) ? `dec:${value(rep)}` : moved.has(id) ? `${opaque(rep, entry.includes(id))}${wide(id) ? '8' : ''}` : node(rep)])), x => x),
        ]
    }
    let [classes, count] = intern(unit => parts(unit).join('|'))
    while (true) {
        const [next, size] = intern(unit => `${classes.get(unit)}|${byNode(unit.calls, set => [...new Set([...set].map(c => classes.get(c)))].sort().join(','))}`)
        classes = next
        if (size === count) break
        count = size
    }
    if (intrinsics.argv().includes('share-debug')) for (const list of plan.values()) for (const unit of list) console.log('SHARE-PARTS', unit.fn.name, list.indexOf(unit), JSON.stringify(parts(unit).map(String)))
    return classes
}

export function shareUnits(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => string, reduced: (shape: string) => boolean, sites: Map<PlannedUnit, Map<number, Handle>>, abiOf: (unit: PlannedUnit) => string, graphOf: (fn: Function) => Graph): Map<PlannedUnit, PlannedUnit> {
    const classes = shareClasses(plan, layoutOf, reduced, sites, abiOf, graphOf)
    const units = [...plan.values()].flat()
    const shared = new Map<PlannedUnit, PlannedUnit>()
    const kept = new Map<number, PlannedUnit>()
    for (const [fn, list] of plan) plan.set(fn, list.filter(unit => {
        const first = kept.get(classes.get(unit)!)
        if (!first) {
            kept.set(classes.get(unit)!, unit)
            return true
        }
        first.frames.push(...unit.frames)
        shared.set(unit, first)
        return false
    }))
    for (const unit of units) for (const [node, set] of unit.calls) unit.calls.set(node, new Set([...set].map(c => shared.get(c) ?? c)))
    for (const unit of shared.keys()) sites.delete(unit)
    return shared
}

const identities = new WeakMap<Function, number>()
let nextIdentity = 0
function unitIdentity(fn: Function): number {
    let id = identities.get(fn)
    if (id === undefined) identities.set(fn, id = nextIdentity++)
    return id
}

const regionMaps = new WeakMap<Graph, Map<number, number>>()
export function regionRets(g: Graph): Map<number, number> {
    let known = regionMaps.get(g)
    if (known) return known
    known = new Map()
    const blocks = new Map(g.blocks.map(b => [b.id, b]))
    for (const [root, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.inlined) continue
        const seen = new Set<number>()
        const stack = [getRef(n, 0)]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const m = getNode(g, id)
            if (!m) continue
            if (m.op === NodeOp.ret) known.set(id, root)
            else if (m.op === NodeOp.select) for (let i = 1; i < countIds(m); i++) stack.push(getRef(m, i))
            else if (m.op === NodeOp.after) stack.push(getRef(m, countIds(m) - 1))
            else if (m.op === NodeOp.apply) stack.push(blocks.get(getRef(m, 0))?.bodyId ?? 0)
        }
    }
    regionMaps.set(g, known)
    return known
}

export type Block = Graph['blocks'][number]

export function effect(op: NodeOp): boolean {
    return op === NodeOp.setProp || op === NodeOp.getProp || op === NodeOp.call || op === NodeOp.rt || op === NodeOp.store || op === NodeOp.load
}

const retLists = new WeakMap<Graph, number[]>()
export function retsOf(g: Graph): number[] {
    let known = retLists.get(g)
    if (!known) {
        known = []
        for (const [id, n] of nodeEntries(g)) {
            if (n.op === NodeOp.ret) known.push(id)
        }
        retLists.set(g, known)
    }
    return known
}

const addressKey = heap.fromJsString('__address')
function addressView(object: ObjectType): boolean {
    return object.state !== undefined && heap.ownPropertyCount(object.state) === 1 && !!heap.getOwnProperty(object.state, addressKey)
}

export function selfOf(g: Graph): number {
    for (const p of g.blocks[0].params) if (isThisParam(getNode(g, p)!)) return p
    return 0
}

export function returnsSelf(g: Graph): boolean {
    const self = selfOf(g)
    for (const n of allNodes(g)) if (n.op === NodeOp.ret && getRef(n, 0) && valueTail(g, getRef(n, 0)) !== self) return false
    return true
}

export function valueTail(g: Graph, id: number): number {
    let n = getNode(g, id)
    while (n?.op === NodeOp.after) {
        id = getRef(n, countIds(n) - 1)
        n = getNode(g, id)
    }
    return id
}

export function blockOf(g: Graph, id: number): Block | undefined {
    const n = getNode(g, id)
    if (n?.op === NodeOp.ret) {
        const owner = g.blocks.find(b => b.id === getRef(n, 1))
        if (owner) return owner
    }
    return g.blocks.find(b => bodyNodes(g, b.bodyId).has(id))
}

const paramSlotMaps = new WeakMap<Graph, Map<number, [Block, number]>>()
function paramSlots(g: Graph): Map<number, [Block, number]> {
    const known = paramSlotMaps.get(g)
    if (known) return known
    const out = new Map<number, [Block, number]>()
    for (const block of g.blocks) block.params.forEach((param, i) => out.set(param, [block, i]))
    paramSlotMaps.set(g, out)
    return out
}

export function predsOf(g: Graph, block: Block): number[] {
    return (usersOf(g).get(block.id) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
}

function successorsOf(g: Graph, block: Block): Block[] {
    const out: Block[] = []
    for (const id of bodyNodes(g, block.bodyId)) {
        const n = getNode(g, id)
        if (n?.op !== NodeOp.apply) continue
        const target = getBlock(g, getRef(n, 0))
        if (target) out.push(target)
    }
    return out
}

export function reaches(g: Graph, from: Block, to: Block): boolean {
    const seen = new Set<number>()
    const work = [from]
    while (work.length) {
        const next = work.pop()!
        if (next.id === to.id) return true
        if (seen.has(next.id)) continue
        seen.add(next.id)
        work.push(...successorsOf(g, next))
    }
    return false
}

function repeats(g: Graph, block: Block, id: number): boolean {
    const guards = armsAt(g, id) ?? []
    for (const member of bodyNodes(g, block.bodyId)) {
        const n = getNode(g, member)
        if (n?.op !== NodeOp.apply) continue
        const other = armsAt(g, member) ?? []
        if (other.some(([cond, positive]) => guards.some(([c, p]) => c === cond && p !== positive))) continue
        const target = getBlock(g, getRef(n, 0))
        if (target && reaches(g, target, block)) return true
    }
    return false
}

function receiverValue(g: Graph, id: number): boolean {
    const slots = paramSlots(g)
    const seen = new Set<number>()
    const work = [id]
    while (work.length) {
        const value = valueTail(g, work.pop()!)
        if (seen.has(value)) continue
        seen.add(value)
        const n = getNode(g, value)
        const slot = slots.get(value)
        if (n?.op !== NodeOp.param || !slot) return false
        const [block, index] = slot
        const preds = predsOf(g, block)
        if (block === g.blocks[0] && (!isThisParam(n) || preds.length)) return false
        for (const pred of preds) work.push(getRef(getNode(g, pred)!, index + 1))
    }
    return true
}

export interface PstackRegion {
    unit: PlannedUnit
    header: number
    call: number
    reason: string
    stacks: number[]
}

interface PstackProgram {
    types: ValueTypes
    units: PlannedUnit[]
    graphOf: (unit: PlannedUnit) => Graph
    unitOfFrame: Map<number, PlannedUnit>
    roots: Set<number>
    holders: Map<number, number[]>
    escaped: Set<number>
}

function pstackRefs(type: Type | undefined): number[] {
    if (!type) return []
    if (!type.closures.length) return type.objects
    return [...type.objects, ...type.closures]
}

function pstackProgram(types: ValueTypes, units: PlannedUnit[], graphOf: (unit: PlannedUnit) => Graph): PstackProgram {
    const unitOfFrame = new Map<number, PlannedUnit>()
    for (const unit of units) for (const f of unit.frames) unitOfFrame.set(f, unit)
    const roots = new Set<number>()
    const escaped = new Set<number>()
    const work: number[] = []
    const why = new Map<number, string>()
    let cause = 'root'
    const escape = (type: Type | undefined) => {
        for (const id of pstackRefs(type)) {
            if (escaped.has(id)) continue
            escaped.add(id)
            why.set(id, cause)
            work.push(id)
        }
    }
    types.frames.forEach((frame, id) => {
        if (frame.sites.some(site => site.frame !== undefined)) return
        roots.add(id)
        escape(frame.returns)
        for (const param of frame.params) escape(param.type)
    })
    for (const unit of units) {
        const g = graphOf(unit)
        const writes: [number, GraphNode][] = []
        for (const [id, n] of nodeEntries(g)) {
            if (n.op === NodeOp.setProp || n.op === NodeOp.store) writes.push([id, n])
            else if (n.op === NodeOp.rt && rt.sliceOf(g, n) === rt.Op.sliceWrite) writes.push([id, n])
            else if (n.op === NodeOp.call && !unit.calls.get(id)?.size) writes.push([id, n])
        }
        if (!writes.length) continue
        for (const f of unit.frames) {
            for (const [id, n] of writes) {
                cause = `${unit.fn.name}%${id}:${opName(n.op)}`
                if (n.op === NodeOp.setProp || n.op === NodeOp.store) {
                    const target = types.typeAt(f, getRef(n, 1))
                    if (!target || !target.objects.length || target.unknown) escape(types.typeAt(f, getRef(n, 3)))
                } else if (n.op === NodeOp.rt) {
                    const target = types.typeAt(f, getRef(n, 2))
                    if (!target || !target.objects.length || target.unknown) escape(types.typeAt(f, getRef(n, 4)))
                } else if (types.typeAt(f, id)) {
                    for (let i = 2; i < countIds(n); i++) escape(types.typeAt(f, getRef(n, i)))
                }
            }
        }
    }
    const holders = new Map<number, number[]>()
    types.objects.forEach((object, id) => {
        for (const field of object.fields.values()) for (const inner of pstackRefs(field.type)) listOf(holders, inner).push(id)
    })
    while (work.length) {
        const next = work.pop()!
        cause = `via O${next}`
        for (const field of types.objects[next].fields.values()) escape(field.type)
    }
    if (intrinsics.argv().includes('pstack-why')) for (const [id, c] of why) console.log(`PSTK2 escaped O${id} ${c}`)
    return { types, units, graphOf, unitOfFrame, roots, holders, escaped }
}

function pstackDemand(g: Graph): Map<number, number[]> {
    const demand = new Map<number, number[]>()
    for (const b of g.blocks) for (const id of bodyNodes(g, b.bodyId)) listOf(demand, id).push(b.id)
    return demand
}

function pstackStaying(g: Graph, members: Set<number>): Set<number> {
    const seen = new Set<number>()
    for (const m of members) {
        for (const p of tailPositions(g, getBlock(g, m)!.bodyId)) {
            const n = getNode(g, p.at)!
            if (n.op !== NodeOp.apply || !members.has(getRef(n, 0))) continue
            const stack = tailRoots(g, p)
            while (stack.length) {
                const id = stack.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const x = getNode(g, id)
                if (!x || x.op === NodeOp.param) continue
                for (let i = 0; i < countIds(x); i++) stack.push(getRef(x, i))
            }
        }
    }
    return seen
}

function pstackBefore(g: Graph, nest: GraphLoops, header: number): Set<number> {
    const before = new Set<number>()
    const work = [g.blocks[0].id]
    while (work.length) {
        const b = work.pop()!
        if (b === header || before.has(b)) continue
        before.add(b)
        for (const t of nest.tailTargets.get(b) ?? []) work.push(t)
    }
    return before
}

function pstackObjectName(types: ValueTypes, id: number): string {
    const object = types.objects[id]
    return `O${id}:${object.name}@${object.site.unit.name || '<anon>'}%${object.site.node}`
}

const PstackObjects = 1
const PstackBuffers = 2

interface PstackSummary {
    kinds: number
    need: number
    escaped: number
    witness: number
}

export function planPstackRegions(types: ValueTypes, units: PlannedUnit[], graphOf: (unit: PlannedUnit) => Graph, debug: boolean): PstackRegion[] {
    const start = performance.now()
    const P = pstackProgram(types, units, graphOf)
    const programmed = performance.now()
    const succ: number[][] = [[]]
    const pred: number[][] = [[]]
    const above: number[] = [0]
    const node = (up: number): number => {
        succ.push([])
        pred.push([])
        above.push(up)
        return succ.length - 1
    }
    const edge = (a: number, b: number) => {
        succ[a].push(b)
        pred[b].push(a)
    }
    const frameNode = new Map<number, number>()
    for (const unit of units) for (const f of unit.frames) frameNode.set(f, node(0))
    for (const f of P.roots) {
        const v = frameNode.get(f)
        if (v !== undefined) edge(0, v)
    }
    const callees = new Map<number, Map<number, number[]>>()
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) if (site.frame !== undefined) listOf(mapOf(callees, site.frame), site.node).push(id)
    })
    const loops: { unit: PlannedUnit, frame: number, header: number, node: number, depth: number }[] = []
    const calls: { unit: PlannedUnit, frame: number, call: number, node: number, loop: number }[] = []
    const placeOf = new Map<number, Map<number, number>>()
    const carriedBy = new Map<number, number[]>()
    for (const unit of units) {
        const g = graphOf(unit)
        const nest = graphLoops(g)
        const depthOf = (header: number) => nest.loopsOf.get(header)!.length
        const headers = [...nest.loopMembers.keys()].sort((a, b) => depthOf(a) - depthOf(b))
        const innermost = new Map<number, number>()
        if (headers.length) {
            const demand = pstackDemand(g)
            for (const header of headers) {
                const members = nest.loopMembers.get(header)!
                const before = pstackBefore(g, nest, header)
                for (const id of pstackStaying(g, members)) {
                    const blocks = demand.get(id)
                    if (blocks && blocks.every(b => members.has(b) || !before.has(b))) innermost.set(id, header)
                }
            }
        }
        for (const f of unit.frames) {
            const u = frameNode.get(f)!
            const loopNode = new Map<number, number>()
            for (const header of headers) {
                let up = u
                let deepest = 0
                for (const outer of nest.loopsOf.get(header)!) {
                    if (outer === header || depthOf(outer) <= deepest) continue
                    deepest = depthOf(outer)
                    up = loopNode.get(outer) ?? up
                }
                const v = node(up)
                edge(up, v)
                loopNode.set(header, v)
                loops.push({ unit, frame: f, header, node: v, depth: depthOf(header) })
                for (const p of getBlock(g, header)!.params) for (const id of pstackRefs(types.typeAt(f, p))) listOf(carriedBy, id).push(up)
            }
            const place = new Map<number, number>()
            for (const [id, header] of innermost) place.set(id, loopNode.get(header)!)
            placeOf.set(f, place)
            const sites = callees.get(f) ?? new Map<number, number[]>()
            const callNodes = new Set<number>([...unit.calls.keys(), ...sites.keys()])
            for (const call of callNodes) {
                const loop = place.get(call) ?? u
                const c = node(loop)
                edge(loop, c)
                calls.push({ unit, frame: f, call, node: c, loop })
                const precise = sites.get(call) ?? []
                for (const callee of precise) {
                    const target = frameNode.get(callee)
                    if (target !== undefined) edge(c, target)
                }
                for (const callee of unit.calls.get(call) ?? []) {
                    if (callee.frames.some(x => precise.includes(x))) continue
                    for (const x of callee.frames) edge(c, frameNode.get(x)!)
                }
            }
        }
    }
    const { idom, order } = dominatorTree(v => succ[v].slice(), v => pred[v].length ? pred[v] : [0])
    const depth = new Array<number>(succ.length).fill(1)
    const parent = new Array<number>(succ.length).fill(0)
    depth[0] = 0
    for (const v of order) {
        if (!v) continue
        parent[v] = idom.get(v) ?? 0
        depth[v] = depth[parent[v]] + 1
    }
    const lca = (a: number, b: number): number => {
        if (a < 0) return b
        if (b < 0) return a
        while (a !== b) {
            if (depth[a] >= depth[b]) a = parent[a]
            else b = parent[b]
        }
        return a
    }
    const dominates = (v: number, x: number): boolean => {
        while (depth[x] > depth[v]) x = parent[x]
        return x === v
    }
    const locs: number[][] = []
    types.objects.forEach((object, id) => {
        const list: number[] = []
        if (!object.constant) {
            for (const frame of framesOf(object)) {
                const unit = P.unitOfFrame.get(frame)
                const at = unit && !object.native && object.site.unit === unit.fn ? placeOf.get(frame)!.get(object.site.node) : undefined
                list.push(at ?? frameNode.get(frame) ?? 0)
            }
        }
        locs[id] = list.length ? list : [0]
    })
    const domOf: number[] = []
    const holderNeed = (id: number): number => {
        if (domOf[id] === undefined) domOf[id] = locs[id].reduce((d, x) => lca(d, x), -1)
        return domOf[id]
    }
    const own: PstackSummary[] = succ.map(() => ({ kinds: 0, need: -1, escaped: -1, witness: -1 }))
    types.objects.forEach((object, id) => {
        let need = -1
        for (const holder of P.holders.get(id) ?? []) need = lca(need, holderNeed(holder))
        for (const up of carriedBy.get(id) ?? []) need = lca(need, up)
        const kind = object.kind === AllocKind.buffer ? PstackBuffers : object.dynamic ? 0 : PstackObjects
        for (const x of locs[id]) {
            const at = own[x]
            at.kinds |= kind
            if (P.escaped.has(id) && at.escaped < 0) at.escaped = id
            if (need < 0) continue
            const joined = lca(at.need, need)
            if (joined !== at.need) at.witness = id
            at.need = joined
        }
    })
    const sccOf = new Array<number>(succ.length).fill(-1)
    const recursive: boolean[] = []
    const summary: PstackSummary[] = []
    const all: number[] = []
    for (let v = 0; v < succ.length; v++) all.push(v)
    for (const scc of stronglyConnected(all, v => succ[v])) {
        const index = summary.length
        for (const v of scc) sccOf[v] = index
        const merged: PstackSummary = { kinds: 0, need: -1, escaped: -1, witness: -1 }
        let cyclic = scc.length > 1
        const absorb = (part: PstackSummary) => {
            merged.kinds |= part.kinds
            if (merged.escaped < 0) merged.escaped = part.escaped
            const joined = lca(merged.need, part.need)
            if (joined !== merged.need) merged.witness = part.witness
            merged.need = joined
        }
        for (const v of scc) {
            absorb(own[v])
            for (const w of succ[v]) {
                if (w === v) cyclic = true
                if (sccOf[w] !== index) absorb(summary[sccOf[w]])
            }
        }
        summary.push(merged)
        recursive.push(cyclic)
    }
    const verdict = (unit: PlannedUnit, v: number): PstackRegion => {
        const sum = summary[sccOf[v]]
        const region: PstackRegion = { unit, header: 0, call: 0, reason: '', stacks: [] }
        if (sum.kinds & PstackObjects) region.stacks.push(0)
        if (sum.kinds & PstackBuffers) region.stacks.push(1)
        if (recursive[sccOf[v]]) region.reason = `recursive:${unit.fn.name}`
        else if (!sum.kinds) region.reason = 'idle'
        else if (sum.escaped >= 0) region.reason = `escapes:${pstackObjectName(types, sum.escaped)}`
        else if (sum.need >= 0 && !dominates(v, sum.need)) region.reason = `held:${pstackObjectName(types, sum.witness)}`
        return region
    }
    const out: PstackRegion[] = []
    const failing = new Map<number, number>()
    const merged = new Map<PlannedUnit, Map<number, PstackRegion>>()
    for (const loop of loops) {
        const region = verdict(loop.unit, loop.node)
        region.header = loop.header
        const fails = region.reason !== '' && region.reason !== 'idle'
        if (fails) failing.set(loop.node, loop.header)
        if (debug && region.reason !== 'idle') console.log(`PSTK2 loop ${loop.unit.fn.name || '<anon>'} B${loop.header} F${loop.frame} depth ${loop.depth} stacks [${region.stacks.join(',')}] ${region.reason || 'reset-ok'}`)
        const byHeader = mapOf(merged, loop.unit)
        const known = byHeader.get(loop.header)
        if (!known) {
            byHeader.set(loop.header, region)
            out.push(region)
            continue
        }
        for (const stack of region.stacks) if (!known.stacks.includes(stack)) known.stacks.push(stack)
        known.stacks.sort((a, b) => a - b)
        if (fails && (known.reason === '' || known.reason === 'idle')) known.reason = region.reason
        if (region.reason === '' && known.reason === 'idle') known.reason = ''
    }
    for (const site of calls) {
        const header = failing.get(site.loop)
        if (header === undefined) continue
        const region = verdict(site.unit, site.node)
        region.header = header
        region.call = site.call
        const returned = pstackRefs(types.typeAt(site.frame, site.call)).find(id => locs[id].some(x => x !== 0))
        if (!region.reason && returned !== undefined) region.reason = `returns:${pstackObjectName(types, returned)}`
        out.push(region)
        if (debug && region.reason !== 'idle') console.log(`PSTK2 call ${site.unit.fn.name || '<anon>'} B${header} F${site.frame} %${site.call} -> ${[...site.unit.calls.get(site.call) ?? []].map(c => c.fn.name || '<anon>').join(',')} stacks [${region.stacks.join(',')}] ${region.reason || 'reset-ok'}`)
    }
    if (debug) console.log(`PSTK2 time ${(performance.now() - start).toFixed(1)}ms program ${(programmed - start).toFixed(1)}ms units ${units.length} loops ${loops.length} calls ${calls.length} nodes ${succ.length}`)
    return out
}

function setOf<K, V>(map: Map<K, Set<V>>, k: K): Set<V> {
    let set = map.get(k)
    if (!set) map.set(k, set = new Set())
    return set
}

function rootOf(parent: number[], a: number): number {
    let at = a
    while (parent[at] !== at) {
        parent[at] = parent[parent[at]]
        at = parent[at]
    }
    return at
}

function listOf<K, V>(map: Map<K, V[]>, k: K): V[] {
    let list = map.get(k)
    if (!list) map.set(k, list = [])
    return list
}

function mapOf<K, K2, V>(map: Map<K, Map<K2, V>>, k: K): Map<K2, V> {
    let inner = map.get(k)
    if (!inner) map.set(k, inner = new Map())
    return inner
}
