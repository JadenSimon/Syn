/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { firstNonOrderingSlot, graphLoops, type GraphLoops, NumericOps, OrderedValues, stronglyConnected, tailPositions, tailRoots, type Graph, type GraphNode, typeName } from './lowering2'
import { countIds, getBlock, getLiteral, getNode, getRef, isThisParam, NodeOp, nodeUsers, opName, resultType, spreadsLast, typeOf, allNodes, countNodes, hasNode, nodeEntries, nodeIds, heapInterior, heapField, heapFieldCount } from './graph-node'
import type { TraceSession } from './trace2'
import { dataKeys, reducedShape } from './property-eval'
import * as rt from './rt'

type Handle = intrinsics.Handle

export enum AllocKind {
    object,
    array,
    buffer,
    scope,
}

export interface Site {
    unit: Function
    node: number
    frame?: number
    operand?: number
}

export interface Allocation {
    site: Site
    frame?: number
    frames?: number[]
    kind: AllocKind
    state?: Handle
    handle?: Handle
    proto: Handle | undefined
    constant: boolean
    native?: boolean
    dynamic?: boolean
    copied?: boolean
    function?: Function
}
export interface Location {
    allocation: number
    key: string
    handle: Handle | undefined
    type: Type
    forms: string[]
    readers: Site[]
    writers: Site[]
    stored: boolean
}


export type Interval = [lo: number, hi: number]

export interface StorageAccess {
    node: number
    store: boolean
    field: boolean
    members: number[][]
}

export interface StorageSlot {
    allocation: number
    key: string
    kinds: number
    type: Type
}

export interface UnitTypes {
    nodes: Map<number, Type>
    slices: Map<number, number[]>
    blocks: Set<number>
    selects: Map<number, boolean[]>
    receivers: Map<number, Type>
}

export interface Accesses {
    resolve(frames: number[]): UnitTypes
    typeAt(frame: number, node: number): Type | undefined
    allocations: Allocation[]
    locations: Location[]
    frames: FrameSignature[]
}

export const numberKey = '[number]'
export interface AccessHost {
    session: TraceSession
    graphOf(fn: Function): Graph
    functionOf(handle: u32): Function | undefined
    localFunction(symbol: number): Function | undefined
    traceable(fn: Function): boolean
    constantElements?(state: Handle): Handle[] | undefined
    bindTarget?(fn: Function, count: number, spread: boolean): Function
    arityVariants?(fn: Function): boolean
    heapValue?(slot: Handle): Handle
    isConstructor?(fn: Function): boolean
    freshCells?(fn: Function): { allocations: number[], closures: number[], frames: number[], definite?: [number, Handle[]][] }
    identity?(fn: Function): unknown
    restOf?(fn: Function): [index: number, proto: Handle] | undefined
}
export function boundCallee(host: AccessHost, fn: Function, call: GraphNode): Function {
    if (!host.bindTarget || call.op !== NodeOp.call) return fn
    return host.bindTarget(fn, countIds(call) - 3, spreadsLast(call))
}

const nodeSpan = 2 ** 24

const Types = intrinsics.Types

export function scalarType(T: intrinsics.Types): boolean {
    return T !== Types.u64 && T !== Types.vm_value && T !== Types.ptr && T !== Types.fnptr && T !== Types.usize && T !== Types.void && T !== Types.unknown && T !== Types.handle && T !== Types.unknown_number
}

const MinI64 = -(2 ** 63)
const MaxI64 = 2 ** 63
const MaxU64 = 2 ** 64
const Boundaries: [intrinsics.Types, Interval][] = [
    [Types.u8, [0, 255]], [Types.u16, [0, 65535]], [Types.u32, [0, 2 ** 32 - 1]], [Types.u64, [0, MaxU64]],
    [Types.i8, [-128, 127]], [Types.i16, [-32768, 32767]], [Types.i32, [-(2 ** 31), 2 ** 31 - 1]], [Types.i64, [MinI64, MaxI64]],
]

function within(a: Interval, b: Interval): boolean {
    return a[0] >= b[0] && a[1] <= b[1]
}

function rangeName(range: Interval): string {
    const exact = Boundaries.find(([, bound]) => bound[0] === range[0] && bound[1] === range[1])
    return exact ? typeName(exact[0]) : `${range[0]}..${range[1]}`
}

function hull(a: Interval | undefined, b: Interval | undefined): Interval | undefined {
    if (!a || !b) return a ?? b
    if (within(b, a)) return a
    if (within(a, b)) return b
    return [Math.min(a[0], b[0]), Math.max(a[1], b[1])]
}

export interface IntFormat {
    bits: 32 | 64
    signed: boolean
}

function numberText(format: IntFormat | undefined): 'int' | 'i64' | 'f64' {
    return !format ? 'f64' : format.signed ? 'i64' : 'int'
}

export function numberName(rep: Rep | undefined): 'int' | 'i64' | 'f64' | undefined {
    return rep?.kind === 'number' ? numberText(rep.format) : undefined
}

function intFormat(range: Interval): IntFormat {
    const signed = range[0] < 0
    return { bits: within(range, signed ? Boundaries[6][1] : Boundaries[2][1]) ? 32 : 64, signed }
}
const users = new WeakMap<Graph, { size: number, index: Map<number, [number, number][]> }>()
export function usersOf(g: Graph): Map<number, [number, number][]> {
    const known = users.get(g)
    if (known) {
        intrinsics.assert(known.size === countNodes(g), `value-types: ${g.name ?? 'graph'} changed after its users were indexed`)
        return known.index
    }
    const index = nodeUsers(g, nodeIds(g))
    users.set(g, { size: countNodes(g), index })
    return index
}
function useDominators(g: Graph): { idom: Map<number, number>, order: number[] } {
    const users = usersOf(g)
    const bodyOf = new Map<number, number[]>()
    for (const b of g.blocks) {
        if (!b.bodyId) continue
        listOf(bodyOf, b.bodyId).push(b.id)
    }
    const entries = (block: number) => (users.get(block) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
    function succs(v: number): number[] {
        const out: number[] = []
        if (v === 0) {
            for (const b of g.blocks) if (!entries(b.id).length) out.push(-b.id)
            for (const id of nodeIds(g)) if (!users.get(id)?.length && !bodyOf.has(id)) out.push(id)
            return out
        }
        if (v < 0) {
            const body = getBlock(g, -v)?.bodyId
            if (body && hasNode(g, body)) out.push(body)
            return out
        }
        const n = getNode(g, v)!
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (ref && hasNode(g, ref)) out.push(ref)
        }
        if (n.op === NodeOp.apply && getBlock(g, getRef(n, 0))) out.push(-getRef(n, 0))
        return out
    }
    function preds(v: number): number[] {
        const out = v < 0 ? entries(-v) : (users.get(v) ?? []).map(([u]) => u)
        if (v > 0) for (const b of bodyOf.get(v) ?? []) out.push(-b)
        if (!out.length) out.push(0)
        return out
    }
    return dominatorTree(succs, preds)
}

function dominatorTree(succs: (v: number) => number[], preds: (v: number) => number[]): { idom: Map<number, number>, order: number[] } {
    const order: number[] = [0]
    const index = new Map<number, number>([[0, 0]])
    const parent: number[] = [0]
    const path: number[] = [0]
    const pending: number[][] = [succs(0).reverse()]
    while (pending.length) {
        const top = pending[pending.length - 1]
        if (!top.length) {
            path.pop()
            pending.pop()
            continue
        }
        const w = top.pop()!
        if (index.has(w)) continue
        index.set(w, order.length)
        parent.push(path[path.length - 1])
        path.push(order.length)
        order.push(w)
        pending.push(succs(w).reverse())
    }
    const semi = order.map((_, i) => i)
    const ancestor = order.map(() => -1)
    const label = order.map((_, i) => i)
    const dom = order.map(() => 0)
    const bucket: number[][] = order.map(() => [])
    function evaluate(v: number): number {
        if (ancestor[v] === -1) return v
        const chain: number[] = []
        let at = v
        while (ancestor[ancestor[at]] !== -1) {
            chain.push(at)
            at = ancestor[at]
        }
        while (chain.length) {
            const x = chain.pop()!
            const a = ancestor[x]
            if (semi[label[a]] < semi[label[x]]) label[x] = label[a]
            ancestor[x] = ancestor[a]
        }
        return label[v]
    }
    for (let i = order.length - 1; i > 0; i--) {
        for (const p of preds(order[i])) {
            const v = index.get(p)
            if (v === undefined) continue
            const u = evaluate(v)
            if (semi[u] < semi[i]) semi[i] = semi[u]
        }
        bucket[semi[i]].push(i)
        ancestor[i] = parent[i]
        for (const v of bucket[parent[i]]) {
            const u = evaluate(v)
            dom[v] = semi[u] < semi[v] ? u : parent[i]
        }
        bucket[parent[i]] = []
    }
    const idom = new Map<number, number>()
    for (let i = 1; i < order.length; i++) {
        if (dom[i] !== semi[i]) dom[i] = dom[dom[i]]
        idom.set(order[i], order[dom[i]])
    }
    return { idom, order }
}
export interface ArmRecord {
    select: number
    arm: number
    positive: boolean
    order: number
}
interface ArmIndex {
    records: Map<number, ArmRecord[]>
    nearest: Map<number, number>
    parent: Map<number, number>
    chains: Map<number, ArmRecord[]>
    arms: Map<number, [cond: number, positive: boolean][]>
    guards: Map<number, [cond: number, positive: boolean][]>
}
const armIndexes = new WeakMap<Graph, ArmIndex>()
export function armIndexOf(g: Graph): ArmIndex {
    const known = armIndexes.get(g)
    if (known) return known
    const records = new Map<number, ArmRecord[]>()
    let order = 0
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.select || countIds(n) !== 3) continue
        for (let slot = 1; slot < 3; slot++) {
            const arm = getRef(n, slot)
            order++
            if (!arm) continue
            const list = records.get(arm)
            const record = { select: id, arm, positive: slot === 1, order }
            if (list) list.push(record)
            else records.set(arm, [record])
        }
    }
    const nearest = new Map<number, number>()
    const parent = new Map<number, number>()
    if (records.size) {
        const { idom, order: preorder } = useDominators(g)
        for (const v of preorder) {
            if (v === 0) continue
            const up = nearest.get(idom.get(v)!)
            const param = v > 0 && getNode(g, v)!.op === NodeOp.param
            if (records.has(v)) {
                nearest.set(v, v)
                if (up !== undefined && !param) parent.set(v, up)
            } else if (up !== undefined && !param) nearest.set(v, up)
        }
        for (const root of records.keys()) if (!nearest.has(root)) nearest.set(root, root)
    }
    const index = { records, nearest, parent, chains: new Map(), arms: new Map(), guards: new Map() }
    armIndexes.set(g, index)
    return index
}
function armChain(g: Graph, root: number): ArmRecord[] {
    const index = armIndexOf(g)
    const climb: number[] = []
    let at: number | undefined = root
    while (at !== undefined && !index.chains.has(at)) {
        climb.push(at)
        at = index.parent.get(at)
    }
    let below = at === undefined ? [] : index.chains.get(at)!
    while (climb.length) {
        const r = climb.pop()!
        const chain = [...below, ...index.records.get(r)!].sort((a, b) => a.order - b.order)
        index.chains.set(r, chain)
        below = chain
    }
    return below
}
export function armsAt(g: Graph, node: number): [cond: number, positive: boolean][] | undefined {
    const index = armIndexOf(g)
    const root = index.nearest.get(node)
    if (root === undefined) return
    const known = index.arms.get(root)
    if (known) return known
    const out: [number, boolean][] = []
    for (const record of armChain(g, root)) {
        const cond = getRef(getNode(g, record.select)!, 0)
        if (cond) out.push([cond, record.positive])
    }
    index.arms.set(root, out)
    return out
}
const bodies = new WeakMap<Graph, Map<number, Set<number>>>()
export function bodyNodes(g: Graph, body: number): Set<number> {
    let byGraph = bodies.get(g)
    if (!byGraph) bodies.set(g, byGraph = new Map())
    const known = byGraph.get(body)
    if (known) return known
    const found = new Set<number>()
    const work = [body]
    while (work.length) {
        const id = work.pop()!
        if (found.has(id)) continue
        found.add(id)
        const n = getNode(g, id)
        if (n) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) work.push(getRef(n, i))
    }
    byGraph.set(body, found)
    return found
}
export interface Type {
    undefined: boolean
    unknown: boolean
    bools: number
    literals: number[]
    range?: Interval
    float: boolean
    objects: number[]
    functions: Function[]
    closures: number[]
    strings: number[]
}

export interface ObjectType extends Allocation {
    name: string
    fields: Map<string, ObjectField>
    readers: Site[]
}

interface ObjectField extends Field {
    initialized: boolean
    constructed: boolean
    stored: boolean
}

export interface Signature<T = Type> {
    params: { label: string, type: T, opaque?: boolean }[]
    returns: T
}

export interface FrameSignature extends Signature {
    unit: Function
    heldStatic: boolean
    sites: Site[]
    accesses: StorageAccess[]
    merges: number[][]
}

export interface ValueTypes {
    resolve(frames: number[]): UnitTypes
    typeAt(frame: number, node: number): Type | undefined
    ms: number
    frames: FrameSignature[]
    slots: StorageSlot[]
    objects: ObjectType[]
    stateAllocations: Map<Handle, number[]>
    keyHandles: Map<string, Handle>
    keyNames: Map<Handle, string>
    fieldStores: Set<string>
    erasedFields: Map<number, Set<string>>
}

export interface Field {
    type: Type
    forms: string[]
}

function fieldAt(types: ValueTypes, allocations: number[], keys: string[]): Field | undefined {
    let current = allocations
    let field: Field | undefined
    for (const key of keys) {
        if (!current.length) return
        let type = emptyType()
        let forms: string[] = []
        let found = false
        for (const allocation of current) {
            const object = types.objects[allocation]
            const known = object.fields.get(key) ?? (constantIndex(key) ? object.fields.get(numberKey) : undefined)
            if (known) {
                found = true
                type = union(type, known.type)
                forms = merge(forms, known.forms)
            }
            if (key === numberKey) for (const [other, inner] of object.fields) if (constantIndex(other)) {
                found = true
                type = union(type, inner.type)
                forms = merge(forms, inner.forms)
            }
        }
        if (!found) return
        field = { type, forms }
        current = type.objects
    }
    return field
}

function wordStore(g: Graph, n: GraphNode): boolean {
    if (n.op === NodeOp.store) return resultType(g, n) === Types.vm_value
    return rt.sliceOf(g, n) === rt.Op.sliceWrite && rt.elementType(g, n) === Types.vm_value
}

function wordLoad(g: Graph, n: GraphNode): boolean {
    if (n.op === NodeOp.load) return resultType(g, n) === Types.vm_value
    return rt.sliceOf(g, n) === rt.Op.sliceRead && rt.elementType(g, n) === Types.vm_value
}

export function constantIndex(key: string): boolean {
    return /^(\[\d+\]|@-?\d+)$/.test(key)
}

export function cutArgument(types: ValueTypes, members: number[], chains: string[][], named: (id: number) => string): string {
    let type = emptyType()
    for (const chain of chains) {
        const field = fieldAt(types, members, chain)
        if (field) type = union(type, field.type)
    }
    return cutTypeText(type, named)
}

export interface CutCall {
    fn: Function
    receivers: number[]
    args: Type[]
    site: Site
}

export function cutCalls(types: ValueTypes, host: AccessHost, member: (fn: Function) => boolean): CutCall[] {
    const out: CutCall[] = []
    for (const frame of types.frames) {
        if (!member(frame.unit)) continue
        const callee = host.graphOf(frame.unit)
        const plain = callee.blocks[0].params.filter(p => !isThisParam(getNode(callee, p)!)).length
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            const g = host.graphOf(site.unit)
            const n = getNode(g, site.node)
            if (!n || n.op === NodeOp.rt) continue
            const first = firstArg(n, plain)
            if (first < 0) continue
            const receivers = types.typeAt(site.frame, getRef(n, n.op === NodeOp.call ? 2 : 1))?.objects ?? []
            if (!receivers.length) continue
            const args: Type[] = []
            let i = first
            while (i < countIds(n)) {
                const ref = getRef(n, i)
                if (ref) args.push(types.typeAt(site.frame, ref) ?? emptyType())
                else args.push({ ...emptyType(), literals: [getLiteral(g, n, i)] })
                i++
            }
            out.push({ fn: frame.unit, receivers, args, site })
        }
    }
    return out
}

export function cutReadType(types: ValueTypes, type: Type, keys: string[]): Type {
    if (!keys.length) return type
    return fieldAt(types, type.objects, keys)?.type ?? emptyType()
}

export function cutUnion(a: Type, b: Type): Type {
    return union(a, b)
}

export function cutWithin(a: Type, b: Type): boolean {
    if (b.unknown) return true
    if (a.unknown || (a.undefined && !b.undefined) || (a.bools & ~b.bools) || (a.float && !b.float)) return false
    const number = (x: number) => b.literals.includes(x) || (b.range !== undefined && Number.isInteger(x) && within([x, x], b.range)) || (b.float && !Number.isInteger(x))
    if (!a.literals.every(number)) return false
    const covered: Interval | undefined = b.range ? [b.range[0], b.range[1]] : undefined
    if (covered) for (const x of [...b.literals].sort((l, r) => r - l)) if (x === covered[0] - 1) covered[0] = x
    if (covered) for (const x of [...b.literals].sort((l, r) => l - r)) if (x === covered[1] + 1) covered[1] = x
    if (a.range && !(covered && within(a.range, covered))) {
        if (a.range[1] - a.range[0] > 64) return false
        for (let x = a.range[0]; x <= a.range[1]; x++) if (!number(x)) return false
    }
    if (!a.objects.every(x => b.objects.includes(x)) || !a.functions.every(x => b.functions.includes(x)) || !a.closures.every(x => b.closures.includes(x))) return false
    return b.strings.includes(0) || a.strings.every(x => b.strings.includes(x))
}

export function cutTypeText(type: Type, named: (id: number) => string): string {
    const parts: string[] = []
    if (type.unknown) parts.push('any')
    if (type.bools) parts.push(type.bools === 3 ? 'boolean' : type.bools === 2 ? 'true' : 'false')
    for (const literal of type.literals) if (!(type.range && Number.isInteger(literal) && within([literal, literal], type.range))) parts.push(String(literal))
    if (type.range) parts.push(rangeName(type.range))
    if (type.float) parts.push('float')
    for (const handle of type.strings) parts.push(handle ? `'${heap.stringToJs(handle as Handle)}'` : 'string')
    if (type.functions.length || type.closures.length) parts.push('fn')
    for (const id of type.objects) {
        const text = named(id)
        if (!parts.includes(text)) parts.push(text)
    }
    if (type.undefined) parts.push('undefined')
    return parts.join(' | ') || 'never'
}

export function emptyType(): Type {
    return { undefined: false, unknown: false, bools: 0, literals: [], float: false, objects: [], functions: [], closures: [], strings: [] }
}

function merge<T>(a: T[], b: T[]): T[] {
    if (a === b || !b.length) return a
    if (!a.length) return b
    const seen = new Set(a)
    let out: T[] | undefined
    for (const x of b) {
        if (seen.has(x)) continue
        seen.add(x)
        if (!out) out = [...a]
        out.push(x)
    }
    return out ?? a
}

function union(a: Type, b: Type): Type {
    if (a === b) return a
    const literals = merge(a.literals, b.literals)
    const range = hull(a.range, b.range)
    const objects = merge(a.objects, b.objects)
    const functions = merge(a.functions, b.functions)
    const closures = merge(a.closures, b.closures)
    const strings = merge(a.strings, b.strings)
    const flags = (a.undefined || !b.undefined) && (a.unknown || !b.unknown) && (a.float || !b.float) && (a.bools | b.bools) === a.bools
    if (flags && literals === a.literals && range === a.range && objects === a.objects && functions === a.functions && closures === a.closures && strings === a.strings) return a
    return { undefined: a.undefined || b.undefined, unknown: a.unknown || b.unknown, bools: a.bools | b.bools, literals, range, float: a.float || b.float, objects, functions, closures, strings }
}

function mergeAll<T>(lists: T[][]): T[] {
    let out = lists[0]
    let seen: Set<T> | undefined
    let copied = false
    for (let i = 1; i < lists.length; i++) {
        const b = lists[i]
        if (b === out || !b.length) continue
        if (!out.length) {
            out = b
            continue
        }
        if (!seen) seen = new Set(out)
        for (const x of b) {
            if (seen.has(x)) continue
            seen.add(x)
            if (!copied) {
                out = out.slice()
                copied = true
            }
            out.push(x)
        }
    }
    return out
}

export function unionAll(types: Type[]): Type {
    if (types.length === 1) return types[0]
    if (types.length === 2) return union(types[0], types[1])
    const a = types[0]
    const literals = mergeAll(types.map(type => type.literals))
    let range = a.range
    for (let i = 1; i < types.length; i++) range = hull(range, types[i].range)
    const objects = mergeAll(types.map(type => type.objects))
    const functions = mergeAll(types.map(type => type.functions))
    const closures = mergeAll(types.map(type => type.closures))
    const strings = mergeAll(types.map(type => type.strings))
    const anyUndefined = types.some(type => type.undefined)
    const anyUnknown = types.some(type => type.unknown)
    const anyFloat = types.some(type => type.float)
    let bools = 0
    for (const type of types) bools = bools | type.bools
    const flags = (a.undefined || !anyUndefined) && (a.unknown || !anyUnknown) && (a.float || !anyFloat) && bools === a.bools
    if (flags && literals === a.literals && range === a.range && objects === a.objects && functions === a.functions && closures === a.closures && strings === a.strings) return a
    return { undefined: anyUndefined, unknown: anyUnknown, bools, literals, range, float: anyFloat, objects, functions, closures, strings }
}

export function constructorOf(proto: Handle | undefined, host: AccessHost): Function | undefined {
    const ctor = proto ? heap.getOwnProperty(proto, heap.fromJsString('constructor')) : 0
    return ctor ? host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32) : undefined
}

function allocationName(allocation: Allocation, host: AccessHost): string {
    if (allocation.kind === AllocKind.array) return 'Array'
    if (allocation.kind === AllocKind.buffer) return 'buffer'
    if (allocation.kind === AllocKind.scope) return 'Scope'
    return constructorOf(allocation.proto, host)?.name || 'Object'
}

export function inhabited(type: Type): boolean {
    return type.undefined || type.unknown || type.bools !== 0 || type.float || type.range !== undefined || type.literals.length > 0 || type.strings.length > 0 || type.objects.length > 0 || type.functions.length > 0 || type.closures.length > 0
}

function receiverOf(frame: FrameSignature): number | undefined {
    const self = frame.params.find(p => p.label === 'this')?.type
    return self && self.objects.length === 1 ? self.objects[0] : undefined
}

function storageSlotsOf(locations: Location[]): StorageSlot[] {
    const slots: StorageSlot[] = []
    const tuples = new Set<number>()
    for (const location of locations) if (location.key === numberKey) tuples.add(location.allocation)
    for (const location of locations) {
        const indexed = location.key === numberKey || (constantIndex(location.key) && tuples.has(location.allocation))
        const type = location.type
        let kinds = 0
        if (type.literals.length || type.range || type.float) kinds |= 1
        if (type.objects.length || type.closures.length || type.functions.length) kinds |= 2
        if (type.bools) kinds |= 4
        if (type.strings.length) kinds |= 8
        slots.push({ allocation: location.allocation, key: indexed ? numberKey : location.key, kinds, type })
    }
    return slots
}

function mixedKinds(kinds: number): boolean {
    return (kinds & (kinds - 1)) !== 0
}

function copiedWords(g: Graph): Map<number, number[]> {
    const users = usersOf(g)
    const out = new Map<number, number[]>()
    function stores(id: number, into: number[]): boolean {
        for (const [user, slot] of users.get(id) ?? []) {
            const n = getNode(g, user)!
            if (n.op === NodeOp.after && slot < countIds(n) - 1) continue
            if (n.op === NodeOp.after && stores(user, into)) continue
            if (rt.sliceOf(g, n) !== rt.Op.sliceWrite || !wordStore(g, n)) return false
            if (slot === 0) continue
            if (slot !== 4) return false
            into.push(user)
        }
        return true
    }
    for (const [id, n] of nodeEntries(g)) {
        if (!wordLoad(g, n) || rt.sliceOf(g, n) !== rt.Op.sliceRead) continue
        const into: number[] = []
        if (stores(id, into) && into.length) out.set(id, into)
    }
    return out
}

export function analyzeTypes(data: Accesses, host: AccessHost, roots: Function[]): ValueTypes {
    const start = performance.now()
    const objects: ObjectType[] = data.allocations.map(allocation => ({ ...allocation, name: allocationName(allocation, host), fields: new Map(), readers: [] }))
    const keyHandles = new Map<string, Handle>()
    const locations = data.locations
    for (const location of locations) if (location.handle !== undefined) keyHandles.set(location.key, location.handle)
    function constructorStore(object: ObjectType, site: Site): boolean {
        const fn = constructorOf(object.proto, host)
        if (fn !== site.unit || !host.isConstructor?.(fn)) return false
        const g = host.graphOf(fn)
        const n = getNode(g, site.node)
        if (n?.op !== NodeOp.setProp || !receiverValue(g, getRef(n, 1))) return false
        const block = blockOf(g, site.node)
        return !!block && !repeats(g, block, site.node)
    }
    const written = (location: Location) => inhabited(location.type) || location.writers.length > 0
    const indexed = new Set(locations.filter(location => (location.key === numberKey || constantIndex(location.key)) && written(location)).map(location => location.allocation))
    const initialWrites: [allocation: number, key: string, node: number][] = []
    const erased = unobservedFields(data, roots, host)
    const erasedFields = new Map<number, Set<string>>()
    for (const location of locations) {
        const object = objects[location.allocation]
        if (erased.has(location)) {
            let keys = erasedFields.get(location.allocation)
            if (!keys) erasedFields.set(location.allocation, keys = new Set())
            keys.add(location.key)
            continue
        }
        if (!written(location) && indexed.has(location.allocation) && (location.key === numberKey || constantIndex(location.key))) continue
        const field: ObjectField = { type: location.type, forms: location.forms, stored: location.stored, initialized: false, constructed: false }
        object.fields.set(location.key, field)
        object.readers.push(...location.readers)
        const writer = location.writers[0]
        if (!writer || !location.writers.every(w => w.unit === writer.unit && w.node === writer.node)) continue
        if (writer.unit === object.site.unit && !location.forms.includes('init')) initialWrites.push([location.allocation, location.key, writer.node])
        field.constructed = constructorStore(object, writer)
    }
    const contained = new Set(objects.flatMap(object => [...object.fields.values()].flatMap(field => field.type.objects)))
    for (const [id, key, node] of initialWrites) {
        const object = objects[id]
        if (object.fields.size !== 1 || contained.has(id)) continue
        const g = host.graphOf(object.site.unit)
        const block = blockOf(g, node)
        if (block && block === blockOf(g, object.site.node)) object.fields.get(key)!.initialized = true
    }
    const frames: FrameSignature[] = data.frames
    const stateAllocations = new Map<Handle, number[]>()
    objects.forEach((object, id) => {
        if (object.state === undefined) return
        listOf(stateAllocations, object.state).push(id)
    })
    if (intrinsics.argv().includes('frames-dump')) frames.forEach((frame, id) => console.log('FRAME', id, frame.unit.name || '<anon>', frame.heldStatic ? '<static>' : '<>', frame.params.map(p => `${p.label}:${formatType({ objects } as ValueTypes, p.type)}`).join(' '), '->', formatType({ objects } as ValueTypes, frame.returns)))
    const fieldStores = new Set<string>()
    for (const location of data.locations) for (const site of location.writers) fieldStores.add(`${unitIdentity(site.unit)}:${site.node}`)
    const keyNames = new Map([...keyHandles].map(([name, key]) => [key, name]))
    return { resolve: data.resolve, typeAt: data.typeAt, ms: performance.now() - start, objects, frames, slots: storageSlotsOf(locations), stateAllocations, keyHandles, keyNames, fieldStores, erasedFields }
}

function unobservedFields(data: Accesses, roots: Function[], host: AccessHost): Set<Location> {
    const exposed = new Set<number>()
    data.frames.forEach((frame, i) => {
        if (!roots.includes(frame.unit)) return
        const graph = host.graphOf(frame.unit)
        const nodes = data.resolve([i]).nodes
        for (const n of allNodes(graph)) {
            if (n.op !== NodeOp.ret) continue
            for (const id of nodes.get(getRef(n, 0))?.objects ?? []) exposed.add(id)
        }
    })
    const fieldsOf = new Map<number, Location[]>()
    for (const location of data.locations) listOf(fieldsOf, location.allocation).push(location)
    const work = [...exposed]
    while (work.length) {
        const id = work.pop()!
        for (const location of fieldsOf.get(id) ?? []) {
            for (const inner of location.type.objects) {
                if (exposed.has(inner)) continue
                exposed.add(inner)
                work.push(inner)
            }
        }
    }
    const erased = new Set<Location>()
    for (const [id, locations] of fieldsOf) {
        const allocation = data.allocations[id]
        if (exposed.has(id) || allocation.kind !== AllocKind.object || allocation.function) continue
        if (allocation.constant || allocation.native || allocation.dynamic || allocation.copied) continue
        if (allocation.state !== undefined && heap.isCallable(allocation.state)) continue
        const erasable = (location: Location) => !location.readers.length && location.handle !== undefined && (heap.isString(location.handle) || heap.isPrivateName(location.handle))
        const unread = locations.filter(erasable)
        if (!locations.some(location => location.writers.length && !erasable(location))) continue
        for (const location of unread) erased.add(location)
    }
    return erased
}
function initOnly(object: ObjectType, k: string | undefined): boolean {
    return k === undefined || (object.fields.get(k)?.forms ?? []).every(form => form === 'init')
}

export function constructionNode(construction: Graph, cell: number): GraphNode | undefined {
    for (const n of allNodes(construction)) {
        if (n.op === NodeOp.heapHandle && !getRef(n, 0) && getLiteral(construction, n, 0) === cell && !heapInterior(construction, n) && heapFieldCount(n)) return n
    }
    return undefined
}

export function constructedAllocation(construction: Graph, cell: number, key: Handle): boolean {
    const holder = constructionNode(construction, cell)
    const field = holder ? heapField(construction, holder, key) : undefined
    let n = typeof field === 'number' ? getNode(construction, field) : undefined
    while (n?.op === NodeOp.after) n = getNode(construction, getRef(n, countIds(n) - 1))
    return n?.op === NodeOp.pstack
}

function fixedElements(types: ValueTypes, object: ObjectType): boolean {
    for (const field of object.fields.values()) for (const id of field.type.objects) {
        const inner = types.objects[id]
        if (inner.kind === AllocKind.buffer && [...inner.fields.values()].some(field => field.stored)) return false
    }
    return true
}

export function fixedField(types: ValueTypes, state: Handle, key: Handle): boolean {
    const index = heap.keyIndex(key)
    const name = index !== undefined ? `[${index}]` : types.keyNames.get(key)
    return (types.stateAllocations.get(state) ?? []).every(id => {
        const object = types.objects[id]
        return initOnly(object, name) && initOnly(object, numberKey) && (index === undefined || fixedElements(types, object))
    })
}

export function fixedState(types: ValueTypes, state: Handle): boolean {
    return (types.stateAllocations.get(state) ?? []).every(id => [...types.objects[id].fields.keys()].every(k => initOnly(types.objects[id], k)))
}

export function formatType(types: ValueTypes, type: Type): string {
    const parts: string[] = []
    if (type.undefined) parts.push('undefined')
    if (type.bools) parts.push(type.bools === 3 ? 'boolean' : type.bools === 2 ? 'true' : 'false')
    for (const literal of type.literals) if (!type.float && !(type.range && Number.isInteger(literal) && within([literal, literal], type.range))) parts.push(String(literal))
    if (type.range) parts.push(rangeName(type.range))
    if (type.float) parts.push('f64')
    if (type.strings.length) parts.push('string')
    for (const id of type.objects) parts.push(`${types.objects[id].name}#${id}`)
    for (const fn of type.functions) parts.push(`fn ${fn.name || '<anon>'}`)
    if (type.unknown) parts.push('unknown')
    return parts.join(' | ') || 'never'
}

function floatType(type: Type): boolean {
    return type.float || type.literals.some(l => !Number.isInteger(l))
}

function numberSpan(type: Type): Interval | undefined {
    let span = type.range
    for (const l of type.literals) span = hull(span, [l, l])
    return span
}

function numberRepresentation(type: Type): string {
    if (floatType(type)) return 'f64'
    const format = intFormat(numberSpan(type)!)
    return `${format.signed ? 'i' : 'u'}${format.bits}`
}

function writtenForms(forms: string[]): boolean {
    return forms.some(form => form !== 'void')
}

function nullsOnly(type: Type): boolean {
    return !type.undefined && !opaqueNumber(type) && type.literals.length === 1 && type.literals[0] === 0
}

function representation(type: Type, targetOf = (id: number) => `O${id}`): string {
    if (type.unknown) return 'any'
    const targets = [...new Set([...type.objects, ...type.closures].map(targetOf))].sort()
    if (type.strings.length) targets.push('str')
    if (type.functions.length && !type.closures.length) targets.push('fn')
    if (type.bools && !boolPartners(type)) return representation(boolNumbers(type), targetOf)
    if (type.bools) return 'union'
    const numeric = numericType(type)
    if (!targets.length) return numeric ? `${numberRepresentation(type)}${type.undefined ? '?' : ''}` : type.undefined ? 'undefined' : 'never'
    if (numeric && !nullsOnly(type)) return `union<${numberRepresentation(type)}|${targets.join('|')}>${type.undefined ? '?' : ''}`
    return `ptr<${targets.join('|')}>${type.undefined || nullsOnly(type) ? '?' : ''}`
}

function typeStats(types: ValueTypes): string {
    return `TYPES ${types.ms.toFixed(1)}ms frames=${types.frames.length} objects=${types.objects.length}`
}

function joinedSignature<T>(frames: Signature<T>[], joinAll: (list: T[]) => T): Signature<T> {
    return {
        params: frames[0].params.map((param, i) => ({ label: param.label, type: joinAll(frames.map(frame => frame.params[i].type)) })),
        returns: joinAll(frames.map(frame => frame.returns)),
    }
}

export function dumpTypes(types: ValueTypes): string {
    const lines: string[] = [typeStats(types)]
    types.objects.forEach((object, id) => {
        lines.push(`OBJECT O${id} ${object.name}@${object.site.unit.name}:%${object.site.node}<${object.frame === undefined ? '' : `F${object.frame}`}>${object.native ? ' native' : ''}${object.constant ? ' constant' : ''}${object.dynamic ? ' dynamic' : ''}`)
        for (const key of [...object.fields.keys()].sort()) {
            const field = object.fields.get(key)!
            lines.push(`  ${key}: ${formatType(types, field.type)} => ${representation(field.type)} [${field.forms.join(',')}]`)
        }
    })
    const units = new Map<Function, FrameSignature[]>()
    for (const frame of types.frames) {
        listOf(units, frame.unit).push(frame)
    }
    for (const [unit, frames] of units) {
        const signature = joinedSignature(frames, unionAll)
        const params = signature.params.map(p => `${p.label}: ${formatType(types, p.type)} => ${representation(p.type)}`).join(', ')
        lines.push(`SIG ${unit.name || '<anon>'}(${params}) -> ${formatType(types, signature.returns)} => ${representation(signature.returns)}`)
    }
    return lines.join('\n')
}
export interface NativeParam {
    label: string
    kind?: intrinsics.Types
    nullish: boolean
    keys?: string[]
}

export interface NativeUnit {
    name: string
    origin: Function
    sites: Site[]
    params: NativeParam[]
    returns: intrinsics.Types
}

export function checkTypes(types: ValueTypes, units: NativeUnit[]): string {
    const lines: string[] = [typeStats(types)]
    for (const unit of units) {
        const frames = types.frames.filter(frame => frame.unit === unit.origin)
        const sited = frames.filter(frame => frame.sites.some(s => unit.sites.some(site => s.unit === site.unit && s.node === site.node)))
        const selected = sited.length ? sited : frames
        const signature = selected.length ? joinedSignature(selected, unionAll) : undefined
        if (!signature) {
            lines.push(`UNSEEN ${unit.name}`)
            continue
        }
        if (!sited.length && unit.sites.length) lines.push(`UNMATCHED ${unit.name}: ${unit.sites.map(s => `${s.unit.name}:%${s.node}`).join(' ')}`)
        for (const param of unit.params) {
            const mine = signature.params.find(p => p.label === param.label)?.type
            if (!mine) continue
            const repr = representation(mine)
            const shown = `${formatType(types, mine)} => ${repr}`
            if (param.nullish && !(mine.undefined && !mine.objects.length && !numericType(mine))) lines.push(`NULLISH ${unit.name}.${param.label}: native nullish, analysis ${shown}`)
            if (param.kind === Types.f64 && repr !== 'f64') lines.push(`F64 ${unit.name}.${param.label}: native f64, analysis ${shown}`)
            if (param.kind !== undefined && param.kind !== Types.f64 && param.kind !== Types.vm_value && (mine.objects.some(a => types.objects[a].kind !== AllocKind.buffer) || mine.strings.length || mine.unknown)) lines.push(`NUMBER ${unit.name}.${param.label}: native ${typeName(param.kind)}, analysis ${shown}`)
            if (param.keys && !mine.functions.length) {
                if (!mine.objects.length) lines.push(`SHAPE ${unit.name}.${param.label}: native {${param.keys.join(',')}}, analysis ${shown}`)
                else {
                    const missing = param.keys.filter(key => !mine.objects.some(id => types.objects[id].fields.has(key)))
                    if (missing.length) lines.push(`SHAPE ${unit.name}.${param.label}: native {${param.keys.join(',')}} missing ${missing.join(',')}`)
                }
            }
        }
        const returns = representation(signature.returns)
        if (unit.returns === Types.f64 && returns !== 'f64') lines.push(`RETURN ${unit.name}: native f64, analysis ${formatType(types, signature.returns)} => ${returns}`)
    }
    return lines.join('\n')
}

export interface Generic {
    name: string
    args(members: number[], fieldOf: (objects: number[], key: string) => Type | undefined): (Type | undefined)[]
    interior(id: number, fieldOf: (objects: number[], key: string) => Type | undefined, skip: (id: number) => boolean, visit: (inner: number, keys: string[]) => void): void
}

export function keyLabel(k: Handle): string {
    if (heap.isString(k)) {
        const name = heap.stringToJs(k)
        return name.startsWith('!') ? `!${name}` : name
    }
    const index = heap.keyIndex(k)
    if (index !== undefined) return `[${index}]`
    return `!${heap.describeKey(k) ?? ''}#${k}`
}
export interface Instantiation {
    key: string
    members: number[]
    fields: Map<string, string>
}

export interface ShapeSignature {
    name: string
    proto: Handle | undefined
    fields: [string, Rep][]
    members: number[]
    absent: Set<string>
    nullish: Set<string>
}

export enum RepMember {
    buffer = 1,
    string = 2,
    dynamic = 4,
    function = 8,
}

export interface Rep {
    kind: 'any' | 'never' | 'undefined' | 'number' | 'pointer' | 'union' | 'buffer'
    format?: IntFormat
    forms?: string[]
    members: number
    shapes: string[]
    closure?: Handle
    nullable: boolean
    zero?: boolean
    fresh?: boolean
    element?: Rep
    encoded?: boolean
    constant?: Constant
    bit?: boolean
    bools?: number
    tested?: boolean
    functions?: Function[]
    states?: Handle[]
    inline?: intrinsics.Types[]
    float?: boolean
    other?: Rep
}

function bitValued(type: Type): boolean {
    if (type.unknown || type.undefined || type.strings.length || type.float || type.objects.length || type.functions.length || type.closures.length) return false
    if (type.bools) return !type.range && !type.literals.length
    return !!type.range && within(type.range, [0, 1]) && type.literals.every(l => l === 0 || l === 1)
}

function truthTested(type: Type): boolean {
    if (!type.bools || type.unknown || type.float || type.strings.length || type.functions.length || type.closures.length) return false
    return boolPartners(type) || type.undefined
}

function truthDemand(g: Graph, types: Map<number, Type>, returns: boolean): Set<number> {
    const tested = new Set<number>()
    const candidates: number[] = []
    for (const b of g.blocks.slice(1)) {
        for (const p of b.params) {
            const type = types.get(p)
            if (type && truthTested(type)) candidates.push(p)
        }
    }
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.call) continue
        const type = types.get(id)
        if (type && truthTested(type)) candidates.push(id)
    }
    if (!candidates.length) return tested
    const users = usersOf(g)
    const into = new Map<number, number[]>()
    const feeds = new Map<number, number[]>()
    for (const p of candidates) tested.add(p)
    for (const p of candidates) {
        for (const [user, slot] of users.get(p) ?? []) {
            const n = getNode(g, user)!
            if (slot < firstNonOrderingSlot(n) || (n.op === NodeOp.select && slot === 0)) continue
            if (returns && n.op === NodeOp.ret && slot === 0) continue
            const target = n.op === NodeOp.apply && slot > 0 ? getBlock(g, getRef(n, 0))?.params[slot - 1] : undefined
            if (target === undefined) {
                tested.delete(p)
                break
            }
            listOf(into, p).push(target)
            listOf(feeds, target).push(p)
        }
    }
    const pending = candidates.filter(p => !tested.has(p))
    for (const p of candidates) if (tested.has(p) && (into.get(p) ?? []).some(target => !tested.has(target))) pending.push(p)
    while (pending.length) {
        const p = pending.pop()!
        tested.delete(p)
        for (const source of feeds.get(p) ?? []) {
            if (tested.has(source)) pending.push(source)
        }
    }
    return tested
}

function boolPartners(type: Type): boolean {
    return type.bools !== 0 && (numericType(type) || type.unknown || type.strings.length > 0 || type.objects.length > 0 || type.functions.length > 0 || type.closures.length > 0)
}

function boolNumbers(type: Type): Type {
    if (!type.bools) return type
    const literals = type.literals.slice()
    if (type.bools & 1 && !literals.includes(0)) literals.push(0)
    if (type.bools & 2 && !literals.includes(1)) literals.push(1)
    literals.sort((a, b) => a - b)
    return { ...type, bools: 0, literals }
}

export interface Constant {
    fn?: Function
    literal?: number
    handle?: Handle
}

export interface Instantiations {
    table: Map<string, Instantiation>
    shapes: Map<string, ShapeSignature>
    constantShapes: Map<Handle, string>
    addressed: Set<string>
    repOf(type: Type): Rep
    elementOf(buffers: number[]): Rep
    shapeOf(allocation: number): string | undefined
    bufferGroups(): Map<number, number[]>
    bufferGroup(allocation: number): number
    collapses(members: number[]): boolean
    joinBuffers(allocations: number[]): void
    layOut(tagged: Set<number>, inlined?: Map<number, intrinsics.Types[]>): void
}

export function instantiate(types: ValueTypes, genericOf: (proto: Handle) => Generic | undefined, joins: number[][] = [], fieldType: (allocation: number, key: string, type: Type) => Type = (_, __, type) => type): Instantiations {
    const keys: string[] = []
    const owners: (string | undefined)[] = []
    const ownerClasses: (string | undefined)[] = []
    const pending = new Set<number>()
    function genericFor(id: number): Generic | undefined {
        const proto = types.objects[id].proto
        return proto ? genericOf(proto) : undefined
    }
    const rep = (type: Type) => representation(type, keyOf)
    function layoutOf(members: number[], indexed: boolean): [string, Type][] {
        const merged = new Map<string, Type>()
        for (const id of members) {
            const object = types.objects[id]
            for (const [k, field] of object.fields) {
                if (!writtenForms(field.forms)) continue
                const at = (indexed || object.fields.has(numberKey)) && constantIndex(k) ? numberKey : k
                const type = at === k && !constantIndex(k) ? fieldType(id, k, field.type) : field.type
                merged.set(at, merged.has(at) ? union(merged.get(at)!, type) : type)
            }
        }
        return [...merged.keys()].sort().map(k => [k, merged.get(k)!])
    }
    const fieldTypeAt = (objects: number[], key: string) => fieldAt(types, objects, [key])?.type
    function claim(id: number, owner: string, generic: Generic): void {
        generic.interior(id, fieldTypeAt, inner => !!genericFor(inner), (inner, keys) => {
            owners[inner] ??= `${owner}.${keys.join('.')}`
            ownerClasses[inner] ??= `${generic.name}.${keys.join('.')}`
        })
    }
    const recordParent = types.objects.map((_, i) => i)
    const findRecord = (a: number) => rootOf(recordParent, a)
    const joinable = (id: number) => {
        const object = types.objects[id]
        if (object.native || object.dynamic || object.kind === AllocKind.buffer) return false
        return genericFor(id) ? true : !object.constant || object.name === 'Object'
    }
    const recordKeys = types.objects.map(object => [...object.fields.keys()].sort().join(','))
    const recordCopied = types.objects.map(object => object.copied)
    function presenceKept(a: number, b: number): boolean {
        if (!recordCopied[a] && !recordCopied[b]) return true
        return recordKeys[a] === recordKeys[b]
    }
    function joinRecords(list: number[]): boolean {
        const byProto = new Map<Handle | undefined, number>()
        let merged = false
        for (const id of list) {
            if (!joinable(id)) continue
            const first = byProto.get(types.objects[id].proto)
            if (first === undefined) {
                byProto.set(types.objects[id].proto, id)
                continue
            }
            const into = findRecord(first)
            const from = findRecord(id)
            if (into === from || !presenceKept(into, from)) continue
            recordParent[from] = into
            recordCopied[into] = recordCopied[into] || recordCopied[from]
            if (recordKeys[into] !== recordKeys[from]) recordKeys[into] = '*'
            merged = true
        }
        return merged
    }
    for (const object of types.objects) for (const field of object.fields.values()) joinRecords(field.type.objects)
    const sharedNative = new Map<Handle, number[]>()
    types.objects.forEach((object, id) => {
        const cell = object.native ? object.state ?? object.handle : undefined
        if (cell !== undefined) listOf(sharedNative, cell).push(id)
    })
    for (const ids of sharedNative.values()) {
        if (ids.length < 2) continue
        const byKey = new Map<string, number[]>()
        for (const id of ids) for (const [k, field] of types.objects[id].fields) listOf(byKey, k).push(...field.type.objects)
        for (const list of byKey.values()) joinRecords(list)
    }
    for (const list of joins) joinRecords(list)
    for (const frame of types.frames) {
        for (const param of frame.params) if (!param.opaque) joinRecords(param.type.objects)
        joinRecords(frame.returns.objects)
    }
    for (let changed = true; changed;) {
        changed = false
        const groups = new Map<number, number[]>()
        types.objects.forEach((_, id) => {
            if (!joinable(id)) return
            const list = listOf(groups, findRecord(id))
            list.push(id)
        })
        for (const members of groups.values()) {
            if (members.length < 2) continue
            const byKey = new Map<string, number[]>()
            for (const id of members) for (const [k, field] of types.objects[id].fields) {
                const list = listOf(byKey, k)
                list.push(...field.type.objects)
            }
            for (const list of byKey.values()) if (joinRecords(list)) changed = true
        }
    }
    const recordMembers = new Map<number, number[]>()
    types.objects.forEach((_, id) => {
        if (!joinable(id)) return
        const list = listOf(recordMembers, findRecord(id))
        list.push(id)
    })
    const paramTypes = new Map<number, (Type | undefined)[]>()
    function genericParams(id: number, generic: Generic): (Type | undefined)[] {
        const root = findRecord(id)
        const known = paramTypes.get(root)
        if (known) return known
        const out = generic.args(recordMembers.get(root) ?? [id], fieldTypeAt)
        if (recordMembers.has(root)) paramTypes.set(root, out)
        return out
    }
    function keyOf(id: number): string {
        if (keys[id] !== undefined) return keys[id]
        if (pending.has(id)) return `^${types.objects[id].name}`
        pending.add(id)
        const object = types.objects[id]
        const generic = genericFor(id)
        let key: string
        if (generic) {
            const args = genericParams(id, generic).map(type => type ? rep(type) : 'never')
            key = `${generic.name}${args.length ? `<${args.join(', ')}>` : ''}`
            claim(id, key, generic)
        } else key = owners[id] ?? `${object.name}@${object.site.unit.name || '<anon>'}:%${object.site.node}`
        const joined = !generic && owners[id] === undefined && joinable(id) ? recordMembers.get(findRecord(id)) ?? [id] : [id]
        if (joined.length > 1) key = `${object.name}@join${findRecord(id)}`
        if (!generic && owners[id] === undefined) key = `${key}{${layoutOf(joined, false).map(([k, type]) => `${k}: ${rep(type)}`).join(', ')}}`
        pending.delete(id)
        keys[id] = key
        return key
    }
    types.objects.forEach((_, id) => { if (genericFor(id)) keyOf(id) })
    const table = new Map<string, Instantiation>()
    types.objects.forEach((object, id) => {
        const key = keyOf(id)
        let entry = table.get(key)
        if (!entry) table.set(key, entry = { key, members: [], fields: new Map() })
        entry.members.push(id)
    })
    const raw = (id: number) => types.objects[id].kind === AllocKind.buffer || (owners[id] !== undefined && !genericFor(id))
    function elementType(members: number[]): [Type | undefined, string[]] {
        const forms = new Set<string>()
        let type: Type | undefined
        for (const id of members) for (const [k, field] of types.objects[id].fields) {
            if (k !== numberKey && !constantIndex(k)) continue
            if (!writtenForms(field.forms)) continue
            for (const form of field.forms) forms.add(form)
            type = type ? union(type, field.type) : field.type
        }
        return [type, [...forms].filter(form => form !== 'prop' && form !== 'init' && form !== 'void')]
    }
    const bufferRoot = types.objects.map((_, i) => i)
    const bufferGroup = (a: number) => rootOf(bufferRoot, a)
    function joinBuffers(ids: number[]): void {
        for (const id of ids) bufferRoot[bufferGroup(id)] = bufferGroup(ids[0])
    }
    for (const entry of table.values()) {
        const owned = owners[entry.members[0]] !== undefined
        if (raw(entry.members[0])) joinBuffers(entry.members)
        for (const [k, type] of layoutOf(entry.members, owned)) {
            entry.fields.set(k, rep(type))
            joinBuffers(type.objects.filter(raw))
        }
    }
    function groupBuffers(): Map<number, number[]> {
        const groups = new Map<number, number[]>()
        types.objects.forEach((_, id) => {
            if (!raw(id)) return
            listOf(groups, bufferGroup(id)).push(id)
        })
        return groups
    }
    let bufferMembers: Map<number, number[]> | undefined
    let tagged = new Set<number>()
    let inlineGroups = new Map<number, intrinsics.Types[]>()
    const wideGroups = new Set<number>()
    const elements = new Map<number, Rep>()
    function elementOf(buffers: number[]): Rep {
        if (!buffers.length) return elementRep([])
        intrinsics.assert(bufferMembers !== undefined, 'value-types: element layout read before layOut')
        const group = bufferGroup(buffers[0])
        const known = elements.get(group)
        if (known) return known
        const base = elementRep(bufferMembers.get(group) ?? buffers, wideGroups.has(group))
        const words = inlineGroups.get(group)
        const element = !words ? base : { ...base, inline: words }
        elements.set(group, element)
        return element
    }
    function collapses(members: number[]): boolean {
        const [type, stored] = elementType(members)
        return !!type && stored.length === 1 && stored[0] === 'vm_value' && falsyCollapsible(repOf(type))
    }
    function heldElement(members: number[]): Rep {
        const [type, stored] = elementType(members)
        if (type && stored.length === 1 && stored[0] === 'vm_value') return repOf(type)
        return elementRep(members)
    }
    const heldBuffers = new Map<string, Map<string, number[]>>()
    const laidOut = new Set<string>()
    function layOutShape(id: string): void {
        const sig = shapes.get(id)!
        const held = heldBuffers.get(id)!
        sig.fields = sig.fields.map(([k, field]) => {
            const buffers = held.get(k)
            if (!buffers) return [k, field]
            const element = elementOf(buffers)
            intrinsics.assert(!laidOut.has(id) || sameRep(field.element!, element), `value-types: ${id}.${k} was laid out as ${repText(field)}, its buffers now need ${repText({ ...field, element })}`)
            return [k, { ...field, element }]
        })
        laidOut.add(id)
    }
    const shapes = new Map<string, ShapeSignature>()
    const protoOrders = new Map<Handle, string[]>()
    const shapeIds = new Map<string, string>()
    const shapePending = new Map<string, string>()
    const referenced = new Set<string>()
    const createdFields = new Map<string, [string, Rep][]>()
    let nextShape = 0
    function elementRep(members: number[], wide = false): Rep {
        const [type, stored] = elementType(members)
        if (!type) return { kind: 'never', members: 0, shapes: [], nullable: false }
        if (stored.length === 1 && stored[0] === 'vm_value') {
            const shown = repOf(type)
            const constant = members.some(id => types.objects[id].constant)
            const inner = falsyCollapsible(shown) && !constant && !members.some(id => tagged.has(id)) ? repOf({ ...type, undefined: false }) : shown
            const free = wide && inner.kind === 'number' && !!inner.format && !inner.nullable
            if ((free || rawElement(inner) || elementTagged(inner) || floatUnion(inner)) && !constant) return inner
            return { ...inner, encoded: true }
        }
        if (!stored.length) return repOf(type)
        const forms = stored.sort()
        const form = forms.length === 1 ? forms[0] : undefined
        if (form === 'f64') return { kind: 'number', members: 0, shapes: [], nullable: false }
        if (form === 'f32') return { kind: 'number', forms, members: 0, shapes: [], nullable: false }
        if (form !== undefined && /^(bool|[ui](8|16|32|64))$/.test(form)) return { kind: 'number', forms, format: { bits: form.endsWith('64') ? 64 : 32, signed: false }, members: 0, shapes: [], nullable: false }
        return { kind: 'any', forms, members: 0, shapes: [], nullable: false }
    }
    function shapeId(key: string): string {
        const known = shapeIds.get(key)
        if (known) return known
        const pending = shapePending.get(key)
        if (pending) {
            referenced.add(pending)
            return pending
        }
        const reserved = `S${nextShape++}`
        shapePending.set(key, reserved)
        const entry = table.get(key)!
        const object = types.objects[entry.members[0]]
        const fields: [string, Rep][] = []
        const held: [string, number[]][] = []
        const absent = new Set<string>()
        const nullish = new Set<string>()
        const members = entry.members.map(id => types.objects[id])
        const constant = members.find(o => o.constant && o.state !== undefined)
        const fixed = constant ?? members.find(o => o.state !== undefined && dataKeys(o.state).length > 0)
        const stateOrder = fixed ? dataKeys(fixed.state!).map(k => keyLabel(k)) : []
        const shared = !constant && object.proto !== undefined ? protoOrders.get(object.proto) : undefined
        const order = shared ?? stateOrder
        if (object.proto !== undefined && stateOrder.length && !protoOrders.has(object.proto)) protoOrders.set(object.proto, stateOrder)
        for (const [k, merged] of layoutOf(entry.members, false)) {
            if (k === numberKey || k.startsWith('@')) continue
            const partial = entry.members.some(id => {
