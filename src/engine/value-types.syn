    const retSets = new Map<number, Map<number, Set<number>>>()
    const callSites = new Map<number, Set<number>>()
    const work: number[] = []
    const queued = new Set<number>()
    const stale = new Set<number>()
    const dirty = new Set<number>()

    function setOf<K, V>(map: Map<K, Set<V>>, k: K): Set<V> {
        let set = map.get(k)
        if (!set) map.set(k, set = new Set())
        return set
    }
    interface Filter {
