/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { firstNonOrderingSlot, NumericOps, OrderedValues, stronglyConnected, type Graph, type GraphNode, typeName } from './lowering2'
import { countIds, getBlock, getLiteral, getNode, getRef, isThisParam, NodeOp, nodeUsers, opName, resultType, spreadsLast, typeOf, allNodes, countNodes, hasNode, nodeEntries, nodeIds, heapInterior, heapField, heapFieldCount } from './graph-node'
import type { TraceSession } from './trace2'
import { dataKeys } from './property-eval'
import * as rt from './rt'

type Handle = intrinsics.Handle

export enum AllocKind {
    object,
    array,
    buffer,
    scope,
}

export interface Site {
    unit: Function
    node: number
    frame?: number
    operand?: number
}

export interface Allocation {
    site: Site
    frame?: number
    frames?: number[]
    kind: AllocKind
    state?: Handle
    handle?: Handle
    proto: Handle | undefined
    constant: boolean
    native?: boolean
    dynamic?: boolean
    copied?: boolean
    function?: Function
}
export interface Location {
    allocation: number
    key: string
    handle: Handle | undefined
    type: Type
    forms: string[]
    readers: Site[]
    writers: Site[]
    stored: boolean
}


export type Interval = [lo: number, hi: number]

export interface WordAccess {
    node: number
    store: boolean
    slots: number[]
}

export interface WordSlot {
    allocation: number
    key: string
    mixed: boolean
}

export interface UnitTypes {
    nodes: Map<number, Type>
    slices: Map<number, number[]>
    blocks: Set<number>
    selects: Map<number, boolean[]>
}

export interface Accesses {
    resolve(frames: number[]): UnitTypes
    allocations: Allocation[]
    locations: Location[]
    frames: FrameSignature[]
}

export const numberKey = '[number]'
export interface AccessHost {
    session: TraceSession
    graphOf(fn: Function): Graph
    functionOf(handle: u32): Function | undefined
    localFunction(symbol: number): Function | undefined
    traceable(fn: Function): boolean
    constantElements?(state: Handle): Handle[] | undefined
    bindTarget?(fn: Function, count: number, spread: boolean): Function
    heapValue?(slot: Handle): Handle
    isConstructor?(fn: Function): boolean
    freshCells?(fn: Function): { allocations: number[], closures: number[], frames: number[] }
}
export function boundCallee(host: AccessHost, fn: Function, call: GraphNode): Function {
    if (!host.bindTarget || call.op !== NodeOp.call) return fn
    return host.bindTarget(fn, countIds(call) - 3, spreadsLast(call))
}

const nodeSpan = 2 ** 24

const Types = intrinsics.Types

export function scalarType(T: intrinsics.Types): boolean {
    return T !== Types.u64 && T !== Types.vm_value && T !== Types.ptr && T !== Types.fnptr && T !== Types.usize && T !== Types.void && T !== Types.unknown && T !== Types.handle && T !== Types.unknown_number
}

const MinI64 = -(2 ** 63)
const MaxI64 = 2 ** 63
const MaxU64 = 2 ** 64
const Boundaries: [intrinsics.Types, Interval][] = [
    [Types.u8, [0, 255]], [Types.u16, [0, 65535]], [Types.u32, [0, 2 ** 32 - 1]], [Types.u64, [0, MaxU64]],
    [Types.i8, [-128, 127]], [Types.i16, [-32768, 32767]], [Types.i32, [-(2 ** 31), 2 ** 31 - 1]], [Types.i64, [MinI64, MaxI64]],
]

function within(a: Interval, b: Interval): boolean {
    return a[0] >= b[0] && a[1] <= b[1]
}

function rangeName(range: Interval): string {
    const exact = Boundaries.find(([, bound]) => bound[0] === range[0] && bound[1] === range[1])
    return exact ? typeName(exact[0]) : `${range[0]}..${range[1]}`
}

function hull(a: Interval | undefined, b: Interval | undefined): Interval | undefined {
    if (!a || !b) return a ?? b
    if (within(b, a)) return a
    if (within(a, b)) return b
    return [Math.min(a[0], b[0]), Math.max(a[1], b[1])]
}

export interface IntFormat {
    bits: 32 | 64
    signed: boolean
}

function numberText(format: IntFormat | undefined): 'int' | 'i64' | 'f64' {
    return !format ? 'f64' : format.signed ? 'i64' : 'int'
}

export function numberName(rep: Rep | undefined): 'int' | 'i64' | 'f64' | undefined {
    return rep?.kind === 'number' ? numberText(rep.format) : undefined
}

function intFormat(range: Interval): IntFormat {
    const signed = range[0] < 0
    return { bits: within(range, signed ? Boundaries[6][1] : Boundaries[2][1]) ? 32 : 64, signed }
}
const users = new WeakMap<Graph, { size: number, index: Map<number, [number, number][]> }>()
export function usersOf(g: Graph): Map<number, [number, number][]> {
    const known = users.get(g)
    if (known) {
        intrinsics.assert(known.size === countNodes(g), `value-types: ${g.name ?? 'graph'} changed after its users were indexed`)
        return known.index
    }
    const index = nodeUsers(g, nodeIds(g), true)
    users.set(g, { size: countNodes(g), index })
    return index
}
function useDominators(g: Graph): { idom: Map<number, number>, order: number[] } {
    const users = usersOf(g)
    const bodyOf = new Map<number, number[]>()
    for (const b of g.blocks) {
        if (!b.bodyId) continue
        listOf(bodyOf, b.bodyId).push(b.id)
    }
    const entries = (block: number) => (users.get(block) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
    function succs(v: number): number[] {
        const out: number[] = []
        if (v === 0) {
            for (const b of g.blocks) if (!entries(b.id).length) out.push(-b.id)
            for (const id of nodeIds(g)) if (!users.get(id)?.length && !bodyOf.has(id)) out.push(id)
            return out
        }
        if (v < 0) {
            const body = getBlock(g, -v)?.bodyId
            if (body && hasNode(g, body)) out.push(body)
            return out
        }
        const n = getNode(g, v)!
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (ref && hasNode(g, ref)) out.push(ref)
        }
        if (n.op === NodeOp.apply && getBlock(g, getRef(n, 0))) out.push(-getRef(n, 0))
        return out
    }
    function preds(v: number): number[] {
        const out = v < 0 ? entries(-v) : (users.get(v) ?? []).map(([u]) => u)
        if (v > 0) for (const b of bodyOf.get(v) ?? []) out.push(-b)
        if (!out.length) out.push(0)
        return out
    }
    const order: number[] = [0]
    const index = new Map<number, number>([[0, 0]])
    const parent: number[] = [0]
    const path: number[] = [0]
    const pending: number[][] = [succs(0).reverse()]
    while (pending.length) {
        const top = pending[pending.length - 1]
        if (!top.length) {
            path.pop()
            pending.pop()
            continue
        }
        const w = top.pop()!
        if (index.has(w)) continue
        index.set(w, order.length)
        parent.push(path[path.length - 1])
        path.push(order.length)
        order.push(w)
        pending.push(succs(w).reverse())
    }
    const semi = order.map((_, i) => i)
    const ancestor = order.map(() => -1)
    const label = order.map((_, i) => i)
    const dom = order.map(() => 0)
    const bucket: number[][] = order.map(() => [])
    function evaluate(v: number): number {
        if (ancestor[v] === -1) return v
        const chain: number[] = []
        let at = v
        while (ancestor[ancestor[at]] !== -1) {
            chain.push(at)
            at = ancestor[at]
        }
        while (chain.length) {
            const x = chain.pop()!
            const a = ancestor[x]
            if (semi[label[a]] < semi[label[x]]) label[x] = label[a]
            ancestor[x] = ancestor[a]
        }
        return label[v]
    }
    for (let i = order.length - 1; i > 0; i--) {
        for (const p of preds(order[i])) {
            const v = index.get(p)
            if (v === undefined) continue
            const u = evaluate(v)
            if (semi[u] < semi[i]) semi[i] = semi[u]
        }
        bucket[semi[i]].push(i)
        ancestor[i] = parent[i]
        for (const v of bucket[parent[i]]) {
            const u = evaluate(v)
            dom[v] = semi[u] < semi[v] ? u : parent[i]
        }
        bucket[parent[i]] = []
    }
    const idom = new Map<number, number>()
    for (let i = 1; i < order.length; i++) {
        if (dom[i] !== semi[i]) dom[i] = dom[dom[i]]
        idom.set(order[i], order[dom[i]])
    }
    return { idom, order }
}
export interface ArmRecord {
    select: number
    arm: number
    positive: boolean
    order: number
}
interface ArmIndex {
    records: Map<number, ArmRecord[]>
    nearest: Map<number, number>
    parent: Map<number, number>
    chains: Map<number, ArmRecord[]>
    arms: Map<number, [cond: number, positive: boolean][]>
    guards: Map<number, [cond: number, positive: boolean][]>
}
const armIndexes = new WeakMap<Graph, ArmIndex>()
export function armIndexOf(g: Graph): ArmIndex {
    const known = armIndexes.get(g)
    if (known) return known
    const records = new Map<number, ArmRecord[]>()
    let order = 0
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.select || countIds(n) !== 3) continue
        for (let slot = 1; slot < 3; slot++) {
            const arm = getRef(n, slot)
            order++
            if (!arm) continue
            const list = records.get(arm)
            const record = { select: id, arm, positive: slot === 1, order }
            if (list) list.push(record)
            else records.set(arm, [record])
        }
    }
    const nearest = new Map<number, number>()
    const parent = new Map<number, number>()
    if (records.size) {
        const { idom, order: preorder } = useDominators(g)
        for (const v of preorder) {
            if (v === 0) continue
            const up = nearest.get(idom.get(v)!)
            const param = v > 0 && getNode(g, v)!.op === NodeOp.param
            if (records.has(v)) {
                nearest.set(v, v)
                if (up !== undefined && !param) parent.set(v, up)
            } else if (up !== undefined && !param) nearest.set(v, up)
        }
        for (const root of records.keys()) if (!nearest.has(root)) nearest.set(root, root)
    }
    const index = { records, nearest, parent, chains: new Map(), arms: new Map(), guards: new Map() }
    armIndexes.set(g, index)
    return index
}
function armChain(g: Graph, root: number): ArmRecord[] {
    const index = armIndexOf(g)
    const climb: number[] = []
    let at: number | undefined = root
    while (at !== undefined && !index.chains.has(at)) {
        climb.push(at)
        at = index.parent.get(at)
    }
    let below = at === undefined ? [] : index.chains.get(at)!
    while (climb.length) {
        const r = climb.pop()!
        const chain = [...below, ...index.records.get(r)!].sort((a, b) => a.order - b.order)
        index.chains.set(r, chain)
        below = chain
    }
    return below
}
export function armsAt(g: Graph, node: number): [cond: number, positive: boolean][] | undefined {
    const index = armIndexOf(g)
    const root = index.nearest.get(node)
    if (root === undefined) return
    const known = index.arms.get(root)
    if (known) return known
    const out: [number, boolean][] = []
    for (const record of armChain(g, root)) {
        const cond = getRef(getNode(g, record.select)!, 0)
        if (cond) out.push([cond, record.positive])
    }
    index.arms.set(root, out)
    return out
}
const bodies = new WeakMap<Graph, Map<number, Set<number>>>()
export function bodyNodes(g: Graph, body: number): Set<number> {
    let byGraph = bodies.get(g)
    if (!byGraph) bodies.set(g, byGraph = new Map())
    const known = byGraph.get(body)
    if (known) return known
    const found = new Set<number>()
    const work = [body]
    while (work.length) {
        const id = work.pop()!
        if (found.has(id)) continue
        found.add(id)
        const n = getNode(g, id)
        if (n) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) work.push(getRef(n, i))
    }
    byGraph.set(body, found)
    return found
}
export interface Type {
    undefined: boolean
    unknown: boolean
    bools: number
    literals: number[]
    range?: Interval
    float: boolean
    objects: number[]
    functions: Function[]
    closures: number[]
    strings: number[]
}

export interface ObjectType extends Allocation {
    name: string
    fields: Map<string, ObjectField>
    readers: Site[]
}

interface ObjectField extends Field {
    initialized: boolean
    constructed: boolean
    stored: boolean
}

export interface Signature<T = Type> {
    params: { label: string, type: T, opaque?: boolean }[]
    returns: T
}

export interface FrameSignature extends Signature {
    unit: Function
    heldStatic: boolean
    sites: Site[]
    accesses: WordAccess[]
    merges: number[][]
}

export interface ValueTypes {
    resolve(frames: number[]): UnitTypes
    ms: number
    frames: FrameSignature[]
    wordSlots: WordSlot[]
    objects: ObjectType[]
    stateAllocations: Map<Handle, number[]>
    keyHandles: Map<string, Handle>
    keyNames: Map<Handle, string>
    fieldStores: Set<string>
    erasedFields: Map<number, Set<string>>
}

export interface Field {
    type: Type
    forms: string[]
}

function fieldAt(types: ValueTypes, allocations: number[], keys: string[]): Field | undefined {
    let current = allocations
    let field: Field | undefined
    for (const key of keys) {
        if (!current.length) return
        let type = emptyType()
        let forms: string[] = []
        let found = false
        for (const allocation of current) {
            const object = types.objects[allocation]
            const known = object.fields.get(key) ?? (constantIndex(key) ? object.fields.get(numberKey) : undefined)
            if (known) {
                found = true
                type = union(type, known.type)
                forms = merge(forms, known.forms)
            }
            if (key === numberKey) for (const [other, inner] of object.fields) if (constantIndex(other)) {
                found = true
                type = union(type, inner.type)
                forms = merge(forms, inner.forms)
            }
        }
        if (!found) return
        field = { type, forms }
        current = type.objects
    }
    return field
}

function wordStore(g: Graph, n: GraphNode): boolean {
    if (n.op === NodeOp.store) return resultType(g, n) === Types.vm_value
    return rt.sliceOf(g, n) === rt.Op.sliceWrite && rt.elementType(g, n) === Types.vm_value
}

function wordLoad(g: Graph, n: GraphNode): boolean {
    if (n.op === NodeOp.load) return resultType(g, n) === Types.vm_value
    return rt.sliceOf(g, n) === rt.Op.sliceRead && rt.elementType(g, n) === Types.vm_value
}

export function constantIndex(key: string): boolean {
    return /^(\[\d+\]|@-?\d+)$/.test(key)
}

export function emptyType(): Type {
    return { undefined: false, unknown: false, bools: 0, literals: [], float: false, objects: [], functions: [], closures: [], strings: [] }
}

function merge<T>(a: T[], b: T[]): T[] {
    if (a === b || !b.length) return a
    if (!a.length) return b
    const seen = new Set(a)
    let out: T[] | undefined
    for (const x of b) {
        if (seen.has(x)) continue
        seen.add(x)
        if (!out) out = [...a]
        out.push(x)
    }
    return out ?? a
}

function union(a: Type, b: Type): Type {
    if (a === b) return a
    const literals = merge(a.literals, b.literals)
    const range = hull(a.range, b.range)
    const objects = merge(a.objects, b.objects)
    const functions = merge(a.functions, b.functions)
    const closures = merge(a.closures, b.closures)
    const strings = merge(a.strings, b.strings)
    const flags = (a.undefined || !b.undefined) && (a.unknown || !b.unknown) && (a.float || !b.float) && (a.bools | b.bools) === a.bools
    if (flags && literals === a.literals && range === a.range && objects === a.objects && functions === a.functions && closures === a.closures && strings === a.strings) return a
    return { undefined: a.undefined || b.undefined, unknown: a.unknown || b.unknown, bools: a.bools | b.bools, literals, range, float: a.float || b.float, objects, functions, closures, strings }
}

function mergeAll<T>(lists: T[][]): T[] {
    let out = lists[0]
    let seen: Set<T> | undefined
    let copied = false
    for (let i = 1; i < lists.length; i++) {
        const b = lists[i]
        if (b === out || !b.length) continue
        if (!out.length) {
            out = b
            continue
        }
        if (!seen) seen = new Set(out)
        for (const x of b) {
            if (seen.has(x)) continue
            seen.add(x)
            if (!copied) {
                out = out.slice()
                copied = true
            }
            out.push(x)
        }
    }
    return out
}

export function unionAll(types: Type[]): Type {
    if (types.length === 1) return types[0]
    if (types.length === 2) return union(types[0], types[1])
    const a = types[0]
    const literals = mergeAll(types.map(type => type.literals))
    let range = a.range
    for (let i = 1; i < types.length; i++) range = hull(range, types[i].range)
    const objects = mergeAll(types.map(type => type.objects))
    const functions = mergeAll(types.map(type => type.functions))
    const closures = mergeAll(types.map(type => type.closures))
    const strings = mergeAll(types.map(type => type.strings))
    const anyUndefined = types.some(type => type.undefined)
    const anyUnknown = types.some(type => type.unknown)
    const anyFloat = types.some(type => type.float)
    let bools = 0
    for (const type of types) bools = bools | type.bools
    const flags = (a.undefined || !anyUndefined) && (a.unknown || !anyUnknown) && (a.float || !anyFloat) && bools === a.bools
    if (flags && literals === a.literals && range === a.range && objects === a.objects && functions === a.functions && closures === a.closures && strings === a.strings) return a
    return { undefined: anyUndefined, unknown: anyUnknown, bools, literals, range, float: anyFloat, objects, functions, closures, strings }
}

function constructorOf(proto: Handle | undefined, host: AccessHost): Function | undefined {
    const ctor = proto ? heap.getOwnProperty(proto, heap.fromJsString('constructor')) : 0
    return ctor ? host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32) : undefined
}

function allocationName(allocation: Allocation, host: AccessHost): string {
    if (allocation.kind === AllocKind.array) return 'Array'
    if (allocation.kind === AllocKind.buffer) return 'buffer'
    if (allocation.kind === AllocKind.scope) return 'Scope'
    return constructorOf(allocation.proto, host)?.name || 'Object'
}

export function inhabited(type: Type): boolean {
    return type.undefined || type.unknown || type.bools !== 0 || type.float || type.range !== undefined || type.literals.length > 0 || type.strings.length > 0 || type.objects.length > 0 || type.functions.length > 0 || type.closures.length > 0
}

function receiverOf(frame: FrameSignature): number | undefined {
    const self = frame.params.find(p => p.label === 'this')?.type
    return self && self.objects.length === 1 ? self.objects[0] : undefined
}

function wordSlotsOf(locations: Location[]): WordSlot[] {
    const kindsOf = new Map<string, number>()
    const wordSlots: WordSlot[] = []
    const tuples = new Set<number>()
    for (const location of locations) if (location.key === numberKey) tuples.add(location.allocation)
    for (const location of locations) {
        const indexed = location.key === numberKey || (constantIndex(location.key) && tuples.has(location.allocation))
        const key = indexed ? numberKey : location.key
        const k = `${location.allocation}:${key}`
        let kinds = kindsOf.get(k) ?? 0
        const type = location.type
        if (type.literals.length || type.range || type.float) kinds |= 1
        if (type.objects.length || type.strings.length) kinds |= 2
        if (type.bools) kinds |= 4
        kindsOf.set(k, kinds)
        wordSlots.push({ allocation: location.allocation, key, mixed: false })
    }
    for (const slot of wordSlots) {
        const kinds = kindsOf.get(`${slot.allocation}:${slot.key}`)!
        slot.mixed = kinds === 3 || kinds > 4
    }
    return wordSlots
}

export function analyzeTypes(data: Accesses, host: AccessHost, roots: Function[]): ValueTypes {
    const start = performance.now()
    const objects: ObjectType[] = data.allocations.map(allocation => ({ ...allocation, name: allocationName(allocation, host), fields: new Map(), readers: [] }))
    const keyHandles = new Map<string, Handle>()
    const locations = data.locations
    for (const location of locations) if (location.handle !== undefined) keyHandles.set(location.key, location.handle)
    function constructorStore(object: ObjectType, site: Site): boolean {
        const fn = constructorOf(object.proto, host)
        if (fn !== site.unit || !host.isConstructor?.(fn)) return false
        const g = host.graphOf(fn)
        const n = getNode(g, site.node)
        if (n?.op !== NodeOp.setProp || !receiverValue(g, getRef(n, 1))) return false
        const block = blockOf(g, site.node)
        return !!block && !repeats(g, block, site.node)
    }
    const written = (location: Location) => inhabited(location.type) || location.writers.length > 0
    const indexed = new Set(locations.filter(location => (location.key === numberKey || constantIndex(location.key)) && written(location)).map(location => location.allocation))
    const initialWrites: [allocation: number, key: string, node: number][] = []
    const erased = unobservedFields(data, roots, host)
    const erasedFields = new Map<number, Set<string>>()
    for (const location of locations) {
        const object = objects[location.allocation]
        if (erased.has(location)) {
            let keys = erasedFields.get(location.allocation)
            if (!keys) erasedFields.set(location.allocation, keys = new Set())
            keys.add(location.key)
            continue
        }
        if (!written(location) && indexed.has(location.allocation) && (location.key === numberKey || constantIndex(location.key))) continue
        const field: ObjectField = { type: location.type, forms: location.forms, stored: location.stored, initialized: false, constructed: false }
        object.fields.set(location.key, field)
        object.readers.push(...location.readers)
        const writer = location.writers[0]
        if (!writer || !location.writers.every(w => w.unit === writer.unit && w.node === writer.node)) continue
        if (writer.unit === object.site.unit && !location.forms.includes('init')) initialWrites.push([location.allocation, location.key, writer.node])
        field.constructed = constructorStore(object, writer)
    }
    const contained = new Set(objects.flatMap(object => [...object.fields.values()].flatMap(field => field.type.objects)))
    for (const [id, key, node] of initialWrites) {
        const object = objects[id]
        if (object.fields.size !== 1 || contained.has(id)) continue
        const g = host.graphOf(object.site.unit)
        const block = blockOf(g, node)
        if (block && block === blockOf(g, object.site.node)) object.fields.get(key)!.initialized = true
    }
    const frames: FrameSignature[] = data.frames
    const stateAllocations = new Map<Handle, number[]>()
    objects.forEach((object, id) => {
        if (object.state === undefined) return
        listOf(stateAllocations, object.state).push(id)
    })
    if (intrinsics.argv().includes('frames-dump')) frames.forEach((frame, id) => console.log('FRAME', id, frame.unit.name || '<anon>', frame.heldStatic ? '<static>' : '<>', frame.params.map(p => `${p.label}:${formatType({ objects } as ValueTypes, p.type)}`).join(' '), '->', formatType({ objects } as ValueTypes, frame.returns)))
    const fieldStores = new Set<string>()
    for (const location of data.locations) for (const site of location.writers) fieldStores.add(`${unitIdentity(site.unit)}:${site.node}`)
    const keyNames = new Map([...keyHandles].map(([name, key]) => [key, name]))
    return { resolve: data.resolve, ms: performance.now() - start, objects, frames, wordSlots: wordSlotsOf(locations), stateAllocations, keyHandles, keyNames, fieldStores, erasedFields }
}

function unobservedFields(data: Accesses, roots: Function[], host: AccessHost): Set<Location> {
    const exposed = new Set<number>()
    data.frames.forEach((frame, i) => {
        if (!roots.includes(frame.unit)) return
        const graph = host.graphOf(frame.unit)
        const nodes = data.resolve([i]).nodes
        for (const n of allNodes(graph)) {
            if (n.op !== NodeOp.ret) continue
            for (const id of nodes.get(getRef(n, 0))?.objects ?? []) exposed.add(id)
        }
    })
    const fieldsOf = new Map<number, Location[]>()
    for (const location of data.locations) listOf(fieldsOf, location.allocation).push(location)
    const work = [...exposed]
    while (work.length) {
        const id = work.pop()!
        for (const location of fieldsOf.get(id) ?? []) {
            for (const inner of location.type.objects) {
                if (exposed.has(inner)) continue
                exposed.add(inner)
                work.push(inner)
            }
        }
    }
    const erased = new Set<Location>()
    for (const [id, locations] of fieldsOf) {
        const allocation = data.allocations[id]
        if (exposed.has(id) || allocation.kind !== AllocKind.object || allocation.function) continue
        if (allocation.constant || allocation.native || allocation.dynamic || allocation.copied) continue
        if (allocation.state !== undefined && heap.isCallable(allocation.state)) continue
        const erasable = (location: Location) => !location.readers.length && location.handle !== undefined && (heap.isString(location.handle) || heap.isPrivateName(location.handle))
        const unread = locations.filter(erasable)
        if (!locations.some(location => location.writers.length && !erasable(location))) continue
        for (const location of unread) erased.add(location)
    }
    return erased
}
function initOnly(object: ObjectType, k: string | undefined): boolean {
    return k === undefined || (object.fields.get(k)?.forms ?? []).every(form => form === 'init')
}

export function constructionNode(construction: Graph, cell: number): GraphNode | undefined {
    for (const n of allNodes(construction)) {
        if (n.op === NodeOp.heapHandle && !getRef(n, 0) && getLiteral(construction, n, 0) === cell && !heapInterior(construction, n) && heapFieldCount(n)) return n
    }
    return undefined
}

export function constructedAllocation(construction: Graph, cell: number, key: Handle): boolean {
    const holder = constructionNode(construction, cell)
    const field = holder ? heapField(construction, holder, key) : undefined
    let n = typeof field === 'number' ? getNode(construction, field) : undefined
    while (n?.op === NodeOp.after) n = getNode(construction, getRef(n, countIds(n) - 1))
    return n?.op === NodeOp.pstack
}

function fixedElements(types: ValueTypes, object: ObjectType): boolean {
    for (const field of object.fields.values()) for (const id of field.type.objects) {
        const inner = types.objects[id]
        if (inner.kind === AllocKind.buffer && [...inner.fields.values()].some(field => field.stored)) return false
    }
    return true
}

export function fixedField(types: ValueTypes, state: Handle, key: Handle): boolean {
    const index = heap.keyIndex(key)
    const name = index !== undefined ? `[${index}]` : types.keyNames.get(key)
    return (types.stateAllocations.get(state) ?? []).every(id => {
        const object = types.objects[id]
        return initOnly(object, name) && initOnly(object, numberKey) && (index === undefined || fixedElements(types, object))
    })
}

export function fixedState(types: ValueTypes, state: Handle): boolean {
    return (types.stateAllocations.get(state) ?? []).every(id => [...types.objects[id].fields.keys()].every(k => initOnly(types.objects[id], k)))
}

export function formatType(types: ValueTypes, type: Type): string {
    const parts: string[] = []
    if (type.undefined) parts.push('undefined')
    if (type.bools) parts.push(type.bools === 3 ? 'boolean' : type.bools === 2 ? 'true' : 'false')
    for (const literal of type.literals) if (!type.float && !(type.range && Number.isInteger(literal) && within([literal, literal], type.range))) parts.push(String(literal))
    if (type.range) parts.push(rangeName(type.range))
    if (type.float) parts.push('f64')
    if (type.strings.length) parts.push('string')
    for (const id of type.objects) parts.push(`${types.objects[id].name}#${id}`)
    for (const fn of type.functions) parts.push(`fn ${fn.name || '<anon>'}`)
    if (type.unknown) parts.push('unknown')
    return parts.join(' | ') || 'never'
}

function floatType(type: Type): boolean {
    return type.float || type.literals.some(l => !Number.isInteger(l))
}

function numberSpan(type: Type): Interval | undefined {
    let span = type.range
    for (const l of type.literals) span = hull(span, [l, l])
    return span
}

function numberRepresentation(type: Type): string {
    if (floatType(type)) return 'f64'
    const format = intFormat(numberSpan(type)!)
    return `${format.signed ? 'i' : 'u'}${format.bits}`
}

function nullsOnly(type: Type): boolean {
    return !type.undefined && !opaqueNumber(type) && type.literals.length === 1 && type.literals[0] === 0
}

function representation(type: Type, targetOf = (id: number) => `O${id}`): string {
    if (type.unknown) return 'any'
    const targets = [...new Set([...type.objects, ...type.closures].map(targetOf))].sort()
    if (type.strings.length) targets.push('str')
    if (type.functions.length && !type.closures.length) targets.push('fn')
    if (type.bools && !boolPartners(type)) return representation(boolNumbers(type), targetOf)
    if (type.bools) return 'union'
    const numeric = numericType(type)
    if (!targets.length) return numeric ? (type.undefined ? 'union' : numberRepresentation(type)) : type.undefined ? 'undefined' : 'never'
    if (numeric && !nullsOnly(type)) return 'union'
    return `ptr<${targets.join('|')}>${type.undefined || nullsOnly(type) ? '?' : ''}`
}

function typeStats(types: ValueTypes): string {
    return `TYPES ${types.ms.toFixed(1)}ms frames=${types.frames.length} objects=${types.objects.length}`
}

function joinedSignature<T>(frames: Signature<T>[], joinAll: (list: T[]) => T): Signature<T> {
    return {
        params: frames[0].params.map((param, i) => ({ label: param.label, type: joinAll(frames.map(frame => frame.params[i].type)) })),
        returns: joinAll(frames.map(frame => frame.returns)),
    }
}

export function dumpTypes(types: ValueTypes): string {
    const lines: string[] = [typeStats(types)]
    types.objects.forEach((object, id) => {
        lines.push(`OBJECT O${id} ${object.name}@${object.site.unit.name}:%${object.site.node}<${object.frame === undefined ? '' : `F${object.frame}`}>${object.native ? ' native' : ''}${object.constant ? ' constant' : ''}${object.dynamic ? ' dynamic' : ''}`)
        for (const key of [...object.fields.keys()].sort()) {
            const field = object.fields.get(key)!
            lines.push(`  ${key}: ${formatType(types, field.type)} => ${representation(field.type)} [${field.forms.join(',')}]`)
        }
    })
    const units = new Map<Function, FrameSignature[]>()
    for (const frame of types.frames) {
        listOf(units, frame.unit).push(frame)
    }
    for (const [unit, frames] of units) {
        const signature = joinedSignature(frames, unionAll)
        const params = signature.params.map(p => `${p.label}: ${formatType(types, p.type)} => ${representation(p.type)}`).join(', ')
        lines.push(`SIG ${unit.name || '<anon>'}(${params}) -> ${formatType(types, signature.returns)} => ${representation(signature.returns)}`)
    }
    return lines.join('\n')
}
export interface NativeParam {
    label: string
    kind?: intrinsics.Types
    nullish: boolean
    keys?: string[]
}

export interface NativeUnit {
    name: string
    origin: Function
    sites: Site[]
    params: NativeParam[]
    returns: intrinsics.Types
}

export function checkTypes(types: ValueTypes, units: NativeUnit[]): string {
    const lines: string[] = [typeStats(types)]
    for (const unit of units) {
        const frames = types.frames.filter(frame => frame.unit === unit.origin)
        const sited = frames.filter(frame => frame.sites.some(s => unit.sites.some(site => s.unit === site.unit && s.node === site.node)))
        const selected = sited.length ? sited : frames
        const signature = selected.length ? joinedSignature(selected, unionAll) : undefined
        if (!signature) {
            lines.push(`UNSEEN ${unit.name}`)
            continue
        }
        if (!sited.length && unit.sites.length) lines.push(`UNMATCHED ${unit.name}: ${unit.sites.map(s => `${s.unit.name}:%${s.node}`).join(' ')}`)
        for (const param of unit.params) {
            const mine = signature.params.find(p => p.label === param.label)?.type
            if (!mine) continue
            const repr = representation(mine)
            const shown = `${formatType(types, mine)} => ${repr}`
            if (param.nullish && !(mine.undefined && !mine.objects.length && !numericType(mine))) lines.push(`NULLISH ${unit.name}.${param.label}: native nullish, analysis ${shown}`)
            if (param.kind === Types.f64 && repr !== 'f64') lines.push(`F64 ${unit.name}.${param.label}: native f64, analysis ${shown}`)
            if (param.kind !== undefined && param.kind !== Types.f64 && param.kind !== Types.vm_value && (mine.objects.some(a => types.objects[a].kind !== AllocKind.buffer) || mine.strings.length || mine.unknown)) lines.push(`NUMBER ${unit.name}.${param.label}: native ${typeName(param.kind)}, analysis ${shown}`)
            if (param.keys && !mine.functions.length) {
                if (!mine.objects.length) lines.push(`SHAPE ${unit.name}.${param.label}: native {${param.keys.join(',')}}, analysis ${shown}`)
                else {
                    const missing = param.keys.filter(key => !mine.objects.some(id => types.objects[id].fields.has(key)))
                    if (missing.length) lines.push(`SHAPE ${unit.name}.${param.label}: native {${param.keys.join(',')}} missing ${missing.join(',')}`)
                }
            }
        }
        const returns = representation(signature.returns)
        if (unit.returns === Types.f64 && returns !== 'f64') lines.push(`RETURN ${unit.name}: native f64, analysis ${formatType(types, signature.returns)} => ${returns}`)
    }
    return lines.join('\n')
}

export interface GenericParam {
    name: string
    paths: string[]
}

export interface Generic {
    name: string
    params: GenericParam[]
    paths: string[]
    lines: string[]
}

export function keyLabel(k: Handle): string {
    if (heap.isString(k)) {
        const name = heap.stringToJs(k)
        return name.startsWith('!') ? `!${name}` : name
    }
    const index = heap.keyIndex(k)
    if (index !== undefined) return `[${index}]`
    return `!${heap.describeKey(k) ?? ''}#${k}`
}
export interface Instantiation {
    key: string
    members: number[]
    fields: Map<string, string>
}

export interface ShapeSignature {
    text: string
    proto: Handle | undefined
    fields: [string, Rep][]
    members: number[]
}

export interface Rep {
    text: string
    kind: 'any' | 'never' | 'undefined' | 'number' | 'pointer' | 'union' | 'buffer'
    format?: IntFormat
    targets: string[]
    nullable: boolean
    zero?: boolean
    fresh?: boolean
    element?: Rep
    encoded?: boolean
    constant?: Constant
    bit?: boolean
    bools?: number
    tested?: boolean
    functions?: Function[]
    inline?: intrinsics.Types[]
    float?: boolean
    other?: Rep
}

function bitValued(type: Type): boolean {
    if (type.unknown || type.undefined || type.strings.length || type.float || type.objects.length || type.functions.length || type.closures.length) return false
    if (type.bools) return !type.range && !type.literals.length
    return !!type.range && within(type.range, [0, 1]) && type.literals.every(l => l === 0 || l === 1)
}

function truthTested(type: Type): boolean {
    if (!type.bools || type.unknown || type.float || type.strings.length || type.functions.length || type.closures.length) return false
    return boolPartners(type) || type.undefined
}

function truthDemand(g: Graph, types: Map<number, Type>, returns: boolean): Set<number> {
    const tested = new Set<number>()
    const candidates: number[] = []
    for (const b of g.blocks.slice(1)) {
        for (const p of b.params) {
            const type = types.get(p)
            if (type && truthTested(type)) candidates.push(p)
        }
    }
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.call) continue
        const type = types.get(id)
        if (type && truthTested(type)) candidates.push(id)
    }
    if (!candidates.length) return tested
    const users = usersOf(g)
    const into = new Map<number, number[]>()
    const feeds = new Map<number, number[]>()
    for (const p of candidates) tested.add(p)
    for (const p of candidates) {
        for (const [user, slot] of users.get(p) ?? []) {
            const n = getNode(g, user)!
            if (slot < firstNonOrderingSlot(n) || (n.op === NodeOp.select && slot === 0)) continue
            if (returns && n.op === NodeOp.ret && slot === 0) continue
            const target = n.op === NodeOp.apply && slot > 0 ? getBlock(g, getRef(n, 0))?.params[slot - 1] : undefined
            if (target === undefined) {
                tested.delete(p)
                break
            }
            listOf(into, p).push(target)
            listOf(feeds, target).push(p)
        }
    }
    const pending = candidates.filter(p => !tested.has(p))
    for (const p of candidates) if (tested.has(p) && (into.get(p) ?? []).some(target => !tested.has(target))) pending.push(p)
    while (pending.length) {
        const p = pending.pop()!
        tested.delete(p)
        for (const source of feeds.get(p) ?? []) {
            if (tested.has(source)) pending.push(source)
        }
    }
    return tested
}

function boolPartners(type: Type): boolean {
    return type.bools !== 0 && (numericType(type) || type.unknown || type.strings.length > 0 || type.objects.length > 0 || type.functions.length > 0 || type.closures.length > 0)
}

function boolNumbers(type: Type): Type {
    if (!type.bools) return type
    const literals = type.literals.slice()
    if (type.bools & 1 && !literals.includes(0)) literals.push(0)
    if (type.bools & 2 && !literals.includes(1)) literals.push(1)
    literals.sort((a, b) => a - b)
    return { ...type, bools: 0, literals }
}

export interface Constant {
    fn?: Function
    literal?: number
    handle?: Handle
}

export interface Instantiations {
    table: Map<string, Instantiation>
    shapes: Map<string, ShapeSignature>
    constantShapes: Map<Handle, string>
    addressed: Set<string>
    repOf(type: Type): Rep
    elementOf(buffers: number[]): Rep
    shapeOf(allocation: number): string | undefined
    bufferGroups(): Map<number, number[]>
    layOut(tagged: Set<number>, inlined?: Map<number, intrinsics.Types[]>): void
}

export function instantiate(types: ValueTypes, genericOf: (proto: Handle) => Generic | undefined, joins: number[][] = []): Instantiations {
    const keys: string[] = []
    const owners: (string | undefined)[] = []
    const ownerClasses: (string | undefined)[] = []
    const pending = new Set<number>()
    function genericFor(id: number): Generic | undefined {
        const proto = types.objects[id].proto
        return proto ? genericOf(proto) : undefined
    }
    const rep = (type: Type) => representation(type, keyOf)
    function layoutOf(members: number[], indexed: boolean): [string, Type][] {
        const merged = new Map<string, Type>()
        for (const id of members) {
            const object = types.objects[id]
            for (const [k, field] of object.fields) {
                if (!field.forms.length) continue
                const at = (indexed || object.fields.has(numberKey)) && constantIndex(k) ? numberKey : k
                merged.set(at, merged.has(at) ? union(merged.get(at)!, field.type) : field.type)
            }
        }
        return [...merged.keys()].sort().map(k => [k, merged.get(k)!])
    }
    function claim(id: number, owner: string, generic: Generic): void {
        for (const path of generic.paths) {
            const segments = path.split('.')
            let current = [id]
            for (let depth = 1; depth < segments.length && current.length; depth++) {
                const next: number[] = []
                for (const inner of fieldAt(types, current, [segments[depth - 1]])?.type.objects ?? []) {
                    if (genericFor(inner)) continue
                    owners[inner] ??= `${owner}.${segments.slice(0, depth).join('.')}`
                    ownerClasses[inner] ??= `${generic.name}.${segments.slice(0, depth).join('.')}`
                    next.push(inner)
                }
                current = next
            }
        }
    }
    const recordParent = types.objects.map((_, i) => i)
    const findRecord = (a: number) => rootOf(recordParent, a)
    const joinable = (id: number) => {
        const object = types.objects[id]
        if (object.native || object.dynamic || object.kind === AllocKind.buffer) return false
        return genericFor(id) ? true : !object.constant || object.name === 'Object'
    }
    const recordKeys = types.objects.map(object => [...object.fields.keys()].sort().join(','))
    const recordCopied = types.objects.map(object => object.copied)
    function presenceKept(a: number, b: number): boolean {
        if (!recordCopied[a] && !recordCopied[b]) return true
        return recordKeys[a] === recordKeys[b]
    }
    function joinRecords(list: number[]): boolean {
        const byProto = new Map<Handle | undefined, number>()
        let merged = false
        for (const id of list) {
            if (!joinable(id)) continue
            const first = byProto.get(types.objects[id].proto)
            if (first === undefined) {
                byProto.set(types.objects[id].proto, id)
                continue
            }
            const into = findRecord(first)
            const from = findRecord(id)
            if (into === from || !presenceKept(into, from)) continue
            recordParent[from] = into
            recordCopied[into] = recordCopied[into] || recordCopied[from]
            if (recordKeys[into] !== recordKeys[from]) recordKeys[into] = '*'
            merged = true
        }
        return merged
    }
    for (const object of types.objects) for (const field of object.fields.values()) joinRecords(field.type.objects)
    const sharedNative = new Map<Handle, number[]>()
    types.objects.forEach((object, id) => {
        const cell = object.native ? object.state ?? object.handle : undefined
        if (cell !== undefined) listOf(sharedNative, cell).push(id)
    })
    for (const ids of sharedNative.values()) {
        if (ids.length < 2) continue
        const byKey = new Map<string, number[]>()
        for (const id of ids) for (const [k, field] of types.objects[id].fields) listOf(byKey, k).push(...field.type.objects)
        for (const list of byKey.values()) joinRecords(list)
    }
    for (const list of joins) joinRecords(list)
    for (const frame of types.frames) {
        for (const param of frame.params) if (!param.opaque) joinRecords(param.type.objects)
        joinRecords(frame.returns.objects)
    }
    for (let changed = true; changed;) {
        changed = false
        const groups = new Map<number, number[]>()
        types.objects.forEach((_, id) => {
            if (!joinable(id)) return
            const list = listOf(groups, findRecord(id))
            list.push(id)
        })
        for (const members of groups.values()) {
            if (members.length < 2) continue
            const byKey = new Map<string, number[]>()
            for (const id of members) for (const [k, field] of types.objects[id].fields) {
                const list = listOf(byKey, k)
                list.push(...field.type.objects)
            }
            for (const list of byKey.values()) if (joinRecords(list)) changed = true
        }
    }
    const recordMembers = new Map<number, number[]>()
    types.objects.forEach((_, id) => {
        if (!joinable(id)) return
        const list = listOf(recordMembers, findRecord(id))
        list.push(id)
    })
    const paramTypes = new Map<number, (Type | undefined)[]>()
    function genericParams(id: number, generic: Generic): (Type | undefined)[] {
        const root = findRecord(id)
        const known = paramTypes.get(root)
        if (known) return known
        const group = recordMembers.get(root) ?? [id]
        const out = generic.params.map(param => {
            let type: Type | undefined
            for (const path of param.paths) {
                const field = fieldAt(types, group, path.split('.'))
                if (field) type = type ? union(type, field.type) : field.type
            }
            return type
        })
        if (recordMembers.has(root)) paramTypes.set(root, out)
        return out
    }
    function keyOf(id: number): string {
        if (keys[id] !== undefined) return keys[id]
        if (pending.has(id)) return `^${types.objects[id].name}`
        pending.add(id)
        const object = types.objects[id]
        const generic = genericFor(id)
        let key: string
        if (generic) {
            const args = genericParams(id, generic).map(type => type ? rep(type) : 'never')
            key = `${generic.name}${args.length ? `<${args.join(', ')}>` : ''}`
            claim(id, key, generic)
        } else key = owners[id] ?? `${object.name}@${object.site.unit.name || '<anon>'}:%${object.site.node}`
        const joined = !generic && owners[id] === undefined && joinable(id) ? recordMembers.get(findRecord(id)) ?? [id] : [id]
        if (joined.length > 1) key = `${object.name}@join${findRecord(id)}`
        if (!generic && owners[id] === undefined) key = `${key}{${layoutOf(joined, false).map(([k, type]) => `${k}: ${rep(type)}`).join(', ')}}`
        pending.delete(id)
        keys[id] = key
        return key
    }
    types.objects.forEach((_, id) => { if (genericFor(id)) keyOf(id) })
    const table = new Map<string, Instantiation>()
    types.objects.forEach((object, id) => {
        const key = keyOf(id)
        let entry = table.get(key)
        if (!entry) table.set(key, entry = { key, members: [], fields: new Map() })
        entry.members.push(id)
    })
    const raw = (id: number) => types.objects[id].kind === AllocKind.buffer || (owners[id] !== undefined && !genericFor(id))
    function elementType(members: number[]): [Type | undefined, string[]] {
        const forms = new Set<string>()
        let type: Type | undefined
        for (const id of members) for (const [k, field] of types.objects[id].fields) {
            if (k !== numberKey && !constantIndex(k)) continue
            if (!field.forms.length) continue
            for (const form of field.forms) forms.add(form)
            type = type ? union(type, field.type) : field.type
        }
        return [type, [...forms].filter(form => form !== 'prop' && form !== 'init')]
    }
    const bufferRoot = types.objects.map((_, i) => i)
    const bufferGroup = (a: number) => rootOf(bufferRoot, a)
    function joinBuffers(ids: number[]): void {
        for (const id of ids) bufferRoot[bufferGroup(id)] = bufferGroup(ids[0])
    }
    for (const entry of table.values()) {
        const owned = owners[entry.members[0]] !== undefined
        if (raw(entry.members[0])) joinBuffers(entry.members)
        for (const [k, type] of layoutOf(entry.members, owned)) {
            entry.fields.set(k, rep(type))
            joinBuffers(type.objects.filter(raw))
        }
    }
    function groupBuffers(): Map<number, number[]> {
        const groups = new Map<number, number[]>()
        types.objects.forEach((_, id) => {
            if (!raw(id)) return
            listOf(groups, bufferGroup(id)).push(id)
        })
        return groups
    }
    let bufferMembers: Map<number, number[]> | undefined
    let tagged = new Set<number>()
    let inlineGroups = new Map<number, intrinsics.Types[]>()
    const wideGroups = new Set<number>()
    const elements = new Map<number, Rep>()
    function elementOf(buffers: number[]): Rep {
        if (!buffers.length) return elementRep([])
        intrinsics.assert(bufferMembers !== undefined, 'value-types: element layout read before layOut')
        const group = bufferGroup(buffers[0])
        const known = elements.get(group)
        if (known) return known
        const base = elementRep(bufferMembers.get(group) ?? buffers, wideGroups.has(group))
        const words = inlineGroups.get(group)
        const element = !words ? base : { ...base, text: `rec<${base.targets[0]}>`, inline: words }
        elements.set(group, element)
        return element
    }
    function elementText(members: number[]): string {
        const [type, stored] = elementType(members)
        if (type && stored.length === 1 && stored[0] === 'vm_value') return repOf(type).text
        return elementRep(members).text
    }
    const heldBuffers = new Map<string, Map<string, number[]>>()
    function layOutShape(id: string): void {
        const sig = shapes.get(id)!
        const held = heldBuffers.get(id)!
        sig.fields = sig.fields.map(([k, field]) => {
            const buffers = held.get(k)
            if (!buffers) return [k, field]
            const element = elementOf(buffers)
            const text = `buf<${element.text}>${field.nullable ? '?' : ''}`
            intrinsics.assert(field.element === undefined || field.text === text, `value-types: ${id}.${k} was laid out as ${field.text}, its buffers now need ${text}`)
            return [k, { ...field, text, element }]
        })
    }
    const shapes = new Map<string, ShapeSignature>()
    const protoOrders = new Map<Handle, string[]>()
    const shapeIds = new Map<string, string>()
    const shapePending = new Map<string, string>()
    const referenced = new Set<string>()
    let nextShape = 0
    function elementRep(members: number[], wide = false): Rep {
        const [type, stored] = elementType(members)
        if (!type) return { text: 'never', kind: 'never', targets: [], nullable: false }
        if (stored.length === 1 && stored[0] === 'vm_value') {
            const shown = repOf(type)
            const inner = elementTagged(shown) && !members.some(id => tagged.has(id)) ? repOf({ ...type, undefined: false }) : shown
            const free = wide && inner.kind === 'number' && !!inner.format && !inner.nullable
            if ((free || rawElement(inner) || elementTagged(inner) || floatUnion(inner)) && !members.some(id => types.objects[id].constant)) return inner
            return { ...inner, text: `enc<${inner.text}>`, encoded: true }
        }
        if (!stored.length) return repOf(type)
        const text = stored.sort().join('|')
        if (text === 'f64' || text === 'f32') return { text, kind: 'number', targets: [], nullable: false }
        if (/^(bool|[ui](8|16|32|64))$/.test(text)) return { text, kind: 'number', format: { bits: text.endsWith('64') ? 64 : 32, signed: false }, targets: [], nullable: false }
        return { text, kind: 'any', targets: [], nullable: false }
    }
    function shapeId(key: string): string {
        const known = shapeIds.get(key)
        if (known) return known
        const pending = shapePending.get(key)
        if (pending) {
            referenced.add(pending)
            return pending
        }
        const reserved = `S${nextShape++}`
        shapePending.set(key, reserved)
        const entry = table.get(key)!
        const object = types.objects[entry.members[0]]
        const fields: [string, Rep][] = []
        const held: [string, number[]][] = []
        const members = entry.members.map(id => types.objects[id])
        const constant = members.find(o => o.constant && o.state !== undefined)
        const fixed = constant ?? members.find(o => o.state !== undefined && dataKeys(o.state).length > 0)
        const stateOrder = fixed ? dataKeys(fixed.state!).map(k => keyLabel(k)) : []
        const shared = !constant && object.proto !== undefined ? protoOrders.get(object.proto) : undefined
        const order = shared ?? stateOrder
        if (object.proto !== undefined && stateOrder.length && !protoOrders.has(object.proto)) protoOrders.set(object.proto, stateOrder)
        for (const [k, merged] of layoutOf(entry.members, false)) {
            if (k === numberKey || k.startsWith('@')) continue
            const partial = entry.members.some(id => !types.objects[id].fields.get(k)?.forms.length && !types.erasedFields.get(id)?.has(k))
            const type = partial ? { ...merged, undefined: true } : merged
            const buffers = [...new Set([...type.objects].filter(id => owners[id] !== undefined && !genericFor(id)))]
            if (buffers.length && buffers.length === type.objects.length) {
                const nullable = type.undefined || type.literals.includes(0)
                held.push([k, buffers])
                fields.push([k, { text: `buf<${elementText(buffers)}>${nullable ? '?' : ''}`, kind: 'buffer', targets: [], nullable }])
            } else fields.push([k, bitValued(type) ? { ...repOf(type), text: 'u1', bit: true } : repOf(type)])
        }
        if (order.length) fields.sort((x, y) => (order.indexOf(x[0]) + 1 || order.length + 1) - (order.indexOf(y[0]) + 1 || order.length + 1))
        const text = `${object.name}{${fields.map(([k, r]) => `${k}: ${r.text}`).join(', ')}}`
        shapePending.delete(key)
        let id = referenced.has(reserved) ? undefined : [...shapes].find(([, sig]) => sig.text === text && sig.proto === object.proto)?.[0]
        if (!id) shapes.set(id = reserved, { text, proto: object.proto, fields, members: [] })
        shapes.get(id)!.members.push(...entry.members)
        const byField = mapOf(heldBuffers, id)
        for (const [k, buffers] of held) {
            listOf(byField, k).push(...buffers)
            if (!bufferMembers) joinBuffers(byField.get(k)!)
        }
        if (bufferMembers) layOutShape(id)
        shapeIds.set(key, id)
        return id
    }
    const reps = new Map<Type, Rep>()
    const addressed = new Set<string>()
    function repOf(type: Type): Rep {
        const known = reps.get(type)
        if (known) return known
        const found = repFor(type)
        const functionsOnly = type.functions.length > 0 && type.closures.every(id => functionObject(types, id)) && !type.objects.length && !type.strings.length && !numericType(type)
        const rep = functionsOnly ? { ...found, functions: type.functions } : found
        reps.set(type, rep)
        return rep
    }
    function repFor(type: Type): Rep {
        if (type.unknown) return { text: 'any', kind: 'any', targets: [], nullable: false }
        if (type.bools && !boolPartners(type)) {
            const numbered = repOf(boolNumbers(type))
            return { ...numbered, text: `bool${type.undefined ? '?' : ''}`, bools: type.bools }
        }
        const numeric = numericType(type)
        const objects = type.objects.filter(id => !types.objects[id].native && !types.objects[id].dynamic)
        const targets = [...new Set(objects.map(id => raw(id) ? 'buf' : shapeId(keyOf(id))))].sort()
        if (type.strings.length) targets.push('str')
        if (type.objects.some(id => types.objects[id].dynamic)) targets.push('heap')
        const known = type.functions.length === 1 && type.closures.every(id => functionObject(types, id))
        const nativeIds = [...known ? [] : type.closures, ...type.objects.filter(id => types.objects[id].native)]
        const natives = [...new Set(nativeIds.map(id => types.objects[id].state))]
        const plain = known || (type.functions.length > 0 && !type.closures.length)
        const nativeShapes = !plain ? [...new Set(nativeIds.map(id => shapeId(keyOf(id))))] : []
        if (natives.length === 1 && natives[0] !== undefined && !plain) targets.push(`clo@${natives[0]}`)
        else if (nativeShapes.length) targets.push(...nativeShapes.sort())
        else if (type.functions.length || natives.length) targets.push('fn')
        if (targets.length && floatType(type)) {
            const other = repOf({ ...type, literals: [], range: undefined, float: false })
            return { text: `union<f64|${other.text}>`, kind: 'union', targets, nullable: type.undefined, float: true, other }
        }
        if (type.bools) {
            for (const target of targets) if (shapeTarget(target)) addressed.add(target)
            return { text: `union<${[...targets, 'bool'].join('|')}>`, kind: 'union', targets, nullable: type.undefined, bools: type.bools }
        }
        if (!targets.length && numeric) {
            const format = floatType(type) ? undefined : intFormat(numberSpan(type)!)
            return { text: `${numberText(format)}${type.undefined ? '?' : ''}`, kind: 'number', format, targets: [], nullable: type.undefined }
        }
        if (!targets.length) return type.undefined ? { text: 'undefined', kind: 'undefined', targets: [], nullable: true, constant: { handle: heap.undefinedHandle } } : { text: 'never', kind: 'never', targets: [], nullable: false }
        const nulls = nullsOnly(type)
        const kinds = type.strings.length > 0 && targets.some(shapeTarget)
        if (numeric || type.undefined || kinds) for (const target of targets) if (shapeTarget(target)) addressed.add(target)
        if ((numeric || kinds) && !nulls) return { text: `union<${targets.join('|')}>`, kind: 'union', targets, nullable: type.undefined }
        const fresh = !nativeIds.length && !type.functions.length && !type.strings.length && objects.length > 0 && objects.every(id => !types.objects[id].constant && !raw(id))
        return { text: `ptr<${targets.join('|')}>${nulls ? '|0' : type.undefined ? '?' : ''}`, kind: 'pointer', targets, nullable: type.undefined || nulls, zero: nulls || undefined, fresh }
    }
    for (const key of table.keys()) if (!owners[table.get(key)!.members[0]] && types.objects[table.get(key)!.members[0]].kind !== AllocKind.buffer && !types.objects[table.get(key)!.members[0]].dynamic) shapeId(key)
    const constantShapes = new Map<Handle, string>()
    types.objects.forEach((object, id) => {
        if (!object.constant || object.state === undefined || !joinable(id) || recordMembers.get(findRecord(id))!.length < 2) return
        constantShapes.set(object.state, shapeId(keyOf(id)))
    })
    function layOut(observed: Set<number>, inlined = new Map<number, intrinsics.Types[]>()): void {
        intrinsics.assert(bufferMembers === undefined, 'value-types: elements laid out twice')
        tagged = observed
        inlineGroups = inlined
        const groups = groupBuffers()
        bufferMembers = groups
        const holderWidths = new Map<string, number>()
        const freeGroups = new Map<number, string>()
        for (const [id, byField] of heldBuffers) for (const [k, buffers] of byField) {
            const group = bufferGroup(buffers[0])
            const members = groups.get(group)!
            const at = `${shapes.get(id)!.proto}/${k}`
            if (elementRep(members).encoded && !elementRep(members, true).encoded) freeGroups.set(group, at)
            else holderWidths.set(at, Math.min(holderWidths.get(at) ?? 8, elementWidth(elementRep(members))))
        }
        for (const [group, at] of freeGroups) if (holderWidths.get(at) === 8) wideGroups.add(group)
        for (const id of shapes.keys()) layOutShape(id)
    }
    return { keys, table, shapes, constantShapes, addressed, repOf: type => repOf(type), elementOf, bufferGroups: groupBuffers, layOut, shapeOf: id => types.objects[id].dynamic || types.objects[id].kind === AllocKind.buffer || (owners[id] !== undefined && !genericFor(id)) ? undefined : shapeId(keyOf(id)) }
}
export interface PlannedUnit {
    fn: Function
    boxes: boolean
    boxedReturn: boolean
    allocations: Map<number, string>
    signature: string
    frames: number[]
    params: { label: string, rep: Rep }[]
    returns: Rep
    returnsSelf: boolean
    nodes: Map<number, Rep>
    slices: Map<number, Rep>
    blocks: Set<number>
    deadArms: Map<number, number[]>
    calls: Map<number, Set<PlannedUnit>>
    boxedCalls: Set<number>
    coercions: Map<number, number>
}

function framesOf(object: Allocation): number[] {
    if (object.frames) return object.frames
    return object.frame === undefined ? [] : [object.frame]
}

function functionObject(types: ValueTypes, id: number): boolean {
    return types.objects[id].function !== undefined
}

function singleValued(types: ValueTypes, type: Type): boolean {
    if (type.unknown || opaqueNumber(type) || type.closures.some(id => !functionObject(types, id)) || type.strings.includes(0)) return false
    const bools = type.bools === 3 ? 2 : type.bools ? 1 : 0
    return (type.undefined ? 1 : 0) + bools + type.literals.length + type.functions.length + type.objects.length + type.strings.length === 1
}

function functionRep(types: ValueTypes, inst: Instantiations, type: Type): Rep | undefined {
    if (!singleValued(types, type) || !type.functions.length) return
    return { ...inst.repOf(type), text: `fn@${unitIdentity(type.functions[0])}`, constant: { fn: type.functions[0] } }
}

function valueRep(types: ValueTypes, inst: Instantiations, type: Type, oneObject: (state: Handle) => boolean): Rep | undefined {
    if (!singleValued(types, type)) return
    const rep = inst.repOf(type)
    if (type.strings.length) return { ...rep, text: `${rep.text}@${type.strings[0]}`, constant: { handle: type.strings[0] as Handle } }
    if (type.bools) return { ...rep, text: type.bools === 2 ? '#true' : '#false', constant: { literal: type.bools === 2 ? 1 : 0 } }
    const literal = type.literals[0]
    if (literal !== undefined && !Number.isNaN(literal)) return { ...rep, text: `#${literal}`, constant: { literal } }
    const object = type.objects.length ? types.objects[type.objects[0]] : undefined
    if (object?.constant && object.handle && oneObject(object.state!)) return { ...rep, text: `${rep.text}@${object.handle}`, constant: { handle: object.handle } }
}

export function planUnits(types: ValueTypes, genericOf: (proto: Handle) => Generic | undefined, oneObject: (state: Handle) => boolean, graphOf: (fn: Function) => Graph, keepsReturn: (fn: Function) => boolean): { inst: Instantiations, plan: Map<Function, PlannedUnit[]>, boxed: Map<number, Set<string>> } {
    const callees = new Map<string, number[]>()
    const outgoing = types.frames.map(() => [] as [node: number, callee: number][])
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            outgoing[site.frame].push([site.node, id])
            const k = `${site.frame}|${site.node}`
            const from = listOf(callees, k)
            from.push(id)
        }
    })
    const find = congruence(types, callees)
    const congruent = new Map<number, number[]>()
    types.frames.forEach((_, id) => {
        const root = find(id)
        listOf(congruent, root).push(id)
    })
    const joins: number[][] = []
    const bySite = new Map<string, number[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native) return
        for (const frame of framesOf(object)) {
            const k = `${find(frame)}|${object.site.node}`
            const list = bySite.get(k)
            if (!list) bySite.set(k, [id])
            else if (!list.includes(id)) list.push(id)
        }
    })
    for (const list of bySite.values()) if (list.length > 1) joins.push(list)
    for (const frame of types.frames) joins.push(...frame.merges)
    for (const members of congruent.values()) {
        if (members.length < 2) continue
        types.frames[members[0]].params.forEach((_, i) => joins.push(members.flatMap(f => types.frames[f].params[i].type.objects)))
        joins.push(members.flatMap(f => types.frames[f].returns.objects))
    }
    const inst = instantiate(types, genericOf, joins)
    const created = new Map<number, string[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = object.dynamic ? 'heap' : inst.shapeOf(id)
        if (shape === undefined) return
        for (const frame of framesOf(object)) {
            let list = created.get(find(frame))
            if (!list) created.set(find(frame), list = [])
            list.push(`%${object.site.node}=${shape}`)
        }
    })
    const signatureOf = (params: { label: string, type: Type }[], returns: Type, allocations: string[] = [], returned = inst.repOf(returns)) => {
        const reps = params.map(param => ({ label: param.label, rep: functionRep(types, inst, param.type) ?? inst.repOf(param.type) }))
        const abis = reps.map(param => `${param.label}: ${param.rep.text}`)
        const made = [...new Set(allocations)].sort()
        return { params: reps, returns: returned, signature: `(${abis.join(', ')}) -> ${returned.text}${made.length ? ` new ${made.join(' ')}` : ''}` }
    }
    const joinedOf = (members: number[]) => {
        const joined = joinedSignature(members.map(f => types.frames[f]), unionAll)
        return signatureOf(joined.params, joined.returns, created.get(find(members[0])))
    }
    let classOf = new Map<number, number>()
    const initial = new Map<string, number>()
    const mixedAccess = (f: number, store: boolean) => types.frames[f].accesses.some(access => access.store === store && access.slots.some(slot => types.wordSlots[slot].mixed))
    for (const [root, members] of congruent) {
        const boxes = members.some(f => mixedAccess(f, true))
        const boxedReturn = members.some(f => mixedAccess(f, false))
        const k = `${unitIdentity(types.frames[root].unit)}|${joinedOf(members).signature.replace(/\bint\b/g, 'i64')}|${boxes}|${boxedReturn}`
        if (!initial.has(k)) initial.set(k, initial.size)
        classOf.set(root, initial.get(k)!)
    }
    const calleesOf = new Map<number, [site: string, callee: number][]>()
    for (const [root, members] of congruent) {
        const out: [string, number][] = []
        for (const f of members) for (const [node, callee] of outgoing[f]) out.push([`${node}:${unitIdentity(types.frames[callee].unit)}`, find(callee)])
        calleesOf.set(root, out)
    }
    const membersOf = new Map<number, number[]>()
    const dependsOn = new Map<number, Set<number>>()
    for (const [root, out] of calleesOf) {
        const c = classOf.get(root)!
        let members = membersOf.get(c)
        if (!members) {
            membersOf.set(c, members = [])
            dependsOn.set(c, new Set())
        }
        members.push(root)
        for (const [, callee] of out) dependsOn.get(c)!.add(classOf.get(callee)!)
    }
    const settled = new Map<number, number>()
    for (const scc of stronglyConnected(membersOf.keys(), c => [...dependsOn.get(c)!])) {
        const inside = new Set(scc)
        for (const c of scc) {
            const groups: Map<string, number>[] = []
            for (const root of membersOf.get(c)!) {
                const calls = new Map<string, number>()
                for (const [site, callee] of calleesOf.get(root)!) calls.set(site, inside.has(classOf.get(callee)!) ? -1 - classOf.get(callee)! : settled.get(callee)!)
                let group = groups.findIndex(known => [...calls].every(([k, v]) => !known.has(k) || known.get(k) === v))
                if (group < 0) {
                    group = groups.length
                    groups.push(new Map())
                }
                for (const [k, v] of calls) groups[group].set(k, v)
                settled.set(root, c * congruent.size + group)
            }
        }
    }
    classOf = settled
    const classRoot = new Map<number, number>()
    for (const root of congruent.keys()) if (!classRoot.has(classOf.get(root)!)) classRoot.set(classOf.get(root)!, root)
    const unitRoot = (id: number) => classRoot.get(classOf.get(find(id))!)!
    const plan = new Map<Function, PlannedUnit[]>()
    const unitOfRoot = new Map<number, PlannedUnit>()
    const touchedOf = new Map<PlannedUnit, Map<number, number[]>>()
    const unitOfFrame: PlannedUnit[] = []
    types.frames.forEach((frame, id) => {
        const root = unitRoot(id)
        let unit = unitOfRoot.get(root)
        if (!unit) {
            unitOfRoot.set(root, unit = { fn: frame.unit, boxes: false, boxedReturn: false, allocations: new Map(), signature: '', frames: [], params: [], returns: { text: 'never', kind: 'never', targets: [], nullable: false }, returnsSelf: false, nodes: new Map(), slices: new Map(), blocks: new Set(), deadArms: new Map(), calls: new Map(), boxedCalls: new Set(), coercions: new Map() })
            const units = listOf(plan, frame.unit)
            units.push(unit)
        }
        unit.frames.push(id)
        if (mixedAccess(id, true)) unit.boxes = true
        if (mixedAccess(id, false)) unit.boxedReturn = true
        unitOfFrame[id] = unit
    })
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            const caller = unitOfFrame[site.frame]
            const set = setOf(caller.calls, site.node)
            set.add(unitOfFrame[id])
            if (site.operand !== undefined) caller.coercions.set(site.node, (caller.coercions.get(site.node) ?? 0) | (1 << site.operand))
        }
    })
    const conventionOf = sharedConventions([...unitOfRoot.values()])
    const truth = { ...inst.repOf({ ...emptyType(), bools: 3 }), text: 'truth', tested: true }
    const testedOf = new Map<PlannedUnit, Set<number>>()
    const resolvedOf = new Map<PlannedUnit, Map<number, Type>>()
    for (const unit of unitOfRoot.values()) {
        const resolved = types.resolve(unit.frames)
        for (const [node, type] of resolved.nodes) unit.nodes.set(node, inst.repOf(type))
        for (const target of comparedTargets(graphOf(unit.fn), node => unit.nodes.get(node))) inst.addressed.add(target)
        testedOf.set(unit, truthDemand(graphOf(unit.fn), resolved.nodes, false))
        resolvedOf.set(unit, resolved.nodes)
        touchedOf.set(unit, resolved.slices)
        for (const b of resolved.blocks) unit.blocks.add(b)
        for (const [select, arms] of resolved.selects) {
            const dead = arms.flatMap((x, i) => x ? [] : [i + 1])
            if (dead.length && dead.length < arms.length) unit.deadArms.set(select, dead)
        }
    }
    const truthful = new Set(truthReturns(types, [...unitOfRoot.values()], conventionOf, unitOfFrame, caller => testedOf.get(caller)!, keepsReturn))
    for (const unit of truthful) for (const f of unit.frames) for (const site of types.frames[f].sites) unitOfFrame[site.frame!].nodes.set(site.node, truth)
    for (const unit of unitOfRoot.values()) {
        const g = graphOf(unit.fn)
        const tested = truthful.has(unit) ? truthDemand(g, resolvedOf.get(unit)!, true) : testedOf.get(unit)!
        for (const node of tested) if (getNode(g, node)!.op !== NodeOp.call) unit.nodes.set(node, truth)
        const signature = joinedSignature(unit.frames.map(f => types.frames[f]), unionAll)
        const peers = conventionOf.get(unit) ?? [unit]
        const returns = unionAll(peers.flatMap(peer => peer.frames.map(f => types.frames[f].returns)))
        const joined = signatureOf(signature.params, returns, unit.frames.flatMap(f => created.get(f) ?? []), truthful.has(unit) ? truth : inst.repOf(returns))
        unit.returnsSelf = peers.length === 1 && unit.frames.every(f => {
            const r = types.frames[f].returns
            return r.objects.length > 0 && !r.undefined && !r.strings.length && !r.unknown && !numericType(r) && !r.functions.length && !r.closures.length
        }) && returnsSelf(graphOf(unit.fn))
        unit.params = joined.params
        unit.returns = joined.returns
        unit.signature = joined.signature
    }
    const wordGroup = types.objects.map((_, i) => i)
    const wordRoot = (a: number) => rootOf(wordGroup, a)
    const accessesOf = (unit: PlannedUnit) => unit.frames.flatMap(f => types.frames[f].accesses)
    for (const unit of unitOfRoot.values()) {
        const first = new Map<number, number>()
        for (const access of accessesOf(unit)) {
            for (const slot of access.slots) {
                const root = wordRoot(types.wordSlots[slot].allocation)
                const known = first.get(access.node)
                if (known === undefined) first.set(access.node, root)
                else wordGroup[root] = wordRoot(known)
            }
        }
    }
    const groupKey = (slot: number) => `${wordRoot(types.wordSlots[slot].allocation)}:${types.wordSlots[slot].key}`
    const mixedGroups = new Set<string>()
    types.wordSlots.forEach((slot, i) => { if (slot.mixed) mixedGroups.add(groupKey(i)) })
    const boxed = new Map<number, Set<string>>()
    types.wordSlots.forEach((slot, i) => {
        if (!mixedGroups.has(groupKey(i))) return
        const keys = boxed.get(slot.allocation)
        if (keys) keys.add(slot.key)
        else boxed.set(slot.allocation, new Set([slot.key]))
    })
    for (const unit of unitOfRoot.values()) {
        for (const access of accessesOf(unit)) {
            if (!access.slots.some(slot => mixedGroups.has(groupKey(slot)))) continue
            if (access.store) unit.boxes = true
            else unit.boxedReturn = true
        }
    }
    const conflicted: [PlannedUnit, number][] = []
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = object.dynamic ? 'heap' : inst.shapeOf(id)
        if (shape === undefined) return
        for (const frame of framesOf(object)) {
            const unit = unitOfFrame[frame]
            const known = unit.allocations.get(object.site.node)
            if (known !== undefined && known !== shape) conflicted.push([unit, object.site.node])
            unit.allocations.set(object.site.node, shape)
        }
    })
    for (const [unit, node] of conflicted) unit.allocations.delete(node)
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame !== undefined && unitOfFrame[id].boxedReturn) unitOfFrame[site.frame].boxedCalls.add(site.node)
        }
    })
    for (const units of plan.values()) {
        const frames = units.flatMap(unit => unit.frames)
        units[0].params.forEach((_, i) => {
            if (units.some(unit => unit.params[i].rep.constant)) return
            const rep = valueRep(types, inst, unionAll(frames.map(f => types.frames[f].params[i].type)), oneObject)
            if (!rep) return
            for (const unit of units) unit.params[i] = { label: unit.params[i].label, rep }
        })
    }
    const inlined = intrinsics.argv().some(flag => flag.startsWith('inline-records')) ? inlineRecords(types, inst, [...unitOfRoot.values()], resolvedOf, touchedOf, graphOf) : undefined
    inst.layOut(nullishReads(types, [...unitOfRoot.values()], touchedOf, graphOf), intrinsics.argv().includes('inline-records') ? inlined : undefined)
    for (const [unit, touched] of touchedOf) for (const [node, buffers] of touched) unit.slices.set(node, inst.elementOf(buffers))
    return { inst, plan, boxed }
}

function recordElements(types: ValueTypes, inst: Instantiations, buffers: number[]): { shape: string, words: intrinsics.Types[], elements: Set<number> } | string {
    let element = emptyType()
    for (const id of buffers) {
        const buffer = types.objects[id]
        if (buffer.kind !== AllocKind.buffer || buffer.constant || buffer.native || buffer.dynamic || buffer.copied) return 'buffer'
        for (const [k, field] of buffer.fields) {
            if (k !== numberKey && !constantIndex(k)) continue
            if (field.forms.some(form => form !== 'vm_value')) return `form:${field.forms.join('|')}`
            element = union(element, field.type)
        }
    }
    if (element.unknown || element.undefined || element.bools || numericType(element) || element.strings.length || element.functions.length || element.closures.length || !element.objects.length) return 'mixed'
    let shape: string | undefined
    for (const id of element.objects) {
        const object = types.objects[id]
        if (object.kind !== AllocKind.object || object.constant || object.native || object.dynamic || object.copied || object.function !== undefined) return 'object'
        const own = inst.shapeOf(id)
        if (own === undefined || (shape !== undefined && own !== shape)) return 'shapes'
        shape = own
    }
    const sig = inst.shapes.get(shape!)!
    if (!sig.fields.length || sig.fields.some(([, rep]) => rep.kind !== 'number' || rep.nullable || rep.bit || rep.bools)) return `fields:${sig.text}`
    return { shape: shape!, words: sig.fields.map(([, rep]) => numberName(rep) === 'f64' ? Types.f64 : Types.u64), elements: new Set(element.objects) }
}

function exposedObjects(types: ValueTypes): Set<number> {
    const exposed = new Set<number>()
    const work: number[] = []
    const expose = (type: Type) => {
        for (const id of type.objects) {
            if (exposed.has(id)) continue
            exposed.add(id)
            work.push(id)
        }
    }
    for (const frame of types.frames) {
        if (frame.sites.some(site => site.frame !== undefined)) continue
        expose(frame.returns)
        for (const param of frame.params) expose(param.type)
    }
    while (work.length) {
        for (const field of types.objects[work.pop()!].fields.values()) expose(field.type)
    }
    return exposed
}

function inlineRecords(types: ValueTypes, inst: Instantiations, units: PlannedUnit[], resolvedOf: Map<PlannedUnit, Map<number, Type>>, touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph): Map<number, intrinsics.Types[]> {
    const out = new Map<number, intrinsics.Types[]>()
    const debug = intrinsics.argv().includes('inline-records-debug')
    const exposed = exposedObjects(types)
    const callers = new Map<PlannedUnit, PlannedUnit[]>()
    for (const unit of units) for (const callees of unit.calls.values()) for (const callee of callees) listOf(callers, callee).push(unit)
    for (const [group, buffers] of inst.bufferGroups()) {
        const found = recordElements(types, inst, buffers)
        const why = typeof found === 'string' ? found : buffers.some(id => exposed.has(id)) || [...found.elements].some(id => exposed.has(id)) ? 'reaches-host' : elementUses(types, units, callers, resolvedOf, touchedOf, graphOf, new Set(buffers), found.elements, found.shape)
        if (debug) console.log(`INLINE-RECORDS group ${group} [${buffers.join(',')}] ${typeof found === 'string' ? '' : `${found.shape} stride ${8 * found.words.length} `}${why || 'inline'}`)
        if (!why && typeof found !== 'string') out.set(group, found.words)
    }
    return out
}

function elementUses(types: ValueTypes, units: PlannedUnit[], callers: Map<PlannedUnit, PlannedUnit[]>, resolvedOf: Map<PlannedUnit, Map<number, Type>>, touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph, buffers: Set<number>, elements: Set<number>, shape: string): string {
    const writesGroup = (allocations: number[] | undefined) => !!allocations && allocations.some(id => buffers.has(id))
    const freshData = (g: Graph, n: GraphNode) => rt.sliceOf(g, getNode(g, valueTail(g, getRef(n, 2)))!) === rt.Op.slice
    const holders = new Set<number>(buffers)
    let grew = true
    while (grew) {
        grew = false
        types.objects.forEach((object, id) => {
            if (holders.has(id) || ![...object.fields.values()].some(field => field.type.objects.some(inner => holders.has(inner)))) return
            holders.add(id)
            grew = true
        })
    }
    const pinned = [...holders].some(id => types.objects[id].constant || types.objects[id].native || types.objects[id].dynamic)
    const unknownCall = (unit: PlannedUnit, g: Graph, id: number, n: GraphNode) => {
        if (n.op !== NodeOp.call || unit.calls.has(id)) return false
        if (pinned) return true
        const nodes = resolvedOf.get(unit)!
        for (let i = 1; i < countIds(n); i++) {
            if (getRef(n, i) && nodes.get(getRef(n, i))?.objects.some(object => holders.has(object))) return true
        }
        return false
    }
    const carriers = new Set<number>(elements)
    let boxed = true
    while (boxed) {
        boxed = false
        types.objects.forEach((object, id) => {
            if (carriers.has(id) || object.kind !== AllocKind.object || object.constant || object.native || object.dynamic || object.copied || object.function !== undefined) return
            if (![...object.fields.values()].some(field => field.type.objects.some(inner => carriers.has(inner)))) return
            carriers.add(id)
            boxed = true
        })
    }
    const movers = new Set<PlannedUnit>()
    const work: PlannedUnit[] = []
    for (const unit of units) {
        const g = graphOf(unit.fn)
        let moves = false
        for (const [node, allocations] of touchedOf.get(unit)!) {
            const n = getNode(g, node)!
            if (rt.sliceOf(g, n) === rt.Op.sliceWrite && writesGroup(allocations) && !freshData(g, n)) moves = true
        }
        for (const [id, n] of nodeEntries(g)) {
            if (unknownCall(unit, g, id, n)) moves = true
        }
        if (moves) {
            movers.add(unit)
            work.push(unit)
        }
    }
    while (work.length) {
        for (const caller of callers.get(work.pop()!) ?? []) {
            if (movers.has(caller)) continue
            movers.add(caller)
            work.push(caller)
        }
    }
    for (const unit of units) {
        const g = graphOf(unit.fn)
        const nodes = resolvedOf.get(unit)!
        const touched = touchedOf.get(unit)!
        const users = usersOf(g)
        const slots = paramSlots(g)
        const name = `${unit.fn.name || '<anon>'}`
        const typed = (id: number) => !!nodes.get(id)?.objects.some(object => carriers.has(object))
        const budget = 64 * countNodes(g)
        let steps = 0
        const moving = new Set<number>()
        for (const [id, n] of nodeEntries(g)) {
            const slice = rt.sliceOf(g, n)
            if (slice === rt.Op.sliceWrite && writesGroup(touched.get(id))) moving.add(id)
            else if (slice !== undefined) continue
            else if (unknownCall(unit, g, id, n)) moving.add(id)
            else if ([...unit.calls.get(id) ?? []].some(callee => movers.has(callee))) moving.add(id)
        }
        const blockMoves = new Map<number, boolean>()
        function moverIn(block: Block): boolean {
            const known = blockMoves.get(block.id)
            if (known !== undefined) return known
            let found = false
            for (const id of bodyNodes(g, block.bodyId)) if (moving.has(id)) found = true
            blockMoves.set(block.id, found)
            return found
        }
        function homeOf(id: number): Block | undefined {
            const slot = slots.get(id)
            if (slot) return slot[0]
            const n = getNode(g, id)!
            if (n.op === NodeOp.ret) return getBlock(g, getRef(n, 1))
            const roots = new Set<number>()
            const seen = new Set<number>()
            const stack = [id]
            while (stack.length) {
                const at = stack.pop()!
                if (seen.has(at)) continue
                seen.add(at)
                const m = getNode(g, at)
                if (!m) continue
                if (m.op === NodeOp.nilEffect) roots.add(getRef(m, 0))
                for (let i = 0; i < firstNonOrderingSlot(m); i++) if (getRef(m, i)) stack.push(getRef(m, i))
            }
            if (roots.size === 1) return getBlock(g, [...roots][0])
            if (roots.size) return
            const containing = g.blocks.filter(b => bodyNodes(g, b.bodyId).has(id))
            return containing.length === 1 ? containing[0] : undefined
        }
        function reachable(from: Block): Set<number> {
            const seen = new Set<number>()
            const stack = successorsOf(g, from)
            while (stack.length) {
                const next = stack.pop()!
                if (seen.has(next.id)) continue
                seen.add(next.id)
                stack.push(...successorsOf(g, next))
            }
            return seen
        }
        function liveAcross(origin: number, x: number): string {
            const n = getNode(g, x)!
            const home = homeOf(origin)
            const at = homeOf(x)
            if (!home || !at) return `unplaced:${name}%${x}`
            if (OrderedValues.has(n.op) || n.op === NodeOp.after) {
                const seen = new Set<number>()
                const stack: number[] = []
                for (let i = 0; i < firstNonOrderingSlot(n); i++) if (getRef(n, i)) stack.push(getRef(n, i))
                while (stack.length) {
                    const id = stack.pop()!
                    if (id === origin || seen.has(id)) continue
                    seen.add(id)
                    if (++steps > budget) return `budget:${name}`
                    if (moving.has(id)) return `live-across-slot-write:${name}%${origin}@%${id}->%${x}`
                    const m = getNode(g, id)
                    if (!m) continue
                    for (let i = 0; i < firstNonOrderingSlot(m); i++) if (getRef(m, i)) stack.push(getRef(m, i))
                }
            } else if (moverIn(at)) return `live-across-slot-write-in-block:${name}%${x}`
            if (home.id === at.id) return ''
            if (moverIn(home)) return `live-across-slot-write-after-origin:${name}%${origin}`
            const after = reachable(home)
            for (const id of after) {
                const b = getBlock(g, id)!
                if (id !== at.id && reachable(b).has(at.id) && moverIn(b)) return `live-across-slot-write-on-path:${name}%${origin}->%${x}`
            }
            if (reachable(at).has(at.id) && moverIn(at)) return `live-across-slot-write-in-loop:${name}%${x}`
            return ''
        }
        function constructs(n: GraphNode): boolean {
            if (getRef(n, 2)) return false
            const base = valueTail(g, getRef(n, 1))
            const k = types.keyNames.get(getLiteral(g, n, 2) as Handle)
            if (allocated.has(base)) return true
            const objects = nodes.get(base)?.objects ?? []
            return k !== undefined && objects.length > 0 && objects.every(id => carriers.has(id) && types.objects[id].fields.get(k)?.constructed)
        }
        function boxes(n: GraphNode): boolean {
            const base = valueTail(g, getRef(n, 1))
            return allocated.has(base) && !!nodes.get(base)?.objects.every(id => carriers.has(id) && !elements.has(id))
        }
        function constructedBefore(origin: number, x: number): string {
            const home = homeOf(origin)
            if (!home || home.id !== homeOf(x)?.id) return liveAcross(origin, x)
            const seen = new Set<number>()
            const stack = [getRef(getNode(g, x)!, 0)]
            while (stack.length) {
                const id = stack.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                if (++steps > budget) return `budget:${name}`
                const m = getNode(g, id)
                if (!m) continue
                for (let i = firstNonOrderingSlot(m); i < countIds(m); i++) {
                    const base = (m.op === NodeOp.getProp || m.op === NodeOp.setProp) && i === 1
                    if (!base && getRef(m, i) && valueTail(g, getRef(m, i)) === origin) return `aliased-mutation:${name}%${x}`
                }
                for (let i = 0; i < firstNonOrderingSlot(m); i++) stack.push(getRef(m, i))
            }
            return ''
        }
        function nullishOperand(n: GraphNode, slot: number): boolean {
            if (!getRef(n, slot)) return false
            const m = getNode(g, valueTail(g, getRef(n, slot)))
            return m?.op === NodeOp.heapHandle && countIds(m) === 1 && !getRef(m, 0) && heap.isNullishHandle(getLiteral(g, m, 0) as Handle)
        }
        const allocated = new Set<number>()
        types.objects.forEach((object, id) => {
            if (carriers.has(id) && object.site.unit === unit.fn) allocated.add(object.site.node)
        })
        function consumersOf(origin: number, value: number): string {
            const walk = (o: number, x: number) => !allocated.has(o) ? liveAcross(o, x) : getNode(g, x)!.op === NodeOp.setProp ? constructedBefore(o, x) : ''
            for (const [u, slot] of users.get(value) ?? []) {
                const n = getNode(g, u)!
                if (slot < firstNonOrderingSlot(n)) continue
                let why = ''
                if (n.op === NodeOp.after || (n.op === NodeOp.select && slot > 0)) why = consumersOf(origin, u)
                else if (n.op === NodeOp.eq || n.op === NodeOp.ne) why = nullishOperand(n, 1 - slot) ? '' : `identity-compared:${name}%${u}`
                else if (n.op === NodeOp.getProp) why = slot === 1 ? walk(origin, u) : `key:${name}%${u}`
                else if (n.op === NodeOp.setProp && slot === 3) why = boxes(n) ? walk(origin, u) : `stored-into-field:${name}%${u}`
                else if (n.op === NodeOp.setProp) why = slot !== 1 ? `key:${name}%${u}` : !constructs(n) ? `aliased-mutation:${name}%${u}` : walk(origin, u)
                else if (n.op === NodeOp.call) why = slot === 1 ? `call-target:${name}%${u}` : walk(origin, u)
                else if (rt.sliceOf(g, n) === rt.Op.sliceWrite) why = slot === 4 && (touched.get(u) ?? []).every(id => buffers.has(id)) ? walk(origin, u) : `other-buffer:${name}%${u}`
                else if (n.op === NodeOp.rt && (getLiteral(g, n, 1) === rt.Op.typeof || getLiteral(g, n, 1) === rt.Op.hasPrototype)) why = ''
                else if (n.op === NodeOp.rt && unit.calls.has(u)) why = walk(origin, u)
                else if (n.op === NodeOp.ret && slot === 0) why = walk(origin, u)
                else if (n.op === NodeOp.apply) why = walk(origin, u)
                else why = `${n.op === NodeOp.rt ? rt.opName(getLiteral(g, n, 1)) : opName(n.op)}:${name}%${u}`
                if (why) return why
            }
            return ''
        }
        for (const id of nodes.keys()) {
            if (!typed(id) || !getNode(g, id)) continue
            const param = g.blocks[0].params.indexOf(id)
            const rep = param >= 0 ? unit.params[param]?.rep : unit.nodes.get(id)
            if (rep && nodes.get(id)!.objects.some(object => elements.has(object)) && (rep.kind !== 'pointer' || rep.encoded || rep.targets.length !== 1 || rep.targets[0] !== shape)) return `rep:${rep.text}@${name}%${id}`
            const why = consumersOf(id, id)
            if (why) return why
        }
    }
    return ''
}

function comparedTargets(g: Graph, repAt: (node: number) => Rep | undefined): string[] {
    const targets: string[] = []
    for (const n of allNodes(g)) {
        if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) continue
        for (let i = 0; i < countIds(n); i++) {
            const rep = getRef(n, i) ? repAt(getRef(n, i)) : undefined
            if (rep) targets.push(...rep.targets.filter(shapeTarget))
        }
    }
    return targets
}

function truthReturns(types: ValueTypes, units: PlannedUnit[], conventionOf: Map<PlannedUnit, PlannedUnit[]>, unitOfFrame: PlannedUnit[], testedIn: (unit: PlannedUnit) => Set<number>, keepsReturn: (fn: Function) => boolean): PlannedUnit[] {
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const parent = units.map((_, i) => i)
    const join = (a: PlannedUnit, b: PlannedUnit) => {
        parent[rootOf(parent, index.get(a)!)] = rootOf(parent, index.get(b)!)
    }
    for (const unit of units) {
        for (const peer of conventionOf.get(unit) ?? []) join(unit, peer)
        for (const callees of unit.calls.values()) {
            const first = [...callees][0]
            for (const callee of callees) join(first, callee)
        }
    }
    const qualifies = (unit: PlannedUnit) => !keepsReturn(unit.fn) && truthTested(unionAll(unit.frames.map(f => types.frames[f].returns))) && unit.frames.every(f => {
        const sites = types.frames[f].sites
        return sites.length > 0 && sites.every(site => site.frame !== undefined && site.operand === undefined && testedIn(unitOfFrame[site.frame]).has(site.node))
    })
    const failed = new Set<number>()
    for (const unit of units) if (!qualifies(unit)) failed.add(rootOf(parent, index.get(unit)!))
    return units.filter(unit => !failed.has(rootOf(parent, index.get(unit)!)))
}

function sharedConventions(units: PlannedUnit[]): Map<PlannedUnit, PlannedUnit[]> {
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const parent = units.map((_, i) => i)
    for (const unit of units) {
        for (const callees of unit.calls.values()) {
            if (callees.size < 2) continue
            const first = index.get([...callees][0])!
            for (const callee of callees) parent[rootOf(parent, index.get(callee)!)] = rootOf(parent, first)
        }
    }
    const groups = new Map<number, PlannedUnit[]>()
    units.forEach((unit, i) => listOf(groups, rootOf(parent, i)).push(unit))
    const out = new Map<PlannedUnit, PlannedUnit[]>()
    for (const members of groups.values()) {
        if (members.length < 2) continue
        for (const unit of members) out.set(unit, members)
    }
    return out
}

export function floatUnion(rep: Rep | undefined): boolean {
    return rep?.kind === 'union' && !!rep.float
}

export function nullableNumber(rep: Rep | undefined): boolean {
    return rep?.kind === 'number' && rep.nullable
}

export function nonzeroLiteral(g: Graph, n: GraphNode, at: number): boolean {
    const ref = getRef(n, at)
    if (!ref) return getLiteral(g, n, at) !== 0
    const m = getNode(g, ref)
    return m?.op === NodeOp.literal && getLiteral(g, m, 0) !== 0
}

function nullishElements(object: ObjectType): boolean {
    let type = emptyType()
    for (const [k, field] of object.fields) if (k === numberKey || constantIndex(k)) type = union(type, field.type)
    return type.undefined && numericType(type) && !type.strings.length && !type.unknown && !type.objects.length && !type.functions.length
}

function firstArg(call: GraphNode, plain: number): number {
    if (call.op === NodeOp.call) return 3
    if (call.op === NodeOp.rt) return 2
    if (call.op === NodeOp.getProp || call.op === NodeOp.setProp) return countIds(call) - plain
    return -1
}

function nullishReads(types: ValueTypes, units: PlannedUnit[], touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph): Set<number> {
    const observed = new Set<number>()
    if (!types.objects.some(object => !object.constant && nullishElements(object))) return observed
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, u) => index.set(unit, u))
    const graphs = units.map(unit => graphOf(unit.fn))
    const at = (u: number, node: number) => u * nodeSpan + node
    const callers = units.map(() => [] as [number, number][])
    const readers = new Map<number, [number, number][]>()
    const writers = new Map<number, [number, number][]>()
    function add(map: Map<number, [number, number][]>, k: number, item: [number, number]): void {
        listOf(map, k).push(item)
    }
    units.forEach((unit, u) => {
        for (const [node, callees] of unit.calls) for (const callee of callees) callers[index.get(callee)!].push([u, node])
        for (const [node, touched] of touchedOf.get(unit)!) {
            const slice = rt.sliceOf(graphs[u], getNode(graphs[u], node)!)
            for (const allocation of touched) {
                if (slice === rt.Op.sliceRead) add(readers, allocation, [u, node])
                if (slice === rt.Op.sliceWrite) add(writers, allocation, [u, node])
            }
        }
    })
    const rooted = units.map(unit => unit.frames.some(f => !types.frames[f].sites.length))
    const plains = new Map<Graph, number[]>()
    function plainOf(g: Graph): number[] {
        let known = plains.get(g)
        if (!known) plains.set(g, known = g.blocks[0].params.filter(p => !isThisParam(getNode(g, p)!)))
        return known
    }
    function calleeTargets(u: number, node: number, n: GraphNode, slot: number): [number, number][] | undefined {
        const callees = units[u].calls.get(node)
        if (!callees) return
        const out: [number, number][] = []
        for (const callee of callees) {
            const c = index.get(callee)!
            const plain = plainOf(graphs[c])
            const first = firstArg(n, plain.length)
            if (first < 0 || slot < first) return
            if (slot - first >= plain.length) continue
            if (!nullableNumber(callee.nodes.get(plain[slot - first]))) return
            out.push([c, plain[slot - first]])
        }
        return out
    }
    function targetsOf(u: number, node: number, slot: number): [number, number][] | undefined {
        const g = graphs[u]
        const n = getNode(g, node)!
        if (effect(n.op) && slot === 0) return []
        if (n.op === NodeOp.after) return slot === countIds(n) - 1 ? [[u, node]] : []
        if (n.op === NodeOp.select) return slot > 0 ? [[u, node]] : undefined
        if (n.op === NodeOp.mem || n.op === NodeOp.inlined) return slot === 0 ? [[u, node]] : undefined
        if (n.op === NodeOp.apply) return slot > 0 ? [[u, getBlock(g, getRef(n, 0))!.params[slot - 1]]] : undefined
        if (n.op === NodeOp.ret) {
            const region = regionRets(g).get(node)
            if (region !== undefined) return [[u, region]]
            return rooted[u] ? undefined : callers[u]
        }
        if (n.op === NodeOp.eq || n.op === NodeOp.ne) return countIds(n) === 2 && nonzeroLiteral(g, n, 1 - slot) ? [] : undefined
        if (n.op === NodeOp.add && typeOf(n) === Types.unknown_number && units[u].nodes.get(node)?.kind !== 'number') return
        if (NumericOps.has(n.op) || n.op === NodeOp.convert || n.op === NodeOp.bitconvert) return []
        if (n.op === NodeOp.load) return slot === 1 || slot === 2 ? [] : undefined
        const slice = rt.sliceOf(g, n)
        if (slice === rt.Op.slice) return slot === 2 ? [] : undefined
        if (slice === rt.Op.sliceRead) return slot === 3 ? [] : undefined
        if (slice === rt.Op.sliceWrite) {
            if (slot === 3) return []
            const touched = touchedOf.get(units[u])!.get(node)
            if (slot !== 4 || !touched) return
            return touched.flatMap(allocation => readers.get(allocation) ?? [])
        }
        if (n.op === NodeOp.setProp && slot === 3 && types.fieldStores.has(`${unitIdentity(units[u].fn)}:${node}`)) return
        if (n.op === NodeOp.call || n.op === NodeOp.rt || n.op === NodeOp.getProp || n.op === NodeOp.setProp) return calleeTargets(u, node, n, slot)
    }
    function observes(u: number, node: number, slot: number): boolean {
        const targets = targetsOf(u, node, slot)
        if (!targets) return true
        for (const [t, id] of targets) {
            const rep = units[t].nodes.get(id)
            if (rep && rep.kind !== 'number' && rep.kind !== 'undefined' && rep.kind !== 'never') return true
        }
        return false
    }
    const seen = new Set<number>()
    const work: [number, number][] = []
    function need(u: number, id: number): void {
        if (!id || !nullableNumber(units[u].nodes.get(id))) return
        if (seen.has(at(u, id))) return
        seen.add(at(u, id))
        work.push([u, id])
    }
    units.forEach((unit, u) => {
        const users = usersOf(graphs[u])
        for (const [id, rep] of unit.nodes) {
            if (!nullableNumber(rep)) continue
            for (const [user, slot] of users.get(id) ?? []) {
                if (!observes(u, user, slot)) continue
                need(u, id)
                break
            }
        }
    })
    while (work.length) {
        const [u, id] = work.pop()!
        const unit: PlannedUnit = units[u]
        const g = graphs[u]
        const n = getNode(g, id)
        if (!n) continue
        if (n.op === NodeOp.param) {
            const slotOf = paramSlots(g).get(id)
            if (!slotOf) continue
            const [block, i] = slotOf
            for (const apply of predsOf(g, block)) need(u, getRef(getNode(g, apply)!, i + 1))
            if (block !== g.blocks[0]) continue
            const position = plainOf(g).indexOf(id)
            if (position < 0) continue
            const incoming: [number, number][] = callers[u]
            for (const [caller, node] of incoming) {
                const call = getNode(graphs[caller], node)!
                const first = firstArg(call, plainOf(g).length)
                if (first >= 0 && first + position < countIds(call)) need(caller, getRef(call, first + position))
            }
            continue
        }
        if (n.op === NodeOp.after) {
            need(u, getRef(n, countIds(n) - 1))
            continue
        }
        if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) need(u, getRef(n, i))
            continue
        }
        if (n.op === NodeOp.mem) {
            need(u, getRef(n, 0))
            continue
        }
        if (n.op === NodeOp.inlined) {
            need(u, getRef(n, 0))
            for (const [ret, root] of regionRets(g)) if (root === id) need(u, getRef(getNode(g, ret)!, 0))
            continue
        }
        const slice = rt.sliceOf(g, n)
        if (slice === rt.Op.sliceRead) {
            for (const allocation of touchedOf.get(unit)!.get(id) ?? []) {
                if (observed.has(allocation)) continue
                observed.add(allocation)
                for (const [w, write] of writers.get(allocation) ?? []) need(w, getRef(getNode(graphs[w], write)!, 4))
            }
            continue
        }
        if (slice !== undefined) continue
        for (const callee of unit.calls.get(id) ?? []) {
            const c = index.get(callee)!
            for (const ret of retsOf(graphs[c])) if (!regionRets(graphs[c]).has(ret)) need(c, getRef(getNode(graphs[c], ret)!, 0))
        }
    }
    return observed
}

function numericType(type: Type): boolean {
    return type.literals.length > 0 || opaqueNumber(type)
}

function opaqueNumber(type: Type): boolean {
    return !!type.range || type.float
}

function congruence(types: ValueTypes, callees: Map<string, number[]>): (a: number) => number {
    const parent = types.frames.map((_, i) => i)
    const find = (a: number) => rootOf(parent, a)
    const sitesOf = new Map<number, Map<string, number>>()
    const pending: [number, number][] = []
    for (const [k, list] of callees) {
        const [caller, node] = k.split('|')
        const sites = mapOf(sitesOf, Number(caller))
        for (const id of list) {
            const site = `${node}|${unitIdentity(types.frames[id].unit)}`
            const known = sites.get(site)
            if (known === undefined) sites.set(site, id)
            else pending.push([known, id])
        }
    }
    function drain(): void {
        while (pending.length) {
            const [x, y] = pending.pop()!
            const rx = find(x)
            const ry = find(y)
            if (rx === ry) continue
            parent[ry] = rx
            const from = sitesOf.get(ry)
            sitesOf.delete(ry)
            if (!from) continue
            const into = sitesOf.get(rx)
            if (!into) {
                sitesOf.set(rx, from)
                continue
            }
            for (const [site, f] of from) {
                const known = into.get(site)
                if (known === undefined) into.set(site, f)
                else pending.push([known, f])
            }
        }
    }
    drain()
    return find
}

export interface Embeddings {
    fields: Map<string, Map<string, string>>
    sites: Map<PlannedUnit, Map<number, string>>
}

export function planEmbeddings(types: ValueTypes, inst: Instantiations, plan: Map<Function, PlannedUnit[]>): Embeddings {
    const holders = new Map<number, [number, string][]>()
    types.objects.forEach((object, id) => {
        for (const [key, field] of object.fields) for (const inner of field.type.objects) {
            const list = listOf(holders, inner)
            list.push([id, key])
        }
    })
    const returned = new Set(types.frames.flatMap(frame => frame.returns.objects.filter(id => receiverOf(frame) !== id)))
    const sameSite = (a: number, b: number) => types.objects[a].site.unit === types.objects[b].site.unit && types.objects[a].site.node === types.objects[b].site.node
    const onlyObjects = (t: Type) => !t.undefined && !t.strings.length && !t.unknown && !numericType(t) && !t.functions.length && !t.closures.length && t.objects.length > 0
    function owner(inner: number): [number, string] | undefined {
        const object = types.objects[inner]
        if (object.constant || object.native || object.kind === AllocKind.buffer || returned.has(inner)) return
        const holding = holders.get(inner) ?? []
        const held = holding.filter(([id]) => framesOf(object).some(frame => receiverOf(types.frames[frame]) === id))
        if (held.length !== 1) return
        const [parent, key] = held[0]
        const outer = types.objects[parent]
        if (outer.constant || outer.native || (holding.length > 1 && !outer.fields.get(key)?.constructed)) return
        const type = outer.fields.get(key)!.type
        if (!onlyObjects(type) || !type.objects.every(id => sameSite(id, inner))) return
        return [parent, key]
    }
    const fields = new Map<string, Map<string, string>>()
    for (const [holderShape, sig] of inst.shapes) {
        const byKey = new Map<string, string>()
        for (const [key] of sig.fields) {
            let inner: string | undefined
            const embeds = sig.members.length > 0 && sig.members.every(m => {
                const t = types.objects[m].fields.get(key)?.type
                return !!t && onlyObjects(t) && t.objects.every(id => {
                    const heldShape = inst.shapeOf(id)
                    if (owner(id)?.[0] !== m || heldShape === undefined || heldShape === holderShape || (inner !== undefined && inner !== heldShape)) return false
                    inner = heldShape
                    return true
                })
            })
            if (embeds && inner !== undefined) byKey.set(key, inner)
        }
        if (byKey.size) fields.set(holderShape, byKey)
    }
    const unitOfFrame = new Map<number, PlannedUnit>()
    const unitIndex = new Map<PlannedUnit, number>()
    for (const units of plan.values()) for (const unit of units) {
        unitIndex.set(unit, unitIndex.size)
        for (const f of unit.frames) unitOfFrame.set(f, unit)
    }
    const keys = new Map<string, Set<string>>()
    const placed = new Map<string, [PlannedUnit, number]>()
    types.objects.forEach((object, id) => {
        for (const frame of framesOf(object)) {
            const unit = unitOfFrame.get(frame)
            if (!unit || !unit.allocations.has(object.site.node)) continue
            const k = `${unitIndex.get(unit)}|${object.site.node}`
            const found = owner(id)
            const holderShape = found ? inst.shapeOf(found[0]) : undefined
            const key = found && holderShape !== undefined && fields.get(holderShape)?.get(found[1]) === inst.shapeOf(id) ? `${holderShape}.${found[1]}` : ''
            let set = keys.get(k)
            if (!set) keys.set(k, set = new Set())
            set.add(key)
            placed.set(k, [unit, object.site.node])
        }
    })
    for (const set of keys.values()) {
        if (set.size < 2) continue
        for (const key of set) {
            if (!key) continue
            const [holderShape, field] = [key.slice(0, key.indexOf('.')), key.slice(key.indexOf('.') + 1)]
            fields.get(holderShape)?.delete(field)
        }
    }
    const sites = new Map<PlannedUnit, Map<number, string>>()
    for (const [k, set] of keys) {
        const [key] = [...set]
        if (set.size !== 1 || !key || !fields.get(key.slice(0, key.indexOf('.')))?.has(key.slice(key.indexOf('.') + 1))) continue
        const [unit, node] = placed.get(k)!
        const map = mapOf(sites, unit)
        map.set(node, key.slice(key.indexOf('.') + 1))
    }
    return { fields, sites }
}
interface Moves {
    words: Set<number>
    elements: ElementReads
}

export type ElementReads = Set<Handle> | 'all'

function movesOf(g: Graph): Moves {
    const known = moveSets.get(g)
    if (known) return known
    const users = usersOf(g)
    function movedBy(passing: boolean): (id: number) => boolean {
        const memo = new Map<number, boolean>()
        function moved(id: number): boolean {
            const done = memo.get(id)
            if (done !== undefined) return done
            memo.set(id, false)
            const result = (users.get(id) ?? []).every(([user, slot]) => {
                const n = getNode(g, user)!
                if (n.op === NodeOp.after) return slot < countIds(n) - 1 || moved(user)
                if (slot === 0 && (n.op === NodeOp.load || n.op === NodeOp.store || n.op === NodeOp.getProp || n.op === NodeOp.setProp || n.op === NodeOp.call || rt.sliceOf(g, n) !== undefined)) return true
                if (n.op === NodeOp.store) return slot === 3 && resultType(g, n) === Types.vm_value
                if (rt.sliceOf(g, n) === rt.Op.sliceWrite) return slot === 4 && wordStore(g, n)
                if (n.op === NodeOp.setProp) return passing && slot === 3
                if (n.op === NodeOp.call) return passing && slot >= 3
                return n.op === NodeOp.ret && slot === 0
            })
            memo.set(id, result)
            return result
        }
        return moved
    }
    const moved = movedBy(true)
    const kept = movedBy(false)
    const words = new Set<number>()
    let elements: ElementReads = new Set<Handle>()
    for (const [id, n] of nodeEntries(g)) {
        const load = wordLoad(g, n)
        const read = n.op === NodeOp.load || rt.sliceOf(g, n) === rt.Op.sliceRead
        if (read && elements !== 'all' && !(load && kept(id))) {
            const base = getNode(g, getRef(n, n.op === NodeOp.load ? 1 : 2))
            if (base?.op === NodeOp.load || (base && rt.sliceOf(g, base) === rt.Op.sliceRead)) elements = 'all'
            else if (base?.op === NodeOp.getProp && !getRef(base, 2)) elements.add(getLiteral(g, base, 2) as Handle)
        }
        if ((load || n.op === NodeOp.getProp || n.op === NodeOp.call || g.blocks[0].params.includes(id)) && moved(id)) words.add(id)
    }
    const out = { words, elements }
    moveSets.set(g, out)
    return out
}
const moveSets = new WeakMap<Graph, Moves>()

function shapeTarget(target: string): boolean {
    return target.startsWith('S')
}

export function dereferenceableRep(rep: Rep | undefined): boolean {
    return !!rep && rep.kind === 'pointer' && !rep.nullable && !rep.encoded && rep.targets.length === 1 && shapeTarget(rep.targets[0])
}

function rawElement(element: Rep): boolean {
    if (element.kind === 'number') return (!element.format || element.format.bits === 64) && !element.nullable
    return element.kind === 'pointer' && element.targets.length > 0 && element.targets.every(shapeTarget) && !element.constant
}

export function elementTagged(element: Rep): boolean {
    return !element.encoded && element.kind === 'number' && element.nullable
}

export function elementWidth(element: Rep): number {
    if (element.inline) return 8 * element.inline.length
    if (element.encoded) return 4
    if (floatUnion(element)) return 24
    if (elementTagged(element)) return 16
    if (element.kind === 'number' && element.format) return 8
    return rawElement(element) ? 8 : 4
}

export function isStringRep(rep: Rep | undefined): boolean {
    return rep?.kind === 'pointer' && rep.targets.length === 1 && rep.targets[0] === 'str'
}

function movedClass(rep: Rep, param: boolean, reduced: (target: string) => boolean, boxed: boolean): string {
    if (boxed && isStringRep(rep)) return 'string-word'
    if (boxed && rep.kind === 'number' && rep.bools) return 'bool-word'
    if (numberName(rep) === 'int' || (rep.kind === 'undefined' && !param) || isStringRep(rep)) return 'word'
    if (rep.kind === 'number') return numberText(rep.format)
    return `${repKey(rep, target => movedTarget(target, reduced))}${rep.fresh ? '!' : ''}`
}

function movedTarget(target: string, reduced: (target: string) => boolean): string {
    const kind = shapeTarget(target) ? 'S' : target.startsWith('clo@') ? 'clo' : undefined
    if (kind === undefined) return target
    return reduced(target) ? `${kind}R` : kind
}

export function argumentKey(rep: Rep): string {
    return repKey(rep.kind === 'pointer' ? { ...rep, nullable: false } : rep, target => target)
}

function repKey(rep: Rep, target: (target: string) => string): string {
    const nullable = rep.zero ? '|0' : rep.nullable ? '?' : ''
    const targets = rep.targets.map(target).join('|')
    switch (rep.kind) {
        case 'number': return `${numberText(rep.format)}${nullable}`
        case 'pointer': return rep.constant ? rep.text : `ptr<${targets}>${nullable}`
        case 'union': return `union<${targets}>`
        case 'buffer': return `buf<${rep.element!.encoded ? `enc<${repKey(rep.element!, target)}>` : repKey(rep.element!, target)}>${nullable}`
        case 'any': return rep.text
        default: return rep.kind
    }
}

export function shareClasses(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => string, reduced: (target: string) => boolean, sites: Map<PlannedUnit, Map<number, Handle>>, abiOf: (unit: PlannedUnit) => string, graphOf: (fn: Function) => Graph): Map<PlannedUnit, number> {
    const byNode = <T>(map: Map<number, T>, show: (value: T) => string) => [...map].sort((a, b) => a[0] - b[0]).map(([node, value]) => `%${node}:${show(value)}`).join(' ')
    const units = [...plan.values()].flat()
    const intern = (keyOf: (unit: PlannedUnit) => string): [Map<PlannedUnit, number>, number] => {
        const ids = new Map<string, number>()
        const out = new Map<PlannedUnit, number>()
        for (const unit of units) {
            const k = keyOf(unit)
            let id = ids.get(k)
            if (id === undefined) ids.set(k, id = ids.size)
            out.set(unit, id)
        }
        return [out, ids.size]
    }
    const parts = (unit: PlannedUnit) => {
        const g = graphOf(unit.fn)
        const { words: moved, elements } = movesOf(g)
        const view = (rep: Rep) => `${repKey(rep, target => shapeTarget(target) ? layoutOf(target, elements) : target)}${rep.fresh ? '!' : ''}`
        const value = (rep: Rep) => rep.kind === 'number' ? numberText(rep.format) : view(rep)
        const node = (rep: Rep) => rep.kind === 'pointer' && rep.targets.length === 1 && rep.targets[0] === 'buf' ? 'int' : value(rep)
        const opaque = (rep: Rep, param: boolean) => movedClass(rep, param, reduced, unit.boxes || unit.boxedReturn)
        const entry = g.blocks[0].params
        const wide = (id: number) => unit.slices.has(id) && elementWidth(unit.slices.get(id)!) === 8
        const read = (id: number) => getNode(g, id)!.op === NodeOp.load || rt.sliceOf(g, getNode(g, id)!) === rt.Op.sliceRead
        const keyed = (id: number) => !moved.has(id) || !read(id) || wide(id)
        return [
            unitIdentity(unit.fn), unit.boxes, unit.boxedReturn ? view(unit.returns) : '', [...unit.boxedCalls].sort((a, b) => a - b).join(','), unit.returnsSelf, !!unit.returns.tested,
            `${unit.params.map((p, i) => `${p.label}:${moved.has(entry[i]) ? opaque(p.rep, true) : value(p.rep)}`).join(',')}->${abiOf(unit)}`,
            byNode(unit.allocations, shape => shapeTarget(shape) ? layoutOf(shape, elements) : shape), byNode(sites.get(unit) ?? new Map<number, Handle>(), k => String(k)),
            [...unit.blocks].sort((a, b) => a - b).join(','), byNode(unit.deadArms, arms => arms.join(',')), byNode(unit.coercions, mask => String(mask)), byNode(unit.slices, element => `${elementWidth(element)}${numberName(element) === 'f64' ? 'f' : ''}`), byNode(new Map([...unit.nodes].filter(([id]) => keyed(id)).map(([id, rep]) => [id, moved.has(id) ? `${opaque(rep, entry.includes(id))}${wide(id) ? '8' : ''}` : node(rep)])), x => x),
        ]
    }
    let [classes, count] = intern(unit => parts(unit).join('|'))
    while (true) {
        const [next, size] = intern(unit => `${classes.get(unit)}|${byNode(unit.calls, set => [...new Set([...set].map(c => classes.get(c)))].sort().join(','))}`)
        classes = next
        if (size === count) break
        count = size
    }
    if (intrinsics.argv().includes('share-debug')) for (const list of plan.values()) for (const unit of list) console.log('SHARE-PARTS', unit.fn.name, list.indexOf(unit), JSON.stringify(parts(unit).map(String)))
    return classes
}

export function shareUnits(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => string, reduced: (target: string) => boolean, sites: Map<PlannedUnit, Map<number, Handle>>, abiOf: (unit: PlannedUnit) => string, graphOf: (fn: Function) => Graph): Map<PlannedUnit, PlannedUnit> {
    const classes = shareClasses(plan, layoutOf, reduced, sites, abiOf, graphOf)
    const units = [...plan.values()].flat()
    const shared = new Map<PlannedUnit, PlannedUnit>()
    const kept = new Map<number, PlannedUnit>()
    for (const [fn, list] of plan) plan.set(fn, list.filter(unit => {
        const first = kept.get(classes.get(unit)!)
        if (!first) {
            kept.set(classes.get(unit)!, unit)
            return true
        }
        first.frames.push(...unit.frames)
        shared.set(unit, first)
        return false
    }))
    for (const unit of units) for (const [node, set] of unit.calls) unit.calls.set(node, new Set([...set].map(c => shared.get(c) ?? c)))
    for (const unit of shared.keys()) sites.delete(unit)
    return shared
}

const identities = new WeakMap<Function, number>()
let nextIdentity = 0
function unitIdentity(fn: Function): number {
    let id = identities.get(fn)
    if (id === undefined) identities.set(fn, id = nextIdentity++)
    return id
}

const regionMaps = new WeakMap<Graph, Map<number, number>>()
export function regionRets(g: Graph): Map<number, number> {
    let known = regionMaps.get(g)
    if (known) return known
    known = new Map()
    const blocks = new Map(g.blocks.map(b => [b.id, b]))
    for (const [root, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.inlined) continue
        const seen = new Set<number>()
        const stack = [getRef(n, 0)]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const m = getNode(g, id)
            if (!m) continue
            if (m.op === NodeOp.ret) known.set(id, root)
            else if (m.op === NodeOp.select) for (let i = 1; i < countIds(m); i++) stack.push(getRef(m, i))
            else if (m.op === NodeOp.after) stack.push(getRef(m, countIds(m) - 1))
            else if (m.op === NodeOp.apply) stack.push(blocks.get(getRef(m, 0))?.bodyId ?? 0)
        }
    }
    regionMaps.set(g, known)
    return known
}

export type Block = Graph['blocks'][number]

export function effect(op: NodeOp): boolean {
    return op === NodeOp.setProp || op === NodeOp.getProp || op === NodeOp.call || op === NodeOp.rt || op === NodeOp.store || op === NodeOp.load
}

const retLists = new WeakMap<Graph, number[]>()
export function retsOf(g: Graph): number[] {
    let known = retLists.get(g)
    if (!known) retLists.set(g, known = [...nodeEntries(g)].filter(([, n]) => n.op === NodeOp.ret).map(([id]) => id))
    return known
}

const addressKey = heap.fromJsString('__address')
function addressView(object: ObjectType): boolean {
    return object.state !== undefined && heap.ownPropertyCount(object.state) === 1 && !!heap.getOwnProperty(object.state, addressKey)
}

export function selfOf(g: Graph): number {
    for (const p of g.blocks[0].params) if (isThisParam(getNode(g, p)!)) return p
    return 0
}

export function returnsSelf(g: Graph): boolean {
    const self = selfOf(g)
    for (const n of allNodes(g)) if (n.op === NodeOp.ret && getRef(n, 0) && valueTail(g, getRef(n, 0)) !== self) return false
    return true
}

export function valueTail(g: Graph, id: number): number {
    let n = getNode(g, id)
    while (n?.op === NodeOp.after) {
        id = getRef(n, countIds(n) - 1)
        n = getNode(g, id)
    }
    return id
}

export function blockOf(g: Graph, id: number): Block | undefined {
    const n = getNode(g, id)
    if (n?.op === NodeOp.ret) {
        const owner = g.blocks.find(b => b.id === getRef(n, 1))
        if (owner) return owner
    }
    return g.blocks.find(b => bodyNodes(g, b.bodyId).has(id))
}

const paramSlotMaps = new WeakMap<Graph, Map<number, [Block, number]>>()
function paramSlots(g: Graph): Map<number, [Block, number]> {
    const known = paramSlotMaps.get(g)
    if (known) return known
    const out = new Map<number, [Block, number]>()
    for (const block of g.blocks) block.params.forEach((param, i) => out.set(param, [block, i]))
    paramSlotMaps.set(g, out)
    return out
}

export function predsOf(g: Graph, block: Block): number[] {
    return (usersOf(g).get(block.id) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
}

function successorsOf(g: Graph, block: Block): Block[] {
    const out: Block[] = []
    for (const id of bodyNodes(g, block.bodyId)) {
        const n = getNode(g, id)
        if (n?.op !== NodeOp.apply) continue
        const target = getBlock(g, getRef(n, 0))
        if (target) out.push(target)
    }
    return out
}

export function reaches(g: Graph, from: Block, to: Block): boolean {
    const seen = new Set<number>()
    const work = [from]
    while (work.length) {
        const next = work.pop()!
        if (next.id === to.id) return true
        if (seen.has(next.id)) continue
        seen.add(next.id)
        work.push(...successorsOf(g, next))
    }
    return false
}

function repeats(g: Graph, block: Block, id: number): boolean {
    const guards = armsAt(g, id) ?? []
    for (const member of bodyNodes(g, block.bodyId)) {
        const n = getNode(g, member)
        if (n?.op !== NodeOp.apply) continue
        const other = armsAt(g, member) ?? []
        if (other.some(([cond, positive]) => guards.some(([c, p]) => c === cond && p !== positive))) continue
        const target = getBlock(g, getRef(n, 0))
        if (target && reaches(g, target, block)) return true
    }
    return false
}

function receiverValue(g: Graph, id: number): boolean {
    const slots = paramSlots(g)
    const seen = new Set<number>()
    const work = [id]
    while (work.length) {
        const value = valueTail(g, work.pop()!)
        if (seen.has(value)) continue
        seen.add(value)
        const n = getNode(g, value)
        const slot = slots.get(value)
        if (n?.op !== NodeOp.param || !slot) return false
        const [block, index] = slot
        const preds = predsOf(g, block)
        if (block === g.blocks[0] && (!isThisParam(n) || preds.length)) return false
        for (const pred of preds) work.push(getRef(getNode(g, pred)!, index + 1))
    }
    return true
}

function setOf<K, V>(map: Map<K, Set<V>>, k: K): Set<V> {
    let set = map.get(k)
    if (!set) map.set(k, set = new Set())
    return set
}

function rootOf(parent: number[], a: number): number {
    let at = a
    while (parent[at] !== at) {
        parent[at] = parent[parent[at]]
        at = parent[at]
    }
    return at
}

function listOf<K, V>(map: Map<K, V[]>, k: K): V[] {
    let list = map.get(k)
    if (!list) map.set(k, list = [])
    return list
}

function mapOf<K, K2, V>(map: Map<K, Map<K2, V>>, k: K): Map<K2, V> {
    let inner = map.get(k)
    if (!inner) map.set(k, inner = new Map())
    return inner
}
