"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { dumpGraph, NumericOps, type Graph, type GraphNode, typeName } from './lowering2'
import { countIds, getBlock, getLiteral, getNode, getRef, isThisParam, NodeOp, resultType, typeOf } from './graph-node'
import type { TraceSession } from './trace2'
import { dataKeys } from './property-eval'
import * as rt from './rt'

type Handle = intrinsics.Handle

export interface Site {
    unit: Function
    node: number
    frame?: number
}

export interface Allocation {
    site: Site
    name: string
    state?: Handle
    depth: number
    context: string
    proto: Handle | undefined
    constant: boolean
    escaped: boolean
    native?: boolean
}

export interface Location {
    allocation: number
    key: string
    values: number[]
    forms: string[]
    readers: Site[]
    writers: Site[]
}

export enum ValueKind {
    undefined,
    number,
    string,
    unknown,
    object,
    function,
    variable,
}

export enum NumberForm {
    literal,
    fixed,
    bound,
}

export interface Value {
    kind: ValueKind
    allocation?: number
    fn?: Function
    form?: NumberForm
    literal?: number
    type?: intrinsics.Types
    bound?: string
    site?: Site
    param?: number
    narrow?: string
    base?: number
}

export interface Param {
    label: string
    values: number[]
}

export interface UnitValues {
    params: Param[]
    returns: number[]
}

export interface FrameValues extends UnitValues {
    unit: Function
    context: string
    sites: Site[]
    signature: string[]
    boxes: boolean
    boxedReturn: boolean
    nodes: Map<number, Set<number>>
    blocks: Set<number>
    selects: Map<number, boolean[]>
}

export interface Accesses {
    allocations: Allocation[]
    locations: Location[]
    values: Value[]
    units: Map<Function, UnitValues>
    frames: FrameValues[]
    graphs: Map<Function, Graph>
    numeric: Set<number>
    keyHandles: Map<string, Handle>
    floatSets: Map<Function, Map<string, number[]>>
    consulted: Set<Handle>
}

export const numberKey = '[number]'

export interface AccessHost {
    session: TraceSession
    graphOf(fn: Function): Graph
    functionOf(handle: u32): Function | undefined
    localFunction(symbol: number): Function | undefined
    traceable(fn: Function): boolean
    invariantsOf?(proto: Handle): Invariants | undefined
    variantOf?(fn: Function, floats: number[]): Function
    constantElements?(state: Handle): Handle[] | undefined
    paramCount?(fn: Function): number | undefined
    heapValue?(slot: Handle): Handle
    receiverless?(fn: Function): boolean
}

export interface Invariants {
    pairs: [string, string][]
    closure: Set<Function>
}

interface Frame {
    unit: Function
    context: string
    object: number
    signature: string[]
    graph?: Graph
    nodes: Map<number, Set<number>>
}

const maxDepth = 3
const maxSignatures = 16
const nodeSpan = 2 ** 24

function widestInteger(types: intrinsics.Types[]): intrinsics.Types {
    const order = [Types.bool, Types.u8, Types.i8, Types.u16, Types.i16, Types.u32, Types.i32, Types.u64, Types.i64]
    let best = types[0]
    for (const T of types) if (order.indexOf(T) > order.indexOf(best)) best = T
    const signed = types.some(T => T === Types.i8 || T === Types.i16 || T === Types.i32 || T === Types.i64)
    if (signed && (best === Types.u32 || best === Types.u16 || best === Types.u8)) return best === Types.u32 ? Types.i64 : Types.i32
    if (signed && best === Types.u64) return Types.i64
    return best
}
const Types = intrinsics.Types

export function scalarType(T: intrinsics.Types): boolean {
    return T !== Types.u64 && T !== Types.vm_value && T !== Types.ptr && T !== Types.fnptr && T !== Types.usize && T !== Types.void && T !== Types.unknown && T !== Types.handle && T !== Types.unknown_number
}
const Undefined = 0
const Str = 1
const Unknown = 2

export interface Isolated {
    name: string
    proto: Handle
}

const users = new WeakMap<Graph, Map<number, [number, number][]>>()
export function usersOf(g: Graph): Map<number, [number, number][]> {
    let index = users.get(g)
    if (index) return index
    index = new Map()
    for (const [id, n] of g.nodes) {
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            const list = index.get(ref)
            if (list) list.push([id, i])
            else index.set(ref, [[id, i]])
        }
    }
    users.set(g, index)
    return index
}
const exclusives = new WeakMap<Graph, Map<number, Set<number>>>()
function exclusive(g: Graph, root: number): Set<number> {
    let byGraph = exclusives.get(g)
    if (!byGraph) exclusives.set(g, byGraph = new Map())
    const known = byGraph.get(root)
    if (known) return known
    const found = exclusiveOf(g, root)
    byGraph.set(root, found)
    return found
}
function exclusiveOf(g: Graph, root: number): Set<number> {
    const users = usersOf(g)
    const inside = new Set<number>([root])
    const pending = new Map<number, number>()
    const work = [root]
    while (work.length) {
        const id = work.pop()!
        const n = getNode(g, id)
        if (!n) continue
        if (n.op === NodeOp.apply) {
            const block = getBlock(g, getRef(n, 0))
            const entries = (users.get(getRef(n, 0)) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
            if (block && block.bodyId && !inside.has(block.bodyId)) {
                const own = bodyNodes(g, block.bodyId)
                if (entries.every(e => inside.has(e) || own.has(e))) {
                    inside.add(block.bodyId)
                    work.push(block.bodyId)
                }
            }
        }
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref || inside.has(ref)) continue
            const m = getNode(g, ref)
            if (!m || m.op === NodeOp.param) continue
            const left = (pending.get(ref) ?? (users.get(ref) ?? []).length) - 1
            pending.set(ref, left)
            if (left > 0) continue
            inside.add(ref)
            work.push(ref)
        }
    }
    return inside
}
const bodies = new WeakMap<Graph, Map<number, Set<number>>>()
function bodyNodes(g: Graph, body: number): Set<number> {
    let byGraph = bodies.get(g)
    if (!byGraph) bodies.set(g, byGraph = new Map())
    const known = byGraph.get(body)
    if (known) return known
    const found = new Set<number>()
    const work = [body]
    while (work.length) {
        const id = work.pop()!
        if (found.has(id)) continue
        found.add(id)
        const n = getNode(g, id)
        if (n) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) work.push(getRef(n, i))
    }
    byGraph.set(body, found)
    return found
}
const guardMaps = new WeakMap<Graph, Map<number, [cond: number, positive: boolean][]>>()
function guardsOf(g: Graph): Map<number, [cond: number, positive: boolean][]> {
    const known = guardMaps.get(g)
    if (known) return known
    const out = new Map<number, [number, boolean][]>()
    for (const n of g.nodes.values()) {
        if (n.op !== NodeOp.select || countIds(n) !== 3 || !getRef(n, 0)) continue
        let cond = getRef(n, 0)
        let positive = true
        for (let c = getNode(g, cond); c?.op === NodeOp.not && getRef(c, 0); c = getNode(g, cond)) {
            cond = getRef(c, 0)
            positive = !positive
        }
        if (!comparison(getNode(g, cond)?.op ?? NodeOp.literal)) continue
        for (const [arm, polarity] of [[getRef(n, 1), positive], [getRef(n, 2), !positive]] as [number, boolean][]) {
            if (!arm) continue
            for (const member of exclusive(g, arm)) {
                let list = out.get(member)
                if (!list) out.set(member, list = [])
                list.push([cond, polarity])
            }
        }
    }
    guardMaps.set(g, out)
    return out
}
function comparison(op: NodeOp): boolean {
    return op === NodeOp.lt || op === NodeOp.le || op === NodeOp.gt || op === NodeOp.ge || op === NodeOp.eq || op === NodeOp.ne
}

function analyzeValues(roots: Function[], host: AccessHost, isolated?: Isolated, fixedFloats?: Map<Function, number[]>): Accesses {
    const frames: Frame[] = []
    const frameIds = new Map<string, number>()
    const unitKeys = new Map<Function, number>()
    const values: Value[] = [{ kind: ValueKind.undefined }, { kind: ValueKind.string }, { kind: ValueKind.unknown }]
    const valueIds = new Map<string, number>()
    const allocations: Allocation[] = []
    const allocationIds = new Map<string, number>()
    const locations: Location[] = []
    const locationIds = new Map<string, number>()
    const recorded = new Set<string>()
    const touched = new Map<number, Set<number>>()
    const contents = new Map<number, Set<number>>()
    const contentReaders = new Map<number, Set<number>>()
    const fieldsOf = new Map<number, number[]>()
    const copiers = new Map<number, Set<number>>()
