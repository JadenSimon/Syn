        frames.forEach((frame, f) => {
            const g = frame.graph
            if (g) for (const [id, n] of g.nodes) if (n.op === NodeOp.call && seeded.has(key(f, id)) && opaque(f, n, g)) flow(f, id, [opaqueValue(g, id)])
        })
        drain()
    }
    opaqueCalls()
    for (let round = 0; round < 4; round++) {
        let added = false
        frames.forEach((frame, f) => {
            const g = frame.graph
            if (!g) return
            for (const [id, n] of g.nodes) {
                if (n.op !== NodeOp.getProp || !seeded.has(key(f, id)) || valuesAt(f, id).size) continue
                if (![...valuesAt(f, getRef(n, 1))].some(v => values[v].allocation !== undefined)) continue
                const locs = touched.get(key(f, id))
                if (!locs?.size || [...locs].some(loc => contents.get(loc)?.size || locations[loc].key === numberKey)) continue
                flow(f, id, [Undefined])
                added = true
            }
        })
        if (!added) break
        drain()
        opaqueCalls()
    }
    frames.forEach((frame, f) => {
        const g = frame.graph
        if (!g) return
        for (const [id, n] of g.nodes) {
            if (!seeded.has(key(f, id))) continue
            const untraced = n.op === NodeOp.call ? [...valuesAt(f, getRef(n, 1))].flatMap(v => values[v].fn && !host.traceable(values[v].fn!) ? [values[v].fn!] : []) : []
            const blind = opaque(f, n, g)
            if (!blind && !untraced.length) continue
            const first = !blind && untraced.every(fn => host.receiverless?.(fn)) ? 3 : 2
            for (let i = first; i < countIds(n); i++) {
                if (!getRef(n, i)) continue
                for (const v of valuesAt(f, getRef(n, i))) {
                    if (values[v].allocation !== undefined) allocations[values[v].allocation!].escaped = true
                    for (const state of functionObjects.get(v) ?? []) {
                        const allocation = allocationIds.get(`@${state}`)
                        if (allocation !== undefined) allocations[allocation].escaped = true
                    }
                }
            }
        }
    })
    for (const [loc, set] of contents) locations[loc].values = [...set].sort((a, b) => a - b)
    const units = new Map<Function, UnitValues>()
    frames.forEach((frame, f) => {
        const g = frame.graph
        if (!g) return
        let unit = units.get(frame.unit)
        if (!unit) {
            const self = receiverOf(g)
            let plain = 0
            units.set(frame.unit, unit = { params: g.blocks[0].params.map(p => ({ label: p === self ? 'this' : `p${plain++}`, values: [] })), returns: [] })
        }
        g.blocks[0].params.forEach((p, i) => unit!.params[i].values.push(...valuesAt(f, p)))
        unit.returns.push(...returns.get(f) ?? [])
    })
    const unique = (list: number[]) => [...new Set(list)].sort((a, b) => a - b)
    for (const unit of units.values()) {
        for (const param of unit.params) param.values = unique(param.values)
        unit.returns = unique(unit.returns)
    }
    const elementSets = new Map<number, number[]>()
    locations.forEach((location, loc) => {
        if (location.key !== numberKey && !constantIndex(location.key)) return
        let list = elementSets.get(location.allocation)
        if (!list) elementSets.set(location.allocation, list = [])
        list.push(...setOf(contents, loc))
    })
    function mixedSlot(loc: number): boolean {
        const location = locations[loc]
        const list = location.key === numberKey || constantIndex(location.key) ? elementSets.get(location.allocation)! : [...setOf(contents, loc)]
        return list.some(v => values[v].kind === ValueKind.number) && list.some(v => values[v].kind === ValueKind.object || values[v].kind === ValueKind.string)
    }
    const frameValues: FrameValues[] = []
    interface Scan {
        stores: number[]
        loads: number[]
        selects: number[]
    }
    const scans = new Map<Graph, Scan>()
    function scanOf(g: Graph): Scan {
        const known = scans.get(g)
        if (known) return known
        const scan: Scan = { stores: [], loads: [], selects: [] }
        for (const [id, n] of g.nodes) {
            if (n.op === NodeOp.store && resultType(g, n) === Types.vm_value) scan.stores.push(id)
            if (n.op === NodeOp.select) scan.selects.push(id)
            if (n.op !== NodeOp.ret || !getRef(n, 0) || regionRets(g).has(id)) continue
            let at = getRef(n, 0)
            for (let m = getNode(g, at); m?.op === NodeOp.after; m = getNode(g, at)) at = getRef(m, countIds(m) - 1)
            const load = getNode(g, at)
            if (load?.op === NodeOp.load && resultType(g, load) === Types.vm_value) scan.loads.push(at)
        }
        scans.set(g, scan)
        return scan
    }
    function touchesMixed(f: number, id: number): boolean {
        for (const loc of touched.get(key(f, id)) ?? []) if (mixedSlot(loc)) return true
        return false
    }
    function liveArms(f: number, g: Graph): Map<number, boolean[]> {
        const out = new Map<number, boolean[]>()
        for (const id of scanOf(g).selects) {
            if (!seeded.has(key(f, id))) continue
            const n = getNode(g, id)!
            const arms: boolean[] = []
            for (let i = 1; i < countIds(n); i++) arms.push(!getRef(n, i) || seeded.has(key(f, getRef(n, i))))
            out.set(id, arms)
        }
        return out
    }
    frames.forEach((frame, f) => {
        const g = frame.graph
        if (!g) return
        const self = receiverOf(g)
        let plain = 0
        const params = g.blocks[0].params.map(p => ({ label: p === self ? 'this' : `p${plain++}`, values: [...valuesAt(f, p)].sort((a, b) => a - b) }))
        const sites = [...callSites.get(f) ?? []].map(k => {
            const [caller, node] = parse(k)
            return { unit: frames[caller].unit, node, frame: caller }
        })
        const scan = scanOf(g)
        const boxes = scan.stores.some(id => touchesMixed(f, id))
        const boxedReturn = scan.loads.some(id => touchesMixed(f, id))
        frameValues.push({ unit: frame.unit, context: frame.context, sites, signature: frame.signature, params, returns: [...returns.get(f) ?? []].sort((a, b) => a - b), boxes, boxedReturn, nodes: frame.nodes, blocks: new Set(g.blocks.map(b => b.id).filter(b => entered.has(key(f, b)))), selects: liveArms(f, g) })
    })
    const graphs = new Map<Function, Graph>()
    for (const frame of frames) if (frame.graph) graphs.set(frame.unit, frame.graph)
    frames.forEach((frame, f) => {
        if (!intrinsics.argv().includes(`node-values:${frame.unit.name}`)) return
        const lines = [`NODE-VALUES ${frame.unit.name} <${frame.context}>`]
        for (const id of frame.graph!.nodes.keys()) lines.push(`  %${id}${seeded.has(key(f, id)) ? '' : ' (unseeded)'}: ${[...valuesAt(f, id)].map(v => JSON.stringify(values[v])).join(' ')}`)
        console.log(lines.join('\n'))
    })
    if (intrinsics.argv().includes('analysis-stats')) console.log('ANALYSIS-RUN', roots.map(r => r.name).join(','), 'frames', frames.length, 'allocations', allocations.length, 'locations', locations.length, 'values', values.length, 'variant', !!fixedFloats)
    return { allocations, locations, values, units, frames: frameValues, graphs, numeric, keyHandles, floatSets, consulted }
}

export interface Type {
    undefined: boolean
    string: boolean
    unknown: boolean
    literals: number[]
    fixed: intrinsics.Types[]
    bounds: string[]
    objects: number[]
    functions: Function[]
    closures: number[]
}

export interface ObjectType {
    name: string
    site: Site
    context: string
    constant: boolean
    native: boolean
    proto?: Handle
    state?: Handle
    fields: Map<string, Type>
    forms: Map<string, string[]>
    initialized: Set<string>
    escaped: boolean
    readers: Site[]
}

export interface Signature {
    params: { label: string, type: Type }[]
    returns: Type
}

export interface LayoutClass {
    members: number[]
    names: string[]
    fields: Map<string, Type>
}

export interface FrameSignature extends Signature {
    unit: Function
    context: string
    sites: Site[]
    signature: string[]
    boxes: boolean
    boxedReturn: boolean
    nodes: Map<number, Type>
    blocks: Set<number>
    selects: Map<number, boolean[]>
}

export interface ValueTypes {
    ms: number
    frames: FrameSignature[]
    objects: ObjectType[]
    signatures: Map<Function, Signature>
    classes: LayoutClass[]
    classOf: number[]
    stateAllocations: Map<Handle, number[]>
    keyHandles: Map<string, Handle>
    keyNames: Map<Handle, string>
    strings: Map<Function, Set<number>>
}

export interface Field {
    type: Type
    forms: string[]
}

export function fieldAt(types: ValueTypes, allocations: number[], keys: string[]): Field | undefined {
    let current = allocations
    let field: Field | undefined
    for (const key of keys) {
        if (!current.length) return
        let type = emptyType()
        let forms: string[] = []
        let found = false
        for (const allocation of current) {
            const object = types.objects[allocation]
            const known = object.fields.get(key) ?? (constantIndex(key) ? object.fields.get(numberKey) : undefined)
            if (known) {
                found = true
                type = union(type, known)
                forms = merge(forms, object.forms.get(key) ?? object.forms.get(numberKey) ?? [])
            }
            if (key === numberKey) for (const [other, inner] of object.fields) if (constantIndex(other)) {
                found = true
                type = union(type, inner)
                forms = merge(forms, object.forms.get(other) ?? [])
            }
        }
        if (!found) return
        field = { type, forms }
        current = type.objects
    }
    return field
}

function encapsulationViolations(data: Accesses, host: AccessHost): Set<Handle> {
    const broken = new Set<Handle>()
    if (!host.invariantsOf) return broken
    const byAllocation = new Map<number, Location[]>()
    for (const loc of data.locations) {
        let list = byAllocation.get(loc.allocation)
        if (!list) byAllocation.set(loc.allocation, list = [])
        list.push(loc)
    }
    const receivers = new Map<number, FrameValues[]>()
    for (const frame of data.frames) for (const v of frame.params.find(p => p.label === 'this')?.values ?? []) {
        const allocation = data.values[v].allocation
        if (allocation === undefined) continue
        let list = receivers.get(allocation)
        if (!list) receivers.set(allocation, list = [])
        list.push(frame)
    }
    data.allocations.forEach((allocation, id) => {
        const proto = allocation.proto
        const invariants = proto ? host.invariantsOf!(proto) : undefined
        if (!proto || !invariants?.pairs.length || broken.has(proto)) return
        const inside = (site: Site) => invariants.closure.has(site.unit)
        for (const path of new Set(invariants.pairs.flat())) {
            let owners = [id]
            for (const key of path.split('.')) {
                const next: number[] = []
                for (const owner of owners) for (const loc of byAllocation.get(owner) ?? []) {
                    if (loc.key !== key) continue
                    if (!loc.writers.every(inside)) broken.add(proto)
                    for (const v of loc.values) if (data.values[v].allocation !== undefined && data.values[v].kind === ValueKind.object) next.push(data.values[v].allocation!)
                }
                if (next.length && owners !== next) for (const owned of next) {
                    const writers = new Set((byAllocation.get(owned) ?? []).flatMap(loc => loc.writers.map(w => w.unit)))
                    for (const frame of receivers.get(owned) ?? []) if (writers.has(frame.unit) && !frame.sites.every(inside)) broken.add(proto)
                }
                owners = next
            }
        }
    })
    return broken
}

function constantIndex(key: string): boolean {
    return /^(\[\d+\]|@-?\d+)$/.test(key)
}

function emptyType(): Type {
    return { undefined: false, string: false, unknown: false, literals: [], fixed: [], bounds: [], objects: [], functions: [], closures: [] }
}

function merge<T>(a: T[], b: T[]): T[] {
    if (a === b || !b.length) return a
    if (!a.length) return b
    const seen = new Set(a)
    let out: T[] | undefined
    for (const x of b) {
        if (seen.has(x)) continue
        seen.add(x)
        if (!out) out = [...a]
        out.push(x)
    }
    return out ?? a
}

function union(a: Type, b: Type): Type {
    if (a === b) return a
    const literals = merge(a.literals, b.literals)
    const fixed = merge(a.fixed, b.fixed)
    const bounds = merge(a.bounds, b.bounds)
    const objects = merge(a.objects, b.objects)
    const functions = merge(a.functions, b.functions)
    const closures = merge(a.closures, b.closures)
    const flags = (a.undefined || !b.undefined) && (a.string || !b.string) && (a.unknown || !b.unknown)
    if (flags && literals === a.literals && fixed === a.fixed && bounds === a.bounds && objects === a.objects && functions === a.functions && closures === a.closures) return a
    return { undefined: a.undefined || b.undefined, string: a.string || b.string, unknown: a.unknown || b.unknown, literals, fixed, bounds, objects, functions, closures }
}

export function analyzeTypes(roots: Function[], host: AccessHost): ValueTypes {
    const start = performance.now()
    let data = analyzeValues(roots, host)
    let fixedFloats: Map<Function, number[]> | undefined
    if (host.variantOf && [...data.floatSets.values()].some(sets => sets.size > 1)) {
        fixedFloats = new Map()
        for (const [origin, sets] of data.floatSets) fixedFloats.set(origin, [...new Set([...sets.values()].flat())].sort((a, b) => a - b))
        data = analyzeValues(roots, host, undefined, fixedFloats)
    }
    const broken = encapsulationViolations(data, host)
    if (broken.size && intrinsics.argv().includes('invariant-debug')) console.log('ENCAPSULATION-BROKEN', [...broken].join(' '))
    if ([...broken].some(proto => data.consulted.has(proto))) data = analyzeValues(roots, { ...host, invariantsOf: proto => broken.has(proto) ? undefined : host.invariantsOf!(proto) }, undefined, fixedFloats)
    const objects: ObjectType[] = data.allocations.map(allocation => ({ name: allocation.name, site: allocation.site, context: allocation.context, constant: allocation.constant, native: !!allocation.native, proto: allocation.proto, state: allocation.state, fields: new Map(), forms: new Map(), initialized: new Set<string>(), escaped: allocation.escaped, readers: [] }))
    const interned = new Map<string, Type>()
    function typeOf(list: Iterable<number>): Type {
        let k = ''
        let first = true
        for (const v of list) {
            k = first ? `${v}` : `${k},${v}`
            first = false
        }
        const known = interned.get(k)
        if (known) return known
        const type = emptyType()
        interned.set(k, type)
        if (first) type.undefined = true
        for (const v of list) {
            const value = data.values[v]
            intrinsics.assert(value.kind !== ValueKind.variable)
            switch (value.kind) {
                case ValueKind.undefined: type.undefined = true; break
                case ValueKind.string: type.string = true; break
                case ValueKind.unknown: type.unknown = true; break
                case ValueKind.object: type.objects = merge(type.objects, [value.allocation!]); break
                case ValueKind.function:
                    type.functions = merge(type.functions, [value.fn!])
                    if (value.allocation !== undefined) type.closures = merge(type.closures, [value.allocation])
                    break
                case ValueKind.number:
                    if (value.form === NumberForm.literal) type.literals = merge(type.literals, [value.literal!])
                    else if (value.form === NumberForm.fixed) type.fixed = merge(type.fixed, [value.type!])
                    else type.bounds = merge(type.bounds, [value.bound!])
                    break
            }
        }
        return type
    }
    const written = (location: Location) => location.values.length > 0 || location.writers.length > 0
    const initialWrites = new Map<ObjectType, [string, number]>()
    const indexed = new Set(data.locations.filter(location => (location.key === numberKey || constantIndex(location.key)) && written(location)).map(location => location.allocation))
    for (const location of data.locations) {
        const object = objects[location.allocation]
        if (!written(location) && indexed.has(location.allocation) && (location.key === numberKey || constantIndex(location.key))) continue
        object.fields.set(location.key, union(object.fields.get(location.key) ?? emptyType(), typeOf(location.values)))
        object.forms.set(location.key, merge(object.forms.get(location.key) ?? [], location.forms))
        object.readers.push(...location.readers)
        const writers = new Set(location.writers.map(w => `${unitIdentity(w.unit)}:${w.node}`))
        if (writers.size === 1 && location.writers[0].unit === object.site.unit && !location.forms.includes('init')) initialWrites.set(object, [location.key, location.writers[0].node])
    }
    const contained = new Set(objects.flatMap(object => [...object.fields.values()].flatMap(type => type.objects)))
    for (const [object, [key, node]] of initialWrites) {
        if (object.fields.size !== 1 || contained.has(objects.indexOf(object))) continue
        const g = host.graphOf(object.site.unit)
        const block = blockOf(g, node)
        if (block && block === blockOf(g, object.site.node)) object.initialized.add(key)
    }
    const stateAllocations = new Map<Handle, number[]>()
    objects.forEach((object, i) => {
        if (object.state === undefined) return
        let list = stateAllocations.get(object.state)
        if (!list) stateAllocations.set(object.state, list = [])
        list.push(i)
    })
    const signatures = new Map<Function, Signature>()
    for (const [unit, values] of data.units) {
        signatures.set(unit, {
            params: values.params.map(param => ({ label: param.label, type: typeOf(param.values) })),
            returns: typeOf(values.returns),
        })
    }
    const parent = objects.map((_, i) => i)
    function find(a: number): number {
        while (parent[a] !== a) a = parent[a] = parent[parent[a]]
        return a
    }
    function meet(list: number[]): void {
        let first = -1
        for (const v of list) {
            const allocation = data.values[v].allocation
            if (allocation === undefined) continue
            if (first < 0) first = find(allocation)
            else parent[find(allocation)] = first
        }
    }
    for (const location of data.locations) meet(location.values)
    for (const values of data.units.values()) {
        for (const param of values.params) meet(param.values)
        meet(values.returns)
    }
    const met = new Set<Type>()
    function anchorOf(type: Type): number {
        const anchor = type.objects.length ? type.objects[0] : type.closures.length ? type.closures[0] : -1
        if (anchor < 0 || met.has(type)) return anchor
        met.add(type)
        for (const id of type.objects) parent[find(id)] = find(anchor)
        for (const id of type.closures) parent[find(id)] = find(anchor)
        return anchor
    }
    const stringOnly = (type: Type) => type.string && !type.undefined && !type.unknown && !type.literals.length && !type.fixed.length && !type.bounds.length && !type.objects.length && !type.functions.length
    const anchors = new Map<Function, Map<number, number>>()
    const unitFrames = new Map<Function, FrameSignature[]>()
    const stringCandidates = new Map<Function, Set<number>>()
    const frames: FrameSignature[] = data.frames.map(frame => {
        let byNode = anchors.get(frame.unit)
        if (!byNode) anchors.set(frame.unit, byNode = new Map())
        const nodes = new Map<number, Type>()
        for (const [node, values] of frame.nodes) {
            if (!values.size) continue
            const type = typeOf(values)
            nodes.set(node, type)
            if (stringOnly(type)) {
                let set = stringCandidates.get(frame.unit)
                if (!set) stringCandidates.set(frame.unit, set = new Set())
                set.add(node)
            }
            const anchor = anchorOf(type)
            if (anchor < 0) continue
            const known = byNode.get(node)
            if (known === undefined) byNode.set(node, anchor)
            else parent[find(anchor)] = find(known)
        }
        const signature: FrameSignature = {
            unit: frame.unit, context: frame.context, sites: frame.sites, signature: frame.signature, boxes: frame.boxes, boxedReturn: frame.boxedReturn,
            params: frame.params.map(param => ({ label: param.label, type: typeOf(param.values) })),
            returns: typeOf(frame.returns),
            nodes,
            blocks: frame.blocks,
            selects: frame.selects,
        }
        let list = unitFrames.get(frame.unit)
        if (!list) unitFrames.set(frame.unit, list = [])
        list.push(signature)
        return signature
    })
    const classes: LayoutClass[] = []
    const classIds = new Map<number, number>()
    const classOf = objects.map((object, i) => {
        const root = find(i)
        let id = classIds.get(root)
        if (id === undefined) {
            classIds.set(root, id = classes.length)
            classes.push({ members: [], names: [], fields: new Map() })
        }
        const layout = classes[id]
        layout.members.push(i)
        if (!layout.names.includes(object.name)) layout.names.push(object.name)
        for (const [key, type] of object.fields) layout.fields.set(key, union(layout.fields.get(key) ?? emptyType(), type))
        return id
    })
    const strings = new Map<Function, Set<number>>()
    for (const [unit, candidates] of stringCandidates) for (const node of candidates) {
        if (!unitFrames.get(unit)!.every(frame => !frame.nodes.has(node) || stringOnly(frame.nodes.get(node)!))) continue
        let set = strings.get(unit)
        if (!set) strings.set(unit, set = new Set())
        set.add(node)
    }
    if (intrinsics.argv().includes('frames-dump')) frames.forEach((frame, id) => console.log('FRAME', id, frame.unit.name || '<anon>', `<${frame.context}>`, frame.params.map(p => `${p.label}:${formatType({ objects } as ValueTypes, p.type)}`).join(' '), '->', formatType({ objects } as ValueTypes, frame.returns)))
    const keyNames = new Map<Handle, string>()
    for (const [name, k] of data.keyHandles) keyNames.set(k, name)
    return { ms: performance.now() - start, objects, signatures, frames, classes, classOf, stateAllocations, keyHandles: data.keyHandles, keyNames, strings }
}

function initOnly(object: ObjectType, k: string | undefined): boolean {
    return k === undefined || (object.forms.get(k) ?? []).every(form => form === 'init')
}

export function fixedField(types: ValueTypes, state: Handle, key: Handle): boolean {
    const index = heap.keyIndex(key)
    const name = index !== undefined ? `[${index}]` : types.keyNames.get(key)
    return (types.stateAllocations.get(state) ?? []).every(id => !types.objects[id].escaped && initOnly(types.objects[id], name) && initOnly(types.objects[id], numberKey))
}

export function fixedState(types: ValueTypes, state: Handle): boolean {
    return (types.stateAllocations.get(state) ?? []).every(id => !types.objects[id].escaped && [...types.objects[id].forms.keys()].every(k => initOnly(types.objects[id], k)))
}

function floating(T: intrinsics.Types): boolean {
    return T === Types.f64 || T === Types.f32 || T === Types.f16
}

function signedType(T: intrinsics.Types): boolean {
    return T === Types.i8 || T === Types.i16 || T === Types.i32 || T === Types.i64
}

function holds(T: intrinsics.Types, literal: number): boolean {
    if (floating(T)) return true
    if (!Number.isInteger(literal)) return false
    return literal >= 0 || signedType(T)
}

export function formatType(types: ValueTypes, type: Type): string {
    const atoms: string[] = []
    const numeric = type.fixed.length > 0 || type.bounds.length > 0
    if (type.undefined) atoms.push('undefined')
    for (const literal of type.literals) {
        const absorbed = type.fixed.some(T => holds(T, literal)) || type.bounds.some(b => b === 'num64' || Number.isInteger(literal))
        if (!absorbed) atoms.push(String(literal))
    }
    for (const T of type.fixed) atoms.push(typeName(T))
    if (!type.fixed.length) for (const bound of type.bounds) if (!(bound === 'int64' && type.bounds.includes('num64'))) atoms.push(`<=${bound}`)
    if (type.string) atoms.push('string')
    for (const id of type.objects) atoms.push(`${types.objects[id].name}#${id}`)
    for (const fn of type.functions) atoms.push(`fn ${fn.name || '<anon>'}`)
    if (type.unknown) atoms.push('unknown')
    return atoms.join(' | ') || (numeric ? 'number' : 'never')
}

const intWidths: [intrinsics.Types, number, boolean][] = [
    [Types.u8, 8, false], [Types.u16, 16, false], [Types.u32, 32, false], [Types.u64, 64, false],
    [Types.i8, 8, true], [Types.i16, 16, true], [Types.i32, 32, true], [Types.i64, 64, true],
]

function intShape(T: intrinsics.Types): [width: number, signed: boolean] | undefined {
    const known = intWidths.find(([U]) => U === T)
    if (known) return [known[1], known[2]]
    if (T === Types.bool) return [8, false]
}

function numberRepresentation(type: Type): string {
    if (type.fixed.length) {
        if (type.fixed.some(floating)) return 'f64'
        const shapes = type.fixed.map(intShape)
        if (shapes.some(shape => !shape)) return type.fixed.map(typeName).join('|')
        const signed = shapes.some(shape => shape![1]) || type.literals.some(l => l < 0)
        const width = Math.max(...shapes.map(shape => shape![0]))
        const mixed = signed && shapes.some(shape => !shape![1] && shape![0] >= width)
        return typeName((mixed ? intWidths.find(([, w, s]) => s && w > width) ?? intWidths[7] : intWidths.find(([, w, s]) => w === width && s === signed)!)[0])
    }
    if (type.bounds.includes('num64') || type.literals.some(l => !Number.isInteger(l))) return 'f64'
    if (type.bounds.includes('int64')) return 'i64'
    if (type.bounds.includes('uint64')) return 'u64'
    if (type.bounds.length) return type.bounds[0]
    const low = Math.min(...type.literals)
    const high = Math.max(...type.literals)
    if (low >= 0 && high < 2 ** 32) return 'u32'
    if (low >= -(2 ** 31) && high < 2 ** 31) return 'i32'
    return 'i64'
}

export function representation(types: ValueTypes, type: Type): string {
    if (type.unknown) return 'any'
    const numeric = type.fixed.length > 0 || type.bounds.length > 0 || type.literals.length > 0
    const refs = [...new Set([...type.objects, ...type.closures].map(a => types.classOf[a]))].sort((a, b) => a - b)
    const pointers = refs.length > 0 || type.string || type.functions.some(fn => !type.closures.length)
    const nulls = !type.fixed.length && !type.bounds.length && type.literals.length === 1 && type.literals[0] === 0
    if (numeric && pointers && !nulls) return 'union'
    if (numeric && !pointers && type.undefined) return 'union'
    if (numeric && !pointers) return numberRepresentation(type)
    if (!pointers) return type.undefined ? 'undefined' : 'never'
    const targets = refs.map(c => `C${c}`)
    if (type.string) targets.push('str')
    if (type.functions.length && !type.closures.length) targets.push('fn')
    return `ptr<${targets.join('|')}>${type.undefined || nulls ? '?' : ''}`
}

export function typeStats(types: ValueTypes): string {
    return `TYPES ${types.ms.toFixed(1)}ms frames=${types.frames.length} objects=${types.objects.length} classes=${types.classes.length}`
}

export function dumpTypes(types: ValueTypes): string {
    const lines: string[] = [typeStats(types)]
    types.classes.forEach((layout, id) => {
        const members = layout.members.map(m => `${types.objects[m].name}#${m}`).join(' ')
        lines.push(`CLASS C${id} ${layout.names.join('|')} [${members}]`)
        for (const key of [...layout.fields.keys()].sort()) {
            const type = layout.fields.get(key)!
            lines.push(`  ${key}: ${formatType(types, type)} => ${representation(types, type)}`)
        }
    })
    if (intrinsics.argv().includes('types-objects')) types.objects.forEach((object, id) => {
        for (const [key, type] of object.fields) lines.push(`OBJECT ${object.name}#${id}@${object.site.unit.name}:%${object.site.node}<${object.context}> ${key}: ${formatType(types, type)} [${object.forms.get(key)?.join(',')}]`)
    })
    for (const [unit, signature] of types.signatures) {
        const params = signature.params.map(p => `${p.label}: ${formatType(types, p.type)} => ${representation(types, p.type)}`).join(', ')
        lines.push(`SIG ${unit.name || '<anon>'}(${params}) -> ${formatType(types, signature.returns)} => ${representation(types, signature.returns)}`)
    }
    return lines.join('\n')
}

export interface NativeParam {
    label: string
    kind?: intrinsics.Types
    nullish: boolean
    keys?: string[]
}

export interface NativeUnit {
    name: string
    origin: Function
    sites: Site[]
    params: NativeParam[]
    returns: intrinsics.Types
}

export function checkTypes(types: ValueTypes, units: NativeUnit[]): string {
    const lines: string[] = [typeStats(types)]
    for (const unit of units) {
        const plain = unit.params.filter(param => param.label !== 'this')
        const compatible = (frame: FrameSignature) => plain.every((param, i) => {
            const c = frame.signature[i]
            if (c === undefined || c === '' || c === '*') return true
            if (param.nullish) return c === 'u'
            if (param.kind === Types.f64) return c === 'd'
            if (param.kind !== undefined && param.kind !== Types.vm_value) return c === 'i' || c === 'd'
            if (param.keys) return c.startsWith('o')
            return true
        })
        const sited = types.frames.filter(frame => frame.unit === unit.origin && compatible(frame) && frame.sites.some(s => unit.sites.some(site => s.unit === site.unit && s.node === site.node)))
        const signature: Signature | undefined = sited.length ? {
            params: sited[0].params.map((param, i) => ({ label: param.label, type: sited.map(frame => frame.params[i].type).reduce(union) })),
            returns: sited.map(frame => frame.returns).reduce(union),
        } : types.signatures.get(unit.origin)
        if (!signature) {
            lines.push(`UNSEEN ${unit.name}`)
            continue
        }
        if (!sited.length && unit.sites.length) lines.push(`UNMATCHED ${unit.name}: ${unit.sites.map(s => `${s.unit.name}:%${s.node}`).join(' ')}`)
        for (const param of unit.params) {
            const mine = signature.params.find(p => p.label === param.label)?.type
            if (!mine) continue
            const repr = representation(types, mine)
            const shown = `${formatType(types, mine)} => ${repr}`
            if (param.nullish && !(mine.undefined && !mine.objects.length && !mine.fixed.length && !mine.bounds.length && !mine.literals.length)) lines.push(`NULLISH ${unit.name}.${param.label}: native nullish, analysis ${shown}`)
            if (param.kind === Types.f64 && repr !== 'f64') lines.push(`F64 ${unit.name}.${param.label}: native f64, analysis ${shown}`)
            if (param.kind !== undefined && param.kind !== Types.f64 && param.kind !== Types.vm_value && (mine.objects.some(a => types.objects[a].name !== 'buffer') || mine.string || mine.unknown)) lines.push(`NUMBER ${unit.name}.${param.label}: native ${typeName(param.kind)}, analysis ${shown}`)
            if (param.keys && !mine.functions.length) {
                const classes = [...new Set(mine.objects.map(a => types.classOf[a]))]
                if (!classes.length) lines.push(`SHAPE ${unit.name}.${param.label}: native {${param.keys.join(',')}}, analysis ${shown}`)
                for (const c of classes) {
                    const missing = param.keys.filter(k => !types.classes[c].fields.has(k))
                    if (missing.length) lines.push(`SHAPE ${unit.name}.${param.label}: native {${param.keys.join(',')}} vs C${c} missing ${missing.join(',')}`)
                }
            }
        }
        const returns = representation(types, signature.returns)
        if (unit.returns === Types.f64 && returns !== 'f64') lines.push(`RETURN ${unit.name}: native f64, analysis ${formatType(types, signature.returns)} => ${returns}`)
    }
    return lines.join('\n')
}

export interface GenericParam {
    name: string
    paths: string[]
}

export interface Generic {
    name: string
    ms: number
    params: GenericParam[]
    paths: string[]
    invariants: Invariants
    lines: string[]
}

function keyLabel(k: Handle): string {
    if (heap.isString(k)) return heap.stringToJs(k)
    return heap.describeKey(k) ?? `#${k}`
}

function unitNodes(data: Accesses): Map<Function, Map<number, number[]>> {
    const united = new Map<Function, Map<number, Set<number>>>()
    for (const frame of data.frames) {
        let byNode = united.get(frame.unit)
        if (!byNode) united.set(frame.unit, byNode = new Map())
        for (const [node, values] of frame.nodes) {
            let set = byNode.get(node)
            if (!set) byNode.set(node, set = new Set())
            for (const v of values) set.add(v)
        }
    }
    const out = new Map<Function, Map<number, number[]>>()
    for (const [unit, byNode] of united) {
        const sorted = new Map<number, number[]>()
        for (const [node, set] of byNode) sorted.set(node, [...set].sort((a, b) => a - b))
        out.set(unit, sorted)
    }
    return out
}

export function analyzeGenerics(name: string, proto: Handle, ctor: Function, host: AccessHost, genericOf: (proto: Handle) => Generic | undefined): Generic {
    const start = performance.now()
    const methods: [string, Function][] = [['constructor', ctor]]
    function add(label: string, handle: u32): void {
        const fn = handle ? host.functionOf(handle) : undefined
        if (fn && fn !== ctor && host.traceable(fn) && !methods.some(([, m]) => m === fn)) methods.push([label, fn])
    }
    for (let k: u32 = 0; k < heap.ownPropertyCount(proto); k++) {
        const key = heap.ownPropertyKeyAt(proto, k)
        const addr = heap.getOwnProperty(proto, key)
        if (!addr) continue
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        if (d.flags & heap.PropFlags.has_getter) add(`get ${keyLabel(key)}`, d.slot0)
        if (d.flags & heap.PropFlags.has_setter) add(`set ${keyLabel(key)}`, d.slot1)
        if (!(d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter))) add(keyLabel(key), d.slot0)
    }
    const trap = heap.getPropertyProxy(proto, heap.indexKey(0 as u32))
    if (trap) {
        add('get [index]', heap.getProxyGetter(trap) as u32)
        add('set [index]', heap.getProxySetter(trap) as u32)
    }
    const data = analyzeValues(methods.map(([, fn]) => fn), host, { name, proto })
    const nodes = unitNodes(data)
    const byAllocation = new Map<number, number[]>()
    data.locations.forEach((loc, i) => {
        let list = byAllocation.get(loc.allocation)
        if (!list) byAllocation.set(loc.allocation, list = [])
        list.push(i)
    })
    const paths = new Map<number, string>([[0, '']])
    const order = [0]
    for (let i = 0; i < order.length; i++) {
        const allocation = order[i]
        for (const loc of byAllocation.get(allocation) ?? []) {
            for (const v of data.locations[loc].values) {
                const inner = data.values[v].allocation
                if (inner === undefined || data.values[v].kind !== ValueKind.object || paths.has(inner)) continue
                paths.set(inner, `${paths.get(allocation)}${paths.get(allocation) ? '.' : ''}${data.locations[loc].key}`)
                order.push(inner)
            }
        }
    }
    const parent = new Map<number, number>()
    function find(v: number): number {
        let at = v
        while (parent.has(at) && parent.get(at) !== at) at = parent.get(at)!
        return at
    }
    const baseOf = (v: number) => data.values[v].base ?? v
    const variables = (list: Iterable<number>) => [...new Set([...list].filter(v => data.values[v].kind === ValueKind.variable && !data.values[v].narrow).map(baseOf))].filter(v => !data.numeric.has(v))
    for (const allocation of order) for (const loc of byAllocation.get(allocation) ?? []) {
        const vars = variables(data.locations[loc].values)
        for (const v of vars.slice(1)) parent.set(find(v), find(vars[0]))
    }
    const rank = (v: number) => {
        const value = data.values[v]
        const method = methods.findIndex(([, fn]) => fn === value.site!.unit)
        return (method < 0 ? methods.length : method) * nodeSpan + (value.param ?? nodeSpan - 1)
    }
    const firsts = new Map<number, number>()
    for (const allocation of order) for (const loc of byAllocation.get(allocation) ?? []) {
        for (const v of variables(data.locations[loc].values)) firsts.set(find(v), Math.min(firsts.get(find(v)) ?? Infinity, rank(v)))
    }
    const names = new Map<number, string>()
    for (const [root] of [...firsts].sort((a, b) => a[1] - b[1])) names.set(root, `T${names.size}`)
    function label(v: number): string {
        const narrow = data.values[v].narrow
        if (narrow) return `${label(baseOf(v))}&${narrow}`
        const named = names.get(find(v))
        if (named) return named
        const value = data.values[v]
        return value.param !== undefined ? `?${value.site!.unit.name || '<anon>'}.p${value.param}` : `?${value.site!.unit.name || '<anon>'}%${value.site!.node}`
    }
    function format(list: Iterable<number>): string {
        const atoms = new Set<string>()
        const literals: number[] = []
        for (const v of list) {
            const value = data.values[v]
            switch (value.kind) {
                case ValueKind.undefined: atoms.add('undefined'); break
                case ValueKind.string: atoms.add('string'); break
                case ValueKind.unknown: atoms.add('unknown'); break
                case ValueKind.variable: atoms.add(data.numeric.has(v) ? `number(${label(v)})` : label(v)); break
                case ValueKind.function: atoms.add(`fn ${value.fn!.name || '<anon>'}`); break
                case ValueKind.object: {
                    const path = paths.get(value.allocation!)
                    atoms.add(value.allocation === 0 ? 'self' : instances.get(value.allocation!) ?? `${data.allocations[value.allocation!].name}${path === undefined ? `#${value.allocation}` : ''}`)
                    break
                }
                case ValueKind.number:
                    if (value.form === NumberForm.literal) literals.push(value.literal!)
                    else atoms.add(value.form === NumberForm.fixed ? typeName(value.type!) : `<=${value.bound}`)
                    break
            }
        }
        if (literals.length > 4) atoms.add(`${Math.min(...literals)}..${Math.max(...literals)}`)
        else for (const literal of literals) atoms.add(String(literal))
        return [...atoms].join(' | ') || 'never'
    }
    const indexed = new Set(data.locations.filter(loc => loc.key === numberKey).map(loc => loc.allocation))
    const pathOf = (allocation: number, key: string) => `${paths.get(allocation)}${paths.get(allocation) ? '.' : ''}${indexed.has(allocation) && constantIndex(key) ? numberKey : key}`
    const contentsAt = new Map<string, Set<number>>()
    for (const allocation of order) for (const loc of byAllocation.get(allocation) ?? []) {
        const k = pathOf(allocation, data.locations[loc].key)
        let set = contentsAt.get(k)
        if (!set) contentsAt.set(k, set = new Set())
        for (const v of data.locations[loc].values) set.add(v)
    }
    const params = [...names.values()].map(param => ({ name: param, paths: [] as string[] }))
    for (const [k, set] of contentsAt) for (const v of variables(set)) {
        const param = params.find(p => p.name === names.get(find(v)))
        if (param && !param.paths.includes(k)) param.paths.push(k)
    }
    const instances = new Map<number, string>()
    const hidden = new Set<number>()
    for (const allocation of order.slice(1)) {
        if (hidden.has(allocation)) continue
        const inner = data.allocations[allocation].proto
        const generic = inner !== undefined && inner !== proto ? genericOf(inner) : undefined
        if (!generic) continue
        const prefix = paths.get(allocation)!
        const args = generic.params.map(param => {
            const set = new Set<number>()
            for (const path of param.paths) for (const v of contentsAt.get(`${prefix}.${path}`) ?? []) set.add(v)
            return format(set)
        })
        instances.set(allocation, `${generic.name}${args.length ? `<${args.join(', ')}>` : ''}`)
        for (const other of order) if (other !== allocation && paths.get(other)!.startsWith(`${prefix}.`)) hidden.add(other)
    }
    const allPaths = [...contentsAt.keys()]
    const numeric = (k: string) => {
        const set = contentsAt.get(k)
        return !!set && set.size > 0 && [...set].every(v => data.values[v].kind === ValueKind.number || (data.values[v].kind === ValueKind.variable && data.numeric.has(baseOf(v))))
    }
    const candidates = allPaths.filter(k => {
        const segments = k.split('.')
        if (segments.length > 2 || /[[@]/.test(k) || !numeric(k)) return false
        return segments.length === 1 || [...contentsAt.get(segments[0]) ?? []].some(v => data.values[v].kind === ValueKind.object)
    })
    const proveStart = performance.now()
    const invariants = { pairs: proveInvariants(methods, ctor, data, host, candidates, nodes), closure: new Set(data.units.keys()) }
    const proveMs = performance.now() - proveStart
    const lines: string[] = []
    const ms = performance.now() - start
    lines.push(`GENERIC ${name}${params.length ? `<${params.map(p => p.name).join(', ')}>` : ''} ${ms.toFixed(1)}ms frames=${data.frames.length}`)
    for (const param of params) lines.push(`  param ${param.name}: ${param.paths.join(' ')}`)
    lines.push(`  invariants ${proveMs.toFixed(1)}ms candidates=${candidates.join(',')}`)
    for (const [x, y] of invariants.pairs) lines.push(`  invariant ${x} == ${y}`)
    for (const allocation of order) {
        if (hidden.has(allocation) || instances.has(allocation)) continue
        for (const loc of byAllocation.get(allocation) ?? []) {
            const k = pathOf(allocation, data.locations[loc].key)
            if (contentsAt.has(k)) lines.push(`  ${k}: ${format(contentsAt.get(k)!)}`)
            contentsAt.delete(k)
        }
    }
    for (const [method, fn] of methods) {
        const unit = data.units.get(fn)
        if (!unit) continue
        const args = unit.params.filter(param => param.label !== 'this').map(param => format(param.values))
        lines.push(`  ${method}(${args.join(', ')}) -> ${format(unit.returns)}`)
    }
    const divergences = new Map<string, Set<string>>()
    for (const [unit, byNode] of nodes) {
        const g = data.graphs.get(unit)
        if (!g) continue
        for (const [id, n] of g.nodes) {
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const kind = divergence(n, i)
                if (!kind) continue
                for (const v of byNode.get(ref) ?? []) {
                    if (data.values[v].kind !== ValueKind.variable || data.numeric.has(baseOf(v))) continue
                    const param = label(v)
                    let set = divergences.get(param)
                    if (!set) divergences.set(param, set = new Set())
                    set.add(`${unit.name || '<anon>'}:${kind}`)
                }
            }
        }
    }
    for (const [param, set] of divergences) lines.push(`  diverges ${param}: ${[...set].join(' ')}`)
    return { name, ms, params, paths: allPaths, invariants, lines }
}

function divergence(n: GraphNode, slot: number): string | undefined {
    if (n.op === NodeOp.rt) return slot >= 2 ? 'rt' : undefined
    if (n.op === NodeOp.call) return slot === 1 ? 'call' : undefined
    if (n.op === NodeOp.getProp || n.op === NodeOp.setProp) return slot === 1 ? 'property' : slot === 2 ? 'key' : undefined
    if (n.op === NodeOp.load) return slot === 1 || slot === 2 ? 'address' : undefined
    if (n.op === NodeOp.store) return slot === 1 || slot === 2 ? 'address' : slot === 3 && typeOf(n) !== Types.vm_value ? `store ${typeName(typeOf(n))}` : undefined
    if (n.op === NodeOp.select) return slot === 0 ? 'branch' : undefined
    if (n.op === NodeOp.convert || n.op === NodeOp.bitconvert) return n.op === NodeOp.convert ? 'convert' : 'bitconvert'
    if (n.op === NodeOp.eq || n.op === NodeOp.ne) return 'equals'
    if (n.op === NodeOp.lt || n.op === NodeOp.le || n.op === NodeOp.gt || n.op === NodeOp.ge) return 'compare'
    if (NumericOps.has(n.op)) return 'arith'
    if (n.op === NodeOp.not) return 'truthy'
}

export interface Instantiation {
    key: string
    members: number[]
    fields: Map<string, string>
}

export interface ShapeSignature {
    text: string
    proto: Handle | undefined
    fields: [string, Rep][]
    members: number[]
}

export interface Rep {
    text: string
    kind: 'any' | 'never' | 'undefined' | 'number' | 'pointer' | 'union' | 'buffer'
    number?: 'int' | 'i64' | 'f64'
    targets: string[]
    nullable: boolean
    fresh?: boolean
    element?: Rep
    encoded?: boolean
    constant?: Function
}

export interface Instantiations {
    keys: string[]
    table: Map<string, Instantiation>
    shapes: Map<string, ShapeSignature>
    constantShapes: Map<Handle, string>
    nullable: Set<string>
    rep(type: Type): string
    repOf(type: Type): Rep
    shapeOf(allocation: number): string | undefined
}

export function instantiate(types: ValueTypes, genericOf: (proto: Handle) => Generic | undefined, joins: [number, number][] = []): Instantiations {
    const keys: string[] = []
    const owners: (string | undefined)[] = []
    const ownerClasses: (string | undefined)[] = []
    const pending = new Set<number>()
    function genericFor(id: number): Generic | undefined {
        const proto = types.objects[id].proto
        return proto ? genericOf(proto) : undefined
    }
    function rep(type: Type): string {
        if (type.unknown) return 'any'
        const numeric = type.fixed.length > 0 || type.bounds.length > 0 || type.literals.length > 0
        const targets = [...new Set([...type.objects, ...type.closures].map(keyOf))].sort()
        if (type.string) targets.push('str')
        if (type.functions.length && !type.closures.length) targets.push('fn')
        if (!targets.length) return numeric ? (type.undefined ? 'union' : numberRepresentation(type)) : type.undefined ? 'undefined' : 'never'
        const nulls = !type.fixed.length && !type.bounds.length && type.literals.length === 1 && type.literals[0] === 0
        if (numeric && !nulls) return 'union'
        return `ptr<${targets.join('|')}>${type.undefined || nulls ? '?' : ''}`
    }
    function layoutOf(members: number[], indexed: boolean): [string, Type][] {
        const merged = new Map<string, Type>()
        for (const id of members) {
            const object = types.objects[id]
            for (const [k, type] of object.fields) {
                if (!object.forms.get(k)?.length) continue
                const at = (indexed || object.fields.has(numberKey)) && constantIndex(k) ? numberKey : k
                merged.set(at, merged.has(at) ? union(merged.get(at)!, type) : type)
            }
        }
        return [...merged.keys()].sort().map(k => [k, merged.get(k)!])
    }
    function claim(id: number, owner: string, generic: Generic): void {
        for (const path of generic.paths) {
            const segments = path.split('.')
            let current = [id]
            for (let depth = 1; depth < segments.length && current.length; depth++) {
                const next: number[] = []
                for (const inner of fieldAt(types, current, [segments[depth - 1]])?.type.objects ?? []) {
                    if (genericFor(inner)) continue
                    owners[inner] ??= `${owner}.${segments.slice(0, depth).join('.')}`
                    ownerClasses[inner] ??= `${generic.name}.${segments.slice(0, depth).join('.')}`
                    next.push(inner)
                }
                current = next
            }
        }
    }
    const recordParent = types.objects.map((_, i) => i)
    function findRecord(a: number): number {
        while (recordParent[a] !== a) a = recordParent[a] = recordParent[recordParent[a]]
        return a
    }
    const joinable = (id: number) => {
        const object = types.objects[id]
        if (object.native || object.name === 'buffer') return false
        return genericFor(id) ? true : !object.constant || object.name === 'Object'
    }
    function joinRecords(list: number[]): boolean {
        const byProto = new Map<Handle | undefined, number>()
        let merged = false
        for (const id of list) {
            if (!joinable(id)) continue
            const first = byProto.get(types.objects[id].proto)
            if (first === undefined) byProto.set(types.objects[id].proto, id)
            else if (findRecord(id) !== findRecord(first)) {
                recordParent[findRecord(id)] = findRecord(first)
                merged = true
            }
        }
        return merged
    }
    for (const object of types.objects) for (const field of object.fields.values()) joinRecords(field.objects)
    for (const pair of joins) joinRecords(pair)
    for (const frame of types.frames) {
        for (const param of frame.params) joinRecords(param.type.objects)
        joinRecords(frame.returns.objects)
    }
    for (let changed = true; changed;) {
        changed = false
        const groups = new Map<number, number[]>()
        types.objects.forEach((_, id) => {
            if (!joinable(id)) return
            let list = groups.get(findRecord(id))
            if (!list) groups.set(findRecord(id), list = [])
            list.push(id)
        })
        for (const members of groups.values()) {
            if (members.length < 2) continue
            const byKey = new Map<string, number[]>()
            for (const id of members) for (const [k, field] of types.objects[id].fields) {
                let list = byKey.get(k)
                if (!list) byKey.set(k, list = [])
                list.push(...field.objects)
            }
            for (const list of byKey.values()) if (joinRecords(list)) changed = true
        }
    }
    const recordMembers = new Map<number, number[]>()
    types.objects.forEach((_, id) => {
        if (!joinable(id)) return
        let list = recordMembers.get(findRecord(id))
        if (!list) recordMembers.set(findRecord(id), list = [])
        list.push(id)
    })
    function keyOf(id: number): string {
        if (keys[id] !== undefined) return keys[id]
        if (pending.has(id)) return `^${types.objects[id].name}`
        pending.add(id)
        const object = types.objects[id]
        const generic = genericFor(id)
        let key: string
        if (generic) {
            const group = recordMembers.get(findRecord(id)) ?? [id]
            const args = generic.params.map(param => {
                let type: Type | undefined
                for (const path of param.paths) {
                    const field = fieldAt(types, group, path.split('.'))
                    if (field) type = type ? union(type, field.type) : field.type
                }
                return type ? rep(type) : 'never'
            })
            key = `${generic.name}${args.length ? `<${args.join(', ')}>` : ''}`
            claim(id, key, generic)
        } else key = owners[id] ?? `${object.name}@${object.site.unit.name || '<anon>'}:%${object.site.node}`
        const joined = !generic && owners[id] === undefined && joinable(id) ? recordMembers.get(findRecord(id)) ?? [id] : [id]
        if (joined.length > 1) key = `${object.name}@join${findRecord(id)}`
        if (!generic && owners[id] === undefined) key = `${key}{${layoutOf(joined, false).map(([k, type]) => `${k}: ${rep(type)}`).join(', ')}}`
        pending.delete(id)
        keys[id] = key
        return key
    }
    types.objects.forEach((_, id) => { if (genericFor(id)) keyOf(id) })
    const table = new Map<string, Instantiation>()
    types.objects.forEach((object, id) => {
        const key = keyOf(id)
        let entry = table.get(key)
        if (!entry) table.set(key, entry = { key, members: [], fields: new Map() })
        entry.members.push(id)
    })
    for (const entry of table.values()) {
        const owned = owners[entry.members[0]] !== undefined
        for (const [k, type] of layoutOf(entry.members, owned)) entry.fields.set(k, rep(type))
    }
    const shapes = new Map<string, ShapeSignature>()
    const protoOrders = new Map<Handle, string[]>()
    const shapeIds = new Map<string, string>()
    const shapePending = new Map<string, string>()
    const referenced = new Set<string>()
    let nextShape = 0
    function elementRep(members: number[]): Rep {
        const forms = new Set<string>()
        let type: Type | undefined
        for (const id of members) for (const [k, field] of types.objects[id].fields) {
            if (k !== numberKey && !constantIndex(k)) continue
            if (!types.objects[id].forms.get(k)?.length) continue
            for (const form of types.objects[id].forms.get(k)!) forms.add(form)
            type = type ? union(type, field) : field
        }
        if (!type) return { text: 'never', kind: 'never', targets: [], nullable: false }
        const stored = [...forms].filter(form => form !== 'prop' && form !== 'init')
        if (stored.length === 1 && stored[0] === 'vm_value') {
            const inner = repOf(type)
            return { ...inner, text: `enc<${inner.text}>`, encoded: true }
        }
        if (!stored.length) return repOf(type)
        const text = stored.sort().join('|')
        if (text === 'f64' || text === 'f32') return { text, kind: 'number', number: 'f64', targets: [], nullable: false }
        if (/^(bool|[ui](8|16|32|64))$/.test(text)) return { text, kind: 'number', number: 'int', targets: [], nullable: false }
        return { text, kind: 'any', targets: [], nullable: false }
    }
    function shapeId(key: string): string {
        const known = shapeIds.get(key)
        if (known) return known
        const pending = shapePending.get(key)
        if (pending) {
            referenced.add(pending)
            return pending
        }
        const reserved = `S${nextShape++}`
        shapePending.set(key, reserved)
        const entry = table.get(key)!
        const object = types.objects[entry.members[0]]
        const fields: [string, Rep][] = []
        const members = entry.members.map(id => types.objects[id])
        const constant = members.find(o => o.constant && o.state !== undefined)
        const fixed = constant ?? members.find(o => o.state !== undefined && dataKeys(o.state).length > 0)
        const stateOrder = fixed ? dataKeys(fixed.state!).map(k => heap.isString(k) ? heap.stringToJs(k) : heap.describeKey(k) ?? `#${k}`) : []
        const shared = !constant && object.proto !== undefined ? protoOrders.get(object.proto) : undefined
        const order = shared ?? stateOrder
        if (object.proto !== undefined && stateOrder.length && !protoOrders.has(object.proto)) protoOrders.set(object.proto, stateOrder)
        for (const [k, merged] of layoutOf(entry.members, false)) {
            if (k === numberKey || k.startsWith('@')) continue
            const partial = entry.members.some(id => !types.objects[id].forms.get(k)?.length)
            const type = partial ? { ...merged, undefined: true } : merged
            const buffers = [...new Set([...type.objects].filter(id => owners[id] !== undefined && !genericFor(id)))]
            if (buffers.length && buffers.length === type.objects.length) {
                const element = elementRep(buffers)
                const nullable = type.undefined || type.literals.includes(0)
                fields.push([k, { text: `buf<${element.text}>${nullable ? '?' : ''}`, kind: 'buffer', element, targets: [], nullable }])
            } else fields.push([k, repOf(type)])
        }
        if (order.length) fields.sort((x, y) => (order.indexOf(x[0]) + 1 || order.length + 1) - (order.indexOf(y[0]) + 1 || order.length + 1))
        const text = `${object.name}{${fields.map(([k, r]) => `${k}: ${r.text}`).join(', ')}}`
        shapePending.delete(key)
        let id = referenced.has(reserved) ? undefined : [...shapes].find(([, sig]) => sig.text === text && sig.proto === object.proto)?.[0]
        if (!id) shapes.set(id = reserved, { text, proto: object.proto, fields, members: [] })
        shapes.get(id)!.members.push(...entry.members)
        shapeIds.set(key, id)
        return id
    }
    const reps = new Map<Type, Rep>()
    const nullable = new Set<string>()
    function repOf(type: Type): Rep {
        const known = reps.get(type)
        if (known) return known
        const rep = repFor(type, true)
        reps.set(type, rep)
        return rep
    }
    function repFor(type: Type, pointers: boolean): Rep {
        if (type.unknown) return { text: 'any', kind: 'any', targets: [], nullable: false }
        const numeric = type.fixed.length > 0 || type.bounds.length > 0 || type.literals.length > 0
        const objects = type.objects.filter(id => !types.objects[id].native)
        const raw = (id: number) => types.objects[id].name === 'buffer' || (owners[id] !== undefined && !genericFor(id))
        const targets = pointers ? [...new Set(objects.map(id => raw(id) ? 'buf' : shapeId(keyOf(id))))].sort() : objects.length ? ['*'] : []
        if (type.string) targets.push('str')
        const nativeIds = [...type.closures, ...type.objects.filter(id => types.objects[id].native)]
        const natives = [...new Set(nativeIds.map(id => types.objects[id].state))]
        const plain = type.functions.some(fn => !type.closures.length)
        const nativeShapes = pointers && !plain ? [...new Set(nativeIds.map(id => shapeId(keyOf(id))))] : []
        if (pointers && natives.length === 1 && natives[0] !== undefined && !plain) targets.push(`clo@${natives[0]}`)
        else if (nativeShapes.length === 1) targets.push(nativeShapes[0])
        else if (type.functions.length || natives.length) targets.push('fn')
        const float = type.fixed.some(floating) || type.bounds.includes('num64') || type.literals.some(l => !Number.isInteger(l))
        const signed = type.literals.some(l => l < 0) || type.fixed.some(T => T === Types.i8 || T === Types.i16 || T === Types.i32 || T === Types.i64) || type.bounds.includes('int64')
        if (!targets.length && numeric) {
            const number = float ? 'f64' : signed ? 'i64' : 'int'
            return { text: `${number}${type.undefined ? '?' : ''}`, kind: 'number', number, targets: [], nullable: type.undefined }
        }
        if (!targets.length) return type.undefined ? { text: 'undefined', kind: 'undefined', targets: [], nullable: true } : { text: 'never', kind: 'never', targets: [], nullable: false }
        const nulls = !type.fixed.length && !type.bounds.length && type.literals.length === 1 && type.literals[0] === 0
        if (numeric && !nulls) return { text: pointers ? `union<${targets.join('|')}>` : 'union', kind: 'union', targets, nullable: false }
        const fresh = !nativeIds.length && !type.functions.length && !type.string && objects.length > 0 && objects.every(id => !types.objects[id].constant && !raw(id))
        if (type.undefined || nulls) for (const target of targets) if (shapeTarget(target)) nullable.add(target)
        return { text: `ptr<${targets.join('|')}>${type.undefined || nulls ? '?' : ''}`, kind: 'pointer', targets, nullable: type.undefined || nulls, fresh }
    }
    for (const key of table.keys()) if (!owners[table.get(key)!.members[0]] && types.objects[table.get(key)!.members[0]].name !== 'buffer') shapeId(key)
    const constantShapes = new Map<Handle, string>()
    types.objects.forEach((object, id) => {
        if (!object.constant || object.state === undefined || !joinable(id) || recordMembers.get(findRecord(id))!.length < 2) return
        constantShapes.set(object.state, shapeId(keyOf(id)))
    })
    return { keys, table, shapes, constantShapes, nullable, rep, repOf: type => repOf(type), shapeOf: id => types.objects[id].name === 'buffer' || (owners[id] !== undefined && !genericFor(id)) ? undefined : shapeId(keyOf(id)) }
}

export interface PlannedUnit {
    fn: Function
    boxes: boolean
    boxedReturn: boolean
    allocations: Map<number, string>
    signature: string
    frames: number[]
    params: { label: string, rep: Rep }[]
    returns: Rep
    returnsSelf: boolean
    nodes: Map<number, Rep>
    blocks: Set<number>
    deadArms: Map<number, number[]>
    calls: Map<number, Set<PlannedUnit>>
    boxedCalls: Set<number>
}

function constantRep(type: Type): Rep | undefined {
    if (type.functions.length !== 1 || type.closures.length || type.objects.length || type.undefined || type.string || type.unknown) return
    if (type.literals.length || type.fixed.length || type.bounds.length) return
    return { text: `fn@${unitIdentity(type.functions[0])}`, kind: 'pointer', targets: ['fn'], nullable: false, constant: type.functions[0] }
}

export function planUnits(types: ValueTypes, inst: Instantiations): Map<Function, PlannedUnit[]> {
    const created = new Map<number, string[]>()
    const contextFrames = new Map<string, number>()
    types.frames.forEach((frame, id) => contextFrames.set(`${unitIdentity(frame.unit)}|${frame.context}`, id))
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = inst.shapeOf(id)
        const frame = contextFrames.get(`${unitIdentity(object.site.unit)}|${object.context}`)
        if (shape === undefined || frame === undefined) return
        let list = created.get(frame)
        if (!list) created.set(frame, list = [])
        list.push(`%${object.site.node}=${shape}`)
    })
    const signatureOf = (params: { label: string, type: Type }[], returns: Type, allocations: string[] = []) => {
        const reps = params.map(param => ({ label: param.label, rep: constantRep(param.type) ?? inst.repOf(param.type) }))
        const abis = reps.map(param => `${param.label}: ${param.rep.text}`)
        const made = [...new Set(allocations)].sort()
        const returned = inst.repOf(returns)
        return { params: reps, returns: returned, signature: `(${abis.join(', ')}) -> ${returned.text}${made.length ? ` new ${made.join(' ')}` : ''}` }
    }
    const parent = types.frames.map((_, i) => i)
    function find(a: number): number {
        while (parent[a] !== a) a = parent[a] = parent[parent[a]]
        return a
    }
    const targets = new Map<number, string[]>()
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            let list = targets.get(site.frame)
            if (!list) targets.set(site.frame, list = [])
            list.push(`%${site.node}=${unitIdentity(frame.unit)}`)
        }
    })
    const bySignature = new Map<string, number>()
    types.frames.forEach((frame, id) => {
        const calls = [...new Set(targets.get(id) ?? [])].sort().join(' ')
        const signature = signatureOf(frame.params, frame.returns, created.get(id)).signature
        const keyed = signature.replace(/\bint\b/g, 'i64')
        const k = `${unitIdentity(frame.unit)}|${keyed}|${calls}|${frame.boxes}|${frame.boxedReturn}`
        const first = bySignature.get(k)
        if (first === undefined) bySignature.set(k, id)
        else parent[find(id)] = find(first)
    })
    const callees = new Map<string, number[]>()
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            const k = `${site.frame}|${site.node}`
            let list = callees.get(k)
            if (!list) callees.set(k, list = [])
            list.push(id)
        }
    })
    let changed = true
    while (changed) {
        changed = false
        const byCallerSite = new Map<string, number>()
        for (const [k, list] of callees) {
            const [callerFrame, node] = k.split('|').map(Number)
            const siteKey = `${find(callerFrame)}|${node}`
            for (const id of list) {
                const first = byCallerSite.get(siteKey)
                if (first === undefined) byCallerSite.set(siteKey, id)
                else if (find(first) !== find(id) && types.frames[first].unit === types.frames[id].unit) {
                    parent[find(id)] = find(first)
                    changed = true
                }
            }
        }
    }
    const plan = new Map<Function, PlannedUnit[]>()
    const unitOfRoot = new Map<number, PlannedUnit>()
    const unitOfFrame: PlannedUnit[] = []
    types.frames.forEach((frame, id) => {
        const root = find(id)
        let unit = unitOfRoot.get(root)
        if (!unit) {
            unitOfRoot.set(root, unit = { fn: frame.unit, boxes: false, boxedReturn: false, allocations: new Map(), signature: '', frames: [], params: [], returns: { text: 'never', kind: 'never', targets: [], nullable: false }, returnsSelf: false, nodes: new Map(), blocks: new Set(), deadArms: new Map(), calls: new Map(), boxedCalls: new Set() })
            let units = plan.get(frame.unit)
            if (!units) plan.set(frame.unit, units = [])
            units.push(unit)
        }
        unit.frames.push(id)
        if (frame.boxes) unit.boxes = true
        if (frame.boxedReturn) unit.boxedReturn = true
        unitOfFrame[id] = unit
    })
    for (const unit of unitOfRoot.values()) {
        const first = types.frames[unit.frames[0]]
        const params = first.params.map((param, i) => ({ label: param.label, type: unit.frames.map(f => types.frames[f].params[i].type).reduce(union) }))
        const returned = unit.frames.map(f => types.frames[f].returns).reduce(union)
        const joined = signatureOf(params, returned, unit.frames.flatMap(f => created.get(f) ?? []))
        const merged = new Map<number, Type>()
        for (const f of unit.frames) for (const [node, type] of types.frames[f].nodes) merged.set(node, merged.has(node) ? union(merged.get(node)!, type) : type)
        for (const [node, type] of merged) unit.nodes.set(node, inst.repOf(type))
        for (const f of unit.frames) for (const b of types.frames[f].blocks) unit.blocks.add(b)
        const live = new Map<number, boolean[]>()
        for (const f of unit.frames) for (const [select, arms] of types.frames[f].selects) {
            const known = live.get(select)
            live.set(select, known ? known.map((x, i) => x || arms[i]) : [...arms])
        }
        for (const [select, arms] of live) {
            const dead = arms.flatMap((x, i) => x ? [] : [i + 1])
            if (dead.length && dead.length < arms.length) unit.deadArms.set(select, dead)
        }
        unit.returnsSelf = unit.frames.every(f => {
            const frame = types.frames[f]
            const r = frame.returns
            return r.objects.length > 0 && r.objects.every(id => frame.context.startsWith(`o${id}|`)) && !r.undefined && !r.string && !r.unknown && !r.literals.length && !r.fixed.length && !r.bounds.length && !r.functions.length && !r.closures.length
        })
        unit.params = joined.params
        unit.returns = joined.returns
        unit.signature = joined.signature
    }
    const conflicted = new Set<string>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = inst.shapeOf(id)
        if (shape === undefined) return
        for (const unit of plan.get(object.site.unit) ?? []) {
            if (!unit.frames.some(f => types.frames[f].context === object.context)) continue
            const known = unit.allocations.get(object.site.node)
            const k = `${unit.signature}|${object.site.node}`
            if (known !== undefined && known !== shape) conflicted.add(k)
            unit.allocations.set(object.site.node, shape)
        }
    })
    for (const units of plan.values()) for (const unit of units) for (const node of [...unit.allocations.keys()]) if (conflicted.has(`${unit.signature}|${node}`)) unit.allocations.delete(node)
    types.frames.forEach((frame, id) => {
        for (const site of frame.sites) {
            if (site.frame === undefined) continue
            const caller = unitOfFrame[site.frame]
            let set = caller.calls.get(site.node)
            if (!set) caller.calls.set(site.node, set = new Set())
            set.add(unitOfFrame[id])
            if (frame.boxedReturn) caller.boxedCalls.add(site.node)
        }
    })
    return plan
}

export function pendingJoins(types: ValueTypes, inst: Instantiations, plan: Map<Function, PlannedUnit[]>): [number, number][] {
    const pairs: [number, number][] = []
    function collect(objects: number[]): void {
        const byProto = new Map<Handle | undefined, Map<string, number>>()
        for (const id of objects) {
            const object = types.objects[id]
            if (object.native || object.name === 'buffer') continue
            const shape = inst.shapeOf(id)
            if (shape === undefined) continue
            let shapes = byProto.get(object.proto)
            if (!shapes) byProto.set(object.proto, shapes = new Map())
            if (!shapes.has(shape)) shapes.set(shape, id)
        }
        for (const shapes of byProto.values()) {
            const [first, ...rest] = [...shapes.values()]
            for (const other of rest) pairs.push([first, other])
        }
    }
    const unitByFrame = new Map<number, PlannedUnit>()
    for (const units of plan.values()) for (const unit of units) {
        const first = types.frames[unit.frames[0]]
        first.params.forEach((_, i) => collect([...new Set(unit.frames.flatMap(f => types.frames[f].params[i].type.objects))]))
        collect([...new Set(unit.frames.flatMap(f => types.frames[f].returns.objects))])
        for (const f of unit.frames) unitByFrame.set(f, unit)
    }
    const contextFrames = new Map<string, number>()
    types.frames.forEach((frame, id) => contextFrames.set(`${unitIdentity(frame.unit)}|${frame.context}`, id))
    const bySite = new Map<string, number[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native) return
        const frame = contextFrames.get(`${unitIdentity(object.site.unit)}|${object.context}`)
        const unit = frame === undefined ? undefined : unitByFrame.get(frame)
        if (!unit) return
        const k = `${unit.signature}|${object.site.node}`
        let list = bySite.get(k)
        if (!list) bySite.set(k, list = [])
        list.push(id)
    })
    for (const list of bySite.values()) if (list.length > 1) collect(list)
    return pairs
}

export interface Embeddings {
    fields: Map<string, Map<string, string>>
    sites: Map<PlannedUnit, Map<number, string>>
}

export function planEmbeddings(types: ValueTypes, inst: Instantiations, plan: Map<Function, PlannedUnit[]>): Embeddings {
    const holders = new Map<number, [number, string][]>()
    types.objects.forEach((object, id) => {
        for (const [key, type] of object.fields) for (const inner of type.objects) {
            let list = holders.get(inner)
            if (!list) holders.set(inner, list = [])
            list.push([id, key])
        }
    })
    const returned = new Set(types.frames.flatMap(frame => frame.returns.objects.filter(id => !frame.context.startsWith(`o${id}|`))))
    const sameSite = (a: number, b: number) => types.objects[a].site.unit === types.objects[b].site.unit && types.objects[a].site.node === types.objects[b].site.node
    const onlyObjects = (t: Type) => !t.undefined && !t.string && !t.unknown && !t.literals.length && !t.fixed.length && !t.bounds.length && !t.functions.length && !t.closures.length && t.objects.length > 0
    function owner(inner: number): [number, string] | undefined {
        const object = types.objects[inner]
        if (object.constant || object.native || object.name === 'buffer' || returned.has(inner)) return
        const held = holders.get(inner) ?? []
        if (held.length !== 1) return
        const [parent, key] = held[0]
        const outer = types.objects[parent]
        if (outer.constant || outer.native || !object.context.startsWith(`o${parent}|`)) return
        const type = outer.fields.get(key)!
        if (!onlyObjects(type) || !type.objects.every(id => sameSite(id, inner))) return
        return [parent, key]
    }
    const fields = new Map<string, Map<string, string>>()
    for (const [P, sig] of inst.shapes) {
        const byKey = new Map<string, string>()
        for (const [key] of sig.fields) {
            let inner: string | undefined
            const embeds = sig.members.length > 0 && sig.members.every(m => {
                const t = types.objects[m].fields.get(key)
                return !!t && onlyObjects(t) && t.objects.every(id => {
                    const I = inst.shapeOf(id)
                    if (owner(id)?.[0] !== m || I === undefined || I === P || (inner !== undefined && inner !== I)) return false
                    inner = I
                    return true
                })
            })
            if (embeds && inner !== undefined) byKey.set(key, inner)
        }
        if (byKey.size) fields.set(P, byKey)
    }
    const contextFrames = new Map<string, number>()
    types.frames.forEach((frame, id) => contextFrames.set(`${unitIdentity(frame.unit)}|${frame.context}`, id))
    const unitOfFrame = new Map<number, PlannedUnit>()
    for (const units of plan.values()) for (const unit of units) for (const f of unit.frames) unitOfFrame.set(f, unit)
    for (let round = 0; round < 2; round++) {
        const keys = new Map<string, Set<string>>()
        const placed = new Map<string, [PlannedUnit, number]>()
        types.objects.forEach((object, id) => {
            const frame = contextFrames.get(`${unitIdentity(object.site.unit)}|${object.context}`)
            const unit = frame === undefined ? undefined : unitOfFrame.get(frame)
            if (!unit || !unit.allocations.has(object.site.node)) return
            const k = `${unit.signature}|${unitIdentity(unit.fn)}|${object.site.node}`
            const found = owner(id)
            const P = found ? inst.shapeOf(found[0]) : undefined
            const key = found && P !== undefined && fields.get(P)?.get(found[1]) === inst.shapeOf(id) ? `${P}.${found[1]}` : ''
            let set = keys.get(k)
            if (!set) keys.set(k, set = new Set())
            set.add(key)
            placed.set(k, [unit, object.site.node])
        })
        let dropped = false
        for (const set of keys.values()) {
            if (set.size < 2) continue
            for (const key of set) {
                if (!key) continue
                const [P, field] = [key.slice(0, key.indexOf('.')), key.slice(key.indexOf('.') + 1)]
                if (fields.get(P)?.delete(field)) dropped = true
            }
        }
        if (dropped && round === 0) continue
        const sites = new Map<PlannedUnit, Map<number, string>>()
        for (const [k, set] of keys) {
            const [key] = [...set]
            if (set.size !== 1 || !key || !fields.get(key.slice(0, key.indexOf('.')))?.has(key.slice(key.indexOf('.') + 1))) continue
            const [unit, node] = placed.get(k)!
            let map = sites.get(unit)
            if (!map) sites.set(unit, map = new Map())
            map.set(node, key.slice(key.indexOf('.') + 1))
        }
        return { fields, sites }
    }
    return { fields: new Map(), sites: new Map() }
}

interface Moves {
    words: Set<number>
    elements: ElementReads
}

export type ElementReads = Set<Handle> | 'all'

function movesOf(g: Graph): Moves {
    const known = moveSets.get(g)
    if (known) return known
    const users = usersOf(g)
    function movedBy(passing: boolean): (id: number) => boolean {
        const memo = new Map<number, boolean>()
        function moved(id: number): boolean {
            const done = memo.get(id)
            if (done !== undefined) return done
            memo.set(id, false)
            const result = (users.get(id) ?? []).every(([user, slot]) => {
                const n = getNode(g, user)!
                if (n.op === NodeOp.after) return slot < countIds(n) - 1 || moved(user)
                if (slot === 0 && (n.op === NodeOp.load || n.op === NodeOp.store || n.op === NodeOp.getProp || n.op === NodeOp.setProp || n.op === NodeOp.call)) return true
                if (n.op === NodeOp.store) return slot === 3 && resultType(g, n) === Types.vm_value
                if (n.op === NodeOp.setProp) return passing && slot === 3
                if (n.op === NodeOp.call) return passing && slot >= 3
                return n.op === NodeOp.ret && slot === 0
            })
            memo.set(id, result)
            return result
        }
        return moved
    }
    const moved = movedBy(true)
    const kept = movedBy(false)
    const words = new Set<number>()
    let elements: ElementReads = new Set<Handle>()
    for (const [id, n] of g.nodes) {
        const load = n.op === NodeOp.load && resultType(g, n) === Types.vm_value
        if (n.op === NodeOp.load && elements !== 'all' && !(load && kept(id))) {
            const base = getNode(g, getRef(n, 1))
            if (base?.op === NodeOp.load) elements = 'all'
            else if (base?.op === NodeOp.getProp && !getRef(base, 2)) elements.add(getLiteral(g, base, 2) as Handle)
        }
        if ((load || n.op === NodeOp.getProp || n.op === NodeOp.call || g.blocks[0].params.includes(id)) && moved(id)) words.add(id)
    }
    const out = { words, elements }
    moveSets.set(g, out)
    return out
}
const moveSets = new WeakMap<Graph, Moves>()

function rawCandidate(g: Graph): boolean {
    const seen = new Set<number>()
    function raw(id: number): boolean {
        if (!id || seen.has(id)) return true
        seen.add(id)
        const n = getNode(g, id)
        if (!n) return false
        if (n.op === NodeOp.after) return raw(getRef(n, countIds(n) - 1))
        if (n.op === NodeOp.select) return raw(getRef(n, 1)) && raw(getRef(n, 2))
        if (n.op === NodeOp.ret || n.op === NodeOp.inlined) return raw(getRef(n, 0))
        return n.op === NodeOp.panic || n.op === NodeOp.unreachable || n.op === NodeOp.literal || n.op === NodeOp.param || n.op === NodeOp.call || (n.op === NodeOp.heapHandle && !getRef(n, 0))
    }
    return [...g.nodes].every(([id, n]) => n.op !== NodeOp.ret || !getRef(n, 0) || raw(id))
}

function shapeTarget(target: string): boolean {
    return target.startsWith('S')
}

function movedClass(rep: Rep, param: boolean, reduced: (target: string) => boolean): string {
    if (rep.number === 'int' || (rep.kind === 'undefined' && !param) || (rep.kind === 'pointer' && rep.targets.length === 1 && rep.targets[0] === 'str')) return 'word'
    if (rep.kind === 'number') return rep.number!
    return `${repKey(rep, target => movedTarget(target, reduced))}${rep.fresh ? '!' : ''}`
}

function movedTarget(target: string, reduced: (target: string) => boolean): string {
    const kind = shapeTarget(target) ? 'S' : target.startsWith('clo@') ? 'clo' : undefined
    if (kind === undefined) return target
    return reduced(target) ? `${kind}R` : kind
}

function repKey(rep: Rep, target: (target: string) => string): string {
    const nullable = rep.nullable ? '?' : ''
    const targets = rep.targets.map(target).join('|')
    switch (rep.kind) {
        case 'number': return `${rep.number}${nullable}`
        case 'pointer': return rep.constant ? rep.text : `ptr<${targets}>${nullable}`
        case 'union': return `union<${targets}>`
        case 'buffer': return `buf<${rep.element!.encoded ? `enc<${repKey(rep.element!, target)}>` : repKey(rep.element!, target)}>${nullable}`
        case 'any': return rep.text
        default: return rep.kind
    }
}

export function shareUnits(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => string, reduced: (target: string) => boolean, sites: Map<PlannedUnit, Map<number, string>>, graphOf: (fn: Function) => Graph): Map<PlannedUnit, PlannedUnit> {
    const byNode = <T>(map: Map<number, T>, show: (value: T) => string) => [...map].sort((a, b) => a[0] - b[0]).map(([node, value]) => `%${node}:${show(value)}`).join(' ')
    const units = [...plan.values()].flat()
    const intern = (keyOf: (unit: PlannedUnit) => string): [Map<PlannedUnit, number>, number] => {
        const ids = new Map<string, number>()
        const out = new Map<PlannedUnit, number>()
        for (const unit of units) {
            const k = keyOf(unit)
            let id = ids.get(k)
            if (id === undefined) ids.set(k, id = ids.size)
            out.set(unit, id)
        }
        return [out, ids.size]
    }
    const parts = (unit: PlannedUnit) => {
        const g = graphOf(unit.fn)
        const { words: moved, elements } = movesOf(g)
        const view = (rep: Rep) => `${repKey(rep, target => shapeTarget(target) ? layoutOf(target, elements) : target)}${rep.fresh ? '!' : ''}`
        const value = (rep: Rep) => rep.kind === 'number' ? rep.number! : view(rep)
        const node = (rep: Rep) => rep.kind === 'pointer' && rep.targets.length === 1 && rep.targets[0] === 'buf' ? 'int' : value(rep)
        const returns = unit.returns.kind === 'pointer' && unit.returns.fresh && unit.returns.targets.length === 1 && shapeTarget(unit.returns.targets[0]) && (!unit.returns.nullable || rawCandidate(g)) ? view(unit.returns) : unit.returns.number === 'f64' ? 'f64' : 'word'
        const opaque = (rep: Rep, param: boolean) => movedClass(rep, param, reduced)
        const entry = g.blocks[0].params
        const keyed = (id: number) => !moved.has(id) || getNode(g, id)!.op !== NodeOp.load
        return [
            unitIdentity(unit.fn), unit.boxes, [...unit.boxedCalls].sort((a, b) => a - b).join(','), unit.returnsSelf,
            `${unit.params.map((p, i) => `${p.label}:${moved.has(entry[i]) ? opaque(p.rep, true) : value(p.rep)}`).join(',')}->${returns}`,
            byNode(unit.allocations, shape => layoutOf(shape, elements)), byNode(sites.get(unit) ?? new Map<number, string>(), k => k),
            [...unit.blocks].sort((a, b) => a - b).join(','), byNode(unit.deadArms, arms => arms.join(',')), byNode(new Map([...unit.nodes].filter(([id]) => keyed(id)).map(([id, rep]) => [id, moved.has(id) ? opaque(rep, entry.includes(id)) : node(rep)])), x => x),
        ]
    }
    let [classes, count] = intern(unit => parts(unit).join('|'))
    while (true) {
        const [next, size] = intern(unit => `${classes.get(unit)}|${byNode(unit.calls, set => [...new Set([...set].map(c => classes.get(c)))].sort().join(','))}`)
        classes = next
        if (size === count) break
        count = size
    }
    const shared = new Map<PlannedUnit, PlannedUnit>()
    const kept = new Map<number, PlannedUnit>()
    for (const [fn, list] of plan) plan.set(fn, list.filter(unit => {
        const first = kept.get(classes.get(unit)!)
        if (!first) {
            kept.set(classes.get(unit)!, unit)
            return true
        }
        first.frames.push(...unit.frames)
        shared.set(unit, first)
        return false
    }))
    for (const unit of units) for (const [node, set] of unit.calls) unit.calls.set(node, new Set([...set].map(c => shared.get(c) ?? c)))
    for (const unit of shared.keys()) sites.delete(unit)
    if (intrinsics.argv().includes('share-debug')) for (const list of plan.values()) for (const unit of list) console.log('SHARE-PARTS', unit.fn.name, list.indexOf(unit), JSON.stringify(parts(unit).map(String)))
    return shared
}

const identities = new WeakMap<Function, number>()
let nextIdentity = 0
function unitIdentity(fn: Function): number {
    let id = identities.get(fn)
    if (id === undefined) identities.set(fn, id = nextIdentity++)
    return id
}

interface Lin {
    sym: string
    k: number
}

interface Bound {
    lo?: number
    loStrict?: boolean
    hi?: number
    hiStrict?: boolean
}

interface SymbolicFrame {
    id: number
    g: Graph
    unit: Function
    param(index: number): Lin | undefined
    entry(obj: Lin, key: string): Lin | undefined
    facts: Map<string, Bound>
    depth: number
    constructing: boolean
    values: Map<number, Lin | null>
    fields: Map<string, Lin | null>
    children: Map<number, SymbolicFrame | null>
    loops: Map<string, 'pending' | 'stable' | 'written'>
}

const maxSymbolicDepth = 8

function sameLin(a: Lin | undefined, b: Lin | undefined): boolean {
    return !!a && !!b && a.sym === b.sym && a.k === b.k
}

function constrain(facts: Map<string, Bound>, a: Lin, b: Lin, rel: '<' | '<=' | '=='): boolean {
    let x = a.sym
    let y = b.sym
    let c = b.k - a.k
    if (x === y) return rel === '<' ? 0 < c : rel === '<=' ? 0 <= c : c === 0
    let bound: Bound
    if (x < y) bound = rel === '<' ? { hi: c, hiStrict: true } : rel === '<=' ? { hi: c } : { lo: c, hi: c }
    else {
        ;[x, y] = [y, x]
        bound = rel === '<' ? { lo: -c, loStrict: true } : rel === '<=' ? { lo: -c } : { lo: -c, hi: -c }
    }
    const k = `${x}|${y}`
    const known = facts.get(k) ?? {}
    const merged: Bound = { ...known }
    if (bound.lo !== undefined && (merged.lo === undefined || bound.lo > merged.lo || (bound.lo === merged.lo && bound.loStrict))) {
        merged.lo = bound.lo
        merged.loStrict = bound.loStrict
    }
    if (bound.hi !== undefined && (merged.hi === undefined || bound.hi < merged.hi || (bound.hi === merged.hi && bound.hiStrict))) {
        merged.hi = bound.hi
        merged.hiStrict = bound.hiStrict
    }
    facts.set(k, merged)
    if (merged.lo === undefined || merged.hi === undefined) return true
    return merged.lo < merged.hi || (merged.lo === merged.hi && !merged.loStrict && !merged.hiStrict)
}

function relate(facts: Map<string, Bound>, op: NodeOp, a: Lin, b: Lin, truth: boolean): boolean {
    switch (op) {
        case NodeOp.lt: return truth ? constrain(facts, a, b, '<') : constrain(facts, b, a, '<=')
        case NodeOp.le: return truth ? constrain(facts, a, b, '<=') : constrain(facts, b, a, '<')
        case NodeOp.gt: return truth ? constrain(facts, b, a, '<') : constrain(facts, a, b, '<=')
        case NodeOp.ge: return truth ? constrain(facts, b, a, '<=') : constrain(facts, a, b, '<')
        case NodeOp.eq: return truth ? constrain(facts, a, b, '==') : true
        case NodeOp.ne: return truth ? true : constrain(facts, a, b, '==')
    }
    return true
}

export function proveInvariants(methods: [string, Function][], ctor: Function, data: Accesses, host: AccessHost, candidates: string[], nodes: Map<Function, Map<number, number[]>>): [string, string][] {
    const proven: [string, string][] = []
    for (let i = 0; i < candidates.length; i++) {
        for (let j = i + 1; j < candidates.length; j++) if (holds(candidates[i], candidates[j])) proven.push([candidates[i], candidates[j]])
    }
    return proven

    function holds(a: string, b: string): boolean {
        let frameIds = 0
        const fresh = new Map<string, Handle>()
        function pathOf(obj: Lin): string {
            return obj.sym.slice(obj.sym.lastIndexOf(':') + 1)
        }
        const registry = new Map<number, SymbolicFrame>()
        const joins = new Map<string, boolean | 'pending'>()
        function canon(l: Lin): Lin {
            const at = l.sym.lastIndexOf(':')
            const path = l.sym.slice(at + 1)
            if (path !== `self.${b}`) return l
            const prefix = l.sym.slice(0, at)
            if (prefix.startsWith('J') && !joinHolds(prefix)) return l
            return { sym: `${l.sym.slice(0, at + 1)}self.${a}`, k: l.k }
        }
        function joinHolds(prefix: string): boolean {
            const known = joins.get(prefix)
            if (known !== undefined) return known !== false
            joins.set(prefix, 'pending')
            const [, frameId, kind, at] = /^J(\d+)\.([BR])(\d+)$/.exec(prefix)!
            const frame = registry.get(Number(frameId))!
            const agree = (f: SymbolicFrame, point: number) => {
                const x = resolve(f, point, a)
                const y = resolve(f, point, b)
                return !!x && !!y && sameLin(canon(x), canon(y))
            }
            let holds = true
            if (kind === 'B') {
                const block = frame.g.blocks.find(t => t.id === Number(at))!
                holds = predsOf(frame.g, block).every(p => refuted(frame, p) || agree(frame, p))
            } else {
                const callee = frame.children.get(Number(at))!
                holds = retsOf(callee.g).every(r => refuted(callee, r) || agree(callee, r))
            }
            joins.set(prefix, holds)
            return holds
        }
        function join(frame: SymbolicFrame, kind: string, at: number, obj: Lin, key: string): Lin {
            return { sym: `J${frame.id}.${kind}${at}:${pathOf(obj)}.${key}`, k: 0 }
        }
        function functionsAt(unit: Function, id: number): Function[] | undefined {
            const values = nodes.get(unit)?.get(id)
            if (!values) return
            const fns: Function[] = []
            for (const v of values) {
                const value = data.values[v]
                if (value.kind === ValueKind.function && value.fn) fns.push(value.fn)
                else return
            }
            return fns
        }
        function trapAt(unit: Function, id: number, setter: boolean): Function | undefined {
            for (const v of nodes.get(unit)?.get(id) ?? []) {
                const allocation = data.values[v].allocation
                const proto = allocation !== undefined ? data.allocations[allocation].proto : undefined
                const proxy = proto ? heap.getPropertyProxy(proto, heap.indexKey(0 as u32)) : 0
                if (proxy) return host.functionOf((setter ? heap.getProxySetter(proxy) : heap.getProxyGetter(proxy)) as u32)
            }
        }
        function top(fn: Function, constructing: boolean): SymbolicFrame {
            const g = host.graphOf(fn)
            const self = g.blocks[0].params.find(p => isThisParam(getNode(g, p)!))
            return register({
                id: frameIds++, g, unit: fn, depth: 0, facts: new Map(), constructing,
                param: index => g.blocks[0].params[index] === self ? { sym: 'self', k: 0 } : { sym: `p${index}`, k: 0 },
                entry: (obj, key) => {
                    if (constructing && obj.sym === 'self') return { sym: 'undef', k: 0 }
                    const state = fresh.get(obj.sym)
                    if (state !== undefined) {
                        const addr = heap.getOwnProperty(state, heap.fromJsString(key))
                        const slot = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).slot0 as Handle : 0 as Handle
                        return heap.isBoxedF64(slot) ? { sym: '', k: heap.unboxF64(slot) } : { sym: 'undef', k: 0 }
                    }
                    return obj.k === 0 && /(^|:)self(\.|$)/.test(obj.sym) ? { sym: `${obj.sym}.${key}`, k: 0 } : undefined
                },
                values: new Map(), fields: new Map(), children: new Map(), loops: new Map(),
            })
        }
        function register(frame: SymbolicFrame): SymbolicFrame {
            registry.set(frame.id, frame)
            return frame
        }
        function child(frame: SymbolicFrame, id: number, fn: Function, receiverSlot: number, first: number): SymbolicFrame | undefined {
            if (frame.depth >= maxSymbolicDepth || !host.traceable(fn)) return
            const g = host.graphOf(fn)
            const n = getNode(frame.g, id)!
            const self = g.blocks[0].params.find(p => isThisParam(getNode(g, p)!))
            const plain = g.blocks[0].params.filter(p => p !== self)
            const facts = factsAt(frame, id)
            if (!facts) return
            return register({
                id: frameIds++, g, unit: fn, depth: frame.depth + 1, facts, constructing: frame.constructing,
                param: index => {
                    const p = g.blocks[0].params[index]
                    const slot = p === self ? receiverSlot : first + plain.indexOf(p)
                    return slot >= 0 && slot < countIds(n) ? operand(frame, n, slot) : undefined
                },
                entry: (obj, key) => walk(frame, getRef(n, 0), obj, key),
                values: new Map(), fields: new Map(), children: new Map(), loops: new Map(),
            })
        }
        function calleeOf(frame: SymbolicFrame, id: number): SymbolicFrame | null | undefined {
            if (frame.children.has(id)) return frame.children.get(id)
            const n = getNode(frame.g, id)!
            let found: SymbolicFrame | undefined
            if (n.op === NodeOp.call && getNode(frame.g, getRef(n, 1))?.op !== NodeOp.syscallTarget) {
                const fns = functionsAt(frame.unit, getRef(n, 1))
                if (fns?.length === 1) found = child(frame, id, fns[0], 2, 3)
            } else if (n.op === NodeOp.rt) {
                const impl = rt.bindingOf(getLiteral(frame.g, n, 1))?.impl
                if (impl) found = child(frame, id, impl, -1, 2)
            } else if ((n.op === NodeOp.setProp || n.op === NodeOp.getProp) && getRef(n, 2)) {
                const trap = trapAt(frame.unit, getRef(n, 1), n.op === NodeOp.setProp)
                if (trap) found = child(frame, id, trap, 1, 2)
            }
            frame.children.set(id, found ?? null)
            return found ?? null
        }
        function opaqueCall(frame: SymbolicFrame, n: GraphNode): boolean {
            if (n.op === NodeOp.call) return getNode(frame.g, getRef(n, 1))?.op !== NodeOp.syscallTarget
            if (n.op === NodeOp.rt) return !!rt.bindingOf(getLiteral(frame.g, n, 1))?.impl
            return false
        }
        function operand(frame: SymbolicFrame, n: GraphNode, i: number): Lin | undefined {
            if (!getRef(n, i)) return { sym: '', k: getLiteral(frame.g, n, i) }
            return value(frame, getRef(n, i))
        }
        function value(frame: SymbolicFrame, id: number): Lin | undefined {
            if (frame.values.has(id)) return frame.values.get(id) ?? undefined
            frame.values.set(id, null)
            const result = computeValue(frame, id)
            frame.values.set(id, result ?? null)
            return result
        }
        function opaque(frame: SymbolicFrame, id: number): Lin {
            return { sym: `${frame.id}%${id}`, k: 0 }
        }
        function computeValue(frame: SymbolicFrame, id: number): Lin | undefined {
            const g = frame.g
            const n = getNode(g, id)
            if (!n) return
            switch (n.op) {
                case NodeOp.literal: return { sym: '', k: getLiteral(g, n, 0) }
                case NodeOp.heapHandle:
                    if (getRef(n, 0)) return opaque(frame, id)
                    if (countIds(n) > 1) {
                        const sym = `f${frame.id}:${id}`
                        fresh.set(sym, getLiteral(g, n, 1) as Handle)
                        return { sym, k: 0 }
                    }
                    return getLiteral(g, n, 0) ? { sym: `h${getLiteral(g, n, 0)}`, k: 0 } : { sym: 'undef', k: 0 }
                case NodeOp.param: {
                    const index = g.blocks[0].params.indexOf(id)
                    if (index >= 0) return frame.param(index)
                    const block = g.blocks.find(b => b.params.includes(id))
                    return block ? blockParam(frame, block, block.params.indexOf(id)) : undefined
                }
                case NodeOp.add:
                case NodeOp.sub: {
                    const x = operand(frame, n, 0)
                    const y = operand(frame, n, 1)
                    if (x && y && y.sym === '') return { sym: x.sym, k: n.op === NodeOp.add ? x.k + y.k : x.k - y.k }
                    if (x && y && x.sym === '' && n.op === NodeOp.add) return { sym: y.sym, k: x.k + y.k }
                    return opaque(frame, id)
                }
                case NodeOp.getProp: {
                    if (getRef(n, 2)) return opaque(frame, id)
                    const obj = operand(frame, n, 1)
                    return obj && walk(frame, getRef(n, 0), obj, keyLabel(getLiteral(g, n, 2) as Handle)) || opaque(frame, id)
                }
                case NodeOp.call: {
                    const callee = calleeOf(frame, id)
                    if (!callee) return opaque(frame, id)
                    let result: Lin | undefined
                    for (const ret of retsOf(callee.g)) {
                        if (refuted(callee, ret)) continue
                        const r = getNode(callee.g, ret)!
                        const v = operand(callee, r, 0)
                        if (!v || (result && !sameLin(result, v))) return opaque(frame, id)
                        result = v
                    }
                    return result ?? opaque(frame, id)
                }
                case NodeOp.after: return operand(frame, n, countIds(n) - 1)
                case NodeOp.mem: return operand(frame, n, 0)
            }
            return opaque(frame, id)
        }
        function before(frame: SymbolicFrame, id: number, obj: Lin, key: string): Lin | undefined {
            const n = getNode(frame.g, id)!
            if (n.op === NodeOp.ret || n.op === NodeOp.apply) {
                const wrapper = n.op === NodeOp.apply ? afterOf(frame.g, id) : getRef(n, 0) ? id : 0
                const start = n.op === NodeOp.apply ? wrapper : getRef(n, 0)
                if (start) {
                    const m = getNode(frame.g, start)!
                    if (m.op === NodeOp.after) return orderings(frame, m, obj, key)
                    if (effect(m.op)) return walk(frame, start, obj, key)
                }
                const block = blockOf(frame.g, id)
                return block ? blockEntry(frame, block, obj, key) : undefined
            }
            return walk(frame, getRef(n, 0), obj, key)
        }
        function orderings(frame: SymbolicFrame, n: GraphNode, obj: Lin, key: string): Lin | undefined {
            let result: Lin | undefined
            for (let i = 0; i < countIds(n) - 1; i++) {
                if (!getRef(n, i)) continue
                const v = walk(frame, getRef(n, i), obj, key)
                if (!v || (result && !sameLin(result, v))) return
                result = v
            }
            return result
        }
        function walk(frame: SymbolicFrame, id: number, obj: Lin, key: string): Lin | undefined {
            const memo = `${id}|${obj.sym}|${obj.k}|${key}`
            if (frame.fields.has(memo)) return frame.fields.get(memo) ?? undefined
            frame.fields.set(memo, null)
            const result = computeWalk(frame, id, obj, key)
            frame.fields.set(memo, result ?? null)
            return result
        }
        function computeWalk(frame: SymbolicFrame, id: number, obj: Lin, key: string): Lin | undefined {
            const g = frame.g
            let at = id
            for (;;) {
                const n = getNode(g, at)
                if (!n) return
                switch (n.op) {
                    case NodeOp.nilEffect: {
                        const block = g.blocks.find(b => b.id === getRef(n, 0))
                        return block ? blockEntry(frame, block, obj, key) : undefined
                    }
                    case NodeOp.setProp:
                        if (!getRef(n, 2)) {
                            if (keyLabel(getLiteral(g, n, 2) as Handle) === key && sameLin(operand(frame, n, 1), obj)) return operand(frame, n, 3)
                            break
                        }
                        return calleeField(frame, at, obj, key)
                    case NodeOp.call:
                    case NodeOp.rt:
                        if (calleeOf(frame, at) || opaqueCall(frame, n)) return calleeField(frame, at, obj, key)
                        break
                    case NodeOp.getProp:
                    case NodeOp.load:
                    case NodeOp.store:
                    case NodeOp.pstack:
                        break
                    case NodeOp.after:
                        return orderings(frame, n, obj, key)
                    default:
                        return
                }
                at = getRef(n, 0)
            }
        }
        function calleeField(frame: SymbolicFrame, id: number, obj: Lin, key: string): Lin | undefined {
            const callee = calleeOf(frame, id)
            const n = getNode(frame.g, id)!
            if (!callee) {
                if (n.op === NodeOp.setProp) return
                const reaches = !frame.constructing || Array.from({ length: countIds(n) - 1 }, (_, i) => operand(frame, n, i + 1)).some(arg => !!arg && /(^|:)self(\.|$)/.test(arg.sym))
                return reaches && /(^|:)self(\.|$)/.test(obj.sym) ? { sym: `c${frame.id}.${id}:${pathOf(obj)}.${key}`, k: 0 } : walk(frame, getRef(n, 0), obj, key)
            }
            let result: Lin | undefined
            let differs = false
            for (const ret of retsOf(callee.g)) {
                if (refuted(callee, ret)) continue
                const v = before(callee, ret, obj, key)
                if (!v) return
                if (result && !sameLin(canon(result), canon(v))) differs = true
                result = v
            }
            return differs ? join(frame, 'R', id, obj, key) : result
        }
        function blockEntry(frame: SymbolicFrame, block: Block, obj: Lin, key: string): Lin | undefined {
            if (block === frame.g.blocks[0]) return frame.entry(obj, key)
            const preds = predsOf(frame.g, block)
            const edges = backEdges(frame.g)
            let forward: Lin | undefined
            let differs = false
            for (const p of preds) {
                if (edges.has(p) || refuted(frame, p)) continue
                const v = before(frame, p, obj, key)
                if (!v) return
                if (forward && !sameLin(canon(forward), canon(v))) differs = true
                forward = v
            }
            const joined = join(frame, 'B', block.id, obj, key)
            if (differs || !forward) return joined
            const back = preds.filter(p => edges.has(p))
            if (!back.length) return forward
            const memo = `${block.id}|${obj.sym}|${obj.k}|${key}`
            const state = frame.loops.get(memo)
            if (state === 'pending') return forward
            if (state !== undefined) return state === 'stable' ? forward : joined
            frame.loops.set(memo, 'pending')
            const fields = new Map(frame.fields)
            const values = new Map(frame.values)
            const stable = back.every(p => {
                if (refuted(frame, p)) return true
                const v = before(frame, p, obj, key)
                return !!v && sameLin(canon(v), canon(forward!))
            })
            frame.loops.set(memo, stable ? 'stable' : 'written')
            if (!stable) {
                frame.fields = fields
                frame.values = values
            }
            return stable ? forward : joined
        }
        function blockParam(frame: SymbolicFrame, block: Block, index: number): Lin | undefined {
            const preds = predsOf(frame.g, block)
            const fresh = { sym: `P${frame.id}.${block.id}.${index}`, k: 0 }
            if (preds.some(p => backEdges(frame.g).has(p))) return fresh
            let result: Lin | undefined
            for (const p of preds) {
                if (refuted(frame, p)) continue
                const v = operand(frame, getNode(frame.g, p)!, index + 1)
                if (!v) return
                if (result && !sameLin(result, v)) return fresh
                result = v
            }
            return result
        }
        function factsAt(frame: SymbolicFrame, id: number): Map<string, Bound> | undefined {
            const facts = new Map(frame.facts)
            for (const [cond, positive] of guardsOf(frame.g).get(id) ?? []) {
                const c = getNode(frame.g, cond)!
                const x = operand(frame, c, 0)
                const y = operand(frame, c, 1)
                if (!x || !y) continue
                if (!relate(facts, c.op, canon(x), canon(y), positive)) return
            }
            return facts
        }
        function refuted(frame: SymbolicFrame, id: number): boolean {
            return !factsAt(frame, id)
        }
        function resolve(frame: SymbolicFrame, at: number, path: string): Lin | undefined {
            let obj: Lin | undefined = { sym: 'self', k: 0 }
            for (const key of path.split('.')) {
                if (!obj) return
                obj = before(frame, at, obj, key)
            }
            return obj
        }
        for (const [, fn] of methods) {
            const frame = top(fn, fn === ctor)
            const g = frame.g
            const escapes = (n: GraphNode) => !frame.constructing || Array.from({ length: countIds(n) - 1 }, (_, i) => operand(frame, n, i + 1)).some(arg => !!arg && /(^|:)self(\.|$)/.test(arg.sym))
            const points = [...retsOf(g), ...[...g.nodes].filter(([id, n]) => opaqueCall(frame, n) && !calleeOf(frame, id) && escapes(n)).map(([id]) => id)]
            for (const at of points) {
                const x = resolve(frame, at, a)
                const y = resolve(frame, at, b)
                if (x && y && sameLin(canon(x), canon(y))) continue
                if (intrinsics.argv().includes('invariant-debug')) console.log('INVARIANT-FAIL', a, b, fn.name, `%${at}`, JSON.stringify(x), JSON.stringify(y))
                return false
            }
        }
        return true
    }
}

const regionMaps = new WeakMap<Graph, Map<number, number>>()
export function regionRets(g: Graph): Map<number, number> {
    let known = regionMaps.get(g)
    if (known) return known
    known = new Map()
    const blocks = new Map(g.blocks.map(b => [b.id, b]))
    for (const [root, n] of g.nodes) {
        if (n.op !== NodeOp.inlined) continue
        const seen = new Set<number>()
        const stack = [getRef(n, 0)]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const m = getNode(g, id)
            if (!m) continue
            if (m.op === NodeOp.ret) known.set(id, root)
            else if (m.op === NodeOp.select) for (let i = 1; i < countIds(m); i++) stack.push(getRef(m, i))
            else if (m.op === NodeOp.after) stack.push(getRef(m, countIds(m) - 1))
            else if (m.op === NodeOp.apply) stack.push(blocks.get(getRef(m, 0))?.bodyId ?? 0)
        }
    }
    regionMaps.set(g, known)
    return known
}

type Block = Graph['blocks'][number]

function effect(op: NodeOp): boolean {
    return op === NodeOp.setProp || op === NodeOp.getProp || op === NodeOp.call || op === NodeOp.rt || op === NodeOp.store || op === NodeOp.load
}

const retLists = new WeakMap<Graph, number[]>()
function retsOf(g: Graph): number[] {
    let known = retLists.get(g)
    if (!known) retLists.set(g, known = [...g.nodes].filter(([, n]) => n.op === NodeOp.ret).map(([id]) => id))
    return known
}

function afterOf(g: Graph, id: number): number {
    for (const [user] of usersOf(g).get(id) ?? []) {
        const n = getNode(g, user)!
        if (n.op === NodeOp.after && getRef(n, countIds(n) - 1) === id) return user
    }
    return 0
}

const addressKey = heap.fromJsString('__address')
function addressView(object: ObjectType): boolean {
    return object.state !== undefined && heap.ownPropertyCount(object.state) === 1 && !!heap.getOwnProperty(object.state, addressKey)
}

const cellSiteMaps = new WeakMap<Graph, Map<Handle, number>>()
function cellSites(g: Graph): Map<Handle, number> {
    let known = cellSiteMaps.get(g)
    if (known) return known
    known = new Map()
    for (const [id, n] of g.nodes) if (n.op === NodeOp.heapHandle && !getRef(n, 0) && !known.has(getLiteral(g, n, 0) as Handle)) known.set(getLiteral(g, n, 0) as Handle, id)
    cellSiteMaps.set(g, known)
    return known
}

function blockOf(g: Graph, id: number): Block | undefined {
    const n = getNode(g, id)
    if (n?.op === NodeOp.ret) {
        const owner = g.blocks.find(b => b.id === getRef(n, 1))
        if (owner) return owner
    }
    return g.blocks.find(b => bodyNodes(g, b.bodyId).has(id))
}

function predsOf(g: Graph, block: Block): number[] {
    return (usersOf(g).get(block.id) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
}

const backEdgeSets = new WeakMap<Graph, Set<number>>()
function backEdges(g: Graph): Set<number> {
    const known = backEdgeSets.get(g)
    if (known) return known
    const found = new Set<number>()
    const visited = new Set<number>()
    const onStack = new Set<number>()
    function visit(block: Block): void {
        visited.add(block.id)
        onStack.add(block.id)
        for (const id of bodyNodes(g, block.bodyId)) {
            const n = getNode(g, id)
            if (n?.op !== NodeOp.apply) continue
            const target = g.blocks.find(t => t.id === getRef(n, 0))
            if (!target) continue
            if (onStack.has(target.id)) found.add(id)
            else if (!visited.has(target.id)) visit(target)
        }
        onStack.delete(block.id)
    }
    visit(g.blocks[0])
    backEdgeSets.set(g, found)
    return found
}
const UnsignedOps = new Set([NodeOp.add, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.ushr, NodeOp.shr, NodeOp.div, NodeOp.rem])
const UnsignedTypes = new Set([Types.u8, Types.u16, Types.u32, Types.u64, Types.usize, Types.bool])
