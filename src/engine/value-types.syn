type Handle = intrinsics.Handle

export interface Site {
    unit: Function
    node: number
    frame?: number
}

export interface Allocation {
    site: Site
    frames: number[]
    name: string
    state?: Handle
    handle?: Handle
    depth: number
    proto: Handle | undefined
    constant: boolean
    escaped: boolean
    native?: boolean
    dynamic?: boolean
    copied?: boolean
}

export interface Location {
    allocation: number
    key: string
    values: number[]
    forms: string[]
    readers: Site[]
    writers: Site[]
