}

export enum ValueKind {
    undefined,
    number,
    string,
    unknown,
    object,
    function,
    variable,
}

export enum NumberForm {
    literal,
    range,
    float,
}

export type Interval = [lo: number, hi: number]

export interface Value {
    kind: ValueKind
    allocation?: number
    fn?: Function
    form?: NumberForm
    literal?: number
    range?: Interval
    word?: boolean
    site?: Site
    param?: number
    narrow?: string
    base?: number
}

interface FrameInfo {
    unit: Function
    context: string
    receiver?: number
