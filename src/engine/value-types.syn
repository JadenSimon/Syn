    return { keyOf, keyText, table, shapes, constantShapes, addressed, repOf: type => repOf(type), elementOf, bufferGroups: groupBuffers, bufferGroup, collapses, joinBuffers, layOut, shapeOf: id => types.objects[id].dynamic || types.objects[id].kind === AllocKind.buffer || (ownerOf[id] !== undefined && !genericFor(id)) ? undefined : shapeId(keyOf(id)) }
}
export interface PlannedParam {
    label: string
    rep: Rep
    receiver?: boolean
}

interface PlannedSignature {
    params: PlannedParam[]
    returns: Rep
    made: number[]
}

export interface PlannedUnit {
    fn: Function
    codecs: Map<number, SlotCodec>
    allocations: Map<number, string | undefined>
    instances: number[]
    params: PlannedParam[]
    returns: Rep
    returnsSelf: boolean
    nodes: Map<number, Rep>
    slices: Map<number, Rep>
    blocks: Set<number>
    deadArms: Map<number, number[]>
    nullishTests: Map<number, Handle[]>
    calls: Map<number, Set<PlannedUnit>>
    reads: Map<number, number>
    equalReads: Map<number, number>
    coercions: Map<number, number>
    receivers: Map<number, Rep>
    observed: Set<number>
    returned: Map<number, Rep>
}

function instancesOf(object: Allocation): number[] {
    if (object.instances) return object.instances
    return object.instance === undefined ? [] : [object.instance]
}

function functionObject(types: ValueTypes, id: number): boolean {
    return types.objects[id].function !== undefined
}

function singleValued(types: ValueTypes, type: Type): boolean {
    if (type.unknown || opaqueNumber(type) || type.closures.some(id => !functionObject(types, id)) || type.strings.includes(0)) return false
    const bools = type.bools === 3 ? 2 : type.bools ? 1 : 0
    return (type.undefined ? 1 : 0) + (type.null ? 1 : 0) + bools + type.literals.length + type.functions.length + type.objects.length + type.strings.length === 1
}

function functionRep(types: ValueTypes, inst: Instantiations, type: Type): Rep | undefined {
    if (!singleValued(types, type) || !type.functions.length) return
    return { ...inst.repOf(type), constant: { fn: type.functions[0] } }
}

function valueRep(types: ValueTypes, inst: Instantiations, type: Type, oneObject: (state: Handle) => boolean): Rep | undefined {
    if (!singleValued(types, type)) return
    const rep = inst.repOf(type)
    if (type.strings.length) return { ...rep, constant: { handle: type.strings[0] as Handle } }
    if (type.bools) return { ...rep, constant: { literal: type.bools === 2 ? 1 : 0 } }
    const literal = type.literals[0]
    if (literal !== undefined && !Number.isNaN(literal)) return { ...rep, constant: { literal } }
    const object = type.objects.length ? types.objects[type.objects[0]] : undefined
    if (object?.constant && object.handle && oneObject(object.state!)) return { ...rep, constant: { handle: object.handle } }
}

export function planUnits(types: ValueTypes, genericOf: (proto: Handle) => Generic | undefined, oneObject: (state: Handle) => boolean, graphOf: (fn: Function) => Graph, keepsReturn: (fn: Function) => boolean, memberFacts: MemberFacts): { inst: Instantiations, plan: Map<Function, PlannedUnit[]>, codecOf: (allocation: number, key: string) => SlotCodec } {
    const callSiteIds = createInterner()
    const callSites: CallSite[] = []
    const outgoing = types.instances.map(() => [] as [node: number, callee: number][])
    types.instances.forEach((instance, id) => {
        for (const site of instance.sites) {
            if (site.instance === undefined) continue
            outgoing[site.instance].push([site.node, id])
            const at = intern(callSiteIds, [site.instance, site.node])
            if (at === callSites.length) callSites.push({ caller: site.instance, node: site.node, callees: [] })
            callSites[at].callees.push(id)
        }
    })
    const find = congruence(types, callSites)
    const congruent = new Map<number, number[]>()
    types.instances.forEach((_, id) => {
        const root = find(id)
        listOf(congruent, root).push(id)
    })
    const joins: number[][] = []
    const bySite = new Map<string, number[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native) return
        for (const instance of instancesOf(object)) {
            const k = `${find(instance)}|${object.site.node}`
            const list = bySite.get(k)
            if (!list) bySite.set(k, [id])
            else if (!list.includes(id)) list.push(id)
        }
    })
    for (const list of bySite.values()) if (list.length > 1) joins.push(list)
    for (const instance of types.instances) joins.push(...instance.merges)
    const indirect = indirectCallees(types, callSites, graphOf)
    for (const list of indirect) {
        const width = Math.max(...list.map(f => types.instances[f].params.length))
        for (let i = 0; i < width; i++) joins.push(list.flatMap(f => types.instances[f].params[i]?.type.objects ?? []))
    }
    for (const members of congruent.values()) {
        if (members.length < 2) continue
        types.instances[members[0]].params.forEach((_, i) => joins.push(members.flatMap(f => types.instances[f].params[i].type.objects)))
        joins.push(members.flatMap(f => types.instances[f].returns.objects))
    }
    const storage = planStorage(types, congruent, graphOf)
    fillInstanceArgs(types, genericOf, storage.copiedType)
    const inst = instantiate(types, genericOf, joins, storage.fieldType, storage.copiedType)
    const madeIds = createInterner()
    const created = new Map<number, number[]>()
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = inst.shapeOf(id)
        if (shape === undefined && !object.dynamic) return
        for (const instance of instancesOf(object)) {
            let list = created.get(find(instance))
            if (!list) created.set(find(instance), list = [])
            list.push(intern(madeIds, [object.site.node, shape]))
        }
    })
    const signatureOf = (params: { label: string, type: Type, receiver?: boolean }[], returns: Type, allocations: number[] = [], returned = inst.repOf(returns)): PlannedSignature => {
        const reps = params.map(param => ({ label: param.label, receiver: param.receiver, rep: functionRep(types, inst, param.type) ?? inst.repOf(param.type) }))
        return { params: reps, returns: returned, made: [...new Set(allocations)].sort((a, b) => a - b) }
    }
    const sameSignature = (a: PlannedSignature, b: PlannedSignature) => {
        if (a.params.length !== b.params.length || a.made.length !== b.made.length || !sameRep(a.returns, b.returns, true)) return false
        if (a.made.some((made, i) => made !== b.made[i])) return false
        return a.params.every((param, i) => param.label === b.params[i].label && sameRep(param.rep, b.params[i].rep, true))
    }
    const joinedOf = (members: number[]) => {
        const joined = joinedSignature(members.map(f => types.instances[f]), unionAll)
        return signatureOf(joined.params, joined.returns, created.get(find(members[0])))
    }
    const reads = memberReads(types, outgoing, graphOf, memberFacts)
    let classOf = new Map<number, number>()
    const classKeys = createInterner()
    const initial = new Map<number, { signature: PlannedSignature, id: number }[]>()
    let classCount = 0
    for (const [root, members] of congruent) {
        const tags = [...new Set(members.flatMap(f => [...storage.instances[f]]))].sort((a, b) => a - b)
        const joined = joinedOf(members)
        const known = listOf(initial, intern(classKeys, [types.instances[root].unit, ...tags, ...reads.atoms(members)]))
        let entry = known.find(other => sameSignature(other.signature, joined))
        if (!entry) known.push(entry = { signature: joined, id: classCount++ })
        classOf.set(root, entry.id)
    }
    const siteIds = createInterner()
    const calleesOf = new Map<number, [site: number, callee: number][]>()
    for (const [root, members] of congruent) {
        const out: [number, number][] = []
        for (const f of members) for (const [node, callee] of outgoing[f]) out.push([intern(siteIds, [node, types.instances[callee].unit]), find(callee)])
        calleesOf.set(root, out)
    }
    const membersOf = new Map<number, number[]>()
    const dependsOn = new Map<number, Set<number>>()
    for (const [root, out] of calleesOf) {
        const c = classOf.get(root)!
        let members = membersOf.get(c)
        if (!members) {
            membersOf.set(c, members = [])
            dependsOn.set(c, new Set())
        }
        members.push(root)
        for (const [, callee] of out) dependsOn.get(c)!.add(classOf.get(callee)!)
    }
    const settled = new Map<number, number>()
    const regroup = (roots: number[], callOf: (callee: number) => number, base: number): number => {
        const groups: Map<number, number>[] = []
        for (const root of roots) {
            const calls = new Map<number, number>()
            for (const [site, callee] of calleesOf.get(root)!) calls.set(site, callOf(callee))
            let group = groups.findIndex(known => [...calls].every(([k, v]) => !known.has(k) || known.get(k) === v))
            if (group < 0) {
                group = groups.length
                groups.push(new Map())
            }
            for (const [k, v] of calls) groups[group].set(k, v)
            settled.set(root, base + group)
        }
        return groups.length
    }
    for (const scc of stronglyConnected(membersOf.keys(), c => [...dependsOn.get(c)!])) {
        const inside = new Set(scc)
        const recursive = scc.length > 1 || dependsOn.get(scc[0])!.has(scc[0])
        let split = false
        for (const c of scc) {
            const count = regroup(membersOf.get(c)!, callee => inside.has(classOf.get(callee)!) ? -1 - classOf.get(callee)! : settled.get(callee)!, c * congruent.size)
            if (count > 1 && recursive) split = true
        }
        while (split) {
            split = false
            const previous = new Map<number, number>()
            for (const c of scc) for (const root of membersOf.get(c)!) previous.set(root, settled.get(root)!)
            for (const c of scc) {
                const byGroup = new Map<number, number[]>()
                for (const root of membersOf.get(c)!) listOf(byGroup, previous.get(root)!).push(root)
                let base = c * congruent.size
                for (const roots of byGroup.values()) {
                    const count = regroup(roots, callee => previous.get(callee) ?? settled.get(callee)!, base)
                    if (count > 1) split = true
                    base += count
                }
            }
        }
    }
    classOf = settled
    const classRoot = new Map<number, number>()
    for (const root of congruent.keys()) if (!classRoot.has(classOf.get(root)!)) classRoot.set(classOf.get(root)!, root)
    const unitRoot = (id: number) => classRoot.get(classOf.get(find(id))!)!
    const plan = new Map<Function, PlannedUnit[]>()
    const unitOfRoot = new Map<number, PlannedUnit>()
    const touchedOf = new Map<PlannedUnit, Map<number, number[]>>()
    const unitOfInstance: PlannedUnit[] = []
    types.instances.forEach((instance, id) => {
        const root = unitRoot(id)
        let unit = unitOfRoot.get(root)
        if (!unit) {
            unitOfRoot.set(root, unit = { fn: instance.unit, codecs: new Map(), allocations: new Map(), instances: [], params: [], returns: { kind: 'never', members: 0, shapes: [], nullable: false }, returnsSelf: false, nodes: new Map(), slices: new Map(), blocks: new Set(), deadArms: new Map(), nullishTests: new Map(), calls: new Map(), reads: new Map(), equalReads: new Map(), coercions: new Map(), receivers: new Map(), observed: new Set(), returned: new Map() })
            const units = listOf(plan, instance.unit)
            units.push(unit)
        }
        unit.instances.push(id)
        unitOfInstance[id] = unit
    })
    const bounded = new Map<PlannedUnit, Map<number, Map<PlannedUnit, [number, number] | undefined>>>()
    types.instances.forEach((instance, id) => {
        for (const site of instance.sites) {
            if (site.instance === undefined) continue
            const caller = unitOfInstance[site.instance]
            const set = setOf(caller.calls, site.node)
            set.add(unitOfInstance[id])
            if (site.operand !== undefined) caller.coercions.set(site.node, (caller.coercions.get(site.node) ?? 0) | (1 << site.operand))
            const arms = mapOf(mapOf(bounded, caller), site.node)
            const known = arms.get(unitOfInstance[id])
            const agrees = !arms.has(unitOfInstance[id]) || (known !== undefined && site.dead !== undefined && known[0] === site.dead[0] && known[1] === site.dead[1])
            arms.set(unitOfInstance[id], agrees ? site.dead : undefined)
        }
    })
    const conventionOf = sharedConventions([...unitOfRoot.values()])
    const truth = { ...inst.repOf({ ...emptyType(), bools: 3 }), tested: true }
    const testedOf = new Map<PlannedUnit, Set<number>>()
    const resolvedOf = new Map<PlannedUnit, Map<number, Type>>()
    for (const unit of unitOfRoot.values()) {
        const resolved = types.resolve(unit.instances)
        for (const [node, type] of resolved.nodes) unit.nodes.set(node, inst.repOf(type))
        for (const [node, type] of resolved.receivers) unit.receivers.set(node, inst.repOf(type))
        for (const target of comparedTargets(graphOf(unit.fn), node => unit.nodes.get(node))) inst.addressed.add(target)
        testedOf.set(unit, truthDemand(graphOf(unit.fn), resolved.nodes, false))
        resolvedOf.set(unit, resolved.nodes)
        touchedOf.set(unit, resolved.slices)
        for (const b of resolved.blocks) unit.blocks.add(b)
        for (const [select, arms] of resolved.selects) {
            const dead = arms.flatMap((x, i) => x ? [] : [i + 1])
            if (dead.length) unit.deadArms.set(select, dead)
        }
        nullishTests(graphOf(unit.fn), resolved.nodes, unit.nullishTests)
        unit.reads = reads.folds(unit.fn, resolved.nodes, unit.calls)
    }
    const returnedOf = new Map<PlannedUnit, Set<number>>()
    const returnedIn = (unit: PlannedUnit) => {
        let known = returnedOf.get(unit)
        if (!known) returnedOf.set(unit, known = truthDemand(graphOf(unit.fn), resolvedOf.get(unit)!, true))
        return known
    }
    const truthful = new Set(truthReturns(types, [...unitOfRoot.values()], conventionOf, unitOfInstance, caller => testedOf.get(caller)!, returnedIn, keepsReturn))
    for (const unit of truthful) for (const f of unit.instances) for (const site of types.instances[f].sites) unitOfInstance[site.instance!].nodes.set(site.node, truth)
    for (const unit of unitOfRoot.values()) {
        const g = graphOf(unit.fn)
        const tested = truthful.has(unit) ? truthDemand(g, resolvedOf.get(unit)!, true) : testedOf.get(unit)!
        for (const node of tested) if (getNode(g, node)!.op !== NodeOp.call) unit.nodes.set(node, truth)
        const signature = joinedSignature(unit.instances.map(f => types.instances[f]), unionAll)
        const peers = conventionOf.get(unit) ?? [unit]
        const returns = unionAll(peers.flatMap(peer => peer.instances.map(f => types.instances[f].returns)))
        const joined = signatureOf(signature.params, returns, [], truthful.has(unit) ? truth : inst.repOf(returns))
        unit.returnsSelf = peers.length === 1 && unit.instances.every(f => {
            const r = types.instances[f].returns
            return r.objects.length > 0 && !nullableType(r) && !r.strings.length && !r.unknown && !numericType(r) && !r.functions.length && !r.closures.length
        }) && returnsSelf(graphOf(unit.fn))
        unit.params = joined.params
        unit.returns = joined.returns
    }
    for (const caller of unitOfRoot.values()) {
        const g = graphOf(caller.fn)
        const resolved = resolvedOf.get(caller)!
        for (const [node, callees] of caller.calls) {
            if (caller.coercions.has(node)) continue
            if (getNode(g, node)?.op !== NodeOp.call) continue
            const site = caller.nodes.get(node)
            if (!site) continue
            const list = [...callees]
            if (list.some(callee => truthful.has(callee))) continue
            const returnType = unionAll(list.flatMap(callee => (conventionOf.get(callee) ?? [callee]).flatMap(peer => peer.instances.map(f => types.instances[f].returns))))
            const returned = list.every(callee => sameRep(callee.returns, list[0].returns)) ? list[0].returns : inst.repOf(returnType)
            caller.returned.set(node, returned)
            const effective = resolved.get(node)
            if (effective && cutWithin(effective, returnType) && returnProjects(returned, site)) continue
            caller.nodes.set(node, returned)
        }
    }
    for (const units of indirectGroups(indirect.map(list => list.map(f => unitOfInstance[f])))) {
        const width = Math.max(...units.map(unit => unit.params.length))
        for (let i = 0; i < width; i++) {
            const type = unionAll(units.flatMap(unit => unit.instances.flatMap(f => types.instances[f].params[i] ? [types.instances[f].params[i].type] : [])))
            const rep = functionRep(types, inst, type) ?? inst.repOf(type)
            for (const unit of units) if (i < unit.params.length && !unit.params[i].receiver) unit.params[i] = { ...unit.params[i], rep }
        }
    }
    for (const touched of touchedOf.values()) for (const buffers of touched.values()) inst.joinBuffers(buffers)
    for (const buffers of storage.copied) inst.joinBuffers(buffers)
    const conflicted: [PlannedUnit, number][] = []
    types.objects.forEach((object, id) => {
        if (object.constant || object.native || addressView(object)) return
        const shape = inst.shapeOf(id)
        if (shape === undefined && !object.dynamic) return
        for (const instance of instancesOf(object)) {
            const unit = unitOfInstance[instance]
            const known = unit.allocations.get(object.site.node)
            if (unit.allocations.has(object.site.node) && known !== shape) conflicted.push([unit, object.site.node])
            unit.allocations.set(object.site.node, shape)
        }
    })
    for (const [unit, node] of conflicted) unit.allocations.delete(node)
    for (const units of plan.values()) {
        const instances = units.flatMap(unit => unit.instances)
        units[0].params.forEach((_, i) => {
            if (units.some(unit => unit.params[i].rep.constant)) return
            const rep = valueRep(types, inst, unionAll(instances.map(f => types.instances[f].params[i].type)), oneObject)
            if (!rep) return
            for (const unit of units) unit.params[i] = { ...unit.params[i], rep }
        })
    }
    inst.layOut(observeUndefined(types, [...unitOfRoot.values()], touchedOf, graphOf, storage.group, inst))
    for (const [unit, touched] of touchedOf) {
        const words = new Set(unit.instances.flatMap(f => [...storage.instances[f]]))
        for (const [node, buffers] of touched) {
            const element = inst.elementOf(buffers)
            unit.slices.set(node, element)
            unit.codecs.set(node, slotCodec(element, words.has(node)))
            words.delete(node)
        }
        intrinsics.assert(!words.size, `value-types: ${unit.fn.name} tags word accesses %${[...words].join(', %')} that touch no buffer`)
    }
    const forwards = new Map<Function, boolean>()
    const forwarded = (fn: Function) => {
        let known = forwards.get(fn)
        if (known === undefined) forwards.set(fn, known = forwardedField(graphOf(fn)) !== undefined)
        return known
    }
    for (const unit of unitOfRoot.values()) {
        const pure = (node: number) => [...unit.calls.get(node) ?? []].every(callee => forwarded(callee.fn))
        for (const [read, prior] of types.equalReads(unit.instances, pure)) {
            const rep = unit.nodes.get(read)
            const known = unit.nodes.get(prior)
            if (!unit.reads.has(read) && rep && known && sameRep(rep, known)) unit.equalReads.set(read, prior)
        }
    }
    const variants = new Map<PlannedUnit, Map<string, PlannedUnit>>()
    const boundedUnit = (unit: PlannedUnit, select: number, arm: number) => {
        const byArm = mapOf(variants, unit)
        const key = `${select}:${arm}`
        const known = byArm.get(key)
        if (known) return known
        const deadArms = new Map(unit.deadArms)
        deadArms.set(select, [...deadArms.get(select) ?? [], arm].sort((a, b) => a - b))
        const variant: PlannedUnit = {
            ...unit, codecs: new Map(unit.codecs), allocations: new Map(unit.allocations), instances: unit.instances.slice(), params: unit.params.slice(), nodes: new Map(unit.nodes), slices: new Map(unit.slices), blocks: new Set(unit.blocks), deadArms, nullishTests: new Map(unit.nullishTests),
            calls: new Map(), reads: new Map(unit.reads), equalReads: new Map(unit.equalReads), coercions: new Map(unit.coercions), receivers: new Map(unit.receivers), observed: new Set(unit.observed), returned: new Map(unit.returned),
        }
        byArm.set(key, variant)
        listOf(plan, unit.fn).push(variant)
        return variant
    }
    for (const [caller, nodes] of bounded) {
        for (const [node, arms] of nodes) {
            const set = caller.calls.get(node)!
            for (const [callee, dead] of arms) {
                if (!dead || (callee.fn as any).shouldNotInline || callee.deadArms.get(dead[0])?.includes(dead[1])) continue
                set.delete(callee)
                set.add(boundedUnit(callee, dead[0], dead[1]))
            }
        }
    }
    for (const [unit, byArm] of variants) for (const variant of byArm.values()) variant.calls = new Map([...unit.calls].map(([node, callees]) => [node, new Set(callees)]))
    if (intrinsics.argv().includes('member-check')) {
        for (const unit of unitOfRoot.values()) {
            const g = graphOf(unit.fn)
            const nodes = resolvedOf.get(unit)!
            for (const [id, n] of nodeEntries(g)) {
                if (n.op !== NodeOp.getProp || getRef(n, 2) || unit.calls.has(id)) continue
                const object = nodes.get(getRef(n, 1))
                const type = nodes.get(id)
                if (!object || !objectsOnly(object) || !type) continue
                const fixed = constantLiteral(type)
                const folded = unit.reads.get(id)
                const key = keyLabel(getLiteral(g, n, 2) as Handle)
                const where = `${unit.fn.name || '<anon>'} %${id} .${key} of ${object.objects.map(a => `${types.objects[a].name}@${types.objects[a].site.unit.name}%${types.objects[a].site.node}`).join(',')}`
                if (folded !== undefined && inhabited(type) && fixed !== folded) console.log(`MEMBER-WRONG ${where} fold ${folded} but flow ${formatType(types, type)}`)
                let receiver = getNode(g, getRef(n, 1))
                while (receiver?.op === NodeOp.after) receiver = getNode(g, getRef(receiver, countIds(receiver) - 1))
                const direct = receiver?.op === NodeOp.heapHandle && !getRef(receiver, 0) && object.objects.every(a => types.objects[a].constant && types.objects[a].state !== undefined && fixedField(types, types.objects[a].state!, getLiteral(g, n, 2) as Handle))
                if (folded === undefined && fixed !== undefined) console.log(`${reads.dead(unit, id) ? 'MEMBER-DEAD' : direct ? 'MEMBER-STATIC' : 'MEMBER-LOST'} ${where} flow ${fixed}`)
            }
        }
    }
    if (intrinsics.argv().includes('member-reads')) {
        for (const unit of unitOfRoot.values()) {
            const atoms = reads.atoms(unit.instances)
            if (!unit.reads.size && !atoms.length) continue
            const receivers = [...new Set(unit.instances.flatMap(f => types.instances[f].params.find(p => p.receiver)?.type.objects ?? []))]
            console.log(`MEMBER-READS ${unit.fn.name || '<anon>'} this=${receivers.map(id => `${types.objects[id].site.unit.name}%${types.objects[id].site.node}`).join(',')} split=[${atoms.join(' ')}] folds=${[...unit.reads].map(([n, l]) => `%${n}=${l}`).join(' ')}`)
        }
    }
    if (intrinsics.argv().includes('element-debug')) {
        for (const line of storage.lines()) console.log(line)
        for (const unit of unitOfRoot.values()) {
            const nodes = [...new Set(unit.instances.flatMap(f => types.instances[f].accesses.filter(access => !access.field).map(access => access.node)))].sort((a, b) => a - b)
            if (!nodes.length) continue
            console.log(`ELEMENT-UNIT ${unit.fn.name || '<anon>'}${unitSignatureText(unit)} ${nodes.map(node => `%${node}:${unit.codecs.has(node) ? slotCodecText(unit.codecs.get(node)!) : '-'}:${repText(unit.nodes.get(node), '-')}`).join(' ')}`)
        }
    }
    return { inst, plan, codecOf: (allocation, key) => slotCodec(inst.elementOf([allocation]), !!storage.tagged.get(allocation)?.has(key)) }
}

export interface MemberFacts {
    fact(allocation: number, key: string): number | undefined
    summarized(allocation: number): boolean
}

export function constantLiteral(type: Type | undefined): number | undefined {
    if (!type || type.unknown || type.undefined || type.null || type.bools || type.range || type.float) return undefined
    if (type.objects.length || type.functions.length || type.closures.length || type.strings.length || type.literals.length !== 1) return undefined
    const literal = type.literals[0]
    return Number.isSafeInteger(literal) ? literal : undefined
}

interface MemberReads {
    dead(unit: PlannedUnit, id: number): boolean
    atoms(members: number[]): Atom[]
    folds(fn: Function, nodes: Map<number, Type>, calls: Map<number, unknown>): Map<number, number>
}

function objectsOnly(type: Type): boolean {
    return type.objects.length > 0 && !type.unknown && !nullableType(type) && !type.bools && !numericType(type) && !type.strings.length && !type.functions.length && !type.closures.length
}

function memberReads(types: ValueTypes, outgoing: [node: number, callee: number][][], graphOf: (fn: Function) => Graph, members: MemberFacts): MemberReads {
    const readsOf = new Map<Function, number[]>()
    const candidates = (fn: Function): number[] => {
        let list = readsOf.get(fn)
        if (list) return list
        list = []
        for (const [id, n] of nodeEntries(graphOf(fn))) if (n.op === NodeOp.getProp && !getRef(n, 2)) list.push(id)
        readsOf.set(fn, list)
        return list
    }
    const decidingOf = new Map<Function, number[]>()
    const deciding = (fn: Function): number[] => {
        let known = decidingOf.get(fn)
        if (known) return known
        known = []
        decidingOf.set(fn, known)
        const list = candidates(fn)
        if (!list.length) return known
        const g = graphOf(fn)
        const users = usersOf(g)
        for (const read of list) {
            const constant = new Set([read])
            const work = [read]
            let decides = false
            while (work.length && !decides) {
                const id = work.pop()!
                for (const [user, slot] of users.get(id) ?? []) {
                    const n = getNode(g, user)!
                    if (slot < firstNonOrderingSlot(n) || constant.has(user)) continue
                    if (n.op === NodeOp.select && slot === 0) {
                        decides = true
                        break
                    }
                    if (!NumericOps.has(n.op) && n.op !== NodeOp.convert) continue
                    let operands = true
                    for (let i = firstNonOrderingSlot(n); i < countIds(n); i++) if (getRef(n, i) && !constant.has(getRef(n, i))) operands = false
                    if (!operands) continue
                    constant.add(user)
                    work.push(user)
                }
            }
            if (decides) known.push(read)
        }
        return known
    }
    const agreed = (objects: number[], key: string): number | undefined => {
        let literal: number | undefined
        for (const allocation of objects) {
            const fact = members.fact(allocation, key)
            if (fact === undefined || (literal !== undefined && fact !== literal)) return undefined
            literal = fact
        }
        return literal
    }
    const plainField = (objects: number[], key: string): boolean => objects.every(id => {
        const object = types.objects[id]
        return !object.constant && !object.native && !object.dynamic && object.kind === AllocKind.object && object.fields.has(key)
    })
    const regionsOf = new Map<Function, GraphRegions>()
    const deadUnder = (fn: Function, id: number, known: Map<number, number>, deadArms?: Map<number, number[]>): boolean => {
        const g = graphOf(fn)
        let regions = regionsOf.get(fn)
        if (!regions) regionsOf.set(fn, regions = graphRegions(g))
        let r = regions.of.get(id) ?? -1
        let steps = 0
        while (r >= 0) {
            steps++
            intrinsics.assert(steps <= regions.parent.length, `value-types: region walk of ${fn.name} %${id} does not end`)
            if (regions.depth[r] === 0) {
                r = regions.link[r]
                continue
            }
            const select = getNode(g, regions.origin[r])!
            const literal = select.op === NodeOp.select ? known.get(getRef(select, 0)) : undefined
            if (literal !== undefined && (literal !== 0) !== (regions.slot[r] === 1)) return true
            if (deadArms?.get(regions.origin[r])?.includes(regions.slot[r])) return true
            r = regions.parent[r]
        }
        return false
    }
    return {
        dead: (unit, id) => deadUnder(unit.fn, id, unit.reads, unit.deadArms),
        atoms: list => {
            const out: Atom[] = []
            const fn = types.instances[list[0]].unit
            const reads = deciding(fn)
            if (!reads.length) return out
            const g = graphOf(fn)
            const calls = new Set(list.flatMap(f => outgoing[f].map(([node]) => node)))
            const known = new Map<number, number>()
            for (const id of reads) {
                if (calls.has(id)) continue
                const n = getNode(g, id)!
                const objects: number[] = []
                let own = true
                for (const f of list) {
                    const object = types.typeAt(f, getRef(n, 1))
                    if (!object || !inhabited(object)) continue
                    const self = types.instances[f].params.find(param => param.receiver)?.type.objects ?? []
                    if (!objectsOnly(object) || !object.objects.every(allocation => self.includes(allocation))) own = false
                    objects.push(...object.objects)
                }
                const literal = own && objects.length ? agreed(objects, keyLabel(getLiteral(g, n, 2) as Handle)) : undefined
                if (literal !== undefined) known.set(id, literal)
            }
            for (const [id, literal] of known) if (!deadUnder(fn, id, known)) out.push(id, literal)
            return out
        },
        folds: (fn, nodes, calls) => {
            const out = new Map<number, number>()
            const list = candidates(fn)
            if (!list.length) return out
            const g = graphOf(fn)
            for (const id of list) {
                if (calls.has(id)) continue
                const n = getNode(g, id)!
                const object = nodes.get(getRef(n, 1))
                if (!object || !objectsOnly(object)) continue
                const key = keyLabel(getLiteral(g, n, 2) as Handle)
                const summarized = object.objects.filter(allocation => members.summarized(allocation)).length
                const literal = summarized === object.objects.length ? agreed(object.objects, key) : !summarized && plainField(object.objects, key) ? constantLiteral(nodes.get(id)) : undefined
                if (literal !== undefined) out.set(id, literal)
            }
            return out
        },
    }
}

interface StoragePlan {
    tagged: Map<number, Set<string>>
    instances: Set<number>[]
    fieldType(allocation: number, key: string, type: Type): Type
    copiedType(allocation: number, key: string, type: Type): Type
    copied: number[][]
    lines(): string[]
    group(slot: number): number
}

function planStorage(types: ValueTypes, congruent: Map<number, number[]>, graphOf: (fn: Function) => Graph): StoragePlan {
    const slotRoot = types.slots.map((_, i) => i)
    const slotGroup = (a: number) => rootOf(slotRoot, a)
    const joinSlots = (a: number, b: number) => {
        slotRoot[slotGroup(b)] = slotGroup(a)
    }
    const joinKeys = (lists: number[][]) => {
        const byKey = new Map<string, number>()
        for (const slots of lists) for (const slot of slots) {
            joinSlots(slots[0], slot)
            const first = byKey.get(types.slots[slot].key)
            if (first === undefined) byKey.set(types.slots[slot].key, slot)
            else joinSlots(first, slot)
        }
    }
    const copyRoot = types.slots.map((_, i) => i)
    const copyGroup = (a: number) => rootOf(copyRoot, a)
    const joinCopies = (a: number, b: number) => {
        joinSlots(a, b)
        copyRoot[copyGroup(b)] = copyGroup(a)
    }
    const byAllocation = new Map<string, number>()
    types.slots.forEach((slot, i) => {
        const k = `${slot.allocation}:${slot.key}`
        const first = byAllocation.get(k)
        if (first === undefined) byAllocation.set(k, i)
        else joinCopies(first, i)
    })
    const copied: number[][] = []
    const copies = new Map<Function, { reads: Map<number, number[]>, moved: Set<number> }>()
    const copiesOf = (fn: Function) => {
        let known = copies.get(fn)
        if (!known) {
            const reads = copiedWords(graphOf(fn))
            copies.set(fn, known = { reads, moved: new Set([...reads.keys(), ...[...reads.values()].flat()]) })
        }
        return known
    }
    for (const instance of types.instances) {
        const { reads } = copiesOf(instance.unit)
        if (!reads.size) continue
        const byAccess = new Map(instance.accesses.map(access => [access.node, access.slots]))
        for (const [read, stores] of reads) {
            const from = byAccess.get(read)
            for (const store of stores) {
                const into = byAccess.get(store)
                if (!from || !into) continue
                const both = [...from, ...into]
                for (const slot of both) joinCopies(both[0], slot)
                copied.push(both.map(slot => types.slots[slot].allocation))
            }
        }
    }
    const shared: number[][][] = []
    for (const members of congruent.values()) {
        const nodes = new Map<number, number[][]>()
        for (const f of members) {
            const { moved } = copiesOf(types.instances[f].unit)
            for (const access of types.instances[f].accesses) if (!moved.has(access.node) && access.slots.length) listOf(nodes, access.node).push(access.slots)
        }
        for (const lists of nodes.values()) {
            joinKeys(lists)
            if (lists.length) shared.push(lists)
        }
    }
    const groupKinds = new Map<number, number>()
    types.slots.forEach((slot, i) => groupKinds.set(slotGroup(i), (groupKinds.get(slotGroup(i)) ?? 0) | slot.kinds))
    const shareRoot = types.slots.map((_, i) => i)
    const shareGroup = (a: number) => rootOf(shareRoot, slotGroup(a))
    for (const lists of shared) for (const slots of lists) for (const slot of slots) shareRoot[shareGroup(slot)] = shareGroup(lists[0][0])
    const mixedShares = new Set<number>()
    for (const [root, kinds] of groupKinds) if (mixedKinds(kinds)) mixedShares.add(shareGroup(root))
    const taggedSlot = (slot: number) => mixedShares.has(shareGroup(slot))
    const tagged = new Map<number, Set<string>>()
    types.slots.forEach((slot, i) => {
        if (!taggedSlot(i)) return
        const keys = tagged.get(slot.allocation)
        if (keys) keys.add(slot.key)
        else tagged.set(slot.allocation, new Set([slot.key]))
    })
    const instances = types.instances.map(instance => {
        const { moved } = copiesOf(instance.unit)
        const nodes = new Set<number>()
        for (const access of instance.accesses) if (!access.field && !moved.has(access.node) && access.slots.some(taggedSlot)) nodes.add(access.node)
        return nodes
    })
    function lines(): string[] {
        const accessed = new Set(types.instances.flatMap(instance => instance.accesses.filter(access => !access.field).flatMap(access => access.slots.map(slotGroup))))
        const groups = new Map<number, string[]>()
        types.slots.forEach((slot, i) => {
            if (!accessed.has(slotGroup(i))) return
            const object = types.objects[slot.allocation]
            const text = `${object.name}#${slot.allocation}@${object.site.unit.name || '<anon>'}:%${object.site.node}${slot.key === numberKey ? '' : slot.key}`
            const list = listOf(groups, slotGroup(i))
            if (!list.includes(text)) list.push(text)
        })
        const out = [...groups].map(([root, members]) => `ELEMENT-GROUP ${root} ${taggedSlot(root) ? 'tagged' : 'raw'} kinds ${groupKinds.get(root)} shared ${shareGroup(root)} members ${members.join(' ')}`)
        const fieldGroups = new Set(types.instances.flatMap(instance => instance.accesses.filter(access => access.field).flatMap(access => access.slots.map(slotGroup))))
        const allocations = new Map<number, Set<number>>()
        types.slots.forEach((slot, i) => {
            if (fieldGroups.has(slotGroup(i))) setOf(allocations, slotGroup(i)).add(slot.allocation)
        })
        for (const [root, ids] of allocations) {
            if (ids.size < 2) continue
            const names = [...ids].map(id => `${types.objects[id].name}#${id}@${types.objects[id].site.unit.name || '<anon>'}:%${types.objects[id].site.node}`)
            out.push(`FIELD-GROUP ${root} ${types.slots[root].key} kinds ${groupKinds.get(root)} type ${formatType(types, fieldType(types.slots[root].allocation, types.slots[root].key, emptyType()))} members ${names.join(' ')}`)
        }
        return out
    }
    let groupTypes: Map<number, Type> | undefined
    const fieldKinds = new Map<number, number>()
    function fieldType(allocation: number, key: string, type: Type): Type {
        const slot = byAllocation.get(`${allocation}:${key}`)
        if (slot === undefined) return type
        if (!groupTypes) {
            const lists = new Map<number, Type[]>()
            types.slots.forEach((other, i) => {
                listOf(lists, slotGroup(i)).push(other.type)
                fieldKinds.set(slotGroup(i), (fieldKinds.get(slotGroup(i)) ?? 0) | (nullsOnly(other.type) ? 0 : other.kinds))
            })
            groupTypes = new Map()
            for (const [group, list] of lists) if (list.length > 1) groupTypes.set(group, unionAll(list))
        }
        const joined = groupTypes.get(slotGroup(slot))
        if (!joined) return type
        if (mixedKinds(fieldKinds.get(slotGroup(slot))!)) return union(type, joined)
        return union(type, { ...joined, objects: [], functions: [], closures: [], strings: [] })
    }
    let copyTypes: Map<number, Type> | undefined
    function copiedType(allocation: number, key: string, type: Type): Type {
        const slot = byAllocation.get(`${allocation}:${key}`)
        if (slot === undefined) return type
        if (!copyTypes) {
            const lists = new Map<number, Type[]>()
            types.slots.forEach((other, i) => listOf(lists, copyGroup(i)).push(other.type))
            copyTypes = new Map()
            for (const [group, list] of lists) if (list.length > 1) copyTypes.set(group, unionAll(list))
        }
        const joined = copyTypes.get(copyGroup(slot))
        return joined ? union(type, joined) : type
    }
    return { tagged, instances, fieldType, copiedType, copied, lines, group: slotGroup }
}

function nullishTests(g: Graph, types: Map<number, Type>, out: Map<number, Handle[]>): void {
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.rt || getLiteral(g, n, 1) !== rt.Op.nullish || !getRef(n, 2)) continue
        const type = types.get(getRef(n, 2))
        const handles: Handle[] = []
        if (!type || type.undefined) handles.push(heap.undefinedHandle)
        if (!type || type.null) handles.push(heap.nullHandle)
        out.set(id, handles)
    }
}

function comparedTargets(g: Graph, repAt: (node: number) => Rep | undefined): string[] {
    const targets: string[] = []
    for (const n of allNodes(g)) {
        if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) continue
        for (let i = 0; i < countIds(n); i++) {
            const rep = getRef(n, i) ? repAt(getRef(n, i)) : undefined
            if (rep) targets.push(...rep.shapes)
        }
    }
    return targets
}

function truthReturns(types: ValueTypes, units: PlannedUnit[], conventionOf: Map<PlannedUnit, PlannedUnit[]>, unitOfInstance: PlannedUnit[], testedIn: (unit: PlannedUnit) => Set<number>, returnedIn: (unit: PlannedUnit) => Set<number>, keepsReturn: (fn: Function) => boolean): PlannedUnit[] {
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const parent = units.map((_, i) => i)
    const join = (a: PlannedUnit, b: PlannedUnit) => {
        parent[rootOf(parent, index.get(a)!)] = rootOf(parent, index.get(b)!)
    }
    for (const unit of units) {
        for (const peer of conventionOf.get(unit) ?? []) join(unit, peer)
        for (const callees of unit.calls.values()) {
            const first = [...callees][0]
            for (const callee of callees) join(first, callee)
        }
    }
    const tested = (site: Site) => site.instance !== undefined && site.operand === undefined && testedIn(unitOfInstance[site.instance]).has(site.node)
    const returned = (site: Site) => site.instance !== undefined && site.operand === undefined && returnedIn(unitOfInstance[site.instance]).has(site.node)
    for (const unit of units) for (const f of unit.instances) for (const site of types.instances[f].sites) if (!tested(site) && returned(site)) join(unit, unitOfInstance[site.instance!])
    const qualifies = (unit: PlannedUnit) => {
        if (keepsReturn(unit.fn)) return false
        const type = unionAll(unit.instances.map(f => types.instances[f].returns))
        if (!truthTested(type) && !truthOnly(type)) return false
        return unit.instances.every(f => {
            const sites = types.instances[f].sites
            return sites.length > 0 && sites.every(site => tested(site) || returned(site))
        })
    }
    const failed = new Set<number>()
    for (const unit of units) if (!qualifies(unit)) failed.add(rootOf(parent, index.get(unit)!))
    const informative = new Set<number>()
    for (const unit of units) if (unit.instances.some(f => types.instances[f].returns.bools)) informative.add(rootOf(parent, index.get(unit)!))
    for (const unit of units) if (!informative.has(rootOf(parent, index.get(unit)!))) failed.add(rootOf(parent, index.get(unit)!))
    return units.filter(unit => !failed.has(rootOf(parent, index.get(unit)!)))
}

interface CallSite {
    caller: number
    node: number
    callees: number[]
}

function indirectCallees(types: ValueTypes, callSites: CallSite[], graphOf: (fn: Function) => Graph): number[][] {
    const out: number[][] = []
    for (const site of callSites) {
        const list = site.callees
        if (list.length < 2) continue
        if (new Set(list.map(f => types.instances[f].unit)).size < 2) continue
        const g = graphOf(types.instances[site.caller].unit)
        const n = getNode(g, site.node)
        if (!n || n.op !== NodeOp.call || !getRef(n, 1)) continue
        if (getNode(g, getRef(n, 1))?.op === NodeOp.getProp) continue
        out.push(list)
    }
    return out
}

function indirectGroups(lists: PlannedUnit[][]): PlannedUnit[][] {
    const parent = new Map<PlannedUnit, PlannedUnit>()
    const find = (unit: PlannedUnit): PlannedUnit => {
        let at = unit
        while (parent.has(at) && parent.get(at) !== at) at = parent.get(at)!
        return at
    }
    for (const list of lists) {
        const root = find(list[0])
        for (const unit of list) {
            const other = find(unit)
            if (other !== root) parent.set(other, root)
            if (!parent.has(root)) parent.set(root, root)
        }
    }
    const groups = new Map<PlannedUnit, PlannedUnit[]>()
    for (const unit of parent.keys()) {
        const root = find(unit)
        let members = groups.get(root)
        if (!members) groups.set(root, members = [])
        members.push(unit)
    }
    return [...groups.values()].filter(members => members.length > 1)
}

function sharedConventions(units: PlannedUnit[]): Map<PlannedUnit, PlannedUnit[]> {
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const parent = units.map((_, i) => i)
    for (const unit of units) {
        for (const callees of unit.calls.values()) {
            if (callees.size < 2) continue
            const first = index.get([...callees][0])!
            for (const callee of callees) parent[rootOf(parent, index.get(callee)!)] = rootOf(parent, first)
        }
    }
    const groups = new Map<number, PlannedUnit[]>()
    units.forEach((unit, i) => listOf(groups, rootOf(parent, i)).push(unit))
    const out = new Map<PlannedUnit, PlannedUnit[]>()
    for (const members of groups.values()) {
        if (members.length < 2) continue
        for (const unit of members) out.set(unit, members)
    }
    return out
}

export function floatUnion(rep: Rep | undefined): boolean {
    return rep?.kind === 'union' && !!rep.float
}

export function nullableNumber(rep: Rep | undefined): boolean {
    return rep?.kind === 'number' && rep.nullable
}

export function falsyCollapsible(rep: Rep | undefined): boolean {
    return nullableNumber(rep) || (isStringRep(rep) && rep!.nullable)
}

export function nonzeroLiteral(g: Graph, n: GraphNode, at: number): boolean {
    const ref = getRef(n, at)
    if (!ref) return getLiteral(g, n, at) !== 0
    const m = getNode(g, ref)
    return m?.op === NodeOp.literal && getLiteral(g, m, 0) !== 0
}

function undefinedCarrier(rep: Rep | undefined): boolean {
    return falsyCollapsible(rep) || (rep?.kind === 'union' && rep.nullable && !rep.float)
}

const arithmeticRt = new Set<number>([rt.Op.exp, rt.Op.mod, rt.Op.trunc])

function truthTest(g: Graph, n: GraphNode): boolean {
    return n.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.truthy
}

function firstArg(call: GraphNode, plain: number): number {
    if (call.op === NodeOp.call) return 3
    if (call.op === NodeOp.rt) return 2
    if (call.op === NodeOp.getProp || call.op === NodeOp.setProp) return countIds(call) - plain
    return -1
}

function observeUndefined(types: ValueTypes, units: PlannedUnit[], touchedOf: Map<PlannedUnit, Map<number, number[]>>, graphOf: (fn: Function) => Graph, slotGroup: (slot: number) => number, inst: Instantiations): Set<number> {
    const observed = new Set<number>()
    const bufferGroup = inst.bufferGroup
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, u) => index.set(unit, u))
    const graphs = units.map(unit => graphOf(unit.fn))
    const at = (u: number, node: number) => u * nodeSpan + node
    const callers = units.map(() => [] as [number, number][])
    const readers = new Map<number, [number, number][]>()
    const writers = new Map<number, [number, number][]>()
    function add(map: Map<number, [number, number][]>, k: number, item: [number, number]): void {
        listOf(map, k).push(item)
    }
    units.forEach((unit, u) => {
        for (const [node, callees] of unit.calls) for (const callee of callees) callers[index.get(callee)!].push([u, node])
        for (const [node, touched] of touchedOf.get(unit)!) {
            const slice = rt.sliceOf(graphs[u], getNode(graphs[u], node)!)
            for (const allocation of touched) {
                if (slice === rt.Op.sliceRead) add(readers, bufferGroup(allocation), [u, node])
                if (slice === rt.Op.sliceWrite) add(writers, bufferGroup(allocation), [u, getRef(getNode(graphs[u], node)!, 4)])
            }
        }
    })
    const fieldReaders = new Map<number, [number, number][]>()
    const fieldWriters = new Map<number, [number, number][]>()
    const fieldGroups = new Map<number, number[]>()
    const fieldBuffers = new Map<number, number[]>()
    const bufferGroups = inst.bufferGroups()
    const buffered = new Set<number>()
    for (const members of bufferGroups.values()) for (const id of members) buffered.add(id)
    units.forEach((unit, u) => {
        for (const f of unit.instances) for (const access of types.instances[f].accesses) {
            if (!access.field || fieldGroups.has(at(u, access.node))) continue
            const slots = access.slots
            const groups = [...new Set(slots.map(slotGroup))]
            const buffers = [...new Set(slots.map(slot => types.slots[slot].allocation).filter(id => buffered.has(id)).map(bufferGroup))]
            fieldGroups.set(at(u, access.node), groups)
            fieldBuffers.set(at(u, access.node), buffers)
            const item: [number, number] = access.store ? [u, getRef(getNode(graphs[u], access.node)!, 3)] : [u, access.node]
            for (const group of groups) add(access.store ? fieldWriters : fieldReaders, group, item)
            for (const group of buffers) add(access.store ? writers : readers, group, item)
        }
    })
    const observedFields = new Set<number>()
    const rooted = units.map(unit => unit.instances.some(f => !types.instances[f].sites.length))
    const plains = new Map<Graph, number[]>()
    function plainOf(g: Graph): number[] {
        let known = plains.get(g)
        if (!known) plains.set(g, known = g.blocks[0].params.filter(p => !isThisParam(getNode(g, p)!)))
        return known
    }
    function calleeTargets(u: number, node: number, n: GraphNode, slot: number): [number, number][] | undefined {
        const callees = units[u].calls.get(node)
        if (!callees) return
        const out: [number, number][] = []
        for (const callee of callees) {
            const c = index.get(callee)!
            const plain = plainOf(graphs[c])
            const first = firstArg(n, plain.length)
            if (first < 0 || slot < first) return
            if (slot - first >= plain.length) continue
            const param = callee.nodes.get(plain[slot - first])
            if (param && !param.nullable) continue
            if (!undefinedCarrier(param)) return
            out.push([c, plain[slot - first]])
        }
        return out
    }
    function targetsOf(u: number, node: number, slot: number): [number, number][] | undefined {
        const g = graphs[u]
        const n = getNode(g, node)!
        if (effect(n.op) && slot === 0) return []
        if (n.op === NodeOp.after) return slot === countIds(n) - 1 ? [[u, node]] : []
        if (n.op === NodeOp.select) return slot > 0 ? [[u, node]] : []
        if (n.op === NodeOp.mem || n.op === NodeOp.inlined) return slot === 0 ? [[u, node]] : undefined
        if (n.op === NodeOp.apply) return slot > 0 ? [[u, getBlock(g, getRef(n, 0))!.params[slot - 1]]] : undefined
        if (n.op === NodeOp.ret) {
            const region = regionRets(g).get(node)
            if (region !== undefined) return [[u, region]]
            return rooted[u] ? [] : callers[u]
        }
        if (n.op === NodeOp.eq || n.op === NodeOp.ne) return countIds(n) === 2 && nonzeroLiteral(g, n, 1 - slot) ? [] : undefined
        if (n.op === NodeOp.add && typeOf(n) === Types.unknown_number && units[u].nodes.get(node)?.kind !== 'number') return
        if (NumericOps.has(n.op) || n.op === NodeOp.convert || n.op === NodeOp.bitconvert) return []
        if (n.op === NodeOp.load) return slot === 1 || slot === 2 ? [] : undefined
        const slice = rt.sliceOf(g, n)
        if (slice === rt.Op.slice) return slot === 2 ? [] : undefined
        if (slice === rt.Op.sliceRead) return slot === 3 ? [] : undefined
        if (slice === rt.Op.sliceWrite) {
            if (slot === 3) return []
            const touched = touchedOf.get(units[u])!.get(node)
            if (slot !== 4 || !touched) return
            return touched.flatMap(allocation => readers.get(bufferGroup(allocation)) ?? [])
        }
        if (slot < firstNonOrderingSlot(n)) return []
        if (truthTest(g, n) || (n.op === NodeOp.rt && arithmeticRt.has(getLiteral(g, n, 1)))) return []
        if (n.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.addOrConcat && (slot === 2 || slot === 3) && numericOperand(u, n, 5 - slot)) return []
        if (n.op === NodeOp.store && slot === 3 && typeOf(n) !== Types.vm_value) return []
        if (n.op === NodeOp.getProp && slot === 1) return []
        if (n.op === NodeOp.setProp && slot === 3 && fieldGroups.has(at(u, node))) return [...fieldGroups.get(at(u, node))!.flatMap(group => fieldReaders.get(group) ?? []), ...fieldBuffers.get(at(u, node))!.flatMap(group => readers.get(group) ?? [])]
        if (n.op === NodeOp.setProp && slot === 3 && types.fieldStores.get(units[u].fn)?.has(node)) return
        if (n.op === NodeOp.call || n.op === NodeOp.rt || n.op === NodeOp.getProp || n.op === NodeOp.setProp) return calleeTargets(u, node, n, slot)
    }
    function numericOperand(u: number, n: GraphNode, at: number): boolean {
        const ref = getRef(n, at)
        if (!ref) return typeof getLiteral(graphs[u], n, at) === 'number'
        return getNode(graphs[u], ref)?.op === NodeOp.literal || units[u].nodes.get(ref)?.kind === 'number'
    }
    function observes(u: number, node: number, slot: number): boolean {
        const targets = targetsOf(u, node, slot)
        if (!targets) return true
        for (const [t, id] of targets) {
            const rep = units[t].nodes.get(id)
            if (rep && rep.nullable && !undefinedCarrier(rep) && rep.kind !== 'undefined') return true
        }
        return false
    }
    const seen = new Set<number>()
    const work: [number, number][] = []
    function need(u: number, id: number): void {
        if (!id || !undefinedCarrier(units[u].nodes.get(id))) return
        if (seen.has(at(u, id))) return
        seen.add(at(u, id))
        units[u].observed.add(id)
        work.push([u, id])
    }
    const observedGroups = new Set<number>()
    function observe(group: number): void {
        if (observedGroups.has(group)) return
        observedGroups.add(group)
        for (const [w, value] of writers.get(group) ?? []) need(w, value)
    }
    for (const [group, members] of bufferGroups) {
        if (members.some(id => types.objects[id].constant) || !inst.collapses(members)) observe(group)
    }
    units.forEach((unit, u) => {
        const users = usersOf(graphs[u])
        for (const [id, rep] of unit.nodes) {
            if (!undefinedCarrier(rep)) continue
            for (const [user, slot] of users.get(id) ?? []) {
                if (!observes(u, user, slot)) continue
                need(u, id)
                break
            }
        }
    })
    while (work.length) {
        const [u, id] = work.pop()!
        const unit: PlannedUnit = units[u]
        const g = graphs[u]
        const n = getNode(g, id)
        if (!n) continue
        if (n.op === NodeOp.param) {
            const slotOf = paramSlots(g).get(id)
            if (!slotOf) continue
            const [block, i] = slotOf
            for (const apply of predsOf(g, block)) need(u, getRef(getNode(g, apply)!, i + 1))
            if (block !== g.blocks[0]) continue
            const position = plainOf(g).indexOf(id)
            if (position < 0) continue
            const incoming: [number, number][] = callers[u]
            for (const [caller, node] of incoming) {
                const call = getNode(graphs[caller], node)!
                if (truthTest(graphs[caller], call)) continue
                const first = firstArg(call, plainOf(g).length)
                if (first >= 0 && first + position < countIds(call)) need(caller, getRef(call, first + position))
            }
            continue
        }
        if (n.op === NodeOp.after) {
            need(u, getRef(n, countIds(n) - 1))
            continue
        }
        if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) need(u, getRef(n, i))
            continue
        }
        if (n.op === NodeOp.mem) {
            need(u, getRef(n, 0))
            continue
        }
        if (n.op === NodeOp.inlined) {
            need(u, getRef(n, 0))
            for (const [ret, root] of regionRets(g)) if (root === id) need(u, getRef(getNode(g, ret)!, 0))
            continue
        }
        const slice = rt.sliceOf(g, n)
        if (slice === rt.Op.sliceRead) {
            for (const allocation of touchedOf.get(unit)!.get(id) ?? []) observe(bufferGroup(allocation))
            continue
        }
        if (slice !== undefined) continue
        if (n.op === NodeOp.getProp && fieldGroups.has(at(u, id))) {
            for (const group of fieldGroups.get(at(u, id))!) {
                if (observedFields.has(group)) continue
                observedFields.add(group)
                for (const [w, value] of fieldWriters.get(group) ?? []) need(w, value)
            }
            for (const group of fieldBuffers.get(at(u, id))!) observe(group)
        }
        for (const callee of unit.calls.get(id) ?? []) {
            const c = index.get(callee)!
            for (const ret of retsOf(graphs[c])) if (!regionRets(graphs[c]).has(ret)) need(c, getRef(getNode(graphs[c], ret)!, 0))
        }
    }
    types.objects.forEach((_, id) => {
        if (observedGroups.has(bufferGroup(id))) observed.add(id)
    })
    return observed
}

function numericType(type: Type): boolean {
    return type.literals.length > 0 || opaqueNumber(type)
}

function opaqueNumber(type: Type): boolean {
    return !!type.range || type.float
}

function congruence(types: ValueTypes, callSites: CallSite[]): (a: number) => number {
    const parent = types.instances.map((_, i) => i)
    const find = (a: number) => rootOf(parent, a)
    const sitesOf = new Map<number, Map<number, number>>()
    const pending: [number, number][] = []
    const receivers = createInterner()
    const indirect = new Map<number, number>()
    for (const call of callSites) {
        const fns = new Set(call.callees.map(id => types.instances[id].unit))
        if (fns.size < 2) continue
        for (const id of call.callees) {
            const instance = types.instances[id]
            const receiver = instance.params.find(p => p.receiver)?.type.objects ?? []
            const value = intern(receivers, [instance.unit, ...receiver])
            const known = indirect.get(value)
            if (known === undefined) indirect.set(value, id)
            else pending.push([known, id])
        }
    }
    const targets = createInterner()
    for (const call of callSites) {
        const sites = mapOf(sitesOf, call.caller)
        for (const id of call.callees) {
            const site = intern(targets, [call.node, types.instances[id].unit])
            const known = sites.get(site)
            if (known === undefined) sites.set(site, id)
            else pending.push([known, id])
        }
    }
    function drain(): void {
        while (pending.length) {
            const [x, y] = pending.pop()!
            const rx = find(x)
            const ry = find(y)
            if (rx === ry) continue
            parent[ry] = rx
            const from = sitesOf.get(ry)
            sitesOf.delete(ry)
            if (!from) continue
            const into = sitesOf.get(rx)
            if (!into) {
                sitesOf.set(rx, from)
                continue
            }
            for (const [site, f] of from) {
                const known = into.get(site)
                if (known === undefined) into.set(site, f)
                else pending.push([known, f])
            }
        }
    }
    drain()
    return find
}

export interface Embeddings {
    fields: Map<string, Map<string, string>>
    sites: Map<PlannedUnit, Map<number, string>>
}

export function planEmbeddings(types: ValueTypes, inst: Instantiations, plan: Map<Function, PlannedUnit[]>): Embeddings {
    const holders = new Map<number, [number, string][]>()
    types.objects.forEach((object, id) => {
        for (const [key, field] of object.fields) for (const inner of field.type.objects) {
            const list = listOf(holders, inner)
            list.push([id, key])
        }
    })
    const returned = new Set(types.instances.flatMap(instance => instance.returns.objects.filter(id => receiverOf(instance) !== id)))
    const sameSite = (a: number, b: number) => types.objects[a].site.unit === types.objects[b].site.unit && types.objects[a].site.node === types.objects[b].site.node
    const onlyObjects = (t: Type) => !nullableType(t) && !t.strings.length && !t.unknown && !numericType(t) && !t.functions.length && !t.closures.length && t.objects.length > 0
    function owner(inner: number): [number, string] | undefined {
        const object = types.objects[inner]
        if (object.constant || object.native || object.kind === AllocKind.buffer || returned.has(inner)) return
        const holding = holders.get(inner) ?? []
        const held = holding.filter(([id]) => instancesOf(object).some(instance => receiverOf(types.instances[instance]) === id))
        if (held.length !== 1) return
        const [parent, key] = held[0]
        const outer = types.objects[parent]
        if (outer.constant || outer.native || (holding.length > 1 && !outer.fields.get(key)?.constructed)) return
        const type = outer.fields.get(key)!.type
        if (!onlyObjects(type) || !type.objects.every(id => sameSite(id, inner))) return
        return [parent, key]
    }
    const fields = new Map<string, Map<string, string>>()
    for (const [holderShape, sig] of inst.shapes) {
        const byKey = new Map<string, string>()
        for (const [key] of sig.fields) {
            let inner: string | undefined
            const embeds = sig.members.length > 0 && sig.members.every(m => {
                const t = types.objects[m].fields.get(key)?.type
                return !!t && onlyObjects(t) && t.objects.every(id => {
                    const heldShape = inst.shapeOf(id)
                    if (owner(id)?.[0] !== m || heldShape === undefined || heldShape === holderShape || (inner !== undefined && inner !== heldShape)) return false
                    inner = heldShape
                    return true
                })
            })
            if (embeds && inner !== undefined) byKey.set(key, inner)
        }
        if (byKey.size) fields.set(holderShape, byKey)
    }
    const unitOfInstance = new Map<number, PlannedUnit>()
    for (const units of plan.values()) for (const unit of units) {
        for (const f of unit.instances) unitOfInstance.set(f, unit)
    }
    const placements = createInterner()
    const placed: { unit: PlannedUnit, node: number, embeds: Set<number> }[] = []
    const embedIds = createInterner()
    const embeds: [holderShape: string, field: string][] = []
    types.objects.forEach((object, id) => {
        for (const instance of instancesOf(object)) {
            const unit = unitOfInstance.get(instance)
            if (!unit || !unit.allocations.has(object.site.node)) continue
            const at = intern(placements, [unit, object.site.node])
            if (at === placed.length) placed.push({ unit, node: object.site.node, embeds: new Set() })
            const found = owner(id)
            const holderShape = found ? inst.shapeOf(found[0]) : undefined
            let embed = -1
            if (found && holderShape !== undefined && fields.get(holderShape)?.get(found[1]) === inst.shapeOf(id)) {
                embed = intern(embedIds, [holderShape, found[1]])
                if (embed === embeds.length) embeds.push([holderShape, found[1]])
            }
            placed[at].embeds.add(embed)
        }
    })
    for (const place of placed) {
        if (place.embeds.size < 2) continue
        for (const embed of place.embeds) {
            if (embed < 0) continue
            const [holderShape, field] = embeds[embed]
            fields.get(holderShape)?.delete(field)
        }
    }
    const sites = new Map<PlannedUnit, Map<number, string>>()
    for (const place of placed) {
        const [embed] = [...place.embeds]
        if (place.embeds.size !== 1 || embed < 0) continue
        const [holderShape, field] = embeds[embed]
        if (!fields.get(holderShape)?.has(field)) continue
        mapOf(sites, place.unit).set(place.node, field)
    }
    return { fields, sites }
}
interface Moves {
    words: Set<number>
    elements: ElementReads
}

export type ElementReads = Set<Handle> | 'all'

function movesOf(g: Graph): Moves {
    const known = moveSets.get(g)
    if (known) return known
    const users = usersOf(g)
    function movedBy(passing: boolean): (id: number) => boolean {
        const memo = new Map<number, boolean>()
        function moved(id: number): boolean {
            const done = memo.get(id)
            if (done !== undefined) return done
            memo.set(id, false)
            const result = (users.get(id) ?? []).every(([user, slot]) => {
                const n = getNode(g, user)!
                if (n.op === NodeOp.after) return slot < countIds(n) - 1 || moved(user)
                if (slot === 0 && (n.op === NodeOp.load || n.op === NodeOp.store || n.op === NodeOp.getProp || n.op === NodeOp.setProp || n.op === NodeOp.call || rt.sliceOf(g, n) !== undefined)) return true
                if (n.op === NodeOp.store) return slot === 3 && resultType(g, n) === Types.vm_value
                if (rt.sliceOf(g, n) === rt.Op.sliceWrite) return slot === 4 && wordStore(g, n)
                if (n.op === NodeOp.setProp) return passing && slot === 3
                if (n.op === NodeOp.call) return passing && slot >= 3
                return n.op === NodeOp.ret && slot === 0
            })
            memo.set(id, result)
            return result
        }
        return moved
    }
    const moved = movedBy(true)
    const kept = movedBy(false)
    const words = new Set<number>()
    let elements: ElementReads = new Set<Handle>()
    for (const [id, n] of nodeEntries(g)) {
        const load = wordLoad(g, n)
        const read = n.op === NodeOp.load || rt.sliceOf(g, n) === rt.Op.sliceRead
        if (read && elements !== 'all' && !(load && kept(id))) {
            const base = getNode(g, getRef(n, n.op === NodeOp.load ? 1 : 2))
            if (base?.op === NodeOp.load || (base && rt.sliceOf(g, base) === rt.Op.sliceRead)) elements = 'all'
            else if (base?.op === NodeOp.getProp && !getRef(base, 2)) elements.add(getLiteral(g, base, 2) as Handle)
        }
        if ((load || n.op === NodeOp.getProp || n.op === NodeOp.call || g.blocks[0].params.includes(id)) && moved(id)) words.add(id)
    }
    const out = { words, elements }
    moveSets.set(g, out)
    return out
}
const moveSets = new WeakMap<Graph, Moves>()

export function dereferenceableRep(rep: Rep | undefined): boolean {
    return !!rep && rep.kind === 'pointer' && !rep.nullable && !rep.encoded && memberCount(rep) === 1 && rep.shapes.length === 1
}

export function addressRep(rep: Rep): boolean {
    return rep.kind === 'pointer' && rep.members === RepMember.buffer && memberCount(rep) === 1 && (!rep.nullable || !!rep.zero)
}

function rawElement(element: Rep): boolean {
    if (element.kind === 'number') return (!element.format || element.format.bits === 64) && !element.nullable
    if (addressRep(element)) return true
    return element.kind === 'pointer' && element.shapes.length > 0 && memberCount(element) === element.shapes.length && !element.constant
}

export function elementTagged(element: Rep): boolean {
    return !element.encoded && element.kind === 'number' && element.nullable
}

export interface SlotCodec {
    word: boolean
    boxed: boolean
    nullable: 'tag' | 'word' | undefined
    float: boolean
}

const slotCodecIds = createInterner()
const slotCodecs: SlotCodec[] = []

export function slotCodec(element: Rep, word: boolean): SlotCodec {
    const boxed = !!element.encoded && element.kind === 'number' && numberName(element) === 'f64'
    const nullable = elementTagged(element) ? 'tag' : element.encoded && element.nullable ? 'word' : undefined
    const float = floatUnion(element)
    const tagged = word || (nullable === 'word' && !boxed && (nullableNumber(element) || element.kind === 'union'))
    const id = intern(slotCodecIds, [tagged, boxed, nullable, float])
    if (id === slotCodecs.length) slotCodecs.push({ word: tagged, boxed, nullable, float })
    return slotCodecs[id]
}

function slotCodecText(codec: SlotCodec): string {
    return `${codec.word ? 'word' : 'raw'}${codec.boxed ? ' boxed' : ''}${codec.nullable ? ` nullable:${codec.nullable}` : ''}${codec.float ? ' float' : ''}`
}

export function elementWidth(element: Rep): number {
    if (element.encoded) return 4
    if (floatUnion(element) || elementTagged(element)) return 16
    if (element.kind === 'number' && element.format) return 8
    return rawElement(element) ? 8 : 4
}

export function isStringRep(rep: Rep | undefined): boolean {
    return rep?.kind === 'pointer' && rep.members === RepMember.string && memberCount(rep) === 1
}

export function memberCount(rep: Rep): number {
    let count = rep.shapes.length
    if (rep.closure !== undefined) count++
    let bits = rep.members
    while (bits) {
        count += bits & 1
        bits >>= 1
    }
    return count
}

function memberNames(rep: Rep, shape: (id: string) => string, closure: (state: Handle) => string): string[] {
    const names = rep.shapes.map(shape)
    if (rep.members & RepMember.buffer) names.push('buf')
    if (rep.members & RepMember.string) names.push('str')
    if (rep.members & RepMember.dynamic) names.push('heap')
    if (rep.closure !== undefined) names.push(closure(rep.closure))
    if (rep.members & RepMember.function) names.push('fn')
    return names
}

function closureName(state: Handle): string {
    return `clo@${state}`
}

export function sameRep(a: Rep, b: Rep, integers = false): boolean {
    if (a === b) return true
    if (!!a.encoded !== !!b.encoded || !!a.bit !== !!b.bit || !!a.tested !== !!b.tested) return false
    if (a.bit) return true
    const fn = a.constant?.fn
    if (fn || b.constant?.fn) return fn === b.constant?.fn
    if (a.tested) return a.nullable === b.nullable
    const literal = a.constant?.literal
    if (literal !== undefined || b.constant?.literal !== undefined) return literal === b.constant?.literal && !!a.bools === !!b.bools && a.nullable === b.nullable
    if (a.kind !== b.kind) return false
    if (a.constant?.handle !== b.constant?.handle) return false
    if (a.storeTypes || b.storeTypes) return !!a.storeTypes && !!b.storeTypes && a.nullable === b.nullable && a.storeTypes.length === b.storeTypes.length && a.storeTypes.every((store, i) => store === b.storeTypes![i])
    switch (a.kind) {
        case 'number': return a.nullable === b.nullable && !!a.bools === !!b.bools && (!!a.bools || (integers ? !a.format === !b.format : machineText(a.format) === machineText(b.format)))
        case 'union': return a.float ? !!b.float && sameRep(a.other!, b.other!, integers) : !b.float && !!a.bools === !!b.bools && !!a.null === !!b.null && sameTargets(a, b)
        case 'pointer': return a.nullable === b.nullable && !!a.zero === !!b.zero && sameTargets(a, b)
        case 'buffer': return a.nullable === b.nullable && sameRep(a.element!, b.element!)
        default: return true
    }
}

function sameFields(a: [string, Rep][], b: [string, Rep][]): boolean {
    return a.length === b.length && a.every(([k, rep], i) => b[i][0] === k && sameRep(rep, b[i][1]))
}

function sameTargets(a: Rep, b: Rep): boolean {
    return a.members === b.members && a.closure === b.closure && a.shapes.length === b.shapes.length && a.shapes.every((shape, i) => shape === b.shapes[i])
}

export function repText(rep: Rep | undefined, missing = 'no rep'): string {
    if (!rep) return missing
    if (rep.encoded) return `enc<${repText({ ...rep, encoded: undefined })}>`
    if (rep.bit) return 'u1'
    if (rep.constant?.fn) return `fn@${rep.constant.fn.name || '<anon>'}`
    const nullable = rep.nullable ? '?' : ''
    if (rep.tested) return `truth${nullable}`
    const literal = rep.constant?.literal
    if (literal !== undefined) return `${!rep.bools ? `#${literal}` : literal ? '#true' : '#false'}${nullable}`
    if (rep.constant?.handle !== undefined && rep.kind !== 'undefined') return `${repText({ ...rep, constant: undefined })}@${rep.constant.handle}`
    if (rep.storeTypes) return `${rep.storeTypes.map(typeName).join('|')}${nullable}`
    const names = memberNames(rep, id => id, closureName)
    const targets = names.join('|')
    switch (rep.kind) {
        case 'number': return `${rep.bools ? 'bool' : numberText(rep.format)}${nullable}`
        case 'union': return rep.float ? `union<f64|${repText(rep.other!)}>` : `union<${[...names, ...rep.bools ? ['bool'] : [], ...rep.null ? ['null'] : []].join('|')}>`
        case 'pointer': return `ptr<${targets}>${rep.zero ? '|0' : nullable}`
        case 'buffer': return `buf<${rep.element ? repText(rep.element) : ''}>${nullable}`
        default: return rep.kind
    }
}

export function shapeSignatureText(sig: ShapeSignature): string {
    return `${sig.name}{${sig.fields.map(([k, rep]) => `${k}: ${repText(rep)}`).join(', ')}}`
}

export function unitSignatureText(unit: PlannedUnit): string {
    const made = [...new Set([...unit.allocations].map(([node, shape]) => `%${node}=${shape ?? 'heap'}`))].sort()
    return `(${unit.params.map(param => `${param.label}: ${repText(param.rep)}`).join(', ')}) -> ${repText(unit.returns)}${made.length ? ` new ${made.join(' ')}` : ''}`
}

export enum Representation {
    none,
    constant,
    integer,
    f64,
    flag,
    condition,
    string,
    object,
    tagged,
    taggedNumber,
    floatRecord,
    dynamic,
    wildcard,
    handle,
}

export enum Address {
    pstack,
    memory,
    heap,
}

export enum Storage {
    record,
    dictionary,
    buffer,
    function,
}

export interface ObjectRepresentation {
    address: Address
    storage: Storage
    layout?: string
    state?: Handle
    element?: BoundaryRepresentation
}

export interface BoundaryRepresentation {
    representation: Representation
    format?: IntFormat
    width?: number
    absent?: boolean
    objects?: ObjectRepresentation[]
    inner?: BoundaryRepresentation
}

function objectRepresentations(rep: Rep): ObjectRepresentation[] {
    const objects: ObjectRepresentation[] = rep.shapes.map(layout => ({ address: Address.pstack, storage: Storage.record, layout }))
    if (rep.members & RepMember.buffer) objects.push({ address: Address.memory, storage: Storage.buffer })
    if (rep.members & RepMember.dynamic) objects.push({ address: Address.heap, storage: Storage.dictionary })
    if (rep.closure !== undefined) objects.push({ address: Address.pstack, storage: Storage.record, state: rep.closure })
    if (rep.members & RepMember.function) objects.push({ address: Address.pstack, storage: Storage.function })
    return objects
}

export function representationOf(rep: Rep): BoundaryRepresentation {
    if (rep.tested) return { representation: Representation.condition }
    if (rep.bit) return { representation: Representation.flag }
    if (rep.encoded) return { representation: Representation.tagged, objects: objectRepresentations(rep) }
    if (rep.kind === 'never') return { representation: Representation.none }
    if (rep.kind === 'undefined') return { representation: Representation.constant }
    if (rep.kind === 'any') return { representation: Representation.dynamic }
    if (rep.kind === 'number') {
        const value = rep.format ? { representation: Representation.integer, format: rep.format } : { representation: Representation.f64 }
        return rep.nullable ? { representation: Representation.taggedNumber, inner: value } : value
    }
    if (rep.kind === 'union' && rep.float) return { representation: Representation.floatRecord, inner: representationOf(rep.other!) }
    if (rep.kind === 'union') return { representation: Representation.tagged, objects: objectRepresentations(rep) }
    if (rep.kind === 'buffer') return { representation: Representation.object, absent: rep.nullable, objects: [{ address: Address.memory, storage: Storage.buffer, element: representationOf(rep.element!) }] }
    if (rep.members & RepMember.string && memberCount(rep) > 1) return { representation: Representation.tagged, objects: objectRepresentations(rep) }
    if (rep.members & RepMember.string) return { representation: Representation.string, absent: rep.nullable }
    return { representation: Representation.object, absent: rep.nullable, objects: objectRepresentations(rep) }
}

export function returnProjects(returned: Rep, site: Rep): boolean {
    if (representationOf(returned).representation !== Representation.tagged) return true
    const representation = representationOf(site).representation
    return representation === Representation.tagged || representation === Representation.constant || representation === Representation.none
}

export function sameRepresentation(a: BoundaryRepresentation | undefined, b: BoundaryRepresentation | undefined): boolean {
    if (!a || !b) return a === b
    if (a.representation !== b.representation || a.width !== b.width || !!a.absent !== !!b.absent) return false
    if (a.format?.bits !== b.format?.bits || a.format?.signed !== b.format?.signed) return false
    if (!sameRepresentation(a.inner, b.inner)) return false
    const x = a.objects ?? []
    const y = b.objects ?? []
    return x.length === y.length && x.every((object, i) => object.address === y[i].address && object.storage === y[i].storage && object.layout === y[i].layout && object.state === y[i].state && sameRepresentation(object.element, y[i].element))
}

enum RepAtom {
    number,
    pointer,
    constantFunction,
    constantPointer,
    union,
    buffer,
    any,
    other,
}

function memberAtoms(rep: Rep, shape: (id: string) => Atom, closure: (state: Handle) => Atom, out: Atom[]): void {
    out.push(rep.shapes.length)
    for (const id of rep.shapes) out.push(shape(id))
    out.push(rep.members & (RepMember.buffer | RepMember.string | RepMember.dynamic | RepMember.function), rep.closure !== undefined)
    if (rep.closure !== undefined) out.push(closure(rep.closure))
}

function repAtoms(rep: Rep, shape: (id: string) => Atom, closure: (state: Handle) => Atom, out: Atom[]): void {
    const nullable = rep.zero ? 2 : rep.nullable ? 1 : 0
    if (rep.kind === 'number') {
        out.push(RepAtom.number, machineText(rep.format), nullable)
        return
    }
    if (rep.kind === 'pointer' && rep.constant?.fn) {
        out.push(RepAtom.constantFunction, rep.constant.fn)
        return
    }
    if (rep.kind === 'pointer' && rep.constant) {
        out.push(RepAtom.constantPointer, nullable, rep.constant.handle)
        memberAtoms(rep, id => id, state => state, out)
        return
    }
    if (rep.kind === 'pointer') {
        out.push(RepAtom.pointer, nullable)
        memberAtoms(rep, shape, closure, out)
        return
    }
    if (rep.kind === 'union') {
        out.push(RepAtom.union)
        memberAtoms(rep, shape, closure, out)
        return
    }
    if (rep.kind === 'buffer') {
        out.push(RepAtom.buffer, nullable, !!rep.element!.encoded)
        repAtoms(rep.element!, shape, closure, out)
        return
    }
    if (rep.kind === 'any') {
        out.push(RepAtom.any, rep.storeTypes ? rep.storeTypes.length : -1)
        if (rep.storeTypes) out.push(...rep.storeTypes)
        return
    }
    out.push(RepAtom.other, rep.kind)
    if (rep.constant?.handle !== undefined) out.push(rep.constant.handle)
}

function movedAtoms(rep: Rep, param: boolean, reduced: (shape: string) => boolean, boxed: boolean, out: Atom[]): void {
    if (boxed && isStringRep(rep)) out.push('string-word')
    else if (boxed && rep.kind === 'number' && rep.bools) out.push('bool-word')
    else if (intFormatOf(rep)?.signed === false || (rep.kind === 'undefined' && !param) || isStringRep(rep)) out.push('word')
    else if (rep.kind === 'number') out.push(machineText(rep.format))
    else {
        repAtoms(rep, id => reduced(id), state => reducedShape(state), out)
        out.push(!!rep.fresh)
    }
}

export function sameArgument(a: Rep, b: Rep): boolean {
    const x: Atom[] = []
    const y: Atom[] = []
    repAtoms(a.kind === 'pointer' ? { ...a, nullable: false } : a, id => id, state => state, x)
    repAtoms(b.kind === 'pointer' ? { ...b, nullable: false } : b, id => id, state => state, y)
    return x.length === y.length && x.every((atom, i) => atom === y[i])
}

export function shareClasses(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => number, reduced: (shape: string) => boolean, sites: Map<PlannedUnit, Map<number, Handle>>, abiOf: (unit: PlannedUnit) => Atom[], graphOf: (fn: Function) => Graph): Map<PlannedUnit, number> {
    const byNode = (entries: [number, Atom[]][], out: Atom[]) => {
        out.push(entries.length)
        for (const [node, atoms] of entries.sort((a, b) => a[0] - b[0])) out.push(node, ...atoms)
    }
    const units = [...plan.values()].flat()
    const parts = (unit: PlannedUnit): Atom[] => {
        const g = graphOf(unit.fn)
        const { words: moved, elements } = movesOf(g)
        const out: Atom[] = []
        const view = (rep: Rep, into: Atom[]) => {
            repAtoms(rep, id => layoutOf(id, elements), state => state, into)
            into.push(!!rep.fresh)
        }
        const value = (rep: Rep, into: Atom[]) => {
            if (rep.kind === 'number') into.push(machineText(rep.format))
            else view(rep, into)
        }
        const node = (rep: Rep, into: Atom[]) => {
            if (rep.kind === 'pointer' && rep.members === RepMember.buffer && memberCount(rep) === 1) into.push('u64')
            else value(rep, into)
        }
        const boxed = [...unit.codecs.values()].some(codec => codec.word)
        const entry = g.blocks[0].params
        const wide = (id: number) => unit.slices.has(id) && elementWidth(unit.slices.get(id)!) === 8
        const read = (id: number) => getNode(g, id)!.op === NodeOp.load || rt.sliceOf(g, getNode(g, id)!) === rt.Op.sliceRead
        const decoded = (id: number) => !!unit.codecs.get(id)?.word && read(id) && unit.nodes.get(id)!.kind !== 'union'
        const keyed = (id: number) => !moved.has(id) || !read(id) || wide(id) || decoded(id)
        out.push(unit.fn)
        byNode([...unit.codecs].map(([n, codec]): [number, Atom[]] => [n, [codec]]), out)
        out.push(unit.returnsSelf, !!unit.returns.tested, unit.params.length)
        unit.params.forEach((p, i) => {
            out.push(p.label)
            if (moved.has(entry[i])) movedAtoms(p.rep, true, reduced, boxed, out)
            else value(p.rep, out)
        })
        out.push(...abiOf(unit), floatUnion(unit.returns))
        if (floatUnion(unit.returns)) view(unit.returns, out)
        byNode([...unit.allocations].map(([n, shape]): [number, Atom[]] => [n, [shape === undefined ? undefined : layoutOf(shape, elements)]]), out)
        const site = sites.get(unit)
        if (site) byNode([...site].map(([n, k]): [number, Atom[]] => [n, [k as number]]), out)
        else out.push(0)
        const blocks = [...unit.blocks].sort((a, b) => a - b)
        out.push(blocks.length, ...blocks)
        byNode([...unit.deadArms].map(([n, arms]): [number, Atom[]] => [n, [arms.length, ...arms]]), out)
        byNode([...unit.nullishTests].map(([n, handles]): [number, Atom[]] => [n, handles]), out)
        byNode([...unit.coercions].map(([n, mask]): [number, Atom[]] => [n, [mask]]), out)
        byNode([...unit.reads].map(([n, literal]): [number, Atom[]] => [n, [literal]]), out)
        byNode([...unit.equalReads].map(([n, prior]): [number, Atom[]] => [n, [prior]]), out)
        byNode([...unit.slices].map(([n, element]): [number, Atom[]] => [n, [elementWidth(element), numberName(element) === 'f64']]), out)
        const nodes = [...unit.nodes].filter(([id]) => keyed(id)).sort((a, b) => a[0] - b[0])
        out.push(nodes.length)
        for (const [id, rep] of nodes) {
            out.push(id)
            if (decoded(id)) {
                out.push('dec')
                if (rep.kind === 'number' && rep.bools) out.push('bool')
                else value(rep, out)
            } else if (moved.has(id)) {
                movedAtoms(rep, entry.includes(id), reduced, boxed, out)
                out.push(wide(id))
            } else {
                node(rep, out)
                out.push(false)
            }
        }
        return out
    }
    const index = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => index.set(unit, i))
    const labels = units.map(unit => {
        const atoms = parts(unit)
        const calls = [...unit.calls.keys()].sort((a, b) => a - b)
        atoms.push(calls.length, ...calls)
        return atoms
    })
    const keys = refineClasses(labels, units.map(unit => [...unit.calls].sort((a, b) => a[0] - b[0]).map(([, set]) => [...set].map(c => index.get(c)!))))
    const classes = new Map<PlannedUnit, number>()
    units.forEach((unit, i) => classes.set(unit, keys[i]))
    if (intrinsics.argv().includes('share-debug')) for (const list of plan.values()) for (const unit of list) console.log('SHARE-PARTS', unit.fn.name, list.indexOf(unit), parts(unit).map(String).join(' '))
    return classes
}

export function shareUnits(plan: Map<Function, PlannedUnit[]>, layoutOf: (shape: string, elements: ElementReads) => number, reduced: (shape: string) => boolean, sites: Map<PlannedUnit, Map<number, Handle>>, abiOf: (unit: PlannedUnit) => Atom[], graphOf: (fn: Function) => Graph): Map<PlannedUnit, PlannedUnit> {
    const classes = shareClasses(plan, layoutOf, reduced, sites, abiOf, graphOf)
    const units = [...plan.values()].flat()
    const shared = new Map<PlannedUnit, PlannedUnit>()
    const kept = new Map<number, PlannedUnit>()
    for (const [fn, list] of plan) plan.set(fn, list.filter(unit => {
        const first = kept.get(classes.get(unit)!)
        if (!first) {
            kept.set(classes.get(unit)!, unit)
            return true
        }
        first.instances.push(...unit.instances)
        shared.set(unit, first)
        return false
    }))
    for (const unit of units) for (const [node, set] of unit.calls) unit.calls.set(node, new Set([...set].map(c => shared.get(c) ?? c)))
    for (const unit of shared.keys()) sites.delete(unit)
    return shared
}

const regionMaps = new WeakMap<Graph, Map<number, number>>()
export function regionRets(g: Graph): Map<number, number> {
    let known = regionMaps.get(g)
    if (known) return known
    known = new Map()
    for (const [root, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.inlined) continue
        const seen = new Set<number>()
        const stack = [getRef(n, 0)]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const m = getNode(g, id)
            if (!m) continue
            if (m.op === NodeOp.ret) known.set(id, root)
            else if (m.op === NodeOp.select) for (let i = 1; i < countIds(m); i++) stack.push(getRef(m, i))
            else if (m.op === NodeOp.after) stack.push(getRef(m, countIds(m) - 1))
            else if (m.op === NodeOp.apply) stack.push(getBlock(g, getRef(m, 0))?.bodyId ?? 0)
        }
    }
    regionMaps.set(g, known)
    return known
}

export type Block = Graph['blocks'][number]

export function effect(op: NodeOp): boolean {
    return op === NodeOp.setProp || op === NodeOp.getProp || op === NodeOp.call || op === NodeOp.rt || op === NodeOp.store || op === NodeOp.load
}

const retLists = new WeakMap<Graph, number[]>()
export function retsOf(g: Graph): number[] {
    let known = retLists.get(g)
    if (!known) {
        known = []
        for (const [id, n] of nodeEntries(g)) {
            if (n.op === NodeOp.ret) known.push(id)
        }
        retLists.set(g, known)
    }
    return known
}

const addressKey = heap.fromJsString('__address')
function addressView(object: ObjectType): boolean {
    return object.state !== undefined && heap.ownPropertyCount(object.state) === 1 && !!heap.getOwnProperty(object.state, addressKey)
}

export function selfOf(g: Graph): number {
    for (const p of g.blocks[0].params) if (isThisParam(getNode(g, p)!)) return p
    return 0
}

export function returnsSelf(g: Graph): boolean {
    const self = selfOf(g)
    for (const n of allNodes(g)) if (n.op === NodeOp.ret && getRef(n, 0) && tailOf(g, getRef(n, 0)) !== self) return false
    return true
}

export function blockOf(g: Graph, id: number): Block | undefined {
    const n = getNode(g, id)
    if (n?.op === NodeOp.ret) {
        const owner = getBlock(g, getRef(n, 1))
        if (owner) return owner
    }
    return g.blocks.find(b => bodyNodes(g, b.bodyId).has(id))
}

const paramSlotMaps = new WeakMap<Graph, Map<number, [Block, number]>>()
function paramSlots(g: Graph): Map<number, [Block, number]> {
    const known = paramSlotMaps.get(g)
    if (known) return known
    const out = new Map<number, [Block, number]>()
    for (const block of g.blocks) block.params.forEach((param, i) => out.set(param, [block, i]))
    paramSlotMaps.set(g, out)
    return out
}

export function predsOf(g: Graph, block: Block): number[] {
    return (usersOf(g).get(block.id) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
}

function successorsOf(g: Graph, block: Block): Block[] {
    const out: Block[] = []
    for (const id of bodyNodes(g, block.bodyId)) {
        const n = getNode(g, id)
        if (n?.op !== NodeOp.apply) continue
        const target = getBlock(g, getRef(n, 0))
        if (target) out.push(target)
    }
    return out
}

export function reaches(g: Graph, from: Block, to: Block): boolean {
    const seen = new Set<number>()
    const work = [from]
    while (work.length) {
        const next = work.pop()!
        if (next.id === to.id) return true
        if (seen.has(next.id)) continue
        seen.add(next.id)
        work.push(...successorsOf(g, next))
    }
    return false
}

function repeats(g: Graph, block: Block, id: number): boolean {
    const guards = armsAt(g, id) ?? []
    for (const member of bodyNodes(g, block.bodyId)) {
        const n = getNode(g, member)
        if (n?.op !== NodeOp.apply) continue
        const other = armsAt(g, member) ?? []
        if (other.some(([cond, positive]) => guards.some(([c, p]) => c === cond && p !== positive))) continue
        const target = getBlock(g, getRef(n, 0))
        if (target && reaches(g, target, block)) return true
    }
    return false
}

export function receiverValue(g: Graph, id: number): boolean {
    const slots = paramSlots(g)
    const seen = new Set<number>()
    const work = [id]
    while (work.length) {
        const value = tailOf(g, work.pop()!)
        if (seen.has(value)) continue
        seen.add(value)
        const n = getNode(g, value)
        const slot = slots.get(value)
        if (n?.op !== NodeOp.param || !slot) return false
        const [block, index] = slot
        const preds = predsOf(g, block)
        if (block === g.blocks[0] && (!isThisParam(n) || preds.length)) return false
        for (const pred of preds) work.push(getRef(getNode(g, pred)!, index + 1))
    }
    return true
}

interface PstackVerdict {
    unit: PlannedUnit
    header: number
    call: number
    ok: number
    loud: number
    why: string[]
}

function pstackList(bits: number): number[] {
    const stacks: number[] = []
    for (let stack = 0; stack < PstackCount; stack++) if (bits & (1 << stack)) stacks.push(stack)
    return stacks
}

interface PstackProgram {
    types: ValueTypes
    units: PlannedUnit[]
    graphOf: (unit: PlannedUnit) => Graph
    unitOfInstance: Map<number, PlannedUnit>
    roots: Set<number>
    holders: Map<number, number[]>
    escaped: Set<number>
}

function pstackRefs(type: Type | undefined): number[] {
    if (!type) return []
    if (!type.closures.length) return type.objects
    return [...type.objects, ...type.closures]
}

function pstackProgram(types: ValueTypes, units: PlannedUnit[], graphOf: (unit: PlannedUnit) => Graph): PstackProgram {
    const unitOfInstance = new Map<number, PlannedUnit>()
    for (const unit of units) for (const f of unit.instances) unitOfInstance.set(f, unit)
    const roots = new Set<number>()
    const escaped = new Set<number>()
    const work: number[] = []
    const why = new Map<number, string>()
    let cause = 'root'
    const escape = (type: Type | undefined) => {
        for (const id of pstackRefs(type)) {
            if (escaped.has(id)) continue
            escaped.add(id)
            why.set(id, cause)
            work.push(id)
        }
    }
    types.instances.forEach((instance, id) => {
        if (instance.sites.some(site => site.instance !== undefined)) return
        roots.add(id)
        escape(instance.returns)
        for (const param of instance.params) escape(param.type)
    })
    for (const unit of units) {
        const g = graphOf(unit)
        const writes: [number, GraphNode][] = []
        for (const [id, n] of nodeEntries(g)) {
            if (n.op === NodeOp.setProp || n.op === NodeOp.store) writes.push([id, n])
            else if (n.op === NodeOp.rt && rt.sliceOf(g, n) === rt.Op.sliceWrite) writes.push([id, n])
            else if (n.op === NodeOp.call && !unit.calls.get(id)?.size) writes.push([id, n])
        }
        if (!writes.length) continue
        for (const f of unit.instances) {
            for (const [id, n] of writes) {
                cause = `${unit.fn.name}%${id}:${opName(n.op)}`
                if (n.op === NodeOp.setProp || n.op === NodeOp.store) {
                    const target = types.typeAt(f, getRef(n, 1))
                    if (!target || !target.objects.length || target.unknown) escape(types.typeAt(f, getRef(n, 3)))
                } else if (n.op === NodeOp.rt) {
                    const target = types.typeAt(f, getRef(n, 2))
                    if (!target || !target.objects.length || target.unknown) escape(types.typeAt(f, getRef(n, 4)))
                } else if (types.typeAt(f, id)) {
                    for (let i = 2; i < countIds(n); i++) escape(types.typeAt(f, getRef(n, i)))
                }
            }
        }
    }
    const holders = new Map<number, number[]>()
    types.objects.forEach((object, id) => {
        for (const field of object.fields.values()) for (const inner of pstackRefs(field.type)) listOf(holders, inner).push(id)
    })
    while (work.length) {
        const next = work.pop()!
        cause = `via O${next}`
        for (const field of types.objects[next].fields.values()) escape(field.type)
    }
    if (intrinsics.argv().includes('pstack-why')) for (const [id, c] of why) console.log(`pstack escaped O${id} ${c}`)
    return { types, units, graphOf, unitOfInstance, roots, holders, escaped }
}

function pstackDemand(g: Graph): Map<number, number[]> {
    const demand = new Map<number, number[]>()
    for (const b of g.blocks) for (const id of bodyNodes(g, b.bodyId)) listOf(demand, id).push(b.id)
    return demand
}

function pstackStaying(g: Graph, members: Set<number>): Set<number> {
    const seen = new Set<number>()
    for (const m of members) {
        for (const p of tailPositions(g, getBlock(g, m)!.bodyId)) {
            const n = getNode(g, p.at)!
            if (n.op !== NodeOp.apply || !members.has(getRef(n, 0))) continue
            const stack = tailRoots(g, p)
            while (stack.length) {
                const id = stack.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const x = getNode(g, id)
                if (!x || x.op === NodeOp.param) continue
                for (let i = 0; i < countIds(x); i++) stack.push(getRef(x, i))
            }
        }
    }
    return seen
}

function pstackBefore(g: Graph, nest: GraphLoops, header: number): Set<number> {
    const before = new Set<number>()
    const work = [g.blocks[0].id]
    while (work.length) {
        const b = work.pop()!
        if (b === header || before.has(b)) continue
        before.add(b)
        for (const t of nest.tailTargets.get(b) ?? []) work.push(t)
    }
    return before
}

interface PstackSummary {
    stacks: number
    need: number[][]
    escaped: number
}

function pstackSummary(): PstackSummary {
    const need: number[][] = []
    while (need.length < PstackCount) need.push([])
    return { stacks: 0, need, escaped: 0 }
}

export interface PstackPlan {
    regions: Map<PlannedUnit, [header: number, call: number, stacks: number[]][]>
    targets: Map<PlannedUnit, Map<number, number>>
}

export function planPstackRegions(types: ValueTypes, units: PlannedUnit[], graphOf: (unit: PlannedUnit) => Graph, debug: boolean): PstackPlan {
    const start = performance.now()
    const PstackScratch = PstackFirst + 1
    const PstackHeld = PstackFirst + 2
    const PstackLasting = PstackFirst + 3
    const P = pstackProgram(types, units, graphOf)
    const programmed = performance.now()
    const succ: number[][] = [[]]
    const pred: number[][] = [[]]
    const instanceOfVertex: number[] = [-1]
    const node = (instance: number): number => {
        succ.push([])
        pred.push([])
        instanceOfVertex.push(instance)
        return succ.length - 1
    }
    const edge = (a: number, b: number) => {
        succ[a].push(b)
        pred[b].push(a)
    }
    const instanceNode = new Map<number, number>()
    for (const unit of units) {
        for (const f of unit.instances) {
            const v = node(-1)
            instanceOfVertex[v] = v
            instanceNode.set(f, v)
        }
    }
    for (const f of P.roots) {
        const v = instanceNode.get(f)
        if (v !== undefined) edge(0, v)
    }
    const callees = new Map<number, Map<number, number[]>>()
    types.instances.forEach((instance, id) => {
        for (const site of instance.sites) if (site.instance !== undefined) listOf(mapOf(callees, site.instance), site.node).push(id)
    })
    const loops: { unit: PlannedUnit, instance: number, header: number, node: number, depth: number }[] = []
    const calls: { unit: PlannedUnit, instance: number, call: number, node: number, loop: number, op: NodeOp }[] = []
    const placeOf = new Map<number, Map<number, number>>()
    const carriedBy = new Map<number, number[]>()
    for (const unit of units) {
        const g = graphOf(unit)
        const nest = graphLoops(g)
        const depthOf = (header: number) => nest.loopsOf.get(header)!.length
        const headers = [...nest.loopMembers.keys()].sort((a, b) => depthOf(a) - depthOf(b))
        const innermost = new Map<number, number>()
        if (headers.length) {
            const demand = pstackDemand(g)
            for (const header of headers) {
                const members = nest.loopMembers.get(header)!
                const before = pstackBefore(g, nest, header)
                for (const id of pstackStaying(g, members)) {
                    const blocks = demand.get(id)
                    if (blocks && blocks.every(b => members.has(b) || !before.has(b))) innermost.set(id, header)
                }
            }
        }
        for (const f of unit.instances) {
            const u = instanceNode.get(f)!
            const loopNode = new Map<number, number>()
            for (const header of headers) {
                let up = u
                let deepest = 0
                for (const outer of nest.loopsOf.get(header)!) {
                    if (outer === header || depthOf(outer) <= deepest) continue
                    deepest = depthOf(outer)
                    up = loopNode.get(outer) ?? up
                }
                const v = node(u)
                edge(up, v)
                loopNode.set(header, v)
                loops.push({ unit, instance: f, header, node: v, depth: depthOf(header) })
                for (const p of getBlock(g, header)!.params) for (const id of pstackRefs(types.typeAt(f, p))) listOf(carriedBy, id).push(up)
            }
            const place = new Map<number, number>()
            for (const [id, header] of innermost) place.set(id, loopNode.get(header)!)
            placeOf.set(f, place)
            const sites = callees.get(f) ?? new Map<number, number[]>()
            const callNodes = new Set<number>([...unit.calls.keys(), ...sites.keys()])
            for (const call of callNodes) {
                const loop = place.get(call) ?? u
                const c = node(u)
                edge(loop, c)
                const site = getNode(g, call)
                calls.push({ unit, instance: f, call, node: c, loop, op: site && getRef(site, 0) ? site.op : NodeOp.void })
                const precise = sites.get(call) ?? []
                for (const callee of precise) {
                    const target = instanceNode.get(callee)
                    if (target !== undefined) edge(c, target)
                }
                for (const callee of unit.calls.get(call) ?? []) {
                    if (callee.instances.some(x => precise.includes(x))) continue
                    for (const x of callee.instances) edge(c, instanceNode.get(x)!)
                }
            }
        }
    }
    const { idom, order } = dominatorTree(v => succ[v].slice(), v => pred[v].length ? pred[v] : [0])
    const depth = new Array<number>(succ.length).fill(1)
    const parent = new Array<number>(succ.length).fill(0)
    depth[0] = 0
    for (const v of order) {
        if (!v) continue
        parent[v] = idom.get(v) ?? 0
        depth[v] = depth[parent[v]] + 1
    }
    const lca = (a: number, b: number): number => {
        if (a < 0) return b
        if (b < 0) return a
        while (a !== b) {
            if (depth[a] >= depth[b]) a = parent[a]
            else b = parent[b]
        }
        return a
    }
    const dominates = (v: number, x: number): boolean => {
        while (depth[x] > depth[v]) x = parent[x]
        return x === v
    }
    const locs: number[][] = []
    types.objects.forEach((object, id) => {
        const list: number[] = []
        if (!object.constant) {
            for (const instance of instancesOf(object)) {
                const unit = P.unitOfInstance.get(instance)
                const at = unit && !object.native && object.site.unit === unit.fn ? placeOf.get(instance)!.get(object.site.node) : undefined
                list.push(at ?? instanceNode.get(instance) ?? 0)
            }
        }
        locs[id] = list.length || object.instances ? list : [0]
    })
    const domOf: number[] = []
    const holderNeed = (id: number): number => {
        if (domOf[id] === undefined) domOf[id] = locs[id].reduce((d, x) => lca(d, x), -1)
        return domOf[id]
    }
    const under = (id: number, site: number) => locs[id].some(x => x === site || !dominates(x, site))
    const loopOf = (call: number) => pred[call][0]
    const freshOf = new Map<number, number[]>()
    for (const site of calls) {
        for (const id of pstackRefs(types.typeAt(site.instance, site.call))) if (under(id, site.node)) listOf(freshOf, id).push(site.node)
    }
    const addNeed = (list: number[], w: number): void => {
        if (w < 0 || list.includes(w)) return
        if (list.length < 4) {
            list.push(w)
            return
        }
        let best = 0
        for (let j = 1; j < list.length; j++) if (depth[lca(list[j], w)] > depth[lca(list[best], w)]) best = j
        list[best] = lca(list[best], w)
    }
    const siteNode = (object: Allocation, instance: number): [PlannedUnit, GraphNode, Graph] | undefined => {
        const unit = P.unitOfInstance.get(instance)
        if (!unit || object.site.unit !== unit.fn) return
        const g = graphOf(unit)
        const n = getNode(g, object.site.node)
        if (n) return [unit, n, g]
    }
    const loopVertices = new Set<number>(loops.map(loop => loop.node))
    const crossesLoop = (from: number, end: number): boolean => {
        let v = from
        while (v !== end) {
            if (loopVertices.has(v)) return true
            v = parent[v]
        }
        return false
    }
    const insideCaller = (I: number, x: number, w: number): boolean => {
        if (w < 0) return true
        if (dominates(I, w)) return !crossesLoop(x, lca(w, x))
        let relevant = false
        for (const s of pred[I]) {
            const J = instanceOfVertex[s]
            if (J < 0) continue
            if (dominates(J, w)) {
                relevant = true
                if (crossesLoop(s, lca(w, s))) return false
            } else if (dominates(w, s)) return false
        }
        return relevant
    }
    const staysWithCaller = (object: Allocation, id: number): boolean => {
        const instances = instancesOf(object)
        const allocating = new Set<number>()
        for (const instance of instances) {
            const v = instanceNode.get(instance)
            if (v !== undefined) allocating.add(v)
        }
        const lifetimes: number[] = []
        for (const holder of P.holders.get(id) ?? []) lifetimes.push(holderNeed(holder))
        for (const up of carriedBy.get(id) ?? []) lifetimes.push(up)
        for (let k = 0; k < locs[id].length; k++) {
            const I = instances[k] === undefined ? undefined : instanceNode.get(instances[k])
            if (I === undefined) return false
            for (const w of lifetimes) if (!insideCaller(I, locs[id][k], w)) return false
        }
        const sites = freshOf.get(id) ?? []
        for (const r of sites) {
            if (succ[r].some(t => allocating.has(t))) continue
            if (succ[r].some(t => sites.some(q => instanceOfVertex[q] === t))) return false
        }
        return true
    }
    const objectIds: number[] = []
    types.objects.forEach((_, id) => objectIds.push(id))
    const needOf: number[] = []
    const ownNeeds: number[][] = []
    const classOf: number[] = []
    for (const scc of stronglyConnected(objectIds, id => P.holders.get(id) ?? [])) {
        let need = -1
        const needs: number[] = []
        for (const id of scc) {
            for (const holder of P.holders.get(id) ?? []) {
                need = lca(lca(need, holderNeed(holder)), needOf[holder] ?? -1)
                addNeed(needs, holderNeed(holder))
                for (const w of ownNeeds[holder] ?? []) addNeed(needs, w)
            }
            for (const up of carriedBy.get(id) ?? []) {
                need = lca(need, up)
                addNeed(needs, up)
            }
            for (const r of freshOf.get(id) ?? []) need = lca(need, loopOf(r))
        }
        let stack = PstackScratch
        for (const id of scc) {
            const object = types.objects[id]
            if (P.escaped.has(id) || need === 0) stack = PstackLasting
            if (stack < PstackHeld && !object.constant && !staysWithCaller(object, id)) stack = PstackHeld
            for (const holder of P.holders.get(id) ?? []) stack = Math.max(stack, classOf[holder] ?? PstackScratch)
        }
        for (const id of scc) {
            needOf[id] = need
            ownNeeds[id] = needs
            classOf[id] = stack
        }
    }
    const targets = new Map<PlannedUnit, Map<number, number>>()
    const placed = (object: Allocation, g: Graph, n: GraphNode): boolean => {
        if (object.kind === AllocKind.buffer && n.op === NodeOp.pstack) return !getRef(n, 1) && getLiteral(g, n, 1) === PstackWildcard
        if (object.kind === AllocKind.buffer) return rt.sliceOf(g, n) === rt.Op.slice
        if (object.kind !== AllocKind.object && object.kind !== AllocKind.array) return false
        if (object.native || object.dynamic || object.copied || object.function !== undefined) return false
        return n.op === NodeOp.heapHandle && !getRef(n, 0)
    }
    types.objects.forEach((object, id) => {
        if (object.constant) return
        for (const instance of instancesOf(object)) {
            const site = siteNode(object, instance)
            if (!site || !placed(object, site[2], site[1])) continue
            const chosen = mapOf(targets, site[0])
            chosen.set(object.site.node, Math.max(chosen.get(object.site.node) ?? PstackScratch, classOf[id]))
        }
    })
    const buffers = [PstackScratch, PstackHeld, PstackLasting]
    const stacksOf = (object: Allocation, instance: number | undefined): number[] => {
        if (object.kind !== AllocKind.buffer && object.dynamic) return []
        const site = instance === undefined ? undefined : siteNode(object, instance)
        const chosen = site && targets.get(site[0])?.get(object.site.node)
        if (chosen !== undefined) return [chosen]
        if (object.kind !== AllocKind.buffer) return [PstackFirst]
        if (!site) return buffers
        if (site[1].op === NodeOp.pstack && !getRef(site[1], 1)) return [getLiteral(site[2], site[1], 1)]
        return buffers
    }
    const own: PstackSummary[] = succ.map(() => pstackSummary())
    const objectStacks: number[] = []
    types.objects.forEach((object, id) => {
        const needs = ownNeeds[id] ?? []
        const instances = instancesOf(object)
        objectStacks[id] = 0
        locs[id].forEach((x, k) => {
            const at = own[x]
            for (const stack of stacksOf(object, instances[k])) {
                at.stacks |= 1 << stack
                objectStacks[id] |= 1 << stack
                if (P.escaped.has(id)) at.escaped |= 1 << stack
                for (const w of needs) addNeed(at.need[stack], w)
            }
        })
    })
    const returned = new Array<number>(succ.length).fill(0)
    for (const [fresh, sites] of freshOf) {
        for (const r of sites) {
            const seen = new Set<number>([fresh])
            const work = [fresh]
            while (work.length) {
                const id = work.pop()!
                returned[r] |= objectStacks[id]
                for (const field of types.objects[id].fields.values()) {
                    for (const held of pstackRefs(field.type)) {
                        if (seen.has(held) || !under(held, r)) continue
                        seen.add(held)
                        work.push(held)
                    }
                }
            }
        }
    }
    const sccOf = new Array<number>(succ.length).fill(-1)
    const recursive: boolean[] = []
    const summary: PstackSummary[] = []
    const all: number[] = []
    for (let v = 0; v < succ.length; v++) all.push(v)
    const sccs = stronglyConnected(all, v => succ[v])
    for (const scc of sccs) {
        const index = summary.length
        for (const v of scc) sccOf[v] = index
        const merged = pstackSummary()
        let cyclic = scc.length > 1
        const absorb = (part: PstackSummary) => {
            merged.stacks |= part.stacks
            merged.escaped |= part.escaped
            for (let stack = 0; stack < PstackCount; stack++) {
                for (const w of part.need[stack]) addNeed(merged.need[stack], w)
            }
        }
        for (const v of scc) {
            absorb(own[v])
            for (const w of succ[v]) {
                if (w === v) cyclic = true
                if (sccOf[w] !== index) absorb(summary[sccOf[w]])
            }
        }
        for (const v of scc) {
            for (let stack = 0; stack < PstackCount; stack++) {
                if (returned[v] & merged.stacks & (1 << stack)) addNeed(merged.need[stack], loopOf(v))
            }
        }
        const below = (c: number): boolean => {
            let x = c
            while (x > 0 && sccOf[x] !== index) x = parent[x]
            return x >= 0 && sccOf[x] === index
        }
        const discharged = (need: number): boolean => {
            if (below(need)) return true
            const home = instanceOfVertex[need]
            if (home < 0 || sccOf[home] === index) return false
            return pred[home].some(c => instanceOfVertex[c] >= 0 && below(c))
        }
        for (let stack = 0; stack < PstackCount; stack++) merged.need[stack] = merged.need[stack].filter(w => !discharged(w))
        summary.push(merged)
        recursive.push(cyclic)
    }
    const verdict = (unit: PlannedUnit, v: number, header: number, call: number): PstackVerdict => {
        const sum = summary[sccOf[v]]
        const region: PstackVerdict = { unit, header, call, ok: 0, loud: 0, why: [] }
        for (let stack = 0; stack < PstackCount; stack++) {
            if (!(sum.stacks & (1 << stack))) continue
            const outside = sum.need[stack].find(need => !dominates(v, need) && !(call !== 0 && succ[v].some(t => dominates(t, need))))
            let reason = ''
            if (recursive[sccOf[v]]) reason = `recursive:${unit.fn.name}`
            else if (stack === PstackLasting) reason = 'lasting'
            else if (sum.escaped & (1 << stack)) reason = 'escapes'
            else if (outside !== undefined) reason = `held:V${outside}`
            region.loud |= 1 << stack
            if (!reason) region.ok |= 1 << stack
            if (debug) region.why.push(`${stack}:${reason || 'ok'}`)
        }
        return region
    }
    const byUnit = new Map<PlannedUnit, Map<number, PstackVerdict>>()
    const regionOf = new Map<number, PstackVerdict>()
    const join = (v: number, region: PstackVerdict): void => {
        const byKey = mapOf(byUnit, region.unit)
        const known = byKey.get(region.call || region.header)
        regionOf.set(v, known ?? region)
        if (!known) {
            byKey.set(region.call || region.header, region)
            return
        }
        const failed = (known.loud & ~known.ok) | (region.loud & ~region.ok)
        known.loud |= region.loud
        known.ok = (known.ok | region.ok) & ~failed
    }
    for (const loop of loops) {
        const region = verdict(loop.unit, loop.node, loop.header, 0)
        if (debug && region.loud) console.log(`pstack loop ${loop.unit.fn.name || '<anon>'} B${loop.header} I${loop.instance} depth ${loop.depth} ${region.why.join(' ')}`)
        join(loop.node, region)
    }
    for (const site of calls) {
        const region = verdict(site.unit, site.node, 0, site.call)
        if (site.op !== NodeOp.call) region.ok = 0
        if (site.op !== NodeOp.call) region.why.push(`site:${opName(site.op)}`)
        if (debug && region.loud) console.log(`pstack call ${site.unit.fn.name || '<anon>'} I${site.instance} %${site.call} -> ${[...site.unit.calls.get(site.call) ?? []].map(c => c.fn.name || '<anon>').join(',')} ${region.why.join(' ')}`)
        join(site.node, region)
    }
    const everyStack = (1 << PstackCount) - 1
    const repeated = new Array<number>(succ.length).fill(0)
    const chosen = new Map<PstackVerdict, number>()
    let i = sccs.length - 1
    while (i >= 0) {
        const scc = sccs[i]
        i--
        if (recursive[sccOf[scc[0]]]) for (const v of scc) repeated[v] = everyStack
        for (const v of scc) {
            const region = regionOf.get(v)
            let spread = repeated[v]
            if (region?.call && region.ok & repeated[v]) chosen.set(region, (chosen.get(region) ?? 0) | (region.ok & repeated[v]))
            if (region?.call) spread &= ~region.ok
            if (region && !region.call) spread = everyStack & ~region.ok
            for (const w of succ[v]) repeated[w] |= spread
        }
    }
    const out = new Map<PlannedUnit, [header: number, call: number, stacks: number[]][]>()
    for (const byKey of byUnit.values()) {
        for (const region of byKey.values()) if (!region.call && region.ok) listOf(out, region.unit).push([region.header, 0, pstackList(region.ok)])
    }
    for (const [region, stacks] of chosen) {
        listOf(out, region.unit).push([0, region.call, pstackList(stacks)])
        if (debug) console.log(`pstack reset ${region.unit.fn.name || '<anon>'} %${region.call} stacks [${pstackList(stacks).join(',')}]`)
    }
    if (debug) for (const [unit, sites] of targets) for (const [node, stack] of sites) console.log(`pstack target ${unit.fn.name || '<anon>'} %${node} stack ${stack}`)
    if (debug) console.log(`pstack time ${(performance.now() - start).toFixed(1)}ms program ${(programmed - start).toFixed(1)}ms units ${units.length} loops ${loops.length} calls ${calls.length} nodes ${succ.length} resets ${chosen.size}`)
    return { regions: out, targets }
}

export function setOf<K, V>(map: Map<K, Set<V>>, k: K): Set<V> {
    let set = map.get(k)
    if (!set) map.set(k, set = new Set())
    return set
}

function rootOf(parent: number[], a: number): number {
    let at = a
    while (parent[at] !== at) {
        parent[at] = parent[parent[at]]
        at = parent[at]
    }
    return at
}

export function listOf<K, V>(map: Map<K, V[]>, k: K): V[] {
    let list = map.get(k)
    if (!list) map.set(k, list = [])
    return list
}

export function mapOf<K, K2, V>(map: Map<K, Map<K2, V>>, k: K): Map<K2, V> {
    let inner = map.get(k)
    if (!inner) map.set(k, inner = new Map())
    return inner
}
