    wordSlots: WordSlot[]
    values: Value[]
    frames: FrameValues[]
    graphs: Map<Function, Graph>
    numeric: Set<number>
    keyHandles: Map<string, Handle>
    consulted: Set<Handle>
}

export const numberKey = '[number]'
export const dynamicKey = '[key]'

export interface AccessHost {
    session: TraceSession
    graphOf(fn: Function): Graph
    functionOf(handle: u32): Function | undefined
    localFunction(symbol: number): Function | undefined
    traceable(fn: Function): boolean
    invariantsOf?(proto: Handle): Invariants | undefined
    constantElements?(state: Handle): Handle[] | undefined
    paramCount?(fn: Function): number | undefined
    bindTarget?(fn: Function, count: number, spread: boolean): Function
    heapValue?(slot: Handle): Handle
    receiverless?(fn: Function): boolean
    isConstructor?(fn: Function): boolean
}

export interface Invariants {
    pairs: [string, string][]
    closure: Set<Function>
}

interface Frame {
    unit: Function
    context: string
    object: number
    receiver?: number
    signature: string[]
    graph: Graph
    facts: UnitFacts
    nodes: Map<number, Set<number>>
}

const maxDepth = 3
const maxSignatures = 16
const maxTuple = 8
const nodeSpan = 2 ** 24

const Types = intrinsics.Types

export function scalarType(T: intrinsics.Types): boolean {
    return T !== Types.u64 && T !== Types.vm_value && T !== Types.ptr && T !== Types.fnptr && T !== Types.usize && T !== Types.void && T !== Types.unknown && T !== Types.handle && T !== Types.unknown_number
}

const MinI64 = -(2 ** 63)
const MaxI64 = 2 ** 63
const MaxU64 = 2 ** 64
const Boundaries: [intrinsics.Types, Interval][] = [
    [Types.u8, [0, 255]], [Types.u16, [0, 65535]], [Types.u32, [0, 2 ** 32 - 1]], [Types.u64, [0, MaxU64]],
    [Types.i8, [-128, 127]], [Types.i16, [-32768, 32767]], [Types.i32, [-(2 ** 31), 2 ** 31 - 1]], [Types.i64, [MinI64, MaxI64]],
]
const U64: Interval = Boundaries[3][1]
const I64: Interval = Boundaries[7][1]

function typeInterval(T: intrinsics.Types): Interval | undefined {
    if (T === Types.bool) return [0, 1]
    if (floating(T) || T === Types.unknown_number) return
    const known = Boundaries.find(([U]) => U === T)
    return known ? known[1] : U64
}

function within(a: Interval, b: Interval): boolean {
    return a[0] >= b[0] && a[1] <= b[1]
}

function wrapped(lo: number, hi: number): Interval {
    if (lo >= 0 && hi <= MaxU64) return [lo, hi]
    if (lo >= MinI64 && hi <= MaxI64) return [lo, hi]
    return lo < 0 ? I64 : U64
}

function boundary(range: Interval): Interval {
    for (const [, bound] of Boundaries) if (within(range, bound)) return bound
    return I64
}

function rangeName(range: Interval): string {
    const exact = Boundaries.find(([, bound]) => bound[0] === range[0] && bound[1] === range[1])
    return exact ? typeName(exact[0]) : `${range[0]}..${range[1]}`
}

function hull(a: Interval | undefined, b: Interval | undefined): Interval | undefined {
    if (!a || !b) return a ?? b
    if (within(b, a)) return a
    if (within(a, b)) return b
    return [Math.min(a[0], b[0]), Math.max(a[1], b[1])]
}

function interval(op: NodeOp, a: Interval, b: Interval): Interval {
    switch (op) {
        case NodeOp.add: return wrapped(a[0] + b[0], a[1] + b[1])
        case NodeOp.sub: return wrapped(a[0] - b[1], a[1] - b[0])
        case NodeOp.subsat: return [Math.max(0, a[0] - b[1]), Math.max(0, a[1] - b[0])]
        case NodeOp.neg: return wrapped(-a[1], -a[0])
        case NodeOp.mul: {
            const corners = [a[0] * b[0], a[0] * b[1], a[1] * b[0], a[1] * b[1]]
            return wrapped(Math.min(...corners), Math.max(...corners))
        }
        case NodeOp.shl: return a[0] >= 0 && b[0] >= 0 && b[1] < 64 ? wrapped(a[0] * 2 ** b[0], a[1] * 2 ** b[1]) : I64
        case NodeOp.shr:
        case NodeOp.ushr:
            if (a[0] >= 0 && b[0] >= 0) return [Math.floor(a[0] / 2 ** Math.min(b[1], 64)), Math.floor(a[1] / 2 ** Math.min(b[0], 64))]
            return op === NodeOp.ushr ? U64 : I64
        case NodeOp.and:
            if (a[0] >= 0 && b[0] >= 0) return [0, Math.min(a[1], b[1])]
            if (a[0] >= 0) return [0, a[1]]
            if (b[0] >= 0) return [0, b[1]]
            return I64
        case NodeOp.or:
        case NodeOp.xor:
            return a[0] >= 0 && b[0] >= 0 ? [0, Math.min(MaxU64, 2 ** Math.ceil(Math.log2(Math.max(a[1], b[1]) + 1)) - 1)] : I64
        case NodeOp.div:
        case NodeOp.rem:
            return a[0] >= 0 && b[0] >= 0 ? [0, a[1]] : I64
        case NodeOp.not: return wrapped(-a[1] - 1, -a[0] - 1)
        case NodeOp.clz: return [0, 64]
    }
    return a[0] >= 0 && b[0] >= 0 ? U64 : I64
}

export interface IntFormat {
    bits: 32 | 64
    signed: boolean
}

function numberText(format: IntFormat | undefined): 'int' | 'i64' | 'f64' {
    return !format ? 'f64' : format.signed ? 'i64' : 'int'
}

export function numberName(rep: Rep | undefined): 'int' | 'i64' | 'f64' | undefined {
    return rep?.kind === 'number' ? numberText(rep.format) : undefined
}

function intFormat(range: Interval): IntFormat {
    const signed = range[0] < 0
    return { bits: within(range, signed ? Boundaries[6][1] : Boundaries[2][1]) ? 32 : 64, signed }
}
const Undefined = 0
const Str = 1
const Unknown = 2
const Interned = 3

export interface Isolated {
    name: string
    proto: Handle
}

function setOf<K, V>(map: Map<K, Set<V>>, k: K): Set<V> {
    let set = map.get(k)
    if (!set) map.set(k, set = new Set())
    return set
}

function rootOf(parent: number[], a: number): number {
    let at = a
    while (parent[at] !== at) {
        parent[at] = parent[parent[at]]
        at = parent[at]
    }
    return at
}

function listOf<K, V>(map: Map<K, V[]>, k: K): V[] {
    let list = map.get(k)
    if (!list) map.set(k, list = [])
    return list
}

function mapOf<K, K2, V>(map: Map<K, Map<K2, V>>, k: K): Map<K2, V> {
    let inner = map.get(k)
    if (!inner) map.set(k, inner = new Map())
    return inner
}

const users = new WeakMap<Graph, { size: number, index: Map<number, [number, number][]> }>()
export function usersOf(g: Graph): Map<number, [number, number][]> {
    const known = users.get(g)
    if (known) {
        intrinsics.assert(known.size === g.nodes.size, `value-types: ${g.name ?? 'graph'} changed after its users were indexed`)
        return known.index
    }
    const index = nodeUsers(g, g.nodes.keys(), true)
    users.set(g, { size: g.nodes.size, index })
    return index
}
function useDominators(g: Graph): { idom: Map<number, number>, order: number[] } {
    const users = usersOf(g)
    const bodyOf = new Map<number, number[]>()
    for (const b of g.blocks) {
        if (!b.bodyId) continue
        listOf(bodyOf, b.bodyId).push(b.id)
    }
    const entries = (block: number) => (users.get(block) ?? []).filter(([u, slot]) => slot === 0 && getNode(g, u)?.op === NodeOp.apply).map(([u]) => u)
    function succs(v: number): number[] {
        const out: number[] = []
        if (v === 0) {
            for (const b of g.blocks) if (!entries(b.id).length) out.push(-b.id)
            for (const id of g.nodes.keys()) if (!users.get(id)?.length && !bodyOf.has(id)) out.push(id)
            return out
        }
        if (v < 0) {
            const body = getBlock(g, -v)?.bodyId
            if (body && g.nodes.has(body)) out.push(body)
            return out
        }
        const n = getNode(g, v)!
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (ref && g.nodes.has(ref)) out.push(ref)
        }
        if (n.op === NodeOp.apply && getBlock(g, getRef(n, 0))) out.push(-getRef(n, 0))
        return out
    }
    function preds(v: number): number[] {
        const out = v < 0 ? entries(-v) : (users.get(v) ?? []).map(([u]) => u)
        if (v > 0) for (const b of bodyOf.get(v) ?? []) out.push(-b)
        if (!out.length) out.push(0)
        return out
    }
    const order: number[] = [0]
    const index = new Map<number, number>([[0, 0]])
    const parent: number[] = [0]
    const path: number[] = [0]
    const pending: number[][] = [succs(0).reverse()]
    while (pending.length) {
        const top = pending[pending.length - 1]
        if (!top.length) {
            path.pop()
            pending.pop()
            continue
        }
        const w = top.pop()!
        if (index.has(w)) continue
        index.set(w, order.length)
        parent.push(path[path.length - 1])
        path.push(order.length)
        order.push(w)
        pending.push(succs(w).reverse())
    }
    const semi = order.map((_, i) => i)
    const ancestor = order.map(() => -1)
    const label = order.map((_, i) => i)
    const dom = order.map(() => 0)
    const bucket: number[][] = order.map(() => [])
    function evaluate(v: number): number {
        if (ancestor[v] === -1) return v
        const chain: number[] = []
        let at = v
        while (ancestor[ancestor[at]] !== -1) {
            chain.push(at)
            at = ancestor[at]
        }
        while (chain.length) {
            const x = chain.pop()!
            const a = ancestor[x]
            if (semi[label[a]] < semi[label[x]]) label[x] = label[a]
            ancestor[x] = ancestor[a]
        }
        return label[v]
    }
    for (let i = order.length - 1; i > 0; i--) {
        for (const p of preds(order[i])) {
            const v = index.get(p)
            if (v === undefined) continue
            const u = evaluate(v)
            if (semi[u] < semi[i]) semi[i] = semi[u]
        }
        bucket[semi[i]].push(i)
        ancestor[i] = parent[i]
        for (const v of bucket[parent[i]]) {
            const u = evaluate(v)
            dom[v] = semi[u] < semi[v] ? u : parent[i]
        }
        bucket[parent[i]] = []
    }
    const idom = new Map<number, number>()
    for (let i = 1; i < order.length; i++) {
        if (dom[i] !== semi[i]) dom[i] = dom[dom[i]]
        idom.set(order[i], order[dom[i]])
    }
    return { idom, order }
}
export interface ArmRecord {
    select: number
    arm: number
    positive: boolean
    order: number
}
interface ArmIndex {
    records: Map<number, ArmRecord[]>
    nearest: Map<number, number>
    parent: Map<number, number>
    chains: Map<number, ArmRecord[]>
    arms: Map<number, [cond: number, positive: boolean][]>
    guards: Map<number, [cond: number, positive: boolean][]>
}
const armIndexes = new WeakMap<Graph, ArmIndex>()
function armIndexOf(g: Graph): ArmIndex {
    const known = armIndexes.get(g)
    if (known) return known
    const records = new Map<number, ArmRecord[]>()
    let order = 0
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.select || countIds(n) !== 3) continue
        for (let slot = 1; slot < 3; slot++) {
            const arm = getRef(n, slot)
            order++
            if (!arm) continue
            const list = records.get(arm)
            const record = { select: id, arm, positive: slot === 1, order }
            if (list) list.push(record)
            else records.set(arm, [record])
        }
    }
    const nearest = new Map<number, number>()
    const parent = new Map<number, number>()
    if (records.size) {
        const { idom, order: preorder } = useDominators(g)
        for (const v of preorder) {
            if (v === 0) continue
            const up = nearest.get(idom.get(v)!)
            const param = v > 0 && getNode(g, v)!.op === NodeOp.param
            if (records.has(v)) {
                nearest.set(v, v)
                if (up !== undefined && !param) parent.set(v, up)
            } else if (up !== undefined && !param) nearest.set(v, up)
        }
        for (const root of records.keys()) if (!nearest.has(root)) nearest.set(root, root)
    }
    const index = { records, nearest, parent, chains: new Map(), arms: new Map(), guards: new Map() }
    armIndexes.set(g, index)
    return index
}
function armChain(g: Graph, root: number): ArmRecord[] {
    const index = armIndexOf(g)
    const climb: number[] = []
    let at: number | undefined = root
    while (at !== undefined && !index.chains.has(at)) {
        climb.push(at)
        at = index.parent.get(at)
    }
    let below = at === undefined ? [] : index.chains.get(at)!
    while (climb.length) {
        const r = climb.pop()!
        const chain = [...below, ...index.records.get(r)!].sort((a, b) => a.order - b.order)
        index.chains.set(r, chain)
        below = chain
    }
    return below
}
function armsAt(g: Graph, node: number): [cond: number, positive: boolean][] | undefined {
    const index = armIndexOf(g)
    const root = index.nearest.get(node)
    if (root === undefined) return
    const known = index.arms.get(root)
    if (known) return known
    const out: [number, boolean][] = []
    for (const record of armChain(g, root)) {
        const cond = getRef(getNode(g, record.select)!, 0)
        if (cond) out.push([cond, record.positive])
    }
    index.arms.set(root, out)
    return out
}
function guardsAt(g: Graph, node: number): [cond: number, positive: boolean][] | undefined {
    const index = armIndexOf(g)
    const root = index.nearest.get(node)
    if (root === undefined) return
    const known = index.guards.get(root)
    if (known) return known
    const out: [number, boolean][] = []
    for (const [arm, polarity] of armsAt(g, node)!) {
        let cond = arm
        let positive = polarity
        for (let c = getNode(g, cond); c?.op === NodeOp.not && getRef(c, 0); c = getNode(g, cond)) {
            cond = getRef(c, 0)
            positive = !positive
        }
        if (comparison(getNode(g, cond)?.op ?? NodeOp.literal)) out.push([cond, positive])
    }
    index.guards.set(root, out)
    return out
}
const bodies = new WeakMap<Graph, Map<number, Set<number>>>()
function bodyNodes(g: Graph, body: number): Set<number> {
    const byGraph = mapOf(bodies, g)
    const known = byGraph.get(body)
    if (known) return known
    const found = new Set<number>()
    const work = [body]
    while (work.length) {
        const id = work.pop()!
        if (found.has(id)) continue
        found.add(id)
        const n = getNode(g, id)
        if (n) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) work.push(getRef(n, i))
    }
    byGraph.set(body, found)
    return found
}
function comparison(op: NodeOp): boolean {
    return op === NodeOp.lt || op === NodeOp.le || op === NodeOp.gt || op === NodeOp.ge || op === NodeOp.eq || op === NodeOp.ne
}

interface RetGuard {
    op: NodeOp
    terms: Term[]
    positive: boolean
}

type Term = { param: number, key?: number } | { literal: number }

interface UnitFacts {
    g: Graph
    users: Map<number, [number, number][]>
    arms?: ArmIndex
    self: number | undefined
    plain: number[]
    calls: number[]
    rts: number[]
    gets: number[]
    exact: Set<number>
    carried: Set<number>
    contexts: number[]
    returnsSelf: boolean
    types: Map<number, intrinsics.Types | undefined>
    canonicals: Map<number, number>
    callFacts: Map<number, Set<string>>
    retGuards: Map<number, RetGuard[]>
}

function literalOperands(n: GraphNode): boolean {
    for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) return false
    return true
}

function arithmetic(n: GraphNode): boolean {
    return NumericOps.has(n.op) || n.op === NodeOp.convert || n.op === NodeOp.bitconvert
}

const unitCache = new WeakMap<Graph, UnitFacts>()
function unitOf(g: Graph): UnitFacts {
    let known = unitCache.get(g)
    if (!known) unitCache.set(g, known = unitFacts(g))
    return known
}

function unitFacts(g: Graph): UnitFacts {
    const params = g.blocks[0].params
    const self = params.find(p => isThisParam(getNode(g, p)!))
    const plain = params.filter(p => p !== self)
    const contexts: number[] = []
    const calls: number[] = []
    const rts: number[] = []
    const gets: number[] = []
    const applies: GraphNode[] = []
    const work: number[] = []
    let returnsSelf = true
    for (const [id, n] of g.nodes) {
        if (n.op === NodeOp.callContext) contexts.push(id)
        if (n.op === NodeOp.call) calls.push(id)
        if (n.op === NodeOp.rt) rts.push(id)
        if (n.op === NodeOp.getProp) gets.push(id)
        if (n.op === NodeOp.apply) applies.push(n)
        if (n.op === NodeOp.ret && getRef(n, 0) && valueTail(g, getRef(n, 0)) !== self) returnsSelf = false
        if ((n.op === NodeOp.load || n.op === NodeOp.store || n.op === NodeOp.getProp || n.op === NodeOp.setProp) && getRef(n, 2)) work.push(getRef(n, 2))
        if (rt.sliceOf(g, n) !== undefined && rt.sliceOf(g, n) !== rt.Op.slice && getRef(n, 3)) work.push(getRef(n, 3))
    }
    const exact = new Set<number>()
    const addressed = new Set<number>()
    while (work.length) {
        const id = work.pop()!
        if (addressed.has(id)) continue
        addressed.add(id)
        if (plain.includes(id)) exact.add(plain.indexOf(id))
        const n = getNode(g, id)
        if (n && (NumericOps.has(n.op) || n.op === NodeOp.after || n.op === NodeOp.convert)) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) work.push(getRef(n, i))
    }
    const dependencies = new Map<number, boolean>()
    function dependsOn(value: number, param: number): boolean {
        const k = value * nodeSpan + param
        const known = dependencies.get(k)
        if (known !== undefined) return known
        const visited = new Set<number>()
        const pending = [value]
        let found = false
        while (pending.length && !found) {
            const id = pending.pop()!
            if (visited.has(id)) continue
            visited.add(id)
            if (id === param) found = true
            const n = getNode(g, id)
            if (n && (arithmetic(n) || n.op === NodeOp.after || n.op === NodeOp.select)) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) pending.push(getRef(n, i))
        }
        dependencies.set(k, found)
        return found
    }
    const carried = new Set<number>()
    for (const n of applies) {
        const targets = getBlock(g, getRef(n, 0))?.params ?? []
        for (let i = 1; i < countIds(n); i++) if (getRef(n, i) && targets[i - 1] !== undefined && dependsOn(getRef(n, i), targets[i - 1])) carried.add(targets[i - 1])
    }
    return { g, users: usersOf(g), self, plain, calls, rts, gets, exact, carried, contexts, returnsSelf, types: new Map(), canonicals: new Map(), callFacts: new Map(), retGuards: new Map() }
}

function armsOf(unit: UnitFacts): ArmIndex {
    if (!unit.arms) unit.arms = armIndexOf(unit.g)
    return unit.arms
}

function nodeType(unit: UnitFacts, node: number): intrinsics.Types | undefined {
    if (unit.types.has(node)) return unit.types.get(node)
    const g = unit.g
    const n = getNode(g, node)
    const T = n && n.op !== NodeOp.param && n.op !== NodeOp.after && n.op !== NodeOp.select && n.op !== NodeOp.inlined ? resultType(g, n) : undefined
    const known = T === Types.u64 && n && n.op !== NodeOp.load && n.op !== NodeOp.convert && n.op !== NodeOp.bitconvert && !NumericOps.has(n.op) ? undefined : T
    unit.types.set(node, known)
    return known
}

function canonical(unit: UnitFacts, id: number): number {
    const known = unit.canonicals.get(id)
    if (known !== undefined) return known
    unit.canonicals.set(id, id)
    const g = unit.g
    const n = getNode(g, id)
    if (n?.op !== NodeOp.getProp || getRef(n, 2)) return id
    const found = priorRead(unit, getRef(n, 0), canonical(unit, getRef(n, 1)), keyLabel(getLiteral(g, n, 2) as Handle))
    const result = typeof found === 'number' ? found : id
    unit.canonicals.set(id, result)
    return result
}

function priorRead(unit: UnitFacts, order: number, object: number, name: string): number | 'entry' | undefined {
    const g = unit.g
    let at = order
    while (at) {
        const m = getNode(g, at)
        if (!m) return
        if (m.op === NodeOp.nilEffect) return getRef(m, 0) === g.blocks[0].id ? 'entry' : undefined
        if (m.op === NodeOp.getProp) {
            if (!getRef(m, 2) && keyLabel(getLiteral(g, m, 2) as Handle) === name && canonical(unit, getRef(m, 1)) === object) return canonical(unit, at)
        } else if (m.op !== NodeOp.setProp || getRef(m, 2) || keyLabel(getLiteral(g, m, 2) as Handle) === name) return
        at = getRef(m, 0)
    }
}

function calleeTerm(unit: UnitFacts, n: GraphNode, i: number): Term | undefined {
    const g = unit.g
    if (!getRef(n, i)) return { literal: getLiteral(g, n, i) }
    const id = getRef(n, i)
    const param = g.blocks[0].params.indexOf(id)
    if (param >= 0) return { param }
    const m = getNode(g, id)
    if (m?.op !== NodeOp.getProp || getRef(m, 2)) return
    const object = g.blocks[0].params.indexOf(getRef(m, 1))
    if (object < 0 || priorRead(unit, getRef(m, 0), getRef(m, 1), keyLabel(getLiteral(g, m, 2) as Handle)) !== 'entry') return
    return { param: object, key: getLiteral(g, m, 2) }
}

function argSlot(call: GraphNode, callee: UnitFacts, param: number): number {
    const p = callee.g.blocks[0].params[param]
    const receiverSlot = call.op === NodeOp.call ? 2 : call.op === NodeOp.getProp || call.op === NodeOp.setProp ? 1 : -1
    const first = call.op === NodeOp.call ? 3 : 2
    return p === callee.self ? receiverSlot : first + callee.plain.indexOf(p)
}

function predicate(op: NodeOp, a: string, b: string, positive: boolean): string {
    switch (op) {
        case NodeOp.lt: return `${positive}<${a},${b}`
        case NodeOp.ge: return `${!positive}<${a},${b}`
        case NodeOp.gt: return `${positive}<${b},${a}`
        case NodeOp.le: return `${!positive}<${b},${a}`
        case NodeOp.eq: return `${positive}=${a < b ? a : b},${a < b ? b : a}`
        default: return `${!positive}=${a < b ? a : b},${a < b ? b : a}`
    }
}

function negated(p: string): string {
    return p.startsWith('true') ? `false${p.slice(4)}` : `true${p.slice(5)}`
}

function callFacts(unit: UnitFacts, call: number): Set<string> {
    const known = unit.callFacts.get(call)
    if (known) return known
    const g = unit.g
    const facts = new Set<string>()
    for (const [cond, positive] of guardsAt(g, call) ?? []) {
        const c = getNode(g, cond)!
        const side = (i: number) => getRef(c, i) ? `n${canonical(unit, getRef(c, i))}` : `#${getLiteral(g, c, i)}`
        facts.add(predicate(c.op, side(0), side(1), positive))
    }
    unit.callFacts.set(call, facts)
    return facts
}

function retGuards(unit: UnitFacts, ret: number): RetGuard[] {
    const known = unit.retGuards.get(ret)
    if (known) return known
    const out: RetGuard[] = []
    for (const [cond, positive] of guardsAt(unit.g, ret) ?? []) {
        const c = getNode(unit.g, cond)!
        const terms = [0, 1].map(i => calleeTerm(unit, c, i))
        if (terms.some(t => !t)) continue
        out.push({ op: c.op, terms: terms.map(t => t!), positive })
    }
    unit.retGuards.set(ret, out)
    return out
}

interface Filter {
    test: string
    positive: boolean
    key?: string
    literal?: number
    when?: boolean
}

type Test = [x: number, filter: Filter]

type Fact = [param: number, filter: Filter]

interface Narrowing {
    own: Map<number, Map<number, [order: number, filter: Filter][]>>
    extras: Map<number, Map<number, [order: number, filter: Filter][]>>
    tested: Set<number>
    combined: Map<number, { pairs: [number, Filter][], filters: Filter[] } | null>
}

interface Accessor {
    kind: 'method' | 'getter' | 'field'
    fn?: Function
    slot?: Handle
    setter?: Function
}

interface SharedFacts {
    keyHandles: Map<string, Handle>
    nameOf(k: Handle): string
    literalFunction(g: Graph, id: number): Function | undefined
    accessorOf(proto: Handle | undefined, k: Handle): Accessor
    setterOf(proto: Handle | undefined, k: Handle): Function | undefined
    indexTrap(proto: Handle | undefined, setter: boolean): Function | undefined
    protoName(proto: Handle | undefined): string
    invariantPairs(proto: Handle): [string, string][] | undefined
    narrowingOf(unit: UnitFacts): Narrowing
    combinedOn(unit: UnitFacts, narrowing: Narrowing, root: number, x: number): { pairs: [number, Filter][], filters: Filter[] } | undefined
    narrowAt(unit: UnitFacts, node: number, x: number): Filter[] | undefined
    initializer(g: Graph, self: number, proto: Handle | undefined): boolean
    killedAfter(g: Graph, call: number, allocated: number, name: string, proto: Handle | undefined, self: boolean): boolean
}

function sharedFacts(host: AccessHost): SharedFacts {
    const keyHandles = new Map<string, Handle>()
    const names = new Map<Handle, string>()
    function nameOf(k: Handle): string {
        const index = heap.keyIndex(k)
        if (index !== undefined) return `[${index}]`
        let name = names.get(k)
        if (name === undefined) names.set(k, name = keyLabel(k))
        keyHandles.set(name, k)
        return name
    }
    const accessors = new Map<string, Accessor>()
    function accessorOf(proto: Handle | undefined, k: Handle): Accessor {
        const id = `${proto}:${k}`
        const known = accessors.get(id)
        if (known) return known
        const addr = proto ? heap.getPropertyDescriptor(proto, k) : 0
        const d = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)) : undefined
        const fn = d ? host.functionOf(d.slot0 as u32) : undefined
        const accessor: Accessor = !d ? { kind: 'field' }
            : d.flags & heap.PropFlags.has_getter ? { kind: 'getter', fn }
            : fn ? { kind: 'method', fn, slot: d.slot0 as Handle } : { kind: 'field' }
        if (d && d.flags & heap.PropFlags.has_setter) accessor.setter = host.functionOf(d.slot1 as u32)
        accessors.set(id, accessor)
        return accessor
    }
    function setterOf(proto: Handle | undefined, k: Handle): Function | undefined {
        return accessorOf(proto, k).setter
    }
    function indexTrap(proto: Handle | undefined, setter: boolean): Function | undefined {
        const proxy = proto ? heap.getPropertyProxy(proto, heap.indexKey(0 as u32)) : 0
        if (!proxy) return
        return host.functionOf((setter ? heap.getProxySetter(proxy) : heap.getProxyGetter(proxy)) as u32)
    }
    const literalFunctions = new Map<Graph, Map<number, Function | null>>()
    function literalFunction(g: Graph, id: number): Function | undefined {
        const functions = mapOf(literalFunctions, g)
        const known = functions.get(id)
        if (known !== undefined) return known ?? undefined
        const found = functionAt(g, id)
        functions.set(id, found ?? null)
        return found
    }
    function functionAt(g: Graph, id: number): Function | undefined {
        const n = getNode(g, id)
        const local = localSymbol(g, n)
        if (local !== undefined) return host.localFunction(local)
        if (n?.op !== NodeOp.heapHandle || getRef(n, 0)) return
        return host.functionOf(getLiteral(g, n, 0) as u32)
    }
    const invariants = new Map<Handle, [string, string][] | null>()
    function invariantPairs(proto: Handle): [string, string][] | undefined {
        const known = invariants.get(proto)
        if (known !== undefined) return known ?? undefined
        const pairs = host.invariantsOf ? host.invariantsOf(proto)?.pairs : undefined
        invariants.set(proto, pairs ?? null)
        return pairs
    }
    function protoName(proto: Handle | undefined): string {
        const ctor = proto ? heap.getOwnProperty(proto, heap.fromJsString('constructor')) : 0
        const fn = ctor ? host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32) : undefined
        return fn?.name || 'Object'
    }
    function negate(tests: Test[]): Test[] {
        return tests.map(([x, filter]) => [x, filter.when === undefined ? { ...filter, positive: !filter.positive } : { ...filter, when: !filter.when }])
    }
    function holding(tests: Test[], truth: boolean): Test[] {
        const out: Test[] = []
        for (const [x, filter] of tests) {
            if (filter.when === undefined) out.push([x, { ...filter, positive: filter.positive === truth }])
            else if (filter.when === truth) out.push([x, { test: filter.test, positive: filter.positive, key: filter.key, literal: filter.literal }])
        }
        return out
    }
    function condition(g: Graph, id: number): Test[] {
        const c = getNode(g, id)
        if (!c) return []
        if (c.op === NodeOp.not) return negate(condition(g, getRef(c, 0)))
        if (c.op === NodeOp.select && countIds(c) === 3 && getRef(c, 0) && !getRef(c, 1) && !getRef(c, 2)) {
            const a = getLiteral(g, c, 1)
            const b = getLiteral(g, c, 2)
            if ((a === 0 && b === 1) || (a === 1 && b === 0)) {
                const inner = condition(g, getRef(c, 0))
                return [[getRef(c, 0), { test: 'falsy', positive: a === 0 }], ...(a === 0 ? negate(inner) : inner)]
            }
        }
        if (c.op === NodeOp.eq || c.op === NodeOp.ne) {
            for (const side of [0, 1]) {
                const inner = getRef(c, side) ? getNode(g, getRef(c, side)) : undefined
                if (inner && !getRef(c, 1 - side) && getLiteral(g, c, 1 - side) === 0 && (comparison(inner.op) || inner.op === NodeOp.not)) {
                    const tests = condition(g, getRef(c, side))
                    return c.op === NodeOp.eq ? negate(tests) : tests
                }
            }
            for (const side of [0, 1]) {
                const t = getRef(c, side) ? getNode(g, getRef(c, side)) : undefined
                const other = 1 - side
                if (t?.op === NodeOp.rt && getLiteral(g, t, 1) === rt.Op.typeof) {
                    const literalName = getRef(c, other) ? getNode(g, getRef(c, other)) : undefined
                    const handle = literalName?.op === NodeOp.heapHandle && !getRef(literalName, 0) ? getLiteral(g, literalName, 0) : getRef(c, other) ? 0 : getLiteral(g, c, other)
                    if (!handle || !heap.isString(handle as Handle)) return []
                    return [[getRef(t, 2), { test: heap.stringToJs(handle as Handle), positive: c.op === NodeOp.eq }]]
                }
                if (t?.op === NodeOp.typeof && getRef(t, 0) && !getRef(c, other) && getLiteral(g, c, other) === Types.f64) return [[getRef(t, 0), { test: 'float', positive: c.op === NodeOp.eq }]]
                if (t?.op === NodeOp.heapHandle && !getRef(t, 0) && !getLiteral(g, t, 0) && countIds(t) === 1 && getRef(c, other)) return [[getRef(c, other), { test: 'undefined', positive: c.op === NodeOp.eq }]]
                if (t?.op === NodeOp.getProp && !getRef(t, 2) && !getRef(c, other)) {
                    const field: Test = [getRef(t, 1), { test: 'field', key: nameOf(getLiteral(g, t, 2) as Handle), literal: getLiteral(g, c, other), positive: c.op === NodeOp.eq }]
                    return getLiteral(g, c, other) === 0 ? [field, [getRef(c, side), { test: 'zero', positive: c.op === NodeOp.eq }]] : [field]
                }
            }
            for (const side of [0, 1]) if (!getRef(c, side) && getLiteral(g, c, side) === 0 && getRef(c, 1 - side)) return [[getRef(c, 1 - side), { test: 'zero', positive: c.op === NodeOp.eq }]]
            return []
        }
        if (comparison(c.op)) return [[id, { test: 'truthy', positive: true }], ...bounded(g, c)]
        if (NumericOps.has(c.op) || c.op === NodeOp.literal) return []
        const tests: Test[] = [[id, { test: 'truthy', positive: true }]]
        if (c.op === NodeOp.getProp && !getRef(c, 2)) tests.push([getRef(c, 1), { test: 'field', key: nameOf(getLiteral(g, c, 2) as Handle), positive: true }])
        if (c.op === NodeOp.call) tests.push(...calleeFacts(g, c))
        return tests
    }
    const summaries = new Map<Graph, Fact[]>()
    function calleeFacts(g: Graph, c: GraphNode): Test[] {
        const literal = literalFunction(g, getRef(c, 1))
        if (!literal || !host.traceable(literal)) return []
        const callee = boundCallee(host, literal, c)
        const calleeGraph = host.graphOf(callee)
        const out: Test[] = []
        for (const [param, filter] of summaryOf(calleeGraph)) {
            const slot = argSlot(c, unitOf(calleeGraph), param)
            if (slot < countIds(c) && getRef(c, slot)) out.push([getRef(c, slot), filter])
        }
        return out
    }
    function summaryOf(g: Graph): Fact[] {
        const known = summaries.get(g)
        if (known) return known
        summaries.set(g, [])
        const params = g.blocks[0].params
        const facts: Fact[] = []
        for (const truth of [true, false]) {
            let met: Test[] | undefined
            for (const r of retsOf(g)) {
                if (regionRets(g).has(r)) continue
                const found = valueFacts(g, r, 0, truth)
                if (found) met = met ? meet(met, found) : found
            }
            const kept = new Set<string>()
            for (const test of met ?? []) {
                const param = params.indexOf(test[0])
                if (param < 0 || kept.has(factKey(test))) continue
                kept.add(factKey(test))
                facts.push([param, { ...test[1], when: truth }])
            }
        }
        summaries.set(g, facts)
        return facts
    }
    function factKey([x, filter]: Test): string {
        return `${x}:${filter.test}:${filter.positive}:${filter.key}:${filter.literal}`
    }
    function meet(a: Test[], b: Test[]): Test[] {
        const keys = new Set(b.map(factKey))
        return a.filter(test => keys.has(factKey(test)))
    }
    function valueFacts(g: Graph, at: number, slot: number, truth: boolean): Test[] | undefined {
        let holder = getNode(g, at)!
        let index = slot
        while (getRef(holder, index) && getNode(g, getRef(holder, index))?.op === NodeOp.after) {
            holder = getNode(g, getRef(holder, index))!
            index = countIds(holder) - 1
        }
        const found = getRef(holder, index) ? refFacts(g, getRef(holder, index), truth) : (getLiteral(g, holder, index) !== 0) === truth ? [] : undefined
        const path = found && pathFacts(g, at)
        return path && [...path, ...found!]
    }
    const truths = new Map<Graph, Map<number, Test[] | null>>()
    function refFacts(g: Graph, id: number, truth: boolean): Test[] | undefined {
        const byGraph = mapOf(truths, g)
        const k = id * 2 + (truth ? 1 : 0)
        const known = byGraph.get(k)
        if (known !== undefined) return known ?? undefined
        byGraph.set(k, [])
        const found = joinedFacts(g, id, truth)
        byGraph.set(k, found ?? null)
        return found
    }
    function joinedFacts(g: Graph, id: number, truth: boolean): Test[] | undefined {
        const n = getNode(g, id)!
        if (n.op === NodeOp.not) return refFacts(g, getRef(n, 0), !truth)
        if (n.op === NodeOp.select && countIds(n) === 3 && getRef(n, 0)) {
            let joined: Test[] | undefined
            for (const arm of [1, 2]) {
                const found = valueFacts(g, id, arm, truth)
                const guard = found && refFacts(g, getRef(n, 0), arm === 1)
                if (!guard) continue
                const armed = [...found!, ...guard]
                joined = joined ? meet(joined, armed) : armed
            }
            return joined
        }
        const param = paramSlots(g).get(id)
        if (!param || param[0] === g.blocks[0]) return holding(condition(g, id), truth)
        let joined: Test[] | undefined
        for (const apply of predsOf(g, param[0])) {
            const found = valueFacts(g, apply, param[1] + 1, truth)
            if (found) joined = joined ? meet(joined, found) : found
        }
        return joined
    }
    function pathFacts(g: Graph, node: number): Test[] | undefined {
        const out: Test[] = []
        for (const [cond, polarity] of armsAt(g, node) ?? []) {
            const found = refFacts(g, cond, polarity)
            if (!found) return
            out.push(...found)
        }
        const block = blockOf(g, node)
        const entry = block ? entryFacts(g, block) : []
        return entry && [...out, ...entry]
    }
    const entries = new Map<Block, Test[] | null>()
    function entryFacts(g: Graph, block: Block): Test[] | undefined {
        if (block === g.blocks[0]) return []
        const known = entries.get(block)
        if (known !== undefined) return known ?? undefined
        entries.set(block, [])
        const preds = predsOf(g, block)
        let joined: Test[] | undefined = preds.length ? undefined : []
        for (const apply of preds) {
            const found = pathFacts(g, apply)
            if (found) joined = joined ? meet(joined, found) : found
        }
        entries.set(block, joined ?? null)
        return joined
    }
    function bounded(g: Graph, c: GraphNode): Test[] {
        const side = getRef(c, 0) ? 0 : 1
        if (!getRef(c, side) || getRef(c, 1 - side)) return []
        const k = getLiteral(g, c, 1 - side)
        const above = (c.op === NodeOp.gt || c.op === NodeOp.ge) === (side === 0)
        const strict = c.op === NodeOp.lt || c.op === NodeOp.gt
        return [[getRef(c, side), { test: 'least', literal: above === strict ? k + 1 : k, positive: above }]]
    }
    const narrowings = new Map<UnitFacts, Narrowing>()
    function narrowingOf(unit: UnitFacts): Narrowing {
        const known = narrowings.get(unit)
        if (known) return known
        const g = unit.g
        const index = armsOf(unit)
        const users = unit.users
        const out: Narrowing = { own: new Map(), extras: new Map(), tested: new Set(), combined: new Map() }
        function panics(arm: number): boolean {
            let at = getNode(g, arm)
            while (at?.op === NodeOp.after) at = getNode(g, getRef(at, countIds(at) - 1))
            return at?.op === NodeOp.panic || at?.op === NodeOp.unreachable
        }
        function ordered(select: number): Set<number> {
            const found = new Set<number>()
            const work = [select]
            while (work.length) {
                const id = work.pop()!
                for (const [u, slot] of users.get(id) ?? []) {
                    const m = getNode(g, u)!
                    const orders = m.op === NodeOp.inlined ? slot === 0 : m.op === NodeOp.after ? slot < countIds(m) - 1 : false
                    if (!orders || found.has(u)) continue
                    found.add(u)
                    work.push(u)
                }
            }
            return found
        }
        function member(node: number, root: number): boolean {
            let at = index.nearest.get(node)
            while (at !== undefined && at !== root) at = index.parent.get(at)
            return at === root
        }
        function add(into: Map<number, Map<number, [number, Filter][]>>, at: number, order: number, held: Test[]): void {
            const byOperand = mapOf(into, at)
            for (const [x, filter] of held) {
                const operand = canonical(unit, x)
                out.tested.add(operand)
                const list = listOf(byOperand, operand)
                list.push([order, filter])
            }
        }
        const tests = new Map<number, Test[]>()
        for (const [root, records] of index.records) {
            for (const record of records) {
                const n = getNode(g, record.select)!
                let known = tests.get(record.select)
                if (!known) tests.set(record.select, known = condition(g, getRef(n, 0)))
                const held = holding(known, record.positive)
                if (!held.length) continue
                add(out.own, root, record.order, held)
                const other = getRef(n, record.positive ? 2 : 1)
                if (!other || !panics(other)) continue
                for (const m of ordered(record.select)) if (!member(m, root)) add(out.extras, m, record.order, held)
            }
        }
        for (const lists of out.extras.values()) for (const list of lists.values()) list.sort((x, y) => x[0] - y[0])
        narrowings.set(unit, out)
        return out
    }
    function combinedOn(unit: UnitFacts, narrowing: Narrowing, root: number, x: number): { pairs: [number, Filter][], filters: Filter[] } | undefined {
        const index = armsOf(unit)
        const climb: number[] = []
        let at: number | undefined = root
        while (at !== undefined && !narrowing.combined.has(at * nodeSpan + x)) {
            climb.push(at)
            at = index.parent.get(at)
        }
        let below = at === undefined ? undefined : narrowing.combined.get(at * nodeSpan + x) ?? undefined
        while (climb.length) {
            const r = climb.pop()!
            const own = narrowing.own.get(r)?.get(x)
            if (own) {
                const pairs = below ? [...below.pairs, ...own].sort((p, q) => p[0] - q[0]) : own
                below = { pairs, filters: pairs.map(([, filter]) => filter) }
            }
            narrowing.combined.set(r * nodeSpan + x, below ?? null)
        }
        return below
    }
    function narrowAt(unit: UnitFacts, node: number, x: number): Filter[] | undefined {
        const narrowing = narrowingOf(unit)
        if (!narrowing.tested.has(x)) return
        const root = armsOf(unit).nearest.get(node)
        const base = root === undefined ? undefined : combinedOn(unit, narrowing, root, x)
        const extra = narrowing.extras.get(node)?.get(x)
        if (!extra) return base?.filters
        return [...base?.pairs ?? [], ...extra].sort((p, q) => p[0] - q[0]).map(([, filter]) => filter)
    }
    const initializers = new Map<Graph, Map<Handle | undefined, boolean>>()
    function initializer(g: Graph, self: number, proto: Handle | undefined): boolean {
        const byGraph = mapOf(initializers, g)
        const known = byGraph.get(proto)
        if (known !== undefined) return known
        const found = initializerOf(g, self, proto)
        byGraph.set(proto, found)
        return found
    }
    function initializerOf(g: Graph, self: number, proto: Handle | undefined): boolean {
        for (const n of g.nodes.values()) {
            if (n.op === NodeOp.call || n.op === NodeOp.static || n.op === NodeOp.inlined) return false
            if (n.op === NodeOp.rt && rt.sliceOf(g, n) === undefined) return false
        }
        for (const [user, slot] of usersOf(g).get(self) ?? []) {
            const m = getNode(g, user)!
            if (m.op === NodeOp.setProp && slot === 1 && !getRef(m, 2) && !setterOf(proto, getLiteral(g, m, 2) as Handle)) continue
            if (m.op === NodeOp.after && slot === countIds(m) - 1) continue
            if (m.op === NodeOp.ret && slot === 0) continue
            return false
        }
        return true
    }
    const kills = new Map<Graph, Map<string, boolean>>()
    function killedAfter(g: Graph, call: number, allocated: number, name: string, proto: Handle | undefined, self: boolean): boolean {
        const byGraph = mapOf(kills, g)
        const id = `${call}:${name}:${self}:${proto}`
        const known = byGraph.get(id)
        if (known !== undefined) return known
        const found = killedOf(g, call, allocated, name, proto, self)
        byGraph.set(id, found)
        return found
    }
    function killedOf(g: Graph, call: number, allocated: number, name: string, proto: Handle | undefined, self: boolean): boolean {
        const c = getNode(g, call)
        if (c?.op !== NodeOp.call || valueTail(g, getRef(c, 2)) !== allocated) return false
        const objects = self ? new Set([allocated, call]) : new Set([allocated])
        const outer = armsAt(g, call) ?? []
        for (const [id, n] of g.nodes) {
            if (n.op !== NodeOp.setProp || getRef(n, 2) || nameOf(getLiteral(g, n, 2) as Handle) !== name) continue
            if (!objects.has(valueTail(g, getRef(n, 1)))) continue
            if (!(armsAt(g, id) ?? []).every(([cond, positive]) => outer.some(([c2, p2]) => c2 === cond && p2 === positive))) continue
            if (unobserved(g, getRef(n, 0), call, objects, proto)) return true
        }
        return false
    }
    function unobserved(g: Graph, from: number, call: number, objects: Set<number>, proto: Handle | undefined): boolean {
        let reached = false
        const visited = new Set<number>()
        const work = [from]
        while (work.length) {
            const id = work.pop()!
            if (!id || visited.has(id)) continue
            visited.add(id)
            if (id === call) {
                reached = true
                continue
            }
            const n = getNode(g, id)
            if (!n) return false
            if (n.op === NodeOp.nilEffect) continue
            if (n.op === NodeOp.after) {
                for (let i = 0; i < countIds(n) - 1; i++) work.push(getRef(n, i))
                continue
            }
            const escapes = (at: number) => !!getRef(n, at) && objects.has(valueTail(g, getRef(n, at)))
            const own = escapes(1)
            if (n.op === NodeOp.setProp) {
                if (escapes(3) || (own && (getRef(n, 2) || setterOf(proto, getLiteral(g, n, 2) as Handle)))) return false
            } else if (n.op === NodeOp.getProp) {
                if (own) return false
            } else if (n.op === NodeOp.store) {
                if (escapes(3)) return false
            } else if (n.op === NodeOp.rt && rt.sliceOf(g, n) !== undefined) {
                if (escapes(4)) return false
            } else if (n.op !== NodeOp.load && n.op !== NodeOp.pstack) return false
            work.push(getRef(n, 0))
        }
        return reached
    }
    return { keyHandles, nameOf, literalFunction, accessorOf, setterOf, indexTrap, protoName, invariantPairs, narrowingOf, combinedOn, narrowAt, initializer, killedAfter }
}

function analyzeValues(roots: Function[], host: AccessHost, isolated?: Isolated): Accesses {
    const { keyHandles, nameOf, literalFunction, accessorOf, setterOf, indexTrap, protoName, invariantPairs, narrowingOf, combinedOn, narrowAt, initializer, killedAfter } = sharedFacts(host)
    const frames: Frame[] = []
    const frameIds = new Map<string, number>()
    const values: Value[] = [{ kind: ValueKind.undefined }, { kind: ValueKind.string }, { kind: ValueKind.unknown }, { kind: ValueKind.string }]
    const valueIds = new Map<string, number>()
    const allocations: Allocation[] = []
    const allocationIds = new Map<string, number>()
    const locations: Location[] = []
    const locationIds = new Map<string, number>()
    const recorded = new Set<string>()
    const touched = new Map<number, Set<number>>()
    const contents = new Map<number, Set<number>>()
    const contentReaders = new Map<number, Set<number>>()
    const fieldsOf = new Map<number, number[]>()
    const copiers = new Map<number, Set<number>>()
    const storedInto = new Map<number, Map<number, [intrinsics.Types | undefined, number]>>()
    const returns = new Map<number, Set<number>>()
    const returnTargets = new Map<number, Set<number>>()
    const returnLocations = new Map<number, Set<number>>()
    const heldStatics = new Map<number, Function>()
    const resultTyped = new Set<number>()
    const retSets = new Map<number, Map<number, Set<number>>>()
    const callSites = new Map<number, Set<number>>()
    const work: number[] = []
    const queued = new Set<number>()
    const stale = new Set<number>()
    const dirty = new Set<number>()
    const added = new Map<number, number[]>()

    const fieldWatchers = new Map<number, Set<number>>()
    function accepts(v: number, filter: Filter, frame: number, x: number): boolean {
        const value = values[v]
        if (value.kind === ValueKind.unknown || value.kind === ValueKind.variable) return true
        if (filter.test === 'field') {
            if (value.kind !== ValueKind.object || value.allocation === undefined || !ownField(value.allocation, filter.key!)) return true
            const loc = location(value.allocation, filter.key!)
            setOf(fieldWatchers, loc).add(key(frame, x))
            const held = setOf(contents, loc)
            const test = (c: number) => filter.literal === undefined ? accepts(c, { test: 'truthy', positive: filter.positive }, frame, x)
                : filter.positive ? values[c].form !== NumberForm.literal || values[c].literal === filter.literal
                : !(values[c].form === NumberForm.literal && values[c].literal === filter.literal)
            return held.size ? [...held].some(test) : test(Undefined)
        }
        switch (filter.test) {
            case 'number': return (value.kind === ValueKind.number) === filter.positive
            case 'float': return (value.kind === ValueKind.number && !integral(v)) === filter.positive
            case 'string': return (value.kind === ValueKind.string || !!value.word) === filter.positive
            case 'undefined': return (value.kind === ValueKind.undefined) === filter.positive
            case 'object': return (value.kind === ValueKind.object) === filter.positive
            case 'function': return (value.kind === ValueKind.function) === filter.positive
            case 'falsy': {
                const falsy = value.kind === ValueKind.undefined || isZero(v)
                const maybeFalsy = falsy || (value.kind === ValueKind.number && value.form !== NumberForm.literal)
                return filter.positive ? maybeFalsy : !falsy
            }
            case 'zero': {
                const zero = isZero(v)
                const maybeZero = zero || (value.kind === ValueKind.number && value.form !== NumberForm.literal)
                return filter.positive ? maybeZero : !zero
            }
            case 'truthy': {
                const falsy = value.kind === ValueKind.undefined || isZero(v)
                const truthy = value.kind !== ValueKind.undefined && !isZero(v)
                const maybeFalsy = falsy || (value.kind === ValueKind.number && value.form !== NumberForm.literal) || value.kind === ValueKind.string
                return filter.positive ? truthy : maybeFalsy
            }
        }
        return true
    }
    function ownField(allocation: number, name: string): boolean {
        const { proto, dynamic } = allocations[allocation]
        if (dynamic || (proto !== undefined && allocatedStates.has(proto))) return false
        const k = keyHandles.get(name)
        if (k === undefined) return !indexTrap(proto, false)
        return accessorOf(proto, k).kind === 'field'
    }
    function addReturns(frame: number, ret: number, incoming: Iterable<number>): void {
        const all = setOf(returns, frame)
        const byRet = mapOf(retSets, frame)
        const set = setOf(byRet, ret)
        const fresh: number[] = []
        for (const v of incoming) {
            all.add(v)
            if (set.has(v)) continue
            set.add(v)
            fresh.push(v)
        }
        if (!fresh.length) return
        for (const loc of returnLocations.get(frame) ?? []) store(loc, fresh)
        for (const target of returnTargets.get(frame) ?? []) {
            if (resultTyped.has(target)) continue
            const [f, c] = parse(target)
            if (!refuted(f, c, frame, ret)) flow(f, c, fresh)
        }
    }
    function returned(frame: number, ret: number, incoming: Iterable<number>): void {
        const region = regionRets(frames[frame].graph).get(ret)
        if (region !== undefined) flow(frame, region, incoming)
        else addReturns(frame, ret, incoming)
    }
    function callerTerm(caller: number, call: GraphNode, term: Term, callee: UnitFacts): string | undefined {
        if ('literal' in term) return `#${term.literal}`
        const unit = frames[caller].facts
        const g = unit.g
        const slot = argSlot(call, callee, term.param)
        if (slot < 0 || slot >= countIds(call)) return
        if (!getRef(call, slot)) return term.key === undefined ? `#${getLiteral(g, call, slot)}` : undefined
        const object = canonical(unit, getRef(call, slot))
        if (term.key === undefined) return `n${object}`
        const name = keyLabel(term.key as Handle)
        const read = priorRead(unit, getRef(call, 0), object, name)
        if (typeof read === 'number') return `n${read}`
        const holder = getNode(g, object)
        if (holder?.op !== NodeOp.getProp || getRef(holder, 2)) return
        const owner = canonical(unit, getRef(holder, 1))
        const path = `${keyLabel(getLiteral(g, holder, 2) as Handle)}.${name}`
        for (const field of equalFields(caller, getRef(holder, 1), path)) {
            const other = priorRead(unit, getRef(call, 0), owner, field)
            if (typeof other === 'number') return `n${other}`
        }
    }
    function equalFields(frame: number, node: number, path: string): string[] {
        if (refuting) setOf(refutationWatchers, key(frame, node)).add(refuting)
        let common: string[] | undefined
        for (const v of valuesAt(frame, node)) {
            const allocation = values[v].allocation
            const proto = allocation !== undefined ? allocations[allocation].proto : undefined
            const pairs = proto ? invariantPairs(proto) : undefined
            if (!pairs) return []
            const fields = pairs.flatMap(([x, y]) => x === path && !y.includes('.') ? [y] : y === path && !x.includes('.') ? [x] : [])
            common = common ? common.filter(f => fields.includes(f)) : fields
        }
        if (common?.length) for (const v of valuesAt(frame, node)) consulted.add(allocations[values[v].allocation!].proto!)
        return common ?? []
    }
    const consulted = new Set<Handle>()
    const refutations = new Map<string, boolean>()
    let refuting: string | undefined
    const refutationWatchers = new Map<number, Set<string>>()
    function recheck(watched: number): void {
        const pending = refutationWatchers.get(watched)
        if (!pending) return
        refutationWatchers.delete(watched)
        for (const entry of pending) {
            const [caller, call, frame, ret] = entry.split('|').map(Number)
            refutations.delete(`${caller}|${call}|${unitIdentity(frames[frame].unit)}|${ret}`)
            if (!refuted(caller, call, frame, ret)) flow(caller, call, retSets.get(frame)?.get(ret) ?? [])
        }
    }
    function refuted(caller: number, call: number, frame: number, ret: number): boolean {
        const previous = refuting
        refuting = `${caller}|${call}|${frame}|${ret}`
        try {
            return refutedAt(caller, call, frame, ret)
        } finally {
            refuting = previous
        }
    }
    function refutedAt(caller: number, call: number, frame: number, ret: number): boolean {
        const k = `${caller}|${call}|${unitIdentity(frames[frame].unit)}|${ret}`
        const known = refutations.get(k)
        if (known !== undefined) return known
        const callNode = getNode(frames[caller].graph, call)!
        const facts = callFacts(frames[caller].facts, call)
        let result = false
        if (facts.size) for (const guard of retGuards(frames[frame].facts, ret)) {
            const sides = guard.terms.map(t => callerTerm(caller, callNode, t, frames[frame].facts))
            if (sides.some(side => side === undefined)) continue
            if (facts.has(negated(predicate(guard.op, sides[0]!, sides[1]!, guard.positive)))) {
                result = true
                break
            }
        }
        refutations.set(k, result)
        return result
    }
    const waiting = new Map<number, Set<number>>()
    const rootStates = new Map<number, boolean>()
    const rootWaiting = new Map<number, Set<number>>()
    const rootChildren = new Map<number, Set<number>>()
    const rootNodes = new Map<number, Set<number>>()
    function holds(frame: number, x: number, filters: Filter[]): boolean {
        const recorded = valuesAt(frame, x)
        return !unrecorded(recorded) && [...recorded].some(v => filters.every(filter => accepts(v, filter, frame, x)))
    }
    function rootOpen(frame: number, root: number): boolean {
        const k = key(frame, root)
        const state = rootStates.get(k)
        if (state !== undefined) return state
        const unit = frames[frame].facts
        const up = armsOf(unit).parent.get(root)
        if (up !== undefined && !rootOpen(frame, up)) {
            setOf(rootChildren, key(frame, up)).add(root)
            rootStates.set(k, false)
            return false
        }
        const narrowing = narrowingOf(unit)
        for (const x of narrowing.own.get(root)?.keys() ?? []) {
            if (holds(frame, x, combinedOn(unit, narrowing, root, x)!.filters)) continue
            setOf(rootWaiting, key(frame, x)).add(root)
            rootStates.set(k, false)
            return false
        }
        rootStates.set(k, true)
        return true
    }
    function retryRoot(frame: number, root: number): void {
        rootStates.delete(key(frame, root))
        if (!rootOpen(frame, root)) return
        const k = key(frame, root)
        const nodes = rootNodes.get(k)
        if (nodes) {
            rootNodes.delete(k)
            for (const node of nodes) seedNode(frame, node)
        }
        const children = rootChildren.get(k)
        if (children) {
            rootChildren.delete(k)
            for (const child of children) retryRoot(frame, child)
        }
    }
    function enabled(frame: number, node: number): boolean {
        const unit = frames[frame].facts
        const narrowing = narrowingOf(unit)
        const root = armsOf(unit).nearest.get(node)
        const extra = narrowing.extras.get(node)
        if (extra) {
            const operands: [number, number][] = []
            for (const [x, list] of extra) operands.push([list[0][0], x])
            let at = root
            while (at !== undefined) {
                for (const [x, list] of narrowing.own.get(at) ?? []) operands.push([list[0][0], x])
                at = armsOf(unit).parent.get(at)
            }
            operands.sort((p, q) => p[0] - q[0])
            const checked = new Set<number>()
            for (const [, x] of operands) {
                if (checked.has(x)) continue
                checked.add(x)
                if (holds(frame, x, narrowAt(unit, node, x)!)) continue
                setOf(waiting, key(frame, x)).add(node)
                return false
            }
            return true
        }
        if (root === undefined || rootOpen(frame, root)) return true
        setOf(rootNodes, key(frame, root)).add(node)
        return false
    }
    function seen(frame: number, user: number, ref: number): Iterable<number> {
        return seenAmong(frame, user, ref, valuesAt(frame, ref))
    }
    function seenAmong(frame: number, user: number, ref: number, set: Iterable<number>): Iterable<number> {
        const filters = narrowAt(frames[frame].facts, user, canonical(frames[frame].facts, ref))
        if (!filters) return set
        return [...set].filter(v => filters.every(filter => accepts(v, filter, frame, ref))).map(v => narrowed(v, filters))
    }
    function nonZero(filter: Filter): boolean {
        if (filter.test === 'truthy') return filter.positive
        return (filter.test === 'zero' || filter.test === 'falsy') && !filter.positive
    }
    function narrowedLeast(low: number, filters: Filter[]): number {
        let out = low
        for (const filter of filters) {
            if (filter.test === 'least' && filter.positive) out = Math.max(out, Math.ceil(filter.literal!))
            else if (nonZero(filter) && low >= 0) out = Math.max(out, 1)
        }
        return out
    }
    function narrowedMost(high: number, filters: Filter[]): number {
        let out = high
        for (const filter of filters) if (filter.test === 'least' && !filter.positive) out = Math.min(out, Math.ceil(filter.literal!) - 1)
        return out
    }
    function narrowed(v: number, filters: Filter[]): number {
        const value = values[v]
        if (value.word && filters.some(filter => filter.positive && filter.test === 'string')) return Str
        if (value.range) {
            const lo = narrowedLeast(value.range[0], filters)
            const hi = narrowedMost(value.range[1], filters)
            if (lo > hi || (lo === value.range[0] && hi === value.range[1])) return v
            return rangeValue([lo, hi], value.word)
        }
        if (value.kind !== ValueKind.variable) return v
        const test = filters.find(filter => filter.positive && filter.test !== 'truthy' && filter.test !== 'field' && filter.test !== 'least')?.test
        if (!test || value.narrow === test) return v
        const base = value.base ?? v
        return intern(`v${base}&${test}`, () => ({ kind: ValueKind.variable, site: value.site, param: value.param, narrow: test, base }))
    }
    function key(frame: number, node: number): number {
        intrinsics.assert(node < nodeSpan)
        return frame * nodeSpan + node
    }
    function parse(k: number): [frame: number, node: number] {
        return [Math.floor(k / nodeSpan), k % nodeSpan]
    }
    function schedule(k: number): void {
        if (queued.has(k)) return
        queued.add(k)
        work.push(k)
    }
    function changed(k: number): void {
        dirty.add(k)
        schedule(k)
    }
    function invalidate(k: number): void {
        stale.add(k)
        schedule(k)
    }
    const none = new Set<number>()
    function valuesAt(frame: number, node: number): Set<number> {
        return frames[frame].nodes.get(node) ?? none
    }
    function literal(value: number): number {
        return intern(`l${value}`, () => ({ kind: ValueKind.number, form: NumberForm.literal, literal: value }))
    }
    function rangeValue(range: Interval, word?: boolean): number {
        if (word) return intern(`w${range[0]}:${range[1]}`, () => ({ kind: ValueKind.number, form: NumberForm.range, range, word }))
        return intern(`r${range[0]}:${range[1]}`, () => ({ kind: ValueKind.number, form: NumberForm.range, range }))
    }
    function floatValue(): number {
        return intern('f', () => ({ kind: ValueKind.number, form: NumberForm.float }))
    }
    function typedValue(T: intrinsics.Types): number {
        const range = typeInterval(T)
        return range ? rangeValue(range, T === Types.u32 || T === Types.u64) : floatValue()
    }
    function isZero(v: number): boolean {
        return values[v].form === NumberForm.literal && values[v].literal === 0
    }
    function integral(v: number): boolean {
        const value = values[v]
        if (value.form === NumberForm.literal) return Number.isInteger(value.literal)
        return value.form === NumberForm.range
    }
    function spanOf(v: number): Interval {
        const value = values[v]
        return value.range ?? [value.literal!, value.literal!]
    }
    function operand(frame: number, node: number, n: GraphNode, i: number): Iterable<number> {
        if (getRef(n, i)) return seen(frame, node, getRef(n, i))
        const value = getLiteral(frames[frame].graph, n, i)
        const index = i === 2 && (n.op === NodeOp.getProp || n.op === NodeOp.setProp) ? heap.keyIndex(value as Handle) : undefined
        return [literal(index ?? value)]
    }
    function typed(incoming: Iterable<number>, T: intrinsics.Types | undefined): Iterable<number> {
        if (T === undefined) return incoming
        if (T === Types.unknown_number) return [...incoming].map(v => opaqueKind(v) ? floatValue() : v)
        if (T === Types.u64 || T === Types.usize || T === Types.ptr) return [...incoming].map(v => opaqueKind(v) ? typedValue(T) : v)
        if (!scalarType(T)) return incoming
        const bound = typeInterval(T)
        return [...incoming].map(v => (values[v].kind === ValueKind.number && !(bound && integral(v) && within(spanOf(v), bound))) || opaqueKind(v) ? typedValue(T) : v)
    }
    function opaqueKind(v: number): boolean {
        return values[v].kind === ValueKind.unknown || values[v].kind === ValueKind.variable
    }
    function variable(site: Site, param?: number): number {
        return intern(`v${unitIdentity(site.unit)}:${param ?? `%${site.node}`}`, () => ({ kind: ValueKind.variable, site, param }))
    }
    const entered = new Set<number>()
    function fold(op: NodeOp, a: number, b: number): number | undefined {
        switch (op) {
            case NodeOp.lt: return a < b ? 1 : 0
            case NodeOp.le: return a <= b ? 1 : 0
            case NodeOp.gt: return a > b ? 1 : 0
            case NodeOp.ge: return a >= b ? 1 : 0
            case NodeOp.eq: return a === b ? 1 : 0
            case NodeOp.ne: return a !== b ? 1 : 0
            case NodeOp.add: return a + b
            case NodeOp.sub: return a - b
            case NodeOp.mul: return a * b
            case NodeOp.shl: return a * 2 ** b
            case NodeOp.and: return a & b
            case NodeOp.or: return a | b
            case NodeOp.xor: return a ^ b
        }
    }
    function comparisonValues(frame: number, node: number, n: GraphNode): number[] {
        const g = frames[frame].graph
        const sides = [0, 1].map(i => getRef(n, i) ? [...seen(frame, node, getRef(n, i))] : [literal(getLiteral(g, n, i))])
        if (sides.some(unrecorded)) return []
        if (sides.every(side => side.length === 1 && values[side[0]].form === NumberForm.literal)) return [literal(fold(n.op, values[sides[0][0]].literal!, values[sides[1][0]].literal!)!)]
        const undefinedOnly = (side: number[]) => side.every(v => values[v].kind === ValueKind.undefined)
        const neverUndefined = (side: number[]) => side.every(v => values[v].kind === ValueKind.object || values[v].kind === ValueKind.function || values[v].kind === ValueKind.string)
        const disjoint = (undefinedOnly(sides[0]) && neverUndefined(sides[1])) || (neverUndefined(sides[0]) && undefinedOnly(sides[1]))
        if (disjoint && (n.op === NodeOp.eq || n.op === NodeOp.ne)) return [literal(n.op === NodeOp.ne ? 1 : 0)]
        return [rangeValue([0, 1])]
    }
    function compareStrings(frame: number, node: number, n: GraphNode): void {
        if (!getRef(n, 0) || !getRef(n, 1)) return
        const sides = [0, 1].map(i => [...seen(frame, node, getRef(n, i))])
        if (!sides.every(side => side.some(v => values[v].kind === ValueKind.string))) return
        if (!sides.some(side => side.includes(Str))) return
        resultTyped.add(key(frame, node))
        bind(frame, node, n, rt.bindingOf(rt.Op.strictEqual)!.impl!, [], 0)
    }
    function testString(frame: number, node: number, n: GraphNode): void {
        if (![...seen(frame, node, getRef(n, 0))].some(v => values[v].kind === ValueKind.string)) return
        resultTyped.add(key(frame, node))
        bind(frame, node, n, rt.bindingOf(rt.Op.truthy)!.impl!, [], 0)
    }
    function truncated(v: number): number {
        const value = values[v]
        if (value.kind !== ValueKind.number || integral(v)) return v
        if (value.form === NumberForm.literal && Number.isSafeInteger(Math.trunc(value.literal!))) return literal(Math.trunc(value.literal!) || 0)
        return rangeValue(I64)
    }
    function operandNumbers(frame: number, node: number, n: GraphNode): number[] {
        const g = frames[frame].graph
        const sets: number[][] = []
        for (let i = 0; i < countIds(n); i++) {
            const operands = getRef(n, i) ? [...seen(frame, node, getRef(n, i))] : [literal(getLiteral(g, n, i))]
            if (!operands.some(v => values[v].kind === ValueKind.number || opaqueKind(v))) return []
            sets.push(BitwiseOps.has(n.op) ? operands.map(truncated) : operands)
        }
        const single = (list: number[]) => list.length === 1 && values[list[0]].form === NumberForm.literal
        if (countIds(n) === 2 && sets.every(single)) {
            const result = fold(n.op, values[sets[0][0]].literal!, values[sets[1][0]].literal!)
            if (result !== undefined && Number.isFinite(result)) return [literal(result)]
        }
        const spans: Interval[] = []
        for (const list of sets) {
            let span: Interval | undefined
            for (const v of list) {
                if (opaqueKind(v)) span = hull(span, [MinI64, MaxU64])
                else if (values[v].kind !== ValueKind.number) continue
                else if (!integral(v)) return [floatValue()]
                else span = hull(span, spanOf(v))
            }
            spans.push(span!)
        }
        let result = interval(n.op, spans[0], spans[spans.length - 1])
        if (n.op === NodeOp.sub) result = [Math.min(result[1], Math.max(result[0], orderedDifference(g, node, n))), result[1]]
        return [rangeValue(sets.every(list => list.length === 1) ? result : boundary(result))]
    }
    function orderedDifference(g: Graph, node: number, n: GraphNode): number {
        if (!getRef(n, 0) || !getRef(n, 1)) return -Infinity
        const unit = unitOf(g)
        const minuend = canonical(unit, getRef(n, 0))
        const subtrahend = canonical(unit, getRef(n, 1))
        if (countedFrom(g, getRef(n, 0), subtrahend)) return 0
        let low = -Infinity
        for (const [cond, positive] of guardsAt(g, node) ?? []) {
            const c = getNode(g, cond)!
            if (c.op === NodeOp.eq || c.op === NodeOp.ne || !getRef(c, 0) || !getRef(c, 1)) continue
            const below = (c.op === NodeOp.gt || c.op === NodeOp.ge) === positive ? 1 : 0
            const strict = (c.op === NodeOp.lt || c.op === NodeOp.gt) === positive
            if (canonical(unit, getRef(c, 1 - below)) === minuend && canonical(unit, getRef(c, below)) === subtrahend) low = Math.max(low, strict ? 1 : 0)
        }
        return low
    }
    function countedFrom(g: Graph, param: number, base: number): boolean {
        const at = paramSlots(g).get(param)
        if (!at) return false
        const arrivals = predsOf(g, at[0])
        if (!arrivals.length) return false
        for (const apply of arrivals) {
            const x = getRef(getNode(g, apply)!, at[1] + 1)
            if (x && canonical(unitOf(g), x) === base) continue
            const step = x ? getNode(g, x) : undefined
            if (step?.op !== NodeOp.add || countIds(step) !== 2) return false
            const self = getRef(step, 0) === param ? 0 : getRef(step, 1) === param ? 1 : -1
            if (self < 0 || getRef(step, 1 - self) || getLiteral(g, step, 1 - self) < 0) return false
        }
        return true
    }
    function opaqueValue(g: Graph, id: number): number {
        const T = resultType(g, getNode(g, id)!)
        if (T === Types.vm_value || T === Types.unknown || T === Types.void) return Unknown
        return typedValue(T)
    }
    function flow(frame: number, node: number, incoming: Iterable<number>): void {
        const set = setOf(frames[frame].nodes, node)
        const k = key(frame, node)
        let fresh: number[] | undefined
        for (const v of typed(incoming, nodeType(frames[frame].facts, node))) {
            if (set.has(v)) continue
            set.add(v)
            fresh ??= listOf(added, k)
            fresh.push(v)
        }
        if (fresh) {
            schedule(k)
            recheck(k)
