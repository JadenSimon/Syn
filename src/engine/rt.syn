/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import { countIds, getLiteral, getOperand, getOperands, makeNode, NodeOp, type NodeSpace } from './graph-node'
import type { GraphNode } from './lowering2'

type Handle = intrinsics.Handle
type usize = u32

const Intrinsics = intrinsics.Intrinsics

export enum Op {
    handleof,
    heapaddr,
    typeof,
    concat,
    addOrConcat,
    toString,
    nullish,
    restIndex,
    paramCount,
    arrayLiteral,
    arrayElement,
    pstackaddr,
    getprop,
    assign,
    create,
    setPrototypeOf,
    hasPrototype,
    strictEqual,
    handleHash,
    ownKeys,
    truthy,
    slice,
    sliceRead,
    sliceWrite,
    compileRegex,
}

Object.freeze(Op)

export const heapOps = new Set<Op>([Op.assign, Op.create, Op.setPrototypeOf, Op.hasPrototype])
export const effectOps = new Set<Op>([Op.assign, Op.create, Op.setPrototypeOf, Op.ownKeys, Op.slice, Op.sliceRead, Op.sliceWrite])
export const sliceOps = new Set<Op>([Op.slice, Op.sliceRead, Op.sliceWrite])
export const earlyCalls = new Set<Op>([Op.concat, Op.arrayLiteral, Op.arrayElement, Op.handleHash])
export const shallowOps = new Set<Op>([Op.typeof, Op.hasPrototype, Op.handleHash])

export function opName(op: Op): string {
    return Object.keys(Op).find(name => (Op as any)[name] === op) ?? `${op}`
}

export const rt = {
    handleof: intrinsics.tagInline((value: any): Handle => Intrinsics.rt(Op.handleof, value) as Handle),
    heapaddr: intrinsics.tagInline((handle: Handle): usize => Intrinsics.rt(Op.heapaddr, handle) as usize),
    typeof: intrinsics.tagInline((value: any): Handle => Intrinsics.rt(Op.typeof, value) as Handle),
    concat: intrinsics.tagInline((lhs: Handle, rhs: Handle): Handle => Intrinsics.rt(Op.concat, lhs, rhs) as Handle),
    addOrConcat: intrinsics.tagInline((lhs: Handle, rhs: Handle): Handle => Intrinsics.rt(Op.addOrConcat, lhs, rhs) as Handle),
    toString: intrinsics.tagInline((cell: Handle): Handle => Intrinsics.rt(Op.toString, cell) as Handle),
    nullish: intrinsics.tagInline((cell: Handle): Handle => Intrinsics.rt(Op.nullish, cell) as Handle),
    restIndex: intrinsics.tagInline((callee: Handle): Handle => Intrinsics.rt(Op.restIndex, callee) as Handle),
    paramCount: intrinsics.tagInline((callee: Handle): Handle => Intrinsics.rt(Op.paramCount, callee) as Handle),
    arrayLiteral: intrinsics.tagInline((length: u32): u32 => Intrinsics.rt(Op.arrayLiteral, length)),
    arrayElement: intrinsics.tagInline((array: u32, index: u32, value: u32): u32 => Intrinsics.rt(Op.arrayElement, array, index, value)),
    pstackaddr: intrinsics.tagInline((word: u32): usize => Intrinsics.rt(Op.pstackaddr, word) as usize),
    getprop: intrinsics.tagInline((obj: u32, key: u32): u32 => Intrinsics.rt(Op.getprop, obj, key)),
    assign: intrinsics.tagInline((target: Handle, source: Handle): Handle => Intrinsics.rt(Op.assign, target, source) as Handle),
    create: intrinsics.tagInline((proto: Handle): Handle => Intrinsics.rt(Op.create, proto) as Handle),
    setPrototypeOf: intrinsics.tagInline((obj: Handle, proto: Handle): Handle => Intrinsics.rt(Op.setPrototypeOf, obj, proto) as Handle),
    hasPrototype: intrinsics.tagInline((obj: Handle, proto: Handle): number => Intrinsics.rt(Op.hasPrototype, obj, proto)),
    handleHash: intrinsics.tagInline((value: any): u32 => Intrinsics.rt(Op.handleHash, value)),
    ownKeys: intrinsics.tagInline((obj: Handle, mode: u32): Handle => Intrinsics.rt(Op.ownKeys, obj, mode) as Handle),
    compileRegex: intrinsics.tagInline((source?: string, flags?: string): (text: string) => boolean => Intrinsics.rt(Op.compileRegex, source, flags) as any),
}

export function sliceOf(g: NodeSpace, n: GraphNode): Op | undefined {
    if (n.op !== NodeOp.rt) return
    const op = getLiteral(g, n, 1)
    return sliceOps.has(op) ? op : undefined
}

export function assignExcluded(g: NodeSpace, n: GraphNode): Handle[] {
    const keys: Handle[] = []
    for (let i = 4; i < countIds(n); i++) keys.push(getLiteral(g, n, i) as Handle)
    return keys
}

export function wordBytes(T: intrinsics.Types): number {
    if (T === intrinsics.Types.vm_value) return 4
    return Math.max(1, intrinsics.intrinsicBitWidth(T) >> 3)
}

export function elementType(g: NodeSpace, n: GraphNode): intrinsics.Types {
    return getLiteral(g, n, countIds(n) - 1)
}

export interface NativeContext {
    runtimeHeapBase(): number
    pstackBase(): number
    add(node: GraphNode): number
}

export interface Binding {
    host?: (...args: any[]) => any
    impl?: Function
    lower?: (g: NodeSpace, n: GraphNode, ctx: NativeContext) => GraphNode
    fold?: (args: Handle[], ctx: FoldContext) => Handle
}

export interface FoldContext {
    fromJsValue(value: any): Handle
}

const bindings: Binding[] = []
const hosts: Record<number, (...args: any[]) => any> = {}
for (const op of Object.values(Op)) {
    if (typeof op === 'number') hosts[op] = () => { throw `rt: ${opName(op)} has no host implementation` }
}
intrinsics.defineRt(hosts)

export function bind(op: Op, binding: Binding): void {
    const known = bindings[op] ??= {}
    if (binding.host) known.host = hosts[op] = binding.host
    if (binding.impl) {
        known.impl = binding.impl
        if (!known.host) hosts[op] = (...args: u32[]) => runImplementation(op, args)
    }
    if (binding.lower) known.lower = binding.lower
    if (binding.fold) {
        const fold = known.fold = binding.fold
        if (!known.host) hosts[op] = (...args: Handle[]) => fold(args, { fromJsValue: hostValue })
    }
}

export function bindingOf(op: Op): Binding | undefined {
    return bindings[op]
}

export function callOf(g: NodeSpace, n: GraphNode, target: number): GraphNode {
    return makeNode(g, NodeOp.call, [getOperand(g, n, 0), target, 0, ...getOperands(g, n).slice(2)])
}

export function lowerNative(g: NodeSpace, n: GraphNode, ctx: NativeContext): GraphNode {
    const op = getLiteral(g, n, 1)
    const lower = bindings[op]?.lower
    if (!lower) throw `rt: ${opName(op)} reached native lowering`
    return lower(g, n, ctx)
}

type Runner = (handle: Handle, args: u32[]) => u32
let runner: Runner | undefined
let linker: ((value: any) => Handle) | undefined
const linked = new Map<Function, Handle>()

export function setRuntimeRunner(run: Runner): void {
    runner = run
}

export function setRuntimeLinker(link: (value: any) => Handle): void {
    linker = link
}

function hostValue(value: any): Handle {
    if (!linker) throw 'rt: no runtime linker'
    return linker(value)
}

export function runImplementation(op: Op, args: u32[]): u32 {
    const fn = bindings[op]?.impl
    if (!fn || !runner || !linker) throw `rt: ${opName(op)} has no implementation to run`
    let handle = linked.get(fn)
    if (handle === undefined) linked.set(fn, handle = linker(fn))
    return runner(handle, args)
}
