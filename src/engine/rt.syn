/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { getLiteral, getOperand, makeNode } from './graph-node'
import type { GraphNode } from './lowering2'

type Handle = intrinsics.Handle
type usize = u32

const Intrinsics = intrinsics.Intrinsics
const Types = intrinsics.Types

export enum Op {
    handleof,
    heapaddr,
    typeof,
    concat,
    addOrConcat,
    toString,
    nullish,
    restArray,
    paramCount,
}

export function opName(op: Op): string {
    return Object.keys(Op).find(name => (Op as any)[name] === op) ?? `${op}`
}

function text(cell: Handle): string {
    if (!cell) return 'undefined'
    if (heap.isBoxedF64(cell)) return String(heap.unboxF64(cell))
    if (heap.isString(cell)) return heap.stringToJs(cell)
    return '[object Object]'
}

function bytecodeOf(callee: Handle) {
    const fn = heap.deref(callee)
    const code = heap.functionBytecode(fn)
    return code === fn ? undefined : heap.FunctionBytecode(heap.resolveHeapCell(code))
}

function concat(lhs: Handle, rhs: Handle): Handle {
    return heap.fromJsString(text(lhs) + text(rhs))
}

const host = {
    [Op.handleof]: (value: any): Handle => value,
    [Op.heapaddr]: (handle: Handle): usize => handle,
    [Op.typeof]: (value: any): Handle => 0 as Handle,
    [Op.concat]: concat,
    [Op.addOrConcat]: (lhs: Handle, rhs: Handle): Handle => heap.isString(lhs) || heap.isString(rhs)
        ? concat(lhs, rhs)
        : heap.boxF64(heap.unboxF64(lhs) + heap.unboxF64(rhs)),
    [Op.toString]: (cell: Handle): Handle => heap.fromJsString(text(cell)),
    [Op.nullish]: (cell: Handle): Handle => heap.boxF64(cell ? 0 : 1),
    [Op.restArray]: (callee: Handle): Handle => bytecodeOf(callee)?.restArray ?? 0 as Handle,
    [Op.paramCount]: (callee: Handle): Handle => heap.boxF64(bytecodeOf(callee)?.paramCount ?? -1),
}
intrinsics.defineRt(host)

function forwarder(op: Op, arity: number): Function {
    switch (arity) {
        case 0: return intrinsics.tagInline(() => Intrinsics.rt(op))
        case 1: return intrinsics.tagInline((a: any) => Intrinsics.rt(op, a))
        case 2: return intrinsics.tagInline((a: any, b: any) => Intrinsics.rt(op, a, b))
        case 3: return intrinsics.tagInline((a: any, b: any, c: any) => Intrinsics.rt(op, a, b, c))
    }
    throw `rt: ${opName(op)} takes ${arity} arguments`
}

type Rt = { [K in keyof typeof Op]: (typeof host)[(typeof Op)[K]] }

export const rt = Object.fromEntries(Object.entries(Op)
    .filter(([, op]) => typeof op === 'number')
    .map(([name, op]) => [name, forwarder(op as Op, host[op as Op].length)])) as Rt

export interface NativeContext {
    runtimeHeapBase(): number
    add(node: GraphNode): number
}

const nativeTransforms: ((n: GraphNode, ctx: NativeContext) => GraphNode)[] = []
nativeTransforms[Op.handleof] = n => makeNode('convert', [getOperand(n, 1)], Types.u32)
nativeTransforms[Op.heapaddr] = (n, ctx) => makeNode('add', [getOperand(n, 1), { literal: ctx.runtimeHeapBase() }], Types.u64)
nativeTransforms[Op.typeof] = (n, ctx) => {
    const tag = ctx.add(makeNode('and', [getOperand(n, 1), { literal: 1 }], Types.u64))
    return makeNode('select', [tag, { literal: heap.fromJsString('object') }, { literal: heap.fromJsString('number') }])
}
nativeTransforms[Op.addOrConcat] = () => { throw 'rt: addOrConcat reached native lowering' }
nativeTransforms[Op.toString] = () => { throw 'rt: toString reached native lowering' }

export function lowerNative(n: GraphNode, ctx: NativeContext): GraphNode {
    return nativeTransforms[getLiteral(n, 0)](n, ctx)
}

export function nativeBinding(op: Op): Function | undefined {
    if (op === Op.concat) return heap.concatStrings
}
