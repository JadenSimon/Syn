/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import * as syscalls from './syscalls'

type usize = u32
type Handle = intrinsics.Handle
type ScId = u16
type EdgeEnumerator = (ptr: usize, index: u32) => Handle
const Types = intrinsics.Types
const slotScale = 8
const slotMask = 0xffff
const scIdMask = 0xffff
const scChunkBytes = 4 * 1024
const accountingCapacity = 16 as u16
const refCountMask = 0x3fffffff
const supportStateMask = 0xc0000000
const supportPending = 0x40000000
const supportDestroying = 0x80000000
const supportDestroyed = 0xc0000000

enum StaticEnumerator {
    none,
    singleEdge,
}

enum ScFlags {
    eternal = 1 << 0,
}

enum ScType {
    general,
    pool,
    branch,
}

interface HeapState {
    scTable: u64
    slabNext: u64
    slabEnd: u64
    nextScId: ScId
    maxScs: ScId
    rootSc: ScId
}

interface BuildState {
    depth: u32
    childCount: u32
}

interface ScHeader {
    owner: Handle
    type: u8
    flags: u8
    depth: u8
    depthExtent: u8
    enumerateEdges: u64
    nextSlot: u16
    capacity: u16
    freeSlot: u16
    cellSlots: u16
    poolStart: u16
    firstChild: ScId
    nextSibling: ScId
}

interface ScCellData {
    header: u64
    localRefs: Handle
    inboundRefs: Handle
    outboundRefs: Handle
    peerRefs: Handle
    localSupport: u8
    supportFlags: u8
    inboundVertical: u16
}

export const Heap = intrinsics.DefineStructView(reify HeapState)
export const Sc = intrinsics.DefineStructView(reify ScHeader)
export const ScCell = intrinsics.DefineStructView(reify ScCellData)
const Build = intrinsics.DefineStructView(reify BuildState)

const heapSize = Heap.sizeof
const scCellSize = ScCell.sizeof
const buildMaxDepth = 32
const buildMaxChildren = 256
const buildFramesOffset = (Build.sizeof + 7) & ~7
const buildChildrenOffset = buildFramesOffset + buildMaxDepth * 8
const buildContextSize = buildChildrenOffset + buildMaxChildren * 4
const heapTableOffset = (heapSize + 7) & ~7
const scHeaderSize = (Sc.sizeof + 7) & ~7

function allocate(bytes: usize): usize {
    const ptr = syscalls.mmap(
        0, bytes,
        syscalls.PROT_READ | syscalls.PROT_WRITE,
        syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
        -1 as any, 0,
    )
    intrinsics.assert((ptr as any) !== -1)
    return ptr
}

function allocateScChunk(heapPtr: usize): usize {
    const heap = Heap(heapPtr)
    const ptr = heap.slabNext as usize
    const next = ptr + scChunkBytes
    intrinsics.assert(next <= heap.slabEnd)
    heap.slabNext = next
    return ptr
}

function getScRaw(heapPtr: usize, id: ScId): usize {
    const heap = Heap(heapPtr)
    intrinsics.assert(id > 0 && id < heap.nextScId)
    return intrinsics.Intrinsics.load(heap.scTable as usize, id * 8, Types.u64) as usize
}

function setScRaw(heapPtr: usize, id: ScId, ptr: usize): void {
    const heap = Heap(heapPtr)
    intrinsics.assert(id > 0 && id < heap.maxScs)
    intrinsics.Intrinsics.store(heap.scTable as usize, id * 8, ptr, Types.u64)
}

function scCellPtr(heapPtr: usize, ptr: usize): usize {
    return resolve(heapPtr, Sc(ptr).owner)
}

intrinsics.tagInline(scCellPtr)

function accountingPtr(heapPtr: usize, handle: Handle): usize {
    return resolve(heapPtr, handle)
}
intrinsics.tagInline(accountingPtr)

function localRefs(heapPtr: usize, ptr: usize): usize {
    return accountingPtr(heapPtr, ScCell(scCellPtr(heapPtr, ptr)).localRefs)
}
intrinsics.tagInline(localRefs)

function inboundRefs(heapPtr: usize, ptr: usize): usize {
    return accountingPtr(heapPtr, ScCell(scCellPtr(heapPtr, ptr)).inboundRefs)
}

function outboundRefs(heapPtr: usize, ptr: usize): usize {
    return accountingPtr(heapPtr, ScCell(scCellPtr(heapPtr, ptr)).outboundRefs)
}

function peerRefs(heapPtr: usize, ptr: usize): usize {
    const handle = ScCell(scCellPtr(heapPtr, ptr)).peerRefs
    intrinsics.assert(handle !== 0)
    return accountingPtr(heapPtr, handle)
}

function ensurePeerRefs(heapPtr: usize, id: ScId, ptr: usize): void {
    const data = ScCell(scCellPtr(heapPtr, ptr))
    if (data.peerRefs !== 0) return
    data.peerRefs = allocBump(id, ptr, accountingCapacity)
}

function hasInlineSupport(heapPtr: usize, handle: Handle): boolean {
    return Sc(getScRaw(heapPtr, handleSc(handle))).type === ScType.branch
}

function inlineSupport(heapPtr: usize, handle: Handle): any {
    return ScCell(resolve(heapPtr, handle))
}
intrinsics.tagInline(inlineSupport)

function supportStateAt(heapPtr: usize, handle: Handle): u32 {
    if (hasInlineSupport(heapPtr, handle)) {
        return ((inlineSupport(heapPtr, handle).supportFlags as u32) << 30) as u32
    }
    const ptr = getScRaw(heapPtr, handleSc(handle))
    return ((sparseCount(inboundRefs(heapPtr, ptr), accountingCapacity, handleSlot(handle)) & supportStateMask) >>> 0) as u32
}

export function supportCount(heapPtr: usize, handle: Handle): u32 {
    if (hasInlineSupport(heapPtr, handle)) {
        const cell = inlineSupport(heapPtr, handle)
        return cell.localSupport + cell.inboundVertical
    }
    const ptr = getScRaw(heapPtr, handleSc(handle))
    const slot = handleSlot(handle)
    return refCount(localRefs(heapPtr, ptr), slot) + refCount(inboundRefs(heapPtr, ptr), slot)
}

export function supportState(heapPtr: usize, handle: Handle): u32 {
    return supportStateAt(heapPtr, handle)
}

function setSupportState(heapPtr: usize, handle: Handle, state: u32): void {
    if (hasInlineSupport(heapPtr, handle)) {
        inlineSupport(heapPtr, handle).supportFlags = state >>> 30
        return
    }
    const ptr = getScRaw(heapPtr, handleSc(handle))
    const refs = inboundRefs(heapPtr, ptr)
    const slot = handleSlot(handle)
    const count = sparseCount(refs, accountingCapacity, slot) & refCountMask
    putSparse(refs, accountingCapacity, slot, count + state)
}

function supportAdded(heapPtr: usize, handle: Handle): void {
    const state = supportStateAt(heapPtr, handle)
    intrinsics.assert(state !== supportDestroying && state !== supportDestroyed)
    if (state === supportPending) setSupportState(heapPtr, handle, 0)
}

function supportRemoved(heapPtr: usize, handle: Handle, eager: boolean): void {
    if (supportCount(heapPtr, handle) !== 0) return
    if (eager) {
        destroyCell(heapPtr, handle)
    } else if (supportStateAt(heapPtr, handle) === 0) {
        setSupportState(heapPtr, handle, supportPending)
    }
}

export function beginDestroy(heapPtr: usize, handle: Handle): boolean {
    if (supportCount(heapPtr, handle) !== 0) return false
    const state = supportStateAt(heapPtr, handle)
    if (state === supportDestroying || state === supportDestroyed) return false
    setSupportState(heapPtr, handle, supportDestroying)
    return true
}

export function finishDestroy(heapPtr: usize, handle: Handle): void {
    intrinsics.assert(supportStateAt(heapPtr, handle) === supportDestroying)
    setSupportState(heapPtr, handle, supportDestroyed)
}

function destroyCellWith(
    heapPtr: usize,
    handle: Handle,
    enumerateEdges: EdgeEnumerator,
): boolean {
    if (!beginDestroy(heapPtr, handle)) return false
    const ptr = resolve(heapPtr, handle)
    for (let index: u32 = 0;; index++) {
        const target = enumerateEdges(ptr, index)
        if (target === 0) break
        removeEdge(heapPtr, handle, target)
    }
    finishDestroy(heapPtr, handle)
    releaseCell(heapPtr, handle)
    return true
}

function destroySingleEdgeCell(heapPtr: usize, handle: Handle): boolean {
    if (!beginDestroy(heapPtr, handle)) return false
    const target = enumerateSingleEdge(resolve(heapPtr, handle), 0)
    if (target !== 0) removeEdge(heapPtr, handle, target)
    finishDestroy(heapPtr, handle)
    releaseCell(heapPtr, handle)
    return true
}

export function destroyCell(heapPtr: usize, handle: Handle): boolean {
    const ptr = getScRaw(heapPtr, handleSc(handle))
    const enumerateEdges = Sc(ptr).enumerateEdges
    if (enumerateEdges === StaticEnumerator.singleEdge) return destroySingleEdgeCell(heapPtr, handle)
    if (enumerateEdges !== 0) return destroyCellWith(heapPtr, handle, enumerateEdges as any)
    if (!beginDestroy(heapPtr, handle)) return false
    finishDestroy(heapPtr, handle)
    releaseCell(heapPtr, handle)
    return true
}

export function initBuild(buildPtr: usize): void {
    const build = Build(buildPtr)
    build.depth = 0
    build.childCount = 0
}

function buildFramePtr(buildPtr: usize, depth: u32): usize {
    return buildPtr + buildFramesOffset + depth * 8
}

function buildChild(buildPtr: usize, index: u32): Handle {
    return intrinsics.Intrinsics.load(buildPtr + buildChildrenOffset, index * 4, Types.u32) as Handle
}

export function beginBuild(heapPtr: usize, buildPtr: usize, scId: ScId, bytes: usize): Handle {
    const build = Build(buildPtr)
    const handle = allocCell(heapPtr, scId, bytes)
    const depth = build.depth
    intrinsics.assert(depth < buildMaxDepth)
    if (depth !== 0) {
        const parent = intrinsics.Intrinsics.load(buildFramePtr(buildPtr, depth - 1), 0, Types.u32) as Handle
        const count = build.childCount
        intrinsics.assert(count < buildMaxChildren)
        intrinsics.Intrinsics.store(buildPtr + buildChildrenOffset, count * 4, handle, Types.u32)
        build.childCount = count + 1
        addEdge(heapPtr, parent, handle)
    }
    const frame = buildFramePtr(buildPtr, depth)
    intrinsics.Intrinsics.store(frame, 0, handle, Types.u32)
    intrinsics.Intrinsics.store(frame, 4, build.childCount, Types.u32)
    build.depth = depth + 1
    return handle
}

function finishBuildWith(
    heapPtr: usize,
    handle: Handle,
    enumerateEdges: EdgeEnumerator,
): void {
    const ptr = resolve(heapPtr, handle)
    for (let index: u32 = 0;; index++) {
        const target = enumerateEdges(ptr, index)
        if (target === 0) break
        addEdge(heapPtr, handle, target)
    }
}

export function finishBuild(heapPtr: usize, buildPtr: usize, handle: Handle): void {
    const build = Build(buildPtr)
    const depth = build.depth - 1
    const frame = buildFramePtr(buildPtr, depth)
    intrinsics.assert((intrinsics.Intrinsics.load(frame, 0, Types.u32) as Handle) === handle)
    const start = intrinsics.Intrinsics.load(frame, 4, Types.u32)
    const end = build.childCount
    const enumerateEdges = Sc(getScRaw(heapPtr, handleSc(handle))).enumerateEdges
    if (enumerateEdges === StaticEnumerator.singleEdge) {
        const target = enumerateSingleEdge(resolve(heapPtr, handle), 0)
        if (target !== 0) addEdge(heapPtr, handle, target)
    } else if (enumerateEdges !== 0) {
        finishBuildWith(heapPtr, handle, enumerateEdges as any)
    }
    for (let i = start; i < end; i++) {
        removeEdge(heapPtr, handle, buildChild(buildPtr, i))
    }
    build.childCount = start
    build.depth = depth
}

function makeHandle(sc: ScId, slot: u16): Handle {
    return (((sc as u32) << 16) + slot) as Handle
}

export function handleSc(handle: Handle): ScId {
    return ((handle >>> 16) & scIdMask) as ScId
}

export function handleSlot(handle: Handle): u16 {
    return (handle & slotMask) as u16
}

export function resolve(heapPtr: usize, handle: Handle): usize {
    const raw = getScRaw(heapPtr, handleSc(handle))
    return raw + scHeaderSize + handleSlot(handle) * slotScale
}

function initSc(ptr: usize, owner: Handle, enumerateEdges: u64, depth: u8, type: ScType): void {
    const sc = Sc(ptr)
    sc.owner = owner
    sc.type = type
    sc.flags = 0
    sc.depth = depth
    sc.depthExtent = 0
    sc.enumerateEdges = enumerateEdges
    sc.nextSlot = 1
    sc.capacity = ((scChunkBytes - scHeaderSize) / slotScale) as u16
    sc.freeSlot = 0
    sc.cellSlots = 0
    sc.poolStart = 0
    sc.firstChild = 0
    sc.nextSibling = 0
}

function initScAccounting(heapPtr: usize, id: ScId, ptr: usize, cellHandle: Handle): void {
    const data = ScCell(resolve(heapPtr, cellHandle))
    data.header = ptr
    const bytes = accountingCapacity * 8
    if (Sc(ptr).type === ScType.branch) {
        data.localRefs = 0 as Handle
        data.inboundRefs = 0 as Handle
    } else {
        data.localRefs = allocCell(heapPtr, id, bytes)
        data.inboundRefs = allocCell(heapPtr, id, bytes)
    }
    data.outboundRefs = Sc(ptr).type === ScType.branch
        ? allocBump(id, ptr, accountingCapacity)
        : allocCell(heapPtr, id, bytes)
    data.peerRefs = 0 as Handle
    data.localSupport = 0
    data.supportFlags = 0
    data.inboundVertical = 0
}

function allocBump(scId: ScId, ptr: usize, slots: u16): Handle {
    const sc = Sc(ptr)
    const start = sc.nextSlot
    intrinsics.assert(slots > 0 && start + slots <= sc.capacity + 1)
    sc.nextSlot = start + slots
    return makeHandle(scId, start)
}

function allocPool(heapPtr: usize, scId: ScId, ptr: usize, slots: u16): Handle {
    const sc = Sc(ptr)
    intrinsics.assert(slots === sc.cellSlots)
    const free = sc.freeSlot
    if (free === 0) return allocBump(scId, ptr, slots)
    const handle = makeHandle(scId, free)
    sc.freeSlot = intrinsics.Intrinsics.load(resolve(heapPtr, handle), 0, Types.u16)
    setSupportState(heapPtr, handle, 0)
    return handle
}

export function allocCell(heapPtr: usize, scId: ScId, bytes: usize): Handle {
    const ptr = getScRaw(heapPtr, scId)
    const sc = Sc(ptr)
    const slots = ((bytes + 7) >> 3) as u16
    if (sc.type === ScType.general) return allocBump(scId, ptr, slots)
    if (sc.type === ScType.pool) return allocPool(heapPtr, scId, ptr, slots)
    if (sc.type === ScType.branch) {
        intrinsics.assert(slots === ((scCellSize + 7) >> 3))
        return allocBump(scId, ptr, slots)
    }
    intrinsics.assert(false)
}

function releaseCell(heapPtr: usize, handle: Handle): void {
    const sc = Sc(getScRaw(heapPtr, handleSc(handle)))
    if (sc.type === ScType.general) return
    if (sc.type === ScType.branch) return
    if (sc.type === ScType.pool) {
        const slot = handleSlot(handle)
        intrinsics.assert(slot >= sc.poolStart && (slot - sc.poolStart) % sc.cellSlots === 0)
        intrinsics.Intrinsics.store(resolve(heapPtr, handle), 0, sc.freeSlot, Types.u16)
        sc.freeSlot = slot
        return
    }
    intrinsics.assert(false)
}

export function createHeap(
    maxScs: ScId,
    enumerateEdges: u64,
): usize {
    intrinsics.assert(maxScs > 1 && (maxScs as any) <= scIdMask)
    const tableBytes = maxScs * 8
    const slabStartOffset = (heapTableOffset + tableBytes + 7) & ~7
    const heapPtr = allocate(slabStartOffset + maxScs * scChunkBytes)
    const heap = Heap(heapPtr)
    heap.scTable = heapPtr + heapTableOffset
    heap.slabNext = heapPtr + slabStartOffset
    heap.slabEnd = heap.slabNext as usize + maxScs * scChunkBytes
    heap.nextScId = 2
    heap.maxScs = maxScs
    heap.rootSc = 1

    const root = allocateScChunk(heapPtr)
    setScRaw(heapPtr, 1, root)
    initSc(root, 0 as Handle, enumerateEdges, 0, ScType.general)
    const rootCell = allocCell(heapPtr, 1, scCellSize)
    Sc(root).owner = rootCell
    initScAccounting(heapPtr, 1, root, rootCell)
    Sc(root).flags = ScFlags.eternal
    return heapPtr
}

function createScWithType(
    heapPtr: usize,
    parentId: ScId,
    enumerateEdges: u64,
    type: ScType,
): ScId {
    const heap = Heap(heapPtr)
    const id = heap.nextScId
    intrinsics.assert(id < heap.maxScs)

    const owner = allocCell(heapPtr, parentId, scCellSize)
    const ptr = allocateScChunk(heapPtr)
    const parent = Sc(getScRaw(heapPtr, parentId))
    ensurePeerRefs(heapPtr, parentId, getScRaw(heapPtr, parentId))
    initSc(ptr, owner, enumerateEdges, parent.depth + 1, type)
    const sc = Sc(ptr)
    sc.nextSibling = parent.firstChild
    parent.firstChild = id
    setScRaw(heapPtr, id, ptr)
    heap.nextScId = id + 1
    initScAccounting(heapPtr, id, ptr, owner)
    if (parent.depthExtent === 0) parent.depthExtent = 1
    return id
}

export function createSc(heapPtr: usize, parentId: ScId, enumerateEdges: u64): ScId {
    return createScWithType(heapPtr, parentId, enumerateEdges, ScType.general)
}

export function createBranchSc(heapPtr: usize, parentId: ScId): ScId {
    return createScWithType(heapPtr, parentId, 0, ScType.branch)
}

function configurePool(heapPtr: usize, id: ScId, cellBytes: usize): ScId {
    const sc = Sc(getScRaw(heapPtr, id))
    const slots = ((cellBytes + 7) >> 3) as u16
    intrinsics.assert(slots > 0)
    sc.type = ScType.pool
    sc.cellSlots = slots
    sc.poolStart = sc.nextSlot
    sc.freeSlot = 0
    return id
}

export function createPoolSc(
    heapPtr: usize,
    parentId: ScId,
    enumerateEdges: u64,
    cellBytes: usize,
): ScId {
    return configurePool(heapPtr, createSc(heapPtr, parentId, enumerateEdges), cellBytes)
}

export function getSc(heapPtr: usize, id: ScId) {
    return Sc(getScRaw(heapPtr, id))
}

export function rootSc(heapPtr: usize): ScId {
    return Heap(heapPtr).rootSc
}

export function scOwner(heapPtr: usize, id: ScId): Handle {
    return Sc(getScRaw(heapPtr, id)).owner
}

export function refSc(heapPtr: usize, id: ScId): void {
    const owner = Sc(getScRaw(heapPtr, id)).owner
    const parentPtr = getScRaw(heapPtr, handleSc(owner))
    addInboundSupport(heapPtr, parentPtr, owner)
}

export function unrefSc(heapPtr: usize, id: ScId): void {
    const owner = Sc(getScRaw(heapPtr, id)).owner
    const parentPtr = getScRaw(heapPtr, handleSc(owner))
    removeInboundSupport(heapPtr, parentPtr, owner, true)
}

export function scDepth(heapPtr: usize, id: ScId): u8 {
    return Sc(getScRaw(heapPtr, id)).depth
}

export function scFlags(heapPtr: usize, id: ScId): u8 {
    return Sc(getScRaw(heapPtr, id)).flags
}

export function scEdgeEnumerator(heapPtr: usize, id: ScId): u64 {
    return Sc(getScRaw(heapPtr, id)).enumerateEdges
}

export function scAddress(heapPtr: usize, id: ScId): usize {
    return getScRaw(heapPtr, id)
}

export function scCellHeader(heapPtr: usize, handle: Handle): usize {
    return ScCell(resolve(heapPtr, handle)).header as usize
}

function refCount(ptr: usize, slot: u16): u32 {
    return sparseCount(ptr, accountingCapacity, slot) & refCountMask
}

function addRef(ptr: usize, slot: u16): u32 {
    const raw = sparseCount(ptr, accountingCapacity, slot)
    const count = raw & refCountMask
    intrinsics.assert(count < refCountMask)
    putSparse(ptr, accountingCapacity, slot, ((raw & supportStateMask) >>> 0) + count + 1)
    return count + 1
}

function removeRef(ptr: usize, slot: u16): u32 {
    const raw = sparseCount(ptr, accountingCapacity, slot)
    const count = raw & refCountMask
    intrinsics.assert(count > 0)
    putSparse(ptr, accountingCapacity, slot, ((raw & supportStateMask) >>> 0) + count - 1)
    return count - 1
}

function addSupportRef(heapPtr: usize, ptr: usize, handle: Handle): u32 {
    const count = addRef(ptr, handleSlot(handle))
    supportAdded(heapPtr, handle)
    return count
}

function removeSupportRef(heapPtr: usize, ptr: usize, handle: Handle, eager: boolean): u32 {
    const count = removeRef(ptr, handleSlot(handle))
    if (count === 0) supportRemoved(heapPtr, handle, eager)
    return count
}

function localCount(heapPtr: usize, ptr: usize, handle: Handle): u32 {
    if (Sc(ptr).type === ScType.branch) return inlineSupport(heapPtr, handle).localSupport
    return refCount(localRefs(heapPtr, ptr), handleSlot(handle))
}

function inboundCount(heapPtr: usize, ptr: usize, handle: Handle): u32 {
    if (Sc(ptr).type === ScType.branch) return inlineSupport(heapPtr, handle).inboundVertical
    return refCount(inboundRefs(heapPtr, ptr), handleSlot(handle))
}

function setLocalCount(heapPtr: usize, ptr: usize, handle: Handle, count: u32): void {
    if (Sc(ptr).type === ScType.branch) {
        intrinsics.assert(count <= 0xff)
        inlineSupport(heapPtr, handle).localSupport = count
        return
    }
    setRefCount(localRefs(heapPtr, ptr), handleSlot(handle), count)
}

function setInboundCount(heapPtr: usize, ptr: usize, handle: Handle, count: u32): void {
    if (Sc(ptr).type === ScType.branch) {
        intrinsics.assert(count <= 0xffff)
        inlineSupport(heapPtr, handle).inboundVertical = count
        return
    }
    setRefCount(inboundRefs(heapPtr, ptr), handleSlot(handle), count)
}

function addLocalCount(heapPtr: usize, ptr: usize, handle: Handle, count: u32): void {
    setLocalCount(heapPtr, ptr, handle, localCount(heapPtr, ptr, handle) + count)
}

function addInboundCount(heapPtr: usize, ptr: usize, handle: Handle, count: u32): void {
    setInboundCount(heapPtr, ptr, handle, inboundCount(heapPtr, ptr, handle) + count)
}

function addLocalSupport(heapPtr: usize, ptr: usize, handle: Handle): u32 {
    if (Sc(ptr).type !== ScType.branch) return addSupportRef(heapPtr, localRefs(heapPtr, ptr), handle)
    const cell = inlineSupport(heapPtr, handle)
    intrinsics.assert(cell.localSupport < 0xff)
    cell.localSupport = cell.localSupport + 1
    supportAdded(heapPtr, handle)
    return cell.localSupport
}

function removeLocalSupport(heapPtr: usize, ptr: usize, handle: Handle, eager: boolean): u32 {
    if (Sc(ptr).type !== ScType.branch) return removeSupportRef(heapPtr, localRefs(heapPtr, ptr), handle, eager)
    const cell = inlineSupport(heapPtr, handle)
    intrinsics.assert(cell.localSupport > 0)
    cell.localSupport = cell.localSupport - 1
    if (cell.localSupport + cell.inboundVertical === 0) supportRemoved(heapPtr, handle, eager)
    return cell.localSupport
}

function addInboundSupport(heapPtr: usize, ptr: usize, handle: Handle): u32 {
    if (Sc(ptr).type !== ScType.branch) return addSupportRef(heapPtr, inboundRefs(heapPtr, ptr), handle)
    const cell = inlineSupport(heapPtr, handle)
    intrinsics.assert(cell.inboundVertical < 0xffff)
    cell.inboundVertical = cell.inboundVertical + 1
    supportAdded(heapPtr, handle)
    return cell.inboundVertical
}

function removeInboundSupport(heapPtr: usize, ptr: usize, handle: Handle, eager: boolean): u32 {
    if (Sc(ptr).type !== ScType.branch) return removeSupportRef(heapPtr, inboundRefs(heapPtr, ptr), handle, eager)
    const cell = inlineSupport(heapPtr, handle)
    intrinsics.assert(cell.inboundVertical > 0)
    cell.inboundVertical = cell.inboundVertical - 1
    if (cell.localSupport + cell.inboundVertical === 0) supportRemoved(heapPtr, handle, eager)
    return cell.inboundVertical
}

function sparseCount(ptr: usize, capacity: u16, key: u32): u32 {
    for (let i: u32 = 0; i < capacity; i++) {
        const offset = i * 8
        const entry = intrinsics.Intrinsics.load(ptr, offset, Types.u32)
        if (entry === key) return intrinsics.Intrinsics.load(ptr, offset + 4, Types.u32)
        if (entry === 0) return 0
    }
    return 0
}

function putSparse(ptr: usize, capacity: u16, key: u32, value: u32): void {
    intrinsics.assert(key > 0)
    for (let i: u32 = 0; i < capacity; i++) {
        const offset = i * 8
        const entry = intrinsics.Intrinsics.load(ptr, offset, Types.u32)
        if (entry === key) {
            intrinsics.Intrinsics.store(ptr, offset + 4, value, Types.u32)
            return
        }
        if (entry === 0) {
            intrinsics.Intrinsics.store(ptr, offset, key, Types.u32)
            intrinsics.Intrinsics.store(ptr, offset + 4, value, Types.u32)
            return
        }
    }
    intrinsics.assert(false)
}

function addSparse(ptr: usize, capacity: u16, key: u32): u32 {
    for (let i: u32 = 0; i < capacity; i++) {
        const offset = i * 8
        const entry = intrinsics.Intrinsics.load(ptr, offset, Types.u32)
        if (entry === key) {
            const count = intrinsics.Intrinsics.load(ptr, offset + 4, Types.u32) + 1
            intrinsics.Intrinsics.store(ptr, offset + 4, count, Types.u32)
            return count
        }
        if (entry === 0) {
            intrinsics.Intrinsics.store(ptr, offset, key, Types.u32)
            intrinsics.Intrinsics.store(ptr, offset + 4, 1, Types.u32)
            return 1
        }
    }
    intrinsics.assert(false)
}

function removeSparse(ptr: usize, capacity: u16, key: u32): u32 {
    for (let i: u32 = 0; i < capacity; i++) {
        const offset = i * 8
        const entry = intrinsics.Intrinsics.load(ptr, offset, Types.u32)
        if (entry === 0) break
        if (entry !== key) continue
        const count = intrinsics.Intrinsics.load(ptr, offset + 4, Types.u32)
        intrinsics.assert(count > 0)
        intrinsics.Intrinsics.store(ptr, offset + 4, count - 1, Types.u32)
        return count - 1
    }
    intrinsics.assert(false)
}

function sparseEntries(ptr: usize): [u32, u32][] {
    const result: [u32, u32][] = []
    for (let i: u32 = 0; i < accountingCapacity; i++) {
        const offset = i * 8
        const key = intrinsics.Intrinsics.load(ptr, offset, Types.u32)
        if (key === 0) break
        const value = intrinsics.Intrinsics.load(ptr, offset + 4, Types.u32)
        if (value !== 0) result.push([key, value])
    }
    return result
}

function addSparseCount(ptr: usize, key: u32, count: u32): void {
    const current = sparseCount(ptr, accountingCapacity, key)
    putSparse(ptr, accountingCapacity, key, current + count)
}

function setRefCount(ptr: usize, slot: u16, count: u32): void {
    const raw = sparseCount(ptr, accountingCapacity, slot)
    putSparse(ptr, accountingCapacity, slot, ((raw & supportStateMask) >>> 0) + count)
}

function peerKey(from: u16, to: u16): u32 {
    return ((from as u32) << 16) + to
}

function parentSc(sc: any): ScId {
    return handleSc(sc.owner)
}

intrinsics.tagInline(parentSc)

function edgeBoundary(heapPtr: usize, sourceId: ScId, targetId: ScId): u32 {
    let left = sourceId
    let right = targetId
    while (left !== right) {
        const a = Sc(getScRaw(heapPtr, left))
        const b = Sc(getScRaw(heapPtr, right))
        const ap = parentSc(a)
        const bp = parentSc(b)
        if (ap === bp) return ((right as u32) << 16) + left
        if (a.depth > b.depth) {
            left = ap
        } else if (b.depth > a.depth) {
            right = bp
        } else {
            left = ap
            right = bp
        }
    }
    return ((right as u32) << 16) + left
}

function addOutboundPath(heapPtr: usize, sourceId: ScId, boundary: u32, target: Handle): boolean {
    const end = (boundary & slotMask) as ScId
    let current = sourceId
    for (;;) {
        const ptr = getScRaw(heapPtr, current)
        const sc = Sc(ptr)
        if (addSparse(outboundRefs(heapPtr, ptr), accountingCapacity, target) !== 1) return false
        if (current === end) return true
        current = parentSc(sc)
    }
}

function removeOutboundPath(heapPtr: usize, sourceId: ScId, boundary: u32, target: Handle): boolean {
    const end = (boundary & slotMask) as ScId
    let current = sourceId
    for (;;) {
        const ptr = getScRaw(heapPtr, current)
        const sc = Sc(ptr)
        if (removeSparse(outboundRefs(heapPtr, ptr), accountingCapacity, target) !== 0) return false
        if (current === end) return true
        current = parentSc(sc)
    }
}

function addInboundPath(heapPtr: usize, targetId: ScId, end: ScId, target: Handle, includeEnd: boolean): Handle {
    let current = targetId
    let projected = target
    while (current !== end) {
        const ptr = getScRaw(heapPtr, current)
        const sc = Sc(ptr)
        addInboundSupport(heapPtr, ptr, projected)
        projected = sc.owner
        current = parentSc(sc)
    }
    if (includeEnd) {
        const ptr = getScRaw(heapPtr, current)
        addInboundSupport(heapPtr, ptr, projected)
    }
    return projected
}

function removeInboundPath(
    heapPtr: usize,
    targetId: ScId,
    end: ScId,
    target: Handle,
    eager: boolean,
): Handle {
    let current = targetId
    let projected = target
    while (current !== end) {
        const ptr = getScRaw(heapPtr, current)
        const sc = Sc(ptr)
        removeInboundSupport(heapPtr, ptr, projected, eager)
        projected = sc.owner
        current = parentSc(sc)
    }
    return projected
}

export function addEdge(heapPtr: usize, from: Handle, to: Handle): void {
    const fromId = handleSc(from)
    const toId = handleSc(to)
    intrinsics.assert(fromId > 0 && toId > 0)
    const fromPtr = getScRaw(heapPtr, fromId)
    if (fromId === toId) {
        addLocalSupport(heapPtr, fromPtr, to)
        return
    }

    const boundary = edgeBoundary(heapPtr, fromId, toId)
    const boundaryFrom = (boundary & slotMask) as ScId
    const boundaryTo = (boundary >>> 16) as ScId
    if (!addOutboundPath(heapPtr, fromId, boundary, to)) return
    const commonBoundary = boundaryFrom === boundaryTo
    const target = addInboundPath(heapPtr, toId, boundaryTo, to, !commonBoundary)
    if (commonBoundary) {
        const common = getScRaw(heapPtr, boundaryTo)
        addLocalSupport(heapPtr, common, target)
        return
    }

    const left = Sc(getScRaw(heapPtr, boundaryFrom))
    const right = Sc(getScRaw(heapPtr, boundaryTo))
    const parentId = parentSc(left)
    intrinsics.assert(parentId > 0 && parentId === parentSc(right))
    const parentPtr = getScRaw(heapPtr, parentId)
    const fromSlot = handleSlot(left.owner)
    const toSlot = handleSlot(right.owner)
    const peers = addSparse(peerRefs(heapPtr, parentPtr), accountingCapacity, peerKey(fromSlot, toSlot))
    if (peers === 1) addLocalSupport(heapPtr, parentPtr, right.owner)
}

function removeEdgeWith(heapPtr: usize, from: Handle, to: Handle, eager: boolean): void {
    const fromId = handleSc(from)
    const toId = handleSc(to)
    intrinsics.assert(fromId > 0 && toId > 0)
    const fromPtr = getScRaw(heapPtr, fromId)
    if (fromId === toId) {
        removeLocalSupport(heapPtr, fromPtr, to, eager)
        return
    }

    const boundary = edgeBoundary(heapPtr, fromId, toId)
    const boundaryFrom = (boundary & slotMask) as ScId
    const boundaryTo = (boundary >>> 16) as ScId
    if (!removeOutboundPath(heapPtr, fromId, boundary, to)) return
    const commonBoundary = boundaryFrom === boundaryTo
    const target = removeInboundPath(heapPtr, toId, boundaryTo, to, eager)
    if (!commonBoundary) {
        const ptr = getScRaw(heapPtr, boundaryTo)
        removeInboundSupport(heapPtr, ptr, target, eager)
    }
    if (commonBoundary) {
        const common = getScRaw(heapPtr, boundaryTo)
        removeLocalSupport(heapPtr, common, target, eager)
        return
    }

    const left = Sc(getScRaw(heapPtr, boundaryFrom))
    const right = Sc(getScRaw(heapPtr, boundaryTo))
    const parentId = parentSc(left)
    intrinsics.assert(parentId > 0 && parentId === parentSc(right))
    const parentPtr = getScRaw(heapPtr, parentId)
    const fromSlot = handleSlot(left.owner)
    const toSlot = handleSlot(right.owner)
    const peers = removeSparse(peerRefs(heapPtr, parentPtr), accountingCapacity, peerKey(fromSlot, toSlot))
    if (peers === 0) removeLocalSupport(heapPtr, parentPtr, right.owner, eager)
}

export function removeEdge(heapPtr: usize, from: Handle, to: Handle): void {
    removeEdgeWith(heapPtr, from, to, true)
}

export function removeEdgeDeferred(heapPtr: usize, from: Handle, to: Handle): void {
    removeEdgeWith(heapPtr, from, to, false)
}

export function localRefCount(heapPtr: usize, handle: Handle): u32 {
    const ptr = getScRaw(heapPtr, handleSc(handle))
    return localCount(heapPtr, ptr, handle)
}

export function inboundRefCount(heapPtr: usize, handle: Handle): u32 {
    const ptr = getScRaw(heapPtr, handleSc(handle))
    return inboundCount(heapPtr, ptr, handle)
}

export function outboundRefCount(heapPtr: usize, from: Handle, to: Handle): u32 {
    const ptr = getScRaw(heapPtr, handleSc(from))
    return sparseCount(outboundRefs(heapPtr, ptr), accountingCapacity, to)
}

export function peerRefCount(heapPtr: usize, parentId: ScId, fromOwner: Handle, toOwner: Handle): u32 {
    const ptr = getScRaw(heapPtr, parentId)
    return sparseCount(
        peerRefs(heapPtr, ptr),
        accountingCapacity,
        peerKey(handleSlot(fromOwner), handleSlot(toOwner)),
    )
}

function isBelow(heapPtr: usize, id: ScId, ancestor: ScId): boolean {
    let current = id
    while (current !== 0) {
        if (current === ancestor) return true
        const parent = parentSc(Sc(getScRaw(heapPtr, current)))
        if (parent === current) return false
        current = parent
    }
    return false
}

function childScs(heapPtr: usize, parentId: ScId): ScId[] {
    const children: ScId[] = []
    let child = Sc(getScRaw(heapPtr, parentId)).firstChild
    while (child !== 0) {
        children.push(child)
        child = Sc(getScRaw(heapPtr, child)).nextSibling
    }
    return children
}

function bumpDepth(heapPtr: usize, id: ScId): void {
    const sc = Sc(getScRaw(heapPtr, id))
    sc.depth = sc.depth + 1
    let child = sc.firstChild
    while (child !== 0) {
        const next = Sc(getScRaw(heapPtr, child)).nextSibling
        bumpDepth(heapPtr, child)
        child = next
    }
}

function removeBoundarySupport(heapPtr: usize, sourceId: ScId, target: Handle): void {
    const targetId = handleSc(target)
    const boundary = edgeBoundary(heapPtr, sourceId, targetId)
    const boundaryFrom = (boundary & slotMask) as ScId
    const boundaryTo = (boundary >>> 16) as ScId
    const commonBoundary = boundaryFrom === boundaryTo
    const projected = removeInboundPath(heapPtr, targetId, boundaryTo, target, false)
    if (commonBoundary) {
        const ptr = getScRaw(heapPtr, boundaryTo)
        removeLocalSupport(heapPtr, ptr, projected, false)
        return
    }
    const boundaryPtr = getScRaw(heapPtr, boundaryTo)
    removeInboundSupport(heapPtr, boundaryPtr, projected, false)
    const left = Sc(getScRaw(heapPtr, boundaryFrom))
    const right = Sc(getScRaw(heapPtr, boundaryTo))
    const parentId = parentSc(left)
    const parentPtr = getScRaw(heapPtr, parentId)
    const peers = removeSparse(peerRefs(heapPtr, parentPtr), accountingCapacity,
        peerKey(handleSlot(left.owner), handleSlot(right.owner)))
    if (peers === 0) removeLocalSupport(heapPtr, parentPtr, right.owner, false)
}

export function mergeGroup(heapPtr: usize, parentId: ScId, group: ScId[]): ScId {
    intrinsics.assert(group.length > 1)
    const parentPtr = getScRaw(heapPtr, parentId)
    const parent = Sc(parentPtr)
    const groupIds = new Set<number>(group)
    const oldOwners = new Map<number, Handle>()
    const oldSlots = new Map<number, u16>()
    const oldLocal = new Map<number, u32>()
    const oldInbound = new Map<number, u32>()
    const outboundByChild = new Map<number, [u32, u32][]>()
    for (const id of group) {
        const sc = Sc(getScRaw(heapPtr, id))
        intrinsics.assert(parentSc(sc) === parentId)
        oldOwners.set(id, sc.owner)
        const slot = handleSlot(sc.owner)
        oldSlots.set(id, slot)
        oldLocal.set(id, localCount(heapPtr, parentPtr, sc.owner))
        oldInbound.set(id, inboundCount(heapPtr, parentPtr, sc.owner))
        outboundByChild.set(id, sparseEntries(outboundRefs(heapPtr, getScRaw(heapPtr, id))))
    }
    const parentPeers = sparseEntries(peerRefs(heapPtr, parentPtr))
    const wrapperId = createBranchSc(heapPtr, parentId)
    const wrapperPtr = getScRaw(heapPtr, wrapperId)
    const wrapper = Sc(wrapperPtr)
    const wrapperSlot = handleSlot(wrapper.owner)
    ensurePeerRefs(heapPtr, wrapperId, wrapperPtr)
    let child = wrapper.nextSibling
    let parentTail = wrapperId
    wrapper.nextSibling = 0
    while (child !== 0) {
        const childSc = Sc(getScRaw(heapPtr, child))
        const next = childSc.nextSibling
        if (groupIds.has(child)) {
            childSc.nextSibling = wrapper.firstChild
            wrapper.firstChild = child
        } else {
            Sc(getScRaw(heapPtr, parentTail)).nextSibling = child
            parentTail = child
            childSc.nextSibling = 0
        }
        child = next
    }
    const newOwners = new Map<number, Handle>()
    const oldSlotToId = new Map<number, number>()
    for (const id of group) oldSlotToId.set(oldSlots.get(id)!, id)

    for (const id of group) {
        const sc = Sc(getScRaw(heapPtr, id))
        const oldOwner = oldOwners.get(id)!
        const oldData = ScCell(resolve(heapPtr, oldOwner))
        const newOwner = allocCell(heapPtr, wrapperId, scCellSize)
        const data = ScCell(resolve(heapPtr, newOwner))
        data.header = oldData.header
        data.localRefs = oldData.localRefs
        data.inboundRefs = oldData.inboundRefs
        data.outboundRefs = oldData.outboundRefs
        data.peerRefs = oldData.peerRefs
        data.localSupport = 0
        data.supportFlags = oldData.supportFlags
        data.inboundVertical = 0
        sc.owner = newOwner
        newOwners.set(id, newOwner)
        bumpDepth(heapPtr, id)
    }

    const parentPeerPtr = peerRefs(heapPtr, parentPtr)
    const wrapperPeerPtr = peerRefs(heapPtr, wrapperPtr)
    let wrapperSupport: u32 = 0
    const incomingPeer = new Map<number, u32>()
    for (const [key, count] of parentPeers) {
        const fromSlot = (key >>> 16) as u16
        const toSlot = (key & slotMask) as u16
        const fromId = oldSlotToId.get(fromSlot)
        const toId = oldSlotToId.get(toSlot)
        if (!fromId && !toId) continue
        putSparse(parentPeerPtr, accountingCapacity, key, 0)
        if (fromId && toId) {
            addSparseCount(wrapperPeerPtr,
                peerKey(handleSlot(newOwners.get(fromId)!), handleSlot(newOwners.get(toId)!)), count)
            addLocalCount(heapPtr, wrapperPtr, newOwners.get(toId)!, 1)
            incomingPeer.set(toId, (incomingPeer.get(toId) ?? 0) + 1)
        } else if (toId) {
            const key = peerKey(fromSlot, wrapperSlot)
            const existing = sparseCount(parentPeerPtr, accountingCapacity, key)
            addSparseCount(parentPeerPtr, key, count)
            addInboundCount(heapPtr, wrapperPtr, newOwners.get(toId)!, count)
            if (existing === 0) wrapperSupport++
            incomingPeer.set(toId, (incomingPeer.get(toId) ?? 0) + 1)
        } else {
            addSparseCount(parentPeerPtr, peerKey(wrapperSlot, toSlot), count)
        }
    }

    for (const id of group) {
        const vertical = oldInbound.get(id)!
        const remainder = oldLocal.get(id)! - (incomingPeer.get(id) ?? 0)
        setLocalCount(heapPtr, parentPtr, oldOwners.get(id)!, 0)
        setInboundCount(heapPtr, parentPtr, oldOwners.get(id)!, 0)
        if (vertical) {
            addInboundCount(heapPtr, wrapperPtr, newOwners.get(id)!, vertical)
            addInboundCount(heapPtr, parentPtr, wrapper.owner, vertical)
        }
        if (remainder) {
            addInboundCount(heapPtr, wrapperPtr, newOwners.get(id)!, remainder)
            wrapperSupport += remainder
        }
    }
    if (wrapperSupport) addLocalCount(heapPtr, parentPtr, wrapper.owner, wrapperSupport)

    const targetSources = new Map<number, number>()
    const wrapperOutboundPtr = outboundRefs(heapPtr, wrapperPtr)
    for (const id of group) {
        for (const [target, count] of outboundByChild.get(id)!) {
            if (!count) continue
            let internal = false
            const targetId = handleSc(target as Handle)
            for (const member of group) {
                if (isBelow(heapPtr, targetId, member)) { internal = true; break }
            }
            if (internal) continue
            addSparseCount(wrapperOutboundPtr, target, 1)
            targetSources.set(target, (targetSources.get(target) ?? 0) + 1)
        }
    }
    for (const [target, sources] of targetSources) {
        const boundary = edgeBoundary(heapPtr, wrapperId, handleSc(target as Handle))
        if ((boundary & slotMask) !== wrapperId) continue
        for (let i = 1; i < sources; i++) removeBoundarySupport(heapPtr, wrapperId, target as Handle)
    }

    let extent: u8 = 0
    for (const id of group) {
        const child = Sc(getScRaw(heapPtr, id))
        const value = child.depthExtent + 1
        if (value > extent) extent = value
    }
    wrapper.depthExtent = extent
    if (wrapper.depthExtent + 1 > parent.depthExtent) parent.depthExtent = wrapper.depthExtent + 1
    return wrapperId
}

export function condense(heapPtr: usize, parentId: ScId, useAll: boolean): ScId[] {
    const parentPtr = getScRaw(heapPtr, parentId)
    const parent = Sc(parentPtr)
    const children = childScs(heapPtr, parentId)
    const buckets = new Map<number, ScId[]>()
    for (const id of children) {
        const child = Sc(getScRaw(heapPtr, id))
        if (useAll) continue
        const vertical = inboundCount(heapPtr, parentPtr, child.owner) !== 0
        const depth = vertical
            ? (child.depthExtent as number) - (parent.depthExtent as number)
            : child.depthExtent as number
        const bucket = buckets.get(depth) ?? []
        bucket.push(id)
        buckets.set(depth, bucket)
    }
    let selected = children
    if (!useAll) {
        selected = []
        let bestDepth = 0
        for (const [depth, bucket] of buckets) {
            if (selected.length === 0 || bucket.length > selected.length
                || (bucket.length === selected.length && depth < bestDepth)) {
                selected = bucket.slice()
                bestDepth = depth
            }
        }
        for (const [depth, bucket] of buckets) {
            if (depth === bestDepth) continue
            if (bestDepth >= 0 && depth < 0) continue
            if (depth < bestDepth) selected.push(...bucket)
        }
    }
    if (selected.length < 2) return []

    const selectedSet = new Set<number>(selected)
    const slotToChild = new Map<number, ScId>()
    for (const id of selected) slotToChild.set(handleSlot(Sc(getScRaw(heapPtr, id)).owner), id)
    const neighbors = new Map<number, ScId[]>()
    for (const id of selected) neighbors.set(id, [])
    for (const [key, count] of sparseEntries(peerRefs(heapPtr, parentPtr))) {
        if (!count) continue
        const from = slotToChild.get(key >>> 16)
        const to = slotToChild.get(key & slotMask)
        if (from && to && selectedSet.has(from) && selectedSet.has(to)) neighbors.get(from)!.push(to)
    }

    let nextIndex = 0
    const indices = new Map<number, number>()
    const lowlinks = new Map<number, number>()
    const stack: ScId[] = []
    const onStack = new Set<number>()
    const components: ScId[][] = []
    function connect(id: ScId): void {
        const index = nextIndex++
        indices.set(id, index)
        lowlinks.set(id, index)
        stack.push(id)
        onStack.add(id)
        for (const target of neighbors.get(id)!) {
            if (!indices.has(target)) {
                connect(target)
                lowlinks.set(id, Math.min(lowlinks.get(id)!, lowlinks.get(target)!))
            } else if (onStack.has(target)) {
                lowlinks.set(id, Math.min(lowlinks.get(id)!, indices.get(target)!))
            }
        }
        if (lowlinks.get(id) !== indices.get(id)) return
        const component: ScId[] = []
        for (;;) {
            const child = stack.pop()!
            onStack.delete(child)
            component.push(child)
            if (child === id) break
        }
        components.push(component)
    }
    for (const id of selected) if (!indices.has(id)) connect(id)

    const groups: ScId[][] = []
    const remainder: ScId[] = []
    for (const component of components) {
        if (component.length > 1) groups.push(component)
        else remainder.push(component[0])
    }
    if (remainder.length > 1) groups.push(remainder)
    const wrappers: ScId[] = []
    for (const group of groups) wrappers.push(mergeGroup(heapPtr, parentId, group))
    return wrappers
}

function createInterpretedHeap(maxScs: ScId, enumerateEdges: u64): usize {
    intrinsics.assert(maxScs > 1 && (maxScs as any) <= scIdMask)
    const tableBytes = maxScs * 8
    const slabStartOffset = (heapTableOffset + tableBytes + 7) & ~7
    const heapPtr = intrinsics.Intrinsics.alloc(slabStartOffset + maxScs * scChunkBytes)
    const heap = Heap(heapPtr)
    heap.scTable = heapPtr + heapTableOffset
    heap.slabNext = heapPtr + slabStartOffset
    heap.slabEnd = heap.slabNext as usize + maxScs * scChunkBytes
    heap.nextScId = 2
    heap.maxScs = maxScs
    heap.rootSc = 1

    const root = allocateScChunk(heapPtr)
    setScRaw(heapPtr, 1, root)
    initSc(root, 0 as Handle, enumerateEdges, 0, ScType.general)
    const rootCell = allocCell(heapPtr, 1, scCellSize)
    Sc(root).owner = rootCell
    initScAccounting(heapPtr, 1, root, rootCell)
    Sc(root).flags = ScFlags.eternal
    return heapPtr
}

function createInterpretedScWithType(
    heapPtr: usize,
    parentId: ScId,
    enumerateEdges: u64,
    type: ScType,
): ScId {
    const heap = Heap(heapPtr)
    const id = heap.nextScId
    intrinsics.assert(id < heap.maxScs)

    const owner = allocCell(heapPtr, parentId, scCellSize)
    const ptr = allocateScChunk(heapPtr)
    const parent = Sc(getScRaw(heapPtr, parentId))
    ensurePeerRefs(heapPtr, parentId, getScRaw(heapPtr, parentId))
    initSc(ptr, owner, enumerateEdges, parent.depth + 1, type)
    const sc = Sc(ptr)
    sc.nextSibling = parent.firstChild
    parent.firstChild = id
    setScRaw(heapPtr, id, ptr)
    heap.nextScId = id + 1
    initScAccounting(heapPtr, id, ptr, owner)
    if (parent.depthExtent === 0) parent.depthExtent = 1
    return id
}

function createInterpretedSc(heapPtr: usize, parentId: ScId, enumerateEdges: u64): ScId {
    return createInterpretedScWithType(heapPtr, parentId, enumerateEdges, ScType.general)
}

function createInterpretedBranchSc(heapPtr: usize, parentId: ScId): ScId {
    return createInterpretedScWithType(heapPtr, parentId, 0, ScType.branch)
}

function createInterpretedPoolSc(
    heapPtr: usize,
    parentId: ScId,
    enumerateEdges: u64,
    cellBytes: usize,
): ScId {
    return configurePool(heapPtr, createInterpretedSc(heapPtr, parentId, enumerateEdges), cellBytes)
}

function benchAddRemove(iter: number, heap: usize, localFrom: Handle, localTo: Handle) {
    addEdge(heap, localFrom, localTo)
    for (let i = 0; i < iter; i++) {
        addEdge(heap, localFrom, localTo)
        removeEdge(heap, localFrom, localTo)
    }
    removeEdge(heap, localFrom, localTo)
}

const condenseBenchFanout = accountingCapacity
const condenseBenchLeafCapacity = accountingCapacity

function condenseBenchScCount(leaves: u32): u32 {
    let level = leaves
    let total = leaves
    while (level > condenseBenchFanout) {
        level = Math.ceil(level / condenseBenchFanout)
        total += level
    }
    return total
}

function makeCondenseBenchLeaves(
    heap: usize,
    parent: ScId,
    count: u32,
    depth: u32,
    leaves: ScId[],
): void {
    if (depth === 1) {
        for (let i: u32 = 0; i < count; i++) {
            leaves.push(createInterpretedSc(heap, parent, 0))
        }
        return
    }
    let childCapacity: u32 = 1
    for (let i: u32 = 1; i < depth; i++) childCapacity *= condenseBenchFanout
    let remaining = count
    while (remaining !== 0) {
        const childLeaves = Math.min(remaining, childCapacity)
        const child = createInterpretedBranchSc(heap, parent)
        makeCondenseBenchLeaves(heap, child, childLeaves, depth - 1, leaves)
        remaining -= childLeaves
    }
}

function makeCondenseBenchHeap(allocations: u32): [usize, ScId] {
    const leafCount = Math.ceil(allocations / condenseBenchLeafCapacity)
    let depth: u32 = 1
    let capacity: u32 = condenseBenchFanout
    while (leafCount > capacity) {
        capacity *= condenseBenchFanout
        depth++
    }
    const maxScs = (condenseBenchScCount(leafCount) + 3) as ScId
    const heap = createInterpretedHeap(maxScs, 0)
    const root = rootSc(heap)
    const leaves: ScId[] = []
    makeCondenseBenchLeaves(heap, root, leafCount, depth, leaves)
    leaves.reverse()
    let leaf = leaves.pop()!
    let used: u32 = 0
    let previous = 0 as Handle
    for (let i: u32 = 0; i < allocations; i++) {
        if (used === condenseBenchLeafCapacity) {
            leaf = leaves.pop()!
            used = 0
        }
        const cell = allocCell(heap, leaf, 8)
        if (previous !== 0) addEdge(heap, cell, previous)
        previous = cell
        used++
    }
    return [heap, root]
}

export function benchCondenseAllocations(samples: u32): void {
    const counts = [32, 256, 1024, 4096, 8192]
    for (let i = 0; i < 10; i++) {
        const [heap, root] = makeCondenseBenchHeap(32)
        condense(heap, root, true)
        intrinsics.Intrinsics.free(heap)
    }
    for (const allocations of counts) {
        const leaves = Math.ceil(allocations / condenseBenchLeafCapacity)
        const scs = condenseBenchScCount(leaves)
        let elapsed = 0
        for (let i: u32 = 0; i < samples; i++) {
            const [heap, root] = makeCondenseBenchHeap(allocations)
            const start = performance.now()
            intrinsics.assert(condense(heap, root, true).length === 1)
            elapsed += performance.now() - start
            intrinsics.Intrinsics.free(heap)
        }
        console.log(
            `benchCondense (allocations: ${allocations}, leaf SCs: ${leaves}, SCs: ${scs}, samples: ${samples})`,
            (elapsed / samples).toFixed(6), 'ms/op',
        )
    }
}

function enumerateSingleEdge(ptr: usize, index: u32): Handle {
    if (index !== 0) return 0 as Handle
    return intrinsics.Intrinsics.load(ptr, 0, Types.u32) as Handle
}

function setSingleEdgeRaw(heapPtr: usize, source: Handle, target: Handle): void {
    intrinsics.Intrinsics.store(resolve(heapPtr, source), 0, target, Types.u32)
}

function setSingleEdge(heapPtr: usize, source: Handle, target: Handle): void {
    const ptr = resolve(heapPtr, source)
    const previous = intrinsics.Intrinsics.load(ptr, 0, Types.u32) as Handle
    if (previous === target) return
    if (target !== 0) addEdge(heapPtr, source, target)
    intrinsics.Intrinsics.store(ptr, 0, target, Types.u32)
    if (previous !== 0) removeEdge(heapPtr, source, previous)
}

export function selfTest(select: (apis: any) => any): void {
    const shared = {
        allocCell,
        addEdge,
        removeEdge,
        removeEdgeDeferred,
        localRefCount,
        inboundRefCount,
        outboundRefCount,
        peerRefCount,
        supportCount,
        supportState,
        beginDestroy,
        finishDestroy,
        destroyCell,
        destroyCellWith,
        enumerateSingleEdge,
        setSingleEdge,
        setSingleEdgeRaw,
        rootSc,
        scOwner,
        refSc,
        unrefSc,
        scDepth,
        scFlags,
        scEdgeEnumerator,
        scAddress,
        scCellHeader,
        edgeBoundary,
        handleSc,
        handleSlot,
        resolve,
        benchAddRemove,
    }
    const api = select({
        native: { createHeap, createSc, createBranchSc, createPoolSc, ...shared },
        interpreted: {
            createHeap: createInterpretedHeap,
            createSc: createInterpretedSc,
            createBranchSc: createInterpretedBranchSc,
            createPoolSc: createInterpretedPoolSc,
            mergeGroup,
            condense,
            initBuild,
            beginBuild,
            finishBuild,
            ...shared,
        },
    })
    // v8.setFlagsFromString('--print-opt-code --code-comments')
    const heap = api.createHeap(16, 0)
    const root = api.rootSc(heap)
    const child = api.createSc(heap, root, 11)
    const sibling = api.createSc(heap, root, 12)
    const grandchild = api.createSc(heap, child, 13)
    const cousin = api.createSc(heap, sibling, 14)
    const childOwner = api.scOwner(heap, child)
    const siblingOwner = api.scOwner(heap, sibling)
    const grandchildOwner = api.scOwner(heap, grandchild)
    const cousinOwner = api.scOwner(heap, cousin)
    intrinsics.assert(api.scFlags(heap, root) === 1)
    intrinsics.assert(api.scDepth(heap, child) === 1)
    intrinsics.assert(api.scDepth(heap, sibling) === 1)
    intrinsics.assert(api.scDepth(heap, grandchild) === 2)
    intrinsics.assert(api.scEdgeEnumerator(heap, child) === 11)
    intrinsics.assert(api.handleSc(childOwner) === root)
    intrinsics.assert(api.handleSlot(childOwner) > 0)
    intrinsics.assert(api.scCellHeader(heap, childOwner) === api.scAddress(heap, child))
    intrinsics.assert(api.scCellHeader(heap, grandchildOwner) === api.scAddress(heap, grandchild))
    intrinsics.assert(api.edgeBoundary(heap, child, sibling) === ((sibling << 16) + child))

    const localFrom = api.allocCell(heap, child, 8)
    const localTo = api.allocCell(heap, child, 8)
    const remoteTo = api.allocCell(heap, sibling, 8)
    api.addEdge(heap, localFrom, localTo)
    api.addEdge(heap, localFrom, localTo)
    intrinsics.assert(api.localRefCount(heap, localTo) === 2)
    api.removeEdgeDeferred(heap, localFrom, localTo)
    api.removeEdgeDeferred(heap, localFrom, localTo)
    intrinsics.assert(api.localRefCount(heap, localTo) === 0)
    intrinsics.assert(api.supportCount(heap, localTo) === 0)
    intrinsics.assert(api.supportState(heap, localTo) === supportPending)

    {
        const benchSc = api.createSc(heap, root, 0)
        const localFrom = api.allocCell(heap, benchSc, 8)
        const localTo = api.allocCell(heap, benchSc, 8)
        const iters = api.createHeap === createInterpretedHeap ? 50_000 : 500_000
        const p = performance.now()
        api.benchAddRemove(iters, heap, localFrom, localTo)
        const dur = performance.now() - p
        console.log(`benchAddRemove (iters: ${iters})`, dur.toFixed(3), 'ms', `(${((dur/iters)*1e6).toFixed(3)} ns/op)`)
        intrinsics.assert(api.supportState(heap, localTo) === supportDestroyed)
    }

    api.addEdge(heap, localFrom, remoteTo)
    intrinsics.assert(api.supportState(heap, remoteTo) === 0)
    api.addEdge(heap, localFrom, remoteTo)
    intrinsics.assert(api.outboundRefCount(heap, localFrom, remoteTo) === 2)
    intrinsics.assert(api.inboundRefCount(heap, remoteTo) === 1)
    intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 1)
    intrinsics.assert(api.localRefCount(heap, siblingOwner) === 1)
    api.removeEdgeDeferred(heap, localFrom, remoteTo)
    intrinsics.assert(api.outboundRefCount(heap, localFrom, remoteTo) === 1)
    intrinsics.assert(api.inboundRefCount(heap, remoteTo) === 1)
    api.removeEdgeDeferred(heap, localFrom, remoteTo)
    intrinsics.assert(api.outboundRefCount(heap, localFrom, remoteTo) === 0)
    intrinsics.assert(api.inboundRefCount(heap, remoteTo) === 0)
    intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 0)
    intrinsics.assert(api.localRefCount(heap, siblingOwner) === 0)
    intrinsics.assert(api.supportState(heap, remoteTo) === supportPending)
    intrinsics.assert(api.supportState(heap, siblingOwner) === supportPending)

    {
        const source = api.allocCell(heap, child, 8)
        const targetA = api.allocCell(heap, sibling, 8)
        const targetB = api.allocCell(heap, sibling, 8)
        api.addEdge(heap, source, targetA)
        api.addEdge(heap, source, targetB)
        intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 2)
        intrinsics.assert(api.localRefCount(heap, siblingOwner) === 1)
        api.removeEdgeDeferred(heap, source, targetA)
        intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 1)
        intrinsics.assert(api.localRefCount(heap, siblingOwner) === 1)
        api.removeEdgeDeferred(heap, source, targetB)
        intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 0)
        intrinsics.assert(api.localRefCount(heap, siblingOwner) === 0)
    }

    const grandFrom = api.allocCell(heap, grandchild, 8)
    const grandTo = api.allocCell(heap, grandchild, 8)
    const cousinTo = api.allocCell(heap, cousin, 8)

    api.addEdge(heap, grandFrom, cousinTo)
    api.addEdge(heap, grandFrom, cousinTo)
    intrinsics.assert(api.outboundRefCount(heap, grandFrom, cousinTo) === 2)
    intrinsics.assert(api.outboundRefCount(heap, grandchildOwner, cousinTo) === 1)
    intrinsics.assert(api.inboundRefCount(heap, cousinTo) === 1)
    intrinsics.assert(api.inboundRefCount(heap, cousinOwner) === 1)
    intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 1)
    intrinsics.assert(api.localRefCount(heap, siblingOwner) === 1)
    api.removeEdgeDeferred(heap, grandFrom, cousinTo)
    intrinsics.assert(api.outboundRefCount(heap, grandFrom, cousinTo) === 1)
    intrinsics.assert(api.outboundRefCount(heap, grandchildOwner, cousinTo) === 1)
    api.removeEdgeDeferred(heap, grandFrom, cousinTo)
    intrinsics.assert(api.outboundRefCount(heap, grandFrom, cousinTo) === 0)
    intrinsics.assert(api.outboundRefCount(heap, grandchildOwner, cousinTo) === 0)
    intrinsics.assert(api.inboundRefCount(heap, cousinTo) === 0)
    intrinsics.assert(api.inboundRefCount(heap, cousinOwner) === 0)
    intrinsics.assert(api.peerRefCount(heap, root, childOwner, siblingOwner) === 0)
    intrinsics.assert(api.localRefCount(heap, siblingOwner) === 0)

    api.addEdge(heap, grandFrom, localTo)
    intrinsics.assert(api.supportState(heap, localTo) === 0)
    api.addEdge(heap, grandFrom, localTo)
    intrinsics.assert(api.outboundRefCount(heap, grandFrom, localTo) === 2)
    intrinsics.assert(api.outboundRefCount(heap, grandchildOwner, localTo) === 1)
    intrinsics.assert(api.localRefCount(heap, localTo) === 1)
    intrinsics.assert(api.inboundRefCount(heap, localTo) === 0)
    api.removeEdgeDeferred(heap, grandFrom, localTo)
    intrinsics.assert(api.localRefCount(heap, localTo) === 1)
    api.removeEdgeDeferred(heap, grandFrom, localTo)
    intrinsics.assert(api.outboundRefCount(heap, grandFrom, localTo) === 0)
    intrinsics.assert(api.outboundRefCount(heap, grandchildOwner, localTo) === 0)
    intrinsics.assert(api.localRefCount(heap, localTo) === 0)
    intrinsics.assert(api.supportState(heap, localTo) === supportPending)

    api.addEdge(heap, localFrom, grandTo)
    api.addEdge(heap, localFrom, grandTo)
    intrinsics.assert(api.outboundRefCount(heap, localFrom, grandTo) === 2)
    intrinsics.assert(api.inboundRefCount(heap, grandTo) === 1)
    intrinsics.assert(api.localRefCount(heap, grandchildOwner) === 1)
    api.removeEdgeDeferred(heap, localFrom, grandTo)
    intrinsics.assert(api.inboundRefCount(heap, grandTo) === 1)
    api.removeEdgeDeferred(heap, localFrom, grandTo)
    intrinsics.assert(api.outboundRefCount(heap, localFrom, grandTo) === 0)
    intrinsics.assert(api.inboundRefCount(heap, grandTo) === 0)
    intrinsics.assert(api.localRefCount(heap, grandchildOwner) === 0)

    const doomed = api.allocCell(heap, child, 8)
    intrinsics.assert(api.supportCount(heap, doomed) === 0)
    intrinsics.assert(api.beginDestroy(heap, doomed))
    intrinsics.assert(api.supportState(heap, doomed) === supportDestroying)
    intrinsics.assert(!api.beginDestroy(heap, doomed))
    api.finishDestroy(heap, doomed)
    intrinsics.assert(api.supportState(heap, doomed) === supportDestroyed)

    const enumeratorAddress = api.enumerateSingleEdge.ptr ?? 0
    const destructibleSc = api.createSc(heap, root, enumeratorAddress)
    const source = api.allocCell(heap, destructibleSc, 8)
    const target = api.allocCell(heap, destructibleSc, 8)
    api.setSingleEdge(heap, source, target)
    intrinsics.assert(api.supportCount(heap, source) === 0)
    intrinsics.assert(api.supportCount(heap, target) === 1)
    const destroyed = enumeratorAddress
        ? api.destroyCell(heap, source)
        : api.destroyCellWith(heap, source, api.enumerateSingleEdge)
    intrinsics.assert(destroyed)
    intrinsics.assert(api.supportState(heap, source) === supportDestroyed)
    intrinsics.assert(api.supportCount(heap, target) === 0)
    intrinsics.assert(api.supportState(heap, target) === supportDestroyed)

    const pool = api.createPoolSc(heap, root, 0, 16)
    const pooled = api.allocCell(heap, pool, 16)
    const nextPooled = api.allocCell(heap, pool, 16)
    intrinsics.assert(pooled !== nextPooled)
    intrinsics.assert(api.destroyCell(heap, pooled))
    intrinsics.assert(api.supportState(heap, pooled) === supportDestroyed)
    const reused = api.allocCell(heap, pool, 16)
    intrinsics.assert(reused === pooled)
    intrinsics.assert(api.supportState(heap, reused) === 0)

    {
        const pool1 = api.createPoolSc(heap, root, StaticEnumerator.singleEdge, 16)
        const pool2 = api.createPoolSc(heap, root, StaticEnumerator.singleEdge, 16)
        const a = api.allocCell(heap, pool1, 16)
        const b = api.allocCell(heap, pool2, 16)
        const c = api.allocCell(heap, pool2, 16)
        api.setSingleEdge(heap, a, b)
        api.setSingleEdge(heap, b, c)
        intrinsics.assert(api.enumerateSingleEdge(api.resolve(heap, a), 0) === b)
        intrinsics.assert(api.enumerateSingleEdge(api.resolve(heap, b), 0) === c)
        intrinsics.assert(api.supportCount(heap, b) === 1)
        intrinsics.assert(api.supportCount(heap, c) === 1)
        api.setSingleEdge(heap, a, 0)
        intrinsics.assert(api.enumerateSingleEdge(api.resolve(heap, a), 0) === 0)
        intrinsics.assert(api.supportState(heap, a) === 0)
        intrinsics.assert(api.supportState(heap, b) === supportDestroyed)
        intrinsics.assert(api.supportState(heap, c) === supportDestroyed)
    }

    {
        const held = api.createSc(heap, root, 0)
        const owner = api.scOwner(heap, held)
        const anchor = api.allocCell(heap, root, 8)
        const value = api.allocCell(heap, held, 8)
        intrinsics.assert(api.supportCount(heap, owner) === 0)
        api.refSc(heap, held)
        intrinsics.assert(api.supportCount(heap, owner) === 1)
        api.addEdge(heap, anchor, value)
        intrinsics.assert(api.supportCount(heap, owner) === 2)
        api.removeEdge(heap, anchor, value)
        intrinsics.assert(api.supportCount(heap, owner) === 1)
        intrinsics.assert(api.supportState(heap, owner) === 0)
        api.unrefSc(heap, held)
        intrinsics.assert(api.supportCount(heap, owner) === 0)
        intrinsics.assert(api.supportState(heap, owner) === supportDestroyed)
    }

    if (api.createBranchSc) {
        const branch = api.createBranchSc(heap, root)
        const left = api.createSc(heap, branch, 0)
        const right = api.createSc(heap, branch, 0)
        const leftCell = api.allocCell(heap, left, 8)
        const rightA = api.allocCell(heap, right, 8)
        const rightB = api.allocCell(heap, right, 8)
        const rightOwner = api.scOwner(heap, right)
        api.addEdge(heap, leftCell, rightA)
        api.addEdge(heap, leftCell, rightB)
        intrinsics.assert(api.localRefCount(heap, rightOwner) === 1)
        for (let i = 0; i < 301; i++) api.refSc(heap, right)
        intrinsics.assert(api.inboundRefCount(heap, rightOwner) === 301)
        for (let i = 0; i < 301; i++) api.unrefSc(heap, right)
        intrinsics.assert(api.inboundRefCount(heap, rightOwner) === 0)
        api.removeEdgeDeferred(heap, leftCell, rightA)
        intrinsics.assert(api.localRefCount(heap, rightOwner) === 1)
        api.removeEdgeDeferred(heap, leftCell, rightB)
        intrinsics.assert(api.localRefCount(heap, rightOwner) === 0)
    }

    if (api.beginBuild) {
        const build = intrinsics.Intrinsics.alloc(buildContextSize)
        defer { intrinsics.Intrinsics.free(build) }
        api.initBuild(build)
        const buildSc = api.createPoolSc(heap, root, StaticEnumerator.singleEdge, 16)
        const existing = api.allocCell(heap, buildSc, 16)

        const parent = api.beginBuild(heap, build, buildSc, 16)
        const child = api.beginBuild(heap, build, buildSc, 16)
        api.finishBuild(heap, build, child)
        api.setSingleEdgeRaw(heap, parent, child)
        api.finishBuild(heap, build, parent)
        intrinsics.assert(api.localRefCount(heap, child) === 1)
        intrinsics.assert(api.supportCount(heap, child) === 1)

        const holder = api.beginBuild(heap, build, buildSc, 16)
        api.setSingleEdgeRaw(heap, holder, existing)
        api.finishBuild(heap, build, holder)
        intrinsics.assert(api.localRefCount(heap, existing) === 1)

        const owner = api.beginBuild(heap, build, buildSc, 16)
        const ephemeral = api.beginBuild(heap, build, buildSc, 16)
        api.finishBuild(heap, build, ephemeral)
        intrinsics.assert(api.localRefCount(heap, ephemeral) === 1)
        api.finishBuild(heap, build, owner)
        intrinsics.assert(api.localRefCount(heap, ephemeral) === 0)
        intrinsics.assert(api.supportState(heap, ephemeral) === supportDestroyed)
    }

    if (api.condense) {
        const mergedHeap = api.createHeap(16, 0)
        const mergedRoot = api.rootSc(mergedHeap)
        const aSc = api.createSc(mergedHeap, mergedRoot, 0)
        const bSc = api.createSc(mergedHeap, mergedRoot, 0)
        const cSc = api.createSc(mergedHeap, mergedRoot, 0)
        const a = api.allocCell(mergedHeap, aSc, 8)
        const b = api.allocCell(mergedHeap, bSc, 8)
        const c = api.allocCell(mergedHeap, cSc, 8)
        api.addEdge(mergedHeap, a, b)
        api.addEdge(mergedHeap, b, a)
        api.addEdge(mergedHeap, a, c)
        api.addEdge(mergedHeap, b, c)
        intrinsics.assert(api.supportCount(mergedHeap, c) === 2)
        const wrappers = api.condense(mergedHeap, mergedRoot, false)
        intrinsics.assert(wrappers.length === 1)
        const wrapper = wrappers[0]
        const wrapperOwner = api.scOwner(mergedHeap, wrapper)
        const aOwner = api.scOwner(mergedHeap, aSc)
        const bOwner = api.scOwner(mergedHeap, bSc)
        const cOwner = api.scOwner(mergedHeap, cSc)
        intrinsics.assert(api.handleSc(aOwner) === wrapper)
        intrinsics.assert(api.handleSc(bOwner) === wrapper)
        intrinsics.assert(api.scDepth(mergedHeap, aSc) === 2)
        intrinsics.assert(api.peerRefCount(mergedHeap, wrapper, aOwner, bOwner) === 1)
        intrinsics.assert(api.peerRefCount(mergedHeap, mergedRoot, wrapperOwner, cOwner) === 1)
        intrinsics.assert(api.supportCount(mergedHeap, b) === 1)
        intrinsics.assert(api.supportCount(mergedHeap, c) === 1)
        api.removeEdgeDeferred(mergedHeap, a, b)
        api.removeEdgeDeferred(mergedHeap, b, a)
        api.removeEdgeDeferred(mergedHeap, a, c)
        intrinsics.assert(api.supportCount(mergedHeap, c) === 1)
        api.removeEdgeDeferred(mergedHeap, b, c)
        intrinsics.assert(api.supportCount(mergedHeap, b) === 0)
        intrinsics.assert(api.supportCount(mergedHeap, c) === 0)

        const bucketHeap = api.createHeap(16, 0)
        const bucketRoot = api.rootSc(bucketHeap)
        const heldSc = api.createSc(bucketHeap, bucketRoot, 0)
        const looseA = api.createSc(bucketHeap, bucketRoot, 0)
        const looseB = api.createSc(bucketHeap, bucketRoot, 0)
        api.refSc(bucketHeap, heldSc)
        const bucketWrappers = api.condense(bucketHeap, bucketRoot, false)
        intrinsics.assert(bucketWrappers.length === 1)
        intrinsics.assert(api.handleSc(api.scOwner(bucketHeap, heldSc)) === bucketRoot)
        intrinsics.assert(api.handleSc(api.scOwner(bucketHeap, looseA)) === bucketWrappers[0])
        intrinsics.assert(api.handleSc(api.scOwner(bucketHeap, looseB)) === bucketWrappers[0])
        api.unrefSc(bucketHeap, heldSc)
    }
}

if (intrinsics.argv()[0] === 'cg') {
    selfTest(apis => apis.interpreted)
    console.log('cg interpreted self-test passed')
    if (intrinsics.argv().includes('condense-bench')) benchCondenseAllocations(20)
}
