/// @synth

"use wrapped";

import * as gn from './graph-node'
import * as intrinsics from './intrinsics'
import * as bytecode from './bytecode-emitter'
import { Op, isVmHandle, vmHandle, vmPayload, tagVmHandle } from './vm'
import * as lowering2 from './lowering2'
import * as heap from './heap'
import { Op as RtOp, bindingOf, effectOps, heapOps, isThrow } from './rt'
import {
    NodeOp, countIds, createGraph, getLiteral, getNode, getRef, internNode, literalSlot, putNode, refSlot,
    setDebugLabel, setGraphBlocks, setNode, slotLiteral, slotRef, ArgForm, argForm, unknownLayout, type Layout,
} from './graph-node'
import type { TraceSession, TraceOptions, CompiledSource } from './trace2'

type Handle = intrinsics.Handle
type Runtime = NonNullable<TraceSession['runtime']>

const Types = intrinsics.Types
const assert = intrinsics.assert

export interface Allocation {
    token: number | undefined
    call: number | undefined
}

export interface FastTraced {
    graph: lowering2.Graph
    session: TraceSession
    frameProxy: u32 | undefined
    frames: Map<u32, number>
    allocations: Map<u32, Allocation>
    closures: Set<number>
    usesSelf: boolean
    accesses: Map<number, number>
    conversions: Map<number, number>
}

enum Kind {
    Number,
    Cell,
    Host,
    Node,
    Bool,
}

interface Registers {
    kind: Uint8Array
    value: Float64Array
    token: number
}

interface Arrival {
    regs: Registers
    node: number
}

interface Merge {
    block: number
    id: number
    live: number[]
    firstParam: number
    arrivals: Arrival[]
    params: number[]
    paramArgs: number[]
    bound: boolean
    body: number
}

interface Constants {
    kind: number[]
    value: number[]
}

interface Hosts {
    values: any[]
    index: Map<any, number>
    cells: number[]
}

interface Parent {
    fn: number
    bytecode: Handle
}

interface Frame {
    id: number
    cell: number
}

interface TraceCtx {
    session: TraceSession
    runtime: Runtime
    source: CompiledSource
    shape: SourceShape
    opts: TraceOptions
    captures: any[] | undefined
    self: Function | undefined
    name: string
    accRegIdx: number
    frozenCells: Set<number>
    root: number
    params: number[]
    constants: Constants
    hosts: Hosts
    parent: Parent | undefined
    frame: Frame | undefined
}

interface Tuple {
    kind: number[]
    value: number[]
}

interface TraceState {
    interned: Map<number, number>
    regs: Registers
    block: number
    tail: number
    merges: (Merge | undefined)[]
    traced: Uint8Array
    allocations: Map<u32, Allocation>
    closures: Set<number>
    usesSelf: boolean
    pc: number
    accesses: Map<number, number>
    tuples: Map<number, Tuple>
    cells: Set<number>
    boolish: Set<number>
    conversions: Map<number, number>
}

let C: TraceCtx
let T: TraceState
const got = { kind: Kind.Number as number, value: 0 }
let syntheticFrames = 0xF000_0000

export function fastTrace(source: CompiledSource, opts: TraceOptions): FastTraced {
    const session = opts.session!
    const captures = opts.captures && opts.mapCapture ? opts.captures.map(opts.mapCapture) : opts.captures
    const runtime = session.enterTrace()
    const outerCtx = C
    const outerState = T
    defer finally {
        C = outerCtx
        T = outerState
        session.leaveTrace()
    }
    C = {
        session, runtime, source, shape: shapeOf(source), opts, captures, self: opts.self, name: opts.name ?? '',
        accRegIdx: source.compiled.registerCount, frozenCells: frozenCellsOf(session),
        root: 0, params: [],
        constants: { kind: [], value: [] },
        hosts: { values: [], index: new Map(), cells: [] },
        parent: undefined, frame: undefined,
    }
    return runtime.tracer.inactive(traceSource)
}

function node(op: NodeOp, slots: number[], type?: gn.TypeOperand): number {
    return internNode(C.runtime, T.interned, op, slots, type)
}

function uniqueNode(op: NodeOp): number {
    const id = C.runtime.ids.next++
    setNode(C.runtime, id, gn.makeNodeFromSlots(op, new Uint32Array(0)))
    return id
}

function nullishNode(handle: number = heap.undefinedHandle): number {
    return node(NodeOp.heapHandle, [literalSlot(C.runtime, handle)])
}

function looseNil(): number {
    return node(NodeOp.nilEffect, [])
}

function boolNode(value: number): number {
    return node(NodeOp.literal, [literalSlot(C.runtime, value)], Types.bool)
}

function cellNode(cell: number): number {
    return node(NodeOp.heapHandle, [literalSlot(C.runtime, cell)])
}

function effect(op: NodeOp, slots: number[], type?: gn.TypeOperand): number {
    slots.unshift(refSlot(T.regs.token))
    const id = node(op, slots, type)
    T.regs.token = id
    if ((op === NodeOp.getProp || op === NodeOp.setProp) && !T.accesses.has(id)) T.accesses.set(id, T.pc)
    return id
}

function after(slot: number, token: number): number {
    const tokenNode = getNode(C.runtime, token)
    if (!tokenNode || tokenNode.op === NodeOp.nilEffect) return slot
    const id = slotRef(slot)
    if (id === token) return slot
    const n = id ? getNode(C.runtime, id) : undefined
    if (n && countIds(n) && lowering2.OrderedValues.has(n.op) && getRef(n, 0) === token) return slot
    return refSlot(node(NodeOp.after, [refSlot(token), slot]))
}

function select(cond: number, yes: number, no: number): number {
    if (yes === no) return yes
    return refSlot(node(NodeOp.select, [cond, yes, no]))
}

function internCell(cell: number): number {
    if (heap.isOddballHandle(cell as Handle) || heap.isIndirect(cell as Handle)) return cell
    return C.runtime.objects.intern(cell as Handle) as number
}

function hostCell(index: number): number {
    const hosts = C.hosts
    if (hosts.cells[index] === undefined) {
        const host = hosts.values[index]
        hosts.cells[index] = typeof host === 'function' ? C.session.linkFunction(host) as number : C.session.fromJsValue(host) as number
    }
    return hosts.cells[index]
}

function cellOf(kind: number, value: number): number {
    if (kind === Kind.Bool) return value ? heap.trueHandle : heap.falseHandle
    return internCell(kind === Kind.Host ? hostCell(value) : value)
}

function numberOf(kind: number, value: number): number {
    return kind === Kind.Number || kind === Kind.Bool ? value : cellOf(kind, value)
}

function slotOf(kind: number, value: number): number {
    if (kind === Kind.Node) return escape(value)
    if (kind === Kind.Number) return literalSlot(C.runtime, value)
    if (kind === Kind.Bool) return refSlot(boolNode(value))
    const cell = cellOf(kind, value)
    if (heap.isNullishHandle(cell as Handle)) return refSlot(nullishNode(cell))
    return refSlot(cellNode(cell))
}

function wordOf(kind: number, value: number): number {
    if (kind === Kind.Node) return escape(value)
    return literalSlot(C.runtime, numberOf(kind, value))
}

function fromHandle(handle: number): void {
    if (heap.isBoxedF64(handle as Handle)) {
        const id = heap.boxedNanId(handle as Handle)
        got.kind = id ? Kind.Node : Kind.Number
        got.value = id || heap.unboxF64(handle as Handle)
        return
    }
    got.kind = Kind.Cell
    got.value = handle
}

function fromWord(word: number): void {
    if (isVmHandle(word as u32)) return fromHandle(vmHandle(word as u32))
    got.kind = Kind.Number
    got.value = vmPayload(word as u32)
}

function fromHost(host: any): void {
    if (typeof host === 'number') {
        const id = Number.isNaN(host) ? intrinsics.getNanId(host) : 0
        got.kind = id ? Kind.Node : Kind.Number
        got.value = id || host
        return
    }
    if (typeof host === 'boolean') {
        got.kind = Kind.Bool
        got.value = host ? 1 : 0
        return
    }
    if (host === null || host === undefined) {
        got.kind = Kind.Cell
        got.value = host === null ? heap.nullHandle : heap.undefinedHandle
        return
    }
    if (typeof host === 'function' || isFrozenHost(host)) {
        const hosts = C.hosts
        let index = hosts.index.get(host)
        if (index === undefined) {
            index = hosts.values.length
            hosts.values.push(host)
            hosts.index.set(host, index)
        }
        got.kind = Kind.Host
        got.value = index
        return
    }
    fromHandle(C.session.fromJsValue(host))
}

function constant(index: number): void {
    const constants = C.constants
    if (constants.kind[index] === undefined) {
        resolveConstant(index)
        constants.kind[index] = got.kind
        constants.value[index] = got.value
    }
    got.kind = constants.kind[index]
    got.value = constants.value[index]
}

function resolveConstant(index: number): void {
    const kind = C.source.compiled.constantKinds[index]
    const value = C.source.compiled.constants[index]
    if (kind === bytecode.ConstantKind.number) {
        got.kind = Kind.Number
        got.value = value
        return
    }
    if (kind === bytecode.ConstantKind.string || kind === bytecode.ConstantKind.symbol) return fromHandle(C.session.fromJsValue(value))
    if (kind === bytecode.ConstantKind.scope) {
        got.kind = Kind.Cell
        got.value = heap.undefinedHandle
        return
    }
    if (kind === bytecode.ConstantKind.late_bound) return fromHost(hostBinding(value as string))
    fromWord(heap.constantAt(parent().bytecode, index as u32))
    if (got.kind !== Kind.Cell || !C.self || heap.isOddballHandle(got.value as Handle)) return
    if (heap.functionBytecode(heap.deref(got.value as Handle)) !== C.parent!.fn) return
    T.usesSelf = true
    fromHost(C.opts.mapCapture ? C.opts.mapCapture(C.self) : C.self)
}

function parent(): Parent {
    if (!C.parent) {
        const compiled = C.source.compiled
        const fn = C.session.finalize(compiled, C.captures)
        const bytecode = heap.functionBytecode(fn as Handle)
        if (C.opts.env) for (const binding of compiled.scopeBindings) heap.setConstant(bytecode, binding.slot as u32, tagVmHandle(heap.boxSymbol(C.constants.value[binding.slot])))
        C.parent = { fn, bytecode }
    }
    return C.parent
}

function frameCell(): number {
    if (!C.frame) {
        const id = syntheticFrames++
        C.frame = { id, cell: heap.frameProxyOf(id as u32, 0 as Handle, 0 as Handle) as number }
        for (const r of C.source.compiled.readonlyCaptures ?? []) heap.setReadonlyProperty(C.frame.cell as Handle, heap.indexKey(r as u32), 0 as Handle)
    }
    return C.frame.cell
}

function frameKey(r: number): number {
    return literalSlot(C.runtime, heap.indexKey(r as u32))
}

function read(r: number): void {
    if (C.shape.shared[r]) {
        got.kind = Kind.Node
        got.value = effect(NodeOp.getProp, [refSlot(cellNode(frameCell())), frameKey(r)])
        return
    }
    got.kind = T.regs.kind[r]
    got.value = T.regs.value[r]
}

function write(r: number, kind: number, value: number): void {
    if (C.shape.captured[r]) effect(NodeOp.setProp, [refSlot(cellNode(frameCell())), frameKey(r), slotOf(kind, value)])
    if (C.shape.shared[r]) return
    T.regs.kind[r] = kind
    T.regs.value[r] = value
}

function setAcc(kind: number, value: number): void {
    T.regs.kind[C.accRegIdx] = kind
    T.regs.value[C.accRegIdx] = value
}

function setAccSlot(slot: number): void {
    const id = slotRef(slot)
    const n = id ? getNode(C.runtime, id) : undefined
    if (n && n.op === NodeOp.literal && gn.typeOf(n) === Types.bool) setAcc(Kind.Bool, getLiteral(C.runtime, n, 0))
    else if (id) setAcc(Kind.Node, id)
    else setAcc(Kind.Number, slotLiteral(C.runtime, slot))
}

function accKind(): number {
    return T.regs.kind[C.accRegIdx]
}

function accValue(): number {
    return T.regs.value[C.accRegIdx]
}

function fold(name: string, args: number[]): number {
    const result = (C.runtime.tracer.saved as any)[name](...args)
    if (typeof result === 'boolean') return result ? 1 : 0
    return typeof result === 'number' ? result : 0
}

const binaryNames: string[] = []
binaryNames[Op.Add] = 'add'
binaryNames[Op.Sub] = 'sub'
binaryNames[Op.Mul] = 'mul'
binaryNames[Op.Div] = 'div'
binaryNames[Op.Mod] = 'rem'
binaryNames[Op.Exp] = 'pow'
binaryNames[Op.BitOr] = 'or'
binaryNames[Op.BitAnd] = 'and'
binaryNames[Op.BitXor] = 'xor'
binaryNames[Op.ShiftLeft] = 'shl'
binaryNames[Op.ShiftRight] = 'shr'
binaryNames[Op.ShiftRightLogical] = 'ushr'
binaryNames[Op.TestLessThan] = 'lt'
binaryNames[Op.TestGreaterThan] = 'gt'
binaryNames[Op.TestLessThanOrEqual] = 'le'
binaryNames[Op.TestGreaterThanOrEqual] = 'ge'

const comparisonOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne])

function numeric(kind: number): boolean {
    return kind === Kind.Number || kind === Kind.Bool
}

function binary(name: string, ak: number, av: number, bk: number, bv: number): void {
    const op = gn.nodeOp(name)
    if (numeric(ak) && numeric(bk)) return setAcc(comparisonOps.has(op) ? Kind.Bool : Kind.Number, fold(name, [av, bv]))
    setAcc(Kind.Node, node(op, [slotOf(ak, av), slotOf(bk, bv)], comparisonOps.has(op) ? Types.bool : Types.unknown_number))
}

function boolArm(n: lowering2.GraphNode, at: number): number {
    const ref = getRef(n, at)
    const arm = ref ? getNode(C.runtime, ref) : undefined
    if (!arm || arm.op !== NodeOp.literal || gn.typeOf(arm) !== Types.bool) return -1
    return getLiteral(C.runtime, arm, 0)
}

function truthSelect(n: lowering2.GraphNode): boolean {
    if (n.op !== NodeOp.select || countIds(n) !== 3 || !getRef(n, 0)) return false
    const a = boolArm(n, 1)
    const b = boolArm(n, 2)
    return (a === 0 && b === 1) || (a === 1 && b === 0)
}

function logicalNot(negate: boolean): void {
    const n = accKind() === Kind.Node ? getNode(C.runtime, accValue()) : undefined
    if (!n) {
        const truth = slotLiteral(C.runtime, truthTest(accKind(), accValue()))
        return setAcc(Kind.Bool, negate ? truth : 1 - truth)
    }
    if (gn.typeOf(n) === Types.bool) return binary(negate ? 'ne' : 'eq', accKind(), accValue(), Kind.Number, 0)
    setAcc(Kind.Node, node(NodeOp.select, [refSlot(accValue()), refSlot(boolNode(negate ? 1 : 0)), refSlot(boolNode(negate ? 0 : 1))]))
}

function unary(name: string): void {
    if (numeric(accKind())) return setAcc(Kind.Number, fold(name, [accValue()]))
    setAcc(Kind.Node, node(gn.nodeOp(name), [accSlot()]))
}

function accSlot(): number {
    return accKind() === Kind.Node ? refSlot(accValue()) : slotOf(accKind(), accValue())
}

function textual(kind: number, value: number): boolean {
    if (kind === Kind.Cell) return heap.isString(value as Handle)
    if (kind !== Kind.Node) return false
    let n = getNode(C.runtime, value)
    while (n?.op === NodeOp.after) n = getNode(C.runtime, getRef(n, countIds(n) - 1))
    if (n?.op === NodeOp.rt) return getLiteral(C.runtime, n, 1) === RtOp.concat
    return n?.op === NodeOp.heapHandle && !getRef(n, 0) && heap.isString(getLiteral(C.runtime, n, 0) as Handle)
}

function stringSlot(kind: number, value: number): number {
    if (kind === Kind.Bool) return refSlot(cellNode(C.session.fromJsValue(value ? 'true' : 'false') as number))
    if (kind !== Kind.Number) return slotOf(kind, value)
    return refSlot(cellNode(fold('rt', [RtOp.toString, heap.boxF64(value)])))
}

function concat(r: number, maybeAdd: boolean): void {
    read(r)
    const ak = accKind()
    const av = accValue()
    const bk = got.kind
    const bv = got.value
    if (maybeAdd && !textual(ak, av) && !textual(bk, bv)) {
        if (numeric(ak) && numeric(bk)) return binary('add', ak, av, bk, bv)
        return setAcc(Kind.Node, node(NodeOp.rt, [refSlot(looseNil()), literalSlot(C.runtime, RtOp.addOrConcat), slotOf(ak, av), slotOf(bk, bv)]))
    }
    if (ak === Kind.Cell && bk === Kind.Cell && heap.isString(av as Handle) && heap.isString(bv as Handle)) {
        fromHandle(fold('rt', [RtOp.concat, av, bv]))
        return setAcc(got.kind, got.value)
    }
    setAcc(Kind.Node, effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.concat), stringSlot(ak, av), stringSlot(bk, bv)]))
}

function strictEqual(r: number, negate: boolean): void {
    read(r)
    let ak = accKind()
    let av = accValue()
    let bk = got.kind
    let bv = got.value
    if (ak === Kind.Host && bk === Kind.Host) return setAcc(Kind.Bool, (av === bv) !== negate ? 1 : 0)
    if (ak === Kind.Host) {
        av = hostCell(av)
        ak = Kind.Cell
    }
    if (bk === Kind.Host) {
        bv = hostCell(bv)
        bk = Kind.Cell
    }
    if (ak === Kind.Node || bk === Kind.Node) {
        return setAcc(Kind.Node, node(negate ? NodeOp.ne : NodeOp.eq, [slotOf(ak, av), slotOf(bk, bv)], Types.bool))
    }
    setAcc(Kind.Bool, (ak === bk && av === bv) !== negate ? 1 : 0)
}

function numericAcc(): void {
    if (accKind() !== Kind.Node) toNumberAcc()
}

function toNumberAcc(): void {
    if (accKind() === Kind.Number) return
    if (accKind() === Kind.Bool) return setAcc(Kind.Number, accValue())
    setAcc(Kind.Node, node(NodeOp.rt, [refSlot(looseNil()), literalSlot(C.runtime, RtOp.toNumber), accSlot()]))
}

function typeOfAcc(): void {
    const kind = accKind()
    const value = accValue()
    if (kind === Kind.Number) return setAcc(Kind.Cell, heap.typeNames.number)
    if (kind === Kind.Bool) return setAcc(Kind.Cell, heap.typeNames.boolean)
    if (kind === Kind.Host) return setAcc(Kind.Cell, typeof C.hosts.values[value] === 'function' ? heap.typeNames.function : heap.typeNames.object)
    if (kind === Kind.Cell) return setAcc(Kind.Cell, heap.typeNameOf(value as Handle))
    setAcc(Kind.Node, node(NodeOp.rt, [refSlot(looseNil()), literalSlot(C.runtime, RtOp.typeof), refSlot(value)]))
}

function cellMatches(value: number, op: number): boolean {
    if (op === Op.JumpIfNull || op === Op.JumpIfNotNull) return value === heap.nullHandle
    if (op === Op.JumpIfUndefined || op === Op.JumpIfNotUndefined) return value === heap.undefinedHandle
    return heap.isNullishHandle(value as Handle)
}

function nullishTest(kind: number, value: number, op: number): number {
    if (kind === Kind.Cell) return literalSlot(C.runtime, cellMatches(value, op) ? 1 : 0)
    if (kind !== Kind.Node) return literalSlot(C.runtime, 0)
    return refSlot(node(NodeOp.eq, [refSlot(value), refSlot(nullishNode())], Types.bool))
}

function truthTest(kind: number, value: number): number {
    if (kind === Kind.Node) return refSlot(value)
    if (kind === Kind.Host) return literalSlot(C.runtime, 1)
    if (textual(kind, value)) return literalSlot(C.runtime, heap.HeapString(heap.resolveHeapCell(value as Handle)).length !== 0 ? 1 : 0)
    if (kind === Kind.Cell) return literalSlot(C.runtime, heap.isFalsyHandle(value as Handle) ? 0 : 1)
    return literalSlot(C.runtime, value !== 0 ? 1 : 0)
}

function propertyKey(kind: number, value: number): number {
    if (kind === Kind.Number) return literalSlot(C.runtime, heap.indexKey(value as u32))
    if (kind === Kind.Bool) return literalSlot(C.runtime, C.session.fromJsValue(value ? 'true' : 'false') as number)
    if (kind === Kind.Node) return refSlot(value)
    return literalSlot(C.runtime, cellOf(kind, value))
}

function hostKey(key: Handle): string | number | undefined {
    const index = heap.keyIndex(key)
    if (index !== undefined) return index
    return heap.isString(key) ? heap.stringToJs(key) : undefined
}

function frozenRead(kind: number, value: number, key: number): boolean {
    if (slotRef(key)) return false
    if (kind === Kind.Host) {
        const host = C.hosts.values[value]
        const name = hostKey(slotLiteral(C.runtime, key) as Handle)
        if (name === undefined) return false
        const descriptor = Object.getOwnPropertyDescriptor(host, name)
        if (!descriptor || !('value' in descriptor)) return false
        fromHost(descriptor.value)
        setAcc(got.kind, got.value)
        return true
    }
    if (kind !== Kind.Cell || !objectCell(value)) return false
    const property = heap.getOwnProperty(heap.deref(value as Handle), slotLiteral(C.runtime, key) as Handle)
    if (!property) return false
    const descriptor = heap.FullPropertyDescriptor(heap.resolveHeapCell(property))
    if (descriptor.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return false
    if (descriptor.flags & heap.PropFlags.writable && !C.frozenCells.has(value)) return false
    fromHandle(descriptor.slot0)
    setAcc(got.kind, got.value)
    return true
}

function objectCell(value: number): boolean {
    if (heap.isOddballHandle(value as Handle)) return false
    const target = heap.deref(value as Handle)
    return heap.isOrdinaryObject(target) || heap.isCallable(target)
}

function staticCell(kind: number, value: number): boolean {
    if (kind === Kind.Host) return true
    if (kind !== Kind.Cell || !objectCell(value)) return false
    return !T.allocations.has(value as u32) && !T.closures.has(value)
}

function prototypeAcc(): void {
    const kind = accKind()
    const value = accValue()
    const host = hostFunction(kind, value)
    if (host !== undefined) {
        fromHost(Object.getPrototypeOf(host))
        setAcc(got.kind, got.value)
        return
    }
    if (!staticCell(kind, value)) {
        setAcc(Kind.Node, node(NodeOp.rt, [refSlot(T.regs.token), literalSlot(C.runtime, RtOp.getPrototypeOf), slotOf(kind, value)]))
        return
    }
    const proto = heap.getPrototypeOf(heap.deref(cellOf(kind, value) as Handle))
    setAcc(Kind.Cell, proto ? proto : heap.nullHandle)
}

function superProperty(receiverReg: number, keyReg: number): void {
    read(keyReg)
    const key = propertyKey(got.kind, got.value)
    const getter = staticGetter(accKind(), accValue(), key)
    if (!getter) {
        getProp(key)
        return
    }
    read(receiverReg)
    setAccSlot(call(Kind.Cell, getter, got.kind, got.value, 0, 0))
}

function staticGetter(kind: number, value: number, key: number): number {
    if (slotRef(key) || !staticCell(kind, value)) return 0
    const property = heap.getPropertyDescriptor(heap.deref(cellOf(kind, value) as Handle), slotLiteral(C.runtime, key) as Handle)
    if (!property) return 0
    const descriptor = heap.FullPropertyDescriptor(heap.resolveHeapCell(property))
    return descriptor.flags & heap.PropFlags.has_getter ? descriptor.slot0 : 0
}

function escape(id: number): number {
    if (T.tuples.size) T.tuples.delete(id)
    return refSlot(id)
}

function tupleRead(key: number): boolean {
    if (accKind() !== Kind.Node) return false
    const elements = T.tuples.get(accValue())
    if (!elements) return false
    const name = slotRef(key) ? undefined : slotLiteral(C.runtime, key) as Handle
    if (name === heap.arrayLengthKey) {
        setAcc(Kind.Number, elements.kind.length)
        return true
    }
    const index = name === undefined ? undefined : heap.keyIndex(name)
    if (index === undefined) return false
    if (index >= elements.kind.length) setAcc(Kind.Cell, heap.undefinedHandle)
    else setAcc(elements.kind[index], elements.value[index])
    return true
}

function getProp(key: number): void {
    if (frozenRead(accKind(), accValue(), key)) return
    if (tupleRead(key)) return
    const object = accKind() === Kind.Node ? refSlot(accValue()) : slotOf(accKind(), accValue())
    setAcc(Kind.Node, effect(NodeOp.getProp, [object, key]))
}

function setProp(r: number, key: number): void {
    read(r)
    effect(NodeOp.setProp, [slotOf(got.kind, got.value), key, slotOf(accKind(), accValue())])
}

function deleteProp(key: number): void {
    const kind = accKind()
    const value = accValue()
    if (kind === Kind.Number || kind === Kind.Bool) {
        setAcc(Kind.Bool, 1)
        return
    }
    if (textual(kind, value)) {
        if (kind !== Kind.Cell || slotRef(key)) throw `fast-trace: delete of a computed key on a string [${C.name}]`
        const name = slotLiteral(C.runtime, key) as Handle
        const index = heap.keyIndex(name)
        const kept = name === heap.arrayLengthKey || (index !== undefined && index < heap.stringLength(value as Handle))
        setAcc(Kind.Bool, kept ? 0 : 1)
        return
    }
    effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.deleteProperty), slotOf(kind, value), key])
    setAcc(Kind.Bool, 1)
}

function argSlots(first: number, count: number): number[] {
    const out: number[] = []
    for (let i = 0; i < count; i++) {
        read(first + i)
        out.push(slotOf(got.kind, got.value))
    }
    return out
}

function packRest(args: number[], rest: number): number[] {
    const fixed = args.slice(0, rest)
    while (fixed.length < rest) fixed.push(refSlot(nullishNode()))
    const extra = args.slice(rest)
    const array = effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.arrayLiteral), literalSlot(C.runtime, extra.length)])
    for (let i = 0; i < extra.length; i++) effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.arrayElement), refSlot(array), literalSlot(C.runtime, i), extra[i]])
    fixed.push(refSlot(array))
    return fixed
}

function unpackSpread(array: number, params: number): number[] {
    const args: number[] = []
    for (let i = 0; i < params; i++) args.push(refSlot(effect(NodeOp.getProp, [array, literalSlot(C.runtime, heap.indexKey(i as u32))])))
    return args
}

function callNode(target: number, receiver: number, args: number[], spread: boolean): number {
    const id = effect(NodeOp.call, [target, receiver, ...args])
    if (!spread) return id
    const n = getNode(C.runtime, id)!
    setNode(C.runtime, id, gn.makeNodeFromSlots(n.op, n.slots, n.flags | gn.NodeFlags.spread))
    return id
}

const layouts = new Map<Function, Layout>()

function layoutOf(fn: any): Layout {
    if (Number.isSafeInteger(fn.__localTarget)) return { params: fn.__args.length, rest: fn.__rest }
    if (Number.isSafeInteger(fn.__native)) return { params: fn.__args.length, rest: -1 }
    if (Number.isSafeInteger(fn.__syscall) || fn.concrete || !intrinsics.hasComputation(fn)) return unknownLayout
    const known = layouts.get(fn)
    if (known) return known
    const compiled = C.session.functionCode(fn).source.compiled
    const layout = { params: compiled.paramCount, rest: compiled.rest ? compiled.paramCount - 1 : -1 }
    layouts.set(fn, layout)
    return layout
}

function layoutOfValue(kind: number, value: number, fn: any): Layout {
    if (fn) return layoutOf(fn)
    if (kind !== Kind.Cell || heap.isOddballHandle(value as Handle)) return unknownLayout
    const target = heap.deref(value as Handle)
    const code = heap.functionBytecode(target)
    if (code === target) return unknownLayout
    const record = heap.FunctionBytecode(heap.resolveHeapCell(code))
    return { params: record.paramCount, rest: record.flags & heap.FunctionBytecodeFlags.has_rest_param ? record.paramCount - 1 : -1 }
}

function hostFunction(kind: number, value: number): any {
    if (kind === Kind.Host) return typeof C.hosts.values[value] === 'function' ? C.hosts.values[value] : undefined
    if (kind !== Kind.Cell || heap.isOddballHandle(value as Handle)) return
    const linked = C.session.stubFunctions.get(value as u32)
    if (linked) return linked
    if (!C.parent || heap.functionBytecode(heap.deref(value as Handle)) !== C.parent.fn) return
    const self = C.self
    if (!self) return
    T.usesSelf = true
    return C.opts.mapCapture ? C.opts.mapCapture(self) : self
}

function terminal(slot: number): boolean {
    const n = getNode(C.runtime, slotRef(slot))
    return !!n && (n.op === NodeOp.panic || n.op === NodeOp.trap || n.op === NodeOp.ret || n.op === NodeOp.unreachable || isThrow(C.runtime, n))
}

function panic(slot: number): number {
    if (terminal(slot)) return slot
    return refSlot(node(NodeOp.panic, [after(slot, T.regs.token)]))
}

function throws(slot: number): number {
    if (terminal(slot)) return slot
    return refSlot(node(NodeOp.rt, [refSlot(T.regs.token), literalSlot(C.runtime, RtOp.throw), slot]))
}

function ret(slot: number): number {
    return refSlot(node(NodeOp.ret, [after(slot, T.regs.token), refSlot(T.block)]))
}

const intrinsicArity = new Map<string, number>()
for (const name of ['add', 'sub', 'mul', 'div', 'rem', 'pow', 'lt', 'le', 'gt', 'ge', 'eq', 'ne', 'or', 'and', 'xor', 'ushr', 'shr', 'shl', 'mem', 'load']) intrinsicArity.set(name, 2)
for (const name of ['neg', 'not', 'convert', 'bitconvert', 'typeof', 'ret', 'stackalloc', 'stackfree']) intrinsicArity.set(name, 1)
for (const name of ['select', 'store', 'crc32']) intrinsicArity.set(name, 3)
const memoryIntrinsics = new Set<string>(['sp', 'stackalloc', 'stackfree', 'alloc', 'free'])

function intrinsic(name: string, first: number, count: number): number {
    const kinds: number[] = []
    const values: number[] = []
    const words: number[] = []
    let symbolic = false
    for (let i = 0; i < count; i++) {
        read(first + i)
        kinds.push(got.kind)
        values.push(got.value)
        words.push(wordOf(got.kind, got.value))
        if (got.kind === Kind.Node) symbolic = true
    }
    if (symbolic) {
        const first = name === 'rt' ? 0 : intrinsicArity.get(name) ?? count
        const end = name === 'rt' ? 1 : count
        for (let i = first; i < end; i++) {
            if (slotRef(words[i])) throw `fast-trace: ${name} argument ${i} must be a literal [${C.name}]`
        }
    }
    if (name === 'callcontext') return refSlot(node(NodeOp.callContext, []))
    if (name === 'load') {
        const type = slotLiteral(C.runtime, words[2])
        const loaded = effect(NodeOp.load, [words[0], words[1]], type)
        if (type !== Types.fnptr) return refSlot(loaded)
        const context = slotRef(words[1]) || slotLiteral(C.runtime, words[1]) !== 0 ? refSlot(node(NodeOp.add, [words[0], words[1]], Types.usize)) : words[0]
        return refSlot(node(NodeOp.indirectTarget, [refSlot(loaded), context]))
    }
    if (name === 'store') {
        effect(NodeOp.store, [words[0], words[1], slotOf(kinds[2], values[2])], slotLiteral(C.runtime, words[3]))
        return literalSlot(C.runtime, 0)
    }
    if (name === 'pstack') return refSlot(effect(NodeOp.pstack, words.slice(0, 3)))
    if (name === 'static') return refSlot(node(NodeOp.static, [slotOf(kinds[0], values[0])]))
    if (name === 'typeof') {
        const id = slotRef(words[0])
        const n = id ? getNode(C.runtime, id) : undefined
        if (n && gn.typeOf(n) === Types.f64) return literalSlot(C.runtime, Types.f64)
    }
    if (name === 'rt') return runtimeOp(kinds, values, words)
    if (name === 'select') {
        if (!slotRef(words[0])) return slotLiteral(C.runtime, words[0]) ? words[1] : words[2]
        return refSlot(node(NodeOp.select, words.slice(0, 3), count > 3 ? slotLiteral(C.runtime, words[3]) : Types.unknown_number))
    }
    if (!symbolic && !memoryIntrinsics.has(name)) {
        const literals: number[] = []
        for (const word of words) literals.push(slotLiteral(C.runtime, word))
        return literalSlot(C.runtime, fold(name, literals))
    }
    const op = gn.maybeNodeOp(name)
    if (op === NodeOp.none) throw `fast-trace: unsupported intrinsic ${name}${symbolic ? ' with symbolic args' : ''} [${C.name}]`
    const arity = name === 'call' ? count : intrinsicArity.get(name) ?? 0
    const type = intrinsics.resultTypeOf(name, count > arity ? slotLiteral(C.runtime, words[arity]) : undefined, count > arity + 1 ? slotLiteral(C.runtime, words[arity + 1]) : undefined)
    const id = node(op, words.slice(0, arity), type)
    if ((name === 'convert' || name === 'bitconvert') && count > arity) T.conversions.set(id, slotLiteral(C.runtime, words[arity]))
    return refSlot(id)
}

function runtimeOp(kinds: number[], values: number[], words: number[]): number {
    const op = slotLiteral(C.runtime, words[0])
    if (op === RtOp.create && kinds[1] !== Kind.Node) return slotOf(Kind.Cell, allocate(slotLiteral(C.runtime, words[1])))
    const args: number[] = [literalSlot(C.runtime, op)]
    for (let i = 1; i < kinds.length; i++) args.push(slotOf(kinds[i], values[i]))
    if (effectOps.has(op)) return refSlot(effect(NodeOp.rt, args))
    args.unshift(refSlot(heapOps.has(op) ? T.regs.token : looseNil()))
    return refSlot(node(NodeOp.rt, args))
}

function allocate(prototype: number): number {
    const cell = internCell(heap.makeObject(prototype ? heap.deref(prototype as Handle) : 0 as Handle) as number)
    T.allocations.set(cell as u32, { token: T.regs.token, call: undefined })
    return cell
}

function objectLiteral(constSlot: number, firstReg: number, lastReg: number): void {
    const keys = C.source.compiled.constants[constSlot] as string[]
    const cell = allocate(0)
    for (let r = firstReg; r <= lastReg; r++) {
        read(r)
        effect(NodeOp.setProp, [refSlot(cellNode(cell)), literalSlot(C.runtime, C.session.fromJsValue(keys[r - firstReg])), slotOf(got.kind, got.value)])
    }
    setAcc(Kind.Cell, cell)
}

function objectRest(constSlot: number): void {
    const excluded = C.source.compiled.constants[constSlot] as string[]
    const source = slotOf(accKind(), accValue())
    const cell = allocate(0)
    const operands = [literalSlot(C.runtime, RtOp.assign), refSlot(cellNode(cell)), source]
    for (const key of excluded) operands.push(literalSlot(C.runtime, C.session.fromJsValue(key)))
    effect(NodeOp.rt, operands)
    setAcc(Kind.Cell, cell)
}

function call(calleeKind: number, callee: number, receiverKind: number, receiver: number, first: number, count: number, constructing = false): number {
    if (calleeKind === Kind.Cell && callee > 1) {
        const name = C.session.intrinsicFns.get(callee as u32)
        if (name === 'panic' || name === 'trap') {
            read(first)
            T.tail = name === 'panic' ? panic(slotOf(got.kind, got.value)) : refSlot(node(NodeOp.trap, [refSlot(T.regs.token), wordOf(got.kind, got.value)]))
            return 0
        }
        if (name) return intrinsic(name, first, count)
    }
    const fn = hostFunction(calleeKind, callee)
    if (fn?.concrete) return concreteCall(fn, first, count)
    if (fn === C.session.symbolicPanic) {
        read(first)
        T.tail = panic(slotOf(got.kind, got.value))
        return 0
    }
    if (fn && Array.isArray(fn.__args) && Number.isSafeInteger(fn.__syscall)) {
        if (count !== fn.__args.length) throw `fast-trace: syscall ${fn.__syscall} takes ${fn.__args.length} arguments, got ${count} [${C.name}]`
        return refSlot(effect(NodeOp.call, [refSlot(node(NodeOp.syscallTarget, [literalSlot(C.runtime, fn.__syscall)])), literalSlot(C.runtime, 0), ...argSlots(first, count)]))
    }
    return invoke(fn, calleeKind, callee, receiverKind, receiver, argSlots(first, count), constructing)
}

function invoke(fn: any, calleeKind: number, callee: number, receiverKind: number, receiver: number, args: number[], constructing: boolean): number {
    const count = args.length
    const stub = fn && Array.isArray(fn.__args) ? stubTarget(fn) : undefined
    const layout = layoutOfValue(calleeKind, callee, fn)
    if (stub !== undefined && count > layout.params && layout.rest < 0) throw `fast-trace: ${fn.name || '<anonymous>'} takes ${fn.__args.length} arguments, got ${count} [${C.name}]`
    const target = stub ?? slotOf(calleeKind, callee)
    const self = stub !== undefined ? literalSlot(C.runtime, 0) : slotOf(receiverKind, receiver)
    const variants = !constructing && !fn?.shouldNotInline && !(fn && C.session.isConstructor(fn))
    if (argForm(layout, count, false, variants) === ArgForm.pack) return refSlot(callNode(target, self, packRest(args, layout.rest), true))
    return refSlot(callNode(target, self, args, false))
}

function stubTarget(fn: any): number | undefined {
    if (Number.isSafeInteger(fn.__localTarget)) return refSlot(node(NodeOp.localTarget, [literalSlot(C.runtime, fn.__localTarget)]))
    if (Number.isSafeInteger(fn.__native)) return literalSlot(C.runtime, fn.__native)
}

function concreteCall(fn: any, first: number, count: number): number {
    const args: number[] = []
    for (let i = 0; i < count; i++) {
        read(first + i)
        if (got.kind === Kind.Node) throw `fast-trace: ${fn.name || '<anonymous>'} is concrete but argument ${i} is symbolic [${C.name}]`
        args.push(numberOf(got.kind, got.value))
    }
    const result = fn(...args)
    if (typeof result === 'boolean') return refSlot(boolNode(result ? 1 : 0))
    return literalSlot(C.runtime, typeof result === 'number' ? result : 0)
}

function construct(calleeKind: number, callee: number, first: number, count: number): number {
    const constructor = calleeKind === Kind.Cell || calleeKind === Kind.Host ? cellOf(calleeKind, callee) : 0
    if (constructor > 1) {
        const prototype = heap.getProperty(heap.deref(constructor as Handle), heap.prototypeKey) as number
        const receiver = allocate(prototype)
        if (T.allocations.has(prototype as u32)) effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.setPrototypeOf), refSlot(cellNode(receiver)), refSlot(cellNode(prototype))])
        const result = call(calleeKind, callee, Kind.Cell, receiver, first, count, true)
        T.allocations.get(receiver as u32)!.call = slotRef(result) || undefined
        return result
    }
    const prototype = effect(NodeOp.getProp, [slotOf(calleeKind, callee), literalSlot(C.runtime, heap.prototypeKey)])
    const created = effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.create), refSlot(prototype)])
    return call(calleeKind, callee, Kind.Node, created, first, count, true)
}

function createClosure(constSlot: number): void {
    const { bytecode } = parent()
    const template = vmHandle(heap.constantAt(bytecode, constSlot as u32))
    const closure = internCell(heap.makeClosure(template, bytecode, frameCell() as Handle) as number)
    T.closures.add(closure)
    if (heap.functionBytecode(template) !== template) writeMembers(template, closure)
    setAcc(Kind.Cell, closure)
}

function defineAccessors(constSlot: number): void {
    const { bytecode } = parent()
    const template = vmHandle(heap.constantAt(bytecode, constSlot as u32))
    if (accKind() !== Kind.Cell) throw `fast-trace: accessors on a symbolic object [${C.name}]`
    const holder = accValue()
    const state = heap.isIndirect(holder as Handle) ? heap.prepareWrite(holder as Handle) : holder as Handle
    heap.closeMembers(template, state, bytecode, frameCell() as Handle)
    for (let i: u32 = 0; i < heap.ownPropertyCount(template); i++) {
        const key = heap.ownPropertyKeyAt(template, i)
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(state, key)))
        const getter = d.flags & heap.PropFlags.has_getter ? d.slot0 : heap.undefinedHandle
        const setter = d.flags & heap.PropFlags.has_setter ? d.slot1 : heap.undefinedHandle
        if (getter !== heap.undefinedHandle) T.closures.add(getter)
        if (setter !== heap.undefinedHandle) T.closures.add(setter)
        effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.defineAccessor), refSlot(cellNode(holder)), refSlot(cellNode(key)), refSlot(cellNode(getter)), refSlot(cellNode(setter))])
    }
}

function writeMembers(template: Handle, holder: number): void {
    const state = heap.deref(holder as Handle)
    for (let i: u32 = 0; i < heap.ownPropertyCount(template); i++) {
        const key = heap.ownPropertyKeyAt(template, i)
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(state, key)))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
        const member = d.slot0 as number
        if (key === heap.prototypeKey) {
            T.allocations.set(member as u32, { token: T.regs.token, call: undefined })
            writeMembers(heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(template, key))).slot0 as Handle, member)
            continue
        }
        T.closures.add(member)
        effect(NodeOp.setProp, [refSlot(cellNode(holder)), literalSlot(C.runtime, key), refSlot(cellNode(member))])
    }
}

function arrayLiteral(firstReg: number, lastReg: number): void {
    const kind: number[] = []
    const value: number[] = []
    for (let r = firstReg; r <= lastReg; r++) {
        read(r)
        kind.push(got.kind)
        value.push(got.value)
    }
    setAcc(Kind.Node, tuple(kind, value))
}

function tuple(kind: number[], value: number[]): number {
    const array = effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.arrayLiteral), literalSlot(C.runtime, kind.length)])
    for (let i = 0; i < kind.length; i++) {
        effect(NodeOp.rt, [literalSlot(C.runtime, RtOp.arrayElement), refSlot(array), literalSlot(C.runtime, i), slotOf(kind[i], value[i])])
    }
    T.tuples.set(array, { kind, value })
    return array
}

function spreadCall(calleeReg: number, arrayReg: number): void {
    read(calleeReg)
    const calleeKind = got.kind
    const callee = got.value
    const fn = hostFunction(calleeKind, callee)
    const layout = layoutOfValue(calleeKind, callee, fn)
    read(arrayReg)
    const array = slotOf(got.kind, got.value)
    const form = argForm(layout, 1, true, false)
    const stub = fn && Array.isArray(fn.__args) ? stubTarget(fn) : undefined
    const target = stub ?? slotOf(calleeKind, callee)
    const receiver = stub !== undefined ? literalSlot(C.runtime, 0) : slotOf(accKind(), accValue())
    if (form === ArgForm.unpack) setAcc(Kind.Node, callNode(target, receiver, unpackSpread(array, layout.params), false))
    else setAcc(Kind.Node, callNode(target, receiver, [array], true))
}


function copyRegisters(from: Registers): Registers {
    return { kind: from.kind.slice(), value: from.value.slice(), token: from.token }
}

function arrive(block: number, from: number): number {
    const merge = T.merges[block]
    if (!merge) return tracePath(block, T.regs)
    const regs = T.regs
    const args = [refSlot(merge.id)]
    for (const r of merge.live) args.push(regs.kind[r] === Kind.Node ? refSlot(regs.value[r]) : slotOf(regs.kind[r], regs.value[r]))
    args.push(refSlot(regs.token))
    const applied = after(refSlot(node(NodeOp.apply, args)), regs.token)
    if (C.source.blocks.backPreds[block].includes(from)) {
        assert(merge.bound, `fast-trace: back edge into unbound B${block} [${C.name}]`)
    } else {
        assert(!T.traced[block], `fast-trace: B${from} arrived after B${block} was traced [${C.name}]`)
        merge.arrivals.push({ regs: copyRegisters(regs), node: slotRef(applied) })
    }
    return applied
}

function dropTuples(merge: Merge, r: number): void {
    for (const arrival of merge.arrivals) {
        if (arrival.regs.kind[r] === Kind.Node) T.tuples.delete(arrival.regs.value[r])
    }
}

function bind(merge: Merge): Registers {
    const first = merge.arrivals[0].regs
    const regs = copyRegisters(first)
    const B = C.source.blocks
    const loopWrites = B.backPreds[merge.block].length ? B.cycleWrites[merge.block] : undefined
    regs.token = node(NodeOp.nilEffect, [refSlot(merge.id)])
    for (let i = 0; i < merge.live.length; i++) {
        const r = merge.live[i]
        let varies = !!loopWrites?.has(r)
        for (let a = 1; a < merge.arrivals.length && !varies; a++) {
            const other = merge.arrivals[a].regs
            varies = other.kind[r] !== first.kind[r] || other.value[r] !== first.value[r]
        }
        if (T.tuples.size && (varies || loopWrites)) dropTuples(merge, r)
        if (!varies) continue
        const param = merge.firstParam + i
        setDebugLabel(C.runtime, param, r === C.accRegIdx ? 'acc' : `s${r}`)
        const bools = merge.arrivals.every(arrival => boolValued(arrival.regs.kind[r], arrival.regs.value[r]))
        if (bools && !loopWrites) putNode(C.runtime, param, NodeOp.param, [], Types.bool)
        else putNode(C.runtime, param, NodeOp.param, [])
        if (bools && loopWrites) T.boolish.add(param)
        if (merge.arrivals.some(arrival => mayHoldCell(arrival.regs.kind[r], arrival.regs.value[r]))) T.cells.add(param)
        merge.params.push(param)
        merge.paramArgs.push(i + 1)
        regs.kind[r] = Kind.Node
        regs.value[r] = param
    }
    merge.bound = true
    return regs
}

function inlineMerge(merge: Merge, inlined: number[]): void {
    const arrival = merge.arrivals[0]
    merge.bound = true
    const body = slotRef(tracePath(merge.block, arrival.regs))
    assert(body, `fast-trace: B${merge.block} has one arrival and a constant body [${C.name}]`)
    inlined.push(arrival.node, body)
}

function narrowed(from: Registers, id: number, value: number, kind: number): Registers {
    let hit = false
    for (let r = 0; r <= C.accRegIdx && !hit; r++) hit = from.kind[r] === Kind.Node && from.value[r] === id
    if (!hit) return from
    const out = copyRegisters(from)
    for (let r = 0; r <= C.accRegIdx; r++) {
        if (out.kind[r] !== Kind.Node || out.value[r] !== id) continue
        out.kind[r] = kind
        out.value[r] = value
    }
    return out
}

function boolValued(kind: number, value: number): boolean {
    if (kind === Kind.Bool) return true
    if (kind !== Kind.Node) return false
    const n = getNode(C.runtime, value)
    return !!n && boolTyped(n)
}

function mayHoldCell(kind: number, value: number): boolean {
    if (kind === Kind.Cell || kind === Kind.Host) return true
    return kind === Kind.Node && T.cells.has(value)
}

function zeroWhenFalsy(id: number, n: lowering2.GraphNode): boolean {
    if (comparisonOps.has(n.op) || truthSelect(n)) return true
    if (T.cells.has(id) || T.boolish.has(id) || !gn.typeSlots(n.op)) return false
    const type = gn.typeOf(n)
    return type !== Types.unknown && type !== Types.vm_value
}

function boolTyped(n: lowering2.GraphNode): boolean {
    return gn.typeSlots(n.op) > 0 && gn.typeOf(n) === Types.bool
}

function branchRegisters(from: Registers, cond: number): Registers[] {
    const test = getNode(C.runtime, cond)
    let yes = from
    const truth = !!test && (truthSelect(test) || boolTyped(test))
    let no = test && zeroWhenFalsy(cond, test) ? narrowed(from, cond, 0, truth ? Kind.Bool : Kind.Number) : from
    if (test && (comparisonOps.has(test.op) || truthSelect(test))) yes = narrowed(from, cond, 1, Kind.Bool)
    if (test && (test.op === NodeOp.eq || test.op === NodeOp.ne)) {
        const a = getRef(test, 0)
        const b = getRef(test, 1)
        const id = a && !b ? a : b && !a ? b : 0
        const value = a && !b ? getLiteral(C.runtime, test, 1) : getLiteral(C.runtime, test, 0)
        const n = id ? getNode(C.runtime, id) : undefined
        const kind = n && boolTyped(n) && (value === 0 || value === 1) ? Kind.Bool : Kind.Number
        if (id && test.op === NodeOp.eq) yes = narrowed(yes, id, value, kind)
        if (id && test.op === NodeOp.ne) no = narrowed(no, id, value, kind)
    }
    return [yes, no]
}

function tracePath(start: number, from: Registers): number {
    const outer = T.regs
    T.regs = copyRegisters(from)
    defer finally {
        T.regs = outer
    }
    let block = start
    for (;;) {
        if (T.traced[block]) throw `fast-trace: bytecode block B${block} traced twice [${C.name}]`
        T.traced[block] = 1
        const jumpTo = traceBlock(block)
        if (T.tail) {
            const tail = T.tail
            T.tail = 0
            return tail
        }
        const exit = blockExit(block, jumpTo)
        if (exit.other < 0) {
            const next = C.shape.blockAt[exit.target]
            if (T.merges[next]) return arrive(next, block)
            block = next
            continue
        }
        const regs = T.regs
        const [yesRegs, noRegs] = branchRegisters(regs, slotRef(exit.cond))
        T.regs = yesRegs
        const yes = arrive(C.shape.blockAt[exit.target], block)
        T.regs = noRegs
        const no = arrive(C.shape.blockAt[exit.other], block)
        T.regs = regs
        return select(exit.cond, yes, no)
    }
}

interface Exit {
    target: number
    other: number
    cond: number
}

function blockExit(block: number, jumpTo: number): Exit {
    const B = C.source.blocks
    const last = B.insts[block][B.insts[block].length - 1]
    const op = last.opcode
    const next = block + 1 < B.leaders.length ? B.leaders[block + 1] : C.source.codeLen
    const exit: Exit = { target: next, other: -1, cond: 0 }
    if (jumpTo >= 0) {
        exit.target = jumpTo
    } else if (op === Op.Jump) {
        exit.target = last.jumpTarget!
    } else if (op === Op.JumpLabel) {
        exit.target = C.source.compiled.labels!.jump[last.jumpLabel!]
    } else if (op === Op.JumpAcc) {
        assert(accKind() === Kind.Number, `fast-trace: computed jump on a non-number [${C.name}]`)
        exit.target = last.pos + 1 + accValue()
    } else if (last.jumpTarget !== undefined) {
        const jumpsWhenTrue = op === Op.JumpIfToBooleanTrue || op === Op.JumpIfNullish || op === Op.JumpIfNull || op === Op.JumpIfUndefined
        const truth = op === Op.JumpIfToBooleanTrue || op === Op.JumpIfToBooleanFalse
        exit.cond = truth ? truthTest(accKind(), accValue()) : nullishTest(accKind(), accValue(), op)
        exit.target = jumpsWhenTrue ? last.jumpTarget : next
        exit.other = jumpsWhenTrue ? next : last.jumpTarget
        if (!slotRef(exit.cond)) {
            if (!slotLiteral(C.runtime, exit.cond)) exit.target = exit.other
            exit.other = -1
        }
    }
    if (exit.target >= C.source.codeLen) throw `fast-trace: B${block} runs off the end of the code [${C.name}]`
    return exit
}

function immediate(width: number, imm: number): number {
    return width === 4 && imm < 0 ? imm + 0x1_0000_0000 : imm
}

function traceBlock(block: number): number {
    const insts = C.source.blocks.insts[block]
    for (let i = 0; i < insts.length && !T.tail; i++) {
        const inst = insts[i]
        const op = inst.opcode
        const regs = inst.regs
        T.pc = inst.pos
        switch (op) {
            case Op.Nop: continue
            case Op.Star: case Op.Star0: case Op.Star1: case Op.Star2: case Op.Star3:
            case Op.Star4: case Op.Star5: case Op.Star6: case Op.Star7: case Op.Star8:
            case Op.Star9: case Op.Star10: case Op.Star11: case Op.Star12: case Op.Star13:
            case Op.Star14: case Op.Star15:
                write(regs[0], accKind(), accValue())
            case Op.Ldar: case Op.Ldar0: case Op.Ldar1: case Op.Ldar2: case Op.Ldar3:
                read(regs[0])
                setAcc(got.kind, got.value)
            case Op.Mov: case Op.MovPacked:
                read(regs[1])
                write(regs[0], got.kind, got.value)
            case Op.LdaZero: setAcc(Kind.Number, 0)
            case Op.LdaImm: setAcc(Kind.Number, immediate(inst.width, inst.imm!))
            case Op.LdaConst:
                constant(inst.constSlot!)
                setAcc(got.kind, got.value)
            case Op.LdaUndefined: setAcc(Kind.Cell, heap.undefinedHandle)
            case Op.LdaNull: setAcc(Kind.Cell, heap.nullHandle)
            case Op.LdaTrue: setAcc(Kind.Bool, 1)
            case Op.LdaFalse: setAcc(Kind.Bool, 0)
            case Op.LoadFrame:
                constant(inst.constSlot!)
                setAcc(Kind.Node, effect(NodeOp.getProp, [slotOf(got.kind, got.value), literalSlot(C.runtime, heap.indexKey(inst.frameReg! as u32))]))
            case Op.StoreFrame:
                constant(inst.constSlot!)
                effect(NodeOp.setProp, [slotOf(got.kind, got.value), literalSlot(C.runtime, heap.indexKey(inst.frameReg! as u32)), slotOf(accKind(), accValue())])
            case Op.Add: case Op.Sub: case Op.Mul: case Op.Div: case Op.Mod: case Op.Exp:
            case Op.BitOr: case Op.BitAnd: case Op.BitXor: case Op.ShiftLeft: case Op.ShiftRight: case Op.ShiftRightLogical:
            case Op.TestLessThan: case Op.TestGreaterThan: case Op.TestLessThanOrEqual: case Op.TestGreaterThanOrEqual:
                read(regs[0])
                binary(binaryNames[op], accKind(), accValue(), got.kind, got.value)
            case Op.AddOrConcat: concat(regs[0], true)
            case Op.Concat: concat(regs[0], false)
            case Op.TestStrictEqual: strictEqual(regs[0], false)
            case Op.TestNotStrictEqual: strictEqual(regs[0], true)
            case Op.IncPost: case Op.DecPost: {
                read(regs[0])
                setAcc(got.kind, got.value)
                numericAcc()
                const kind = accKind()
                const value = accValue()
                binary(op === Op.IncPost ? 'add' : 'sub', kind, value, Kind.Number, 1)
                write(regs[0], accKind(), accValue())
                setAcc(kind, value)
            }
            case Op.Inc: {
                numericAcc()
                binary('add', accKind(), accValue(), Kind.Number, 1)
            }
            case Op.Dec: {
                numericAcc()
                binary('sub', accKind(), accValue(), Kind.Number, 1)
            }
            case Op.Negate: unary('neg')
            case Op.BitNot: unary('not')
            case Op.LogicalNot: logicalNot(false)
            case Op.LogicalNotNot: logicalNot(true)
            case Op.ToNumber: toNumberAcc()
            case Op.TypeOf: typeOfAcc()
            case Op.GetProperty:
                read(regs[0])
                getProp(propertyKey(got.kind, got.value))
            case Op.GetPropertyConst:
                constant(inst.constSlot!)
                getProp(propertyKey(got.kind, got.value))
            case Op.GetPropertyImm: getProp(literalSlot(C.runtime, heap.indexKey(inst.imm! as u32)))
            case Op.GetPrototype: prototypeAcc()
            case Op.GetSuperProperty: superProperty(regs[0], regs[1])
            case Op.SetProperty:
                read(regs[1])
                setProp(regs[0], propertyKey(got.kind, got.value))
            case Op.SetPropertyConst:
                constant(inst.constSlot!)
                setProp(regs[0], propertyKey(got.kind, got.value))
            case Op.SetPropertyImm: setProp(regs[0], literalSlot(C.runtime, heap.indexKey(inst.imm! as u32)))
            case Op.DeleteProperty:
                read(regs[0])
                deleteProp(propertyKey(got.kind, got.value))
            case Op.CreateObjectRest: objectRest(inst.constSlot!)
            case Op.DefineAccessors: defineAccessors(inst.constSlot!)
            case Op.CreateEmptyObject: setAcc(Kind.Cell, allocate(0))
            case Op.CreateObjectLiteral: objectLiteral(inst.constSlot!, regs[0], regs[1])
            case Op.CreateClosure: createClosure(inst.constSlot!)
            case Op.CreateEmptyArray:
                constant(inst.constSlot!)
                setAccSlot(construct(got.kind, got.value, 0, 0))
            case Op.CreateArrayLiteral: arrayLiteral(regs[0], regs[1])
            case Op.Call: {
                read(regs[0])
                const count = regs.length === 3 ? regs[2] - regs[1] + 1 : 0
                setAccSlot(call(got.kind, got.value, accKind(), accValue(), count ? regs[1] : 0, count))
            }
            case Op.CallConst: {
                constant(inst.constSlot!)
                const count = regs.length ? regs[1] - regs[0] + 1 : 0
                setAccSlot(call(got.kind, got.value, accKind(), accValue(), count ? regs[0] : 0, count))
            }
            case Op.CallRuntime: {
                fromHost(bindingOf(inst.imm!)!.impl!)
                const count = regs.length ? regs[1] - regs[0] + 1 : 0
                setAccSlot(call(got.kind, got.value, accKind(), accValue(), count ? regs[0] : 0, count))
            }
            case Op.Construct: {
                read(regs[0])
                const count = regs.length === 3 ? regs[2] - regs[1] + 1 : 0
                setAccSlot(construct(got.kind, got.value, count ? regs[1] : 0, count))
            }
            case Op.ConstructConst: {
                constant(inst.constSlot!)
                const count = regs.length ? regs[1] - regs[0] + 1 : 0
                setAccSlot(construct(got.kind, got.value, count ? regs[0] : 0, count))
            }
            case Op.CallArray: spreadCall(regs[0], regs[1])
            case Op.Return: T.tail = ret(slotOf(accKind(), accValue()))
            case Op.ReturnVoid: T.tail = ret(refSlot(node(NodeOp.void, [])))
            case Op.Throw: case Op.ReThrow: {
                const handler = bytecode.ehHandler(C.source.compiled.labels?.eh ?? [], inst.pos + 1)
                if (handler >= 0) return handler
                T.tail = throws(slotOf(accKind(), accValue()))
            }
            case Op.Jump: case Op.JumpIfNull: case Op.JumpIfUndefined: case Op.JumpIfNullish:
            case Op.JumpIfToBooleanFalse: case Op.JumpIfNotNull: case Op.JumpIfNotUndefined:
            case Op.JumpIfNotNullish: case Op.JumpIfToBooleanTrue: case Op.JumpAcc: case Op.JumpLabel:
                continue
            default: throw `fast-trace: unsupported opcode ${inst.opname} [${C.name}]`
        }
    }
    return -1
}

function traceSource(): FastTraced {
    const { session, runtime, source, shape, opts, accRegIdx } = C
    const compiled = source.compiled
    T = {
        interned: new Map(),
        regs: { kind: new Uint8Array(accRegIdx + 1), value: new Float64Array(accRegIdx + 1), token: 0 }, block: 0, tail: 0,
        merges: [], traced: new Uint8Array(source.blocks.leaders.length),
        allocations: new Map(), closures: new Set(), usesSelf: false, pc: 0, accesses: new Map(), tuples: new Map(), cells: new Set(), boolish: new Set(), conversions: new Map(),
    }
    C.root = uniqueNode(NodeOp.block)
    T.block = C.root
    if (opts.env) bindScope()
    bindEntry()
    for (let i = 0; i < shape.merges.length; i++) {
        const block = shape.merges[i]
        const live = shape.live[i]
        const id = uniqueNode(NodeOp.block)
        setDebugLabel(runtime, id, `B${block}`)
        const firstParam = runtime.ids.next
        runtime.ids.next += live.length
        T.merges[block] = { block, id, live, firstParam, arrivals: [], params: [], paramArgs: [], bound: false, body: 0 }
    }
    let result = 0
    const inlined: number[] = []
    const bodies = new Map<number, Merge>()
    try {
        result = arrive(0, -1)
        for (const block of source.blocks.order) {
            const merge = T.merges[block]
            if (!merge?.arrivals.length) continue
            T.block = merge.id
            if (merge.arrivals.length === 1 && !source.blocks.backPreds[block].length) {
                inlineMerge(merge, inlined)
                continue
            }
            merge.body = tracePath(block, bind(merge))
            bodies.set(merge.id, merge)
        }
        for (let i = inlined.length - 2; i >= 0; i -= 2) setNode(runtime, inlined[i], gn.copyNode(runtime, getNode(runtime, inlined[i + 1])!))
    } catch (e) {
        if (opts.verbose || intrinsics.argv().includes('fast-trace-debug')) {
            console.log(`fast-trace failed in ${C.name}`)
            console.log(bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount))
        }
        throw e
    }
    const graph = assembleGraph(result, bodies)
    const frames = new Map<u32, number>()
    if (C.frame) {
        heap.releaseFrameProxy(C.frame.id as u32)
        frames.set(C.frame.cell as u32, bytecode.frameSize(source.captured))
    }
    if (opts.verbose) console.log(lowering2.dumpGraph(graph))
    return {
        graph,
        session,
        frameProxy: C.frame?.cell as u32 | undefined,
        frames,
        allocations: T.allocations,
        closures: T.closures,
        usesSelf: T.usesSelf,
        accesses: T.accesses,
        conversions: T.conversions,
    }
}

function bindScope(): void {
    const context = node(NodeOp.callContext, [])
    const bindings = C.source.compiled.scopeBindings
    for (let i = 0; i < bindings.length; i++) {
        C.constants.kind[bindings[i].slot] = Kind.Node
        C.constants.value[bindings[i].slot] = node(NodeOp.getProp, [refSlot(looseNil()), refSlot(context), literalSlot(C.runtime, heap.closureScopeKey(i as u32))])
    }
}

function bindEntry(): void {
    const { runtime, opts } = C
    const regs = T.regs
    const compiled = C.source.compiled
    const extras = opts.restExtras
    const spreadFixed = opts.spreadFixed
    const fixed = extras === undefined ? compiled.paramCount : compiled.paramCount - extras
    const registers = spreadFixed !== undefined ? spreadFixed + 1 : extras === undefined ? compiled.paramCount : fixed + 1
    for (let i = 0; i < compiled.paramCount; i++) {
        const param = runtime.ids.next++
        setDebugLabel(runtime, param, `p${i}`)
        putNode(runtime, param, NodeOp.param, [], Types.u64)
        C.params.push(param)
        if (i >= fixed) continue
        regs.kind[i] = Kind.Node
        regs.value[i] = param
    }
    if (opts.receiver) {
        const receiver = runtime.ids.next++
        setDebugLabel(runtime, receiver, 'this')
        setNode(runtime, receiver, gn.createThisParam(runtime))
        C.params.push(receiver)
        regs.kind[C.accRegIdx] = Kind.Node
        regs.value[C.accRegIdx] = receiver
    } else if (compiled.expandos !== undefined) {
        regs.kind[C.accRegIdx] = Kind.Cell
        regs.value[C.accRegIdx] = internCell(heap.makeObject(heap.deref(heap.getPrototypeProperty(parent().fn as Handle))) as number)
    }
    regs.token = node(NodeOp.nilEffect, [refSlot(C.root)])
    if (extras !== undefined) {
        const kind: number[] = []
        const value: number[] = []
        for (let i = 0; i < extras; i++) {
            kind.push(Kind.Node)
            value.push(C.params[fixed + i])
        }
        regs.kind[fixed] = Kind.Node
        regs.value[fixed] = tuple(kind, value)
    }
    if (spreadFixed !== undefined) {
        const args = refSlot(C.params[0])
        for (let i = 0; i < spreadFixed; i++) {
            regs.kind[i] = Kind.Node
            regs.value[i] = effect(NodeOp.getProp, [args, literalSlot(runtime, heap.indexKey(i as u32))])
        }
        const slice = effect(NodeOp.getProp, [args, literalSlot(runtime, C.session.fromJsValue('slice') as number)])
        regs.kind[spreadFixed] = Kind.Node
        regs.value[spreadFixed] = callNode(refSlot(slice), args, [slotOf(Kind.Number, spreadFixed)], false)
    }
    for (let r = 0; r < registers; r++) {
        if (!C.shape.captured[r]) continue
        regs.token = node(NodeOp.setProp, [refSlot(regs.token), refSlot(cellNode(frameCell())), frameKey(r), slotOf(regs.kind[r], regs.value[r])])
    }
}

interface SourceShape {
    blockAt: Int32Array
    captured: Uint8Array
    shared: Uint8Array
    merges: number[]
    live: number[][]
}

const shapes = new WeakMap<CompiledSource, SourceShape>()

function shapeOf(source: CompiledSource): SourceShape {
    const known = shapes.get(source)
    if (known) return known
    const B = source.blocks
    const token = source.compiled.registerCount + 1
    const blockAt = new Int32Array(source.codeLen + 1)
    for (let i = 0; i < B.leaders.length; i++) blockAt[B.leaders[i]] = i
    const captured = new Uint8Array(token + 1)
    for (const r of source.captured.reads) captured[r] = 1
    const shared = new Uint8Array(token + 1)
    for (const r of source.captured.writes) {
        captured[r] = 1
        shared[r] = 1
    }
    const merges: number[] = []
    const live: number[][] = []
    for (const b of B.order) {
        if (B.preds[b].length < 2 && !B.backPreds[b].length && !exitsNestedLoop(B, b)) continue
        const own: number[] = []
        for (const r of B.liveIn[b]) if (r !== token && !shared[r]) own.push(r)
        own.sort((x, y) => x - y)
        merges.push(b)
        live.push(own)
    }
    const shape = { blockAt, captured, shared, merges, live }
    shapes.set(source, shape)
    return shape
}

function exitsNestedLoop(B: CompiledSource['blocks'], b: number): boolean {
    for (const p of B.preds[b]) {
        if (!B.backPreds[p].length || B.cycles[p].has(b)) continue
        for (const m of B.cycles[p]) if (m !== p && (B.preds[m].length >= 2 || B.backPreds[m].length > 0)) return true
    }
    return false
}

function assembleGraph(result: number, bodies: Map<number, Merge>): lowering2.Graph {
    const runtime = C.runtime
    const graph = createGraph({ ids: runtime.ids, literals: runtime.literals, root: C.root, debugLabels: runtime.debugLabels, name: C.name || undefined })
    const base = C.root
    const marked = new Uint8Array(runtime.ids.next - base)
    const older = new Set<number>()
    const blocks: lowering2.GraphBlock[] = []
    const order: number[] = []
    const applies = new Map<number, lowering2.GraphNode>()
    function visit(id: number): number {
        if (!id) return id
        if (id >= base) {
            if (marked[id - base]) return id
            marked[id - base] = 1
        } else {
            if (older.has(id)) return id
            older.add(id)
        }
        const n = getNode(runtime, id)
        if (!n) return id
        if (n.op === NodeOp.block) {
            const merge = bodies.get(id)
            if (merge) blocks.push({ id, params: merge.params.slice(), bodyId: visit(slotRef(merge.body)), bodyConst: slotRef(merge.body) ? 0 : slotLiteral(C.runtime, merge.body) })
        }
        if (n.op === NodeOp.apply) {
            const merge = bodies.get(getRef(n, 0))
            const operands: gn.Operand[] = [visit(getRef(n, 0))]
            for (const i of merge?.paramArgs ?? []) operands.push(visit(getRef(n, i)) || { literal: getLiteral(runtime, n, i) })
            order.push(id)
            applies.set(id, gn.copyNode(runtime, n, operands))
            return id
        }
        for (let i = 0; i < countIds(n); i++) visit(getRef(n, i))
        visit(gn.typeRefOf(n))
        if (n.op === NodeOp.heapHandle && !getRef(n, 0)) visit(T.allocations.get(getLiteral(runtime, n, 0) as u32)?.token ?? 0)
        order.push(id)
        return id
    }
    blocks.unshift({ id: visit(C.root), params: C.params, bodyId: visit(slotRef(result)), bodyConst: slotRef(result) ? 0 : slotLiteral(C.runtime, result) })
    for (const block of blocks) for (const param of block.params) visit(param)
    if (T.closures.size && C.opts.env) for (const binding of C.source.compiled.scopeBindings) visit(C.constants.value[binding.slot])
    order.sort((a, b) => a - b)
    for (const id of order) setNode(graph, id, applies.get(id) ?? getNode(runtime, id)!)
    setGraphBlocks(graph, blocks)
    return graph
}

function hostBinding(name: string): any {
    if (name.startsWith('$') && name[1] !== '$') {
        const capture = C.captures?.[Number(name.slice(1))]
        if (capture === Symbol) return heap.symbolConstants
        if (capture === intrinsics.Intrinsics) return C.session.moduleContext.Intrinsics
        if (capture === intrinsics) return C.session.moduleContext
        if (capture === intrinsics.Types) return C.session.typesWrapper
        if (capture === intrinsics.isNative) return C.session.moduleContext.isNative
        return capture
    }
    if (name in C.session.globals) return C.session.globals[name]
    throw `fast-trace: failed to find symbol ${name} [${C.name}]`
}

function isFrozenHost(host: any): boolean {
    if (host === heap.symbolConstants) return true
    return host !== null && typeof host === 'object' && Object.isFrozen(host)
}

const frozenBySession = new WeakMap<TraceSession, Set<number>>()

function frozenCellsOf(session: TraceSession): Set<number> {
    const known = frozenBySession.get(session)
    if (known) return known
    const cells = new Set<number>()
    for (const value of [session.moduleContext.Intrinsics, session.typesWrapper]) {
        const cell = session.fromJsValue(value)
        if (cell > 1) cells.add(cell)
    }
    frozenBySession.set(session, cells)
    return cells
}
