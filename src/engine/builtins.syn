import * as intrinsics from './intrinsics'
import './heap' // XXX: the dynamic imports below would evaluate heap out of band before the static graph reaches it, and the loader then never resumes the static graph

export { globals } from './builtin/globals'
export { allocate, markStacks, programStack, programStackTop, releaseProgramStack, releaseStacks, stackCount, stackTops } from './builtin/memory'

const dir = `${import.meta.dirname}/builtin`
await Promise.all(intrinsics.readDir(dir).map(file => import(`${dir}/${file.replace(/\.syn$/, '')}`)))
