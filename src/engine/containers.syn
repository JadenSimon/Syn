/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import * as syscalls from './syscalls'

type usize = u32
const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const tagInline = intrinsics.tagInline

interface VecHeader {
    length: u32
    capacity: u32
}

const VecHead = intrinsics.DefineStructView(reify VecHeader)
const vecHeaderSize = VecHead.sizeof
const mapHeaderSize = 16 as u32

function defineValueIterator(base: u32, stride: u32, offset: u32) {
    type Self = { __address: usize, index: u32 }
    const properties = {
        next: tagInline(function(this: Self): IteratorResult<u32> {
            const index = this.index
            const length = Intrinsics.load(this.__address, 0, Types.u32)
            if (index >= length) return { done: true, value: 0 }
            this.index = index + 1
            return { done: false, value: Intrinsics.load(this.__address, base + index * stride + offset, Types.u32) }
        }),
        [Symbol.iterator]: tagInline(function(this: Self) { return this }),
    }
    const f = function(ptr: usize): IterableIterator<u32> {
        return Object.setPrototypeOf({ __address: ptr, index: 0 }, properties) as any
    }
    f.shouldInline = true
    return f
}

const valueIterator = defineValueIterator(vecHeaderSize, 4, 0)
const mapKeyIterator = defineValueIterator(mapHeaderSize, 8, 0)
const mapValueIterator = defineValueIterator(mapHeaderSize, 8, 4)

function defineEntryIterator(base: u32) {
    type Self = { __address: usize, index: u32 }
    const properties = {
        next: tagInline(function(this: Self): IteratorResult<[u32, u32]> {
            const index = this.index
            const length = Intrinsics.load(this.__address, 0, Types.u32)
            if (index >= length) return { done: true, value: [0, 0] }
            this.index = index + 1
            const offset = base + index * 8
            const key = Intrinsics.load(this.__address, offset, Types.u32)
            const value = Intrinsics.load(this.__address, offset + 4, Types.u32)
            return { done: false, value: [key, value] }
        }),
        [Symbol.iterator]: tagInline(function(this: Self) { return this }),
    }
    const f = function(ptr: usize): IterableIterator<[u32, u32]> {
        return Object.setPrototypeOf({ __address: ptr, index: 0 }, properties) as any
    }
    f.shouldInline = true
    return f
}
const mapEntryIterator = defineEntryIterator(mapHeaderSize)

interface VecView {
    __address: usize
    length: u32
    readonly capacity: u32
    get(index: u32): u32
    set(index: u32, value: u32): void
    push(value: u32): void
    pop(): u32
    clear(): void
    values(): IterableIterator<u32>
    [Symbol.iterator](): IterableIterator<u32>
}

interface VecAllocator {
    alloc(bytes: usize): usize
    free(ptr: usize, bytes: usize): void
}

function defineVec(allocator?: VecAllocator) {
    type Self = { __address: usize }
    const elementSize = 4 as u32
    const grow = function(addr: usize, length: u32, capacity: u32) {
        if (!allocator) return 0
        const next = capacity === 0 ? 4 as u32 : capacity * 2
        const ptr = allocator.alloc(vecHeaderSize + next * elementSize)
        intrinsics.memcpy(ptr, addr, vecHeaderSize + length * elementSize)
        Intrinsics.store(ptr, 4, next, Types.u32)
        allocator.free(addr, vecHeaderSize + capacity * elementSize)
        return ptr
    }
    const properties = Object.defineProperties({}, {
        [Symbol.iterator]: {
            value: tagInline(function(this: Self) { return valueIterator(this.__address) }),
        },
        values: {
            value: tagInline(function(this: Self) { return valueIterator(this.__address) }),
            enumerable: true,
        },
        length: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 0, Types.u32)
            }),
            set: tagInline(function(this: Self, value: u32) {
                Intrinsics.store(this.__address, 0, value, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        capacity: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        get: {
            value: tagInline(function(this: Self, index: u32) {
                return Intrinsics.load(this.__address, vecHeaderSize + index * elementSize, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        set: {
            value: tagInline(function(this: Self, index: u32, value: u32) {
                Intrinsics.store(this.__address, vecHeaderSize + index * elementSize, value, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        push: {
            value: tagInline(function(this: Self, value: u32) {
                const n = Intrinsics.load(this.__address, 0, Types.u32)
                if (!allocator) {
                    intrinsics.assert(n < Intrinsics.load(this.__address, 4, Types.u32))
                } else {
                    const capacity = Intrinsics.load(this.__address, 4, Types.u32)
                    if (n >= capacity) this.__address = grow(this.__address, n, capacity)
                }
                Intrinsics.store(this.__address, vecHeaderSize + n * elementSize, value, Types.u32)
                Intrinsics.store(this.__address, 0, n + 1, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        pop: {
            value: tagInline(function(this: Self, ) {
                const n = Intrinsics.load(this.__address, 0, Types.u32) - 1
                Intrinsics.store(this.__address, 0, n, Types.u32)
                return Intrinsics.load(this.__address, vecHeaderSize + n * elementSize, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        clear: {
            value: tagInline(function(this: Self) {
                Intrinsics.store(this.__address, 0, 0, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
    })
    const f = function(ptr: usize) {
        if (allocator && ptr === 0) {
            ptr = allocator.alloc(vecHeaderSize + 4 * elementSize)
            initVec(ptr, 4)
        }
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as VecView
    }
    f.shouldInline = true
    return f
}

export const Vec = defineVec()
export const U32Array = Vec

export function u32ArrayBytes(capacity: u32): usize {
    return vecHeaderSize + capacity * 4
}

export function initU32Array(ptr: usize, capacity: u32): void {
    initVec(ptr, capacity)
}

interface U32SetView {
    __address: usize
    readonly size: u32
    readonly capacity: u32
    has(value: u32): boolean
    add(value: u32): void
    delete(value: u32): boolean
    pop(): u32
    clear(): void
    values(): IterableIterator<u32>
    [Symbol.iterator](): IterableIterator<u32>
}

function defineU32Set() {
    type Self = { __address: usize }
    const properties = Object.defineProperties({}, {
        [Symbol.iterator]: {
            value: tagInline(function(this: Self) { return valueIterator(this.__address) }),
        },
        values: {
            value: tagInline(function(this: Self) { return valueIterator(this.__address) }),
            enumerable: true,
        },
        size: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 0, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        capacity: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        has: {
            value: tagInline(function(this: Self, value: u32): boolean {
                const length = Intrinsics.load(this.__address, 0, Types.u32)
                for (let i: u32 = 0; i < length; i++) {
                    if (Intrinsics.load(this.__address, vecHeaderSize + i * 4, Types.u32) === value) return true
                }
                return false
            }),
            enumerable: true,
            configurable: true,
        },
        add: {
            value: tagInline(function(this: Self, value: u32): void {
                const length = Intrinsics.load(this.__address, 0, Types.u32)
                for (let i: u32 = 0; i < length; i++) {
                    if (Intrinsics.load(this.__address, vecHeaderSize + i * 4, Types.u32) === value) return
                }
                intrinsics.assert(length < Intrinsics.load(this.__address, 4, Types.u32))
                Intrinsics.store(this.__address, vecHeaderSize + length * 4, value, Types.u32)
                Intrinsics.store(this.__address, 0, length + 1, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        delete: {
            value: tagInline(function(this: Self, value: u32): boolean {
                const length = Intrinsics.load(this.__address, 0, Types.u32)
                for (let i: u32 = 0; i < length; i++) {
                    if (Intrinsics.load(this.__address, vecHeaderSize + i * 4, Types.u32) !== value) continue
                    const next = length - 1
                    if (i !== next) {
                        const last = Intrinsics.load(this.__address, vecHeaderSize + next * 4, Types.u32)
                        Intrinsics.store(this.__address, vecHeaderSize + i * 4, last, Types.u32)
                    }
                    Intrinsics.store(this.__address, 0, next, Types.u32)
                    return true
                }
                return false
            }),
            enumerable: true,
            configurable: true,
        },
        pop: {
            value: tagInline(function(this: Self): u32 {
                const next = Intrinsics.load(this.__address, 0, Types.u32) - 1
                Intrinsics.store(this.__address, 0, next, Types.u32)
                return Intrinsics.load(this.__address, vecHeaderSize + next * 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        clear: {
            value: tagInline(function(this: Self): void {
                Intrinsics.store(this.__address, 0, 0, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
    })
    const f = function(ptr: usize) {
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as U32SetView
    }
    f.shouldInline = true
    return f
}

export const U32Set = defineU32Set()

export function u32SetBytes(capacity: u32): usize {
    return vecHeaderSize + capacity * 4
}

export function initU32Set(ptr: usize, capacity: u32): void {
    initVec(ptr, capacity)
}

interface U32MapView {
    __address: usize
    readonly size: u32
    readonly capacity: u32
    has(key: u32): boolean
    get(key: u32): u32
    set(key: u32, value: u32): void
    append(key: u32, value: u32): void
    delete(key: u32): boolean
    keyAt(index: u32): u32
    valueAt(index: u32): u32
    clear(): void
    keys(): IterableIterator<u32>
    values(): IterableIterator<u32>
    entries(): IterableIterator<[u32, u32]>
    [Symbol.iterator](): IterableIterator<[u32, u32]>
}

const mapLinearMax = 8 as u32
const mapEmptySlot = 0 as u32
const mapDeadSlot = 0xFFFFFFFF as u32

function mapHash(key: u32): u32 {
    let h = key
    h = ((h ^ (h >>> 16)) >>> 0) as u32
    h = ((h ^ (h << 5)) >>> 0) as u32
    h = ((h ^ (h >>> 7)) >>> 0) as u32
    h = ((h ^ (h << 11)) >>> 0) as u32
    return ((h ^ (h >>> 13)) >>> 0) as u32
}

function mapSlotOf(addr: usize, table: u32, mask: u32, key: u32): u32 {
    const miss = mask + 1
    let slot = mapHash(key) & mask
    for (let probe: u32 = 0; probe <= mask; probe++) {
        const e = Intrinsics.load(addr, table + slot * 4, Types.u32)
        if (e === mapEmptySlot) return miss
        if (e !== mapDeadSlot
            && Intrinsics.load(addr, mapHeaderSize + (e - 1) * 8, Types.u32) === key) return slot
        slot = (slot + 1) & mask
    }
    return miss
}

function mapFreeSlot(addr: usize, table: u32, mask: u32, key: u32): u32 {
    let slot = mapHash(key) & mask
    for (let probe: u32 = 0; probe <= mask; probe++) {
        const e = Intrinsics.load(addr, table + slot * 4, Types.u32)
        if (e === mapEmptySlot || e === mapDeadSlot) return slot
        slot = (slot + 1) & mask
    }
    return 0
}

function mapLookup(addr: usize, key: u32): u32 {
    const buckets = Intrinsics.load(addr, 8, Types.u32)
    if (buckets === 0) {
        const length = Intrinsics.load(addr, 0, Types.u32)
        for (let i: u32 = 0; i < length; i++) {
            if (Intrinsics.load(addr, mapHeaderSize + i * 8, Types.u32) === key) return i + 1
        }
        return 0
    }
    const mask = buckets - 1
    const table = mapHeaderSize + Intrinsics.load(addr, 4, Types.u32) * 8
    const slot = mapSlotOf(addr, table, mask, key)
    if (slot > mask) return 0
    return Intrinsics.load(addr, table + slot * 4, Types.u32)
}

function mapReindex(addr: usize): u32 {
    const capacity = Intrinsics.load(addr, 4, Types.u32)
    const ceiling = u32MapBuckets(capacity)
    const wanted = u32MapBuckets(Intrinsics.load(addr, 0, Types.u32) * 2)
    const buckets = wanted > ceiling ? ceiling : wanted
    const table = mapHeaderSize + capacity * 8
    for (let i: u32 = 0; i < buckets; i++) Intrinsics.store(addr, table + i * 4, 0, Types.u32)
    const mask = buckets - 1
    const length = Intrinsics.load(addr, 0, Types.u32)
    for (let i: u32 = 0; i < length; i++) {
        const key = Intrinsics.load(addr, mapHeaderSize + i * 8, Types.u32)
        Intrinsics.store(addr, table + mapFreeSlot(addr, table, mask, key) * 4, i + 1, Types.u32)
    }
    Intrinsics.store(addr, 8, buckets, Types.u32)
    Intrinsics.store(addr, 12, 0, Types.u32)
    return buckets
}

tagInline(mapHash)
tagInline(mapSlotOf)
tagInline(mapFreeSlot)

function mapIndexAppended(addr: usize): void {
    const length = Intrinsics.load(addr, 0, Types.u32)
    const buckets = Intrinsics.load(addr, 8, Types.u32)
    if (buckets === 0) {
        if (length > mapLinearMax) mapReindex(addr)
        return
    }
    const dead = Intrinsics.load(addr, 12, Types.u32)
    if ((length + dead) * 4 >= buckets * 3) {
        mapReindex(addr)
        return
    }
    const mask = buckets - 1
    const table = mapHeaderSize + Intrinsics.load(addr, 4, Types.u32) * 8
    const key = Intrinsics.load(addr, mapHeaderSize + (length - 1) * 8, Types.u32)
    Intrinsics.store(addr, table + mapFreeSlot(addr, table, mask, key) * 4, length, Types.u32)
}

function defineU32Map(allocator?: VecAllocator) {
    type Self = { __address: usize }
    const entrySize = 8 as u32
    const grow = function(addr: usize, length: u32, capacity: u32) {
        if (!allocator) return 0
        const next = capacity === 0 ? 4 as u32 : capacity * 2
        const ptr = allocator.alloc(u32MapBytes(next))
        intrinsics.memcpy(ptr, addr, mapHeaderSize + length * entrySize)
        Intrinsics.store(ptr, 4, next, Types.u32)
        Intrinsics.store(ptr, 8, 0, Types.u32)
        Intrinsics.store(ptr, 12, 0, Types.u32)
        allocator.free(addr, u32MapBytes(capacity))
        return ptr
    }
    const properties = Object.defineProperties({}, {
        [Symbol.iterator]: {
            value: tagInline(function(this: Self) { return mapEntryIterator(this.__address) }),
        },
        entries: {
            value: tagInline(function(this: Self) { return mapEntryIterator(this.__address) }),
            enumerable: true,
        },
        keys: {
            value: tagInline(function(this: Self) { return mapKeyIterator(this.__address) }),
            enumerable: true,
        },
        values: {
            value: tagInline(function(this: Self) { return mapValueIterator(this.__address) }),
            enumerable: true,
        },
        size: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 0, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        capacity: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        has: {
            value: tagInline(function(this: Self, key: u32): boolean {
                return mapLookup(this.__address, key) !== 0
            }),
            enumerable: true,
            configurable: true,
        },
        get: {
            value: tagInline(function(this: Self, key: u32): u32 {
                const found = mapLookup(this.__address, key)
                if (found === 0) return 0
                return Intrinsics.load(this.__address, mapHeaderSize + (found - 1) * entrySize + 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        set: {
            value: tagInline(function mapSet(this: Self, key: u32, value: u32): void {
                const found = mapLookup(this.__address, key)
                if (found !== 0) {
                    Intrinsics.store(this.__address,
                        mapHeaderSize + (found - 1) * entrySize + 4, value, Types.u32)
                    return
                }
                const length = Intrinsics.load(this.__address, 0, Types.u32)
                if (!allocator) {
                    intrinsics.assert(length < Intrinsics.load(this.__address, 4, Types.u32))
                } else {
                    const capacity = Intrinsics.load(this.__address, 4, Types.u32)
                    if (length >= capacity) this.__address = grow(this.__address, length, capacity)
                }
                const offset = mapHeaderSize + length * entrySize
                Intrinsics.store(this.__address, offset, key, Types.u32)
                Intrinsics.store(this.__address, offset + 4, value, Types.u32)
                Intrinsics.store(this.__address, 0, length + 1, Types.u32)
                mapIndexAppended(this.__address)
            }),
            enumerable: true,
            configurable: true,
        },
        append: {
            value: tagInline(function(this: Self, key: u32, value: u32): void {
                const length = Intrinsics.load(this.__address, 0, Types.u32)
                if (!allocator) {
                    intrinsics.assert(length < Intrinsics.load(this.__address, 4, Types.u32))
                } else {
                    const capacity = Intrinsics.load(this.__address, 4, Types.u32)
                    if (length >= capacity) this.__address = grow(this.__address, length, capacity)
                }
                const offset = mapHeaderSize + length * entrySize
                Intrinsics.store(this.__address, offset, key, Types.u32)
                Intrinsics.store(this.__address, offset + 4, value, Types.u32)
                Intrinsics.store(this.__address, 0, length + 1, Types.u32)
                mapIndexAppended(this.__address)
            }),
            enumerable: true,
            configurable: true,
        },
        delete: {
            value: tagInline(function(this: Self, key: u32): boolean {
                const addr = this.__address
                const found = mapLookup(addr, key)
                if (found === 0) return false
                const index = found - 1
                const next = Intrinsics.load(addr, 0, Types.u32) - 1
                const buckets = Intrinsics.load(addr, 8, Types.u32)
                if (buckets !== 0) {
                    const mask = buckets - 1
                    const table = mapHeaderSize + Intrinsics.load(addr, 4, Types.u32) * 8
                    Intrinsics.store(addr, table + mapSlotOf(addr, table, mask, key) * 4,
                        mapDeadSlot, Types.u32)
                    if (index !== next) {
                        const moved = Intrinsics.load(addr, mapHeaderSize + next * entrySize, Types.u32)
                        Intrinsics.store(addr, table + mapSlotOf(addr, table, mask, moved) * 4,
                            found, Types.u32)
                    }
                    Intrinsics.store(addr, 12, Intrinsics.load(addr, 12, Types.u32) + 1, Types.u32)
                }
                if (index !== next) {
                    const offset = mapHeaderSize + index * entrySize
                    const last = mapHeaderSize + next * entrySize
                    Intrinsics.store(addr, offset, Intrinsics.load(addr, last, Types.u32), Types.u32)
                    Intrinsics.store(addr, offset + 4,
                        Intrinsics.load(addr, last + 4, Types.u32), Types.u32)
                }
                Intrinsics.store(addr, 0, next, Types.u32)
                return true
            }),
            enumerable: true,
            configurable: true,
        },
        keyAt: {
            value: tagInline(function(this: Self, index: u32): u32 {
                intrinsics.assert(index < Intrinsics.load(this.__address, 0, Types.u32))
                return Intrinsics.load(this.__address, mapHeaderSize + index * entrySize, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        valueAt: {
            value: tagInline(function(this: Self, index: u32): u32 {
                intrinsics.assert(index < Intrinsics.load(this.__address, 0, Types.u32))
                return Intrinsics.load(this.__address, mapHeaderSize + index * entrySize + 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        clear: {
            value: tagInline(function(this: Self): void {
                Intrinsics.store(this.__address, 0, 0, Types.u32)
                Intrinsics.store(this.__address, 8, 0, Types.u32)
                Intrinsics.store(this.__address, 12, 0, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
    })
    const f = function(ptr: usize) {
        if (allocator && ptr === 0) {
            ptr = allocator.alloc(u32MapBytes(4))
            initU32Map(ptr, 4)
        }
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as U32MapView
    }
    f.shouldInline = true
    return f
}

export const U32Map = defineU32Map()

export function u32MapBuckets(capacity: u32): u32 {
    let buckets: u32 = 8
    while (buckets < capacity * 2) buckets = buckets * 2
    return buckets
}

export function u32MapBytes(capacity: u32): usize {
    return mapHeaderSize + capacity * 8 + u32MapBuckets(capacity) * 4
}

export function initU32Map(ptr: usize, capacity: u32): void {
    Intrinsics.store(ptr, 0, 0, Types.u32)
    Intrinsics.store(ptr, 4, capacity, Types.u32)
    Intrinsics.store(ptr, 8, 0, Types.u32)
    Intrinsics.store(ptr, 12, 0, Types.u32)
}

export function defineU32MapCtor(allocator: VecAllocator, capacity: u32) {
    const View = defineU32Map(allocator)
    const f = function() {
        const ptr = allocator.alloc(u32MapBytes(capacity))
        intrinsics.assert(ptr)
        initU32Map(ptr, capacity)
        return View(ptr)
    }
    f.shouldInline = true
    return f
}

function allocate(bytes: usize): usize {
    const ptr = syscalls.mmap(
        0, bytes,
        syscalls.PROT_READ | syscalls.PROT_WRITE,
        syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
        -1 as any, 0,
    )
    intrinsics.assert((ptr as any) !== -1)
    return ptr
}

function initVec(ptr: usize, capacity: u32): void {
    const head = VecHead(ptr)
    head.length = 0
    head.capacity = capacity
}

function allocVec(capacity: u32): usize {
    const ptr = allocate(vecHeaderSize + capacity * 4)
    initVec(ptr, capacity)
    return ptr
}

function allocInterpretedVec(capacity: u32): usize {
    const ptr = Intrinsics.alloc(vecHeaderSize + capacity * 4)
    initVec(ptr, capacity)
    return ptr
}

const mmapAllocator: VecAllocator = {
    alloc: allocate,
    free: function(ptr: usize, bytes: usize): void {
        syscalls.munmap(ptr, bytes)
    },
}

const interpretedAllocator: VecAllocator = {
    alloc: function(bytes: usize): usize {
        return Intrinsics.alloc(bytes)
    },
    free: function(ptr: usize, _bytes: usize): void {
        Intrinsics.free(ptr)
    },
}

const bumpRegionBytes = (1 << 20) as usize

let bumpAllocator: VecAllocator

function createBumpAllocator(native: any, symbolicMemory: (ptr: any) => usize): VecAllocator {
    const mapRegion = native.createNative(function mapBumpRegion(len: usize): usize {
        return syscalls.mmap(
            0, len,
            syscalls.PROT_READ | syscalls.PROT_WRITE,
            syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
            -1 as any, 0,
        )
    })
    const rawAddr = Number(mapRegion(bumpRegionBytes))
    intrinsics.assert(rawAddr !== -1)
    const addr = symbolicMemory(rawAddr)
    native.createNative(function initBumpRegion(start: usize) {
        Intrinsics.store(addr, 0, start, Types.u64)
    })(rawAddr + 8)

    function alloc(bytes: usize): usize {
        const ptr = Intrinsics.load(addr, 0, Types.u64) as usize
        Intrinsics.store(addr, 0, ptr + ((bytes + 7) & ~7), Types.u64)
        return ptr
    }
    function free(ptr: usize, _bytes: usize): void {
        Intrinsics.store(addr, 0, ptr, Types.u64)
    }
    tagInline(alloc)
    tagInline(free)
    return { alloc, free }
}

const GrowVec = defineVec(mmapAllocator)
const InterpretedGrowVec = defineVec(interpretedAllocator)
export const MmapU32Map = defineU32MapCtor(mmapAllocator, 256 as u32)

function defineVecGrow(V: (ptr: usize) => VecView) {
    return function vecGrow(ptr: usize, n: u32): u32 {
        const v = V(0)
        for (let i: u32 = 0; i < n; i++) v.push(i * 3)
        let total: u32 = v.capacity + v.length
        for (let i: u32 = 0; i < n; i++) total += v.get(i)
        return total
    }
}

function vecPush(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    v.length = 0
    for (let i: u32 = 0; i < n; i++) v.push(i)
    return v.length
}

function vecSum(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += v.get(i)
    return total
}

function vecPopSum(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    let total: u32 = 0
    while (v.length !== 0) total += v.pop()
    return total
}

function vecForOf(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    let total: u32 = 0
    for (const value of v) total += value
    // for (const value of v.values()) {
    //     if (value === 1) continue
    //     if (value >= n - 1) break
    //     total += value
    // }
    return total
}

function setForOf(ptr: usize, n: u32): u32 {
    const set = U32Set(ptr)
    set.clear()
    for (let i: u32 = 0; i < n; i++) set.add(i)
    let total: u32 = 0
    for (const value of set) total += value
    return total
}

function mapForOf(ptr: usize, n: u32): u32 {
    initU32Map(ptr, 32 as u32)
    const map = U32Map(ptr)
    for (let i: u32 = 0; i < n; i++) map.set(i, i + 1)
    let total: u32 = 0
    for (const key of map.keys()) total += key
    //for (const value of map.values()) total += value
    for (const [key, value] of map) total += key + value
    return total
}

function setExercise(ptr: usize, n: u32): u32 {
    const set = U32Set(ptr)
    set.clear()
    for (let i: u32 = 0; i < n; i++) {
        set.add(i)
        set.add(i)
    }
    intrinsics.assert(set.size === n)
    if (n > 3) {
        intrinsics.assert(set.delete(3))
        intrinsics.assert(!set.has(3))
    }
    let total: u32 = 0
    while (set.size !== 0) total += set.pop()
    return total
}

function mapExercise(ptr: usize, n: u32): u32 {
    initU32Map(ptr, 32 as u32)
    const map = U32Map(ptr)
    for (let i: u32 = 0; i < n; i++) map.set(i, i + 1)
    intrinsics.assert(map.size === n)
    if (n > 4) {
        map.set(3, 99)
        intrinsics.assert(map.get(3) === 99)
        intrinsics.assert(map.delete(4))
        intrinsics.assert(!map.has(4))
    }
    let total: u32 = 0
    for (let i: u32 = 0; i < map.size; i++) total += map.keyAt(i) + map.valueAt(i)
    return total
}

function headStoreLoop(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    head.length = 0
    for (let i: u32 = 0; i < n; i++) head.length = head.length + 1
    return head.length
}

function rawStoreLoop(ptr: usize, n: u32): u32 {
    Intrinsics.store(ptr, 0, 0, Types.u32)
    for (let i: u32 = 0; i < n; i++) {
        Intrinsics.store(ptr, 0, Intrinsics.load(ptr, 0, Types.u32) + 1, Types.u32)
    }
    return Intrinsics.load(ptr, 0, Types.u32)
}

function headStoreNoLoop(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    head.length = 0
    head.length = head.length + n
    return head.length
}

function loopUnifyIdle(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += i
    for (let i: u32 = 0; i < n; i++) total += head.capacity
    return total
}

function loopUnifyBoth(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += head.length
    for (let i: u32 = 0; i < n; i++) total += head.capacity
    return total
}

interface BenchCase {
    name: string
    kind: string
    ops: u32
    run: (ptr: usize, iters: u32) => u32
}

function runBenchmarks(compiled: any): void {
    const iters = 2_000_000 as u32
    const cases: BenchCase[] = [
        { name: 'vec.get', kind: 'vec', ops: 1, run: compiled.benchVecGet },
        { name: 'vec.set', kind: 'vec', ops: 1, run: compiled.benchVecSet },
        { name: 'vec.push+pop', kind: 'vec', ops: 2, run: compiled.benchVecPushPop },
        { name: 'set.has hit', kind: 'set', ops: 1, run: compiled.benchSetHasHit },
        { name: 'set.has miss', kind: 'set', ops: 1, run: compiled.benchSetHasMiss },
        { name: 'set.add+delete', kind: 'set', ops: 2, run: compiled.benchSetAddDelete },
        { name: 'map.get', kind: 'map', ops: 1, run: compiled.benchMapGet },
        { name: 'map.set', kind: 'map', ops: 1, run: compiled.benchMapSet },
    ]
    const vecPtr = compiled.allocVec(benchPopulation * 4)
    const setPtr = compiled.allocVec(benchPopulation * 4)
    const mapPtr = compiled.allocVec(benchPopulation * 4)
    console.log(`\ncontainer microbenchmarks (population ${benchPopulation}, ${iters} iters)`)
    for (const c of cases) {
        if (c.kind === 'vec') compiled.fillVec(vecPtr, benchPopulation)
        else if (c.kind === 'set') compiled.fillSet(setPtr, benchPopulation)
        else compiled.fillMap(mapPtr, benchPopulation)
        const ptr = c.kind === 'vec' ? vecPtr : c.kind === 'set' ? setPtr : mapPtr
        c.run(ptr, 10_000)
        c.run(ptr, 100_000)
        const start = performance.now()
        c.run(ptr, iters)
        const dur = performance.now() - start
        const perOp = (dur * 1e6) / (iters * c.ops)
        console.log(`  ${c.name.padEnd(16)} ${dur.toFixed(2).padStart(8)} ms  ${perOp.toFixed(2).padStart(7)} ns/op`)
    }
}

function defineTwoLeaf() {
    type Self = { a: u32, b: u32 }
    const properties = {
        bump: tagInline(function(this: Self, d: u32): u32 {
            this.a = this.a + d
            this.b = this.b + 1
            return this.a + this.b
        })
    }
    const f = function(a: u32, b: u32) {
        const o = { a, b }
        return Object.setPrototypeOf(o, properties) as any
    }
    f.shouldInline = true
    return f
}

const TwoLeaf = defineTwoLeaf()

function twoLeafLoop(ptr: usize, n: u32): u32 {
    const v = TwoLeaf(0, n)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += v.bump(i)
    return total
}

function defineMoveVec() {
    type Self = { __address: usize }
    const properties = Object.defineProperties({}, {
        bump: {
            value: tagInline(function(this: Self, flag: u32): u32 {
                if (flag !== 0) {
                    this.__address = this.__address + 8
                }
                return Intrinsics.load(this.__address, 0, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
    })
    const f = function(ptr: usize) {
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as any
    }
    f.shouldInline = true
    return f
}

const MoveVec = defineMoveVec()

function movingRead(ptr: usize, n: u32): u32 {
    const v = MoveVec(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += v.bump(i & 1)
    return total
}

function timeIt(run: () => void): number {
    const start = performance.now()
    run()
    return performance.now() - start
}

function runMapGlobalBenchmark(compiled: any): void {
    console.log('\nmapGlobal: new Map -> n set -> n+1 get -> free, per iteration')
    console.log('  native      BumpU32Map: fixed cap 256, open-addressed index, bump alloc + LIFO free')
    console.log('  interpreted host Map: hashed, growable  (not an apples-to-apples container)')
    console.log('  n = 0 does one set + one get, so it prices the allocator alone')
    const head = `${'n'.padStart(6)}${'iters'.padStart(9)}${'native'.padStart(12)}${'ns/iter'.padStart(10)}`
        + `${'interpreted'.padStart(14)}${'ns/iter'.padStart(10)}${'ratio'.padStart(9)}`
    console.log(head)
    console.log('-'.repeat(head.length))
    for (const n of mapGlobalPopulations) {
        const iters = Math.min(50_000, Math.max(1000, Math.floor(2_000_000 / Math.max(1, n * n)))) as u32
        const want = benchMapGlobal(n, 100 as u32)
        const got = compiled.benchMapGlobal(n, 100 as u32)
        const nativeMs = timeIt(() => compiled.benchMapGlobal(n, iters))
        const interpMs = timeIt(() => benchMapGlobal(n, iters))
        const row = `${`${n}`.padStart(6)}${`${iters}`.padStart(9)}`
            + `${`${nativeMs.toFixed(2)} ms`.padStart(12)}${((nativeMs * 1e6) / iters).toFixed(1).padStart(10)}`
            + `${`${interpMs.toFixed(2)} ms`.padStart(14)}${((interpMs * 1e6) / iters).toFixed(1).padStart(10)}`
            + `${`${(interpMs / nativeMs).toFixed(2)}x`.padStart(9)}`
        console.log(got === want ? row : `${row}   MISMATCH native=${got} interpreted=${want}`)
    }
}

const benchPopulation = 32 as u32
const benchMask = 31 as u32

function fillVec(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    v.length = 0
    for (let i: u32 = 0; i < n; i++) v.push(i)
    return v.length
}

function fillSet(ptr: usize, n: u32): u32 {
    initVec(ptr, n * 2)
    const set = U32Set(ptr)
    for (let i: u32 = 0; i < n; i++) set.add(i)
    return set.size
}

function fillMap(ptr: usize, n: u32): u32 {
    initU32Map(ptr, n * 2)
    const map = U32Map(ptr)
    for (let i: u32 = 0; i < n; i++) map.set(i, i + 1)
    return map.size
}

function benchVecGet(ptr: usize, iters: u32): u32 {
    const v = Vec(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < iters; i++) total += v.get(i & benchMask)
    return total
}

function benchVecSet(ptr: usize, iters: u32): u32 {
    const v = Vec(ptr)
    for (let i: u32 = 0; i < iters; i++) v.set(i & benchMask, i)
    return v.get(0)
}

function benchVecPushPop(ptr: usize, iters: u32): u32 {
    const v = Vec(ptr)
    v.length = 0
    for (let i: u32 = 0; i < iters; i++) {
        v.push(i)
        v.pop()
    }
    return v.length
}

function benchSetHasHit(ptr: usize, iters: u32): u32 {
    const set = U32Set(ptr)
    let hits: u32 = 0
    for (let i: u32 = 0; i < iters; i++) {
        if (set.has(i & benchMask)) hits++
    }
    return hits
}

function benchSetHasMiss(ptr: usize, iters: u32): u32 {
    const set = U32Set(ptr)
    let hits: u32 = 0
    for (let i: u32 = 0; i < iters; i++) {
        if (set.has(benchPopulation + (i & benchMask))) hits++
    }
    return hits
}

function benchSetAddDelete(ptr: usize, iters: u32): u32 {
    const set = U32Set(ptr)
    for (let i: u32 = 0; i < iters; i++) {
        set.add(benchPopulation)
        set.delete(benchPopulation)
    }
    return set.size
}

function benchMapGet(ptr: usize, iters: u32): u32 {
    const map = U32Map(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < iters; i++) total += map.get(i & benchMask)
    return total
}

function benchMapSet(ptr: usize, iters: u32): u32 {
    const map = U32Map(ptr)
    for (let i: u32 = 0; i < iters; i++) map.set(i & benchMask, i)
    return map.size
}

function freeMap(m: any) {
    if (!intrinsics.isNative()) return
    bumpAllocator.free((m as any).__address, 0 as usize)
}

function mapGlobal(_ptr: usize, n: u32): u32 {
    const m = new Map<u32, u32>()
    // TODO: make transformer emit simpler code for this. or trace arrow fns
    // defer freeMap(m) 
    for (let i: u32 = 0; i < n; i++) m.set(i, (i * 3) as u32)
    m.set(0 as u32, (m.get(0 as u32)! + 7) as u32)
    let total = m.size as u32
    for (let i: u32 = 0; i < n; i++) total = (total + m.get(i)!) as u32
    freeMap(m)
    return total
}

const mapGlobalPopulations: u32[] = [0, 8, 32, 128, 256]

function benchMapGlobal(population: u32, iters: u32): u32 {
    let total: u32 = 0
    for (let i: u32 = 0; i < iters; i++) {
        total = ((total + mapGlobal(0, population)) & 0x3FFFFFF) as u32
    }
    return total
}

if (intrinsics.argv()[0] === 'containers') {
    const cases: any = {
        vecPush, vecSum, vecPopSum, setExercise, mapExercise, vecForOf, setForOf, mapForOf,
        headStoreNoLoop, headStoreLoop, rawStoreLoop,
        loopUnifyIdle, loopUnifyBoth, twoLeafLoop,
        vecGrow: defineVecGrow(GrowVec),
        mapGlobal,
    }
    const interpretedCases: any = {
        vecGrow: defineVecGrow(InterpretedGrowVec),
    }
    const compileOnly: any = {}

    const buffer = allocInterpretedVec(256)
    initVec(buffer, 256)
    intrinsics.assert(vecPush(buffer, 10) === 10)
    intrinsics.assert(vecSum(buffer, 10) === 45)
   // intrinsics.assert(vecForOf(buffer, 10) === 80)
    intrinsics.assert(vecPopSum(buffer, 0) === 45)
   // intrinsics.assert(setForOf(buffer, 10) === 45)
  //  intrinsics.assert(mapForOf(buffer, 10) === 200)
    console.log('containers interpreted self-test passed')

    if (intrinsics.argv().includes('native')) {
        const native = await import('./native')
        bumpAllocator = createBumpAllocator(native, (await import('./trace2')).symbolicMemory)
        const BumpU32Map = defineU32MapCtor(bumpAllocator, 256 as u32)
        const benches: any = {
            fillVec, fillSet, fillMap,
            benchVecGet, benchVecSet, benchVecPushPop,
            benchSetHasHit, benchSetHasMiss, benchSetAddDelete,
            benchMapGet, benchMapSet,
            benchMapGlobal,
        }
        const compiled: any = native.createNatives(
            { allocVec, ...cases, ...benches },
            { globals: { Map: BumpU32Map } },
        )
        let failures = 0
        for (const [name, fn] of Object.entries(cases)) {
            initVec(buffer, 256)
            vecPush(buffer, 10)
            const want = (interpretedCases[name] ?? fn)(buffer, 10)
            const nativeBuffer = compiled.allocVec(256)
            compiled.vecPush(nativeBuffer, 10)
            const got = compiled[name](nativeBuffer, 10)
            if (got === want) continue
            failures++
            console.log(`  MISCOMPILE ${name}: interpreted=${want} native=${got}`)
        }
        for (const [name, fn] of Object.entries(compileOnly)) {
            try {
                native.createNatives({ [name]: fn })
            } catch (e: any) {
                failures++
                console.log(`  NOCOMPILE  ${name}: ${`${e}`.split('\n')[0]}`)
            }
        }
        console.log(failures === 0
            ? 'containers native self-test passed'
            : `containers native self-test: ${failures} known loop-unification failures`)

        if (!intrinsics.argv().includes('no-bench')) {
            runBenchmarks(compiled)
            runMapGlobalBenchmark(compiled)
        }
    }
}
