/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import * as syscalls from './syscalls'

type usize = u32
const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const tagInline = intrinsics.tagInline

interface VecHeader {
    length: u32
    capacity: u32
}

const VecHead = intrinsics.DefineStructView(reify VecHeader)
const vecHeaderSize = VecHead.sizeof

interface VecView {
    __address: usize
    length: u32
    readonly capacity: u32
    get(index: u32): u32
    set(index: u32, value: u32): void
    push(value: u32): void
    pop(): u32
}

function defineVec() {
    type Self = { __address: usize }
    const elementSize = 4 as u32
    const properties = Object.defineProperties({}, {
        length: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 0, Types.u32)
            }),
            set: tagInline(function(this: Self, value: u32) {
                Intrinsics.store(this.__address, 0, value, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        capacity: {
            get: tagInline(function(this: Self) {
                return Intrinsics.load(this.__address, 4, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        get: {
            value: tagInline(function(this: Self, index: u32) {
                return Intrinsics.load(this.__address, vecHeaderSize + index * elementSize, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        set: {
            value: tagInline(function(this: Self, index: u32, value: u32) {
                Intrinsics.store(this.__address, vecHeaderSize + index * elementSize, value, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        push: {
            value: tagInline(function(this: Self, value: u32) {
                const n = Intrinsics.load(this.__address, 0, Types.u32)
                intrinsics.assert(n < Intrinsics.load(this.__address, 4, Types.u32))
                Intrinsics.store(this.__address, vecHeaderSize + n * elementSize, value, Types.u32)
                Intrinsics.store(this.__address, 0, n + 1, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
        pop: {
            value: tagInline(function(this: Self, ) {
                const n = Intrinsics.load(this.__address, 0, Types.u32) - 1
                Intrinsics.store(this.__address, 0, n, Types.u32)
                return Intrinsics.load(this.__address, vecHeaderSize + n * elementSize, Types.u32)
            }),
            enumerable: true,
            configurable: true,
        },
    })
    const f = function(ptr: usize) {
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as VecView
    }
    f.shouldInline = true
    return f
}

export const Vec = defineVec()

function allocate(bytes: usize): usize {
    const ptr = syscalls.mmap(
        0, bytes,
        syscalls.PROT_READ | syscalls.PROT_WRITE,
        syscalls.MAP_PRIVATE | syscalls.MAP_ANON,
        -1 as any, 0,
    )
    intrinsics.assert((ptr as any) !== -1)
    return ptr
}

export function initVec(ptr: usize, capacity: u32): void {
    const head = VecHead(ptr)
    head.length = 0
    head.capacity = capacity
}

export function allocVec(capacity: u32): usize {
    const ptr = allocate(vecHeaderSize + capacity * 4)
    initVec(ptr, capacity)
    return ptr
}

function allocInterpretedVec(capacity: u32): usize {
    const ptr = Intrinsics.alloc(vecHeaderSize + capacity * 4)
    initVec(ptr, capacity)
    return ptr
}

export function vecPush(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    v.length = 0
    for (let i: u32 = 0; i < n; i++) v.push(i)
    return v.length
}

export function vecSum(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += v.get(i)
    return total
}

export function vecPopSum(ptr: usize, n: u32): u32 {
    const v = Vec(ptr)
    let total: u32 = 0
    while (v.length !== 0) total += v.pop()
    return total
}

export function headStoreLoop(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    head.length = 0
    for (let i: u32 = 0; i < n; i++) head.length = head.length + 1
    return head.length
}

export function rawStoreLoop(ptr: usize, n: u32): u32 {
    Intrinsics.store(ptr, 0, 0, Types.u32)
    for (let i: u32 = 0; i < n; i++) {
        Intrinsics.store(ptr, 0, Intrinsics.load(ptr, 0, Types.u32) + 1, Types.u32)
    }
    return Intrinsics.load(ptr, 0, Types.u32)
}

export function headStoreNoLoop(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    head.length = 0
    head.length = head.length + n
    return head.length
}

export function loopUnifyIdle(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += i
    for (let i: u32 = 0; i < n; i++) total += head.capacity
    return total
}

export function loopUnifyBoth(ptr: usize, n: u32): u32 {
    const head = VecHead(ptr)
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total += head.length
    for (let i: u32 = 0; i < n; i++) total += head.capacity
    return total
}

if (intrinsics.argv()[0] === 'containers') {
    const cases: any = {
        vecPush, vecSum, vecPopSum, headStoreNoLoop, headStoreLoop, rawStoreLoop,
        loopUnifyIdle, loopUnifyBoth,
    }
    const compileOnly: any = {}

    const buffer = allocInterpretedVec(256)
    initVec(buffer, 256)
    intrinsics.assert(vecPush(buffer, 10) === 10)
    intrinsics.assert(vecSum(buffer, 10) === 45)
    intrinsics.assert(vecPopSum(buffer, 0) === 45)
    console.log('containers interpreted self-test passed')

    if (intrinsics.argv().includes('native')) {
        const native = await import('./native')
        const compiled: any = native.createNatives({ allocVec, ...cases })
        let failures = 0
        for (const [name, fn] of Object.entries(cases)) {
            initVec(buffer, 256)
            const want = (fn as any)(buffer, 10)
            const nativeBuffer = compiled.allocVec(256)
            const got = compiled[name](nativeBuffer, 10)
            if (got === want) continue
            failures++
            console.log(`  MISCOMPILE ${name}: interpreted=${want} native=${got}`)
        }
        for (const [name, fn] of Object.entries(compileOnly)) {
            try {
                native.createNatives({ [name]: fn })
            } catch (e: any) {
                failures++
                console.log(`  NOCOMPILE  ${name}: ${`${e}`.split('\n')[0]}`)
            }
        }
        console.log(failures === 0
            ? 'containers native self-test passed'
            : `containers native self-test: ${failures} known loop-unification failures`)
    }
}
