/// @synth
"use wrapped";

import * as heap from './heap'
import * as intrinsics from './intrinsics'
import { Op, createInterpreter, makeFunctionFromBytes, tagVmHandle, vmValue, hostIntrinsics } from './vm'
import ts from 'typescript'
import { globals as builtinGlobals } from './builtins'
import { Op as RtOp, setRuntimeLinker } from './rt'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const inRange = intrinsics.inRange
const assert = intrinsics.assert

type usize = u32
type Handle = heap.Handle

function isLateBoundSymbol(node: ts.Node) {
    return (node as any).isLateBoundSymbol?.() ?? false
}

function getSymbolId(node: ts.Node) {
    return (node as any).extra
}

function usesThisBinding(node: ts.Node) {
    return (node as any).usesThisBinding?.() ?? false
}

function isReferencedSymbol(node: ts.Node) {
    return (node as any).isReferencedSymbol?.() ?? false
}

function isConstSymbol(node: ts.Node) {
    return (node as any).isConstSymbol?.() ?? false
}

function disposeSourceFile(sf: ts.SourceFile) {
    (ts as any).disposeSourceFile(sf)
}

function sourceNodeCount(node: ts.Node): number {
    return (node as any).getSourceFileNodeCount()
}

function getEncodedLocation(node: ts.Node) {
    return (node as any).location ?? 0
}

function getDecodedLocation(loc: number): { line: number; col: number } {
    return (ts as any).decodeLocation(loc)
}

export enum ConstantKind {
    number,
    string,
    function_, // ??? FIXME: this breaks if you try to use "function" because it gets treated as a keyword :/
    late_bound, // so, unknown
    nested_function,
    scope,
    class_,
    private_name,
    object_template,
    symbol,
}

type ScopeBinding = { slot: number, parentSlot: number }
type OuterSymbol = { scopeSlot: number, reg: number }
type FoldResultValue = string | number | boolean | undefined | null
type PrivateMember = { node: ts.GetAccessorDeclaration | ts.SetAccessorDeclaration | ts.MethodDeclaration, template?: EmitResult, compiling?: boolean }
type PrivateName = { method?: PrivateMember, getter?: PrivateMember, setter?: PrivateMember }
type EmitCtx = {
    outerSymbols: Map<number, OuterSymbol>
    outerFolded: Map<number, [FoldResultValue]>
    owner?: ts.Identifier
    privateNames?: Map<string, symbol>
    privateMembers?: Map<string, PrivateName>
    home?: HomeObject
    fields?: ts.PropertyDeclaration[]
}
const thisSymbol = -3
const homeSymbol = -6

enum HomeObject {
    prototype,
    constructor,
}

export interface EhRange {
    start: number
    end: number
    handler: number
}

export function ehHandler(ranges: readonly EhRange[], pc: number): number {
    for (const range of ranges) {
        if (pc >= range.start && pc <= range.end) return range.handler
    }
    return -1
}

interface Labels {
    eh: EhRange[]
    jump: number[]
}

export type ClassAccessor = { getter?: EmitResult, setter?: EmitResult }
export type Expandos = Map<string | symbol, EmitResult | Expandos | ClassAccessor>

function wellKnownSymbol(name: ts.PropertyName): symbol | undefined {
    if (!ts.isComputedPropertyName(name)) return
    const e = name.expression
    if (!ts.isPropertyAccessExpression(e) || !ts.isIdentifier(e.expression) || e.expression.text !== 'Symbol') return
    const symbol = (Symbol as any)[e.name.text]
    return typeof symbol === 'symbol' ? symbol : undefined
}

function isStaticMember(member: ts.ClassElement): boolean {
    return !!member.modifiers?.some(m => m.kind === ts.SyntaxKind.StaticKeyword)
}

function classPrivateNames(node: ts.ClassDeclaration | ts.ClassExpression, outer: Map<string, symbol> | undefined): Map<string, symbol> {
    const names = new Map(outer)
    for (const member of node.members) {
        if (member.name && ts.isPrivateIdentifier(member.name)) names.set(member.name.text, Symbol(member.name.text))
    }
    return names
}

function isPrivateMember(member: ts.ClassElement): member is ts.GetAccessorDeclaration | ts.SetAccessorDeclaration | ts.MethodDeclaration {
    if (!member.name || !ts.isPrivateIdentifier(member.name)) return false
    return ts.isGetAccessorDeclaration(member) || ts.isSetAccessorDeclaration(member) || ts.isMethodDeclaration(member)
}

function classPrivateMembers(node: ts.ClassDeclaration | ts.ClassExpression, outer?: Map<string, PrivateName>): Map<string, PrivateName> {
    const members = new Map(outer)
    for (const member of node.members) {
        if (member.name && ts.isPrivateIdentifier(member.name)) members.delete(member.name.text)
    }
    for (const member of node.members) {
        if (!isPrivateMember(member)) continue
        if (isStaticMember(member)) throw `static private members are not supported: ${member.name.getText()}`
        const name = (member.name as ts.PrivateIdentifier).text
        const entry = members.get(name) ?? {}
        members.set(name, entry)
        if (ts.isGetAccessorDeclaration(member)) entry.getter = { node: member }
        else if (ts.isSetAccessorDeclaration(member)) entry.setter = { node: member }
        else entry.method = { node: member }
    }
    return members
}

function isFieldDeclaration(member: ts.ClassElement): boolean {
    if (!ts.isPropertyDeclaration(member)) return false
    if (member.initializer && isStaticMember(member)) throw `static class field initializers are not supported: ${member.name.getText()}`
    return true
}

function initializedFields(node: ts.ClassDeclaration | ts.ClassExpression): ts.PropertyDeclaration[] {
    const fields: ts.PropertyDeclaration[] = []
    for (const member of node.members) {
        if (!isFieldDeclaration(member)) continue
        const field = member as ts.PropertyDeclaration
        if (!field.initializer) continue
        if (ts.isComputedPropertyName(field.name)) throw `computed class field names are not supported: ${field.name.getText()}`
        fields.push(field)
    }
    return fields
}

function heritageOf(node: ts.ClassDeclaration | ts.ClassExpression): ts.Expression | undefined {
    const clause = node.heritageClauses?.find(c => c.token === ts.SyntaxKind.ExtendsKeyword)
    if (!clause) return
    if (clause.types.length !== 1) throw 'a class extends exactly one base'
    const base = clause.types[0]
    if (base.typeArguments?.length) throw 'class heritage type arguments are not supported'
    return base.expression
}

function usesSuper(node: ts.Node): boolean {
    function visit(child: ts.Node): boolean {
        if (child.kind === ts.SyntaxKind.SuperKeyword) return true
        if (ts.isClassLike(child)) return false
        if (ts.isFunctionLike(child) && !ts.isArrowFunction(child)) return false
        return !!ts.forEachChild(child, visit)
    }
    return !!ts.forEachChild(node, visit)
}

function classMemberName(member: ts.MethodDeclaration | ts.GetAccessorDeclaration | ts.SetAccessorDeclaration): string | symbol {
    if (ts.isIdentifier(member.name)) return member.name.text
    const symbol = wellKnownSymbol(member.name)
    if (symbol === undefined) throw `unsupported class member name: ${member.name.getText()}`
    return symbol
}

function classMemberKey(member: ts.ClassElement): string | symbol {
    if (!ts.isMethodDeclaration(member)) throw `unsupported class member: ${ts.SyntaxKind[member.kind]}`
    return classMemberName(member)
}

export type EmitResult = {
    code: number[]           // opcodes + byte operands
    constants: any[]
    constantKinds: ConstantKind[]
    paramCount: number
    registerCount: number
    lateBound: Map<number, number> // symbol id -> constant pool slot
    selfSlot?: number
    labels?: Labels
    scopeBindings: ScopeBinding[]
    sourceMapping: [pc: number, pos: number][] // uses encoded line/col
    expandos?: Expandos
    name?: string
    defaults?: boolean
    rest?: boolean
    readonlyCaptures?: number[]
}

function defaultConstructorResult(): EmitResult {
    return {
        code: [Op.Return], constants: [], constantKinds: [], paramCount: 0, registerCount: 0,
        lateBound: new Map(), scopeBindings: [], sourceMapping: [],
    }
}

function isShortStore(opcode: number) {
    return opcode >= Op.Star0 && opcode <= Op.Star15
}

function isShortLoad(opcode: number) {
    return opcode >= Op.Ldar0 && opcode <= Op.Ldar3
}

const NumericBinaryOperators = new Set<ts.SyntaxKind>([
    ts.SyntaxKind.MinusToken, ts.SyntaxKind.AsteriskToken, ts.SyntaxKind.SlashToken, ts.SyntaxKind.PercentToken,
    ts.SyntaxKind.AsteriskAsteriskToken, ts.SyntaxKind.AmpersandToken, ts.SyntaxKind.BarToken, ts.SyntaxKind.CaretToken,
    ts.SyntaxKind.LessThanLessThanToken, ts.SyntaxKind.GreaterThanGreaterThanToken, ts.SyntaxKind.GreaterThanGreaterThanGreaterThanToken,
    ts.SyntaxKind.LessThanToken, ts.SyntaxKind.GreaterThanToken, ts.SyntaxKind.LessThanEqualsToken, ts.SyntaxKind.GreaterThanEqualsToken,
    ts.SyntaxKind.EqualsEqualsToken, ts.SyntaxKind.ExclamationEqualsToken,
    ts.SyntaxKind.EqualsEqualsEqualsToken, ts.SyntaxKind.ExclamationEqualsEqualsToken,
    ts.SyntaxKind.InstanceOfKeyword, ts.SyntaxKind.InKeyword,
])

function isNumericExpression(e: ts.Expression): boolean {
    while (ts.isParenthesizedExpression(e) || ts.isAsExpression(e) || ts.isNonNullExpression(e)) e = e.expression
    if (ts.isNumericLiteral(e)) return true
    if (e.kind === ts.SyntaxKind.TrueKeyword || e.kind === ts.SyntaxKind.FalseKeyword) return true
    if (ts.isPostfixUnaryExpression(e)) return true
    if (ts.isPrefixUnaryExpression(e)) return e.operator !== ts.SyntaxKind.PlusToken
    if (!ts.isBinaryExpression(e)) return false
    const kind = e.operatorToken.kind
    if (kind === ts.SyntaxKind.PlusToken) return isNumericExpression(e.left) && isNumericExpression(e.right)
    return NumericBinaryOperators.has(kind)
}

const jumpBytesPerNode = 8

function emitFunction(
    fn: ts.FunctionDeclaration | ts.ArrowFunction | ts.FunctionExpression | ts.MethodDeclaration | ts.ConstructorDeclaration | ts.GetAccessorDeclaration | ts.SetAccessorDeclaration | ts.ClassDeclaration | ts.ClassExpression,
    emitCtx: EmitCtx = { outerSymbols: new Map(), outerFolded: new Map() },
): EmitResult {
    let jumpWidth: 2 | 4 = sourceNodeCount(fn) * jumpBytesPerNode > 0x7FFF ? 4 : 2
    const outerSymbols = emitCtx.outerSymbols
    let privateNames = emitCtx.privateNames
    let privateMembers = emitCtx.privateMembers
    const privateMemberSlots = new Map<PrivateMember, number>()
    const code: number[] = []
    const constants: any[] = []
    const constantKinds: ConstantKind[] = []
    const sourceMapping: EmitResult['sourceMapping'] = []

    const internMap = new Map<string | symbol, number>()  // interning key -> slot
    const symToReg = new Map<number, number>()    // symbol id -> register
    const lateBound = new Map<number, number>()   // symbol id -> constant slot
    const scopedSymbols = new Map<number, OuterSymbol>()
    const scopeSlots = new Map<number, number>()
    const scopeBindings: ScopeBinding[] = []
    const capturedRegs = new Map<number, number>()

    function bindScope(outer: OuterSymbol): OuterSymbol {
        let slot = scopeSlots.get(outer.scopeSlot)
        if (slot === undefined) {
            slot = constants.length
            constants.push(0)
            constantKinds.push(ConstantKind.scope)
            scopeSlots.set(outer.scopeSlot, slot)
            scopeBindings.push({ slot, parentSlot: outer.scopeSlot })
        }
        return { scopeSlot: slot, reg: outer.reg }
    }
    function scopedSymbol(symId: number): OuterSymbol | undefined {
        const prev = scopedSymbols.get(symId)
        if (prev) return prev
        const outer = outerSymbols.get(symId)
        if (!outer) return
        const scoped = bindScope(outer)
        scopedSymbols.set(symId, scoped)
        return scoped
    }

    // only used for source mapping
    // DOES NOT COVER MUCH CURRENTLY
    // mainly covers idents
    let currentNode: ts.Node = fn
    function emitSourceMapping() {
        const pos = getEncodedLocation(currentNode)
        if (!pos) return
        const top = sourceMapping[sourceMapping.length - 1]
        if (top?.[1] !== pos) {
            const pc = lookbehind(0)
            if (pc === undefined) return
            sourceMapping.push([pc, pos])
        }
    }

    const regState: [number, number][] = [] // tracks the most recent store pc against the reg
    const maxLookbehind = 16
    const lookbehindBuffer = new Uint32Array(maxLookbehind)
    let lookbehindPos = 0
    let lookbehindCount = 0
    function pushLookbehind(pos: number) {
        if (lookbehindCount < maxLookbehind) {
            lookbehindCount += 1
        } else {
            lookbehindPos = (lookbehindPos + 1) % maxLookbehind
        }
        const p = (lookbehindCount + lookbehindPos) % maxLookbehind
        lookbehindBuffer[p] = pos as any 
    }
    function popLookbehind(amt = 1) {
        assert(lookbehindCount > amt-1)
        lookbehindCount -= amt
    }
    // returns the _position_ of the last op, starting at 0
    function lookbehind(amt: number) {
        assert(amt >= 0)
        if (amt > lookbehindCount) return
        const p = (lookbehindCount + lookbehindPos - amt) & (maxLookbehind-1)
        return lookbehindBuffer[p]
    }

    let nextReg = 0
    let maxReg = 0
    let thisReg: number | undefined = undefined
    let homeReg: number | undefined = undefined
    const implicitConstructor = ts.isClassDeclaration(fn) || ts.isClassExpression(fn)
    const isConstructor = ts.isConstructorDeclaration(fn) || implicitConstructor
    const derivedConstructor = isConstructor && emitCtx.home !== undefined
    const forwardsArguments = implicitConstructor && derivedConstructor
    const parameters = implicitConstructor ? [] : fn.parameters
    const body = implicitConstructor ? undefined : fn.body
    const classHomes = new Map<ts.Node, number>()
    let prevOpOffset: number = -1
    let prevStoreOffset: number = -1
    let skipNextLookbehind = false
    // jumps should not update the "prev op" values
    
    // used for less common constructs
    let extraLabels: Labels | undefined
    function getExtraLabels() {
        return extraLabels ??= {
            eh: [],
            jump: [],
        }
    }

    function findConstPoolSlot(node: ts.Expression) {
        if (node.kind !== ts.SyntaxKind.Identifier) return
        const symId = getSymbolId(node)
        if (!symId) return
        if (isLateBoundSymbol(node)) return lateBoundSlot(symId, (node as ts.Identifier).text)
        if (const x = lateBound.get(symId)) return x
    }

    function allocReg(): number {
        const r = nextReg
        nextReg = nextReg + 1
        if (nextReg > maxReg) {
            maxReg = nextReg
            if (regState.length < maxReg) {
                regState.length = maxReg
                regState[regState.length-1] = [-1, -1]
            }
        }
        return r
    }
    function freeReg(): void {
        nextReg = nextReg - 1
    }

    function beginInstruction(op: number, width: number) {
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        pushOpcode(code, op, width)
    }
    function encode2(op: number, operand: number) {
        const width = operandWidth(operand)
        beginInstruction(op, width)
        pushOperand(code, operand, width)
    }
    function emit1(op: number) {
        beginInstruction(op, 1)
        emitSourceMapping()
    }
    function emit2(op: number, operand: number) {
        encode2(op, operand)
        emitSourceMapping()
    }
    function emit3(op: number, operand1: number, operand2: number) {
        const width = Math.max(operandWidth(operand1), operandWidth(operand2))
        beginInstruction(op, width)
        pushOperand(code, operand1, width)
        pushOperand(code, operand2, width)
        emitSourceMapping()
    }
    function emit4(op: number, operand1: number, operand2: number, operand3: number) {
        const width = Math.max(operandWidth(operand1), operandWidth(operand2), operandWidth(operand3))
        beginInstruction(op, width)
        pushOperand(code, operand1, width)
        pushOperand(code, operand2, width)
        pushOperand(code, operand3, width)
        emitSourceMapping()
    }
    function star(reg: number) {
        const pc = code.length
        regState[reg][0] = pc
        regState[reg][1] = prevOpOffset
        if (reg <= 15) beginInstruction(Op.Star0 + reg, 1)
        else encode2(Op.Star, reg)
        prevStoreOffset = pc
    }
    function tryReplaceToMov(): boolean {
        if (const x = lookbehind(2)) {
            if ((code[x] === Op.Width2 || code[x] === Op.Width4) && JumpOps.has(code[x+1])) return false
        }
        const pc0 = lookbehind(0) as number
        const pc1 = lookbehind(1) as number
        if (pc0 === undefined || pc1 === undefined || pc0 === maxJumpTarget) return false
        if (isShortStore(code[pc0]) && isShortLoad(code[pc1])) {
            const dst = code[pc0] - Op.Star0
            const src = code[pc1] - Op.Ldar0
            code[pc1] = Op.MovPacked
            code[pc0] = dst | (src << 4)
            prevOpOffset = pc1
            popLookbehind()
            return true
        }
        return false
    }
    function ldar(reg: number) {
        tryReplaceToMov()
        if (const prev = lookbehindForReg(reg)) {
            if (prev === reg) return
        }
        if (reg <= 3) emit1(Op.Ldar0 + reg)
        else emit2(Op.Ldar, reg)
    }

    function emitLoadImm(val: number) {
        if (!inRange(Types.i32, val)) throw `immediate too large: ${val}`
        let width = 4
        if (inRange(Types.i16, val)) width = 2
        if (inRange(Types.i8, val)) width = 1
        beginInstruction(Op.LdaImm, width)
        pushOperand(code, val, width)
    }

    function emitLoadConst(slot: number) {
        encode2(Op.LdaConst, slot)
    }

    function lookbehindForReg(reg: number) {
        if (skipNextLookbehind) {
            // we cannot skip if we're going to be jumped into
            skipNextLookbehind = false
            return
        }
        if (const prev = (regState[reg] as [number, number] | undefined)) {
            if (prev[0] !== -1 && (code as any)[prev[0]] - Op.Star0 === reg) {
                if (prevOpOffset === prev[1] || prevOpOffset === prev[0]) return reg
            }
        }
        if (prevStoreOffset === -1 || prevOpOffset !== prevStoreOffset) return
        const op = code[prevStoreOffset]
        if (op >= Op.Star0 && op <= Op.Star15) return op - Op.Star0
    }

    function emitJumpPlaceholder(jumpOp: number): number {
        pushLookbehind(code.length)
        pushOpcode(code, jumpOp, jumpWidth)
        const at = code.length
        pushOperand(code, 0, jumpWidth)
        return at
    }

    let maxJumpTarget = 0
    function checkJumpOffset(off: number) {
        if (!inRange(jumpWidth === 2 ? Types.i16 : Types.i32, off)) throw `jump offset out of range: ${off}`
    }
    function patchJump(at: number) {
        const off = code.length - (at + jumpWidth)
        checkJumpOffset(off)
        if (code.length > maxJumpTarget) maxJumpTarget = code.length
        for (let i = 0; i < jumpWidth; i++) code[at + i] = (off >>> (8 * i)) & 0xFF
    }
    function emitJumpTo(jumpOp: number, target: number) {
        if (target > maxJumpTarget) maxJumpTarget = target
        pushLookbehind(code.length)
        pushOpcode(code, jumpOp, jumpWidth)
        const off = target - (code.length + jumpWidth)
        checkJumpOffset(off)
        pushOperand(code, off, jumpWidth)
    }

    type IteratorScope = { iterator: number, open: number }
    type Guard = { start: number, segments: EhRange[] }
    type LoopLabels = {
        breaks: number[]
        continues: number[]
        continueTarget: number
        canContinue: boolean
        iterator?: IteratorScope
        finallyBlock?: ts.Block
        guard?: Guard
        outer?: LoopLabels
        names: string[]
        labeledOnly?: boolean
    }
    let labels: LoopLabels | undefined = undefined
    let pendingLabels: string[] = []
    function enterLabels(continueTarget: number, canContinue: boolean): LoopLabels {
        const ctx: LoopLabels = { breaks: [], continues: [], continueTarget, canContinue, outer: labels, names: pendingLabels }
        pendingLabels = []
        labels = ctx
        return ctx
    }
    function enterGuarded(): LoopLabels {
        const ctx: LoopLabels = { breaks: [], continues: [], continueTarget: -1, canContinue: false, outer: labels, names: [], labeledOnly: true }
        ctx.guard = openGuard()
        labels = ctx
        return ctx
    }
    function jumpTarget(label: string | undefined, continuing: boolean): LoopLabels {
        for (let ctx = labels; ctx; ctx = ctx.outer) {
            if (label === undefined) {
                if (continuing ? ctx.canContinue : !ctx.labeledOnly) return ctx
                continue
            }
            if (!ctx.names.includes(label)) continue
            if (continuing && !ctx.canContinue) throw `\`continue ${label}\` does not target a loop`
            return ctx
        }
        if (label !== undefined) throw `unknown label: ${label}`
        throw continuing ? "`continue` outside of a loop" : "`break` outside of a loop"
    }
    function openGuard(): Guard {
        return { start: code.length, segments: [] }
    }
    function suspendGuard(guard: Guard): void {
        if (code.length > guard.start) {
            const range: EhRange = { start: guard.start, end: code.length, handler: 0 }
            guard.segments.push(range)
            getExtraLabels().eh.push(range)
        }
        guard.start = -1
    }
    function resumeGuards(guards: Guard[]): void {
        for (const guard of guards) guard.start = code.length
    }
    function handleGuard(guard: Guard): void {
        for (const range of guard.segments) range.handler = code.length
    }
    function hasCleanup(): boolean {
        for (let ctx = labels; ctx; ctx = ctx.outer) {
            if (ctx.iterator || ctx.finallyBlock) return true
        }
        return false
    }
    function leaveScopes(target: LoopLabels | undefined, inclusive: boolean): Guard[] {
        const inner = labels
        const guards: Guard[] = []
        let suspended = 0
        for (let ctx = labels; ctx; ctx = ctx.outer) {
            if (ctx === target && !inclusive) break
            if (ctx.guard) guards.push(ctx.guard)
            if (ctx.iterator || ctx.finallyBlock) {
                while (suspended < guards.length) {
                    suspendGuard(guards[suspended])
                    suspended += 1
                }
                labels = ctx.outer
                if (ctx.iterator) emitIteratorClose(ctx.iterator)
                if (ctx.finallyBlock) emitBlock(ctx.finallyBlock)
                labels = inner
            }
            if (ctx === target) break
        }
        return guards.slice(0, suspended)
    }
    function emitBreak(label?: string) {
        const target = jumpTarget(label, false)
        const suspended = leaveScopes(target, true)
        target.breaks.push(emitJumpPlaceholder(Op.Jump))
        resumeGuards(suspended)
    }
    function emitContinue(label?: string) {
        const target = jumpTarget(label, true)
        const suspended = leaveScopes(target, false)
        if (target.continueTarget >= 0) emitJumpTo(Op.Jump, target.continueTarget)
        else target.continues.push(emitJumpPlaceholder(Op.Jump))
        resumeGuards(suspended)
    }

    function internString(s: string): number {
        const existing = internMap.get(s)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(s)
        constantKinds.push(ConstantKind.string)
        internMap.set(s, slot)
        return slot
    }
    function internNumber(v: number): number {
        const key = "##" + v
        const existing = internMap.get(key)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(v)
        constantKinds.push(ConstantKind.number)
        internMap.set(key, slot)
        return slot
    }
    function internSymbol(sym: symbol): number {
        const existing = internMap.get(sym)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(sym)
        constantKinds.push(ConstantKind.symbol)
        internMap.set(sym, slot)
        return slot
    }
    function internPrivate(name: string): number {
        const key = privateNames?.get(name)
        if (!key) throw `private name ${name} is not declared by an enclosing class`
        const existing = internMap.get(key)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(key)
        constantKinds.push(ConstantKind.private_name)
        internMap.set(key, slot)
        return slot
    }
    function internObjectTemplate(keys: string[]): number {
        const key = '#template:' + JSON.stringify(keys)
        const existing = internMap.get(key)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(keys)
        constantKinds.push(ConstantKind.object_template)
        internMap.set(key, slot)
        return slot
    }
    function internName(name: ts.MemberName): number {
        return ts.isPrivateIdentifier(name) ? internPrivate(name.text) : internString(name.text)
    }
    function internValue(s: string | number): number {
        if (typeof s === 'string') return internString(s)
        return internNumber(s)
    }
    function lateBoundSlot(symId: number, name: string, kind = ConstantKind.late_bound): number {
        const existing = lateBound.get(symId)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(name)
        constantKinds.push(kind)
        lateBound.set(symId, slot)
        return slot
    }

    function emitNumber(v: number) {
        if (Number.isInteger(v) && inRange(Types.i8, v)) {
            return emitLoadImm(v)
        }
        emitLoadConst(internNumber(v))
    }

    function emitLiteral(v: FoldResultValue) {
        if (v === true) return emit1(Op.LdaTrue)
        if (v === false) return emit1(Op.LdaFalse)
        if (v === null) return emit1(Op.LdaNull)
        if (v === undefined) return emit1(Op.LdaUndefined)
        if (typeof v === 'string') return emitLoadConst(internString(v));
        intrinsics.assert(typeof v === 'number')
        return emitNumber(v)
    }

    function isLexicalIdent(node: ts.Node): boolean {
        if (!ts.isIdentifier(node)) return false
        if (isLateBoundSymbol(node)) return false
        return symToReg.has(getSymbolId(node))
    }

    function isReceiverIdent(node: ts.Node): boolean {
        return isLexicalIdent(node) && !capturedRegs.has(getSymbolId(node))
    }

    function argumentsMayWrite(receiver: ts.Identifier, args: ReadonlyArray<ts.Expression>): boolean {
        if (isConstSymbol(receiver)) return false
        const symId = getSymbolId(receiver)
        function names(node: ts.Node): boolean {
            if (ts.isIdentifier(node)) return getSymbolId(node) === symId
            return !!ts.forEachChild(node, names)
        }
        function writes(node: ts.Node): boolean {
            if (ts.isBinaryExpression(node) && isAssignmentOp(node.operatorToken.kind) && names(node.left)) return true
            if ((ts.isPrefixUnaryExpression(node) || ts.isPostfixUnaryExpression(node)) && isAssignmentUnary(node.operator) && names(node.operand)) return true
            return !!ts.forEachChild(node, writes)
        }
        return args.some(writes)
    }

    const foldedVariables = new Map<number, [FoldResultValue]>(emitCtx.outerFolded)
    function tryFoldVariableDecl(node: ts.VariableDeclaration) {
        if (!node.initializer) return false
        if (!ts.isIdentifier(node.name)) return false
        // ASSUMES CONST BINDING
        // MUST NOT HAVE BEEN REF'D YET
        const symId = getSymbolId(node.name)
        if (symToReg.has(symId)) return false
        // simple = just constant fold it
        if (const r = tryFoldExp(node.initializer)) {
            if (r[0] === 'value') {
                foldedVariables.set(symId, [r[1]])
                return true
            }
        }
        return false
    }

    function hasEffects(node: ts.Node): boolean {
        switch (node.kind) {
            case ts.SyntaxKind.ParenthesizedExpression:
                return hasEffects((node as ts.ParenthesizedExpression).expression)
            case ts.SyntaxKind.PrefixUnaryExpression:
                if (isAssignmentUnary((node as ts.PrefixUnaryExpression).operator)) {
                    return true
                }
                return hasEffects((node as ts.PrefixUnaryExpression).operand)
            case ts.SyntaxKind.BinaryExpression:
                if (isAssignmentOp((node as ts.BinaryExpression).operatorToken.kind)) {
                    return true
                }
                return hasEffects((node as ts.BinaryExpression).left) || hasEffects((node as ts.BinaryExpression).right)
            case ts.SyntaxKind.ConditionalExpression:
                return hasEffects((node as ts.ConditionalExpression).condition) || hasEffects((node as ts.ConditionalExpression).whenTrue) || hasEffects((node as ts.ConditionalExpression).whenFalse)
            case ts.SyntaxKind.VoidExpression:
                return hasEffects((node as ts.VoidExpression).expression)
            case ts.SyntaxKind.TemplateExpression:
                for (const span of (node as ts.TemplateExpression).templateSpans) {
                    if (hasEffects(span.expression)) return true
                }
                return false
            case ts.SyntaxKind.TrueKeyword:
            case ts.SyntaxKind.FalseKeyword:
            case ts.SyntaxKind.NullKeyword:
            case ts.SyntaxKind.UndefinedKeyword:
            case ts.SyntaxKind.NumericLiteral:
            case ts.SyntaxKind.StringLiteral: 
                return false
        }
        return true
    }

    function isDeadCode(node: ts.Node) {
        // extremely simple DCE, don't expect much from it
        switch (node.kind) {
            case ts.SyntaxKind.ExpressionStatement:
                return !hasEffects((node as ts.ExpressionStatement).expression)
        }
        return !hasEffects(node)
    }

    function maxRegAllocsNeeded(exp: ts.Expression): number {
        if (const r = tryFoldExp(exp)) {
            if (r[0] === 'value') return 0
            return maxRegAllocsNeeded(r[1]) // residual
        }

        // isFirstOperand can be set when we know we will always spill anyway
        function visit(n: ts.Expression, isAcc = false): number {
            switch (n.kind) {
                case ts.SyntaxKind.NumericLiteral:
                case ts.SyntaxKind.StringLiteral: 
                case ts.SyntaxKind.TrueKeyword:
                case ts.SyntaxKind.FalseKeyword:
                case ts.SyntaxKind.NullKeyword:
                case ts.SyntaxKind.UndefinedKeyword:
                    return isAcc ? 0 : 1 // need a tmp to spill

                case ts.SyntaxKind.ArrayLiteralExpression:
                    const elements = (n as ts.ArrayLiteralExpression).elements
                    const spreads = elements.some(ts.isSpreadElement)
                    if (elements.length && elements.length < 0x100 && !spreads) {
                        return elements.length + Math.max(...elements.map(x => visit(x, true))) + (isAcc ? 0 : 1)
                    }
                    let inner = 0
                    for (const x of elements) {
                        if (ts.isSpreadElement(x)) {
                            inner = Math.max(inner, 5 + visit(x.expression, true))
                            continue
                        }
                        inner = Math.max(inner, (spreads ? 2 : 1) + visit(x, true))
                    }
                    return (isAcc ? 0 : 1) + inner

                case ts.SyntaxKind.TemplateExpression:
                    let templateInner = 0
                    for (const span of (n as ts.TemplateExpression).templateSpans) {
                        templateInner = Math.max(templateInner, visit(span.expression, true))
                    }
                    return (isAcc ? 0 : 1) + 2 + templateInner

                case ts.SyntaxKind.ObjectLiteralExpression:
                    const properties = (n as ts.ObjectLiteralExpression).properties
                    let inner = 0
                    for (const x of properties) {
                        if (ts.isSpreadAssignment(x)) {
                            inner = Math.max(inner, 4 + visit(x.expression, true))
                            continue
                        }
                        if (ts.isShorthandPropertyAssignment(x)) {
                            inner = Math.max(inner, isLexicalIdent(x.name) ? 0 : 1)
                            continue
                        }
                        if (ts.isPropertyAssignment(x)) {
                            inner = Math.max(inner, 1 + visit(x.initializer, true))
                            if (ts.isComputedPropertyName(x.name)) {
                                inner = Math.max(inner, visit(x.name.expression, true), 2 + visit(x.initializer, true))
                            }
                            continue
                        }
                        throw `Unhandled property kind: ${ts.SyntaxKind[x.kind]}`
                    }
                    return (isAcc ? 0 : 1) + inner

                case ts.SyntaxKind.Identifier:
                    if (isAcc) return 0
                    return isLexicalIdent(n) ? 0 : 1
                case ts.SyntaxKind.AwaitExpression:
                    return 1 // assumes we need to spill acc
                case ts.SyntaxKind.ParenthesizedExpression: 
                    return visit((n as ts.ParenthesizedExpression).expression, isAcc)
                case ts.SyntaxKind.BinaryExpression:
                    const bin = n as ts.BinaryExpression
                    if (isLogicalOp(bin.operatorToken.kind)) {
                        // no spill
                        return Math.max(visit(bin.left, isAcc), visit(bin.right, isAcc))
                    }
                    const l = visit(bin.left, false)
                    const r = visit(bin.right, false)
                    if (r === 0) return l
                    return Math.max(Math.max(l-1, 0), Math.max(r, 0) + (isCommutativeBinaryExp(bin.operatorToken.kind) ? 0 : 1)) + (isAcc ? 1 : 0)
                case ts.SyntaxKind.PrefixUnaryExpression:
                case ts.SyntaxKind.PostfixUnaryExpression:
                    const operand = (n as ts.PrefixUnaryExpression | ts.PostfixUnaryExpression).operand
                    const operator = (n as ts.PrefixUnaryExpression | ts.PostfixUnaryExpression).operator
                    if (!isAssignmentUnary(operator)) return visit(operand, isAcc)
                    return visit(operand, isAcc) + 1
                case ts.SyntaxKind.CallExpression:
                    const subj = (n as ts.CallExpression).expression
                    const args = (n as ts.CallExpression).arguments
                    const argMax = Math.max(...args.map(x => Math.max(0, maxRegAllocsNeeded(x)-1)))
                    if (findConstPoolSlot(subj) !== undefined) {
                        return argMax + args.length + (isAcc ? 0 : 1)
                    }
                    const l = maxRegAllocsNeeded(subj)
                    return 1 + args.length + Math.max(l, argMax) + (isAcc ? 0 : 1)
                case ts.SyntaxKind.TypeOfExpression:
                    return visit((n as ts.TypeOfExpression).expression, isAcc)
                case ts.SyntaxKind.VoidExpression:
                    return visit((n as ts.VoidExpression).expression, isAcc)
                case ts.SyntaxKind.SpreadElement:
                    return 5 + visit((n as ts.SpreadElement).expression, true)
                case ts.SyntaxKind.ArrowFunction:
                case ts.SyntaxKind.FunctionExpression:
                    return isAcc ? 0 : 1
                case ts.SyntaxKind.ConditionalExpression:
                    const x = n as ts.ConditionalExpression
                    return Math.max(visit(x.condition, isAcc), visit(x.whenTrue, isAcc), visit(x.whenFalse, isAcc))

                default: throw `Unhandled exp kind: ${ts.SyntaxKind[n.kind]}`
            }
        }
        return visit(exp, true)
    }

    function mapBinaryOp(kind: ts.SyntaxKind): number {
        switch (kind) {
            case ts.SyntaxKind.PlusToken: return Op.Add
            case ts.SyntaxKind.MinusToken: return Op.Sub
            case ts.SyntaxKind.AsteriskToken: return Op.Mul
            case ts.SyntaxKind.SlashToken: return Op.Div
            case ts.SyntaxKind.PercentToken: return Op.Mod
            case ts.SyntaxKind.AsteriskAsteriskToken: return Op.Exp
            case ts.SyntaxKind.AmpersandToken: return Op.BitAnd
            case ts.SyntaxKind.BarToken: return Op.BitOr
            case ts.SyntaxKind.CaretToken: return Op.BitXor
            case ts.SyntaxKind.LessThanLessThanToken: return Op.ShiftLeft
            case ts.SyntaxKind.GreaterThanGreaterThanToken: return Op.ShiftRight
            case ts.SyntaxKind.GreaterThanGreaterThanGreaterThanToken: return Op.ShiftRightLogical
            case ts.SyntaxKind.LessThanToken: return Op.TestLessThan
            case ts.SyntaxKind.GreaterThanToken: return Op.TestGreaterThan
            case ts.SyntaxKind.LessThanEqualsToken: return Op.TestLessThanOrEqual
            case ts.SyntaxKind.GreaterThanEqualsToken: return Op.TestGreaterThanOrEqual
            case ts.SyntaxKind.ExclamationEqualsToken:
            case ts.SyntaxKind.ExclamationEqualsEqualsToken: return Op.TestNotStrictEqual
            case ts.SyntaxKind.EqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsEqualsToken: return Op.TestStrictEqual
            default: throw `unsupported binary operator: ${ts.SyntaxKind[kind]}`
        }
    }

    function tryFoldInts(kind: ts.SyntaxKind, lv: number, rv: number): number {
        switch (kind) {
            case ts.SyntaxKind.PlusToken: return lv + rv
            case ts.SyntaxKind.MinusToken: return lv - rv
            case ts.SyntaxKind.AsteriskToken: return Math.imul(lv, rv)
            case ts.SyntaxKind.AmpersandToken: return lv & rv
            case ts.SyntaxKind.BarToken: return lv | rv
            case ts.SyntaxKind.CaretToken: return lv ^ rv
            case ts.SyntaxKind.LessThanLessThanToken: return lv << rv
            case ts.SyntaxKind.GreaterThanGreaterThanToken: return lv >> rv
            case ts.SyntaxKind.GreaterThanGreaterThanGreaterThanToken: return lv >>> rv
            case ts.SyntaxKind.LessThanToken: return lv < rv ? 1 : 0
            case ts.SyntaxKind.GreaterThanToken: return lv > rv ? 1 : 0
            case ts.SyntaxKind.LessThanEqualsToken: return lv <= rv ? 1 : 0
            case ts.SyntaxKind.GreaterThanEqualsToken: return lv >= rv ? 1 : 0
            case ts.SyntaxKind.EqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsEqualsToken: return lv === rv ? 1 : 0
            case ts.SyntaxKind.ExclamationEqualsToken:
            case ts.SyntaxKind.ExclamationEqualsEqualsToken: return lv !== rv ? 1 : 0
            case ts.SyntaxKind.SlashToken:
                if (rv === 0) throw `Invalid expression: ${lv} / ${rv}`
                return Math.trunc(lv / rv) // idiv
            case ts.SyntaxKind.PercentToken:
                if (rv === 0) throw `Invalid expression: ${lv} % ${rv}`
                return lv % rv
            case ts.SyntaxKind.AsteriskAsteriskToken:
                const res = lv**rv
                if (!Number.isInteger(res)) throw `Invalid expression: ${lv} ** ${rv} = ${res}`
                return res
            default: throw "not foldable"
        }
    }

    function isFoldable(kind: ts.SyntaxKind): boolean {
        switch (kind) {
            // these are only foldable in native mode (we throw here if it would produce NaN)
            case ts.SyntaxKind.SlashToken:
            case ts.SyntaxKind.PercentToken:
                return true
            case ts.SyntaxKind.CommaToken: return false
            case ts.SyntaxKind.PlusEqualsToken:
            case ts.SyntaxKind.MinusEqualsToken:
            case ts.SyntaxKind.SlashEqualsToken:
            case ts.SyntaxKind.AsteriskEqualsToken:
            case ts.SyntaxKind.AmpersandEqualsToken:
            case ts.SyntaxKind.BarEqualsToken:
            case ts.SyntaxKind.CaretEqualsToken:
            case ts.SyntaxKind.QuestionQuestionEqualsToken:
            case ts.SyntaxKind.BarBarEqualsToken:
            case ts.SyntaxKind.AmpersandAmpersandEqualsToken:
            case ts.SyntaxKind.EqualsToken:
                return false
            default: return true
        }
    }

    function isLogicalOp(kind: ts.SyntaxKind): boolean {
        return kind === ts.SyntaxKind.BarBarToken || kind === ts.SyntaxKind.AmpersandAmpersandToken || kind === ts.SyntaxKind.QuestionQuestionToken
    }

    let foldDepth = 0 // so we can cache intermediate failures on the way back up
    let foldMaxDepth = 0
    const foldedResults = new Map<ts.Expression, FoldResult | false>()
    type FoldResult = 
        | [kind: 'value', value: FoldResultValue]
        | [kind: 'residual', node: ts.Expression]
    function tryFoldExp(node: ts.Expression): FoldResult | undefined {
        if (ts.isParenthesizedExpression(node)) {
            return tryFoldExp(node.expression)
        }
        if (ts.isNumericLiteral(node)) {
            const val = (node as any).getf64()
            return ['value', val]
        }
        if (ts.isStringLiteral(node)) {
            return ['value', node.text]
        }
        if (node.kind === ts.SyntaxKind.TrueKeyword) {
            return ['value', true]
        }
        if (node.kind === ts.SyntaxKind.FalseKeyword) {
            return ['value', false]
        }
        if (node.kind === ts.SyntaxKind.NullKeyword) {
            return ['value', null]
        }
        if (node.kind === ts.SyntaxKind.UndefinedKeyword) {
            return ['value', undefined]
        }
        if (const r = foldedResults.get(node)) return r ? r : undefined

        const isTop = foldDepth === 0
        defer foldMaxDepth = isTop ? 0 : Math.max(foldMaxDepth, foldDepth)

        foldDepth += 1
        defer foldDepth -= 1

        function tryGetNumber(n: ts.Expression) {
            const v = tryFoldExp(n)
            if (!v || v[0] === 'residual') return
            const operand = v[1]
            if (typeof operand !== 'number') return
            return operand
        }

        function tryGetAnyValue(n: ts.Expression) {
            const v = tryFoldExp(n)
            if (!v || v[0] === 'residual') return
            return v
        }

        function fold(): FoldResult | undefined  {
            if (ts.isConditionalExpression(node)) {
                const cond = tryFoldExp(node.condition)
                if (!cond || cond[0] === 'residual') return
                if (cond[1]) {
                    return tryFoldExp(node.whenTrue) ?? ['residual', node.whenTrue]
                }
                return tryFoldExp(node.whenFalse) ?? ['residual', node.whenFalse]
            } else if (ts.isBinaryExpression(node)) {
                const opKind = node.operatorToken.kind
                if (!isFoldable(opKind)) return
                const v1 = tryFoldExp(node.left)
                if (!v1 || v1[0] === 'residual') return
                const l = v1[1]

                if (isLogicalOp(opKind)) {
                    if (opKind === ts.SyntaxKind.BarBarToken) {
                        if (l) return ['value', l]
                        return tryFoldExp(node.right) ?? ['residual', node.right]
                    }
                    if (opKind === ts.SyntaxKind.AmpersandAmpersandToken) {
                        if (!l) return ['value', l]
                        return tryFoldExp(node.right) ?? ['residual', node.right]
                    }
                    if (opKind === ts.SyntaxKind.QuestionQuestionToken) {
                        if (l !== undefined && l !== null) return ['value', l]
                        return tryFoldExp(node.right) ?? ['residual', node.right]
                    }
                }

                const v2 = tryFoldExp(node.right)
                if (!v2 || v2[0] === 'residual') {
                    return
                }
                const r = v2[1]

                if (opKind === ts.SyntaxKind.EqualsEqualsEqualsToken || opKind === ts.SyntaxKind.EqualsEqualsToken) {
                    return ['value', l === r]
                }
                if (opKind === ts.SyntaxKind.ExclamationEqualsEqualsToken || opKind === ts.SyntaxKind.ExclamationEqualsToken) {
                    return ['value', l !== r]
                }

                if (typeof l === 'string' || typeof r === 'string') {
                    if (opKind !== ts.SyntaxKind.PlusToken) return
                    return ['value', l + (r as string)]
                }
                if (typeof l === 'number' && typeof r === 'number') {
                    intrinsics.assert(Number.isInteger(l) && Number.isInteger(r))
                    return ['value', tryFoldInts(opKind, l, r)]
                }
            } else if (ts.isPrefixUnaryExpression(node)) {
                const opKind = node.operator
                if (opKind === ts.SyntaxKind.MinusToken) {
                    if (const v = tryGetNumber(node.operand)) {
                        return ['value', -v]
                    }
                } else if (opKind === ts.SyntaxKind.TildeToken) {
                    if (const v = tryGetNumber(node.operand)) {
                        return ['value', ~v]
                    }
                } else if (opKind === ts.SyntaxKind.ExclamationToken) {
                    if (const v = tryGetAnyValue(node.operand)) {
                        return ['value', !v[1]]
                    }
                }
            } else if (ts.isVoidExpression(node)) {
                if (tryGetAnyValue(node.expression)) {
                    return ['value', undefined]
                }
            } else if (ts.isPropertyAccessExpression(node)) {
                if (node.name.text !== 'length') return
                const v = tryGetAnyValue(node.expression)
                if (!v || typeof v[1] !== 'string') return
                return ['value', new TextEncoder().encode(v[1]).length]
            } else if (ts.isIdentifier(node)) {
                const symId = getSymbolId(node)
                if (!symId) return
                if (const x = foldedVariables.get(symId)) {
                    return ['value', x[0]]
                }
            }
        }

        const r = fold()
        if (!r) {
            if ((foldMaxDepth - foldDepth) >= 3) foldedResults.set(node, false)
            return
        }
        foldedResults.set(node, r)
        return r
    }

    function isCommutativeBinaryExp(kind: ts.SyntaxKind): boolean {
        switch (kind) {
            case ts.SyntaxKind.PlusToken:
            case ts.SyntaxKind.AsteriskToken:
            case ts.SyntaxKind.AmpersandToken:
            case ts.SyntaxKind.BarToken:
            case ts.SyntaxKind.CaretToken:
            case ts.SyntaxKind.ExclamationEqualsToken:
            case ts.SyntaxKind.ExclamationEqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsEqualsToken:
                return true
            default:
                return false
        }
    }

    // `x <op>= e` -> the binary op behind the compound assignment
    function compoundBinaryOp(kind: ts.SyntaxKind): number {
        switch (kind) {
            case ts.SyntaxKind.PlusEqualsToken: return Op.AddOrConcat
            case ts.SyntaxKind.MinusEqualsToken: return Op.Sub
            case ts.SyntaxKind.AsteriskEqualsToken: return Op.Mul
            case ts.SyntaxKind.SlashEqualsToken: return Op.Div
            case ts.SyntaxKind.PercentEqualsToken: return Op.Mod
            case ts.SyntaxKind.AsteriskAsteriskEqualsToken: return Op.Exp
            case ts.SyntaxKind.AmpersandEqualsToken: return Op.BitAnd
            case ts.SyntaxKind.BarEqualsToken: return Op.BitOr
            case ts.SyntaxKind.CaretEqualsToken: return Op.BitXor
            case ts.SyntaxKind.LessThanLessThanEqualsToken: return Op.ShiftLeft
            case ts.SyntaxKind.GreaterThanGreaterThanEqualsToken: return Op.ShiftRight
            case ts.SyntaxKind.GreaterThanGreaterThanGreaterThanEqualsToken: return Op.ShiftRightLogical
            default: throw `unsupported compound assignment: ${ts.SyntaxKind[kind]}`
        }
    }

    function logicalAssignmentJump(kind: ts.SyntaxKind): number | undefined {
        switch (kind) {
            case ts.SyntaxKind.QuestionQuestionEqualsToken: return Op.JumpIfNotNullish
            case ts.SyntaxKind.BarBarEqualsToken: return Op.JumpIfToBooleanTrue
            case ts.SyntaxKind.AmpersandAmpersandEqualsToken: return Op.JumpIfToBooleanFalse
        }
    }

    function emitLogicalAssignment(jumpOp: number, load: () => void, right: ts.Expression, store: () => void): void {
        load()
        const end = emitJumpPlaceholder(jumpOp)
        skipNextLookbehind = true
        emitExpr(right)
        store()
        patchJump(end)
    }

    function isAssignmentOp(kind: ts.SyntaxKind): boolean {
        return kind >= ts.SyntaxKind.FirstAssignment && kind <= ts.SyntaxKind.LastAssignment
    }

    function finishPropertyAccessAssignment(node: ts.BinaryExpression, load: () => void, store: () => void) {
        const kind = node.operatorToken.kind
        if (kind === ts.SyntaxKind.EqualsToken) {
            emitExpr(node.right) // acc = value
            store()
            return
        }

        const jump = logicalAssignmentJump(kind)
        if (jump !== undefined) {
            emitLogicalAssignment(jump, load, node.right, store)
            return
        }
        const op = compoundBinaryOp(kind)
        if (isLexicalIdent(node.right)) {
            load() // acc = obj[key]
            emit2(op, symToReg.get(getSymbolId(node.right))!)
        } else {
            emitExpr(node.right)
            const rR = allocReg(); star(rR)
            load() // acc = obj[key]
            emit2(op, rR)
            freeReg()
        }
        store()
    }

    function emitPropertyTarget(
        target: ts.PropertyAccessExpression | ts.ElementAccessExpression,
        finish: (load: () => void, store: () => void) => void,
    ) {
        if (target.questionDotToken) throw `optional chaining assignment is not supported`
        if (target.expression.kind === ts.SyntaxKind.SuperKeyword) throw 'assignment to a super property is not supported'
        const isConstName = target.kind === ts.SyntaxKind.PropertyAccessExpression

        emitExpr(target.expression) // acc = object
        const robj = allocReg(); star(robj)
        defer freeReg()

        if (ts.isPropertyAccessExpression(target)) {
            const entry = privateMember(target.name)
            if (entry) return finish(() => emitPrivateRead(entry, target.name.text, robj), () => emitPrivateWrite(entry, target.name.text, robj))
        }
        function finishKey(getOp: number, setOp: number, keySlot: number): void {
            const load = () => {
                ldar(robj)
                emit2(getOp, keySlot)
            }
            finish(load, () => emit3(setOp, robj, keySlot))
        }

        if (target.kind === ts.SyntaxKind.ElementAccessExpression) {
            const key = tryFoldExp(target.argumentExpression)
            if (key?.[0] === 'value' && typeof key[1] === 'number') {
                finishKey(Op.GetPropertyImm, Op.SetPropertyImm, key[1])
                return
            }
        }

        const keySlot = isConstName ? internName(target.name) : allocReg()
        defer if (!isConstName) freeReg()

        if (!isConstName) {
            if (const val = tryFoldExp(target.argumentExpression)) {
                if (val[0] === 'value' && typeof val[1] === 'string') {
                    return finishKey(Op.GetPropertyConst, Op.SetPropertyConst, internValue(val[1]))
                }
            }
            emitExpr(target.argumentExpression)
            star(keySlot)
        }

        finishKey(
            isConstName ? Op.GetPropertyConst : Op.GetProperty,
            isConstName ? Op.SetPropertyConst : Op.SetProperty,
            keySlot,
        )
    }

    function emitPropertyAccessAssignment(
        node: ts.BinaryExpression,
        target: ts.PropertyAccessExpression | ts.ElementAccessExpression
    ) {
        emitPropertyTarget(target, (load, store) => finishPropertyAccessAssignment(node, load, store))
    }

    function emitAssignment(node: ts.BinaryExpression) {
        const target = node.left
        if (ts.isPropertyAccessExpression(target) || ts.isElementAccessExpression(target)) {
            emitPropertyAccessAssignment(node, target)
            return
        }
        if (!ts.isIdentifier(target)) throw `unsupported assignment target: ${ts.SyntaxKind[target.kind]}`
        const symId = getSymbolId(target)
        if (symId === 0) throw `non-lexical assignment target: ${target.getText()}`
        const scoped = scopedSymbol(symId)
        if (scoped) {
            const kind = node.operatorToken.kind
            if (kind === ts.SyntaxKind.EqualsToken) {
                emitExpr(node.right)
                emit3(Op.StoreFrame, scoped.scopeSlot, scoped.reg)
                return
            }
            const jump = logicalAssignmentJump(kind)
            if (jump !== undefined) {
                const load = () => emit3(Op.LoadFrame, scoped.scopeSlot, scoped.reg)
                emitLogicalAssignment(jump, load, node.right, () => emit3(Op.StoreFrame, scoped.scopeSlot, scoped.reg))
                return
            }
            const op = compoundBinaryOp(kind)
            emitExpr(node.right)
            const rhs = allocReg(); star(rhs)
            emit3(Op.LoadFrame, scoped.scopeSlot, scoped.reg)
            emit2(op, rhs)
            freeReg()
            emit3(Op.StoreFrame, scoped.scopeSlot, scoped.reg)
            return
        }
        if (isLateBoundSymbol(target)) throw `cannot assign to free variable: ${target.getText()}`
        const reg = symToReg.get(symId)
        if (reg === undefined) {
            if (foldedVariables.has(symId)) throw `cannot assign to const binding: ${target.getText()}`
            throw `unresolved assignment target: ${target.getText()}`
        }

        const kind = node.operatorToken.kind
        if (kind === ts.SyntaxKind.EqualsToken) {
            emitExpr(node.right)       // acc = rhs
            star(reg)        // target = acc
            return
        }

        const jump = logicalAssignmentJump(kind)
        if (jump !== undefined) {
            emitLogicalAssignment(jump, () => ldar(reg), node.right, () => star(reg))
            return
        }
        const op = compoundBinaryOp(kind)
        if (isLexicalIdent(node.right)) {
            ldar(reg)
            emit2(op, symToReg.get(getSymbolId(node.right))!)
        } else {
            emitExpr(node.right)
            const rR = allocReg(); star(rR)
            ldar(reg)
            emit2(op, rR)
            freeReg()
        }
        star(reg)
    }

    function privateMember(name: ts.MemberName): PrivateName | undefined {
        if (!ts.isPrivateIdentifier(name)) return
        return privateMembers?.get(name.text)
    }

    function privateTemplate(member: PrivateMember, name: string): number {
        const known = privateMemberSlots.get(member)
        if (known !== undefined) return known
        if (member.compiling) throw `recursive private member ${name} is not supported`
        member.compiling = true
        defer member.compiling = false
        const template = member.template ?? emitFunction(member.node, closureCtx(member.node))
        template.name = name
        if (template.scopeBindings.length && template.selfSlot !== undefined) throw `recursive private member ${name} with captures is not supported`
        if (!template.scopeBindings.length) member.template = template
        const slot = constants.length
        constants.push(template)
        constantKinds.push(ConstantKind.nested_function)
        privateMemberSlots.set(member, slot)
        return slot
    }

    function ownSlot(): number {
        if (selfSlot !== undefined) return selfSlot
        selfSlot = constants.length
        constants.push(fn.name!.getText())
        constantKinds.push(ConstantKind.function_)
        return selfSlot
    }

    function emitPrivateInvoke(member: PrivateMember, name: string, call: (op: 'Call' | 'CallConst', callee: number) => void): void {
        if (member.node === fn) return call('CallConst', ownSlot())
        const slot = privateTemplate(member, name)
        const template = constants[slot] as EmitResult
        if (!template.scopeBindings.length) return call('CallConst', slot)
        emit2(Op.CreateClosure, slot)
        const callee = allocReg()
        defer freeReg()
        star(callee)
        call('Call', callee)
    }

    function emitPrivateRead(entry: PrivateName, name: string, receiver: number): void {
        if (entry.method) throw `private method ${name} can only be called`
        if (!entry.getter) throw `cannot read private member ${name}`
        emitPrivateInvoke(entry.getter, name, (op, callee) => {
            ldar(receiver)
            emit4(Op[op], callee, 0, 0)
        })
    }

    function emitPrivateWrite(entry: PrivateName, name: string, receiver: number): void {
        if (!entry.setter) throw `cannot assign to private member ${name}`
        const value = allocReg()
        defer freeReg()
        star(value)
        emitPrivateInvoke(entry.setter, name, (op, callee) => {
            ldar(receiver)
            emit4(Op[op], callee, value, 1)
        })
        ldar(value)
    }

    function emitPrivateGetter(name: ts.MemberName): boolean {
        const entry = privateMember(name)
        if (!entry) return false
        const receiver = allocReg()
        defer freeReg()
        star(receiver)
        emitPrivateRead(entry, (name as ts.PrivateIdentifier).text, receiver)
        return true
    }

    function emitPrivateCall(node: ts.CallExpression, method: PrivateMember): void {
        const target = node.expression as ts.PropertyAccessExpression
        if (node.questionDotToken || target.questionDotToken) throw `optional chaining is not supported`
        const receiver = allocReg()
        defer freeReg()
        emitExpr(target.expression)
        star(receiver)
        emitPrivateInvoke(method, target.name.text, (op, callee) => emitCallArgs(op, callee, node.arguments, receiver))
    }

    function emitPropertyAccess(node: ts.PropertyAccessExpression | ts.ElementAccessExpression, receiverReg?: number, shouldSpillRecv = true) {
        if (node.questionDotToken) throw `optional chaining is not supported`
        if (node.expression.kind === ts.SyntaxKind.SuperKeyword) {
            emitSuperGet(node)
            return
        }

        emitExpr(node.expression) // acc = object

        if (receiverReg === undefined && isReceiverIdent(node.expression)) {
            receiverReg = symToReg.get(getSymbolId(node.expression))!
            shouldSpillRecv = false
        }

        if (receiverReg !== undefined && shouldSpillRecv) star(receiverReg)
        if (ts.isPropertyAccessExpression(node) && emitPrivateGetter(node.name)) return

        if (node.kind === ts.SyntaxKind.ElementAccessExpression) {
            const key = tryFoldExp(node.argumentExpression)
            if (key?.[0] === 'value' && typeof key[1] === 'number') {
                emit2(Op.GetPropertyImm, key[1])
                return
            }
        }

        const isConstName = node.kind === ts.SyntaxKind.PropertyAccessExpression
        const keySlot = isConstName ? internName(node.name) : allocReg()
        defer if (!isConstName) freeReg()

        let spilledRecv: number | undefined
        defer if (spilledRecv) freeReg()

        if (!isConstName) {
            if (const val = tryFoldExp(node.argumentExpression)) {
                if (val[0] === 'value' && typeof val[1] === 'string') {
                    return emit2(Op.GetPropertyConst, internValue(val[1]))
                }
            }
            if (isLexicalIdent(node.argumentExpression)) {
                return emit2(Op.GetProperty, symToReg.get(getSymbolId(node.argumentExpression))!)
            }
            if (receiverReg === undefined && shouldSpillRecv) {
                spilledRecv = allocReg()
                star(spilledRecv)
            }
            emitExpr(node.argumentExpression)
            star(keySlot)
        }

        if (!isConstName) ldar(spilledRecv ?? receiverReg!)
        emit2(isConstName ? Op.GetPropertyConst : Op.GetProperty, keySlot)
    }

    function emitChainedPropertyAccess(node: ts.PropertyAccessExpression | ts.ElementAccessExpression, receiverReg?: number) {
        if (ts.isPropertyAccessExpression(node) && emitPrivateGetter(node.name)) return
        if (node.kind === ts.SyntaxKind.ElementAccessExpression) {
            const key = tryFoldExp(node.argumentExpression)
            if (key?.[0] === 'value' && typeof key[1] === 'number') {
                emit2(Op.GetPropertyImm, key[1])
                return
            }
        }

        if (node.kind === ts.SyntaxKind.PropertyAccessExpression) {
            emit2(Op.GetPropertyConst, internName(node.name))
            return
        }

        if (const key = tryFoldExp(node.argumentExpression)) {
            if (key[0] === 'value' && typeof key[1] === 'string') {
                emit2(Op.GetPropertyConst, internValue(key[1]))
                return
            }
        }
        if (isLexicalIdent(node.argumentExpression)) {
            emit2(Op.GetProperty, symToReg.get(getSymbolId(node.argumentExpression))!)
            return
        }

        let savedReceiver = receiverReg
        if (savedReceiver === undefined) {
            savedReceiver = allocReg()
            star(savedReceiver)
        }
        defer if (receiverReg === undefined) freeReg()
        const keyReg = allocReg()
        defer freeReg()
        emitExpr(node.argumentExpression)
        star(keyReg)
        ldar(savedReceiver)
        emit2(Op.GetProperty, keyReg)
    }

    function isOptionalChainExpression(node: ts.Expression): boolean {
        if (ts.isPropertyAccessExpression(node) || ts.isElementAccessExpression(node) || ts.isCallExpression(node)) {
            return !!node.questionDotToken || isOptionalChainExpression(node.expression)
        }
        return false
    }

    function emitOptionalChain(node: ts.Expression): void {
        const nullish: number[] = []

        function emitOptionalOperand(exp: ts.Expression): void {
            if (isOptionalChainExpression(exp)) emitOptionalPart(exp)
            else emitExpr(exp)
        }

        function checkNullish(): void {
            nullish.push(emitJumpPlaceholder(Op.JumpIfNullish))
        }

        function emitOptionalPart(exp: ts.Expression): void {
            if (ts.isPropertyAccessExpression(exp) || ts.isElementAccessExpression(exp)) {
                emitOptionalOperand(exp.expression)
                if (exp.questionDotToken) checkNullish()
                emitChainedPropertyAccess(exp)
                return
            }
            if (ts.isCallExpression(exp)) {
                const callee = exp.expression
                if (ts.isPropertyAccessExpression(callee) || ts.isElementAccessExpression(callee)) {
                    emitOptionalOperand(callee.expression)
                    if (callee.questionDotToken) checkNullish()
                    const receiverReg = allocReg()
                    defer freeReg()
                    star(receiverReg)
                    emitChainedPropertyAccess(callee, receiverReg)
                    if (exp.questionDotToken) checkNullish()
                    const calleeReg = allocReg()
                    defer freeReg()
                    star(calleeReg)
                    emitCallArgs('Call', calleeReg, exp.arguments, receiverReg)
                    return
                }
                emitOptionalOperand(callee)
                if (exp.questionDotToken) checkNullish()
                const calleeReg = allocReg()
                defer freeReg()
                star(calleeReg)
                emitCallArgs('Call', calleeReg, exp.arguments)
                return
            }
            throw `unsupported optional chain: ${ts.SyntaxKind[exp.kind]}`
        }

        emitOptionalPart(node)
        const done = emitJumpPlaceholder(Op.Jump)
        for (const jump of nullish) patchJump(jump)
        emit1(Op.LdaUndefined)
        patchJump(done)
    }

    function emitLogicalOp(node: ts.BinaryExpression) {
        const kind = node.operatorToken.kind
        emitExpr(node.left) // acc = left
        const jumpOp = kind === ts.SyntaxKind.AmpersandAmpersandToken ? Op.JumpIfToBooleanFalse : kind === ts.SyntaxKind.QuestionQuestionToken ? Op.JumpIfNotNullish : Op.JumpIfToBooleanTrue
        const overRight = emitJumpPlaceholder(jumpOp)
        skipNextLookbehind = true
        emitExpr(node.right) // acc = right
        patchJump(overRight)
    }

    function emitBinary(node: ts.BinaryExpression): void {
        const kind = node.operatorToken.kind

        if (isAssignmentOp(kind)) { emitAssignment(node); return }

        if (kind === ts.SyntaxKind.InstanceOfKeyword) {
            emitCallArgs('CallRuntime', RtOp.instanceof, [node.left, node.right])
            return
        }

        if (kind === ts.SyntaxKind.CommaToken) {
            emitExpr(node.left)
            emitExpr(node.right)
            return
        }

        if (isLogicalOp(kind)) { emitLogicalOp(node); return }

        if (ts.isNumericLiteral(node.left) && ts.isNumericLiteral(node.right) && isFoldable(kind)) {
            const lv = Number(node.left.text)
            const rv = Number(node.right.text)
            if (Number.isInteger(lv) && Number.isInteger(rv)) { emitNumber(tryFoldInts(kind, lv, rv)); return }
        }

        const op = kind === ts.SyntaxKind.PlusToken && !(isNumericExpression(node.left) && isNumericExpression(node.right))
            ? Op.AddOrConcat
            : mapBinaryOp(kind)
        const commutative = op !== Op.AddOrConcat && isCommutativeBinaryExp(kind)

        if (isLexicalIdent(node.right)) {
            emitExpr(node.left)
            emit2(op, symToReg.get(getSymbolId(node.right))!)
            return
        }

        if (isLexicalIdent(node.left) && commutative) {
            const rL = symToReg.get(getSymbolId(node.left))!
            emitExpr(node.right)
            return emit2(op, rL)
        }

        emitExpr(node.left)
        const rL = allocReg(); star(rL)
        defer freeReg()
        emitExpr(node.right)
        if (commutative) {
            return emit2(op, rL)
        }
        const rR = allocReg(); star(rR)
        ldar(rL)
        emit2(op, rR)
        freeReg()
    }

    function isAssignmentUnary(op: ts.SyntaxKind) {
        return op === ts.SyntaxKind.PlusPlusToken || op === ts.SyntaxKind.MinusMinusToken
    }

    function emitUpdateAcc(isPrefix: boolean, increment: boolean, store: () => void) {
        const op = increment ? Op.Inc : Op.Dec
        if (isPrefix) {
            emit1(op)
            store()
            return
        }
        const old = allocReg(); star(old)
        emit1(op)
        store()
        ldar(old)
        freeReg()
    }

    function emitUnaryAssignment(node: ts.PrefixUnaryExpression | ts.PostfixUnaryExpression) {
        assert(isAssignmentUnary(node.operator))
        const isPrefix = node.kind === ts.SyntaxKind.PrefixUnaryExpression
        const op = node.operator === ts.SyntaxKind.PlusPlusToken 
            ? (isPrefix ? Op.Inc : Op.IncPost) 
            : (isPrefix ? Op.Dec : Op.DecPost) 
        const operand = node.operand
        const increment = node.operator === ts.SyntaxKind.PlusPlusToken
        if (ts.isPropertyAccessExpression(operand) || ts.isElementAccessExpression(operand)) {
            return emitPropertyTarget(operand, (load, store) => {
                load()
                emitUpdateAcc(isPrefix, increment, store)
            })
        }
        const symId = getSymbolId(operand)
        if (symId === 0) throw `non-lexical identifier: ${operand.getText()}`
        if (const scoped = scopedSymbol(symId)) {
            emit3(Op.LoadFrame, scoped.scopeSlot, scoped.reg)
            return emitUpdateAcc(isPrefix, increment, () => emit3(Op.StoreFrame, scoped.scopeSlot, scoped.reg))
        }
        const dst = symToReg.get(symId)
        assert(dst !== undefined)
        if (!isPrefix) return emit2(op, dst)

        ldar(dst)
        emit1(op)
        star(dst)
    }

    function isLogicalNot(node: ts.Expression): node is ts.PrefixUnaryExpression {
        return ts.isPrefixUnaryExpression(node) && node.operator === ts.SyntaxKind.ExclamationToken
    }

    function prefixUnaryToOp(token: ts.SyntaxKind) {
        switch (token) {
            case ts.SyntaxKind.MinusToken: return Op.Negate
            case ts.SyntaxKind.TildeToken: return Op.BitNot
            case ts.SyntaxKind.ExclamationToken: return Op.LogicalNot
            case ts.SyntaxKind.PlusToken: return Op.ToNumber
            default: throw `Unhandled unary operator: ${ts.SyntaxKind[token]}`
        }
    }

    function emitPrefixUnary(node: ts.PrefixUnaryExpression) {
        const op = node.operator
        if (isAssignmentUnary(op)) {
            return emitUnaryAssignment(node)
        }
        const operand = node.operand
        if (op === ts.SyntaxKind.ExclamationToken) {
            if (isLogicalNot(operand)) {
                emitExpr(operand.operand)
                return emit1(Op.LogicalNotNot)
            }
            emitExpr(operand)
            return emit1(Op.LogicalNot)
        }
        const op2 = prefixUnaryToOp(op)
        emitExpr(operand)
        return emit1(op2)
    }

    function emitPostfixUnary(node: ts.PostfixUnaryExpression) {
        const op = node.operator
        if (isAssignmentUnary(op)) {
            return emitUnaryAssignment(node)
        }
        console.log(ts.SyntaxKind[op])
        assert(false)
    }

    function emitIdentifier(node: ts.Identifier) {
        const saveCurrentNode = currentNode
        defer currentNode = saveCurrentNode
        currentNode = node

        const symId = getSymbolId(node)
        if (symId === 0) throw `non-lexical identifier: ${node.getText()}`
        if (const scoped = scopedSymbol(symId)) {
            emit3(Op.LoadFrame, scoped.scopeSlot, scoped.reg)
            return
        }
        const reg = symToReg.get(symId)
        if (reg !== undefined) {
            return ldar(reg)
        }
        if (isLateBoundSymbol(node)) { emitLoadConst(lateBoundSlot(symId, node.getText())); return }
        // was folded
        const v = foldedVariables.get(symId)
        if (!v) {
            if (const slot = lateBound.get(symId)) {
                return void emitLoadConst(slot)
            }
            throw `unresolved identifier: ${node.getText()}`
        }
        return emitLiteral(v[0])
    }

    function objTemplateKeys(node: ts.ObjectLiteralExpression): string[] | undefined {
        if (!node.properties.length) return
        const keys: string[] = []
        for (const p of node.properties) {
            let name: string | undefined
            if (ts.isShorthandPropertyAssignment(p)) {
                name = p.name.text
            } else if (ts.isPropertyAssignment(p) && (ts.isIdentifier(p.name) || ts.isStringLiteral(p.name) || ts.isNumericLiteral(p.name))) {
                name = p.name.text
            } else if (ts.isMethodDeclaration(p) && ts.isIdentifier(p.name)) {
                name = p.name.text
            }
            if (name === undefined || name === '__proto__' || keys.includes(name)) return
            keys.push(name)
        }
        return keys
    }

    function emitObjectTemplate(node: ts.ObjectLiteralExpression, keys: string[]): void {
        const savedReg = nextReg
        defer nextReg = savedReg
        const registers = keys.map(() => allocReg())
        for (let i = 0; i < keys.length; i++) {
            const p = node.properties[i]
            if (ts.isMethodDeclaration(p)) emitClosure(p)
            else if (ts.isShorthandPropertyAssignment(p)) emitExpr(p.name)
            else emitExpr((p as ts.PropertyAssignment).initializer)
            star(registers[i])
        }
        emit4(Op.CreateObjectLiteral, internObjectTemplate(keys), registers[0], keys.length)
    }

    function emitObjectLiteral(node: ts.ObjectLiteralExpression): void {
        const keys = objTemplateKeys(node)
        if (keys) return emitObjectTemplate(node, keys)
        emit1(Op.CreateEmptyObject)
        const robj = allocReg()
        star(robj)
        defer freeReg()
        for (const p of node.properties) {
            if (ts.isSpreadAssignment(p)) {
                const argStart = nextReg
                const target = allocReg(); ldar(robj); star(target)
                const source = allocReg(); emitExpr(p.expression); star(source)
                emitRuntimeCall(RtOp.copyDataProperties, argStart, 2)
                freeReg()
                freeReg()
                continue
            }
            if (ts.isComputedPropertyName(p.name) && (ts.isPropertyAssignment(p) || ts.isMethodDeclaration(p))) {
                emitExpr(p.name.expression)
                const key = allocReg(); star(key)
                if (ts.isMethodDeclaration(p)) {
                    emitClosure(p)
                } else {
                    emitExpr(p.initializer)
                }
                emit3(Op.SetProperty, robj, key)
                freeReg()
                continue
            }
            let name: string
            let value: ts.Expression
            if (ts.isShorthandPropertyAssignment(p)) {
                name = p.name.text
                value = p.name
            } else if (ts.isPropertyAssignment(p) && !ts.isComputedPropertyName(p.name)) {
                name = p.name.text
                value = p.initializer
            } else if (ts.isMethodDeclaration(p) && ts.isIdentifier(p.name)) {
                emitClosure(p)
                emit3(Op.SetPropertyConst, robj, internString(p.name.text))
                continue
            } else {
                throw `unsupported object property: ${ts.SyntaxKind[p.kind]}`
            }
            emitExpr(value)
            emit3(Op.SetPropertyConst, robj, internString(name))
        }
        ldar(robj)
    }

    function emitArrayLiteral(node: ts.ArrayLiteralExpression): void {
        emitArrayOf(node.elements)
    }

    function emitArrayOf(elements: ReadonlyArray<ts.Expression>): void {
        const savedReg = nextReg
        defer nextReg = savedReg
        if (elements.length && !elements.some(ts.isSpreadElement)) {
            const registers = elements.map(() => allocReg())
            for (let i = 0; i < elements.length; i++) {
                if (ts.isOmittedExpression(elements[i])) emit1(Op.LdaUndefined)
                else emitExpr(elements[i])
                star(registers[i])
            }
            emit3(Op.CreateArrayLiteral, registers[0], elements.length)
            return
        }
        emit2(Op.CreateEmptyArray, lateBoundSlot(-4, 'Array'))
        const rarray = allocReg()
        star(rarray)
        let index: number | undefined
        for (let i = 0; i < elements.length; i++) {
            const element = elements[i]
            if (ts.isSpreadElement(element)) {
                if (index === undefined) {
                    index = allocReg()
                    emitNumber(i)
                    star(index)
                }
                emitSpreadInto(rarray, index, element.expression)
                continue
            }
            if (ts.isOmittedExpression(element)) emit1(Op.LdaUndefined)
            else emitExpr(element)
            if (index === undefined) {
                emit3(Op.SetPropertyImm, rarray, i)
                continue
            }
            emitAppend(rarray, index)
        }
        ldar(rarray)
    }

    function emitAppend(rarray: number, index: number): void {
        emit3(Op.SetProperty, rarray, index)
        ldar(index)
        emit1(Op.Inc)
        star(index)
    }

    function emitOpenIterator(exp: ts.Expression): { iterator: number, method: number } {
        emitExpr(exp)
        const iterator = allocReg(); star(iterator)
        emitLoadConst(internSymbol(Symbol.iterator))
        const method = allocReg(); star(method)
        ldar(iterator)
        emit2(Op.GetProperty, method)
        star(method)
        emitCallArgs('Call', method, [], iterator)
        star(iterator)
        emit2(Op.GetPropertyConst, internString('next'))
        star(method)
        return { iterator, method }
    }

    function emitSpreadInto(rarray: number, index: number, exp: ts.Expression): void {
        const savedReg = nextReg
        defer nextReg = savedReg
        const { iterator, method } = emitOpenIterator(exp)
        const step = allocReg()
        skipNextLookbehind = true
        const top = code.length
        emitCallArgs('Call', method, [], iterator)
        star(step)
        emit2(Op.GetPropertyConst, internString('done'))
        const end = emitJumpPlaceholder(Op.JumpIfToBooleanTrue)
        ldar(step)
        emit2(Op.GetPropertyConst, internString('value'))
        emitAppend(rarray, index)
        emitJumpTo(Op.Jump, top)
        patchJump(end)
    }

    function emitTemplateExpression(node: ts.TemplateExpression): void {
        emitLoadConst(internString(node.head.text))
        const result = allocReg()
        star(result)
        defer freeReg()
        function concat(): void {
            const value = allocReg()
            star(value)
            ldar(result)
            emit2(Op.AddOrConcat, value)
            star(result)
            freeReg()
        }
        for (const span of node.templateSpans) {
            emitExpr(span.expression)
            concat()
            if (span.literal.text) {
                emitLoadConst(internString(span.literal.text))
                concat()
            }
        }
        ldar(result)
    }

    function emitExpr(node: ts.Expression): void {
        const saveCurrentNode = currentNode
        defer currentNode = saveCurrentNode
        currentNode = node

        if (const r = tryFoldExp(node)) {
            if (r[0] === 'value') {
                return emitLiteral(r[1])
            }
            return emitExpr(r[1]) // residual
        }
        if (isOptionalChainExpression(node)) { emitOptionalChain(node); return }
        if (ts.isParenthesizedExpression(node)) { emitExpr(node.expression); return }
        if (node.kind === ts.SyntaxKind.SuperKeyword) throw "'super' must be followed by a call or property access"
        if (node.kind === ts.SyntaxKind.ThisKeyword) {
            if (loadBinding(thisSymbol, thisReg)) return
            // generally should not happen?
            emitLoadConst(lateBoundSlot(getSymbolId(node), "this"))
            return
        }
        if (ts.isNumericLiteral(node)) { emitNumber(Number(node.text)); return }
        if (ts.isStringLiteral(node)) { emitLoadConst(internString(node.text)); return }
        if (ts.isIdentifier(node)) { emitIdentifier(node); return }
        if (ts.isBinaryExpression(node)) { emitBinary(node); return }
        if (ts.isPrefixUnaryExpression(node)) { emitPrefixUnary(node); return }
        if (ts.isPostfixUnaryExpression(node)) { emitPostfixUnary(node); return }
        if (ts.isTypeOfExpression(node)) { emitExpr(node.expression); emit1(Op.TypeOf); return }
        if (ts.isVoidExpression(node)) {
            emitExpr(node.expression)
            emit1(Op.LdaUndefined)
            return
        }
        if (ts.isArrowFunction(node) || ts.isFunctionExpression(node)) { emitClosure(node); return }
        if (ts.isConditionalExpression(node)) { emitConditionalExp(node); return }
        if (ts.isTemplateExpression(node)) { emitTemplateExpression(node); return }
        if (ts.isArrayLiteralExpression(node)) { emitArrayLiteral(node); return }
        if (ts.isObjectLiteralExpression(node)) { emitObjectLiteral(node); return }
        if (ts.isClassExpression(node)) { emitClass(node); return }
        if (ts.isPropertyAccessExpression(node) || ts.isElementAccessExpression(node)) { 
            return void emitPropertyAccess(node);
        }
        if (ts.isCallExpression(node) || ts.isNewExpression(node)) { 
            return void emitCallOrConstruct(node) 
        }
        if (ts.isNoSubstitutionTemplateLiteral(node)) {
            emitLoadConst(internString(node.text))
            return
        }
        if (ts.isRegularExpressionLiteral(node)) {
            const end = node.text.lastIndexOf('/')
            const saveNextReg = nextReg
            defer nextReg = saveNextReg
            const args = nextReg
            const source = allocReg()
            const flags = allocReg()
            emitLoadConst(internString(node.text.slice(1, end)))
            star(source)
            emitLoadConst(internString(node.text.slice(end + 1)))
            star(flags)
            emitRuntimeCall(RtOp.regExpCreate, args, 2)
            return
        }
        throw `unsupported expression: ${ts.SyntaxKind[node.kind]}`
    }

    function emitRuntimeCall(op: RtOp, argStart: number, count: number): void {
        emit1(Op.LdaUndefined)
        emit4(Op.CallRuntime, op, argStart, count)
    }

    function emitCallArgs(
        callOp: keyof typeof Op,
        callee: number,
        args: ReadonlyArray<ts.Expression>,
        thisReg?: number
    ) {
        const saveNextReg = nextReg
        defer nextReg = saveNextReg

        if (args.some(ts.isSpreadElement)) {
            if (callOp !== 'Call') throw `spread arguments are not supported for ${callOp}`
            emitArrayOf(args)
            const rarray = allocReg(); star(rarray)
            if (thisReg !== undefined) ldar(thisReg)
            else emit1(Op.LdaUndefined)
            emit3(Op.CallArray, callee, rarray)
            return
        }

        const nargs = args.length
        const allocated = new Array(nargs)
        for (let i = 0; i < args.length; i++) allocated[i] = allocReg()
        for (let i = 0; i < args.length; i++) {
            emitExpr(args[i])
            star(allocated[i])
        }
        if (thisReg !== undefined) ldar(thisReg)
        else emit1(Op.LdaUndefined)
        emit4(Op[callOp], callee, saveNextReg, nargs)
    }

    function emitCallOrConstruct(node: ts.CallExpression | ts.NewExpression) {
        const isConstruct = node.kind === ts.SyntaxKind.NewExpression
        const isTailCall = node.parent.kind === ts.SyntaxKind.ReturnStatement
        // if (const slot = findConstPoolSlot(node.expression)) {
        //     return emitCallArgs(isConstruct ? 'ConstructConst' : 'CallConst', slot, node.arguments ?? [])
        // }

        if (!isConstruct && node.expression.kind === ts.SyntaxKind.SuperKeyword) return emitSuperCall(node as ts.CallExpression)
        if (!isConstruct && ts.isPropertyAccessExpression(node.expression)) {
            const method = privateMember(node.expression.name)?.method
            if (method) return emitPrivateCall(node as ts.CallExpression, method)
        }
        if (!isConstruct && (ts.isPropertyAccessExpression(node.expression) || ts.isElementAccessExpression(node.expression))) {
            let receiverReg = allocReg()
            const originalRecv = receiverReg
            defer if (originalRecv === receiverReg) freeReg()

            if (node.expression.expression.kind === ts.SyntaxKind.SuperKeyword) {
                emitSuperGet(node.expression)
                const rMethod = allocReg()
                defer freeReg()
                star(rMethod)
                emitThis()
                star(receiverReg)
                return emitCallArgs('Call', rMethod, node.arguments ?? [], receiverReg)
            }
            if (isReceiverIdent(node.expression.expression) && !argumentsMayWrite(node.expression.expression as ts.Identifier, node.arguments ?? [])) {
                freeReg()
                receiverReg = symToReg.get(getSymbolId(node.expression.expression))!
                emitPropertyAccess(node.expression, receiverReg, false)
            } else {
                emitPropertyAccess(node.expression, receiverReg) // acc = method, receiverReg = `o`
            }

            const rCallee = allocReg()
            defer freeReg()

            star(rCallee)

            return emitCallArgs('Call', rCallee, node.arguments ?? [], receiverReg)
        }

        emitExpr(node.expression) // callee -> acc
        const rCallee = allocReg()
        defer freeReg()

        star(rCallee)

        return emitCallArgs(isConstruct ? 'Construct' : 'Call', rCallee, node.arguments ?? [])
    }

    function bindingReg(symId: number): number {
        return capturedRegs.get(symId) ?? allocReg()
    }

    function bindPattern(name: ts.BindingName): void {
        if (ts.isIdentifier(name)) {
            symToReg.set(getSymbolId(name), bindingReg(getSymbolId(name)))
            return
        }
        for (const element of name.elements) {
            if (ts.isOmittedExpression(element)) continue
            if (element.dotDotDotToken && ts.isArrayBindingPattern(name)) throw 'array rest bindings are not supported'
            bindPattern(element.name)
        }
    }

    function assignPattern(name: ts.BindingName): void {
        if (ts.isIdentifier(name)) { star(symToReg.get(getSymbolId(name))!); return }
        const value = allocReg(); star(value)
        const excluded: string[] = []
        for (let i = 0; i < name.elements.length; i++) {
            const element = name.elements[i]
            if (ts.isOmittedExpression(element)) continue
            ldar(value)
            if (element.dotDotDotToken) {
                emit2(Op.CreateObjectRest, internObjectTemplate(excluded))
            } else if (ts.isArrayBindingPattern(name)) {
                emit2(Op.GetPropertyImm, i)
            } else {
                const key = element.propertyName ?? element.name
                if (!ts.isIdentifier(key) && !ts.isStringLiteral(key) && !ts.isNumericLiteral(key)) throw 'unsupported binding key'
                excluded.push(key.text)
                emit2(Op.GetPropertyConst, internString(key.text))
            }
            if (!element.initializer) {
                assignPattern(element.name)
                continue
            }
            const r = allocReg(); star(r)
            emitDefaultInit(element.initializer, r)
            ldar(r)
            assignPattern(element.name)
            freeReg()
        }
        freeReg()
    }

    function emitVariableDecl(decl: ts.VariableDeclaration, isConst = false) {
        if (!ts.isIdentifier(decl.name)) {
            bindPattern(decl.name)
            if (!decl.initializer) return
            emitExpr(decl.initializer)
            assignPattern(decl.name)
            return
        }
        const symId = getSymbolId(decl.name)
        if (symId === 0) throw "binding has no symbol id"
        if (isConst) {
            if (tryFoldVariableDecl(decl)) return
        }
        if (!isReferencedSymbol(decl.name)) {
            if (decl.initializer) emitSideEffect(decl.initializer)
            return
        }
        const reg = capturedRegs.get(symId) ?? allocReg()
        symToReg.set(symId, reg)
        if (decl.initializer) emitExpr(decl.initializer)
        else emit1(Op.LdaUndefined)
        star(reg)
    }

    function emitVariableStatement(node: ts.VariableStatement) {
        const isConst = !!ts.getModifiers(node)?.find(x => x.kind === ts.SyntaxKind.ConstKeyword)
        for (const decl of node.declarationList.declarations) {
            emitVariableDecl(decl, isConst)
        }
    }

    function emitSideEffect(n: ts.Node) {
        if (isDeadCode(n)) return
        if (ts.isExpressionStatement(n)) { emitExpr(n.expression); return }
        emitExpr(n as ts.Expression)
    }

    function emitBlock(node: ts.Block) {
        const savedReg = nextReg
        const hoisted = hoistFunctions(node.statements)
        for (const s of node.statements) if (!ts.isFunctionDeclaration(s)) emitStatement(s)
        for (const [slot, decl] of hoisted) constants[slot] = emitFunction(decl, closureCtx(decl))
        nextReg = savedReg
    }

    function emitConditionalExp(node: ts.ConditionalExpression) {
        emitExpr(node.condition)
        const overTrue = emitJumpPlaceholder(Op.JumpIfToBooleanFalse)
        emitExpr(node.whenTrue)
        const whenFalse = emitJumpPlaceholder(Op.Jump)
        patchJump(overTrue)
        emitExpr(node.whenFalse)
        patchJump(whenFalse)
    }

    function emitIf(node: ts.IfStatement) {
        const c = tryFoldExp(node.expression)
        if (c && c[0] === 'value') {
            if (c[1]) emitStatement(node.thenStatement)
            else if (node.elseStatement) emitStatement(node.elseStatement)
            return
        }

        emitExpr(node.expression)
        const overThen = emitJumpPlaceholder(Op.JumpIfToBooleanFalse)
        emitStatement(node.thenStatement)
        // TODO: we don't need this if the branches exit
        skipNextLookbehind = true
        if (node.elseStatement) {
            const overElse = emitJumpPlaceholder(Op.Jump)
            patchJump(overThen)
            emitStatement(node.elseStatement)
            patchJump(overElse)
            skipNextLookbehind = true
        } else {
            patchJump(overThen)
        }
    }

    function emitWhile(node: ts.WhileStatement) {
        const c = tryFoldExp(node.expression)
        if (c && c[0] === 'value' && !c[1]) return

        const saveLabels = labels
        defer labels = saveLabels
        const ctx = enterLabels(-1, true)
        skipNextLookbehind = true

        if (c && c[0] === 'value') {
            // unconditional
            const bodyTop = code.length
            ctx.continueTarget = bodyTop
            emitStatement(node.statement)
            emitJumpTo(Op.Jump, bodyTop)
        } else {
            const toTest = emitJumpPlaceholder(Op.Jump)
            const bodyTop = code.length
            emitStatement(node.statement)
            patchJump(toTest)
            for (const p of ctx.continues) patchJump(p) 
            skipNextLookbehind = true
            emitExpr(node.expression)
            emitJumpTo(Op.JumpIfToBooleanTrue, bodyTop)
        }

        for (const p of ctx.breaks) patchJump(p) 
    }

    function emitDo(node: ts.DoStatement) {
        const saveLabels = labels
        defer labels = saveLabels
        const ctx = enterLabels(-1, true)
        skipNextLookbehind = true

        const bodyTop = code.length
        emitStatement(node.statement)
        for (const p of ctx.continues) patchJump(p)
        skipNextLookbehind = true

        const c = tryFoldExp(node.expression)
        if (c && c[0] === 'value') {
            if (c[1]) emitJumpTo(Op.Jump, bodyTop)
        } else {
            emitExpr(node.expression)
            emitJumpTo(Op.JumpIfToBooleanTrue, bodyTop)
        }

        for (const p of ctx.breaks) patchJump(p)
    }

    function emitFor(node: ts.ForStatement) {
        const savedReg = nextReg
        defer nextReg = savedReg 

        if (node.initializer) {
            if (ts.isVariableDeclarationList(node.initializer)) {
                for (const decl of node.initializer.declarations) {
                    if (!ts.isIdentifier(decl.name)) {
                        emitVariableDecl(decl)
                        continue
                    }
                    const symId = getSymbolId(decl.name)
                    if (symId === 0) throw "binding has no symbol id"
                    const reg = bindingReg(symId)
                    symToReg.set(symId, reg)
                    if (decl.initializer) { emitExpr(decl.initializer); star(reg) }
                }
            } else {
                emitSideEffect(node.initializer)
            }
        }

        const c = node.condition ? tryFoldExp(node.condition) : undefined
        if (c && c[0] === 'value' && !c[1]) return // for (...; false; ...)
        const condAlwaysTrue = !node.condition || (c && c[0] === 'value')

        const saveLabels = labels
        defer labels = saveLabels
        const ctx = enterLabels(-1, true)
        skipNextLookbehind = true

        if (condAlwaysTrue) {
            const bodyTop = code.length
            emitStatement(node.statement)
            for (const p of ctx.continues) patchJump(p) // continue -> update
            if (node.incrementor) emitSideEffect(node.incrementor)
            emitJumpTo(Op.Jump, bodyTop)
        } else {
            const toTest = emitJumpPlaceholder(Op.Jump)
            const bodyTop = code.length
            emitStatement(node.statement)
            for (const p of ctx.continues) patchJump(p) // continue -> update
            if (node.incrementor) emitSideEffect(node.incrementor)
            patchJump(toTest)
            skipNextLookbehind = true
            emitExpr(node.condition!)
            emitJumpTo(Op.JumpIfToBooleanTrue, bodyTop)
        }

        for (const p of ctx.breaks) patchJump(p) // break -> after loop
    }

    function emitIteratorClose(scope: IteratorScope) {
        ldar(scope.open)
        const closed = emitJumpPlaceholder(Op.JumpIfToBooleanFalse)
        emit1(Op.LdaFalse)
        star(scope.open)
        ldar(scope.iterator)
        emit2(Op.GetPropertyConst, internString('return'))
        const missing = emitJumpPlaceholder(Op.JumpIfNullish)
        const method = allocReg()
        star(method)
        emitCallArgs('Call', method, [], scope.iterator)
        freeReg()
        patchJump(missing)
        patchJump(closed)
    }

    function emitForOf(node: ts.ForOfStatement) {
        if (node.awaitModifier) throw 'for await...of is not supported'
        const savedReg = nextReg
        const savedLabels = labels
        defer { nextReg = savedReg; labels = savedLabels }

        const { iterator, method } = emitOpenIterator(node.expression)
        const step = allocReg()
        const open = allocReg()
        const scope = { iterator, open }

        const binding = ts.isVariableDeclarationList(node.initializer) ? node.initializer.declarations[0].name : undefined
        if (binding) bindPattern(binding)

        skipNextLookbehind = true
        const top = code.length
        emit1(Op.LdaFalse); star(open)
        emitCallArgs('Call', method, [], iterator)
        star(step)
        emit2(Op.GetPropertyConst, internString('done'))
        const end = emitJumpPlaceholder(Op.JumpIfToBooleanTrue)
        ldar(step)
        emit2(Op.GetPropertyConst, internString('value'))
        star(step)
        emit1(Op.LdaTrue); star(open)
        const guard = openGuard()
        ldar(step)
        if (binding) assignPattern(binding)
        else if (ts.isIdentifier(node.initializer)) star(symToReg.get(getSymbolId(node.initializer))!)
        else throw 'for...of assignment target must be an identifier'

        const ctx = enterLabels(top, true)
        ctx.iterator = scope
        ctx.guard = guard
        emitStatement(node.statement)
        suspendGuard(guard)
        emitJumpTo(Op.Jump, top)

        handleGuard(guard)
        skipNextLookbehind = true
        const error = allocReg(); star(error)
        const closeRange: EhRange = { start: code.length, end: 0, handler: 0 }
        emitIteratorClose(scope)
        closeRange.end = code.length
        closeRange.handler = code.length
        ldar(error)
        emit1(Op.ReThrow)
        freeReg()
        getExtraLabels().eh.push(closeRange)
        patchJump(end)
        for (const at of ctx.breaks) patchJump(at)
    }

    function emitTryStatement(node: ts.TryStatement) {
        if (!node.finallyBlock) {
            emitTryCatch(node.tryBlock, node.catchClause!)
            return
        }
        const savedLabels = labels
        const ctx = enterGuarded()
        ctx.finallyBlock = node.finallyBlock
        if (node.catchClause) emitTryCatch(node.tryBlock, node.catchClause)
        else emitBlock(node.tryBlock)
        suspendGuard(ctx.guard!)
        labels = savedLabels
        emitBlock(node.finallyBlock)
        const done = emitJumpPlaceholder(Op.Jump)

        handleGuard(ctx.guard!)
        prevStoreOffset = -1
        skipNextLookbehind = true
        const error = allocReg(); star(error)
        emitBlock(node.finallyBlock)
        ldar(error)
        emit1(Op.ReThrow)
        freeReg()
        patchJump(done)
        skipNextLookbehind = true
    }

    function emitTryCatch(tryBlock: ts.Block, catchClause: ts.CatchClause) {
        const savedLabels = labels
        const ctx = enterGuarded()
        emitBlock(tryBlock)
        suspendGuard(ctx.guard!)
        labels = savedLabels
        const done = emitJumpPlaceholder(Op.Jump)

        handleGuard(ctx.guard!)
        prevStoreOffset = -1
        skipNextLookbehind = true
        const decl = catchClause.variableDeclaration
        if (decl && ts.isIdentifier(decl.name)) {
            const reg = bindingReg(getSymbolId(decl.name))
            symToReg.set(getSymbolId(decl.name), reg)
            star(reg)
        } else if (decl) {
            bindPattern(decl.name)
            assignPattern(decl.name)
        }
        emitBlock(catchClause.block)
        patchJump(done)
        skipNextLookbehind = true
    }

    function emitSwitch(node: ts.SwitchStatement) {
        const savedReg = nextReg
        defer nextReg = savedReg

        emitExpr(node.expression)
        const discriminant = allocReg()
        star(discriminant)

        const clauses = node.caseBlock.clauses
        const targets: number[][] = clauses.map(() => [])
        const defaults: number[] = []
        let defaultClause = -1
        const integers: { value: number, clause: number }[] = []
        let allIntegers = true
        for (let i = 0; i < clauses.length; i++) {
            const clause = clauses[i]
            if (ts.isDefaultClause(clause)) {
                if (defaultClause < 0) defaultClause = i
                continue
            }
            const folded = tryFoldExp(clause.expression)
            if (!folded || folded[0] !== 'value' || typeof folded[1] !== 'number'
                || !Number.isInteger(folded[1])) {
                allIntegers = false
                continue
            }
            integers.push({ value: folded[1], clause: i })
        }

        function jumpToDefault(): void {
            defaults.push(emitJumpPlaceholder(Op.Jump))
        }
        function match(value: number, clause: number): void {
            emitNumber(value)
            emit2(Op.TestStrictEqual, discriminant)
            targets[clause].push(emitJumpPlaceholder(Op.JumpIfToBooleanTrue))
        }

        const firstByValue = new Map<number, { value: number, clause: number }>()
        if (allIntegers) {
            for (const entry of integers) {
                if (!firstByValue.has(entry.value)) firstByValue.set(entry.value, entry)
            }
        }
        const unique = [...firstByValue.values()]

        if (allIntegers && unique.length) {
            unique.sort((a, b) => a.value - b.value)
            const min = unique[0].value
            const max = unique[unique.length - 1].value
            const span = max - min + 1
            const dense = unique.length >= 3 && span <= unique.length * 2
            if (dense) {
                if (min === 0) ldar(discriminant)
                else {
                    emitNumber(min)
                    const bias = allocReg(); star(bias)
                    ldar(discriminant)
                    emit2(Op.Sub, bias)
                    freeReg()
                }
                const index = allocReg(); star(index)
                emitNumber(span - 1)
                emit2(Op.TestLessThan, index)
                defaults.push(emitJumpPlaceholder(Op.JumpIfToBooleanTrue))
                emitNumber(jumpWidth + 2)
                const scale = allocReg(); star(scale)
                ldar(index)
                emit2(Op.Mul, scale)
                freeReg()
                freeReg()
                emit1(Op.JumpAcc)
                const byValue = new Map<number, number>()
                for (const entry of unique) byValue.set(entry.value, entry.clause)
                for (let value = min; value <= max; value++) {
                    const clause = byValue.get(value)
                    const at = emitJumpPlaceholder(Op.Jump)
                    if (clause === undefined) defaults.push(at)
                    else targets[clause].push(at)
                }
            } else {
                unique.sort((a, b) => (a.value >>> 0) - (b.value >>> 0))
                function tree(entries: typeof unique): void {
                    if (!entries.length) { jumpToDefault(); return }
                    const mid = entries.length >> 1
                    const pivot = entries[mid]
                    match(pivot.value, pivot.clause)
                    const left = entries.slice(0, mid)
                    const right = entries.slice(mid + 1)
                    if (!left.length) { tree(right); return }
                    if (!right.length) { tree(left); return }
                    emitNumber(pivot.value)
                    emit2(Op.TestGreaterThan, discriminant)
                    const toRight = emitJumpPlaceholder(Op.JumpIfToBooleanFalse)
                    tree(left)
                    patchJump(toRight)
                    tree(right)
                }
                tree(unique)
            }
        } else {
            for (let i = 0; i < clauses.length; i++) {
                const clause = clauses[i]
                if (ts.isDefaultClause(clause)) continue
                emitExpr(clause.expression)
                emit2(Op.TestStrictEqual, discriminant)
                targets[i].push(emitJumpPlaceholder(Op.JumpIfToBooleanTrue))
            }
            jumpToDefault()
        }

        const savedLabels = labels
        defer labels = savedLabels
        const ctx = enterLabels(-1, false)
        freeReg()
        for (let i = 0; i < clauses.length; i++) {
            for (const at of targets[i]) patchJump(at)
            if (i === defaultClause) for (const at of defaults) patchJump(at)
            skipNextLookbehind = true
            for (const statement of clauses[i].statements) emitStatement(statement)
        }
        if (defaultClause < 0) for (const at of defaults) patchJump(at)
        for (const at of ctx.breaks) patchJump(at)
    }

    function emitLabeled(node: ts.LabeledStatement) {
        const statement = node.statement
        pendingLabels.push(node.label.text)
        defer pendingLabels = []
        if (ts.isWhileStatement(statement) || ts.isDoStatement(statement) || ts.isForStatement(statement)
            || ts.isForOfStatement(statement) || ts.isSwitchStatement(statement) || ts.isLabeledStatement(statement)) {
            emitStatement(statement)
            return
        }
        const saveLabels = labels
        defer labels = saveLabels
        const ctx = enterLabels(-1, false)
        ctx.labeledOnly = true
        emitStatement(statement)
        for (const at of ctx.breaks) patchJump(at)
    }

    function emitStatement(node: ts.Statement) {
        if (isDeadCode(node)) return

        const saveCurrentNode = currentNode
        defer currentNode = saveCurrentNode
        currentNode = node
  
        if (ts.isReturnStatement(node)) {
            const cleanups = hasCleanup()
            if (!node.expression && !cleanups) {
                if (isConstructor) ldar(thisReg!)
                emit1(isConstructor ? Op.Return : Op.ReturnVoid)
                return
            }
            if (node.expression) emitExpr(node.expression)
            else if (isConstructor) ldar(thisReg!)
            else emit1(Op.LdaUndefined)
            if (!cleanups) {
                emit1(Op.Return)
                return
            }
            const value = allocReg(); star(value)
            const suspended = leaveScopes(undefined, true)
            ldar(value)
            freeReg()
            emit1(Op.Return)
            resumeGuards(suspended)
            return
        }
        if (ts.isExpressionStatement(node)) { emitExpr(node.expression); return }
        if (ts.isVariableStatement(node)) { emitVariableStatement(node); return }
        if (ts.isBlock(node)) { emitBlock(node); return }
        if (ts.isIfStatement(node)) { emitIf(node); return }
        if (ts.isWhileStatement(node)) { emitWhile(node); return }
        if (ts.isDoStatement(node)) { emitDo(node); return }
        if (ts.isForStatement(node)) { emitFor(node); return }
        if (ts.isForOfStatement(node)) { emitForOf(node); return }
        if (ts.isSwitchStatement(node)) { emitSwitch(node); return }
        if (ts.isLabeledStatement(node)) { emitLabeled(node); return }
        if (ts.isBreakStatement(node)) {
            emitBreak(node.label?.text); return
        } else if (ts.isContinueStatement(node)) {
            emitContinue(node.label?.text); return
        } else if (ts.isTryStatement(node)) {
            return void emitTryStatement(node)
        } else if (ts.isThrowStatement(node)) {
            emitExpr(node.expression)
            return void emit1(Op.Throw)
        }
        if (ts.isFunctionDeclaration(node)) {
            if (!node.name) throw 'nested function declaration has no name'
            const reg = bindingReg(getSymbolId(node.name))
            symToReg.set(getSymbolId(node.name), reg)
            emitClosure(node)
            star(reg)
            return
        }
        if (ts.isClassDeclaration(node)) {
            if (!node.name) throw 'class declaration has no name'
            const reg = bindingReg(getSymbolId(node.name))
            symToReg.set(getSymbolId(node.name), reg)
            emitClass(node)
            star(reg)
            return
        }
        if (node.kind === ts.SyntaxKind.EmptyStatement) return
        throw `unsupported statement: ${ts.SyntaxKind[node.kind]}`
    }

    function emitNested(nested: EmitResult): void {
        const slot = constants.length
        constants.push(nested)
        constantKinds.push(ConstantKind.nested_function)
        emit2(Op.CreateClosure, slot)
    }

    function emitClosure(node: ts.FunctionDeclaration | ts.MethodDeclaration | ts.ConstructorDeclaration | ts.ArrowFunction | ts.FunctionExpression): void {
        emitNested(emitFunction(node, closureCtx(node)))
    }

    function hoistFunctions(statements: readonly ts.Statement[]): [slot: number, decl: ts.FunctionDeclaration][] {
        const hoisted: [number, ts.FunctionDeclaration][] = []
        for (const s of statements) {
            if (!ts.isFunctionDeclaration(s) || !s.body) continue
            if (!s.name) throw 'nested function declaration has no name'
            const reg = bindingReg(getSymbolId(s.name))
            symToReg.set(getSymbolId(s.name), reg)
            const slot = constants.length
            constants.push(undefined)
            constantKinds.push(ConstantKind.nested_function)
            emit2(Op.CreateClosure, slot)
            star(reg)
            hoisted.push([slot, s])
        }
        return hoisted
    }

    function closureCtx(node: ts.FunctionDeclaration | ClassMember | ts.ArrowFunction | ts.FunctionExpression | ts.ClassDeclaration | ts.ClassExpression): EmitCtx {
        const childOuter = new Map<number, OuterSymbol>()
        for (const [sym, valueReg] of symToReg) childOuter.set(sym, { scopeSlot: -1, reg: valueReg })
        for (const [sym] of outerSymbols) {
            if (sym === thisSymbol || sym === homeSymbol) continue
            const scoped = scopedSymbol(sym)
            if (scoped) childOuter.set(sym, scoped)
        }
        if (ts.isArrowFunction(node)) {
            inheritBinding(childOuter, thisSymbol, thisReg)
            inheritBinding(childOuter, homeSymbol, homeReg)
            return { outerSymbols: childOuter, outerFolded: foldedVariables, privateNames, privateMembers, home: emitCtx.home }
        }
        return { outerSymbols: childOuter, outerFolded: foldedVariables, privateNames, privateMembers }
    }

    function inheritBinding(childOuter: Map<number, OuterSymbol>, sym: number, reg: number | undefined): void {
        if (reg !== undefined) childOuter.set(sym, { scopeSlot: -1, reg })
        else if (outerSymbols.has(sym)) childOuter.set(sym, scopedSymbol(sym)!)
    }

    function loadBinding(sym: number, reg: number | undefined): boolean {
        if (reg !== undefined) {
            ldar(reg)
            return true
        }
        const scoped = scopedSymbol(sym)
        if (!scoped) return false
        emit3(Op.LoadFrame, scoped.scopeSlot, scoped.reg)
        return true
    }

    function emitClass(node: ts.ClassDeclaration | ts.ClassExpression): void {
        const outerPrivateNames = privateNames
        const outerPrivateMembers = privateMembers
        privateNames = classPrivateNames(node, outerPrivateNames)
        privateMembers = classPrivateMembers(node, outerPrivateMembers)
        defer privateNames = outerPrivateNames
        defer privateMembers = outerPrivateMembers
        const heritage = heritageOf(node)
        if (!heritage) {
            emitNested(emitClassTemplate(node, (member, scope) => emitFunction(member, { ...closureCtx(member), ...scope })))
            return
        }
        const home = classHomes.get(node)
        if (home === undefined) throw 'class heritage outside of a function body'
        const cls = allocReg()
        const parent = allocReg()
        emitExpr(heritage)
        star(parent)
        emitNested(emitClassTemplate(node, (member, scope) => {
            const ctx = closureCtx(member)
            ctx.outerSymbols.set(homeSymbol, { scopeSlot: -1, reg: home })
            return emitFunction(member, { ...ctx, ...scope })
        }))
        star(home)
        star(cls)
        emitRuntimeCall(RtOp.classHeritage, cls, 2)
        freeReg()
        freeReg()
    }

    function emitThis(): void {
        if (!loadBinding(thisSymbol, thisReg)) throw "'this' is not bound here"
    }

    function emitHome(): void {
        if (emitCtx.home === undefined) throw "'super' is only supported in members of a derived class"
        if (!loadBinding(homeSymbol, homeReg)) throw "'super' is not bound in this member"
    }

    function emitSuperBase(): void {
        emitHome()
        if (emitCtx.home === HomeObject.prototype) emit2(Op.GetPropertyConst, internString('prototype'))
        emit1(Op.GetPrototype)
    }

    function emitSuperGet(node: ts.PropertyAccessExpression | ts.ElementAccessExpression): void {
        if (node.questionDotToken) throw `optional chaining is not supported`
        const receiver = allocReg()
        const key = allocReg()
        emitThis()
        star(receiver)
        if (ts.isPropertyAccessExpression(node)) emitLoadConst(internName(node.name))
        else emitExpr(node.argumentExpression)
        star(key)
        emitSuperBase()
        emit3(Op.GetSuperProperty, receiver, key)
        freeReg()
        freeReg()
    }

    function emitFieldInitializers(): void {
        for (const field of emitCtx.fields ?? []) {
            emitExpr(field.initializer!)
            const name = field.name
            let key: number
            if (ts.isIdentifier(name) || ts.isPrivateIdentifier(name)) key = internName(name)
            else if (ts.isStringLiteral(name) || ts.isNumericLiteral(name)) key = internString(name.text)
            else throw `unsupported class field name: ${name.getText()}`
            emit3(Op.SetPropertyConst, thisReg!, key)
        }
    }

    function emitSuperConstruct(call: (callee: number) => void): void {
        const callee = allocReg()
        emitHome()
        emit1(Op.GetPrototype)
        star(callee)
        call(callee)
        freeReg()
        emitFieldInitializers()
    }

    function emitSuperCall(node: ts.CallExpression): void {
        if (!isConstructor || thisReg === undefined) throw "'super(...)' is only supported directly in a constructor"
        const receiver = thisReg
        emitSuperConstruct(callee => emitCallArgs('Call', callee, node.arguments, receiver))
        ldar(receiver)
    }

    function emitDefaultInit(exp: ts.Expression, reg: number, effectOnly = false) {
        ldar(reg)
        const ph = emitJumpPlaceholder(Op.JumpIfNotUndefined)
        emitExpr(exp)
        if (!effectOnly) star(reg)
        patchJump(ph)
    }

    if (!body && !implicitConstructor) throw "function has no body"
    const declaredHere = new Set<number>()
    const referencedNested = new Set<number>()
    const constSymbols = new Set<number>()
    const derivedClasses: ts.Node[] = []
    function scanCaptures(node: ts.Node, nested: boolean): void {
        if (ts.isForOfStatement(node) || (ts.isTryStatement(node) && node.finallyBlock)) jumpWidth = 4
        const declared = ts.isVariableDeclaration(node) || ts.isBindingElement(node) || ts.isFunctionDeclaration(node) || ts.isClassDeclaration(node)
            ? node.name : undefined
        if (!nested && declared && ts.isIdentifier(declared)) {
            declaredHere.add(getSymbolId(declared))
            if (isConstSymbol(declared)) constSymbols.add(getSymbolId(declared))
        }
        if (nested && ts.isIdentifier(node)) referencedNested.add(getSymbolId(node))
        if (!nested && (ts.isClassDeclaration(node) || ts.isClassExpression(node)) && heritageOf(node)) derivedClasses.push(node)
        const inner = nested || ts.isFunctionLike(node) || ts.isPropertyDeclaration(node)
        ts.forEachChild(node, child => scanCaptures(child, child === declared ? nested : inner))
    }
    if (body) ts.forEachChild(body, child => scanCaptures(child, false))

    const paramRegs: number[] = []
    for (let i = 0; i < parameters.length; i++) {
        const p = parameters[i]
        if (p.dotDotDotToken && (i !== parameters.length - 1 || !ts.isIdentifier(p.name))) throw "rest parameters must be a trailing identifier"
        // we have to assign it even if unused
        const reg = allocReg()
        paramRegs.push(reg)
        if (ts.isIdentifier(p.name)) symToReg.set(getSymbolId(p.name), reg)
    }
    const argumentList = forwardsArguments ? allocReg() : undefined
    for (let i = 0; i < parameters.length; i++) {
        const p = parameters[i]
        if (!p.initializer) continue
        if (ts.isIdentifier(p.name) && !isReferencedSymbol(p.name)) {
            if (hasEffects(p.initializer)) emitDefaultInit(p.initializer, paramRegs[i], true)
            continue
        }
        emitDefaultInit(p.initializer, paramRegs[i])
    }
    // `freeReg` pops, so only a run of unused parameters at the end can be given back
    for (let i = parameters.length-1; i >= 0; i--) {
        const name = parameters[i].name
        if (!ts.isIdentifier(name) || isReferencedSymbol(name)) break
        freeReg()
    }
    for (let i = 0; i < parameters.length; i++) {
        const name = parameters[i].name
        if (ts.isIdentifier(name)) continue
        bindPattern(name)
        ldar(paramRegs[i])
        assignPattern(name)
    }

    const lexicalThis = ts.isArrowFunction(fn) && outerSymbols.has(thisSymbol)
    if (!lexicalThis && (usesThisBinding(fn) || ts.isMethodDeclaration(fn) || ts.isGetAccessorDeclaration(fn) || ts.isSetAccessorDeclaration(fn) || isConstructor)) {
        skipNextLookbehind = true
        thisReg = allocReg()
        star(thisReg)
    }

    let selfSlot: number | undefined
    if ((ts.isFunctionDeclaration(fn) || ts.isFunctionExpression(fn)) && fn.name && isReferencedSymbol(fn.name) && !outerSymbols.has(getSymbolId(fn.name))) {
        const slot = lateBoundSlot(getSymbolId(fn.name), (fn.name as ts.Identifier).text, ConstantKind.function_)
        selfSlot = slot
        const reg = allocReg()
        symToReg.set(getSymbolId(fn.name), reg)
        emitLoadConst(slot)
        star(reg)
    }

    const owner = emitCtx.owner
    if (owner && !outerSymbols.has(getSymbolId(owner))) {
        const reg = allocReg()
        symToReg.set(getSymbolId(owner), reg)
        emitLoadConst(lateBoundSlot(getSymbolId(owner), owner.text, ConstantKind.class_))
        star(reg)
    }

    if (emitCtx.home !== undefined && !outerSymbols.has(homeSymbol) && (implicitConstructor || usesSuper(fn))) {
        homeReg = allocReg()
        emitLoadConst(lateBoundSlot(homeSymbol, 'class', ConstantKind.class_))
        star(homeReg)
    }

    for (const sym of declaredHere) if (sym && referencedNested.has(sym)) capturedRegs.set(sym, allocReg())
    for (const node of derivedClasses) classHomes.set(node, allocReg())
    const readonlyCaptures: number[] = []
    for (const [sym, reg] of capturedRegs) {
        if (constSymbols.has(sym)) readonlyCaptures.push(reg)
    }
    if (isConstructor && !derivedConstructor) emitFieldInitializers()
    if (argumentList !== undefined) {
        emitSuperConstruct(callee => {
            ldar(thisReg!)
            emit3(Op.CallArray, callee, argumentList)
        })
    } else if (body && ts.isBlock(body)) {
        emitBlock(body)
    } else if (body) {
        emitExpr(body) // arrow fn
    }

    const closed = code.at(-1) === Op.Return || code.at(-1) === Op.ReturnVoid || code.at(-1) === Op.Throw || code.at(-1) === Op.ReThrow
    if (!closed || maxJumpTarget >= code.length) {
        if (isConstructor) ldar(thisReg!)
        emit1(body && !isConstructor && ts.isBlock(body) ? Op.ReturnVoid : Op.Return)
    }

    assert(constants.length === constantKinds.length)

    return {
        code,
        constants,
        constantKinds,
        paramCount: forwardsArguments ? 1 : parameters.length,
        defaults: parameters.some(p => p.initializer !== undefined),
        rest: forwardsArguments || parameters.some(p => p.dotDotDotToken !== undefined),
        registerCount: maxReg,
        lateBound,
        selfSlot,
        labels: extraLabels,
        scopeBindings,
        readonlyCaptures,
        sourceMapping,
        name: !implicitConstructor && fn.name && ts.isIdentifier(fn.name) ? fn.name.text : undefined,
    }
}

function unwrapParensOrExpStatement(node: ts.Node) {
    if (ts.isParenthesizedExpression(node) || ts.isExpressionStatement(node)) {
        return unwrapParensOrExpStatement(node.expression)
    }
    return node
}

// very hacky but good enough
const arrowFnPattern = /\w+\s*=>/
function computedKeyEnd(src: string): number {
    let depth = 0
    for (let i = 0; i < src.length; i++) {
        if (src[i] === '[') depth++
        else if (src[i] === ']' && --depth === 0) return i + 1
    }
    throw `unterminated computed key: ${src.slice(0, 40)}`
}

function fixupMethodLikeDecl(src: string) {
    src = src.trim()
    if (src.startsWith('export default ')) src = src.slice(15).trimStart()
    else if (src.startsWith('export ')) src = src.slice(7).trimStart()
    else if (src.startsWith('get ') || src.startsWith('set ')) src = src.slice(4)
    if (src.startsWith('function')) return src
    if (src.startsWith('(')) return src
    if (src.startsWith('[')) return `function ${src.slice(computedKeyEnd(src))}`
    if (src.startsWith('async')) return src // todo: async method fixup
    if (arrowFnPattern.test(src)) {
        const idx = src.indexOf('>')
        return `(${src.slice(0, idx-1)})=${src.slice(idx)}`
    }
    if (src.startsWith('class')) return src
    return `function ${src}`
}

type ClassMember = ts.ConstructorDeclaration | ts.MethodDeclaration | ts.GetAccessorDeclaration | ts.SetAccessorDeclaration
type ClassScope = Pick<EmitCtx, 'home' | 'fields'>
type MemberEmitter = (member: ClassMember | ts.ClassDeclaration | ts.ClassExpression, scope: ClassScope) => EmitResult

function emitClassTemplate(node: ts.ClassDeclaration | ts.ClassExpression, emitMember: MemberEmitter): EmitResult {
    const ctor = node.members.find(ts.isConstructorDeclaration)
    const derived = heritageOf(node) !== undefined
    const fields = initializedFields(node)
    const constructorScope: ClassScope = { home: derived ? HomeObject.prototype : undefined, fields }
    let result: EmitResult
    if (ctor) result = emitMember(ctor, constructorScope)
    else if (derived || fields.length) result = emitMember(node, constructorScope)
    else result = defaultConstructorResult()
    const prototype: Expandos = new Map()
    const expandos: Expandos = new Map()
    for (const member of node.members) {
        if (member === ctor || isFieldDeclaration(member)) continue
        if (isPrivateMember(member)) continue
        const target = isStaticMember(member) ? expandos : prototype
        const scope: ClassScope = { home: derived ? (isStaticMember(member) ? HomeObject.constructor : HomeObject.prototype) : undefined }
        if (ts.isGetAccessorDeclaration(member) || ts.isSetAccessorDeclaration(member)) {
            const key = classMemberName(member)
            const accessor = (target.get(key) ?? {}) as ClassAccessor
            if (ts.isGetAccessorDeclaration(member)) accessor.getter = emitMember(member, scope)
            else accessor.setter = emitMember(member, scope)
            target.set(key, accessor)
            continue
        }
        target.set(classMemberKey(member), emitMember(member as ts.MethodDeclaration, scope))
    }
    expandos.set('prototype', prototype)
    result.expandos = expandos
    return result
}

function emitClassDeclaration(node: ts.ClassDeclaration | ts.ClassExpression): EmitResult {
    const owner = node.name && isReferencedSymbol(node.name) ? node.name : undefined
    const privateNames = classPrivateNames(node, undefined)
    const privateMembers = classPrivateMembers(node)
    return emitClassTemplate(node, (member, scope) => emitFunction(member, { outerSymbols: new Map(), outerFolded: new Map(), owner, privateNames, privateMembers, ...scope }))
}

export function compile(src: string): EmitResult {
    const sf = ts.createSourceFile('input.js', fixupMethodLikeDecl(src), ts.ScriptTarget.Latest)
    defer finally {
        disposeSourceFile(sf)
    }
    const fn = sf.statements[0]
    if (!fn) throw "found no statements in source"
    const exp = unwrapParensOrExpStatement(fn)
    if (ts.isArrowFunction(exp) || ts.isFunctionExpression(exp)) {
        return emitFunction(exp)
    }
    if (ts.isClassDeclaration(exp) || ts.isClassExpression(exp)) {
        return emitClassDeclaration(exp)
    }
    if (!ts.isFunctionDeclaration(fn)) 
        throw "expected the source to be a single function declaration/expression"
    return emitFunction(fn)
}

export function operandWidth(value: number): 1 | 2 | 4 {
    if ((value >>> 0) !== value) throw `invalid bytecode operand: ${value}`
    if (value <= 0xFF) return 1
    if (value <= 0xFFFF) return 2
    return 4
}

export function pushOpcode(code: number[], op: number, width: number): void {
    if (width === 2) code.push(Op.Width2)
    if (width === 4) code.push(Op.Width4)
    code.push(op)
}

export function pushOperand(code: number[], value: number, width: number): void {
    for (let i = 0; i < width; i++) code.push((value >>> (8 * i)) & 0xFF)
}

const OpNames: Record<number, string> = {}
for (const [name, val] of Object.entries(Op)) OpNames[val as number] = name

const ImmOps = new Set([Op.LdaImm])
const ConstOps = new Set([Op.LdaConst, Op.GetPropertyConst, Op.SetPropertyConst, Op.CreateClosure, Op.CreateEmptyArray])
export const ConditionalJumpOps = new Set([Op.JumpIfNull, Op.JumpIfUndefined, Op.JumpIfNullish, Op.JumpIfNotUndefined, Op.JumpIfNotNull, Op.JumpIfNotNullish, Op.JumpIfToBooleanTrue, Op.JumpIfToBooleanFalse])
const JumpOps = new Set([Op.Jump, ...ConditionalJumpOps])

const RegOperandCounts: Record<number, number> = {
    [Op.Mov]: 2,
    [Op.Star]: 1,
    [Op.Ldar]: 1,
    [Op.Add]: 1, [Op.Sub]: 1, [Op.Mul]: 1, [Op.Div]: 1, [Op.Mod]: 1, [Op.Exp]: 1,
    [Op.BitOr]: 1, [Op.BitAnd]: 1, [Op.BitXor]: 1,
    [Op.ShiftLeft]: 1, [Op.ShiftRight]: 1, [Op.ShiftRightLogical]: 1,
    [Op.TestNotStrictEqual]: 1, [Op.TestStrictEqual]: 1,
    [Op.TestLessThan]: 1, [Op.TestGreaterThan]: 1,
    [Op.TestLessThanOrEqual]: 1, [Op.TestGreaterThanOrEqual]: 1,
    [Op.IncPost]: 1, [Op.DecPost]: 1,
    [Op.AddOrConcat]: 1, [Op.Concat]: 1,
    [Op.GetProperty]: 1,
    [Op.SetProperty]: 2,
    [Op.SetPropertyConst]: 1,
    [Op.SetPropertyImm]: 1,
    [Op.GetSuperProperty]: 2,
}

export type CodeInstruction = {
    pos: usize
    width: 1 | 2 | 4 | 8
    opcode: number
    opname: string
    regs: number[]          // register operands, in order
    imm?: number            // decoded value (sign-extended)
    constSlot?: number      // decoded constant pool slot,
    jumpOffset?: number     // decoded relative jump offset
    jumpTarget?: usize      // absolute byte offset the jump lands on
    jumpLabel?: number      // slots into the labeled jump table
    copyTo?: number
    frameReg?: number
    readsAcc?: boolean
    writesAcc?: boolean
}

export function createCodeIterator(bytes: readonly u8[]) {
    let cursor = 0

    function readByte(): number {
        const b = bytes[cursor]
        cursor = cursor + 1
        return b
    }
    function readSigned(width: 1 | 2 | 4 | 8): number {
        const shift = 32 - 8 * width
        return (readUnsigned(width) << shift) >> shift
    }
    function readUnsigned(width: 1 | 2 | 4 | 8): number {
        if (width === 8) throw "todo: 8 wide"
        let v = 0
        for (let i = 0; i < width; i++) v = v | (readByte() << (8 * i))
        return v >>> 0
    }

    function next(): CodeInstruction | undefined {
        if (cursor === bytes.length) return

        const pos = cursor as usize
        let width: 1 | 2 | 4 | 8 = 1
        let opcode = readByte()
        if (opcode === Op.Width2) { width = 2; opcode = readByte() }
        else if (opcode === Op.Width4) { width = 4; opcode = readByte() }
        else if (opcode === Op.Width8) { width = 8; opcode = readByte() }

        const inst: CodeInstruction = {
            pos,
            width,
            opcode,
            opname: OpNames[opcode] ?? `UNKNOWN(0x${opcode.toString(16)})`,
            regs: [],
        }

        if (opcode >= Op.Star0 && opcode <= Op.Star15) {
            inst.readsAcc = true
            inst.opname = 'Star'
            inst.regs.push(opcode - Op.Star0)
            return inst
        }
        if (opcode >= Op.Ldar0 && opcode <= Op.Ldar3) {
            inst.writesAcc = true
            inst.opname = 'Ldar'
            inst.regs.push(opcode - Op.Ldar0)
            return inst
        }
        if (opcode === Op.JumpLabel) {
            inst.jumpLabel = readUnsigned(width)
            return inst
        }
        if (opcode === Op.MovPacked) {
            inst.opname = 'Mov'
            const val = readUnsigned(width)
            inst.regs.push(val & 0xF, val >> 4) // dst, src
            return inst
        }
        if (opcode === Op.LoadFrame || opcode === Op.StoreFrame) {
            inst.readsAcc = opcode === Op.StoreFrame
            inst.writesAcc = opcode === Op.LoadFrame
            inst.constSlot = readUnsigned(width)
            inst.frameReg = readUnsigned(width)
            return inst
        }
        if (inst.opname.endsWith('Const')) {
            inst.opname = inst.opname.slice(0, -5)
        }
        if (inst.opname.startsWith('Lda') || inst.opname.startsWith('Create')) {
            inst.writesAcc = true
        }
        if (opcode >= Op.Add && opcode <= Op.ToNumber) {
            inst.readsAcc = inst.writesAcc = true
        }
        if (opcode === Op.Return || opcode === Op.Throw || opcode === Op.ReThrow) {
            inst.readsAcc = true
        }
        if (opcode === Op.JumpAcc) inst.readsAcc = true

        if (inst.opcode >= Op.GetProperty && inst.opcode <= Op.GetSuperProperty) {
            if (inst.opname.startsWith('Get')) {
                inst.readsAcc = inst.writesAcc = true
            } else {
                inst.readsAcc = true
            }
        }

        const regCount = RegOperandCounts[opcode]
        if (regCount !== undefined) {
            if (opcode === Op.Ldar) {
                inst.writesAcc = true
            }
            if (opcode === Op.Star) {
                inst.readsAcc = true
            }
            for (let i = 0; i < regCount; i++) inst.regs.push(readUnsigned(width))
            if (ConstOps.has(opcode)) {
                inst.constSlot = width === 8 ? undefined : readUnsigned(width as 1 | 2 | 4)
            }
            if (opcode === Op.SetPropertyImm) {
                inst.imm = width === 8 ? undefined : readUnsigned(width as 1 | 2 | 4)
            }
            return inst
        }

        if (opcode === Op.CreateObjectRest) {
            inst.readsAcc = inst.writesAcc = true
            inst.constSlot = readUnsigned(width)
            return inst
        }
        if (opcode === Op.GetPropertyImm) {
            inst.readsAcc = inst.writesAcc = true
            inst.imm = width === 8 ? undefined : readUnsigned(width as 1 | 2 | 4)
            return inst
        }

        if (ImmOps.has(opcode)) {
            inst.imm = width === 8 ? undefined : readSigned(width as 1 | 2 | 4)
            return inst
        }
        if (ConstOps.has(opcode)) {
            inst.constSlot = width === 8 ? undefined : readUnsigned(width as 1 | 2 | 4)
            return inst
        }
        if (JumpOps.has(opcode)) {
            if (opcode !== Op.Jump) inst.readsAcc = true
            const off = width === 8 ? undefined : readSigned(width as 1 | 2 | 4)
            inst.jumpOffset = off
            if (off !== undefined) inst.jumpTarget = (cursor + off) as usize
            return inst
        }

        if (opcode === Op.Call || opcode === Op.Construct) {
            inst.readsAcc = inst.writesAcc = true
            inst.regs.push(readUnsigned(width), readUnsigned(width)) // callee, argStart
            inst.regs.push(readUnsigned(width)) // nargs
            if (inst.regs[2] === 0) {
                inst.regs.length = 1
            } else {
                inst.regs[2] += inst.regs[1]-1
            }
            return inst
        }
        if (opcode === Op.CallArray) {
            inst.readsAcc = inst.writesAcc = true
            inst.regs.push(readUnsigned(width), readUnsigned(width)) // callee, array
            return inst
        }
        if (opcode === Op.CreateArrayLiteral) {
            inst.writesAcc = true
            inst.regs.push(readUnsigned(width), readUnsigned(width))
            inst.regs[1] += inst.regs[0] - 1
            return inst
        }
        if (opcode === Op.CreateObjectLiteral) {
            inst.writesAcc = true
            inst.constSlot = readUnsigned(width)
            inst.regs.push(readUnsigned(width), readUnsigned(width))
            inst.regs[1] += inst.regs[0] - 1
            return inst
        }
        if (opcode === Op.CallConst || opcode === Op.ConstructConst || opcode === Op.CallRuntime) {
            inst.readsAcc = inst.writesAcc = true
            if (opcode === Op.CallRuntime) inst.imm = readUnsigned(width)
            else inst.constSlot = readUnsigned(width)
            inst.regs.push(readUnsigned(width))
            inst.regs.push(readUnsigned(width))
            if (inst.regs[1] === 0) {
                inst.regs.length = 0
            } else {
                inst.regs[1] += inst.regs[0]-1
            }
            return inst
        }

        // no-operand ops
        return inst
    }

    return { next }
}

export interface FrameCaptures {
    reads: Set<number>
    writes: Set<number>
}

export function frameSize(captures: FrameCaptures): number {
    return Math.max(0, ...captures.reads, ...captures.writes) + 1
}

export function memberTemplates(template: EmitResult): EmitResult[] {
    const members: EmitResult[] = []
    function collect(expandos: Expandos): void {
        for (const value of expandos.values()) {
            if (value instanceof Map) {
                collect(value)
                continue
            }
            if ('code' in value) {
                members.push(value as EmitResult)
                continue
            }
            const accessor = value as ClassAccessor
            if (accessor.getter) members.push(accessor.getter)
            if (accessor.setter) members.push(accessor.setter)
        }
    }
    if (template.expandos) collect(template.expandos)
    return members
}

export function frameCaptures(result: EmitResult): FrameCaptures {
    const captures: FrameCaptures = { reads: new Set(), writes: new Set() }
    function visit(fn: EmitResult, frameSlots: Set<number>): void {
        for (let i = 0; i < fn.constants.length; i++) {
            if (fn.constantKinds[i] !== ConstantKind.nested_function) continue
            visitNested(fn.constants[i], frameSlots)
            for (const member of memberTemplates(fn.constants[i])) visitNested(member, frameSlots)
        }
    }
    function visitNested(nested: EmitResult, frameSlots: Set<number>): void {
        const slots = new Set<number>()
        for (const b of nested.scopeBindings) if (frameSlots.has(b.parentSlot)) slots.add(b.slot)
        if (!slots.size) return
        const it = createCodeIterator(nested.code as u8[])
        while (const inst = it.next()) {
            if (inst.opcode !== Op.LoadFrame && inst.opcode !== Op.StoreFrame) continue
            if (!slots.has(inst.constSlot!)) continue
            captures.reads.add(inst.frameReg!)
            if (inst.opcode === Op.StoreFrame) captures.writes.add(inst.frameReg!)
        }
        visit(nested, slots)
    }
    visit(result, new Set([-1]))
    return captures
}

// -1 is considered the acc
export function getRegReads(inst: CodeInstruction): number[] {
    if (inst.opcode >= Op.Ldar && inst.opcode <= Op.Ldar3) {
        return inst.regs.slice()
    }
    if (inst.opcode >= Op.Star && inst.opcode <= Op.Star15) {
        return [-1]
    }
    if (inst.opcode === Op.Mov || inst.opcode === Op.MovPacked) {
        return [inst.regs[1]]
    }
    let regs: number[] = []
    if (inst.readsAcc) regs.push(-1)
    if (inst.opcode >= Op.Add && inst.opcode <= Op.Concat) {
        regs.push(...inst.regs)
    }
    if (inst.opcode >= Op.GetProperty && inst.opcode <= Op.GetSuperProperty) {
        regs.push(...inst.regs)
    }
    if (inst.opcode === Op.CallArray) regs.push(...inst.regs)
    if (inst.opcode === Op.Call || inst.opcode === Op.Construct) {
        regs.push(inst.regs[0])
        if (inst.regs.length === 3) {
            for (let i = inst.regs[1]; i <= inst.regs[2]; i++) regs.push(i)
        }
    } else if (inst.opcode === Op.CallConst || inst.opcode === Op.ConstructConst || inst.opcode === Op.CallRuntime || inst.opcode === Op.CreateArrayLiteral || inst.opcode === Op.CreateObjectLiteral) {
        if (inst.regs.length) {
            for (let i = inst.regs[0]; i <= inst.regs[1]; i++) regs.push(i)
        }
    }
    return regs
}
export function getRegWrites(inst: CodeInstruction): number[] {
    if (inst.opcode >= Op.Star && inst.opcode <= Op.Star15) {
        return inst.regs.slice()
    }
    if (inst.opcode >= Op.Ldar && inst.opcode <= Op.Ldar3) {
        return [-1]
    }
    if (inst.opcode === Op.Mov || inst.opcode === Op.MovPacked) {
        return [inst.regs[0]]
    }
    let regs: number[] = []
    if (inst.writesAcc) regs.push(-1)
    if (inst.opcode >= Op.IncPost && inst.opcode <= Op.DecPost) {
        regs.push(...inst.regs)
    }
    return regs
}

export function isAlwaysLiteral(inst: CodeInstruction): boolean {
    return inst.opcode >= Op.LdaConst && inst.opcode <= Op.LdaFalse
}

export function sourcePosition(compiled: EmitResult, pc: number): { line: number; col: number } | undefined {
    let found = 0
    for (const [at, loc] of compiled.sourceMapping) {
        if (at > pc) break
        found = loc
    }
    if (!found) return undefined
    return getDecodedLocation(found)
}

export function disassemble(code: readonly u8[], paramCount?: number, maxRegs?: number, mappings?: EmitResult['sourceMapping']): string {
    const pcToEncodedLoc = new Map<number, number>(mappings)
    const it = createCodeIterator(code)
    const lines: string[] = []
    while (const inst = it.next()) {
        let line = `${String(inst.pos).padStart(4, ' ')}: ${inst.opname}`
        if (inst.width !== 1) line = line + ` (W${inst.width})`
        if (inst.constSlot !== undefined) line = line + ` [const:${inst.constSlot}]`
        for (const r of inst.regs) {
            if (maxRegs === undefined || paramCount === undefined) {
                line = line + ` r${r}`
                continue
            }
            const name = r < paramCount ? `p${r}` : r >= maxRegs ? `a${r-maxRegs}` : `r${r-paramCount}`
            line = line + ` ${name}`
        }
        if (inst.imm !== undefined) line = line + ` #${inst.imm}`
        if (inst.jumpTarget !== undefined) line = line + ` -> ${inst.jumpTarget} (${inst.jumpOffset! >= 0 ? '+' : ''}${inst.jumpOffset})`
        if (inst.jumpLabel !== undefined) line = line + ` -> [label:${inst.jumpLabel}]`
        if (const loc = pcToEncodedLoc.get(inst.pos)) {
            const lc = getDecodedLocation(loc)
            line = line.padEnd(32, ' ') + ` @ ${lc.line+1}:${lc.col+1}`
        }
        lines.push(line)
    }
    return lines.join('\n')
}

function testBytecodeEmit(str: string, name = 'f') {
    const r = compile(str)
    console.log(`${name}: code`, r.code, r.code.length)
    console.log(`${name}: constants`, r.constants, r.constantKinds)
    console.log(`${name}: lateBound`, r.lateBound, 'regs:', r.registerCount)
    console.log(`${name}: disasm\n${disassemble(r.code as u8[], r.paramCount, r.registerCount)}`)
}

function emitTest() {
    testBytecodeEmit('function add(a, b) { let c = a + b; return c * 2 }')

    testBytecodeEmit('function f(a) { return a + g + "hi" + (2 * 20) }')

    testBytecodeEmit('function f(a) { const x = 10*10; return x+x+a }', 'constReduce')
    
    testBytecodeEmit('function f(a) { if (a <= 1) return a; return f(a-1) }', 'recursive')
    testBytecodeEmit('function f(a) { return a <= 1 ? a : a+f(a-1) }', 'recursive2')

    testBytecodeEmit('function objectSpread(a, b) { return { x: 1, ...a, y: 2, ...b } }', 'objectSpread')

    testBytecodeEmit('class Error {\n  constructor(message) {\n    this.message = message;\n  }\n}', 'classDecl')

    function opcodesOf(source: string): number[] {
        const it = createCodeIterator(compile(source).code as u8[])
        const ops: number[] = []
        while (const inst = it.next()) ops.push(inst.opcode)
        return ops
    }
    const templated = opcodesOf('function f(a) { return { x: a, y: 2, m() { return 1 } } }')
    assert(templated.includes(Op.CreateObjectLiteral) && !templated.includes(Op.CreateEmptyObject), 'static keys create the object from a template')
    for (const source of ['function f(a) { return { x: a, x: 2 } }', 'function f(a) { return { __proto__: a } }', 'function f(a) { return { [a]: 1 } }', 'function f(a) { return { ...a } }', 'function f() { return {} }']) {
        assert(!opcodesOf(source).includes(Op.CreateObjectLiteral), `no template for ${source}`)
    }

    const statics = compile('class A {\n  static twice(x) { return x * 2 }\n  get() { return 1 }\n}')
    const prototype = statics.expandos?.get('prototype') as Expandos
    assert(statics.expandos?.has('twice') && prototype.has('get') && !prototype.has('twice'), 'static methods belong to the constructor')

    const disposable = ts.createSourceFile('dispose.js', 'function f(x) { const y = x; return y }', ts.ScriptTarget.Latest)
    const body = (disposable.statements[0] as ts.FunctionDeclaration).body!
    const declared = (body.statements[0] as ts.VariableStatement).declarationList.declarations[0].name
    assert(isConstSymbol(declared), 'binder state is readable before disposal')
    disposeSourceFile(disposable)
    disposeSourceFile(disposable)
    let stale = false
    try {
        declared.getText()
    } catch (e) {
        stale = true
    }
    assert(stale, 'disposed source files reject native access')
}

export function finalize(
    result: EmitResult,
    ctx?: Ctx,
    compileFn?: (f: Function) => Handle,
    convertValue?: (v: any) => Handle,
    owner?: Handle,
): Handle {
    const kinds = result.constantKinds
    const constants = new Array(kinds.length)
    const constantHandles = new Array(kinds.length)
    const fromJsValue = convertValue ?? heap.createJsValueConverter(compileFn ?? (f => compileJsFn(f, ctx!)))
    setRuntimeLinker(fromJsValue)
    for (let i = 0; i < result.constants.length; i++) {
        constantHandles[i] = true
        if (kinds[i] === ConstantKind.function_) {
            if (result.selfSlot !== i) throw `Missing fn const slot: ${i}`
            continue
        }
        if (kinds[i] === ConstantKind.class_) {
            if (owner !== undefined) constants[i] = owner
            continue
        }
        if (kinds[i] === ConstantKind.late_bound) {
            const name = result.constants[i]
            if (!ctx) throw `Cannot finalize late bound symbol without a ctx obj: ${name}`
            if (!(name in ctx)) throw `Failed to find symbol: ${name}`
            constants[i] = fromJsValue(ctx[name])
            continue
        }
        if (kinds[i] === ConstantKind.nested_function) {
            constants[i] = finalize(result.constants[i], ctx, compileFn, fromJsValue)
            continue
        }
        if (kinds[i] === ConstantKind.scope) {
            constants[i] = 0
            continue
        }
        if (kinds[i] === ConstantKind.object_template) {
            const template = heap.makeObject(0 as Handle)
            for (const key of result.constants[i] as string[]) heap.setProperty(template, fromJsValue(key), 0 as Handle)
            constants[i] = template
            continue
        }
        if (kinds[i] === ConstantKind.string || kinds[i] === ConstantKind.private_name || kinds[i] === ConstantKind.symbol) {
            constants[i] = fromJsValue(result.constants[i])
        } else {
            constants[i] = result.constants[i]
            constantHandles[i] = false
        }
    }
    const res = makeFunctionFromBytes(result.code, result.paramCount as u16, result.registerCount as u32, constants, constantHandles, true, false)
    if (result.rest) {
        const fn = heap.FunctionBytecode(heap.resolveHeapCell(res))
        fn.flags = fn.flags | heap.FunctionBytecodeFlags.has_rest_param
    }
    if (result.scopeBindings.length) {
        const fn = heap.FunctionBytecode(heap.resolveHeapCell(res))
        fn.scopeBindingsCount = result.scopeBindings.length as u32
        const bindings = heap.allocateHeapCell(fn.scopeBindingsCount * heap.ScopeBinding.sizeof)
        const bindingsPtr = heap.resolveHeapCell(bindings)
        fn.scopeBindings = bindings
        for (let i: u32 = 0; i < fn.scopeBindingsCount; i++) {
            const binding = heap.ScopeBinding(bindingsPtr + i * heap.ScopeBinding.sizeof)
            binding.slot = result.scopeBindings[i].slot as u32
            binding.parentSlot = result.scopeBindings[i].parentSlot as u32
        }
        heap.finishHeapCell(bindings)
    }
    if (result.selfSlot !== undefined) {
        const v = heap.FunctionBytecode(heap.resolveHeapCell(res))
        Intrinsics.store(heap.resolveHeapCell(v.constants), result.selfSlot*8 as u32, tagVmHandle(res), Types.u64)
    }
    if (result.labels !== undefined) {
        const ehArr = result.labels.eh
        const jumpArr = result.labels.jump

        const v = heap.FunctionBytecode(heap.resolveHeapCell(res))
        const labelsHandle = heap.allocateHeapCell(heap.FunctionBytecodeLabels.sizeof)
        v.labels = labelsHandle
        const labels = heap.FunctionBytecodeLabels(heap.resolveHeapCell(labelsHandle))

        labels.ehRangesCount = ehArr.length as u32
        labels.jumpLabelsCount = jumpArr.length as u32
        if (labels.ehRangesCount) {
            const ranges = heap.allocateHeapCell(labels.ehRangesCount * heap.CoveredRange.sizeof)
            labels.ehRanges = ranges
            const rangesPtr = heap.resolveHeapCell(ranges)
            for (let i: u32 = 0; i < ehArr.length; i++) {
                assert(ehArr[i].handler) // we assume we will never start on a handler
                assert(ehArr[i].end > ehArr[i].start)
                const range = heap.CoveredRange(rangesPtr + i * heap.CoveredRange.sizeof)
                range.start = ehArr[i].start as u32
                range.end = ehArr[i].end as u32
                range.handler = ehArr[i].handler as u32
            }
            heap.finishHeapCell(ranges)
        } else {
            labels.ehRanges = 0
        }
        if (labels.jumpLabelsCount) {
            const jumps = heap.allocateHeapCell(labels.jumpLabelsCount * 4)
            labels.jumpLabels = jumps
            const jumpsPtr = heap.resolveHeapCell(jumps)
            for (let i: u32 = 0; i < jumpArr.length; i++) {
                assert(jumpArr[i])
                Intrinsics.store(jumpsPtr, i * 4, jumpArr[i] as u32, Types.u32)
            }
            heap.finishHeapCell(jumps)
        } else {
            labels.jumpLabels = 0
        }
        heap.finishHeapCell(labelsHandle)
    }
    heap.finishHeapCell(res)
    if (!result.expandos) return res
    const fn = heap.makeFunction(res)
    const cls = owner ?? fn
    const v = heap.FunctionBytecode(heap.resolveHeapCell(res))
    for (let i = 0; i < kinds.length; i++) {
        if (kinds[i] !== ConstantKind.class_) continue
        Intrinsics.store(heap.resolveHeapCell(v.constants), i*8 as u32, tagVmHandle(cls), Types.u64)
    }
    for (const [key, value] of result.expandos) installExpando(fn, key, value, ctx, compileFn, fromJsValue, cls)
    return fn
}

function installExpando(
    obj: Handle,
    key: string | symbol,
    value: EmitResult | Expandos | ClassAccessor,
    ctx: Ctx | undefined,
    compileFn: ((f: Function) => Handle) | undefined,
    fromJsValue: (v: any) => Handle,
    owner: Handle,
): void {
    if (value instanceof Map || 'code' in value) {
        heap.setProperty(obj, fromJsValue(key), materializeExpando(value, ctx, compileFn, fromJsValue, owner))
        return
    }
    const getter = value.getter ? finalize(value.getter, ctx, compileFn, fromJsValue, owner) : 0 as Handle
    const setter = value.setter ? finalize(value.setter, ctx, compileFn, fromJsValue, owner) : 0 as Handle
    heap.setAccessorProperty(obj, fromJsValue(key), getter, setter)
}

function materializeExpando(
    value: EmitResult | Expandos,
    ctx: Ctx | undefined,
    compileFn: ((f: Function) => Handle) | undefined,
    fromJsValue: (v: any) => Handle,
    owner: Handle,
): Handle {
    if (!(value instanceof Map)) return finalize(value, ctx, compileFn, fromJsValue, owner)
    const obj = heap.makeObject(0 as Handle)
    for (const [key, nested] of value) installExpando(obj, key, nested, ctx, compileFn, fromJsValue, owner)
    return obj
}

const compiledSym = Symbol('compiled')
const convertedSym = Symbol('converted')
const substitutesSym = Symbol('substitutes')
const membersSym = Symbol('members')
interface Ctx {
    readonly [compiledSym]: Map<Function, any>
    readonly [convertedSym]: Map<object, Handle>
    readonly [substitutesSym]: Map<any, any>
    readonly [membersSym]: Map<Function, { compiled: EmitResult, captures: any[], owner: Function }>
    [key: string]: any
}
export function createCtx(o: Record<string, any> = {}): Ctx {
    return Object.assign({
        [compiledSym]: new Map(),
        [convertedSym]: new Map(),
        [substitutesSym]: new Map<any, any>([[intrinsics.Intrinsics, heap.createHeapHandle(hostIntrinsics)]]),
        [membersSym]: new Map(),
        Symbol: heap.symbolConstants,
        ...builtinGlobals,
    }, o) as any
}
const toComputation = Symbol.for('toComputation')
function computationOf(f: Function): [string, any[]] {
    const computation = (f as any)[toComputation]
    return computation ? computation() : [f.toString(), []]
}

function withCaptures(ctx: Ctx, captures: any[] | undefined): Ctx {
    if (!captures?.length) return ctx
    const scoped = Object.create(ctx)
    const substitutes = ctx[substitutesSym]
    for (let i = 0; i < captures.length; i++) {
        const capture = captures[i]
        scoped[`$${i}`] = substitutes.has(capture) ? substitutes.get(capture) : capture
    }
    return scoped
}

function compileComputation(f: Function): [EmitResult, any[]] {
    const [source, captures] = computationOf(f)
    return [compile(source), captures]
}

function bindMembers(ctx: Ctx, owner: Function, holder: any, expandos: Expandos, captures: any[]): void {
    const members = ctx[membersSym]
    for (const [name, value] of expandos) {
        const d = Object.getOwnPropertyDescriptor(holder, name)!
        if (value instanceof Map) {
            bindMembers(ctx, owner, d.value, value, captures)
        } else if ('code' in value) {
            members.set(d.value, { compiled: value as EmitResult, captures, owner })
        } else {
            if (value.getter) members.set(d.get!, { compiled: value.getter, captures, owner })
            if (value.setter) members.set(d.set!, { compiled: value.setter, captures, owner })
        }
    }
}

function hostHeritage(cls: Function, ctx: Ctx): Handle | undefined {
    const parent = Object.getPrototypeOf(cls)
    if (typeof parent !== 'function' || parent === Function.prototype) return
    return compileJsFn(parent, ctx)
}

export function compileJsFn(f: Function, ctx: Ctx): any {
    const compiledFns = ctx[compiledSym]
    if (const prev = compiledFns.get(f)) return prev
    const member = ctx[membersSym].get(f)
    const [compiled, captures] = member ? [member.compiled, member.captures] : compileComputation(f)
    if (compiled.expandos) bindMembers(ctx, f, f, compiled.expandos, captures)
    // for circularity. TODO: need to do something to fixup cycles. like allocating heap handle ahead of time
    compiledFns.set(f, compiled)
    const scoped = withCaptures(ctx, captures)
    const proto = (f as any).prototype
    if (proto === null || typeof proto !== 'object') {
        const fn = finalize(compiled, scoped, undefined, undefined, member && compileJsFn(member.owner, ctx))
        compiledFns.set(f, fn)
        return fn
    }
    const finalized = finalize(compiled, scoped)
    const fn = compiled.expandos ? finalized : heap.makeFunction(finalized)
    compiledFns.set(f, fn)
    const heritage = hostHeritage(f, ctx)
    if (heritage !== undefined) heap.setPrototypeOf(fn, heap.deref(heritage))
    heap.setProperty(fn, heap.prototypeKey, heap.convertJsValue({ compileFn: g => compileJsFn(g, ctx), seen: ctx[convertedSym] }, proto))
    return fn
}

function e2eTest(code: string | Function, _args: any[], thisArg: any = null, ctx: Ctx = createCtx()): any {
    const fromJsValue = (v: any) => heap.fromJsValue(v, f => compileJsFn(f, ctx))

    const source = code is string ? code : code.toString()
    const interpret = createInterpreter(true) // native mode
    const compiled = compile(source)
    const fn = finalize(compiled, ctx)
    const m = compiled.paramCount
    const framesize = Math.max(m, 1) * 4 as usize
    const sp = Intrinsics.sp()
    defer { 
        assert(sp === Intrinsics.sp())
        intrinsics.memsetByte(sp-framesize, framesize, 0)
    }
    const args = Intrinsics.stackalloc(framesize)
    defer Intrinsics.stackfree(framesize)
    const suppliedArgs = _args.slice(0, m)

    for (let i = 0; i < suppliedArgs.length; i++) {
        Intrinsics.store(args, 4*i as u32, tagVmHandle(fromJsValue(suppliedArgs[i])), Types.u32)
    }
    const compiledThisArg = fromJsValue(thisArg)
    const r = vmValue(interpret(fn, compiledThisArg, args, suppliedArgs.length as u32))

    const realResult = r & (2**32)-1 // TODO: the intrinsics should be truncating to `nt`
    function disasmIfBad(expected: any): void {
        const cond = realResult === expected
        if (!cond) {
            const x = disassemble(compiled.code as u8[])
            console.log(compiled.constants)
            console.log(`disasm:\n${x}`)
        }
        assert(cond)
    }
    if (compiled.constantKinds.some(x => x === ConstantKind.late_bound)) {
        const indices = compiled.constantKinds.map((x, i) => x === ConstantKind.late_bound ? i : -1).filter(x => x !== -1)
        const paramNames = indices.map(x => compiled.constants[x])
        const paramValues = paramNames.map(x => ctx[x])
        const f = (new Function(...paramNames, 'return ' + code))(...paramValues)
        const expectedResult = f.apply(thisArg, _args) || 0
        console.log(f.name, '(...) =', expectedResult, 'actual=', realResult)
        disasmIfBad(expectedResult)
    } else {
        const f = code is string ? (new Function('return ' + code))() : code
        const expectedResult = f.apply(thisArg, _args) || 0
        console.log(f.name, '(...) =', expectedResult, 'actual=', realResult)
        disasmIfBad(expectedResult)
    }
    
    return realResult
}

function e2eTestPrint(...args: Parameters<typeof e2eTest>) {
    assert(args[0] is string)
    testBytecodeEmit(args[0])
    return e2eTest(...args)
}

function runTest() {
    const r = e2eTest('function add(a, b) { let c = a + b; return c * 2 }', [2, 3])
    intrinsics.assert(r === 10) // (2 + 3) * 2
    console.log("compiled add(2, 3) =", r)

    const r2 = e2eTest('function g(x) { return x * 10 + (3 - 1) }', [4])
    intrinsics.assert(r2 === 42) // 4 * 10 + 2
    console.log("compiled g(4) =", r2)

    let bigSrc = 'function big() {'
    for (let v = 200; v <= 500; v++) bigSrc = bigSrc + ' ' + v + ';'
    bigSrc = bigSrc + ' return 456 }'
    const r3 = e2eTest(bigSrc, [])
    intrinsics.assert(r3 === 456)
    console.log("compiled big() =", r3, "(via Width2 LdaConst, 301 constants)")

    const r4 = e2eTest('function useThis(a) { return this + a }', [2], 40)
    intrinsics.assert(r4 === 42) // this(40) + a(2)
    console.log("compiled useThis(2) with this=40 =", r4)

    const ifSrc = 'function f(x) { if (x > 5) { return 100 } return 0 }'
    const runIf = (x: number) => e2eTest(ifSrc, [x])
    intrinsics.assert(runIf(10) === 100)
    intrinsics.assert(runIf(3) === 0)
    console.log("compiled if: f(10)=", runIf(10), " f(3)=", runIf(3))

    // constant-folded condition: only the taken branch is emitted
    intrinsics.assert(e2eTest('function h() { if (true) { return 7 } return 8 }', []) === 7)
    console.log("compiled const-if h() = 7")

    // while (loop rotation + conditional jump-back)
    const whileSrc = 'function w(x) { while (x > 5) { return 1 } return 0 }'
    const runW = (x: number) => e2eTest(whileSrc, [x])
    intrinsics.assert(runW(10) === 1)
    intrinsics.assert(runW(3) === 0)
    console.log("compiled while: w(10)=", runW(10), " w(3)=", runW(3))

    // assignment + a iterating while loop
    const sumToSrc = 'function sumTo(n) { let acc = 0; let i = 0; while (i < n) { acc = acc + i; i = i + 1 } return acc }'
    const runSum = (n: number) => e2eTest(sumToSrc, [n])
    intrinsics.assert(runSum(5) === 10)  // 0+1+2+3+4
    intrinsics.assert(runSum(100) === 4950)
    console.log("compiled sumTo(5)=", runSum(5), " sumTo(100)=", runSum(100))

    e2eTest(function doOnce(n: number) {
        let count = 0
        do { count++ } while (n > 0 && --n > 0)
        return count
    }, [0])
    e2eTest(function doContinueBreak(n: number) {
        let sum = 0
        let i = 0
        do {
            i++
            if (i < 3) continue
            sum += i
            if (sum > 20) break
        } while (i < n)
        return sum
    }, [20])

    e2eTest(function loopEntryAccumulator(current: number, end: number, target: number) {
        let count = 0
        let projected = target
        while (current !== end) {
            count++
            current = end
        }
        return count + projected - target
    }, [2, 3, 3])

    const typeOfResult = e2eTest(function typeOfValues(n: number) {
        function f() { return 1 }
        let r = 0
        if (typeof n === 'number') r += 1
        if (typeof 'a' === 'string') r += 2
        if (typeof undefined === 'undefined') r += 4
        if (typeof f === 'function') r += 8
        if (typeof {} === 'object') r += 16
        return r
    }, [3])
    intrinsics.assert(typeOfResult === 31)

    const oddballResult = e2eTest(function oddballValues(n: number) {
        const u = n > 100 ? 1 : undefined
        const z = n > 100 ? 1 : null
        let r = 0
        if (!u) r += 1
        if (!z) r += 2
        if (u === undefined) r += 4
        if (z === null) r += 8
        if (u !== null) r += 16
        if (z !== undefined) r += 32
        if ((u ?? 7) === 7) r += 64
        if ((z ?? 7) === 7) r += 128
        if (!'') r += 256
        if (typeof z === 'object') r += 512
        return r
    }, [3])
    intrinsics.assert(oddballResult === 1023)

    const voidResult = e2eTest(function voidValues(n: number) {
        let calls = 0
        function g() {
            calls++
            return 5
        }
        function h() {
            return void g()
        }
        const u = n > 100 ? n : undefined
        let x: number | undefined = n
        x = void 0
        let r = 0
        if (void 0 === undefined) r += 1
        if (void n === undefined) r += 2
        if (void g() === undefined) r += 4
        if (calls === 1) r += 8
        if ((u ?? void 0) === undefined) r += 16
        if (x === undefined) r += 32
        if (typeof void 0 === 'undefined') r += 64
        if (typeof void n === 'undefined') r += 128
        if (h() === undefined) r += 256
        if (calls === 2) r += 512
        void g()
        return r + calls * 1024
    }, [3])
    intrinsics.assert(voidResult === 4095)

    // compound assignment
    const compSrc = 'function f(x) { x += 10; x *= 2; return x }'
    const runComp = (x: number) => e2eTest(compSrc, [x])
    intrinsics.assert(runComp(5) === 30) // (5 + 10) * 2
    console.log("compiled compound f(5) =", runComp(5))

    // for loop
    const forSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { s += i } return s }'
    intrinsics.assert(e2eTest(forSrc, [5]) === 10)   // 0+1+2+3+4
    intrinsics.assert(e2eTest(forSrc, [10]) === 45)
    console.log("compiled for: f(5)=", e2eTest(forSrc, [5]), " f(10)=", e2eTest(forSrc, [10]))

    const brkSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { if (i === 3) { break } s += i } return s }'
    intrinsics.assert(e2eTest(brkSrc, [100]) === 3) // 0+1+2, break at 3
    console.log("compiled break: f(100)=", e2eTest(brkSrc, [100]))

    const contSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { if (i % 2 === 1) { continue } s += i } return s }'
    intrinsics.assert(e2eTest(contSrc, [10]) === 20) // 0+2+4+6+8
    console.log("compiled continue: f(10)=", e2eTest(contSrc, [10]))

    const nestSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { let j = 0; while (true) { if (j >= i) { break } s += 1; j += 1 } } return s }'
    console.log("compiled nested: f(5)=", e2eTest(nestSrc, [5]))
    intrinsics.assert(e2eTest(nestSrc, [5]) === 10)

    function opcodes(src: string): number[] {
        const it = createCodeIterator(compile(src).code as u8[])
        const out: number[] = []
        while (const inst = it.next()) out.push(inst.opcode)
        return out
    }

    const denseSwitch = `function denseSwitch(x) {
        let y = 0
        switch (x) {
            case 10: y = 100; break
            case 11: y = 110
            case 12: y += 2; break
            case 14: return 140
            default: y = 9
        }
        return y
    }`
    assert(opcodes(denseSwitch).includes(Op.JumpAcc))
    e2eTest(denseSwitch, [10])
    e2eTest(denseSwitch, [11])
    e2eTest(denseSwitch, [12])
    e2eTest(denseSwitch, [13])
    e2eTest(denseSwitch, [14])

    const sparseSwitch = `function sparseSwitch(x) {
        switch (x) {
            case 1: return 10
            case 100: return 20
            case 10000: return 30
            case 100000: return 40
            default: return 50
        }
    }`
    const sparseOps = opcodes(sparseSwitch)
    assert(!sparseOps.includes(Op.JumpAcc))
    assert(sparseOps.includes(Op.TestGreaterThan))
    e2eTest(sparseSwitch, [1])
    e2eTest(sparseSwitch, [10000])
    e2eTest(sparseSwitch, [99])

    const generalSwitch = `function generalSwitch(x, a, b) {
        switch (x) {
            case a: return 10
            default: return 30
            case b: return 20
        }
    }`
    const generalOps = opcodes(generalSwitch)
    assert(!generalOps.includes(Op.JumpAcc))
    assert(!generalOps.includes(Op.TestGreaterThan))
    e2eTest(generalSwitch, [7, 7, 8])
    e2eTest(generalSwitch, [8, 7, 8])
    e2eTest(generalSwitch, [9, 7, 8])
    e2eTest(
        'function apply(f, x) { return f(x) }', 
        [function addOne(x: number) { return x + 1 }, 5]
    )

    e2eTest(
        'function call2(f, a, b) { return f(a, b) }', 
        [function add2(x: number, y: number) { return x + y }, 20, 22]
    )

    assert(e2eTest('function f(a) { return a <= 1 ? a : a+f(a-1) }', [10]) === 55)
    assert(e2eTest('function f(a) { return a >= 10 ? a : a+f(a+1) }', [1]) === 55)

    // unused param
    testBytecodeEmit('function f(a,b) { const x = a++; const y = a; return y+a }', 'unused_param')
    assert(e2eTest('function f(a,b) { const x = a++; const y = a; return y+a  }', [1]) === 4)

    // unused var with side effects
    testBytecodeEmit('function f(a) { const x = a++; return a }', 'unused')
    assert(e2eTest('function f(a) { const x = a++; return a }', [1]) === 2)

    // logical ops
    e2eTest('function f(a, b) { return a || b }', [0, 5])
    e2eTest('function f(a, b) { return a || b }', [3, 5])
    e2eTest('function f(a, b) { return a && b }', [0, 5])
    e2eTest('function f(a, b) { return a && b }', [3, 5])
    e2eTest('function f(a, b) { return a ?? b }', [3, 5])
    e2eTestPrint('function shortCircuitRecv(o, a, b) { return o.m(a && b) }', [{ m: (x: number) => x + 1 }, 0, 5])
    e2eTest('function shortCircuitRecv(o, a, b) { return o.m(a && b) }', [{ m: (x: number) => x + 1 }, 3, 5])
    e2eTest('function f(a, b, c) { return (a || b) && c }', [0, 3, 5])

    // late bound
    e2eTest('function late() { return a }', [], null, createCtx({ a: 1 }))

    // property assignment
    e2eTest('function assign(o, y) { return o.x = y }', [{}, 3])
    e2eTest('function assign2(o, y) { return o["x"] = y }', [{}, 3]) // element access
    e2eTest('function assign3(o, y) { return o["x"] += y }', [{ x: 0 }, 3]) // element access
    e2eTest('function assign4(o, y) { return o["x"+"y"] += y }', [{ xy: 1 }, 3]) // element access

    // property read
    e2eTest('function read(o) { return o.x }', [{ x: 5 }])

    // optional chains
    e2eTest('function optionalProperty(o) { return o?.x || 7 }', [{ x: 5 }])
    e2eTest('function optionalProperty(o) { return o?.x || 7 }', [undefined])
    e2eTest('function optionalNested(o) { return o?.inner.x || 7 }', [{ inner: { x: 5 } }])
    e2eTest('function optionalNested(o) { return o?.inner.x || 7 }', [undefined])
    e2eTest('function optionalElement(o) { let i = 0; const x = o?.[(i++, "x")]; return i * 10 + (x || 0) }', [{ x: 5 }])
    e2eTest('function optionalElement(o) { let i = 0; const x = o?.[(i++, "x")]; return i * 10 + (x || 0) }', [undefined])
    e2eTest('function optionalCall(f, a) { return f?.(a) || 7 }', [(a: number) => a + 1, 4])
    e2eTest('function optionalCall(f, a) { return f?.(a) || 7 }', [undefined, 4])
    e2eTest('function optionalCallArgs(f) { let i = 0; f?.(i++); return i }', [() => 0])
    e2eTest('function optionalCallArgs(f) { let i = 0; f?.(i++); return i }', [undefined])
    e2eTest('function optionalMethod(o) { return o?.m() || 7 }', [{ x: 5, m() { return this.x } }])
    e2eTest('function optionalMethod(o) { return o?.m() || 7 }', [undefined])
    e2eTest('function optionalMethodCall(o) { return o.m?.() || 7 }', [{ x: 5, m() { return this.x } }])
    e2eTest('function optionalMethodCall(o) { return o.m?.() || 7 }', [{}])

    // read after write
    e2eTest('function assignThenRead(o, y) { o.x = y; return o.x }', [{}, 7])

    e2eTest('function arrayLiteral(a, b) { const x = [a, b]; return x[0] + x[1] + x.length }', [4, 7])
    e2eTest('function arrayStore(a) { const x = [1, 2]; x[1] = a; return x[1] }', [9])
    e2eTest('function nestedCapture(a) { let x = 2; function add(b) { x = x + b; return x + a } return add(3) }', [7])
    e2eTest('function capturedPostfix() { let n = 5; function take() { const i = n++; return i } const a = take(); return a * 10 + n }', [])
    e2eTest('function capturedPrefix() { let n = 5; function take() { return ++n } const a = take(); return a * 10 + n }', [])
    e2eTest('function capturedDecrement() { let n = 5; function take() { return n-- } const a = take(); return a * 10 + n }', [])
    e2eTest('function assignedReceiver() { let x = { v: 1, m: function (a, b) { return this.v * 10 + b } }; const y = { v: 2, m: x.m }; return x.m(x = y, 3) }', [])
    e2eTest('function updatedReceiver() { let x = { v: 7, m: function (a) { return this.v } }; return x.m(x++) }', [])
    e2eTest('function nestedReceiver() { let x = { v: 1, m: function (a) { return this.v * 10 + a } }; const y = { v: 2, m: x.m }; return x.m((x = y).v) }', [])
    e2eTest('function constReceiver() { const x = { v: 4, m: function (a) { return this.v + a } }; return x.m(5) }', [])
    e2eTest('function capturedReceiver() { let x = { v: 1, m: function () { return this.v } }; function swap() { x = { v: 2, m: x.m }; return 0 } return x.m(swap()) }', [])
    e2eTest('function arrowCapture(a) { const add = (x) => x + a; return add(2) }', [5])
    e2eTest('function arrowBlock(a) { let s = 0; const bump = (x) => { s = s + x + a }; bump(1); bump(2); return s }', [1])
    e2eTest('function fnExpression(a) { const f = function(x) { return x * a }; return f(3) }', [4])
    e2eTest('function nestedArrow(a) { const outer = (x) => { const inner = (y) => x + y + a; return inner(1) }; return outer(2) }', [3])
    e2eTest('function objectMethod(a) { const o = { get() { return a }, add: function(x) { return x + a } }; return o.get() + o.add(1) }', [2])
    e2eTest('function arrowThis() { const f = () => this.x; return f() }', [], { x: 7 })
    e2eTest('function hoistedCall() { return later(3); function later(x) { return x + 1 } }', [])
    e2eTest('function hoistedCapture(a) { const f = (x) => g(x) + 1; function g(y) { return y * a } return f(2) }', [5])
    e2eTest('function hoistedLaterConst(a) { function g() { return k + a } const k = a * 2; return g() }', [5])
    e2eTest('function recursiveCapture(a) { function sum(k) { return k ? a + sum(k - 1) : 0 } return sum(3) }', [5])
    e2eTest('function spreadOnly(o) { const x = [...o]; return x[0] + x[1] * 10 + x[2] * 100 + x[3] * 1000 + x.length * 10000 }', [iterable()])
    e2eTest('function spreadMiddle(o, a) { const x = [a, ...o, a + 1]; return x[0] + x[2] * 10 + x[5] * 100 + x.length * 1000 }', [iterable(), 7])
    e2eTest('function spreadTwice(o) { const x = [...o, ...o]; return x[3] + x[4] * 10 + x[7] * 100 + x.length * 1000 }', [iterable()])
    e2eTest('function foldedCapture(a) { const k = 3; function g() { return k + a } return g() }', [5])
    e2eTest('function foldedArrow(a) { const k = 3; const f = () => k * a; return f() }', [5])
    e2eTest('function foldedNested(a) { const k = 3; const j = k * 2; function g() { function h() { return j + k + a } return h() } return g() }', [5])
    e2eTest('function defaultThenPlain(a = 1, b) { return a * 10 + (b ?? 7) }', [])
    e2eTest('function logicalLocal(a) { let x; x ??= a; x ||= 9; x &&= x + 1; return x }', [5])
    e2eTest('function logicalFalsy(a) { let x = 0; x ||= a; let y = 0; y &&= a; return x * 10 + y }', [5])
    e2eTest('function logicalScoped(a) { let x; function set() { x ??= a } set(); set(); return x }', [5])
    e2eTest('function logicalProperty(o, a) { o.x ??= a; o.y ??= a; return o.x * 10 + o.y }', [{ x: 3 }, 5])
    e2eTest('function logicalValue(a) { let x; const v = (x ??= a); const w = (x ??= 9); return v * 10 + w }', [5])
    function counted(n: number) {
        const o: any = iterable()
        o.limit = n
        o.next = function next(this: { index: number, limit: number }) {
            const value = this.index
            this.index = value + 1
            return { value: value + 1, done: value >= this.limit }
        }
        return o
    }
    e2eTest('function spreadCall(two, one, a) { function f(x, y, z, w) { return x + y * 10 + z * 100 + w * 1000 } return f(...two, a, ...one) }', [counted(2), counted(1), 5])
    e2eTest('function spreadMethod(o, two) { return o.add(...two) }', [{ base: 10, add(x: number, y: number) { return (this as any).base + x + y } }, counted(2)])
    e2eTest('function spreadIterable(o) { function f(a, b, c, d) { return a + b * 10 + c * 100 + d * 1000 } return f(...o) }', [iterable()])
    e2eTest('function restParams(a) { function f(x, ...ys) { let s = x; for (const y of ys) s = s + y; return s * 10 + ys.length } return f(a) + f(a, 1, 2) * 1000 + f(...[a, 4]) * 100000 }', [3])
    e2eTest('function restThis(a) { const o = { b: 10, f(x, ...ys) { return this.b + x * 100 + ys.length * 1000 + (ys.length ? ys[1] : 0) } }; return o.f(a, 2, 7) + o.f(a) * 10000 }', [3])
    e2eTest('function objectRest(a) { const { x, ...rest } = { x: a, y: 2, z: 3 }; return x + rest.y + rest.z }', [3])
    e2eTest('function objectRestRename(a) { const { x: first, ...rest } = { x: a, y: a + 1 }; return first * 10 + rest.y }', [4])
    e2eTest('function objectRestEmpty(a) { const { x, ...rest } = { x: a }; return x + (rest.x === undefined ? 1 : 0) }', [3])
    e2eTest('function objectRestNumeric(a) { const { 0: x, ...rest } = { 0: a, y: a + 1 }; return x + rest.y + (rest[0] === undefined ? 10 : 0) }', [3])
    e2eTest('function destructureParam(o) { function f([a, b], c) { return a + b * 10 + c * 100 } return f(o, 3) }', [[1, 2]])
    e2eTest('function destructureSkip(o) { const g = ([, id]) => id; return g(o) * 2 }', [[4, 9]])
    e2eTest('function destructureParamDefault() { function f([a, b] = [5, 6]) { return a * 10 + b } return f() }', [])
    e2eTest('function unaryPlus(a) { return +(a > 3) + +a }', [5])
    e2eTest('function arrayIterate() { let s = 0; for (const x of [1, 2, 3]) s += x; return s }', [])
    e2eTest('function arraySpreadReal(a) { const x = [a, 2]; const y = [...x, ...x]; return y.length * 100 + y[2] * 10 + y[3] }', [5])
    e2eTest('function arrayPush() { const x = []; x.push(4); x.push(5); return x.length * 10 + x[1] }', [])
    e2eTest('function arrayPushMany() { const x = [1]; x.push(4, 5); x.push(); return x.length * 100 + x[1] * 10 + x[2] }', [])
    e2eTest('function arraySpreadCall(a) { function f(x, y, z, w) { return x + y * 10 + z * 100 + w * 1000 } return f(...[1, 2], a, ...[3]) }', [5])
    e2eTest('function elementKeyExpression(n) { const a = [5, 6, 7]; return a[n - 1] }', [3])
    e2eTest('function arrayIndexLoop(o) { const x = [7, 8, 9]; let s = 0; for (let i = 0; i < x.length; i++) s = s * 10 + x[i]; return s }', [0])
    e2eTest('function mapBasics() { const m = new Map(); m.set(1, 10); m.set(2, 20); m.set(1, 30); return m.get(1) + m.get(2) + m.size * 1000 + (m.has(3) ? 100 : 0) }', [])
    e2eTest('function sharedFrame() { let n = 1; function bump() { n = n * 3 } function read() { return n } bump(); n = n + 1; return read() }', [])
    try {
        e2eTest('function outlived() { function make() { let n = 5; function get() { return n } return get } const g = make(); return g() }', [])
        throw 'vm: outlived closure was expected to throw'
    } catch (e) {
        if (!String(e).includes('outlived its frame')) throw e
        console.log('outlived closure refused ok')
    }
    e2eTest('function propertyPostfix(o) { const a = o.x++; return a * 10 + o.x }', [{ x: 3 }])
    e2eTest('function propertyPrefix(o) { const a = ++o.x; return a * 10 + o.x }', [{ x: 3 }])
    e2eTest('function elementPostfix(o, k) { const a = o[k]++; return a * 10 + o[k] }', [{ x: 3 }, 'x'])
    e2eTest('function indexPostfix(a) { const b = a[0]++; return b * 10 + a[0] }', [[7]])

    // FIXME: these fail in vm due to `length` producing 0
    // e2eTest('function noExpTemplate() { return `aaa`.length }', [[]])
    // e2eTest('function regExpLiteral() { const r = /^[ui]\\d+$/g; return r.source.length * 10 + r.flags.length }', [[]])

    // compound property assignment
    e2eTest('function compoundProp(o) { o.x += 5; return o.x }', [{ x: 10 }])
    e2eTest('function compoundPropRhs(o, y) { o.x *= y; return o.x }', [{ x: 3 }, 4])

    // recv
    e2eTest('function methodCall(o) { return o.bar() }', [{ x: 1, bar() { return this.x } }])
    e2eTest('function methodCall2(o) { return o["bar"]() }', [{ x: 1, bar() { return this.x } }])
    testBytecodeEmit('function methodCall3(o,k) { return o[k]() }')
    e2eTest('function methodCall3(o,k) { return o[k]() }', [{ x: 1, bar() { return this.x } }, "bar"])

    // repeat calls
    testBytecodeEmit('function manyCalls(o,k) { return o[k]() + o[k]() + o[k]() }')
    e2eTest('function manyCalls(o,k) { return o[k]() + o[k]() + o[k]() }', [{ x: 1, bar() { return this.x } }, "bar"])
    testBytecodeEmit(`function add2(a, b) {
    const q = add(a, b)
    return add(a, b) + q
}`)
    e2eTest(`function add2(a, b) {
    const q = add(a, b)
    return add(a, b) + q
}`,[2,3], undefined, createCtx({ 
        add: function add(a: number, b: number) { let c = a + b; return c * 2 } 
    }))

    // default init
    e2eTest('function init(x, y = 1) { return x + y }', [1])
    e2eTest('function initZero(x, y = 1) { return x + y }', [1, 0])
    e2eTestPrint('function init2(x, _ = 1) { return x }', [1])
    e2eTest('function init3(x, f, _ = f(x++)) { return x }', [1, () => 2])
    e2eTest('function init4(x, f, y = f()) { return x + y }', [1, () => 2, 3])

    // try/catch
    e2eTest('function eh() { try { throw 1 } catch (e) { return e + 1 } }', [1])
    e2eTest('function nothrow(x) { try { x += 1 } catch (e) { return e + 1 } return x }', [1])

    function iterable() {
        return {
            index: 0, closed: 0,
            [Symbol.iterator]: function iterator() { this.index = 0; return this },
            next: function next() {
                const value = this.index
                this.index = value + 1
                return { value, done: value >= 4 }
            },
            return: function close() { this.closed = this.closed + 1; return { done: true, value: 0 } },
        }
    }
    e2eTest('function iteration(o) { let sum = 0; for (const x of o) sum += x; return sum * 10 + o.closed }', [iterable()])
    e2eTest('function iterationBreak(o) { let sum = 0; for (const x of o) { if (x === 1) continue; if (x === 3) break; sum += x } return sum * 10 + o.closed }', [iterable()])
    e2eTest('function iterationReturn(o) { function inner() { for (const x of o) { if (x === 2) return x + 10 } return 0 } const value = inner(); return value * 10 + o.closed }', [iterable()])
    e2eTest('function iterationThrow(o) { try { for (const x of o) { if (x === 2) throw 7 } } catch (e) { return e * 10 + o.closed } return 0 }', [iterable()])
    e2eTest('function iterationAssign(o) { let x = 0; for (x of o) {} return x }', [iterable()])
    e2eTest('function iterationSwitch(o) { let sum = 0; for (const x of o) { switch (x) { case 1: break; default: sum += x } } return sum * 10 + o.closed }', [iterable()])
    e2eTest('function labeledFor(n) { let s = 0; outer: for (let i = 0; i < n; i += 1) { for (let j = 0; j < n; j += 1) { if (j === 3) continue outer; if (i === 4) break outer; s += i * 10 + j } } return s }', [6])
    e2eTest('function labeledBlock(x) { let s = 1; block: { if (x > 2) break block; s = 5 } return s }', [3])
    e2eTest('function labeledBlock(x) { let s = 1; block: { if (x > 2) break block; s = 5 } return s }', [1])
    e2eTest('function blockInLoop(n) { let s = 0; for (let i = 0; i < n; i += 1) { b: { if (i === 2) break b; if (i === 4) break; s += i } } return s }', [10])
    e2eTest('function labeledSwitch(n) { let s = 0; loop: for (let i = 0; i < n; i += 1) { switch (i) { case 1: continue loop; case 3: break loop; default: s += i } s += 100 } return s }', [6])
    e2eTest('function labeledWhile(n) { let i = 0; let s = 0; top: while (i < n) { i += 1; let j = 0; do { j += 1; if (j === 2) continue top; s += j } while (j < 5) } return s }', [4])
    e2eTest('function labeledIteration(o, p) { let sum = 0; outer: for (const x of o) { for (const y of p) { if (y === 2) continue outer; if (x === 3) break outer; sum += x * 10 + y } } return sum * 100 + o.closed * 10 + p.closed }', [iterable(), iterable()])
    const pairs = iterable()
    pairs.next = function next(this: { index: number }) {
        const index = this.index
        this.index = index + 1
        return { done: index >= 4, value: [index, index + 1] }
    } as any
    e2eTest('function iterationEntries(o) { let sum = 0; for (const [key, value] of o) sum += key + value; return sum }', [pairs])
    e2eTest('function symbolProperty(key, n) { const o = { [key]: n, value: 5 }; return o[key] + o.value }', [Symbol('value'), 7])

    // classes
    e2eTest('function classMethod(a) { class Point { constructor(x) { this.x = x } get() { return this.x + 1 } } return new Point(a).get() }', [4])
    e2eTest('function classNoConstructor() { class A { value() { return 7 } } return new A().value() }', [])
    e2eTest('function classChain(a) { class Counter { constructor(n) { this.n = n } add(x) { this.n = this.n + x; return this } } return new Counter(a).add(2).add(3).n }', [1])
    e2eTest('function classExpression(a) { const K = class { constructor(x) { this.x = x } }; return new K(a).x }', [5])
    e2eTest('function classCapture(a) { let base = 10; class A { get() { return base + a } } return new A().get() }', [3])
    e2eTest('function classStatic(a) { class A { static twice(x) { return x * 2 } } return A.twice(a) }', [6])
    e2eTest('function classStaticThis(a) { class A { static base() { return 3 } static plus(x) { return this.base() + x } } return A.plus(a) }', [4])
    e2eTest('function spreadCopy(a) { const o = { x: a, y: 2 }; const c = { ...o, ...undefined, z: 3 }; return c.x + c.y * 10 + c.z * 100 }', [4])
    e2eTest('function classInstanceof(a) { class A { get() { return 1 } } class B {} const x = new A(); return (x instanceof A ? 10 : 0) + (a instanceof A ? 100 : 0) + (x instanceof B ? 1000 : 0) + (new B() instanceof A ? 1 : 0) + ({} instanceof A ? 2 : 0) }', [3])
    e2eTest('function classStaticMixed(a) { class P { constructor(x) { this.x = x } static of(x) { return new P(x) } get() { return this.x + 1 } } return P.of(a).get() }', [8])
    assert(e2eTest('function classExtends(a) { class A { constructor(x) { this.x = x } get() { return this.x } } class B extends A { constructor(x) { super(x + 1); this.y = 2 } get() { return super.get() * 10 + this.y } } return new B(a).get() }', [3]) === 42)
    assert(e2eTest('function classImplicitConstructor(a) { class A { constructor(x, y) { this.s = x + y } } class B extends A { twice() { return this.s * 2 } } return new B(a, 5).twice() }', [2]) === 14)
    assert(e2eTest('function classInstanceofChain(a) { class A {} class B extends A {} class C extends B {} const c = new C(); return (c instanceof A ? 1 : 0) + (c instanceof B ? 2 : 0) + (new A() instanceof C ? 4 : 0) + (new B() instanceof A ? 8 : 0) + a }', [1]) === 12)
    assert(e2eTest('function classStaticInherit(a) { class A { static triple(x) { return x * 3 } static me() { return this } } class B extends A { static six(x) { return super.triple(x) * 2 } } return B.triple(a) + B.six(a) + (B.me() === B ? 100 : 0) }', [2]) === 118)
    assert(e2eTest('function classFields(a) { class A { x = 1; constructor(v) { this.v = v + this.x } } class B extends A { y = this.x + 10; constructor(v) { super(v); this.z = this.y * 2 } } const b = new B(a); return b.v * 100 + b.y + b.z }', [3]) === 433)
    assert(e2eTest('function classFieldsImplicit(a) { class P { n = a * 2; m = this.n + 1 } class Q extends P { k = this.m * 10 } const q = new Q(); return q.n * 1000 + q.k }', [2]) === 4050)
    assert(e2eTest('function classChainSuper(a) { class A { name() { return 1 } } class B extends A { name() { return super.name() * 10 + 2 } } class C extends B { name() { return super.name() * 10 + 3 } } return new C().name() + a }', [1]) === 124)
    assert(e2eTest('function classOverride(a) { class A { constructor(v) { this.v = v } get() { return this.v } run() { return this.get() + 1 } } class B extends A { get() { return this.v * 10 } } return new A(a).run() * 1000 + new B(a).run() }', [2]) === 3021)
    assert(e2eTest('function classSuperArrow(a) { class A { get() { return a } } class B extends A { get() { const f = () => super.get() + 1; return f() * 10 } } return new B().get() }', [4]) === 50)
    assert(e2eTest('function classSuperProperty(a) { class A { get() { return 5 } } class B extends A { get() { return 7 } both() { return this.get() * 10 + super.get() } } return new B().both() + a }', [1]) === 76)
    assert(e2eTest('function classExtendsCall(a) { class A { constructor(v) { this.v = v } } class Z { constructor(v) { this.v = v * 100 } } function pick(k) { return k ? A : Z } const M = class extends pick(a > 2) { twice() { return this.v * 2 } }; return new M(a).twice() }', [4]) === 8)
    assert(e2eTest('function classPolymorphic(a) { class Shape { constructor(s) { this.s = s } area() { return 0 } } class Square extends Shape { area() { return this.s * this.s } } class Twice extends Square { area() { return super.area() * 2 } } const xs = [new Shape(a), new Square(a), new Twice(a)]; let t = 0; for (const x of xs) t = t + x.area(); return t }', [3]) === 27)
    assert(e2eTest('function classSuperSpread(a) { class A { constructor(x, y) { this.s = x * 10 + y } } class B extends A { constructor(...xs) { super(...xs) } } return new B(a, 2).s }', [3]) === 32)
    assert(e2eTest('function classHeritageOnce(a) { let n = 0; class A { constructor() { this.k = 1 } get() { return this.k } } function pick() { n = n + 1; return A } class B extends pick() { get() { return super.get() * 10 } } const x = new B(); const y = new B(); return x.get() + y.get() + n * 100 + a }', [1]) === 121)
    assert(e2eTest('function classHeritageReassign(a) { class A { constructor() { this.k = 1 } get() { return this.k } } class Z { constructor() { this.k = 5 } get() { return 7 } } let M = A; class B extends M { get() { return super.get() * 10 } } M = Z; const b = new B(); return b.get() + (b instanceof A ? 100 : 0) + (b instanceof Z ? 1000 : 0) + a }', [1]) === 111)
    assert(e2eTest('function classSuperGetter(a) { class A { get v() { return this.k } } class B extends A { constructor() { super(); this.k = a } get v() { return super.v * 10 } } return new B().v }', [4]) === 40)
    assert(e2eTest('function classStaticSuperGetter(a) { class A { static get v() { return this.k } } class B extends A { static get w() { return super.v * 10 } } B.k = a; return B.w }', [3]) === 30)
    assert(e2eTest('function classSuperComputed(a) { class A { m1() { return 1 } m2() { return 2 } } class B extends A { pick(i) { return super["m" + i]() * 10 } } return new B().pick(a) }', [2]) === 20)
    {
        function setProto(o: any, p: any) {
            Object.setPrototypeOf(o, p)
        }
        const protoCtx = createCtx({ setProto })
        assert(e2eTest('function classSuperSetPrototype(a) { class A { get() { return 1 } } class X { get() { return 7 } } class B extends A { get() { return super.get() * 10 } } const before = new B().get(); setProto(B.prototype, X.prototype); return before * 100 + new B().get() + a }', [1], null, protoCtx) === 1071)
        assert(e2eTest('function classSuperConstructorSwap(a) { class A { constructor() { this.k = 1 } } class X { constructor() { this.k = 9 } } class B extends A {} setProto(B, X); return new B().k + a }', [1], null, protoCtx) === 10)
    }
    assert(e2eTest('function classSiblingHomes(a) { class A { v() { return 1 } } class B { v() { return 2 } } class X extends A { v() { return super.v() * 10 } } class Y extends B { v() { return super.v() * 100 } } return new X().v() + new Y().v() + a }', [3]) === 213)
    assert(e2eTest('function classNestedHomes(a) { class A { v() { return 1 } } class B extends A { v() { class C extends A { v() { return super.v() + 4 } } const f = () => super.v() * 10; return new C().v() * 100 + f() } } return new B().v() + a }', [3]) === 513)
    assert(e2eTest('function classExtendsNull(a) { class N extends null { m() { return a + 1 } } return N.prototype.m() + (N.prototype.toString === undefined ? 10 : 0) }', [2]) === 13)
    e2eTest('function privateGetter(a) { class C { constructor(x) { this.x = x } get #twice() { return this.x * 2 } read() { return this.#twice + 1 } } return new C(a).read() }', [4])
    e2eTest('function privateGetterCapture(a) { const k = a + 1; class C { get #k() { return k } read() { return this.#k * 10 } } return new C().read() }', [2])
    e2eTest('function privateGetterChain(a) { class C { constructor(x) { this.x = x } get #inner() { return this.x + 1 } get #outer() { return this.#inner * 3 } read() { return this.#outer } } return new C(a).read() }', [2])
    e2eTest('function privateGetterShadow(a) { class C { get #v() { return 1 } read() { class D { constructor() { this.#v = 7 } #v; get() { return this.#v } } return new D().get() * 10 + this.#v } } return new C().read() + a }', [3])
    e2eTest('function privateMethod(a) { class C { constructor(x) { this.x = x } #scale(k) { return this.x * k } read(k) { return this.#scale(k) + 1 } } return new C(a).read(3) }', [4])
    e2eTest('function privateMethodCapture(a) { const k = a + 1; class C { #add(x) { return x + k } read(x) { return this.#add(x) * 10 } } return new C().read(2) }', [2])
    e2eTest('function privateMethodRecursive(a) { class C { #sum(n) { return n ? n + this.#sum(n - 1) : 0 } read(n) { return this.#sum(n) } } return new C().read(a) }', [5])
    e2eTest('function privateMethodShadow(a) { class C { #v() { return 1 } read() { class D { #v() { return 7 } get() { return this.#v() } } return new D().get() * 10 + this.#v() } } return new C().read() + a }', [3])
    e2eTest('function privateMethodOther(a) { class C { constructor(x) { this.x = x } #get() { return this.x } plus(o) { return this.#get() * 10 + o.#get() } } return new C(a).plus(new C(a + 1)) }', [2])
    e2eTest('function privateMethodGetter(a) { class C { constructor(x) { this.x = x } get #twice() { return this.#double(this.x) } #double(n) { return n * 2 } read() { return this.#twice } } return new C(a).read() }', [4])
    e2eTest('function privateSetter(a) { class C { set #v(x) { this.x = x * 2 } write(x) { this.#v = x; return this.x } } return new C().write(a) }', [3])
    e2eTest('function privateSetterCapture(a) { const k = a + 1; class C { set #v(x) { this.x = x + k } write(x) { this.#v = x; return this.x } } return new C().write(10) }', [2])
    e2eTest('function privateSetterValue(a) { class C { set #v(x) { this.x = x * 2 } write(x) { const r = this.#v = x + 1; return r * 100 + this.x } } return new C().write(a) }', [3])
    e2eTest('function privateAccessorPair(a) { class C { constructor() { this.x = 1 } get #v() { return this.x } set #v(x) { this.x = x } bump(n) { this.#v = this.#v + n; return this.#v } } return new C().bump(a) }', [4])
    e2eTest('function privateAccessorUpdate(a) { class C { constructor(x) { this.x = x } get #v() { return this.x } set #v(x) { this.x = x * 10 } bump() { const old = this.#v++; return old * 1000 + this.x } } return new C(a).bump() }', [2])
    e2eTest('function privateAccessorPrefix(a) { class C { constructor(x) { this.x = x } get #v() { return this.x } set #v(x) { this.x = x * 10 } bump() { const r = ++this.#v; return r * 1000 + this.x } } return new C(a).bump() }', [2])
    e2eTest('function privateAccessorCompound(a) { class C { constructor(x) { this.x = x } get #v() { return this.x } set #v(x) { this.x = x } bump(n) { const r = (this.#v += n); this.#v *= 2; return r * 100 + this.x } } return new C(a).bump(3) }', [4])
    e2eTest('function privateAccessorReceiverOnce(a) { class C { constructor() { this.x = 1; this.n = 0 } get #v() { return this.x } set #v(x) { this.x = x } self() { this.n++; return this } bump(k) { this.self().#v += k; return this.x * 10 + this.n } } return new C().bump(a) }', [4])
    e2eTest('function privateSetterOther(a) { class C { constructor() { this.x = 0 } set #v(x) { this.x = x } copyTo(o, x) { o.#v = x; return o } } return new C().copyTo(new C(), a).x }', [5])
    e2eTest('function privateSetterRecursive(a) { class C { constructor() { this.total = 0 } set #v(n) { if (n) { this.total = this.total + n; this.#v = n - 1 } } sum(n) { this.#v = n; return this.total } } return new C().sum(a) }', [4])
    e2eTest('function privateGetterRecursive(a) { class C { constructor(n) { this.n = n } get #v() { if (!this.n) return 0; this.n = this.n - 1; return this.#v + 2 } read() { return this.#v } } return new C(a).read() }', [3])
    e2eTest('function privateSetterShadow(a) { class C { constructor() { this.x = 0 } set #v(x) { this.x = x } write() { class D { constructor() { this.y = 0 } set #v(x) { this.y = x * 2 } run(o) { o.#v = 5; return this.y } } const d = new D(); d.run(d); this.#v = d.y; return this.x } } return new C().write() + a }', [1])
    for (const [source, message] of [
        ['function f() { class C { static set #v(x) {} } return 0 }', 'static private members are not supported'],
        ['function f() { class C { static get #v() { return 1 } } return 0 }', 'static private members are not supported'],
        ['function f() { class C { static #m() { return 1 } } return 0 }', 'static private members are not supported'],
        ['function f() { class C { #m() { return 1 } read() { const f = this.#m; return f() } } return new C().read() }', 'can only be called'],
        ['function f() { class C { #m() { return 1 } write() { this.#m = 2 } } return 0 }', 'cannot assign to private member'],
        ['function f() { class C { #a() { return this.#b() } #b() { return this.#a() } read() { return this.#a() } } return new C().read() }', 'recursive private member'],
        ['function f(k) { class C { #m(n) { return n ? k + this.#m(n - 1) : 0 } read() { return this.#m(2) } } return new C().read() }', 'recursive private member #m with captures'],
        ['function f(k) { class C { set #v(n) { if (n) this.#v = n - k } write() { this.#v = 2 } } return new C().write() }', 'recursive private member #v with captures'],
        ['function f() { class C { get #v() { this.#v = 1; return 0 } set #v(x) { this.y = this.#v } read() { return this.#v } } return new C().read() }', 'recursive private member'],
        ['function f() { class C { set #v(x) {} read() { return this.#v } } return new C().read() }', 'cannot read private member #v'],
        ['function f() { class C { set #v(x) {} bump() { this.#v++ } } return 0 }', 'cannot read private member #v'],
        ['function f() { class C { set #v(x) {} bump() { this.#v += 1 } } return 0 }', 'cannot read private member #v'],
        ['function f() { class C { #m() { return 1 } bump() { this.#m += 1 } } return 0 }', 'can only be called'],
        ['function f() { class C { get #v() { return 1 } write() { this.#v = 2 } } return 0 }', 'cannot assign to private member'],
        ['function f() { class C { get #v() { return 1 } bump() { this.#v++ } } return 0 }', 'cannot assign to private member'],
        ['function f() { class C { get #v() { return 1 } bump() { this.#v += 1 } } return 0 }', 'cannot assign to private member'],
        ['function f() { class C { m() { return super.m() } } return 0 }', "'super' is only supported in members of a derived class"],
        ['function f() { class A {} class B extends A { m() { super.x = 1 } } return 0 }', 'assignment to a super property is not supported'],
        ['function f() { class A {} class B extends A { static k = 1 } return 0 }', 'static class field initializers are not supported'],
    ]) {
        let error = ''
        try {
            compile(source)
        } catch (e) {
            error = String(e)
        }
        if (!error.includes(message)) throw `private accessor: expected "${message}" from ${source}, got "${error}"`
    }
    e2eTest('function classFromCtx(a) { return new Point(a).value() }', [4], null, createCtx({
        Point: class Point { constructor(public x: number) {} value() { return this.x + 1 } },
    }))
    {
        class HostBase {
            v: number
            constructor(v: number) {
                this.v = v
            }
            get() {
                return this.v
            }
            static make(v: number) {
                return new this(v)
            }
        }
        class HostDerived extends HostBase {
            w = 3
            constructor(v: number) {
                super(v + 1)
            }
            get() {
                return super.get() * 10 + this.w
            }
        }
        class HostLeaf extends HostDerived {
        }
        const hostCtx = createCtx({ HostBase, HostDerived, HostLeaf })
        assert(e2eTest('function hostExtends(a) { return new HostDerived(a).get() }', [2], null, hostCtx) === 33)
        assert(e2eTest('function hostImplicit(a) { const l = new HostLeaf(a); return l.get() + (l instanceof HostBase ? 100 : 0) + (l instanceof HostDerived ? 1000 : 0) }', [2], null, hostCtx) === 1133)
        assert(e2eTest('function hostStatic(a) { return HostLeaf.make(a).get() }', [4], null, hostCtx) === 53)
    }
    {
        let hostPicks = 0
        class HostOne {
            get() {
                return 1
            }
        }
        class HostTwo {
            get() {
                return 2
            }
        }
        function hostPick() {
            hostPicks = hostPicks + 1
            return HostOne
        }
        let hostParent = HostOne
        class HostReassigned extends hostParent {
            get() {
                return super.get() * 10
            }
        }
        hostParent = HostTwo
        class HostPicked extends hostPick() {
            get() {
                return super.get() * 10 + hostPicks
            }
        }
        const hostCtx = createCtx({ HostOne, HostTwo, HostReassigned, HostPicked })
        assert(e2eTest('function hostHeritageReassign(a) { const r = new HostReassigned(); return r.get() + (r instanceof HostOne ? 100 : 0) + (r instanceof HostTwo ? 1000 : 0) + a }', [1], null, hostCtx) === 111)
        assert(e2eTest('function hostHeritageOnce(a) { return new HostPicked().get() + new HostPicked().get() + a }', [1], null, hostCtx) === 23)
        assert(hostPicks === 1)
    }
    e2eTest('function destructureArray(a) { const [x, , y] = [a, 0, a + 1]; return x * y }', [3])
    e2eTest('function destructureObject(a) { const { x, y: z } = { x: a, y: 2 }; return x + z }', [3])
    e2eTest('function literalFields(a, b) { const o = { x: a, y: b, z: a + b }; return o.x * 100 + o.y * 10 + o.z }', [1, 2])
    e2eTest('function literalOrder(a) { let n = a; const o = { p: (n = n * 10 + 1), q: (n = n * 10 + 2), r: n }; return o.p * 10000 + o.q * 100 + o.r }', [0])
    e2eTest('function literalThis(a) { const o = { v: a, twice() { return this.v * 2 } }; return o.twice() }', [4])
    e2eTest('function literalShorthand(a, b) { const o = { a, b, c: 3 }; return o.a * 100 + o.b * 10 + o.c }', [1, 2])
    e2eTest('function literalStringKeys(a) { const o = { "k": a, \'m n\': 2 }; return o.k * 10 + o["m n"] }', [3])
    e2eTest('function literalNested(a) { const o = { inner: { v: a }, w: 3 }; return o.inner.v * 10 + o.w }', [4])
    e2eTest('function literalThenStore(a) { const o = { x: a }; o.x = o.x + 1; o.y = 3; return o.x * 10 + o.y }', [4])
    e2eTest('function literalDuplicate(a) { const o = { x: 1, y: 2, x: a }; return o.x * 10 + o.y }', [5])
    e2eTest('function literalComputed(a) { const k = "x"; const o = { y: 1, [k]: a }; return o.x * 10 + o.y }', [5])
    e2eTest('function literalSpread(a) { const o = { y: 1, ...{ x: a } }; return o.x * 10 + o.y }', [5])
    e2eTest('function destructureDefault(a) { let { x, y = 7 } = { x: a }; const [p = 1, q = 2] = [a]; return x + y + p + q }', [3])
    e2eTest('function destructureNested(a) { const [{ x }, [y, w]] = [{ x: a }, [1, 3]]; return x + y + w }', [4])
    e2eTest('function destructureCapture(a) { const { x } = { x: a }; function f() { return x + 1 } return f() }', [5])
    e2eTest('function destructureFor(a) { let t = 0; for (let [i, n] = [0, a]; i < n; i++) t += i; return t }', [4])
    e2eTest('function destructureCatch(a) { try { throw { v: a } } catch ({ v }) { return v + 1 } }', [2])
    e2eTest('function finallyNormal(n) { let s = 0; try { s = n } finally { s += 1 } return s }', [4])
    e2eTest('function finallyReturn(n) { const o = { v: 0 }; function inner() { let s = 0; try { if (n > 2) return n; s = 1 } finally { o.v += 10 } return s } return inner() + o.v }', [4])
    e2eTest('function finallyReturn(n) { const o = { v: 0 }; function inner() { let s = 0; try { if (n > 2) return n; s = 1 } finally { o.v += 10 } return s } return inner() + o.v }', [1])
    e2eTest('function finallyThrow(n) { let s = 0; try { try { if (n > 2) throw n } finally { s += 10 } } catch (e) { return e + s } return s }', [4])
    e2eTest('function finallyThrow(n) { let s = 0; try { try { if (n > 2) throw n } finally { s += 10 } } catch (e) { return e + s } return s }', [1])
    e2eTest('function finallyLoop(n) { let s = 0; for (let i = 0; i < n; i += 1) { try { if (i === 2) continue; if (i === 4) break; s += i } finally { s += 100 } } return s }', [6])
    e2eTest('function finallyOverride(n) { try { return n } finally { if (n > 2) return 7 } }', [4])
    e2eTest('function finallyOverride(n) { try { return n } finally { if (n > 2) return 7 } }', [1])
    e2eTest('function catchFinally(n) { let s = 0; try { if (n > 2) throw n; s = 1 } catch (e) { s = e } finally { s += 100 } return s }', [4])
    e2eTest('function catchFinally(n) { let s = 0; try { if (n > 2) throw n; s = 1 } catch (e) { s = e } finally { s += 100 } return s }', [1])
    e2eTest('function finallyRethrows(n) { let s = 0; try { try { throw n } catch (e) { throw e + 1 } finally { s = 10 } } catch (e) { return e + s } }', [4])
    e2eTest('function finallyIteration(o) { let s = 0; try { for (const x of o) { try { if (x === 2) return s } finally { s += x } } } finally { s += 100 } return s }', [iterable()])

    {
        function shortcircuit(x: number, y: (o: any) => number) {
            const o = { y: 0 }
            if (x && y(o)) return x + y(o)
            return o.y
        }
        e2eTest(shortcircuit, [1, (o: any) => o.y += 1])
        e2eTest(shortcircuit, [0, (o: any) => o.y += 1])
    }

    e2eTest(function noret(x: number, f: (n: number) => void) {
        f(x += 1)
        x += 1
    }, [0, () => {}])

    // generated/fuzz tests
    e2eTest(function gen158_min(a: number, b: number) {
        let s1 = 2
        if (16 >= b) {
            a = 6
        } else {
            if (a >= b) {} else s1 = 1
        }
        return s1
    }, [18, 17])

    console.log(Intrinsics.rem(-5, 10, Types.u32))

    console.log("bytecode-emitter end-to-end passed")
}

function wideTest() {
    function jumps(source: string): CodeInstruction[] {
        const it = createCodeIterator(compile(source).code as u8[])
        const out: CodeInstruction[] = []
        while (const inst = it.next()) {
            if (JumpOps.has(inst.opcode)) out.push(inst)
        }
        return out
    }
    assert(jumps('function small(n) { while (n) n--; return n }').every(inst => inst.width === 2))
    assert(jumps(`function medium(n) { if (n) { ${'n = 1;'.repeat(400)} } return n }`).every(inst => inst.width === 2))
    const early = jumps(`function early(n = 0) { if (n) { ${'n = 1;'.repeat(1500)} } return n }`)
    assert(early.length >= 2)
    assert(early.every(inst => inst.width === 4 && Math.abs(inst.jumpOffset!) < 32768))
    assert(jumps(`function outer(n) { function inner(x) { ${'x = 1;'.repeat(1500)} return x } if (n) return inner(n); return 0 }`).every(inst => inst.width === 4))
    assert(jumps('function cleanup(n) { try { if (n) return 1 } finally { n++ } return n }').every(inst => inst.width === 4))
    assert(jumps('function iterator(a) { for (const x of a) { if (x) return x } return 0 }').every(inst => inst.width === 4))
    for (const off of [-2147483648, -40000, 40000, 2147483647]) {
        const bytes: number[] = []
        pushOpcode(bytes, Op.Jump, 4)
        pushOperand(bytes, off, 4)
        const inst = createCodeIterator(bytes as u8[]).next()!
        assert(inst.jumpOffset === off)
        assert(inst.jumpTarget === 6 + off)
    }

    const body = 'x = x + 1;'.repeat(7000)
    e2eTest(`function largeLoop(n) { let x = 0; while (n > 0) { ${body} n--; } return x }`, [2])
    e2eTest(`function largeDo(n) { let x = 0; do { ${body} n--; } while (n > 0); return x }`, [2])
    const largeSwitch = `function largeSwitch(n) { let x = 0; switch (n) { case 0: ${body} break; case 1: x = 2; break; case 2: x = 3; break; default: x = 4 } return x }`
    e2eTest(largeSwitch, [0])
    e2eTest(largeSwitch, [2])
    e2eTest(`function largeCatch(n) { let x = 0; try { if (n) { ${body} throw 9 } } catch (e) { x += e } finally { x++ } return x }`, [1])

    const locals = Array.from({ length: 300 }, (_, i) => `let v${i} = n;`).join('')
    const uses = Array.from({ length: 300 }, (_, i) => `v${i};`).join('')
    e2eTest(`function wideRegisters(n) { ${locals} function g() { ${uses} v299++; return v0 + v299 } return g() + v299 }`, [3])
    const elements = Array.from({ length: 300 }, () => 'n').join(',')
    e2eTest(`function wideArray(n) { const a = [${elements}]; a[299] += 2; return a[299] + a.length }`, [3])
    e2eTest(`function wideArgs(n) { function f(...args) { return args.length + args[299] } return f(${elements}) }`, [3])
    e2eTest('function wideIndex(n) { const o = {}; o[65536] = n; return o[65536] }', [7])
    const fields = Array.from({ length: 300 }, (_, i) => `p${i}: n`).join(',')
    e2eTest(`function wideObject(n) { const o = {${fields}}; o.p299 += 2; return o.p299 }`, [3])

    function wide(width: number, op: number, ...operands: number[]): number[] {
        const bytes: number[] = []
        pushOpcode(bytes, op, width)
        for (const operand of operands) pushOperand(bytes, operand, width)
        return bytes
    }
    const interpret = createInterpreter(true)
    const noArgs = Intrinsics.stackalloc(4)
    defer Intrinsics.stackfree(4)
    const identity = makeFunctionFromBytes([Op.Ldar0, Op.Return], 1, 1)
    for (const width of [2, 4]) {
        const index = width === 2 ? 256 : 65536
        const constants = new Array(index + 1).fill(0)
        const handles = new Array(index + 1).fill(false)
        constants[index] = identity
        handles[index] = true
        const caller = makeFunctionFromBytes([
            Op.LdaImm, 42,
            ...wide(width, Op.Star, index),
            Op.LdaUndefined,
            ...wide(width, Op.CallConst, index, index, 1),
            ...wide(width, Op.Star, index + 1),
            ...wide(width, Op.LdaConst, index),
            ...wide(width, Op.Star, index + 2),
            Op.LdaUndefined,
            ...wide(width, Op.Call, index + 2, index, 1),
            ...wide(width, Op.Add, index + 1),
            Op.Return,
        ], 0, index + 3 as u32, constants, handles)
        assert(vmValue(interpret(caller, 0, noArgs, 0)) === 84)
        constants[index] = heap.fromJsString('x')
        const property = makeFunctionFromBytes([
            Op.CreateEmptyObject,
            ...wide(width, Op.Star, index),
            Op.LdaImm, 42,
            ...wide(width, Op.SetPropertyConst, index, index),
            ...wide(width, Op.Ldar, index),
            ...wide(width, Op.GetPropertyConst, index),
            Op.Return,
        ], 0, index + 1 as u32, constants, handles)
        assert(vmValue(interpret(property, 0, noArgs, 0)) === 42)
    }
    for (const op of ConditionalJumpOps) {
        for (const load of [Op.LdaUndefined, Op.LdaZero, Op.LdaTrue]) {
            const code = [load, ...wide(4, op, 40000), Op.LdaZero, Op.Return]
            for (let i = 0; i < 39998; i++) code.push(Op.Nop)
            code.push(Op.LdaImm, 1, Op.Return)
            let taken: boolean
            if (op === Op.JumpIfToBooleanTrue) taken = load === Op.LdaTrue
            else if (op === Op.JumpIfToBooleanFalse) taken = load !== Op.LdaTrue
            else if (op === Op.JumpIfNull) taken = false
            else if (op === Op.JumpIfNotNull) taken = true
            else if (op === Op.JumpIfUndefined || op === Op.JumpIfNullish) taken = load === Op.LdaUndefined
            else taken = load !== Op.LdaUndefined
            assert(vmValue(interpret(makeFunctionFromBytes(code, 0, 1), 0, noArgs, 0)) === (taken ? 1 : 0))
        }
    }
}

export function suite() {
    emitTest()
    runTest()
    wideTest()
}

