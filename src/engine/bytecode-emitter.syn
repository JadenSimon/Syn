"use wrapped";

import * as heap from './heap'
import * as intrinsics from './intrinsics'
import { Op, createInterpreter, makeFunctionFromBytes } from './vm'
import ts from 'typescript'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const inRange = intrinsics.inRange
const assert = intrinsics.assert

type usize = u32
type Handle = heap.Handle

function isLateBoundSymbol(node: ts.Node) {
    return (node as any).isLateBoundSymbol?.() ?? false
}

function getSymbolId(node: ts.Node) {
    return (node as any).extra
}

function usesThisBinding(node: ts.Node) {
    return (node as any).usesThisBinding?.() ?? false
}

function isReferencedSymbol(node: ts.Node) {
    return (node as any).isReferencedSymbol?.() ?? false
}

enum ConstantKind {
    number,
    string,
    function_, // ??? FIXME: this breaks if you try to use "function" because it gets treated as a keyword :/
    late_bound, // so, unknown
}

interface EhRange {
    start: number
    end: number
    handler: number
}

interface Labels {
    eh: EhRange[]
    jump: number[]
}

export type EmitResult = {
    code: number[]           // opcodes + byte operands
    constants: any[]
    constantKinds: ConstantKind[]
    paramCount: number
    registerCount: number
    lateBound: Map<number, number> // symbol id -> constant pool slot
    selfSlot?: number
    labels?: Labels
}

function isShortStore(opcode: number) {
    return opcode >= Op.Star0 && opcode <= Op.Star15
}

function isShortLoad(opcode: number) {
    return opcode >= Op.Ldar0 && opcode <= Op.Ldar3
}

function emitFunction(
    fn: ts.FunctionDeclaration | ts.ArrowFunction | ts.FunctionExpression,
    constContext?: Record<string, any> // will be used to specialize bytecode later
): EmitResult {
    const code: number[] = []
    const constants: any[] = []
    const constantKinds: ConstantKind[] = []

    const internMap = new Map<string, number>()  // interning key -> slot
    const symToReg = new Map<number, number>()    // symbol id -> register
    const lateBound = new Map<number, number>()   // symbol id -> constant slot

    const regState: [number, number][] = [] // tracks the most recent store pc against the reg
    const maxLookbehind = 16
    const lookbehindBuffer = new Uint32Array(maxLookbehind)
    let lookbehindPos = 0
    let lookbehindCount = 0
    function pushLookbehind(pos: number) {
        if (lookbehindCount < maxLookbehind) {
            lookbehindCount += 1
        } else {
            lookbehindPos = (lookbehindPos + 1) % maxLookbehind
        }
        const p = (lookbehindCount + lookbehindPos) % maxLookbehind
        lookbehindBuffer[p] = pos as any 
    }
    function popLookbehind(amt = 1) {
        assert(lookbehindCount > amt-1)
        lookbehindCount -= amt
    }
    // returns the _position_ of the last op, starting at 0
    function lookbehind(amt: number) {
        assert(amt >= 0)
        if (amt > lookbehindCount) return
        const p = (lookbehindCount + lookbehindPos - amt) & (maxLookbehind-1)
        return lookbehindBuffer[p]
    }

    let nextReg = 0
    let maxReg = 0
    let thisReg: number | undefined = undefined
    let prevOpOffset: number = -1
    let prevStoreOffset: number = -1
    let skipNextLookbehind = false
    // jumps should not update the "prev op" values
    
    // used for less common constructs
    let extraLabels: Labels | undefined
    function getExtraLabels() {
        return extraLabels ??= {
            eh: [],
            jump: [],
        }
    }

    function findConstPoolSlot(node: ts.Expression) {
        if (node.kind !== ts.SyntaxKind.Identifier) return
        const symId = getSymbolId(node)
        if (!symId) return
        if (isLateBoundSymbol(node)) return lateBoundSlot(symId, (node as ts.Identifier).text)
        if (const x = lateBound.get(symId)) return x
    }

    function allocReg(): number {
        const r = nextReg
        nextReg = nextReg + 1
        if (nextReg > maxReg) {
            maxReg = nextReg
            if (regState.length < maxReg) {
                regState.length = maxReg
                regState[regState.length-1] = [-1, -1]
            }
        }
        return r
    }
    function freeReg(): void {
        nextReg = nextReg - 1
    }

    function emitByte(b: number) {
        if (b === undefined) throw `not a byte: ${b}`
        if (b < 0 || b > 255) throw `operand out of byte range: ${b} (TODO: width prefixes)`
        code.push(b)
    }
    function emit1(op: number) { 
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        code.push(op) 
    }
    function emit2(op: number, operand: number) {
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        code.push(op);
        emitByte(operand)
    }
    function emit3(op: number, operand1: number, operand2: number) {
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        code.push(op)
        emitByte(operand1)
        emitByte(operand2)
    }
    function emit4(op: number, operand1: number, operand2: number, operand3: number) {
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        code.push(op)
        emitByte(operand1)
        emitByte(operand2)
        emitByte(operand3)
    }
    function star(reg: number) {
        const pc = code.length
        regState[reg][0] = pc
        regState[reg][1] = prevOpOffset
        prevOpOffset = prevStoreOffset = pc
        pushLookbehind(pc)
        if (reg <= 15) {
            const op = Op.Star0 + reg
            code.push(op)
        } else {
            code.push(Op.Star, reg)
        }
    }
    function tryReplaceToMov(): boolean {
        const pc0 = lookbehind(0) as number
        const pc1 = lookbehind(1) as number
        if (pc0 === undefined || pc1 === undefined) return false
        if (isShortStore(code[pc0]) && isShortLoad(code[pc1])) {
            const dst = code[pc0] - Op.Star0
            const src = code[pc1] - Op.Ldar0
            code[pc1] = Op.MovPacked
            code[pc0] = dst | (src << 4)
            prevOpOffset = pc1
            popLookbehind()
            return true
        }
        return false
    }
    function ldar(reg: number) {
        tryReplaceToMov()
        if (const prev = lookbehindForReg(reg)) {
            if (prev === reg) return
        }
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        if (reg <= 3) {
            const op = Op.Ldar0 + reg
            code.push(op)
        } else {
            code.push(Op.Ldar, reg)
        }
    }

    function emitLoadImm(val: number) {
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        if (inRange(Types.i8, val)) { code.push(Op.LdaImm); code.push(val & 0xFF); return }
        if (inRange(Types.i16, val)) {
            code.push(Op.Width2); code.push(Op.LdaImm)
            code.push(val & 0xFF); code.push((val >>> 8) & 0xFF)
            return
        }
        if (inRange(Types.i32, val)) {
            code.push(Op.Width4); code.push(Op.LdaImm)
            code.push(val & 0xFF); code.push((val >>> 8) & 0xFF)
            code.push((val >>> 16) & 0xFF); code.push((val >>> 24) & 0xFF)
            return
        }
        throw `immediate too large: ${val}`
    }

    function emitLoadConst(slot: number) {
        prevOpOffset = code.length
        pushLookbehind(prevOpOffset)
        if (slot <= 0xFF) { code.push(Op.LdaConst); code.push(slot); return }
        if (slot <= 0xFFFF) {
            code.push(Op.Width2); code.push(Op.LdaConst)
            code.push(slot & 0xFF); code.push((slot >>> 8) & 0xFF)
            return
        }
        if (slot <= 0xFFFFFFFF) {
            code.push(Op.Width4); code.push(Op.LdaConst)
            code.push(slot & 0xFF); code.push((slot >>> 8) & 0xFF)
            code.push((slot >>> 16) & 0xFF); code.push((slot >>> 24) & 0xFF)
            return
        }
        throw `constant pool index too large: ${slot}`
    }

    function lookbehindForReg(reg: number) {
        if (skipNextLookbehind) {
            // we cannot skip if we're going to be jumped into
            skipNextLookbehind = false
            return
        }
        if (const prev = (regState[reg] as [number, number] | undefined)) {
            if (prev[0] !== -1 && (code as any)[prev[0]] - Op.Star0 === reg) {
                if (prevOpOffset === prev[1] || prevOpOffset === prev[0]) return reg
            }
        }
        if (prevStoreOffset === -1 || prevOpOffset !== prevStoreOffset) return
        const op = code[prevStoreOffset]
        if (op >= Op.Star0 && op <= Op.Star15) return op - Op.Star0
    }

    function emitJumpPlaceholder(jumpOp: number): number {
        pushLookbehind(code.length)
        code.push(Op.Width2); code.push(jumpOp)
        const at = code.length
        code.push(0); code.push(0) // filled in by patchJump
        return at
    }
    function patchJump(at: number) {
        const off = code.length - (at + 2)
        if (!inRange(Types.i16, off)) throw `jump offset out of range: ${off}`
        code[at] = off & 0xFF
        code[at + 1] = (off >>> 8) & 0xFF
    }
    function emitJumpTo(jumpOp: number, target: number) {
        pushLookbehind(code.length)
        code.push(Op.Width2); code.push(jumpOp)
        const at = code.length
        const off = target - (at + 2)
        if (!inRange(Types.i16, off)) throw `jump offset out of range: ${off}`
        code.push(off & 0xFF); code.push((off >>> 8) & 0xFF)
    }

    const patchStarState: number[] = []
    function emitStarPlaceholder(): number {
        // TODO: select size based on bounded # of regs needed
        // the prediction does not need to be perfect, just needs to bound it
        const at = code.length
        pushLookbehind(at)
        code.push(Op.Star0)
        patchStarState.push(prevOpOffset)
        return at
    }

    function patchStar(at: number) {
        const reg = allocReg()
        if (reg > 15) throw `TODO: patch larger stores`
        code[at] += reg
        regState[reg][0] = at
        regState[reg][1] = patchStarState.pop()!
        return reg
    }

    function patchStarArg(at: number, idx: number) {
        const state = patchStarState.pop()!
        const reg = maxReg + idx
        // easier to treat these regs as volatile for the caller
        // regState[reg] ??= [-1, -1]
        // regState[reg][0] = at
        // regState[reg][1] = state
        if (reg > 15) throw `TODO: patch larger stores`
        assert(code[at] === Op.Star0 || code[at-1] === Op.MovPacked)
        code[at] += reg
        return reg
    }

    type LoopLabels = { breaks: number[], continues: number[], continueTarget: number }
    let labels: LoopLabels | undefined = undefined
    function emitBreak() {
        if (!labels) throw "`break` outside of a loop"
        labels.breaks.push(emitJumpPlaceholder(Op.Jump))
    }
    function emitContinue() {
        if (!labels) throw "`continue` outside of a loop"
        if (labels.continueTarget >= 0) { emitJumpTo(Op.Jump, labels.continueTarget); return }
        labels.continues.push(emitJumpPlaceholder(Op.Jump))
    }

    function internString(s: string): number {
        const existing = internMap.get(s)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(s)
        constantKinds.push(ConstantKind.string)
        internMap.set(s, slot)
        return slot
    }
    function internNumber(v: number): number {
        const key = "##" + v
        const existing = internMap.get(key)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(v)
        constantKinds.push(ConstantKind.number)
        internMap.set(key, slot)
        return slot
    }
    function internValue(s: string | number): number {
        if (typeof s === 'string') return internString(s)
        return internNumber(s)
    }
    function lateBoundSlot(symId: number, name: string, kind = ConstantKind.late_bound): number {
        const existing = lateBound.get(symId)
        if (existing !== undefined) return existing
        const slot = constants.length
        constants.push(name)
        constantKinds.push(kind)
        lateBound.set(symId, slot)
        return slot
    }

    function emitNumber(v: number) {
        if (!Number.isInteger(v)) throw "float literals are not supported yet"
        if (inRange(Types.i8, v)) {
            return emitLoadImm(v)
        }
        emitLoadConst(internNumber(v))
    }

    function emitLiteral(v: FoldResultValue) {
        if (v === true) return emit1(Op.LdaTrue)
        if (v === false) return emit1(Op.LdaFalse)
        if (v === null) return emit1(Op.LdaNull)
        if (v === undefined) return emit1(Op.LdaUndefined)
        if (typeof v === 'string') return emitLoadConst(internString(v));
        intrinsics.assert(typeof v === 'number')
        return emitNumber(v)
    }

    function isLexicalIdent(node: ts.Node): boolean {
        if (!ts.isIdentifier(node)) return false
        if (isLateBoundSymbol(node)) return false
        return symToReg.has(getSymbolId(node))
    }

    const foldedVariables = new Map<number, [FoldResultValue]>()
    function tryFoldVariableDecl(node: ts.VariableDeclaration) {
        if (!node.initializer) return false
        if (!ts.isIdentifier(node.name)) return false
        // ASSUMES CONST BINDING
        // MUST NOT HAVE BEEN REF'D YET
        const symId = getSymbolId(node.name)
        if (symToReg.has(symId)) return false
        // simple = just constant fold it
        if (const r = tryFoldExp(node.initializer)) {
            if (r[0] === 'value') {
                foldedVariables.set(symId, [r[1]])
                return true
            }
        }
        return false
    }

    function hasEffects(node: ts.Node): boolean {
        switch (node.kind) {
            case ts.SyntaxKind.ParenthesizedExpression:
                return hasEffects((node as ts.ParenthesizedExpression).expression)
            case ts.SyntaxKind.PrefixUnaryExpression:
                if (isAssignmentUnary((node as ts.PrefixUnaryExpression).operator)) {
                    return true
                }
                return hasEffects((node as ts.PrefixUnaryExpression).operand)
            case ts.SyntaxKind.BinaryExpression:
                if (isAssignmentOp((node as ts.BinaryExpression).operatorToken.kind)) {
                    return true
                }
                return hasEffects((node as ts.BinaryExpression).left) || hasEffects((node as ts.BinaryExpression).right)
            case ts.SyntaxKind.ConditionalExpression:
                return hasEffects((node as ts.ConditionalExpression).condition) || hasEffects((node as ts.ConditionalExpression).whenTrue) || hasEffects((node as ts.ConditionalExpression).whenFalse)
            case ts.SyntaxKind.TrueKeyword:
            case ts.SyntaxKind.FalseKeyword:
            case ts.SyntaxKind.NullKeyword:
            case ts.SyntaxKind.UndefinedKeyword:
            case ts.SyntaxKind.NumericLiteral:
            case ts.SyntaxKind.StringLiteral: 
                return false
        }
        return true
    }

    function isDeadCode(node: ts.Node) {
        // extremely simple DCE, don't expect much from it
        switch (node.kind) {
            case ts.SyntaxKind.ExpressionStatement:
                return !hasEffects((node as ts.ExpressionStatement).expression)
        }
        return !hasEffects(node)
    }

    function maxRegAllocsNeeded(exp: ts.Expression): number {
        if (const r = tryFoldExp(exp)) {
            if (r[0] === 'value') return 0
            return maxRegAllocsNeeded(r[1]) // residual
        }

        // isFirstOperand can be set when we know we will always spill anyway
        function visit(n: ts.Expression, isAcc = false): number {
            switch (n.kind) {
                case ts.SyntaxKind.NumericLiteral:
                case ts.SyntaxKind.StringLiteral: 
                case ts.SyntaxKind.TrueKeyword:
                case ts.SyntaxKind.FalseKeyword:
                case ts.SyntaxKind.NullKeyword:
                case ts.SyntaxKind.UndefinedKeyword:
                    return isAcc ? 0 : 1 // need a tmp to spill

                case ts.SyntaxKind.ArrayLiteralExpression:
                    const elements = (n as ts.ArrayLiteralExpression).elements
                    let inner = 0
                    for (const x of elements) {
                        if (ts.isSpreadElement(x)) {
                            throw `Unhandled array element kind: ${ts.SyntaxKind[x.kind]}`
                        }
                        inner = Math.max(inner, 1 + visit(x, true))
                    }
                    return (isAcc ? 0 : 1) + inner

                case ts.SyntaxKind.ObjectLiteralExpression:
                    const properties = (n as ts.ObjectLiteralExpression).properties
                    let inner = 0
                    for (const x of properties) {
                        if (ts.isShorthandPropertyAssignment(x)) {
                            inner = Math.max(inner, isLexicalIdent(x.name) ? 0 : 1)
                            continue
                        }
                        if (ts.isPropertyAssignment(x)) {
                            // FIXME: computed names
                            inner = Math.max(inner, 1 + visit(x.initializer, true))
                            continue
                        }
                        throw `Unhandled property kind: ${ts.SyntaxKind[x.kind]}`
                    }
                    return (isAcc ? 0 : 1) + inner

                case ts.SyntaxKind.Identifier:
                    if (isAcc) return 0
                    return isLexicalIdent(n) ? 0 : 1
                case ts.SyntaxKind.AwaitExpression:
                    return 1 // assumes we need to spill acc
                case ts.SyntaxKind.ParenthesizedExpression: 
                    return visit((n as ts.ParenthesizedExpression).expression, isAcc)
                case ts.SyntaxKind.BinaryExpression:
                    const bin = n as ts.BinaryExpression
                    if (isLogicalOp(bin.operatorToken.kind)) {
                        // no spill
                        return Math.max(visit(bin.left, isAcc), visit(bin.right, isAcc))
                    }
                    const l = visit(bin.left, false)
                    const r = visit(bin.right, false)
                    if (r === 0) return l
                    return Math.max(Math.max(l-1, 0), Math.max(r, 0) + (isCommutativeBinaryExp(bin.operatorToken.kind) ? 0 : 1)) + (isAcc ? 1 : 0)
                case ts.SyntaxKind.PrefixUnaryExpression:
                case ts.SyntaxKind.PostfixUnaryExpression:
                    const operand = (n as ts.PrefixUnaryExpression | ts.PostfixUnaryExpression).operand
                    const operator = (n as ts.PrefixUnaryExpression | ts.PostfixUnaryExpression).operator
                    if (!isAssignmentUnary(operator)) return visit(operand, isAcc)
                    return visit(operand, isAcc) + 1
                case ts.SyntaxKind.CallExpression:
                    const subj = (n as ts.CallExpression).expression
                    const args = (n as ts.CallExpression).arguments
                    const argMax = Math.max(...args.map(x => Math.max(0, maxRegAllocsNeeded(x)-1)))
                    if (findConstPoolSlot(subj) !== undefined) {
                        return argMax + args.length + (isAcc ? 0 : 1)
                    }
                    const l = maxRegAllocsNeeded(subj)
                    return 1 + args.length + Math.max(l, argMax) + (isAcc ? 0 : 1)
                case ts.SyntaxKind.ConditionalExpression:
                    const x = n as ts.ConditionalExpression
                    return Math.max(visit(x.condition, isAcc), visit(x.whenTrue, isAcc), visit(x.whenFalse, isAcc))

                default: throw `Unhandled exp kind: ${ts.SyntaxKind[n.kind]}`
            }
        }
        return visit(exp, true)
    }

    function mapBinaryOp(kind: ts.SyntaxKind): number {
        switch (kind) {
            case ts.SyntaxKind.PlusToken: return Op.Add
            case ts.SyntaxKind.MinusToken: return Op.Sub
            case ts.SyntaxKind.AsteriskToken: return Op.Mul
            case ts.SyntaxKind.SlashToken: return Op.Div
            case ts.SyntaxKind.PercentToken: return Op.Mod
            case ts.SyntaxKind.AsteriskAsteriskToken: return Op.Exp
            case ts.SyntaxKind.AmpersandToken: return Op.BitAnd
            case ts.SyntaxKind.BarToken: return Op.BitOr
            case ts.SyntaxKind.CaretToken: return Op.BitXor
            case ts.SyntaxKind.LessThanLessThanToken: return Op.ShiftLeft
            case ts.SyntaxKind.GreaterThanGreaterThanToken: return Op.ShiftRight
            case ts.SyntaxKind.GreaterThanGreaterThanGreaterThanToken: return Op.ShiftRightLogical
            case ts.SyntaxKind.LessThanToken: return Op.TestLessThan
            case ts.SyntaxKind.GreaterThanToken: return Op.TestGreaterThan
            case ts.SyntaxKind.LessThanEqualsToken: return Op.TestLessThanOrEqual
            case ts.SyntaxKind.GreaterThanEqualsToken: return Op.TestGreaterThanOrEqual
            case ts.SyntaxKind.ExclamationEqualsToken:
            case ts.SyntaxKind.ExclamationEqualsEqualsToken: return Op.TestNotStrictEqual
            case ts.SyntaxKind.EqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsEqualsToken: return Op.TestStrictEqual
            default: throw `unsupported binary operator: ${ts.SyntaxKind[kind]}`
        }
    }

    function tryFoldInts(kind: ts.SyntaxKind, lv: number, rv: number): number {
        switch (kind) {
            case ts.SyntaxKind.PlusToken: return lv + rv
            case ts.SyntaxKind.MinusToken: return lv - rv
            case ts.SyntaxKind.AsteriskToken: return Math.imul(lv, rv)
            case ts.SyntaxKind.AmpersandToken: return lv & rv
            case ts.SyntaxKind.BarToken: return lv | rv
            case ts.SyntaxKind.CaretToken: return lv ^ rv
            case ts.SyntaxKind.LessThanLessThanToken: return lv << rv
            case ts.SyntaxKind.GreaterThanGreaterThanToken: return lv >> rv
            case ts.SyntaxKind.GreaterThanGreaterThanGreaterThanToken: return lv >>> rv
            case ts.SyntaxKind.LessThanToken: return lv < rv ? 1 : 0
            case ts.SyntaxKind.GreaterThanToken: return lv > rv ? 1 : 0
            case ts.SyntaxKind.LessThanEqualsToken: return lv <= rv ? 1 : 0
            case ts.SyntaxKind.GreaterThanEqualsToken: return lv >= rv ? 1 : 0
            case ts.SyntaxKind.EqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsEqualsToken: return lv === rv ? 1 : 0
            case ts.SyntaxKind.ExclamationEqualsToken:
            case ts.SyntaxKind.ExclamationEqualsEqualsToken: return lv !== rv ? 1 : 0
            case ts.SyntaxKind.SlashToken:
                if (rv === 0) throw `Invalid expression: ${lv} / ${rv}`
                return Math.trunc(lv / rv) // idiv
            case ts.SyntaxKind.PercentToken:
                if (rv === 0) throw `Invalid expression: ${lv} % ${rv}`
                return lv % rv
            case ts.SyntaxKind.AsteriskAsteriskToken:
                const res = lv**rv
                if (!Number.isInteger(res)) throw `Invalid expression: ${lv} ** ${rv} = ${res}`
                return res
            default: throw "not foldable"
        }
    }

    function isFoldable(kind: ts.SyntaxKind): boolean {
        switch (kind) {
            // these are only foldable in native mode (we throw here if it would produce NaN)
            case ts.SyntaxKind.SlashToken:
            case ts.SyntaxKind.PercentToken:
                return true
            case ts.SyntaxKind.CommaToken: return false
            case ts.SyntaxKind.PlusEqualsToken:
            case ts.SyntaxKind.MinusEqualsToken:
            case ts.SyntaxKind.SlashEqualsToken:
            case ts.SyntaxKind.AsteriskEqualsToken:
            case ts.SyntaxKind.AmpersandEqualsToken:
            case ts.SyntaxKind.BarEqualsToken:
            case ts.SyntaxKind.CaretEqualsToken:
            case ts.SyntaxKind.QuestionQuestionEqualsToken:
            case ts.SyntaxKind.BarBarEqualsToken:
            case ts.SyntaxKind.AmpersandAmpersandEqualsToken:
            case ts.SyntaxKind.EqualsToken:
                return false
            default: return true
        }
    }

    function isLogicalOp(kind: ts.SyntaxKind): boolean {
        return kind === ts.SyntaxKind.BarBarToken || kind === ts.SyntaxKind.AmpersandAmpersandToken || kind === ts.SyntaxKind.QuestionQuestionToken
    }

    let foldDepth = 0 // so we can cache intermediate failures on the way back up
    let foldMaxDepth = 0
    const foldedResults = new Map<ts.Expression, FoldResult | false>()
    type FoldResultValue = string | number | boolean | undefined | null
    type FoldResult = 
        | [kind: 'value', value: FoldResultValue]
        | [kind: 'residual', node: ts.Expression]
    function tryFoldExp(node: ts.Expression): FoldResult | undefined {
        if (ts.isParenthesizedExpression(node)) {
            return tryFoldExp(node.expression)
        }
        if (ts.isNumericLiteral(node)) {
            const val = (node as any).getf64()
            return ['value', val]
        }
        if (ts.isStringLiteral(node)) {
            return ['value', node.text]
        }
        if (node.kind === ts.SyntaxKind.TrueKeyword) {
            return ['value', true]
        }
        if (node.kind === ts.SyntaxKind.FalseKeyword) {
            return ['value', false]
        }
        if (node.kind === ts.SyntaxKind.NullKeyword) {
            return ['value', null]
        }
        if (node.kind === ts.SyntaxKind.UndefinedKeyword) {
            return ['value', undefined]
        }
        if (const r = foldedResults.get(node)) return r ? r : undefined

        const isTop = foldDepth === 0
        defer foldMaxDepth = isTop ? 0 : Math.max(foldMaxDepth, foldDepth)

        foldDepth += 1
        defer foldDepth -= 1

        function tryGetNumber(opKind: ts.SyntaxKind, n: ts.Expression) {
            const v = tryFoldExp(n)
            if (!v || v[0] === 'residual') return
            const operand = v[1]
            if (typeof operand !== 'number') throw `Unexpected operand: ${ts.SyntaxKind[opKind]} ${operand}`
            return operand
        }

        function tryGetAnyValue(n: ts.Expression) {
            const v = tryFoldExp(n)
            if (!v || v[0] === 'residual') return
            return v
        }

        function fold(): FoldResult | undefined  {
            if (ts.isConditionalExpression(node)) {
                const cond = tryFoldExp(node.condition)
                if (!cond || cond[0] === 'residual') return
                if (cond[1]) {
                    return tryFoldExp(node.whenTrue) ?? ['residual', node.whenTrue]
                }
                return tryFoldExp(node.whenFalse) ?? ['residual', node.whenFalse]
            } else if (ts.isBinaryExpression(node)) {
                const opKind = node.operatorToken.kind
                if (!isFoldable(opKind)) return
                const v1 = tryFoldExp(node.left)
                if (!v1 || v1[0] === 'residual') return
                const l = v1[1]

                if (isLogicalOp(opKind)) {
                    if (opKind === ts.SyntaxKind.BarBarToken) {
                        if (l) return ['value', l]
                        return tryFoldExp(node.right) ?? ['residual', node.right]
                    }
                    if (opKind === ts.SyntaxKind.AmpersandAmpersandToken) {
                        if (!l) return ['value', l]
                        return tryFoldExp(node.right) ?? ['residual', node.right]
                    }
                    if (opKind === ts.SyntaxKind.QuestionQuestionToken) {
                        if (l !== undefined && l !== null) return ['value', l]
                        return tryFoldExp(node.right) ?? ['residual', node.right]
                    }
                }

                const v2 = tryFoldExp(node.right)
                if (!v2 || v2[0] === 'residual') {
                    return
                }
                const r = v2[1]

                if (opKind === ts.SyntaxKind.EqualsEqualsEqualsToken || opKind === ts.SyntaxKind.EqualsEqualsToken) {
                    return ['value', l === r]
                }
                if (opKind === ts.SyntaxKind.ExclamationEqualsEqualsToken || opKind === ts.SyntaxKind.ExclamationEqualsToken) {
                    return ['value', l !== r]
                }

                if (typeof l === 'string' || typeof r === 'string') {
                    intrinsics.assert(opKind === ts.SyntaxKind.PlusToken)
                    return ['value', l + (r as string)]
                }
                if (typeof l === 'number' && typeof r === 'number') {
                    intrinsics.assert(Number.isInteger(l) && Number.isInteger(r))
                    return ['value', tryFoldInts(opKind, l, r)]
                }

                throw `Unexpected operands: ${l} ${ts.SyntaxKind[opKind]} ${r}`
            } else if (ts.isPrefixUnaryExpression(node)) {
                const opKind = node.operator
                if (opKind === ts.SyntaxKind.MinusToken) {
                    if (const v = tryGetNumber(opKind, node.operand)) {
                        return ['value', -v]
                    }
                } else if (opKind === ts.SyntaxKind.TildeToken) {
                    if (const v = tryGetNumber(opKind, node.operand)) {
                        return ['value', ~v]
                    }
                } else if (opKind === ts.SyntaxKind.ExclamationToken) {
                    if (const v = tryGetAnyValue(node.operand)) {
                        return ['value', !v]
                    }
                }
            } else if (ts.isIdentifier(node)) {
                const symId = getSymbolId(node)
                if (!symId) return
                if (const x = foldedVariables.get(symId)) {
                    return ['value', x[0]]
                }
            }
        }

        const r = fold()
        if (!r) {
            if ((foldMaxDepth - foldDepth) >= 3) foldedResults.set(node, false)
            return
        }
        foldedResults.set(node, r)
        return r
    }

    function isCommutativeBinaryExp(kind: ts.SyntaxKind): boolean {
        switch (kind) {
            case ts.SyntaxKind.PlusToken:
            case ts.SyntaxKind.AsteriskToken:
            case ts.SyntaxKind.AmpersandToken:
            case ts.SyntaxKind.BarToken:
            case ts.SyntaxKind.CaretToken:
            case ts.SyntaxKind.ExclamationEqualsToken:
            case ts.SyntaxKind.ExclamationEqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsToken:
            case ts.SyntaxKind.EqualsEqualsEqualsToken:
                return true
            default:
                return false
        }
    }

    // `x <op>= e` -> the binary op behind the compound assignment
    function compoundBinaryOp(kind: ts.SyntaxKind): number {
        switch (kind) {
            case ts.SyntaxKind.PlusEqualsToken: return Op.Add
            case ts.SyntaxKind.MinusEqualsToken: return Op.Sub
            case ts.SyntaxKind.AsteriskEqualsToken: return Op.Mul
            case ts.SyntaxKind.SlashEqualsToken: return Op.Div
            case ts.SyntaxKind.PercentEqualsToken: return Op.Mod
            case ts.SyntaxKind.AsteriskAsteriskEqualsToken: return Op.Exp
            case ts.SyntaxKind.AmpersandEqualsToken: return Op.BitAnd
            case ts.SyntaxKind.BarEqualsToken: return Op.BitOr
            case ts.SyntaxKind.CaretEqualsToken: return Op.BitXor
            case ts.SyntaxKind.LessThanLessThanEqualsToken: return Op.ShiftLeft
            case ts.SyntaxKind.GreaterThanGreaterThanEqualsToken: return Op.ShiftRight
            case ts.SyntaxKind.GreaterThanGreaterThanGreaterThanEqualsToken: return Op.ShiftRightLogical
            default: throw `unsupported compound assignment: ${ts.SyntaxKind[kind]}`
        }
    }

    function isAssignmentOp(kind: ts.SyntaxKind): boolean {
        return kind >= ts.SyntaxKind.FirstAssignment && kind <= ts.SyntaxKind.LastAssignment
    }

    function finishPropertyAccessAssignment(
        node: ts.BinaryExpression,
        getOp: number,
        setOp: number,
        robj: number,
        keySlot: number,
    ) {
        const kind = node.operatorToken.kind
        if (kind === ts.SyntaxKind.EqualsToken) {
            emitExpr(node.right) // acc = value
            emit3(setOp, robj, keySlot)
            return
        }

        const op = compoundBinaryOp(kind)
        if (isLexicalIdent(node.right)) {
            ldar(robj)
            emit2(getOp, keySlot) // acc = obj[key]
            emit2(op, symToReg.get(getSymbolId(node.right))!)
        } else {
            emitExpr(node.right)
            const rR = allocReg(); star(rR)
            ldar(robj)
            emit2(getOp, keySlot) // acc = obj[key]
            emit2(op, rR)
            freeReg()
        }
        emit3(setOp, robj, keySlot)
    }

    function emitPropertyAccessAssignment(
        node: ts.BinaryExpression, 
        target: ts.PropertyAccessExpression | ts.ElementAccessExpression
    ) {
        if (target.questionDotToken) throw `optional chaining assignment is not supported`
        const isConstName = target.kind === ts.SyntaxKind.PropertyAccessExpression        
        
        emitExpr(target.expression) // acc = object
        const robj = allocReg(); star(robj)
        defer freeReg()

        const keySlot = isConstName ? internString(target.name.text) : allocReg()
        defer if (!isConstName) freeReg()

        if (!isConstName) {
            if (const val = tryFoldExp(target.argumentExpression)) {
                if (val[0] === 'value' && typeof val[1] === 'string') {
                    return finishPropertyAccessAssignment(
                        node,
                        Op.GetPropertyConst,
                        Op.SetPropertyConst,
                        robj,
                        internValue(val[1]),
                    )
                }
            }
            emitExpr(target.argumentExpression)
            star(keySlot)
        }

        finishPropertyAccessAssignment(
            node,
            isConstName ? Op.GetPropertyConst : Op.GetProperty,
            isConstName ? Op.SetPropertyConst : Op.SetProperty,
            robj,
            keySlot,
        )
    }

    function emitAssignment(node: ts.BinaryExpression) {
        const target = node.left
        if (ts.isPropertyAccessExpression(target) || ts.isElementAccessExpression(target)) {
            emitPropertyAccessAssignment(node, target)
            return
        }
        if (!ts.isIdentifier(target)) throw `unsupported assignment target: ${ts.SyntaxKind[target.kind]}`
        const symId = getSymbolId(target)
        if (symId === 0) throw `non-lexical assignment target: ${target.getText()}`
        if (isLateBoundSymbol(target)) throw `cannot assign to free variable: ${target.getText()}`
        const reg = symToReg.get(symId)
        if (reg === undefined) {
            if (foldedVariables.has(symId)) throw `cannot assign to const binding: ${target.getText()}`
            throw `unresolved assignment target: ${target.getText()}`
        }

        const kind = node.operatorToken.kind
        if (kind === ts.SyntaxKind.EqualsToken) {
            emitExpr(node.right)       // acc = rhs
            star(reg)        // target = acc
            return
        }

        const op = compoundBinaryOp(kind)
        if (isLexicalIdent(node.right)) {
            ldar(reg)
            emit2(op, symToReg.get(getSymbolId(node.right))!)
        } else {
            emitExpr(node.right)
            const rR = allocReg(); star(rR)
            ldar(reg)
            emit2(op, rR)
            freeReg()
        }
        star(reg)
    }

    function emitPropertyAccess(node: ts.PropertyAccessExpression | ts.ElementAccessExpression, receiverReg?: number, shouldSpillRecv = true) {
        if (node.questionDotToken) throw `optional chaining is not supported`

        emitExpr(node.expression) // acc = object

        if (receiverReg === undefined && isLexicalIdent(node.expression)) {
            receiverReg = symToReg.get(getSymbolId(node))!
            shouldSpillRecv = false
        }

        if (receiverReg !== undefined && shouldSpillRecv) star(receiverReg)

        const isConstName = node.kind === ts.SyntaxKind.PropertyAccessExpression
        const keySlot = isConstName ? internString(node.name.text) : allocReg()
        defer if (!isConstName) freeReg()

        let spilledRecv: number | undefined
        defer if (spilledRecv) freeReg()

        if (!isConstName) {
            if (const val = tryFoldExp(node.argumentExpression)) {
                if (val[0] === 'value' && typeof val[1] === 'string') {
                    return emit2(Op.GetPropertyConst, internValue(val[1]))
                }
            }
            if (isLexicalIdent(node.argumentExpression)) {
                return emit2(Op.GetProperty, symToReg.get(getSymbolId(node.argumentExpression))!)
            }
            if (receiverReg === undefined && shouldSpillRecv) {
                spilledRecv = allocReg()
                star(spilledRecv)
            }
            emitExpr(node.argumentExpression)
            star(keySlot)
        }

        if (!isConstName && shouldSpillRecv) ldar(spilledRecv ?? receiverReg!)
        emit2(isConstName ? Op.GetPropertyConst : Op.GetProperty, keySlot)
    }

    function emitLogicalOp(node: ts.BinaryExpression) {
        const kind = node.operatorToken.kind
        emitExpr(node.left) // acc = left
        // `??` is treated the same as `||` in native for now
        const jumpOp = kind === ts.SyntaxKind.AmpersandAmpersandToken ? Op.JumpIfToBooleanFalse : Op.JumpIfToBooleanTrue
        const overRight = emitJumpPlaceholder(jumpOp)
        emitExpr(node.right) // acc = right
        patchJump(overRight)
    }

    function emitBinary(node: ts.BinaryExpression): void {
        const kind = node.operatorToken.kind

        if (isAssignmentOp(kind)) { emitAssignment(node); return }

        if (kind === ts.SyntaxKind.CommaToken) {
            emitExpr(node.left)
            emitExpr(node.right)
            return
        }

        if (isLogicalOp(kind)) { emitLogicalOp(node); return }

        if (ts.isNumericLiteral(node.left) && ts.isNumericLiteral(node.right) && isFoldable(kind)) {
            const lv = Number(node.left.text)
            const rv = Number(node.right.text)
            if (Number.isInteger(lv) && Number.isInteger(rv)) { emitNumber(tryFoldInts(kind, lv, rv)); return }
        }

        const op = mapBinaryOp(kind)

        if (isLexicalIdent(node.right)) {
            emitExpr(node.left)
            emit2(op, symToReg.get(getSymbolId(node.right))!)
            return
        }

        if (isLexicalIdent(node.left) && isCommutativeBinaryExp(kind)) {
            const rL = symToReg.get(getSymbolId(node.left))!
            emitExpr(node.right)
            return emit2(op, rL)
        }

        emitExpr(node.left)
        const rL = allocReg(); star(rL)
        defer freeReg()
        emitExpr(node.right)
        if (isCommutativeBinaryExp(kind)) {
            return emit2(op, rL)
        }
        const rR = allocReg(); star(rR)
        ldar(rL)
        emit2(op, rR)
        freeReg()
    }

    function isAssignmentUnary(op: ts.SyntaxKind) {
        return op === ts.SyntaxKind.PlusPlusToken || op === ts.SyntaxKind.MinusMinusToken
    }

    function emitUnaryAssignment(node: ts.PrefixUnaryExpression | ts.PostfixUnaryExpression) {
        assert(isAssignmentUnary(node.operator))
        const isPrefix = node.kind === ts.SyntaxKind.PrefixUnaryExpression
        const op = node.operator === ts.SyntaxKind.PlusPlusToken 
            ? (isPrefix ? Op.Inc : Op.IncPost) 
            : (isPrefix ? Op.Dec : Op.DecPost) 
        const operand = node.operand
        const symId = getSymbolId(operand)
        if (symId === 0) throw `non-lexical identifier: ${operand.getText()}`
        const dst = symToReg.get(symId)
        assert(dst !== undefined)
        if (!isPrefix) return emit2(op, dst)

        ldar(dst)
        emit1(op)
        star(dst)
    }

    function isLogicalNot(node: ts.Expression): node is ts.PrefixUnaryExpression {
        return ts.isPrefixUnaryExpression(node) && node.operator === ts.SyntaxKind.ExclamationToken
    }

    function prefixUnaryToOp(token: ts.SyntaxKind) {
        switch (token) {
            case ts.SyntaxKind.MinusToken: return Op.Negate
            case ts.SyntaxKind.TildeToken: return Op.BitNot
            case ts.SyntaxKind.ExclamationToken: return Op.LogicalNot
            default: throw `Unhandled unary operator: ${ts.SyntaxKind[token]}`
        }
    }

    function emitPrefixUnary(node: ts.PrefixUnaryExpression) {
        const op = node.operator
        if (isAssignmentUnary(op)) {
            return emitUnaryAssignment(node)
        }
        const operand = node.operand
        if (op === ts.SyntaxKind.ExclamationToken) {
            if (isLogicalNot(operand)) {
                emitExpr(operand.operand)
                return emit1(Op.LogicalNotNot)
            }
            emitExpr(operand)
            return emit1(Op.LogicalNot)
        }
        const op2 = prefixUnaryToOp(op)
        emitExpr(operand)
        return emit1(op2)
    }

    function emitPostfixUnary(node: ts.PostfixUnaryExpression) {
        const op = node.operator
        if (isAssignmentUnary(op)) {
            return emitUnaryAssignment(node)
        }
        console.log(ts.SyntaxKind[op])
        assert(false)
    }

    function emitIdentifier(node: ts.Identifier) {
        const symId = getSymbolId(node)
        if (symId === 0) throw `non-lexical identifier: ${node.getText()}`
        if (isLateBoundSymbol(node)) { emitLoadConst(lateBoundSlot(symId, node.getText())); return }
        const reg = symToReg.get(symId)
        if (reg !== undefined) {
            return ldar(reg)
        }
        // was folded
        const v = foldedVariables.get(symId)
        if (!v) {
            if (const slot = lateBound.get(symId)) {
                return void emitLoadConst(slot)
            }
            throw `unresolved identifier: ${node.getText()}`
        }
        return emitLiteral(v[0])
    }

    function emitObjectLiteral(node: ts.ObjectLiteralExpression): void {
        emit1(Op.CreateEmptyObject)
        const robj = allocReg()
        star(robj)
        defer freeReg()
        for (const p of node.properties) {
            let name: string
            let value: ts.Expression
            if (ts.isShorthandPropertyAssignment(p)) {
                name = p.name.text
                value = p.name
            } else if (ts.isPropertyAssignment(p) && !ts.isComputedPropertyName(p.name)) {
                name = p.name.getText().replace(/^['"]|['"]$/g, '')
                value = p.initializer
            } else {
                throw `unsupported object property: ${ts.SyntaxKind[p.kind]}`
            }
            emitExpr(value)
            emit3(Op.SetPropertyConst, robj, internString(name))
        }
        ldar(robj)
    }

    function emitExpr(node: ts.Expression): void {
        if (const r = tryFoldExp(node)) {
            if (r[0] === 'value') {
                return emitLiteral(r[1])
            }
            return emitExpr(r[1]) // residual
        }
        if (ts.isParenthesizedExpression(node)) { emitExpr(node.expression); return }
        if (node.kind === ts.SyntaxKind.ThisKeyword) {
            if (thisReg !== undefined) { ldar(thisReg); return }
            // generally should not happen?
            emitLoadConst(lateBoundSlot(getSymbolId(node), "this"))
            return
        }
        if (ts.isNumericLiteral(node)) { emitNumber(Number(node.text)); return }
        if (ts.isStringLiteral(node)) { emitLoadConst(internString(node.text)); return }
        if (ts.isIdentifier(node)) { emitIdentifier(node); return }
        if (ts.isBinaryExpression(node)) { emitBinary(node); return }
        if (ts.isPrefixUnaryExpression(node)) { emitPrefixUnary(node); return }
        if (ts.isPostfixUnaryExpression(node)) { emitPostfixUnary(node); return }
        if (ts.isConditionalExpression(node)) { emitConditionalExp(node); return }
        if (ts.isObjectLiteralExpression(node)) { emitObjectLiteral(node); return }
        if (ts.isPropertyAccessExpression(node) || ts.isElementAccessExpression(node)) { 
            return void emitPropertyAccess(node);
        }
        if (ts.isCallExpression(node) || ts.isNewExpression(node)) { 
            return void emitCallOrConstruct(node) 
        }
        throw `unsupported expression: ${ts.SyntaxKind[node.kind]}`
    }

    function emitCallArgs(
        callOp: keyof typeof Op,
        callee: number,
        args: ReadonlyArray<ts.Expression>,
        thisReg?: number
    ) {
        const saveNextReg = nextReg
        defer nextReg = saveNextReg

        const nargs = args.length
        const allocated = new Array(nargs)
        for (let i = 0; i < args.length; i++) {
            const arg = args[i]
            if (ts.isSpreadElement(arg)) throw "spread arguments are not supported"
            allocated[i] = allocReg()
        }
        for (let i = 0; i < args.length; i++) {
            emitExpr(args[i])
            star(allocated[i])
        }
        if (thisReg !== undefined) ldar(thisReg)
        else emit1(Op.LdaUndefined)
        emit4(Op[callOp], callee, saveNextReg, nargs)
    }

    function emitCallOrConstruct(node: ts.CallExpression | ts.NewExpression) {
        const isConstruct = node.kind === ts.SyntaxKind.NewExpression
        if (!isConstruct && (node as ts.CallExpression).questionDotToken) throw "optional call is not supported"
        const isTailCall = node.parent.kind === ts.SyntaxKind.ReturnStatement
        // if (const slot = findConstPoolSlot(node.expression)) {
        //     return emitCallArgs(isConstruct ? 'ConstructConst' : 'CallConst', slot, node.arguments ?? [])
        // }

        if (!isConstruct && (ts.isPropertyAccessExpression(node.expression) || ts.isElementAccessExpression(node.expression))) {
            let receiverReg = allocReg()
            const originalRecv = receiverReg
            defer if (originalRecv === receiverReg) freeReg()

            if (isLexicalIdent(node.expression.expression)) {
                freeReg()
                receiverReg = symToReg.get(getSymbolId(node.expression.expression))!
                emitPropertyAccess(node.expression, receiverReg, false)
            } else {
                emitPropertyAccess(node.expression, receiverReg) // acc = method, receiverReg = `o`
            }

            const rCallee = allocReg()
            defer freeReg()

            star(rCallee)

            return emitCallArgs('Call', rCallee, node.arguments ?? [], receiverReg)
        }

        emitExpr(node.expression) // callee -> acc
        const rCallee = allocReg()
        defer freeReg()

        star(rCallee)

        return emitCallArgs(isConstruct ? 'Construct' : 'Call', rCallee, node.arguments ?? [])
    }

    function emitVariableDecl(decl: ts.VariableDeclaration, isConst = false) {
        if (!ts.isIdentifier(decl.name)) throw "destructuring bindings are not supported"
        const symId = getSymbolId(decl.name)
        if (symId === 0) throw "binding has no symbol id"
        if (isConst) {
            if (tryFoldVariableDecl(decl)) return
        }
        if (!isReferencedSymbol(decl.name)) {
            if (decl.initializer) emitSideEffect(decl.initializer)
            return
        }
        const reg = allocReg()
        symToReg.set(symId, reg)
        if (decl.initializer) { 
            emitExpr(decl.initializer)
            star(reg)
        }
    }

    function emitVariableStatement(node: ts.VariableStatement) {
        const isConst = !!ts.getModifiers(node)?.find(x => x.kind === ts.SyntaxKind.ConstKeyword)
        for (const decl of node.declarationList.declarations) {
            emitVariableDecl(decl, isConst)
        }
    }

    function emitSideEffect(n: ts.Node) {
        if (isDeadCode(n)) return
        if (ts.isExpressionStatement(n)) { emitExpr(n.expression); return }
        emitExpr(n as ts.Expression)
    }

    function emitBlock(node: ts.Block) {
        const savedReg = nextReg
        for (const s of node.statements) emitStatement(s)
        nextReg = savedReg
    }

    function emitConditionalExp(node: ts.ConditionalExpression) {
        emitExpr(node.condition)
        const overTrue = emitJumpPlaceholder(Op.JumpIfToBooleanFalse)
        emitExpr(node.whenTrue)
        const whenFalse = emitJumpPlaceholder(Op.Jump)
        patchJump(overTrue)
        emitExpr(node.whenFalse)
        patchJump(whenFalse)
    }

    function emitIf(node: ts.IfStatement) {
        const c = tryFoldExp(node.expression)
        if (c && c[0] === 'value') {
            if (c[1]) emitStatement(node.thenStatement)
            else if (node.elseStatement) emitStatement(node.elseStatement)
            return
        }

        emitExpr(node.expression)
        const overThen = emitJumpPlaceholder(Op.JumpIfToBooleanFalse)
        emitStatement(node.thenStatement)
        // TODO: we don't need this if the branches exit
        skipNextLookbehind = true
        if (node.elseStatement) {
            const overElse = emitJumpPlaceholder(Op.Jump)
            patchJump(overThen)
            emitStatement(node.elseStatement)
            patchJump(overElse)
            skipNextLookbehind = true
        } else {
            patchJump(overThen)
        }
    }

    function emitWhile(node: ts.WhileStatement) {
        const c = tryFoldExp(node.expression)
        if (c && c[0] === 'value' && !c[1]) return

        const saveLabels = labels
        defer labels = saveLabels
        const ctx = { breaks: [], continues: [], continueTarget: -1 }
        labels = ctx
        skipNextLookbehind = true

        if (c && c[0] === 'value') {
            // unconditional
            const bodyTop = code.length
            ctx.continueTarget = bodyTop
            emitStatement(node.statement)
            emitJumpTo(Op.Jump, bodyTop)
        } else {
            const toTest = emitJumpPlaceholder(Op.Jump)
            const bodyTop = code.length
            emitStatement(node.statement)
            patchJump(toTest)
            for (const p of ctx.continues) patchJump(p) 
            emitExpr(node.expression)
            emitJumpTo(Op.JumpIfToBooleanTrue, bodyTop)
        }

        for (const p of ctx.breaks) patchJump(p) 
    }

    function emitFor(node: ts.ForStatement) {
        const savedReg = nextReg
        defer nextReg = savedReg 

        if (node.initializer) {
            if (ts.isVariableDeclarationList(node.initializer)) {
                for (const decl of node.initializer.declarations) {
                    if (!ts.isIdentifier(decl.name)) throw "destructuring bindings are not supported"
                    const symId = getSymbolId(decl.name)
                    if (symId === 0) throw "binding has no symbol id"
                    const reg = allocReg()
                    symToReg.set(symId, reg)
                    if (decl.initializer) { emitExpr(decl.initializer); star(reg) }
                }
            } else {
                emitSideEffect(node.initializer)
            }
        }

        const c = node.condition ? tryFoldExp(node.condition) : undefined
        if (c && c[0] === 'value' && !c[1]) return // for (...; false; ...)
        const condAlwaysTrue = !node.condition || (c && c[0] === 'value')

        const saveLabels = labels
        defer labels = saveLabels
        const ctx = { breaks: [], continues: [], continueTarget: -1 }
        labels = ctx
        skipNextLookbehind = true

        if (condAlwaysTrue) {
            const bodyTop = code.length
            emitStatement(node.statement)
            for (const p of ctx.continues) patchJump(p) // continue -> update
            if (node.incrementor) emitSideEffect(node.incrementor)
            emitJumpTo(Op.Jump, bodyTop)
        } else {
            const toTest = emitJumpPlaceholder(Op.Jump)
            const bodyTop = code.length
            emitStatement(node.statement)
            for (const p of ctx.continues) patchJump(p) // continue -> update
            if (node.incrementor) emitSideEffect(node.incrementor)
            patchJump(toTest)
            emitExpr(node.condition!)
            emitJumpTo(Op.JumpIfToBooleanTrue, bodyTop)
        }

        for (const p of ctx.breaks) patchJump(p) // break -> after loop
    }

    // TODO: `finally` which requires swapping out subsequent control flow labels w/ jumps
    function emitTryStatement(node: ts.TryStatement) {
        if (node.finallyBlock) throw "TODO: finally block"
        const extras = getExtraLabels()
        const range: EhRange = {
            start: code.length,
            end: 0,
            handler: 0,
        }
        emitBlock(node.tryBlock)
        range.end = code.length
        // FIXME: we don't need a jump if the block ends with an unconditional jump
        const handleEnd = extras.jump.length
        emit2(Op.JumpLabel, handleEnd)

        if (!node.catchClause) {
            range.handler = code.length
            emit1(Op.ReThrow)
            extras.jump[handleEnd] = code.length
        } else {
            prevStoreOffset = -1 // acc was clobbered
            range.handler = code.length
            const decl = node.catchClause.variableDeclaration
            if (decl) {
                emitVariableDecl(decl)
                star(symToReg.get(getSymbolId(decl.name))!)
            }
            emitBlock(node.catchClause.block)
            extras.jump[handleEnd] = code.length
        }

        extras.eh.push(range)
    }

    function emitSwitch(node: ts.SwitchStatement) {
        
    }

    function emitStatement(node: ts.Statement) {
        if (isDeadCode(node)) return
        if (ts.isReturnStatement(node)) {
            if (node.expression) emitExpr(node.expression)
            else emit1(Op.LdaUndefined) // clobber
            emit1(Op.Return)
            return
        }
        if (ts.isExpressionStatement(node)) { emitExpr(node.expression); return }
        if (ts.isVariableStatement(node)) { emitVariableStatement(node); return }
        if (ts.isBlock(node)) { emitBlock(node); return }
        if (ts.isIfStatement(node)) { emitIf(node); return }
        if (ts.isWhileStatement(node)) { emitWhile(node); return }
        if (ts.isForStatement(node)) { emitFor(node); return }
        if (ts.isBreakStatement(node)) {
            if (node.label) throw "labeled break is not supported"
            emitBreak(); return
        } else if (ts.isContinueStatement(node)) {
            if (node.label) throw "labeled continue is not supported"
            emitContinue(); return
        } else if (ts.isTryStatement(node)) {
            return void emitTryStatement(node)
        } else if (ts.isThrowStatement(node)) {
            emitExpr(node.expression)
            return void emit1(Op.Throw)
        }
        if (ts.isFunctionDeclaration(node)) throw "nested function declarations are not supported"
        throw `unsupported statement: ${ts.SyntaxKind[node.kind]}`
    }

    function emitDefaultInit(exp: ts.Expression, reg: number, effectOnly = false) {
        ldar(reg)
        const ph = emitJumpPlaceholder(Op.JumpIfNotUndefined)
        emitExpr(exp)
        if (!effectOnly) star(reg)
        patchJump(ph)
    }

    let defaultInitIndex = -1
    for (let i = 0; i < fn.parameters.length; i++) {
        const p = fn.parameters[i]
        if (!ts.isIdentifier(p.name)) throw "destructuring parameters are not supported"
        if (p.dotDotDotToken) throw "rest parameters are not supported"
        if (p.initializer && defaultInitIndex === -1) defaultInitIndex = i
        // we have to assign it even if unused
        const reg = allocReg()
        symToReg.set(getSymbolId(p.name), reg)
    }
    if (defaultInitIndex !== -1) {
        for (let i = defaultInitIndex; i < fn.parameters.length; i++) {
            const p = fn.parameters[i]
            assert(p.initializer)
            const name = p.name as ts.Identifier
            const reg = symToReg.get(getSymbolId(name))!
            if (!isReferencedSymbol(name)) {
                if (hasEffects(p.initializer)) {
                    emitDefaultInit(p.initializer, reg, true)
                }
                continue
            }
            emitDefaultInit(p.initializer, reg)
        }
    }
    // `freeReg` pops, so only a run of unused parameters at the end can be given back
    for (let i = fn.parameters.length-1; i >= 0; i--) {
        if (isReferencedSymbol(fn.parameters[i].name as any)) break
        freeReg()
    }

    if (usesThisBinding(fn)) {
        skipNextLookbehind = true
        thisReg = allocReg()
        star(thisReg)
    }

    let selfSlot: number | undefined
    if (!ts.isArrowFunction(fn) && fn.name && isReferencedSymbol(fn.name)) {
        const slot = lateBoundSlot(getSymbolId(fn.name), fn.name.text, ConstantKind.function_)
        selfSlot = slot
    }

    if (!fn.body) throw "function has no body"
    if (ts.isBlock(fn.body)) {
        emitBlock(fn.body)
    } else {
        emitExpr(fn.body) // arrow fn
    }

    if (code.at(-1) !== Op.Return) {
        emit1(Op.Return)
    }

    assert(constants.length === constantKinds.length)

    return {
        code,
        constants,
        constantKinds,
        paramCount: fn.parameters.length,
        registerCount: maxReg,
        lateBound,
        selfSlot,
        labels: extraLabels,
    }
}

function unwrapParensOrExpStatement(node: ts.Node) {
    if (ts.isParenthesizedExpression(node) || ts.isExpressionStatement(node)) {
        return unwrapParensOrExpStatement(node.expression)
    }
    return node
}

// very hacky but good enough
function fixupMethodLikeDecl(src: string) {
    src = src.trim()
    if (src.startsWith('export default ')) src = src.slice(15).trimStart()
    else if (src.startsWith('export ')) src = src.slice(7).trimStart()
    if (src.startsWith('get ') || src.startsWith('set ')) src = src.slice(4)
    if (src.startsWith('function')) return src
    if (src.startsWith('(')) return src
    if (src.startsWith('async')) return src // todo: async method fixup
    return `function ${src}`
}

export function compile(src: string): EmitResult {
    const sf = ts.createSourceFile('input.js', fixupMethodLikeDecl(src), ts.ScriptTarget.Latest)
    const fn = sf.statements[0]
    if (!fn) throw "found no statements in source"
    const exp = unwrapParensOrExpStatement(fn)
    if (ts.isArrowFunction(exp) || ts.isFunctionExpression(exp)) {
        return emitFunction(exp)
    }
    if (!ts.isFunctionDeclaration(fn)) 
        throw "expected the source to be a single function declaration/expression"
    return emitFunction(fn)
}

const OpNames: Record<number, string> = {}
for (const [name, val] of Object.entries(Op)) OpNames[val as number] = name

const ImmOps = new Set([Op.LdaImm])
const ConstOps = new Set([Op.LdaConst, Op.GetPropertyConst, Op.SetPropertyConst])
export const ConditionalJumpOps = new Set([Op.JumpIfNull, Op.JumpIfUndefined, Op.JumpIfNullish, Op.JumpIfNotUndefined, Op.JumpIfNotNull, Op.JumpIfNotNullish, Op.JumpIfToBooleanTrue, Op.JumpIfToBooleanFalse])
const JumpOps = new Set([Op.Jump, ...ConditionalJumpOps])

const RegOperandCounts: Record<number, number> = {
    [Op.Mov]: 2,
    [Op.Star]: 1,
    [Op.Ldar]: 1,
    [Op.Add]: 1, [Op.Sub]: 1, [Op.Mul]: 1, [Op.Div]: 1, [Op.Mod]: 1, [Op.Exp]: 1,
    [Op.BitOr]: 1, [Op.BitAnd]: 1, [Op.BitXor]: 1,
    [Op.ShiftLeft]: 1, [Op.ShiftRight]: 1, [Op.ShiftRightLogical]: 1,
    [Op.TestNotStrictEqual]: 1, [Op.TestStrictEqual]: 1,
    [Op.TestLessThan]: 1, [Op.TestGreaterThan]: 1,
    [Op.TestLessThanOrEqual]: 1, [Op.TestGreaterThanOrEqual]: 1,
    [Op.IncPost]: 1, [Op.DecPost]: 1,
    [Op.GetProperty]: 1,
    [Op.SetProperty]: 2,
    [Op.SetPropertyConst]: 1,
}

export type CodeInstruction = {
    pos: usize
    width: 1 | 2 | 4 | 8
    opcode: number
    opname: string
    regs: number[]          // register operands, in order
    imm?: number            // decoded value (sign-extended)
    constSlot?: number      // decoded constant pool slot,
    jumpOffset?: number     // decoded relative jump offset
    jumpTarget?: usize      // absolute byte offset the jump lands on
    jumpLabel?: number      // slots into the labeled jump table
    copyTo?: number
    readsAcc?: boolean
    writesAcc?: boolean
}

export function createCodeIterator(bytes: readonly u8[]) {
    let cursor = 0

    function readByte(): number {
        const b = bytes[cursor]
        cursor = cursor + 1
        return b
    }
    function readSigned(width: 1 | 2 | 4 | 8): number {
        if (width === 8) throw "todo: 8 wide"
        let v = 0
        for (let i = 0; i < width; i++) v = v | (readByte() << (8 * i))
        const bits = width * 8
        const signBit = 1 << (bits - 1)
        return (v ^ signBit) - signBit
    }
    function readUnsigned(width: 1 | 2 | 4 | 8): number {
        if (width === 8) throw "todo: 8 wide"
        let v = 0
        for (let i = 0; i < width; i++) v = v | (readByte() << (8 * i))
        return v >>> 0
    }

    function next(): CodeInstruction | undefined {
        if (cursor === bytes.length) return

        const pos = cursor as usize
        let width: 1 | 2 | 4 | 8 = 1
        let opcode = readByte()
        if (opcode === Op.Width2) { width = 2; opcode = readByte() }
        else if (opcode === Op.Width4) { width = 4; opcode = readByte() }
        else if (opcode === Op.Width8) { width = 8; opcode = readByte() }

        const inst: CodeInstruction = {
            pos,
            width,
            opcode,
            opname: OpNames[opcode] ?? `UNKNOWN(0x${opcode.toString(16)})`,
            regs: [],
        }

        if (opcode >= Op.Star0 && opcode <= Op.Star15) {
            inst.readsAcc = true
            inst.opname = 'Star'
            inst.regs.push(opcode - Op.Star0)
            return inst
        }
        if (opcode >= Op.Ldar0 && opcode <= Op.Ldar3) {
            inst.writesAcc = true
            inst.opname = 'Ldar'
            inst.regs.push(opcode - Op.Ldar0)
            return inst
        }
        if (opcode === Op.JumpLabel) {
            inst.jumpLabel = readUnsigned(width)
            return inst
        }
        if (opcode === Op.MovPacked) {
            inst.opname = 'Mov'
            const val = readByte()
            inst.regs.push(val & 0xF, val >> 4) // dst, src
            return inst
        }
        if (inst.opname.endsWith('Const')) {
            inst.opname = inst.opname.slice(0, -5)
        }
        if (inst.opname.startsWith('Lda')) {
            inst.writesAcc = true
        }
        if (opcode >= Op.Add && opcode <= Op.LogicalNotNot) {
            inst.readsAcc = inst.writesAcc = true
        }
        if (opcode === Op.Return || opcode === Op.Throw || opcode === Op.ReThrow) {
            inst.readsAcc = true
        }

        const regCount = RegOperandCounts[opcode]
        if (regCount !== undefined) {
            if (opcode === Op.Ldar) {
                inst.writesAcc = true
            }
            if (opcode === Op.Star) {
                inst.readsAcc = true
            }
            if (inst.opcode >= Op.GetProperty && inst.opcode <= Op.SetPropertyImm) {
                if (inst.opname.startsWith('Get')) {
                    inst.readsAcc = inst.writesAcc = true
                } else {
                    inst.readsAcc = true
                }
            }
            for (let i = 0; i < regCount; i++) inst.regs.push(width === 1 ? readByte() : readUnsigned(width))
            if (ConstOps.has(opcode)) {
                inst.constSlot = width === 8 ? undefined : readUnsigned(width as 1 | 2 | 4)
            }
            return inst
        }

        if (ImmOps.has(opcode)) {
            inst.imm = width === 8 ? undefined : readSigned(width as 1 | 2 | 4)
            return inst
        }
        if (ConstOps.has(opcode)) {
            inst.constSlot = width === 8 ? undefined : readUnsigned(width as 1 | 2 | 4)
            return inst
        }
        if (JumpOps.has(opcode)) {
            if (opcode !== Op.Jump) inst.readsAcc = true
            const off = width === 8 ? undefined : readSigned(width as 1 | 2 | 4)
            inst.jumpOffset = off
            if (off !== undefined) inst.jumpTarget = (cursor + off) as usize
            return inst
        }

        if (opcode === Op.Call || opcode === Op.Construct) {
            inst.readsAcc = inst.writesAcc = true
            inst.regs.push(readByte(), readByte()) // callee, argStart
            inst.regs.push(readByte()) // nargs
            if (inst.regs[2] === 0) {
                inst.regs.length = 1
            } else {
                inst.regs[2] += inst.regs[1]-1
            }
            return inst
        }
        if (opcode === Op.CallConst || opcode === Op.ConstructConst) {
            inst.readsAcc = inst.writesAcc = true
            inst.constSlot = readByte() 
            inst.regs.push(readByte())
            inst.regs.push(readByte())
            if (inst.regs[1] === 0) {
                inst.regs.length = 0
            } else {
                inst.regs[1] += inst.regs[0]-1
            }
            return inst
        }

        // no-operand ops
        return inst
    }

    return { next }
}

// -1 is considered the acc
export function getRegReads(inst: CodeInstruction): number[] {
    if (inst.opcode >= Op.Ldar && inst.opcode <= Op.Ldar3) {
        return inst.regs.slice()
    }
    if (inst.opcode >= Op.Star && inst.opcode <= Op.Star15) {
        return [-1]
    }
    if (inst.opcode === Op.Mov || inst.opcode === Op.MovPacked) {
        return [inst.regs[1]]
    }
    let regs: number[] = []
    if (inst.readsAcc) regs.push(-1)
    if (inst.opcode >= Op.Add && inst.opcode <= Op.DecPost) {
        regs.push(...inst.regs)
    }
    if (inst.opcode >= Op.GetProperty && inst.opcode <= Op.SetPropertyImm) {
        regs.push(...inst.regs)
    }
    if (inst.opcode === Op.Call || inst.opcode === Op.Construct) {
        regs.push(inst.regs[0])
        if (inst.regs.length === 3) {
            for (let i = inst.regs[1]; i <= inst.regs[2]; i++) regs.push(i)
        }
    } else if (inst.opcode === Op.CallConst || inst.opcode === Op.ConstructConst) {
        if (inst.regs.length) {
            for (let i = inst.regs[0]; i <= inst.regs[1]; i++) regs.push(i)
        }
    }
    return regs
}
export function getRegWrites(inst: CodeInstruction): number[] {
    if (inst.opcode >= Op.Star && inst.opcode <= Op.Star15) {
        return inst.regs.slice()
    }
    if (inst.opcode >= Op.Ldar && inst.opcode <= Op.Ldar3) {
        return [-1]
    }
    if (inst.opcode === Op.Mov || inst.opcode === Op.MovPacked) {
        return [inst.regs[0]]
    }
    let regs: number[] = []
    if (inst.writesAcc) regs.push(-1)
    if (inst.opcode >= Op.IncPost && inst.opcode <= Op.DecPost) {
        regs.push(...inst.regs)
    }
    return regs
}

export function isAlwaysLiteral(inst: CodeInstruction): boolean {
    return inst.opcode >= Op.LdaConst && inst.opcode <= Op.LdaFalse
}

export function disassemble(code: readonly u8[], paramCount?: number, maxRegs?: number): string {
    const it = createCodeIterator(code)
    const lines: string[] = []
    while (const inst = it.next()) {
        let line = `${String(inst.pos).padStart(4, ' ')}: ${inst.opname}`
        if (inst.width !== 1) line = line + ` (W${inst.width})`
        if (inst.constSlot !== undefined) line = line + ` [const:${inst.constSlot}]`
        for (const r of inst.regs) {
            if (maxRegs === undefined || paramCount === undefined) {
                line = line + ` r${r}`
                continue
            }
            const name = r < paramCount ? `p${r}` : r >= maxRegs ? `a${r-maxRegs}` : `r${r-paramCount}`
            line = line + ` ${name}`
        }
        if (inst.imm !== undefined) line = line + ` #${inst.imm}`
        if (inst.jumpTarget !== undefined) line = line + ` -> ${inst.jumpTarget} (${inst.jumpOffset! >= 0 ? '+' : ''}${inst.jumpOffset})`
        if (inst.jumpLabel !== undefined) line = line + ` -> [label:${inst.jumpLabel}]`
        lines.push(line)
    }
    return lines.join('\n')
}

function testBytecodeEmit(str: string, name = 'f') {
    const r = compile(str)
    console.log(`${name}: code`, r.code, r.code.length)
    console.log(`${name}: constants`, r.constants, r.constantKinds)
    console.log(`${name}: lateBound`, r.lateBound, 'regs:', r.registerCount)
    console.log(`${name}: disasm\n${disassemble(r.code as u8[], r.paramCount, r.registerCount)}`)
}

function emitTest() {
    testBytecodeEmit('function add(a, b) { let c = a + b; return c * 2 }')

    testBytecodeEmit('function f(a) { return a + g + "hi" + (2 * 20) }')

    testBytecodeEmit('function f(a) { const x = 10*10; return x+x+a }', 'constReduce')
    
    testBytecodeEmit('function f(a) { if (a <= 1) return a; return f(a-1) }', 'recursive')
    testBytecodeEmit('function f(a) { return a <= 1 ? a : a+f(a-1) }', 'recursive2')
}
emitTest()

export function finalize(
    result: EmitResult,
    ctx?: Ctx,
    compileFn?: (f: Function) => Handle,
    convertValue?: (v: any) => Handle,
): Handle {
    const kinds = result.constantKinds
    const constants = new Array(kinds.length)
    const fromJsValue = convertValue ?? heap.createJsValueConverter(compileFn ?? (f => compileJsFn(f, ctx!)))
    for (let i = 0; i < result.constants.length; i++) {
        if (kinds[i] === ConstantKind.function_) {
            if (result.selfSlot !== i) throw `Missing fn const slot: ${i}`
            continue
        }
        if (kinds[i] === ConstantKind.late_bound) {
            const name = result.constants[i]
            if (!ctx) throw `Cannot finalize late bound symbol without a ctx obj: ${name}`
            if (!(name in ctx)) throw `Failed to find symbol: ${name}`
            // for testing
            constants[i] = fromJsValue(ctx[name])
            continue
        }
        if (kinds[i] === ConstantKind.string) constants[i] = heap.fromJsString(result.constants[i])
        else constants[i] = result.constants[i]
    }
    const res = makeFunctionFromBytes(result.code, result.paramCount as u16, result.registerCount as u32, constants)
    if (result.selfSlot !== undefined) {
        // FIXME: the above check is broken in native mode!
        const v = heap.FunctionBytecode(res)
        Intrinsics.store(v.constants, result.selfSlot*4 as u32, res, Types.u32)
    }
    if (result.labels !== undefined) {
        const ehArr = result.labels.eh
        const jumpArr = result.labels.jump

        const v = heap.FunctionBytecode(res)
        v.labels = intrinsics.New(heap.FunctionBytecodeLabels)
        const labels = v.labels

        labels.ehRangesCount = ehArr.length as u32
        labels.jumpLabelsCount = jumpArr.length as u32
        if (labels.ehRangesCount) {
            labels.ehRanges = intrinsics.Alloc(heap.CoveredRange, labels.ehRangesCount)
            for (let i: u32 = 0; i < ehArr.length; i++) {
                assert(ehArr[i].handler) // we assume we will never start on a handler
                assert(ehArr[i].end > ehArr[i].start)
                labels.ehRanges[i].start = ehArr[i].start as u32
                labels.ehRanges[i].end = ehArr[i].end as u32
                labels.ehRanges[i].handler = ehArr[i].handler as u32
            }
        }
        if (labels.jumpLabelsCount) {
            labels.jumpLabels = intrinsics.Alloc(Types.u32, labels.jumpLabelsCount)
            for (let i: u32 = 0; i < jumpArr.length; i++) {
                assert(jumpArr[i])
                labels.jumpLabels[i] = jumpArr[i] as u32
            }
        }
    }
    return res
}

// this _will_ tag the fn to dedupe compilations
const ctxSym = Symbol('ctx')
interface Ctx {
    readonly [ctxSym]: unique symbol
    [key: string]: any
}
export function createCtx(o: Record<string, any> = {}): Ctx {
    return Object.assign({ [ctxSym]: Symbol('ctx brand') }, o) as any
}
export function compileJsFn(f: Function, ctx: Ctx): any {
    const key = ctx[ctxSym]
    const _f = f as any
    if (const prev = _f[key]) return prev
    const compiled = compile(_f.toString()) // TODO: use computations
    // for circularity. TODO: need to do something to fixup cycles. like allocating heap handle ahead of time
    _f[key] = compiled
    return _f[key] = finalize(compiled, ctx)
}

function e2eTest(code: string | Function, _args: any[], thisArg: any = null, ctx: Ctx = createCtx()): any {
    const fromJsValue = (v: any) => heap.fromJsValue(v, f => compileJsFn(f, ctx))

    const source = code is string ? code : code.toString()
    const interpret = createInterpreter(true) // native mode
    const compiled = compile(source)
    const fn = finalize(compiled, ctx)
    const m = compiled.paramCount
    const framesize = Math.max(m, 1) * 4 as usize
    const sp = Intrinsics.sp()
    defer { 
        assert(sp === Intrinsics.sp())
        intrinsics.memsetByte(sp-framesize, framesize, 0)
    }
    const args = Intrinsics.stackalloc(framesize)
    defer Intrinsics.stackfree(framesize)
    const zerodArgs = _args.slice()
    while (zerodArgs.length < m) zerodArgs.push(0)
    zerodArgs.length = m

    for (let i = 0; i < zerodArgs.length; i++) {
        Intrinsics.store(args, 4*i as u32, fromJsValue(zerodArgs[i]), Types.u32)
    }
    const compiledThisArg = fromJsValue(thisArg)
    const r = interpret(fn, compiledThisArg, args, zerodArgs.length as u32)

    const realResult = r & (2**32)-1 // TODO: the intrinsics should be truncating to `nt`
    function disasmIfBad(expected: any): void {
        const cond = realResult === expected
        if (!cond) {
            const x = disassemble(compiled.code as u8[])
            console.log(compiled.constants)
            console.log(`disasm:\n${x}`)
        }
        assert(cond)
    }
    if (compiled.constantKinds.some(x => x === ConstantKind.late_bound)) {
        const indices = compiled.constantKinds.map((x, i) => x === ConstantKind.late_bound ? i : -1).filter(x => x !== -1)
        const paramNames = indices.map(x => compiled.constants[x])
        const paramValues = paramNames.map(x => ctx[x])
        const f = (new Function(...paramNames, 'return ' + code))(...paramValues)
        const expectedResult = f.apply(thisArg, _args)
        console.log(f.name, '(...) =', expectedResult, 'actual=', realResult)
        disasmIfBad(expectedResult)
    } else {
        const f = code is string ? (new Function('return ' + code))() : code
        const expectedResult = f.apply(thisArg, _args)
        console.log(f.name, '(...) =', expectedResult, 'actual=', realResult)
        disasmIfBad(expectedResult)
    }
    
    return realResult
}

function e2eTestPrint(...args: Parameters<typeof e2eTest>) {
    assert(args[0] is string)
    testBytecodeEmit(args[0])
    return e2eTest(...args)
}

function runTest() {
    const r = e2eTest('function add(a, b) { let c = a + b; return c * 2 }', [2, 3])
    intrinsics.assert(r === 10) // (2 + 3) * 2
    console.log("compiled add(2, 3) =", r)

    const r2 = e2eTest('function g(x) { return x * 10 + (3 - 1) }', [4])
    intrinsics.assert(r2 === 42) // 4 * 10 + 2
    console.log("compiled g(4) =", r2)

    let bigSrc = 'function big() {'
    for (let v = 200; v <= 500; v++) bigSrc = bigSrc + ' ' + v + ';'
    bigSrc = bigSrc + ' return 456 }'
    const r3 = e2eTest(bigSrc, [])
    intrinsics.assert(r3 === 456)
    console.log("compiled big() =", r3, "(via Width2 LdaConst, 301 constants)")

    const r4 = e2eTest('function useThis(a) { return this + a }', [2], 40)
    intrinsics.assert(r4 === 42) // this(40) + a(2)
    console.log("compiled useThis(2) with this=40 =", r4)

    const ifSrc = 'function f(x) { if (x > 5) { return 100 } return 0 }'
    const runIf = (x: number) => e2eTest(ifSrc, [x])
    intrinsics.assert(runIf(10) === 100)
    intrinsics.assert(runIf(3) === 0)
    console.log("compiled if: f(10)=", runIf(10), " f(3)=", runIf(3))

    // constant-folded condition: only the taken branch is emitted
    intrinsics.assert(e2eTest('function h() { if (true) { return 7 } return 8 }', []) === 7)
    console.log("compiled const-if h() = 7")

    // while (loop rotation + conditional jump-back)
    const whileSrc = 'function w(x) { while (x > 5) { return 1 } return 0 }'
    const runW = (x: number) => e2eTest(whileSrc, [x])
    intrinsics.assert(runW(10) === 1)
    intrinsics.assert(runW(3) === 0)
    console.log("compiled while: w(10)=", runW(10), " w(3)=", runW(3))

    // assignment + a iterating while loop
    const sumToSrc = 'function sumTo(n) { let acc = 0; let i = 0; while (i < n) { acc = acc + i; i = i + 1 } return acc }'
    const runSum = (n: number) => e2eTest(sumToSrc, [n])
    intrinsics.assert(runSum(5) === 10)  // 0+1+2+3+4
    intrinsics.assert(runSum(100) === 4950)
    console.log("compiled sumTo(5)=", runSum(5), " sumTo(100)=", runSum(100))

    // compound assignment
    const compSrc = 'function f(x) { x += 10; x *= 2; return x }'
    const runComp = (x: number) => e2eTest(compSrc, [x])
    intrinsics.assert(runComp(5) === 30) // (5 + 10) * 2
    console.log("compiled compound f(5) =", runComp(5))

    // for loop
    const forSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { s += i } return s }'
    intrinsics.assert(e2eTest(forSrc, [5]) === 10)   // 0+1+2+3+4
    intrinsics.assert(e2eTest(forSrc, [10]) === 45)
    console.log("compiled for: f(5)=", e2eTest(forSrc, [5]), " f(10)=", e2eTest(forSrc, [10]))

    const brkSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { if (i === 3) { break } s += i } return s }'
    intrinsics.assert(e2eTest(brkSrc, [100]) === 3) // 0+1+2, break at 3
    console.log("compiled break: f(100)=", e2eTest(brkSrc, [100]))

    const contSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { if (i % 2 === 1) { continue } s += i } return s }'
    intrinsics.assert(e2eTest(contSrc, [10]) === 20) // 0+2+4+6+8
    console.log("compiled continue: f(10)=", e2eTest(contSrc, [10]))

    const nestSrc = 'function f(n) { let s = 0; for (let i = 0; i < n; i += 1) { let j = 0; while (true) { if (j >= i) { break } s += 1; j += 1 } } return s }'
    console.log("compiled nested: f(5)=", e2eTest(nestSrc, [5]))
    intrinsics.assert(e2eTest(nestSrc, [5]) === 10)

    e2eTest(
        'function apply(f, x) { return f(x) }', 
        [function addOne(x: number) { return x + 1 }, 5]
    )

    e2eTest(
        'function call2(f, a, b) { return f(a, b) }', 
        [function add2(x: number, y: number) { return x + y }, 20, 22]
    )

    assert(e2eTest('function f(a) { return a <= 1 ? a : a+f(a-1) }', [10]) === 55)
    assert(e2eTest('function f(a) { return a >= 10 ? a : a+f(a+1) }', [1]) === 55)

    // unused param
    testBytecodeEmit('function f(a,b) { const x = a++; const y = a; return y+a }', 'unused_param')
    assert(e2eTest('function f(a,b) { const x = a++; const y = a; return y+a  }', [1]) === 4)

    // unused var with side effects
    testBytecodeEmit('function f(a) { const x = a++; return a }', 'unused')
    assert(e2eTest('function f(a) { const x = a++; return a }', [1]) === 2)

    // logical ops
    e2eTest('function f(a, b) { return a || b }', [0, 5])
    e2eTest('function f(a, b) { return a || b }', [3, 5])
    e2eTest('function f(a, b) { return a && b }', [0, 5])
    e2eTest('function f(a, b) { return a && b }', [3, 5])
    e2eTest('function f(a, b) { return a ?? b }', [3, 5])
    e2eTest('function f(a, b, c) { return (a || b) && c }', [0, 3, 5])

    // late bound
    e2eTest('function late() { return a }', [], null, createCtx({ a: 1 }))

    // property assignment
    e2eTest('function assign(o, y) { return o.x = y }', [{}, 3])
    e2eTest('function assign2(o, y) { return o["x"] = y }', [{}, 3]) // element access
    e2eTest('function assign3(o, y) { return o["x"] += y }', [{ x: 0 }, 3]) // element access
    e2eTest('function assign4(o, y) { return o["x"+"y"] += y }', [{ xy: 1 }, 3]) // element access

    // property read
    e2eTest('function read(o) { return o.x }', [{ x: 5 }])

    // read after write
    e2eTest('function assignThenRead(o, y) { o.x = y; return o.x }', [{}, 7])

    // compound property assignment
    e2eTest('function compoundProp(o) { o.x += 5; return o.x }', [{ x: 10 }])
    e2eTest('function compoundPropRhs(o, y) { o.x *= y; return o.x }', [{ x: 3 }, 4])

    // recv
    e2eTest('function methodCall(o) { return o.bar() }', [{ x: 1, bar() { return this.x } }])
    e2eTest('function methodCall2(o) { return o["bar"]() }', [{ x: 1, bar() { return this.x } }])
    testBytecodeEmit('function methodCall3(o,k) { return o[k]() }')
    e2eTest('function methodCall3(o,k) { return o[k]() }', [{ x: 1, bar() { return this.x } }, "bar"])

    // repeat calls
    testBytecodeEmit('function manyCalls(o,k) { return o[k]() + o[k]() + o[k]() }')
    e2eTest('function manyCalls(o,k) { return o[k]() + o[k]() + o[k]() }', [{ x: 1, bar() { return this.x } }, "bar"])
    testBytecodeEmit(`function add2(a, b) {
    const q = add(a, b)
    return add(a, b) + q
}`)
    e2eTest(`function add2(a, b) {
    const q = add(a, b)
    return add(a, b) + q
}`,[2,3], undefined, createCtx({ 
        add: function add(a: number, b: number) { let c = a + b; return c * 2 } 
    }))

    // default init
    e2eTest('function init(x, y = 1) { return x + y }', [1])
    e2eTestPrint('function init2(x, _ = 1) { return x }', [1])
    e2eTest('function init3(x, f, _ = f(x++)) { return x }', [1, () => 2])
    e2eTest('function init4(x, f, y = f()) { return x + y }', [1, () => 2, 3])

    // try/catch
    e2eTest('function eh() { try { throw 1 } catch (e) { return e + 1 } }', [1])
    e2eTest('function nothrow(x) { try { x += 1 } catch (e) { return e + 1 } return x }', [1])

    // generated/fuzz tests
    e2eTest(function gen158_min(a: number, b: number) {
        let s1 = 2
        if (16 >= b) {
            a = 6
        } else {
            if (a >= b) {} else s1 = 1
        }
        return s1
    }, [18, 17])

    console.log(Intrinsics.rem(-5, 10, Types.u32, Types.u32))

    console.log("bytecode-emitter end-to-end passed")
}
runTest()

