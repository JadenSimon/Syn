"use wrapped";

import * as heap from './heap'
import { Op } from './vm'

// we will have parts of the `typescript` API available to us
type ts = typeof import('typescript')
declare var ts: ts

type Node = import('typescript').Node

function getSymbolId(node: Node) {
    return (node as any).extra
}

function test() {
    const sf = ts.createSourceFile('test.js', 'function(a, b) { return a + b }', ts.ScriptTarget.Latest)
    function visit(node: Node): any {
        if (node.kind === ts.SyntaxKind.Identifier) {
            const symId = getSymbolId(node)
            if (symId === 0) {
                // if it's zero, then it's not a lexical ident
                return
            }
            console.log(node.getText(), symId)
        }
        return ts.forEachChild(node, visit)
    }
    visit(sf)
}

test()