"use wrapped";

import * as intrinsics from './intrinsics'
import { type Graph, type GraphNode } from './lowering2'
import {
    copyNode, createGraph, getArgIds, getLiteral, makeNode,
} from './graph-node'

export interface FlowEdge {
    from: number
    to: number
    capacity: number
}

export interface FlowResult {
    value: number
    sourceSide: Set<number>
    flows: number[]
}

const isDebug = false

export function maxFlow(vertexCount: number, edges: FlowEdge[], source: number, sink: number, onRegion?: (name: string, milliseconds: number) => void): FlowResult {
    const started = onRegion ? (performance as any).now() : 0
    let levelTime = 0
    let augmentTime = 0
    if (!Number.isInteger(vertexCount) || vertexCount < 2 || vertexCount > 0x7fffffff || edges.length > 0x3fffffff
        || source === sink || source < 0 || sink < 0
        || source >= vertexCount || sink >= vertexCount
        || !Number.isInteger(source) || !Number.isInteger(sink)) throw 'maxFlow: invalid vertices'
    const offsets = new Int32Array(vertexCount + 1)
    for (const edge of edges) {
        if (isDebug) {
            if ((edge.from | 0) !== edge.from || (edge.to | 0) !== edge.to
                || edge.from < 0 || edge.to < 0 || edge.from >= vertexCount || edge.to >= vertexCount
                || typeof edge.capacity !== 'number' || !(edge.capacity >= 0 && edge.capacity < Infinity)) {
                throw 'maxFlow: invalid edge'
            }
        }
        offsets[edge.from + 1]++
        offsets[edge.to + 1]++
    }
    if (onRegion) onRegion('validate-and-count', (performance as any).now() - started)
    for (let i = 1; i <= vertexCount; i++) offsets[i] += offsets[i - 1]
    const adjacency = new Int32Array(edges.length * 2)
    const targets = new Int32Array(edges.length * 2)
    const residual = new Float64Array(edges.length * 2)
    const fill = offsets.slice()
    for (let i = 0; i < edges.length; i++) {
        const edge = edges[i]
        const index = i * 2
        adjacency[fill[edge.from]++] = index as i32
        adjacency[fill[edge.to]++] = index + 1 as i32
        targets[index] = edge.to as i32
        targets[index + 1] = edge.from as i32
        residual[index] = edge.capacity as f64
    }
    if (onRegion) onRegion('setup', (performance as any).now() - started)
    let value = 0
    const level = new Int32Array(vertexCount)
    for (;;) {
        const levelStarted = onRegion ? (performance as any).now() : 0
        level.fill(-1)
        level[source] = 0
        const queue = [source]
        for (let i = 0; i < queue.length; i++) {
            const from = queue[i]
            for (let i = offsets[from]; i < offsets[from + 1]; i++) {
                const edge = adjacency[i]
                const to = targets[edge]
                if (residual[edge] <= 0 || level[to] >= 0) continue
                level[to] = level[from] + 1
                queue.push(to)
            }
        }
        if (onRegion) levelTime += (performance as any).now() - levelStarted
        if (level[sink] < 0) {
            if (onRegion) { onRegion('levels', levelTime); onRegion('augment', augmentTime) }
            const sourceSide = new Set<number>()
            for (const vertex of queue) sourceSide.add(vertex)
            return { value, sourceSide, flows: edges.map((edge, i) => edge.capacity - residual[i * 2]) }
        }
        const augmentStarted = onRegion ? (performance as any).now() : 0
        const cursor = offsets.slice(0, vertexCount)
        const vertices = [source]
        const path: number[] = []
        while (vertices.length) {
            const from = vertices[vertices.length - 1]
            if (from === sink) {
                let amount = Infinity
                for (const edge of path) amount = Math.min(amount, residual[edge])
                for (const edge of path) {
                    residual[edge] -= amount
                    residual[edge ^ 1] += amount
                }
                value += amount
                vertices.length = 1
                path.length = 0
                continue
            }
            const end = offsets[from + 1]
            while (cursor[from] < end) {
                const edge = adjacency[cursor[from]]
                if (residual[edge] > 0 && level[targets[edge]] === level[from] + 1) break
                cursor[from]++
            }
            if (cursor[from] === end) {
                vertices.pop()
                if (path.length) {
                    path.pop()
                    cursor[vertices[vertices.length - 1]]++
                }
                continue
            }
            const edge = adjacency[cursor[from]]
            path.push(edge)
            vertices.push(targets[edge])
        }
        if (onRegion) augmentTime += (performance as any).now() - augmentStarted
    }
}

export interface PlacementSolution {
    placements: Map<number, number>
    parameterCount: number
    parameters: Map<number, Set<number>>
}

export interface PlacementOptions {
    onRegion?: (name: string, milliseconds: number) => void
}

export function solvePlacements(g: Graph, choices: Map<number, number[]>, blockEdges?: Map<number, number[]>, options?: PlacementOptions): PlacementSolution {
    const profile = options?.onRegion
    let regionStart = profile ? (performance as any).now() : 0
    function region(name: string) {
        if (!profile) return
        const end = (performance as any).now()
        profile(name, end - regionStart)
        regionStart = (performance as any).now()
    }
    const next = new Map<number, Set<number>>()
    if (blockEdges) {
        for (const [block, successors] of blockEdges) {
            if (!next.has(block)) next.set(block, new Set())
            for (const successor of successors) {
                next.get(block)!.add(successor)
                if (!next.has(successor)) next.set(successor, new Set())
            }
        }
        const visited = new Set<number>()
        const active = new Set<number>()
        function forward(block: number) {
            if (visited.has(block)) return
            visited.add(block)
            active.add(block)
            for (const successor of next.get(block)!) {
                if (active.has(successor)) next.get(block)!.delete(successor)
                else forward(successor)
            }
            active.delete(block)
        }
        if (g.blocks.length && next.has(g.blocks[0].id)) forward(g.blocks[0].id)
        for (const block of next.keys()) forward(block)
    }
    const users = new Map<number, Set<number>>()
    for (const [id, chain] of choices) {
        if (!id || !g.nodes.has(id) || !chain.length || new Set(chain).size !== chain.length) {
            throw `placement: invalid choices for ${id}`
        }
        users.set(id, new Set())
        for (const block of chain) {
            if (blockEdges && !next.has(block)) throw `placement: missing block ${block} in block edges`
            if (!next.has(block)) next.set(block, new Set())
        }
        if (!blockEdges) for (let i = 1; i < chain.length; i++) next.get(chain[i - 1])!.add(chain[i])
    }
    for (const [user] of choices) {
        for (const operand of getArgIds(g.nodes.get(user)!)) {
            if (operand && choices.has(operand)) users.get(operand)!.add(user)
        }
    }
    region('topology-and-uses')
    const descendants = new Map<number, Set<number>>()
    const active = new Set<number>()
    function below(block: number): Set<number> {
        const known = descendants.get(block)
        if (known) return known
        if (active.has(block)) throw 'placement: placement chains must form an acyclic boundary order'
        active.add(block)
        const result = new Set([block])
        for (const successor of next.get(block)!) for (const b of below(successor)) result.add(b)
        active.delete(block)
        descendants.set(block, result)
        return result
    }
    for (const block of next.keys()) below(block)

    region('reachability')
    interface ChainInfo {
        before: Map<number, number>
        first: Map<number, number>
        allowed: Map<number, number>
    }
    const chainCache = new Map<string, ChainInfo>()
    const chainInfo = new Map<number, ChainInfo>()
    for (const [value, chain] of choices) {
        const key = chain.join(',')
        let info = chainCache.get(key)
        if (!info) {
            info = { before: new Map(), first: new Map(), allowed: new Map() }
            for (const block of next.keys()) {
                let before = 0
                while (before < chain.length && chain[before] !== block && below(chain[before]).has(block)) before++
                info.before.set(block, before)
                info.first.set(block, chain.findIndex(candidate => below(block).has(candidate)))
                let allowed = 0
                while (allowed < chain.length && below(chain[allowed]).has(block)) allowed++
                for (let i = allowed; i < chain.length; i++) {
                    if (below(chain[i]).has(block)) throw 'placement: non-linear dependency choices'
                }
                info.allowed.set(block, allowed)
            }
            chainCache.set(key, info)
        }
        chainInfo.set(value, info)
    }

    region('chain-queries')
    const source = 0
    const sink = 1
    let vertices = 2
    const thresholds = new Map<number, number[]>()
    for (const [id, chain] of choices) {
        const row = [source]
        for (let i = 1; i < chain.length; i++) row.push(vertices++)
        row.push(sink)
        thresholds.set(id, row)
    }
    const hard: [number, number][] = []
    const costs: FlowEdge[] = []
    let fixedCost = 0
    function imply(from: number, to: number) {
        if (from !== sink && to !== source && from !== to) hard.push([from, to])
    }
    function cost(from: number, to: number) {
        if (from === source && to === sink) fixedCost++
        else costs.push({ from, to, capacity: 1 })
    }
    for (const row of thresholds.values()) {
        for (let i = 1; i + 1 < row.length; i++) imply(row[i + 1], row[i])
    }
    for (const [operand, consumers] of users) {
        for (const consumer of consumers) {
            const chain = choices.get(consumer)!
            for (let j = 0; j < chain.length; j++) {
                const count = chainInfo.get(operand)!.allowed.get(chain[j])!
                imply(thresholds.get(operand)![count], thresholds.get(consumer)![j + 1])
            }
        }
    }
    region('constraints')
    interface Boundary { value: number, block: number, before: number, consumers: [number, number][] }
    const boundaries: Boundary[] = []
    for (const [value, consumers] of users) {
        if (!consumers.size) continue
        for (const block of next.keys()) {
            const before = chainInfo.get(value)!.before.get(block)!
            if (!before) continue
            const needs: [number, number][] = []
            for (const consumer of consumers) {
                const first = chainInfo.get(consumer)!.first.get(block)!
                if (first >= 0) needs.push([consumer, first])
            }
            if (!needs.length) continue
            if (needs.some(([, first]) => first === 0)) {
                cost(source, thresholds.get(value)![before])
            } else {
                const gate = vertices++
                for (const [consumer, first] of needs) imply(thresholds.get(consumer)![first], gate)
                cost(gate, thresholds.get(value)![before])
            }
            boundaries.push({ value, block, before, consumers: needs })
        }
    }
    region('boundary-gates')
    const infinity = costs.length + fixedCost + 1
    const edges = costs
    for (const [from, to] of hard) if (from !== to) edges.push({ from, to, capacity: infinity })
    region('flow-edges')
    const result = maxFlow(vertices, edges, source, sink, profile ? (name, ms) => profile(`max-flow.${name}`, ms) : undefined)
    if (result.value >= infinity) {
        const outgoing = new Map<number, number[]>()
        for (const [from, to] of hard) {
            let list = outgoing.get(from)
            if (!list) outgoing.set(from, list = [])
            list.push(to)
        }
        const previous = new Map<number, number>([[source, source]])
        const queue = [source]
        for (let i = 0; i < queue.length && !previous.has(sink); i++) {
            for (const to of outgoing.get(queue[i]) ?? []) {
                if (previous.has(to)) continue
                previous.set(to, queue[i])
                queue.push(to)
            }
        }
        const path: string[] = []
        if (previous.has(sink)) {
            for (let to = sink; to !== source;) {
                const from = previous.get(to)!
                path.push(`${from}:${to}`)
                to = from
            }
            path.reverse()
        }
        const wanted = new Set(path)
        const reasons = new Map<string, string>()
        const involved = new Set<number>()
        function explain(from: number, to: number, message: string, values: number[]) {
            const key = `${from}:${to}`
            if (!wanted.has(key) || reasons.has(key)) return
            reasons.set(key, message)
            for (const value of values) involved.add(value)
        }
        for (const [value, row] of thresholds) {
            const chain = choices.get(value)!
            for (let i = 1; i + 1 < row.length; i++) {
                explain(row[i + 1], row[i], `%${value} at B${chain[i + 1]} or later is also at B${chain[i]} or later`, [value])
            }
        }
        for (const [operand, consumers] of users) {
            const producer = choices.get(operand)!
            for (const consumer of consumers) {
                const chain = choices.get(consumer)!
                for (let j = 0; j < chain.length; j++) {
                    const count = chainInfo.get(operand)!.allowed.get(chain[j])!
                    const premise = count === 0 ? `%${operand} has no placement that can supply B${chain[j]}`
                        : `%${operand} placed after B${producer[count - 1]} cannot supply B${chain[j]}`
                    const conclusion = j + 1 === chain.length ? `%${consumer} has no later allowed placement`
                        : `%${consumer} must move to B${chain[j + 1]} or later`
                    explain(thresholds.get(operand)![count], thresholds.get(consumer)![j + 1],
                        `%${consumer} uses %${operand}: ${premise}; ${conclusion}`, [operand, consumer])
                }
            }
        }
        console.log(`--- placement contradiction for ${g.name || '<anonymous>'} ---`)
        for (const key of path) console.log('  ' + (reasons.get(key) ?? `hard implication ${key}`))
        for (const value of involved) {
            const n = g.nodes.get(value)!
            const operands = getArgIds(n).map((id, i) => id ? `%${id}` : `#${getLiteral(n, i)}`).join(' ')
            console.log(`  %${value} = ${n.op} ${operands}; allowed [${choices.get(value)!.map(b => `B${b}`).join(', ')}]`)
        }
        throw 'placement: no feasible assignment in the supplied chains'
    }
    region('max-flow')
    const placements = new Map<number, number>()
    const indices = new Map<number, number>()
    for (const [value, chain] of choices) {
        const row = thresholds.get(value)!
        let index = 0
        while (index + 1 < chain.length && result.sourceSide.has(row[index + 1])) index++
        indices.set(value, index)
        placements.set(value, chain[index])
    }
    const parameters = new Map<number, Set<number>>()
    let parameterCount = 0
    for (const boundary of boundaries) {
        if (indices.get(boundary.value)! >= boundary.before
            || !boundary.consumers.some(([value, first]) => indices.get(value)! >= first)) continue
        let captured = parameters.get(boundary.block)
        if (!captured) parameters.set(boundary.block, captured = new Set())
        captured.add(boundary.value)
        parameterCount++
    }
    if (parameterCount !== result.value + fixedCost) throw 'placement: cut does not match decoded parameter cost'
    region('decode')
    return { placements, parameterCount, parameters }
}

if (intrinsics.argv()[0] === 'placement-flow') {
    const assert = intrinsics.assert
    let seed = 12345
    function random(n: number): number {
        seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0
        return seed % n
    }
    for (let trial = 0; trial < 100; trial++) {
        const n = 2 + random(5)
        const edges: FlowEdge[] = []
        for (let i = 0; i < 20; i++) edges.push({ from: random(n), to: random(n), capacity: random(8) })
        let best = Infinity
        for (let mask = 0; mask < (1 << n); mask++) {
            if (!(mask & 1) || mask & (1 << (n - 1))) continue
            let cost = 0
            for (const edge of edges) if ((mask & (1 << edge.from)) && !(mask & (1 << edge.to))) cost += edge.capacity
            best = Math.min(best, cost)
        }
        const answer = maxFlow(n, edges, 0, n - 1)
        assert(answer.value === best)
        const balance = new Float64Array(n)
        for (let i = 0; i < edges.length; i++) {
            assert(answer.flows[i] >= 0 && answer.flows[i] <= edges[i].capacity)
            balance[edges[i].from] -= answer.flows[i]
            balance[edges[i].to] += answer.flows[i]
        }
        assert(balance[0] === -best && balance[n - 1] === best)
        for (let i = 1; i + 1 < n; i++) assert(balance[i] === 0)
    }
    const long: FlowEdge[] = []
    for (let i = 0; i < 10000; i++) long.push({ from: i, to: i + 1, capacity: 1 })
    assert(maxFlow(10001, long, 0, 10000).value === 1)

    function graph(args: number[][]): Graph {
        const nodes = new Map<number, GraphNode>()
        for (let i = 0; i < args.length; i++) nodes.set(i + 1, makeNode('opaque', args[i], new Float64Array(args[i].length)))
        return createGraph({ nodes, maxId: args.length + 1 })
    }
    for (let trial = 0; trial < 100; trial++) {
        const args: number[][] = [[], [], [], [], []]
        for (let i = 1; i < args.length; i++) {
            for (let j = 0; j < i; j++) if (random(2)) args[i].push(j + 1)
        }
        const g = graph(args)
        const choices = new Map<number, number[]>()
        choices.set(1, [0])
        choices.set(5, [3])
        for (let i = 2; i <= 4; i++) {
            const start = random(3)
            const end = start + random(4 - start)
            const chain: number[] = []
            for (let b = start; b <= end; b++) chain.push(b)
            choices.set(i, chain)
        }
        g.nodes.set(6, copyNode(g.nodes.get(1)!, []))
        choices.set(6, [0, 1, 2, 3])
        let best = Infinity
        const assignment = new Map<number, number>()
        function enumerate(id: number): void {
            if (id <= 5) {
                for (const block of choices.get(id)!) { assignment.set(id, block); enumerate(id + 1) }
                return
            }
            const captures = new Set<string>()
            for (let user = 1; user <= 5; user++) for (const operand of args[user - 1]) {
                const from = assignment.get(operand)!
                const to = assignment.get(user)!
                if (from > to) return
                for (let block = from + 1; block <= to; block++) captures.add(`${operand}:${block}`)
            }
            best = Math.min(best, captures.size)
        }
        enumerate(1)
        let failed = false
        let cost = -1
        try { cost = solvePlacements(g, choices).parameterCount }
        catch (e) { if (!String(e).includes('no feasible assignment')) throw e; failed = true }
        if (best === Infinity) assert(failed)
        else assert(!failed && cost === best, `placement mismatch: ${trial}, got ${cost}, expected ${best}`)
    }
    const omitted = graph([[], [1, 999, 0], [2]])
    assert(solvePlacements(omitted, new Map([[2, [0, 1, 2]]])).parameterCount === 0)
    const shared = solvePlacements(graph([[], [1], [1]]), new Map([[1, [0]], [2, [2]], [3, [0, 1, 2]]]))
    assert(shared.parameterCount === 2)
    assert(shared.parameters.get(1)!.has(1) && shared.parameters.get(2)!.has(1))
    console.log('max flow and placement tests passed')

    const early = solvePlacements(graph([[], [], [1, 2], [3]]), new Map([
        [1, [0]], [2, [0]], [3, [0, 1]], [4, [1]],
    ]))
    assert(early.parameterCount === 1 && early.placements.get(3) === 0)
    const late = solvePlacements(graph([[], [], [1, 2], [1, 2, 3]]), new Map([
        [1, [0]], [2, [0]], [3, [0, 1]], [4, [1]],
    ]))
    assert(late.parameterCount === 2 && late.placements.get(3) === 1)
    const joined = solvePlacements(graph([[], [1], [], []]), new Map([
        [1, [0]], [2, [3]], [3, [0, 1, 3]], [4, [0, 2, 3]],
    ]))
    assert(joined.parameterCount === 3)
    console.log('placement sharing and forwarding tests passed')

    const fixedGraph = graph([[], [], [1, 2], [1, 2]])
    const fixedChoices = new Map([[1, [0]], [2, [0]], [3, [5]], [4, [11]]])
    const blockEdges = new Map([[0, [5]], [5, [5, 11]], [11, [11]]])
    const fixed = solvePlacements(fixedGraph, fixedChoices, blockEdges)
    assert(fixed.parameterCount === 4)
    assert(fixed.parameters.get(5)!.size === 2 && fixed.parameters.get(11)!.size === 2)
    assert(blockEdges.get(5)!.length === 2 && blockEdges.get(11)![0] === 11)
    const loop = solvePlacements(graph([[], [1]]), new Map([[1, [5]], [2, [5]]]),
        new Map([[0, [5]], [5, [11]], [11, [5]]]))
    assert(loop.parameterCount === 0)
    console.log('explicit block-edge tests passed')

    let contradiction = false
    try {
        solvePlacements(graph([[], [1], [2]]), new Map([[1, [2]], [2, [0, 1, 2]], [3, [0]]]),
            new Map([[0, [1]], [1, [2]], [2, []]]))
    } catch (e) {
        contradiction = String(e).includes('no feasible assignment')
    }
    assert(contradiction)
    console.log('placement contradiction diagnostics test passed')

    if (isDebug) {
        for (const capacity of [-1, NaN, Infinity, -Infinity, '1' as any]) {
            let rejected = false
            try { maxFlow(2, [{ from: 0, to: 1, capacity }], 0, 1) }
            catch { rejected = true }
            assert(rejected)
        }
        for (const from of [-1, 0.5, NaN, Infinity, 2, '0' as any]) {
            let rejected = false
            try { maxFlow(2, [{ from, to: 1, capacity: 1 }], 0, 1) }
            catch { rejected = true }
            assert(rejected)
        }
    }

    assert(maxFlow(2, [{ from: 0, to: 1, capacity: 0.5 }], 0, 1).value === 0.5)
    const regions: string[] = []
    assert(maxFlow(2, [{ from: 0, to: 1, capacity: 1 }], 0, 1, (name, ms) => {
        assert(ms >= 0)
        regions.push(name)
    }).value === 1)
    assert(regions.includes('setup') && regions.includes('levels') && regions.includes('augment'))
    console.log('flow validation and profiling tests passed')
}

if (intrinsics.argv()[0] === 'placement-flow' && intrinsics.argv().includes('bench')) {
    function workload(count: number, depth: number, fixed: boolean, shared: boolean, fork: boolean) {
        const nodes = new Map<number, GraphNode>()
        const choices = new Map<number, number[]>()
        const edges = new Map<number, number[]>()
        const chain: number[] = []
        for (let b = 0; b < depth; b++) {
            chain.push(b)
            edges.set(b, b + 1 < depth ? [b + 1] : [])
        }
        if (fork) {
            edges.set(0, [1, depth])
            edges.set(depth, [depth - 1])
        }
        for (let id = 1; id <= count; id++) {
            const args = id === 1 ? [] : shared ? [1, Math.max(1, id - 1), Math.max(1, id - 7)] : [id - 1]
            nodes.set(id, makeNode('opaque', args, new Float64Array(args.length)))
            const block = Math.floor((id - 1) * (depth - 1) / (count - 1))
            choices.set(id, fixed || id === 1 || id === count ? [block] : chain.slice())
        }
        const graph = createGraph({ nodes, maxId: count + 1 })
        return { graph, choices, edges }
    }
    for (const [name, count, depth, fixed, shared, fork] of [
        ['fixed-small', 500, 8, true, true, false],
        ['shared-small', 500, 8, false, true, false],
        ['fixed', 2000, 32, true, true, false],
        ['chain', 1000, 32, false, false, false],
        ['shared', 1000, 32, false, true, false],
        ['deep', 300, 128, false, true, false],
        ['fork', 700, 24, false, true, true],
    ] as [string, number, number, boolean, boolean, boolean][]) {
        const w = workload(count, depth, fixed, shared, fork)
        const times: number[] = []
        const regions = new Map<string, number[]>()
        let cost = -1
        for (let iteration = 0; iteration < 7; iteration++) {
            const start = (performance as any).now()
            const result = solvePlacements(w.graph, w.choices, w.edges, {
                onRegion(name, ms) {
                    if (iteration < 2) return
                    let samples = regions.get(name)
                    if (!samples) regions.set(name, samples = [])
                    samples.push(ms)
                },
            })
            const elapsed = (performance as any).now() - start
            if (cost !== -1) intrinsics.assert(cost === result.parameterCount)
            cost = result.parameterCount
            if (iteration >= 2) times.push(elapsed)
        }
        times.sort((a, b) => a - b)
        console.log(`BENCH ${name}: values=${count} depth=${depth} median=${times[2].toFixed(2)}ms min=${times[0].toFixed(2)}ms cost=${cost}`)
        console.log('REGIONS ' + name + ': ' + [...regions].map(([region, samples]) => {
            samples.sort((a, b) => a - b)
            return `${region}=${samples[2].toFixed(2)}ms`
        }).join(', '))
    }
}