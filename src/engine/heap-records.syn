"use wrapped";

import * as heap from './heap'
import * as intrinsics from './intrinsics'
import type { GraphNode } from './lowering2'
import { countIds, countLiterals, createRecordParam, getLiteral, getRef } from './graph-node'
import { symbolOf, symbolValue, tagVmHandle, traceCell, traceValue } from './vm'

const assert = intrinsics.assert
const Types = intrinsics.Types
type Handle = intrinsics.Handle

type ValueNode = GraphNode

interface Shape {
    type: Handle
    keys: Handle[]
    fields: Handle[]
    flags: number[]
    fixed: Handle[]
    second: Handle[]
}

export interface Group {
    members: Handle[]
    children: [key: Handle, group: number][]
    base: number[]
}

export interface Joined {
    result: number
    groups: Group[]
}

export type HeapState = Map<Handle, number>
type CellChanges = Map<Handle, Handle>
interface CellMarks {
    count: number
    outer: Map<Handle, Handle> | undefined
}
export type HeapRecords = ReturnType<typeof createHeapRecords>

export function createHeapRecords(
    tracer: any,
    mk: (op: string, args: number[], label?: string, types?: intrinsics.Types[]) => any,
    nodes: Map<number, ValueNode>,
    blocks: Map<number, { body: any }>,
) {
    const identities = new Map<Handle, Handle>()
    const managed = new Set<Handle>()
    const stats = { marks: 0, scanned: 0, maxManaged: 0 }
    const shapes = new Map<Handle, Shape>()
    const children = new Map<Handle, Handle[]>()
    const records = new Map<Handle, number>()
    const joins = new Map<number, Joined>()
    const offset = 0x100000000
    const armKey = -1
    let saved: Map<Handle, Handle> | undefined

    function manage(cell: Handle): void {
        if (managed.has(cell)) return
        managed.add(cell)
        for (const child of children.get(cell) ?? []) manage(child)
    }

    function release(): void {
        managed.clear()
    }

    function intern(handle: Handle): Handle {
        if (handle <= 1 || intrinsics.getNanId(handle)) return handle
        if (heap.isIndirect(handle)) {
            manage(handle)
            return handle
        }
        if (!heap.isOrdinaryObject(handle)) return handle
        const previous = identities.get(handle) ?? owning(handle)
        if (previous !== undefined) {
            identities.set(handle, previous)
            manage(previous)
            return previous
        }
        const cell = heap.makeIndirect(handle)
        identities.set(handle, cell)
        managed.add(cell)
        const refs: Handle[] = []
        children.set(cell, refs)
        for (const key of keysOf(handle)) {
            const d = descriptor(handle, key)
            if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
            const value = d.slot0 as Handle
            if (!value || heap.isBoxedF64(value)) continue
            const child = intern(value)
            if (child !== value) d.slot0 = child
            if (heap.isIndirect(child)) refs.push(child)
        }
        return cell
    }

    function owning(interior: Handle): Handle | undefined {
        for (const cell of managed) {
            if (heap.indirectTarget(cell) === interior) return cell
        }
        return undefined
    }

    function keysOf(target: Handle): Handle[] {
        const keys: Handle[] = []
        for (let i: u32 = 0; i < heap.ownPropertyCount(target); i++) keys.push(heap.ownPropertyKeyAt(target, i))
        return keys
    }

    function descriptor(target: Handle, key: Handle) {
        return heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key)))
    }

    function shapeOf(cell: Handle, target: Handle): Shape {
        const known = shapes.get(cell)
        if (known) {
            assert(heap.typeDescriptorOf(target) === known.type, 'heap record: prototype or type changed')
            const keys = keysOf(target)
            assert(keys.length === known.keys.length && keys.every((k, i) => k === known.keys[i]), 'heap record: property shape changed')
            for (let i = 0; i < keys.length; i++) {
                const d = descriptor(target, keys[i])
                assert(d.flags === known.flags[i], 'heap record: property descriptor changed')
                if (known.fields.includes(keys[i])) {
                    assert(heap.isBoxedF64(d.slot0), 'heap record: scalar field changed representation')
                } else {
                    assert(d.slot0 === known.fixed[i] && d.slot1 === known.second[i], 'heap record: structural field changed')
                }
            }
            return known
        }
        const keys = keysOf(target)
        const fields: Handle[] = []
        const flags: number[] = []
        const fixed: Handle[] = []
        const second: Handle[] = []
        for (const key of keys) {
            const d = descriptor(target, key)
            flags.push(d.flags)
            fixed.push(d.slot0 as Handle)
            second.push(d.slot1 as Handle)
            if (!(d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) && heap.isBoxedF64(d.slot0)) fields.push(key)
        }
        const refs: Handle[] = []
        for (let i = 0; i < keys.length; i++) {
            if (fields.includes(keys[i])) continue
            if (heap.isIndirect(fixed[i])) refs.push(fixed[i])
        }
        children.set(cell, refs)
        const shape = { type: heap.typeDescriptorOf(target), keys, fields, flags, fixed, second }
        shapes.set(cell, shape)
        return shape
    }

    function shapeAt(cell: Handle, where: string): Shape {
        const known = shapes.get(cell)
        if (!known) {
            const target = heap.indirectTarget(cell)
            const owners: Handle[] = []
            for (const [c] of shapes) {
                if (heap.isIndirect(c) && heap.indirectTarget(c) === target) owners.push(c)
            }
            const ids: Handle[] = []
            for (const [h, c] of identities) if (c === cell) ids.push(h)
            throw `heap record: ${where} on unshaped cell ${cell} target=${target}`
                + ` recorded=${records.has(target)} managed=${managed.has(cell)}`
                + ` sameTargetCells=[${owners.join(',')}] internedFrom=[${ids.join(',')}]`
        }
        return known
    }

    function record(cell: Handle, target: Handle): number {
        const previous = records.get(target)
        if (previous !== undefined) return previous
        const shape = shapeOf(cell, target)
        const values: number[] = []
        for (const key of shape.fields) {
            values.push(traceValue(key), tagVmHandle(descriptor(target, key).slot0))
        }
        const value = mk('record', values)
        records.set(target, value)
        return value
    }

    function get(value: number, key: Handle): f64 {
        const n = nodes.get(symbolOf(value))!
        if (n.op === 'record') {
            for (let i = 0; i < countIds(n); i += 2) {
                if (getLiteral(n, i) !== key) continue
                return getRef(n, i + 1) ? symbolValue(getRef(n, i + 1)) : traceValue(getLiteral(n, i + 1))
            }
            throw 'heap record: missing field'
        }
        return mk('get', [value, traceValue(key)], '', [Types.u64])
    }

    function findTerminal(value: number): string {
        const parent = new Map<number, number>()
        const seen = new Set<number>()
        const stack = [symbolOf(value)]
        while (const id = stack.pop()) {
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = nodes.get(id)
            if (!n) continue
            if (n.op === 'ret' || n.op === 'panic' || n.op === 'unreachable') {
                const path: string[] = []
                for (let at = id; at; at = parent.get(at) ?? 0) path.unshift(`${nodes.get(at)!.op} %${at}`)
                return path.join(' -> ')
            }
            if (n.op === 'block' || n.op === 'inlined') continue
            for (let i = n.op === 'apply' ? 1 : 0; i < countIds(n); i++) {
                const r = getRef(n, i)
                if (r && !seen.has(r)) parent.set(r, id)
                stack.push(r)
            }
        }
        return ''
    }

    function install(cell: Handle, value: number): void {
        if (intrinsics.argv().includes('probe-ret')) {
            const bad = findTerminal(value)
            if (bad) {
                const parents: Handle[] = []
                for (const [owner, kids] of children) {
                    if (owner !== cell && kids.includes(cell)) parents.push(owner)
                }
                console.log(`PROBE install cell=${cell} parents=[${parents.join(', ')}]`
                    + ` managed=${managed.has(cell)} reaches ${bad}`)
            }
        }
        const shape = shapeAt(cell, 'install')
        const target = heap.prepareWrite(cell)
        for (const key of shape.fields) descriptor(target, key).slot0 = traceCell(get(value, key))
        records.set(target, value)
        freeze(cell)
    }

    function freeze(cell: Handle): void {
        const target = heap.indirectTarget(cell)
        const stash = heap.indirectStash(cell)
        if (target === stash) return
        if (saved && !saved.has(cell)) saved.set(cell, stash)
        heap.setIndirectStash(cell, target)
    }

    function mark(): CellMarks {
        stats.marks++
        stats.scanned += managed.size
        stats.maxManaged = Math.max(stats.maxManaged, managed.size)
        for (const cell of managed) freeze(cell)
        const marks = { count: managed.size, outer: saved }
        saved = new Map()
        return marks
    }

    function take(marks: CellMarks): CellChanges {
        const changes: CellChanges = new Map()
        stats.scanned += marks.count
        let remaining = marks.count
        for (const cell of managed) {
            if (!remaining--) break
            const target = heap.indirectTarget(cell)
            const stash = heap.indirectStash(cell)
            const base = saved!.get(cell) ?? stash
            if (target !== base) changes.set(cell, target)
            if (target === base && stash === base) continue
            heap.setIndirectTarget(cell, base)
            heap.setIndirectStash(cell, base)
        }
        saved!.clear()
        return changes
    }

    function capture(roots: Handle[]): HeapState {
        const state: HeapState = new Map()
        function visit(handle: Handle): void {
            const cell = intern(handle)
            if (!managed.has(cell) || state.has(cell)) return
            freeze(cell)
            state.set(cell, record(cell, heap.indirectTarget(cell)))
            for (const child of children.get(cell) ?? []) visit(child)
        }
        for (const root of roots) visit(root)
        return state
    }

    function parameter(cell: Handle): number {
        const id = tracer.getNanId(tracer.createUniqueNan())
        const keys = shapeAt(cell, 'parameter').fields
        nodes.set(id, createRecordParam(keys))
        return id
    }

    function merge(cond: number, marks: CellMarks, a: CellChanges, b: CellChanges): void {
        saved = marks.outer
        for (const cell of new Set([...a.keys(), ...b.keys()])) {
            const at = a.get(cell) ?? heap.indirectTarget(cell)
            const bt = b.get(cell) ?? heap.indirectTarget(cell)
            if (at === bt) {
                heap.setIndirectTarget(cell, at)
                freeze(cell)
                continue
            }
            const av = record(cell, at), bv = record(cell, bt)
            if (symbolOf(av) === symbolOf(bv)) { install(cell, av); continue }
            const value = mk('select', [cond, av, bv])
            install(cell, value)
        }
    }

    function sameShape(a: Handle, b: Handle): boolean {
        const x = shapeAt(a, 'sameShape')
        const y = shapeAt(b, 'sameShape')
        if (x.type !== y.type || x.keys.length !== y.keys.length) return false
        for (let i = 0; i < x.keys.length; i++) {
            if (x.keys[i] !== y.keys[i] || x.flags[i] !== y.flags[i]) return false
            const field = x.fields.includes(x.keys[i])
            if (field !== y.fields.includes(y.keys[i])) return false
            if (field || x.fixed[i] === y.fixed[i]) continue
            if (!managed.has(x.fixed[i]) || !managed.has(y.fixed[i])) return false
        }
        return true
    }

    function operand(n: ValueNode, i: number): number {
        return getRef(n, i) ? symbolValue(getRef(n, i)) : traceValue(getLiteral(n, i))
    }

    function rebuild(id: number, leaf: (id: number) => number, memo: Map<number, number>): number {
        if (const known = memo.get(id)) return known
        const n = nodes.get(id)!
        let out: number
        if (n.op === 'heap-handle') {
            out = leaf(id)
        } else if (n.op === 'apply') {
            const block = blocks.get(getRef(n, 0))!
            block.body = rebuild(symbolOf(block.body), leaf, memo)
            memo.set(symbolOf(block.body), block.body)
            out = symbolValue(id)
        } else {
            const args: number[] = []
            for (let i = 0; i < countIds(n); i++) {
                const spine = n.op === 'after' ? i === 1
                    : n.op === 'join' ? i === countIds(n) - 1
                    : n.op === 'select' ? i > 0 : i === 0
                args.push(spine ? rebuild(getRef(n, i), leaf, memo) : operand(n, i))
            }
            out = mk(n.op, args)
        }
        memo.set(id, out)
        return out
    }

    function plain(cell: Handle): number {
        return mk('heap-handle', [traceValue(cell)], '', [Types.handle])
    }

    function stateAt(id: number): Handle {
        const n = nodes.get(id)!
        if (countLiterals(n) > 1) return getLiteral(n, 1) as Handle
        return heap.indirectTarget(getLiteral(n, 0) as Handle)
    }

    function unify(value: number): { value: number, result: number } | undefined {
        const root = symbolOf(value)
        if (!root) return
        const top = nodes.get(root)
        if (top?.op === 'heap-handle') {
            if (getRef(top, 0) || countLiterals(top) < 2) return
            return { value: plain(getLiteral(top, 0) as Handle), result: value }
        }
        const leaves: number[] = []
        const visited = new Set<number>()
        let crossed = false
        function collect(id: number): boolean {
            if (visited.has(id)) return true
            visited.add(id)
            const n = nodes.get(id)
            if (!n) return false
            if (n.op === 'heap-handle') {
                if (getRef(n, 0)) return false
                leaves.push(id)
                return true
            }
            if (n.op === 'apply') {
                const block = blocks.get(getRef(n, 0))
                crossed = true
                return !!block && collect(symbolOf(block.body))
            }
            if (n.op === 'after') return !!getRef(n, 1) && collect(getRef(n, 1))
            if (n.op === 'join') {
                const last = getRef(n, countIds(n) - 1)
                return !!last && collect(last)
            }
            if (n.op === 'ret' || n.op === 'inlined') return !!getRef(n, 0) && collect(getRef(n, 0))
            if (n.op !== 'select' || countIds(n) < 2) return false
            for (let i = 1; i < countIds(n); i++) {
                if (!getRef(n, i) || !collect(getRef(n, i))) return false
            }
            return true
        }
        if (!collect(root)) return

        const cells = leaves.map(id => getLiteral(nodes.get(id)!, 0) as Handle)
        if (cells.every(c => c === cells[0])) {
            const identity = plain(cells[0])
            if (!crossed) {
                const empty = mk('void', [], '', [Types.u32])
                return { value: identity, result: rebuild(root, () => empty, new Map()) }
            }
            if (!managed.has(cells[0])) return
            const result = rebuild(root, id => record(cells[0], stateAt(id)), new Map())
            install(cells[0], result)
            return { value: identity, result }
        }
        if (crossed) return
        for (const cell of cells) {
            if (!managed.has(cell)) return
        }

        const groups: Group[] = []
        function join(members: Handle[]): number {
            for (const c of members) shapeOf(c, heap.indirectTarget(c))
            for (const c of members) assert(sameShape(members[0], c), 'heap record: cannot unify objects with different shapes')
            const group: Group = { members, children: [], base: new Array(members.length).fill(0) }
            const index = groups.push(group) - 1
            const shape = shapeAt(members[0], 'join')
            for (let i = 0; i < shape.keys.length; i++) {
                if (shape.fields.includes(shape.keys[i])) continue
                const children = members.map(c => shapeAt(c, 'join.children').fixed[i])
                if (children.every(c => c === children[0])) continue
                group.children.push([shape.keys[i], join(children)])
            }
            return index
        }
        join(cells)

        let width = 2
        for (const group of groups) width += shapeAt(group.members[0], 'unify.width').fields.length * 2
        function leafRecord(id: number): number {
            const index = leaves.indexOf(id)
            const fields = [traceValue(armKey), traceValue(index)]
            for (let g = 0; g < groups.length; g++) {
                const cell = groups[g].members[index]
                const own = record(cell, heap.indirectTarget(cell))
                groups[g].base[index] = own
                for (const key of shapeAt(cell, 'leafRecord').fields) {
                    fields.push(traceValue(g * offset + key), get(own, key))
                }
            }
            return mk('record', fields)
        }
        const result = rebuild(root, leafRecord, new Map())
        joins.set(root, { result, groups })
        return { value, result }
    }

    function rerootFields(cells: Handle[], proj: (k: number) => number): void {
        let k = 0
        for (const cell of cells) {
            const shape = shapes.get(cell)
            if (!shape) continue
            const fields: number[] = []
            for (const key of shape.fields) fields.push(traceValue(key), proj(k++))
            install(cell, mk('record', fields))
        }
    }

    function fieldsFor(cells: Handle[], wrap: (value: number, k: number) => number): number[] {
        const out: number[] = []
        let k = 0
        for (const cell of cells) {
            const shape = shapes.get(cell)
            if (!shape) continue
            freeze(cell)
            const value = record(cell, heap.indirectTarget(cell))
            for (const key of shape.fields) out.push(wrap(get(value, key), k++))
        }
        return out
    }

    function snapshot(cell: Handle): Handle | undefined {
        if (!managed.has(cell)) return
        freeze(cell)
        return heap.indirectTarget(cell)
    }

    function joinOf(value: number): Joined | undefined {
        const id = symbolOf(value)
        return id ? joins.get(id) : undefined
    }

    function same(a: number, b: number): boolean {
        const id = symbolOf(a)
        return id ? id === symbolOf(b) : a === b
    }

    function guard(arm: number, index: number): number {
        return mk('eq', [arm, traceValue(index)], '', [Types.u64, Types.u64])
    }

    function select(cond: number, a: number, b: number): f64 {
        if (same(a, b)) return a as f64
        return mk('select', [cond, a, b])
    }

    function readJoined(joined: Joined, g: number, key: Handle): { value?: number, group?: number, handle?: Handle } {
        const group = joined.groups[g]
        const shape = shapeAt(group.members[0], 'readJoined')
        const at = shape.keys.indexOf(key)
        if (at < 0) return { handle: 0 as Handle }
        if (shape.fields.includes(key)) {
            const arm = get(joined.result, armKey as Handle)
            let value = get(joined.result, (g * offset + key) as Handle)
            for (let i = 0; i < group.members.length; i++) {
                const cell = group.members[i]
                const current = get(record(cell, heap.indirectTarget(cell)), key)
                if (same(current, get(group.base[i], key))) continue
                value = select(guard(arm, i), current, value)
            }
            return { value }
        }
        for (const [k, child] of group.children) {
            if (k === key) return { group: child }
        }
        assert(!(shape.flags[at] & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)), 'heap record: accessor on a joined object')
        return { handle: shape.fixed[at] }
    }

    function writeJoined(joined: Joined, g: number, key: Handle, value: number): void {
        const group = joined.groups[g]
        assert(shapes.get(group.members[0])!.fields.includes(key), 'heap record: structural write through a joined object')
        const arm = get(joined.result, armKey as Handle)
        const updates = new Map<Handle, number>()
        for (let i = 0; i < group.members.length; i++) {
            const cell = group.members[i]
            const prior = updates.get(cell) ?? get(record(cell, heap.indirectTarget(cell)), key)
            updates.set(cell, select(guard(arm, i), value, prior))
        }
        for (const [cell, field] of updates) {
            const own = record(cell, heap.indirectTarget(cell))
            const keys = shapeAt(cell, 'writeJoined').fields
            const fields: number[] = []
            for (const k of keys) fields.push(traceValue(k), k === key ? field : get(own, k))
            install(cell, mk('record', fields))
        }
    }

    return { intern, release, capture, mark, take, parameter, install, fieldsFor, rerootFields, merge, sameShape, unify, snapshot, joinOf, readJoined, writeJoined, stats }
}
