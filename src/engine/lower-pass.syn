/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as bytecode from './bytecode-emitter'
import { trace2, createTraceSession } from './trace2'
import { frameShape, resolveClosures } from './property-eval'
import { dumpGraph, lowerValueGraph, normalizeValueGraph, type Graph } from './lowering2'
import * as lowering2 from './lowering2'
import * as native from './native'

export function suite() {
    if (intrinsics.argv().includes('whole')) {
        const optimizeValueGraph = intrinsics.getComputation(lowering2.optimizePackaged)[1].find((c: any) => c?.name === 'optimizeValueGraph')
        const start = performance.now()
        try {
            native.createNatives({ optimizeValueGraph })
            console.log(`lower-pass: optimizeValueGraph lowered in ${Math.round(performance.now() - start)}ms`)
        } catch (e) {
            console.log(`lower-pass: optimizeValueGraph failed after ${Math.round(performance.now() - start)}ms: ${(e as any)?.stack ?? e}`)
        }
    }
    const passName = intrinsics.argv().find(a => a.startsWith('pass:'))?.slice(5) ?? 'normalizeCommutative'
    const session = createTraceSession()
    const optimize = intrinsics.getComputation(lowering2.optimizePackaged)[1].find((c: any) => c?.name === 'optimizeValueGraph')
    if (!optimize) throw 'lower-pass: optimizeValueGraph is not a capture of optimizePackaged'
    const [code, captures] = intrinsics.getComputation(optimize)
    if (intrinsics.argv().includes('pass-source')) {
        const pattern = new RegExp(intrinsics.argv().find(a => a.startsWith('grep:'))?.slice(5) ?? 'c___')
        for (const line of code.split('\n')) if (pattern.test(line)) console.log('SOURCE', line.trim())
    }
    const parent = session.compileSource(code)

    function findTemplate(result: bytecode.EmitResult): bytecode.EmitResult | undefined {
        for (let i = 0; i < result.constants.length; i++) {
            if (result.constantKinds[i] !== bytecode.ConstantKind.nested_function) continue
            const nested: bytecode.EmitResult = result.constants[i]
            if (nested.name === passName) return nested
        }
    }
    const template = findTemplate(parent.compiled)
    if (!template) throw `lower-pass: no nested function ${passName} in optimizeValueGraph`
    console.log(`lower-pass: ${passName} params=${template.paramCount} registers=${template.registerCount} scopes=${template.scopeBindings.length}`)

    let stage = 'finalize'
    const show = (label: string, g: Graph) => console.log(`=== ${label} ===\n${dumpGraph(g)}`)
    session.enterTrace()
    try {
        session.finalize(parent.compiled, captures)
        stage = 'trace'
        const body = trace2(template, { session, captures, env: true, name: passName })
        show('traced', body.graph)
        stage = 'resolve'
        const frames = new Map<u32, intrinsics.Handle>()
        for (const [proxy, size] of body.frames) frames.set(proxy, frameShape(size))
        const resolved = resolveClosures(body.graph, session, frames)
        show('resolved', resolved.graph)
        stage = 'normalize'
        const normalized = normalizeValueGraph(resolved.graph)
        show('normalized', normalized)
        stage = 'lower'
        const lowered = lowerValueGraph(normalized)
        console.log(lowered.listing)
        console.log(`lower-pass: ${passName} lowered to ${lowered.words.length} instructions`)
    } catch (e) {
        console.log(`lower-pass: ${passName} failed at ${stage}: ${e}`)
    } finally {
        session.leaveTrace()
    }
}
