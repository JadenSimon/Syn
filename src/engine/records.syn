"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { snapshotField, snapshotKeys } from './heap-records'
import type { Graph, GraphNode } from './lowering2'
import {
    copyNode, countIds, getBlock, getDebugLabel, getLiteral, getRef,
    makeNode, type Operand, recordFields, setDebugLabel, setGraphBlocks, type RecordField, typeRefOf,
} from './graph-node'

const assert = intrinsics.assert
interface Value { id: number, constant: number }

export function recordSnapshots(g: Graph): void {
    const users = new Map<number, [user: number, slot: number][]>()
    for (const [id, n] of g.nodes) {
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            const list = users.get(ref)
            if (list) list.push([id, i])
            else users.set(ref, [[id, i]])
        }
    }
    const bodies = new Set(g.blocks.map(b => b.bodyId))
    function recordParam(id: number): boolean {
        const param = g.nodes.get(id)
        return param?.op === 'param' && g.nodes.get(typeRefOf(param))?.op === 'record-type'
    }
    const memo = new Map<number, boolean>()
    function contained(id: number): boolean {
        const known = memo.get(id)
        if (known !== undefined) return known
        memo.set(id, true)
        let result = !bodies.has(id)
        for (const [user, slot] of users.get(id) ?? []) {
            if (!result) break
            const u = g.nodes.get(user)!
            if (u.op === 'get' && slot === 0) continue
            if (u.op === 'apply' && slot > 0 && recordParam(getBlock(g, getRef(u, 0))?.params[slot - 1] ?? 0)) continue
            if (u.op === 'select' && slot > 0) result = contained(user)
            else if (u.op === 'after' && slot === countIds(u) - 1) result = contained(user)
            else result = false
        }
        memo.set(id, result)
        return result
    }
    for (const [id, n] of [...g.nodes]) {
        if (n.op !== 'heap-handle' || getRef(n, 0) || countIds(n) < 2) continue
        if (!contained(id)) continue
        const target = getLiteral(n, 1) as intrinsics.Handle
        const fields: Operand[] = []
        for (const key of snapshotKeys(target)) {
            const raw = heap.unboxF64(snapshotField(target, key)!)
            fields.push({ literal: key }, intrinsics.getNanId(raw) || { literal: raw })
        }
        g.nodes.set(id, makeNode('record', fields))
    }
}

export function flattenRecords(g: Graph): Graph {
    function recordParam(n: GraphNode): RecordField[] | undefined {
        if (n.op !== 'param') return
        const type = g.nodes.get(typeRefOf(n))
        return type?.op === 'record-type' ? recordFields(type) : undefined
    }
    const nodes = new Map<number, GraphNode>()
    const parts = new Map<number, number[]>()
    let nextId = g.maxId

    let seenRecord = false
    for (const b of g.blocks) {
        for (const id of b.params) {
            const record = recordParam(g.nodes.get(id)!)
            if (!record) continue
            seenRecord = true
            const fields: number[] = []
            const label = getDebugLabel(g, id) ?? 'record'
            for (const { key, type } of record) {
                const field = nextId++
                fields.push(field)
                nodes.set(field, makeNode('param', [], type))
                setDebugLabel(g, field, `${label}.${key}`)
            }
            parts.set(id, fields)
        }
    }
    if (!seenRecord) {
        for (const n of g.nodes.values()) {
            if (n.op !== 'get') continue
            seenRecord = true
            break
        }
    }
    if (!seenRecord) return g

    function operand(n: GraphNode, i: number): Value {
        return { id: getRef(n, i), constant: getLiteral(n, i) }
    }

    function keepNode(id: number): void {
        if (!id || nodes.has(id)) return
        const t = g.nodes.get(id)!
        nodes.set(id, t)
        keepNode(typeRefOf(t))
        for (let i = 0; i < countIds(t); i++) keepNode(getRef(t, i))
    }

    function keepType(n: GraphNode): void {
        keepNode(typeRefOf(n))
    }

    function make(n: GraphNode, args: Value[]): Value {
        const id = nextId++
        nodes.set(id, copyNode(n, args.map(a => a.id || { literal: a.constant })))
        return { id, constant: 0 }
    }

    const projections = new Map<string, Value>()
    function project(record: number, key: number): Value {
        const cacheKey = `${record}:${key}`
        const hit = projections.get(cacheKey)
        if (hit) return hit
        const n = g.nodes.get(record)!
        let result: Value
        if (n.op === 'record') {
            let index = -1
            for (let i = 0; i < countIds(n); i += 2) {
                if (getLiteral(n, i) === key) { index = i + 1; break }
            }
            assert(index !== -1, 'record: projection does not match shape')
            result = visit(operand(n, index))
        } else if (n.op === 'param') {
            const keys = recordParam(n)?.map(field => field.key) ?? []
            const index = keys.indexOf(key)
            assert(index >= 0, `record: projection ${key} does not match parameter shape [${keys.join(', ')}] at %${record}`)
            const fields = parts.get(record)
            assert(fields, 'record: parameter has no owning block')
            result = { id: fields[index], constant: 0 }
        } else if (n.op === 'heap-handle' && !getRef(n, 0) && countIds(n) > 1) {
            const slot = snapshotField(getLiteral(n, 1) as intrinsics.Handle, key)
            assert(slot !== undefined, `record: projection ${key} is missing from the snapshot %${record}`)
            const raw = heap.unboxF64(slot)
            const id = intrinsics.getNanId(raw)
            result = id ? visit({ id, constant: 0 }) : { id: 0, constant: raw }
        } else if (n.op === 'select') {
            const a = project(getRef(n, 1), key)
            const b = project(getRef(n, 2), key)
            result = a.id === b.id && a.constant === b.constant ? a : make(n, [visit(operand(n, 0)), a, b])
        } else if (n.op === 'after') {
            const args: Value[] = []
            for (let i = 0; i < countIds(n) - 1; i++) args.push(visit(operand(n, i)))
            result = make(n, [...args, project(getRef(n, countIds(n) - 1), key)])
        } else if (n.op === 'call') {
            const id = nextId++
            nodes.set(id, makeNode('get', [visit({ id: record, constant: 0 }).id, { literal: key }]))
            result = { id, constant: 0 }
        } else {
            throw `record: cannot project '${n.op}'`
        }
        projections.set(cacheKey, result)
        return result
    }

    function keysOf(id: number): number[] | undefined {
        const n = g.nodes.get(id)
        if (!n) return
        if (n.op === 'after') return keysOf(getRef(n, countIds(n) - 1))
        if (n.op !== 'record') return recordParam(n)?.map(field => field.key)
        const keys: number[] = []
        for (let i = 0; i < countIds(n); i += 2) keys.push(getLiteral(n, i))
        return keys
    }

    const rewritten = new Map<number, Value>()
    function visit(value: Value): Value {
        if (!value.id) return value
        const hit = rewritten.get(value.id)
        if (hit) return hit
        const n = g.nodes.get(value.id)
        assert(n, `record: missing value ${value.id}`)
        if (n.op === 'get' && g.nodes.get(getRef(n, 0))?.op !== 'call') {
            assert(!getRef(n, 1), 'record: dynamic projection key')
            const result = project(getRef(n, 0), getLiteral(n, 1))
            rewritten.set(value.id, result)
            return result
        }
        const returned = n.op === 'ret' ? keysOf(getRef(n, 0)) : undefined
        if (returned) {
            const fields: Operand[] = []
            for (const key of returned) {
                const field = project(getRef(n, 0), key)
                fields.push({ literal: key }, field.id || { literal: field.constant })
            }
            const record = nextId++
            nodes.set(record, makeNode('record', fields))
            const args: Value[] = [{ id: record, constant: 0 }]
            for (let i = 1; i < countIds(n); i++) args.push(visit(operand(n, i)))
            nodes.set(value.id, copyNode(n, args.map(a => a.id || { literal: a.constant })))
            rewritten.set(value.id, value)
            return value
        }
        assert(n.op !== 'record' && !recordParam(n), `record: aggregate escapes through '${n.op}' %${value.id}`)
        const args: Value[] = []
        if (n.op === 'apply') {
            args.push(visit(operand(n, 0)))
            const target = getBlock(g, getRef(n, 0))!
            assert(target.params.length + 1 === countIds(n), 'record: application arity mismatch')
            for (let i = 0; i < target.params.length; i++) {
                const record = recordParam(g.nodes.get(target.params[i])!)
                if (!record) { args.push(visit(operand(n, i + 1))); continue }
                for (const { key } of record) args.push(project(getRef(n, i + 1), key))
            }
        } else {
            for (let i = 0; i < countIds(n); i++) args.push(visit(operand(n, i)))
        }
        nodes.set(value.id, copyNode(n, args.map(a => a.id || { literal: a.constant })))
        keepType(n)
        rewritten.set(value.id, value)
        return value
    }

    const blocks = g.blocks.map(b => {
        const body = visit({ id: b.bodyId, constant: b.bodyConst })
        const params: number[] = []
        for (let i = 0; i < b.params.length; i++) {
            const fields = parts.get(b.params[i])
            for (const id of fields ?? [b.params[i]]) {
                params.push(id)
                if (!fields) visit({ id, constant: 0 })
            }
        }
        return { ...b, params, bodyId: body.id, bodyConst: body.constant }
    })
    const out = { ...g, nodes, maxId: nextId }
    setGraphBlocks(out, blocks)
    return out
}
