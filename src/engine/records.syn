/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { snapshotField, snapshotKeys } from './heap-records'
import type { Graph, GraphNode } from './lowering2'
import {
    copyNode, countIds, getBlock, getDebugLabel, getLiteral, getRef,
    makeNode, newId, type Operand, recordFields, setDebugLabel, type RecordField, typeRefOf, withNodes,
    NodeOp,
    opName,
    getNode, setNode,
    putNode,
    putCopy,
    setGraphBlocks,
    hasNode,
    nodeUsers, allNodes, nodeEntries, nodeIds,
} from './graph-node'

const assert = intrinsics.assert
interface Value { id: number, constant: number }

export function recordSnapshots(g: Graph): void {
    const snapshots: number[] = []
    for (const [id, n] of nodeEntries(g)) if (n.op === NodeOp.heapHandle && !getRef(n, 0) && countIds(n) >= 2) snapshots.push(id)
    if (!snapshots.length) return
    const users = nodeUsers(g, nodeIds(g), true)
    const bodies = new Set(g.blocks.map(b => b.bodyId))
    const returnedBy = new Map<number, number>()
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.inlined) continue
        const seen = new Set<number>()
        const stack = [getRef(n, 0)]
        while (stack.length) {
            const at = stack.pop()!
            const m = at && !seen.has(at) ? getNode(g, at) : undefined
            if (!m) continue
            seen.add(at)
            if (m.op === NodeOp.ret) returnedBy.set(at, id)
            else if (m.op === NodeOp.after) stack.push(getRef(m, countIds(m) - 1))
            else if (m.op === NodeOp.select) for (let i = 1; i < countIds(m); i++) stack.push(getRef(m, i))
            else if (m.op === NodeOp.apply) stack.push(getBlock(g, getRef(m, 0))?.bodyId ?? 0)
        }
    }
    function recordParam(id: number): boolean {
        const param = getNode(g, id)
        return param?.op === NodeOp.param && getNode(g, typeRefOf(param))?.op === NodeOp.recordType
    }
    const memo = new Map<number, boolean>()
    function contained(id: number): boolean {
        const known = memo.get(id)
        if (known !== undefined) return known
        memo.set(id, true)
        let result = !bodies.has(id)
        for (const [user, slot] of users.get(id) ?? []) {
            if (!result) break
            const u = getNode(g, user)!
            if (u.op === NodeOp.get && slot === 0) continue
            if (u.op === NodeOp.apply && slot > 0 && recordParam(getBlock(g, getRef(u, 0))?.params[slot - 1] ?? 0)) continue
            if (u.op === NodeOp.after && slot < countIds(u) - 1) continue
            if (u.op === NodeOp.select && slot > 0) result = contained(user)
            else if (u.op === NodeOp.after) result = contained(user)
            else if (u.op === NodeOp.ret && returnedBy.has(user)) result = contained(returnedBy.get(user)!)
            else result = false
        }
        memo.set(id, result)
        return result
    }
    for (const id of snapshots) {
        if (!contained(id)) continue
        const target = getLiteral(g, getNode(g, id)!, 1) as intrinsics.Handle
        const fields: Operand[] = []
        for (const key of snapshotKeys(target)) {
            const raw = heap.unboxF64(snapshotField(target, key)!)
            fields.push({ literal: key }, intrinsics.getNanId(raw) || { literal: raw })
        }
        putNode(g, id, NodeOp.record, fields)
    }
}

export function flattenRecords(g: Graph): Graph {
    function recordParam(n: GraphNode): RecordField[] | undefined {
        if (n.op !== NodeOp.param) return
        const type = getNode(g, typeRefOf(n))
        return type?.op === NodeOp.recordType ? recordFields(g, type) : undefined
    }
    const out = withNodes(g, new Map())
    const parts = new Map<number, number[]>()

    let seenRecord = false
    for (const b of g.blocks) {
        for (const id of b.params) {
            const record = recordParam(getNode(g, id)!)
            if (!record) continue
            seenRecord = true
            const fields: number[] = []
            const label = getDebugLabel(g, id) ?? 'record'
            for (const { key, type } of record) {
                const field = newId(g)
                fields.push(field)
                putNode(out, field, NodeOp.param, [], type)
                setDebugLabel(g, field, `${label}.${key}`)
            }
            parts.set(id, fields)
        }
    }
    if (!seenRecord) {
        for (const n of allNodes(g)) {
            if (n.op !== NodeOp.get) continue
            seenRecord = true
            break
        }
    }
    if (!seenRecord) return g

    function operand(n: GraphNode, i: number): Value {
        return { id: getRef(n, i), constant: getLiteral(out, n, i) }
    }

    function keepNode(id: number): void {
        if (!id || hasNode(out, id)) return
        const t = getNode(g, id)!
        setNode(out, id, t)
        keepNode(typeRefOf(t))
        for (let i = 0; i < countIds(t); i++) keepNode(getRef(t, i))
    }

    function keepType(n: GraphNode): void {
        keepNode(typeRefOf(n))
    }

    function make(n: GraphNode, args: Value[]): Value {
        const id = newId(g)
        putCopy(out, id, n, args.map(a => a.id || { literal: a.constant }))
        return { id, constant: 0 }
    }

    const projections = new Map<string, Value>()
    function project(record: number, key: number): Value {
        const cacheKey = `${record}:${key}`
        const hit = projections.get(cacheKey)
        if (hit) return hit
        const n = getNode(g, record)!
        let result: Value
        if (n.op === NodeOp.record) {
            let index = -1
            for (let i = 0; i < countIds(n); i += 2) {
                if (getLiteral(out, n, i) === key) { index = i + 1; break }
            }
            assert(index !== -1, 'record: projection does not match shape')
            result = visit(operand(n, index))
        } else if (n.op === NodeOp.param) {
            const keys = recordParam(n)?.map(field => field.key) ?? []
            const index = keys.indexOf(key)
            assert(index >= 0, `record: projection ${key} does not match parameter shape [${keys.join(', ')}] at %${record}`)
            const fields = parts.get(record)
            assert(fields, 'record: parameter has no owning block')
            result = { id: fields[index], constant: 0 }
        } else if (n.op === NodeOp.select) {
            const a = project(getRef(n, 1), key)
            const b = project(getRef(n, 2), key)
            result = uninitialized(a) ? b : uninitialized(b) || (a.id === b.id && a.constant === b.constant) ? a : make(n, [visit(operand(n, 0)), a, b])
        } else if (n.op === NodeOp.after) {
            const args: Value[] = []
            for (let i = 0; i < countIds(n) - 1; i++) args.push(visit(operand(n, i)))
            result = make(n, [...args, project(getRef(n, countIds(n) - 1), key)])
        } else if (n.op === NodeOp.call) {
            const id = newId(g)
            putNode(out, id, NodeOp.get, [visit({ id: record, constant: 0 }).id, { literal: key }])
            result = { id, constant: 0 }
        } else {
            throw `record: cannot project '${n.op}'`
        }
        projections.set(cacheKey, result)
        return result
    }

    function keysOf(id: number): number[] | undefined {
        const n = getNode(g, id)
        if (!n) return
        if (n.op === NodeOp.after) return keysOf(getRef(n, countIds(n) - 1))
        if (n.op !== NodeOp.record) return recordParam(n)?.map(field => field.key)
        const keys: number[] = []
        for (let i = 0; i < countIds(n); i += 2) keys.push(getLiteral(out, n, i))
        return keys
    }

    function uninitialized(value: Value): boolean {
        return !!value.id && getNode(g, value.id)?.op === NodeOp.uninitialized
    }

    const rewritten = new Map<number, Value>()
    function visit(value: Value): Value {
        if (!value.id) return value
        const hit = rewritten.get(value.id)
        if (hit) return hit
        const n = getNode(g, value.id)
        assert(n, `record: missing value ${value.id}`)
        if (n.op === NodeOp.get && getNode(g, getRef(n, 0))?.op !== NodeOp.call) {
            assert(!getRef(n, 1), 'record: dynamic projection key')
            const result = project(getRef(n, 0), getLiteral(out, n, 1))
            rewritten.set(value.id, result)
            return result
        }
        const returned = n.op === NodeOp.ret ? keysOf(getRef(n, 0)) : undefined
        if (returned) {
            const fields: Operand[] = []
            for (const key of returned) {
                const field = project(getRef(n, 0), key)
                fields.push({ literal: key }, field.id || { literal: field.constant })
            }
            const record = newId(g)
            putNode(out, record, NodeOp.record, fields)
            const args: Value[] = [{ id: record, constant: 0 }]
            for (let i = 1; i < countIds(n); i++) args.push(visit(operand(n, i)))
            putCopy(out, value.id, n, args.map(a => a.id || { literal: a.constant }))
            rewritten.set(value.id, value)
            return value
        }
        assert(n.op !== NodeOp.record && !recordParam(n), `record: aggregate escapes through '${opName(n.op)}' %${value.id}`)
        const args: Value[] = []
        if (n.op === NodeOp.apply) {
            args.push(visit(operand(n, 0)))
            const target = getBlock(g, getRef(n, 0))!
            assert(target.params.length + 1 === countIds(n), 'record: application arity mismatch')
            for (let i = 0; i < target.params.length; i++) {
                const record = recordParam(getNode(g, target.params[i])!)
                if (!record) { args.push(visit(operand(n, i + 1))); continue }
                for (const { key } of record) args.push(project(getRef(n, i + 1), key))
            }
        } else {
            for (let i = 0; i < countIds(n); i++) args.push(visit(operand(n, i)))
        }
        if (n.op === NodeOp.store && uninitialized(args[3])) {
            rewritten.set(value.id, args[0])
            return args[0]
        }
        putCopy(out, value.id, n, args.map(a => a.id || { literal: a.constant }))
        keepType(n)
        rewritten.set(value.id, value)
        return value
    }

    const blocks = g.blocks.map(b => {
        const body = visit({ id: b.bodyId, constant: b.bodyConst })
        const params: number[] = []
        for (let i = 0; i < b.params.length; i++) {
            const fields = parts.get(b.params[i])
            for (const id of fields ?? [b.params[i]]) {
                params.push(id)
                if (!fields) visit({ id, constant: 0 })
            }
        }
        visit({ id: b.id, constant: 0 })
        return { ...b, params, bodyId: body.id, bodyConst: body.constant }
    })
    setGraphBlocks(out, blocks)
    return out
}
