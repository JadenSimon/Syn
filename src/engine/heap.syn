/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import { rt, bind, Op as RtOp } from './rt'
import { allocate } from './builtin/memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

type usize = u32
export type Handle = intrinsics.Handle
type RawPtr = intrinsics.RawPtr

export const boxedCellBit = 1 << 30

export const undefinedHandle = intrinsics.undefinedHandle
export const nullHandle = intrinsics.nullHandle
export const emptyStringHandle = intrinsics.emptyStringHandle
export const falseHandle = intrinsics.falseHandle
export const trueHandle = intrinsics.trueHandle

export const fixedHandles = [undefinedHandle, nullHandle, emptyStringHandle, falseHandle, trueHandle]

export function isNullishHandle(handle: Handle): boolean {
    return handle === undefinedHandle || handle === nullHandle
}

export function isOddballHandle(handle: Handle): boolean {
    return isNullishHandle(handle) || handle === falseHandle || handle === trueHandle
}

export function isFalsyHandle(handle: Handle): boolean {
    return handle <= falseHandle
}
export const pstackWordTag = 0xc0000000
export const pstackBoxWordTag = 0xe0000000

bind(RtOp.handleof, { host: (value: any): Handle => value })
bind(RtOp.stringOf, { host: (handle: Handle): any => handle })
bind(RtOp.heapaddr, { host: (handle: Handle): usize => (handle & ~boxedCellBit) as usize })

export interface HeapAllocator {
    allocate(bytes: usize): Handle
    resolve(handle: Handle): usize
    finish(handle: Handle): void
}

function runtimeAllocate(bytes: usize): Handle {
    const next = rt.heapaddr(runtimeCells)
    const handle = Intrinsics.load(next, 0, Types.u32) as Handle
    Intrinsics.store(next, 0, handle + ((bytes + 7) & ~7), Types.u32)
    return handle
}

function bootstrapAllocate(bytes: usize): Handle {
    if (intrinsics.isNative()) return runtimeAllocate(bytes)
    return Intrinsics.alloc(bytes) as Handle
}

function bootstrapResolve(handle: Handle): usize {
    return rt.heapaddr(handle)
}

function bootstrapFinish(_handle: Handle): void {}

const bootstrapAllocator: HeapAllocator = {
    allocate: bootstrapAllocate,
    resolve: bootstrapResolve,
    finish: bootstrapFinish,
}

let allocateCell = bootstrapAllocate
let resolveCell = bootstrapResolve
let finishCell = bootstrapFinish

export function setHeapAllocator(allocator: HeapAllocator): HeapAllocator {
    const previous = {
        allocate: allocateCell,
        resolve: resolveCell,
        finish: finishCell,
    }
    allocateCell = allocator.allocate
    resolveCell = allocator.resolve
    finishCell = allocator.finish
    return previous
}

export function resetHeapAllocator(): void {
    setHeapAllocator(bootstrapAllocator)
}

export function allocateHeapCell(bytes: usize): Handle {
    return allocateCell(bytes)
}

export function resolveHeapCell(handle: Handle): usize {
    return resolveCell(handle)
}

export function finishHeapCell(handle: Handle): void {
    finishCell(handle)
}

intrinsics.tagInline(runtimeAllocate)
intrinsics.tagInline(bootstrapAllocate)
intrinsics.tagInline(bootstrapResolve)
intrinsics.tagInline(bootstrapFinish)
intrinsics.tagInline(allocateHeapCell)
intrinsics.tagInline(resolveHeapCell)
intrinsics.tagInline(finishHeapCell)

// an "Object" is the only TD with conventional field descriptors
// certain Object variants are wrappers around a different base. wrapping a function uniquely preserves its "typeof" value.
enum BaseTypeKind {
    oddball = 1, // true/false/undefined/null etc.
    string = 2,
    number = 3,
    symbol = 4,
    array = 5,
    object = 6,
    fn = 7,
    proxy = 8,

    string_table = 128,
    native_struct = 132,
}

enum TDFlags {
    callable = 1 << 0,
    // anything managing data offheap will need this set
    has_destructor = 1 << 1,
    // means an instance _might_ be ok to stack allocate
    stack_allocatable = 1 << 7,
}

// all strings are assumed utf-8 unless named otherwise
enum StringVariant {
    inline = 1, // slot1 contains packed code units, length is extraSlots + 1. The TD _is_ the string!
    internal = 2, // instance has the index into a string table, slot1 of the TD is the string table
    external = 3, // instance has a raw ptr to its bytes, slot1 of the TD is the prototype
    interned = 4,
}

// shared data for describing the interpretation of a heap cell
interface TypeDescriptorHeader {
    kind: u8
    variant: u8
    extraSlots: u8 // # of extra slots, these live past the header
    flags: u8
    slot1: Handle
}

export const TypeDescriptor = intrinsics.DefineStructView(reify TypeDescriptorHeader)

const cellViews = new Map<Handle, intrinsics.StructViewFactory<any>>()

export function cellViewOf(td: Handle): intrinsics.StructViewFactory<any> | undefined {
    return cellViews.get(td) ?? functionView(td)
}

const typeDescriptors = new Set<Handle>()

export function isTypeDescriptor(handle: Handle): boolean {
    return typeDescriptors.has(handle)
}

function allocTypeDescriptor(kind: u8, variant: u8, extraSlots: u8, flags: u8, slot1: Handle = 0 as Handle) {
    const size = TypeDescriptor.sizeof + (extraSlots as u32) * 4
    const handle = allocateHeapCell(size)
    typeDescriptors.add(handle)
    const td = TypeDescriptor(resolveHeapCell(handle))
    td.kind = kind
    td.variant = variant
    td.extraSlots = extraSlots
    td.flags = flags
    td.slot1 = slot1
    finishHeapCell(handle)
    return handle
}

interface HeapF64 {
    td: Handle
    value: f64
}

const HeapF64 = intrinsics.DefineStructView(reify HeapF64)
const heapF64TD = allocTypeDescriptor(BaseTypeKind.number, Types.f64, 0, 0)
export const boxTypeDescriptor = heapF64TD
export const boxValueOffset = intrinsics.offsetof(reify HeapF64, 'value')

const f64NanCache = new Map<number, Handle>() // XXX: perf
const f64NanIds = new Map<Handle, number>()
export function clearNanCache() {
    f64NanCache.clear()
    f64NanIds.clear()
}
export function boxF64(value: f64): Handle {
    const id = intrinsics.getNanId(value)
    if (id) {
        if (const cached = f64NanCache.get(id)) return cached
    }
    const handle = (allocateHeapCell(HeapF64.sizeof) | boxedCellBit) as Handle
    const boxed = HeapF64(resolveHeapCell(handle))
    boxed.td = heapF64TD
    boxed.value = value
    finishHeapCell(handle)
    if (id) {
        f64NanCache.set(id, handle)
        f64NanIds.set(handle, id)
    }
    return handle
}

export function boxSymbol(id: number): Handle {
    return boxF64(intrinsics.getNanFromId(id))
}

export function setBoxedF64(handle: Handle, value: f64): void {
    HeapF64(resolveHeapCell(handle)).value = value
    const id = intrinsics.getNanId(value)
    if (!id) return
    f64NanCache.set(id, handle)
    f64NanIds.set(handle, id)
}

export function boxedNanId(value: Handle): number {
    const known = f64NanIds.get(value)
    if (known !== undefined) return known
    return isBoxedF64(value) ? intrinsics.getNanId(unboxF64(value)) : 0
}

interface HeapIndirect {
    td: Handle
    target: Handle
    stash: Handle
}

const HeapIndirect = intrinsics.DefineStructView(reify HeapIndirect)
const heapIndirectTD = allocTypeDescriptor(BaseTypeKind.object, 254, 0, 0)

export function makeIndirect(target: Handle): Handle {
    const handle = allocateHeapCell(HeapIndirect.sizeof)
    const cell = HeapIndirect(resolveHeapCell(handle))
    cell.td = heapIndirectTD
    cell.target = target
    cell.stash = 0 as Handle
    finishHeapCell(handle)
    return handle
}

export function indirectStash(cell: Handle): Handle {
    return HeapIndirect(resolveHeapCell(cell)).stash
}

export function setIndirectStash(cell: Handle, stash: Handle): void {
    HeapIndirect(resolveHeapCell(cell)).stash = stash
}

export function prepareWrite(cell: Handle): Handle {
    const c = HeapIndirect(resolveHeapCell(cell))
    if (c.stash && c.target === c.stash) c.target = shallowClone(c.target)
    return c.target
}

const indirectVariant = 254

export function hasPropertySlot(cell: Handle): boolean {
    const td = typeDescriptorOf(cell)
    return td !== heapIndirectTD && !isSymbolTD(td) && !isBoxedF64(cell)
}

export function isIndirect(value: Handle): boolean {
    if (!value) return false
    const td = HeapObject(resolveHeapCell(value)).td
    if (!td) return false
    return TypeDescriptor(resolveHeapCell(td)).variant === indirectVariant
}

export function indirectTarget(cell: Handle): Handle {
    return HeapIndirect(resolveHeapCell(cell)).target
}

export function setIndirectTarget(cell: Handle, target: Handle): void {
    HeapIndirect(resolveHeapCell(cell)).target = target
}

export function deref(obj: Handle): Handle {
    return isIndirect(obj) ? HeapIndirect(resolveHeapCell(obj)).target : obj
}

intrinsics.tagInline(isIndirect)
intrinsics.tagInline(indirectTarget)
intrinsics.tagInline(deref)
intrinsics.tagInline(prepareWrite)

export function isBoxedF64(value: Handle): boolean {
    return value !== 0 && HeapObject(resolveHeapCell(value)).td === heapF64TD
}

export function unboxF64(value: Handle): f64 {
    return HeapF64(resolveHeapCell(value)).value
}

// ---- strings --------------------------------------------------------------
// utf-8 centric
interface HeapString {
    td: Handle
    properties?: Handle
    length: u32     // byte length
    hash: u32
    ptr: RawPtr     // -> utf-8 bytes (external variant)
}

export const HeapString = intrinsics.DefineStructView(reify HeapString)

enum SymbolVariant {
    ordinary = 0,
    private_name = 1,
}

const externalStringTD = allocTypeDescriptor(BaseTypeKind.string, StringVariant.external, 0, TDFlags.has_destructor)
const internedStringTD = allocTypeDescriptor(BaseTypeKind.string, StringVariant.interned, 0, TDFlags.has_destructor)
const symbolTD = allocTypeDescriptor(BaseTypeKind.symbol, SymbolVariant.ordinary, 0, 0)
const privateSymbolTD = allocTypeDescriptor(BaseTypeKind.symbol, SymbolVariant.private_name, 0, 0)
const keyTDStride = internedStringTD - externalStringTD
intrinsics.assert(keyTDStride > 0 && symbolTD - internedStringTD === keyTDStride && privateSymbolTD - symbolTD === keyTDStride, 'heap: string and symbol TDs must be contiguous')

function isStringTD(td: Handle): boolean {
    return td >= externalStringTD && td <= internedStringTD
}

function isSymbolTD(td: Handle): boolean {
    return td >= symbolTD && td <= privateSymbolTD
}

cellViews.set(externalStringTD, HeapString)
cellViews.set(internedStringTD, HeapString)
export const stringTypeDescriptors = [externalStringTD, internedStringTD]

export function setStringPrototype(proto: Handle): void {
    TypeDescriptor(resolveHeapCell(externalStringTD)).slot1 = proto
    TypeDescriptor(resolveHeapCell(internedStringTD)).slot1 = proto
}

function allocString(bytes: Uint8Array): Handle {
    const length = bytes.length as u32
    const handle = allocateHeapCell(HeapString.sizeof)
    const str = HeapString(resolveHeapCell(handle))
    const data = Intrinsics.alloc(length === 0 ? 1 : length)
    for (let i: u32 = 0; i < length; i++) {
        Intrinsics.store(data, i, bytes[i], Types.u8)
    }

    str.td = internedStringTD
    str.properties = 0 as Handle
    str.length = length
    str.hash = bytesHash(data, length)
    str.ptr = data as RawPtr
    finishHeapCell(handle)
    return handle
}

// copies `s` (as utf-8) onto the heap, returns the string instance's address
const internedStrings = new Map<string, Handle>()

interface HeapOddball {
    td: Handle
}

const HeapOddball = intrinsics.DefineStructView(reify HeapOddball)

intrinsics.assert(trueHandle + 8 <= intrinsics.reservedHeapBytes && emptyStringHandle + HeapString.sizeof <= falseHandle, 'heap: fixed cells do not fit the reserved prefix')

function initOddball(handle: Handle, td: Handle): Handle {
    HeapOddball(resolveHeapCell(handle)).td = td
    cellViews.set(td, HeapOddball)
    return td
}

export const oddballTypeDescriptors = [
    initOddball(undefinedHandle, allocTypeDescriptor(BaseTypeKind.oddball, 1, 0, 0)),
    initOddball(nullHandle, allocTypeDescriptor(BaseTypeKind.oddball, 2, 0, 0)),
    initOddball(falseHandle, allocTypeDescriptor(BaseTypeKind.oddball, 4, 0, 0)),
    initOddball(trueHandle, allocTypeDescriptor(BaseTypeKind.oddball, 5, 0, 0)),
]

function initEmptyString(): void {
    const str = HeapString(resolveHeapCell(emptyStringHandle))
    const data = Intrinsics.alloc(1)
    str.td = internedStringTD
    str.properties = 0 as Handle
    str.length = 0
    str.hash = bytesHash(data, 0)
    str.ptr = data as RawPtr
    internedStrings.set('', emptyStringHandle)
}

initEmptyString()

export function fromJsString(s: string): Handle {
    if (intrinsics.isNative()) return rt.handleof(s)
    const known = internedStrings.get(s)
    if (known !== undefined) return known
    const handle = allocString(new TextEncoder().encode(s))
    internedStrings.set(s, handle)
    return handle
}

export const runtimeCells = intrinsics.heapMaxAddress as Handle

if (!intrinsics.isNative()) Intrinsics.store(resolveHeapCell(runtimeCells), 0, runtimeCells + 8, Types.u32)

export function externalString(data: u32, length: u32): Handle {
    const next = resolveHeapCell(runtimeCells)
    const handle = Intrinsics.load(next, 0, Types.u32) as Handle
    Intrinsics.store(next, 0, handle + HeapString.sizeof, Types.u32)
    const str = HeapString(resolveHeapCell(handle))
    str.td = externalStringTD
    str.properties = 0 as Handle
    str.length = length
    str.hash = bytesHash(data, length)
    str.ptr = data as RawPtr
    return handle
}

export function concatStrings(lhs: Handle, rhs: Handle): Handle {
    const a = HeapString(resolveHeapCell(lhs))
    const b = HeapString(resolveHeapCell(rhs))
    const data = allocate(a.length + b.length)
    for (let i: u32 = 0; i < a.length; i++) Intrinsics.store(data, i, Intrinsics.load(a.ptr, i, Types.u8), Types.u8)
    for (let i: u32 = 0; i < b.length; i++) Intrinsics.store(data, a.length + i, Intrinsics.load(b.ptr, i, Types.u8), Types.u8)
    return externalString(data, a.length + b.length)
}


export function numberToString(bits: u64): Handle {
    const x = Intrinsics.bitconvert(bits, Types.u64, Types.f64)
    const whole = Intrinsics.convert(x, Types.f64, Types.i64)
    if (Intrinsics.convert(whole, Types.i64, Types.f64) !== x) Intrinsics.panic('numberToString: non-integer numbers are not formatted natively')
    return integerToString(whole)
}

function integerToString(whole: number): Handle {
    const negative = whole < 0
    let n = Intrinsics.convert(negative ? Intrinsics.sub(0, whole, Types.i64) : whole, Types.i64, Types.u64)
    const data = allocate(20)
    let at: u32 = 20
    do {
        at = at - 1
        Intrinsics.store(data, at, Intrinsics.add(48, Intrinsics.rem(n, 10, Types.u64), Types.u64), Types.u8)
        n = Intrinsics.div(n, 10, Types.u64)
    } while (n !== 0)
    if (negative) {
        at = at - 1
        Intrinsics.store(data, at, 45, Types.u8)
    }
    return externalString(data + at, 20 - at)
}

export const valueNames = {
    undefined: fromJsString('undefined'),
    null: fromJsString('null'),
    true: fromJsString('true'),
    false: fromJsString('false'),
    object: fromJsString('[object Object]'),
}

export function textOf(value: any): Handle {
    if (typeof value !== 'number') return typeof value === 'string' ? value : nameOf(value)
    if (Intrinsics.typeof(value) !== Types.f64) return integerToString(value)
    return numberToString(Intrinsics.bitconvert(value, Types.f64, Types.u64))
}

function nameOf(value: any): Handle {
    if (value === undefined) return valueNames.undefined
    if (value === null) return valueNames.null
    if (value === true) return valueNames.true
    if (value === false) return valueNames.false
    return valueNames.object
}

export function concatValues(lhs: any, rhs: any): Handle {
    return concatStrings(textOf(lhs), textOf(rhs))
}

function hostText(cell: Handle): string {
    if (cell === undefinedHandle) return 'undefined'
    if (cell === nullHandle) return 'null'
    if (isBoxedF64(cell)) return String(unboxF64(cell))
    if (isString(cell)) return stringToJs(cell)
    return '[object Object]'
}

function hostConcat(lhs: Handle, rhs: Handle): Handle {
    return fromJsString(hostText(lhs) + hostText(rhs))
}

function addOrConcat(lhs: any, rhs: any): any {
    if (typeof lhs === 'string') return rt.concat(lhs, rhs)
    if (typeof rhs === 'string') return rt.concat(lhs, rhs)
    return +lhs + +rhs
}

bind(RtOp.concat, { host: hostConcat, impl: concatValues })
bind(RtOp.addOrConcat, { host: (lhs: Handle, rhs: Handle): Handle => isString(lhs) || isString(rhs) ? hostConcat(lhs, rhs) : boxF64(unboxF64(lhs) + unboxF64(rhs)), impl: addOrConcat })
bind(RtOp.toString, { host: (cell: Handle): Handle => fromJsString(hostText(cell)), impl: textOf })


export function stringLength(addr: Handle): u32 {
    return HeapString(resolveHeapCell(addr)).length
}

export function stringToJs(addr: Handle): string {
    if (intrinsics.isNative()) return rt.stringOf(addr)
    const str = HeapString(resolveHeapCell(addr))
    const length = str.length
    const ptr = str.ptr
    const bytes = new Uint8Array(length)
    for (let i: u32 = 0; i < length; i++) {
        bytes[i] = Intrinsics.load(ptr, i, Types.u8)
    }
    return new TextDecoder().decode(bytes)
}

interface HeapSymbol { td: Handle, description: Handle }
const HeapSymbol = intrinsics.DefineStructView(reify HeapSymbol)
const symbols = new Map<symbol, Handle>()

export function makeSymbol(description: Handle = 0 as Handle, td: Handle = symbolTD): Handle {
    const handle = allocateHeapCell(HeapSymbol.sizeof)
    const value = HeapSymbol(resolveHeapCell(handle))
    value.td = td
    value.description = description
    finishHeapCell(handle)
    return handle
}

function internSymbol(value: symbol, td: Handle): Handle {
    const known = symbols.get(value)
    if (known !== undefined) return known
    const handle = makeSymbol(value.description === undefined ? 0 as Handle : fromJsString(value.description), td)
    symbols.set(value, handle)
    return handle
}

export function fromJsSymbol(value: symbol): Handle {
    return internSymbol(value, symbolTD)
}

export function fromPrivateName(value: symbol): Handle {
    const handle = internSymbol(value, privateSymbolTD)
    intrinsics.assert(isPrivateName(handle), 'heap: private name was interned as an ordinary symbol')
    return handle
}

export function isPrivateName(key: Handle): boolean {
    return typeDescriptorOf(key) === privateSymbolTD
}

function isSymbol(value: Handle): boolean {
    return isSymbolTD(typeDescriptorOf(value))
}

export const symbolConstants = Object.fromEntries(Object.getOwnPropertyNames(Symbol)
    .filter(key => typeof Symbol[key] === 'symbol').map(key => [key, Symbol[key]]))

export function propertyKeysEqual(a: Handle, b: Handle): boolean {
    if (a === b) return true
    if (isSymbol(a) || isSymbol(b)) return false
    return stringBytesEqual(a, b)
}

const symbolHashBit: u32 = 0x8000_0000

function propertyKeyHash(key: Handle): u32 {
    if (isSymbol(key)) return symbolHashBit + key
    return HeapString(resolveHeapCell(key)).hash
}

export function stringBytesEqual(a: Handle, b: Handle): boolean {
    const sa = HeapString(resolveHeapCell(a))
    const sb = HeapString(resolveHeapCell(b))
    if (sa.hash !== sb.hash) return false
    const length = sa.length
    if (length !== sb.length) return false
    const pa = sa.ptr
    const pb = sb.ptr
    for (let i: u32 = 0; i < length; i++) {
        if (Intrinsics.load(pa, i, Types.u8) !== Intrinsics.load(pb, i, Types.u8)) return false
    }
    return true
}

export function strictEquals(lhs: any, rhs: any): boolean {
    const a = rt.handleof(lhs)
    const b = rt.handleof(rhs)
    if (a === b) return typeof lhs === typeof rhs
    if (typeof lhs !== 'string' || typeof rhs !== 'string') return false
    return stringBytesEqual(a, b)
}

bind(RtOp.strictEqual, { impl: strictEquals })

// XXX: DO NOT USE UTF16 FOR ANYTHING NEW, THIS IS LEGACY, WE ARE UTF8 FIRST
function utf16Lead(p: RawPtr, at: u32): u32 {
    const b0 = Intrinsics.load(p, at, Types.u8)
    if (b0 < 0x80) return b0
    const b1 = Intrinsics.load(p, at + 1, Types.u8) & 0x3F
    if (b0 < 0xE0) return ((b0 & 0x1F) << 6) | b1
    const b2 = Intrinsics.load(p, at + 2, Types.u8) & 0x3F
    if (b0 < 0xF0) return ((b0 & 0x0F) << 12) | (b1 << 6) | b2
    const b3 = Intrinsics.load(p, at + 3, Types.u8) & 0x3F
    const point = ((b0 & 0x07) << 18) | (b1 << 12) | (b2 << 6) | b3
    return 0xD800 + ((point - 0x10000) >> 10)
}

export function compareStrings(a: Handle, b: Handle): number {
    const sa = HeapString(resolveHeapCell(a))
    const sb = HeapString(resolveHeapCell(b))
    const pa = sa.ptr
    const pb = sb.ptr
    const length = sa.length < sb.length ? sa.length : sb.length
    let i: u32 = 0
    while (i < length && Intrinsics.load(pa, i, Types.u8) === Intrinsics.load(pb, i, Types.u8)) {
        i = i + 1
    }
    if (i === length) return sa.length < sb.length ? -1 : sa.length > sb.length ? 1 : 0
    let start = i
    while (start > 0 && (Intrinsics.load(pa, start, Types.u8) & 0xC0) === 0x80) {
        start = start - 1
    }
    const x = utf16Lead(pa, start)
    const y = utf16Lead(pb, start)
    if (x !== y) return x < y ? -1 : 1
    return Intrinsics.load(pa, i, Types.u8) < Intrinsics.load(pb, i, Types.u8) ? -1 : 1
}

export function compareValues(lhs: any, rhs: any): number {
    if (typeof lhs === 'string' && typeof rhs === 'string') return compareStrings(rt.handleof(lhs), rt.handleof(rhs))
    const a = +lhs
    const b = +rhs
    if (a < b) return -1
    if (a > b) return 1
    if (a === b) return 0
    return NaN
}

bind(RtOp.compare, { impl: compareValues })

export function truthy(value: any): boolean {
    if (value === undefined || value === false) return false
    if (typeof value === 'number') return value !== 0
    if (typeof value !== 'string') return true
    return HeapString(resolveHeapCell(rt.handleof(value))).length !== 0
}

bind(RtOp.truthy, { impl: truthy })

function bytesHash(data: u64, length: u32): u32 {
    const words = length & 0xFFFF_FFFC
    let h: u32 = 0xFFFF_FFFF
    let i: u32 = 0
    while (i < words) {
        h = Intrinsics.crc32(h, Intrinsics.load(data, i, Types.u32), Types.u32)
        i = i + 4
    }
    while (i < length) {
        h = Intrinsics.crc32(h, Intrinsics.load(data, i, Types.u8), Types.u8)
        i = i + 1
    }
    return Intrinsics.ushr(h, 1, Types.u32)
}

const stringHashOffset = intrinsics.offsetof(reify HeapString, 'hash')
export const stringLengthOffset = intrinsics.offsetof(reify HeapString, 'length')
export const stringPtrOffset = intrinsics.offsetof(reify HeapString, 'ptr')

export function handleHash(value: any): u32 {
    if (typeof value !== 'string') return Intrinsics.crc32(0, Intrinsics.bitconvert(value, Types.vm_value, Types.u32), Types.u32)
    return Intrinsics.load(resolveHeapCell(rt.handleof(value)), stringHashOffset, Types.u32)
}

bind(RtOp.handleHash, { host: (cell: Handle): u32 => isString(cell) ? HeapString(resolveHeapCell(cell)).hash : Intrinsics.crc32(0, cell, Types.u32), impl: handleHash })

// ---- objects --------------------------------------------------------------

export enum PropFlags {
    enumerable = 1 << 0,
    configurable = 1 << 1,
    writable = 1 << 2,
    has_getter = 1 << 3,
    has_setter = 1 << 4,
}

const dataPropertyFlags: u8 = PropFlags.enumerable | PropFlags.configurable | PropFlags.writable

interface FullPropertyDescriptor {
    flags: u8
    slot0: u32 // value, or getter
    slot1: u32 // setter (accessor only)
}

export const FullPropertyDescriptor = intrinsics.DefineStructView(reify FullPropertyDescriptor)

interface PropertyEntry {
    key: Handle
    hash: u32
    descriptor: Handle // -> FullPropertyDescriptor
}

const PropertyEntry = intrinsics.DefineStructView(reify PropertyEntry)

interface PropertyDict {
    count: u32
    capacity: u32
    entries: Handle // -> PropertyEntry[capacity]
}

const PropertyDict = intrinsics.DefineStructView(reify PropertyDict)

interface HeapObject {
    td: Handle
    properties?: Handle // -> PropertyDict
}

export const HeapObject = intrinsics.DefineStructView(reify HeapObject)

interface HeapProxy {
    td: Handle
    properties: Handle
    getter: Handle
    setter: Handle
}

export const HeapProxy = intrinsics.DefineStructView(reify HeapProxy)
const proxyTD = allocTypeDescriptor(BaseTypeKind.proxy, 0, 0, 0)
const indexedProxyTD = allocTypeDescriptor(BaseTypeKind.proxy, 1, 0, 0)
const proxyTDs = new Map<Handle, Handle>()

function proxyTDFor(proto: Handle): Handle {
    if (!proto) return proxyTD
    const cached = proxyTDs.get(proto)
    if (cached !== undefined) return cached
    const td = allocTypeDescriptor(BaseTypeKind.proxy, 0, 0, 0, proto)
    proxyTDs.set(proto, td)
    return td
}

interface FrameProxy {
    td: Handle
    properties: Handle
    getter: Handle
    setter: Handle
    frame: u32
}

const FrameProxy = intrinsics.DefineStructView(reify FrameProxy)
const frameProxies = new Map<u32, Handle>()
const frameProxyHandles = new Set<Handle>()

export function isFrameProxy(handle: Handle): boolean {
    return frameProxyHandles.has(handle)
}

export function frameProxyOf(frame: u32, getter: Handle, setter: Handle): Handle {
    const known = frameProxies.get(frame)
    if (known !== undefined) return known
    const handle = allocateHeapCell(FrameProxy.sizeof)
    const proxy = FrameProxy(resolveHeapCell(handle))
    proxy.td = indexedProxyTD
    proxy.properties = 0
    proxy.getter = getter
    proxy.setter = setter
    proxy.frame = frame
    finishHeapCell(handle)
    frameProxies.set(frame, handle)
    frameProxyHandles.add(handle)
    return handle
}

export const closureCallKey = fromJsSymbol(Symbol('Call'))
export const protoSlotKey = fromJsSymbol(Symbol('Prototype'))
export const shapeTagKey = fromJsSymbol(Symbol('ShapeTag'))
const closureScopeKeys: Handle[] = []

export function closureScopeKey(index: u32): Handle {
    return closureScopeKeys[index] ??= fromJsSymbol(Symbol(`scope${index}`))
}

export function liveFrameProxy(frame: u32): Handle | undefined {
    return frameProxies.get(frame)
}

export function frameProxyFrame(proxy: Handle): u32 {
    const frame = FrameProxy(resolveHeapCell(proxy)).frame
    if (!frame) throw 'vm: closure outlived its frame'
    return frame
}

export function releaseFrameProxy(frame: u32): void {
    const proxy = frameProxies.get(frame)
    if (proxy === undefined) return
    frameProxies.delete(frame)
    FrameProxy(resolveHeapCell(proxy)).frame = 0
}

export function makeProxy(getter: Handle, setter: Handle, proto: Handle = 0 as Handle): Handle {
    const handle = allocateHeapCell(HeapProxy.sizeof)
    const proxy = HeapProxy(resolveHeapCell(handle))
    proxy.td = proxyTDFor(proto)
    proxy.properties = 0
    proxy.getter = getter
    proxy.setter = setter
    finishHeapCell(handle)
    return handle
}


const objectTDs = new Map<Handle, Handle>()

function objectTDFor(proto: Handle): Handle {
    const cached = objectTDs.get(proto)
    if (cached !== undefined) return cached
    const td = allocTypeDescriptor(BaseTypeKind.object, 0, 0, 0, proto)
    objectTDs.set(proto, td)
    return td
}

const plainObjectTD = objectTDFor(0 as Handle)

function initObject(handle: Handle, td: Handle): Handle {
    const obj = HeapObject(resolveHeapCell(handle))
    obj.td = td
    obj.properties = 0
    finishHeapCell(handle)
    return handle
}

export function makeObject(proto: Handle): Handle {
    return initObject(allocateHeapCell(HeapObject.sizeof), objectTDFor(proto))
}

export function makePlainObject(): Handle {
    return initObject(allocateHeapCell(HeapObject.sizeof), plainObjectTD)
}

bind(RtOp.create, { host: (proto: Handle): Handle => makeObject(deref(proto)) })

export function makeFunctionObject(): Handle {
    const handle = allocateHeapCell(HeapObject.sizeof)
    const obj = HeapObject(resolveHeapCell(handle))
    obj.td = functionObjectTD
    obj.properties = 0
    finishHeapCell(handle)
    return handle
}

interface HeapFunction {
    td: Handle
    properties?: Handle
    bytecode: Handle
}

const HeapFunction = intrinsics.DefineStructView(reify HeapFunction)

export type HostCallback = (thisArg: Handle, args: usize, argc: u32) => u32

interface HostFunction {
    td: Handle
    properties?: Handle
    index: u32
}

const HostFunction = intrinsics.DefineStructView(reify HostFunction)

enum FunctionVariant {
    object = 0,
    bytecode = 1,
    host = 2,
}

const objectFunctionTDs = new Map<Handle, Handle>()
const bytecodeFunctionTDs = new Map<Handle, Handle>()
const hostFunctionTDs = new Map<Handle, Handle>()

function functionTDsOf(variant: FunctionVariant): Map<Handle, Handle> {
    if (variant === FunctionVariant.bytecode) return bytecodeFunctionTDs
    if (variant === FunctionVariant.host) return hostFunctionTDs
    return objectFunctionTDs
}

function functionTDFor(variant: FunctionVariant, proto: Handle): Handle {
    const byProto = functionTDsOf(variant)
    const cached = byProto.get(proto)
    if (cached !== undefined) return cached
    const td = allocTypeDescriptor(BaseTypeKind.fn, variant, 0, TDFlags.callable, proto)
    byProto.set(proto, td)
    return td
}

function functionView(td: Handle): intrinsics.StructViewFactory<any> | undefined {
    const header = TypeDescriptor(resolveHeapCell(td))
    if (header.kind !== BaseTypeKind.fn) return
    if (header.variant === FunctionVariant.bytecode) return HeapFunction
    if (header.variant === FunctionVariant.host) return HostFunction
}

function isFunctionVariant(fn: Handle, variant: FunctionVariant): boolean {
    const td = TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(fn)).td))
    return td.kind === BaseTypeKind.fn && td.variant === variant
}

const functionObjectTD = functionTDFor(FunctionVariant.object, 0 as Handle)
const hostFunctionTD = functionTDFor(FunctionVariant.host, 0 as Handle)
const hostCallbacks: HostCallback[] = []

export function makeHostFunction(callback: HostCallback): Handle {
    const handle = allocateHeapCell(HostFunction.sizeof)
    const fn = HostFunction(resolveHeapCell(handle))
    fn.td = hostFunctionTD
    fn.properties = 0
    fn.index = hostCallbacks.length as u32
    hostCallbacks.push(callback)
    finishHeapCell(handle)
    return handle
}

export function hostCallbackOf(fn: Handle): HostCallback | undefined {
    if (!fn) return
    if (!isFunctionVariant(fn, FunctionVariant.host)) return
    return hostCallbacks[HostFunction(resolveHeapCell(fn)).index]
}

export function makeFunction(bytecode: Handle): Handle {
    const handle = allocateHeapCell(HeapFunction.sizeof)
    const fn = HeapFunction(resolveHeapCell(handle))
    const td = FunctionBytecode(resolveHeapCell(bytecode)).functionTD
    fn.td = td ? td : functionTDFor(FunctionVariant.bytecode, 0 as Handle)
    fn.properties = 0
    fn.bytecode = bytecode
    finishHeapCell(handle)
    return handle
}

export function functionBytecode(fn: Handle): Handle {
    if (!fn) return fn
    return isFunctionVariant(fn, FunctionVariant.bytecode) ? HeapFunction(resolveHeapCell(fn)).bytecode : fn
}

export function isCallable(value: Handle): boolean {
    if (!value) return false
    const td = TypeDescriptor(resolveHeapCell(typeDescriptorOf(value)))
    return (td.flags & TDFlags.callable) !== 0
}

const arrayPrototype = makeObject(0 as Handle)
const arrayTDs = new Map<Handle, Handle>()
const arrayDescriptors = new Set<Handle>()

function arrayTDFor(proto: Handle): Handle {
    const cached = arrayTDs.get(proto)
    if (cached !== undefined) return cached
    const td = allocTypeDescriptor(BaseTypeKind.object, 0, 0, 0, proto)
    arrayTDs.set(proto, td)
    arrayDescriptors.add(td)
    return td
}
export const arrayLengthKey = fromJsString('length')
const indexKeys: Handle[] = []
const keyIndices = new Map<Handle, u32>()

export function indexKey(index: u32): Handle {
    const known = indexKeys[index]
    if (known !== undefined) return known
    const key = fromJsString(`${index}`)
    indexKeys[index] = key
    keyIndices.set(key, index)
    return key
}

export function unproxyKey(key: Handle): Handle {
    const index = key as u32
    return index < indexKeys.length && indexKeys[index] !== undefined ? indexKeys[index] : key
}

export function keyIndex(key: Handle): u32 | undefined {
    return keyIndices.get(key)
}

export function describeKey(key: Handle): string | undefined {
    const index = keyIndex(key)
    if (index !== undefined) return `[${index}]`
    if (isString(key)) return `.${stringToJs(key)}`
    if (!isSymbol(key)) return
    const description = HeapSymbol(resolveHeapCell(key)).description
    const text = description ? stringToJs(description) : ''
    return text.startsWith('Symbol.') ? `[${text}]` : `[Symbol(${text})]`
}

export function makeArray(proto: Handle = arrayPrototype): Handle {
    const handle = allocateHeapCell(HeapObject.sizeof)
    const obj = HeapObject(resolveHeapCell(handle))
    obj.td = arrayTDFor(proto)
    obj.properties = 0
    finishHeapCell(handle)
    setProperty(handle, arrayLengthKey, boxF64(0))
    return handle
}

export function isArray(value: Handle): boolean {
    if (isIndirect(value)) value = indirectTarget(value)
    return arrayDescriptors.has(typeDescriptorOf(value))
}

export function arrayLength(value: Handle): u32 {
    if (isIndirect(value)) value = indirectTarget(value)
    return unboxF64(FullPropertyDescriptor(resolveHeapCell(getOwnProperty(value, arrayLengthKey))).slot0) as u32
}

export function typeDescriptorOf(obj: Handle): Handle {
    return HeapObject(resolveHeapCell(obj)).td
}

export function isOrdinaryObject(obj: Handle): boolean {
    const td = TypeDescriptor(resolveHeapCell(typeDescriptorOf(obj)))
    return td.kind === BaseTypeKind.object && td.variant === 0
}

export function isString(value: Handle): boolean {
    if (!value) return false
    return isStringTD(typeDescriptorOf(value))
}

export const typeNames = {
    undefined: fromJsString('undefined'),
    boolean: fromJsString('boolean'),
    number: fromJsString('number'),
    string: fromJsString('string'),
    function: fromJsString('function'),
    object: fromJsString('object'),
    symbol: fromJsString('symbol'),
}

export function typeNameOf(cell: Handle): Handle {
    if (cell === undefinedHandle) return typeNames.undefined
    if (cell === nullHandle) return typeNames.object
    if (cell === falseHandle || cell === trueHandle) return typeNames.boolean
    const target = deref(cell)
    if (isString(target)) return typeNames.string
    return isCallable(target) ? typeNames.function : typeNames.object
}

export function setTypeDescriptorOf(obj: Handle, td: Handle): void {
    HeapObject(resolveHeapCell(obj)).td = td
}

function prototypeTDFor(td: Handle, proto: Handle): Handle {
    const header = TypeDescriptor(resolveHeapCell(td))
    if (header.kind === BaseTypeKind.fn) return functionTDFor(header.variant, proto)
    return objectTDFor(proto)
}

export function setPrototypeOf(obj: Handle, proto: Handle): void {
    const cell = HeapObject(resolveHeapCell(obj))
    cell.td = prototypeTDFor(cell.td, proto)
}

bind(RtOp.setPrototypeOf, {
    host: (obj: Handle, proto: Handle): Handle => {
        setPrototypeOf(isIndirect(obj) ? prepareWrite(obj) : obj, proto === nullHandle ? 0 as Handle : deref(proto))
        return obj
    },
})

export function prototypeOf(obj: Handle): Handle {
    return TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(obj)).td)).slot1 as Handle
}

export function getPrototypeOf(obj: Handle): Handle {
    return prototypeOf(obj)
}

export function hasPrototype(obj: Handle, proto: Handle): boolean {
    if (!obj || isBoxedF64(obj) || isString(obj)) return false
    const target = deref(proto)
    let at = getPrototypeOf(deref(obj))
    while (at) {
        if (at === target) return true
        at = getPrototypeOf(at)
    }
    return false
}

bind(RtOp.getPrototypeOf, {
    host: (obj: Handle): Handle => {
        const proto = getPrototypeOf(deref(obj))
        return proto ? proto : nullHandle
    },
})

bind(RtOp.hasPrototype, { host: (obj: Handle, proto: Handle): Handle => boxF64(hasPrototype(obj, proto) ? 1 : 0) })

export function hasPropertyKey(obj: Handle, key: Handle): boolean {
    let at = obj
    while (at !== 0) {
        if (getOwnProperty(at, key) !== 0) return true
        if (isProxy(at) && trapsKey(at, key)) throw `'in' tests ${describeKey(key) ?? 'a key'}, which an index trap holds`
        at = prototypeOf(at)
    }
    return false
}

function makePropertyDict(capacity: u32): Handle {
    const handle = allocateHeapCell(PropertyDict.sizeof)
    const dict = PropertyDict(resolveHeapCell(handle))
    dict.count = 0
    dict.capacity = capacity
    const entries = allocateHeapCell(capacity * PropertyEntry.sizeof)
    dict.entries = entries
    finishHeapCell(entries)
    finishHeapCell(handle)
    return handle
}

function objectDict(obj: Handle): Handle {
    const o = HeapObject(resolveHeapCell(obj))
    if (o.properties) return o.properties
    const dict = makePropertyDict(4)
    o.properties = dict
    return dict
}

function findEntry(dictAddr: Handle, key: Handle): usize {
    const dict = PropertyDict(resolveHeapCell(dictAddr))
    const entries = resolveHeapCell(dict.entries)
    const count = dict.count
    const hash = propertyKeyHash(key)
    for (let i: u32 = 0; i < count; i++) {
        const e = PropertyEntry(entries + i * PropertyEntry.sizeof)
        if (e.hash !== hash) continue
        if (e.key === key) return entries + i * PropertyEntry.sizeof
        if (hash >= symbolHashBit) continue
        if (stringBytesEqual(e.key, key)) return entries + i * PropertyEntry.sizeof
    }
    return 0
}

function growDict(dictAddr: Handle): void {
    const dict = PropertyDict(resolveHeapCell(dictAddr))
    const newCap = dict.capacity * 2
    const newEntries = allocateHeapCell(newCap * PropertyEntry.sizeof)
    intrinsics.memcpy(resolveHeapCell(newEntries), resolveHeapCell(dict.entries), dict.count * PropertyEntry.sizeof)
    dict.capacity = newCap
    dict.entries = newEntries
    finishHeapCell(newEntries)
}

function appendEntry(dictAddr: Handle, key: Handle, descHandle: Handle): void {
    const dict = PropertyDict(resolveHeapCell(dictAddr))
    if (dict.count >= dict.capacity) growDict(dictAddr)
    const count = dict.count
    const e = PropertyEntry(resolveHeapCell(dict.entries) + count * PropertyEntry.sizeof)
    e.key = key
    e.hash = propertyKeyHash(key)
    e.descriptor = descHandle
    dict.count = count + 1
}

function appendDataProperty(dictAddr: Handle, key: Handle, value: Handle): Handle {
    const descHandle = allocateHeapCell(FullPropertyDescriptor.sizeof)
    const desc = FullPropertyDescriptor(resolveHeapCell(descHandle))
    desc.slot0 = value
    desc.slot1 = 0
    desc.flags = dataPropertyFlags
    appendEntry(dictAddr, key, descHandle)
    finishHeapCell(descHandle)
    return descHandle
}

function putProperty(obj: Handle, key: Handle, value: Handle): Handle {
    const dictAddr = objectDict(obj)
    const found = findEntry(dictAddr, key)
    if (!found) return appendDataProperty(dictAddr, key, value)
    const descHandle = PropertyEntry(found).descriptor
    const desc = FullPropertyDescriptor(resolveHeapCell(descHandle))
    desc.slot0 = value
    desc.flags = dataPropertyFlags
    return descHandle
}

export function setProperty(obj: Handle, key: Handle, value: Handle): void {
    putProperty(obj, key, value)
}

export function setAccessorProperty(obj: Handle, key: Handle, getter: Handle, setter: Handle, enumerable: boolean): void {
    const desc = FullPropertyDescriptor(resolveHeapCell(putProperty(obj, key, getter)))
    desc.slot1 = setter
    let flags: u8 = PropFlags.configurable
    if (enumerable) flags |= PropFlags.enumerable
    if (getter) flags |= PropFlags.has_getter
    if (setter) flags |= PropFlags.has_setter
    desc.flags = flags
}

export function setReadonlyProperty(obj: Handle, key: Handle, value: Handle): void {
    const desc = FullPropertyDescriptor(resolveHeapCell(putProperty(obj, key, value)))
    desc.flags = desc.flags & ~PropFlags.writable
}

export function getOwnProperty(obj: Handle, key: Handle): Handle {
    const o = HeapObject(resolveHeapCell(obj))
    if (!o.properties) return 0
    const e = findEntry(o.properties, key)
    if (e === 0) return 0
    return PropertyEntry(e).descriptor
}

export function ownPropertyKeyAt(obj: Handle, index: u32): Handle {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    if (!properties) return 0
    const dict = PropertyDict(resolveHeapCell(properties))
    if (index >= dict.count) return 0
    return PropertyEntry(resolveHeapCell(dict.entries) + index * PropertyEntry.sizeof).key
}

export function ownPropertyAt(obj: Handle, index: u32): Handle {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    intrinsics.assert(properties, 'Object was missing properties')
    const dict = PropertyDict(resolveHeapCell(properties))
    intrinsics.assert(index >= 0 && index < dict.count, `Invalid property index "${index}", dictionary has "${dict.count}" keys`)
    return PropertyEntry(resolveHeapCell(dict.entries) + index * PropertyEntry.sizeof).descriptor
}

export function shallowClone(obj: Handle): Handle {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    const size = cellViewOf(HeapObject(resolveHeapCell(obj)).td)?.sizeof ?? HeapObject.sizeof
    const handle = allocateHeapCell(size)
    intrinsics.memcpy(resolveHeapCell(handle), resolveHeapCell(obj), size)
    HeapObject(resolveHeapCell(handle)).properties = 0
    finishHeapCell(handle)
    if (!properties) return handle
    const count = PropertyDict(resolveHeapCell(properties)).count
    const dictHandle = makePropertyDict(PropertyDict(resolveHeapCell(properties)).capacity)
    PropertyDict(resolveHeapCell(dictHandle)).count = count
    for (let i: u32 = 0; i < count; i++) {
        const source = PropertyEntry(
            resolveHeapCell(PropertyDict(resolveHeapCell(properties)).entries)
            + i * PropertyEntry.sizeof)
        const key = source.key
        const descHandle = allocateHeapCell(FullPropertyDescriptor.sizeof)
        const from = FullPropertyDescriptor(resolveHeapCell(
            PropertyEntry(resolveHeapCell(PropertyDict(resolveHeapCell(properties)).entries)
                + i * PropertyEntry.sizeof).descriptor))
        const to = FullPropertyDescriptor(resolveHeapCell(descHandle))
        to.flags = from.flags
        to.slot0 = from.slot0
        to.slot1 = from.slot1
        finishHeapCell(descHandle)
        const target = PropertyEntry(
            resolveHeapCell(PropertyDict(resolveHeapCell(dictHandle)).entries)
            + i * PropertyEntry.sizeof)
        target.key = key
        target.hash = source.hash
        target.descriptor = descHandle
    }
    HeapObject(resolveHeapCell(handle)).properties = dictHandle
    return handle
}

export function ownPropertyCount(obj: Handle): u32 {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    return properties ? PropertyDict(resolveHeapCell(properties)).count : 0
}

export function copyEnumerableOwnProperties(target: Handle, source: Handle): void {
    const writable = isIndirect(target) ? prepareWrite(target) : target
    const readable = isIndirect(source) ? indirectTarget(source) : source
    for (let i: u32 = 0; i < ownPropertyCount(readable); i++) {
        const key = ownPropertyKeyAt(readable, i)
        if (!key) continue
        const d = FullPropertyDescriptor(resolveHeapCell(ownPropertyAt(readable, i)))
        if (!(d.flags & PropFlags.enumerable)) continue
        setProperty(writable, key, d.slot0 as Handle)
    }
}

// XXX: assign only lowers once property-eval knows the source's shape; an unknown source would need a runtime key walk.
bind(RtOp.assign, {
    host: (target: Handle, source: Handle): Handle => {
        copyEnumerableOwnProperties(target, source)
        return target
    },
})

export function getPropertyDescriptor(obj: Handle, key: Handle): Handle {
    let cur = obj
    while (cur !== 0) {
        const desc = getOwnProperty(cur, key)
        if (desc !== 0) return desc
        cur = prototypeOf(cur)
    }
    return 0
}

export function isProxy(obj: Handle): boolean {
    return TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(obj)).td)).kind === BaseTypeKind.proxy
}
intrinsics.tagInline(isProxy)

export function trapsKey(proxy: Handle, key: Handle): boolean {
    return TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(proxy)).td)).variant === 0 || keyIndices.has(key) || intrinsics.getNanId(key) !== 0
}

export function enumerableKeys(obj: Handle): Handle[] {
    const keys: Handle[] = []
    for (let i: u32 = 0; i < ownPropertyCount(obj); i++) {
        const key = ownPropertyKeyAt(obj, i)
        if (!key || !isString(key)) continue
        if (FullPropertyDescriptor(resolveHeapCell(ownPropertyAt(obj, i))).flags & PropFlags.enumerable) keys.push(key)
    }
    return keys
}

export function hasIndexKeys(obj: Handle): boolean {
    let cur = obj
    while (cur !== 0) {
        for (let i: u32 = 0; i < ownPropertyCount(cur); i++) {
            if (keyIndices.has(ownPropertyKeyAt(cur, i))) return true
        }
        cur = prototypeOf(cur)
    }
    return false
}

export function getPropertyProxy(obj: Handle, key: Handle): Handle {
    let cur = obj
    while (cur !== 0) {
        if (isProxy(cur) && trapsKey(cur, key)) return cur
        cur = prototypeOf(cur)
    }
    return 0
}
intrinsics.tagInline(getPropertyProxy)

export function getComputedKeyProxy(obj: Handle): Handle {
    let cur = obj
    while (cur !== 0) {
        if (isProxy(cur)) return cur
        cur = prototypeOf(cur)
    }
    return 0
}

export function getProxyGetter(proxy: Handle): Handle {
    return HeapProxy(resolveHeapCell(proxy)).getter
}
intrinsics.tagInline(getProxyGetter)

export function getProxySetter(proxy: Handle): Handle {
    return HeapProxy(resolveHeapCell(proxy)).setter
}

function hasProperty(obj: Handle, key: Handle): boolean {
    let cur = obj
    while (cur !== 0) {
        if (getOwnProperty(cur, key) !== 0) return true
        cur = prototypeOf(cur)
    }
    return false
}

export function getProperty(obj: Handle, key: Handle): Handle {
    const desc = getPropertyDescriptor(obj, key)
    return desc === 0 ? 0 : FullPropertyDescriptor(resolveHeapCell(desc)).slot0 as Handle
}

export function isCell(handle: Handle): boolean {
    if (!handle || (handle & ~boxedCellBit) >= runtimeCells) return false
    return typeDescriptors.has(Intrinsics.load(resolveHeapCell(handle), 0, Types.u32) as Handle)
}

export function cellLayout(td: Handle): intrinsics.StructViewFactory<any> | undefined {
    const view = cellViewOf(td)
    if (view) return view
    const header = TypeDescriptor(resolveHeapCell(td))
    if (header.kind === BaseTypeKind.number) return HeapF64
    if (header.kind === BaseTypeKind.symbol) return HeapSymbol
    if (header.kind === BaseTypeKind.fn) return HeapObject
    if (header.kind === BaseTypeKind.proxy) return HeapProxy
    if (header.kind === BaseTypeKind.array) return HeapObject
    if (header.kind !== BaseTypeKind.object) return
    return header.variant === indirectVariant ? HeapIndirect : HeapObject
}

export function prototypeOfTD(td: Handle): Handle {
    const header = TypeDescriptor(resolveHeapCell(td))
    return header.kind === BaseTypeKind.object || header.kind === BaseTypeKind.string ? header.slot1 : 0 as Handle
}

export function propertyStorage(dictHandle: Handle): { raw: Handle[], cells: Handle[] } {
    const dict = PropertyDict(resolveHeapCell(dictHandle))
    intrinsics.assert(dict.count <= dict.capacity && dict.entries !== 0, `heap: ${dictHandle} is not a property dictionary`)
    const raw: Handle[] = [dictHandle, dict.entries]
    const cells: Handle[] = []
    for (let i: u32 = 0; i < dict.count; i++) {
        const entry = PropertyEntry(resolveHeapCell(dict.entries) + i * PropertyEntry.sizeof)
        cells.push(entry.key)
        raw.push(entry.descriptor)
        const desc = FullPropertyDescriptor(resolveHeapCell(entry.descriptor))
        cells.push(desc.slot0 as Handle, desc.slot1 as Handle)
    }
    return { raw, cells }
}

export const undefinedWord = handleWord(undefinedHandle)
export const falseWord = handleWord(falseHandle)
export const trueWord = handleWord(trueHandle)

function smiRange(value: i64): boolean {
    return value >= -0x40000000 && value < 0x40000000
}

function boxWord(value: f64): u32 {
    const handle = allocateHeapCell(HeapF64.sizeof)
    const boxed = HeapF64(resolveHeapCell(handle))
    boxed.td = heapF64TD
    boxed.value = value
    finishHeapCell(handle)
    return handleWord(handle)
}

function handleWord(handle: Handle): u32 {
    return Intrinsics.or(Intrinsics.shl(handle, 1, Types.u32), 1, Types.u32)
}

function intWord(value: i64): u32 {
    if (smiRange(value)) return Intrinsics.convert(Intrinsics.shl(value, 1, Types.i64), Types.i64, Types.u32)
    return boxWord(Intrinsics.convert(value, Types.i64, Types.f64))
}

function floatWord(value: f64): u32 {
    const whole = Intrinsics.convert(value, Types.f64, Types.i64)
    if (Intrinsics.convert(whole, Types.i64, Types.f64) === value && smiRange(whole)) return intWord(whole)
    return boxWord(value)
}

function wordAt(obj: Handle, key: Handle): u32 {
    const desc = getPropertyDescriptor(obj, key)
    return desc === 0 ? undefinedWord : FullPropertyDescriptor(resolveHeapCell(desc)).slot0
}

function boxedWord(word: u32): f64 {
    return unboxF64(Intrinsics.ushr(word, 1, Types.u32) as Handle)
}

export function setIntProperty(obj: Handle, key: Handle, value: i64): void {
    setProperty(obj, key, intWord(value) as Handle)
}

export function setFloatProperty(obj: Handle, key: Handle, value: f64): void {
    setProperty(obj, key, floatWord(value) as Handle)
}

export function setHandleProperty(obj: Handle, key: Handle, value: Handle): void {
    setProperty(obj, key, (value ? handleWord(value) : undefinedWord) as Handle)
}

export function deleteHandleProperty(obj: Handle, key: Handle): void {
    deleteOwnProperty(obj, key)
}

export function getIntProperty(obj: Handle, key: Handle): number | undefined {
    const word = wordAt(obj, key)
    if (word === undefinedWord) return undefined
    if (Intrinsics.and(word, 1, Types.u32) === 0) return Intrinsics.shr(Intrinsics.convert(word, Types.u32, Types.i32), 1, Types.i64)
    return Intrinsics.convert(boxedWord(word), Types.f64, Types.i64)
}

export function getFloatProperty(obj: Handle, key: Handle): number | undefined {
    const word = wordAt(obj, key)
    if (word === undefinedWord) return undefined
    if (Intrinsics.and(word, 1, Types.u32) === 0) return Intrinsics.convert(Intrinsics.shr(Intrinsics.convert(word, Types.u32, Types.i32), 1, Types.i64), Types.i64, Types.f64)
    return boxedWord(word)
}

export function getHandleProperty(obj: Handle, key: Handle): Handle {
    const word = wordAt(obj, key)
    if (word === undefinedWord) return 0 as Handle
    return Intrinsics.ushr(word, 1, Types.u32) as Handle
}

function dynamicHandle(word: u32): Handle {
    if (Intrinsics.and(word, 1, Types.u32) === 0) Intrinsics.trap(0)
    if (word >= pstackWordTag) Intrinsics.trap(0)
    const handle = Intrinsics.ushr(word, 1, Types.u32) as Handle
    return handle === 0 ? undefinedHandle : handle
}

function dynamicKey(key: u32): Handle {
    if (Intrinsics.and(key, 1, Types.u32) !== 0) return dynamicHandle(key)
    const index = Intrinsics.shr(Intrinsics.convert(key, Types.u32, Types.i32), 1, Types.i64)
    if (index < 0) Intrinsics.trap(0)
    return numberToString(Intrinsics.bitconvert(Intrinsics.convert(index, Types.i64, Types.f64), Types.f64, Types.u64))
}

function hostWord(slot: Handle): u32 {
    if (!slot) return undefinedWord
    if (!isBoxedF64(slot)) return handleWord(slot)
    const value = unboxF64(slot)
    const whole = Intrinsics.convert(value, Types.f64, Types.i64)
    if (Intrinsics.convert(whole, Types.i64, Types.f64) !== value) Intrinsics.trap(0)
    if (!smiRange(whole)) Intrinsics.trap(0)
    return Intrinsics.convert(Intrinsics.shl(whole, 1, Types.i64), Types.i64, Types.u32)
}

function slotWord(slot: Handle): u32 {
    if (!slot) return undefinedWord
    if (!isBoxedF64(slot)) return handleWord(slot)
    return floatWord(unboxF64(slot))
}

export function hostHandle(word: u32): Handle {
    if (Intrinsics.and(word, 1, Types.u32) !== 0) return dynamicHandle(word)
    const value = Intrinsics.shr(Intrinsics.convert(word, Types.u32, Types.i32), 1, Types.i64)
    const handle = allocateHeapCell(HeapF64.sizeof)
    const boxed = HeapF64(resolveHeapCell(handle))
    boxed.td = heapF64TD
    boxed.value = Intrinsics.convert(value, Types.i64, Types.f64)
    finishHeapCell(handle)
    return handle
}

export function dynamicGet(object: u32, key: u32): u32 {
    const receiver = dynamicHandle(object)
    if (isNullishHandle(receiver)) Intrinsics.trap(0)
    const name = dynamicKey(key)
    if (isString(receiver)) {
        if (!propertyKeysEqual(name, arrayLengthKey)) Intrinsics.trap(0)
        return Intrinsics.shl(stringLength(receiver), 1, Types.u32)
    }
    let at = deref(receiver)
    while (at !== 0) {
        const desc = getOwnProperty(at, name)
        if (desc !== 0) {
            const found = FullPropertyDescriptor(resolveHeapCell(desc))
            if (found.flags & (PropFlags.has_getter | PropFlags.has_setter)) Intrinsics.trap(0)
            if (at < runtimeCells) return hostWord(found.slot0 as Handle)
            return found.slot0
        }
        if (isProxy(at)) Intrinsics.trap(0)
        at = prototypeOf(at)
    }
    return undefinedWord
}

function defineAccessor(object: u32, key: u32, getter: u32, setter: u32): u32 {
    const getterHandle = getter === undefinedWord ? 0 as Handle : deref(dynamicHandle(getter))
    const setterHandle = setter === undefinedWord ? 0 as Handle : deref(dynamicHandle(setter))
    setAccessorProperty(deref(dynamicHandle(object)), dynamicKey(key), getterHandle, setterHandle, true)
    return object
}

bind(RtOp.getprop, { impl: dynamicGet })
bind(RtOp.defineAccessor, { impl: defineAccessor })

function isSmiWord(word: u32): boolean {
    return Intrinsics.and(word, 1, Types.u32) === 0
}

function smiValue(word: u32): i64 {
    return Intrinsics.shr(Intrinsics.convert(word, Types.u32, Types.i32), 1, Types.i64)
}

function isNumberWord(word: u32): boolean {
    if (isSmiWord(word)) return true
    const handle = Intrinsics.ushr(word, 1, Types.u32) as Handle
    return handle > trueHandle && word < pstackWordTag && isBoxedF64(handle)
}

function wordIndex(key: u32): i64 {
    if (isSmiWord(key)) return smiValue(key)
    const handle = Intrinsics.ushr(key, 1, Types.u32) as Handle
    if (handle <= trueHandle || key >= pstackWordTag || !isString(handle)) return -1
    const text = HeapString(resolveHeapCell(handle))
    const length = text.length
    if (length === 0 || length > 9) return -1
    if (length > 1 && Intrinsics.load(text.ptr, 0, Types.u8) === 48) return -1
    let value: i64 = 0
    let i: u32 = 0
    while (i < length) {
        const digit = Intrinsics.load(text.ptr, i, Types.u8)
        if (digit < 48 || digit > 57) return -1
        value = value * 10 + (digit - 48)
        i = i + 1
    }
    return value
}

function trapsWord(proxy: Handle, key: u32): boolean {
    if (wordIndex(key) >= 0) return true
    return TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(proxy)).td)).variant === 0
}

export function deleteOwnProperty(obj: Handle, key: Handle): boolean {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    if (!properties) return true
    const found = findEntry(properties, key)
    if (!found) return true
    const entry = PropertyEntry(found)
    const desc = FullPropertyDescriptor(resolveHeapCell(entry.descriptor))
    if (!(desc.flags & PropFlags.configurable)) return false
    // FIXME: add tombstone flag
    // FIXME (ES compat): if this key is used again, it needs to be moved to be last
    entry.hash = Intrinsics.xor(entry.hash, 0x7FFF_FFFF, Types.u32)
    desc.flags = 0
    desc.slot0 = obj < runtimeCells ? 0 : undefinedWord
    desc.slot1 = 0
    return true
}

function dynamicDelete(object: u32, key: u32): u32 {
    if (isNumberWord(object)) return trueWord
    const receiver = dynamicHandle(object)
    if (isNullishHandle(receiver)) Intrinsics.trap(0)
    const name = dynamicKey(key)
    if (isString(receiver)) {
        if (propertyKeysEqual(name, arrayLengthKey)) return falseWord
        const index = wordIndex(key)
        return index >= 0 && index < stringLength(receiver) ? falseWord : trueWord
    }
    const target = deref(receiver)
    if (getOwnProperty(target, name) === 0) {
        let at = target
        while (at !== 0) {
            if (isProxy(at) && trapsWord(at, key)) Intrinsics.trap(0)
            at = prototypeOf(at)
        }
        return trueWord
    }
    return deleteOwnProperty(target, name) ? trueWord : falseWord
}

bind(RtOp.deleteProperty, { impl: dynamicDelete })

export function dynamicHas(object: u32, key: u32): u32 {
    if (isNumberWord(object)) Intrinsics.trap(0)
    const receiver = dynamicHandle(object)
    if (isNullishHandle(receiver) || isString(receiver)) Intrinsics.trap(0)
    const name = dynamicKey(key)
    let at = deref(receiver)
    while (at !== 0) {
        if (getOwnProperty(at, name) !== 0) return 1
        if (isProxy(at) && trapsWord(at, key)) Intrinsics.trap(0)
        at = prototypeOf(at)
    }
    return 0
}

bind(RtOp.hasProperty, { impl: dynamicHas })

function prototypeHandle(proto: Handle): Handle {
    if (!proto || isOddballHandle(proto)) return 0 as Handle
    return deref(proto)
}

function createObject(proto: Handle): Handle {
    return makeObject(prototypeHandle(proto))
}

function setPrototypeImpl(obj: Handle, proto: Handle): Handle {
    setPrototypeOf(deref(obj), prototypeHandle(proto))
    return obj
}

function getPrototypeImpl(obj: Handle): Handle {
    const proto = getPrototypeOf(deref(obj))
    return proto ? proto : nullHandle
}

function hasPrototypeWord(value: u32, proto: Handle): u32 {
    if (isNumberWord(value)) return 0
    const handle = Intrinsics.ushr(value, 1, Types.u32) as Handle
    if (isOddballHandle(handle) || isString(handle)) return 0
    return hasPrototype(handle, proto) ? 1 : 0
}

function copiedSlot(into: Handle, from: Handle, slot: Handle): Handle {
    const word = from < runtimeCells ? slotWord(slot) : slot as u32
    return into < runtimeCells ? hostHandle(word) : word as Handle
}

function assignImpl(target: Handle, source: Handle): Handle {
    if (!source || isOddballHandle(source) || isBoxedF64(source)) return target
    const into = deref(target)
    const from = deref(source)
    const count = ownPropertyCount(from)
    let i: u32 = 0
    while (i < count) {
        const key = ownPropertyKeyAt(from, i)
        const desc = FullPropertyDescriptor(resolveHeapCell(ownPropertyAt(from, i)))
        if (desc.flags & PropFlags.enumerable) setProperty(into, key, copiedSlot(into, from, desc.slot0 as Handle))
        i = i + 1
    }
    return target
}

bind(RtOp.create, { impl: createObject })
bind(RtOp.setPrototypeOf, { impl: setPrototypeImpl })
bind(RtOp.getPrototypeOf, { impl: getPrototypeImpl })
bind(RtOp.assign, { impl: assignImpl })
bind(RtOp.hasPrototype, { impl: hasPrototypeWord })

export const prototypeKey = fromJsString('prototype')

export function getPrototypeProperty(obj: Handle): Handle {
    return getProperty(obj, prototypeKey)
}

// shallow-ish. nested plain objects are visited recursively
export function fromJsObject(o: object, compileFn?: (f: Function) => Handle, construct?: Construct): Handle {
    return fromJsObjectInner(o, { compileFn, construct, seen: new Map<object, Handle>() })
}

export function fromJsValue(v: any, compileFn?: (f: Function) => Handle, construct?: Construct): Handle {
    return fromJsValueInner(v, { compileFn, construct, seen: new Map<object, Handle>() })
}

export function createJsValueConverter(compileFn?: (f: Function) => Handle, construct?: Construct): (v: any) => Handle {
    const cx: JsConversion = { compileFn, construct, seen: new Map<object, Handle>() }
    return v => fromJsValueInner(v, cx)
}

export interface JsConversion {
    compileFn?: (f: Function) => Handle
    construct?: Construct
    seen: Map<object, Handle>
    converted?: (o: object) => void
}

export function convertJsValue(cx: JsConversion, v: any): Handle {
    return fromJsValueInner(v, cx)
}

function noteConverted(cx: JsConversion, o: object, handle: Handle): void {
    cx.seen.set(o, handle)
    if (cx.converted) cx.converted(o)
}

export type Construct = (rebuild: Function) => Handle

export const serializerKey = Symbol.for('synapse.serializer')

export function attachSerializer(target: object, serialize: (this: any) => Function): void {
    Object.defineProperty(target, serializerKey, { value: serialize, configurable: true })
}

// used for caching in test harnesses
const rawHeapHandle = Symbol('heap.handle')
export function createHeapHandle(handle: u32): any {
    return { [rawHeapHandle]: handle }
}

function fromJsObjectInner(o: object, cx: JsConversion): Handle {
    if (const prev = cx.seen.get(o)) return prev
    const serialize = (o as any)[serializerKey]
    if (serialize !== undefined) {
        if (!cx.construct) throw `heap: ${o.constructor?.name ?? 'value'} can only be converted where constructions run`
        const handle = cx.construct(serialize.call(o))
        noteConverted(cx, o, handle)
        return handle
    }
    if (o instanceof Map) throw 'heap: Map values cannot be materialized'
    if (Array.isArray(o)) {
        const handle = makeArray()
        noteConverted(cx, o, handle)
        const length = o.length as u32
        for (let i: u32 = 0; i < length; i++) {
            appendDataProperty(objectDict(handle), indexKey(i), fromJsValueInner(o[i], cx))
        }
        setProperty(handle, arrayLengthKey, boxF64(length as f64))
        return handle
    }
    const parent = Object.getPrototypeOf(o)
    if ('__proxy' in o && !(parent !== null && '__proxy' in parent)) {
        const obj = allocateHeapCell(HeapProxy.sizeof)
        const proxy = HeapProxy(resolveHeapCell(obj))
        proxy.td = indexedProxyTD
        proxy.properties = 0
        noteConverted(cx, o, obj)
        const value: any = o
        proxy.getter = fromJsValueInner(value.__proxyGet, cx)
        proxy.setter = fromJsValueInner(value.__proxySet, cx)
        finishHeapCell(obj)
        return obj
    }
    if (rawHeapHandle in o) {
        const h = o[rawHeapHandle] as u32
        noteConverted(cx, o, h)
        return h
    }
    const proto = parent === null || parent === Object.prototype ? 0 : fromJsObjectInner(parent, cx)
    const obj = allocateHeapCell(HeapObject.sizeof)
    const object = HeapObject(resolveHeapCell(obj))
    object.td = objectTDFor(proto)
    object.properties = 0
    noteConverted(cx, o, obj)
    const dictAddr = objectDict(obj)
    const descriptors: any = (Object as any).getOwnPropertyDescriptors(o)
    for (const k of Reflect.ownKeys(descriptors)) {
        const d = descriptors[k]
        const descHandle = allocateHeapCell(FullPropertyDescriptor.sizeof)
        const desc = FullPropertyDescriptor(resolveHeapCell(descHandle))
        let flags: u8 = 0
        if (d.enumerable) flags |= PropFlags.enumerable
        if (d.configurable) flags |= PropFlags.configurable
        if ('value' in d) {
            if (d.writable) flags |= PropFlags.writable
            desc.slot0 = fromJsValueInner(d.value, cx)
            desc.slot1 = 0
        } else {
            if (d.get) {
                flags |= PropFlags.has_getter
                desc.slot0 = fromJsValueInner(d.get, cx)
            }
            if (d.set) {
                flags |= PropFlags.has_setter
                desc.slot1 = fromJsValueInner(d.set, cx)
            }
        }
        desc.flags = flags
        appendEntry(dictAddr, typeof k === 'symbol' ? fromJsSymbol(k) : fromJsString(k), descHandle)
        finishHeapCell(descHandle)
    }
    finishHeapCell(obj)
    return obj
}

function fromJsValueInner(v: any, cx: JsConversion): Handle {
    if (typeof v === 'symbol') return fromJsSymbol(v)
    if (typeof v === 'number') return boxF64(v)
    if (typeof v === 'bigint') return boxF64(Number(v))
    if (typeof v === 'boolean') return boxF64(v ? 1 : 0)
    if (v === null) return nullHandle
    if (v === undefined) return undefinedHandle
    if (typeof v === 'function') {
        if (cx.compileFn) {
            if (const h = cx.compileFn(v)) return h
        }
        throw 'todo'
    }
    if (typeof v === 'object') return fromJsObjectInner(v, cx)
    if (typeof v === 'string') {
        // TODO: we should be interning strings within the heap
        // this is just a hack to speed up dev time
        if (const cached = cx.seen.get(v as any)) return cached
        const r = fromJsString(v)
        cx.seen.set(v as any, r)
        return r
    }
    throw `unhandled typeof: ${typeof v}`
}

// the interpreter has two modes which can influence some of these flags
// one of the modes does not use SMIs and has native width registers, but lacks Number.prototype.
// in "native" mode, interpretation is entirely implied by usage instead of tracked independently
export enum FunctionBytecodeFlags {
    has_rest_param = 1 << 0,
    has_effects = 1 << 1, // conservative, _excludes_ allocations, `throw` is not considered an effect
    has_no_stack_escapes = 1 << 2, // returns are not considered escapes
    has_no_stack_returns = 1 << 3, // only stack allocated handles are stack returns
    has_no_handle_returns = 1 << 4, // means this fn only returns simple scalars e.g. `return 1 + 1`
    has_captures = 1 << 5,

    uses_this = 1 << 9,
    uses_callback = 1 << 10, // one of the params is known to be called in a code path
    uses_throw = 1 << 11,

    // max size of the bytecode operands. you should check `uses_u64_bytecode` first.
    uses_u16_bytecode = 1 << 12,
    uses_u32_bytecode = 1 << 13,
    uses_u64_bytecode = uses_u16_bytecode | uses_u32_bytecode,

    assumes_native_mode = 1 << 15,
}

interface CoveredRange {
    // all are bytecode indices
    start: u32
    end: u32
    handler: u32 
}
export const CoveredRange = intrinsics.DefineStructView(reify CoveredRange)

interface FunctionBytecodeLabels {
    ehRanges: Handle
    ehRangesCount: u32
    jumpLabels: Handle
    jumpLabelsCount: u32
}

export const FunctionBytecodeLabels = intrinsics.DefineStructView(reify FunctionBytecodeLabels)

interface FunctionBytecode {
    source?: Handle // string
    flags: u16
    paramCount: u16 // we won't bother supporting more than this, rest params will use a flag. they will still appear apart of this count
    registerCount: u32
    bytecode: Handle
    bytecodeLen: u32 
    constants: Handle
    constantsLen: u32
    scopeBindings: Handle
    scopeBindingsCount: u32
    labels?: Handle
    functionTD?: Handle
}
export const FunctionBytecode = intrinsics.DefineStructView(reify FunctionBytecode)

const functionNameKey = fromJsString('name')
const functionLengthKey = fromJsString('length')

const templateTDs = new Map<string, Handle>()

export function makeTemplateTD(name: Handle, length: u32): Handle {
    const key = `${name}/${length}`
    const known = templateTDs.get(key)
    if (known !== undefined) return known
    const proto = makeObject(0 as Handle)
    FullPropertyDescriptor(resolveHeapCell(putProperty(proto, functionNameKey, name))).flags = PropFlags.configurable
    FullPropertyDescriptor(resolveHeapCell(putProperty(proto, functionLengthKey, boxF64(length)))).flags = PropFlags.configurable
    const td = allocTypeDescriptor(BaseTypeKind.fn, FunctionVariant.bytecode, 0, TDFlags.callable, proto)
    templateTDs.set(key, td)
    return td
}

export function isTemplateTyped(obj: Handle): boolean {
    if (!isFunctionVariant(obj, FunctionVariant.bytecode)) return false
    const td = HeapObject(resolveHeapCell(obj)).td
    return td === FunctionBytecode(resolveHeapCell(HeapFunction(resolveHeapCell(obj)).bytecode)).functionTD
}

interface ScopeBinding {
    slot: u32
    parentSlot: u32
    parentReg: u32
}
export const ScopeBinding = intrinsics.DefineStructView(reify ScopeBinding)

export function constantAt(bytecode: Handle, index: u32): u32 {
    const fn = FunctionBytecode(resolveHeapCell(bytecode))
    if (fn.flags & FunctionBytecodeFlags.assumes_native_mode) return Intrinsics.load(resolveHeapCell(fn.constants), index * 8, Types.u64) as u32
    return Intrinsics.load(resolveHeapCell(fn.constants), index * 4, Types.u32)
}

export function setConstant(bytecode: Handle, index: u32, tagged: u32): void {
    const fn = FunctionBytecode(resolveHeapCell(bytecode))
    if (fn.flags & FunctionBytecodeFlags.assumes_native_mode) Intrinsics.store(resolveHeapCell(fn.constants), index * 8, tagged, Types.u64)
    else Intrinsics.store(resolveHeapCell(fn.constants), index * 4, tagged, Types.u32)
}

export function makeClosure(template: Handle, parent: Handle, frameProxy: Handle, envAt: (reg: u32) => Handle): Handle {
    const code = functionBytecode(template)
    const src = FunctionBytecode(resolveHeapCell(code))
    const handle = allocateHeapCell(FunctionBytecode.sizeof)
    const fn = FunctionBytecode(resolveHeapCell(handle))
    fn.source = src.source
    fn.flags = src.flags
    fn.paramCount = src.paramCount
    fn.registerCount = src.registerCount
    fn.bytecode = src.bytecode
    fn.bytecodeLen = src.bytecodeLen
    fn.constantsLen = src.constantsLen
    fn.labels = src.labels
    fn.functionTD = src.functionTD
    fn.scopeBindings = src.scopeBindings
    fn.scopeBindingsCount = src.scopeBindingsCount
    const nativeConstants = !!(src.flags & FunctionBytecodeFlags.assumes_native_mode)
    const constantBytes = nativeConstants ? 8 : 4
    const constantType = nativeConstants ? Types.u64 : Types.u32
    const constants = allocateHeapCell(src.constantsLen === 0 ? 1 : src.constantsLen * constantBytes)
    intrinsics.memcpy(resolveHeapCell(constants), resolveHeapCell(src.constants), src.constantsLen * constantBytes)
    fn.constants = constants
    const parentFn = FunctionBytecode(resolveHeapCell(parent))
    const nativeParentConstants = !!(parentFn.flags & FunctionBytecodeFlags.assumes_native_mode)
    const parentConstantBytes = nativeParentConstants ? 8 : 4
    const parentConstantType = nativeParentConstants ? Types.u64 : Types.u32
    for (let i: u32 = 0; i < src.scopeBindingsCount; i++) {
        const binding = ScopeBinding(resolveHeapCell(src.scopeBindings) + i * ScopeBinding.sizeof)
        let scope: usize
        if (binding.parentReg !== 0xFFFFFFFF) {
            scope = (((envAt(binding.parentReg) << 1) | 1) >>> 0) as usize
        } else if (binding.parentSlot === 0xFFFFFFFF) {
            scope = ((frameProxy << 1) | 1) as usize
        } else {
            scope = Intrinsics.load(resolveHeapCell(parentFn.constants), binding.parentSlot * parentConstantBytes, parentConstantType)
        }
        Intrinsics.store(resolveHeapCell(constants), binding.slot * constantBytes, scope, constantType)
    }
    finishHeapCell(constants)
    finishHeapCell(handle)
    const closure = makeFunction(handle)
    setProperty(closure, closureCallKey, handle)
    for (let i: u32 = 0; i < src.scopeBindingsCount; i++) {
        const binding = ScopeBinding(resolveHeapCell(src.scopeBindings) + i * ScopeBinding.sizeof)
        setProperty(closure, closureScopeKey(i), (constantAt(handle, binding.slot) >>> 1) as Handle)
    }
    if (code !== template) closeMembers(template, closure, parent, frameProxy, envAt)
    return closure
}

export function closeMembers(template: Handle, target: Handle, parent: Handle, frameProxy: Handle, envAt: (reg: u32) => Handle): void {
    for (let i: u32 = 0; i < ownPropertyCount(template); i++) {
        const key = ownPropertyKeyAt(template, i)
        const d = FullPropertyDescriptor(resolveHeapCell(getOwnProperty(template, key)))
        if (d.flags & (PropFlags.has_getter | PropFlags.has_setter)) {
            const getter = d.slot0 as Handle
            const setter = d.slot1 as Handle
            setAccessorProperty(target, key, getter ? makeClosure(getter, parent, frameProxy, envAt) : 0 as Handle, setter ? makeClosure(setter, parent, frameProxy, envAt) : 0 as Handle, (d.flags & PropFlags.enumerable) !== 0)
            continue
        }
        const member = d.slot0 as Handle
        if (key === prototypeKey) {
            const prototype = makeObject(0 as Handle)
            closeMembers(member, prototype, parent, frameProxy, envAt)
            setReadonlyProperty(target, key, prototype)
            continue
        }
        setProperty(target, key, makeClosure(member, parent, frameProxy, envAt))
    }
}

export function suite() {
    const assert = intrinsics.assert

    // strings: utf-8 roundtrip (é is 2 bytes)
    const hello = fromJsString("héllo")
    assert(stringLength(hello) === 6)
    assert(stringToJs(hello) === "héllo")
    assert(stringBytesEqual(hello, fromJsString("héllo")))
    assert(!stringBytesEqual(hello, fromJsString("world")))

    const firstSymbol = Symbol('key'), secondSymbol = Symbol('key')
    const symbolObject = fromJsObject(Object.defineProperty({ [firstSymbol]: 7, key: 9 }, secondSymbol, { value: 11 }))
    assert(fromJsSymbol(firstSymbol) === fromJsValue(firstSymbol))
    assert(fromJsSymbol(firstSymbol) !== fromJsSymbol(secondSymbol))
    assert(unboxF64(getProperty(symbolObject, fromJsSymbol(firstSymbol))) === 7)
    assert(unboxF64(getProperty(symbolObject, fromJsSymbol(secondSymbol))) === 11)
    assert(unboxF64(getProperty(symbolObject, fromJsString('key'))) === 9)
    const inheritedSymbol = makeObject(symbolObject)
    assert(unboxF64(getProperty(inheritedSymbol, fromJsSymbol(firstSymbol))) === 7)

    // objects + prototype chain
    const proto = makeObject(0)
    setProperty(proto, fromJsString("kind"), fromJsString("base"))

    const obj = makeObject(proto)
    const nameKey = fromJsString("name")
    setProperty(obj, nameKey, fromJsString("widget"))

    assert(hasProperty(obj, nameKey))
    assert(stringToJs(getProperty(obj, nameKey)) === "widget")

    // "kind" is not own but is inherited
    assert(getOwnProperty(obj, fromJsString("kind")) === 0)
    assert(hasProperty(obj, fromJsString("kind")))
    assert(stringToJs(getProperty(obj, fromJsString("kind"))) === "base")

    // shared TD: same prototype -> same TD handle
    const obj2 = makeObject(proto)
    assert(HeapObject(resolveHeapCell(obj)).td === HeapObject(resolveHeapCell(obj2)).td)

    // overwrite in place
    setProperty(obj, nameKey, fromJsString("gadget"))
    assert(stringToJs(getProperty(obj, nameKey)) === "gadget")

    const shadow = makeObject(proto)
    const kindKey = fromJsString("kind")
    setProperty(shadow, kindKey, fromJsString("own"))
    setProperty(shadow, nameKey, fromJsString("n"))
    assert(deleteOwnProperty(shadow, kindKey))
    assert(getOwnProperty(shadow, kindKey) === 0)
    assert(stringToJs(getProperty(shadow, kindKey)) === "base")
    assert(enumerableKeys(shadow).length === 1)
    assert(deleteOwnProperty(shadow, kindKey))
    setProperty(shadow, kindKey, fromJsString("again"))
    const reordered = enumerableKeys(shadow)
    assert(reordered.length === 2 && reordered[0] === nameKey && reordered[1] === kindKey)
    assert(stringToJs(getProperty(shadow, kindKey)) === "again")
    assert(dynamicDelete(handleWord(shadow), handleWord(nameKey)) === trueWord)
    assert(getOwnProperty(shadow, nameKey) === 0)
    assert(dynamicDelete(handleWord(hello), handleWord(arrayLengthKey)) === falseWord)
    assert(dynamicDelete(handleWord(hello), handleWord(fromJsString("x"))) === trueWord)

    // force a dict grow (initial capacity 4)
    for (let i = 0; i < 10; i++) {
        setProperty(obj, fromJsString("k" + i), fromJsString("v" + i))
    }
    assert(stringToJs(getProperty(obj, fromJsString("k7"))) === "v7")

    {
        const inner = makeObject(0 as Handle)
        setProperty(inner, nameKey, fromJsString("first"))
        const cell = makeIndirect(inner)
        assert(isIndirect(cell) && !isIndirect(inner))
        assert(indirectTarget(cell) === inner)

        const next = shallowClone(inner)
        setProperty(next, nameKey, fromJsString("second"))
        setIndirectTarget(cell, next)
        assert(indirectTarget(cell) === next)
        assert(stringToJs(getProperty(indirectTarget(cell), nameKey)) === "second")
        assert(stringToJs(getProperty(inner, nameKey)) === "first")

        function branch(depth: number): Handle {
            const outer = indirectStash(cell)
            const base = indirectTarget(cell)
            setIndirectStash(cell, base)
            const w = prepareWrite(cell)
            assert(w !== base)
            setProperty(w, nameKey, fromJsString("depth" + depth))
            if (depth < 2) {
                const nested = branch(depth + 1)
                assert(stringToJs(getProperty(nested, nameKey)) === "depth" + (depth + 1))
                assert(indirectTarget(cell) === w)
                assert(prepareWrite(cell) === w)
                assert(stringToJs(getProperty(w, nameKey)) === "depth" + depth)
            }
            const taken = indirectTarget(cell)
            setIndirectTarget(cell, base)
            setIndirectStash(cell, outer)
            return taken
        }

        const before = indirectTarget(cell)
        const taken = branch(0)
        assert(taken !== before)
        assert(stringToJs(getProperty(taken, nameKey)) === "depth0")
        assert(indirectTarget(cell) === before)
        assert(indirectStash(cell) === 0)
        assert(stringToJs(getProperty(indirectTarget(cell), nameKey)) === "second")
    }

    assert(fromJsValue(undefined) === undefinedHandle && fromJsValue(null) === nullHandle && fromJsString('') === emptyStringHandle)
    assert(isCell(undefinedHandle) && isCell(nullHandle) && isCell(falseHandle) && isCell(trueHandle) && isString(emptyStringHandle))
    assert(typeNameOf(undefinedHandle) === typeNames.undefined && typeNameOf(nullHandle) === typeNames.object && typeNameOf(trueHandle) === typeNames.boolean)
    assert(stringToJs(emptyStringHandle) === '' && hostText(nullHandle) === 'null' && hostText(undefinedHandle) === 'undefined')
    assert(isFalsyHandle(undefinedHandle) && isFalsyHandle(nullHandle) && isFalsyHandle(emptyStringHandle) && isFalsyHandle(falseHandle) && !isFalsyHandle(trueHandle))
    assert(unboxF64(fromJsValue(true)) === 1 && unboxF64(fromJsValue(false)) === 0)

    console.log("heap self-test passed")
}

