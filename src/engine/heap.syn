/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

type usize = u32
export type Handle = intrinsics.Handle

export interface HeapAllocator {
    allocate(bytes: usize): Handle
    resolve(handle: Handle): usize
    finish(handle: Handle): void
}

function bootstrapAllocate(bytes: usize): Handle {
    return Intrinsics.alloc(bytes) as Handle
}

function bootstrapResolve(handle: Handle): usize {
    return handle as usize
}

function bootstrapFinish(_handle: Handle): void {}

const bootstrapAllocator: HeapAllocator = {
    allocate: bootstrapAllocate,
    resolve: bootstrapResolve,
    finish: bootstrapFinish,
}

let allocateCell = bootstrapAllocate
let resolveCell = bootstrapResolve
let finishCell = bootstrapFinish

export function setHeapAllocator(allocator: HeapAllocator): HeapAllocator {
    const previous = {
        allocate: allocateCell,
        resolve: resolveCell,
        finish: finishCell,
    }
    allocateCell = allocator.allocate
    resolveCell = allocator.resolve
    finishCell = allocator.finish
    return previous
}

export function resetHeapAllocator(): void {
    setHeapAllocator(bootstrapAllocator)
}

export function allocateHeapCell(bytes: usize): Handle {
    return allocateCell(bytes)
}

export function resolveHeapCell(handle: Handle): usize {
    return resolveCell(handle)
}

export function finishHeapCell(handle: Handle): void {
    finishCell(handle)
}

intrinsics.tagInline(bootstrapAllocate)
intrinsics.tagInline(bootstrapResolve)
intrinsics.tagInline(bootstrapFinish)
intrinsics.tagInline(allocateHeapCell)
intrinsics.tagInline(resolveHeapCell)
intrinsics.tagInline(finishHeapCell)

// an "Object" is the only TD with conventional field descriptors
// certain Object variants are wrappers around a different base. wrapping a function uniquely preserves its "typeof" value.
enum BaseTypeKind {
    oddball = 1, // true/false/undefined/null etc.
    string = 2,
    number = 3,
    symbol = 4,
    array = 5,
    object = 6,
    fn = 7,
    proxy = 8,

    string_table = 128,
    native_struct = 132,
}

enum TDFlags {
    callable = 1 << 0,
    // anything managing data offheap will need this set
    has_destructor = 1 << 1,
    // means an instance _might_ be ok to stack allocate
    stack_allocatable = 1 << 7,
}

// all strings are assumed utf-8 unless named otherwise
enum StringVariant {
    inline = 1, // slot1 contains packed code units, length is extraSlots + 1. The TD _is_ the string!
    internal = 2, // instance has the index into a string table, slot1 of the TD is the string table
    external = 3, // slot1 says if the instance is heap allocated or is a raw ptr (including static addr)
}

// shared data for describing the interpretation of a heap cell
interface TypeDescriptorHeader {
    kind: u8
    variant: u8
    extraSlots: u8 // # of extra slots, these live past the header
    flags: u8
    slot1: Handle
}

const TypeDescriptor = intrinsics.DefineStructView(reify TypeDescriptorHeader)

function allocTypeDescriptor(kind: u8, variant: u8, extraSlots: u8, flags: u8, slot1: Handle = 0 as Handle) {
    const size = TypeDescriptor.sizeof + (extraSlots as u32) * 4
    const handle = allocateHeapCell(size)
    const td = TypeDescriptor(resolveHeapCell(handle))
    td.kind = kind
    td.variant = variant
    td.extraSlots = extraSlots
    td.flags = flags
    td.slot1 = slot1
    finishHeapCell(handle)
    return handle
}

interface HeapF64 {
    td: Handle
    value: f64
}

const HeapF64 = intrinsics.DefineStructView(reify HeapF64)
const heapF64TD = allocTypeDescriptor(BaseTypeKind.number, Types.f64, 0, 0)

const f64NanCache = new Map<number, Handle>() // XXX: perf
export function clearNanCache() {
    f64NanCache.clear()
}
export function boxF64(value: f64): Handle {
    const id = intrinsics.getNanId(value)
    if (id) {
        if (const cached = f64NanCache.get(id)) return cached
    }
    const handle = allocateHeapCell(HeapF64.sizeof)
    const boxed = HeapF64(resolveHeapCell(handle))
    boxed.td = heapF64TD
    boxed.value = value
    finishHeapCell(handle)
    if (id) f64NanCache.set(id, handle)
    return handle
}

interface HeapIndirect {
    td: Handle
    target: Handle
    stash: Handle
}

const HeapIndirect = intrinsics.DefineStructView(reify HeapIndirect)
const heapIndirectTD = allocTypeDescriptor(BaseTypeKind.object, 254, 0, 0)

export function makeIndirect(target: Handle): Handle {
    const handle = allocateHeapCell(HeapIndirect.sizeof)
    const cell = HeapIndirect(resolveHeapCell(handle))
    cell.td = heapIndirectTD
    cell.target = target
    cell.stash = 0 as Handle
    finishHeapCell(handle)
    return handle
}

export function indirectStash(cell: Handle): Handle {
    return HeapIndirect(resolveHeapCell(cell)).stash
}

export function setIndirectStash(cell: Handle, stash: Handle): void {
    HeapIndirect(resolveHeapCell(cell)).stash = stash
}

export function prepareWrite(cell: Handle): Handle {
    const c = HeapIndirect(resolveHeapCell(cell))
    if (c.stash && c.target === c.stash) c.target = shallowClone(c.target)
    return c.target
}

const indirectVariant = 254

export function isIndirect(value: Handle): boolean {
    if (!value) return false
    const td = HeapObject(resolveHeapCell(value)).td
    if (!td) return false
    return TypeDescriptor(resolveHeapCell(td)).variant === indirectVariant
}

export function indirectTarget(cell: Handle): Handle {
    return HeapIndirect(resolveHeapCell(cell)).target
}

export function setIndirectTarget(cell: Handle, target: Handle): void {
    HeapIndirect(resolveHeapCell(cell)).target = target
}

function deref(obj: Handle): Handle {
    return isIndirect(obj) ? HeapIndirect(resolveHeapCell(obj)).target : obj
}

intrinsics.tagInline(isIndirect)
intrinsics.tagInline(indirectTarget)
intrinsics.tagInline(deref)
intrinsics.tagInline(prepareWrite)

export function isBoxedF64(value: Handle): boolean {
    return value !== 0 && HeapObject(resolveHeapCell(value)).td === heapF64TD
}

export function unboxF64(value: Handle): f64 {
    return HeapF64(resolveHeapCell(value)).value
}

// ---- strings --------------------------------------------------------------
// utf-8 centric
interface HeapString {
    td: Handle
    length: u32     // byte length
    ptr: Handle     // -> utf-8 bytes (external variant)
}

const HeapString = intrinsics.DefineStructView(reify HeapString)

const externalStringTD = allocTypeDescriptor(BaseTypeKind.string, StringVariant.external, 0, TDFlags.has_destructor)

function allocString(bytes: Uint8Array): Handle {
    const length = bytes.length as u32
    const handle = allocateHeapCell(HeapString.sizeof)
    const str = HeapString(resolveHeapCell(handle))
    const data = allocateHeapCell(length === 0 ? 1 : length)
    const dataPtr = resolveHeapCell(data)
    for (let i: u32 = 0; i < length; i++) {
        Intrinsics.store(dataPtr, i, bytes[i], Types.u8)
    }
    finishHeapCell(data)

    str.td = externalStringTD
    str.length = length
    str.ptr = data
    finishHeapCell(handle)
    return handle
}

// copies `s` (as utf-8) onto the heap, returns the string instance's address
const internedStrings = new Map<string, Handle>()

export function fromJsString(s: string): Handle {
    const known = internedStrings.get(s)
    if (known !== undefined) return known
    const handle = allocString(new TextEncoder().encode(s))
    internedStrings.set(s, handle)
    return handle
}

function stringLength(addr: Handle): u32 {
    return HeapString(resolveHeapCell(addr)).length
}

export function stringToJs(addr: Handle): string {
    const str = HeapString(resolveHeapCell(addr))
    const length = str.length
    const ptr = resolveHeapCell(str.ptr)
    const bytes = new Uint8Array(length)
    for (let i: u32 = 0; i < length; i++) {
        bytes[i] = Intrinsics.load(ptr, i, Types.u8)
    }
    return new TextDecoder().decode(bytes)
}

interface HeapSymbol { td: Handle, description: Handle }
const HeapSymbol = intrinsics.DefineStructView(reify HeapSymbol)
const symbolTD = allocTypeDescriptor(BaseTypeKind.symbol, 0, 0, 0)
const symbols = new Map<symbol, Handle>()

export function makeSymbol(description: Handle = 0 as Handle): Handle {
    const handle = allocateHeapCell(HeapSymbol.sizeof)
    const value = HeapSymbol(resolveHeapCell(handle))
    value.td = symbolTD
    value.description = description
    finishHeapCell(handle)
    return handle
}

export function fromJsSymbol(value: symbol): Handle {
    const known = symbols.get(value)
    if (known !== undefined) return known
    const handle = makeSymbol(value.description === undefined ? 0 as Handle : fromJsString(value.description))
    symbols.set(value, handle)
    return handle
}

export const symbolConstants = Object.fromEntries(Object.getOwnPropertyNames(Symbol)
    .filter(key => typeof Symbol[key] === 'symbol').map(key => [key, Symbol[key]]))

function propertyKeysEqual(a: Handle, b: Handle): boolean {
    if (a === b) return true
    if (typeDescriptorOf(a) === symbolTD || typeDescriptorOf(b) === symbolTD) return false
    return stringBytesEqual(a, b)
}

function stringBytesEqual(a: Handle, b: Handle): boolean {
    const sa = HeapString(resolveHeapCell(a))
    const sb = HeapString(resolveHeapCell(b))
    if (sa.length !== sb.length) return false
    const pa = resolveHeapCell(sa.ptr)
    const pb = resolveHeapCell(sb.ptr)
    for (let i: u32 = 0; i < sa.length; i++) {
        if (Intrinsics.load(pa, i, Types.u8) !== Intrinsics.load(pb, i, Types.u8)) return false
    }
    return true
}

// ---- objects --------------------------------------------------------------

export enum PropFlags {
    enumerable = 1 << 0,
    configurable = 1 << 1,
    writable = 1 << 2,
    has_getter = 1 << 3,
    has_setter = 1 << 4,
}

const dataPropertyFlags: u8 = PropFlags.enumerable | PropFlags.configurable | PropFlags.writable

interface FullPropertyDescriptor {
    flags: u8
    slot0: u32 // value, or getter
    slot1: u32 // setter (accessor only)
}

export const FullPropertyDescriptor = intrinsics.DefineStructView(reify FullPropertyDescriptor)

interface PropertyEntry {
    key: Handle
    descriptor: Handle // -> FullPropertyDescriptor
}

const PropertyEntry = intrinsics.DefineStructView(reify PropertyEntry)

interface PropertyDict {
    count: u32
    capacity: u32
    entries: Handle // -> PropertyEntry[capacity]
}

const PropertyDict = intrinsics.DefineStructView(reify PropertyDict)

interface HeapObject {
    td: Handle
    properties?: Handle // -> PropertyDict
}

const HeapObject = intrinsics.DefineStructView(reify HeapObject)

interface HeapProxy {
    td: Handle
    properties: Handle
    getter: Handle
    setter: Handle
}

const HeapProxy = intrinsics.DefineStructView(reify HeapProxy)
const proxyTD = allocTypeDescriptor(BaseTypeKind.proxy, 0, 0, 0)
const proxyTDs = new Map<Handle, Handle>()

function proxyTDFor(proto: Handle): Handle {
    if (!proto) return proxyTD
    const cached = proxyTDs.get(proto)
    if (cached !== undefined) return cached
    const td = allocTypeDescriptor(BaseTypeKind.proxy, 0, 0, 0, proto)
    proxyTDs.set(proto, td)
    return td
}

export function makeProxy(getter: Handle, setter: Handle, proto: Handle = 0 as Handle): Handle {
    const handle = allocateHeapCell(HeapProxy.sizeof)
    const proxy = HeapProxy(resolveHeapCell(handle))
    proxy.td = proxyTDFor(proto)
    proxy.properties = 0
    proxy.getter = getter
    proxy.setter = setter
    finishHeapCell(handle)
    return handle
}


const objectTDs = new Map<Handle, Handle>()

function objectTDFor(proto: Handle): Handle {
    const cached = objectTDs.get(proto)
    if (cached !== undefined) return cached
    const td = allocTypeDescriptor(BaseTypeKind.object, 0, 0, 0, proto)
    objectTDs.set(proto, td)
    return td
}

export function makeObject(proto: Handle): Handle {
    const handle = allocateHeapCell(HeapObject.sizeof)
    const obj = HeapObject(resolveHeapCell(handle))
    obj.td = objectTDFor(proto)
    obj.properties = 0
    finishHeapCell(handle)
    return handle
}

const functionObjectTD = allocTypeDescriptor(BaseTypeKind.fn, 0, 0, TDFlags.callable)

export function makeFunctionObject(): Handle {
    const handle = allocateHeapCell(HeapObject.sizeof)
    const obj = HeapObject(resolveHeapCell(handle))
    obj.td = functionObjectTD
    obj.properties = 0
    finishHeapCell(handle)
    return handle
}

interface HeapFunction {
    td: Handle
    properties?: Handle
    bytecode: Handle
}

const HeapFunction = intrinsics.DefineStructView(reify HeapFunction)
const bytecodeFunctionTD = allocTypeDescriptor(BaseTypeKind.fn, 1, 0, TDFlags.callable)

export function makeFunction(bytecode: Handle): Handle {
    const handle = allocateHeapCell(HeapFunction.sizeof)
    const fn = HeapFunction(resolveHeapCell(handle))
    fn.td = bytecodeFunctionTD
    fn.properties = 0
    fn.bytecode = bytecode
    finishHeapCell(handle)
    return handle
}

export function functionBytecode(fn: Handle): Handle {
    if (!fn) return fn
    const cell = HeapFunction(resolveHeapCell(fn))
    return cell.td === bytecodeFunctionTD ? cell.bytecode : fn
}

export function isCallable(value: Handle): boolean {
    if (!value) return false
    const td = TypeDescriptor(resolveHeapCell(typeDescriptorOf(value)))
    return (td.flags & TDFlags.callable) !== 0
}

const arrayPrototype = makeObject(0 as Handle)
const arrayTD = objectTDFor(arrayPrototype)
export const arrayLengthKey = fromJsString('length')
const indexKeys: Handle[] = []
const keyIndices = new Map<Handle, u32>()

export function indexKey(index: u32): Handle {
    const known = indexKeys[index]
    if (known !== undefined) return known
    const key = fromJsString(`${index}`)
    indexKeys[index] = key
    keyIndices.set(key, index)
    return key
}

export function unproxyKey(key: Handle): Handle {
    const index = key as u32
    return index < indexKeys.length && indexKeys[index] !== undefined ? indexKeys[index] : key
}

export function proxyKey(key: Handle): Handle {
    const index = keyIndices.get(key)
    return index === undefined ? key : index as Handle
}

export function makeArray(): Handle {
    const handle = makeObject(arrayPrototype)
    setProperty(handle, arrayLengthKey, boxF64(0))
    return handle
}

export function isArray(value: Handle): boolean {
    if (isIndirect(value)) value = indirectTarget(value)
    return typeDescriptorOf(value) === arrayTD
}

export function arrayLength(value: Handle): u32 {
    if (isIndirect(value)) value = indirectTarget(value)
    return unboxF64(FullPropertyDescriptor(resolveHeapCell(getOwnProperty(value, arrayLengthKey))).slot0) as u32
}

export function typeDescriptorOf(obj: Handle): Handle {
    return HeapObject(resolveHeapCell(obj)).td
}

export function isOrdinaryObject(obj: Handle): boolean {
    const td = TypeDescriptor(resolveHeapCell(typeDescriptorOf(obj)))
    return td.kind === BaseTypeKind.object && td.variant === 0
}

export function isString(value: Handle): boolean {
    if (!value) return false
    const td = typeDescriptorOf(value)
    if (!td) return false
    return TypeDescriptor(resolveHeapCell(td)).kind === BaseTypeKind.string
}

export function setTypeDescriptorOf(obj: Handle, td: Handle): void {
    HeapObject(resolveHeapCell(obj)).td = td
}

export function setPrototypeOf(obj: Handle, proto: Handle): void {
    HeapObject(resolveHeapCell(obj)).td = objectTDFor(proto)
}

function prototypeOf(obj: Handle): Handle {
    return TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(obj)).td)).slot1 as Handle
}

export function getPrototypeOf(obj: Handle): Handle {
    return prototypeOf(obj)
}

function makePropertyDict(capacity: u32): Handle {
    const handle = allocateHeapCell(PropertyDict.sizeof)
    const dict = PropertyDict(resolveHeapCell(handle))
    dict.count = 0
    dict.capacity = capacity
    const entries = allocateHeapCell(capacity * PropertyEntry.sizeof)
    dict.entries = entries
    finishHeapCell(entries)
    finishHeapCell(handle)
    return handle
}

function objectDict(obj: Handle): Handle {
    const o = HeapObject(resolveHeapCell(obj))
    if (o.properties) return o.properties
    const dict = makePropertyDict(4)
    o.properties = dict
    return dict
}

function findEntry(dictAddr: Handle, key: Handle): usize {
    const dict = PropertyDict(resolveHeapCell(dictAddr))
    const entries = resolveHeapCell(dict.entries)
    const count = dict.count
    for (let i: u32 = 0; i < count; i++) {
        const e = PropertyEntry(entries + i * PropertyEntry.sizeof)
        if (propertyKeysEqual(e.key, key)) return entries + i * PropertyEntry.sizeof
    }
    return 0
}

function growDict(dictAddr: Handle): void {
    const dict = PropertyDict(resolveHeapCell(dictAddr))
    const newCap = dict.capacity * 2
    const newEntries = allocateHeapCell(newCap * PropertyEntry.sizeof)
    intrinsics.memcpy(resolveHeapCell(newEntries), resolveHeapCell(dict.entries), dict.count * PropertyEntry.sizeof)
    dict.capacity = newCap
    dict.entries = newEntries
    finishHeapCell(newEntries)
}

export function setProperty(obj: Handle, key: Handle, value: Handle): void {
    const dictAddr = objectDict(obj)

    const found = findEntry(dictAddr, key)
    if (found) {
        const desc = FullPropertyDescriptor(resolveHeapCell(PropertyEntry(found).descriptor))
        desc.slot0 = value
        desc.flags = dataPropertyFlags
        return
    }

    const dict = PropertyDict(resolveHeapCell(dictAddr))
    if (dict.count >= dict.capacity) growDict(dictAddr)

    const descHandle = allocateHeapCell(FullPropertyDescriptor.sizeof)
    const desc = FullPropertyDescriptor(resolveHeapCell(descHandle))
    desc.slot0 = value
    desc.slot1 = 0
    desc.flags = dataPropertyFlags

    const count = dict.count
    const e = PropertyEntry(resolveHeapCell(dict.entries) + count * PropertyEntry.sizeof)
    e.key = key
    e.descriptor = descHandle
    dict.count = count + 1
    finishHeapCell(descHandle)
}

export function getOwnProperty(obj: Handle, key: Handle): Handle {
    const o = HeapObject(resolveHeapCell(obj))
    if (!o.properties) return 0
    const e = findEntry(o.properties, key)
    if (e === 0) return 0
    return PropertyEntry(e).descriptor
}

export function ownPropertyKeyAt(obj: Handle, index: u32): Handle {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    if (!properties) return 0
    const dict = PropertyDict(resolveHeapCell(properties))
    if (index >= dict.count) return 0
    return PropertyEntry(resolveHeapCell(dict.entries) + index * PropertyEntry.sizeof).key
}

export function shallowClone(obj: Handle): Handle {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    const handle = allocateHeapCell(HeapObject.sizeof)
    HeapObject(resolveHeapCell(handle)).td = HeapObject(resolveHeapCell(obj)).td
    HeapObject(resolveHeapCell(handle)).properties = 0
    finishHeapCell(handle)
    if (!properties) return handle
    const count = PropertyDict(resolveHeapCell(properties)).count
    const dictHandle = makePropertyDict(PropertyDict(resolveHeapCell(properties)).capacity)
    PropertyDict(resolveHeapCell(dictHandle)).count = count
    for (let i: u32 = 0; i < count; i++) {
        const source = PropertyEntry(
            resolveHeapCell(PropertyDict(resolveHeapCell(properties)).entries)
            + i * PropertyEntry.sizeof)
        const key = source.key
        const descHandle = allocateHeapCell(FullPropertyDescriptor.sizeof)
        const from = FullPropertyDescriptor(resolveHeapCell(
            PropertyEntry(resolveHeapCell(PropertyDict(resolveHeapCell(properties)).entries)
                + i * PropertyEntry.sizeof).descriptor))
        const to = FullPropertyDescriptor(resolveHeapCell(descHandle))
        to.flags = from.flags
        to.slot0 = from.slot0
        to.slot1 = from.slot1
        finishHeapCell(descHandle)
        const target = PropertyEntry(
            resolveHeapCell(PropertyDict(resolveHeapCell(dictHandle)).entries)
            + i * PropertyEntry.sizeof)
        target.key = key
        target.descriptor = descHandle
    }
    HeapObject(resolveHeapCell(handle)).properties = dictHandle
    return handle
}

export function ownPropertyCount(obj: Handle): u32 {
    const properties = HeapObject(resolveHeapCell(obj)).properties
    return properties ? PropertyDict(resolveHeapCell(properties)).count : 0
}

export function copyEnumerableOwnProperties(target: Handle, source: Handle): void {
    const writable = isIndirect(target) ? prepareWrite(target) : target
    const readable = isIndirect(source) ? indirectTarget(source) : source
    for (let i: u32 = 0; i < ownPropertyCount(readable); i++) {
        const key = ownPropertyKeyAt(readable, i)
        if (!key) continue
        const descriptor = getOwnProperty(readable, key)
        if (!descriptor) continue
        const d = FullPropertyDescriptor(resolveHeapCell(descriptor))
        if (!(d.flags & PropFlags.enumerable)) continue
        setProperty(writable, key, d.slot0 as Handle)
    }
}

export function getPropertyDescriptor(obj: Handle, key: Handle): Handle {
    let cur = obj
    while (cur !== 0) {
        const desc = getOwnProperty(cur, key)
        if (desc !== 0) return desc
        cur = prototypeOf(cur)
    }
    return 0
}

export function getPropertyProxy(obj: Handle): Handle {
    let cur = obj
    while (cur !== 0) {
        if (TypeDescriptor(resolveHeapCell(HeapObject(resolveHeapCell(cur)).td)).kind === BaseTypeKind.proxy) return cur
        cur = prototypeOf(cur)
    }
    return 0
}
intrinsics.tagInline(getPropertyProxy)

export function getProxyGetter(proxy: Handle): Handle {
    return HeapProxy(resolveHeapCell(proxy)).getter
}
intrinsics.tagInline(getProxyGetter)

export function getProxySetter(proxy: Handle): Handle {
    return HeapProxy(resolveHeapCell(proxy)).setter
}

function hasProperty(obj: Handle, key: Handle): boolean {
    let cur = obj
    while (cur !== 0) {
        if (getOwnProperty(cur, key) !== 0) return true
        cur = prototypeOf(cur)
    }
    return false
}

export function getProperty(obj: Handle, key: Handle): Handle {
    const desc = getPropertyDescriptor(obj, key)
    return desc === 0 ? 0 : FullPropertyDescriptor(resolveHeapCell(desc)).slot0 as Handle
}

const prototypeKey = fromJsString('prototype')

export function getPrototypeProperty(obj: Handle): Handle {
    return getProperty(obj, prototypeKey)
}

// shallow-ish. nested plain objects are visited recursively
export function fromJsObject(o: object, compileFn?: (f: Function) => Handle): Handle {
    return fromJsObjectInner(o, compileFn, new Map<object, Handle>())
}

export function fromJsValue(v: any, compileFn?: (f: Function) => Handle): Handle {
    return fromJsValueInner(v, compileFn, new Map<object, Handle>())
}

export function createJsValueConverter(compileFn?: (f: Function) => Handle): (v: any) => Handle {
    const seen = new Map<object, Handle>()
    return v => fromJsValueInner(v, compileFn, seen)
}

// used for caching in test harnesses
const rawHeapHandle = Symbol('heap.handle')
export function createHeapHandle(handle: u32): any {
    return { [rawHeapHandle]: handle }
}

function fromJsObjectInner(o: object, compileFn: ((f: Function) => Handle) | undefined, seen: Map<object, Handle>): Handle {
    if (o instanceof Map) throw 'heap: Map values cannot be materialized'
    if (const prev = seen.get(o)) return prev
    if (Array.isArray(o)) {
        const handle = makeArray()
        seen.set(o, handle)
        const length = o.length as u32
        for (let i: u32 = 0; i < length; i++) {
            setProperty(handle, indexKey(i), fromJsValueInner(o[i], compileFn, seen))
        }
        setProperty(handle, arrayLengthKey, boxF64(length as f64))
        return handle
    }
    const isProxy = '__proxy' in o
    const isView = isProxy && Object.prototype.hasOwnProperty.call(o, '__address')
    if (isProxy && !isView) {
        const obj = allocateHeapCell(HeapProxy.sizeof)
        const proxy = HeapProxy(resolveHeapCell(obj))
        proxy.td = proxyTD
        proxy.properties = 0
        seen.set(o, obj)
        const value: any = o
        proxy.getter = fromJsValueInner(value.__proxyGet, compileFn, seen)
        proxy.setter = fromJsValueInner(value.__proxySet, compileFn, seen)
        finishHeapCell(obj)
        return obj
    }
    if (rawHeapHandle in o) {
        const h = o[rawHeapHandle] as u32
        seen.set(o, h)
        return h
    }
    const proto = isView ? fromJsObjectInner(Object.getPrototypeOf(o), compileFn, seen) : 0
    const obj = allocateHeapCell(HeapObject.sizeof)
    const object = HeapObject(resolveHeapCell(obj))
    object.td = objectTDFor(proto)
    object.properties = 0
    seen.set(o, obj)
    const dictAddr = objectDict(obj)
    const descriptors: any = (Object as any).getOwnPropertyDescriptors(o)
    for (const k of Reflect.ownKeys(descriptors)) {
        const d = descriptors[k]
        if (!d.enumerable && typeof k !== 'symbol') continue
        const descHandle = allocateHeapCell(FullPropertyDescriptor.sizeof)
        const desc = FullPropertyDescriptor(resolveHeapCell(descHandle))
        let flags: u8 = 0
        if (d.enumerable) flags |= PropFlags.enumerable
        if (d.configurable) flags |= PropFlags.configurable
        if ('value' in d) {
            if (d.writable) flags |= PropFlags.writable
            desc.slot0 = fromJsValueInner(d.value, compileFn, seen)
            desc.slot1 = 0
        } else {
            if (d.get) {
                flags |= PropFlags.has_getter
                desc.slot0 = fromJsValueInner(d.get, compileFn, seen)
            }
            if (d.set) {
                flags |= PropFlags.has_setter
                desc.slot1 = fromJsValueInner(d.set, compileFn, seen)
            }
        }
        desc.flags = flags
        const dict = PropertyDict(resolveHeapCell(dictAddr))
        if (dict.count >= dict.capacity) growDict(dictAddr)
        const e = PropertyEntry(resolveHeapCell(dict.entries) + dict.count * PropertyEntry.sizeof)
        e.key = typeof k === 'symbol' ? fromJsSymbol(k) : fromJsString(k)
        e.descriptor = descHandle
        dict.count = dict.count + 1
        finishHeapCell(descHandle)
    }
    finishHeapCell(obj)
    return obj
}

function fromJsValueInner(v: any, compileFn: ((f: Function) => Handle) | undefined, seen: Map<object, Handle>): Handle {
    if (typeof v === 'symbol') return fromJsSymbol(v)
    if (typeof v === 'number') return boxF64(v)
    if (typeof v === 'bigint') return boxF64(Number(v))
    if (typeof v === 'boolean') return v ? 1 : 0
    if (v === null || v === undefined) return 0
    if (typeof v === 'function') {
        if (const h = compileFn?.(v)) return h
        throw 'todo'
    }
    if (typeof v === 'object') return fromJsObjectInner(v, compileFn, seen)
    if (typeof v === 'string') {
        // TODO: we should be interning strings within the heap
        // this is just a hack to speed up dev time
        if (const cached = seen.get(v as any)) return cached
        const r = fromJsString(v)
        seen.set(v as any, r)
        return r
    }
    throw `unhandled typeof: ${typeof v}`
}

// the interpreter has two modes which can influence some of these flags
// one of the modes does not use SMIs and has native width registers, but lacks Number.prototype.
// in "native" mode, interpretation is entirely implied by usage instead of tracked independently
export enum FunctionBytecodeFlags {
    has_rest_param = 1 << 0,
    has_effects = 1 << 1, // conservative, _excludes_ allocations, `throw` is not considered an effect
    has_no_stack_escapes = 1 << 2, // returns are not considered escapes
    has_no_stack_returns = 1 << 3, // only stack allocated handles are stack returns
    has_no_handle_returns = 1 << 4, // means this fn only returns simple scalars e.g. `return 1 + 1`
    has_captures = 1 << 5,

    uses_this = 1 << 9,
    uses_callback = 1 << 10, // one of the params is known to be called in a code path
    uses_throw = 1 << 11,

    // max size of the bytecode operands. you should check `uses_u64_bytecode` first.
    uses_u16_bytecode = 1 << 12,
    uses_u32_bytecode = 1 << 13,
    uses_u64_bytecode = uses_u16_bytecode | uses_u32_bytecode,

    assumes_native_mode = 1 << 15,
}

interface CoveredRange {
    // all are bytecode indices
    start: u32
    end: u32
    handler: u32 
}
export const CoveredRange = intrinsics.DefineStructView(reify CoveredRange)

interface FunctionBytecodeLabels {
    ehRanges: Handle
    ehRangesCount: u32
    jumpLabels: Handle
    jumpLabelsCount: u32
}

export const FunctionBytecodeLabels = intrinsics.DefineStructView(reify FunctionBytecodeLabels)

interface FunctionBytecode {
    source?: Handle // string
    flags: u16
    paramCount: u16 // we won't bother supporting more than this, rest params will use a flag. they will still appear apart of this count
    registerCount: u32
    bytecode: Handle
    bytecodeLen: u32 
    constants: Handle
    constantsLen: u32
    scopeBindings: Handle
    scopeBindingsCount: u32
    labels?: Handle
}
export const FunctionBytecode = intrinsics.DefineStructView(reify FunctionBytecode)

interface ScopeBinding {
    slot: u32
    parentSlot: u32
}
export const ScopeBinding = intrinsics.DefineStructView(reify ScopeBinding)

export function makeClosure(template: Handle, parent: Handle, frame: usize): Handle {
    const src = FunctionBytecode(resolveHeapCell(template))
    const handle = allocateHeapCell(FunctionBytecode.sizeof)
    const fn = FunctionBytecode(resolveHeapCell(handle))
    fn.source = src.source
    fn.flags = src.flags
    fn.paramCount = src.paramCount
    fn.registerCount = src.registerCount
    fn.bytecode = src.bytecode
    fn.bytecodeLen = src.bytecodeLen
    fn.constantsLen = src.constantsLen
    fn.labels = src.labels
    fn.scopeBindings = src.scopeBindings
    fn.scopeBindingsCount = src.scopeBindingsCount
    const nativeConstants = !!(src.flags & FunctionBytecodeFlags.assumes_native_mode)
    const constantBytes = nativeConstants ? 8 : 4
    const constantType = nativeConstants ? Types.u64 : Types.u32
    const constants = allocateHeapCell(src.constantsLen === 0 ? 1 : src.constantsLen * constantBytes)
    intrinsics.memcpy(resolveHeapCell(constants), resolveHeapCell(src.constants), src.constantsLen * constantBytes)
    fn.constants = constants
    const parentFn = FunctionBytecode(resolveHeapCell(parent))
    const nativeParentConstants = !!(parentFn.flags & FunctionBytecodeFlags.assumes_native_mode)
    const parentConstantBytes = nativeParentConstants ? 8 : 4
    const parentConstantType = nativeParentConstants ? Types.u64 : Types.u32
    for (let i: u32 = 0; i < src.scopeBindingsCount; i++) {
        const binding = ScopeBinding(resolveHeapCell(src.scopeBindings) + i * ScopeBinding.sizeof)
        let scope: usize
        if (binding.parentSlot === 0xFFFFFFFF) {
            const scopeHandle = allocateHeapCell(4)
            Intrinsics.store(resolveHeapCell(scopeHandle), 0, frame, Types.u32)
            finishHeapCell(scopeHandle)
            scope = ((scopeHandle << 1) | 1) as usize
        } else {
            scope = Intrinsics.load(resolveHeapCell(parentFn.constants), binding.parentSlot * parentConstantBytes, parentConstantType)
        }
        Intrinsics.store(resolveHeapCell(constants), binding.slot * constantBytes, scope, constantType)
    }
    finishHeapCell(constants)
    finishHeapCell(handle)
    return handle
}

if (intrinsics.argv()[0] === 'heap') {
    const assert = intrinsics.assert

    // strings: utf-8 roundtrip (é is 2 bytes)
    const hello = fromJsString("héllo")
    assert(stringLength(hello) === 6)
    assert(stringToJs(hello) === "héllo")
    assert(stringBytesEqual(hello, fromJsString("héllo")))
    assert(!stringBytesEqual(hello, fromJsString("world")))

    const firstSymbol = Symbol('key'), secondSymbol = Symbol('key')
    const symbolObject = fromJsObject(Object.defineProperty({ [firstSymbol]: 7, key: 9 }, secondSymbol, { value: 11 }))
    assert(fromJsSymbol(firstSymbol) === fromJsValue(firstSymbol))
    assert(fromJsSymbol(firstSymbol) !== fromJsSymbol(secondSymbol))
    assert(unboxF64(getProperty(symbolObject, fromJsSymbol(firstSymbol))) === 7)
    assert(unboxF64(getProperty(symbolObject, fromJsSymbol(secondSymbol))) === 11)
    assert(unboxF64(getProperty(symbolObject, fromJsString('key'))) === 9)
    const inheritedSymbol = makeObject(symbolObject)
    assert(unboxF64(getProperty(inheritedSymbol, fromJsSymbol(firstSymbol))) === 7)

    // objects + prototype chain
    const proto = makeObject(0)
    setProperty(proto, fromJsString("kind"), fromJsString("base"))

    const obj = makeObject(proto)
    const nameKey = fromJsString("name")
    setProperty(obj, nameKey, fromJsString("widget"))

    assert(hasProperty(obj, nameKey))
    assert(stringToJs(getProperty(obj, nameKey)) === "widget")

    // "kind" is not own but is inherited
    assert(getOwnProperty(obj, fromJsString("kind")) === 0)
    assert(hasProperty(obj, fromJsString("kind")))
    assert(stringToJs(getProperty(obj, fromJsString("kind"))) === "base")

    // shared TD: same prototype -> same TD handle
    const obj2 = makeObject(proto)
    assert(HeapObject(resolveHeapCell(obj)).td === HeapObject(resolveHeapCell(obj2)).td)

    // overwrite in place
    setProperty(obj, nameKey, fromJsString("gadget"))
    assert(stringToJs(getProperty(obj, nameKey)) === "gadget")

    // force a dict grow (initial capacity 4)
    for (let i = 0; i < 10; i++) {
        setProperty(obj, fromJsString("k" + i), fromJsString("v" + i))
    }
    assert(stringToJs(getProperty(obj, fromJsString("k7"))) === "v7")

    {
        const inner = makeObject(0 as Handle)
        setProperty(inner, nameKey, fromJsString("first"))
        const cell = makeIndirect(inner)
        assert(isIndirect(cell) && !isIndirect(inner))
        assert(indirectTarget(cell) === inner)

        const next = shallowClone(inner)
        setProperty(next, nameKey, fromJsString("second"))
        setIndirectTarget(cell, next)
        assert(indirectTarget(cell) === next)
        assert(stringToJs(getProperty(indirectTarget(cell), nameKey)) === "second")
        assert(stringToJs(getProperty(inner, nameKey)) === "first")

        function branch(depth: number): Handle {
            const outer = indirectStash(cell)
            const base = indirectTarget(cell)
            setIndirectStash(cell, base)
            const w = prepareWrite(cell)
            assert(w !== base)
            setProperty(w, nameKey, fromJsString("depth" + depth))
            if (depth < 2) {
                const nested = branch(depth + 1)
                assert(stringToJs(getProperty(nested, nameKey)) === "depth" + (depth + 1))
                assert(indirectTarget(cell) === w)
                assert(prepareWrite(cell) === w)
                assert(stringToJs(getProperty(w, nameKey)) === "depth" + depth)
            }
            const taken = indirectTarget(cell)
            setIndirectTarget(cell, base)
            setIndirectStash(cell, outer)
            return taken
        }

        const before = indirectTarget(cell)
        const taken = branch(0)
        assert(taken !== before)
        assert(stringToJs(getProperty(taken, nameKey)) === "depth0")
        assert(indirectTarget(cell) === before)
        assert(indirectStash(cell) === 0)
        assert(stringToJs(getProperty(indirectTarget(cell), nameKey)) === "second")
    }

    console.log("heap self-test passed")
}

// "native mode" limitations:
// 1. true/false are not distinct from 1/0, they are the same (also like number, you cannot use prototype methods on them)
// 2. null/undefined are both numeric 0. empty string is also numeric 0, and may trap on GetProperty
// 3. floating point ops are explicit (Float.*)
// 4. no using number primitives for Number.prototype methods (for now)
// 5. cannot use numeric keys w/o boxing them explicitly
