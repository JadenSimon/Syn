/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as native from './native'
import * as heap from './heap'
import { globals, programStack, programStackTop, releaseProgramStack } from './builtins'
import { sampleNative } from './sampling'
import { writeNativeProfile } from './profile'

const caseHandleBase = 0x100_0000

function reserveLowHandles(): void {
    const top = heap.allocateHeapCell(8)
    if (top < caseHandleBase) heap.allocateHeapCell((caseHandleBase - top) as usize)
}

reserveLowHandles()

const fingerprintCrypto = (globalThis as any).process.getBuiltinModule('node:crypto')
const fingerprintScale = 0x200000

function fingerprintHalf(x: number): number {
    x = Math.imul(x ^ (x >>> 16), 0x85ebca6b)
    x = Math.imul(x ^ (x >>> 13), 0xc2b2ae35)
    return (x ^ (x >>> 16)) >>> 0
}

class FingerprintHasher {
    a = 0x811c9dc5
    b = 0x9e3779b9

    word(x: number): void {
        this.a = Math.imul(this.a ^ x, 0x01000193)
        this.b = Math.imul(this.b ^ x, 0x5bd1e995) ^ (this.b >>> 15)
    }

    add(hash: number): void {
        this.word(Math.floor(hash / fingerprintScale))
        this.word(hash % fingerprintScale)
    }

    done(): number {
        return fingerprintHalf(this.a) * fingerprintScale + (fingerprintHalf(this.b ^ this.a) & 0x1fffff)
    }
}

let fingerprintRanges: [base: number, size: number][] = []

function fingerprintNumber(x: number): string {
    let i = 0
    while (i < fingerprintRanges.length) {
        const [base, size] = fingerprintRanges[i]
        if (x >= base && x < base + size) return `address ${i}+${x - base}`
        i++
    }
    return String(x)
}

class Fingerprint {
    memo = new Map<unknown, number>()
    texts = new Map<string, number>()
    depth = 0
    leaves = 0

    constructor(public base?: Fingerprint) {}

    text(text: string): number {
        const known = this.base?.texts.get(text) ?? this.texts.get(text)
        if (known !== undefined) return known
        const hash = parseInt(fingerprintCrypto.createHash('sha1').update(text).digest('hex').slice(0, 13), 16)
        this.texts.set(text, hash)
        return hash
    }

    leaf(label: string): number {
        this.leaves++
        const h = new FingerprintHasher()
        h.add(this.text('leaf'))
        h.add(this.text(label))
        h.word(this.leaves)
        return h.done()
    }

    keyed(h: FingerprintHasher, owner: any, key: string | symbol): void {
        h.add(this.visit(key))
        const d = Object.getOwnPropertyDescriptor(owner, key)!
        if ('value' in d) {
            h.add(this.visit(d.value))
            return
        }
        h.add(this.visit(d.get))
        h.add(this.visit(d.set))
    }

    computation(fn: Function): any[] | undefined {
        if (!intrinsics.hasComputation(fn)) return undefined
        try {
            return intrinsics.getComputation(fn)
        } catch {
            return undefined
        }
    }

    compound(v: any): number {
        if (typeof v === 'symbol') {
            const key = Symbol.keyFor(v)
            return key === undefined ? this.leaf(`symbol ${v.description}`) : this.text(`symbol ${key}`)
        }
        const h = new FingerprintHasher()
        if (typeof v === 'function') {
            const computation = this.computation(v)
            if (!computation) return this.leaf(`function ${v.name}`)
            h.add(this.text('function'))
            h.add(this.text(computation[0]))
            h.add(this.visit(computation[1]))
            h.add(this.visit(computation[2]))
            h.add(this.visit(computation[3]))
            for (const key of Object.keys(v)) this.keyed(h, v, key)
            return h.done()
        }
        if (Array.isArray(v)) {
            h.add(this.text('array'))
            h.word(v.length)
            let i = 0
            while (i < v.length) {
                h.add(this.visit(v[i]))
                i++
            }
            return h.done()
        }
        if (v instanceof Map) {
            h.add(this.text('map'))
            for (const [key, value] of v) {
                h.add(this.visit(key))
                h.add(this.visit(value))
            }
            return h.done()
        }
        if (v instanceof Set) {
            h.add(this.text('set'))
            for (const value of v) h.add(this.visit(value))
            return h.done()
        }
        if (ArrayBuffer.isView(v) || v instanceof ArrayBuffer || v instanceof WeakMap || v instanceof WeakSet || v instanceof Fingerprint || v === globalThis) {
            return this.leaf(Object.prototype.toString.call(v))
        }
        h.add(this.text('object'))
        h.add(this.visit(Object.getPrototypeOf(v)))
        for (const key of Reflect.ownKeys(v)) this.keyed(h, v, key)
        return h.done()
    }

    visit(v: any): number {
        if (v === null) return this.text('null')
        const kind = typeof v
        if (kind === 'number') return this.text(`number ${fingerprintNumber(v)}`)
        if (kind !== 'object' && kind !== 'function' && kind !== 'symbol') return this.text(`${kind} ${String(v)}`)
        const known = this.base?.memo.get(v) ?? this.memo.get(v)
        if (known !== undefined && known >= 0) return known
        if (known !== undefined) return this.text(`cycle ${this.depth + known}`)
        this.depth++
        this.memo.set(v, -this.depth)
        const hash = this.compound(v)
        this.depth--
        this.memo.set(v, hash)
        return hash
    }
}

function fingerprintHex(hash: number): string {
    return hash.toString(16).padStart(14, '0')
}

let compilerFingerprint: Fingerprint | undefined
let suiteRoots: string[] = []
let suiteRootsMs = 0

function fingerprintCompiler(): Fingerprint {
    if (compilerFingerprint) return compilerFingerprint
    const started = performance.now()
    const compiler = new Fingerprint()
    console.log(`FINGERPRINT compiler ${fingerprintHex(compiler.visit(native.createNatives))} [${(performance.now() - started).toFixed(1)}ms]`)
    compilerFingerprint = compiler
    return compiler
}

native.observeRoots((fns, opts) => {
    const started = performance.now()
    suiteRoots.push(fingerprintHex(new Fingerprint(fingerprintCompiler()).visit([fns, opts.globals])))
    suiteRootsMs += performance.now() - started
})

export type Case = [fn: Function, ...argSets: number[][]]

export interface CaseFormat {
    prefix: string
    args?: boolean
    value?: boolean
    stacks?: boolean
}

export interface BenchOptions {
    ops?: number
    reps?: number
    minus?: Function
    globals?: Record<string, any>
}

interface Bench {
    fn: Function
    args: number[]
    opts: BenchOptions
}

interface Measurement {
    compileMs: number
    native: number
    js: number
    nativeResult: number
    jsResult: number
    perCall: number
    reps: number
}

function flagValues(name: string): string[] {
    const prefix = `${name}:`
    return intrinsics.argv().filter(a => a.startsWith(prefix)).map(a => a.slice(prefix.length))
}

function flagNumber(name: string, fallback: number): number {
    const values = flagValues(name)
    return values.length ? Number(values[0]) : fallback
}

export function selected(name: string): boolean {
    const only = flagValues('only')
    if (only.length && !only.includes(name)) return false
    return !flagValues('skip').includes(name)
}

export function markers(): boolean {
    return intrinsics.argv().includes('case-markers')
}

interface CrashResume {
    suite: string
    case: number
}

const crashEnv = (globalThis as any).process?.env ?? {}
const crashFd = Number(crashEnv.SYN_CRASH_FD ?? 0)
const crashResume: CrashResume | undefined = crashEnv.SYN_CRASH_RESUME ? JSON.parse(crashEnv.SYN_CRASH_RESUME) : undefined
let suiteName = ''
let runKey = ''
let caseNumber = 0
let currentCase = ''
let failures = 0
let inCase = false
let caseNames = new Map<string, number>()
let insideCases = { units: 0, fns: 0, instructions: 0, nonMov: 0 }
let outsideCompile = { run: 0, direct: 0 }

function crashMark(line: string): void {
    if (!crashFd) return
    const writeFile = (globalThis as any).__writeFile
    writeFile(crashFd, `${line.replace(/\n/g, ' ')}\n`)
}

if (crashFd) native.observeNatives(event => crashMark(`event\t${event}`))
if (crashFd) native.observeCode(units => crashMark(`map\t${units}`))
if (crashFd) native.installCrashDump(Number(crashEnv.SYN_CRASH_DUMP_FD ?? 0))

export function fail(line: string): void {
    failures++
    console.log(line)
    crashMark(`fail\t${line.split('\n')[0].slice(0, 200)}`)
}

function phaseSum(): number {
    return Object.values(native.phaseTimes()).reduce((a, b) => a + b, 0)
}

function reportCase(name: string, units: number, fns: number, instructions: number, nonMov: number, ms: number): void {
    crashMark(`end\t${name}\t${instructions}\t${nonMov}\t${fns}\t${ms.toFixed(1)}`)
    if (units) console.log(`CASE ${suiteName} ${name} ${instructions} ${nonMov} ${fns}`)
}

export async function runSuite(name: string): Promise<number> {
    fingerprintRanges = (await import('./trace2')).symbolicRanges
    const compiler = fingerprintHex(fingerprintCompiler().visit(native.createNatives))
    suiteName = name
    caseNumber = 0
    caseNames = new Map()
    outsideCompile = { run: 0, direct: 0 }
    runKey = [name, ...intrinsics.argv()].filter(a => !/^(timeout|max-crashes|baseline|only|skip):|^heap-(stats|owners)$/.test(a)).join(' ')
    crashMark(`suite\t${name}\t${runKey}`)
    const start = native.emittedCounts()
    const phasesBefore = native.phaseTimes()
    insideCases = { units: 0, fns: 0, instructions: 0, nonMov: 0 }
    suiteRoots = []
    suiteRootsMs = 0
    try {
        const { suite } = await import(`./${name}`)
        await suite()
    } catch (e) {
        fail(`SUITE ${name} ABORTED${currentCase ? ` in ${currentCase}` : ''}: ${String(e).split('\n')[0].slice(0, 300)}`)
        throw e
    }
    const end = native.emittedCounts()
    const units = end.units - start.units - insideCases.units
    if (units) reportCase('(outside cases)', units, end.fns - start.fns - insideCases.fns, end.instructions - start.instructions - insideCases.instructions, end.nonMov - start.nonMov - insideCases.nonMov, 0)
    const phases = native.phaseTimes()
    for (const phase of Object.keys(phases)) phases[phase] -= phasesBefore[phase] ?? 0
    const roots = fingerprintHex(new Fingerprint().visit(suiteRoots))
    console.log(`FINGERPRINT ${name} roots ${roots} [${suiteRoots.length} compiles, ${suiteRootsMs.toFixed(1)}ms]`)
    if (heapStatsOn) reportHeap(`suite ${name}`)
    if (intrinsics.argv().includes('heap-owners')) {
        const fs = (globalThis as any).process.getBuiltinModule('node:fs')
        fs.writeFileSync(`${(globalThis as any).process.env.HEAP_OWNERS_DIR}/${name}.json`, JSON.stringify([...intrinsics.heapOwners()]))
    }
    crashMark(`fingerprint\t${compiler}\t${roots}`)
    crashMark(`done\t${JSON.stringify({ ...phases, run: outsideCompile.run, direct: outsideCompile.direct })}`)
    return failures
}

export function test(name: string, run: () => void): void {
    if (inCase) {
        run()
        return
    }
    if (!selected(name)) return
    caseNumber++
    const seen = caseNames.get(name) ?? 0
    caseNames.set(name, seen + 1)
    const unique = seen ? `${name}#${seen + 1}` : name
    if (crashResume?.suite === suiteName && caseNumber <= crashResume.case) return
    if (markers()) console.log(`CASE-START ${name}`)
    crashMark(`case\t${caseNumber}\t${suiteName} ${name}\t${unique}`)
    currentCase = name
    inCase = true
    const start = native.emittedCounts()
    const started = performance.now()
    const compiledBefore = phaseSum()
    try {
        run()
    } finally {
        inCase = false
    }
    const end = native.emittedCounts()
    const units = end.units - start.units
    const fns = end.fns - start.fns
    const instructions = end.instructions - start.instructions
    const nonMov = end.nonMov - start.nonMov
    insideCases.units += units
    insideCases.fns += fns
    insideCases.instructions += instructions
    insideCases.nonMov += nonMov
    const ms = performance.now() - started
    if (units) outsideCompile.run += ms - (phaseSum() - compiledBefore)
    else outsideCompile.direct += ms
    reportCase(unique, units, fns, instructions, nonMov, ms)
    if (heapStatsOn) reportHeap(`case ${suiteName} ${unique}`)
    currentCase = ''
}

const heapStatsOn = intrinsics.argv().includes('heap-stats') || intrinsics.argv().includes('heap-owners')
function reportHeap(label: string): void {
    const h = intrinsics.heapStats()
    console.log(`HEAP ${label} high ${(h.highWater / 1048576).toFixed(2)}MB live ${(h.live / 1048576).toFixed(2)}MB free ${(h.free / 1048576).toFixed(2)}MB blocks ${h.blocks} liveBlocks ${h.liveBlocks}`)
}

export function fatal(name: string, flags: string[], expected: string, run: () => void, output = ''): void {
    if (intrinsics.argv().includes('fatal-child')) {
        test(name, run)
        return
    }
    test(name, () => {
        const exited = runChild(name, flags)
        const stderr = String(exited.stderr ?? '').trim()
        if (exited.signal !== expected) fail(`fatal ${name} FAILED: ${exited.signal ? `killed by ${exited.signal}` : `exited ${exited.status}`}, expected ${expected}: ${stderr.slice(0, 300)}`)
        else if (!stderr.includes(output)) fail(`fatal ${name} FAILED: stderr ${JSON.stringify(stderr.slice(0, 300))}, expected ${JSON.stringify(output)}`)
        else console.log(`fatal ${name} ok`)
    })
}

export function flagged(name: string, flags: string[], run: () => void, check: (stdout: string) => void): void {
    if (intrinsics.argv().includes('fatal-child')) {
        test(name, run)
        return
    }
    test(name, () => {
        const exited = runChild(name, flags)
        if (exited.status !== 0) fail(`${name} FAILED: ${exited.signal ? `killed by ${exited.signal}` : `exited ${exited.status}`}: ${String(exited.stderr ?? '').trim().slice(0, 300)}`)
        else check(String(exited.stdout ?? ''))
    })
}

function runChild(name: string, flags: string[]): any {
    const host = (globalThis as any).process
    const engine = host.argv.indexOf('--engine')
    const args = [...host.argv.slice(2, engine + 1), suiteName, ...intrinsics.argv().filter(a => !a.startsWith('only:')), 'in-process', `only:${name}`, 'fatal-child', ...flags]
    const env = { ...host.env, SYN_CRASH_FD: '', SYN_CRASH_RESUME: '' }
    return (globalThis as any).__spawnSync(host.argv[1], args, env)
}

export function benching(): boolean {
    return intrinsics.argv().includes('bench') || flagValues('bench').length > 0 || profiling()
}

export function profiling(): boolean {
    return intrinsics.argv().some(a => /^(prof|sample)(:|$)/.test(a))
}

export function profileNative(name: string, run: any, workload: (measure: (call: () => void) => void) => void): void {
    if (!profiling()) return
    if (!run.units || !run.image) throw 'prof requires native listing metadata; use it without image-in/image-roundtrip'
    const depth = flagNumber('chain-depth', 32)
    const chains = flagNumber('chains', 8)
    if (!Number.isInteger(depth) || depth < 3 || depth > 128) throw 'prof: chain-depth must be an integer in [3, 128]'
    if (!Number.isInteger(chains) || chains < 1 || chains > 100) throw 'prof: chains must be an integer in [1, 100]'
    const gate = new Uint32Array(1)
    const measure = (call: () => void) => {
        gate[0] = 1
        try { call() }
        finally { gate[0] = 0 }
    }
    const samples = sampleNative(() => workload(measure), flagNumber('sample-ms', 1000), flagNumber('sample-us', 1000), gate)
    console.log(`sample ${name}: ${samples.pcs.length} PCs captured in ${samples.milliseconds.toFixed(1)}ms`)
    const directory = flagValues('prof')[0] || flagValues('sample')[0] || 'out/profiles'
    console.log(writeNativeProfile({ directory, name: `${suiteName}.${name}`, run, samples, chains, depth }))
}

export function benchSelected(name: string): boolean {
    const names = flagValues('bench')
    return !names.length || names.includes(name)
}

function caseLabel(format: CaseFormat, fn: Function, args: number[]): string {
    return format.args ? `${fn.name}(${args.join(', ')})` : fn.name
}

function describeError(format: CaseFormat, e: unknown): string {
    if (format.stacks) return (e as any)?.stack ?? String(e)
    return String(e).split('\n')[0].slice(0, 300)
}

const roundTrip = intrinsics.argv().includes('image-roundtrip')
const imageOut = flagValues('image-out')[0]
const imageIn = flagValues('image-in')[0]
const imageNames = new Map<string, number>()

function imageFile(dir: string, name: string): string {
    const key = `${suiteName}.${name}`
    const seen = imageNames.get(key) ?? 0
    imageNames.set(key, seen + 1)
    return `${dir}/${key}.${seen}.img`
}

export function roundTripped<T extends Record<string, any>>(natives: T): T {
    if (!roundTrip) return natives
    const bytes = native.serializeImage(natives)
    const loaded = native.withRegionsProtected(() => native.loadImage(bytes))
    const out: Record<string, any> = {}
    for (const name of Object.keys(loaded)) out[name] = (...args: any[]) => native.withRegionsProtected(() => loaded[name](...args))
    return out as T
}

function compile(name: string, fn: Function, globals?: Record<string, any>) {
    if (imageIn) return native.loadImage((globalThis as any).__readBytes(imageFile(imageIn, name)))[name]
    const natives: any = native.createNatives({ [name]: fn }, { globals })
    if (imageOut) (globalThis as any).__writeFile(imageFile(imageOut, name), native.serializeImage(natives))
    return roundTripped(natives)[name]
}

function hostGlobal(value: unknown): unknown {
    for (const name of Object.keys(globals)) {
        if (globals[name] === value) return (globalThis as any)[name]
    }
    return value
}

function reference(fn: Function): Function {
    if (!intrinsics.hasComputation(fn)) return fn
    const [source, captures] = intrinsics.getComputation(fn)
    const hosted = captures.map(hostGlobal)
    if (hosted.every((value, i) => value === captures[i])) return fn
    return new Function(...hosted.map((_, i) => `$${i}`), `return (${source})`)(...hosted)
}

export function sameResult(actual: unknown, expected: unknown): boolean {
    if (typeof actual === 'string' || typeof expected === 'string') return actual === expected
    return Number(actual) === Number(expected)
}

export function runCases(format: CaseFormat, cases: Case[]): void {
    if (benching()) return
    const compileOnly = intrinsics.argv().includes('compile-only')
    const caseStack = intrinsics.argv().includes('case-stack')
    for (const [fn, ...argSets] of cases) {
        test(fn.name, () => {
            const expected = argSets.map(args => (reference(fn) as any)(...args))
            const failed = (args: number[], e: unknown) => {
                fail(`${format.prefix} ${caseLabel(format, fn, args)} FAILED: ${describeError(format, e)}`)
                if (caseStack && !format.stacks) console.log((e as any)?.stack)
            }
            let run: any
            crashMark(`step\t${format.prefix} ${fn.name}`)
            try {
                run = compile(fn.name, fn)
            } catch (e) {
                for (const args of argSets) failed(args, e)
                return
            }
            argSets.forEach((args, i) => {
                const label = caseLabel(format, fn, args)
                if (compileOnly) {
                    console.log(`${format.prefix} ${label} compiled`)
                    return
                }
                crashMark(`step\t${format.prefix} ${label}`)
                try {
                    const actual = run(...args)
                    if (!sameResult(actual, expected[i])) fail(`${format.prefix} ${label} FAILED (miscompile): ${actual}, expected ${expected[i]}`)
                    else if (format.value) console.log(`${format.prefix} ${label} ok = ${typeof actual === 'string' ? actual : Number(actual)}`)
                    else console.log(`${format.prefix} ${label} ok`)
                } catch (e) {
                    failed(args, e)
                }
            })
        })
    }
}

function repeater(fn: Function, arity: number): Function {
    const f = fn as any
    if (arity === 1) {
        return function repeated(reps: u32, a: u32): number {
            let total = 0
            for (let i: u32 = 0; i < reps; i++) total = total + f(a + (i & 1))
            return total
        }
    }
    if (arity === 2) {
        return function repeated(reps: u32, a: u32, b: u32): number {
            let total = 0
            for (let i: u32 = 0; i < reps; i++) total = total + f(a + (i & 1), b)
            return total
        }
    }
    if (arity === 3) {
        return function repeated(reps: u32, a: u32, b: u32, c: u32): number {
            let total = 0
            for (let i: u32 = 0; i < reps; i++) total = total + f(a + (i & 1), b, c)
            return total
        }
    }
    if (arity === 4) {
        return function repeated(reps: u32, a: u32, b: u32, c: u32, d: u32): number {
            let total = 0
            for (let i: u32 = 0; i < reps; i++) total = total + f(a + (i & 1), b, c, d)
            return total
        }
    }
    throw `harness: no repeater for ${arity} args`
}

export function best(run: () => unknown): number {
    const warmups = flagNumber('warmups', 5)
    const samples = flagNumber('samples', 7)
    for (let i = 0; i < warmups; i++) run()
    let fastest = Infinity
    for (let sample = 0; sample < samples; sample++) {
        const start = performance.now()
        run()
        fastest = Math.min(fastest, performance.now() - start)
    }
    return fastest
}

function measure(fn: Function, args: number[], opts: BenchOptions): Measurement {
    const wrapper = repeater(fn, args.length) as any
    const compileStart = performance.now()
    const run = compile(fn.name, wrapper, opts.globals)
    const compileMs = performance.now() - compileStart
    const stacks = [0, programStack]
    const marks = stacks.map(stack => native.pstackMark(stack))
    const release = () => stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
    run(1, ...args)
    const perCall = Math.max(...stacks.map((stack, i) => Number(native.pstackMark(stack) - marks[i])))
    release()
    const fits = perCall ? Math.max(1, Math.floor((8 << 20) / perCall)) : Infinity
    const reps = Math.min(fits, flagNumber('reps', opts.reps ?? 200))
    const warmups = flagNumber('warmups', 5)
    const samples = flagNumber('samples', 7)
    const nativeOnly = intrinsics.argv().includes('native-only')
    const jsTop = programStackTop()
    let nativeResult = 0
    let jsResult = 0
    let nativeBest = Infinity
    let jsBest = Infinity
    for (let round = 0; round < warmups + samples; round++) {
        let start = performance.now()
        nativeResult = Number(run(reps, ...args))
        if (round >= warmups) nativeBest = Math.min(nativeBest, (performance.now() - start) / reps)
        release()
        if (nativeOnly) continue
        start = performance.now()
        jsResult = Number(wrapper(reps, ...args))
        if (round >= warmups) jsBest = Math.min(jsBest, (performance.now() - start) / reps)
        releaseProgramStack(jsTop)
    }
    if (profiling()) {
        if (!run.units || !run.image) throw 'prof requires native listing metadata; use it without image-in/image-roundtrip'
        const depth = flagNumber('chain-depth', 32)
        const chains = flagNumber('chains', 8)
        if (!Number.isInteger(depth) || depth < 3 || depth > 128) throw 'prof: chain-depth must be an integer in [3, 128]'
        if (!Number.isInteger(chains) || chains < 1 || chains > 100) throw 'prof: chains must be an integer in [1, 100]'
        const sampleReps = Math.min(fits, Math.max(reps, Math.ceil(5 / nativeBest)))
        const collected = sampleNative(() => {
            try { run(sampleReps, ...args) }
            finally { release() }
        }, flagNumber('sample-ms', 1000), flagNumber('sample-us', 1000))
        const directory = flagValues('prof')[0] || flagValues('sample')[0] || 'out/profiles'
        console.log(writeNativeProfile({
            directory, name: `${suiteName}.${fn.name}.${args.join('_')}`, samples: collected, run, chains, depth,
        }))
    }
    return { compileMs, native: nativeBest, js: jsBest, nativeResult, jsResult, perCall, reps }
}

function perOp(ms: number, opts: BenchOptions): string {
    return opts.ops ? ` (${(ms * 1e6 / opts.ops).toFixed(2)} ns/op)` : ''
}

function verdict(nativeMs: number, jsMs: number): string {
    const ratio = nativeMs / jsMs
    return ratio > 1 ? `${ratio.toFixed(2)}x slower` : `${(1 / ratio).toFixed(2)}x faster`
}

function report(name: string, m: Measurement, opts: BenchOptions): void {
    const nativeOnly = intrinsics.argv().includes('native-only')
    let line = `bench ${name} compile ${m.compileMs.toFixed(0)}ms, native ${(m.native * 1000).toFixed(2)} us${perOp(m.native, opts)}`
    if (!nativeOnly) line += `, js ${(m.js * 1000).toFixed(2)} us${perOp(m.js, opts)}, native ${verdict(m.native, m.js)}`
    line += `, ${(m.perCall / 1024).toFixed(1)} KB pstack/call, reps ${m.reps}`
    if (!nativeOnly && m.nativeResult !== m.jsResult) fail(`${line} MISMATCH native=${m.nativeResult} js=${m.jsResult}`)
    else console.log(line)
}

export function createBenches() {
    const benches: Bench[] = []
    return {
        bench(fn: Function, args: number[], opts: BenchOptions = {}): void {
            benches.push({ fn, args, opts })
        },
        run(): void {
            if (!benching()) return
            const nativeOnly = intrinsics.argv().includes('native-only')
            for (const { fn, args, opts } of benches) {
                if (!benchSelected(fn.name)) continue
                const name = `${fn.name}(${args.join(', ')})`
                if (!opts.minus) {
                    report(name, measure(fn, args, opts), opts)
                    continue
                }
                const base = measure(opts.minus, args, opts)
                report(`${opts.minus.name}(${args.join(', ')})`, base, opts)
                const m = measure(fn, args, opts)
                report(name, m, opts)
                const nativeNet = m.native - base.native
                const jsNet = m.js - base.js
                let line = `bench ${name} - ${opts.minus.name}: native ${(nativeNet * 1000).toFixed(2)} us${perOp(nativeNet, opts)}`
                if (!nativeOnly) line += `, js ${(jsNet * 1000).toFixed(2)} us${perOp(jsNet, opts)}, native ${verdict(nativeNet, jsNet)}`
                console.log(line)
            }
        },
    }
}
