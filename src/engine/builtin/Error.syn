/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import * as syscalls from '../syscalls'
import { Op as RtOp, bind } from '../rt'
import { print } from './console'
import { defineGlobal } from './globals'

export class Error {
    declare message: string

    constructor(message?: any) {
        if (typeof message === 'string') this.message = message
        else if (message === undefined) this.message = ''
        else this.message = `${message}`
    }
}

defineGlobal(Error)

export function reportPanic(value: any): void {
    print(2, value instanceof Error ? value.message : `${value}`)
    print(2, '\n')
    syscalls.exit(1)
    intrinsics.Intrinsics.trap(0)
}

bind(RtOp.throw, { host: intrinsics.Intrinsics.panic })
