/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { allocate } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Uint32Array {
    declare length: number
    declare data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.data = allocate(source * 4)
            for (let i = 0; i < source; i++) Intrinsics.store(this.data, i * 4, 0, Types.u32)
        } else {
            const length = source.length
            this.length = length
            this.data = allocate(length * 4)
            for (let i = 0; i < length; i++) Intrinsics.store(this.data, i * 4, source[i], Types.u32)
        }
    }

    slice(start?: number, end?: number): Uint32Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Uint32Array(to > from ? to - from : 0)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.store(out.data, i * 4, Intrinsics.load(this.data, (from + i) * 4, Types.u32), Types.u32)
        }
        return out
    }

    sort(): this {
        quicksort(this.data, 0, this.length)
        return this
    }
}

function at(data: number, i: number): number {
    return Intrinsics.load(data, i * 4, Types.u32)
}

function put(data: number, i: number, v: number): void {
    Intrinsics.store(data, i * 4, v, Types.u32)
}

function median(a: number, b: number, c: number): number {
    if (a < b) {
        if (b < c) return b
        return a < c ? c : a
    }
    if (a < c) return a
    return b < c ? c : b
}

function insertionSort(data: number, lo: number, hi: number): void {
    for (let i = lo + 1; i < hi; i++) {
        const v = at(data, i)
        let j = i
        while (j > lo && at(data, j - 1) > v) {
            put(data, j, at(data, j - 1))
            j--
        }
        put(data, j, v)
    }
}

function quicksort(data: number, lo: number, hi: number): void {
    while (hi - lo > 16) {
        const pivot = median(at(data, lo), at(data, lo + ((hi - lo) >>> 1)), at(data, hi - 1))
        let lt = lo
        let i = lo
        let gt = hi
        while (i < gt) {
            const v = at(data, i)
            if (v < pivot) {
                put(data, i, at(data, lt))
                put(data, lt, v)
                lt++
                i++
            } else if (v > pivot) {
                gt--
                put(data, i, at(data, gt))
                put(data, gt, v)
            } else {
                i++
            }
        }
        if (lt - lo < hi - gt) {
            quicksort(data, lo, lt)
            lo = gt
        } else {
            quicksort(data, gt, hi)
            hi = lt
        }
    }
    insertionSort(data, lo, hi)
}

function getIndex(this: Uint32Array, index: number): any {
    if (index >= this.length) return undefined
    return Intrinsics.load(this.data, index * 4, Types.u32)
}

function setIndex(this: Uint32Array, index: number, value: any): void {
    if (index >= this.length) return
    Intrinsics.store(this.data, index * 4, value, Types.u32)
}

Object.setPrototypeOf(Uint32Array.prototype, intrinsics.setIndexDescriptor({}, getIndex, setIndex))

defineGlobal(Uint32Array)

export class Int32Array {
    declare length: number
    declare data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.data = allocate(source * 4)
            for (let i = 0; i < source; i++) Intrinsics.store(this.data, i * 4, 0, Types.i32)
        } else {
            const length = source.length
            this.length = length
            this.data = allocate(length * 4)
            for (let i = 0; i < length; i++) Intrinsics.store(this.data, i * 4, source[i], Types.i32)
        }
    }

    slice(start?: number, end?: number): Int32Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Int32Array(to > from ? to - from : 0)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.store(out.data, i * 4, Intrinsics.load(this.data, (from + i) * 4, Types.i32), Types.i32)
        }
        return out
    }

    fill(value: number): this {
        for (let i = 0; i < this.length; i++) Intrinsics.store(this.data, i * 4, value, Types.i32)
        return this
    }
}

function getInt(this: Int32Array, index: number): any {
    if (index >= this.length) return undefined
    return Intrinsics.load(this.data, index * 4, Types.i32)
}

function setInt(this: Int32Array, index: number, value: any): void {
    if (index >= this.length) return
    Intrinsics.store(this.data, index * 4, value, Types.i32)
}

Object.setPrototypeOf(Int32Array.prototype, intrinsics.setIndexDescriptor({}, getInt, setInt))

defineGlobal(Int32Array)

export class Float64Array {
    declare length: number
    declare data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.data = allocate(source * 8)
            for (let i = 0; i < source; i++) Intrinsics.store(this.data, i * 8, 0, Types.f64)
        } else {
            const length = source.length
            this.length = length
            this.data = allocate(length * 8)
            for (let i = 0; i < length; i++) Intrinsics.store(this.data, i * 8, source[i], Types.f64)
        }
    }
}

function getFloat(this: Float64Array, index: number): any {
    if (index >= this.length) return undefined
    return Intrinsics.load(this.data, index * 8, Types.f64)
}

function setFloat(this: Float64Array, index: number, value: any): void {
    if (index >= this.length) return
    Intrinsics.store(this.data, index * 8, value, Types.f64)
}

Object.setPrototypeOf(Float64Array.prototype, intrinsics.setIndexDescriptor({}, getFloat, setFloat))

defineGlobal(Float64Array)
