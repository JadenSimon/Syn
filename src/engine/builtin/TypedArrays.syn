/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { allocate } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

let bufferData: (buffer: ArrayBuffer) => number
let viewedBuffer: (data: number, byteLength: number) => ArrayBuffer

export class Uint8Array {
    declare length: number
    #data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.#data = allocate(source)
            for (let i = 0; i < source; i++) Intrinsics.store(this.#data, i, 0, Types.u8)
        } else {
            const length = source.length
            this.length = length
            this.#data = allocate(length)
            for (let i = 0; i < length; i++) Intrinsics.store(this.#data, i, source[i], Types.u8)
        }
    }

    slice(start?: number, end?: number): Uint8Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Uint8Array(0)
        out.length = to > from ? to - from : 0
        out.#data = allocate(out.length)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.store(out.#data, i, Intrinsics.load(this.#data, from + i, Types.u8), Types.u8)
        }
        return out
    }

    subarray(start?: number, end?: number): Uint8Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Uint8Array(0)
        out.#data = this.#data + from
        out.length = to > from ? to - from : 0
        return out
    }

    set(source: ArrayLike<number>, offset?: number): void {
        const at = offset === undefined ? 0 : offset
        const length = source.length
        if (at + length > this.length) throw 'offset is out of bounds'
        for (let i = 0; i < length; i++) Intrinsics.store(this.#data, (at + i), source[i], Types.u8)
    }

    static {
        function getByte(this: Uint8Array, index: number): any {
            if (index >= this.length) return undefined
            return Intrinsics.load(this.#data, index, Types.u8)
        }

        function setByte(this: Uint8Array, index: number, value: any): void {
            if (index >= this.length) return
            Intrinsics.store(this.#data, index, value, Types.u8)
        }

        Object.setPrototypeOf(Uint8Array.prototype, intrinsics.setIndexDescriptor({}, getByte, setByte))
    }
}

defineGlobal(Uint8Array)

export class Uint32Array {
    declare length: number
    #data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.#data = allocate(source * 4)
            for (let i = 0; i < source; i++) Intrinsics.store(this.#data, i * 4, 0, Types.u32)
        } else {
            const length = source.length
            this.length = length
            this.#data = allocate(length * 4)
            for (let i = 0; i < length; i++) Intrinsics.store(this.#data, i * 4, source[i], Types.u32)
        }
    }

    slice(start?: number, end?: number): Uint32Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Uint32Array(0)
        out.length = to > from ? to - from : 0
        out.#data = allocate(out.length * 4)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.store(out.#data, i * 4, Intrinsics.load(this.#data, (from + i) * 4, Types.u32), Types.u32)
        }
        return out
    }

    subarray(start?: number, end?: number): Uint32Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Uint32Array(0)
        out.#data = this.#data + from * 4
        out.length = to > from ? to - from : 0
        return out
    }

    set(source: ArrayLike<number>, offset?: number): void {
        const at = offset === undefined ? 0 : offset
        const length = source.length
        if (at + length > this.length) throw 'offset is out of bounds'
        for (let i = 0; i < length; i++) Intrinsics.store(this.#data, (at + i) * 4, source[i], Types.u32)
    }

    sort(): this {
        quicksort(this.#data, 0, this.length)
        return this
    }

    static {
        function getIndex(this: Uint32Array, index: number): any {
            if (index >= this.length) return undefined
            return Intrinsics.load(this.#data, index * 4, Types.u32)
        }

        function setIndex(this: Uint32Array, index: number, value: any): void {
            if (index >= this.length) return
            Intrinsics.store(this.#data, index * 4, value, Types.u32)
        }

        Object.setPrototypeOf(Uint32Array.prototype, intrinsics.setIndexDescriptor({}, getIndex, setIndex))
    }
}

function at(data: number, i: number): number {
    return Intrinsics.load(data, i * 4, Types.u32)
}

function put(data: number, i: number, v: number): void {
    Intrinsics.store(data, i * 4, v, Types.u32)
}

function median(a: number, b: number, c: number): number {
    if (a < b) {
        if (b < c) return b
        return a < c ? c : a
    }
    if (a < c) return a
    return b < c ? c : b
}

function insertionSort(data: number, lo: number, hi: number): void {
    for (let i = lo + 1; i < hi; i++) {
        const v = at(data, i)
        let j = i
        while (j > lo && at(data, j - 1) > v) {
            put(data, j, at(data, j - 1))
            j--
        }
        put(data, j, v)
    }
}

function quicksort(data: number, lo: number, hi: number): void {
    while (hi - lo > 16) {
        const pivot = median(at(data, lo), at(data, lo + ((hi - lo) >>> 1)), at(data, hi - 1))
        let lt = lo
        let i = lo
        let gt = hi
        while (i < gt) {
            const v = at(data, i)
            if (v < pivot) {
                put(data, i, at(data, lt))
                put(data, lt, v)
                lt++
                i++
            } else if (v > pivot) {
                gt--
                put(data, i, at(data, gt))
                put(data, gt, v)
            } else {
                i++
            }
        }
        if (lt - lo < hi - gt) {
            quicksort(data, lo, lt)
            lo = gt
        } else {
            quicksort(data, gt, hi)
            hi = lt
        }
    }
    insertionSort(data, lo, hi)
}

defineGlobal(Uint32Array)

export class Int32Array {
    declare length: number
    #data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.#data = allocate(source * 4)
            for (let i = 0; i < source; i++) Intrinsics.store(this.#data, i * 4, 0, Types.i32)
        } else {
            const length = source.length
            this.length = length
            this.#data = allocate(length * 4)
            for (let i = 0; i < length; i++) Intrinsics.store(this.#data, i * 4, source[i], Types.i32)
        }
    }

    slice(start?: number, end?: number): Int32Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Int32Array(0)
        out.length = to > from ? to - from : 0
        out.#data = allocate(out.length * 4)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.store(out.#data, i * 4, Intrinsics.load(this.#data, (from + i) * 4, Types.i32), Types.i32)
        }
        return out
    }

    subarray(start?: number, end?: number): Int32Array {
        const length = this.length
        let from = start === undefined ? 0 : start < 0 ? length + start : start
        let to = end === undefined ? length : end < 0 ? length + end : end
        if (from < 0) from = 0
        if (to > length) to = length
        const out = new Int32Array(0)
        out.#data = this.#data + from * 4
        out.length = to > from ? to - from : 0
        return out
    }

    set(source: ArrayLike<number>, offset?: number): void {
        const at = offset === undefined ? 0 : offset
        const length = source.length
        if (at + length > this.length) throw 'offset is out of bounds'
        for (let i = 0; i < length; i++) Intrinsics.store(this.#data, (at + i) * 4, source[i], Types.i32)
    }

    fill(value: number): this {
        for (let i = 0; i < this.length; i++) Intrinsics.store(this.#data, i * 4, value, Types.i32)
        return this
    }

    static {
        function getInt(this: Int32Array, index: number): any {
            if (index >= this.length) return undefined
            return Intrinsics.load(this.#data, index * 4, Types.i32)
        }

        function setInt(this: Int32Array, index: number, value: any): void {
            if (index >= this.length) return
            Intrinsics.store(this.#data, index * 4, value, Types.i32)
        }

        Object.setPrototypeOf(Int32Array.prototype, intrinsics.setIndexDescriptor({}, getInt, setInt))
    }
}

defineGlobal(Int32Array)

export class Uint16Array {
    declare length: number
    #data: number

    constructor(source: number | ArrayLike<number>) {
        if (typeof source === 'number') {
            this.length = source
            this.#data = allocate(source * 2)
            for (let i = 0; i < source; i++) Intrinsics.store(this.#data, i * 2, 0, Types.u16)
        } else {
            const length = source.length
            this.length = length
            this.#data = allocate(length * 2)
            for (let i = 0; i < length; i++) Intrinsics.store(this.#data, i * 2, source[i], Types.u16)
        }
    }

    static {
        function getHalf(this: Uint16Array, index: number): any {
            if (index >= this.length) return undefined
            return Intrinsics.load(this.#data, index * 2, Types.u16)
        }

        function setHalf(this: Uint16Array, index: number, value: any): void {
            if (index >= this.length) return
            Intrinsics.store(this.#data, index * 2, value, Types.u16)
        }

        Object.setPrototypeOf(Uint16Array.prototype, intrinsics.setIndexDescriptor({}, getHalf, setHalf))
    }
}

defineGlobal(Uint16Array)

export class Float64Array {
    declare length: number
    #data: number
    #viewed: ArrayBuffer | undefined

    constructor(source: number | ArrayLike<number>) {
        this.#viewed = undefined
        if (typeof source === 'number') {
            this.length = source
            this.#data = allocate(source * 8)
            for (let i = 0; i < source; i++) Intrinsics.store(this.#data, i * 8, 0, Types.f64)
        } else {
            const length = source.length
            this.length = length
            this.#data = allocate(length * 8)
            for (let i = 0; i < length; i++) Intrinsics.store(this.#data, i * 8, source[i], Types.f64)
        }
    }

    get buffer(): ArrayBuffer {
        if (this.#viewed === undefined) this.#viewed = viewedBuffer(this.#data, this.length * 8)
        return this.#viewed
    }

    static {
        function getFloat(this: Float64Array, index: number): any {
            if (index >= this.length) return undefined
            return Intrinsics.load(this.#data, index * 8, Types.f64)
        }

        function setFloat(this: Float64Array, index: number, value: any): void {
            if (index >= this.length) return
            Intrinsics.store(this.#data, index * 8, value, Types.f64)
        }

        Object.setPrototypeOf(Float64Array.prototype, intrinsics.setIndexDescriptor({}, getFloat, setFloat))
    }
}

defineGlobal(Float64Array)

export class ArrayBuffer {
    declare byteLength: number
    #data: number

    constructor(length: number) {
        this.byteLength = length
        this.#data = allocate(length)
        for (let i = 0; i < length; i++) Intrinsics.store(this.#data, i, 0, Types.u8)
    }

    static {
        bufferData = buffer => buffer.#data
        viewedBuffer = (data, byteLength) => {
            const buffer = new ArrayBuffer(0)
            buffer.byteLength = byteLength
            buffer.#data = data
            return buffer
        }
    }
}

defineGlobal(ArrayBuffer)

export class BigUint64Array {
    declare length: number
    #data: number

    constructor(source: number | ArrayBuffer | ArrayLike<any>, byteOffset?: number, length?: number) {
        if (typeof source === 'number') {
            this.length = source
            this.#data = allocate(source * 8)
            for (let i = 0; i < source; i++) Intrinsics.store(this.#data, i * 8, 0, Types.u64)
        } else if (source instanceof ArrayBuffer) {
            const offset = byteOffset === undefined ? 0 : byteOffset
            if (offset % 8 !== 0) throw 'start offset of BigUint64Array should be a multiple of 8'
            if (length === undefined && (source.byteLength - offset) % 8 !== 0) throw 'byte length of BigUint64Array should be a multiple of 8'
            const count = length === undefined ? (source.byteLength - offset) / 8 : length
            if (offset + count * 8 > source.byteLength) throw 'invalid typed array length'
            this.length = count
            this.#data = bufferData(source) + offset
        } else {
            const count = source.length
            this.length = count
            this.#data = allocate(count * 8)
            for (let i = 0; i < count; i++) Intrinsics.store(this.#data, i * 8, source[i], Types.u64)
        }
    }

    static {
        function getWide(this: BigUint64Array, index: number): any {
            if (index >= this.length) return undefined
            return Intrinsics.load(this.#data, index * 8, Types.u64)
        }

        function setWide(this: BigUint64Array, index: number, value: any): void {
            if (index >= this.length) return
            Intrinsics.store(this.#data, index * 8, value, Types.u64)
        }

        Object.setPrototypeOf(BigUint64Array.prototype, intrinsics.setIndexDescriptor({}, getWide, setWide))
    }
}

defineGlobal(BigUint64Array)

export class DataView {
    declare buffer: ArrayBuffer
    declare byteOffset: number
    declare byteLength: number

    constructor(buffer: ArrayBuffer, byteOffset?: number, byteLength?: number) {
        const offset = byteOffset === undefined ? 0 : byteOffset
        if (offset > buffer.byteLength) throw 'start offset is outside the bounds of the buffer'
        const length = byteLength === undefined ? buffer.byteLength - offset : byteLength
        if (offset + length > buffer.byteLength) throw 'invalid DataView length'
        this.buffer = buffer
        this.byteOffset = offset
        this.byteLength = length
    }

    getUint8(at: number): number {
        return Intrinsics.load(viewAddress(this, at, 1), 0, Types.u8)
    }

    setUint8(at: number, value: number): void {
        Intrinsics.store(viewAddress(this, at, 1), 0, value, Types.u8)
    }

    getUint32(at: number, littleEndian?: boolean): number {
        const address = viewAddress(this, at, 4)
        if (littleEndian) return Intrinsics.load(address, 0, Types.u32)
        let value = 0
        for (let i = 0; i < 4; i++) value = value * 256 + Intrinsics.load(address, i, Types.u8)
        return value
    }

    setUint32(at: number, value: number, littleEndian?: boolean): void {
        const address = viewAddress(this, at, 4)
        Intrinsics.store(address, 0, value, Types.u32)
        if (!littleEndian) reverseBytes(address, 4)
    }

    getFloat64(at: number, littleEndian?: boolean): number {
        const address = viewAddress(this, at, 8)
        if (littleEndian) return Intrinsics.load(address, 0, Types.f64)
        reverseBytes(address, 8)
        const value = Intrinsics.load(address, 0, Types.f64)
        reverseBytes(address, 8)
        return value
    }

    setFloat64(at: number, value: number, littleEndian?: boolean): void {
        const address = viewAddress(this, at, 8)
        Intrinsics.store(address, 0, value, Types.f64)
        if (!littleEndian) reverseBytes(address, 8)
    }
}

function viewAddress(view: DataView, at: number, size: number): number {
    if (at + size > view.byteLength) throw 'offset is outside the bounds of the DataView'
    return bufferData(view.buffer) + view.byteOffset + at
}

function reverseBytes(address: number, size: number): void {
    for (let i = 0; i < size / 2; i++) {
        const low = Intrinsics.load(address, i, Types.u8)
        Intrinsics.store(address, i, Intrinsics.load(address, size - 1 - i, Types.u8), Types.u8)
        Intrinsics.store(address, size - 1 - i, low, Types.u8)
    }
}

defineGlobal(DataView)

export async function suite() {
    const harness = await import('../harness')
    function u32Subarray(n: u32, k: u32): number {
        const a = new Uint32Array([n, n + 1, n + 2, n + 3])
        const b = a.subarray(1, k)
        const c = a.subarray(k - 6)
        if (b.length) b[0] = 9
        return b.length * 10000 + c.length * 1000 + (c.length ? c[0] : 0) * 100 + a[1] * 10 + a.subarray().length
    }
    function u32Set(n: u32, k: u32): number {
        const a = new Uint32Array(5)
        a.set([n, n + 1], k)
        a.set(new Uint32Array([7]))
        return a[0] * 10000 + a[1] * 1000 + a[2] * 100 + a[3] * 10 + a[4]
    }
    function u8SubarraySet(n: u32): number {
        const a = new Uint8Array([1, 2, 3, 4, 5])
        const b = a.subarray(2)
        b.set([n, n + 1])
        return a[2] * 100 + a[3] * 10 + b.length
    }
    function i32SubarraySet(n: u32): number {
        const a = new Int32Array(4)
        a.set([n, n * 2, n * 3], 1)
        const b = a.subarray(-2)
        return b[0] * 100 + b[1] * 10 + b.length
    }
    function u16Wrap(n: u32): number {
        const a = new Uint16Array(n + 2)
        a[0] = n
        a[1] = n + 65536
        const b = new Uint16Array([n, 70000])
        return a[0] * 100000 + a[1] * 1000 + a.length * 100 + b[1] + (a[n + 2] === undefined ? 1 : 0)
    }
    function dataViewFields(n: u32): number {
        const view = new DataView(new ArrayBuffer(16))
        view.setUint8(0, n + 3)
        view.setUint32(4, n + 0x01020304, true)
        view.setFloat64(8, n + 0.25, true)
        return view.getUint8(0) * 100000 + view.getUint32(4, true) % 1000 * 100 + view.getFloat64(8, true) * 4
    }
    function dataViewBigEndian(n: u32): number {
        const view = new DataView(new ArrayBuffer(16))
        view.setUint32(0, n + 0x01020304)
        view.setFloat64(8, n + 0.25)
        return view.getUint8(0) * 100000 + view.getUint8(3) * 1000 + view.getUint32(0) % 7 + view.getFloat64(8) * 4
    }
    function wideWords(n: u32): number {
        const words = new BigUint64Array([BigInt(n), BigInt(n) << BigInt(40)])
        const zeros = new BigUint64Array(2)
        words[0] = words[0] + BigInt(3)
        let parts = 0
        for (let i = 0; i < 4; i++) if ((words[1] >> BigInt(i * 16)) & BigInt(0xFFFF)) parts++
        return parts * 1000 + Number(words[0]) * 10 + Number(zeros[1]) + (words[2] === undefined ? 100 : 0)
    }
    function floatBuffer(n: u32): number {
        const floats = new Float64Array([n + 0.5, 2])
        const buffer = floats.buffer
        return buffer.byteLength * 10 + (floats.buffer === buffer ? 1 : 0)
    }
    harness.runCases({ prefix: 'TypedArrays', args: true }, [
        [wideWords, [0], [5]],
        [floatBuffer, [0], [5]],
        [dataViewFields, [0], [5]],
        // XXX: need to fix mised access width on 1 pstack
        // [dataViewBigEndian, [0], [5]]
        [u32Subarray, [3, 3], [3, 1], [3, 9], [3, 4]],
        [u32Set, [2, 0], [2, 3]],
        [u8SubarraySet, [6]],
        [i32SubarraySet, [2]],
        [u16Wrap, [0], [5]],
    ])
}
