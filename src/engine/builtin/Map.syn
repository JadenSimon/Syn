/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { buildTable, findEntry, writeTable, hashKey, programStackTop } from './memory'
import { readElement, writeElement } from './Array'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const maxSize = 2**24

export class Map {
    #keyList: any[]
    #valueList: any[]
    get #size(): number {
        return this.#keyList.length
    }
    get size(): number {
        return this.#size
    }
    #table: u32
    #mask: u32

    constructor() {
        this.#keyList = []
        this.#valueList = []
        this.#table = 0
        this.#mask = 0
    }

    #rehash(capacity: u32): void {
        this.#table = buildTable(this.#keyList, this.#size, capacity)
        this.#mask = capacity - 1
    }

    has(key: any): boolean {
        return findEntry(this.#keyList, this.#table, this.#mask, key) >= 0
    }

    get(key: any): any {
        const index = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (index < 0) return undefined
        return readElement(this.#valueList, index)
    }

    set(key: any, value: any): this {
        const found = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (found >= 0) {
            writeElement(this.#valueList, found, value)
            return this
        }
        const index = this.#size
        this.#keyList.push(key)
        this.#valueList.push(value)
        // TODO: ES engines throw RangeError here
        if (this.#size >= maxSize) throw 'Map maximum size exceeded'
        if (this.#size * 2 > this.#mask) this.#rehash(this.#mask ? (this.#mask + 1) * 2 : 8)
        else Intrinsics.store(this.#table, (-found - 1) * 4, index + 1, Types.u32)
        return this
    }

    delete(key: any): boolean {
        const index = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (index < 0) return false
        for (let i = index + 1; i < this.#size; i++) {
            writeElement(this.#keyList, i - 1, readElement(this.#keyList, i))
            writeElement(this.#valueList, i - 1, readElement(this.#valueList, i))
        }
        const size = this.#size - 1
        this.#keyList.length = size
        this.#valueList.length = size
        writeTable(this.#keyList, size, this.#mask + 1, this.#table)
        return true
    }

    clear(): void {
        this.#keyList.length = 0
        this.#valueList.length = 0
        this.#table = 0
        this.#mask = 0
    }

    forEach(fn: (value: any, key: any, map: Map) => void): void {
        for (let i = 0; i < this.#size; i++) fn(readElement(this.#valueList, i), readElement(this.#keyList, i), this)
    }

    keys() {
        return this.#keyList[Symbol.iterator]()
    }

    values() {
        return this.#valueList[Symbol.iterator]()
    }

    entries() {
        return {
            map: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.map.#size) return { done: true }
                this.index = index + 1
                return { done: false, value: [readElement(this.map.#keyList, index), readElement(this.map.#valueList, index)] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }

    [Symbol.iterator]() {
        return this.entries()
    }
}

defineGlobal(Map)

export async function suite() {
    const harness = await import('../harness')
    function mapIterate(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < n; i++) m.set(i * 2, i + 1)
        let total = 0
        m.forEach((value, key) => {
            total = total + value * 10 + key
        })
        for (const key of m.keys()) total = total + key * 100
        for (const value of m.values()) total = total + value * 1000
        return total
    }
    function mapFromEntries(n: u32): number {
        const m = new Map([[n, 1], [n + 1, 2], [n, 3]])
        return m.size * 100 + m.get(n)! * 10 + m.get(n + 1)!
    }
    function mapFromMap(n: u32): number {
        const a = new Map<number, number>()
        for (let i = 0; i < n; i++) a.set(i, i * 3)
        const b = new Map(a)
        b.set(n, 7)
        return a.size * 1000 + b.size * 100 + (n ? b.get(n - 1)! : 0) * 10 + b.get(n)!
    }
    function mapProbeMutation(n: u32): number {
        const m = new Map<number, number | undefined>()
        for (let i = 0; i < 48; i++) m.set(i * 17, i % 5 ? i + n : undefined)
        for (let i = 1; i < 48; i += 3) m.set(i * 17, i + n + 100)
        for (let i = 0; i < 48; i += 2) m.delete(i * 17)
        let total = m.size
        for (let i = 0; i < 50; i++) {
            const key = i * 17
            total += m.has(key) ? 1 : 1000
            total += m.get(key) ?? 7
        }
        m.clear()
        m.set(n, undefined)
        m.set(n + 1, 9)
        return total + m.size * 10 + (m.has(n) ? 100 : 0) + (m.get(n) ?? 3) + m.get(n + 1)!
    }
    function mapPointerValues(n: u32): number {
        const m = new Map<number, { value: number }>()
        for (let i = 0; i < 16; i++) m.set(i, { value: i + n })
        const replacement = { value: n + 40 }
        m.set(7, replacement)
        m.delete(3)
        return m.get(7)!.value + m.get(15)!.value + (m.get(7) === replacement ? 100 : 0)
    }
    function mapEntriesKinds(n: u32): number {
        const m = new Map<string, { value: number } | undefined>()
        m.set('first', { value: n })
        m.set('missing', undefined)
        m.set('last', { value: n + 1 })
        let total = 0
        for (const [key, value] of m) total += key.length * 10 + (value ? value.value : 7)
        return total
    }
    function mapEntriesGrow(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        m.set(2, n + 1)
        let total = 0
        for (const [key, value] of m) {
            total += key * 10 + value
            if (key === 2) for (let i = 3; i < 12; i++) m.set(i, n + i)
        }
        return total
    }
    function nextCollision(key: u32): u32 {
        while ((hashKey(key) & 7) !== 7) key++
        return key
    }
    function mapSetProbeWrap(n: u32): number {
        const a = nextCollision(n)
        const b = nextCollision(a + 1)
        const c = nextCollision(b + 1)
        const d = nextCollision(c + 1)
        const map = new Map<number, number>()
        const set = new Set<number>()
        map.set(a, n)
        set.add(a)
        map.set(b, n + 1)
        set.add(b)
        map.set(c, n + 2)
        set.add(c)
        map.set(b, n + 10)
        set.add(b)
        let total = map.has(d) || set.has(d) ? 100000 : 0
        map.delete(a)
        set.delete(a)
        map.set(d, n + 20)
        set.add(d)
        if (map.has(a) || set.has(a)) total += 10000
        return total + map.size * 1000 + set.size * 100 + map.get(b)! + map.get(c)! + map.get(d)!
    }
    function mapSetDeleteReuse(n: u32): number {
        const map = new Map<number, number>()
        const set = new Set<number>()
        for (let i = 0; i < 32; i++) {
            map.set(i * 17, i + n)
            set.add(i * 17)
        }
        const before = programStackTop()
        if (!map.delete(17 * 11) || !set.delete(17 * 11)) return -1
        if (map.has(17 * 11) || set.has(17 * 11)) return -2
        const allocated = programStackTop() - before
        map.clear()
        set.clear()
        map.set(n, 7)
        set.add(n)
        if (map.size !== 1 || map.get(n) !== 7 || set.size !== 1 || !set.has(n)) return -3
        if (map.has(17 * 5) || set.has(17 * 5)) return -4
        return allocated
    }
    harness.runCases({ prefix: 'Map', args: true }, [
        [mapIterate, [0], [3]],
        [mapProbeMutation, [0], [7]],
        [mapPointerValues, [0], [7]],
        [mapEntriesKinds, [0], [7]],
        [mapEntriesGrow, [0], [7]],
        [mapSetProbeWrap, [0], [7]],
        [mapSetDeleteReuse, [0], [7]],
        // [mapFromEntries, [0], [4]],
        // [mapFromMap, [0], [3]],
    ])
}
