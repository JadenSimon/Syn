/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { buildTable, hashKey } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Map {
    declare keyList: any[]
    declare valueList: any[]
    declare size: number
    declare table: u32
    declare mask: u32

    constructor() {
        this.keyList = []
        this.valueList = []
        this.size = 0
        this.table = 0
        this.mask = 0
    }

    indexOf(key: any): number {
        if (!this.table) return this.size
        let slot: u32 = hashKey(key) & this.mask
        let entry = Intrinsics.load(this.table, slot * 4, Types.u32)
        while (entry) {
            if (this.keyList[entry - 1] === key) return entry - 1
            slot = (slot + 1) & this.mask
            entry = Intrinsics.load(this.table, slot * 4, Types.u32)
        }
        return this.size
    }

    place(index: u32): void {
        let slot: u32 = hashKey(this.keyList[index]) & this.mask
        while (Intrinsics.load(this.table, slot * 4, Types.u32)) slot = (slot + 1) & this.mask
        Intrinsics.store(this.table, slot * 4, index + 1, Types.u32)
    }

    rehash(capacity: u32): void {
        this.table = buildTable(this.keyList, this.size, capacity)
        this.mask = capacity - 1
    }

    has(key: any): boolean {
        return this.indexOf(key) < this.size
    }

    get(key: any): any {
        const index = this.indexOf(key)
        if (index >= this.size) return undefined
        return this.valueList[index]
    }

    set(key: any, value: any): this {
        const index = this.indexOf(key)
        if (index < this.size) {
            this.valueList[index] = value
            return this
        }
        this.keyList.push(key)
        this.valueList.push(value)
        this.size = this.size + 1
        if (this.size * 2 > this.mask) this.rehash(this.mask ? (this.mask + 1) * 2 : 8)
        else this.place(index)
        return this
    }

    delete(key: any): boolean {
        const index = this.indexOf(key)
        if (index >= this.size) return false
        for (let i = index + 1; i < this.size; i++) {
            this.keyList[i - 1] = this.keyList[i]
            this.valueList[i - 1] = this.valueList[i]
        }
        this.size = this.size - 1
        this.keyList.length = this.size
        this.valueList.length = this.size
        this.rehash(this.mask + 1)
        return true
    }

    clear(): void {
        this.size = 0
        this.keyList.length = 0
        this.valueList.length = 0
        if (this.table) this.rehash(this.mask + 1)
    }

    forEach(fn: (value: any, key: any, map: Map) => void): void {
        for (let i = 0; i < this.size; i++) fn(this.valueList[i], this.keyList[i], this)
    }

    keys() {
        return this.keyList[Symbol.iterator]()
    }

    values() {
        return this.valueList[Symbol.iterator]()
    }

    entries() {
        return {
            map: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.map.size) return { done: true }
                this.index = index + 1
                return { done: false, value: [this.map.keyList[index], this.map.valueList[index]] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }

    [Symbol.iterator]() {
        return this.entries()
    }
}

defineGlobal(Map)
