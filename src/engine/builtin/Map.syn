/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { buildTable, findEntry, removeEntry, tableCapacity, liveIndex, clearHoles, markHole, closeHoles, linkHoles, nextHoles, remapIndex, isHole, hashKey, stackTops } from './memory'
import { readElement, writeElement, reserveElements } from './Array'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const maxSize = 2**24
const exhausted = 2**32

let iteratorNext: (iterator: MapIterator) => any
let seek: (map: Map, cursor: MapIterator) => number

export class Map {
    #keyList: any[]
    #valueList: any[]
    #table: u32
    #mask: u32
    #removed: number
    #vacancies: u32
    #retired: u32
    #oldestRetired: u32
    get size(): number {
        return this.#keyList.length - this.#removed
    }

    constructor(entries?: Iterable<readonly [any, any]>) {
        this.#keyList = []
        this.#valueList = []
        this.#table = 0
        this.#mask = 0
        this.#removed = 0
        this.#vacancies = 0
        this.#retired = 0
        this.#oldestRetired = 0
        if (entries === undefined) return
        if (entries instanceof Map) {
            const length = entries.#keyList.length
            const count = length - entries.#removed
            if (!count) return
            const holes = entries.#removed ? entries.#vacancies : 0
            reserveElements(this.#keyList, count)
            reserveElements(this.#valueList, count)
            for (let i = 0; i < length; i++) {
                if (holes && isHole(holes, i)) continue
                this.#keyList.push(readElement(entries.#keyList, i))
                this.#valueList.push(readElement(entries.#valueList, i))
            }
            this.#rebuild()
            return
        }
        if (entries instanceof Array && entries.length) {
            const count = entries.length < maxSize ? entries.length : maxSize
            const capacity = tableCapacity(count)
            reserveElements(this.#keyList, count)
            reserveElements(this.#valueList, count)
            this.#table = buildTable(this.#keyList, 0, capacity)
            this.#mask = capacity - 1
        }
        for (const entry of entries) this.set(entry[0], entry[1])
    }

    #rebuild(): void {
        const length = this.#keyList.length
        let count = length
        if (this.#removed) {
            const holes = closeHoles(this.#table, this.#mask, length, false)
            if (this.#retired) linkHoles(this.#retired, holes)
            else this.#oldestRetired = holes
            this.#retired = holes
            count = 0
            for (let i = 0; i < length; i++) {
                if (isHole(this.#vacancies, i)) continue
                writeElement(this.#keyList, count, readElement(this.#keyList, i))
                writeElement(this.#valueList, count, readElement(this.#valueList, i))
                count++
            }
            this.#keyList.length = count
            this.#valueList.length = count
            this.#removed = 0
            this.#vacancies = 0
        }
        const capacity = tableCapacity(count)
        this.#table = buildTable(this.#keyList, count, capacity)
        this.#mask = capacity - 1
    }

    has(key: any): boolean {
        return findEntry(this.#keyList, this.#table, this.#mask, key) >= 0
    }

    get(key: any): any {
        const index = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (index < 0) return undefined
        return readElement(this.#valueList, index)
    }

    set(key: any, value: any): this {
        const found = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (found >= 0) {
            writeElement(this.#valueList, found, value)
            return this
        }
        const index = this.#keyList.length
        this.#keyList.push(key)
        this.#valueList.push(value)
        // TODO: ES engines throw RangeError here
        if (this.#keyList.length >= maxSize) throw 'Map maximum size exceeded'
        if (this.#keyList.length * 2 > this.#mask) this.#rebuild()
        else Intrinsics.store(this.#table, (-found - 1) * 4, index + 1, Types.u32)
        return this
    }

    getOrInsert(key: any, value: any): any {
        const found = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (found >= 0) return readElement(this.#valueList, found)
        const index = this.#keyList.length
        this.#keyList.push(key)
        this.#valueList.push(value)
        // TODO: ES engines throw RangeError here
        if (this.#keyList.length >= maxSize) throw 'Map maximum size exceeded'
        if (this.#keyList.length * 2 > this.#mask) this.#rebuild()
        else Intrinsics.store(this.#table, (-found - 1) * 4, index + 1, Types.u32)
        return value
    }

    getOrInsertComputed(key: any, callbackfn: (key: any) => any): any {
        if (typeof callbackfn !== 'function') throw 'Map.prototype.getOrInsertComputed: callbackfn is not callable'
        let found = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (found >= 0) return readElement(this.#valueList, found)
        const table = this.#table
        const length = this.#keyList.length
        const removed = this.#removed
        const value = callbackfn(key)
        if (this.#table !== table || this.#keyList.length !== length || this.#removed !== removed) found = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (found >= 0) {
            writeElement(this.#valueList, found, value)
            return value
        }
        const index = this.#keyList.length
        this.#keyList.push(key)
        this.#valueList.push(value)
        // TODO: ES engines throw RangeError here
        if (this.#keyList.length >= maxSize) throw 'Map maximum size exceeded'
        if (this.#keyList.length * 2 > this.#mask) this.#rebuild()
        else Intrinsics.store(this.#table, (-found - 1) * 4, index + 1, Types.u32)
        return value
    }

    delete(key: any): boolean {
        const index = findEntry(this.#keyList, this.#table, this.#mask, key)
        if (index < 0) return false
        removeEntry(this.#keyList, this.#table, this.#mask, index)
        if (!this.#vacancies) this.#vacancies = clearHoles(this.#table, this.#mask)
        markHole(this.#vacancies, index)
        this.#removed++
        if (this.#removed > 8 && this.#removed * 2 > this.#keyList.length) this.#rebuild()
        return true
    }

    clear(): void {
        const length = this.#keyList.length
        if (length) {
            const holes = closeHoles(this.#table, this.#mask, length, true)
            if (this.#retired) linkHoles(this.#retired, holes)
            else this.#oldestRetired = holes
            this.#retired = holes
        }
        this.#keyList.length = 0
        this.#valueList.length = 0
        this.#table = 0
        this.#mask = 0
        this.#removed = 0
        this.#vacancies = 0
    }

    forEach(fn: (value: any, key: any, map: Map) => void): void {
        const cursor = new MapIterator(this, 0, this.#retired)
        let index = seek(this, cursor)
        while (index < this.#keyList.length) {
            fn(readElement(this.#valueList, index), readElement(this.#keyList, index), this)
            index = seek(this, cursor)
        }
    }

    keys() {
        return new MapIterator(this, 0, this.#retired)
    }

    values() {
        return new MapIterator(this, 1, this.#retired)
    }

    entries() {
        return new MapIterator(this, 2, this.#retired)
    }

    [Symbol.iterator]() {
        return this.entries()
    }

    static {
        seek = intrinsics.tagInline((map: Map, cursor: MapIterator): number => {
            let index = cursor.index
            if (cursor.retired !== map.#retired) {
                index = remapIndex(cursor.retired ? nextHoles(cursor.retired) : map.#oldestRetired, index)
                cursor.retired = map.#retired
            }
            if (map.#vacancies) index = liveIndex(map.#vacancies, index, map.#keyList.length)
            cursor.index = index + 1
            return index
        })
        iteratorNext = intrinsics.tagInline((iterator: MapIterator): any => {
            const map = iterator.map
            const index = seek(map, iterator)
            if (index >= map.#keyList.length) {
                iterator.index = exhausted
                return { done: true }
            }
            if (iterator.kind === 0) return { done: false, value: readElement(map.#keyList, index) }
            if (iterator.kind === 1) return { done: false, value: readElement(map.#valueList, index) }
            return { done: false, value: [readElement(map.#keyList, index), readElement(map.#valueList, index)] }
        })
    }
}

class MapIterator {
    map: Map
    kind: number
    index: number
    retired: u32

    constructor(map: Map, kind: number, retired: u32) {
        this.map = map
        this.kind = kind
        this.index = 0
        this.retired = retired
    }

    next() {
        return iteratorNext(this)
    }

    [Symbol.iterator]() {
        return this
    }
}

intrinsics.tagInline(MapIterator.prototype.next)

defineGlobal(Map)

export async function suite() {
    const harness = await import('../harness')
    function mapIterate(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < n; i++) m.set(i * 2, i + 1)
        let total = 0
        m.forEach((value, key) => {
            total = total + value * 10 + key
        })
        for (const key of m.keys()) total = total + key * 100
        for (const value of m.values()) total = total + value * 1000
        return total
    }
    function mapFromEntries(n: u32): number {
        const m = new Map([[n, 1], [n + 1, 2], [n, 3]])
        return m.size * 100 + m.get(n)! * 10 + m.get(n + 1)!
    }
    function mapFromMap(n: u32): number {
        const a = new Map<number, number>()
        for (let i = 0; i < n; i++) a.set(i, i * 3)
        const b = new Map(a)
        b.set(n, 7)
        return a.size * 1000 + b.size * 100 + (n ? b.get(n - 1)! : 0) * 10 + b.get(n)!
    }
    function mapProbeMutation(n: u32): number {
        const m = new Map<number, number | undefined>()
        for (let i = 0; i < 48; i++) m.set(i * 17, i % 5 ? i + n : undefined)
        for (let i = 1; i < 48; i += 3) m.set(i * 17, i + n + 100)
        for (let i = 0; i < 48; i += 2) m.delete(i * 17)
        let total = m.size
        for (let i = 0; i < 50; i++) {
            const key = i * 17
            total += m.has(key) ? 1 : 1000
            total += m.get(key) ?? 7
        }
        m.clear()
        m.set(n, undefined)
        m.set(n + 1, 9)
        return total + m.size * 10 + (m.has(n) ? 100 : 0) + (m.get(n) ?? 3) + m.get(n + 1)!
    }
    function mapPointerValues(n: u32): number {
        const m = new Map<number, { value: number }>()
        for (let i = 0; i < 16; i++) m.set(i, { value: i + n })
        const replacement = { value: n + 40 }
        m.set(7, replacement)
        m.delete(3)
        return m.get(7)!.value + m.get(15)!.value + (m.get(7) === replacement ? 100 : 0)
    }
    function mapEntriesKinds(n: u32): number {
        const m = new Map<string, { value: number } | undefined>()
        m.set('first', { value: n })
        m.set('missing', undefined)
        m.set('last', { value: n + 1 })
        let total = 0
        for (const [key, value] of m) total += key.length * 10 + (value ? value.value : 7)
        return total
    }
    function mapEntriesGrow(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        m.set(2, n + 1)
        let total = 0
        for (const [key, value] of m) {
            total += key * 10 + value
            if (key === 2) for (let i = 3; i < 12; i++) m.set(i, n + i)
        }
        return total
    }
    function nextCollision(key: u32): u32 {
        while ((hashKey(key) & 7) !== 7) key++
        return key
    }
    function mapSetProbeWrap(n: u32): number {
        const a = nextCollision(n)
        const b = nextCollision(a + 1)
        const c = nextCollision(b + 1)
        const d = nextCollision(c + 1)
        const map = new Map<number, number>()
        const set = new Set<number>()
        map.set(a, n)
        set.add(a)
        map.set(b, n + 1)
        set.add(b)
        map.set(c, n + 2)
        set.add(c)
        map.set(b, n + 10)
        set.add(b)
        let total = map.has(d) || set.has(d) ? 100000 : 0
        map.delete(a)
        set.delete(a)
        map.set(d, n + 20)
        set.add(d)
        if (map.has(a) || set.has(a)) total += 10000
        return total + map.size * 1000 + set.size * 100 + map.get(b)! + map.get(c)! + map.get(d)!
    }
    function mapSetDeleteReuse(n: u32): number {
        const map = new Map<number, number>()
        const set = new Set<number>()
        for (let i = 0; i < 32; i++) {
            map.set(i * 17, i + n)
            set.add(i * 17)
        }
        const before = stackTops()
        if (!map.delete(17 * 11) || !set.delete(17 * 11)) return -1
        if (map.has(17 * 11) || set.has(17 * 11)) return -2
        const allocated = stackTops() - before
        map.clear()
        set.clear()
        map.set(n, 7)
        set.add(n)
        if (map.size !== 1 || map.get(n) !== 7 || set.size !== 1 || !set.has(n)) return -3
        if (map.has(17 * 5) || set.has(17 * 5)) return -4
        return allocated
    }
    function mapDeleteDuringForOf(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 12; i++) m.set(i, i + n)
        let total = 0
        for (const [key, value] of m) {
            total = total * 3 + key + value
            if (key % 3 === 0) m.delete(key)
            if (key === 4) m.delete(7)
        }
        for (const key of m.keys()) total = total * 5 + key
        return total + m.size * 1000
    }
    function mapDeleteReadd(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 6; i++) m.set(i, i + n)
        m.delete(2)
        m.set(2, 20 + n)
        m.delete(0)
        m.set(0, 30 + n)
        let total = 0
        for (const [key, value] of m) total = total * 7 + key * 100 + value
        return total + m.size
    }
    function mapClearDuringForOf(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 6; i++) m.set(i, i + n)
        let total = 0
        for (const [key, value] of m) {
            total = total * 3 + key + value
            if (key === 2) {
                m.clear()
                m.set(10, n)
                m.set(11, n + 1)
            }
        }
        return total + m.size * 1000
    }
    function mapCompactDuringForOf(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 64; i++) m.set(i, i + n)
        let total = 0
        for (const key of m.keys()) {
            total = (total * 3 + key) % 1000003
            if (key === 40) {
                for (let i = 0; i < 40; i++) m.delete(i)
                for (let i = 100; i < 140; i++) m.set(i, i)
            }
            if (key === 120) for (let i = 41; i < 100; i++) m.delete(i)
        }
        return total + m.size * 1000000
    }
    function mapForEachDelete(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 10; i++) m.set(i, i + n)
        let total = 0
        m.forEach((value, key) => {
            total = total * 3 + key + value
            m.delete(key + 1)
            if (key === 4) m.set(20, n)
        })
        return total + m.size * 1000
    }
    function mapDoneStaysDone(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        const keys = m.keys()
        let total = keys.next().value!
        total += keys.next().done ? 10 : 0
        m.set(2, n + 1)
        total += keys.next().done ? 100 : 0
        return total
    }
    function mapSweep(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 300; i++) m.set(i * 7, i + n)
        const unseen: number[] = []
        for (const [key, value] of m) if (value % 3 !== 0) unseen.push(key)
        for (const key of unseen) m.delete(key)
        let total = 0
        for (const [key, value] of m) total = (total * 3 + key + value) % 1000003
        for (const value of m.values()) total = (total + value) % 1000003
        return total + m.size * 1000000 + [...m.keys()].length
    }
    function mapGetOrInsert(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        let total = m.getOrInsert(1, 50) + m.getOrInsert(2, n + 3) * 10
        total += m.getOrInsert(2, 99) * 100
        for (let i = 0; i < 40; i++) total += m.getOrInsert(i % 13, i)
        return total + m.size * 100000
    }
    function mapGetOrInsertComputed(n: u32): number {
        const m = new Map<number, number>()
        let calls = 0
        let total = 0
        for (let i = 0; i < 40; i++) {
            total += m.getOrInsertComputed(i % 13, key => {
                calls++
                return key * 3 + n
            })
        }
        return total + calls * 1000 + m.size * 100000
    }
    function mapGetOrInsertComputedMutates(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 6; i++) m.set(i, i)
        const a = m.getOrInsertComputed(10, key => {
            m.set(key, 1)
            return key + n
        })
        const b = m.getOrInsertComputed(11, key => {
            for (let i = 20; i < 40; i++) m.set(i, i)
            return key + n
        })
        const c = m.getOrInsertComputed(12, key => {
            m.clear()
            m.set(5, 50)
            return key + n
        })
        const d = m.getOrInsertComputed(13, key => {
            m.delete(5)
            return key + n
        })
        const e = m.getOrInsertComputed(13, key => key + 1000)
        let total = a + b * 10 + c * 100 + d * 1000 + e * 10000
        for (const [key, value] of m) total = total * 7 + key * 3 + value
        return total + m.size * 1000000 + (m.has(5) ? 1 : 0)
    }
    function mapGetOrInsertComputedDeletes(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 24; i++) m.set(i * 5, i)
        let total = 0
        for (let i = 0; i < 24; i++) {
            total += m.getOrInsertComputed(i * 5 + 1, key => {
                m.delete(i * 5)
                return key + n
            })
        }
        for (const [key, value] of m) total = (total * 3 + key + value) % 1000003
        return total + m.size * 1000000
    }
    function mapClusterDeletes(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 127; i++) m.set(i * 37 + n, i)
        for (let i = 0; i < 127; i += 3) m.delete(i * 37 + n)
        let total = m.size
        for (let i = 0; i < 127; i++) total = (total * 3 + (m.get(i * 37 + n) ?? 500) + (m.has(i * 37 + n) ? 1 : 0)) % 1000003
        for (let i = 0; i < 127; i += 6) m.set(i * 37 + n, i + 1000)
        for (let i = 1; i < 127; i += 4) m.delete(i * 37 + n)
        for (const [key, value] of m) total = (total * 5 + key + value) % 1000003
        for (let i = 0; i < 127; i++) total = (total * 7 + (m.get(i * 37 + n) ?? 900)) % 1000003
        return total + m.size * 1000000
    }
    function mapGetOrInsertComputedShifts(n: u32): number {
        const a = nextCollision(n)
        const b = nextCollision(a + 1)
        const c = nextCollision(b + 1)
        const m = new Map<number, number>()
        m.set(a, 1)
        m.set(b, 2)
        const v = m.getOrInsertComputed(c, key => {
            m.delete(a)
            return 3
        })
        return v * 1000 + (m.get(c) ?? 7) * 100 + (m.get(b) ?? 8) * 10 + (m.has(a) ? 1 : 0)
    }
    function mapSameValueZero(n: u32): number {
        const m = new Map<number, number>()
        const zero = n * 0.5 - n * 0.5
        const negative = -zero
        const nan = zero / zero
        m.set(nan, n + 1)
        m.set(NaN, n + 2)
        m.set(negative, n + 3)
        m.set(0, n + 4)
        m.set(1.5, n + 5)
        m.set(3, n + 6)
        m.set(3 * (n + 0.5) / (n + 0.5), n + 7)
        let total = m.size * 1000
        total += (m.get(NaN) ?? 99) * 100 + (m.get(zero) ?? 99) * 10 + (m.get(negative) ?? 99)
        total += m.has(nan) ? 1000000 : 0
        total += m.get(3)! * 7 + m.get(1.5)!
        if (m.delete(NaN)) total += 10000000
        total += m.has(nan) ? 100000000 : 0
        m.set(nan, 5)
        for (const [key, value] of m) total = total * 3 + value + (key === key ? 1 : 7)
        return total
    }
    function mapFractionalKeys(n: u32): number {
        const m = new Map<number, number>()
        m.set(n + 1.5, 10)
        m.set(n + 2, 20)
        const k: u32 = n + 1
        return (m.get(k) ?? 99) + (m.has(k) ? 1000 : 0) + m.get(n + 2)! * 3
    }
    function mapFractionalUnionKeys(n: u32): number {
        const m = new Map<number | undefined, number>()
        m.set(n > 100 ? undefined : n + 1.5, 10)
        m.set(n + 2, 20)
        m.set(n > 200 ? undefined : n + 3, 30)
        const k: u32 = n + 1
        return (m.get(k) ?? 99) + (m.has(k) ? 1000 : 0) + m.get(n + 2)! * 3
    }
    function mapObjectKeys(n: u32): number {
        const a = { id: n }
        const b = { id: n }
        const m = new Map<{ id: number }, number>()
        m.set(a, 1)
        m.set(b, 2)
        m.set(a, 3)
        let total = m.size * 100 + m.get(a)! * 10 + m.get(b)!
        total += m.has({ id: n }) ? 1000 : 0
        m.delete(a)
        total += m.has(a) ? 10000 : 0
        m.set(a, 4)
        for (const [key, value] of m) total = total * 3 + key.id + value + (key === a ? 50 : 0)
        return total
    }
    function mapIteratorAcrossRebuilds(n: u32): number {
        const m = new Map<number, number>()
        for (let i = 0; i < 4; i++) m.set(i, i + n)
        const keys = m.keys()
        const entries = m.entries()
        let total = keys.next().value! + entries.next().value![1] * 10
        for (let i = 4; i < 200; i++) m.set(i, i)
        for (let i = 1; i < 150; i += 2) m.delete(i)
        for (let i = 300; i < 340; i++) m.set(i, i + n)
        let key = keys.next()
        while (!key.done) {
            total = (total * 3 + key.value) % 1000003
            key = keys.next()
        }
        m.clear()
        m.set(7, n)
        let entry = entries.next()
        while (!entry.done) {
            total = (total * 5 + entry.value[0] + entry.value[1]) % 1000003
            entry = entries.next()
        }
        return total + m.size * 1000000
    }
    function mapFromPairsOrder(n: u32): number {
        const zero = n * 0.5 - n * 0.5
        const pairs: [number, number][] = [[n + 3, 1], [n + 1, 2], [n + 3, 3], [zero / zero, 4], [n + 2, 5], [NaN, 6], [n + 1, 7], [-zero, 8], [0, 9]]
        for (let i = 0; i < 40; i++) pairs.push([(i * 7) % 23 + n, i])
        const m = new Map<number, number>(pairs)
        let total = m.size
        for (const [key, value] of m) total = (total * 3 + (key === key ? key : 5) * 100 + value) % 1000003
        return total + (m.get(NaN) ?? 99) * 1000000 + (m.get(n + 3) ?? 99) * 100000000
    }
    function mapFromIterable(n: u32): number {
        const zero = n * 0.5 - n * 0.5
        const source = new Map<number, [number, number]>()
        source.set(-1, [n + 30, 1])
        for (let i = 0; i < 40; i++) source.set(i, [(i * 7) % 23 + n, i])
        source.set(100, [zero / zero, 2])
        source.set(101, [NaN, 3])
        source.set(102, [-zero, 4])
        source.set(103, [0, 5])
        source.set(104, [n + 30, 6])
        const m = new Map<number, number>(source.values())
        let total = m.size
        for (const [key, value] of m) total = (total * 3 + (key === key ? key : 5) * 100 + value) % 1000003
        const a = { id: n }
        const b = { id: n + 1 }
        const objects = new Map<number, [{ id: number }, number]>()
        objects.set(0, [b, 1])
        objects.set(1, [a, 2])
        objects.set(2, [b, 3])
        objects.set(3, [{ id: n }, 4])
        const o = new Map(objects.values())
        total = total * 10 + o.size + (o.get(a) ?? 9) * 10 + (o.get(b) ?? 9) * 100 + (o.has({ id: n }) ? 1000 : 0)
        for (const [key, value] of o) total = (total * 7 + key.id * 3 + value) % 1000003
        return total + (m.get(NaN) ?? 99) * 1000000 + (m.get(n + 30) ?? 99) * 100000000
    }
    function mapEmpty(n: u32): number {
        const m = new Map<number, number>()
        let total = m.size + (m.has(n) ? 10 : 0) + (m.get(n) ?? 7) * 100 + (m.delete(n) ? 1000 : 0)
        m.forEach((value, key) => {
            total = total + 10000 + key + value
        })
        for (const [key, value] of m) total = total + 100000 + key + value
        const keys = m.keys()
        const values = m.values()
        const entries = m.entries()
        const early = m.keys()
        total = total * 2 + (early.next().done ? 1 : 0)
        m.set(n + 1, 3)
        m.set(n + 2, 4)
        let key = keys.next()
        while (!key.done) {
            total = total * 3 + key.value
            key = keys.next()
        }
        let value = values.next()
        while (!value.done) {
            total = total * 3 + value.value
            value = values.next()
        }
        let entry = entries.next()
        while (!entry.done) {
            total = total * 3 + entry.value[0] * 10 + entry.value[1]
            entry = entries.next()
        }
        total = total * 2 + (early.next().done ? 1 : 0)
        m.clear()
        m.clear()
        total = total * 5 + m.size + (m.has(n + 1) ? 3 : 0) + (m.get(n + 1) ?? 1)
        m.set(n, 6)
        m.set(n, 8)
        return total * 7 + m.size + m.get(n)!
    }
    function mapEmptyFirstInsert(n: u32): number {
        const a = new Map<number, number>()
        const b = new Map<number, number>()
        let total = a.getOrInsert(n, 5) + a.getOrInsert(n, 9) * 10
        total += b.getOrInsertComputed(n + 1, key => key * 2) * 100
        total += b.getOrInsertComputed(n + 1, key => key * 3) * 1000
        const c = new Map<number, number>()
        total += c.getOrInsertComputed(n, key => {
            c.set(key + 1, 4)
            return key + 7
        }) * 10000
        for (const [key, value] of c) total = total * 3 + key * 10 + value
        return total + a.size + b.size * 10 + c.size * 100
    }
    function mapFromEmpty(n: u32): number {
        const empty = new Map<number, number>()
        const copy = new Map(empty)
        const drained = new Map<number, number>()
        drained.set(n, 1)
        drained.delete(n)
        const fromDrained = new Map(drained)
        const fromArray = new Map<number, number>([])
        const fromIterable = new Map(new Map<number, [number, number]>().values())
        let total = copy.size + fromDrained.size * 2 + fromArray.size * 4 + fromIterable.size * 8
        total += (copy.get(n) ?? 1) + (fromDrained.get(n) ?? 2) + (fromArray.get(n) ?? 3) + (fromIterable.get(n) ?? 4)
        total += (copy.delete(n) || fromDrained.delete(n) || fromArray.delete(n) || fromIterable.delete(n)) ? 32 : 0
        const held = fromIterable.entries()
        copy.set(n, 1)
        fromDrained.set(n + 1, 2)
        fromArray.getOrInsert(n, 3)
        for (let i = 0; i < 20; i++) fromIterable.set(i + n, i)
        let step = held.next()
        while (!step.done) {
            total = (total * 3 + step.value[0] + step.value[1]) % 1000003
            step = held.next()
        }
        return total * 10 + copy.size + fromDrained.size * 2 + fromArray.size * 4 + fromIterable.size * 8 + empty.size * 1000
    }
    harness.runCases({ prefix: 'Map', args: true }, [
        [mapEmpty, [0], [7]],
        [mapEmptyFirstInsert, [0], [7]],
        [mapFromEmpty, [0], [7]],
        [mapFromPairsOrder, [0], [7]],
        [mapFromIterable, [0], [7]],
        [mapFromEntries, [0], [4]],
        [mapFromMap, [0], [3]],
        [mapClusterDeletes, [0], [7]],
        [mapSameValueZero, [0], [7]],
        [mapFractionalKeys, [0], [7]],
        [mapFractionalUnionKeys, [0], [7]],
        [mapObjectKeys, [0], [7]],
        [mapIteratorAcrossRebuilds, [0], [7]],
        [mapGetOrInsert, [0], [7]],
        [mapGetOrInsertComputed, [0], [7]],
        [mapGetOrInsertComputedMutates, [0], [7]],
        [mapGetOrInsertComputedDeletes, [0], [7]],
        [mapGetOrInsertComputedShifts, [0], [7]],
        [mapIterate, [0], [3]],
        [mapProbeMutation, [0], [7]],
        [mapPointerValues, [0], [7]],
        [mapEntriesKinds, [0], [7]],
        [mapEntriesGrow, [0], [7]],
        [mapSetProbeWrap, [0], [7]],
        [mapSetDeleteReuse, [0], [7]],
        [mapDeleteDuringForOf, [0], [7]],
        [mapDeleteReadd, [0], [7]],
        [mapClearDuringForOf, [0], [7]],
        [mapCompactDuringForOf, [0], [7]],
        [mapForEachDelete, [0], [7]],
        [mapDoneStaysDone, [0], [7]],
        [mapSweep, [0], [7]],
    ])
}
