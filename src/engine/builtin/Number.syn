/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import * as heap from '../heap'
import { rt } from '../rt'
import { defineGlobal } from './globals'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

declare global {
    interface NumberConstructor {
        asUintN(bits: number, value: number): number
        asIntN(bits: number, value: number): number
    }
}

function asUintN(bits: number, value: number): number {
    if (!intrinsics.isNative() && bits <= 32) return (value << (32 - bits)) >>> (32 - bits)
    const range = 2 ** bits
    const rem = value % range
    return rem < 0 ? rem + range : rem
}

function asIntN(bits: number, value: number): number {
    if (!intrinsics.isNative() && bits <= 32) return (value << (32 - bits)) >> (32 - bits)
    const unsigned = asUintN(bits, value)
    return unsigned >= 2 ** (bits - 1) ? unsigned - 2 ** bits : unsigned
}

Object.defineProperty(Number, 'asUintN', { value: asUintN, writable: true, configurable: true })
Object.defineProperty(Number, 'asIntN', { value: asIntN, writable: true, configurable: true })

function digitOf(byte: number, radix: number): number {
    const digit = byte >= 48 && byte <= 57 ? byte - 48 : byte >= 97 && byte <= 122 ? byte - 87 : byte >= 65 && byte <= 90 ? byte - 55 : radix
    return digit < radix ? digit : -1
}

function parseNumber(text: string): number {
    const str = heap.HeapString(heap.resolveHeapCell(rt.handleof(text)))
    const length = str.length
    if (length === 0) return 0
    let i = 0
    let negative = false
    const sign = Intrinsics.load(str.ptr, 0, Types.u8)
    if (sign === 45 || sign === 43) {
        negative = sign === 45
        i = 1
    }
    let radix = 10
    if (i + 1 < length && Intrinsics.load(str.ptr, i, Types.u8) === 48) {
        const prefix = Intrinsics.load(str.ptr, i + 1, Types.u8)
        if (prefix === 120 || prefix === 88) radix = 16
        if (prefix === 111 || prefix === 79) radix = 8
        if (prefix === 98 || prefix === 66) radix = 2
        if (radix !== 10) {
            if (negative || sign === 43) return NaN
            i = i + 2
        }
    }
    if (i === length) return NaN
    let whole = 0
    while (i < length) {
        const byte = Intrinsics.load(str.ptr, i, Types.u8)
        if (radix === 10 && byte === 46) break
        const digit = digitOf(byte, radix)
        if (digit < 0) return NaN
        whole = whole * radix + digit
        i++
    }
    if (i === length) return negative ? -whole : whole
    let value = Intrinsics.convert(whole, Types.i64, Types.f64)
    let scale = 1.0
    i++
    while (i < length) {
        const digit = digitOf(Intrinsics.load(str.ptr, i, Types.u8), 10)
        if (digit < 0) return NaN
        scale = scale * 10
        value = value + Intrinsics.convert(digit, Types.i64, Types.f64) / scale
        i++
    }
    return negative ? -value : value
}

export const NumberBuiltin = function Number(value?: any): number {
    if (typeof value === 'number') return value
    if (typeof value === 'boolean') return value ? 1 : 0
    if (typeof value === 'string') return parseNumber(value)
    if (value === null) return 0
    return NaN
}

NumberBuiltin.asUintN = asUintN
NumberBuiltin.asIntN = asIntN
NumberBuiltin.MAX_SAFE_INTEGER = 9007199254740991
NumberBuiltin.MIN_SAFE_INTEGER = -9007199254740991

NumberBuiltin.isInteger = function isInteger(value: any): boolean {
    if (typeof value !== 'number') return false
    if (Intrinsics.typeof(value) !== Types.f64) return true
    return Intrinsics.convert(Intrinsics.convert(value, Types.f64, Types.i64), Types.i64, Types.f64) === value
}

NumberBuiltin.isSafeInteger = function isSafeInteger(value: any): boolean {
    if (!NumberBuiltin.isInteger(value)) return false
    const magnitude = value < 0 ? -value : value
    return magnitude <= 9007199254740991
}

NumberBuiltin.isNaN = function isNaN(value: any): boolean {
    return typeof value === 'number' && value !== value
}

NumberBuiltin.isFinite = function isFinite(value: any): boolean {
    return typeof value === 'number' && value === value && value !== Infinity && value !== -Infinity
}

defineGlobal(NumberBuiltin)
defineGlobal(Infinity, 'Infinity')
defineGlobal(NaN, 'NaN')

export async function suite() {
    const harness = await import('../harness')
    function numberConvert(n: u32): number {
        const big = BigInt(n)
        return Number(n) * 1000 + Number(big) * 100 + Number(n > 2) * 10 + Number(null)
    }
    function numberParse(n: u32): number {
        const text = `${n}`
        return Number(text) * 1000 + Number('+' + text) * 10 + Number('') * 7
    }
    function numberParseNegative(n: u32): number {
        return Number(`-${n}`) + 100
    }
    function numberParseRadix(n: u32): number {
        return Number('0x1f') * 100 + Number('0b101') * 10 + Number(`0x${n}`)
    }
    function numberParseFraction(n: u32): number {
        return Number(`${n}.25`) * 4 + Number('-0.5') * 2
    }
    function numberParseInvalid(n: u32): number {
        const bad = Number(`${n}x`)
        const sign = Number('-')
        const prefix = Number('0x')
        return (bad !== bad ? 100 : 0) + (sign !== sign ? 10 : 0) + (prefix !== prefix ? 1 : 0)
    }
    function numberPredicates(n: u32): number {
        const half = n + 0.5
        const nan = Number(`x${n}`)
        let r = 0
        if (Number.isNaN(nan)) r = r + 1
        if (!Number.isNaN(half)) r = r + 2
        if (Number.isFinite(half)) r = r + 4
        if (!Number.isFinite(nan)) r = r + 8
        if (n <= Number.MAX_SAFE_INTEGER) r = r + 16
        return r
    }
    harness.runCases({ prefix: 'Number', args: true }, [
        [numberConvert, [0], [3]],
        [numberParse, [0], [42]],
        // [numberParseNegative, [42], [0]],
        [numberParseRadix, [7]],
        [numberParseFraction, [0], [3]],
        [numberParseInvalid, [3]],
        [numberPredicates, [3]],
    ])
}
