/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Number {
    static isInteger(value: any): boolean {
        if (typeof value !== 'number') return false
        if (Intrinsics.typeof(value) !== Types.f64) return true
        return Intrinsics.convert(Intrinsics.convert(value, Types.f64, Types.i64), Types.i64, Types.f64) === value
    }

    static isSafeInteger(value: any): boolean {
        if (!Number.isInteger(value)) return false
        const magnitude = value < 0 ? -value : value
        return magnitude <= 9007199254740991
    }
}

defineGlobal(Number)
