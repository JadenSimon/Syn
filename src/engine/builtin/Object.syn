/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { rt } from '../rt'

export const ObjectBuiltin = {
    assign: intrinsics.tagInline(function assign(target: any, source: any): any {
        if (source === undefined || source === null) return target
        return rt.assign(target, source)
    }),
    create: intrinsics.tagInline(function create(proto: any): any {
        return rt.create(proto)
    }),
    setPrototypeOf: intrinsics.tagInline(function setPrototypeOf(obj: any, proto: any): any {
        return rt.setPrototypeOf(obj, proto)
    }),
}

defineGlobal(ObjectBuiltin, 'Object')

function isObject(value: any): boolean {
    return typeof value === 'function' || (typeof value === 'object' && value !== null)
}

function OrdinaryHasInstance(C: any, O: any): boolean {
    if (typeof C !== 'function') return false
    if (!isObject(O)) return false
    const P = C.prototype
    if (!isObject(P)) throw new Error('instanceof: the prototype of the right-hand side is not an object')
    return rt.hasPrototype(O, P) !== 0
}

// XXX: this should not exist. this needs to be Symbol.hasInstance on Function
function InstanceofOperator(value: any, target: any): boolean {
    if (!isObject(target)) throw new Error('instanceof: the right-hand side is not an object')
    const handler = target[Symbol.hasInstance]
    if (handler !== undefined && handler !== null) return !!target[Symbol.hasInstance](value)
    if (typeof target !== 'function') throw new Error('instanceof: the right-hand side is not callable')
    return OrdinaryHasInstance(target, value)
}

defineGlobal(InstanceofOperator)
