/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { rt } from '../rt'

export const assignOne = intrinsics.tagInline(function assignOne(target: any, source: any): any {
    if (source === undefined || source === null) return target
    return rt.assign(target, source)
})

export const ObjectBuiltin = {
    assign: intrinsics.tagInline(function assign(target: any, ...sources: any[]): any {
        for (const source of sources) {
            assignOne(target, source)
        }
        return target
    }),
    create: intrinsics.tagInline(function create(proto: any): any {
        return rt.create(proto)
    }),
    setPrototypeOf: intrinsics.tagInline(function setPrototypeOf(obj: any, proto: any): any {
        return rt.setPrototypeOf(obj, proto)
    }),
    keys: intrinsics.tagInline(function keys(obj: any): string[] {
        return rt.ownKeys(obj, 0) as any
    }),
    values: intrinsics.tagInline(function values(obj: any): any[] {
        return rt.ownKeys(obj, 1) as any
    }),
    entries: intrinsics.tagInline(function entries(obj: any): [string, any][] {
        return rt.ownKeys(obj, 2) as any
    }),
}

defineGlobal(ObjectBuiltin, 'Object')

function isObject(value: any): boolean {
    return typeof value === 'function' || (typeof value === 'object' && value !== null)
}

function OrdinaryHasInstance(C: any, O: any): boolean {
    if (typeof C !== 'function') return false
    if (!isObject(O)) return false
    const P = C.prototype
    if (!isObject(P)) throw new Error('instanceof: the prototype of the right-hand side is not an object')
    return rt.hasPrototype(O, P) !== 0
}

// XXX: this should not exist. this needs to be Symbol.hasInstance on Function
function InstanceofOperator(value: any, target: any): boolean {
    if (!isObject(target)) throw new Error('instanceof: the right-hand side is not an object')
    const handler = target[Symbol.hasInstance]
    if (handler !== undefined && handler !== null) return !!target[Symbol.hasInstance](value)
    if (typeof target !== 'function') throw new Error('instanceof: the right-hand side is not callable')
    return OrdinaryHasInstance(target, value)
}

defineGlobal(InstanceofOperator)

export async function suite() {
    const harness = await import('../harness')
    const settings = { scale: 3, offset: 7, label: 2 }
    const empty = {}
    function objectKeys(n: u32): number {
        const keys = Object.keys(settings)
        return keys.length * 100 + (keys[n] === 'offset' ? 10 : 0) + Object.keys(empty).length
    }
    function objectValues(n: u32): number {
        const values = Object.values(settings)
        return values.length * 100 + values[n] * 10 + Object.values(empty).length
    }
    function objectEntryValues(n: u32): number {
        const entries = Object.entries(settings)
        return entries.length * 100 + entries[n].length * 10 + entries[n][1]
    }
    function objectEntryKeys(n: u32): number {
        let total = 0
        for (const [key, value] of Object.entries(settings)) total = total + (key === 'scale' ? value * 100 : value)
        return total + n
    }
    function mixedPair(n: u32): number {
        const pair: any[] = ['scale', n]
        return (pair[0] === 'scale' ? 10 : 0) + pair[1]
    }
    harness.runCases({ prefix: 'Object', args: true }, [
        [objectKeys, [0], [1], [2]],
        [objectValues, [0], [2]],
        [objectEntryValues, [0], [1]],
        [objectEntryKeys, [0], [3]],
        [mixedPair, [0], [3]],
    ])
}
