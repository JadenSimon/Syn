/// @synth

"use wrapped";

import * as heap from '../heap'
import * as syscalls from '../syscalls'
import { rt } from '../rt'
import { defineGlobal } from './globals'

export function print(fd: u32, text: string): void {
    const str = heap.HeapString(heap.resolveHeapCell(rt.handleof(text)))
    syscalls.write(fd, str.ptr, str.length)
}

export const console = {
    log(message: string): void {
        print(1, message)
        print(1, '\n')
    },
}

defineGlobal(console, 'console')
