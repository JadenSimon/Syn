/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import * as heap from '../heap'
import { bind, Op, rt } from '../rt'
import { compileMatcher } from '../regex'
import { defineGlobal } from './globals'
import type { Case } from '../harness'

export class RegExp {
    declare source: string
    declare flags: string
    declare test: (text: string) => boolean

    constructor(source?: string, flags?: string) {
        this.source = source === undefined ? '' : source
        this.flags = flags === undefined ? '' : flags
        this.test = rt.compileRegex(source, flags)
    }
}

intrinsics.tagInline(RegExp) // XXX: hack for folding

defineGlobal(RegExp)

const regExpCreate = intrinsics.tagInline(function regExpCreate(source: string, flags: string): RegExp {
    return new RegExp(source, flags)
})

bind(Op.regExpCreate, { impl: regExpCreate })

function stringArg(value: intrinsics.Handle): string {
    if (!value || heap.isNullishHandle(value)) return ''
    if (!heap.isString(value)) throw new TypeError('regex: RegExp requires string patterns and flags')
    return heap.stringToJs(value)
}

bind(Op.compileRegex, {
    fold: ([source, flags], ctx) => ctx.fromJsValue(compileMatcher(stringArg(source), stringArg(flags))),
})

export async function suite() {
    const harness = await import('../harness')
    const native = await import('../native')
    if (harness.benching()) return benches(harness)
    const HostRegExp = globalThis.RegExp
    function check(ok: boolean, label: string): void {
        if (!ok) harness.fail(`RegExp ${label} FAILED`)
    }
    const patterns: [string, string, string[]][] = [
        ['cat', 'i', ['cats', 'CAT', 'xcat', 'dog']],
        ['\\bcat', 'i', ['cats', 'xcat', 'CAT']],
        ['cat\\B', 'i', ['cats', 'cat', 'CATS']],
        ['\\b', '', ['cats', '', ' ']],
        ['\\B', '', ['cats', '', ' ']],
        ['\\bcat', '', ['cats', 'xcat']],
        ['cat\\B', '', ['cats', 'cat']],
        ['', '', ['', 'abc']],
        ['ab+c', '', ['', 'ac', 'abc', 'zabbbc!', 'abb']],
        ['^(ab|cd)+e?$', '', ['', 'ab', 'abcdabe', 'xabcde', 'cde', 'ab\n']],
        ['a{2,4}b{1,}c{0,2}', '', ['ab', 'aab', 'aaaabbbcc', 'aaaaab', 'aa']],
        ['^(a?)*b$', '', ['', 'b', 'aaab', 'aaac']],
        ['(?:a*|b?)*c', '', ['', 'aaaa', 'bbac', 'c']],
        ['[^a-z]+', 'i', ['', 'abc', 'ABC', 'ab1', '123']],
        ['^[\\w-]+\\s\\d{2}$', '', ['abc- 12', 'ab\t09', 'a 1', 'a 123', 'a! 12']],
        ['\\bcat\\B', 'i', ['cats', 'cat', 'CatS', 'bobcats']],
        ['^foo.$', 'ms', ['foo\n', 'x\nfoo!\ny', 'foo', 'xfoo!']],
        ['a.*?b', '', ['ab', 'axxbxxb', 'a\nb', 'ba']],
        ['[\\D_]+', '', ['123', 'abc', '_', '1_2']],
        ['[]|[^]', '', ['', 'a', '\n']],
        ['\\x41\\u0042\\0', '', ['AB\0', 'AB', 'ab\0']],
    ]
    harness.test('differential', () => {
        const atoms = ['a', '[ab]', '[^a]', '.', '\\d', '\\b', '^', '$', '(?:a|)', '(?:a?)']
        const texts = ['', 'a', 'b', 'aa', 'ab', 'ba', '1', 'a1', ' a ', '\na', 'a\n', '\n']
        for (const left of atoms) {
            for (const right of atoms) {
                for (const repeat of ['', '?', '*', '+', '{0,2}']) {
                    if (repeat && (left === '^' || left === '$' || left === '\\b')) continue
                    for (const flags of ['', 'i', 'm', 's']) {
                        const source = left + repeat + right
                        const generated = compileMatcher(source, flags)
                        const reference = new HostRegExp(source, flags)
                        for (const text of texts) check(generated(text) === reference.test(text), `/${source}/${flags} ${JSON.stringify(text)}`)
                    }
                }
            }
        }
    })
    harness.test('syntax-errors', () => {
        const invalid = [['(', ''], ['[a', ''], ['[z-a]', ''], ['a{3,2}', ''], ['a**', ''], ['\\', ''], ['(?=a)', ''], ['(a)\\1', ''], ['é', ''], ['a', 'g'], ['a', 'ii'], ['a{1001}', '']]
        for (const [source, flags] of invalid) {
            let rejected = false
            try {
                compileMatcher(source, flags)
            } catch (e) {
                rejected = e instanceof SyntaxError
            }
            check(rejected, `/${source}/${flags} is rejected`)
        }
    })
    function patternCase(source: string, flags: string, texts: string[]): Case {
        function pattern(index: u32): boolean {
            return new RegExp(source, flags).test(texts[index])
        }
        return [pattern, ...texts.map((_, i) => [i])]
    }
    harness.runCases({ prefix: 'RegExp', args: true }, patterns.map(([source, flags, texts]) => patternCase(source, flags, texts)))
    const texts = ['', 'ab', 'abcd2', 'ab9x', 'ABC', 'abc!', 'z', 'cats', 'cat', 'ABBC']
    const indices = texts.map((_, i) => [i])
    function literal(index: u32): boolean {
        return /^(ab|cd)+\d?$/.test(texts[index])
    }
    function constructed(index: u32): boolean {
        return new RegExp('^[a-z]+$', 'i').test(texts[index])
    }
    function empty(index: u32): boolean {
        return new RegExp().test(texts[index])
    }
    function create(): RegExp {
        return /ab/
    }
    function fresh(): boolean {
        return create() !== create()
    }
    function source(state: { calls: u32 }): string {
        state.calls++
        return 'ab'
    }
    intrinsics.tagInline(source)
    function effects(n: u32): u32 {
        const state = { calls: 0 as u32 }
        const expression = new RegExp(source(state), 'i')
        return state.calls * 10 + (expression.test(n ? 'AB' : 'zz') ? 1 : 0)
    }
    function metadata(): u32 {
        const expression = new RegExp('ab', 'i')
        return expression.source.length * 100 + expression.flags.length * 10 + (expression instanceof RegExp ? 1 : 0)
    }
    const captured = /^ab+c$/i
    const alias = captured
    const nested = { captured }
    const other = /cat\B/
    function capturedDirect(index: u32): boolean {
        return captured.test(texts[index])
    }
    function capturedNested(index: u32): boolean {
        return nested.captured.test(texts[index])
    }
    function capturedOther(index: u32): boolean {
        return other.test(texts[index])
    }
    function capturedShared(): boolean {
        return captured === nested.captured && captured === alias
    }
    const a = /^a$/
    const b = /^b$/
    const c = /^c$/
    const d = /^d$/
    const e = /^e$/
    const f = /^f$/
    const g = /^g$/
    const h = /^h$/
    function capturedMany(): u32 {
        return (a.test('a') ? 1 : 0) + (b.test('b') ? 2 : 0) + (c.test('c') ? 4 : 0) + (d.test('d') ? 8 : 0)
            + (e.test('e') ? 16 : 0) + (f.test('f') ? 32 : 0) + (g.test('g') ? 64 : 0) + (h.test('x') ? 128 : 0)
    }
    harness.runCases({ prefix: 'RegExp', args: true }, [
        [literal, ...indices],
        [constructed, ...indices],
        [empty, ...indices],
        [fresh, []],
        [effects, [0], [1]],
        [metadata, []],
        [capturedDirect, ...indices],
        [capturedNested, ...indices],
        [capturedOther, ...indices],
        [capturedShared, []],
        [capturedMany, []],
    ])
    function rejects(fn: Function, reason: string): void {
        let message = ''
        try {
            native.createNatives({ [fn.name]: fn })
        } catch (e) {
            message = String(e)
        }
        check(message.includes(reason), `${fn.name} is rejected with '${reason}', got '${message.slice(0, 200)}'`)
    }
    harness.test('dynamic-patterns', () => {
        function dynamicPattern(index: u32): boolean {
            return new RegExp(index ? 'a' : 'b').test('ab')
        }
        function numericPattern(): boolean {
            return new RegExp(123 as any).test('123')
        }
        rejects(dynamicPattern, 'compileRegex reached native lowering')
        rejects(numericPattern, 'requires string patterns and flags')
    })
}

function benches(harness: typeof import('../harness')): void {
    function count(regex: RegExp, corpus: string[], iters: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            if (regex.test(corpus[k & 3])) total++
        }
        return total
    }
    function literalCorpus(size: number): string[] {
        const fill = 'x'.repeat(size - 6)
        return ['needle' + fill, fill + 'needle', 'x'.repeat(size), 'needlf' + fill]
    }
    const needle = /needle/
    const shortCorpus = literalCorpus(256)
    const longCorpus = literalCorpus(4096)
    const identifier = /^[a-zA-Z_][a-zA-Z0-9_]*$/
    const identifierCorpus = ['a'.repeat(64), '_' + 'a9'.repeat(31) + '_', 'a'.repeat(63) + '!', '1' + 'a'.repeat(63)]
    const date = /^\d{4}-\d{2}-\d{2}$/
    const dateCorpus = ['2026-10-18', '1999-12-31', '2026/10/18', '2026-10-1x']
    const alternation = /^(ab|cd)+e?$/
    const alternationCorpus = ['ab'.repeat(32), 'abcd'.repeat(16), 'ab'.repeat(31) + 'ae', 'xx' + 'ab'.repeat(31)]
    const boundary = /\bcat\B/i
    const boundaryCorpus = ['CATS ' + 'x'.repeat(251), 'x'.repeat(250) + ' cats ', 'x'.repeat(256), 'x'.repeat(250) + ' cat  ']
    const dots = /a.*b/
    const dotsCorpus = ['a' + 'x'.repeat(254) + 'b', 'axxb' + 'x'.repeat(252), 'a'.repeat(256), 'x'.repeat(256)]
    const negated = /[^\w\s]/
    const negatedCorpus = ['!' + 'a'.repeat(255), 'a'.repeat(255) + '!', 'a'.repeat(256), ' '.repeat(256)]
    function benchLiteral(iters: u32): u32 {
        return count(needle, shortCorpus, iters)
    }
    function benchIdentifier(iters: u32): u32 {
        return count(identifier, identifierCorpus, iters)
    }
    function benchDate(iters: u32): u32 {
        return count(date, dateCorpus, iters)
    }
    function benchAlternation(iters: u32): u32 {
        return count(alternation, alternationCorpus, iters)
    }
    function benchBoundary(iters: u32): u32 {
        return count(boundary, boundaryCorpus, iters)
    }
    function benchDots(iters: u32): u32 {
        return count(dots, dotsCorpus, iters)
    }
    function benchNegated(iters: u32): u32 {
        return count(negated, negatedCorpus, iters)
    }
    function benchLongLiteral(iters: u32): u32 {
        return count(needle, longCorpus, iters)
    }
    const registry = harness.createBenches()
    registry.bench(benchLiteral, [20_000], { reps: 1, ops: 20_000 })
    registry.bench(benchIdentifier, [100_000], { reps: 1, ops: 100_000 })
    registry.bench(benchDate, [200_000], { reps: 1, ops: 200_000 })
    registry.bench(benchAlternation, [50_000], { reps: 1, ops: 50_000 })
    registry.bench(benchBoundary, [20_000], { reps: 1, ops: 20_000 })
    registry.bench(benchDots, [20_000], { reps: 1, ops: 20_000 })
    registry.bench(benchNegated, [20_000], { reps: 1, ops: 20_000 })
    registry.bench(benchLongLiteral, [2_000], { reps: 1, ops: 2_000 })
    registry.run()
}
