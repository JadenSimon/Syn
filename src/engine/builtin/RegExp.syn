/// @synth

"use wrapped";

import { defineGlobal } from './globals'

export class RegExp {
    declare source: string
    declare flags: string

    constructor(source: string, flags: string) {
        this.source = source
        this.flags = flags
    }

    test(text: string): boolean {
        throw new Error(`RegExp is not implemented: /${this.source}/${this.flags}`)
    }
}

defineGlobal(RegExp)
