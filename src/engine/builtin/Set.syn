/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { buildTable, hashKey } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Set {
    declare keyList: any[]
    declare size: number
    declare table: u32
    declare mask: u32

    constructor(values?: Iterable<any>) {
        const keyList: any[] = []
        if (values !== undefined) {
            for (const value of values) {
                let found = false
                for (let i = 0; i < keyList.length; i++) {
                    if (keyList[i] === value) found = true
                }
                if (!found) keyList.push(value)
            }
        }
        let capacity: u32 = 8
        while (keyList.length * 2 > capacity) capacity = capacity * 2
        this.keyList = keyList
        this.size = keyList.length
        this.table = buildTable(keyList, keyList.length, capacity)
        this.mask = capacity - 1
    }

    indexOf(value: any): number {
        let slot: u32 = hashKey(value) & this.mask
        let entry = Intrinsics.load(this.table, slot * 4, Types.u32)
        while (entry) {
            if (this.keyList[entry - 1] === value) return entry - 1
            slot = (slot + 1) & this.mask
            entry = Intrinsics.load(this.table, slot * 4, Types.u32)
        }
        return this.size
    }

    place(index: u32): void {
        let slot: u32 = hashKey(this.keyList[index]) & this.mask
        while (Intrinsics.load(this.table, slot * 4, Types.u32)) slot = (slot + 1) & this.mask
        Intrinsics.store(this.table, slot * 4, index + 1, Types.u32)
    }

    rehash(capacity: u32): void {
        this.table = buildTable(this.keyList, this.size, capacity)
        this.mask = capacity - 1
    }

    has(value: any): boolean {
        return this.indexOf(value) < this.size
    }

    add(value: any): this {
        const index = this.indexOf(value)
        if (index < this.size) return this
        this.keyList.push(value)
        this.size = this.size + 1
        if (this.size * 2 > this.mask) this.rehash((this.mask + 1) * 2)
        else this.place(index)
        return this
    }

    delete(value: any): boolean {
        const index = this.indexOf(value)
        if (index >= this.size) return false
        for (let i = index + 1; i < this.size; i++) {
            this.keyList[i - 1] = this.keyList[i]
        }
        this.size = this.size - 1
        this.keyList.length = this.size
        this.rehash(this.mask + 1)
        return true
    }

    clear(): void {
        this.size = 0
        this.keyList.length = 0
        this.rehash(this.mask + 1)
    }

    forEach(fn: (value: any, key: any, set: Set) => void): void {
        for (let i = 0; i < this.size; i++) fn(this.keyList[i], this.keyList[i], this)
    }

    values() {
        return this.keyList[Symbol.iterator]()
    }

    keys() {
        return this.keyList[Symbol.iterator]()
    }

    [Symbol.iterator]() {
        return this.keyList[Symbol.iterator]()
    }
}
