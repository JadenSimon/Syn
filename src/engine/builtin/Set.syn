/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { buildTable, findEntry, removeEntry, tableCapacity, liveIndex, clearHoles, markHole, closeHoles, linkHoles, nextHoles, remapIndex, isHole } from './memory'
import { readElement, writeElement, reserveElements } from './Array'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const exhausted = 2**32

let iteratorNext: (iterator: SetIterator) => any
let seek: (set: Set, cursor: SetIterator) => number

export class Set {
    #keyList: any[]
    #table: u32
    #mask: u32
    #removed: number
    #vacancies: u32
    #retired: u32
    #oldestRetired: u32
    get size(): number {
        return this.#keyList.length - this.#removed
    }

    constructor(values?: Iterable<any>) {
        const keyList: any[] = []
        if (values instanceof Set) {
            const length = values.#keyList.length
            const holes = values.#removed ? values.#vacancies : 0
            reserveElements(keyList, length - values.#removed)
            for (let i = 0; i < length; i++) {
                if (holes && isHole(holes, i)) continue
                keyList.push(readElement(values.#keyList, i))
            }
        } else if (values !== undefined) {
            if (values instanceof Array && values.length) reserveElements(keyList, values.length)
            for (const value of values) {
                let found = false
                for (let i = 0; i < keyList.length; i++) {
                    const key = keyList[i]
                    if (key === value || (key !== key && value !== value)) found = true
                }
                if (!found) keyList.push(value)
            }
        }
        const capacity = tableCapacity(keyList.length)
        this.#keyList = keyList
        this.#table = buildTable(keyList, keyList.length, capacity)
        this.#mask = capacity - 1
        this.#removed = 0
        this.#vacancies = 0
        this.#retired = 0
        this.#oldestRetired = 0
    }

    #rebuild(): void {
        const length = this.#keyList.length
        let count = length
        if (this.#removed) {
            const holes = closeHoles(this.#table, this.#mask, length, false)
            if (this.#retired) linkHoles(this.#retired, holes)
            else this.#oldestRetired = holes
            this.#retired = holes
            count = 0
            for (let i = 0; i < length; i++) {
                if (isHole(this.#vacancies, i)) continue
                writeElement(this.#keyList, count, readElement(this.#keyList, i))
                count++
            }
            this.#keyList.length = count
            this.#removed = 0
            this.#vacancies = 0
        }
        const capacity = tableCapacity(count)
        this.#table = buildTable(this.#keyList, count, capacity)
        this.#mask = capacity - 1
    }

    has(value: any): boolean {
        return findEntry(this.#keyList, this.#table, this.#mask, value) >= 0
    }

    add(value: any): this {
        const found = findEntry(this.#keyList, this.#table, this.#mask, value)
        if (found >= 0) return this
        const index = this.#keyList.length
        this.#keyList.push(value)
        if (this.#keyList.length * 2 > this.#mask) this.#rebuild()
        else Intrinsics.store(this.#table, (-found - 1) * 4, index + 1, Types.u32)
        return this
    }

    delete(value: any): boolean {
        const index = findEntry(this.#keyList, this.#table, this.#mask, value)
        if (index < 0) return false
        removeEntry(this.#keyList, this.#table, this.#mask, index)
        if (!this.#vacancies) this.#vacancies = clearHoles(this.#table, this.#mask)
        markHole(this.#vacancies, index)
        this.#removed++
        if (this.#removed > 8 && this.#removed * 2 > this.#keyList.length) this.#rebuild()
        return true
    }

    clear(): void {
        const length = this.#keyList.length
        if (length) {
            const holes = closeHoles(this.#table, this.#mask, length, true)
            if (this.#retired) linkHoles(this.#retired, holes)
            else this.#oldestRetired = holes
            this.#retired = holes
        }
        this.#keyList.length = 0
        this.#table = 0
        this.#mask = 0
        this.#removed = 0
        this.#vacancies = 0
    }

    forEach(fn: (value: any, key: any, set: Set) => void): void {
        const cursor = new SetIterator(this, this.#retired)
        let index = seek(this, cursor)
        while (index < this.#keyList.length) {
            const value = readElement(this.#keyList, index)
            fn(value, value, this)
            index = seek(this, cursor)
        }
    }

    values() {
        return new SetIterator(this, this.#retired)
    }

    keys() {
        return new SetIterator(this, this.#retired)
    }

    [Symbol.iterator]() {
        return new SetIterator(this, this.#retired)
    }

    static {
        seek = intrinsics.tagInline((set: Set, cursor: SetIterator): number => {
            let index = cursor.index
            if (cursor.retired !== set.#retired) {
                index = remapIndex(cursor.retired ? nextHoles(cursor.retired) : set.#oldestRetired, index)
                cursor.retired = set.#retired
            }
            if (set.#vacancies) index = liveIndex(set.#vacancies, index, set.#keyList.length)
            cursor.index = index + 1
            return index
        })
        iteratorNext = intrinsics.tagInline((iterator: SetIterator): any => {
            const set = iterator.set
            const index = seek(set, iterator)
            if (index >= set.#keyList.length) {
                iterator.index = exhausted
                return { done: true }
            }
            return { done: false, value: readElement(set.#keyList, index) }
        })
    }
}

class SetIterator {
    set: Set
    index: number
    retired: u32

    constructor(set: Set, retired: u32) {
        this.set = set
        this.index = 0
        this.retired = retired
    }

    next() {
        return iteratorNext(this)
    }

    [Symbol.iterator]() {
        return this
    }
}

intrinsics.tagInline(SetIterator.prototype.next)

defineGlobal(Set)

export async function suite() {
    const harness = await import('../harness')
    function setFromArray(n: u32): number {
        const s = new Set<number>([n, n + 1, n])
        return s.size * 10 + (s.has(n + 1) ? 1 : 0)
    }
    function setFromSet(n: u32): number {
        const a = new Set<number>([n, n + 1])
        const b = new Set(a)
        b.add(n + 2)
        return a.size * 100 + b.size * 10 + (b.has(n + 1) ? 1 : 0)
    }
    function setProbeMutation(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 48; i++) s.add(i * 17)
        for (let i = 0; i < 48; i += 2) s.delete(i * 17)
        let total = s.size
        for (let i = 0; i < 50; i++) total += s.has(i * 17) ? i + n : 100
        s.clear()
        s.add(n)
        s.add(n)
        return total + s.size * 10 + (s.has(n) ? 1 : 0)
    }
    function setDeleteDuringForOf(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 12; i++) s.add(i + n)
        let total = 0
        for (const value of s) {
            total = total * 3 + value
            if (value % 3 === 0) s.delete(value)
            if (value === n + 4) s.delete(n + 7)
        }
        for (const value of s.values()) total = total * 5 + value
        return total + s.size * 1000
    }
    function setDeleteReadd(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 6; i++) s.add(i + n)
        s.delete(n + 2)
        s.add(n + 2)
        s.delete(n)
        s.add(n)
        let total = 0
        for (const value of s) total = total * 7 + value
        return total + s.size
    }
    function setClearDuringForOf(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 6; i++) s.add(i + n)
        let total = 0
        for (const value of s) {
            total = total * 3 + value
            if (value === n + 2) {
                s.clear()
                s.add(n + 10)
                s.add(n + 11)
            }
        }
        return total + s.size * 1000
    }
    function setCompactDuringForOf(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 64; i++) s.add(i)
        let total = n
        for (const value of s) {
            total = (total * 3 + value) % 1000003
            if (value === 40) {
                for (let i = 0; i < 40; i++) s.delete(i)
                for (let i = 100; i < 140; i++) s.add(i)
            }
            if (value === 120) for (let i = 41; i < 100; i++) s.delete(i)
        }
        let count = 0
        s.forEach(value => {
            count = count + value
            s.delete(value + 1)
        })
        return total + s.size * 1000000 + count * 7
    }
    function setClusterDeletes(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 127; i++) s.add(i * 37 + n)
        for (let i = 0; i < 127; i += 3) s.delete(i * 37 + n)
        let total = s.size
        for (let i = 0; i < 127; i++) total = (total * 3 + (s.has(i * 37 + n) ? 1 : 2)) % 1000003
        for (let i = 0; i < 127; i += 6) s.add(i * 37 + n)
        for (let i = 1; i < 127; i += 4) s.delete(i * 37 + n)
        for (const value of s) total = (total * 5 + value) % 1000003
        for (let i = 0; i < 127; i++) total = (total * 7 + (s.has(i * 37 + n) ? 1 : 2)) % 1000003
        return total + s.size * 1000000
    }
    function setFromArrayNaN(n: u32): number {
        const zero = n * 0.5 - n * 0.5
        return new Set<number>([zero / zero, zero / zero]).size
    }
    function setSameValueZero(n: u32): number {
        const zero = n * 0.5 - n * 0.5
        const nan = zero / zero
        const s = new Set<number>([nan, NaN, -zero, 0, n, n + 0.5])
        let total = s.size * 1000
        s.add(NaN)
        s.add(-zero)
        s.add(zero)
        total += s.size * 100
        total += (s.has(NaN) ? 1 : 0) + (s.has(0) ? 2 : 0) + (s.has(-zero) ? 4 : 0) + (s.has(n + 0.5) ? 8 : 0)
        s.delete(nan)
        total += s.has(NaN) ? 10 : 20
        s.add(nan)
        for (const value of s) total = total * 3 + (value === value ? value : 5)
        return total
    }
    function setObjectKeys(n: u32): number {
        const a = { id: n }
        const b = { id: n }
        const s = new Set<{ id: number }>([a, b, a])
        s.add(b)
        let total = s.size * 100 + (s.has(a) ? 10 : 0) + (s.has(b) ? 1 : 0)
        total += s.has({ id: n }) ? 1000 : 0
        s.delete(a)
        total += s.has(a) ? 10000 : 0
        s.add(a)
        for (const value of s) total = total * 3 + value.id + (value === a ? 50 : 0)
        return total
    }
    function setIteratorAcrossRebuilds(n: u32): number {
        const s = new Set<number>()
        for (let i = 0; i < 4; i++) s.add(i + n)
        const values = s.values()
        let total = values.next().value!
        for (let i = 4; i < 200; i++) s.add(i + n)
        for (let i = 1; i < 150; i += 2) s.delete(i + n)
        for (let i = 300; i < 340; i++) s.add(i + n)
        let step = values.next()
        while (!step.done) {
            total = (total * 3 + step.value) % 1000003
            step = values.next()
        }
        s.forEach(value => {
            total = (total * 5 + value) % 1000003
            if (value < 20 + n) s.add(value + 1000)
        })
        return total + s.size * 1000000
    }
    harness.runCases({ prefix: 'Set', args: true }, [
        [setClusterDeletes, [0], [7]],
        [setFromArrayNaN, [0], [7]],
        [setSameValueZero, [0], [7]],
        [setObjectKeys, [0], [7]],
        [setIteratorAcrossRebuilds, [0], [7]],
        [setFromArray, [3]],
        [setFromSet, [2]],
        [setProbeMutation, [0], [7]],
        [setDeleteDuringForOf, [0], [7]],
        [setDeleteReadd, [0], [7]],
        [setClearDuringForOf, [0], [7]],
        [setCompactDuringForOf, [0], [7]],
    ])
}
