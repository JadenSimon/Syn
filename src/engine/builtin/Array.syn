/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { isNative } from '../intrinsics'
import { defineGlobal } from './globals'
import { Op as RtOp, bind, rt } from '../rt'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Array {
    declare length: number
    declare capacity: number
    declare data: number // XXX: should be private

    constructor() {
        this.length = 0
        this.capacity = 0
        this.data = 0
    }

    reserve(capacity: number): void {
        const data = Intrinsics.rt(RtOp.slice, capacity, Types.vm_value)
        for (let i = 0; i < this.length; i++) {
            Intrinsics.rt(RtOp.sliceWrite, data, i, Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), Types.vm_value)
        }
        this.data = data
        this.capacity = capacity
    }

    push(...values: any[]): number {
        const count = values.length
        const index = this.length
        if (count === 1) {
            if (index >= this.capacity) this.reserve(index * 2 + 4)
            Intrinsics.rt(RtOp.sliceWrite, this.data, index, values[0], Types.vm_value)
            this.length = index + 1
            return index + 1
        }
        if (index + count > this.capacity) this.reserve(index * 2 + count + 3)
        let i = 0
        while (i < count) {
            Intrinsics.rt(RtOp.sliceWrite, this.data, index + i, Intrinsics.rt(RtOp.sliceRead, values.data, i, Types.vm_value), Types.vm_value)
            i++
        }
        this.length = index + count
        return index + count
    }

    pop(): any {
        const index = this.length
        if (index === 0) return undefined
        this.length = index - 1
        return Intrinsics.rt(RtOp.sliceRead, this.data, index - 1, Types.vm_value)
    }

    at(index: number): any {
        const at = index < 0 ? this.length + index : index
        if (at < 0 || at >= this.length) return undefined
        return Intrinsics.rt(RtOp.sliceRead, this.data, at, Types.vm_value)
    }

    unshift(...values: any[]): number {
        const count = values.length
        const length = this.length
        if (length + count > this.capacity) this.reserve(length * 2 + count + 3)
        let i = length
        while (i > 0) {
            i--
            Intrinsics.rt(RtOp.sliceWrite, this.data, i + count, Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), Types.vm_value)
        }
        while (i < count) {
            Intrinsics.rt(RtOp.sliceWrite, this.data, i, Intrinsics.rt(RtOp.sliceRead, values.data, i, Types.vm_value), Types.vm_value)
            i++
        }
        this.length = length + count
        return length + count
    }

    splice(start: number, deleteCount?: number, ...items: any[]): Array {
        const length = this.length
        const from = clampIndex(start, length)
        const available = length - from
        const removing = deleteCount === undefined ? available : deleteCount < 0 ? 0 : deleteCount > available ? available : deleteCount
        const count = items.length
        const removed = arrayLiteral(removing)
        for (let i = 0; i < removing; i++) {
            Intrinsics.rt(RtOp.sliceWrite, removed.data, i, Intrinsics.rt(RtOp.sliceRead, this.data, from + i, Types.vm_value), Types.vm_value)
        }
        const total = length - removing + count
        if (total > this.capacity) this.reserve(total * 2 + 4)
        const tail = from + removing
        if (count < removing) {
            let i = tail
            while (i < length) {
                Intrinsics.rt(RtOp.sliceWrite, this.data, i - removing + count, Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), Types.vm_value)
                i++
            }
        } else {
            let i = length
            while (i > tail) {
                i--
                Intrinsics.rt(RtOp.sliceWrite, this.data, i - removing + count, Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), Types.vm_value)
            }
        }
        for (let i = 0; i < count; i++) {
            Intrinsics.rt(RtOp.sliceWrite, this.data, from + i, Intrinsics.rt(RtOp.sliceRead, items.data, i, Types.vm_value), Types.vm_value)
        }
        this.length = total
        return removed
    }

    concat(...items: any[]): Array {
        const out = this.slice()
        for (let i = 0; i < items.length; i++) spread(out, items[i])
        return out
    }

    flatMap(fn: (value: any, index: number, array: Array) => any): Array {
        const out = new Array()
        for (let i = 0; i < this.length; i++) spread(out, fn(Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this))
        return out
    }

    shift(): any {
        const length = this.length
        if (length === 0) return undefined
        const first = Intrinsics.rt(RtOp.sliceRead, this.data, 0, Types.vm_value)
        for (let i = 1; i < length; i++) {
            Intrinsics.rt(RtOp.sliceWrite, this.data, i - 1, Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), Types.vm_value)
        }
        this.length = length - 1
        return first
    }

    indexOf(value: any, fromIndex?: number): number {
        const start = fromIndex === undefined ? 0 : clampIndex(fromIndex, this.length)
        for (let i = start; i < this.length; i++) {
            if (Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value) === value) return i
        }
        return -1
    }

    lastIndexOf(value: any, fromIndex?: number): number {
        let i = this.length
        if (fromIndex !== undefined) {
            const last = fromIndex < 0 ? this.length + fromIndex : fromIndex
            if (last < 0) return -1
            if (last < i) i = last + 1
        }
        while (i > 0) {
            i--
            if (Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value) === value) return i
        }
        return -1
    }

    includes(value: any, fromIndex?: number): boolean {
        const start = fromIndex === undefined ? 0 : clampIndex(fromIndex, this.length)
        for (let i = start; i < this.length; i++) {
            if (Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value) === value) return true
        }
        return false
    }

    find(predicate: (value: any, index: number, array: Array) => boolean): any {
        for (let i = 0; i < this.length; i++) {
            const value = Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value)
            if (predicate(value, i, this)) return value
        }
        return undefined
    }

    findIndex(predicate: (value: any, index: number, array: Array) => boolean): number {
        for (let i = 0; i < this.length; i++) {
            if (predicate(Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this)) return i
        }
        return -1
    }

    forEach(fn: (value: any, index: number, array: Array) => void): void {
        for (let i = 0; i < this.length; i++) fn(Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this)
    }

    reduce(fn: (acc: any, value: any, index: number, array: Array) => any, initial?: any): any {
        let acc = initial
        let i = 0
        if (initial === undefined) {
            if (this.length === 0) throw 'Reduce of empty array with no initial value'
            acc = Intrinsics.rt(RtOp.sliceRead, this.data, 0, Types.vm_value)
            i = 1
        }
        while (i < this.length) {
            acc = fn(acc, Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this)
            i++
        }
        return acc
    }

    slice(start?: number, end?: number): Array {
        const length = this.length
        const from = start === undefined ? 0 : clampIndex(start, length)
        const to = end === undefined ? length : clampIndex(end, length)
        const out = arrayLiteral(to > from ? to - from : 0)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.rt(RtOp.sliceWrite, out.data, i, Intrinsics.rt(RtOp.sliceRead, this.data, from + i, Types.vm_value), Types.vm_value)
        }
        return out
    }

    fill(value: any, start?: number, end?: number): this {
        const length = this.length
        const from = start === undefined ? 0 : clampIndex(start, length)
        const to = end === undefined ? length : clampIndex(end, length)
        for (let i = from; i < to; i++) Intrinsics.rt(RtOp.sliceWrite, this.data, i, value, Types.vm_value)
        return this
    }

    some(predicate: (value: any, index: number, array: Array) => boolean): boolean {
        for (let i = 0; i < this.length; i++) {
            if (predicate(Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this)) return true
        }
        return false
    }

    every(predicate: (value: any, index: number, array: Array) => boolean): boolean {
        for (let i = 0; i < this.length; i++) {
            if (!predicate(Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this)) return false
        }
        return true
    }

    filter(predicate: (value: any, index: number, array: Array) => boolean): Array {
        const out = new Array()
        for (let i = 0; i < this.length; i++) {
            const value = Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value)
            if (predicate(value, i, this)) out.push(value)
        }
        return out
    }

    map(fn: (value: any, index: number, array: Array) => any): Array {
        const out = new Array()
        out.reserve(this.length)
        for (let i = 0; i < this.length; i++) out.push(fn(Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value), i, this))
        return out
    }

    reverse(): this {
        for (let i = 0, j = this.length - 1; i < j; i++, j--) {
            const value = Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value)
            Intrinsics.rt(RtOp.sliceWrite, this.data, i, Intrinsics.rt(RtOp.sliceRead, this.data, j, Types.vm_value), Types.vm_value)
            Intrinsics.rt(RtOp.sliceWrite, this.data, j, value, Types.vm_value)
        }
        return this
    }

    join(separator?: string): string {
        const sep = separator === undefined ? ',' : separator
        let out = ''
        for (let i = 0; i < this.length; i++) {
            if (i > 0) out += sep
            const value = Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value)
            if (value !== undefined && value !== null) out += value
        }
        return out
    }

    sort(compare: (a: any, b: any) => number): this {
        for (let i = 1; i < this.length; i++) {
            const value = Intrinsics.rt(RtOp.sliceRead, this.data, i, Types.vm_value)
            let j = i
            while (j > 0 && Intrinsics.convert(compare(Intrinsics.rt(RtOp.sliceRead, this.data, j - 1, Types.vm_value), value), Types.u64, Types.i64) > 0) {
                Intrinsics.rt(RtOp.sliceWrite, this.data, j, Intrinsics.rt(RtOp.sliceRead, this.data, j - 1, Types.vm_value), Types.vm_value)
                j--
            }
            Intrinsics.rt(RtOp.sliceWrite, this.data, j, value, Types.vm_value)
        }
        return this
    }

    values() {
        return this[Symbol.iterator]()
    }

    keys() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: index }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }

    entries() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: [index, this.array[index]] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }

    static isArray(value: any): boolean {
        if (typeof value !== 'object' || value === null) return false
        return rt.hasPrototype(value, Array.prototype) !== 0
    }

    static from(source: any, mapFn?: (value: any, index: number) => any): Array {
        const out = new Array()
        if (source[Symbol.iterator] !== undefined) {
            for (const value of source) out.push(mapFn === undefined ? value : mapFn(value, out.length))
            return out
        }
        const length = source.length
        out.reserve(length)
        for (let i = 0; i < length; i++) out.push(mapFn === undefined ? source[i] : mapFn(source[i], i))
        return out
    }

    [Symbol.iterator]() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: this.array[index] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }
}

function spread(out: Array, value: any): void {
    if (!Array.isArray(value)) {
        out.push(value)
        return
    }
    for (let i = 0; i < value.length; i++) out.push(value[i])
}

function clampIndex(index: number, length: number): number {
    if (index < 0) return length + index < 0 ? 0 : length + index
    return index > length ? length : index
}

export const readElement = intrinsics.tagInline((array: any[], index: number): any => {
    if (!isNative()) return array[index]
    return Intrinsics.rt(RtOp.sliceRead, (array as any).data, index, Types.vm_value)
})

export const writeElement = intrinsics.tagInline((array: any[], index: number, value: any): void => {
    if (!isNative()) {
        array[index] = value
        return
    }
    Intrinsics.rt(RtOp.sliceWrite, (array as any).data, index, value, Types.vm_value)
})

function getIndex(this: Array, index: number): any {
    if (index >= this.length) return undefined
    return Intrinsics.rt(RtOp.sliceRead, this.data, index, Types.vm_value)
}

function setIndex(this: Array, index: number, value: any): void {
    if (index >= this.capacity) this.reserve(index * 2 + 4)
    Intrinsics.rt(RtOp.sliceWrite, this.data, index, value, Types.vm_value)
    if (index >= this.length) this.length = index + 1
}

Object.setPrototypeOf(Array.prototype, intrinsics.setIndexDescriptor({}, getIndex, setIndex))

function arrayLiteral(length: number): Array {
    const array = new Array()
    array.data = Intrinsics.rt(RtOp.slice, length, Types.vm_value)
    array.capacity = length
    array.length = length
    return array
}

function arrayElement(array: Array, index: number, value: any): void {
    Intrinsics.rt(RtOp.sliceWrite, array.data, index, value, Types.vm_value)
}

bind(RtOp.arrayLiteral, { impl: arrayLiteral })
bind(RtOp.arrayElement, { impl: arrayElement })

defineGlobal(Array)

export async function suite() {
    const harness = await import('../harness')
    function arrayAt(n: u32): number {
        const a = [7, n, 9]
        const outside = (a.at(n + 3) === undefined ? 1 : 0) + (a.at(-4 - n) === undefined ? 2 : 0)
        return a.at(-1) * 1000 + a.at(1) * 100 + a.at(n - 3) * 10 + outside
    }
    function arrayIndexOf(n: u32, k: u32): number {
        const a = [1, n, 3, n]
        return (a.indexOf(n, k - 2) + 1) * 100 + (a.indexOf(3) + 1) * 10 + a.indexOf(42) + 1
    }
    function arrayLastIndexOf(n: u32, k: u32): number {
        const a = [n, 1, n, 3]
        return (a.lastIndexOf(n, 0) + 1) * 1000 + (a.lastIndexOf(n, k - 3) + 1) * 100 + (a.lastIndexOf(n) + 1) * 10 + a.lastIndexOf(42) + 1
    }
    function arrayIncludes(n: u32, k: u32): number {
        const a = [1, n, 3]
        return (a.includes(n, k - 2) ? 100 : 0) + (a.includes(3) ? 10 : 0) + (a.includes(n + 5) ? 1 : 0)
    }
    function arrayFind(n: u32): number {
        const a = [n, n * 2, n * 3]
        const found = a.find(x => x > 2 * n)
        const missing = a.find(x => x > 3 * n)
        return (found === undefined ? 1000 : found) + (missing === undefined ? 1 : 0)
    }
    function arrayFindIndex(n: u32): number {
        const a = [n, n * 2, n * 3]
        return (a.findIndex(x => x > 2 * n) + 1) * 10 + a.findIndex(x => x > 3 * n) + 1
    }
    function arrayForEach(n: u32): number {
        const a = [n, n + 1, n + 2]
        let total = 0
        a.forEach((x, i) => {
            total = total + x * (i + 1)
        })
        return total
    }
    function arrayReduce(n: u32): number {
        const a: number[] = []
        for (let i = 0; i < n; i++) a.push(i + 1)
        const sum = a.reduce((acc, x) => acc + x, 100)
        const product = n > 0 ? a.reduce((acc, x) => acc * x) : 0
        const doubled = a.reduce((acc, x) => acc + x * 2, 0)
        return sum * 100000 + product * 100 + doubled
    }
    function arraySlice(n: u32, k: u32): number {
        const a = [n, n + 1, n + 2, n + 3]
        const b = a.slice(1, k)
        const c = a.slice(k - 6)
        const d = a.slice()
        d[0] = 9
        return a.slice(2, 0).length * 100000 + b.length * 10000 + (b.length ? b[0] : 0) * 1000 + c.length * 100 + c[0] * 10 + a[0]
    }
    function arrayFill(n: u32, k: u32): number {
        const a = [1, 2, 3, 4]
        a.fill(n, 1, k)
        a.fill(7, k - 6)
        a.fill(8, 0, 0)
        return a[0] * 1000 + a[1] * 100 + a[2] * 10 + a[3]
    }
    function arrayShift(n: u32): number {
        const a: number[] = []
        for (let i = 0; i < n; i++) a.push(i + 5)
        const first = a.shift()
        return (first === undefined ? 0 : first) * 100 + a.length * 10 + (a.length ? a[0] : 0)
    }
    function arrayIterators(n: u32): number {
        const a = [n, n + 1, n + 2]
        let total = 0
        for (const v of a.values()) total = total + v
        for (const i of a.keys()) total = total + i * 100
        for (const [i, v] of a.entries()) total = total + i * v * 1000
        return total
    }
    function arrayFromArray(n: u32): number {
        const a = Array.from([n, n + 1])
        return a.length * 100 + a[1]
    }
    function arrayFromSet(n: u32): number {
        const b = Array.from(new Set([n, n, n + 2]))
        return b.length * 100 + b[1]
    }
    function arrayFromLength(n: u32): number {
        const c = Array.from({ length: n }, (_, i) => i * 2)
        return c.length * 100 + (n ? c[n - 1] : 0)
    }
    function arrayFromMapped(n: u32): number {
        const d = Array.from([n, n + 1], x => x * 3)
        return d.length * 100 + d[1]
    }
    function arrayIsArray(n: u32): number {
        const a = [n]
        const o = { length: n }
        return (Array.isArray(a) ? 100 : 0) + (Array.isArray(o) ? 10 : 0) + (Array.isArray(n) ? 1 : 0)
    }
    function arrayHigherOrder(n: u32): number {
        const a = [n, n + 1, n + 2]
        const doubled = a.map(x => x * 2)
        const odd = a.filter(x => x % 2 === 1)
        return doubled[2] * 1000 + odd.length * 100 + (a.some(x => x > n + 1) ? 10 : 0) + (a.every(x => x > n) ? 1 : 0)
    }
    function arrayUnshift(n: u32): number {
        const a = [1, 2]
        const length = a.unshift(n, 9)
        const b: number[] = []
        b.unshift(n)
        return length * 10000 + a[0] * 1000 + a[1] * 100 + a[3] * 10 + b.length + a.unshift()
    }
    function arraySplice(n: u32, k: u32): number {
        const a = [1, 2, 3, 4, 5]
        const removed = a.splice(1, k)
        const b = [1, 2, 3]
        b.splice(1, 0, n, n + 1)
        const c = [1, 2, 3, 4]
        const tail = c.splice(k - 6)
        return a.length * 100000 + removed.length * 10000 + (removed.length ? removed[0] : 0) * 1000 + b.length * 100 + b[2] * 10 + tail.length + c.length
    }
    function arrayConcat(n: u32): number {
        const a = [1, n]
        const c = a.concat(3, 4, n + 5)
        return c.length * 1000 + c[1] * 100 + c[4] * 10 + a.length + a.concat().length * 10000
    }
    function arrayFlatMap(n: u32): number {
        const a = [1, n]
        const pairs = a.flatMap(x => [x, x * 2])
        const flat = a.flatMap(x => x + 1)
        return pairs.length * 1000 + pairs[3] * 100 + flat.length * 10 + flat[1]
    }
    harness.runCases({ prefix: 'Array', args: true }, [

        [arrayAt, [0], [1], [5]],
        [arrayIndexOf, [3, 2], [3, 4], [3, 1], [5, 0], [1, 2]],
        [arrayLastIndexOf, [3, 3], [3, 4], [3, 2], [3, 0], [1, 9]],
        [arrayIncludes, [3, 2], [3, 5], [3, 1], [8, 0]],
        [arrayFind, [1], [0], [4]],
        [arrayFindIndex, [1], [0], [4]],
        [arrayForEach, [0], [3]],
        [arrayReduce, [0], [1], [4]],
        [arraySlice, [3, 3], [3, 1], [3, 9], [3, 0]],
        [arrayFill, [5, 3], [5, 1], [5, 9], [5, 4]],
        [arrayShift, [1], [3]],
        // [arrayShift, [0]],
        [arrayIterators, [0], [2]],
        [arrayFromArray, [0], [3]],
        [arrayFromSet, [0], [3]],
        [arrayFromLength, [0], [3]],
        [arrayFromMapped, [0], [3]],
        [arrayIsArray, [0], [2]],
        [arrayHigherOrder, [0], [3]],
        [arrayUnshift, [0], [7]],
        [arraySplice, [3, 2], [3, 0], [3, 9], [3, 4]],
        [arrayConcat, [0], [3]],
        [arrayFlatMap, [0], [3]],
    ])
}
