/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { Op as RtOp, bind, rt } from '../rt'
import { allocate } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Array {
    declare length: number
    declare capacity: number
    declare data: number

    constructor() {
        this.length = 0
        this.capacity = 0
        this.data = 0
    }

    reserve(capacity: number): void {
        // FIXME: Error needs to be a builtin
        // intrinsics.assert(capacity > this.capacity || capacity === 0)
        const data = allocate(capacity * 4)
        for (let i = 0; i < this.length; i++) {
            Intrinsics.store(data, i * 4, Intrinsics.load(this.data, i * 4, Types.vm_value), Types.vm_value)
        }
        this.data = data
        this.capacity = capacity
    }

    push(value: any): number {
        const index = this.length
        if (index >= this.capacity) this.reserve(index * 2 + 4)
        Intrinsics.store(this.data, index * 4, value, Types.vm_value)
        this.length = index + 1
        return index + 1
    }

    pop(): any {
        const index = this.length
        if (index === 0) return undefined
        this.length = index - 1
        return Intrinsics.load(this.data, (index - 1) * 4, Types.vm_value)
    }

    at(index: number): any {
        const at = index < 0 ? this.length + index : index
        if (at < 0 || at >= this.length) return undefined
        return Intrinsics.load(this.data, at * 4, Types.vm_value)
    }

    shift(): any {
        const length = this.length
        if (length === 0) return undefined
        const first = Intrinsics.load(this.data, 0, Types.vm_value)
        for (let i = 1; i < length; i++) {
            Intrinsics.store(this.data, (i - 1) * 4, Intrinsics.load(this.data, i * 4, Types.vm_value), Types.vm_value)
        }
        this.length = length - 1
        return first
    }

    indexOf(value: any, fromIndex?: number): number {
        const start = fromIndex === undefined ? 0 : clampIndex(fromIndex, this.length)
        for (let i = start; i < this.length; i++) {
            if (Intrinsics.load(this.data, i * 4, Types.vm_value) === value) return i
        }
        return -1
    }

    lastIndexOf(value: any, fromIndex?: number): number {
        let i = this.length
        if (fromIndex !== undefined) {
            const last = fromIndex < 0 ? this.length + fromIndex : fromIndex
            if (last < 0) return -1
            if (last < i) i = last + 1
        }
        while (i > 0) {
            i--
            if (Intrinsics.load(this.data, i * 4, Types.vm_value) === value) return i
        }
        return -1
    }

    includes(value: any, fromIndex?: number): boolean {
        const start = fromIndex === undefined ? 0 : clampIndex(fromIndex, this.length)
        for (let i = start; i < this.length; i++) {
            if (Intrinsics.load(this.data, i * 4, Types.vm_value) === value) return true
        }
        return false
    }

    find(predicate: (value: any, index: number, array: Array) => boolean): any {
        for (let i = 0; i < this.length; i++) {
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            if (predicate(value, i, this)) return value
        }
        return undefined
    }

    findIndex(predicate: (value: any, index: number, array: Array) => boolean): number {
        for (let i = 0; i < this.length; i++) {
            if (predicate(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)) return i
        }
        return -1
    }

    forEach(fn: (value: any, index: number, array: Array) => void): void {
        for (let i = 0; i < this.length; i++) fn(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)
    }

    reduce(fn: (acc: any, value: any, index: number, array: Array) => any, initial?: any): any {
        let acc = initial
        let i = 0
        if (initial === undefined) {
            if (this.length === 0) throw 'Reduce of empty array with no initial value'
            acc = Intrinsics.load(this.data, 0, Types.vm_value)
            i = 1
        }
        while (i < this.length) {
            acc = fn(acc, Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)
            i++
        }
        return acc
    }

    slice(start?: number, end?: number): Array {
        const length = this.length
        const from = start === undefined ? 0 : clampIndex(start, length)
        const to = end === undefined ? length : clampIndex(end, length)
        const out = arrayLiteral(to > from ? to - from : 0)
        for (let i = 0; i < out.length; i++) {
            Intrinsics.store(out.data, i * 4, Intrinsics.load(this.data, (from + i) * 4, Types.vm_value), Types.vm_value)
        }
        return out
    }

    fill(value: any, start?: number, end?: number): this {
        const length = this.length
        const from = start === undefined ? 0 : clampIndex(start, length)
        const to = end === undefined ? length : clampIndex(end, length)
        for (let i = from; i < to; i++) Intrinsics.store(this.data, i * 4, value, Types.vm_value)
        return this
    }

    some(predicate: (value: any, index: number, array: Array) => boolean): boolean {
        for (let i = 0; i < this.length; i++) {
            if (predicate(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)) return true
        }
        return false
    }

    every(predicate: (value: any, index: number, array: Array) => boolean): boolean {
        for (let i = 0; i < this.length; i++) {
            if (!predicate(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)) return false
        }
        return true
    }

    filter(predicate: (value: any, index: number, array: Array) => boolean): Array {
        const out = new Array()
        for (let i = 0; i < this.length; i++) {
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            if (predicate(value, i, this)) out.push(value)
        }
        return out
    }

    map(fn: (value: any, index: number, array: Array) => any): Array {
        const out = new Array()
        out.reserve(this.length)
        for (let i = 0; i < this.length; i++) out.push(fn(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this))
        return out
    }

    reverse(): this {
        for (let i = 0, j = this.length - 1; i < j; i++, j--) {
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            Intrinsics.store(this.data, i * 4, Intrinsics.load(this.data, j * 4, Types.vm_value), Types.vm_value)
            Intrinsics.store(this.data, j * 4, value, Types.vm_value)
        }
        return this
    }

    join(separator?: string): string {
        const sep = separator === undefined ? ',' : separator
        let out = ''
        for (let i = 0; i < this.length; i++) {
            if (i > 0) out += sep
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            if (value !== undefined && value !== null) out += value
        }
        return out
    }

    sort(compare: (a: any, b: any) => number): this {
        for (let i = 1; i < this.length; i++) {
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            let j = i
            while (j > 0 && Intrinsics.convert(compare(Intrinsics.load(this.data, (j - 1) * 4, Types.vm_value), value), Types.u64, Types.i64) > 0) {
                Intrinsics.store(this.data, j * 4, Intrinsics.load(this.data, (j - 1) * 4, Types.vm_value), Types.vm_value)
                j--
            }
            Intrinsics.store(this.data, j * 4, value, Types.vm_value)
        }
        return this
    }

    values() {
        return this[Symbol.iterator]()
    }

    keys() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: index }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }

    entries() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: [index, this.array[index]] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }

    static isArray(value: any): boolean {
        if (typeof value !== 'object' || value === null) return false
        return rt.hasPrototype(value, Array.prototype) !== 0
    }

    static from(source: any, mapFn?: (value: any, index: number) => any): Array {
        const out = new Array()
        if (source[Symbol.iterator] !== undefined) {
            for (const value of source) out.push(mapFn === undefined ? value : mapFn(value, out.length))
            return out
        }
        const length = source.length
        out.reserve(length)
        for (let i = 0; i < length; i++) out.push(mapFn === undefined ? source[i] : mapFn(source[i], i))
        return out
    }

    [Symbol.iterator]() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: this.array[index] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }
}

function clampIndex(index: number, length: number): number {
    if (index < 0) return length + index < 0 ? 0 : length + index
    return index > length ? length : index
}

function getIndex(this: Array, index: number): any {
    if (index >= this.length) return undefined
    return Intrinsics.load(this.data, index * 4, Types.vm_value)
}

function setIndex(this: Array, index: number, value: any): void {
    if (index >= this.capacity) this.reserve(index * 2 + 4)
    Intrinsics.store(this.data, index * 4, value, Types.vm_value)
    if (index >= this.length) this.length = index + 1
}

Object.setPrototypeOf(Array.prototype, intrinsics.setIndexDescriptor({}, getIndex, setIndex))

function arrayLiteral(length: number): Array {
    const array = new Array()
    array.data = allocate(length * 4)
    array.capacity = length
    array.length = length
    return array
}

function arrayElement(array: Array, index: number, value: any): void {
    Intrinsics.store(array.data, index * 4, value, Types.vm_value)
}

bind(RtOp.arrayLiteral, { impl: arrayLiteral })
bind(RtOp.arrayElement, { impl: arrayElement })

defineGlobal(Array)

export async function suite() {
    const harness = await import('../harness')
    function arrayAt(n: u32): number {
        const a = [7, n, 9]
        const outside = (a.at(n + 3) === undefined ? 1 : 0) + (a.at(-4 - n) === undefined ? 2 : 0)
        return a.at(-1) * 1000 + a.at(1) * 100 + a.at(n - 3) * 10 + outside
    }
    function arrayIndexOf(n: u32, k: u32): number {
        const a = [1, n, 3, n]
        return (a.indexOf(n, k - 2) + 1) * 100 + (a.indexOf(3) + 1) * 10 + a.indexOf(42) + 1
    }
    function arrayLastIndexOf(n: u32, k: u32): number {
        const a = [n, 1, n, 3]
        return (a.lastIndexOf(n, 0) + 1) * 1000 + (a.lastIndexOf(n, k - 3) + 1) * 100 + (a.lastIndexOf(n) + 1) * 10 + a.lastIndexOf(42) + 1
    }
    function arrayIncludes(n: u32, k: u32): number {
        const a = [1, n, 3]
        return (a.includes(n, k - 2) ? 100 : 0) + (a.includes(3) ? 10 : 0) + (a.includes(n + 5) ? 1 : 0)
    }
    function arrayFind(n: u32): number {
        const a = [n, n * 2, n * 3]
        const found = a.find(x => x > 2 * n)
        const missing = a.find(x => x > 3 * n)
        return (found === undefined ? 1000 : found) + (missing === undefined ? 1 : 0)
    }
    function arrayFindIndex(n: u32): number {
        const a = [n, n * 2, n * 3]
        return (a.findIndex(x => x > 2 * n) + 1) * 10 + a.findIndex(x => x > 3 * n) + 1
    }
    function arrayForEach(n: u32): number {
        const a = [n, n + 1, n + 2]
        let total = 0
        a.forEach((x, i) => {
            total = total + x * (i + 1)
        })
        return total
    }
    function arrayReduce(n: u32): number {
        const a: number[] = []
        for (let i = 0; i < n; i++) a.push(i + 1)
        const sum = a.reduce((acc, x) => acc + x, 100)
        const product = n > 0 ? a.reduce((acc, x) => acc * x) : 0
        const doubled = a.reduce((acc, x) => acc + x * 2, 0)
        return sum * 100000 + product * 100 + doubled
    }
    function arraySlice(n: u32, k: u32): number {
        const a = [n, n + 1, n + 2, n + 3]
        const b = a.slice(1, k)
        const c = a.slice(k - 6)
        const d = a.slice()
        d[0] = 9
        return a.slice(2, 0).length * 100000 + b.length * 10000 + (b.length ? b[0] : 0) * 1000 + c.length * 100 + c[0] * 10 + a[0]
    }
    function arrayFill(n: u32, k: u32): number {
        const a = [1, 2, 3, 4]
        a.fill(n, 1, k)
        a.fill(7, k - 6)
        a.fill(8, 0, 0)
        return a[0] * 1000 + a[1] * 100 + a[2] * 10 + a[3]
    }
    function arrayShift(n: u32): number {
        const a: number[] = []
        for (let i = 0; i < n; i++) a.push(i + 5)
        const first = a.shift()
        return (first === undefined ? 0 : first) * 100 + a.length * 10 + (a.length ? a[0] : 0)
    }
    function arrayIterators(n: u32): number {
        const a = [n, n + 1, n + 2]
        let total = 0
        for (const v of a.values()) total = total + v
        for (const i of a.keys()) total = total + i * 100
        for (const [i, v] of a.entries()) total = total + i * v * 1000
        return total
    }
    function arrayFromArray(n: u32): number {
        const a = Array.from([n, n + 1])
        return a.length * 100 + a[1]
    }
    function arrayFromSet(n: u32): number {
        const b = Array.from(new Set([n, n, n + 2]))
        return b.length * 100 + b[1]
    }
    function arrayFromLength(n: u32): number {
        const c = Array.from({ length: n }, (_, i) => i * 2)
        return c.length * 100 + (n ? c[n - 1] : 0)
    }
    function arrayFromMapped(n: u32): number {
        const d = Array.from([n, n + 1], x => x * 3)
        return d.length * 100 + d[1]
    }
    function arrayIsArray(n: u32): number {
        const a = [n]
        const o = { length: n }
        return (Array.isArray(a) ? 100 : 0) + (Array.isArray(o) ? 10 : 0) + (Array.isArray(n) ? 1 : 0)
    }
    function arrayHigherOrder(n: u32): number {
        const a = [n, n + 1, n + 2]
        const doubled = a.map(x => x * 2)
        const odd = a.filter(x => x % 2 === 1)
        return doubled[2] * 1000 + odd.length * 100 + (a.some(x => x > n + 1) ? 10 : 0) + (a.every(x => x > n) ? 1 : 0)
    }
    harness.runCases({ prefix: 'Array', args: true }, [
        [arrayAt, [0], [1], [5]],
        [arrayIndexOf, [3, 2], [3, 4], [3, 1], [5, 0], [1, 2]],
        [arrayLastIndexOf, [3, 3], [3, 4], [3, 2], [3, 0], [1, 9]],
        [arrayIncludes, [3, 2], [3, 5], [3, 1], [8, 0]],
        [arrayFind, [1], [0], [4]],
        [arrayFindIndex, [1], [0], [4]],
        [arrayForEach, [0], [3]],
        [arrayReduce, [0], [1], [4]],
        [arraySlice, [3, 3], [3, 1], [3, 9], [3, 0]],
        [arrayFill, [5, 3], [5, 1], [5, 9], [5, 4]],
        [arrayShift, [1], [3]],
        // [arrayShift, [0]],
        [arrayIterators, [0], [2]],
        [arrayFromArray, [0], [3]],
        [arrayFromSet, [0], [3]],
        [arrayFromLength, [0], [3]],
        [arrayFromMapped, [0], [3]],
        [arrayIsArray, [0], [2]],
        [arrayHigherOrder, [0], [3]],
    ])
}
