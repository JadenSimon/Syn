/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { allocate } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Array {
    declare length: number
    declare capacity: number
    declare data: number

    constructor() {
        this.length = 0
        this.capacity = 0
        this.data = 0
    }

    reserve(capacity: number): void {
        if (capacity <= this.capacity) return
        const data = allocate(capacity * 4)
        for (let i = 0; i < this.length; i++) {
            Intrinsics.store(data, i * 4, Intrinsics.load(this.data, i * 4, Types.vm_value), Types.vm_value)
        }
        this.data = data
        this.capacity = capacity
    }

    push(value: any): number {
        const index = this.length
        if (index >= this.capacity) this.reserve(index * 2 + 4)
        Intrinsics.store(this.data, index * 4, value, Types.vm_value)
        this.length = index + 1
        return index + 1
    }

    [Symbol.iterator]() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: this.array[index] }
            },
        }
    }
}

function getIndex(self: Array, index: number): any {
    if (index >= self.length) return undefined
    return Intrinsics.load(self.data, index * 4, Types.vm_value)
}

function setIndex(self: Array, index: number, value: any): void {
    if (index >= self.capacity) self.reserve(index * 2 + 4)
    Intrinsics.store(self.data, index * 4, value, Types.vm_value)
    if (index >= self.length) self.length = index + 1
}

Object.setPrototypeOf(Array.prototype, intrinsics.setIndexDescriptor({}, getIndex, setIndex))

defineGlobal(Array)
