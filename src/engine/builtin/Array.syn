/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'
import { Op as RtOp, bindRuntime } from '../rt'
import { allocate } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export class Array {
    declare length: number
    declare capacity: number
    declare data: number

    constructor() {
        this.length = 0
        this.capacity = 0
        this.data = 0
    }

    reserve(capacity: number): void {
        if (capacity <= this.capacity) return
        const data = allocate(capacity * 4)
        for (let i = 0; i < this.length; i++) {
            Intrinsics.store(data, i * 4, Intrinsics.load(this.data, i * 4, Types.vm_value), Types.vm_value)
        }
        this.data = data
        this.capacity = capacity
    }

    push(value: any): number {
        const index = this.length
        if (index >= this.capacity) this.reserve(index * 2 + 4)
        Intrinsics.store(this.data, index * 4, value, Types.vm_value)
        this.length = index + 1
        return index + 1
    }

    pop(): any {
        const index = this.length
        if (index === 0) return undefined
        this.length = index - 1
        return Intrinsics.load(this.data, (index - 1) * 4, Types.vm_value)
    }

    some(predicate: (value: any, index: number, array: Array) => boolean): boolean {
        for (let i = 0; i < this.length; i++) {
            if (predicate(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)) return true
        }
        return false
    }

    every(predicate: (value: any, index: number, array: Array) => boolean): boolean {
        for (let i = 0; i < this.length; i++) {
            if (!predicate(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this)) return false
        }
        return true
    }

    filter(predicate: (value: any, index: number, array: Array) => boolean): Array {
        const out = new Array()
        for (let i = 0; i < this.length; i++) {
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            if (predicate(value, i, this)) out.push(value)
        }
        return out
    }

    map(fn: (value: any, index: number, array: Array) => any): Array {
        const out = new Array()
        out.reserve(this.length)
        for (let i = 0; i < this.length; i++) out.push(fn(Intrinsics.load(this.data, i * 4, Types.vm_value), i, this))
        return out
    }

    sort(compare: (a: any, b: any) => number): this {
        for (let i = 1; i < this.length; i++) {
            const value = Intrinsics.load(this.data, i * 4, Types.vm_value)
            let j = i
            while (j > 0 && Intrinsics.convert(compare(Intrinsics.load(this.data, (j - 1) * 4, Types.vm_value), value), Types.u64, Types.i64) > 0) {
                Intrinsics.store(this.data, j * 4, Intrinsics.load(this.data, (j - 1) * 4, Types.vm_value), Types.vm_value)
                j--
            }
            Intrinsics.store(this.data, j * 4, value, Types.vm_value)
        }
        return this
    }

    [Symbol.iterator]() {
        return {
            array: this as any,
            index: 0,
            next() {
                const index = this.index
                if (index >= this.array.length) return { done: true }
                this.index = index + 1
                return { done: false, value: this.array[index] }
            },
            [Symbol.iterator]() {
                return this
            },
        }
    }
}

function getIndex(this: Array, index: number): any {
    if (index >= this.length) return undefined
    return Intrinsics.load(this.data, index * 4, Types.vm_value)
}

function setIndex(this: Array, index: number, value: any): void {
    if (index >= this.capacity) this.reserve(index * 2 + 4)
    Intrinsics.store(this.data, index * 4, value, Types.vm_value)
    if (index >= this.length) this.length = index + 1
}

Object.setPrototypeOf(Array.prototype, intrinsics.setIndexDescriptor({}, getIndex, setIndex))

function arrayLiteral(length: number): Array {
    const array = new Array()
    array.data = allocate(length * 4)
    array.capacity = length
    array.length = length
    return array
}

function arrayElement(array: Array, index: number, value: any): void {
    Intrinsics.store(array.data, index * 4, value, Types.vm_value)
}

bindRuntime(RtOp.arrayLiteral, arrayLiteral)
bindRuntime(RtOp.arrayElement, arrayElement)

defineGlobal(Array)
