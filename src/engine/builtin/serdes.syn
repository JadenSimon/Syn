/// @synth

"use wrapped";

import * as heap from '../heap'

heap.attachSerializer(RegExp.prototype, function(this: RegExp) {
    const source = this.source
    const flags = this.flags
    return () => new RegExp(source, flags)
})

heap.attachSerializer(Map.prototype, function(this: Map<any, any>) {
    const entries = [...this.entries()]
    return () => {
        const map = new Map()
        for (let i = 0; i < entries.length; i++) map.set(entries[i][0], entries[i][1])
        return map
    }
})

heap.attachSerializer(Set.prototype, function(this: Set<any>) {
    const values = [...this.values()]
    return () => new Set(values)
})

heap.attachSerializer(Uint8Array.prototype, function(this: Uint8Array) {
    const values = Array.from(this)
    return () => {
        const out = new Uint8Array(values.length)
        for (let i = 0; i < values.length; i++) out[i] = values[i]
        return out
    }
})

heap.attachSerializer(Uint32Array.prototype, function(this: Uint32Array) {
    const values = Array.from(this)
    return () => {
        const out = new Uint32Array(values.length)
        for (let i = 0; i < values.length; i++) out[i] = values[i]
        return out
    }
})

heap.attachSerializer(Int32Array.prototype, function(this: Int32Array) {
    const values = Array.from(this)
    return () => {
        const out = new Int32Array(values.length)
        for (let i = 0; i < values.length; i++) out[i] = values[i]
        return out
    }
})

heap.attachSerializer(Float64Array.prototype, function(this: Float64Array) {
    const values = Array.from(this)
    return () => {
        const out = new Float64Array(values.length)
        for (let i = 0; i < values.length; i++) out[i] = values[i]
        return out
    }
})

heap.attachSerializer(DataView.prototype, function(this: DataView) {
    const bytes = Array.from(new Uint8Array(this.buffer, this.byteOffset, this.byteLength))
    return () => {
        const view = new DataView(new ArrayBuffer(bytes.length))
        for (let i = 0; i < bytes.length; i++) view.setUint8(i, bytes[i])
        return view
    }
})
