/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { bind, Op as RtOp } from '../rt'
import { defineGlobal } from './globals'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

function trunc(value: number): number {
    if (Intrinsics.typeof(value) !== Types.f64) return value
    return Intrinsics.convert(Intrinsics.convert(value, Types.f64, Types.i64), Types.i64, Types.f64)
}

export const Math = {
    max(...values: number[]): number {
        const count = values.length
        if (count === 2) return values[0] > values[1] ? values[0] : values[1]
        let out = count ? values[0] : -Infinity
        let i = 1
        while (i < count) {
            const value = values[i]
            out = value > out ? value : out
            i++
        }
        return out
    },
    min(...values: number[]): number {
        const count = values.length
        if (count === 2) return values[0] < values[1] ? values[0] : values[1]
        let out = count ? values[0] : Infinity
        let i = 1
        while (i < count) {
            const value = values[i]
            out = value < out ? value : out
            i++
        }
        return out
    },
    abs(value: number): number {
        return value < 0 ? -value : value
    },
    trunc,
    floor(value: number): number {
        const t = trunc(value)
        return t > value ? t - 1 : t
    },
    ceil(value: number): number {
        const t = trunc(value)
        return t < value ? t + 1 : t
    },
    round(value: number): number {
        const t = trunc(value + 0.5)
        return t > value + 0.5 ? t - 1 : t
    },
    pow(base: number, exponent: number): number {
        return base ** exponent
    },
    sign(value: number): number {
        if (value > 0) return 1
        if (value < 0) return -1
        return value
    },
    clz32(value: number): number {
        let bits = trunc(value) & 0xFFFFFFFF
        if (bits === 0) return 32
        let count = 0
        while (bits < 0x80000000) {
            bits = bits * 2
            count++
        }
        return count
    },
    log2(value: number): number {
        const x = Intrinsics.typeof(value) === Types.f64 ? value : Intrinsics.convert(value, Types.i64, Types.f64)
        if (x !== x || x < 0) return NaN
        if (x === 0) return -Infinity
        if (x === Infinity) return Infinity
        let exponent = 0
        let m = x
        while (m >= 2) {
            m = m / 2
            exponent++
        }
        while (m < 1) {
            m = m * 2
            exponent--
        }
        if (m === 1) return exponent
        const t = (m - 1) / (m + 1)
        const t2 = t * t
        let term = t
        let sum = 0
        let k = 1
        while (k < 61) {
            sum = sum + term / k
            term = term * t2
            k = k + 2
        }
        return exponent + sum * 2.8853900817779268
    },
    imul(a: number, b: number): number {
        const product = (trunc(a) * trunc(b)) & 0xFFFFFFFF
        return product >= 0x80000000 ? product - 0x100000000 : product
    },
}

function float(value: number): number {
    if (Intrinsics.typeof(value) === Types.f64) return value
    return Intrinsics.convert(value, Types.i64, Types.f64)
}

function integralPower(base: number, exponent: number): number {
    let n = exponent < 0 ? 0 - exponent : exponent
    let result = float(1)
    let x = float(base)
    while (n > 0) {
        if (Intrinsics.and(n, 1, Types.i64) !== 0) result = result * x
        x = x * x
        n = Intrinsics.shr(n, 1, Types.i64)
    }
    return exponent < 0 ? 1 / result : result
}

function exp2(t: number): number {
    if (t >= 1024) return Infinity
    if (t < -1100) return 0
    let k = Intrinsics.convert(t, Types.f64, Types.i64)
    let f = t - float(k)
    if (f > 0.5) {
        f = f - 1
        k = k + 1
    }
    if (f < -0.5) {
        f = f + 1
        k = k - 1
    }
    const z = f * 0.6931471805599453
    let term = float(1)
    let sum = term
    let i = 1
    while (i < 18) {
        term = term * z / i
        sum = sum + term
        i++
    }
    while (k > 0) {
        sum = sum * 2
        k--
    }
    while (k < 0) {
        sum = sum * 0.5
        k++
    }
    return sum
}

function exponentiate(base: number, exponent: number): number {
    if (Intrinsics.typeof(exponent) !== Types.f64) return integralPower(base, exponent)
    const x = float(base)
    const y = exponent
    if (y !== y) return NaN
    const small = y > -9007199254740992 && y < 9007199254740992
    if (small && trunc(y) === y) return integralPower(x, Intrinsics.convert(y, Types.f64, Types.i64))
    if (x !== x) return NaN
    const magnitude = x < 0 ? -x : x
    if (y === Infinity || y === -Infinity) {
        if (magnitude === 1) return NaN
        if (magnitude > 1) return y > 0 ? Infinity : 0
        return y > 0 ? 0 : Infinity
    }
    if (small && x < 0) return NaN
    if (magnitude === Infinity) return y > 0 ? Infinity : 0
    if (magnitude === 0) return y > 0 ? 0 : Infinity
    return exp2(y * Math.log2(magnitude))
}

function remainder(dividend: number, divisor: number): number {
    const x = float(dividend)
    const y = float(divisor)
    if (x !== x || y !== y || y === 0 || x === Infinity || x === -Infinity) return NaN
    if (y === Infinity || y === -Infinity) return x
    const d = y < 0 ? -y : y
    let r = x < 0 ? -x : x
    if (r < d) return x
    if (r < 9007199254740992 && trunc(r) === r && trunc(d) === d) {
        const whole = float(Intrinsics.rem(Intrinsics.convert(r, Types.f64, Types.i64), Intrinsics.convert(d, Types.f64, Types.i64)))
        return x < 0 ? -whole : whole
    }
    let s = d
    while (s <= r * 0.5) {
        s = s * 2
    }
    while (s >= d) {
        if (r >= s) r = r - s
        s = s * 0.5
    }
    return x < 0 ? -r : r
}

bind(RtOp.exp, { impl: exponentiate })
bind(RtOp.mod, { impl: remainder })

defineGlobal(Math, 'Math')

export async function suite() {
    const harness = await import('../harness')
    function mathMinMax(n: u32, k: u32): number {
        return Math.max(n, k) * 1000 + Math.min(n, k) * 100 + Math.abs(n - k) * 10 + Math.max(n - 5, 0)
    }
    function mathRounding(n: u32): number {
        const x = n + 0.5
        const y = n + 0.25
        return Math.floor(x) * 1000 + Math.ceil(y) * 100 + Math.round(x) * 10 + Math.round(y) + Math.trunc(x)
    }
    function mathRoundNegative(n: u32): number {
        return Math.round(0.5 - n) + Math.floor(0.5 - n) * 10 + Math.ceil(0.5 - n) * 100 + 1000
    }
    function mathPow(n: u32): number {
        return Math.pow(2, n) + Math.pow(n, 2) * 1000
    }
    function mathSign(n: u32): number {
        return Math.sign(n) * 100 + Math.sign(3 - n) * 10 + Math.sign(n - n)
    }
    function mathClz32(n: u32): number {
        return Math.clz32(n) * 10000 + Math.clz32(n * 4096) * 100 + Math.clz32(0 - n)
    }
    function mathImul(n: u32): number {
        return Math.imul(n, 3) + Math.imul(n * 65536, n * 65536 + 1) * 10 + Math.imul(0 - n, 7) * 1000
    }
    function mathLog2(n: u32): number {
        return Math.log2(n * 8) * 10 + Math.ceil(Math.log2(n + 1)) * 1000 + (Math.log2(n + 0.5) > 1 ? 7 : 3)
    }
    harness.runCases({ prefix: 'Math', args: true }, [
        [mathLog2, [1], [3], [64], [1000]],
        [mathMinMax, [3, 7], [9, 2], [4, 4]],
        [mathRounding, [0], [3]],
        [mathRoundNegative, [0], [3]],
        [mathPow, [0], [5]],
        [mathSign, [0], [2], [5]],
        [mathClz32, [0], [1], [300], [65535]],
        [mathImul, [0], [3], [40000]],
    ])
}
