/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

function trunc(value: number): number {
    if (Intrinsics.typeof(value) !== Types.f64) return value
    return Intrinsics.convert(Intrinsics.convert(value, Types.f64, Types.i64), Types.i64, Types.f64)
}

export const Math = {
    max(...values: number[]): number {
        const count = values.length
        if (count === 2) return values[0] > values[1] ? values[0] : values[1]
        let out = count ? values[0] : -Infinity
        let i = 1
        while (i < count) {
            const value = values[i]
            out = value > out ? value : out
            i++
        }
        return out
    },
    min(...values: number[]): number {
        const count = values.length
        if (count === 2) return values[0] < values[1] ? values[0] : values[1]
        let out = count ? values[0] : Infinity
        let i = 1
        while (i < count) {
            const value = values[i]
            out = value < out ? value : out
            i++
        }
        return out
    },
    abs(value: number): number {
        return value < 0 ? -value : value
    },
    trunc,
    floor(value: number): number {
        const t = trunc(value)
        return t > value ? t - 1 : t
    },
    ceil(value: number): number {
        const t = trunc(value)
        return t < value ? t + 1 : t
    },
    round(value: number): number {
        const t = trunc(value + 0.5)
        return t > value + 0.5 ? t - 1 : t
    },
    pow(base: number, exponent: number): number {
        return base ** exponent
    },
}

defineGlobal(Math, 'Math')

export async function suite() {
    const harness = await import('../harness')
    function mathMinMax(n: u32, k: u32): number {
        return Math.max(n, k) * 1000 + Math.min(n, k) * 100 + Math.abs(n - k) * 10 + Math.max(n - 5, 0)
    }
    function mathRounding(n: u32): number {
        const x = n + 0.5
        const y = n + 0.25
        return Math.floor(x) * 1000 + Math.ceil(y) * 100 + Math.round(x) * 10 + Math.round(y) + Math.trunc(x)
    }
    function mathRoundNegative(n: u32): number {
        return Math.round(0.5 - n) + Math.floor(0.5 - n) * 10 + Math.ceil(0.5 - n) * 100 + 1000
    }
    function mathPow(n: u32): number {
        return Math.pow(2, n) + Math.pow(n, 2) * 1000
    }
    harness.runCases({ prefix: 'Math', args: true }, [
        [mathMinMax, [3, 7], [9, 2], [4, 4]],
        [mathRounding, [0], [3]],
        [mathRoundNegative, [0], [3]],
        [mathPow, [0], [5]],
    ])
}
