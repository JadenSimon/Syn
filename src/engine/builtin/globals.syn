export const globals: Record<string, any> = {}

export function defineGlobal<T extends { name: string }>(value: T, name?: string): void
export function defineGlobal<T>(value: T, name: string): void
export function defineGlobal(value: any, name: string = value.name): void {
    if (name in globals) throw new Error(`Global already defined: ${name}`)
    globals[name] = value
}
