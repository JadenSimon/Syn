/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { defineGlobal } from './globals'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

function BigInt(value: any): u64 {
    return value as u64
}

function asUintN(bits: number, value: u64): u64 {
    if (bits >= 64) return value
    return value & ((BigInt(1) << BigInt(bits)) - BigInt(1))
}

function asIntN(bits: number, value: u64): i64 {
    const unsigned = Intrinsics.convert(asUintN(bits, value), Types.u64, Types.i64)
    if (bits >= 64 || unsigned < Intrinsics.convert(BigInt(1) << BigInt(bits - 1), Types.u64, Types.i64)) return unsigned
    return unsigned - Intrinsics.convert(BigInt(1) << BigInt(bits), Types.u64, Types.i64)
}

BigInt.asUintN = asUintN
BigInt.asIntN = asIntN

defineGlobal(BigInt)

export async function suite() {
    const harness = await import('../harness')
    function bigIntShift(n: u32): number {
        return Number(BigInt(n) << BigInt(3)) + Number(BigInt(n * 64) >> BigInt(2))
    }
    function bigIntArith(n: u32): number {
        const big = BigInt(n)
        return Number(big * BigInt(1000) + (big & BigInt(6)) + (big | BigInt(1)))
    }
    function bigIntWrap(n: u32): number {
        const low = Number(BigInt.asUintN(32, BigInt(n - 7)))
        const signed = Number(BigInt.asIntN(64, BigInt(n) ^ BigInt(-1)))
        const narrow = Number(BigInt.asIntN(8, BigInt(n * 50)))
        return low + signed * 1000 + narrow * 7
    }
    harness.runCases({ prefix: 'BigInt', args: true }, [
        [bigIntShift, [5], [0]],
        [bigIntArith, [5], [2]],
        [bigIntWrap, [5], [2]],
    ])
}
