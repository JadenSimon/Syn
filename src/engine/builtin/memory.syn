/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import { rt, bind, bindImpl, Op as RtOp } from '../rt'
import { mmap, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANON } from '../syscalls'
import { readElement, writeElement } from './Array'

const Intrinsics = intrinsics.Intrinsics

type RawPtr = intrinsics.RawPtr

export const programStack = 0
export const wildcardStack = -1
export const stackCount = intrinsics.pstackCount

export const allocate = intrinsics.tagInline(function allocate(bytes: u32): u32 {
    return Intrinsics.pstack(wildcardStack, 0, bytes)
})

export function programStackTop(): u32 {
    return Intrinsics.pstack(programStack, 0, 0)
}

export function releaseProgramStack(top: u32): void {
    Intrinsics.pstack(programStack, top, 0)
}

const Types = intrinsics.Types

const chunkBytes = 1 << 16
const headBytes = 2 * 8 + 32 * 8
let hostHeads: RawPtr = 0

const leadingZeros = intrinsics.tagInline(function leadingZeros(value: u32): u32 {
    return intrinsics.isNative() ? Intrinsics.rt(RtOp.clz32, value) : Math.clz32(value)
})

const blockIndex = intrinsics.tagInline(function blockIndex(bytes: u32): u32 {
    return bytes <= 16 ? 0 : (28 - leadingZeros(bytes - 1)) & 31
})

export const blockBytes = intrinsics.tagInline(function blockBytes(bytes: u32): u32 {
    return 16 << blockIndex(bytes)
})

export const allocateBlock = intrinsics.tagNoInline(function allocateBlock(bytes: u32): RawPtr {
    const heads = Intrinsics.rt(RtOp.slabHeads) as RawPtr
    const index = blockIndex(bytes)
    const size = 16 << index
    const at = heads + 16 + index * 8
    let head = Intrinsics.load(at, 0, Types.u64)
    if (!head) {
        const span = size > chunkBytes ? size : chunkBytes
        // XXX: a failed mmap returns -1, and the first write through it faults
        head = intrinsics.isNative() ? mmap(0, span, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1 as any, 0) : Intrinsics.alloc(span)
        const last = head + span - size
        let block = head
        while (block < last) {
            Intrinsics.store(block, 0, block + size, Types.u64)
            block = block + size
        }
        Intrinsics.store(last, 0, 0, Types.u64)
    }
    Intrinsics.store(at, 0, Intrinsics.load(head, 0, Types.u64), Types.u64)
    const live = Intrinsics.load(heads, 0, Types.u64) + size
    Intrinsics.store(heads, 0, live, Types.u64)
    if (live > Intrinsics.load(heads, 8, Types.u64)) Intrinsics.store(heads, 8, live, Types.u64)
    return head
})

export const freeBlock = intrinsics.tagNoInline(function freeBlock(ptr: RawPtr, bytes: u32): void {
    if (!ptr) return
    const heads = Intrinsics.rt(RtOp.slabHeads) as RawPtr
    const index = blockIndex(bytes)
    const at = heads + 16 + index * 8
    Intrinsics.store(ptr, 0, Intrinsics.load(at, 0, Types.u64), Types.u64)
    Intrinsics.store(at, 0, ptr, Types.u64)
    Intrinsics.store(heads, 0, Intrinsics.load(heads, 0, Types.u64) - (16 << index), Types.u64)
})

bind(RtOp.slabHeads, { host: (): RawPtr => hostHeads ||= Intrinsics.alloc(headBytes) })
bindImpl(RtOp.malloc, allocateBlock)
bindImpl(RtOp.mfree, freeBlock)
bind(RtOp.sliceFree, { host: (slice: RawPtr, capacity: u32, T: u32): void => undefined })

export const stackTops = intrinsics.tagInline(function stackTops(): usize {
    return Intrinsics.pstack(0, 0, 0) + Intrinsics.pstack(1, 0, 0) + Intrinsics.pstack(2, 0, 0) + Intrinsics.pstack(3, 0, 0) + Intrinsics.pstack(4, 0, 0)
})

export const markStacks = intrinsics.tagInline(function markStacks(): usize {
    const marks = Intrinsics.pstack(programStack, 0, stackCount * 8)
    Intrinsics.store(marks, 0, Intrinsics.pstack(0, 0, 0), Types.u64)
    Intrinsics.store(marks, 8, Intrinsics.pstack(1, 0, 0), Types.u64)
    Intrinsics.store(marks, 16, Intrinsics.pstack(2, 0, 0), Types.u64)
    Intrinsics.store(marks, 24, Intrinsics.pstack(3, 0, 0), Types.u64)
    Intrinsics.store(marks, 32, Intrinsics.pstack(4, 0, 0), Types.u64)
    return marks
})

export const releaseStacks = intrinsics.tagInline(function releaseStacks(marks: usize): void {
    Intrinsics.pstack(4, Intrinsics.load(marks, 32, Types.u64), 0)
    Intrinsics.pstack(3, Intrinsics.load(marks, 24, Types.u64), 0)
    Intrinsics.pstack(2, Intrinsics.load(marks, 16, Types.u64), 0)
    Intrinsics.pstack(1, Intrinsics.load(marks, 8, Types.u64), 0)
    Intrinsics.pstack(programStack, marks, 0)
})

function numberHash(value: f64): u32 {
    if (value !== value) return 0
    const whole = Intrinsics.convert(value, Types.f64, Types.i64)
    if (Intrinsics.convert(whole, Types.i64, Types.f64) === value && whole >= -0x40000000 && whole < 0x40000000) {
        return Intrinsics.crc32(0, whole, Types.u32)
    }
    return Intrinsics.crc32(0, Intrinsics.bitconvert(value, Types.f64, Types.u64), Types.u64)
}

export function hashKey(key: any): u32 {
    if (typeof key !== 'number') return rt.handleHash(key)
    if (Intrinsics.typeof(key) === Types.f64) return numberHash(key)
    if (key >= -0x40000000 && key < 0x40000000) return Intrinsics.crc32(0, key, Types.u32)
    return Intrinsics.crc32(0, Intrinsics.bitconvert(Intrinsics.convert(key, Types.i64, Types.f64), Types.f64, Types.u64), Types.u64)
}

const maxCapacity = 2**29
const holeFlags = 16

function holesOf(table: u32, mask: u32): u32 {
    return table + (mask + 1) * 4
}

export function tableCapacity(count: number): u32 {
    let capacity: u32 = 8
    while (count * 4 > capacity) {
        if (capacity >= maxCapacity) throw 'Table maximum size exceeded'
        capacity = capacity * 2
    }
    return capacity
}

export function liveIndex(holes: u32, index: number, length: number): number {
    while (index < length && Intrinsics.load(holes, holeFlags + index, Types.u8)) index++
    return index
}

export function clearHoles(table: u32, mask: u32): u32 {
    const holes = holesOf(table, mask)
    for (let i: u32 = 0; i < ((mask + 1) >> 1); i += 4) Intrinsics.store(holes, holeFlags + i, 0, Types.u32)
    return holes
}

export function markHole(holes: u32, index: number): void {
    Intrinsics.store(holes, holeFlags + index, 1, Types.u8)
}

export function closeHoles(table: u32, mask: u32, length: number, cleared: boolean): u32 {
    const holes = holesOf(table, mask)
    Intrinsics.store(holes, 0, 0, Types.u64)
    Intrinsics.store(holes, 8, length, Types.u32)
    Intrinsics.store(holes, 12, cleared ? 1 : 0, Types.u32)
    return holes
}

export function linkHoles(previous: u32, holes: u32): void {
    Intrinsics.store(previous, 0, holes, Types.u64)
}

export function nextHoles(holes: u32): u32 {
    return Intrinsics.load(holes, 0, Types.u64)
}

export function remapIndex(holes: u32, index: number): number {
    while (holes) {
        if (index <= Intrinsics.load(holes, 8, Types.u32)) {
            if (Intrinsics.load(holes, 12, Types.u32)) {
                index = 0
            } else {
                let removed = 0
                for (let i = 0; i < index; i++) removed += Intrinsics.load(holes, holeFlags + i, Types.u8)
                index = index - removed
            }
        }
        holes = nextHoles(holes)
    }
    return index
}

export function isHole(holes: u32, index: number): boolean {
    return Intrinsics.load(holes, holeFlags + index, Types.u8) !== 0
}

export function findEntry(keys: any[], table: u32, mask: u32, key: any): number {
    if (!table) return -1
    let slot: u32 = hashKey(key) & mask
    let entry = Intrinsics.load(table, slot * 4, Types.u32)
    while (entry) {
        const stored = readElement(keys, entry - 1)
        if (stored === key || (stored !== stored && key !== key)) return entry - 1
        slot = (slot + 1) & mask
        entry = Intrinsics.load(table, slot * 4, Types.u32)
    }
    return -slot - 1
}

export function removeEntry(keys: any[], table: u32, mask: u32, index: number): void {
    let vacant: u32 = hashKey(readElement(keys, index)) & mask
    while (Intrinsics.load(table, vacant * 4, Types.u32) !== index + 1) vacant = (vacant + 1) & mask
    let slot: u32 = (vacant + 1) & mask
    let entry = Intrinsics.load(table, slot * 4, Types.u32)
    while (entry) {
        const home: u32 = hashKey(readElement(keys, entry - 1)) & mask
        if (((slot - home) & mask) >= ((slot - vacant) & mask)) {
            Intrinsics.store(table, vacant * 4, entry, Types.u32)
            vacant = slot
        }
        slot = (slot + 1) & mask
        entry = Intrinsics.load(table, slot * 4, Types.u32)
    }
    Intrinsics.store(table, vacant * 4, 0, Types.u32)
}

export function buildTable(keys: any[], count: number, capacity: u32): u32 {
    // intrinsics.assert(capacity > 0 && capacity < maxCapacity)
    const table = allocate(capacity * 4 + holeFlags + (capacity >> 1))
    writeTable(keys, count, capacity, table)
    return table
}

export function uniqueTable(keys: any[], capacity: u32): u32 {
    const table = allocate(capacity * 4 + holeFlags + (capacity >> 1))
    for (let i: u32 = 0; i < capacity; i++) Intrinsics.store(table, i * 4, 0, Types.u32)
    const mask = capacity - 1
    const count = keys.length
    let kept: u32 = 0
    for (let i: u32 = 0; i < count; i++) {
        const key = readElement(keys, i)
        let slot: u32 = hashKey(key) & mask
        let entry = Intrinsics.load(table, slot * 4, Types.u32)
        while (entry) {
            const stored = readElement(keys, entry - 1)
            if (stored === key || (stored !== stored && key !== key)) break
            slot = (slot + 1) & mask
            entry = Intrinsics.load(table, slot * 4, Types.u32)
        }
        if (entry) continue
        writeElement(keys, kept, key)
        kept++
        Intrinsics.store(table, slot * 4, kept, Types.u32)
    }
    keys.length = kept
    return table
}

export function writeTable(keys: any[], count: number, capacity: u32, table: u32): void {
    for (let i: u32 = 0; i < capacity; i++) Intrinsics.store(table, i * 4, 0, Types.u32)
    const mask = capacity - 1
    for (let i: u32 = 0; i < count; i++) {
        let slot: u32 = hashKey(readElement(keys, i)) & mask
        while (Intrinsics.load(table, slot * 4, Types.u32)) slot = (slot + 1) & mask
        Intrinsics.store(table, slot * 4, i + 1, Types.u32)
    }
}
