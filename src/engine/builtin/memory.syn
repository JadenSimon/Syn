/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'

const Intrinsics = intrinsics.Intrinsics

export const programStack = 1

export function allocate(bytes: u32): u32 {
    return Intrinsics.pstack(programStack, 0, bytes)
}

export function programStackTop(): u32 {
    return Intrinsics.pstack(programStack, 0, 0)
}

export function releaseProgramStack(top: u32): void {
    Intrinsics.pstack(programStack, top, 0)
}

const Types = intrinsics.Types

export function hashKey(key: any): u32 {
    const bits = Intrinsics.bitconvert(key, Types.vm_value, Types.u32)
    return bits ^ (bits >>> 3) ^ (bits >>> 11)
}

export function buildTable(keys: any[], count: number, capacity: u32): u32 {
    const table = allocate(capacity * 4)
    for (let i: u32 = 0; i < capacity; i++) Intrinsics.store(table, i * 4, 0, Types.u32)
    const mask = capacity - 1
    for (let i: u32 = 0; i < count; i++) {
        let slot: u32 = hashKey(keys[i]) & mask
        while (Intrinsics.load(table, slot * 4, Types.u32)) slot = (slot + 1) & mask
        Intrinsics.store(table, slot * 4, i + 1, Types.u32)
    }
    return table
}
