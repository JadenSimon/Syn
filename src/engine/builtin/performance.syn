/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import * as syscalls from '../syscalls'
import { allocate, programStackTop, releaseProgramStack } from './memory'
import { defineGlobal } from './globals'

const Intrinsics = intrinsics.Intrinsics
const Types = intrinsics.Types

export const performance = {
    now(): number {
        const mark = programStackTop()
        const timeval = allocate(16)
        syscalls.gettimeofday(timeval, 0, 0)
        const seconds = Intrinsics.load(timeval, 0, Types.u64)
        const micros = Intrinsics.load(timeval, 8, Types.u32)
        releaseProgramStack(mark)
        return seconds * 1000 + micros * 0.001
    },
}

defineGlobal(performance, 'performance')
