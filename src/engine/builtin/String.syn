/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import * as heap from '../heap'
import { rt } from '../rt'
import { defineGlobal } from './globals'
import { allocate } from './memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

const bytesOf = intrinsics.tagInline(function bytesOf(text: string) {
    return heap.HeapString(heap.resolveHeapCell(rt.handleof(text)))
})

function matchesAt(ptr: number, needle: number, length: number): boolean {
    for (let i = 0; i < length; i++) {
        if (Intrinsics.load(ptr, i, Types.u8) !== Intrinsics.load(needle, i, Types.u8)) return false
    }
    return true
}

const stringOf = intrinsics.tagInline(function stringOf(data: number, length: number): string {
    return rt.stringOf(heap.externalString(data, length))
})

function clampIndex(index: number, length: number): number {
    if (index < 0) return length + index < 0 ? 0 : length + index
    return index > length ? length : index
}

function copyBytes(to: number, from: number, length: number): void {
    for (let i = 0; i < length; i++) Intrinsics.store(to, i, Intrinsics.load(from, i, Types.u8), Types.u8)
}

function pad(text: string, targetLength: number, padString: string | undefined, atStart: boolean): string {
    const str = bytesOf(text)
    const filler = bytesOf(padString === undefined ? ' ' : padString)
    if (targetLength <= str.length || filler.length === 0) return text
    const data = allocate(targetLength)
    const count = targetLength - str.length
    const at = atStart ? 0 : str.length
    for (let i = 0; i < count; i++) Intrinsics.store(data, at + i, Intrinsics.load(filler.ptr, i % filler.length, Types.u8), Types.u8)
    copyBytes(atStart ? data + count : data, str.ptr, str.length)
    return stringOf(data, targetLength)
}

function mapCase(text: string, lo: number, hi: number, shift: number): string {
    const str = bytesOf(text)
    const length = str.length
    const data = allocate(length)
    for (let i = 0; i < length; i++) {
        const byte = Intrinsics.load(str.ptr, i, Types.u8)
        Intrinsics.store(data, i, byte >= lo && byte <= hi ? byte + shift : byte, Types.u8)
    }
    return stringOf(data, length)
}

function encodeCodes(codes: number[]): string {
    const count = codes.length
    let length = 0
    for (let i = 0; i < count; i++) {
        const code = codes[i] & 0xFFFF
        length += code < 0x80 ? 1 : code < 0x800 ? 2 : 3
    }
    const data = allocate(length)
    let at = 0
    for (let i = 0; i < count; i++) {
        const code = codes[i] & 0xFFFF
        if (code < 0x80) {
            Intrinsics.store(data, at, code, Types.u8)
            at++
        } else if (code < 0x800) {
            Intrinsics.store(data, at, 0xC0 | (code >> 6), Types.u8)
            Intrinsics.store(data, at + 1, 0x80 | (code & 0x3F), Types.u8)
            at += 2
        } else {
            Intrinsics.store(data, at, 0xE0 | (code >> 12), Types.u8)
            Intrinsics.store(data, at + 1, 0x80 | ((code >> 6) & 0x3F), Types.u8)
            Intrinsics.store(data, at + 2, 0x80 | (code & 0x3F), Types.u8)
            at += 3
        }
    }
    return stringOf(data, length)
}

function find(ptr: number, length: number, needle: number, needleLength: number, from: number): number {
    let at = from
    while (at + needleLength <= length) {
        if (matchesAt(ptr + at, needle, needleLength)) return at
        at++
    }
    return -1
}

export function substitute(template: string, text: string, position: number, match: (string | undefined)[]): string {
    const matched = match[0] as string
    const length = template.length
    let result = ''
    let start = 0
    let at = 0
    while (at + 1 < length) {
        if (template.charCodeAt(at) !== 36) {
            at++
            continue
        }
        const c = template.charCodeAt(at + 1)
        let width = 2
        let piece = ''
        if (c === 36) {
            piece = '$'
        } else if (c === 38) {
            piece = matched
        } else if (c === 96) {
            piece = text.slice(0, position)
        } else if (c === 39) {
            piece = text.slice(position + matched.length)
        } else if (c >= 48 && c <= 57) {
            let index = c - 48
            const next = at + 2 < length ? template.charCodeAt(at + 2) : -1
            if (next >= 48 && next <= 57 && index * 10 + next - 48 < match.length) {
                index = index * 10 + next - 48
                width = 3
            }
            if (index < 1 || index >= match.length) {
                at++
                continue
            }
            piece = match[index] ?? ''
        } else {
            at++
            continue
        }
        result = result + template.slice(start, at) + piece
        at += width
        start = at
    }
    return result + template.slice(start)
}

export class String {
    get length(): u32 {
        return bytesOf(this as any).length
    }

    charCodeAt(index?: number): number {
        const str = bytesOf(this as any)
        const at = index === undefined ? 0 : index
        if (at < 0 || at >= str.length) return NaN
        return Intrinsics.load(str.ptr, at, Types.u8)
    }

    indexOf(search: string, position?: number): number {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        return find(str.ptr, str.length, needle.ptr, needle.length, position === undefined || position < 0 ? 0 : position)
    }

    includes(search: string, position?: number): boolean {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        return find(str.ptr, str.length, needle.ptr, needle.length, position === undefined || position < 0 ? 0 : position) >= 0
    }

    startsWith(search: string, position?: number): boolean {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        const at = position === undefined || position < 0 ? 0 : position
        if (at + needle.length > str.length) return false
        return matchesAt(str.ptr + at, needle.ptr, needle.length)
    }

    endsWith(search: string, endPosition?: number): boolean {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        const end = endPosition === undefined || endPosition > str.length ? str.length : endPosition < 0 ? 0 : endPosition
        if (needle.length > end) return false
        return matchesAt(str.ptr + end - needle.length, needle.ptr, needle.length)
    }

    slice(start?: number, end?: number): string {
        const str = bytesOf(this as any)
        const length = str.length
        const from = start === undefined ? 0 : clampIndex(start, length)
        const to = end === undefined ? length : clampIndex(end, length)
        return stringOf(str.ptr + from, to > from ? to - from : 0)
    }

    split(separator?: string): string[] {
        const str = bytesOf(this as any)
        const parts: string[] = []
        if (separator === undefined) {
            parts.push(this as any)
            return parts
        }
        const needle = bytesOf(separator)
        if (needle.length === 0) {
            for (let i = 0; i < str.length; i++) parts.push(stringOf(str.ptr + i, 1))
            return parts
        }
        let start = 0
        while (true) {
            const at = find(str.ptr, str.length, needle.ptr, needle.length, start)
            if (at < 0) break
            parts.push(stringOf(str.ptr + start, at - start))
            start = at + needle.length
        }
        parts.push(stringOf(str.ptr + start, str.length - start))
        return parts
    }

    replace(search: any, replacement: any): string {
        const holder = typeof search === 'function' || (typeof search === 'object' && search !== null)
        if (holder && search[Symbol.replace] !== undefined) return search[Symbol.replace](this, replacement)
        const text = this as any as string
        const found = `${search}`
        const position = text.indexOf(found)
        if (position < 0) return text
        const replaced = typeof replacement === 'function' ? `${replacement(found, position, text)}` : substitute(`${replacement}`, text, position, [found])
        return text.slice(0, position) + replaced + text.slice(position + found.length)
    }

    toUpperCase(): string {
        return mapCase(this as any, 97, 122, -32)
    }

    toLowerCase(): string {
        return mapCase(this as any, 65, 90, 32)
    }

    // XXX: need locales
    localeCompare(that: string): number {
        const self = this as any as string
        if (self < that) return -1
        if (self > that) return 1
        return 0
    }

    padStart(targetLength: number, padString?: string): string {
        return pad(this as any, targetLength, padString, true)
    }

    padEnd(targetLength: number, padString?: string): string {
        return pad(this as any, targetLength, padString, false)
    }

    repeat(count: number): string {
        const str = bytesOf(this as any)
        if (count < 0) throw 'Invalid count value'
        const length = str.length * count
        const data = allocate(length)
        for (let i = 0; i < count; i++) copyBytes(data + i * str.length, str.ptr, str.length)
        return stringOf(data, length)
    }

    static fromCharCode(...codes: number[]): string {
        return encodeCodes(codes)
    }
}

defineGlobal(String)

export async function suite() {
    const harness = await import('../harness')
    function stringCharCodeAt(n: u32): number {
        const text = 'hello'
        const outside = text.charCodeAt(n + 5)
        return text.charCodeAt(n) * 10 + text.charCodeAt() + (outside !== outside ? 1 : 0)
    }
    function stringIndexOf(n: u32): number {
        const text = 'abcabc'
        return (text.indexOf('c', n) + 1) * 100 + (text.indexOf('bc') + 1) * 10 + text.indexOf('x') + 1
    }
    function stringSearch(n: u32): number {
        const text = 'prefix-body'
        return (text.startsWith('pre') ? 1000 : 0) + (text.startsWith('fix', n) ? 100 : 0) + (text.endsWith('body') ? 10 : 0) + (text.includes('-', n) ? 1 : 0)
    }
    function stringEndsWithAt(n: u32): number {
        const text = 'abcdef'
        return (text.endsWith('cd', n) ? 10 : 0) + (text.endsWith('abcdefg') ? 1 : 0)
    }
    function charOutside(n: u32): number {
        const code = 'hello'.charCodeAt(n + 5)
        return code !== code ? 1 : 0
    }
    function charMixed(n: u32): number {
        const text = 'hello'
        return text.charCodeAt(n) * 10 + text.charCodeAt()
    }
    function stringSlice(n: u32): number {
        const text = 'abcdef'
        const tail = text.slice(n)
        const mid = text.slice(1, n)
        const back = text.slice(-2 - n, -1)
        return tail.length * 10000 + mid.length * 1000 + back.length * 100 + (mid === 'bc' ? 10 : 0) + (text.slice(n, 1) === '' ? 1 : 0)
    }
    function stringSplit(n: u32): number {
        const parts = `a,b,${n},`.split(',')
        const chars = 'xyz'.slice(n % 3).split('')
        const whole = 'a--b'.split('-').length * 10 + 'ab'.split('--').length + 'ab'.split().length
        return parts.length * 100000 + (parts[1] === 'b' ? 10000 : 0) + parts[2].length * 1000 + chars.length * 100 + parts[3].length + whole
    }
    function stringCase(n: u32): number {
        const upper = `aB${n}z`.toUpperCase()
        const lower = `aB${n}Z`.toLowerCase()
        return upper.charCodeAt(1) * 100 + (upper === `AB${n}Z` ? 10 : 0) + (lower === `ab${n}z` ? 1 : 0)
    }
    function stringPad(n: u32): number {
        const text = `${n}`
        const zeros = text.padStart(5, '0')
        const tail = text.padEnd(4, 'ab')
        return zeros.length * 1000 + (zeros === `0000${n}` ? 100 : 0) + (tail === `${n}aba` ? 10 : 0) + text.padStart(3).charCodeAt(0) - 32 + text.padStart(n).length
    }
    function stringRepeat(n: u32): number {
        const twice = 'ab'.repeat(n)
        return twice.length * 100 + (twice === 'abab' ? 10 : 0) + ('x'.repeat(0) === '' ? 1 : 0)
    }
    function stringFromCharCode(n: u32): number {
        const pair = String.fromCharCode(72, 105 + n)
        return String.fromCharCode(65 + n).charCodeAt(0) * 1000 + pair.length * 100 + (pair === 'Hi' ? 10 : 0) + String.fromCharCode().length
    }
    function replaced(n: u32): string {
        return n === 0 ? 'a-b-c' : n === 1 ? `ab${n}c` : n === 2 ? '--' : `x$y${n}`
    }
    function stringReplace(n: u32): string {
        return replaced(n).replace('-', '+')
    }
    function stringReplaceTemplate(n: u32): string {
        return replaced(n).replace('b', '[$&$$$1$`]')
    }
    function stringReplaceCallback(n: u32): string {
        return replaced(n).replace('$', (found, position, text) => `${found}${position}${text.length}`)
    }
    function stringReplaceChain(n: u32): string {
        const text = n ? 'ldur x1, [x2]' : 'stur w3, [sp]'
        return text.slice(0, text.indexOf('[')).replace('ldur', 'ldr').replace('stur', 'str')
    }
    harness.runCases({ prefix: 'String', args: true }, [
        [stringReplace, [0], [1], [2], [3]],
        [stringReplaceTemplate, [0], [1], [2], [3]],
        [stringReplaceCallback, [0], [1], [2], [3]],
        [stringReplaceChain, [0], [1]],
        [charMixed, [0], [3]],
        [charOutside, [0], [2]],
        // [stringCharCodeAt, [0], [4]],
        [stringIndexOf, [0], [3], [6]],
        [stringSearch, [3], [0], [7]],
        [stringEndsWithAt, [4], [3], [9]],
        [stringSlice, [0], [3], [6], [9]],
        [stringSplit, [0], [7], [12]],
        [stringCase, [0], [5]],
        [stringPad, [3], [12345], [0]],
        [stringRepeat, [0], [2], [5]],
        [stringFromCharCode, [0], [1], [4]],
    ])
}
