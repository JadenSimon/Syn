/// @synth

"use wrapped";

import * as intrinsics from '../intrinsics'
import * as heap from '../heap'
import { rt } from '../rt'
import { defineGlobal } from './globals'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

const bytesOf = intrinsics.tagInline(function bytesOf(text: string) {
    return heap.HeapString(heap.resolveHeapCell(rt.handleof(text)))
})

function matchesAt(ptr: number, needle: number, length: number): boolean {
    for (let i = 0; i < length; i++) {
        if (Intrinsics.load(ptr, i, Types.u8) !== Intrinsics.load(needle, i, Types.u8)) return false
    }
    return true
}

function find(ptr: number, length: number, needle: number, needleLength: number, from: number): number {
    let at = from
    while (at + needleLength <= length) {
        if (matchesAt(ptr + at, needle, needleLength)) return at
        at++
    }
    return -1
}

export class String {
    get length(): u32 {
        return bytesOf(this as any).length
    }

    charCodeAt(index?: number): number {
        const str = bytesOf(this as any)
        const at = index === undefined ? 0 : index
        if (at < 0 || at >= str.length) return NaN
        return Intrinsics.load(str.ptr, at, Types.u8)
    }

    indexOf(search: string, position?: number): number {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        return find(str.ptr, str.length, needle.ptr, needle.length, position === undefined || position < 0 ? 0 : position)
    }

    includes(search: string, position?: number): boolean {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        return find(str.ptr, str.length, needle.ptr, needle.length, position === undefined || position < 0 ? 0 : position) >= 0
    }

    startsWith(search: string, position?: number): boolean {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        const at = position === undefined || position < 0 ? 0 : position
        if (at + needle.length > str.length) return false
        return matchesAt(str.ptr + at, needle.ptr, needle.length)
    }

    endsWith(search: string, endPosition?: number): boolean {
        const str = bytesOf(this as any)
        const needle = bytesOf(search)
        const end = endPosition === undefined || endPosition > str.length ? str.length : endPosition < 0 ? 0 : endPosition
        if (needle.length > end) return false
        return matchesAt(str.ptr + end - needle.length, needle.ptr, needle.length)
    }
}

defineGlobal(String)

export async function suite() {
    const harness = await import('../harness')
    function stringCharCodeAt(n: u32): number {
        const text = 'hello'
        const outside = text.charCodeAt(n + 5)
        return text.charCodeAt(n) * 10 + text.charCodeAt() + (outside !== outside ? 1 : 0)
    }
    function stringIndexOf(n: u32): number {
        const text = 'abcabc'
        return (text.indexOf('c', n) + 1) * 100 + (text.indexOf('bc') + 1) * 10 + text.indexOf('x') + 1
    }
    function stringSearch(n: u32): number {
        const text = 'prefix-body'
        return (text.startsWith('pre') ? 1000 : 0) + (text.startsWith('fix', n) ? 100 : 0) + (text.endsWith('body') ? 10 : 0) + (text.includes('-', n) ? 1 : 0)
    }
    function stringEndsWithAt(n: u32): number {
        const text = 'abcdef'
        return (text.endsWith('cd', n) ? 10 : 0) + (text.endsWith('abcdefg') ? 1 : 0)
    }
    function charOutside(n: u32): number {
        const code = 'hello'.charCodeAt(n + 5)
        return code !== code ? 1 : 0
    }
    function charMixed(n: u32): number {
        const text = 'hello'
        return text.charCodeAt(n) * 10 + text.charCodeAt()
    }
    harness.runCases({ prefix: 'String', args: true }, [
        [charMixed, [0], [3]],
        [charOutside, [0], [2]],
        // [stringCharCodeAt, [0], [4]],
        [stringIndexOf, [0], [3], [6]],
        [stringSearch, [3], [0], [7]],
        [stringEndsWithAt, [4], [3], [9]],
    ])
}
