/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import type { Graph, GraphBlock, GraphNode } from './lowering2'

const Types = intrinsics.Types

export interface DebugLabels {
    debugLabels: Map<number, string>
}

export function createGraph(init?: Partial<Graph>): Graph {
    const g: Graph = {
        form: init?.form,
        ids: init?.ids ?? { next: 1 },
        nodes: init?.nodes ?? new Map(),
        literals: init?.literals ?? createLiteralPool(),
        blocks: init?.blocks ?? [],
        root: init?.root ?? 0,
        blockIndex: new Map(),
        epoch: init?.epoch ?? 0,
        debugLabels: init?.debugLabels ?? new Map(),
        name: init?.name,
        level: init?.level,
        unswitch: init?.unswitch,
        facts: init?.facts,
        index: undefined,
        kinds: init?.kinds ?? GraphKinds.all,
    }
    setGraphBlocks(g, g.blocks)
    return g
}

export interface LiteralPool {
    values: number[]
    at: Map<number, number>
    raw: number[]
    interned: Map<string, number>
}

export function createLiteralPool(): LiteralPool {
    return { values: [], at: new Map(), raw: [], interned: new Map() }
}

export interface NodeSpace {
    nodes: Map<number, GraphNode>
    ids: intrinsics.IdSpace
    literals: LiteralPool
    kinds?: GraphKinds
}

export function getNode(g: NodeSpace, id: number): GraphNode | undefined {
    return g.nodes.get(id)
}

export function setNode(g: NodeSpace, id: number, n: GraphNode): void {
    g.kinds |= opKinds[n.op]
    g.nodes.set(id, n)
}

export function hasNode(g: NodeSpace, id: number): boolean {
    return g.nodes.has(id)
}

export function deleteNode(g: NodeSpace, id: number): void {
    g.nodes.delete(id)
}

export function countNodes(g: NodeSpace): number {
    return g.nodes.size
}

export function nodeIds(g: NodeSpace): Iterable<number> {
    return g.nodes.keys()
}

export function allNodes(g: NodeSpace): Iterable<GraphNode> {
    return g.nodes.values()
}

export function nodeEntries(g: NodeSpace): Iterable<[number, GraphNode]> {
    return g.nodes
}

export function copyNodes(g: NodeSpace): Map<number, GraphNode> {
    return new Map(g.nodes)
}

export function newId(g: NodeSpace): number {
    return g.ids.next++
}

export function insertNode(g: NodeSpace, n: GraphNode): number {
    const id = g.ids.next++
    setNode(g, id, n)
    return id
}

export function addNode(g: NodeSpace, op: NodeOp, operands: Operand[], T: TypeOperand = Types.u64): number {
    return insertNode(g, makeNode(g, op, operands, T))
}

export function addCopy(g: NodeSpace, from: GraphNode, operands?: Operand[], op: NodeOp = from.op): number {
    return insertNode(g, copyNode(g, from, operands, op))
}

export function putNode(g: NodeSpace, id: number, op: NodeOp, operands: Operand[], T: TypeOperand = Types.u64): void {
    setNode(g, id, makeNode(g, op, operands, T))
}

export function putCopy(g: NodeSpace, id: number, from: GraphNode, operands?: Operand[], op: NodeOp = from.op): void {
    setNode(g, id, copyNode(g, from, operands, op))
}

export function retypeNode(g: NodeSpace, id: number, T: TypeOperand): void {
    const copy = copyNode(g, getNode(g, id)!)
    setType(copy, T)
    setNode(g, id, copy)
}

export function withOperand(g: NodeSpace, n: GraphNode, idx: number, x: Operand): Operand[] {
    const operands = getOperands(g, n)
    operands[idx] = x
    return operands
}

export function nodeUsers(g: NodeSpace, ids: Iterable<number>): Map<number, [user: number, slot: number][]> {
    const users = new Map<number, [number, number][]>()
    for (const id of ids) {
        const n = getNode(g, id)!
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            const list = users.get(ref)
            if (list) list.push([id, i])
            else users.set(ref, [[id, i]])
        }
    }
    return users
}

export function getBlock(g: Graph, id: number): GraphBlock | undefined {
    return g.blockIndex.get(id)
}

export function addGraphBlock(g: Graph, block: GraphBlock): void {
    g.blocks.push(block)
    g.blockIndex.set(block.id, block)
}

export function withNodes(g: Graph, nodes: Map<number, GraphNode>, blocks = g.blocks.map(b => ({ ...b, params: b.params.slice() }))): Graph {
    const out = { ...g, nodes, facts: g.facts && new Map(g.facts), index: undefined, kinds: nodes.size ? g.kinds : GraphKinds.none }
    setGraphBlocks(out, blocks)
    return out
}

export function setGraphBlocks(g: Graph, blocks: GraphBlock[]): void {
    intrinsics.assert(!blocks.length || blocks[0].id === g.root, 'graph: the root block must come first')
    g.blocks = blocks
    g.blockIndex = new Map()
    for (const block of blocks) g.blockIndex.set(block.id, block)
}


export interface GraphIndex {
    dependents: Map<number, Set<number>>
    byOp: Map<number, Map<NodeOp, number[]>>
    successors: Map<number, Set<number>>
    preds: Map<number, Set<number>>
    visited: Map<number, number>
    shared: Set<number>
    reachableBlocks: Set<GraphBlock>
    inboundVersions: Map<number, number>
    stale: Set<number>
}

export interface IndexWatch {
    reused(g: Graph, ix: GraphIndex): void
    built(g: Graph, ix: GraphIndex): void
    dropped(g: Graph): void
    staled(g: Graph, block: number): void
    rewrote(g: Graph, ids: Iterable<number>): void
}

let indexWatch: IndexWatch | undefined

export function watchIndex(watch: IndexWatch): void {
    indexWatch = watch
}

export function refreshable(g: Graph): boolean {
    return g.form === 'packaged' || g.form === 'optimized' || g.form === 'lowerable'
}

export function graphIndex(g: Graph): GraphIndex {
    const ix = g.index
    if (ix && ix.stale.size && refreshable(g)) refreshStale(g, ix)
    if (ix && !ix.stale.size) {
        if (indexWatch) indexWatch.reused(g, ix)
        return ix
    }
    g.index = buildIndex(g)
    if (indexWatch) indexWatch.built(g, g.index)
    return g.index
}

export function refreshStale(g: Graph, ix: GraphIndex): void {
    for (const id of ix.stale) {
        const b = getBlock(g, id)
        if (b && ix.reachableBlocks.has(b)) {
            refreshBlock(g, ix, b)
            continue
        }
        if (!ix.stale.delete(id)) continue
        const old = indexedBlock(g, ix, id)
        if (old) unindexBlock(g, ix, old)
    }
}

export function rebuildIndex(g: Graph, ix: GraphIndex): void {
    const fresh = buildIndex(g)
    for (const [x, from] of fresh.preds) {
        const old = ix.preds.get(x)
        let added = false
        for (const p of from) {
            if (!old?.has(p)) added = true
        }
        if (added) ix.inboundVersions.set(x, (ix.inboundVersions.get(x) ?? 0) + 1)
    }
    ix.dependents.clear()
    for (const [k, v] of fresh.dependents) ix.dependents.set(k, v)
    ix.byOp.clear()
    for (const [k, v] of fresh.byOp) ix.byOp.set(k, v)
    ix.successors.clear()
    for (const [k, v] of fresh.successors) ix.successors.set(k, v)
    ix.preds.clear()
    for (const [k, v] of fresh.preds) ix.preds.set(k, v)
    ix.visited.clear()
    for (const [k, v] of fresh.visited) ix.visited.set(k, v)
    ix.shared.clear()
    for (const id of fresh.shared) ix.shared.add(id)
    ix.reachableBlocks.clear()
    for (const b of fresh.reachableBlocks) ix.reachableBlocks.add(b)
    ix.stale.clear()
}

export function buildIndex(g: Graph): GraphIndex {
    const ix: GraphIndex = {
        dependents: new Map(),
        byOp: new Map(),
        successors: new Map(),
        preds: new Map(),
        visited: new Map(),
        shared: new Set(),
        reachableBlocks: new Set(),
        inboundVersions: new Map(),
        stale: new Set(),
    }
    walkBlock(g, ix, g.blocks[0])
    sortGrown(ix)
    return ix
}

const grownPreds: number[] = []

function sortGrown(ix: GraphIndex): void {
    for (const id of grownPreds) {
        const set = ix.preds.get(id)
        if (set) sortIds(ix.preds, id, set)
    }
    grownPreds.length = 0
}

function sortIds(sets: Map<number, Set<number>>, key: number, set: Set<number>): Set<number> {
    let last = -1
    for (const id of set) {
        if (id < last) {
            const sorted = new Set([...set].sort((a, b) => a - b))
            sets.set(key, sorted)
            return sorted
        }
        last = id
    }
    return set
}

export function dirtyIndex(g: Graph): void {
    g.index = undefined
    if (indexWatch) indexWatch.dropped(g)
}

const noIds: ReadonlySet<number> = new Set()
const noOps: ReadonlyMap<NodeOp, number[]> = new Map()

export function indexedUsers(ix: GraphIndex, id: number): ReadonlySet<number> {
    const users = ix.dependents.get(id)
    if (!users) return noIds
    if (users.size < 2) return users
    return sortIds(ix.dependents, id, users)
}

export function userCount(ix: GraphIndex, id: number): number {
    return ix.dependents.get(id)?.size ?? 0
}

export function indexedPreds(ix: GraphIndex, block: number): ReadonlySet<number> {
    return ix.preds.get(block) ?? noIds
}

export function predCount(ix: GraphIndex, block: number): number {
    return ix.preds.get(block)?.size ?? 0
}

export function indexedSuccessors(ix: GraphIndex, block: number): ReadonlySet<number> {
    return ix.successors.get(block) ?? noIds
}

export function blockOps(ix: GraphIndex, block: number): ReadonlyMap<NodeOp, number[]> {
    return ix.byOp.get(block) ?? noOps
}

export function isIndexed(ix: GraphIndex, b: GraphBlock): boolean {
    return ix.reachableBlocks.has(b)
}

export function inboundVersion(ix: GraphIndex, block: number): number {
    return ix.inboundVersions.get(block) ?? 0
}

export function holderOf(ix: GraphIndex, id: number): number | undefined {
    return ix.visited.get(id)
}

export function isShared(ix: GraphIndex, id: number): boolean {
    return ix.shared.has(id)
}

export function findValues(ix: GraphIndex, block: number, op: NodeOp): number[] | undefined {
    if (const m = ix.byOp.get(block)) {
        return m.get(op)
    }
}

export function indexedValues(ix: GraphIndex, op: NodeOp): number[] {
    const out: number[] = []
    for (const [block, ops] of ix.byOp) {
        for (const id of ops.get(op) ?? noIds) {
            if (ix.visited.get(id) === block) out.push(id)
        }
    }
    return out.sort((a, b) => a - b)
}

export function inboundApplies(g: Graph, ix: GraphIndex, target: GraphBlock): [from: number, apply: number][] {
    const res: [from: number, apply: number][] = []
    if (target.id === g.root) return res
    const from = ix.preds.get(target.id)
    if (!from) return res
    for (const b of from) {
        for (const apply of findValues(ix, b, NodeOp.apply)!) {
            if (getRef(getNode(g, apply)!, 0) === target.id) res.push([b, apply])
        }
    }
    return res
}

export function mayHave(g: Graph, ...ops: NodeOp[]): boolean {
    if (!mayHaveOps(g, ops)) return false
    const ix = g.index
    if (!ix || ix.stale.size) return true
    if (indexWatch) indexWatch.reused(g, ix)
    for (const m of ix.byOp.values()) {
        for (const op of ops) {
            if (m.has(op)) return true
        }
    }
    return false
}

export function useSlot(g: NodeSpace, user: number, id: number, from = 0): number {
    const n = getNode(g, user)!
    let i = from
    while (i < countIds(n)) {
        if (getRef(n, i) === id) return i
        i++
    }
    return -1
}

export function dirtyValues(g: Graph, ids: Iterable<number>): void {
    if (indexWatch) indexWatch.rewrote(g, ids)
    const ix = g.index
    if (!ix) return
    const blocks = new Set<number>()
    for (const id of ids) {
        const block = ix.visited.get(id)
        if (block === undefined) continue
        if (ix.shared.has(id)) {
            dirtyIndex(g)
            return
        }
        blocks.add(block)
    }
    for (const block of blocks) {
        const b = getBlock(g, block)
        if (!b) throw `missing block "B${block}" while invalidating the graph index`
        dirtyBlock(g, b)
    }
}

export function dirtyBlock(g: Graph, b: GraphBlock): void {
    if (g.index) g.index.stale.add(b.id)
    if (indexWatch) indexWatch.staled(g, b.id)
}

export function setBlockBody(g: Graph, b: GraphBlock, body: number): void {
    b.bodyId = body
    dirtyBlock(g, b)
}

export function setBlockConst(g: Graph, b: GraphBlock, value: number): void {
    b.bodyConst = value
    dirtyBlock(g, b)
}

export function setBlockParams(g: Graph, b: GraphBlock, params: number[]): void {
    b.params = params
    dirtyBlock(g, b)
}

export function setBlockParam(g: Graph, b: GraphBlock, at: number, param: number): void {
    b.params[at] = param
    dirtyBlock(g, b)
}

export function pushBlockParams(g: Graph, b: GraphBlock, ...params: number[]): void {
    b.params.push(...params)
    dirtyBlock(g, b)
}

export function refreshBlock(g: Graph, ix: GraphIndex, b: GraphBlock): void {
    if (!ix.stale.delete(b.id)) return
    const old = ix.byOp.get(b.id)
    ix.byOp.delete(b.id)
    const touched = new Set<number>()
    for (const ids of old?.values() ?? []) {
        for (const id of ids) {
            const n = getNode(g, id)
            if (!n || ix.shared.has(id)) {
                touched.add(id)
                continue
            }
            if (ix.visited.get(id) !== b.id) continue
            ix.dependents.delete(id)
        }
    }
    const out = ix.successors.get(b.id)
    ix.successors.delete(b.id)
    for (const x of out ?? []) ix.preds.get(x)?.delete(b.id)
    const seen = walkBlock(g, ix, b)
    releaseMembers(g, ix, b, old, seen, touched)
    for (const x of out ?? []) {
        if (!ix.successors.get(b.id)?.has(x)) dropOrphan(g, ix, x)
    }
    sortGrown(ix)
}

export function unindexBlock(g: Graph, ix: GraphIndex, b: GraphBlock): void {
    ix.stale.delete(b.id)
    ix.reachableBlocks.delete(b)
    const old = ix.byOp.get(b.id)
    ix.byOp.delete(b.id)
    const touched = new Set<number>()
    for (const ids of old?.values() ?? []) {
        for (const id of ids) {
            if (!hasNode(g, id) || ix.shared.has(id)) touched.add(id)
        }
    }
    const out = ix.successors.get(b.id)
    ix.successors.delete(b.id)
    for (const x of out ?? []) ix.preds.get(x)?.delete(b.id)
    releaseMembers(g, ix, b, old, noIds, touched)
    for (const x of out ?? []) dropOrphan(g, ix, x)
}

function releaseMembers(g: Graph, ix: GraphIndex, b: GraphBlock, old: ReadonlyMap<NodeOp, number[]> | undefined, kept: ReadonlySet<number>, touched: Set<number>): void {
    const released = new Set<number>()
    for (const ids of old?.values() ?? []) {
        for (const id of ids) {
            if (kept.has(id)) continue
            const n = getNode(g, id)
            if (ix.visited.get(id) !== b.id) continue
            ix.visited.delete(id)
            if (!n || ix.shared.has(id)) {
                released.add(id)
                continue
            }
            ix.dependents.delete(id)
            for (let i = 0; i < countIds(n); i++) {
                const x = getRef(n, i)
                if (x && ix.shared.has(x)) touched.add(x)
            }
        }
    }
    keepShared(g, ix, released)
    pruneUsers(g, ix, touched)
}

export function absorbBlock(g: Graph, ix: GraphIndex, into: GraphBlock, b: GraphBlock): void {
    ix.stale.delete(b.id)
    ix.reachableBlocks.delete(b)
    let ops = ix.byOp.get(into.id)
    if (!ops) ix.byOp.set(into.id, ops = new Map())
    for (const [op, ids] of ix.byOp.get(b.id) ?? []) {
        for (const id of ids) {
            if (ix.visited.get(id) === b.id) ix.visited.set(id, into.id)
        }
        const list = ops.get(op)
        if (list) list.push(...ids)
        else ops.set(op, ids.slice())
    }
    ix.byOp.delete(b.id)
    ix.preds.delete(b.id)
    let out = ix.successors.get(into.id)
    if (!out) ix.successors.set(into.id, out = new Set())
    out.delete(b.id)
    for (const x of ix.successors.get(b.id) ?? []) {
        const from = ix.preds.get(x)
        if (from) {
            from.delete(b.id)
            from.add(into.id)
            grownPreds.push(x)
        }
        out.add(x)
    }
    ix.successors.delete(b.id)
    sortGrown(ix)
    if (indexWatch) indexWatch.staled(g, into.id)
}

function dropOrphan(g: Graph, ix: GraphIndex, id: number): void {
    if (id === g.root) return
    if (ix.preds.get(id)?.size && reachesRoot(g, ix, id)) return
    const b = indexedBlock(g, ix, id)
    if (b) unindexBlock(g, ix, b)
    if (!ix.preds.get(id)?.size) ix.preds.delete(id)
}

function reachesRoot(g: Graph, ix: GraphIndex, id: number): boolean {
    const seen = new Set<number>([id])
    const work = [id]
    while (work.length) {
        for (const p of ix.preds.get(work.pop()!) ?? []) {
            if (p === g.root) return true
            if (seen.has(p)) continue
            seen.add(p)
            work.push(p)
        }
    }
    return false
}

function indexedBlock(g: Graph, ix: GraphIndex, id: number): GraphBlock | undefined {
    const b = getBlock(g, id)
    if (b && ix.reachableBlocks.has(b)) return b
    for (const old of ix.reachableBlocks) {
        if (old.id === id) return old
    }
}

function keepShared(g: Graph, ix: GraphIndex, ids: Set<number>): void {
    const work: number[] = []
    for (const id of ids) {
        if (!ix.visited.has(id)) work.push(id)
    }
    while (work.length) {
        const id = work.pop()!
        if (ix.visited.has(id)) continue
        let holder: number | undefined
        for (const u of indexedUsers(ix, id)) {
            const block = ix.visited.get(u)
            const n = block === undefined ? undefined : getNode(g, u)
            if (!n || !refersTo(n, id)) continue
            holder = block
            break
        }
        if (holder === undefined) continue
        ix.visited.set(id, holder)
        const n = getNode(g, id)!
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            if (x && ids.has(x) && !ix.visited.has(x)) work.push(x)
        }
    }
    for (const id of ids) {
        if (!ix.visited.has(id)) ix.shared.delete(id)
    }
}

function refersTo(n: GraphNode, id: number): boolean {
    for (let i = n.op === NodeOp.apply ? 1 : 0; i < countIds(n); i++) {
        if (getRef(n, i) === id) return true
    }
    return false
}

function pruneUsers(g: Graph, ix: GraphIndex, ids: Set<number>): void {
    for (const id of ids) {
        const users = ix.dependents.get(id)
        if (!users) continue
        if (!ix.visited.has(id)) {
            ix.dependents.delete(id)
            continue
        }
        for (const u of [...users]) {
            const n = ix.visited.has(u) ? getNode(g, u) : undefined
            if (!n || !refersTo(n, id)) users.delete(u)
        }
        if (!users.size) ix.dependents.delete(id)
    }
}

function usesResult(u: GraphNode, id: number): boolean {
    const count = countIds(u)
    if (u.op === NodeOp.after) return getRef(u, count - 1) === id
    const from = u.op === NodeOp.apply || OrderedValues.has(u.op) ? 1 : 0
    for (let i = from; i < count; i++) {
        if (getRef(u, i) === id) return true
    }
    return false
}

export function resultUsed(g: Graph, ix: GraphIndex, id: number): boolean {
    for (const u of ix.dependents.get(id) ?? noIds) {
        if (usesResult(getNode(g, u)!, id)) return true
    }
    return false
}

function walkBlock(g: Graph, ix: GraphIndex, b: GraphBlock): Set<number> {
    ix.reachableBlocks.add(b)
    let ops = ix.byOp.get(b.id)
    if (!ops) ix.byOp.set(b.id, ops = new Map())
    const seen = new Set<number>()
    walkValue(g, ix, b, ops, seen, b.bodyId, 0)
    return seen
}

function walkValue(g: Graph, ix: GraphIndex, b: GraphBlock, ops: Map<NodeOp, number[]>, seen: Set<number>, id: number, user: number): void {
    if (!id) return
    const n = getNode(g, id)!
    if (n.op === NodeOp.startOf || n.op === NodeOp.void) return
    const first = ix.visited.get(id)
    if (user) {
        let d = ix.dependents.get(id)
        if (!d) ix.dependents.set(id, d = new Set())
        d.add(user)
    }
    if (seen.has(id)) return
    seen.add(id)
    if (first === undefined) ix.visited.set(id, b.id)
    else if (first !== b.id) ix.shared.add(id)
    let arr = ops.get(n.op)
    if (!arr) ops.set(n.op, arr = [])
    arr.push(id)
    if (n.op === NodeOp.param || !countIds(n)) return

    if (n.op === NodeOp.apply) {
        const to = getRef(n, 0)
        let s = ix.successors.get(b.id)
        if (!s) ix.successors.set(b.id, s = new Set())
        s.add(to)
        s = ix.preds.get(to)
        if (!s) ix.preds.set(to, s = new Set())
        if (!s.has(b.id)) {
            ix.inboundVersions.set(to, (ix.inboundVersions.get(to) ?? 0) + 1)
            if (s.size) grownPreds.push(to)
        }
        s.add(b.id)
        const target = getBlock(g, to)
        intrinsics.assert(target)
        for (let i = 1; i < countIds(n); i++) {
            walkValue(g, ix, b, ops, seen, getRef(n, i), id)
        }
        if (!ix.reachableBlocks.has(target)) walkBlock(g, ix, target)
        return
    }
    for (let i = 0; i < countIds(n); i++) {
        walkValue(g, ix, b, ops, seen, getRef(n, i), id)
    }
}

export enum NodeOp {
    none,
    add,
    after,
    alloca,
    and,
    apply,
    bitconvert,
    block,
    box,
    call,
    callContext,
    clz,
    convert,
    crc32,
    decode,
    dispatch,
    div,
    encode,
    eq,
    fnType,
    frameAddress,
    ge,
    get,
    getProp,
    gt,
    heapHandle,
    indirectTarget,
    inlined,
    join,
    le,
    literal,
    load,
    localTarget,
    lt,
    mem,
    mul,
    ne,
    neg,
    startOf,
    nonzero,
    not,
    opaque,
    or,
    panic,
    param,
    pc,
    poolEntry,
    pow,
    pstack,
    record,
    recordType,
    rem,
    ret,
    rt,
    select,
    setProp,
    shl,
    shr,
    stackalloc,
    stackfree,
    static,
    store,
    sub,
    subsat,
    syscallTarget,
    trap,
    typeof,
    unbox,
    uninitialized,
    unreachable,
    ushr,
    void,
    xor,
    type,
    rawbuffer,
    trunc,
    floor,
    ceil,
    abs,
}
Object.freeze(NodeOp)

const nodeOpNames: string[] = ['']
const nodeOps = new Map<string, NodeOp>()
for (const key of Object.keys(NodeOp)) {
    const op = (NodeOp as any)[key] as NodeOp
    if (!op) continue
    const name = key.replace(/[A-Z]/g, c => `-${c.toLowerCase()}`)
    nodeOpNames[op] = name
    nodeOps.set(name, op)
}
const opTyped = new Uint8Array(nodeOpNames.length)
for (const op of [
    NodeOp.param, NodeOp.literal, NodeOp.load, NodeOp.store, NodeOp.convert, NodeOp.bitconvert,
    NodeOp.localTarget, NodeOp.heapHandle, NodeOp.indirectTarget,
    NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.subsat, NodeOp.neg,
    NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr,
    NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.box, NodeOp.unbox, NodeOp.mem, NodeOp.crc32,
    NodeOp.trunc, NodeOp.floor, NodeOp.ceil, NodeOp.abs,
]) opTyped[op] = 1

export enum GraphKinds {
    none = 0,
    pstack = 1 << 0,
    codec = 1 << 1,
    record = 1 << 2,
    mem = 1 << 3,
    all = 15,
}
Object.freeze(GraphKinds)

const opKinds = new Uint8Array(nodeOpNames.length)
opKinds[NodeOp.pstack] = GraphKinds.pstack
for (const op of [NodeOp.box, NodeOp.unbox, NodeOp.encode, NodeOp.decode]) opKinds[op] = GraphKinds.codec
for (const op of [NodeOp.record, NodeOp.recordType, NodeOp.get]) opKinds[op] = GraphKinds.record
opKinds[NodeOp.mem] = GraphKinds.mem

export function kindOf(op: NodeOp): GraphKinds {
    return opKinds[op]
}

export function clearKinds(g: Graph, kinds: GraphKinds): void {
    g.kinds &= ~kinds
}

export function mayHaveKinds(g: Graph, kinds: GraphKinds): boolean {
    return (g.kinds & kinds) !== 0
}

function mayHaveOps(g: Graph, ops: NodeOp[]): boolean {
    for (const op of ops) {
        const kinds = opKinds[op]
        if (!kinds || g.kinds & kinds) return true
    }
    return false
}

export const FloatUnaryOps = new Set<NodeOp>([NodeOp.trunc, NodeOp.floor, NodeOp.ceil, NodeOp.abs])

export const OrderedValues = new Set([
    NodeOp.load, NodeOp.store, NodeOp.call, NodeOp.pstack, NodeOp.rt, NodeOp.alloca, NodeOp.trap, NodeOp.getProp, NodeOp.setProp
])

export const RecomputableOps = new Set<NodeOp>([
    NodeOp.literal, NodeOp.pc, NodeOp.poolEntry, NodeOp.heapHandle, NodeOp.static, NodeOp.frameAddress, NodeOp.localTarget, NodeOp.syscallTarget, NodeOp.indirectTarget,
    NodeOp.startOf, NodeOp.void, NodeOp.uninitialized, NodeOp.unreachable,
    NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.subsat,
    NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.neg, NodeOp.not, NodeOp.clz, NodeOp.crc32, NodeOp.convert, NodeOp.bitconvert, NodeOp.encode, NodeOp.decode, NodeOp.box, NodeOp.select,
    ...FloatUnaryOps,
])

export function opName(op: NodeOp): string {
    return nodeOpNames[op]
}

export function maybeNodeOp(name: string): NodeOp {
    return nodeOps.get(name) ?? NodeOp.none
}

export function nodeOp(name: string): NodeOp {
    const op = nodeOps.get(name)
    if (op === undefined) throw `graph-node: unknown node op '${name}'`
    return op
}

export function typeSlots(op: NodeOp): number {
    return opTyped[op]
}

export enum NodeFlags {
    none = 0,
    this_param = 1 << 0,
    guarded = 1 << 1,
    scratch = 1 << 2,
    spread = 1 << 3,
}
Object.freeze(NodeFlags)

export function spreadsLast(n: GraphNode): boolean {
    return (n.flags & NodeFlags.spread) !== 0
}

export interface Layout {
    params: number
    rest: number
}

export const unknownLayout: Layout = { params: -1, rest: -1 }

export enum ArgForm {
    plain,
    arity,
    pack,
    array,
    unpack,
    unbound,
}

export function argForm(layout: Layout, count: number, spread: boolean, variants: boolean): ArgForm {
    if (layout.params < 0) return spread ? ArgForm.unbound : ArgForm.plain
    if (!spread && layout.rest < 0) return ArgForm.plain
    if (!spread) return variants ? ArgForm.arity : ArgForm.pack
    if (layout.rest === count - 1) return ArgForm.array
    if (layout.rest < 0) return ArgForm.unpack
    return ArgForm.unbound
}

const refBias = 2 ** 29
const allocBias = 2 ** 28
const inlineMin = -(2 ** 27)
const inlineMax = 2 ** 27

function inlineLiteral(v: number): boolean {
    return v >= inlineMin && v < inlineMax && Number.isInteger(v)
}

function encodeLiteral(g: NodeSpace, v: number): number {
    if (inlineLiteral(v)) return v < 0 ? v + allocBias : v
    const pool = g.literals
    let at = pool.at.get(v)
    if (at === undefined) {
        at = pool.values.length
        pool.values.push(v)
        pool.at.set(v, at)
    }
    return allocBias + at
}

function encodeSmall(v: number): number {
    intrinsics.assert(inlineLiteral(v), 'graph: a type, fact or location literal must be small')
    return v < 0 ? v + allocBias : v
}

export function encodeSlot(g: NodeSpace, id: number, literal: number): number {
    return id ? refBias + id : encodeLiteral(g, literal)
}

export function slotKey(op: NodeOp, slots: Uint32Array): string {
    let key = `${opName(op)}`
    for (let i = 0; i < slots.length; i++) key += `,${slots[i]}`
    return key
}

function decodeLiteral(g: NodeSpace, v: number): number {
    const at = v - allocBias
    if (at >= 0) return g.literals.values[at]
    return v >= inlineMax ? v - allocBias : v
}

function smallLiteral(n: GraphNode, idx: number): number {
    const v = n.slots[idx]
    if (v >= refBias) return 0
    return v >= inlineMax ? v - allocBias : v
}

export function slotLiteral(g: NodeSpace, slot: number): number {
    return slot >= refBias ? 0 : decodeLiteral(g, slot)
}

export function refSlot(id: number): number {
    return refBias + id
}

export function literalSlot(g: NodeSpace, literal: number): number {
    return encodeLiteral(g, literal)
}

export function slotRef(slot: number): number {
    return slot >= refBias ? slot - refBias : 0
}

const internMask = 0x7fffffff

function internHash(op: NodeOp, slots: number[], type: number): number {
    let h = (op * 31 + type) & internMask
    for (let i = 0; i < slots.length; i++) h = (h * 31 + slots[i]) & internMask
    return h
}

function sameSlots(n: GraphNode, op: NodeOp, slots: number[], typed: boolean, type: number): boolean {
    if (n.op !== op || n.slots.length !== slots.length + (typed ? 1 : 0)) return false
    for (let i = 0; i < slots.length; i++) if (n.slots[i] !== slots[i]) return false
    return !typed || n.slots[slots.length] === type
}

export function internNode(g: NodeSpace, table: Map<number, number>, op: NodeOp, slots: number[], T: TypeOperand = Types.unknown_number): number {
    const typed = typeSlots(op) > 0
    const type = typed ? encodeType(T) : 0
    let h = internHash(op, slots, type)
    for (;;) {
        const hit = table.get(h)
        if (hit === undefined) break
        if (sameSlots(g.nodes.get(hit)!, op, slots, typed, type)) return hit
        h = (h + 1) & internMask
    }
    const encoded = new Uint32Array(slots.length + (typed ? 1 : 0))
    for (let i = 0; i < slots.length; i++) encoded[i] = slots[i] as u32
    if (typed) encoded[slots.length] = type as u32
    const id = g.ids.next++
    g.nodes.set(id, makeNodeFromSlots(op, encoded))
    table.set(h, id)
    return id
}

export function getRef(n: GraphNode, idx: number): number {
    const id = n.slots[idx] - refBias as i32
    return id >= 0 ? id : 0
}

export function getLiteral(g: NodeSpace, n: GraphNode, idx: number): f64 {
    const v = n.slots[idx]
    return (v >= refBias ? 0 : decodeLiteral(g, v)) as f64
}

export function countIds(n: GraphNode): number {
    return n.slots.length - typeSlots(n.op) - (n.flags & NodeFlags.guarded ? 1 : 0)
}

export function localSymbol(g: NodeSpace, n: GraphNode | undefined): number | undefined {
    if (n?.op !== NodeOp.localTarget || getRef(n, 0)) return undefined
    return getLiteral(g, n, 0)
}

export function isNullishValue(g: NodeSpace, id: number): boolean {
    let n = id ? getNode(g, id) : undefined
    while (n?.op === NodeOp.after) {
        const last = countIds(n) - 1
        if (!getRef(n, last)) return false
        n = getNode(g, getRef(n, last))
    }
    if (n?.op !== NodeOp.heapHandle || countIds(n) !== 1 || getRef(n, 0)) return false
    const handle = getLiteral(g, n, 0)
    return handle === intrinsics.undefinedHandle || handle === intrinsics.nullHandle
}

function appendRaw(pool: LiteralPool, words: number[]): number {
    const raw = pool.raw
    const at = raw.length
    raw.push(words.length)
    for (let i = 0; i < words.length; i++) raw.push(words[i])
    return at
}

export function internRaw(g: NodeSpace, words: number[]): number {
    const pool = g.literals
    const key = words.join(',')
    const known = pool.interned.get(key)
    if (known !== undefined) return known
    const at = appendRaw(pool, words)
    pool.interned.set(key, at)
    return at
}

export function rawLength(g: NodeSpace, at: number): number {
    return g.literals.raw[at]
}

export function rawAt(g: NodeSpace, at: number, i: number): number {
    return g.literals.raw[at + 1 + i]
}

export function rawContents(g: NodeSpace, at: number): number[] {
    return g.literals.raw.slice(at + 1, at + 1 + rawLength(g, at))
}

export function addRaw(g: NodeSpace, words: number[]): number {
    return addNode(g, NodeOp.rawbuffer, [{ literal: appendRaw(g.literals, words) }])
}

function rawNode(g: NodeSpace, id: number): GraphNode {
    const n = getNode(g, id)
    intrinsics.assert(n?.op === NodeOp.rawbuffer, 'graph: a raw read names a node that is not a raw buffer')
    return n!
}

export function rawWords(g: NodeSpace, id: number): number {
    return rawLength(g, getLiteral(g, rawNode(g, id), 0))
}

export function rawWord(g: NodeSpace, id: number, i: number): number {
    return rawAt(g, getLiteral(g, rawNode(g, id), 0), i)
}

export function rawSlot(n: GraphNode): number {
    if (n.op === NodeOp.rawbuffer) return 0
    return n.op === NodeOp.localTarget && countIds(n) === 2 && !getRef(n, 1) ? 1 : -1
}

export function heapInterior(g: NodeSpace, n: GraphNode): number {
    return countIds(n) > 1 && !getRef(n, 1) ? getLiteral(g, n, 1) : 0
}

function heapFieldsAt(n: GraphNode): number {
    return countIds(n) > 1 && !getRef(n, 1) ? 2 : 1
}

export function heapFieldCount(n: GraphNode): number {
    const at = heapFieldsAt(n)
    return countIds(n) > at ? countIds(n) - at - 1 : 0
}

export function heapFieldKey(g: NodeSpace, n: GraphNode, i: number): number {
    return rawWord(g, getRef(n, heapFieldsAt(n)), i)
}

export function heapFieldOperand(g: NodeSpace, n: GraphNode, i: number): Operand {
    return getOperand(g, n, heapFieldsAt(n) + 1 + i)
}

export function heapField(g: NodeSpace, n: GraphNode, key: number): Operand | undefined {
    const count = heapFieldCount(n)
    for (let i = 0; i < count; i++) {
        if (heapFieldKey(g, n, i) === key) return heapFieldOperand(g, n, i)
    }
    return undefined
}

export function heapHandleOperands(g: NodeSpace, cell: number, interior: number, keys: number[], values: Operand[]): Operand[] {
    const operands: Operand[] = [{ literal: cell }]
    if (interior) operands.push({ literal: interior })
    if (!keys.length) return operands
    operands.push(addRaw(g, keys))
    for (const value of values) operands.push(value)
    return operands
}

export function factOf(n: GraphNode): number {
    return n.flags & NodeFlags.guarded ? smallLiteral(n, n.slots.length - 1) : 0
}

export function setFact(n: GraphNode, fact: number): void {
    const updated = withFact(n, fact)
    n.slots = updated.slots
    n.flags = updated.flags
}

export function withFact(n: GraphNode, fact: number): GraphNode {
    const base = n.flags & NodeFlags.guarded ? n.slots.subarray(0, n.slots.length - 1) : n.slots
    if (!fact) return { op: n.op, slots: base.slice(), flags: (n.flags & ~NodeFlags.guarded) as u8, scratchFlags: 0 as u8, epoch: 0 }
    const slots = new Uint32Array(base.length + 1)
    slots.set(base)
    slots[base.length] = encodeSmall(fact) as u32
    return { op: n.op, slots, flags: (n.flags | NodeFlags.guarded) as u8, scratchFlags: 0 as u8, epoch: 0 }
}

export function countLiterals(n: GraphNode): number {
    return n.slots.length
}

export function typeOf(n: GraphNode): intrinsics.Types {
    if (!typeSlots(n.op)) return Types.u64
    const at = countIds(n)
    return getRef(n, at) ? Types.unknown : smallLiteral(n, at)
}

export function machineType(T: intrinsics.Types): intrinsics.Types {
    return T === Types.vm_value ? Types.u32 : slotType(T)
}

export function slotType(T: intrinsics.Types): intrinsics.Types {
    return T === Types.ptr ? Types.u64 : T
}

export function sameSlotBits(a: intrinsics.Types, b: intrinsics.Types): boolean {
    const A = slotType(a)
    const B = slotType(b)
    return A === B || ((A === Types.i64 || A === Types.u64) && (B === Types.i64 || B === Types.u64))
}

export function typeRefOf(n: GraphNode): number {
    return typeSlots(n.op) ? getRef(n, countIds(n)) : 0
}

export type TypeOperand = intrinsics.Types | { ref: number }

function typeOperandOf(n: GraphNode): TypeOperand {
    const ref = typeRefOf(n)
    return ref ? { ref } : typeOf(n)
}

export function encodeType(T: TypeOperand): number {
    return typeof T === 'number' ? encodeSmall(T) : refBias + T.ref
}

export function operandType(g: Graph, n: GraphNode, i: number): intrinsics.Types {
    const ref = getRef(n, i)
    if (!ref) return literalType(getLiteral(g, n, i))
    const producer = getNode(g, ref)
    return producer ? slotType(resultType(g, producer)) : Types.u64
}

function literalType(v: number): intrinsics.Types {
    return v < 0 ? Types.i64 : Types.u64
}

export function floatLiteral(v: number): boolean {
    return !Number.isInteger(v) || v < -(2 ** 63) || v >= 2 ** 64
}

export function resultType(g: Graph, n: GraphNode): intrinsics.Types {
    if (n.op === NodeOp.after) {
        const last = countIds(n) - 1
        const value = getRef(n, last) ? getNode(g, getRef(n, last)) : undefined
        return value ? resultType(g, value) : literalType(getLiteral(g, n, last))
    }
    // XXX: we need union types, this is wrong
    if (n.op === NodeOp.select) {
        let pointers = true
        for (let i = 1; i < countIds(n); i++) {
            const arm = getRef(n, i) ? getNode(g, getRef(n, i)) : undefined
            const T = arm ? resultType(g, arm) : literalType(getLiteral(g, n, i))
            if (T === Types.ptr) continue
            pointers = false
            if (T !== Types.u64) return T
        }
        return pointers ? Types.ptr : Types.u64
    }
    if (n.op === NodeOp.literal && typeOf(n) === Types.u64) return literalType(getLiteral(g, n, 0))
    if (n.op === NodeOp.get) return fieldType(g, n)
    if (n.op !== NodeOp.call) return typeOf(n)
    const target = getNode(g, getRef(n, 1))
    if (!target) return Types.u64
    const fnType = getNode(g, typeRefOf(target))
    if (fnType?.op !== NodeOp.fnType) return typeOf(target)
    const returns = fnReturn(fnType)
    return typeof returns === 'number' ? returns : Types.unknown
}

export function recordTypeAt(g: Graph, id: number): GraphNode | undefined {
    const ref = recordTypeRef(g, getNode(g, id))
    return ref ? getNode(g, ref) : undefined
}

export function recordTypeRef(g: Graph, n: GraphNode | undefined): number {
    if (n?.op === NodeOp.after) return recordTypeRef(g, getNode(g, getRef(n, countIds(n) - 1)))
    if (n?.op === NodeOp.select) return recordTypeRef(g, getNode(g, getRef(n, 1)))
    const target = n?.op === NodeOp.call ? getNode(g, getRef(n, 1)) : undefined
    const fnType = target ? getNode(g, typeRefOf(target)) : undefined
    const ref = fnType?.op === NodeOp.fnType ? getRef(fnType, 0) : n?.op === NodeOp.param ? typeRefOf(n) : 0
    return getNode(g, ref)?.op === NodeOp.recordType ? ref : 0
}

function fieldType(g: Graph, n: GraphNode): intrinsics.Types {
    const t = getRef(n, 1) ? undefined : recordTypeAt(g, getRef(n, 0))
    if (!t) return typeOf(n)
    const key = getLiteral(g, n, 1)
    for (let i = 0; i < countIds(t); i += 2) {
        if (getLiteral(g, t, i) === key && !getRef(t, i + 1)) return smallLiteral(t, i + 1)
    }
    return typeOf(n)
}

export const floatLocation = -2

export function createFnType(g: NodeSpace, returns: TypeOperand, locations: number[] = [], returnLocation = -1): GraphNode {
    return makeNode(g, NodeOp.fnType, [typeof returns === 'number' ? { literal: returns } : returns.ref, { literal: returnLocation }, ...locations.map(literal => ({ literal }))])
}

export function fnReturn(t: GraphNode): TypeOperand {
    const ref = getRef(t, 0)
    return ref ? { ref } : smallLiteral(t, 0)
}

export function fnReturnLocation(t: GraphNode): number {
    return countIds(t) > 1 ? smallLiteral(t, 1) : -1
}

export function fnLocations(t: GraphNode): number[] {
    const out: number[] = []
    for (let i = 2; i < countIds(t); i++) out.push(smallLiteral(t, i))
    return out
}

export function paramLocation(g: NodeSpace, n: GraphNode): number {
    return countIds(n) ? getLiteral(g, n, 0) : -1
}

export type Operand = number | { literal: number }

export function encodeOperand(g: NodeSpace, x: Operand): number {
    return typeof x === 'number' ? (x ? refBias + x : 0) : encodeLiteral(g, x.literal)
}

export function makeNode(
    g: NodeSpace,
    op: NodeOp,
    operands: Operand[],
    T: TypeOperand = Types.u64,
    flags: u8 = NodeFlags.none,
): GraphNode {
    const arity = operands.length
    const tySlots = typeSlots(op)
    const slots = new Uint32Array(arity + tySlots)
    for (let i = 0; i < arity; i++) slots[i] = encodeOperand(g, operands[i]) as u32
    if (tySlots) slots[arity] = encodeType(T) as u32
    return { op, slots, flags: (flags & ~NodeFlags.guarded) as u8, scratchFlags: 0 as u8, epoch: 0 }
}

export function makeNodeFromSlots(
    op: NodeOp,
    slots: Uint32Array,
    flags: u8 = NodeFlags.none,
): GraphNode {
    return { op, slots, flags, scratchFlags: 0 as u8, epoch: 0 }
}

export interface RecordField {
    key: number
    type: TypeOperand
}

export function createRecordType(g: NodeSpace, fields: RecordField[]): GraphNode {
    const operands: Operand[] = []
    for (const field of fields) {
        operands.push({ literal: field.key })
        operands.push(typeof field.type === 'number' ? { literal: field.type } : field.type.ref)
    }
    return makeNode(g, NodeOp.recordType, operands)
}

export function recordFields(g: NodeSpace, t: GraphNode): RecordField[] {
    const fields: RecordField[] = []
    for (let i = 0; i < countIds(t); i += 2) {
        const ref = getRef(t, i + 1)
        fields.push({ key: getLiteral(g, t, i), type: ref ? { ref } : smallLiteral(t, i + 1) })
    }
    return fields
}

export function createThisParam(g: NodeSpace): GraphNode {
    return makeNode(g, NodeOp.param, [], Types.u64, NodeFlags.this_param)
}

export function isThisParam(n: GraphNode): boolean {
    return n.op === NodeOp.param && (n.flags & NodeFlags.this_param) !== 0
}

export function createLocatedParam(g: NodeSpace, location: number): GraphNode {
    return makeNode(g, NodeOp.param, [{ literal: location }])
}

export function copyNode(g: NodeSpace, n: GraphNode, operands?: Operand[], op: NodeOp = n.op): GraphNode {
    if (!operands && op === n.op) return { op, slots: n.slots.slice(), flags: n.flags, scratchFlags: n.scratchFlags, epoch: 0 }
    const copy = makeNode(g, op, operands ?? getOperands(g, n), typeOperandOf(n), n.flags)
    const fact = factOf(n)
    return fact && op === n.op ? withFact(copy, fact) : copy
}

export function swapBinaryOperands(n: GraphNode): void {
    const slots = n.slots
    const arg = slots[0]
    slots[0] = slots[1]
    slots[1] = arg
}

export function getArgIds(n: GraphNode): number[] {
    const arity = countIds(n)
    const out = new Array(arity)
    for (let i = 0; i < arity; i++) out[i] = getRef(n, i)
    return out
}

// export function* enumerateRefs(n: GraphNode) {
//     const arity = countIds(n)
//     let i = 0
//     while (i < arity) {
//         const r = getRef(n, i++)
//         if (r) yield r
//     }
// }

export function enumerateRefs(n: GraphNode) {
    let i = 0
    const arity = countIds(n)
    return {
        next() {
            while (i < arity) {
                const r = getRef(n, i++)
                if (r) return { done: false, value: r }
            }
            return { done: true, value: 0 } as const
        },
        [Symbol.iterator]() { return this },
    }
}

export function getArgConsts(g: NodeSpace, n: GraphNode): Float64Array {
    const out = new Float64Array(n.slots.length - (n.flags & NodeFlags.guarded ? 1 : 0))
    for (let i = 0; i < out.length; i++) out[i] = getLiteral(g, n, i)
    return out
}

function clampRange(arity: number, start: number, end: number): number[] {
    const from = start < 0 ? Math.max(arity + start, 0) : Math.min(start, arity)
    const to = end < 0 ? Math.max(arity + end, 0) : Math.min(end, arity)
    return [from, Math.max(to, from)]
}

export function cloneRefs(n: GraphNode, start = 0, end = countIds(n)): number[] {
    const [from, to] = clampRange(countIds(n), start, end)
    const out = new Array(to - from)
    for (let i = from; i < to; i++) out[i - from] = getRef(n, i)
    return out
}

export function getOperand(g: NodeSpace, n: GraphNode, idx: number): Operand {
    const id = getRef(n, idx)
    return id ? id : { literal: getLiteral(g, n, idx) }
}

export function getOperands(g: NodeSpace, n: GraphNode, start = 0, end = countIds(n)): Operand[] {
    const [from, to] = clampRange(countIds(n), start, end)
    const out: Operand[] = new Array(to - from)
    for (let i = from; i < to; i++) out[i - from] = getOperand(g, n, i)
    return out
}

export function withRefs(g: NodeSpace, n: GraphNode, refs: number[]): Operand[] {
    return refs.map((ref, i) => ref || { literal: getLiteral(g, n, i) })
}

export function setType(n: GraphNode, T: TypeOperand): void {
    n.slots[countIds(n)] = encodeType(T) as u32
}

export function setOperand(g: NodeSpace, n: GraphNode, idx: number, x: Operand): void {
    n.slots[idx] = encodeOperand(g, x) as u32
}

export function setRef(n: GraphNode, idx: number, v: number): void {
    n.slots[idx] = (v ? refBias + v : 0) as u32
}

export function setLiteral(g: NodeSpace, n: GraphNode, idx: number, v: number): void {
    n.slots[idx] = encodeLiteral(g, v) as u32
}

export function pushRefs(n: GraphNode, refs: number[]): void {
    const tySlots = typeSlots(n.op)
    const arity = countIds(n)
    const encoded = new Uint32Array(arity + refs.length + tySlots)
    for (let i = 0; i < arity; i++) encoded[i] = n.slots[i]
    for (let i = 0; i < refs.length; i++) encoded[arity + i] = (refs[i] ? refBias + refs[i] : 0) as u32
    for (let i = 0; i < tySlots; i++) encoded[arity + refs.length + i] = n.slots[arity + i]
    const fact = factOf(n)
    n.slots = encoded
    if (fact) n.slots = withFact({ ...n, flags: (n.flags & ~NodeFlags.guarded) as u8 }, fact).slots
}

export function clearOperands(n: GraphNode): void {
    const tySlots = typeSlots(n.op)
    const arity = countIds(n)
    const encoded = new Uint32Array(tySlots)
    for (let i = 0; i < tySlots; i++) encoded[i] = n.slots[arity + i]
    const fact = factOf(n)
    n.slots = encoded
    if (fact) n.slots = withFact({ ...n, flags: (n.flags & ~NodeFlags.guarded) as u8 }, fact).slots
}

export function setDebugLabel(g: DebugLabels, id: number, label: string): void {
    g.debugLabels.set(id, label)
}

export function getDebugLabel(g: DebugLabels, id: number): string | undefined {
    return g.debugLabels.get(id)
}

export function blockOrder(g: Graph, b: GraphBlock): number[] {
    const order: number[] = []
    const seen = new Set<number>([b.bodyId])
    const stack: number[] = [b.bodyId]
    const slots: number[] = [0]
    while (stack.length) {
        const top = stack.length - 1
        const id = stack[top]
        const n = getNode(g, id)
        const i = slots[top]
        if (n && n.op !== NodeOp.param && n.op !== NodeOp.block && i < countIds(n)) {
            slots[top] = i + 1
            const x = getRef(n, i)
            if (x && !seen.has(x)) {
                seen.add(x)
                stack.push(x)
                slots.push(0)
            }
            continue
        }
        stack.pop()
        slots.pop()
        order.push(id)
    }
    return order
}

export interface RegionTree {
    parent: number[]
    depth: number[]
    origin: number[]
    slot: number[]
    link: number[]
    roots: number[]
    of: Map<number, number>
    children: Map<number, number>
    nests: (n: GraphNode, i: number, id: number) => boolean
}

export interface GraphRegions extends RegionTree {
    blockOf: Map<number, number>
    shared: Set<number>
    paramBlock: Map<number, number>
    arrivals: number[][]
}

export function armSlot(n: GraphNode, i: number): boolean {
    return n.op === NodeOp.select && i > 0
}

export function armOrBodySlot(n: GraphNode, i: number): boolean {
    if (n.op === NodeOp.inlined) return i === 0
    return armSlot(n, i)
}

function createRegionTree(nests: (n: GraphNode, i: number) => boolean = armSlot): RegionTree {
    return { parent: [], depth: [], origin: [], slot: [], link: [], roots: [], of: new Map(), children: new Map(), nests }
}

function rootRegion(t: RegionTree): number {
    const r = t.parent.length
    t.parent.push(-1)
    t.depth.push(0)
    t.origin.push(0)
    t.slot.push(0)
    t.link.push(-1)
    t.roots.push(r)
    return r
}

export function childRegion(t: RegionTree, parent: number, origin: number, slot: number): number {
    intrinsics.assert(origin < 16777216 && slot < 4, `graph: region of %${origin} slot ${slot} does not fit a region key`)
    const key = (parent * 16777216 + origin) * 4 + slot
    const known = t.children.get(key)
    if (known !== undefined) return known
    const r = t.parent.length
    t.parent.push(parent)
    t.depth.push(t.depth[parent] + 1)
    t.origin.push(origin)
    t.slot.push(slot)
    t.link.push(-1)
    t.children.set(key, r)
    return r
}

export function regionUp(t: RegionTree, r: number): number {
    return t.depth[r] > 0 ? t.parent[r] : t.link[r]
}

function regionLca(t: RegionTree, a: number, b: number): number {
    let x = a
    let y = b
    while (t.depth[x] > t.depth[y]) x = t.parent[x]
    while (t.depth[y] > t.depth[x]) y = t.parent[y]
    while (x !== y) {
        x = t.parent[x]
        y = t.parent[y]
    }
    return x
}

export function demandRegion(t: RegionTree, user: number, n: GraphNode, i: number): number {
    const ru = t.of.get(user)
    if (ru === undefined) return -1
    return edgeRegion(t, n, user, i, ru)
}

function edgeRegion(t: RegionTree, n: GraphNode, user: number, i: number, ru: number): number {
    return t.nests(n, i, user) ? childRegion(t, ru, user, n.op === NodeOp.select ? i : 3) : ru
}

export function orderRegions(g: NodeSpace, order: number[], nests: (n: GraphNode, i: number) => boolean = armSlot): RegionTree {
    const t = createRegionTree(nests)
    const root = rootRegion(t)
    if (order.length) t.of.set(order[order.length - 1], root)
    let k = order.length - 1
    while (k >= 0) {
        const id = order[k]
        k--
        const ru = t.of.get(id)
        const n = getNode(g, id)
        if (ru === undefined || !n || n.op === NodeOp.param || n.op === NodeOp.block) continue
        let i = 0
        while (i < countIds(n)) {
            const ref = getRef(n, i)
            if (ref) {
                const c = edgeRegion(t, n, id, i, ru)
                const prior = t.of.get(ref)
                t.of.set(ref, prior === undefined ? c : regionLca(t, prior, c))
            }
            i++
        }
    }
    return t
}

function noCharge(_n: number): void {
}

function unordered(_n: GraphNode, _id: number): number {
    return 0
}

export function graphRegions(g: Graph, charge: (n: number) => void = noCharge, nests: (n: GraphNode, i: number, id: number) => boolean = armSlot, orderedAfter: (n: GraphNode, id: number) => number = unordered): GraphRegions {
    const r: GraphRegions = {
        parent: [], depth: [], origin: [], slot: [], link: [], roots: [], of: new Map(), children: new Map(), nests,
        blockOf: new Map(), shared: new Set(), paramBlock: new Map(), arrivals: [],
    }
    const nb = g.blocks.length
    const indexOf = new Map<number, number>()
    const orders: number[][] = []
    let b = 0
    while (b < nb) {
        const block = g.blocks[b]
        indexOf.set(block.id, b)
        for (const p of block.params) r.paramBlock.set(p, b)
        r.arrivals.push([])
        b++
    }
    b = 0
    while (b < nb) {
        orders.push([])
        b++
    }
    const claimed = new Uint8Array(nb)
    const pending: number[] = nb ? [0] : []
    let next = 0
    while (pending.length || next < nb) {
        if (!pending.length) {
            pending.push(next)
            next++
        }
        const at = pending.pop()!
        if (claimed[at]) continue
        claimed[at] = 1
        const order = orders[at]
        const body = g.blocks[at].bodyId
        if (body) claimBlock(g, r, at, body, order, charge)
        let k = order.length - 1
        while (k >= 0) {
            const n = getNode(g, order[k])!
            k--
            if (n.op !== NodeOp.apply) continue
            const target = indexOf.get(getRef(n, 0))
            if (target !== undefined && !claimed[target]) pending.push(target)
        }
    }
    const exits: number[][] = []
    b = 0
    while (b < nb) {
        const root = rootRegion(r)
        const out: number[] = []
        exits.push(out)
        const order = orders[b]
        let k = order.length - 1
        while (k >= 0) {
            const id = order[k]
            k--
            if (!r.of.has(id) || r.shared.has(id)) r.of.set(id, root)
            const n = getNode(g, id)!
            const ru = r.of.get(id)!
            if (n.op === NodeOp.apply) {
                const target = indexOf.get(getRef(n, 0))
                if (target !== undefined) {
                    out.push(target)
                    out.push(ru)
                    r.arrivals[target].push(id)
                }
            }
            let i = 0
            while (i < countIds(n)) {
                const ref = getRef(n, i)
                if (ref && r.blockOf.get(ref) === b && !r.shared.has(ref)) {
                    const c = edgeRegion(r, n, id, i, ru)
                    const prior = r.of.get(ref)
                    r.of.set(ref, prior === undefined ? c : regionLca(r, prior, c))
                }
                i++
            }
            const after = orderedAfter(n, id)
            if (after && r.blockOf.get(after) === b && !r.shared.has(after)) {
                const prior = r.of.get(after)
                r.of.set(after, prior === undefined ? ru : regionLca(r, prior, ru))
            }
        }
        b++
    }
    linkBlocks(r, exits, charge)
    const placed = new Map<number, number>()
    const memo: number[] = []
    b = nb - 1
    while (b >= 0) {
        const body = g.blocks[b].bodyId
        if (body && !placed.has(body)) placed.set(body, r.roots[b])
        const order = orders[b]
        let k = order.length - 1
        while (k >= 0) {
            const id = order[k]
            k--
            const ru = placed.get(id)
            if (ru === undefined) continue
            charge(1)
            const n = getNode(g, id)!
            let i = 0
            while (i < countIds(n)) {
                const ref = getRef(n, i)
                if (ref && r.blockOf.has(ref)) {
                    const c = edgeRegion(r, n, id, i, ru)
                    const prior = placed.get(ref)
                    placed.set(ref, prior === undefined ? c : linkedLca(r, memo, prior, c))
                }
                i++
            }
            const after = orderedAfter(n, id)
            if (after && r.blockOf.has(after)) {
                const prior = placed.get(after)
                placed.set(after, prior === undefined ? ru : linkedLca(r, memo, prior, ru))
            }
        }
        b--
    }
    r.of = placed
    return r
}

function claimBlock(g: Graph, r: GraphRegions, b: number, body: number, order: number[], charge: (n: number) => void): void {
    if (r.blockOf.has(body)) {
        r.shared.add(body)
        return
    }
    r.blockOf.set(body, b)
    const stack: number[] = [body]
    const next: number[] = [0]
    while (stack.length) {
        const top = stack.length - 1
        const id = stack[top]
        const n = getNode(g, id)
        const at = next[top]
        if (n && at < countIds(n)) {
            next[top] = at + 1
            const ref = getRef(n, at)
            const m = ref ? getNode(g, ref) : undefined
            if (!m || m.op === NodeOp.block) continue
            const known = r.blockOf.get(ref)
            if (known !== undefined) {
                if (known !== b) r.shared.add(ref)
                continue
            }
            charge(1)
            r.blockOf.set(ref, b)
            stack.push(ref)
            next.push(0)
            continue
        }
        stack.pop()
        next.pop()
        order.push(id)
    }
}

function linkBlocks(r: GraphRegions, exits: number[][], charge: (n: number) => void): void {
    const nb = exits.length
    if (!nb) return
    const order: number[] = []
    const rpo = new Int32Array(nb).fill(-1)
    const visited = new Uint8Array(nb)
    const stack: number[] = [0]
    const edge: number[] = [0]
    visited[0] = 1
    while (stack.length) {
        const top = stack.length - 1
        const b = stack[top]
        const k = edge[top]
        if (k < exits[b].length) {
            edge[top] = k + 2
            const to = exits[b][k]
            if (visited[to]) continue
            visited[to] = 1
            stack.push(to)
            edge.push(0)
            continue
        }
        stack.pop()
        edge.pop()
        order.push(b)
    }
    order.reverse()
    let i = 0
    while (i < order.length) {
        rpo[order[i]] = i
        i++
    }
    const preds: number[][] = []
    i = 0
    while (i < nb) {
        preds.push([])
        i++
    }
    for (const b of order) {
        let k = 0
        while (k < exits[b].length) {
            preds[exits[b][k]].push(b)
            k += 2
        }
    }
    const idom = new Int32Array(nb).fill(-1)
    idom[0] = 0
    let changed = true
    while (changed) {
        changed = false
        i = 1
        while (i < order.length) {
            const b = order[i]
            i++
            let d = -1
            for (const p of preds[b]) {
                charge(1)
                if (idom[p] < 0) continue
                if (d < 0) {
                    d = p
                    continue
                }
                let x = p
                let y = d
                while (x !== y) {
                    while (rpo[x] > rpo[y]) x = idom[x]
                    while (rpo[y] > rpo[x]) y = idom[y]
                }
                d = x
            }
            if (d >= 0 && idom[b] !== d) {
                idom[b] = d
                changed = true
            }
        }
    }
    i = 1
    while (i < order.length) {
        const b = order[i]
        i++
        const d = idom[b]
        if (d < 0) continue
        let region = -1
        let backOnly = true
        for (const p of preds[b]) {
            charge(1)
            if (p !== d && rpo[p] < rpo[b]) backOnly = false
        }
        if (backOnly) {
            const out = exits[d]
            let k = 0
            while (k < out.length) {
                if (out[k] === b) region = region < 0 ? out[k + 1] : regionLca(r, region, out[k + 1])
                k += 2
            }
        }
        r.link[r.roots[b]] = region >= 0 ? region : r.roots[d]
    }
}

function linkedDepth(t: RegionTree, memo: number[], r: number): number {
    const path: number[] = []
    let at = r
    while (at >= 0 && memo[at] === undefined) {
        path.push(at)
        at = regionUp(t, at)
    }
    let d = at >= 0 ? memo[at] : -1
    let i = path.length - 1
    while (i >= 0) {
        d++
        memo[path[i]] = d
        i--
    }
    return memo[r]
}

function linkedLca(t: RegionTree, memo: number[], a: number, b: number): number {
    let x = a
    let y = b
    let dx = linkedDepth(t, memo, x)
    let dy = linkedDepth(t, memo, y)
    while (dx > dy) {
        x = regionUp(t, x)
        dx--
    }
    while (dy > dx) {
        y = regionUp(t, y)
        dy--
    }
    while (x !== y) {
        x = regionUp(t, x)
        y = regionUp(t, y)
        if (x < 0 || y < 0) return t.roots[0]
    }
    return x
}
