"use wrapped";

import * as intrinsics from './intrinsics'
import type { Graph, GraphBlock, GraphNode } from './lowering2'

const Types = intrinsics.Types

export interface DebugLabels {
    debugLabels: Map<number, string>
}

export function createGraph(init?: Partial<Graph>): Graph {
    const g: Graph = {
        maxId: 1,
        nodes: new Map(),
        blocks: [],
        blockIndex: new Map(),
        epoch: 0,
        debugLabels: new Map(),
        ...init,
    }
    setGraphBlocks(g, g.blocks)
    return g
}

export function getBlock(g: Graph, id: number): GraphBlock | undefined {
    return g.blockIndex.get(id)
}

export function addGraphBlock(g: Graph, block: GraphBlock): void {
    g.blocks.push(block)
    g.blockIndex.set(block.id, block)
}

export function setGraphBlocks(g: Graph, blocks: GraphBlock[]): void {
    g.blocks = blocks
    g.blockIndex = new Map()
    for (const block of blocks) g.blockIndex.set(block.id, block)
}

const TypeSlots = new Map<string, number>([
    ['load', 1], ['store', 1],
    ['convert', 2], ['bitconvert', 2],
    ['add', 2], ['sub', 2], ['mul', 2], ['div', 2], ['rem', 2], ['subsat', 2],
    ['or', 2], ['and', 2], ['xor', 2], ['shl', 2], ['shr', 2], ['ushr', 2],
    ['lt', 2], ['le', 2], ['gt', 2], ['ge', 2], ['eq', 2], ['ne', 2],
])

export function typeSlots(op: string): number {
    return TypeSlots.get(op) ?? 0
}

const refBias = 2 ** 29
const allocBias = 2 ** 28
const inlineMin = -(2 ** 27)
const inlineMax = 2 ** 27
const inlineMask = 0x0FFFFFFF
const inlineShift = 4

const allocated: number[] = []
const allocatedAt = new Map<number, number>()

function allocateLiteral(v: number): number {
    let at = allocatedAt.get(v)
    if (at === undefined) {
        at = allocated.length
        allocated.push(v)
        allocatedAt.set(v, at)
    }
    return allocBias + at
}

function encodeLiteral(v: number): number {
    if (v >= inlineMin && v < inlineMax && Number.isInteger(v) && !Object.is(v, -0)) {
        return v & inlineMask
    }
    return allocateLiteral(v)
}

export function encodeSlot(id: number, literal: number): number {
    return id ? refBias + id : encodeLiteral(literal)
}

function decodeLiteral(v: number): number {
    const at = v - allocBias
    if (at >= 0) return allocated[at]
    return (v << inlineShift) >> inlineShift
}

export function getRef(n: GraphNode, idx: number): number {
    const id = n.slots[idx] - refBias as i32
    return id >= 0 ? id : 0
}

export function getLiteral(n: GraphNode, idx: number): f64 {
    const v = n.slots[idx]
    return (v >= refBias ? 0 : decodeLiteral(v)) as f64
}

export function countIds(n: GraphNode): number {
    return n.slots.length - typeSlots(n.op)
}

export function countLiterals(n: GraphNode): number {
    return n.slots.length
}

export function getTypeT(n: GraphNode): intrinsics.Types {
    return typeSlots(n.op) ? getLiteral(n, countIds(n)) : Types.u64
}

export function getTypeU(n: GraphNode): intrinsics.Types {
    return typeSlots(n.op) > 1 ? getLiteral(n, countIds(n) + 1) : Types.u64
}

function withTypes(
    op: string,
    argIds: number[],
    argConsts: ArrayLike<number>,
    T: intrinsics.Types,
    U: intrinsics.Types,
    tySlots: number,
): GraphNode {
    const arity = argIds.length
    const encoded = new Uint32Array(arity + tySlots)
    for (let i = 0; i < arity; i++) encoded[i] = encodeSlot(argIds[i], argConsts[i]) as u32
    if (tySlots) encoded[arity] = encodeLiteral(T) as u32
    if (tySlots > 1) encoded[arity + 1] = encodeLiteral(U) as u32
    return { op, slots: encoded, epoch: 0 }
}

export function createLoad(argIds: number[], argConsts: ArrayLike<number>, T: intrinsics.Types): GraphNode {
    return withTypes('load', argIds, argConsts, T, Types.u64, 1)
}

export function createStore(argIds: number[], argConsts: ArrayLike<number>, T: intrinsics.Types): GraphNode {
    return withTypes('store', argIds, argConsts, T, Types.u64, 1)
}

export function createConvert(
    op: string,
    argIds: number[],
    argConsts: ArrayLike<number>,
    T: intrinsics.Types,
    U: intrinsics.Types,
): GraphNode {
    return withTypes(op, argIds, argConsts, T, U, 2)
}

export function createArith(
    op: string,
    argIds: number[],
    argConsts: ArrayLike<number>,
    T: intrinsics.Types,
    U: intrinsics.Types,
): GraphNode {
    return withTypes(op, argIds, argConsts, T, U, 2)
}

export function makeNode(
    op: string,
    argIds: number[],
    argConsts: ArrayLike<number>,
    T: intrinsics.Types = Types.u64,
    U: intrinsics.Types = Types.u64,
): GraphNode {
    const tySlots = typeSlots(op)
    if (tySlots === 1) return op === 'load' ? createLoad(argIds, argConsts, T) : createStore(argIds, argConsts, T)
    if (tySlots === 2) {
        return op === 'convert' || op === 'bitconvert'
            ? createConvert(op, argIds, argConsts, T, U)
            : createArith(op, argIds, argConsts, T, U)
    }
    return withTypes(op, argIds, argConsts, T, U, 0)
}

export function makeNodeFromSlots(
    op: string,
    slots: Uint32Array
): GraphNode {
    return { op, slots, epoch: 0 }
}

export function createRecordParam(keys: number[]): GraphNode {
    return makeNode('param', new Array(keys.length + 1).fill(0), new Float64Array([keys.length, ...keys]))
}

export function copyNode(n: GraphNode, argIds?: number[], argConsts?: ArrayLike<number>, op = n.op): GraphNode {
    if (!argIds && !argConsts && op === n.op) return { op, slots: n.slots.slice(), epoch: 0 }
    const arity = argIds ? argIds.length : countIds(n)
    const tySlots = typeSlots(op)
    const encoded = new Uint32Array(arity + tySlots)
    for (let i = 0; i < arity; i++) {
        const id = argIds ? argIds[i] : getRef(n, i)
        encoded[i] = (id ? refBias + id : encodeLiteral(argConsts ? argConsts[i] : getLiteral(n, i))) as u32
    }
    if (tySlots) encoded[arity] = encodeLiteral(getTypeT(n)) as u32
    if (tySlots > 1) encoded[arity + 1] = encodeLiteral(getTypeU(n)) as u32
    return { op, slots: encoded, epoch: 0 }
}

export function getArgIds(n: GraphNode): number[] {
    const arity = countIds(n)
    const out = new Array(arity)
    for (let i = 0; i < arity; i++) out[i] = getRef(n, i)
    return out
}

// export function* enumerateRefs(n: GraphNode) {
//     const arity = countIds(n)
//     let i = 0
//     while (i < arity) {
//         const r = getRef(n, i++)
//         if (r) yield r
//     }
// }

export function enumerateRefs(n: GraphNode) {
    let i = 0
    const arity = countIds(n)
    return {
        next() {
            while (i < arity) {
                const r = getRef(n, i++)
                if (r) return { done: false, value: r }
            }
            return { done: true, value: 0 } as const
        },
        [Symbol.iterator]() { return this },
    }
}

export function getArgConsts(n: GraphNode): Float64Array {
    const out = new Float64Array(n.slots.length)
    for (let i = 0; i < out.length; i++) out[i] = getLiteral(n, i)
    return out
}

function clampRange(arity: number, start: number, end: number): number[] {
    const from = start < 0 ? Math.max(arity + start, 0) : Math.min(start, arity)
    const to = end < 0 ? Math.max(arity + end, 0) : Math.min(end, arity)
    return [from, Math.max(to, from)]
}

export function cloneRefs(n: GraphNode, start = 0, end = countIds(n)): number[] {
    const [from, to] = clampRange(countIds(n), start, end)
    const out = new Array(to - from)
    for (let i = from; i < to; i++) out[i - from] = getRef(n, i)
    return out
}

export function cloneLiterals(n: GraphNode, start = 0, end = countIds(n)): Float64Array {
    const [from, to] = clampRange(countIds(n), start, end)
    const out = new Float64Array(to - from)
    for (let i = from; i < to; i++) out[i - from] = getLiteral(n, i)
    return out
}

export function setRef(n: GraphNode, idx: number, v: number): void {
    n.slots[idx] = (v ? refBias + v : 0) as u32
}

export function setLiteral(n: GraphNode, idx: number, v: number): void {
    n.slots[idx] = encodeLiteral(v) as u32
}

export function pushRefs(n: GraphNode, refs: number[]): void {
    const tySlots = typeSlots(n.op)
    const arity = countIds(n)
    const encoded = new Uint32Array(arity + refs.length + tySlots)
    for (let i = 0; i < arity; i++) encoded[i] = n.slots[i]
    for (let i = 0; i < refs.length; i++) encoded[arity + i] = (refs[i] ? refBias + refs[i] : 0) as u32
    for (let i = 0; i < tySlots; i++) encoded[arity + refs.length + i] = n.slots[arity + i]
    n.slots = encoded
}

export function clearOperands(n: GraphNode): void {
    const tySlots = typeSlots(n.op)
    const arity = countIds(n)
    const encoded = new Uint32Array(tySlots)
    for (let i = 0; i < tySlots; i++) encoded[i] = n.slots[arity + i]
    n.slots = encoded
}

export function setDebugLabel(g: DebugLabels, id: number, label: string): void {
    g.debugLabels.set(id, label)
}

export function getDebugLabel(g: DebugLabels, id: number): string | undefined {
    return g.debugLabels.get(id)
}
