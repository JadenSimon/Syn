"use wrapped";

import * as intrinsics from './intrinsics'
import type { Graph, GraphNode } from './lowering2'

const Types = intrinsics.Types

export interface DebugLabels {
    debugLabels: Map<number, string>
}

export function createGraph(init?: Partial<Graph>): Graph {
    return {
        maxId: 1,
        nodes: new Map(),
        blocks: [],
        epoch: 0,
        debugLabels: new Map(),
        ...init,
    }
}

const TypeSlots = new Map<string, number>([
    ['load', 1], ['store', 1],
    ['convert', 2], ['bitconvert', 2],
    ['add', 2], ['sub', 2], ['mul', 2], ['div', 2], ['rem', 2], ['subsat', 2],
    ['or', 2], ['and', 2], ['xor', 2], ['shl', 2], ['shr', 2], ['ushr', 2],
    ['lt', 2], ['le', 2], ['gt', 2], ['ge', 2], ['eq', 2], ['ne', 2],
])

export function typeSlots(op: string): number {
    return TypeSlots.get(op) ?? 0
}

export function getTypeT(n: GraphNode): intrinsics.Types {
    return typeSlots(n.op) ? n.argConsts[n.argIds.length] : Types.u64
}

export function getTypeU(n: GraphNode): intrinsics.Types {
    return typeSlots(n.op) > 1 ? n.argConsts[n.argIds.length + 1] : Types.u64
}

function withTypes(
    op: string,
    argIds: number[],
    argConsts: Float64Array,
    T: intrinsics.Types,
    U: intrinsics.Types,
    slots: number,
): GraphNode {
    const arity = argIds.length
    const consts = new Float64Array(arity + slots)
    for (let i = 0; i < arity; i++) consts[i] = argConsts[i]
    consts[arity] = T
    if (slots > 1) consts[arity + 1] = U
    return { op, argIds, argConsts: consts, epoch: 0 }
}

export function createLoad(argIds: number[], argConsts: Float64Array, T: intrinsics.Types): GraphNode {
    return withTypes('load', argIds, argConsts, T, Types.u64, 1)
}

export function createStore(argIds: number[], argConsts: Float64Array, T: intrinsics.Types): GraphNode {
    return withTypes('store', argIds, argConsts, T, Types.u64, 1)
}

export function createConvert(
    op: string,
    argIds: number[],
    argConsts: Float64Array,
    T: intrinsics.Types,
    U: intrinsics.Types,
): GraphNode {
    return withTypes(op, argIds, argConsts, T, U, 2)
}

export function createArith(
    op: string,
    argIds: number[],
    argConsts: Float64Array,
    T: intrinsics.Types,
    U: intrinsics.Types,
): GraphNode {
    return withTypes(op, argIds, argConsts, T, U, 2)
}

export function makeNode(
    op: string,
    argIds: number[],
    argConsts: Float64Array,
    T: intrinsics.Types = Types.u64,
    U: intrinsics.Types = Types.u64,
): GraphNode {
    const slots = typeSlots(op)
    if (slots === 1) return op === 'load' ? createLoad(argIds, argConsts, T) : createStore(argIds, argConsts, T)
    if (slots === 2) {
        return op === 'convert' || op === 'bitconvert'
            ? createConvert(op, argIds, argConsts, T, U)
            : createArith(op, argIds, argConsts, T, U)
    }
    const arity = argIds.length
    return { op, argIds, argConsts: argConsts.length === arity ? argConsts : argConsts.slice(0, arity), epoch: 0 }
}

export function createRecordParam(keys: number[]): GraphNode {
    return makeNode('param', new Array(keys.length + 1).fill(0), new Float64Array([keys.length, ...keys]))
}

export function copyNode(n: GraphNode, argIds = n.argIds, argConsts = n.argConsts, op = n.op): GraphNode {
    return makeNode(op, argIds, argConsts, getTypeT(n), getTypeU(n))
}

export function getArgIds(n: GraphNode): number[] {
    return n.argIds
}

export function getArgConsts(n: GraphNode): Float64Array {
    return n.argConsts
}

export function getRef(n: GraphNode, idx: number): number {
    return n.argIds[idx]
}

export function getLiteral(n: GraphNode, idx: number): f64 {
    return n.argConsts[idx]
}

export function countIds(n: GraphNode): number {
    return n.argIds.length
}

export function countLiterals(n: GraphNode): number {
    return n.argConsts.length
}

export function cloneRefs(n: GraphNode, start = 0, end = n.argIds.length): number[] {
    return n.argIds.slice(start, end)
}

export function cloneLiterals(n: GraphNode, start = 0, end = n.argIds.length): Float64Array {
    return n.argConsts.slice(start, end)
}

export function setRef(n: GraphNode, idx: number, v: number): void {
    n.argIds[idx] = v
    n.argConsts[idx] = 0 as f64
}

export function setLiteral(n: GraphNode, idx: number, v: number): void {
    n.argIds[idx] = 0
    n.argConsts[idx] = v as f64
}

export function pushRefs(n: GraphNode, refs: number[]): void {
    const slots = typeSlots(n.op)
    const arity = n.argIds.length
    const consts = new Float64Array(arity + refs.length + slots)
    for (let i = 0; i < arity; i++) consts[i] = n.argConsts[i]
    for (let i = 0; i < slots; i++) consts[arity + refs.length + i] = n.argConsts[arity + i]
    for (let i = 0; i < refs.length; i++) n.argIds.push(refs[i])
    n.argConsts = consts
}

export function clearOperands(n: GraphNode): void {
    const slots = typeSlots(n.op)
    const consts = new Float64Array(slots)
    for (let i = 0; i < slots; i++) consts[i] = n.argConsts[n.argIds.length + i]
    n.argIds = []
    n.argConsts = consts
}

export function setDebugLabel(g: DebugLabels, id: number, label: string): void {
    g.debugLabels.set(id, label)
}

export function getDebugLabel(g: DebugLabels, id: number): string | undefined {
    return g.debugLabels.get(id)
}
