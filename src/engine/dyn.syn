/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import * as native from './native'
import * as harness from './harness'
import * as rt from './rt'
import { type Graph, type GraphNode, dumpGraph } from './lowering2'
import {
    NodeOp, NodeFlags, addNode, blockOrder, typeSlots as typeSlotsOf, copyNode, countIds, createGraph, getLiteral, getNode, getOperand, getRef, isThisParam, putNode, setGraphBlocks, typeOf, withNodes,
    type Operand,
} from './graph-node'
import type { FastTraced } from './fast-trace'
import { globals as builtinGlobals, programStack } from './builtins'
import { parseNumber } from './builtin/Number'
import * as optimizer from './program-optimizer'
import { Kinds, anyKinds, useVersion, usesCallee, versionOf, type Contract, type Host, type Version } from './call-graph'

const Types = intrinsics.Types

type Handle = intrinsics.Handle
const Intrinsics = intrinsics.Intrinsics

const flags = new Set(intrinsics.argv())

const argRegs = 4
const callKey = heap.fromJsSymbol(Symbol('Call'))
const promotedKey = Symbol('Promoted')
const pendingSymbol = Symbol('pending')
const numberPrototype = builtinGlobals.Number.prototype

function fromBits(bits: u64): u32 {
    return heap.floatWord(Intrinsics.bitconvert(bits, Types.u64, Types.f64))
}

function toBits(word: u32): u64 {
    return Intrinsics.bitconvert(heap.wordFloat(word), Types.f64, Types.u64)
}

function numberBits(word: u32): u64 {
    const handle = Intrinsics.ushr(word, 1, Types.u32) as Handle
    if (Intrinsics.and(word, 1, Types.u32) !== 0 && handle > heap.trueHandle && word < heap.pstackWordTag && heap.isString(handle)) {
        const parsed: f64 = parseNumber(rt.rt.stringOf(handle))
        return Intrinsics.bitconvert(parsed, Types.f64, Types.u64)
    }
    return Intrinsics.bitconvert(heap.wordFloat(word), Types.f64, Types.u64)
}

function powerBits(baseBits: u64, exponentBits: u64): u64 {
    const base = Intrinsics.bitconvert(baseBits, Types.u64, Types.f64)
    const exponent = Intrinsics.bitconvert(exponentBits, Types.u64, Types.f64)
    let n = Intrinsics.convert(exponent, Types.f64, Types.i64)
    const whole = Intrinsics.convert(n, Types.i64, Types.f64) === exponent
    const negative = n < 0
    if (negative) n = 0 - n
    let result: f64 = 1
    let x = base
    while (n > 0) {
        if (Intrinsics.and(n, 1, Types.i64) !== 0) result = result * x
        x = x * x
        n = Intrinsics.shr(n, 1, Types.i64)
    }
    if (negative) result = 1 / result
    if (!whole) result = NaN
    return Intrinsics.bitconvert(result, Types.f64, Types.u64)
}

function machineType(word: u32): u32 {
    if (Intrinsics.and(word, 1, Types.u32) === 0) return Types.i64
    return heap.isBoxedF64(Intrinsics.ushr(word, 1, Types.u32) as Handle) ? Types.f64 : Types.i64
}

function callCode(fn: u32): u64 {
    if (Intrinsics.and(fn, 1, Types.u32) === 0) Intrinsics.trap(3)
    const target = heap.deref(Intrinsics.ushr(fn, 1, Types.u32) as Handle)
    const desc = heap.getOwnProperty(target, callKey)
    if (desc === 0) Intrinsics.trap(3)
    const slot = heap.FullPropertyDescriptor(heap.resolveHeapCell(desc)).slot0
    const word = target < heap.runtimeCells ? heap.slotWord(slot as Handle) : slot
    return Intrinsics.convert(heap.wordInt(word), Types.i64, Types.u64)
}

function setCall(fn: u32, code: u64): u32 {
    heap.dynamicStore(fn, heap.handleWord(callKey), heap.intWord(Intrinsics.convert(code, Types.u64, Types.i64)))
    return fn
}

function newFunction(code: u64): u32 {
    return setCall(heap.handleWord(heap.makeFunctionObject()), code)
}

function hostArray(word: u32): u32 {
    if (Intrinsics.and(word, 1, Types.u32) === 0) return 0
    const handle = Intrinsics.ushr(word, 1, Types.u32) as Handle
    if (handle <= heap.trueHandle || handle >= heap.runtimeCells) return 0
    return heap.prototypeOf(heap.deref(handle)) === heap.arrayPrototype ? 1 : 0
}

function installCalls(table: u64, count: u32): u32 {
    let i: u32 = 0
    while (i < count) {
        setCall(Intrinsics.load(table, i * 16, Types.u32), Intrinsics.load(table, i * 16 + 8, Types.u64))
        i = i + 1
    }
    return 0
}

type Signature = [params: number[], result: number]

const natives = new Map<Function, Signature>([
    [heap.intWord, [[Types.i64], Types.vm_value]],
    [fromBits, [[Types.u64], Types.vm_value]],
    [heap.wordInt, [[Types.vm_value], Types.i64]],
    [toBits, [[Types.vm_value], Types.u64]],
    [numberBits, [[Types.vm_value], Types.u64]],
    [powerBits, [[Types.u64, Types.u64], Types.u64]],
    [machineType, [[Types.vm_value], Types.u32]],
    [heap.typeofWord, [[Types.vm_value], Types.vm_value]],
    [heap.truthyWord, [[Types.vm_value], Types.u32]],
    [heap.strictWordsEqual, [[Types.vm_value, Types.vm_value], Types.u32]],
    [heap.dynamicLookup, [[Types.vm_value, Types.vm_value, Types.vm_value], Types.vm_value]],
    [heap.dynamicStore, [[Types.vm_value, Types.vm_value, Types.vm_value], Types.vm_value]],
    [heap.dynamicAccessor, [[Types.vm_value, Types.vm_value, Types.vm_value, Types.u32], Types.vm_value]],
    [heap.dynamicTrapKey, [[Types.vm_value, Types.vm_value, Types.vm_value], Types.vm_value]],
    [heap.defineAccessor, [[Types.vm_value, Types.vm_value, Types.vm_value, Types.vm_value], Types.vm_value]],
    [heap.createObject, [[Types.u32], Types.handle]],
    [heap.setPrototypeImpl, [[Types.u32, Types.u32], Types.handle]],
    [heap.getPrototypeImpl, [[Types.u32], Types.handle]],
    [heap.assignImpl, [[Types.u32, Types.u32], Types.handle]],
    [heap.hasPrototypeWord, [[Types.vm_value, Types.u32], Types.u32]],
    [heap.enumerableKeyCount, [[Types.u32], Types.u32]],
    [heap.enumerableKey, [[Types.u32, Types.u32], Types.u32]],
    [callCode, [[Types.vm_value], Types.u64]],
    [newFunction, [[Types.u64], Types.vm_value]],
    [hostArray, [[Types.vm_value], Types.u32]],
    [installCalls, [[Types.u64, Types.u32], Types.u32]],
])

let nativeEntries: Map<Function, number> | undefined

export function prepareRuntime(): void {
    if (nativeEntries) return
    const named: Record<string, Function> = {}
    const order = [...natives.keys()]
    for (let i = 0; i < order.length; i++) named[`n${i}`] = order[i]
    const compiled: Record<string, any> = native.createStandardNatives(named)
    nativeEntries = new Map()
    for (let i = 0; i < order.length; i++) {
        nativeEntries.set(order[i], Number(compiled[`n${i}`].ptr))
        native.sealCode(compiled[`n${i}`].codePage)
    }
    native.mirrorValue(callKey)
}

const { dynamicLookup, dynamicStore, dynamicAccessor, dynamicTrapKey, enumerableKeyCount, enumerableKey, pendingWord, undefinedWord } = heap
const { handleof, stringOf } = rt.rt

function get(object: any, key: any): any {
    const word = dynamicLookup(object, key, numberPrototype)
    if (word === pendingWord) return invoke(dynamicAccessor(object, key, numberPrototype, 0), object, dynamicTrapKey(object, key, numberPrototype), pendingSymbol)
    if (hostArray(word)) return promote(word)
    return word
}

function set(object: any, key: any, value: any): any {
    const word = dynamicStore(object, key, value)
    if (word === pendingWord) invoke(dynamicAccessor(object, key, numberPrototype, 1), object, dynamicTrapKey(object, key, numberPrototype), value)
    return value
}

function promote(source: any): any {
    const known = dynamicLookup(source, promotedKey, undefined)
    if (known !== undefinedWord) return known
    const out: any[] = []
    const length = get(source, 'length')
    let i = 0
    while (i < length) {
        out[i] = get(source, i)
        i = i + 1
    }
    dynamicStore(source, promotedKey, out)
    return out
}

function keys(object: any, mode: number): any {
    const handle = handleof(object)
    const count = enumerableKeyCount(handle)
    const out: any[] = []
    let i = 0
    while (i < count) {
        const key = stringOf(enumerableKey(handle, i))
        if (mode === 0) out[i] = key
        else if (mode === 1) out[i] = get(object, key)
        else out[i] = [key, get(object, key)]
        i = i + 1
    }
    return out
}

function argAt(overflow: any, index: number, argc: number): any {
    if (index < argc) return get(overflow, index)
    return undefined
}

function restTail(rest: any[], overflow: any, argc: number, from: number): void {
    let i = from > argRegs ? from : argRegs
    while (i < argc) {
        rest[i - from] = get(overflow, i)
        i = i + 1
    }
    rest.length = argc > from ? argc - from : 0
}

function invoke(fn: any, receiver: any, trap: any, value: any): any {
    return undefined
}

const glueSources = [get, set, promote, keys, argAt, restTail]

interface Dyn {
    linker: native.Linker
    image: native.ProgramImage
    program: native.ProgramGraph
    thunks: Map<Function, number>
    call: number
    apply: number
    opt: optimizer.Optimizer | undefined
}

const signedTypes = new Set<number>([Types.i8, Types.i16, Types.i32])
const unsignedTypes = new Set<number>([Types.u8, Types.u16, Types.u32, Types.u64])
const narrowTypes = new Set<number>([Types.u8, Types.u16, Types.u32, Types.i8, Types.i16, Types.i32, Types.bool])
const numberTypes = new Set<number>([Types.unknown_number, Types.f64, Types.i64, Types.u64, Types.i32, Types.u32, Types.i16, Types.u16, Types.i8, Types.u8])
const bitwiseOps = new Set<NodeOp>([NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr])
const arithOps = new Set<NodeOp>([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow])
const compareOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge])
const machineOps = new Set<NodeOp>([NodeOp.crc32, NodeOp.pstack, NodeOp.stackalloc, NodeOp.stackfree, NodeOp.mem, NodeOp.clz, NodeOp.alloca])
const controlOps = new Set<NodeOp>([NodeOp.apply, NodeOp.ret, NodeOp.panic, NodeOp.unreachable, NodeOp.trap])
const numberResults = new Set<number>([rt.Op.toNumber, rt.Op.compare, rt.Op.handleHash])
const boolResults = new Set<number>([rt.Op.instanceof])

function constantWord(value: number): number {
    const word = heap.floatWord(value) >>> 0
    if (word & 1) native.mirrorValue(word >>> 1)
    return word
}

function sliceWidth(T: number): number {
    if (T === Types.vm_value) return 4
    if (T === Types.u8 || T === Types.i8 || T === Types.bool) return 1
    if (T === Types.u16 || T === Types.i16) return 2
    if (T === Types.u32 || T === Types.i32) return 4
    return 8
}

function symbolOf(d: Dyn, fn: Function): number {
    if (natives.has(fn)) return thunkSymbol(d, fn)
    return d.linker.addUnit(fn)
}

function thunkSymbol(d: Dyn, fn: Function): number {
    const known = d.thunks.get(fn)
    if (known !== undefined) return known
    const symbol = glueSymbol(d, `dyn/${fn.name}`)
    d.thunks.set(fn, symbol)
    return unitGraph(d, symbol, `dyn/${fn.name}`, natives.get(fn)![0].length, Types.u64, (g, token, params) => addNode(g, NodeOp.call, [token, { literal: nativeEntries!.get(fn)! }, { literal: 0 }, ...params]))
}

function glueSymbol(d: Dyn, name: string): number {
    return d.linker.intern(Object.defineProperty(function glue() {}, 'name', { value: name }))
}

function cellWord(d: Dyn, cell: number): number {
    if (heap.isOddballHandle(cell as Handle)) return heap.handleWord(cell as Handle)
    if (heap.isBoxedF64(cell as Handle)) {
        if (heap.boxedNanId(cell as Handle)) throw `dyn: a symbolic value @${cell} reached a constant position`
        return constantWord(heap.unboxF64(cell as Handle))
    }
    native.mirrorValue(cell)
    return heap.handleWord(cell as Handle)
}

function unitGraph(d: Dyn, symbol: number, name: string, count: number, T: number, body: (g: Graph, token: number, params: number[]) => number): number {
    const g = createGraph({ name })
    const root = addNode(g, NodeOp.block, [])
    g.root = root
    const token = addNode(g, NodeOp.nilEffect, [root])
    const params: number[] = []
    for (let i = 0; i < count; i++) params.push(addNode(g, NodeOp.param, [], T))
    setGraphBlocks(g, [{ id: root, params, bodyId: addNode(g, NodeOp.ret, [body(g, token, params), root]), bodyConst: 0 }])
    d.program.units.set(symbol, g)
    return symbol
}

function abiGraph(d: Dyn, symbol: number, name: string, body: (g: Graph, token: number, params: number[]) => number): number {
    return unitGraph(d, symbol, name, argRegs + 4, Types.u32, body)
}

function abiCall(g: Graph, token: Operand, target: Operand, callee: Operand, receiver: Operand, argc: Operand, args: Operand[], overflow: Operand): number {
    const regs: Operand[] = []
    for (let i = 0; i < argRegs; i++) regs.push(i < args.length ? args[i] : { literal: heap.undefinedWord })
    return addNode(g, NodeOp.call, [token, target, { literal: 0 }, callee, receiver, argc, ...regs, overflow])
}

function nativeTarget(d: Dyn, g: Graph, fn: Function): number {
    return addNode(g, NodeOp.localTarget, [{ literal: thunkSymbol(d, fn) }], Types.u32)
}

function localTarget(d: Dyn, g: Graph, fn: Function): number {
    return addNode(g, NodeOp.localTarget, [{ literal: symbolOf(d, fn) }], Types.u32)
}

function callGlue(d: Dyn): number {
    return abiGraph(d, glueSymbol(d, 'dyn/call'), 'dyn/call', (g, token, [callee, receiver, argc, a0, a1, a2, a3, overflow]) => {
        const code = addNode(g, NodeOp.call, [token, nativeTarget(d, g, callCode), { literal: 0 }, callee])
        return addNode(g, NodeOp.call, [code, code, { literal: 0 }, callee, receiver, argc, a0, a1, a2, a3, overflow])
    })
}

function invokeGlue(d: Dyn): number {
    return abiGraph(d, d.linker.addUnit(invoke), 'dyn/invoke', (g, token, [, , , fn, receiver, trap, value]) => {
        const plain = addNode(g, NodeOp.eq, [trap, { literal: heap.pendingWord }], Types.bool)
        const getter = addNode(g, NodeOp.eq, [value, { literal: heap.pendingWord }], Types.bool)
        const base = addNode(g, NodeOp.select, [getter, { literal: 0 }, { literal: 1 }])
        const argc = addNode(g, NodeOp.add, [base, addNode(g, NodeOp.select, [plain, { literal: 0 }, { literal: 1 }])], Types.u32)
        const first = addNode(g, NodeOp.select, [plain, value, trap])
        const code = addNode(g, NodeOp.call, [token, nativeTarget(d, g, callCode), { literal: 0 }, fn])
        return abiCall(g, code, code, fn, receiver, argc, [first, value], { literal: heap.undefinedWord })
    })
}

function applyGlue(d: Dyn): number {
    return abiGraph(d, glueSymbol(d, 'dyn/apply'), 'dyn/apply', (g, token, [, , , fn, receiver, array]) => {
        const getter = () => localTarget(d, g, get)
        let last = abiCall(g, token, getter(), { literal: heap.undefinedWord }, { literal: heap.undefinedWord }, { literal: 2 }, [array, { literal: heap.handleWord(heap.arrayLengthKey) }], { literal: heap.undefinedWord })
        const length = addNode(g, NodeOp.call, [last, nativeTarget(d, g, heap.wordInt), { literal: 0 }, last])
        const args: Operand[] = []
        for (let i = 0; i < argRegs; i++) {
            last = abiCall(g, i ? last : length, getter(), { literal: heap.undefinedWord }, { literal: heap.undefinedWord }, { literal: 2 }, [array, { literal: i << 1 }], { literal: heap.undefinedWord })
            args.push(last)
        }
        const code = addNode(g, NodeOp.call, [last, nativeTarget(d, g, callCode), { literal: 0 }, fn])
        return abiCall(g, code, code, fn, receiver, length, args, array)
    })
}

function lowerTraced(d: Dyn, fn: Function, traced: FastTraced, routes?: Map<number, optimizer.Route>, contract?: Contract): Graph {
    const src = traced.graph
    const g = withNodes(src, new Map(src.nodes))
    const { linker } = d
    const machine = new Map<number, number>()
    const raw = new Set<number>()
    const control = new Map<number, boolean>()
    const boxes = new Map<number, Operand>()
    const unboxes = new Map<string, Operand>()
    const materialized = new Map<number, number>()
    const cellNodes = new Map<number, number>()
    const lastFresh = new Map<number, number>()
    const entry = src.blocks[0]
    const entryToken = addNode(g, NodeOp.nilEffect, [g.root])
    const loose = addNode(g, NodeOp.nilEffect, [])
    const undefinedWord: Operand = { literal: heap.undefinedWord }
    const where = fn.name || 'anonymous'
    function fail(why: string): never {
        throw `dyn: ${where} ${why}`
    }
    function freshToken(token: Operand): Operand {
        if (typeof token !== 'number') return token
        return lastFresh.get(token) ?? token
    }
    function fresh(token: Operand, id: number): number {
        if (typeof token === 'number') lastFresh.set(token, id)
        return id
    }
    function nativeCall(token: Operand, f: Function, args: Operand[]): number {
        return addNode(g, NodeOp.call, [token, nativeTarget(d, g, f), { literal: 0 }, ...args])
    }
    function putNative(id: number, token: Operand, f: Function, args: Operand[]): void {
        const result = natives.get(f)![1]
        if (result === Types.handle) {
            const handle = nativeCall(token, f, args)
            putNode(g, id, NodeOp.or, [addNode(g, NodeOp.shl, [handle, { literal: 1 }], Types.u32), { literal: 1 }], Types.u32)
            return
        }
        putNode(g, id, NodeOp.call, [token, nativeTarget(d, g, f), { literal: 0 }, ...args])
        if (result === Types.vm_value) raw.add(id)
        machine.set(id, result === Types.vm_value ? Types.u32 : result)
    }
    function nativeArgs(f: Function, n: GraphNode, first: number): Operand[] {
        return natives.get(f)![0].map((kind, i) => kind === Types.vm_value ? wordOf(n, first + i) : machineOf(n, first + i, kind))
    }
    function isControl(id: number): boolean {
        const known = control.get(id)
        if (known !== undefined) return known
        const n = getNode(src, id)
        let result = false
        if (n && controlOps.has(n.op)) result = true
        else if (n?.op === NodeOp.after && getRef(n, countIds(n) - 1)) result = isControl(getRef(n, countIds(n) - 1))
        else if (n?.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) {
                if (getRef(n, i) && isControl(getRef(n, i))) result = true
            }
        }
        control.set(id, result)
        return result
    }
    function boxed(ref: number, T: number): Operand {
        if (raw.has(ref)) return ref
        const known = boxes.get(ref)
        if (known !== undefined) return known
        let out: Operand
        if (T === Types.bool) out = addNode(g, NodeOp.select, [ref, { literal: heap.trueWord }, { literal: heap.falseWord }])
        else if (T === Types.f64) out = nativeCall(loose, fromBits, [addNode(g, NodeOp.bitconvert, [ref], Types.u64)])
        else if (signedTypes.has(T)) out = nativeCall(loose, heap.intWord, [addNode(g, NodeOp.convert, [ref], Types.i64)])
        else if (narrowTypes.has(T)) out = nativeCall(loose, heap.intWord, [addNode(g, NodeOp.convert, [ref], Types.u64)])
        else out = nativeCall(loose, heap.intWord, [ref])
        boxes.set(ref, out)
        return out
    }
    function unboxed(ref: number, T: number): Operand {
        const key = `${ref}:${T}`
        const known = unboxes.get(key)
        if (known !== undefined) return known
        let out: Operand
        if (T === Types.f64) out = addNode(g, NodeOp.bitconvert, [nativeCall(loose, toBits, [ref])], Types.f64)
        else if (T === Types.bool) out = truthy(loose, ref)
        else if (narrowTypes.has(T)) out = addNode(g, NodeOp.convert, [addNode(g, NodeOp.bitconvert, [nativeCall(loose, heap.wordInt, [ref])], Types.i64)], T)
        else out = addNode(g, NodeOp.bitconvert, [nativeCall(loose, heap.wordInt, [ref])], Types.i64)
        unboxes.set(key, out)
        return out
    }
    function truthy(token: Operand, word: Operand): number {
        return addNode(g, NodeOp.ne, [nativeCall(token, heap.truthyWord, [word]), { literal: 0 }], Types.bool)
    }
    function perInvocation(cell: number): boolean {
        return traced.allocations.has(cell as u32) || traced.frames.has(cell as u32) || traced.closures.has(cell)
    }
    function wordOf(n: GraphNode, i: number): Operand {
        const ref = getRef(n, i)
        if (!ref) return { literal: constantWord(getLiteral(src, n, i)) }
        return wordRef(ref)
    }
    function wordRef(ref: number): Operand {
        if (isControl(ref)) return ref
        const T = machine.get(ref)
        if (T !== undefined) return boxed(ref, T)
        return ref
    }
    function machineOf(n: GraphNode, i: number, T: number): Operand {
        const ref = getRef(n, i)
        if (!ref) return { literal: getLiteral(src, n, i) }
        const M = machine.get(ref)
        if (M !== undefined) return M !== T && (M === Types.f64 || T === Types.f64) && !raw.has(ref) ? addNode(g, NodeOp.convert, [ref], T) : ref
        return unboxed(ref, T)
    }
    function keyOf(n: GraphNode, i: number): Operand {
        if (getRef(n, i)) return wordOf(n, i)
        const index = heap.keyIndex(getLiteral(src, n, i) as Handle)
        return { literal: index !== undefined && index < 0x40000000 ? index << 1 : cellWord(d, getLiteral(src, n, i)) }
    }
    function truthOf(n: GraphNode, i: number): Operand {
        const ref = getRef(n, i)
        if (!ref) return { literal: getLiteral(src, n, i) ? 1 : 0 }
        const T = machine.get(ref)
        if (T === Types.bool) return ref
        if (T !== undefined) return addNode(g, NodeOp.ne, [ref, { literal: 0 }], Types.bool)
        const m = getNode(src, ref)
        if (m && m.op === NodeOp.literal && typeOf(m) === Types.bool) return { literal: getLiteral(src, m, 0) ? 1 : 0 }
        return truthy(loose, ref)
    }
    function numeric(n: GraphNode, i: number): boolean {
        const ref = getRef(n, i)
        if (!ref) return true
        if (machine.has(ref)) return !raw.has(ref)
        const m = getNode(src, ref)
        if (!m) return false
        if (m.op === NodeOp.literal) return typeOf(m) !== Types.bool
        if (m.op === NodeOp.rt) return numberResults.has(getLiteral(src, m, 1))
        return arithOps.has(m.op) || bitwiseOps.has(m.op) || m.op === NodeOp.neg || m.op === NodeOp.not
    }
    function closureCode(cell: number): number {
        const unit = linker.closureFunction(cell as u32, 'closure')
        return addNode(g, NodeOp.poolEntry, [{ literal: d.image.functionSlot(linker.addUnit(unit), unit.name) }])
    }
    function slotValue(slot: number): Operand {
        if (heap.isBoxedF64(slot as Handle) && heap.boxedNanId(slot as Handle)) {
            lowerFrom(heap.boxedNanId(slot as Handle))
            return wordRef(heap.boxedNanId(slot as Handle))
        }
        if (perInvocation(slot)) return materialize(slot)
        return { literal: cellWord(d, slot) }
    }
    function materialize(cell: number): number {
        const known = materialized.get(cell)
        if (known !== undefined) return known
        const id = cellNodes.get(cell) ?? addNode(g, NodeOp.void, [])
        materialized.set(cell, id)
        if (traced.frames.has(cell as u32)) {
            putNative(id, freshToken(entryToken), heap.createObject, [{ literal: 0 }])
            fresh(entryToken, id)
            return id
        }
        const state = heap.deref(cell as Handle)
        if (traced.allocations.has(cell as u32)) {
            const proto = heap.getPrototypeOf(state)
            const protoHandle: Operand = !proto ? { literal: 0 } : perInvocation(proto) ? addNode(g, NodeOp.ushr, [materialize(proto), { literal: 1 }], Types.u32) : { literal: cellWord(d, proto) >>> 1 }
            const token = traced.allocations.get(cell as u32)!.token ?? entryToken
            putNative(id, freshToken(token), heap.createObject, [protoHandle])
            fresh(token, id)
            return id
        }
        const created = fresh(entryToken, nativeCall(freshToken(entryToken), newFunction, [closureCode(cell)]))
        let token = created
        for (let i: u32 = 0; i < heap.ownPropertyCount(state); i++) {
            const key = heap.ownPropertyKeyAt(state, i)
            if (key === heap.closureCallKey || heap.isString(key) && key !== heap.prototypeKey) continue
            const slot = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.ownPropertyAt(state, i))).slot0 as number
            if (key === heap.prototypeKey && !perInvocation(slot)) continue
            token = nativeCall(token, heap.dynamicStore, [created, { literal: cellWord(d, key) }, slotValue(slot)])
        }
        putNode(g, id, NodeOp.after, [token, created])
        return id
    }
    function unitCall(token: Operand, unit: Function, callee: Operand, receiver: Operand, args: Operand[]): number {
        const id = addNode(g, NodeOp.void, [])
        putUnitCall(id, token, unit, callee, receiver, args)
        return id
    }
    function overflowOf(token: Operand, args: Operand[]): [Operand, Operand] {
        if (args.length <= argRegs) return [token, undefinedWord]
        const array = unitCall(token, rt.bindingOf(rt.Op.arrayLiteral)!.impl!, undefinedWord, undefinedWord, [{ literal: args.length << 1 }])
        let last: number = array
        for (let i = 0; i < args.length; i++) last = unitCall(last, rt.bindingOf(rt.Op.arrayElement)!.impl!, undefinedWord, undefinedWord, [array, { literal: i << 1 }, args[i]])
        return [last, array]
    }
    function putUnitCall(id: number, token: Operand, unit: Function, callee: Operand, receiver: Operand, args: Operand[]): void {
        if (natives.has(unit)) fail(`calls the word helper ${unit.name} with words`)
        putTargetCall(id, token, localTarget(d, g, unit), callee, receiver, args)
    }
    function putTargetCall(id: number, token: Operand, target: Operand, callee: Operand, receiver: Operand, args: Operand[]): void {
        const [after, overflow] = overflowOf(token, args)
        const regs: Operand[] = []
        for (let i = 0; i < argRegs; i++) regs.push(i < args.length ? args[i] : undefinedWord)
        putNode(g, id, NodeOp.call, [after, target, { literal: 0 }, callee, receiver, { literal: args.length }, ...regs, overflow])
    }
    function machineCall(id: number, n: GraphNode, target: Operand): void {
        const args: Operand[] = []
        for (let i = 3; i < countIds(n); i++) args.push(machineOf(n, i, Types.u64))
        putNode(g, id, NodeOp.call, [getOperand(src, n, 0), target, { literal: 0 }, ...args])
        machine.set(id, Types.u64)
    }
    function versionCall(id: number, n: GraphNode, route: optimizer.Route): void {
        const opt = d.opt!
        const c = route.version.contract
        const target = getNode(src, getRef(n, 1))!
        const needsCallee = !optimizer.enabled(opt, 'callee') || usesCallee(opt, c.unit)
        let callee: Operand = undefinedWord
        if (needsCallee && target.op === NodeOp.heapHandle) {
            const cell = getLiteral(src, target, 0)
            callee = traced.closures.has(cell) ? materialize(cell) : { literal: cellWord(d, cell) }
        } else if (needsCallee && route.cell) callee = { literal: cellWord(d, route.cell) }
        const receiver: Operand = getRef(n, 2) ? wordOf(n, 2) : { literal: getLiteral(src, n, 2) ? constantWord(getLiteral(src, n, 2)) : heap.undefinedWord }
        const args: Operand[] = []
        for (let k = 1; k < c.params.length; k++) {
            const slot = k + 2
            if (slot >= countIds(n)) args.push(undefinedWord)
            else if (c.params[k].kind === Kinds.int) args.push(machineOf(n, slot, Types.i64))
            else args.push(wordOf(n, slot))
        }
        const local = addNode(g, NodeOp.localTarget, [{ literal: useVersion(opt, route.version) }], Types.u32)
        const operands: Operand[] = [getOperand(src, n, 0), local, { literal: 0 }, callee, receiver, ...args]
        if (!c.returnsInt) {
            putNode(g, id, NodeOp.call, operands)
            return
        }
        const call = addNode(g, NodeOp.call, operands)
        putNode(g, id, NodeOp.after, [call, addNode(g, NodeOp.bitconvert, [call], Types.i64)])
        machine.set(id, Types.i64)
    }
    function lowerCall(id: number, n: GraphNode): void {
        const route = routes?.get(id)
        if (route) return versionCall(id, n, route)
        const token = getOperand(src, n, 0)
        const targetRef = getRef(n, 1)
        if (!targetRef) return machineCall(id, n, { literal: getLiteral(src, n, 1) })
        const target = getNode(src, targetRef)!
        if (target.op === NodeOp.syscallTarget) return machineCall(id, n, targetRef)
        let unit: Function | undefined
        let callee: Operand = undefinedWord
        if (target.op === NodeOp.localTarget) unit = linker.functions[getLiteral(src, target, 0)]
        if (target.op === NodeOp.heapHandle) {
            const cell = getLiteral(src, target, 0)
            if (traced.closures.has(cell)) {
                unit = linker.closureFunction(cell as u32, 'closure')
                callee = materialize(cell)
            } else if (!perInvocation(cell)) {
                const linked: any = linker.session.stubFunctions.get(cell as u32)
                if (linked && Number.isSafeInteger(linked.__native)) return machineCall(id, n, { literal: linked.__native })
                unit = linker.functionAt(cell)
                if (unit && !natives.has(unit) && !linker.codeOf(unit)) unit = undefined
                if (unit) callee = { literal: cellWord(d, cell) }
            }
        }
        if (unit && natives.has(unit)) return putNative(id, token, unit, nativeArgs(unit, n, 3))
        const args: Operand[] = []
        for (let i = 3; i < countIds(n); i++) args.push(wordOf(n, i))
        const receiver: Operand = getRef(n, 2) ? wordOf(n, 2) : { literal: getLiteral(src, n, 2) ? constantWord(getLiteral(src, n, 2)) : heap.undefinedWord }
        if (n.flags & NodeFlags.spread) {
            const glue = addNode(g, NodeOp.localTarget, [{ literal: d.apply }], Types.u32)
            return putTargetCall(id, token, glue, undefinedWord, undefinedWord, [unit ? callee : wordOf(n, 1), receiver, args[0]])
        }
        if (unit) return putUnitCall(id, token, unit, callee, receiver, args)
        putTargetCall(id, token, addNode(g, NodeOp.localTarget, [{ literal: d.call }], Types.u32), wordOf(n, 1), receiver, args)
    }
    function lowerRuntime(id: number, n: GraphNode): void {
        const op = getLiteral(src, n, 1)
        const token = getOperand(src, n, 0)
        if (op === rt.Op.handleof) {
            putNode(g, id, NodeOp.ushr, [wordOf(n, 2), { literal: 1 }], Types.u32)
            machine.set(id, Types.u32)
            return
        }
        if (op === rt.Op.stringOf) {
            putNode(g, id, NodeOp.or, [addNode(g, NodeOp.shl, [machineOf(n, 2, Types.u32), { literal: 1 }], Types.u32), { literal: 1 }], Types.u32)
            return
        }
        if (op === rt.Op.heapaddr || op === rt.Op.pstackaddr) {
            putNode(g, id, NodeOp.rt, [token, { literal: op }, machineOf(n, 2, Types.u32)])
            machine.set(id, Types.u64)
            return
        }
        if (op === rt.Op.typeof) return putNative(id, token, heap.typeofWord, [wordOf(n, 2)])
        if (op === rt.Op.strictEqual) {
            putNode(g, id, NodeOp.ne, [nativeCall(token, heap.strictWordsEqual, [wordOf(n, 2), wordOf(n, 3)]), { literal: 0 }], Types.bool)
            machine.set(id, Types.bool)
            return
        }
        if (op === rt.Op.truthy) {
            putNode(g, id, NodeOp.ne, [nativeCall(token, heap.truthyWord, [wordOf(n, 2)]), { literal: 0 }], Types.bool)
            machine.set(id, Types.bool)
            return
        }
        if (op === rt.Op.getprop) return putUnitCall(id, token, get, undefinedWord, undefinedWord, [wordOf(n, 2), keyOf(n, 3)])
        if (op === rt.Op.setprop) return putUnitCall(id, token, set, undefinedWord, undefinedWord, [wordOf(n, 2), keyOf(n, 3), wordOf(n, 4)])
        if (op === rt.Op.ownKeys) return putUnitCall(id, token, keys, undefinedWord, undefinedWord, [wordOf(n, 2), wordOf(n, 3)])
        if (op === rt.Op.slice) {
            const T = getLiteral(src, n, 3)
            const size = addNode(g, NodeOp.mul, [machineOf(n, 2, Types.i64), { literal: sliceWidth(T) }], Types.i64)
            putNode(g, id, NodeOp.pstack, [freshToken(token), { literal: programStack }, { literal: 0 }, size])
            fresh(token, id)
            machine.set(id, Types.u64)
            return
        }
        if (op === rt.Op.sliceRead || op === rt.Op.sliceWrite) {
            const T = getLiteral(src, n, op === rt.Op.sliceRead ? 4 : 5)
            const at = addNode(g, NodeOp.mul, [machineOf(n, 3, Types.i64), { literal: sliceWidth(T) }], Types.i64)
            const stored = T === Types.vm_value ? Types.u32 : T
            if (op === rt.Op.sliceRead) {
                putNode(g, id, NodeOp.load, [token, machineOf(n, 2, Types.u64), at], stored)
                if (T !== Types.vm_value) machine.set(id, T)
                return
            }
            const value = T === Types.vm_value ? wordOf(n, 4) : machineOf(n, 4, T)
            putNode(g, id, NodeOp.store, [token, machineOf(n, 2, Types.u64), at, value], stored)
            return
        }
        if (op === rt.Op.addOrConcat && numeric(n, 2) && numeric(n, 3)) return putFloat(id, addNode(g, NodeOp.add, [machineOf(n, 2, Types.f64), machineOf(n, 3, Types.f64)], Types.f64))
        if (op === rt.Op.assign && countIds(n) > 4) fail(`copies an object without some keys at %${id}`)
        const impl = rt.bindingOf(op)?.impl
        if (!impl) fail(`uses rt ${rt.opName(op)} at %${id}`)
        if (natives.has(impl!)) {
            const callToken = op === rt.Op.create ? freshToken(token) : token
            putNative(id, callToken, impl!, nativeArgs(impl!, n, 2))
            if (op === rt.Op.create) fresh(token, id)
            return
        }
        const words: Operand[] = []
        for (let i = 2; i < countIds(n); i++) words.push(wordOf(n, i))
        if (!rt.handleResults.has(op) && !boolResults.has(op)) return putUnitCall(id, token, impl!, undefinedWord, undefinedWord, words)
        const result = unitCall(token, impl!, undefinedWord, undefinedWord, words)
        if (boolResults.has(op)) {
            putNode(g, id, NodeOp.eq, [result, { literal: heap.trueWord }], Types.bool)
            machine.set(id, Types.bool)
            return
        }
        putNode(g, id, NodeOp.or, [result, { literal: 1 }], Types.u32)
    }
    function lowerConvert(id: number, n: GraphNode, bits: boolean): void {
        const to = typeOf(n)
        const from = traced.conversions.get(id) ?? (to === Types.f64 ? Types.f64 : Types.i64)
        const ref = getRef(n, 0)
        const op = bits ? NodeOp.bitconvert : NodeOp.convert
        if (!ref) {
            putNode(g, id, op, [{ literal: getLiteral(src, n, 0) }], to === Types.vm_value ? Types.u32 : to)
            if (to !== Types.vm_value) machine.set(id, to)
            return
        }
        const value = machine.has(ref) || from === Types.vm_value ? ref : machineOf(n, 0, from)
        if (to === Types.vm_value) {
            putNode(g, id, NodeOp.convert, [value], Types.u32)
            return
        }
        putNode(g, id, from === Types.vm_value ? NodeOp.convert : op, [value], to)
        machine.set(id, to)
    }
    function nullishOperand(n: GraphNode, i: number): boolean {
        const ref = getRef(n, i)
        const m = ref ? getNode(src, ref) : undefined
        return !!m && m.op === NodeOp.heapHandle && heap.isNullishHandle(getLiteral(src, m, 0) as Handle)
    }
    function rawOperand(n: GraphNode, i: number): Operand {
        const ref = getRef(n, i)
        if (!ref) return { literal: getLiteral(src, n, i) }
        if (raw.has(ref)) return ref
        const m = getNode(src, ref)
        if (m?.op === NodeOp.literal) return { literal: getLiteral(src, m, 0) }
        return wordRef(ref)
    }
    function lowerCompare(id: number, n: GraphNode): void {
        const a = getRef(n, 0)
        const b = getRef(n, 1)
        machine.set(id, Types.bool)
        if (raw.has(a) || raw.has(b)) {
            putNode(g, id, n.op, [rawOperand(n, 0), rawOperand(n, 1)], Types.bool)
            return
        }
        const T = (a ? machine.get(a) : undefined) ?? (b ? machine.get(b) : undefined)
        if (T !== undefined) {
            putNode(g, id, n.op, [machineOf(n, 0, T), machineOf(n, 1, T)], Types.bool)
            return
        }
        const eq = n.op === NodeOp.eq || n.op === NodeOp.ne
        if (eq && (nullishOperand(n, 0) || nullishOperand(n, 1))) {
            const other = wordOf(n, nullishOperand(n, 0) ? 1 : 0)
            const missing = addNode(g, NodeOp.eq, [other, undefinedWord], Types.bool)
            const empty = addNode(g, NodeOp.eq, [other, { literal: heap.handleWord(heap.nullHandle) }], Types.bool)
            putNode(g, id, n.op, [addNode(g, NodeOp.or, [missing, empty], Types.bool), { literal: 1 }], Types.bool)
            return
        }
        if (numeric(n, 0) && numeric(n, 1)) {
            putNode(g, id, n.op, [machineOf(n, 0, Types.f64), machineOf(n, 1, Types.f64)], Types.bool)
            return
        }
        if (eq) {
            putNode(g, id, n.op, [nativeCall(loose, heap.strictWordsEqual, [wordOf(n, 0), wordOf(n, 1)]), { literal: 1 }], Types.bool)
            return
        }
        const order = unitCall(loose, rt.bindingOf(rt.Op.compare)!.impl!, undefinedWord, undefinedWord, [wordOf(n, 0), wordOf(n, 1)])
        const less = addNode(g, NodeOp.eq, [order, { literal: -1 << 1 >>> 0 }], Types.bool)
        const more = addNode(g, NodeOp.eq, [order, { literal: 2 }], Types.bool)
        const same = addNode(g, NodeOp.eq, [order, { literal: 0 }], Types.bool)
        if (n.op === NodeOp.lt) putNode(g, id, NodeOp.ne, [less, { literal: 0 }], Types.bool)
        else if (n.op === NodeOp.gt) putNode(g, id, NodeOp.ne, [more, { literal: 0 }], Types.bool)
        else putNode(g, id, NodeOp.or, [n.op === NodeOp.le ? less : more, same], Types.bool)
    }
    function lowerNumber(id: number, n: GraphNode): void {
        if (n.op === NodeOp.neg || n.op === NodeOp.not) return lowerUnary(id, n)
        const T = typeOf(n)
        if (T !== Types.unknown_number) {
            const operands: Operand[] = []
            for (let i = 0; i < countIds(n); i++) operands.push(machineOf(n, i, T))
            putNode(g, id, n.op, operands, T)
            machine.set(id, T)
            return
        }
        const M = bitwiseOps.has(n.op) || n.op === NodeOp.not ? Types.i64 : Types.f64
        const operands: Operand[] = []
        for (let i = 0; i < countIds(n); i++) operands.push(numberOf(n, i, M))
        let value: number
        if (n.op === NodeOp.rem && M === Types.f64) value = floatRem(operands[0], operands[1])
        else if (n.op === NodeOp.pow) value = addNode(g, NodeOp.bitconvert, [nativeCall(loose, powerBits, operands.map(floatBits))], Types.f64)
        else value = addNode(g, n.op, operands, M)
        if (M === Types.i64) putNode(g, id, NodeOp.call, [loose, nativeTarget(d, g, heap.intWord), { literal: 0 }, value])
        else putFloat(id, value)
    }
    function numberOf(n: GraphNode, i: number, M: number): Operand {
        const ref = getRef(n, i)
        if (!ref || machine.has(ref) || numeric(n, i)) return machineOf(n, i, M)
        const value = addNode(g, NodeOp.bitconvert, [nativeCall(loose, numberBits, [ref])], Types.f64)
        return M === Types.f64 ? value : addNode(g, NodeOp.convert, [value], M)
    }
    function floatBits(x: Operand): Operand {
        if (typeof x === 'number') return addNode(g, NodeOp.bitconvert, [x], Types.u64)
        const value = x.literal as number
        if (Number.isSafeInteger(value)) return addNode(g, NodeOp.bitconvert, [addNode(g, NodeOp.convert, [x], Types.f64)], Types.u64)
        const bits = new BigUint64Array(new Float64Array([value]).buffer)[0]
        if (BigInt(Number(bits)) !== bits) fail(`needs the bits of ${value}`)
        return { literal: Number(bits) }
    }
    function floatRem(a: Operand, b: Operand): number {
        const whole = addNode(g, NodeOp.convert, [addNode(g, NodeOp.convert, [addNode(g, NodeOp.div, [a, b], Types.f64)], Types.i64)], Types.f64)
        return addNode(g, NodeOp.sub, [a, addNode(g, NodeOp.mul, [whole, b], Types.f64)], Types.f64)
    }
    function putFloat(id: number, value: number): void {
        putNode(g, id, NodeOp.call, [loose, nativeTarget(d, g, fromBits), { literal: 0 }, addNode(g, NodeOp.bitconvert, [value], Types.u64)])
    }
    function lowerUnary(id: number, n: GraphNode): void {
        const ref = getRef(n, 0)
        const m = getNode(src, ref)
        let T = machine.get(ref) ?? (m && typeSlotsOf(m.op) ? typeOf(m) : Types.unknown_number)
        const known = numberTypes.has(T) && T !== Types.unknown_number
        if (!known) T = n.op === NodeOp.not ? Types.i64 : Types.f64
        if (unsignedTypes.has(T)) T = Types.i64
        const x = known ? machineOf(n, 0, T) : numberOf(n, 0, T)
        if (n.op === NodeOp.not) putNode(g, id, NodeOp.xor, [x, { literal: -1 }], T)
        else putNode(g, id, NodeOp.sub, [{ literal: 0 }, x], T)
        machine.set(id, T)
    }
    const thisNode = entry.params.find(p => isThisParam(getNode(src, p)!))
    const params: number[] = []
    for (let i = 0; i < (contract ? 2 : argRegs + 4); i++) params.push(i === 1 && thisNode ? thisNode : addNode(g, NodeOp.param, [], Types.u32))
    if (thisNode) putNode(g, thisNode, NodeOp.param, [], Types.u32)
    const callee = params[0]
    const argc = params[2]
    const overflow = params[argRegs + 3]
    const compiled = linker.codeOf(fn)!.source.compiled
    const rest = compiled.rest ? compiled.paramCount - 1 : -1
    let index = 0
    for (const p of entry.params) {
        if (p === thisNode) continue
        if (contract) {
            const typed = contract.params[index + 1].kind === Kinds.int
            putNode(g, p, NodeOp.param, [], typed ? Types.i64 : Types.u32)
            if (typed) machine.set(p, Types.i64)
            params.push(p)
            index++
            continue
        }
        const present = addNode(g, NodeOp.lt, [{ literal: index }, argc], Types.bool)
        if (index === rest) {
            const count = addNode(g, NodeOp.select, [addNode(g, NodeOp.gt, [argc, { literal: index }], Types.bool), addNode(g, NodeOp.sub, [argc, { literal: index }], Types.u32), { literal: 0 }])
            const room = argRegs - index
            const capacity = room > 0 ? addNode(g, NodeOp.select, [addNode(g, NodeOp.gt, [count, { literal: room }], Types.bool), count, { literal: room }]) : count
            const array = unitCall(entryToken, rt.bindingOf(rt.Op.arrayLiteral)!.impl!, undefinedWord, undefinedWord, [addNode(g, NodeOp.shl, [capacity, { literal: 1 }], Types.u32)])
            let last: number = array
            for (let j = index; j < argRegs; j++) {
                const value = addNode(g, NodeOp.select, [addNode(g, NodeOp.lt, [{ literal: j }, argc], Types.bool), params[3 + j], undefinedWord])
                last = unitCall(last, rt.bindingOf(rt.Op.arrayElement)!.impl!, undefinedWord, undefinedWord, [array, { literal: (j - index) << 1 }, value])
            }
            const tail = unitCall(last, restTail, undefinedWord, undefinedWord, [array, overflow, addNode(g, NodeOp.shl, [argc, { literal: 1 }], Types.u32), { literal: index << 1 }])
            putNode(g, p, NodeOp.after, [tail, array])
        } else if (index < argRegs) {
            putNode(g, p, NodeOp.select, [present, params[3 + index], undefinedWord])
        } else {
            putUnitCall(p, loose, argAt, undefinedWord, undefinedWord, [overflow, { literal: index << 1 }, addNode(g, NodeOp.shl, [argc, { literal: 1 }], Types.u32)])
        }
        index++
    }
    const entryParams = new Set(entry.params)
    for (const b of src.blocks) {
        if (b.id === entry.id) continue
        for (const p of b.params) {
            const T = d.opt ? typeOf(getNode(src, p)!) : Types.u32
            const M = T === Types.ptr ? Types.u64 : T === Types.i64 ? T : Types.u32
            putNode(g, p, NodeOp.param, [], M)
            if (M !== Types.u32) machine.set(p, M)
        }
    }
    const ids: number[] = []
    const seen = new Set<number>()
    const done = new Set<number>()
    for (const b of src.blocks) {
        for (const id of blockOrder(src, b)) {
            if (seen.has(id)) continue
            seen.add(id)
            ids.push(id)
            const n = getNode(src, id)
            if (n?.op === NodeOp.heapHandle && perInvocation(getLiteral(src, n, 0))) cellNodes.set(getLiteral(src, n, 0), id)
        }
    }
    function lowerNode(id: number): void {
        const n = getNode(src, id)!
        if (entryParams.has(id) || n.op === NodeOp.param || n.op === NodeOp.block || n.op === NodeOp.nilEffect) return
        if (n.op === NodeOp.panic || n.op === NodeOp.unreachable || n.op === NodeOp.localTarget || n.op === NodeOp.syscallTarget) return
        if (n.op === NodeOp.literal) {
            const value = getLiteral(src, n, 0)
            putNode(g, id, NodeOp.literal, [{ literal: typeOf(n) === Types.bool ? value ? heap.trueWord : heap.falseWord : constantWord(value) }], Types.u32)
            return
        }
        if (n.op === NodeOp.void) {
            putNode(g, id, NodeOp.literal, [undefinedWord], Types.u32)
            return
        }
        if (n.op === NodeOp.heapHandle) {
            const cell = getLiteral(src, n, 0)
            if (perInvocation(cell)) materialize(cell)
            else if (hostArrayCell(cell)) putUnitCall(id, loose, promote, undefinedWord, undefinedWord, [{ literal: cellWord(d, cell) }])
            else putNode(g, id, NodeOp.literal, [{ literal: cellWord(d, cell) }], Types.u32)
            return
        }
        if (n.op === NodeOp.callContext) {
            putNode(g, id, NodeOp.convert, [callee], Types.u32)
            return
        }
        if (n.op === NodeOp.after) {
            const operands: Operand[] = []
            for (let i = 0; i < countIds(n) - 1; i++) operands.push(getOperand(src, n, i))
            const last = getRef(n, countIds(n) - 1)
            const T = last ? machine.get(last) : undefined
            operands.push(T !== undefined ? last : wordOf(n, countIds(n) - 1))
            if (T !== undefined) machine.set(id, T)
            if (T !== undefined && raw.has(last)) raw.add(id)
            putNode(g, id, NodeOp.after, operands)
            return
        }
        if (n.op === NodeOp.ret) {
            putNode(g, id, NodeOp.ret, [contract?.returnsInt ? machineOf(n, 0, Types.i64) : wordOf(n, 0), getOperand(src, n, 1)])
            return
        }
        if (n.op === NodeOp.inlined) return
        if (n.op === NodeOp.apply) {
            const operands: Operand[] = [getRef(n, 0)]
            const targetParams = src.blockIndex.get(getRef(n, 0))?.params ?? []
            for (let i = 1; i < countIds(n); i++) {
                const M = machine.get(targetParams[i - 1])
                operands.push(M !== undefined ? machineOf(n, i, M) : wordOf(n, i))
            }
            putNode(g, id, NodeOp.apply, operands)
            return
        }
        if (n.op === NodeOp.select) {
            const operands: Operand[] = [truthOf(n, 0)]
            let first = 0
            for (let i = 1; i < countIds(n) && !first; i++) {
                if (machine.has(getRef(n, i))) first = getRef(n, i)
            }
            const T = first && !isControl(id) ? machine.get(first) : undefined
            const armOf = (i: number): Operand | undefined => {
                const ref = getRef(n, i)
                const m = getNode(src, ref)
                if (m?.op === NodeOp.literal && typeOf(m) === Types.bool && T === Types.bool) return { literal: getLiteral(src, m, 0) ? 1 : 0 }
                return machine.get(ref) === T && raw.has(ref) === raw.has(first) ? ref : undefined
            }
            const arms: Operand[] = []
            for (let i = 1; i < countIds(n) && T !== undefined; i++) {
                const arm = armOf(i)
                if (arm !== undefined) arms.push(arm)
            }
            const typed = T !== undefined && arms.length === countIds(n) - 1
            for (let i = 1; i < countIds(n); i++) operands.push(typed ? arms[i - 1] : wordOf(n, i))
            putNode(g, id, NodeOp.select, operands)
            if (typed) machine.set(id, T!)
            if (typed && raw.has(first)) raw.add(id)
            return
        }
        if (n.op === NodeOp.trap) {
            putNode(g, id, NodeOp.trap, [getOperand(src, n, 0), machineOf(n, 1, Types.u64)])
            return
        }
        if (arithOps.has(n.op) || bitwiseOps.has(n.op) || n.op === NodeOp.neg || n.op === NodeOp.not) {
            lowerNumber(id, n)
            return
        }
        if (compareOps.has(n.op) || n.op === NodeOp.eq || n.op === NodeOp.ne) {
            lowerCompare(id, n)
            return
        }
        if (n.op === NodeOp.unbox) {
            const T = typeOf(n)
            const word = wordOf(n, 0)
            if (T === Types.bool) putNode(g, id, NodeOp.eq, [word, { literal: heap.trueWord }], Types.bool)
            else if (T === Types.f64) putNode(g, id, NodeOp.bitconvert, [nativeCall(loose, toBits, [word])], Types.f64)
            else putNode(g, id, NodeOp.bitconvert, [nativeCall(loose, heap.wordInt, [word])], Types.i64)
            machine.set(id, T)
            return
        }
        if (n.op === NodeOp.box) {
            const ref = getRef(n, 0)
            const T = machine.get(ref)
            if (T === undefined) fail(`boxes a word at %${id}`)
            if (T === Types.f64) putFloat(id, ref)
            else if (T === Types.bool) putNode(g, id, NodeOp.select, [ref, { literal: heap.trueWord }, { literal: heap.falseWord }])
            else putNode(g, id, NodeOp.call, [loose, nativeTarget(d, g, heap.intWord), { literal: 0 }, ref])
            return
        }
        if (n.op === NodeOp.rt) {
            lowerRuntime(id, n)
            return
        }
        if (n.op === NodeOp.getProp) {
            putUnitCall(id, getOperand(src, n, 0), get, undefinedWord, undefinedWord, [wordOf(n, 1), keyOf(n, 2)])
            return
        }
        if (n.op === NodeOp.setProp) {
            putUnitCall(id, getOperand(src, n, 0), set, undefinedWord, undefinedWord, [wordOf(n, 1), keyOf(n, 2), wordOf(n, 3)])
            return
        }
        if (n.op === NodeOp.call) {
            lowerCall(id, n)
            return
        }
        if (n.op === NodeOp.load) {
            const T = typeOf(n)
            putNode(g, id, NodeOp.load, [getOperand(src, n, 0), machineOf(n, 1, Types.u64), machineOf(n, 2, Types.u64)], T === Types.vm_value ? Types.u32 : T)
            if (T !== Types.vm_value) machine.set(id, T)
            return
        }
        if (n.op === NodeOp.store) {
            const T = typeOf(n)
            const value = T === Types.vm_value ? wordOf(n, 3) : machineOf(n, 3, T)
            putNode(g, id, NodeOp.store, [getOperand(src, n, 0), machineOf(n, 1, Types.u64), machineOf(n, 2, Types.u64), value], T === Types.vm_value ? Types.u32 : T)
            return
        }
        if (n.op === NodeOp.convert || n.op === NodeOp.bitconvert) {
            lowerConvert(id, n, n.op === NodeOp.bitconvert)
            return
        }
        if (n.op === NodeOp.typeof) {
            putNative(id, loose, machineType, [wordOf(n, 0)])
            return
        }
        if (n.op === NodeOp.poolEntry) {
            machine.set(id, Types.u64)
            return
        }
        if (n.op === NodeOp.static) {
            const target = getNode(src, getRef(n, 0))
            if (target?.op !== NodeOp.heapHandle) fail(`reads a static of an unknown function at %${id}`)
            const slot = addNode(g, NodeOp.static, [addNode(g, NodeOp.heapHandle, [{ literal: getLiteral(src, target!, 0) }])])
            putNode(g, id, NodeOp.convert, [slot], Types.u32)
            return
        }
        if (machineOps.has(n.op)) {
            const T = typeOf(n)
            const operands: Operand[] = []
            const ordered = n.op === NodeOp.pstack || n.op === NodeOp.stackalloc || n.op === NodeOp.stackfree || n.op === NodeOp.alloca
            for (let i = 0; i < countIds(n); i++) operands.push(ordered && i === 0 ? getOperand(src, n, 0) : machineOf(n, i, Types.u64))
            putNode(g, id, n.op, operands, T)
            machine.set(id, n.op === NodeOp.pstack || n.op === NodeOp.alloca ? Types.u64 : T)
            return
        }
        fail(`has an unsupported ${n.op} node %${id}`)
    }
    function lowerFrom(root: number): void {
        for (const id of blockOrder(src, { id: 0, params: [], bodyId: root, bodyConst: 0 })) {
            if (done.has(id)) continue
            done.add(id)
            lowerNode(id)
        }
    }
    for (const id of ids) {
        if (done.has(id)) continue
        done.add(id)
        lowerNode(id)
    }
    setGraphBlocks(g, g.blocks.map(b => b.id === entry.id ? { ...b, params } : b))
    g.name = where
    return g
}

function hostArrayCell(cell: number): boolean {
    return !!cell && heap.isCell(cell as Handle) && cell < heap.runtimeCells && heap.isArray(cell as Handle)
}

function entryGraph(d: Dyn, name: string, target: number, count: number, fast?: Contract): number {
    return unitGraph(d, glueSymbol(d, `${name}/entry`), `${name}/entry`, count, Types.u64, (g, token, params) => {
        const words = params.map((p, i) => fast?.params[i + 1].kind === Kinds.int ? p : addNode(g, NodeOp.call, [token, nativeTarget(d, g, heap.intWord), { literal: 0 }, p]))
        const local = addNode(g, NodeOp.localTarget, [{ literal: target }], Types.u32)
        if (!fast) return abiCall(g, token, local, { literal: heap.undefinedWord }, { literal: heap.undefinedWord }, { literal: count }, words, { literal: heap.undefinedWord })
        const call = addNode(g, NodeOp.call, [token, local, { literal: 0 }, { literal: heap.undefinedWord }, { literal: heap.undefinedWord }, ...words])
        return fast.returnsInt ? addNode(g, NodeOp.call, [call, nativeTarget(d, g, heap.intWord), { literal: 0 }, call]) : call
    })
}

function optimizerHost(d: Dyn, tracer: native.Tracer, keep: (fn: Function) => boolean): Host {
    const { linker } = d
    const unit = (fn: Function | undefined) => fn && keep(fn) && linker.codeOf(fn) ? fn : undefined
    const cellUnit = (cell: number) => {
        const linked: any = linker.session.stubFunctions.get(cell as u32)
        if (linked && (Number.isSafeInteger(linked.__native) || Number.isSafeInteger(linked.__syscall))) return undefined
        return unit(linker.functionAt(cell))
    }
    return {
        trace: fn => {
            if (!unit(fn)) return undefined
            try {
                return tracer.graphsOf(fn).traced as any as FastTraced
            } catch {
                return undefined
            }
        },
        unit: cellUnit,
        bound: (fn, count) => {
            try {
                return linker.boundTarget(fn, count, false)
            } catch {
                return undefined
            }
        },
        direct: (traced, n) => {
            const target = getNode(traced.graph, getRef(n, 1))
            if (target?.op === NodeOp.localTarget) return unit(linker.functions[getLiteral(traced.graph, target, 0)])
            if (target?.op !== NodeOp.heapHandle) return undefined
            const cell = getLiteral(traced.graph, target, 0)
            if (traced.closures.has(cell)) return linker.closureFunction(cell as u32, 'closure')
            if (optimizer.perInvocationCell(traced, cell)) return undefined
            return cellUnit(cell)
        },
        symbol: fn => linker.intern(fn),
        signature: fn => {
            const compiled = linker.codeOf(fn)?.source.compiled
            return compiled ? { params: compiled.paramCount, rest: !!compiled.rest } : undefined
        },
        version: name => glueSymbol(d, name),
    }
}

function initGraph(d: Dyn, calls: [cell: number, symbol: number][], statics: number | undefined): number {
    const table = native.staticData(new Uint8Array(Math.max(calls.length, 1) * 16))
    const words = new Uint32Array(calls.length * 4)
    for (let i = 0; i < calls.length; i++) {
        words[i * 4] = cellWord(d, calls[i][0])
        d.image.codeFields.push([table + i * 16 + 8, d.image.functionSlot(calls[i][1], `${calls[i][1]}`)])
    }
    if (calls.length) native.staticWrite(table, new Uint8Array(words.buffer))
    return unitGraph(d, glueSymbol(d, 'dyn/init'), 'dyn/init', 0, Types.u32, (g, token) => {
        let last = addNode(g, NodeOp.call, [token, nativeTarget(d, g, installCalls), { literal: 0 }, { literal: table }, { literal: calls.length }])
        if (statics !== undefined) last = abiCall(g, last, addNode(g, NodeOp.localTarget, [{ literal: statics }], Types.u32), { literal: heap.undefinedWord }, { literal: heap.undefinedWord }, { literal: 0 }, [], { literal: heap.undefinedWord })
        return addNode(g, NodeOp.after, [last, { literal: 0 }])
    })
}

export function dynProgram(linker: native.Linker, tracer: native.Tracer, image: native.ProgramImage, target: any, clock: native.PhaseClock): native.ProgramGraph {
    const program: native.ProgramGraph = { units: new Map(), roots: new Map(), noInline: new Set(), alwaysInline: new Set(), constructors: new Set(), unplanned: new Set(), tagged: new Set(), abi: new Map(), hostReturns: new Map(), image, target }
    const d: Dyn = { linker, image, program, thunks: new Map(), call: 0, apply: 0, opt: undefined }
    for (const fn of glueSources) linker.addUnit(fn)
    d.call = callGlue(d)
    d.apply = applyGlue(d)
    invokeGlue(d)
    const lowered = new Set<Function>()
    const keep = (fn: Function) => !natives.has(fn) && fn !== invoke
    if (flags.has('dyn-opt')) d.opt = clock.timed('analysis', () => optimizer.createOptimizer(optimizerHost(d, tracer, keep), [...linker.roots.values()].map(symbol => linker.functions[symbol])))
    const fastRoots = new Map<number, Version>()
    for (const symbol of linker.roots.values()) {
        const contract = d.opt && optimizer.enabled(d.opt, 'kinds') ? optimizer.fastContract(d.opt, linker.functions[symbol]) : undefined
        if (!contract || !contract.params.every(p => p.kind === Kinds.int || p.kind === anyKinds)) continue
        const version = versionOf(d.opt!, contract)
        useVersion(d.opt!, version)
        fastRoots.set(symbol, version)
    }
    const lower = (fn: Function, unit: native.Unit) => {
        const traced = unit.traced as any as FastTraced
        const optimized = d.opt ? clock.timed('analysis', () => optimizer.optimizeUnit(d.opt!, traced, undefined), fn.name) : undefined
        const graph = clock.timed('resolve', () => lowerTraced(d, fn, optimized?.traced ?? traced, optimized?.routes), fn.name)
        if (flags.has(`dyn-debug:${fn.name}`) || flags.has(`dyn-debug`)) console.log(dumpGraph(graph))
        program.units.set(linker.addUnit(fn), graph)
        lowered.add(fn)
    }
    const schedule = () => {
        tracer.traceScheduled(keep, lower)
        while (d.opt && d.opt.pending.length) {
            const version = d.opt.pending.pop()!
            const fn = version.contract.unit
            const base = tracer.graphsOf(fn).traced as any as FastTraced
            const nodes = new Map<number, GraphNode>()
            for (const [id, n] of base.graph.nodes) nodes.set(id, copyNode(base.graph, n))
            const optimized = clock.timed('analysis', () => optimizer.optimizeUnit(d.opt!, { ...base, graph: withNodes(base.graph, nodes) }, version.contract), version.name)
            const graph = clock.timed('resolve', () => lowerTraced(d, fn, optimized.traced, optimized.routes, version.contract), version.name)
            graph.name = version.name
            if (flags.has(`dyn-debug:${version.name}`) || flags.has(`dyn-debug`)) console.log(dumpGraph(graph))
            program.units.set(version.symbol, graph)
            tracer.traceScheduled(keep, lower)
        }
    }
    schedule()
    let statics: Function | undefined
    let linked = 0
    while (linked !== linker.staticFns.length) {
        linked = linker.staticFns.length
        statics = native.staticInitializerOf(linker, image, () => true)
        linker.link(statics!)
        schedule()
    }
    const calls: [number, number][] = []
    for (const [cell, fn] of linker.callableCells) {
        if (lowered.has(fn)) calls.push([cell, linker.addUnit(fn)])
    }
    for (const [name, symbol] of linker.roots) {
        const fast = fastRoots.get(symbol)
        const entry = entryGraph(d, name, fast ? fast.symbol : symbol, linker.codeOf(linker.functions[symbol])!.source.compiled.paramCount, fast?.contract)
        program.roots.set(name, entry)
        program.hostReturns.set(entry, 'word')
    }
    program.roots.set(native.staticInitName, initGraph(d, calls, statics ? linker.addUnit(statics) : undefined))
    if (d.opt && flags.has('opt-stats')) optimizer.printStats(d.opt)
    return program
}

export function normalizeProgram(program: native.ProgramGraph, clock: native.PhaseClock): number {
    for (const [symbol, graph] of program.units) {
        const normal = clock.normalize(graph, { firstPass: true })
        if (flags.has(`dyn-debug:${graph.name}`)) console.log(dumpGraph(normal))
        program.units.set(symbol, normal)
    }
    return 0
}

export function suite() {
    function addOne(n: number): number {
        return n + 1
    }
    function fieldTwice(n: number): number {
        const o = { a: n, b: 3 }
        return o.a * 2 + o.b
    }
    function branchy(n: number): number {
        if (n > 3) return n - 3
        return n * 10
    }
    function loopSum(n: number): number {
        let total = 0
        for (let i = 0; i < n; i++) total = total + i
        return total
    }
    function helper(a: number, b: number): number {
        return a * b + 1
    }
    function callsHelper(n: number): number {
        return helper(n, n + 1) + helper(2, 3)
    }
    function closureCount(n: number): number {
        let count = 0
        const bump = (by: number) => {
            count = count + by
        }
        for (let i = 0; i < n; i++) bump(i)
        return count
    }
    function arrayPush(n: number): number {
        const xs: number[] = []
        for (let i = 0; i < n; i++) xs.push(i * 2)
        let total = 0
        for (const x of xs) total = total + x
        return total + xs.length
    }
    function stringJoin(n: number): number {
        const s = 'ab' + n + 'c'
        return s.length
    }
    function setSize(n: number): number {
        const s = new Set([n, n + 1, n])
        return s.size * 10 + (s.has(n + 1) ? 1 : 0)
    }
    const prefixNames = ['LdaX', 'Star', 'x']
    function startsLda(n: number): number {
        const name = prefixNames[n] ?? 'x'
        return (name.startsWith('Lda') ? 10 : 0) + name.length
    }
    const protoGetter = { get v(): number { return 5 } }
    function getterCase(n: number): number {
        const o = Object.create(protoGetter)
        return o.v + n
    }
    const definedProto = Object.defineProperties({}, { v: { get: intrinsics.tagInline(function (this: any) { return this.k * 2 }), enumerable: true, configurable: true } })
    function getterDefined(n: number): number {
        const o = Object.create(definedProto)
        o.k = n
        return o.v
    }
    function entriesProbe(n: number): number {
        const o = { a: n, b: 2 }
        const e = Object.entries(o)
        return e.length * 1000 + e[0].length * 100 + e[1][1] * 10 + Object.keys(o).length + Object.values(o)[0]
    }
    function sumAll(...xs: number[]): number {
        let total = 0
        for (const x of xs) total = total + x
        return total
    }
    function headAndRest(first: number, ...xs: number[]): number {
        return first * 100 + xs.length
    }
    const spreadTargets = [sumAll, headAndRest]
    function spreadUnknown(n: number): number {
        const xs = [n, 2, 3, 4, 5, 6]
        const f = spreadTargets[n & 1]
        return f(...xs) + Math.max(...xs) + sumAll(n, 1, 2, 3, 4, 5)
    }
    function constCode(n: number): number {
        return 'Lda'.charCodeAt(n)
    }
    function hostCode(n: number): number {
        return prefixNames[n].charCodeAt(0)
    }
    function firstCode(n: number): number {
        const name = prefixNames[n] ?? 'x'
        return name.charCodeAt(0) * 1000 + 'Lda'.charCodeAt(n) * 10 + name.length
    }
    const tagNames = ['add', 'sub', ['mul', 'div']]
    const tagHolder = { names: tagNames, inner: tagNames[2] }
    function hostArrays(n: number): number {
        const seen = new Set(tagNames)
        let count = 0
        for (const x of tagNames) count = count + (typeof x === 'string' ? 1 : 2)
        let score = seen.size * 100 + count * 10 + n
        if (tagNames.includes('sub')) score = score + 1
        if (tagHolder.names === tagNames) score = score + 1000
        if (tagHolder.inner === tagNames[2]) score = score + 10000
        const inner = tagNames[2] as string[]
        if (inner.includes('div')) score = score + 100000
        return score
    }
    function mapMiss(n: number): number {
        const m = new Map<number, number>()
        m.set(1, 5)
        m.set(3, 0)
        if (const r = m.get(n)) return r + 10
        return -1
    }
    function wideSign(x: i64): number {
        if (Intrinsics.or(x, 0, Types.i64) >= 0) return 1
        return 2
    }
    function signedGe(n: number): number {
        return wideSign(n - 5) * 10 + wideSign(n)
    }
    function manyArgs(a: number, b: number, c: number, d: number, e: number, f?: number): number {
        if (f === undefined) return -a
        return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
    }
    function overflowCall(n: number): number {
        return manyArgs(n, 1, 2, 3, 4, 5) + manyArgs(1, 1, 1, 1, 1) * 1000
    }
    function parsed(n: number): number {
        return +('1' + n) + +'2.5' * 2
    }
    function restFirst(...xs: number[]): number {
        return xs[0] * 100 + xs.length
    }
    function restArgs(n: number): number {
        return restFirst(n, 5)
    }
    function negOf(x: u32): number {
        return -x - 1
    }
    function negated(n: number): number {
        return negOf(n)
    }
    harness.runCases({ prefix: 'dyn', args: true }, [
        [signedGe, [2], [9]],
        [mapMiss, [1], [2], [3]],
        [hostArrays, [0], [3]],
        [addOne, [3], [-7]],
        [fieldTwice, [4]],
        [branchy, [2], [9]],
        [loopSum, [10]],
        [callsHelper, [4]],
        [closureCount, [5]],
        [arrayPush, [6]],
        [stringJoin, [12]],
        [setSize, [3]],
        [startsLda, [0], [1], [2], [5]],
        [getterCase, [1]],
        [getterDefined, [4]],
        [entriesProbe, [3]],
        [spreadUnknown, [0], [1], [6]],
        [constCode, [0], [1]],
        [hostCode, [0], [1]],
        [firstCode, [0], [1], [2]],
        [overflowCall, [7]],
        [parsed, [4]],
        [negated, [3]],
        [restArgs, [4]],
    ])
}
