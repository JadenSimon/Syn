/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { BitwiseOps, type Graph, type GraphNode, NumericOps, typeName } from './lowering2'
import { countIds, getLiteral, getNode, getRef, isThisParam, NodeOp, resultType, spreadsLast, typeOf } from './graph-node'
import { Op as RtOp, assignExcluded, bindingOf, elementType } from './rt'
import { dataKeys } from './property-eval'
import * as pg from './pg-optimizer'
import { constructedAllocation, numberKey, regionRets, type AccessHost, type Accesses, type Site } from './value-types'

type Handle = intrinsics.Handle

const Types = intrinsics.Types
const argv = intrinsics.argv()

export const MinI64 = -(2 ** 63)
export const MaxI64 = 2 ** 63
export const MaxU64 = 2 ** 64
const maxStrings = 8
const maxLiterals = 8
const budgetFactor = 40

export enum ScalarFlag {
    undef = 1,
    void = 2,
    int = 4,
    float = 8,
    str = 16,
    anyStr = 32,
    unknown = 64,
}

interface Scalars {
    flags: number[]
    lo: number[]
    hi: number[]
    strs: number[][]
    nums: number[][]
    index: Map<string, number>
    unions: Map<number, Map<number, number>>
}

export enum ExprOp {
    konst,
    origin,
    alloc,
    param,
    union,
    member,
    call,
    arith,
    cmp,
    num,
    rt,
    opaque,
    store,
    narrow,
    pick,
    gate,
    ntype,
}

export interface Expr {
    op: ExprOp
    node: number
    a: number
    b: number
    key: number
    args: number[]
    sub: number
    type: number
    gates: number[] | undefined
}

interface Order {
    groups: number[][]
    users: (number[][] | undefined)[]
}

export interface Summary {
    fn: Function
    id: number
    g: Graph
    name: string
    exprs: Expr[]
    exprOf: Map<number, number>
    konsts: Map<number, number>
    origins: Map<number, number>
    params: number
    hasThis: boolean
    usesCtx: boolean
    rets: number[]
    fresh: Set<number>
    scopes: Set<number>
    returnsFresh: boolean
    returnsSlice: boolean
    local: Int32Array | undefined
    width: number
    owned: number[]
    order: Order | undefined
    regions: Regions | undefined
    stores: number[]
    cone: number[] | null | undefined
    allocNodes: Map<number, number>
    retExpr: number
    selects: number[]
    blockGates: number[][]
    regionRets: Map<number, number>
}

export interface Regions {
    of: Map<number, number>
    block: Map<number, number>
    shared: Set<number>
    parent: number[]
    depth: number[]
    cond: number[]
    arm: number[]
    children: Map<number, number>
    roots: number[]
    link: number[]
    tested: Set<number>
    paramBlock: Map<number, number>
    entries: number[][]
    narrows: Map<number, Map<number, number>>
    guards: Map<number, Map<number, Guard>>
    narrowExprs: Map<number, Map<Guard, number>>
    gateOf: Map<number, number>
}

export enum OriginKind {
    none,
    fn,
    static,
    fresh,
    slice,
    created,
    site,
    str,
}

export enum SlotKind {
    expr,
    sig,
    ret,
    field,
    konst,
    part,
}

interface Bind {
    callee: number
    from: number
    kind: BindKind
    target: number
    recv: number
}

enum BindKind {
    virtual,
    call,
    rt,
}

export enum ListenerKind {
    copy,
    member,
    callTarget,
    callRecv,
    rtSubject,
    store,
    assignSource,
    assignTarget,
    narrow,
    pick,
    offset,
    invariant,
}

interface Listener {
    kind: ListenerKind
    target: number
    key: number
    extra: number
    e: number
}

export interface Instance {
    id: number
    summary: Summary
    qual: number
    base: number
    sigs: number[]
    ret: number
    callers: number[]
    lit: number
    litParam: number
    site: Instance | undefined
    map: Map<number, number> | undefined
}

export interface FlowState {
    host: AccessHost
    roots: Function[]
    strOrigin: number
    nothing: number
    dynamicOrigins: Set<number>
    spec: SpecState
    frames: FrameInfo[]
    unitKeys: Map<Function, number>
    work: number
    traceMs: number
    budget: number
    totalNodes: number
    summaries: Map<Function, Summary>
    summaryList: Summary[]
    instances: Instance[]
    instanceOf: Map<Function, Map<number, number>>
    originKind: number[]
    originCell: number[]
    originQual: number[]
    originFn: (Function | undefined)[]
    originFnKnown: number[]
    originOwner: (Summary | undefined)[]
    originNode: number[]
    originIndex: Map<string, number>
    originFields: Map<number, number>[]
    originFieldListeners: (number[] | undefined)[]
    originPending: (Map<number, number[]> | undefined)[]
    elemReaders: Map<number, number[]>
    pickWatch: Map<number, number[]>
    freshOwner: Map<number, Summary>
    slotKind: number[]
    slotOwner: number[]
    slotIndex: number[]
    slotOrigins: number[][]
    slotOriginSet: (Set<number> | undefined)[]
    slotSent: number[]
    slotListeners: (Listener[] | undefined)[]
    slotIns: (number[] | undefined)[]
    slotConst: number[]
    slotOpaque: number[]
    queue: number[]
    storeSlots: Map<number, number>
    constSlots: Map<number, number>
    originSlots: Map<number, number>
    bound: Map<number, Set<number>>
    missing: number[]
    gateWaits: Map<number, number[]>
    scalar: number[]
    scalarUsers: (number[] | undefined)[]
    scalarQueue: number[]
    scalarQueued: number[]
    scalarChanges: number[]
    originMask: number[]
    stringSite: number[]
    fieldForms: Map<number, string[]>
    fieldReaders: Map<number, number[]>
    fieldWriters: Map<number, number[]>
    fieldStored: Set<number>
    originSeen: number[]
    originCopied: Set<number>
    heldInits: Map<number, Function>
    heldStatics: Set<number>
    rtPending: number[]
    parts: Map<number, Map<number, number>>
    partBind: Map<number, Bind>
    rooted: Set<number>
    originCreators: Map<number, number[]>
    originSeeds: Map<number, number[]>
    seedList: number[]
    setterKeys: Set<number>
    keyedReads: Map<number, number[]>
    namedReads: Map<number, number[]>
    runtimeBinds: Map<number, number[]>
}

export const elemKey = -1
export const dynKey = -2
const maxTuple = 8
export const posBase = -16

function posKey(i: number): number {
    return posBase - i
}

export function isPosKey(key: number): boolean {
    return key <= posBase && key > posBase - maxTuple
}

let flow: FlowState
export const scalars: Scalars = { flags: [], lo: [], hi: [], strs: [], nums: [], index: new Map(), unions: new Map() }

function scalar(flags: number, lo: number, hi: number, strs: number[], nums: number[] = []): number {
    if (!(flags & ScalarFlag.int)) {
        lo = 0
        hi = 0
        nums = []
    }
    if (nums.length < 2 || nums.length > maxLiterals) nums = []
    if (nums.length) {
        lo = nums[0]
        hi = nums[nums.length - 1]
    }
    if (nums.length === hi - lo + 1) nums = []
    if (lo < 0 && hi > MaxI64) {
        lo = MinI64
        hi = MaxI64
    }
    if (flags & ScalarFlag.anyStr) strs = []
    if (strs.length > maxStrings) {
        flags = flags | ScalarFlag.anyStr
        strs = []
    }
    if (strs.length) flags = flags | ScalarFlag.str
    else flags = flags & ~ScalarFlag.str
    const key = `${flags}|${lo}|${hi}|${strs.join(',')}|${nums.join(',')}`
    const known = scalars.index.get(key)
    if (known !== undefined) return known
    const id = scalars.flags.length
    scalars.flags.push(flags)
    scalars.lo.push(lo)
    scalars.hi.push(hi)
    scalars.strs.push(strs)
    scalars.nums.push(nums)
    scalars.index.set(key, id)
    return id
}

export const NONE = scalar(0, 0, 0, [])
const UNDEF = scalar(ScalarFlag.undef, 0, 0, [])
const VOID = scalar(ScalarFlag.void, 0, 0, [])
const UNKNOWN = scalar(ScalarFlag.unknown, 0, 0, [])
const FLOAT = scalar(ScalarFlag.float, 0, 0, [])
const BOOL = scalar(ScalarFlag.int, 0, 1, [])
const ANYSTR = scalar(ScalarFlag.anyStr, 0, 0, [])
const U64 = scalar(ScalarFlag.int, 0, MaxU64, [])
const I64 = scalar(ScalarFlag.int, MinI64, MaxI64, [])

function numScalar(lo: number, hi: number): number {
    return scalar(ScalarFlag.int, lo, hi, [])
}

function literalScalar(v: number): number {
    if (!Number.isInteger(v)) return FLOAT
    return numScalar(v, v)
}

function literalsOf(t: number): number[] | undefined {
    if (!(scalars.flags[t] & ScalarFlag.int)) return undefined
    if (scalars.nums[t].length) return scalars.nums[t]
    if (scalars.lo[t] === scalars.hi[t]) return [scalars.lo[t]]
    return undefined
}

function strScalar(h: number): number {
    return scalar(ScalarFlag.str, 0, 0, [h])
}

export function unite(a: number, b: number): number {
    if (a === b || b === NONE) return a
    if (a === NONE) return b
    const lo0 = a < b ? a : b
    const hi0 = a < b ? b : a
    let byHi = scalars.unions.get(lo0)
    if (!byHi) scalars.unions.set(lo0, byHi = new Map())
    const known = byHi.get(hi0)
    if (known !== undefined) return known
    const fa = scalars.flags[a]
    const fb = scalars.flags[b]
    const flags = fa | fb
    let lo = 0
    let hi = 0
    let nums: number[] = []
    if ((fa & ScalarFlag.int) && (fb & ScalarFlag.int)) {
        lo = Math.min(scalars.lo[a], scalars.lo[b])
        hi = Math.max(scalars.hi[a], scalars.hi[b])
        const la = literalsOf(a)
        const lb = literalsOf(b)
        if (la && lb) {
            nums = la.slice()
            for (const v of lb) if (!nums.includes(v)) nums.push(v)
            nums.sort((x, y) => x - y)
        }
    } else if (fa & ScalarFlag.int) {
        lo = scalars.lo[a]
        hi = scalars.hi[a]
        nums = scalars.nums[a]
    } else if (fb & ScalarFlag.int) {
        lo = scalars.lo[b]
        hi = scalars.hi[b]
        nums = scalars.nums[b]
    }
    let strs: number[] = []
    if (!(flags & ScalarFlag.anyStr)) {
        strs = scalars.strs[a].slice()
        for (const s of scalars.strs[b]) if (!strs.includes(s)) strs.push(s)
        strs.sort((x, y) => x - y)
    }
    const id = scalar(flags, lo, hi, strs, nums)
    byHi.set(hi0, id)
    return id
}

export function typeRange(T0: intrinsics.Types): number {
    if (T0 === Types.bool) return BOOL
    if (T0 === Types.f64 || T0 === Types.f32 || T0 === Types.f16) return FLOAT
    if (T0 === Types.u8) return numScalar(0, 255)
    if (T0 === Types.u16) return numScalar(0, 65535)
    if (T0 === Types.u32 || T0 === Types.usize || T0 === Types.handle) return numScalar(0, 2 ** 32 - 1)
    if (T0 === Types.i8) return numScalar(-128, 127)
    if (T0 === Types.i16) return numScalar(-32768, 32767)
    if (T0 === Types.i32) return numScalar(-(2 ** 31), 2 ** 31 - 1)
    if (T0 === Types.i64 || T0 === Types.unknown_number) return I64
    if (T0 === Types.vm_value || T0 === Types.unknown) return UNKNOWN
    return U64
}

function wrapped(lo: number, hi: number): number {
    if (lo >= 0 && hi <= MaxU64) return numScalar(lo, hi)
    if (lo >= MinI64 && hi <= MaxI64) return numScalar(lo, hi)
    return lo < 0 ? I64 : U64
}

function singleton(op: NodeOp, a: number, b: number): number {
    const small = a >= -(2 ** 31) && a < 2 ** 31 && b >= -(2 ** 31) && b < 2 ** 31
    switch (op) {
        case NodeOp.and: return small ? numScalar(a & b, a & b) : NONE
        case NodeOp.or: return small ? numScalar(a | b, a | b) : NONE
        case NodeOp.xor: return small ? numScalar(a ^ b, a ^ b) : NONE
        case NodeOp.div: return a >= 0 && b > 0 ? numScalar(Math.floor(a / b), Math.floor(a / b)) : NONE
        case NodeOp.rem: return a >= 0 && b > 0 ? numScalar(a % b, a % b) : NONE
    }
    return NONE
}

function interval(op: NodeOp, alo: number, ahi: number, blo: number, bhi: number): number {
    if (alo === ahi && blo === bhi && Number.isSafeInteger(alo) && Number.isSafeInteger(blo)) {
        const exact = singleton(op, alo, blo)
        if (exact !== NONE) return exact
    }
    switch (op) {
        case NodeOp.add: return wrapped(alo + blo, ahi + bhi)
        case NodeOp.sub: return wrapped(alo - bhi, ahi - blo)
        case NodeOp.subsat: return numScalar(Math.max(0, alo - bhi), Math.max(0, ahi - blo))
        case NodeOp.neg: return wrapped(-ahi, -alo)
        case NodeOp.mul: {
            const c0 = alo * blo
            const c1 = alo * bhi
            const c2 = ahi * blo
            const c3 = ahi * bhi
            return wrapped(Math.min(c0, c1, c2, c3), Math.max(c0, c1, c2, c3))
        }
        case NodeOp.shl: return alo >= 0 && blo >= 0 && bhi < 64 ? wrapped(alo * 2 ** blo, ahi * 2 ** bhi) : I64
        case NodeOp.shr:
        case NodeOp.ushr:
            if (alo >= 0 && blo >= 0) return numScalar(Math.floor(alo / 2 ** Math.min(bhi, 64)), Math.floor(ahi / 2 ** Math.min(blo, 64)))
            return op === NodeOp.ushr ? U64 : I64
        case NodeOp.and:
            if (alo >= 0 && blo >= 0) return numScalar(0, Math.min(ahi, bhi))
            if (alo >= 0) return numScalar(0, ahi)
            if (blo >= 0) return numScalar(0, bhi)
            return I64
        case NodeOp.or:
        case NodeOp.xor:
            return alo >= 0 && blo >= 0 ? numScalar(0, Math.min(MaxU64, 2 ** Math.ceil(Math.log2(Math.max(ahi, bhi) + 1)) - 1)) : I64
        case NodeOp.div:
        case NodeOp.rem:
            return alo >= 0 && blo >= 0 ? numScalar(0, ahi) : I64
        case NodeOp.not: return wrapped(-ahi - 1, -alo - 1)
        case NodeOp.clz: return numScalar(0, 64)
    }
    return alo >= 0 && blo >= 0 ? U64 : I64
}

function opaqueNumber(t: number): number {
    if (!(scalars.flags[t] & ScalarFlag.unknown)) return t
    return unite(withoutUnknown(t), numScalar(MinI64, MaxU64))
}

function truncated(t: number): number {
    if (!(scalars.flags[t] & ScalarFlag.float)) return t
    return unite(scalar(scalars.flags[t] & ~ScalarFlag.float, scalars.lo[t], scalars.hi[t], scalars.strs[t]), I64)
}

function arithScalar(op: NodeOp, T0: intrinsics.Types, a0: number, b0: number): number {
    const bitwise = BitwiseOps.has(op)
    if ((T0 === Types.f64 || T0 === Types.f32) && !bitwise) return FLOAT
    const a = bitwise ? truncated(opaqueNumber(a0)) : opaqueNumber(a0)
    const b = bitwise ? truncated(opaqueNumber(b0)) : opaqueNumber(b0)
    const fa = scalars.flags[a]
    const fb = scalars.flags[b]
    if (!((fa | fb) & (ScalarFlag.int | ScalarFlag.float))) return NONE
    let out = NONE
    if ((fa | fb) & ScalarFlag.float) out = FLOAT
    if ((fa & ScalarFlag.int) && (fb & ScalarFlag.int)) out = unite(out, interval(op, scalars.lo[a], scalars.hi[a], scalars.lo[b], scalars.hi[b]))
    if (T0 !== Types.unknown_number && T0 !== Types.u64 && T0 !== Types.i64 && (scalars.flags[out] & ScalarFlag.int)) {
        const bound = typeRange(T0)
        if ((scalars.flags[bound] & ScalarFlag.int) && (scalars.lo[out] < scalars.lo[bound] || scalars.hi[out] > scalars.hi[bound])) out = unite(scalars.flags[out] & ScalarFlag.float ? FLOAT : NONE, bound)
    }
    return out
}

export function charge(n: number): void {
    flow.work += n
    if (flow.work > flow.budget) throw `value-flow: budget exceeded (work ${flow.work} > ${budgetFactor} * ${flow.totalNodes} nodes)\n${new Error().stack}`
}

function newSlot(kind: SlotKind, owner: number, index: number): number {
    const id = flow.slotKind.length
    flow.slotKind.push(kind)
    flow.slotOwner.push(owner)
    flow.slotIndex.push(index)
    flow.slotOrigins.push([])
    flow.slotOriginSet.push(undefined)
    flow.slotSent.push(0)
    flow.slotListeners.push(undefined)
    flow.slotIns.push(undefined)
    flow.slotConst.push(NONE)
    flow.slotOpaque.push(0)
    flow.scalar.push(NONE)
    flow.scalarUsers.push(undefined)
    flow.scalarQueued.push(0)
    flow.scalarChanges.push(0)
    flow.originMask.push(0)
    flow.stringSite.push(0)
    dirtyScalar(id)
    return id
}

function dirtyScalar(s: number): void {
    if (flow.scalarQueued[s]) return
    flow.scalarQueued[s] = 1
    flow.scalarQueue.push(s)
}

function scalarUse(from: number, to: number): void {
    let users = flow.scalarUsers[from]
    if (!users) flow.scalarUsers[from] = users = []
    users.push(to)
}

function dirtyUsers(s: number): void {
    const users = flow.scalarUsers[s]
    if (users) for (const u of users) dirtyScalar(u)
}

function markOpaque(s: number): void {
    if (flow.slotOpaque[s]) return
    flow.slotOpaque[s] = 1
    dirtyScalar(s)
}

function originBit(origin: number): number {
    if (flow.originKind[origin] === OriginKind.str) return 3
    return originHostFn(origin) ? 5 : 9
}

function noteOrigin(s: number, origin: number): void {
    const mask = flow.originMask[s]
    if (mask === 15) return
    const next = mask | originBit(origin)
    if (next === mask) return
    flow.originMask[s] = next
    dirtyUsers(s)
}

export function addConst(s: number, t: number): void {
    const next = unite(flow.slotConst[s], t)
    if (next === flow.slotConst[s]) return
    flow.slotConst[s] = next
    dirtyScalar(s)
    if (flow.pickWatch.size && flow.slotKind[s] === SlotKind.field) recheckPicks(s)
}

function addIn(s: number, from: number): void {
    let ins = flow.slotIns[s]
    if (!ins) flow.slotIns[s] = ins = []
    ins.push(from)
    scalarUse(from >= 0 ? from : -from - 1, s)
    dirtyScalar(s)
    if (flow.pickWatch.size && flow.slotKind[s] === SlotKind.field) recheckPicks(s)
}

function addOrigin(s: number, origin: number): void {
    let set = flow.slotOriginSet[s]
    if (!set) flow.slotOriginSet[s] = set = new Set()
    if (set.has(origin)) return
    set.add(origin)
    flow.slotOrigins[s].push(origin)
    flow.queue.push(s)
    noteOrigin(s, origin)
    if (flow.pickWatch.size && flow.slotKind[s] === SlotKind.field) recheckPicks(s)
}

export function listen(s: number, kind: ListenerKind, target: number, key: number, extra: number, e: number = 0): void {
    let list = flow.slotListeners[s]
    if (!list) flow.slotListeners[s] = list = []
    const l: Listener = { kind, target, key, extra, e }
    list.push(l)
    const origins = flow.slotOrigins[s]
    const sent = flow.slotSent[s]
    for (let i = 0; i < sent; i++) deliver(l, origins[i])
}

export const exprBits = 1048576

export function writerId(inst: Instance, e: number): number {
    intrinsics.assert(e < exprBits, `value-flow: expression index ${e} of ${inst.summary.name} does not fit a writer id`)
    return inst.id * exprBits + e
}

export function storeSlot(inst: Instance, e: number): number {
    const key = writerId(inst, e)
    const known = flow.storeSlots.get(key)
    if (known !== undefined) return known
    const slot = newSlot(SlotKind.expr, inst.id, e)
    flow.storeSlots.set(key, slot)
    exprUses(slot)
    return slot
}

export function copyEdge(from: number, to: number): void {
    addIn(to, from)
    listen(from, ListenerKind.copy, to, 0, 0)
}

function partSlot(target: number, key: number): number {
    let byKey = flow.parts.get(target)
    if (!byKey) flow.parts.set(target, byKey = new Map())
    const known = byKey.get(key)
    if (known !== undefined) return known
    const p = newSlot(SlotKind.part, target, key)
    byKey.set(key, p)
    copyEdge(p, target)
    return p
}

export function ownerSlot(slot: number): number {
    let at = slot
    while (flow.slotKind[at] === SlotKind.part) at = flow.slotOwner[at]
    return at
}

function drain(): void {
    let next = 0
    for (;;) {
        if (next >= flow.queue.length) {
            if (flow.seedList.length) {
                seedPending()
                continue
            }
            if (!flow.scalarQueue.length) break
            drainScalars()
            continue
        }
        const s = flow.queue[next++]
        const origins = flow.slotOrigins[s]
        while (flow.slotSent[s] < origins.length) {
            const origin = origins[flow.slotSent[s]]
            flow.slotSent[s]++
            const list = flow.slotListeners[s]
            if (!list) continue
            for (let i = 0; i < list.length; i++) deliver(list[i], origin)
        }
    }
    flow.queue.length = 0
}

export function originOf(kind: OriginKind, cell: number, qual: number, node: number, owner: Summary | undefined): number {
    const k = `${kind}:${cell}:${qual}:${node}:${owner ? owner.id : 0}`
    const known = flow.originIndex.get(k)
    if (known !== undefined) return known
    const id = flow.originKind.length
    flow.originIndex.set(k, id)
    flow.originKind.push(kind)
    flow.originCell.push(cell)
    flow.originQual.push(qual)
    flow.originFn.push(undefined)
    flow.originOwner.push(owner)
    flow.originNode.push(node)
    flow.originFields.push(new Map())
    flow.originFieldListeners.push(undefined)
    flow.originPending.push(undefined)
    flow.originSeen.push(0)
    flow.originFnKnown.push(kind === OriginKind.static || (kind === OriginKind.fresh && !owner!.scopes.has(cell)) ? 0 : 1)
    if (kind === OriginKind.static || kind === OriginKind.fresh) flow.seedList.push(id)
    return id
}

function seedPending(): void {
    while (flow.seedList.length) {
        const origin = flow.seedList.pop()!
        if (flow.originKind[origin] === OriginKind.static && originHostFn(origin)) continue
        const state = heapState(origin)
        if (state === undefined || (!heap.isOrdinaryObject(state) && !originHostFn(origin))) continue
        const keys = dataKeys(state)
        charge(keys.length)
        for (const key of keys) fieldSlot(origin, key as number)
    }
}

function constantBuffer(origin: number, s: number, value: Handle): boolean {
    if (flow.originKind[origin] !== OriginKind.static || !flow.host.constantElements) return false
    const cell = flow.originCell[origin]
    const construction = flow.host.session.constructions.get(cell as u32)?.graph
    if (!construction || !constructedAllocation(construction, value)) return false
    const elements = flow.host.constantElements(heap.deref(cell as Handle))
    if (!elements) return false
    const buffer = originOf(OriginKind.slice, cell, origin, 0, undefined)
    flow.originSeen[buffer] = flow.originSeen[origin]
    for (let i = 0; i < elements.length; i++) {
        const f = fieldSlot(buffer, elements.length > maxTuple ? elemKey : posKey(i))
        addForm(f, 'vm_value')
        heapValue(elements[i], f, 0, undefined, 0)
    }
    addOrigin(s, buffer)
    return true
}

export function originFunction(origin: number): Function | undefined {
    if (!flow.originFnKnown[origin]) {
        flow.originFnKnown[origin] = 1
        flow.originFn[origin] = callableOf(flow.originCell[origin])
    }
    return flow.originFn[origin]
}

export function originHostFn(origin: number): Function | undefined {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.fn) return flow.originFn[origin]
    if (flow.originFnKnown[origin] && flow.originFn[origin]) return flow.originFn[origin]
    if (kind !== OriginKind.static && (kind !== OriginKind.fresh || isScope(origin))) return undefined
    const cell = flow.originCell[origin]
    if (cell <= 1 || heap.isString(cell as Handle) || heap.isBoxedF64(cell as Handle)) return undefined
    return flow.host.functionOf(cell as u32)
}

export function callableOf(cell: number): Function | undefined {
    if (cell <= 1 || heap.isString(cell as Handle) || heap.isBoxedF64(cell as Handle)) return
    const fn = flow.host.functionOf(cell as u32)
    return fn && flow.host.traceable(fn) ? fn : undefined
}

function fnOrigin(fn: Function): number {
    const s = summaryOf(fn)
    const id = originOf(OriginKind.fn, 0, 0, 0, s)
    flow.originFn[id] = fn
    return id
}

function strOrigin(): number {
    if (flow.strOrigin < 0) flow.strOrigin = originOf(OriginKind.str, heap.typeNames.string as number, 0, 0, undefined)
    return flow.strOrigin
}

function qualOf(origin: number): number {
    return flow.originKind[origin] === OriginKind.str ? 0 : origin
}

function qualified(kind: OriginKind, cell: number, qual: number, node: number, owner: Summary): number {
    while (qual > 0 && flow.originOwner[qual] === owner) qual = flow.originQual[qual]
    let at = qual
    while (at > 0) {
        if (flow.originKind[at] === kind && flow.originCell[at] === cell && flow.originNode[at] === node && flow.originOwner[at] === owner) return at
        at = flow.originQual[at]
    }
    return originOf(kind, cell, qual, node, owner)
}

function staticOrigin(cell: number): number {
    const owner = flow.freshOwner.get(cell)
    if (owner) return originOf(OriginKind.fresh, cell, 0, 0, owner)
    return originOf(OriginKind.static, cell, 0, 0, undefined)
}

export function isScope(origin: number): boolean {
    return flow.originKind[origin] === OriginKind.fresh && flow.originOwner[origin]!.scopes.has(flow.originCell[origin])
}

export function fieldSlot(origin: number, key: number): number {
    const fields = flow.originFields[origin]
    const known = fields.get(key)
    if (known !== undefined) return known
    const s = newSlot(SlotKind.field, origin, key)
    fields.set(key, s)
    seedField(origin, key, s)
    const pending = flow.originPending[origin]?.get(key)
    if (pending) for (const target of pending) readField(s, target)
    if (isPosKey(key)) {
        const readers = flow.elemReaders.get(origin)
        if (readers) for (const target of readers) readField(s, target)
    }
    const listeners = flow.originFieldListeners[origin]
    if (listeners) for (const assign of listeners) assignField(assign, key, s)
    if (key >= 0) for (const target of flow.keyedReads.get(origin) ?? []) readField(s, target)
    if (key === dynKey) {
        for (const target of flow.keyedReads.get(origin) ?? []) readField(s, target)
        for (const target of flow.namedReads.get(origin) ?? []) keyedInto(s, target)
    }
    return s
}

function keyedRead(origin: number, target: number): void {
    let list = flow.keyedReads.get(origin)
    if (!list) flow.keyedReads.set(origin, list = [])
    list.push(target)
    const state = heapState(origin)
    if (state !== undefined && heap.isOrdinaryObject(state)) for (const key of dataKeys(state)) fieldSlot(origin, key as number)
    for (const [key, s] of flow.originFields[origin]) if (key >= 0 || key === dynKey) readField(s, target)
    addConst(target, UNDEF)
}

function namedRead(origin: number, target: number): void {
    let list = flow.namedReads.get(origin)
    if (!list) flow.namedReads.set(origin, list = [])
    list.push(target)
    const keyed = flow.originFields[origin].get(dynKey)
    if (keyed !== undefined) keyedInto(keyed, target)
}

function keyedInto(keyed: number, target: number): void {
    readField(keyed, target)
    addConst(target, UNDEF)
}

function heapState(origin: number): Handle | undefined {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.static) return heap.deref(flow.originCell[origin] as Handle)
    if (kind !== OriginKind.fresh || isScope(origin)) return undefined
    const cell = flow.originCell[origin] as Handle
    if (flow.host.session.templateOf(cell as u32)) return heap.deref(cell)
    if (cell > 1 && !heap.isString(cell) && !heap.isBoxedF64(cell) && flow.host.functionOf(cell as u32)) return heap.isIndirect(cell) ? heap.indirectTarget(cell) : heap.deref(cell)
    return undefined
}

function seedField(origin: number, key: number, s: number): void {
    if (key < 0) return
    const state = heapState(origin)
    if (state === undefined) return
    const descriptor = heap.getOwnProperty(state, key as Handle)
    if (!descriptor) return
    const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
    if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
    addForm(s, 'init')
    if (constantBuffer(origin, s, d.slot0 as Handle)) return
    heapValue(d.slot0 as Handle, s, flow.originQual[origin], flow.originOwner[origin], origin)
}

function addForm(field: number, form: string): void {
    let list = flow.fieldForms.get(field)
    if (!list) flow.fieldForms.set(field, list = [])
    if (!list.includes(form)) list.push(form)
}

function heldStatic(init: Function): number {
    const id = instance(init, 0, -1, -1)
    flow.heldStatics.add(id)
    return id
}

function readField(field: number, target: number): void {
    const init = flow.heldInits.get(field)
    if (init) {
        flow.heldInits.delete(field)
        copyEdge(flow.instances[heldStatic(init)].ret, field)
    }
    copyEdge(field, target)
    let list = flow.fieldReaders.get(field)
    if (!list) flow.fieldReaders.set(field, list = [])
    list.push(ownerSlot(target))
}

export function writeField(field: number, value: number, writer: number, form: string, stored: boolean): void {
    copyEdge(value, field)
    addForm(field, form)
    if (stored) flow.fieldStored.add(field)
    let list = flow.fieldWriters.get(field)
    if (!list) flow.fieldWriters.set(field, list = [])
    if (!list.includes(writer)) list.push(writer)
}

function created(origin: number, inst: Instance): number {
    const owner = inst.site ?? inst
    let list = flow.originCreators.get(origin)
    if (!list) flow.originCreators.set(origin, list = [])
    if (list.includes(owner.id)) return origin
    list.push(owner.id)
    const seeds = flow.originSeeds.get(origin)
    if (seeds) for (let i = 0; i < seeds.length; i += 2) copyEdge(at(owner, seeds[i + 1]), seeds[i])
    return origin
}

function heapValue(value: Handle, s: number, qual: number, owner: Summary | undefined, seeded: number): void {
    if (!value) return addConst(s, UNDEF)
    if (value === 1) return addConst(s, literalScalar(1))
    const init = flow.host.session.statics.get(value)
    if (init && flow.host.traceable(init)) {
        if (flow.slotKind[s] === SlotKind.field && !flow.fieldReaders.has(s)) {
            flow.heldInits.set(s, init)
            return
        }
        return copyEdge(flow.instances[heldStatic(init)].ret, s)
    }
    if (heap.isBoxedF64(value)) {
        const id = heap.boxedNanId(value)
        if (!id) return addConst(s, literalScalar(heap.unboxF64(value)))
        const e = owner?.exprOf.get(id)
        if (e !== undefined && seeded > 0) {
            let seeds = flow.originSeeds.get(seeded)
            if (!seeds) flow.originSeeds.set(seeded, seeds = [])
            seeds.push(s, e)
            for (const c of flow.originCreators.get(seeded) ?? []) copyEdge(at(flow.instances[c], e), s)
            return
        }
        return addConst(s, UNKNOWN)
    }
    if (heap.isString(value)) {
        addConst(s, strScalar(value))
        return addOrigin(s, strOrigin())
    }
    const cell = flow.host.session.runtime!.objects.intern(flow.host.heapValue ? flow.host.heapValue(value) : value) as number
    if (opaqueHandle(cell)) return addConst(s, UNKNOWN)
    const own = flow.freshOwner.get(cell)
    if (own) return addOrigin(s, own === owner ? qualified(OriginKind.fresh, cell, qual, 0, own) : originOf(OriginKind.fresh, cell, 0, 0, own))
    const origin = staticOrigin(cell)
    addOrigin(s, origin)
}


function opaqueHandle(cell: number): boolean {
    if (heap.isFrameProxy(cell as Handle) || flow.host.functionOf(cell as u32)) return false
    const inner = heap.deref(cell as Handle)
    return !inner || !heap.isOrdinaryObject(inner)
}

export function summaryOf(fn: Function): Summary {
    const known = flow.summaries.get(fn)
    if (known) return known
    const traceStart = performance.now()
    const g = flow.host.graphOf(fn)
    flow.traceMs += performance.now() - traceStart
    const cells = flow.host.freshCells!(fn)
    const fresh = new Set<number>()
    for (const c of cells.allocations) fresh.add(c)
    for (const c of cells.closures) fresh.add(c)
    for (const c of cells.frames) fresh.add(c)
    const s: Summary = {
        fn, id: flow.summaryList.length + 1, g, name: fn.name || '<anon>', exprs: [], exprOf: new Map(), konsts: new Map(), origins: new Map(),
        params: 0, hasThis: false, usesCtx: false, rets: [], fresh, scopes: new Set(cells.frames), returnsFresh: false, returnsSlice: false,
        local: undefined, width: 0, owned: [], order: undefined, regions: undefined, stores: [], cone: undefined, allocNodes: new Map(), retExpr: -1, selects: [], blockGates: [], regionRets: new Map(),
    }
    flow.summaries.set(fn, s)
    flow.summaryList.push(s)
    for (const cell of fresh) flow.freshOwner.set(cell, s)
    flow.totalNodes += g.nodes.size
    flow.budget = budgetFactor * flow.totalNodes
    buildSummary(s)
    return s
}

export function expr(s: Summary, op: ExprOp, node: number, a: number, b: number, key: number, args: number[], sub: number): number {
    const id = s.exprs.length
    const type = node > 0 && op !== ExprOp.konst && op !== ExprOp.origin && op !== ExprOp.param && op !== ExprOp.union ? nodeType(s.g, node) : -1
    s.exprs.push({ op, node, a, b, key, args, sub, type, gates: undefined })
    return id
}

function nodeType(g: Graph, id: number): number {
    const n = getNode(g, id)
    if (!n || n.op === NodeOp.param || n.op === NodeOp.after || n.op === NodeOp.select || n.op === NodeOp.inlined) return -1
    if (n.op === NodeOp.rt && getLiteral(g, n, 1) === RtOp.sliceWrite) return elementType(g, n)
    if (n.op === NodeOp.store) return typeOf(n)
    const T0 = resultType(g, n)
    if (BitwiseOps.has(n.op) && (T0 === Types.f64 || T0 === Types.f32)) return Types.i64
    if (T0 === Types.u64 && n.op !== NodeOp.load && n.op !== NodeOp.convert && n.op !== NodeOp.bitconvert && !NumericOps.has(n.op)) return -1
    return T0
}

function opaqueScalar(s: Summary, x: Expr): number {
    const n = x.node ? getNode(s.g, x.node) : undefined
    if (!n) return UNKNOWN
    const T0 = resultType(s.g, n)
    if (T0 === Types.vm_value || T0 === Types.unknown || T0 === Types.void) return UNKNOWN
    return typeRange(T0)
}

function withoutUnknown(t: number): number {
    const f = scalars.flags[t]
    return scalar(f & ~ScalarFlag.unknown, scalars.lo[t], scalars.hi[t], scalars.strs[t], scalars.nums[t])
}

function withoutNumbers(t: number): number {
    const f = scalars.flags[t]
    return scalar(f & ~(ScalarFlag.int | ScalarFlag.float), 0, 0, scalars.strs[t])
}

function typedScalar(t: number, T0: number): number {
    if (T0 < 0 || t === NONE) return t
    const f = scalars.flags[t]
    if (T0 === Types.unknown_number) return f & ScalarFlag.unknown ? unite(withoutUnknown(t), FLOAT) : t
    if (T0 === Types.u64 || T0 === Types.usize || T0 === Types.ptr) return f & ScalarFlag.unknown ? unite(withoutUnknown(t), typeRange(T0)) : t
    if (T0 === Types.vm_value || T0 === Types.fnptr || T0 === Types.void || T0 === Types.unknown || T0 === Types.handle) return t
    const bound = typeRange(T0)
    let out = f & ScalarFlag.unknown ? unite(withoutUnknown(t), bound) : t
    const g = scalars.flags[out]
    if (!(g & (ScalarFlag.int | ScalarFlag.float))) return out
    if (bound === FLOAT) return g & ScalarFlag.int ? unite(withoutNumbers(out), FLOAT) : out
    if (g & ScalarFlag.float || scalars.lo[out] < scalars.lo[bound] || scalars.hi[out] > scalars.hi[bound]) out = unite(withoutNumbers(out), bound)
    return out
}

function konst(s: Summary, t: number): number {
    const known = s.konsts.get(t)
    if (known !== undefined) return known
    const id = expr(s, ExprOp.konst, 0, t, 0, 0, [], 0)
    s.konsts.set(t, id)
    return id
}

function originExpr(s: Summary, origin: number): number {
    const known = s.origins.get(origin)
    if (known !== undefined) return known
    const id = expr(s, ExprOp.origin, 0, origin, 0, 0, [], 0)
    s.origins.set(origin, id)
    return id
}

function operand(s: Summary, user: number, n: GraphNode, i: number): number {
    const ref = getRef(n, i)
    if (!ref) return konst(s, literalScalar(getLiteral(s.g, n, i)))
    const base = exprOfNode(s, ref)
    const region = s.regions ? useRegion(s.regions, user, n, i) : -1
    return region < 0 ? base : narrowed(s, ref, base, region)
}

const arithOps = new Set<NodeOp>([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.subsat, NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.neg, NodeOp.not, NodeOp.clz])
const compareOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne])
const numberOps = new Set<NodeOp>([NodeOp.load, NodeOp.convert, NodeOp.bitconvert, NodeOp.pstack, NodeOp.stackalloc, NodeOp.mem, NodeOp.crc32, NodeOp.frameAddress, NodeOp.pc, NodeOp.poolEntry])
const neverOps = new Set<NodeOp>([NodeOp.ret, NodeOp.apply, NodeOp.panic, NodeOp.trap, NodeOp.unreachable, NodeOp.nilEffect, NodeOp.block, NodeOp.store, NodeOp.stackfree])

function exprOfNode(s: Summary, id: number): number {
    const known = s.exprOf.get(id)
    if (known !== undefined) return known
    const g = s.g
    const n = getNode(g, id)
    if (!n) return konst(s, UNKNOWN)
    charge(1)
    let e = -1
    const op = n.op
    if (op === NodeOp.after) {
        e = operand(s, id, n, countIds(n) - 1)
    } else if (op === NodeOp.param) {
        e = expr(s, ExprOp.union, id, 0, 0, 0, [], 0)
    } else if (op === NodeOp.heapHandle) {
        const cell = getLiteral(g, n, 0)
        if (!cell) e = konst(s, UNDEF)
        else if (heap.isString(cell as Handle)) e = expr(s, ExprOp.konst, id, strScalar(cell), 0, 0, [], strOrigin())
        else if (s.fresh.has(cell)) {
            e = expr(s, ExprOp.alloc, id, cell, 0, 0, [], 0)
            if (!s.allocNodes.has(cell)) s.allocNodes.set(cell, id)
        } else if (opaqueHandle(cell)) {
            e = konst(s, UNKNOWN)
        } else {
            const origin = staticOrigin(cell)
            intrinsics.assert(id < 16777216, `value-flow: node ${id} of ${s.name} does not fit a seen-site key`)
            if (!flow.originSeen[origin]) flow.originSeen[origin] = s.id * 16777216 + id
            e = originExpr(s, origin)
        }
    } else if (op === NodeOp.localTarget) {
        const fn = flow.host.localFunction(getLiteral(g, n, 0))
        e = fn && flow.host.traceable(fn) ? originExpr(s, fnOrigin(fn)) : expr(s, ExprOp.opaque, id, 0, 0, 0, [], 0)
    } else if (op === NodeOp.callContext) {
        s.usesCtx = true
        e = expr(s, ExprOp.param, id, -2, 0, 0, [], 0)
    } else if (op === NodeOp.getProp) {
        const obj = operand(s, id, n, 1)
        const keyRef = getRef(n, 2)
        e = keyRef ? expr(s, ExprOp.member, id, obj, exprOfNode(s, keyRef), dynKey, [], 0) : expr(s, ExprOp.member, id, obj, 0, getLiteral(g, n, 2), [], 0)
    } else if (op === NodeOp.setProp) {
        const obj = operand(s, id, n, 1)
        const keyRef = getRef(n, 2)
        const value = operand(s, id, n, 3)
        e = keyRef ? expr(s, ExprOp.store, id, obj, value, dynKey, [exprOfNode(s, keyRef)], 0) : expr(s, ExprOp.store, id, obj, value, getLiteral(g, n, 2), [], 0)
    } else if (op === NodeOp.call) {
        const target = getRef(n, 1) ? operand(s, id, n, 1) : -1
        const recv = getRef(n, 2) ? operand(s, id, n, 2) : konst(s, UNDEF)
        const args: number[] = []
        for (let i = 3; i < countIds(n); i++) args.push(operand(s, id, n, i))
        const opaque = target < 0 || s.exprs[target].op === ExprOp.opaque || s.exprs[target].op === ExprOp.konst || s.exprs[target].op === ExprOp.num
        e = opaque ? expr(s, ExprOp.opaque, id, 0, 0, 0, args, 0) : expr(s, ExprOp.call, id, target, recv, 0, args, 0)
    } else if (op === NodeOp.static) {
        const target = operand(s, id, n, 0)
        const opaque = s.exprs[target].op !== ExprOp.origin
        e = opaque ? expr(s, ExprOp.opaque, id, 0, 0, 0, [], 0) : expr(s, ExprOp.call, id, target, konst(s, UNDEF), 0, [], 0)
    } else if (op === NodeOp.select) {
        e = expr(s, ExprOp.union, id, 0, 0, 0, [operand(s, id, n, 1), operand(s, id, n, 2)], 0)
        s.selects.push(e)
    } else if (op === NodeOp.inlined) {
        e = expr(s, ExprOp.union, id, 0, 0, 0, [operand(s, id, n, 0)], 0)
        s.exprs[e].gates = [-1]
    } else if (op === NodeOp.typeof) {
        e = expr(s, ExprOp.ntype, id, operand(s, id, n, 0), 0, 0, [], 0)
    } else if (op === NodeOp.void) {
        e = konst(s, NONE)
    } else if (arithOps.has(op)) {
        const a = operand(s, id, n, 0)
        const b = countIds(n) > 1 ? operand(s, id, n, 1) : konst(s, literalScalar(0))
        e = expr(s, ExprOp.arith, id, a, b, op, [], typeOf(n))
    } else if (compareOps.has(op)) {
        e = expr(s, ExprOp.cmp, id, operand(s, id, n, 0), operand(s, id, n, 1), op, [], 0)
    } else if (op === NodeOp.literal) {
        e = konst(s, typeOf(n) === Types.f64 ? FLOAT : literalScalar(getLiteral(g, n, 0)))
    } else if (op === NodeOp.pstack && (getRef(n, 3) || getLiteral(g, n, 3) > 0)) {
        e = expr(s, ExprOp.rt, id, RtOp.slice, 0, 0, [], 0)
    } else if (op === NodeOp.store) {
        e = expr(s, ExprOp.rt, id, RtOp.sliceWrite, 0, 0, [operand(s, id, n, 1), operand(s, id, n, 2), operand(s, id, n, 3)], 0)
    } else if (numberOps.has(op)) {
        const T0 = typeOf(n)
        e = expr(s, ExprOp.num, id, T0 === Types.vm_value || T0 === Types.unknown ? UNKNOWN : typeRange(T0), 0, 0, [], 0)
    } else if (op === NodeOp.rt) {
        const args: number[] = []
        for (let i = 2; i < countIds(n); i++) args.push(operand(s, id, n, i))
        e = expr(s, ExprOp.rt, id, getLiteral(g, n, 1), 0, 0, args, 0)
    } else if (neverOps.has(op)) {
        e = konst(s, NONE)
    } else {
        e = expr(s, ExprOp.opaque, id, 0, 0, 0, [], 0)
    }
    s.exprOf.set(id, e)
    return e
}

export enum GuardFlag {
    truthy = 1,
    falsy = 2,
    nullish = 4,
    defined = 8,
    isNumber = 16,
    isString = 32,
    isObject = 64,
    isFunction = 128,
    isUndefined = 256,
    notNumber = 512,
    notString = 1024,
    notObject = 2048,
    notFunction = 4096,
    notUndefined = 8192,
    bounded = 16384,
    nonzero = 32768,
}

function computeRegions(s: Summary): Regions {
    const g = s.g
    const regions: Regions = { of: new Map(), block: new Map(), shared: new Set(), parent: [], depth: [], cond: [], arm: [], children: new Map(), roots: [], link: [], tested: new Set(), paramBlock: new Map(), entries: [], narrows: new Map(), guards: new Map(), narrowExprs: new Map(), gateOf: new Map() }
    for (let b = 0; b < s.g.blocks.length; b++) regions.entries.push([])
    const selects: number[] = []
    const indexOf = new Map<number, number>()
    for (let b = 0; b < g.blocks.length; b++) {
        indexOf.set(g.blocks[b].id, b)
        for (const p of g.blocks[b].params) regions.paramBlock.set(p, b)
    }
    const exits: number[][] = []
    const preds = new Uint32Array(g.blocks.length)
    const orders: number[][] = []
    for (let b = 0; b < g.blocks.length; b++) {
        const block = g.blocks[b]
        const order: number[] = []
        orders.push(order)
        if (!block.bodyId) continue
        const stack: number[] = [block.bodyId]
        const next: number[] = [0]
        if (regions.block.has(block.bodyId)) {
            regions.shared.add(block.bodyId)
            continue
        }
        regions.block.set(block.bodyId, b)
        while (stack.length) {
            const id = stack[stack.length - 1]
            const n = getNode(g, id)
            const at = next[next.length - 1]
            if (n && at < countIds(n)) {
                next[next.length - 1] = at + 1
                const ref = getRef(n, at)
                if (!ref) continue
                const m = getNode(g, ref)
                if (!m || m.op === NodeOp.block) continue
                const known = regions.block.get(ref)
                if (known !== undefined) {
                    if (known !== b) regions.shared.add(ref)
                    continue
                }
                charge(1)
                regions.block.set(ref, b)
                stack.push(ref)
                next.push(0)
                continue
            }
            stack.pop()
            next.pop()
            order.push(id)
        }
    }
    for (let b = 0; b < g.blocks.length; b++) {
        const root = regions.parent.length
        regions.parent.push(-1)
        regions.depth.push(0)
        regions.cond.push(0)
        regions.arm.push(0)
        regions.link.push(-1)
        regions.roots.push(root)
        const order = orders[b]
        const out: number[] = []
        exits.push(out)
        for (let k = order.length - 1; k >= 0; k--) {
            const id = order[k]
            if (!regions.of.has(id) || regions.shared.has(id)) regions.of.set(id, root)
            const n = getNode(g, id)!
            const ru = regions.of.get(id)!
            if (n.op === NodeOp.select) selects.push(id)
            if (n.op === NodeOp.apply) {
                const target = indexOf.get(getRef(n, 0))
                if (target !== undefined) {
                    preds[target]++
                    out.push(target)
                    out.push(ru)
                    regions.entries[target].push(id, ru)
                }
            }
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref || regions.block.get(ref) !== b || regions.shared.has(ref)) continue
                const contribution = n.op === NodeOp.select && (i === 1 || i === 2) ? childRegion(regions, ru, id, i) : ru
                const known = regions.of.get(ref)
                regions.of.set(ref, known === undefined ? contribution : lca(regions, known, contribution))
            }
        }
    }
    const nb = g.blocks.length
    const order: number[] = []
    const rpo = new Int32Array(nb).fill(-1)
    const visited = new Uint8Array(nb)
    const stack: number[] = [0]
    const edge: number[] = [0]
    visited[0] = 1
    while (stack.length) {
        const b = stack[stack.length - 1]
        const k = edge[edge.length - 1]
        if (k < exits[b].length) {
            edge[edge.length - 1] = k + 2
            const t = exits[b][k]
            if (visited[t]) continue
            visited[t] = 1
            stack.push(t)
            edge.push(0)
            continue
        }
        stack.pop()
        edge.pop()
        order.push(b)
    }
    order.reverse()
    for (let i = 0; i < order.length; i++) rpo[order[i]] = i
    const predLists: number[][] = []
    for (let b = 0; b < nb; b++) predLists.push([])
    for (const b of order) {
        for (let k = 0; k < exits[b].length; k += 2) predLists[exits[b][k]].push(b)
    }
    const idom = new Int32Array(nb).fill(-1)
    idom[0] = 0
    let changed = true
    while (changed) {
        changed = false
        for (let i = 1; i < order.length; i++) {
            const b = order[i]
            let d = -1
            for (const p of predLists[b]) {
                charge(1)
                if (idom[p] < 0) continue
                if (d < 0) {
                    d = p
                    continue
                }
                let x = p
                let y = d
                while (x !== y) {
                    while (rpo[x] > rpo[y]) x = idom[x]
                    while (rpo[y] > rpo[x]) y = idom[y]
                }
                d = x
            }
            if (d >= 0 && idom[b] !== d) {
                idom[b] = d
                changed = true
            }
        }
    }
    for (let i = 1; i < order.length; i++) {
        const b = order[i]
        const d = idom[b]
        if (d < 0) continue
        let region = -1
        let backOnly = true
        for (const p of predLists[b]) {
            charge(1)
            if (p !== d && rpo[p] < rpo[b]) backOnly = false
        }
        if (backOnly) {
            const out = exits[d]
            for (let k = 0; k < out.length; k += 2) {
                if (out[k] !== b) continue
                region = region < 0 ? out[k + 1] : lca(regions, region, out[k + 1])
            }
        }
        regions.link[regions.roots[b]] = region >= 0 ? region : regions.roots[d]
    }
    const global = new Map<number, number>()
    const gdepth: number[] = []
    for (let b = nb - 1; b >= 0; b--) {
        const block = g.blocks[b]
        if (block.bodyId && !global.has(block.bodyId)) global.set(block.bodyId, regions.roots[b])
        const order = orders[b]
        for (let k = order.length - 1; k >= 0; k--) {
            const id = order[k]
            const ru = global.get(id)
            if (ru === undefined) continue
            charge(1)
            const n = getNode(g, id)!
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref || !regions.block.has(ref)) continue
                const contribution = n.op === NodeOp.select && (i === 1 || i === 2) ? childRegion(regions, ru, id, i) : ru
                const known = global.get(ref)
                global.set(ref, known === undefined ? contribution : globalLca(regions, gdepth, known, contribution))
            }
        }
    }
    regions.of = global
    const seenConds = new Set<number>()
    for (const id of selects) testedRefs(s, regions, getRef(getNode(g, id)!, 0), seenConds)
    return regions
}

function testedRefs(s: Summary, regions: Regions, cond: number, seen: Set<number>): void {
    const g = s.g
    const out = regions.tested
    const [id] = condition(g, cond, true)
    const n = id ? getNode(g, id) : undefined
    if (!n || seen.has(id)) return
    seen.add(id)
    charge(1)
    out.add(id)
    if (n.op === NodeOp.getProp) {
        if (getRef(n, 1)) out.add(getRef(n, 1))
        return
    }
    if (n.op === NodeOp.call) {
        for (let i = 3; i < countIds(n); i++) {
            const r = getRef(n, i)
            if (!r) continue
            out.add(r)
        }
        return
    }
    if (!compareOps.has(n.op)) return
    for (let i = 0; i < 2; i++) {
        const r = getRef(n, i)
        if (!r) continue
        out.add(r)
        const m = getNode(g, r)
        if (m?.op === NodeOp.rt && getRef(m, 2)) out.add(getRef(m, 2))
    }
}

export function childRegion(regions: Regions, parent: number, select: number, arm: number): number {
    intrinsics.assert(select < 16777216, `value-flow: select ${select} does not fit a region key`)
    const key = (parent * 16777216 + select) * 4 + arm
    const known = regions.children.get(key)
    if (known !== undefined) return known
    const id = regions.parent.length
    regions.parent.push(parent)
    regions.depth.push(regions.depth[parent] + 1)
    regions.cond.push(select)
    regions.arm.push(arm)
    regions.link.push(-1)
    regions.children.set(key, id)
    return id
}

export function regionUp(regions: Regions, r: number): number {
    return regions.depth[r] > 0 ? regions.parent[r] : regions.link[r]
}

function globalDepth(regions: Regions, memo: number[], r: number): number {
    const path: number[] = []
    let at = r
    while (at >= 0 && memo[at] === undefined) {
        path.push(at)
        at = regionUp(regions, at)
    }
    let d = at >= 0 ? memo[at] : -1
    for (let i = path.length - 1; i >= 0; i--) {
        d++
        memo[path[i]] = d
    }
    return memo[r]
}

function globalLca(regions: Regions, memo: number[], a: number, b: number): number {
    let da = globalDepth(regions, memo, a)
    let db = globalDepth(regions, memo, b)
    while (da > db) {
        a = regionUp(regions, a)
        da--
    }
    while (db > da) {
        b = regionUp(regions, b)
        db--
    }
    while (a !== b) {
        a = regionUp(regions, a)
        b = regionUp(regions, b)
        if (a < 0 || b < 0) return regions.roots[0]
    }
    return a
}

function lca(regions: Regions, a: number, b: number): number {
    while (regions.depth[a] > regions.depth[b]) a = regions.parent[a]
    while (regions.depth[b] > regions.depth[a]) b = regions.parent[b]
    while (a !== b) {
        a = regions.parent[a]
        b = regions.parent[b]
    }
    return a
}

function useRegion(regions: Regions, user: number, n: GraphNode, i: number): number {
    const ru = regions.of.get(user)
    if (ru === undefined) return -1
    if (n.op === NodeOp.select && (i === 1 || i === 2)) return childRegion(regions, ru, user, i)
    return ru
}

export interface Guard {
    flags: number
    lo: number
    hi: number
    picks: number[]
}

export const noGuard: Guard = { flags: 0, lo: MinI64, hi: MaxU64, picks: [] }
const deadGuard: Guard = { flags: GuardFlag.truthy | GuardFlag.falsy | GuardFlag.nullish, lo: MinI64, hi: MaxU64, picks: [] }

function narrowed(s: Summary, ref: number, base: number, use: number): number {
    const regions = s.regions!
    if (regions.depth[use] === 0 && regions.link[use] < 0) return base
    if (!regions.tested.has(ref)) return base
    let byRegion = regions.narrows.get(ref)
    if (!byRegion) regions.narrows.set(ref, byRegion = new Map())
    const known = byRegion.get(use)
    if (known !== undefined) return known
    const guard = guardAt(s, ref, use)
    let byGuard = regions.narrowExprs.get(ref)
    if (!byGuard) regions.narrowExprs.set(ref, byGuard = new Map())
    let e = byGuard.get(guard)
    if (e === undefined) {
        e = guard.flags ? expr(s, ExprOp.narrow, 0, base, guard.lo, guard.flags, [base], guard.hi) : base
        for (const pick of guard.picks) e = expr(s, ExprOp.pick, 0, e, pick & 1, pick >> 1, [e], 0)
        byGuard.set(guard, e)
    }
    byRegion.set(use, e)
    return e
}

function guardAt(s: Summary, ref: number, use: number): Guard {
    const regions = s.regions!
    let guards = regions.guards.get(ref)
    if (!guards) regions.guards.set(ref, guards = new Map())
    const owner = regions.paramBlock.get(ref)
    const home = owner !== undefined ? (owner === 0 ? -1 : regions.roots[owner]) : regions.shared.has(ref) ? -1 : regions.of.get(ref) ?? -1
    const path: number[] = []
    let at = use
    while (at >= 0 && at !== home && !guards.has(at)) {
        path.push(at)
        at = regionUp(regions, at)
    }
    let guard = at >= 0 && at !== home ? guards.get(at)! : noGuard
    for (let i = path.length - 1; i >= 0; i--) {
        const r = path[i]
        charge(1)
        if (regions.depth[r] > 0) guard = meetGuard(guard, guardOn(s, getRef(getNode(s.g, regions.cond[r])!, 0), ref, regions.arm[r] === 1))
        guards.set(r, guard)
    }
    return guard
}

function meetGuard(a: Guard, b: Guard): Guard {
    if (b === noGuard || a === deadGuard) return a
    if (a === noGuard || b === deadGuard) return b
    const flags = a.flags | b.flags
    const lo = a.lo > b.lo ? a.lo : b.lo
    const hi = a.hi < b.hi ? a.hi : b.hi
    if (contradicts(flags) || lo > hi) return deadGuard
    const picks = a.picks.slice()
    for (const p of b.picks) {
        if (picks.includes(p ^ 1)) return deadGuard
        if (!picks.includes(p)) picks.push(p)
    }
    if (flags === a.flags && lo === a.lo && hi === a.hi && picks.length === a.picks.length) return a
    return { flags, lo, hi, picks }
}

export function condition(g: Graph, cond: number, positive: boolean): [number, boolean] {
    let id = cond
    let yes = positive
    for (;;) {
        const n = id ? getNode(g, id) : undefined
        if (!n) return [0, yes]
        if (n.op === NodeOp.after) {
            id = getRef(n, countIds(n) - 1)
            continue
        }
        if (n.op !== NodeOp.select || getRef(n, 1) || getRef(n, 2)) return [id, yes]
        const a = getLiteral(g, n, 1)
        const b = getLiteral(g, n, 2)
        if (a === 0 && b === 1) yes = !yes
        else if (!(a === 1 && b === 0)) return [0, yes]
        id = getRef(n, 0)
    }
}

function contradicts(flags: number): boolean {
    if ((flags & GuardFlag.truthy) && (flags & GuardFlag.falsy)) return true
    if ((flags & GuardFlag.nullish) && (flags & (GuardFlag.defined | GuardFlag.truthy | GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction))) return true
    return false
}

export function guardOn(s: Summary, cond: number, ref: number, yes: boolean, calls: boolean = true): Guard {
    const g = s.g
    const [id, positive] = condition(g, cond, yes)
    if (!id) return noGuard
    if (id === ref) return { flags: positive ? GuardFlag.truthy : GuardFlag.falsy, lo: MinI64, hi: MaxU64, picks: [] }
    const n = getNode(g, id)!
    if (n.op === NodeOp.getProp && !getRef(n, 2) && getRef(n, 1) === ref) return { flags: 0, lo: MinI64, hi: MaxU64, picks: [getLiteral(g, n, 2) * 2 + (positive ? 1 : 0)] }
    if (n.op === NodeOp.call) return calls ? pg.predicateGuard(s, n, ref, positive) : noGuard
    if (n.op !== NodeOp.eq && n.op !== NodeOp.ne && n.op !== NodeOp.lt && n.op !== NodeOp.le && n.op !== NodeOp.gt && n.op !== NodeOp.ge) return noGuard
    const equal = n.op === NodeOp.eq ? positive : n.op === NodeOp.ne ? !positive : positive
    const a = getRef(n, 0)
    const b = getRef(n, 1)
    const other = a === ref ? 1 : b === ref ? 0 : -1
    if (other < 0) {
        if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) return noGuard
        const side = typeofOf(s, a, ref) ? 1 : typeofOf(s, b, ref) ? 0 : -1
        if (side < 0) return noGuard
        const name = constantCell(s, getRef(n, side))
        const flag = name === heap.typeNames.number ? (equal ? GuardFlag.isNumber : GuardFlag.notNumber)
            : name === heap.typeNames.string ? (equal ? GuardFlag.isString : GuardFlag.notString)
            : name === heap.typeNames.object ? (equal ? GuardFlag.isObject : GuardFlag.notObject)
            : name === heap.typeNames.function ? (equal ? GuardFlag.isFunction : GuardFlag.notFunction)
            : name === heap.typeNames.undefined ? (equal ? GuardFlag.isUndefined : GuardFlag.notUndefined) : 0
        return { flags: flag, lo: MinI64, hi: MaxU64, picks: [] }
    }
    const otherRef = getRef(n, other)
    if (n.op === NodeOp.eq || n.op === NodeOp.ne) {
        if (otherRef && constantCell(s, otherRef) === 0) return { flags: equal ? GuardFlag.nullish : GuardFlag.defined, lo: MinI64, hi: MaxU64, picks: [] }
        if (otherRef) return noGuard
        const v = getLiteral(g, n, other)
        if (equal) return { flags: GuardFlag.bounded, lo: v, hi: v, picks: [] }
        if (v === 0) return { flags: GuardFlag.nonzero, lo: MinI64, hi: MaxU64, picks: [] }
        return noGuard
    }
    if (otherRef) return noGuard
    const v = getLiteral(g, n, other)
    const refLeft = other === 1
    let op = n.op
    if (!positive) op = op === NodeOp.lt ? NodeOp.ge : op === NodeOp.le ? NodeOp.gt : op === NodeOp.gt ? NodeOp.le : NodeOp.lt
    if (!refLeft) op = op === NodeOp.lt ? NodeOp.gt : op === NodeOp.le ? NodeOp.ge : op === NodeOp.gt ? NodeOp.lt : NodeOp.le
    if (op === NodeOp.lt) return { flags: GuardFlag.bounded, lo: MinI64, hi: Math.ceil(v) - 1, picks: [] }
    if (op === NodeOp.le) return { flags: GuardFlag.bounded, lo: MinI64, hi: Math.floor(v), picks: [] }
    if (op === NodeOp.gt) return { flags: GuardFlag.bounded, lo: Math.floor(v) + 1, hi: MaxU64, picks: [] }
    return { flags: GuardFlag.bounded, lo: Math.ceil(v), hi: MaxU64, picks: [] }
}

function typeofOf(s: Summary, id: number, ref: number): boolean {
    const n = id ? getNode(s.g, id) : undefined
    return n?.op === NodeOp.rt && getLiteral(s.g, n, 1) === RtOp.typeof && getRef(n, 2) === ref
}

function constantCell(s: Summary, id: number): number {
    let n = getNode(s.g, id)
    while (n?.op === NodeOp.after) n = getNode(s.g, getRef(n, countIds(n) - 1))
    return n?.op === NodeOp.heapHandle && !getRef(n, 0) ? getLiteral(s.g, n, 0) : -1
}

function buildSummary(s: Summary): void {
    const g = s.g
    s.regions = computeRegions(s)
    const params = g.blocks[0].params
    let declared = 0
    for (let i = 0; i < params.length; i++) {
        const p = getNode(g, params[i])!
        if (isThisParam(p)) {
            s.hasThis = true
            s.exprOf.set(params[i], expr(s, ExprOp.param, params[i], -1, 0, 0, [], 0))
            continue
        }
        s.exprOf.set(params[i], expr(s, ExprOp.param, params[i], declared, 0, 0, [], 0))
        declared++
    }
    s.params = declared
    const ids: number[] = []
    for (const id of g.nodes.keys()) ids.push(id)
    ids.sort((a, b) => a - b)
    s.regionRets = regionRets(g)
    const retArgs: number[] = []
    const gated: number[] = []
    for (const id of ids) {
        const n = getNode(g, id)!
        if (n.op === NodeOp.ret) {
            const value = operand(s, id, n, 0)
            const region = s.regionRets.get(id)
            if (region !== undefined) {
                const u = exprOfNode(s, region)
                s.exprs[u].args.push(value)
                gated.push(u, s.exprs[u].args.length - 1, id)
                continue
            }
            s.rets.push(value)
            retArgs.push(value)
            continue
        }
        if (n.op === NodeOp.apply) {
            const block = g.blockIndex.get(getRef(n, 0))
            if (!block) continue
            for (let j = 0; j < block.params.length; j++) {
                const merge = exprOfNode(s, block.params[j])
                s.exprs[merge].args.push(operand(s, id, n, j + 1))
                gated.push(merge, s.exprs[merge].args.length - 1, id)
            }
            continue
        }
        exprOfNode(s, id)
    }
    if (retArgs.length) {
        s.retExpr = expr(s, ExprOp.union, 0, 0, 0, 0, retArgs, 0)
        const gates: number[] = []
        let k = 0
        for (const id of ids) if (getNode(g, id)!.op === NodeOp.ret && !s.regionRets.has(id)) gates[k++] = nodeGate(s, id)
        s.exprs[s.retExpr].gates = gates
    }
    for (let i = 0; i < gated.length; i += 3) {
        const x = s.exprs[gated[i]]
        if (!x.gates) x.gates = []
        while (x.gates.length < gated[i + 1]) x.gates.push(-1)
        x.gates[gated[i + 1]] = nodeGate(s, gated[i + 2])
    }
    const regions = s.regions!
    for (const e of s.selects) {
        const x = s.exprs[e]
        const ru = regions.of.get(x.node)
        if (ru !== undefined) x.gates = [regionGate(s, childRegion(regions, ru, x.node, 1)), regionGate(s, childRegion(regions, ru, x.node, 2))]
    }
    const count = s.exprs.length
    for (let e = 0; e < count; e++) {
        const x = s.exprs[e]
        if ((x.op !== ExprOp.call && x.op !== ExprOp.rt && x.op !== ExprOp.store && x.op !== ExprOp.alloc) || !x.node) continue
        const gate = nodeGate(s, x.node)
        if (gate >= 0) x.gates = [gate]
    }
    for (let b = 0; b < g.blocks.length; b++) {
        const gates: number[] = []
        const entries = regions.entries[b]
        for (let k = 0; k < entries.length; k += 2) gates.push(nodeGate(s, entries[k]))
        s.blockGates.push(gates)
    }
    if (retArgs.length) pg.summarizeBounds(s, ids, retArgs)
    s.returnsSlice = freshReturn(s, true)
    s.returnsFresh = freshReturn(s, false)
}

function nodeGate(s: Summary, id: number): number {
    const regions = s.regions
    const r = regions ? regions.of.get(id) : undefined
    return r === undefined ? -1 : regionGate(s, r)
}

function regionGate(s: Summary, r: number): number {
    const regions = s.regions!
    const known = regions.gateOf.get(r)
    if (known !== undefined) return known
    let gate = -1
    if (regions.depth[r] > 0) {
        const select = getNode(s.g, regions.cond[r])!
        const cond = getRef(select, 0)
        const parent = regionGate(s, regions.parent[r])
        if (cond) gate = expr(s, ExprOp.gate, 0, parent, exprOfNode(s, cond), regions.arm[r], [], 0)
        else gate = (getLiteral(s.g, select, 0) !== 0) === (regions.arm[r] === 1) ? parent : expr(s, ExprOp.konst, 0, NONE, 0, 0, [], 0)
    } else if (regions.link[r] >= 0) gate = regionGate(s, regions.link[r])
    regions.gateOf.set(r, gate)
    return gate
}

function freshCallee(origin: number): boolean {
    const fn = originFunction(origin)
    if (!fn) return false
    const callee = summaryOf(fn)
    return !callee.hasThis && callee.returnsSlice
}

function freshReturn(s: Summary, slices: boolean): boolean {
    if (!s.rets.length) return false
    const seen = new Set<number>()
    const work = s.rets.slice()
    let found = false
    while (work.length) {
        const e = work.pop()!
        if (seen.has(e)) continue
        seen.add(e)
        const x = s.exprs[e]
        if (x.op === ExprOp.rt && x.a === RtOp.slice) found = true
        else if (!slices && (x.op === ExprOp.alloc || (x.op === ExprOp.call && s.exprs[x.b].op === ExprOp.alloc))) found = true
        else if (x.op === ExprOp.call && s.exprs[x.a].op === ExprOp.origin && freshCallee(s.exprs[x.a].a)) found = true
        else if (x.op === ExprOp.union || x.op === ExprOp.narrow || x.op === ExprOp.pick) for (const a of x.args) work.push(a)
        else if (x.op === ExprOp.konst && (x.a === UNDEF || x.a === NONE)) continue
        else return false
    }
    return found
}

export function instance(fn: Function, qual: number, lit: number, litParam: number): number {
    let byQual = flow.instanceOf.get(fn)
    if (!byQual) flow.instanceOf.set(fn, byQual = new Map())
    intrinsics.assert(lit < 15, `value-flow: literal context ${lit} does not fit an instance key`)
    const memo = qual * 16 + lit + 1
    const known = byQual.get(memo)
    if (known !== undefined) return known
    const s = summaryOf(fn)
    const id = flow.instances.length
    layout(s)
    const base = flow.slotKind.length
    for (const e of s.owned) newSlot(SlotKind.expr, id, e)
    const sigs: number[] = []
    const pinned = s.hasThis && qual > 0 && flow.originKind[qual] !== OriginKind.str ? paramOffset(s, -1) : -1
    for (let i = 0; i < sigWidth(s); i++) sigs.push(i === pinned ? originSlot(qual) : newSlot(SlotKind.sig, id, i))
    const inst: Instance = { id, summary: s, qual, base, sigs, ret: -1, callers: [], lit, litParam, site: undefined, map: undefined }
    inst.ret = s.retExpr >= 0 ? at(inst, s.retExpr) : newSlot(SlotKind.ret, id, 0)
    flow.instances.push(inst)
    byQual.set(memo, id)
    for (const e of s.owned) exprUses(at(inst, e))
    for (const e of s.owned) watchString(inst, e)
    wire(inst)
    return id
}

export function paramSlot(inst: Instance, index: number): number {
    return inst.sigs[paramOffset(inst.summary, index)]
}

function thisPinned(inst: Instance): boolean {
    return inst.summary.hasThis && flow.slotKind[paramSlot(inst, -1)] === SlotKind.konst
}

function paramOffset(s: Summary, index: number): number {
    if (index === -1) return s.params
    if (index === -2) return s.params + (s.hasThis ? 1 : 0)
    return index
}

function sigWidth(s: Summary): number {
    return s.params + (s.hasThis ? 1 : 0) + (s.usesCtx ? 1 : 0)
}


function layout(s: Summary): Int32Array {
    if (s.local) return s.local
    const n = s.exprs.length
    const local = new Int32Array(n)
    let width = 0
    for (let e = 0; e < n; e++) {
        const x = s.exprs[e]
        if (x.op === ExprOp.store || (x.op === ExprOp.rt && x.a === RtOp.sliceWrite)) {
            local[e] = -nothingSlot() - 1
            s.stores.push(e)
        } else if (x.op === ExprOp.konst || x.op === ExprOp.num) local[e] = -constSlot(x.a, x.op === ExprOp.konst ? x.sub : 0) - 1
        else if (x.op === ExprOp.origin) local[e] = -originSlot(x.a) - 1
        else if (x.op !== ExprOp.param) {
            local[e] = width++
            s.owned.push(e)
        }
    }
    for (let e = 0; e < n; e++) {
        const x = s.exprs[e]
        if (x.op === ExprOp.param) local[e] = width + paramOffset(s, x.a)
    }
    s.local = local
    s.width = width
    return local
}

export function at(inst: Instance, e: number): number {
    const s = inst.summary
    if (inst.map) {
        const own = inst.map.get(e)
        if (own !== undefined) return own
        const x = s.exprs[e]
        if (x.op === ExprOp.param && x.a >= 0) return inst.sigs[x.a]
        return at(inst.site!, e)
    }
    const local = s.local![e]
    if (local < 0) return -local - 1
    return local < s.width ? inst.base + local : inst.sigs[local - s.width]
}

function nothingSlot(): number {
    if (flow.nothing < 0) flow.nothing = newSlot(SlotKind.konst, -1, 0)
    return flow.nothing
}

function constSlot(t: number, origin: number): number {
    intrinsics.assert(origin < 4194304, `value-flow: origin ${origin} does not fit a constant-slot key`)
    const key = t * 4194304 + origin
    const known = flow.constSlots.get(key)
    if (known !== undefined) return known
    const slot = newSlot(SlotKind.konst, -1, 0)
    flow.constSlots.set(key, slot)
    addConst(slot, t)
    if (origin) addOrigin(slot, origin)
    return slot
}

function originSlot(origin: number): number {
    const known = flow.originSlots.get(origin)
    if (known !== undefined) return known
    const slot = newSlot(SlotKind.konst, -1, 0)
    flow.originSlots.set(origin, slot)
    addOrigin(slot, origin)
    return slot
}

function wire(inst: Instance): void {
    const s = inst.summary
    const local = s.local!
    charge(s.width + s.stores.length)
    for (let e = 0; e < s.exprs.length; e++) {
        if (local[e] < 0 || local[e] >= s.width) continue
        const x = s.exprs[e]
        if ((x.op === ExprOp.call || x.op === ExprOp.rt || x.op === ExprOp.alloc) && gated(inst, x, e)) continue
        wireExpr(inst, x, inst.base + local[e])
    }
    for (const e of s.stores) {
        if (!gated(inst, s.exprs[e], e)) wireStore(inst, e)
    }
}

function gated(inst: Instance, x: Expr, e: number): boolean {
    if (!x.gates || x.gates[0] < 0) return false
    const gate = at(inst, x.gates[0])
    if (flow.scalar[gate] !== NONE) return false
    let waiting = flow.gateWaits.get(gate)
    if (!waiting) flow.gateWaits.set(gate, waiting = [])
    waiting.push(inst.id, e)
    return true
}

function wireEffect(inst: Instance, e: number): void {
    const x = inst.summary.exprs[e]
    if (x.op === ExprOp.store || (x.op === ExprOp.rt && x.a === RtOp.sliceWrite)) return wireStore(inst, e)
    wireExpr(inst, x, at(inst, e))
}

function wireStore(inst: Instance, e: number): void {
    const x = inst.summary.exprs[e]
    if (x.op === ExprOp.store) listen(at(inst, x.a), ListenerKind.store, inst.id, x.key, at(inst, x.b), e)
    else listen(at(inst, x.args[0]), ListenerKind.store, inst.id, slotKey(inst, x.args[1]), at(inst, x.args[2]), e)
}

function wireExpr(inst: Instance, x: Expr, slot: number): void {
    const s = inst.summary
    switch (x.op) {
        case ExprOp.alloc: addOrigin(slot, created(qualified(OriginKind.fresh, x.a, inst.qual, 0, s), inst))
        case ExprOp.union:
            for (const a of x.args) listen(at(inst, a), ListenerKind.copy, slot, 0, 0)
        case ExprOp.narrow: listen(at(inst, x.a), ListenerKind.narrow, slot, x.key, 0)
        case ExprOp.pick: listen(at(inst, x.a), ListenerKind.pick, slot, x.key, x.b)
        case ExprOp.member:
            listen(at(inst, x.a), ListenerKind.member, slot, x.key, x.key === dynKey ? at(inst, x.b) : 0)
        case ExprOp.call:
            listen(at(inst, x.a), ListenerKind.callTarget, slot, 0, 0)
            listen(at(inst, x.b), ListenerKind.callRecv, slot, 0, 0)
        case ExprOp.opaque:
            markOpaque(slot)
        case ExprOp.rt: wireRt(inst, x, slot)
        case ExprOp.arith:
            if (x.key !== NodeOp.add && x.key !== NodeOp.sub) return
            listen(at(inst, x.a), ListenerKind.offset, slot, 0, 0)
            if (x.key === NodeOp.add) listen(at(inst, x.b), ListenerKind.offset, slot, 0, 0)
    }
}

function returnCone(s: Summary): number[] | null {
    if (s.cone !== undefined) return s.cone
    s.cone = null
    if (s.hasThis || s.usesCtx || !s.rets.length) return null
    const order: number[] = []
    const state = new Uint8Array(s.exprs.length)
    const work: number[] = []
    let params = 0
    for (const r of s.rets) work.push(r)
    while (work.length) {
        const e = work[work.length - 1]
        if (state[e] === 2) {
            work.pop()
            continue
        }
        const x = s.exprs[e]
        if (state[e] === 1) {
            state[e] = 2
            work.pop()
            order.push(e)
            continue
        }
        state[e] = 1
        charge(1)
        if (x.op === ExprOp.param || x.op === ExprOp.konst || x.op === ExprOp.origin || x.op === ExprOp.alloc) {
            if (x.op === ExprOp.param) params++
            state[e] = 2
            work.pop()
            continue
        }
        if (x.op !== ExprOp.narrow && x.op !== ExprOp.pick && x.op !== ExprOp.member && x.op !== ExprOp.union) return null
        if (x.op === ExprOp.member && x.key === dynKey) return null
        if (x.op === ExprOp.member && !state[x.a]) work.push(x.a)
        for (const a of x.args) if (!state[a]) work.push(a)
    }
    if (!params) return null
    s.cone = order
    return order
}

function siteReturn(callee: Instance, from: Instance, x: Expr, callSlot: number, into: number, cone: number[]): void {
    const s = callee.summary
    const id = flow.instances.length
    const sigs: number[] = []
    for (let i = 0; i < s.params; i++) sigs.push(i < x.args.length ? at(from, x.args[i]) : constSlot(UNDEF, 0))
    const site: Instance = { id, summary: s, qual: 0, base: 0, sigs, ret: -1, callers: [callSlot], lit: -1, litParam: -1, site: callee, map: new Map() }
    flow.instances.push(site)
    charge(cone.length)
    for (const e of cone) site.map!.set(e, newSlot(SlotKind.expr, id, e))
    for (const e of cone) exprUses(site.map!.get(e)!)
    for (const e of cone) wireExpr(site, s.exprs[e], site.map!.get(e)!)
    for (const r of s.rets) copyEdge(at(site, r), into)
}

export const pureRt = new Set<number>([RtOp.typeof, RtOp.toString, RtOp.handleof, RtOp.heapaddr, RtOp.pstackaddr, RtOp.hasPrototype, RtOp.nullish, RtOp.paramCount, RtOp.restIndex, RtOp.handleHash])

function wireRt(inst: Instance, x: Expr, slot: number): void {
    const op = x.a
    if (op === RtOp.slice) return addOrigin(slot, created(qualified(OriginKind.slice, 0, inst.qual, x.node, inst.summary), inst))
    if (op === RtOp.sliceRead) return listen(at(inst, x.args[0]), ListenerKind.member, slot, slotKey(inst, x.args[1]), 0)
    if (op === RtOp.create) {
        const made = created(qualified(OriginKind.created, 0, inst.qual, x.node, inst.summary), inst)
        const proto = inst.summary.exprs[x.args[0]]
        flow.originCell[made] = proto.op === ExprOp.origin ? flow.originCell[proto.a] : 0
        return addOrigin(slot, made)
    }
    if (op === RtOp.assign) return listen(at(inst, x.args[1]), ListenerKind.assignSource, slot, 0, slot)
    if (op === RtOp.concat || op === RtOp.toString || op === RtOp.addOrConcat) addOrigin(slot, strOrigin())
    const impl = bindingOf(op)?.impl
    if (pureRt.has(op) && (!impl || !flow.host.traceable(impl))) return
    if (!impl || !flow.host.traceable(impl)) {
        if (op !== RtOp.concat && op !== RtOp.addOrConcat) markOpaque(slot)
        return
    }
    const s = summaryOf(impl)
    if (s.returnsFresh) return bindRt(inst, x, slot, impl, qualified(OriginKind.site, 0, inst.qual, x.node, inst.summary), 0)
    if (!x.args.length) return bindRt(inst, x, slot, impl, 0, 0)
    flow.rtPending.push(slot)
    listen(at(inst, x.args[0]), ListenerKind.rtSubject, slot, 0, 0)
}

function bindPendingRt(): boolean {
    let bound = false
    const pending = flow.rtPending
    flow.rtPending = []
    for (const slot of pending) {
        const inst = instOfSlot(slot)
        const x = exprAt(slot)
        charge(1)
        if (flow.slotOrigins[at(inst, x.args[0])].some(a => flow.originKind[a] !== OriginKind.str)) continue
        bindRt(inst, x, slot, bindingOf(x.a)!.impl!, 0, 0)
        bound = true
    }
    return bound
}

function addCaller(callee: Instance, slot: number): void {
    callee.callers.push(slot)
    pg.initCallerAdded(callee, slot)
}

function bindRt(inst: Instance, x: Expr, slot: number, impl: Function, qual: number, subject: number): void {
    const lit = subject && x.args.length > 1 ? smallLiteral(inst.summary, x.args[1]) : -1
    const callee = flow.instances[instance(impl, qual, lit, lit < 0 ? -1 : 1)]
    addCaller(callee, slot)
    const params = callee.summary.params
    for (let i = 0; i < x.args.length && i < params; i++) {
        if (i === 0 && subject) {
            addOrigin(callee.sigs[0], subject)
            addIn(callee.sigs[0], -at(inst, x.args[0]) - 1)
            continue
        }
        if (i === 0 && !qual) {
            addIn(callee.sigs[0], -at(inst, x.args[0]) - 1)
            continue
        }
        copyEdge(at(inst, x.args[i]), callee.sigs[i])
    }
    for (let i = x.args.length; i < params; i++) addConst(callee.sigs[i], UNDEF)
    const part = partSlot(slot, subject)
    const from = stringRt.has(x.a) ? -1 : callee.ret
    flow.partBind.set(part, { callee: callee.id, from, kind: BindKind.rt, target: qual, recv: subject })
    if (from >= 0) copyEdge(from, part)
}

const stringRt = new Set<number>([RtOp.concat, RtOp.toString])

function stringy(slot: number): boolean {
    return (scalars.flags[flow.scalar[slot]] & (ScalarFlag.str | ScalarFlag.anyStr)) !== 0 || flow.slotOrigins[slot].some(a => flow.originKind[a] === OriginKind.str)
}

function generic(slot: number): boolean {
    return (scalars.flags[flow.scalar[slot]] & ScalarFlag.anyStr) !== 0
}

function rtOperands(inst: Instance, x: Expr): number[] {
    if (x.op === ExprOp.cmp) return [x.a, x.b]
    if (x.op === ExprOp.union) return [inst.summary.exprOf.get(getRef(getNode(inst.summary.g, x.node)!, 0))!]
    return x.args
}

function watchString(inst: Instance, e: number): void {
    const s = inst.summary
    const x = s.exprs[e]
    if (x.op === ExprOp.cmp && (x.key === NodeOp.eq || x.key === NodeOp.ne)) {
        flow.stringSite[at(inst, e)] = 1
        return
    }
    if (x.op !== ExprOp.union || !x.node || getNode(s.g, x.node)?.op !== NodeOp.select) return
    const cond = s.exprOf.get(getRef(getNode(s.g, x.node)!, 0))
    if (cond === undefined) return
    const slot = at(inst, e)
    flow.stringSite[slot] = 1
    scalarUse(at(inst, cond), slot)
}

function checkString(slot: number): void {
    const inst = instOfSlot(slot)
    const x = exprAt(slot)
    charge(1)
    if (x.op === ExprOp.cmp) {
        const a = at(inst, x.a)
        const b = at(inst, x.b)
        if (!stringy(a) || !stringy(b) || (!generic(a) && !generic(b))) return
        flow.stringSite[slot] = 0
        return bindStringRt(inst, x, slot, RtOp.strictEqual)
    }
    const cond = inst.summary.exprOf.get(getRef(getNode(inst.summary.g, x.node)!, 0))!
    if (!stringy(at(inst, cond))) return
    flow.stringSite[slot] = 0
    bindStringRt(inst, x, slot, RtOp.truthy)
}

function bindStringRt(inst: Instance, x: Expr, slot: number, op: number): void {
    if (flow.parts.get(slot)?.has(0)) return
    const impl = bindingOf(op)!.impl!
    const callee = flow.instances[instance(impl, 0, -1, -1)]
    addCaller(callee, slot)
    const args = rtOperands(inst, x)
    for (let i = 0; i < callee.summary.params; i++) {
        if (i < args.length) copyEdge(at(inst, args[i]), callee.sigs[i])
        else addConst(callee.sigs[i], UNDEF)
    }
    flow.partBind.set(partSlot(slot, 0), { callee: callee.id, from: -1, kind: BindKind.rt, target: 0, recv: 0 })
}

function deliver(l: Listener, origin: number): void {
    charge(1)
    switch (l.kind) {
        case ListenerKind.copy: addOrigin(l.target, origin)
        case ListenerKind.member: resolveMember(origin, l.key, partSlot(l.target, origin), l.extra)
        case ListenerKind.store: resolveStore(origin, l.key, flow.instances[l.target], l.e, l.extra)
        case ListenerKind.callTarget: callTarget(l.target, origin)
        case ListenerKind.callRecv: callRecv(l.target, origin)
        case ListenerKind.rtSubject: rtSubject(l.target, origin)
        case ListenerKind.assignSource: assignSource(origin, l.extra)
        case ListenerKind.assignTarget: assignTarget(l.target, origin)
        case ListenerKind.narrow: if (originPasses(origin, l.key)) addOrigin(l.target, origin)
        case ListenerKind.pick: pickOrigin(l.target, origin, l.key, l.extra)
        case ListenerKind.offset: if (flow.originKind[origin] === OriginKind.slice) addOrigin(l.target, origin)
        case ListenerKind.invariant: pg.recheckBound(origin, l.target, l.key, l.extra, l.e)
    }
}

function pickOrigin(target: number, origin: number, key: number, truthy: number): void {
    const f = flow.originFields[origin].get(key)
    if (f === undefined || !pickRejects(f, truthy)) return addOrigin(target, origin)
    let list = flow.pickWatch.get(f)
    if (!list) flow.pickWatch.set(f, list = [])
    list.push(target, origin, truthy)
}

function pickRejects(f: number, truthy: number): boolean {
    let t = flow.slotConst[f]
    const ins = flow.slotIns[f]
    if (ins) {
        for (const from of ins) {
            const slot = from >= 0 ? from : -from - 1
            if (flow.slotKind[slot] !== SlotKind.konst || flow.slotIns[slot]?.length) return false
            t = unite(t, flow.slotConst[slot])
        }
    }
    const objects = flow.slotOrigins[f].length > 0
    const fl = scalars.flags[t]
    const falsy = !objects && !(fl & ~(ScalarFlag.undef | ScalarFlag.void | ScalarFlag.int)) && (!(fl & ScalarFlag.int) || (scalars.lo[t] === 0 && scalars.hi[t] === 0))
    const truthyOnly = !(fl & ~ScalarFlag.int) && (!(fl & ScalarFlag.int) || scalars.lo[t] > 0 || scalars.hi[t] < 0) && (objects || (fl & ScalarFlag.int) !== 0)
    return truthy ? falsy && (t !== NONE || objects) : truthyOnly
}

function recheckPicks(f: number): void {
    const list = flow.pickWatch.get(f)
    if (!list) return
    let keep = 0
    for (let i = 0; i < list.length; i += 3) {
        if (pickRejects(f, list[i + 2])) {
            list[keep++] = list[i]
            list[keep++] = list[i + 1]
            list[keep++] = list[i + 2]
        } else addOrigin(list[i], list[i + 1])
    }
    list.length = keep
}

function originPasses(origin: number, flags: number): boolean {
    if (flags & (GuardFlag.nullish | GuardFlag.isNumber | GuardFlag.isUndefined)) return false
    const k = flow.originKind[origin]
    const str = k === OriginKind.str
    const fn = !str && !!originHostFn(origin)
    const obj = !str && !fn
    if ((flags & GuardFlag.falsy) && !str) return false
    if ((flags & GuardFlag.isString) && !str) return false
    if ((flags & GuardFlag.notString) && str) return false
    if ((flags & GuardFlag.isFunction) && !fn) return false
    if ((flags & GuardFlag.notFunction) && fn) return false
    if ((flags & GuardFlag.isObject) && !obj) return false
    if ((flags & GuardFlag.notObject) && obj) return false
    return true
}

function filterScalar(t: number, flags: number, lo: number, hi: number): number {
    let f = scalars.flags[t]
    if (f & ScalarFlag.unknown) return t
    let tlo = scalars.lo[t]
    let thi = scalars.hi[t]
    let strs = scalars.strs[t]
    if (flags & (GuardFlag.truthy | GuardFlag.defined | GuardFlag.notUndefined | GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.bounded)) f = f & ~(ScalarFlag.undef | ScalarFlag.void)
    if (flags & (GuardFlag.nullish | GuardFlag.isUndefined)) f = f & (ScalarFlag.undef | ScalarFlag.void)
    if (flags & (GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.notNumber)) f = f & ~(ScalarFlag.int | ScalarFlag.float)
    if (flags & (GuardFlag.isNumber | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.notString)) f = f & ~(ScalarFlag.str | ScalarFlag.anyStr)
    if (flags & GuardFlag.bounded) f = f & ~(ScalarFlag.str | ScalarFlag.anyStr)
    if ((flags & (GuardFlag.truthy | GuardFlag.nonzero)) && (f & ScalarFlag.int)) {
        if (tlo === 0 && thi === 0 && !(f & ScalarFlag.float)) f = f & ~ScalarFlag.int
        else if (tlo === 0) tlo = 1
        else if (thi === 0) thi = -1
    }
    if (flags & GuardFlag.falsy) {
        if ((f & ScalarFlag.int) && tlo <= 0 && thi >= 0) {
            tlo = 0
            thi = 0
        } else f = f & ~ScalarFlag.int
    }
    if ((flags & GuardFlag.bounded) && (f & ScalarFlag.int)) {
        if (lo > tlo) tlo = lo
        if (hi < thi) thi = hi
    }
    if ((f & ScalarFlag.int) && tlo > thi) f = f & ~ScalarFlag.int
    const nums = scalars.nums[t].filter(v => v >= tlo && v <= thi && (v !== 0 || !(flags & (GuardFlag.truthy | GuardFlag.nonzero))))
    if (scalars.nums[t].length && !nums.length) f = f & ~ScalarFlag.int
    if (!(f & (ScalarFlag.str | ScalarFlag.anyStr))) strs = []
    if (!f) return NONE
    if (nums.length === 1) return scalar(f, nums[0], nums[0], strs)
    return scalar(f, tlo, thi, strs, nums)
}

export function exprAt(slot: number): Expr {
    const owner = ownerSlot(slot)
    return flow.instances[flow.slotOwner[owner]].summary.exprs[flow.slotIndex[owner]]
}

export function instOfSlot(slot: number): Instance {
    return flow.instances[flow.slotOwner[ownerSlot(slot)]]
}

export function protoOf(origin: number): Handle {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.created) return flow.originCell[origin] ? heap.deref(flow.originCell[origin] as Handle) : 0 as Handle
    if (kind === OriginKind.str) return heap.getPrototypeOf(flow.originCell[origin] as Handle)
    if (kind === OriginKind.static || kind === OriginKind.fresh) {
        if (isScope(origin)) return 0 as Handle
        return heap.getPrototypeOf(heap.deref(flow.originCell[origin] as Handle))
    }
    return 0 as Handle
}

function smallLiteral(s: Summary, e: number): number {
    const x = s.exprs[e]
    if (x.op !== ExprOp.konst) return -1
    return constIndex(x.a)
}

function constIndex(t: number): number {
    if (scalars.flags[t] !== ScalarFlag.int || scalars.lo[t] !== scalars.hi[t]) return -1
    const v = scalars.lo[t]
    return v >= 0 && v < maxTuple ? v : -1
}

export function slotKey(inst: Instance, index: number): number {
    if (inst.lit < 0) return elemKey
    let x = inst.summary.exprs[index]
    while (x.op === ExprOp.narrow || x.op === ExprOp.pick) x = inst.summary.exprs[x.a]
    return x.op === ExprOp.param && x.a === inst.litParam ? posKey(inst.lit) : elemKey
}

function virtualCall(target: number, fnValue: Handle, recv: number, args: number[], argConsts: number[]): void {
    const fn = callableOf(flow.host.session.runtime!.objects.intern(fnValue) as number)
    if (!fn) {
        markOpaque(target)
        return
    }
    const s = summaryOf(fn)
    const index = argConsts.length && (args.length === 0 || args[0] < 0) ? constIndex(argConsts[0]) : -1
    const callee = flow.instances[instance(fn, s.hasThis ? qualOf(recv) : 0, index, index < 0 ? -1 : 0)]
    addCaller(callee, target)
    if (s.hasThis) addOrigin(paramSlot(callee, -1), recv)
    for (let i = 0; i < s.params; i++) {
        if (i < args.length && args[i] >= 0) copyEdge(args[i], callee.sigs[i])
        else if (i < argConsts.length) addConst(callee.sigs[i], argConsts[i])
        else addConst(callee.sigs[i], UNDEF)
    }
    const from = pg.refineReturn(callee, target)
    copyEdge(from, target)
    flow.partBind.set(target, { callee: callee.id, from, kind: BindKind.virtual, target: 0, recv })
}

function isIndexKey(key: number): boolean {
    return key === dynKey || (key >= 0 && heap.keyIndex(key as Handle) !== undefined)
}

function resolveMember(origin: number, key: number, target: number, keySlot: number): void {
    if (key === elemKey) return elemRead(origin, target)
    if (isPosKey(key)) {
        readField(fieldSlot(origin, key), target)
        return readField(fieldSlot(origin, elemKey), target)
    }
    const kind = flow.originKind[origin]
    if (kind === OriginKind.fn || kind === OriginKind.site || kind === OriginKind.slice) {
        addConst(target, UNDEF)
        return
    }
    const scope = isScope(origin)
    if (!scope && isIndexKey(key)) {
        const proxy = trapOf(origin)
        if (proxy) {
            const index = key === dynKey ? -1 : heap.keyIndex(key as Handle)!
            return virtualCall(target, heap.getProxyGetter(proxy), origin, [key === dynKey ? keySlot : -1], [index < 0 ? NONE : literalScalar(index)])
        }
    }
    if (key === dynKey && !scope && (kind === OriginKind.fresh || kind === OriginKind.created)) return keyedRead(origin, target)
    if (key < 0 || scope) {
        const own = fieldSlot(origin, key)
        readField(own, target)
        flow.missing.push(target, own)
        return
    }
    const state = heapState(origin)
    const ownDescriptor = state === undefined ? 0 : heap.getOwnProperty(state, key as Handle)
    if (ownDescriptor) {
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(ownDescriptor))
        if (d.flags & heap.PropFlags.has_getter) return virtualCall(target, d.slot0 as Handle, origin, [], [])
        return readField(fieldSlot(origin, key), target)
    }
    let at = protoOf(origin)
    while (at) {
        const descriptor = heap.getOwnProperty(at, key as Handle)
        if (descriptor) {
            const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
            if (d.flags & heap.PropFlags.has_getter) return virtualCall(target, d.slot0 as Handle, origin, [], [])
            if (d.flags & heap.PropFlags.has_setter) return addConst(target, UNDEF)
            ownLater(origin, key, target)
            return heapValue(d.slot0 as Handle, target, 0, undefined, 0)
        }
        at = heap.getPrototypeOf(at)
    }
    const own = fieldSlot(origin, key)
    readField(own, target)
    flow.missing.push(target, own)
    if (kind === OriginKind.fresh || kind === OriginKind.created) namedRead(origin, target)
}

function elemRead(origin: number, target: number): void {
    readField(fieldSlot(origin, elemKey), target)
    for (const [key, f] of flow.originFields[origin]) if (isPosKey(key)) copyEdge(f, target)
    let readers = flow.elemReaders.get(origin)
    if (!readers) flow.elemReaders.set(origin, readers = [])
    readers.push(target)
}

function ownLater(origin: number, key: number, target: number): void {
    const known = flow.originFields[origin].get(key)
    if (known !== undefined) return readField(known, target)
    let pending = flow.originPending[origin]
    if (!pending) flow.originPending[origin] = pending = new Map()
    let list = pending.get(key)
    if (!list) pending.set(key, list = [])
    list.push(target)
}

function trapOf(origin: number): Handle {
    let at = protoOf(origin)
    while (at) {
        if (heap.isProxy(at)) return at
        at = heap.getPrototypeOf(at)
    }
    return 0 as Handle
}

function resolveStore(origin: number, key: number, inst: Instance, e: number, valueSlot: number): void {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.fn || kind === OriginKind.site || kind === OriginKind.str) return
    const scope = isScope(origin)
    if (key !== elemKey && !scope && isIndexKey(key)) {
        const proxy = trapOf(origin)
        if (proxy) {
            const x = inst.summary.exprs[e]
            const index = key === dynKey ? -1 : heap.keyIndex(key as Handle)!
            const keyArg = key === dynKey ? at(inst, x.args[0]) : -1
            return virtualCall(storeSlot(inst, e), heap.getProxySetter(proxy), origin, [keyArg, valueSlot], [index < 0 ? NONE : literalScalar(index), NONE])
        }
    }
    if (key >= 0 && !scope) {
        let at = protoOf(origin)
        while (at) {
            const descriptor = heap.getOwnProperty(at, key as Handle)
            if (descriptor) {
                const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
                if (d.flags & heap.PropFlags.has_setter) {
                    flow.setterKeys.add(key)
                    return virtualCall(storeSlot(inst, e), d.slot1 as Handle, origin, [valueSlot], [])
                }
                break
            }
            at = heap.getPrototypeOf(at)
        }
    }
    const x = inst.summary.exprs[e]
    if (x.op === ExprOp.store && key >= 0 && inst.qual === origin && pg.deferInit(inst, x, origin, key, e, valueSlot)) return
    if (x.op === ExprOp.store) return writeField(fieldSlot(origin, key), valueSlot, writerId(inst, e), 'prop', true)
    writeField(fieldSlot(origin, key), typedStore(inst, e, valueSlot), writerId(inst, e), typeName(x.type), true)
}

function typedStore(inst: Instance, e: number, valueSlot: number): number {
    const key = writerId(inst, e)
    const known = flow.storeSlots.get(key)
    if (known !== undefined) return known
    const slot = storeSlot(inst, e)
    copyEdge(valueSlot, slot)
    return slot
}

function assignSource(origin: number, assign: number): void {
    flow.originCopied.add(origin)
    let list = flow.originFieldListeners[origin]
    if (!list) flow.originFieldListeners[origin] = list = []
    list.push(assign)
    for (const [key, s] of flow.originFields[origin]) assignField(assign, key, s)
}

function assignField(assign: number, key: number, field: number): void {
    const inst = instOfSlot(assign)
    const x = exprAt(assign)
    const n = getNode(inst.summary.g, x.node)!
    if (assignExcluded(inst.summary.g, n).includes(key as Handle)) return
    listen(at(inst, x.args[0]), ListenerKind.assignTarget, field, key, 0)
}

function assignTarget(fromField: number, origin: number): void {
    writeField(fieldSlot(origin, flow.slotIndex[fromField]), fromField, -1, 'prop', false)
}

function callTarget(callSlot: number, target: number): void {
    const fn = originFunction(target)
    if (!fn) {
        if (flow.originKind[target] !== OriginKind.str) markOpaque(callSlot)
        return
    }
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    const s = summaryOf(fn)
    if (!s.hasThis) return bindCall(callSlot, target, 0)
    const recvExpr = inst.summary.exprs[x.b]
    if (recvExpr.op === ExprOp.konst) bindCall(callSlot, target, 0)
    const recv = at(inst, x.b)
    const origins = flow.slotOrigins[recv]
    const sent = flow.slotSent[recv]
    for (let i = 0; i < sent; i++) if (methodOf(inst, x, target, origins[i])) bindCall(callSlot, target, origins[i])
}

function methodOf(inst: Instance, x: Expr, target: number, recv: number): boolean {
    const m = inst.summary.exprs[x.a]
    if (m.op !== ExprOp.member || m.a !== x.b) return true
    const part = flow.parts.get(at(inst, x.a))?.get(recv)
    return part !== undefined && flow.slotOrigins[part].includes(target)
}

function callRecv(callSlot: number, recv: number): void {
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    const targetSlot = at(inst, x.a)
    const origins = flow.slotOrigins[targetSlot]
    const sent = flow.slotSent[targetSlot]
    for (let i = 0; i < sent; i++) {
        const fn = originFunction(origins[i])
        if (fn && summaryOf(fn).hasThis && methodOf(inst, x, origins[i], recv)) bindCall(callSlot, origins[i], recv)
    }
}

function rtSubject(callSlot: number, subject: number): void {
    if (flow.originKind[subject] === OriginKind.str) return
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    bindRt(inst, x, callSlot, bindingOf(x.a)!.impl!, subject, subject)
}

function bindCall(callSlot: number, target: number, recv: number): void {
    let bound = flow.bound.get(callSlot)
    if (!bound) flow.bound.set(callSlot, bound = new Set())
    intrinsics.assert(recv < 4194304, `value-flow: origin ${recv} does not fit a call-binding key`)
    const key = target * 4194304 + recv
    if (bound.has(key)) return
    bound.add(key)
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    const fn = boundCallee(originFunction(target)!, getNode(inst.summary.g, x.node)!)
    const s = summaryOf(fn)
    const kind = flow.originKind[target]
    const qual = s.hasThis ? qualOf(recv) : kind === OriginKind.fresh ? target : s.returnsFresh && getNode(inst.summary.g, x.node)?.op !== NodeOp.static ? qualified(OriginKind.site, 0, inst.qual, x.node, inst.summary) : 0
    const callee = flow.instances[instance(fn, qual, -1, -1)]
    addCaller(callee, callSlot)
    for (let i = 0; i < s.params; i++) {
        if (i < x.args.length) copyEdge(at(inst, x.args[i]), callee.sigs[i])
        else addConst(callee.sigs[i], UNDEF)
    }
    if (s.hasThis) {
        if (recv) addOrigin(paramSlot(callee, -1), recv)
        if (!thisPinned(callee)) addIn(paramSlot(callee, -1), -at(inst, x.b) - 1)
    }
    if (s.usesCtx) addOrigin(paramSlot(callee, -2), target)
    const part = partSlot(callSlot, key)
    const cone = qual === 0 && !s.hasThis ? returnCone(s) : null
    const from = cone ? callee.ret : pg.refineReturn(callee, part)
    flow.partBind.set(part, { callee: callee.id, from, kind: BindKind.call, target, recv })
    if (cone) siteReturn(callee, inst, x, callSlot, part, cone)
    else copyEdge(from, part)
}

function fillMissing(): void {
    for (let i = 0; i < flow.missing.length; i += 2) {
        const target = flow.missing[i]
        const own = flow.missing[i + 1]
        if (!flow.slotIns[own]?.length && flow.slotConst[own] === NONE) addConst(target, UNDEF)
    }
}

function globalOrigins(slot: number): number[] {
    return flow.slotOrigins[slot]
}

function evalSlot(slot: number, value: (s: number) => number, originsOf: (s: number) => number[] = globalOrigins): number {
    let out = flow.slotConst[slot]
    const ins = flow.slotIns[slot]
    if (ins) for (const from of ins) out = unite(out, value(from >= 0 ? from : -from - 1))
    if (flow.slotOpaque[slot] && flow.slotKind[slot] !== SlotKind.expr) out = unite(out, UNKNOWN)
    if (flow.slotKind[slot] !== SlotKind.expr) return out
    const inst = flow.instances[flow.slotOwner[slot]]
    const x = inst.summary.exprs[flow.slotIndex[slot]]
    if (flow.slotOpaque[slot]) out = unite(out, opaqueScalar(inst.summary, x))
    switch (x.op) {
        case ExprOp.union:
            for (let i = 0; i < x.args.length; i++) {
                const gate = x.gates ? x.gates[i] ?? -1 : -1
                if (gate >= 0 && value(at(inst, gate)) === NONE) continue
                out = unite(out, value(at(inst, x.args[i])))
            }
        case ExprOp.gate:
            if (x.a >= 0 && value(at(inst, x.a)) === NONE) return out
            if (admits(value(at(inst, x.b)), originsOf(at(inst, x.b)).length > 0, x.key === 1)) out = unite(out, literalScalar(1))
        case ExprOp.ntype: out = unite(out, ntypeScalar(value(at(inst, x.a)), originsOf(at(inst, x.a)).length > 0))
        case ExprOp.narrow: out = unite(out, filterScalar(value(at(inst, x.a)), x.key, x.b, x.sub))
        case ExprOp.pick: out = unite(out, value(at(inst, x.a)))
        case ExprOp.arith: out = unite(out, arithScalar(x.key, x.sub, value(at(inst, x.a)), value(at(inst, x.b))))
        case ExprOp.cmp: out = unite(out, foldCompare(x.key, value(at(inst, x.a)), value(at(inst, x.b)), originsOf(at(inst, x.a)), originsOf(at(inst, x.b))))
        case ExprOp.rt: out = unite(out, rtScalar(inst, x, value, originsOf))
        case ExprOp.member: if (scalars.flags[value(at(inst, x.a))] & ScalarFlag.unknown) out = unite(out, UNKNOWN)
    }
    return typedScalar(out, x.type)
}

function admits(t: number, objects: boolean, truthy: boolean): boolean {
    const f = scalars.flags[t]
    if (f & (ScalarFlag.unknown | ScalarFlag.float | ScalarFlag.anyStr)) return true
    if (truthy) {
        if (objects) return true
        if ((f & ScalarFlag.int) && !(scalars.lo[t] === 0 && scalars.hi[t] === 0)) return true
        return scalars.strs[t].length > 0
    }
    if (f & (ScalarFlag.undef | ScalarFlag.void)) return true
    if ((f & ScalarFlag.int) && scalars.lo[t] <= 0 && scalars.hi[t] >= 0) return true
    for (const h of scalars.strs[t]) if (heap.stringToJs(h as Handle) === '') return true
    return false
}

function ntypeScalar(t: number, objects: boolean): number {
    const f = scalars.flags[t]
    if (t === NONE && !objects) return NONE
    if (f & ScalarFlag.unknown) return numScalar(Types.u64, Types.f64)
    const float = (f & ScalarFlag.float) !== 0
    const other = objects || (f & ~ScalarFlag.float) !== 0
    if (float && other) return numScalar(Types.u64, Types.f64)
    return literalScalar(float ? Types.f64 : Types.u64)
}

function onlyInts(t: number, origins: number[]): boolean {
    return scalars.flags[t] === ScalarFlag.int && origins.length === 0
}

function disjoint(a: number, b: number): boolean {
    const la = literalsOf(a)
    const lb = literalsOf(b)
    if (!la || !lb) return false
    for (const v of la) if (lb.includes(v)) return false
    return true
}

function foldCompare(op: NodeOp, a: number, b: number, originsA: number[], originsB: number[]): number {
    if ((a === NONE && !originsA.length) || (b === NONE && !originsB.length)) return NONE
    const fa = scalars.flags[a]
    const fb = scalars.flags[b]
    if ((fa | fb) & ScalarFlag.unknown) return BOOL
    if (onlyInts(a, originsA) && onlyInts(b, originsB)) {
        const alo = scalars.lo[a]
        const ahi = scalars.hi[a]
        const blo = scalars.lo[b]
        const bhi = scalars.hi[b]
        switch (op) {
            case NodeOp.lt: return ahi < blo ? literalScalar(1) : alo >= bhi ? literalScalar(0) : BOOL
            case NodeOp.le: return ahi <= blo ? literalScalar(1) : alo > bhi ? literalScalar(0) : BOOL
            case NodeOp.gt: return alo > bhi ? literalScalar(1) : ahi <= blo ? literalScalar(0) : BOOL
            case NodeOp.ge: return alo >= bhi ? literalScalar(1) : ahi < blo ? literalScalar(0) : BOOL
            case NodeOp.eq:
                if (alo === ahi && blo === bhi && alo === blo) return literalScalar(1)
                return ahi < blo || bhi < alo || disjoint(a, b) ? literalScalar(0) : BOOL
            case NodeOp.ne:
                if (alo === ahi && blo === bhi && alo === blo) return literalScalar(0)
                return ahi < blo || bhi < alo || disjoint(a, b) ? literalScalar(1) : BOOL
        }
        return BOOL
    }
    if (op !== NodeOp.eq && op !== NodeOp.ne) return BOOL
    const equal = op === NodeOp.eq
    const strA = fa === ScalarFlag.str && scalars.strs[a].length === 1 && onlyStrOrigins(originsA)
    const strB = fb === ScalarFlag.str && scalars.strs[b].length === 1 && onlyStrOrigins(originsB)
    if (strA && strB) {
        const same = scalars.strs[a][0] === scalars.strs[b][0] || heap.stringToJs(scalars.strs[a][0] as Handle) === heap.stringToJs(scalars.strs[b][0] as Handle)
        return literalScalar(same === equal ? 1 : 0)
    }
    const undefA = (fa & ~(ScalarFlag.undef | ScalarFlag.void)) === 0 && (fa & (ScalarFlag.undef | ScalarFlag.void)) !== 0 && !originsA.length
    const undefB = (fb & ~(ScalarFlag.undef | ScalarFlag.void)) === 0 && (fb & (ScalarFlag.undef | ScalarFlag.void)) !== 0 && !originsB.length
    const definedA = (fa & (ScalarFlag.undef | ScalarFlag.void)) === 0 && (originsA.length > 0 || (fa & (ScalarFlag.str | ScalarFlag.anyStr | ScalarFlag.int | ScalarFlag.float)) !== 0)
    const definedB = (fb & (ScalarFlag.undef | ScalarFlag.void)) === 0 && (originsB.length > 0 || (fb & (ScalarFlag.str | ScalarFlag.anyStr | ScalarFlag.int | ScalarFlag.float)) !== 0)
    if (undefA && undefB) return literalScalar(equal ? 1 : 0)
    if ((undefA && definedB) || (definedA && undefB)) return literalScalar(equal ? 0 : 1)
    return BOOL
}

function onlyStrOrigins(origins: number[]): boolean {
    for (const a of origins) if (flow.originKind[a] !== OriginKind.str) return false
    return true
}

function rtScalar(inst: Instance, x: Expr, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    const op = x.a
    if (op === RtOp.typeof) return typeofScalar(at(inst, x.args[0]), value, originsOf)
    if (op === RtOp.concat || op === RtOp.toString) return ANYSTR
    if (op === RtOp.addOrConcat) return unite(ANYSTR, I64)
    if (op === RtOp.handleHash || op === RtOp.heapaddr || op === RtOp.handleof || op === RtOp.pstackaddr) return numScalar(0, 2 ** 32 - 1)
    if (op === RtOp.hasPrototype || op === RtOp.strictEqual || op === RtOp.truthy || op === RtOp.nullish) return BOOL
    if (op === RtOp.paramCount || op === RtOp.restIndex) return I64
    return NONE
}

function typeofScalar(slot: number, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    const t = value(slot)
    const f = scalars.flags[t]
    if (f & ScalarFlag.unknown) return ANYSTR
    const names: number[] = []
    if (f & (ScalarFlag.int | ScalarFlag.float)) names.push(heap.typeNames.number as number)
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) names.push(heap.typeNames.string as number)
    if (f & (ScalarFlag.undef | ScalarFlag.void)) names.push(heap.typeNames.undefined as number)
    for (const a of originsOf(slot)) {
        const k = flow.originKind[a]
        const name = (k === OriginKind.str ? heap.typeNames.string : originHostFn(a) ? heap.typeNames.function : heap.typeNames.object) as number
        if (!names.includes(name)) names.push(name)
    }
    names.sort((a, b) => a - b)
    return scalar(ScalarFlag.str, 0, 0, names)
}

function exprUses(slot: number): void {
    const inst = flow.instances[flow.slotOwner[slot]]
    const x = inst.summary.exprs[flow.slotIndex[slot]]
    if (x.op === ExprOp.union) for (const a of x.args) scalarUse(at(inst, a), slot)
    if (x.gates) for (const gate of x.gates) if (gate >= 0) scalarUse(at(inst, gate), slot)
    if (x.op === ExprOp.gate) {
        if (x.a >= 0) scalarUse(at(inst, x.a), slot)
        scalarUse(at(inst, x.b), slot)
    }
    if (x.op === ExprOp.ntype || x.op === ExprOp.narrow || x.op === ExprOp.pick) scalarUse(at(inst, x.a), slot)
    if (x.op === ExprOp.cmp || x.op === ExprOp.arith) {
        scalarUse(at(inst, x.a), slot)
        scalarUse(at(inst, x.b), slot)
    }
    if (x.op === ExprOp.rt && x.a === RtOp.typeof) scalarUse(at(inst, x.args[0]), slot)
    if (x.op === ExprOp.member) scalarUse(at(inst, x.a), slot)
}

function components(n: number, roots: number[], edgesOf: (v: number) => number[], emit: (group: number[], cyclic: boolean, edges: number[][]) => void): void {
    const index = new Int32Array(n).fill(-1)
    const low = new Int32Array(n)
    const onStack = new Uint8Array(n)
    const lists: number[][] = new Array(n)
    const stack: number[] = []
    const call: number[] = []
    const edgeAt: number[] = []
    let counter = 0
    const enter = (v: number) => {
        index[v] = low[v] = counter++
        stack.push(v)
        onStack[v] = 1
        lists[v] = edgesOf(v)
        call.push(v)
        edgeAt.push(0)
    }
    for (const root of roots) {
        if (index[root] >= 0) continue
        enter(root)
        while (call.length) {
            const v = call[call.length - 1]
            const list = lists[v]
            const k = edgeAt[edgeAt.length - 1]
            if (k < list.length) {
                edgeAt[edgeAt.length - 1] = k + 1
                const w = list[k]
                if (index[w] < 0) enter(w)
                else if (onStack[w] && index[w] < low[v]) low[v] = index[w]
                continue
            }
            call.pop()
            edgeAt.pop()
            if (call.length) {
                const u = call[call.length - 1]
                if (low[v] < low[u]) low[u] = low[v]
            }
            if (low[v] !== index[v]) continue
            const group: number[] = []
            for (;;) {
                const w = stack.pop()!
                onStack[w] = 0
                group.push(w)
                if (w === v) break
            }
            emit(group, group.length > 1 || list.includes(v), lists)
            for (const w of group) lists[w] = []
        }
    }
}

function widens(slot: number): boolean {
    if (flow.slotKind[slot] !== SlotKind.expr) return true
    const op = exprAt(slot).op
    return op !== ExprOp.narrow && op !== ExprOp.pick && op !== ExprOp.arith
}

function globalValue(slot: number): number {
    return flow.scalar[slot]
}

function drainScalars(): void {
    const queue = flow.scalarQueue
    let i = 0
    while (i < queue.length) {
        const s = queue[i++]
        flow.scalarQueued[s] = 0
        updateScalar(s)
    }
    queue.length = 0
}

function updateScalar(s: number): void {
    charge(1)
    if (flow.stringSite[s]) checkString(s)
    const old = flow.scalar[s]
    let next = unite(old, evalSlot(s, globalValue))
    if (next === old) return
    if (widens(s) && (scalars.flags[next] & ScalarFlag.int) && (scalars.flags[old] & ScalarFlag.int) && (scalars.lo[next] !== scalars.lo[old] || scalars.hi[next] !== scalars.hi[old])) {
        flow.scalarChanges[s]++
        if (flow.scalarChanges[s] >= 2) {
            const lo = scalars.lo[next] < scalars.lo[old] ? (scalars.lo[old] > 0 ? 0 : MinI64) : scalars.lo[next]
            const hi = scalars.hi[next] > scalars.hi[old] ? (lo < 0 ? MaxI64 : MaxU64) : scalars.hi[next]
            next = unite(next, numScalar(lo, hi))
        }
    }
    flow.scalar[s] = next
    dirtyUsers(s)
    if (old !== NONE) return
    const waiting = flow.gateWaits.get(s)
    if (!waiting) return
    flow.gateWaits.delete(s)
    for (let i = 0; i < waiting.length; i += 2) wireEffect(flow.instances[waiting[i]], waiting[i + 1])
}

function groupUsers(group: number[], edges: number[][]): number[][] {
    const local = new Map<number, number>()
    for (let i = 0; i < group.length; i++) local.set(group[i], i)
    const users: number[][] = []
    for (let i = 0; i < group.length; i++) users.push([])
    for (let i = 0; i < group.length; i++) {
        for (const d of edges[group[i]]) {
            const at = local.get(d)
            if (at !== undefined) users[at].push(i)
        }
    }
    return users
}

function settleGroup(group: number[], users: number[][], step: (i: number, v: number) => boolean): void {
    const dirty = new Uint8Array(group.length).fill(1)
    let pending = group.length
    while (pending > 0) {
        for (let i = 0; i < group.length; i++) {
            if (!dirty[i]) continue
            dirty[i] = 0
            pending--
            if (!step(i, group[i])) continue
            for (const u of users[i]) {
                if (dirty[u]) continue
                dirty[u] = 1
                pending++
            }
        }
    }
}

export function seedRoot(fn: Function, qual: number): number[] {
    const inst = flow.instances[instance(fn, summaryOf(fn).hasThis ? qual : 0, -1, -1)]
    flow.rooted.add(inst.id)
    const g = inst.summary.g
    let declared = 0
    for (const p of g.blocks[0].params) {
        const n = getNode(g, p)!
        if (isThisParam(n)) continue
        addConst(inst.sigs[declared], typeRange(typeOf(n)))
        declared++
    }
    const s = inst.summary
    if (s.usesCtx) for (const x of s.exprs) {
        if (x.op === ExprOp.param && x.a === -2) addConst(paramSlot(inst, -2), opaqueScalar(s, x))
    }
    return inst.sigs.slice(0, s.params)
}

export interface Spec {
    inst: Instance
    global: boolean
    params: number[]
    paramOrigins: number[][]
    sigIndex: Map<number, number>
    scalar: number[]
    origins: number[][]
    calls: Map<number, Spec>
    dead: Set<number>
}

interface SpecState {
    globals: Map<number, Spec>
    memo: Map<number, Map<string, Spec>>
    grown: Map<Spec, number>
    recursive: Set<number>
    active: Set<number>
}

interface Arrival {
    from: Spec | undefined
    part: number
    params: number[]
    origins: number[][]
}

const widenAfter = 3
const directRt = new Set<number>([RtOp.slice, RtOp.create, RtOp.concat, RtOp.toString, RtOp.addOrConcat, RtOp.assign])

function callerInstance(slot: number): Instance {
    const inst = instOfSlot(slot)
    return inst.site ?? inst
}

function callOrder(): [number[], boolean][] {
    const edges = new Map<number, number[]>()
    for (const [part, bind] of flow.partBind) {
        const owner = callerInstance(part)
        if (bind.kind !== BindKind.virtual && owner === instOfSlot(part)) {
            const [params, origins] = callArgs(globalSpec(owner), part, bind)
            if (impossibleArgs(flow.instances[bind.callee], params, origins)) continue
        }
        const from = owner.id
        let list = edges.get(from)
        if (!list) edges.set(from, list = [])
        list.push(bind.callee)
        charge(1)
    }
    for (const [slot, callees] of flow.runtimeBinds) {
        const from = callerInstance(slot).id
        let list = edges.get(from)
        if (!list) edges.set(from, list = [])
        for (const callee of callees) list.push(callee)
    }
    const out: [number[], boolean][] = []
    const roots: number[] = []
    for (const inst of flow.instances) if (!inst.site) roots.push(inst.id)
    components(flow.instances.length, roots, v => edges.get(v) ?? [], (members, recursive) => out.push([members, recursive]))
    out.reverse()
    return out
}

function sigIndexOf(inst: Instance): Map<number, number> {
    const out = new Map<number, number>()
    for (let i = 0; i < inst.sigs.length; i++) if (flow.slotKind[inst.sigs[i]] === SlotKind.sig) out.set(inst.sigs[i], i)
    return out
}

function globalSpec(inst: Instance): Spec {
    const known = flow.spec.globals.get(inst.id)
    if (known) return known
    const params: number[] = []
    const paramOrigins: number[][] = []
    for (const sig of inst.sigs) {
        params.push(flow.scalar[sig])
        paramOrigins.push(flow.slotOrigins[sig])
    }
    const spec: Spec = { inst, global: true, params, paramOrigins, sigIndex: sigIndexOf(inst), scalar: [], origins: [], calls: new Map(), dead: new Set() }
    flow.spec.globals.set(inst.id, spec)
    return spec
}

export function specScalar(spec: Spec, slot: number): number {
    if (spec.global) return flow.scalar[slot]
    const k = slot - spec.inst.base
    if (k >= 0 && k < spec.inst.summary.width && flow.slotKind[slot] === SlotKind.expr) {
        return spec.scalar[k]
    }
    const i = spec.sigIndex.get(slot)
    if (i !== undefined) return spec.params[i]
    if (flow.slotKind[slot] === SlotKind.part && ownsPart(spec, slot)) {
        if (!partLive(spec, slot) || spec.dead.has(slot)) return NONE
        const c = spec.calls.get(slot)
        if (c && !c.global && flow.partBind.get(slot)!.from >= 0) return specScalar(c, flow.partBind.get(slot)!.from)
    }
    return flow.scalar[slot]
}

export function specOrigins(spec: Spec, slot: number): number[] {
    if (spec.global) return flow.slotOrigins[slot]
    const k = slot - spec.inst.base
    if (k >= 0 && k < spec.inst.summary.width && flow.slotKind[slot] === SlotKind.expr) {
        return spec.origins[k]
    }
    const i = spec.sigIndex.get(slot)
    if (i !== undefined) return spec.paramOrigins[i]
    if (flow.slotKind[slot] === SlotKind.part && ownsPart(spec, slot)) {
        if (!partLive(spec, slot) || spec.dead.has(slot)) return []
        const c = spec.calls.get(slot)
        if (c && !c.global && flow.partBind.get(slot)!.from >= 0) return specOrigins(c, flow.partBind.get(slot)!.from)
    }
    return flow.slotOrigins[slot]
}

function ownsPart(spec: Spec, part: number): boolean {
    const owner = flow.slotOwner[part]
    const k = owner - spec.inst.base
    return k >= 0 && k < spec.inst.summary.width && flow.slotKind[owner] === SlotKind.expr
}

function partLive(spec: Spec, part: number): boolean {
    const owner = flow.slotOwner[part]
    const inst = spec.inst
    const x = inst.summary.exprs[flow.slotIndex[owner]]
    const bind = flow.partBind.get(part)
    const gate = x.gates && (x.op === ExprOp.call || x.op === ExprOp.rt) ? x.gates[0] : -1
    if (gate >= 0 && specScalar(spec, at(inst, gate)) === NONE) return false
    if (bind?.kind === BindKind.call) return specOrigins(spec, at(inst, x.a)).includes(bind.target) && (!bind.recv || specOrigins(spec, at(inst, x.b)).includes(bind.recv))
    if (bind?.kind === BindKind.rt) return !bind.recv || specOrigins(spec, at(inst, x.args[0])).includes(bind.recv)
    if (x.op === ExprOp.member) return specOrigins(spec, at(inst, x.a)).includes(flow.slotIndex[part])
    if (x.op === ExprOp.rt && x.args.length) return specOrigins(spec, at(inst, x.args[0])).includes(flow.slotIndex[part])
    return true
}

function addOrigins(into: number[], from: number[]): number[] {
    let out = into
    for (const a of from) {
        if (out.includes(a)) continue
        if (out === into) out = into.slice()
        out.push(a)
    }
    return out
}

function partOrigins(spec: Spec, slot: number, into: number[]): number[] {
    let out = into
    const parts = flow.parts.get(slot)
    if (!parts) return out
    for (const part of parts.values()) out = addOrigins(out, specOrigins(spec, part))
    return out
}

function localOrigins(spec: Spec, x: Expr, slot: number): number[] {
    const inst = spec.inst
    switch (x.op) {
        case ExprOp.union: {
            let out: number[] = []
            for (let i = 0; i < x.args.length; i++) {
                const gate = x.gates ? x.gates[i] ?? -1 : -1
                if (gate >= 0 && specScalar(spec, at(inst, gate)) === NONE) continue
                out = addOrigins(out, specOrigins(spec, at(inst, x.args[i])))
            }
            return out
        }
        case ExprOp.narrow:
        case ExprOp.pick: {
            const from = specOrigins(spec, at(inst, x.a))
            const all = flow.slotOrigins[slot]
            return from.filter(a => all.includes(a))
        }
        case ExprOp.member:
        case ExprOp.call: return partOrigins(spec, slot, [])
        case ExprOp.rt: return directRt.has(x.a) ? flow.slotOrigins[slot] : partOrigins(spec, slot, [])
    }
    return flow.slotOrigins[slot]
}

function localFix(spec: Spec): void {
    const inst = spec.inst
    const s = inst.summary
    spec.scalar = new Array(s.width).fill(NONE)
    spec.origins = []
    for (let k = 0; k < s.width; k++) spec.origins.push([])
    const changes = new Uint8Array(s.width)
    const value = (slot: number) => specScalar(spec, slot)
    const originsOf = (slot: number) => specOrigins(spec, slot)
    const step = (i: number, e: number): boolean => {
        const k = s.local![e]
        const slot = inst.base + k
        charge(1)
        bindLocalCalls(spec, slot)
        let t = unite(spec.scalar[k], evalSlot(slot, value, originsOf))
        let origins = addOrigins(spec.origins[k], localOrigins(spec, s.exprs[e], slot))
        if (t === spec.scalar[k] && origins.length === spec.origins[k].length) return false
        if (changes[k] < 255) changes[k]++
        if (changes[k] > widenAfter) {
            t = unite(t, flow.scalar[slot])
            origins = addOrigins(origins, flow.slotOrigins[slot])
        }
        spec.scalar[k] = t
        spec.origins[k] = origins
        return true
    }
    const order = orderOf(s)
    for (let g = 0; g < order.groups.length; g++) {
        const users = order.users[g]
        if (users) settleGroup(order.groups[g], users, step)
        else step(0, order.groups[g][0])
    }
}

function orderOf(s: Summary): Order {
    if (s.order) return s.order
    const order: Order = { groups: [], users: [] }
    components(s.exprs.length, s.owned, e => ownedOperands(s, e), (group, cyclic, edges) => {
        order.groups.push(group)
        order.users.push(cyclic ? groupUsers(group, edges) : undefined)
    })
    s.order = order
    return order
}

function ownedOperands(s: Summary, e: number): number[] {
    const x = s.exprs[e]
    const all: number[] = []
    if (x.gates) for (const gate of x.gates) all.push(gate)
    switch (x.op) {
        case ExprOp.union:
        case ExprOp.rt:
        case ExprOp.opaque:
            for (const a of x.args) all.push(a)
        case ExprOp.narrow:
        case ExprOp.pick:
        case ExprOp.ntype:
            all.push(x.a)
        case ExprOp.gate:
        case ExprOp.arith:
        case ExprOp.cmp:
            all.push(x.a)
            all.push(x.b)
        case ExprOp.member:
            all.push(x.a)
            if (x.key === dynKey) all.push(x.b)
        case ExprOp.call:
            all.push(x.a)
            all.push(x.b)
            for (const a of x.args) all.push(a)
    }
    const n = x.op === ExprOp.union && x.node ? getNode(s.g, x.node) : undefined
    if (n?.op === NodeOp.select) all.push(s.exprOf.get(getRef(n, 0)) ?? -1)
    const out: number[] = []
    for (const a of all) if (a >= 0 && s.local![a] >= 0 && s.local![a] < s.width) out.push(a)
    return out
}

function callArgs(spec: Spec, part: number, bind: Bind): [number[], number[][]] {
    const inst = spec.inst
    const x = exprAt(part)
    const callee = flow.instances[bind.callee]
    const cs = callee.summary
    const params: number[] = []
    const origins: number[][] = []
    for (const sig of callee.sigs) {
        params.push(flow.scalar[sig])
        origins.push(flow.slotOrigins[sig])
    }
    const set = (i: number, t: number, a: number[]) => {
        if (i < 0 || i >= callee.sigs.length || flow.slotKind[callee.sigs[i]] !== SlotKind.sig) return
        params[i] = t
        origins[i] = a
    }
    if (bind.kind === BindKind.rt) {
        const args = rtOperands(inst, x)
        for (let i = 0; i < cs.params; i++) {
            if (i >= args.length) set(i, UNDEF, [])
            else if (i === 0 && bind.recv) set(0, specScalar(spec, at(inst, args[0])), [bind.recv])
            else if (i === 0 && !bind.target && x.op === ExprOp.rt) set(0, specScalar(spec, at(inst, args[0])), [])
            else set(i, specScalar(spec, at(inst, args[i])), specOrigins(spec, at(inst, args[i])))
        }
        return [params, origins]
    }
    for (let i = 0; i < cs.params; i++) {
        if (i >= x.args.length) set(i, UNDEF, [])
        else set(i, specScalar(spec, at(inst, x.args[i])), specOrigins(spec, at(inst, x.args[i])))
    }
    if (cs.hasThis) set(paramOffset(cs, -1), bind.kind === BindKind.call ? specScalar(spec, at(inst, x.b)) : NONE, bind.recv ? [bind.recv] : [])
    if (cs.usesCtx) set(paramOffset(cs, -2), NONE, [bind.target])
    return [params, origins]
}

function joinArrivals(inst: Instance, list: Arrival[]): Spec {
    const params = list[0].params.slice()
    const paramOrigins = list[0].origins.slice()
    for (let k = 1; k < list.length; k++) {
        for (let i = 0; i < params.length; i++) {
            params[i] = unite(params[i], list[k].params[i])
            paramOrigins[i] = addOrigins(paramOrigins[i], list[k].origins[i])
        }
    }
    return specOf(inst, params, paramOrigins, true)
}

function covers(spec: Spec, params: number[], paramOrigins: number[][], exact: boolean): boolean {
    if (spec.global && !exact) return true
    for (let i = 0; i < params.length; i++) {
        if (exact && (spec.params[i] !== params[i] || spec.paramOrigins[i].length !== paramOrigins[i].length)) return false
        if (unite(spec.params[i], params[i]) !== spec.params[i]) return false
        for (const a of paramOrigins[i]) if (!spec.paramOrigins[i].includes(a)) return false
    }
    return true
}

function specOf(inst: Instance, params: number[], paramOrigins: number[][], exact: boolean): Spec {
    if (flow.spec.recursive.has(inst.id) || flow.spec.active.has(inst.id)) return globalSpec(inst)
    let memo = flow.spec.memo.get(inst.id)
    if (!memo) flow.spec.memo.set(inst.id, memo = new Map())
    const key = arrivalClass(inst, { from: undefined, part: -1, params, origins: paramOrigins })
    const known = memo.get(key)
    if (known && covers(known, params, paramOrigins, exact)) return known
    let joined = params
    let joinedOrigins = paramOrigins
    if (known && !exact) {
        joined = params.slice()
        joinedOrigins = paramOrigins.slice()
        for (let i = 0; i < joined.length; i++) {
            joined[i] = unite(joined[i], known.params[i])
            joinedOrigins[i] = addOrigins(joinedOrigins[i], known.paramOrigins[i])
        }
    }
    const grown = known ? (flow.spec.grown.get(known) ?? 0) + 1 : 0
    if (grown > widenAfter) {
        const spec = globalSpec(inst)
        if (!exact) memo.set(key, spec)
        return spec
    }
    const spec: Spec = { inst, global: false, params: joined, paramOrigins: joinedOrigins, sigIndex: sigIndexOf(inst), scalar: [], origins: [], calls: new Map(), dead: new Set() }
    flow.spec.grown.set(spec, grown)
    flow.spec.active.add(inst.id)
    localFix(spec)
    flow.spec.active.delete(inst.id)
    memo.set(key, spec)
    return spec
}

function bindLocalCalls(spec: Spec, slot: number): void {
    const parts = flow.parts.get(slot)
    if (!parts) return
    for (const part of parts.values()) {
        const bind = flow.partBind.get(part)
        if (!bind || bind.kind === BindKind.virtual) continue
        if (!partLive(spec, part)) {
            spec.calls.delete(part)
            continue
        }
        const callee = flow.instances[bind.callee]
        const [params, origins] = callArgs(spec, part, bind)
        if (impossibleArgs(callee, params, origins)) {
            spec.calls.delete(part)
            spec.dead.add(part)
            continue
        }
        spec.dead.delete(part)
        spec.calls.set(part, specOf(callee, params, origins, false))
    }
}

function nullishOnly(t: number, origins: number[]): boolean {
    return t !== NONE && (scalars.flags[t] & ~(ScalarFlag.undef | ScalarFlag.void)) === 0 && !origins.length
}

export function impossibleExpr(spec: Spec, e: number, memo: Map<number, boolean>): boolean {
    const known = memo.get(e)
    if (known !== undefined) return known
    memo.set(e, false)
    const inst = spec.inst
    const s = inst.summary
    const x = s.exprs[e]
    let dead = false
    const operand = (a: number) => a >= 0 && impossibleExpr(spec, a, memo)
    switch (x.op) {
        case ExprOp.konst:
        case ExprOp.origin:
        case ExprOp.param:
        case ExprOp.alloc:
        case ExprOp.union:
            break
        case ExprOp.member:
            dead = operand(x.a) || nullishOnly(specScalar(spec, at(inst, x.a)), specOrigins(spec, at(inst, x.a)))
            break
        case ExprOp.call:
        case ExprOp.rt: {
            for (const a of x.args) if (operand(a)) dead = true
            const parts = s.local![e] >= 0 && s.local![e] < s.width ? flow.parts.get(inst.base + s.local![e]) : undefined
            if (!dead && parts && parts.size) {
                let all = true
                for (const part of parts.values()) if (!spec.dead.has(part)) all = false
                dead = all
            }
            break
        }
        case ExprOp.arith:
        case ExprOp.cmp:
            dead = operand(x.a) || operand(x.b)
            break
        case ExprOp.narrow:
        case ExprOp.pick:
        case ExprOp.ntype:
            dead = operand(x.a)
            break
    }
    memo.set(e, dead)
    return dead
}

function impossibleArgs(callee: Instance, params: number[], origins: number[][]): boolean {
    for (let i = 0; i < params.length; i++) {
        if (flow.slotKind[callee.sigs[i]] === SlotKind.sig && params[i] === NONE && !origins[i].length) return true
    }
    return false
}

function globalArrival(inst: Instance, from: Spec | undefined, part: number): Arrival {
    const spec = globalSpec(inst)
    return { from, part, params: spec.params, origins: spec.paramOrigins }
}

function originClass(origin: number): string {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.slice) return 'buffer'
    if (kind === OriginKind.site) return 'site'
    if (isScope(origin)) return 'Scope'
    const state = heapState(origin)
    const name = state !== undefined && heap.isArray(state) ? 'Array' : constructorName(protoOf(origin))
    const elements = elementClass(origin)
    return elements ? `${name}<${elements}>` : name
}

function elementClass(origin: number): string {
    let t = NONE
    let origins: number[] = []
    const visit = (owner: number) => {
        for (const [key, slot] of flow.originFields[owner]) {
            if (key !== elemKey && !isPosKey(key)) continue
            t = unite(t, flow.scalar[slot])
            origins = addOrigins(origins, flow.slotOrigins[slot])
        }
    }
    visit(origin)
    for (const slot of flow.originFields[origin].values()) for (const a of flow.slotOrigins[slot]) if (flow.originKind[a] === OriginKind.slice) visit(a)
    if (t === NONE && !origins.length) return ''
    const f = scalars.flags[t]
    const parts = new Set<string>()
    if (f & ScalarFlag.unknown) parts.add('?')
    if (f & (ScalarFlag.undef | ScalarFlag.void)) parts.add('u')
    if (f & (ScalarFlag.int | ScalarFlag.float)) parts.add('n')
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) parts.add('s')
    for (const a of origins) parts.add(flow.originKind[a] === OriginKind.str ? 's' : originHostFn(a) ? 'f' : 'o')
    return [...parts].sort().join('|')
}

function classOfValue(t: number, origins: number[]): string {
    const f = scalars.flags[t]
    const parts = new Set<string>()
    if (f & ScalarFlag.unknown) parts.add('?')
    if (f & (ScalarFlag.undef | ScalarFlag.void)) parts.add('u')
    if (f & ScalarFlag.int) parts.add('i')
    if (f & ScalarFlag.float) parts.add('d')
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) parts.add('s')
    for (const a of origins) {
        const fn = originHostFn(a)
        if (flow.originKind[a] === OriginKind.str) parts.add('s')
        else if (fn) parts.add(`f${unitKeyOf(fn)}`)
        else parts.add(`o${originClass(a)}`)
    }
    if (parts.has('d')) {
        parts.delete('i')
        parts.delete('u')
    }
    if (parts.has('i')) parts.delete('u')
    return [...parts].sort().join('|')
}

function arrivalClass(inst: Instance, a: Arrival): string {
    const sigs = inst.sigs
    let key = ''
    for (let i = 0; i < sigs.length; i++) if (flow.slotKind[sigs[i]] === SlotKind.sig) key += `${classOfValue(a.params[i], a.origins[i])},`
    return key
}

export interface FrameInfo {
    inst: Instance
    members: Spec[]
    key: string
    sites: Site[]
}

export function buildFrames(): void {
    const bindsInto = new Map<number, number>()
    const coneParts = new Map<number, number[]>()
    for (const [part, bind] of flow.partBind) {
        bindsInto.set(bind.callee, (bindsInto.get(bind.callee) ?? 0) + 1)
        const owner = callerInstance(part)
        if (owner === instOfSlot(part)) continue
        let list = coneParts.get(owner.id)
        if (!list) coneParts.set(owner.id, list = [])
        list.push(part)
    }
    const arrivals = new Map<number, Arrival[]>()
    const built = new Map<number, Spec>()
    const edges: [Spec, number, Spec][] = []
    const arrive = (callee: number, a: Arrival) => {
        charge(1)
        const fixed = built.get(callee)
        if (fixed) {
            edges.push([a.from!, a.part, fixed])
            return
        }
        let list = arrivals.get(callee)
        if (!list) arrivals.set(callee, list = [])
        list.push(a)
    }
    const leave = (spec: Spec) => {
        const s = spec.inst.summary
        for (const e of s.owned) {
            const slot = spec.inst.base + s.local![e]
            for (const callee of flow.runtimeBinds.get(slot) ?? []) arrive(callee, globalArrival(flow.instances[callee], spec, slot))
            const parts = flow.parts.get(slot)
            if (!parts) continue
            for (const part of parts.values()) {
                const bind = flow.partBind.get(part)
                if (!bind) continue
                if (!spec.global && !partLive(spec, part)) continue
                const callee = flow.instances[bind.callee]
                if (bind.kind === BindKind.virtual) {
                    arrive(callee.id, globalArrival(callee, spec, part))
                    continue
                }
                const [params, origins] = callArgs(spec, part, bind)
                if (impossibleArgs(callee, params, origins)) continue
                arrive(callee.id, { from: spec, part, params, origins })
            }
        }
        for (const e of s.stores) {
            const slot = flow.storeSlots.get(writerId(spec.inst, e))
            const bind = slot === undefined ? undefined : flow.partBind.get(slot)
            if (bind) arrive(bind.callee, globalArrival(flow.instances[bind.callee], spec, slot!))
            if (slot !== undefined) for (const callee of flow.runtimeBinds.get(slot) ?? []) arrive(callee, globalArrival(flow.instances[callee], spec, slot))
        }
        for (const part of coneParts.get(spec.inst.id) ?? []) {
            const callee = flow.instances[flow.partBind.get(part)!.callee]
            arrive(callee.id, globalArrival(callee, spec, part))
        }
    }
    const frameOfSpec = new Map<Spec, number>()
    const order = callOrder()
    for (const [members, recursive] of order) if (recursive) for (const id of members) flow.spec.recursive.add(id)
    const forced = (inst: Instance) => flow.rooted.has(inst.id) || flow.heldStatics.has(inst.id) || inst.callers.length > (bindsInto.get(inst.id) ?? 0)
    for (const [members, recursive] of order) {
        const specs: Spec[] = []
        if (!members.some(id => arrivals.has(id) || forced(flow.instances[id]))) continue
        for (const id of members) {
            const inst = flow.instances[id]
            const list = arrivals.get(id) ?? []
            arrivals.delete(id)
            if (forced(inst)) list.push(globalArrival(inst, undefined, -1))
            if (!list.length && !recursive) continue
            const groups = new Map<string, Arrival[]>()
            if (recursive) groups.set('*', list)
            else {
                for (const a of list) {
                    const k = arrivalClass(inst, a)
                    const known = groups.get(k)
                    if (known) known.push(a)
                    else groups.set(k, [a])
                }
            }
            for (const [key, group] of groups) {
                const spec = recursive ? globalSpec(inst) : joinArrivals(inst, group)
                for (const a of group) if (a.from) edges.push([a.from, a.part, spec])
                if (frameOfSpec.has(spec)) continue
                frameOfSpec.set(spec, flow.frames.length)
                flow.frames.push({ inst, members: [spec], key, sites: [] })
                specs.push(spec)
            }
            if (recursive) built.set(id, globalSpec(inst))
        }
        for (const spec of specs) leave(spec)
    }
    const recorded = new Set<string>()
    for (const [from, part, to] of edges) {
        const frame = frameOfSpec.get(to)!
        const caller = frameOfSpec.get(from)!
        const owner = callerInstance(part)
        const node = exprAt(part).node
        const k = `${frame}:${caller}:${node}`
        if (recorded.has(k)) continue
        recorded.add(k)
        flow.frames[frame].sites.push({ unit: owner.summary.fn, node, frame: caller })
    }
}

export function unitKeyOf(fn: Function): number {
    let k = flow.unitKeys.get(fn)
    if (k === undefined) flow.unitKeys.set(fn, k = flow.unitKeys.size)
    return k
}

let constructorKey = 0

export function constructorName(proto: Handle): string {
    if (!proto) return 'Object'
    if (!constructorKey) constructorKey = heap.fromJsString('constructor') as number
    const ctor = heap.getOwnProperty(proto, constructorKey as Handle)
    if (!ctor) return 'Object'
    const fn = flow.host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32)
    return fn?.name || 'Object'
}

export function keyLabel(key: number): string {
    if (key === elemKey || key === dynKey) return numberKey
    if (isPosKey(key)) return `@${posBase - key}`
    const index = heap.keyIndex(key as Handle)
    if (index !== undefined) return `[${index}]`
    if (heap.isString(key as Handle)) {
        const name = heap.stringToJs(key as Handle)
        return name.startsWith('!') ? `!${name}` : name
    }
    return `!${heap.describeKey(key as Handle) ?? ''}#${key}`
}

export function boundCallee(fn: Function, call: GraphNode): Function {
    if (!flow.host.bindTarget || call.op !== NodeOp.call) return fn
    return flow.host.bindTarget(fn, countIds(call) - 3, spreadsLast(call))
}


export function flowAccesses(roots: Function[], host: AccessHost): Accesses {
    analyzeFlow(roots, host)
    return pg.exportAccesses()
}

function begin(roots: Function[], host: AccessHost): void {
    flow = {
        host, roots, strOrigin: -1, nothing: -1, dynamicOrigins: new Set(),
        spec: { globals: new Map(), memo: new Map(), grown: new Map(), recursive: new Set(), active: new Set() },
        frames: [],
        unitKeys: new Map(),
        work: 0, traceMs: 0, budget: 0, totalNodes: 0,
        summaries: new Map(), summaryList: [], instances: [], instanceOf: new Map(),
        originKind: [OriginKind.none], originCell: [0], originQual: [0], originFn: [undefined], originFnKnown: [1], originOwner: [undefined], originNode: [0], originIndex: new Map(), originFields: [new Map()], originFieldListeners: [undefined], originPending: [undefined], elemReaders: new Map(), pickWatch: new Map(),
        freshOwner: new Map(),
        slotKind: [], slotOwner: [], slotIndex: [], slotOrigins: [], slotOriginSet: [], slotSent: [], slotListeners: [], slotIns: [], slotConst: [], slotOpaque: [],
        queue: [], storeSlots: new Map(), constSlots: new Map(), originSlots: new Map(), bound: new Map(), missing: [], gateWaits: new Map(),
        scalar: [], scalarUsers: [], scalarQueue: [], scalarQueued: [], scalarChanges: [], originMask: [], stringSite: [],
        fieldForms: new Map(), fieldReaders: new Map(), fieldWriters: new Map(), fieldStored: new Set(), originSeen: [0], originCopied: new Set(), heldInits: new Map(), heldStatics: new Set(), rtPending: [], parts: new Map(), partBind: new Map(), rooted: new Set(), originCreators: new Map(), originSeeds: new Map(), seedList: [], setterKeys: new Set(), keyedReads: new Map(), namedReads: new Map(), runtimeBinds: new Map(),
    }
}

export function withFlow<R>(next: FlowState, run: () => R): R {
    const outer = flow
    flow = next
    const out = run()
    flow = outer
    return out
}

export function newFlow<R>(roots: Function[], host: AccessHost, run: () => R): R {
    const outer = flow
    begin(roots, host)
    const out = run()
    flow = outer
    return out
}

function settle(): void {
    drain()
    while (bindPendingRt()) drain()
}

export function solve(): number {
    settle()
    fillMissing()
    settle()
    const discovery = performance.now()
    while (pg.repairBounds()) settle()
    if (pg.bindDynamic()) settle()
    return discovery
}

function analyzeFlow(roots: Function[], host: AccessHost): void {
    const start = performance.now()
    const detail = new Set<string>()
    let dumpAll = false
    for (const a of argv) {
        if (a === 'flow-dump') dumpAll = true
        else if (a.startsWith('flow-dump:')) detail.add(a.slice('flow-dump:'.length))
    }
    begin(roots, host)
    for (const fn of roots) seedRoot(fn, 0)
    const discovery = solve()
    const end = performance.now()
    const out: string[] = []
    if (dumpAll || detail.size) pg.dumpFlow(detail, dumpAll, out)
    if (argv.includes('flow-cost') || dumpAll || detail.size > 0) out.push(`flow cost: work=${flow.work} nodes=${flow.totalNodes} ratio=${(flow.work / Math.max(1, flow.totalNodes)).toFixed(2)} fns=${flow.summaryList.length} instances=${flow.instances.length} slots=${flow.slotKind.length} origins=${flow.originKind.length} ms=${(end - start - flow.traceMs).toFixed(1)} trace=${flow.traceMs.toFixed(1)} (discovery ${(discovery - start).toFixed(1)}, resolve ${(end - discovery).toFixed(1)})`)
    if (out.length) console.log(out.join('\n'))
}

export function flowState(): FlowState {
    return flow
}
