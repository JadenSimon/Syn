/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { BitwiseOps, dumpGraph, type Graph, type GraphNode, NumericOps, typeName } from './lowering2'
import { addNode, childRegion, countIds, demandRegion, getLiteral, getNode, getRef, graphRegions, isThisParam, NodeOp, putCopy, regionUp, resultType, setRef, typeOf, type GraphRegions } from './graph-node'
import { Op as RtOp, assignExcluded, bindingOf, coercingOps, fallbackOps, elementType, isDelete, opName as rtName, relationalOps, sliceOf, wordOps } from './rt'
import { dataKeys } from './property-eval'
import * as pg from './pg-optimizer'
import type { GenericFlow } from './pg-optimizer'
import { AllocKind, boundCallee, constantIndex, constructedAllocation, emptyType, inhabited, keyLabel as propertyLabel, numberKey, regionRets, returnsSelf, type AccessHost, type Generic, type Accesses, type Allocation, type FrameSignature, type Location, type Site, type Type, type UnitTypes, type WordAccess } from './value-types'

type Handle = intrinsics.Handle

const Types = intrinsics.Types
const argv = intrinsics.argv()

const MinI64 = -(2 ** 63)
const MaxI64 = 2 ** 63
const MaxU64 = 2 ** 64
const maxStrings = 8
const maxLiterals = 8
const budgetFactor = 40

enum ScalarFlag {
    undef = 1,
    void = 2,
    int = 4,
    float = 8,
    str = 16,
    anyStr = 32,
    unknown = 64,
    no = 128,
    yes = 256,
}

interface Scalars {
    flags: number[]
    lo: number[]
    hi: number[]
    strs: number[][]
    nums: number[][]
    index: Map<string, number>
    unions: Map<number, Map<number, number>>
}

enum ExprOp {
    konst,
    origin,
    alloc,
    param,
    union,
    member,
    call,
    arith,
    cmp,
    num,
    rt,
    opaque,
    store,
    narrow,
    pick,
    gate,
    ntype,
}

interface Expr {
    op: ExprOp
    node: number
    a: number
    b: number
    key: number
    args: number[]
    sub: number
    type: number
    gates: number[] | undefined
}

interface Order {
    groups: number[][]
    users: (number[][] | undefined)[]
}

interface Summary {
    fn: Function
    id: number
    g: Graph
    name: string
    exprs: Expr[]
    exprOf: Map<number, number>
    konsts: Map<number, number>
    origins: Map<number, number>
    params: number
    hasThis: boolean
    usesCtx: boolean
    rets: number[]
    fresh: Set<number>
    scopes: Set<number>
    returnsFresh: boolean
    returnsSlice: boolean
    local: Int32Array | undefined
    width: number
    owned: number[]
    order: Order | undefined
    regions: GraphRegions | undefined
    tested: Set<number>
    guards: Map<number, Map<number, Guard>>
    narrowExprs: Map<number, Map<Guard, number>>
    gateOf: Map<number, number>
    stores: number[]
    cone: number[] | null | undefined
    allocNodes: Map<number, number>
    retExpr: number
    selects: number[]
    blockGates: number[][]
    regionRets: Map<number, number>
    predicates: Guard[] | null | undefined
    initializer: boolean | undefined
    bound: Bound | undefined
    proofs: pg.ProofScope | undefined
}

enum OriginKind {
    none,
    fn,
    static,
    fresh,
    slice,
    created,
    site,
    str,
}

enum SlotKind {
    expr,
    sig,
    ret,
    field,
    konst,
    part,
}

interface Bind {
    callee: number
    from: number
    kind: BindKind
    target: number
    recv: number
}

enum BindKind {
    virtual,
    call,
    rt,
}

enum FieldWatch {
    elem,
    assign,
    keyed,
    named,
}

enum ListenerKind {
    copy,
    member,
    callTarget,
    callRecv,
    rtSubject,
    store,
    assignSource,
    assignTarget,
    narrow,
    pick,
    offset,
}

interface Listener {
    kind: ListenerKind
    target: number
    key: number
    extra: number
    e: number
}

interface Instance {
    id: number
    summary: Summary
    qual: number
    base: number
    sigs: number[]
    ret: number
    callers: number[]
    lit: number
    litParam: number
    site: Instance | undefined
    map: Map<number, number> | undefined
}

interface FlowState {
    host: AccessHost
    roots: Function[]
    strOrigin: number
    dynamicOrigins: Set<number>
    spec: SpecState
    frames: FrameInfo[]
    unitKeys: Map<Function, number>
    work: number
    traceMs: number
    budget: number
    totalNodes: number
    summaries: Map<Function, Summary>
    summaryList: Summary[]
    instances: Instance[]
    instanceOf: Map<Function, Map<number, number>>
    originKind: number[]
    originCell: number[]
    originQual: number[]
    originFn: (Function | null | undefined)[]
    originProto: (Handle | undefined)[]
    originOwner: (Summary | undefined)[]
    originNode: number[]
    originIndex: Map<string, number>
    originFields: Map<number, number>[]
    fieldWatch: (number[] | undefined)[]
    originPending: (Map<number, number[]> | undefined)[]
    pickWatch: Map<number, number[]>
    freshOwner: Map<number, Summary>
    slotKind: number[]
    slotOwner: number[]
    slotIndex: number[]
    slotOrigins: number[][]
    slotOriginSet: (Set<number> | undefined)[]
    slotSent: number[]
    slotListeners: (Listener[] | undefined)[]
    slotIns: (number[] | undefined)[]
    slotConst: number[]
    slotOpaque: number[]
    queue: number[]
    storeSlots: Map<number, number>
    constSlots: Map<number, number>
    missing: number[]
    gateWaits: Map<number, number[]>
    scalar: number[]
    scalarUsers: (number[] | undefined)[]
    scalarQueue: number[]
    scalarQueued: number[]
    scalarChanges: number[]
    originMask: number[]
    stringSite: number[]
    fieldForms: Map<number, string[]>
    fieldReaders: Map<number, number[]>
    fieldWriters: Map<number, number[]>
    fieldStored: Set<number>
    originSeen: number[]
    originCopied: Set<number>
    heldInits: Map<number, Function>
    heldStatics: Set<number>
    rtPending: number[]
    parts: Map<number, Map<number, number>>
    partBind: Map<number, Bind>
    rooted: Set<number>
    originCreators: Map<number, number[]>
    originSeeds: Map<number, number[]>
    seedList: number[]
    setterKeys: Set<number>
    runtimeBinds: Map<number, number[]>
    heldWrites: Map<number, number[]>
    skippedKeys: Set<number>
    exported: Export
}

const elemKey = -1
const dynKey = -2
const maxTuple = 8
const posBase = -16

function posKey(i: number): number {
    return posBase - i
}

function isPosKey(key: number): boolean {
    return key <= posBase && key > posBase - maxTuple
}

let flow: FlowState
const scalars: Scalars = { flags: [], lo: [], hi: [], strs: [], nums: [], index: new Map(), unions: new Map() }

function scalar(flags: number, lo: number, hi: number, strs: number[], nums: number[] = []): number {
    if (!(flags & ScalarFlag.int)) {
        lo = 0
        hi = 0
        nums = []
    }
    if (nums.length < 2 || nums.length > maxLiterals) nums = []
    if (nums.length) {
        lo = nums[0]
        hi = nums[nums.length - 1]
    }
    if (nums.length === hi - lo + 1) nums = []
    if (lo < 0 && hi > MaxI64) {
        lo = MinI64
        hi = MaxI64
    }
    if (flags & ScalarFlag.anyStr) strs = []
    if (strs.length > maxStrings) {
        flags = flags | ScalarFlag.anyStr
        strs = []
    }
    if (strs.length) flags = flags | ScalarFlag.str
    else flags = flags & ~ScalarFlag.str
    const key = `${flags}|${lo}|${hi}|${strs.join(',')}|${nums.join(',')}`
    const known = scalars.index.get(key)
    if (known !== undefined) return known
    const id = scalars.flags.length
    scalars.flags.push(flags)
    scalars.lo.push(lo)
    scalars.hi.push(hi)
    scalars.strs.push(strs)
    scalars.nums.push(nums)
    scalars.index.set(key, id)
    return id
}

const NONE = scalar(0, 0, 0, [])
const UNDEF = scalar(ScalarFlag.undef, 0, 0, [])
const VOID = scalar(ScalarFlag.void, 0, 0, [])
const UNKNOWN = scalar(ScalarFlag.unknown, 0, 0, [])
const FLOAT = scalar(ScalarFlag.float, 0, 0, [])
const FALSE = scalar(ScalarFlag.no, 0, 0, [])
const TRUE = scalar(ScalarFlag.yes, 0, 0, [])
const BOOL = scalar(ScalarFlag.no | ScalarFlag.yes, 0, 0, [])
const ANYSTR = scalar(ScalarFlag.anyStr, 0, 0, [])
const U64 = scalar(ScalarFlag.int, 0, MaxU64, [])
const I64 = scalar(ScalarFlag.int, MinI64, MaxI64, [])

function numScalar(lo: number, hi: number): number {
    return scalar(ScalarFlag.int, lo, hi, [])
}

function truthScalar(truth: boolean): number {
    return truth ? TRUE : FALSE
}

function boolScalar(t: number): number {
    const f = scalars.flags[t]
    if (f & ScalarFlag.unknown) return BOOL
    let out = scalar(f & (ScalarFlag.no | ScalarFlag.yes), 0, 0, [])
    if (!(f & ScalarFlag.int)) return out
    if (scalars.lo[t] <= 0 && scalars.hi[t] >= 0 && (!scalars.nums[t].length || scalars.nums[t].includes(0))) out = unite(out, FALSE)
    if (scalars.lo[t] <= 1 && scalars.hi[t] >= 1 && (!scalars.nums[t].length || scalars.nums[t].includes(1))) out = unite(out, TRUE)
    return out
}

function boolNumbers(t: number): number {
    const f = scalars.flags[t]
    if (!(f & (ScalarFlag.no | ScalarFlag.yes))) return t
    let out = scalar(f & ~(ScalarFlag.no | ScalarFlag.yes), scalars.lo[t], scalars.hi[t], scalars.strs[t], scalars.nums[t])
    if (f & ScalarFlag.no) out = unite(out, numScalar(0, 0))
    if (f & ScalarFlag.yes) out = unite(out, numScalar(1, 1))
    return out
}

function literalScalar(v: number): number {
    if (!Number.isInteger(v)) return FLOAT
    return numScalar(v, v)
}

function literalsOf(t: number): number[] | undefined {
    if (!(scalars.flags[t] & ScalarFlag.int)) return undefined
    if (scalars.nums[t].length) return scalars.nums[t]
    if (scalars.lo[t] === scalars.hi[t]) return [scalars.lo[t]]
    return undefined
}

function strScalar(h: number): number {
    return scalar(ScalarFlag.str, 0, 0, [h])
}

function unite(a: number, b: number): number {
    if (a === b || b === NONE) return a
    if (a === NONE) return b
    const lo0 = a < b ? a : b
    const hi0 = a < b ? b : a
    let byHi = scalars.unions.get(lo0)
    if (!byHi) scalars.unions.set(lo0, byHi = new Map())
    const known = byHi.get(hi0)
    if (known !== undefined) return known
    const fa = scalars.flags[a]
    const fb = scalars.flags[b]
    const flags = fa | fb
    let lo = 0
    let hi = 0
    let nums: number[] = []
    if ((fa & ScalarFlag.int) && (fb & ScalarFlag.int)) {
        lo = Math.min(scalars.lo[a], scalars.lo[b])
        hi = Math.max(scalars.hi[a], scalars.hi[b])
        const la = literalsOf(a)
        const lb = literalsOf(b)
        if (la && lb) {
            nums = la.slice()
            for (const v of lb) if (!nums.includes(v)) nums.push(v)
            nums.sort((x, y) => x - y)
        }
    } else if (fa & ScalarFlag.int) {
        lo = scalars.lo[a]
        hi = scalars.hi[a]
        nums = scalars.nums[a]
    } else if (fb & ScalarFlag.int) {
        lo = scalars.lo[b]
        hi = scalars.hi[b]
        nums = scalars.nums[b]
    }
    let strs: number[] = []
    if (!(flags & ScalarFlag.anyStr)) {
        strs = scalars.strs[a].slice()
        for (const s of scalars.strs[b]) if (!strs.includes(s)) strs.push(s)
        strs.sort((x, y) => x - y)
    }
    const id = scalar(flags, lo, hi, strs, nums)
    byHi.set(hi0, id)
    return id
}

const typeRanges: number[] = []

function typeRange(T0: intrinsics.Types): number {
    const known = typeRanges[T0]
    if (known !== undefined) return known
    const t = rangeOf(T0)
    typeRanges[T0] = t
    return t
}

function rangeOf(T0: intrinsics.Types): number {
    if (T0 === Types.bool) return BOOL
    if (T0 === Types.f64 || T0 === Types.f32 || T0 === Types.f16) return FLOAT
    if (T0 === Types.u8) return numScalar(0, 255)
    if (T0 === Types.u16) return numScalar(0, 65535)
    if (T0 === Types.u32 || T0 === Types.usize || T0 === Types.handle) return numScalar(0, 2 ** 32 - 1)
    if (T0 === Types.i8) return numScalar(-128, 127)
    if (T0 === Types.i16) return numScalar(-32768, 32767)
    if (T0 === Types.i32) return numScalar(-(2 ** 31), 2 ** 31 - 1)
    if (T0 === Types.i64 || T0 === Types.unknown_number) return I64
    if (T0 === Types.vm_value || T0 === Types.unknown) return UNKNOWN
    return U64
}

function wrapped(lo: number, hi: number): number {
    if (lo >= 0 && hi <= MaxU64) return numScalar(lo, hi)
    if (lo >= MinI64 && hi <= MaxI64) return numScalar(lo, hi)
    return lo < 0 ? I64 : U64
}

function singleton(op: NodeOp, a: number, b: number): number {
    const small = a >= -(2 ** 31) && a < 2 ** 31 && b >= -(2 ** 31) && b < 2 ** 31
    switch (op) {
        case NodeOp.and: return small ? numScalar(a & b, a & b) : NONE
        case NodeOp.or: return small ? numScalar(a | b, a | b) : NONE
        case NodeOp.xor: return small ? numScalar(a ^ b, a ^ b) : NONE
        case NodeOp.div: return a >= 0 && b > 0 ? numScalar(Math.floor(a / b), Math.floor(a / b)) : NONE
        case NodeOp.rem: return a >= 0 && b > 0 ? numScalar(a % b, a % b) : NONE
    }
    return NONE
}

function interval(op: NodeOp, alo: number, ahi: number, blo: number, bhi: number): number {
    if (alo === ahi && blo === bhi && Number.isSafeInteger(alo) && Number.isSafeInteger(blo)) {
        const exact = singleton(op, alo, blo)
        if (exact !== NONE) return exact
    }
    switch (op) {
        case NodeOp.add: return wrapped(alo + blo, ahi + bhi)
        case NodeOp.sub: return wrapped(alo - bhi, ahi - blo)
        case NodeOp.subsat: return numScalar(Math.max(0, alo - bhi), Math.max(0, ahi - blo))
        case NodeOp.neg: return wrapped(-ahi, -alo)
        case NodeOp.mul: {
            const c0 = alo * blo
            const c1 = alo * bhi
            const c2 = ahi * blo
            const c3 = ahi * bhi
            return wrapped(Math.min(c0, c1, c2, c3), Math.max(c0, c1, c2, c3))
        }
        case NodeOp.shl: return alo >= 0 && blo >= 0 && bhi < 64 ? wrapped(alo * 2 ** blo, ahi * 2 ** bhi) : I64
        case NodeOp.shr:
        case NodeOp.ushr:
            if (alo >= 0 && blo >= 0) return numScalar(Math.floor(alo / 2 ** Math.min(bhi, 64)), Math.floor(ahi / 2 ** Math.min(blo, 64)))
            return op === NodeOp.ushr ? U64 : I64
        case NodeOp.and:
            if (alo >= 0 && blo >= 0) return numScalar(0, Math.min(ahi, bhi))
            if (alo >= 0) return numScalar(0, ahi)
            if (blo >= 0) return numScalar(0, bhi)
            return I64
        case NodeOp.or:
        case NodeOp.xor:
            return alo >= 0 && blo >= 0 ? numScalar(0, Math.min(MaxU64, 2 ** Math.ceil(Math.log2(Math.max(ahi, bhi) + 1)) - 1)) : I64
        case NodeOp.div:
        case NodeOp.rem:
            return alo >= 0 && blo >= 0 ? numScalar(0, ahi) : I64
        case NodeOp.not: return wrapped(-ahi - 1, -alo - 1)
        case NodeOp.clz: return numScalar(0, 64)
    }
    return alo >= 0 && blo >= 0 ? U64 : I64
}

function opaqueNumber(t0: number): number {
    const t = boolNumbers(t0)
    if (!(scalars.flags[t] & ScalarFlag.unknown)) return t
    return unite(withoutUnknown(t), numScalar(MinI64, MaxU64))
}

function truncated(t: number): number {
    if (!(scalars.flags[t] & ScalarFlag.float)) return t
    return unite(scalar(scalars.flags[t] & ~ScalarFlag.float, scalars.lo[t], scalars.hi[t], scalars.strs[t]), I64)
}

function arithScalar(op: NodeOp, T0: intrinsics.Types, a0: number, b0: number): number {
    const bitwise = BitwiseOps.has(op)
    if ((T0 === Types.f64 || T0 === Types.f32) && !bitwise) return FLOAT
    const a = bitwise ? truncated(opaqueNumber(a0)) : opaqueNumber(a0)
    const b = bitwise ? truncated(opaqueNumber(b0)) : opaqueNumber(b0)
    const fa = scalars.flags[a]
    const fb = scalars.flags[b]
    if (!((fa | fb) & (ScalarFlag.int | ScalarFlag.float))) return NONE
    let out = NONE
    if ((fa | fb) & ScalarFlag.float) out = FLOAT
    if ((fa & ScalarFlag.int) && (fb & ScalarFlag.int)) out = unite(out, interval(op, scalars.lo[a], scalars.hi[a], scalars.lo[b], scalars.hi[b]))
    if (T0 !== Types.unknown_number && T0 !== Types.u64 && T0 !== Types.i64 && (scalars.flags[out] & ScalarFlag.int)) {
        const bound = typeRange(T0)
        if ((scalars.flags[bound] & ScalarFlag.int) && (scalars.lo[out] < scalars.lo[bound] || scalars.hi[out] > scalars.hi[bound])) out = unite(scalars.flags[out] & ScalarFlag.float ? FLOAT : NONE, bound)
    }
    return out
}

function charge(n: number): void {
    flow.work += n
    if (flow.work > flow.budget) throw `value-flow: budget exceeded (work ${flow.work} > ${budgetFactor} * ${flow.totalNodes} nodes)\n${new Error().stack}`
}

function newSlot(kind: SlotKind, owner: number, index: number): number {
    const id = flow.slotKind.length
    flow.slotKind.push(kind)
    flow.slotOwner.push(owner)
    flow.slotIndex.push(index)
    flow.slotOrigins.push([])
    flow.slotOriginSet.push(undefined)
    flow.slotSent.push(0)
    flow.slotListeners.push(undefined)
    flow.slotIns.push(undefined)
    flow.slotConst.push(NONE)
    flow.slotOpaque.push(0)
    flow.scalar.push(NONE)
    flow.scalarUsers.push(undefined)
    flow.scalarQueued.push(0)
    flow.scalarChanges.push(0)
    flow.originMask.push(0)
    flow.stringSite.push(0)
    dirtyScalar(id)
    return id
}

function dirtyScalar(s: number): void {
    if (flow.scalarQueued[s]) return
    flow.scalarQueued[s] = 1
    flow.scalarQueue.push(s)
}

function scalarUse(from: number, to: number): void {
    let users = flow.scalarUsers[from]
    if (!users) flow.scalarUsers[from] = users = []
    users.push(to)
}

function dirtyUsers(s: number): void {
    const users = flow.scalarUsers[s]
    if (users) for (const u of users) dirtyScalar(u)
}

function markOpaque(s: number): void {
    if (flow.slotOpaque[s]) return
    flow.slotOpaque[s] = 1
    dirtyScalar(s)
}

function originBit(origin: number): number {
    if (flow.originKind[origin] === OriginKind.str) return 3
    return originHostFn(origin) ? 5 : 9
}

function noteOrigin(s: number, origin: number): void {
    const mask = flow.originMask[s]
    if (mask === 15) return
    const next = mask | originBit(origin)
    if (next === mask) return
    flow.originMask[s] = next
    dirtyUsers(s)
}

function addConst(s: number, t: number): void {
    const next = unite(flow.slotConst[s], t)
    if (next === flow.slotConst[s]) return
    flow.slotConst[s] = next
    dirtyScalar(s)
    if (flow.pickWatch.size && flow.slotKind[s] === SlotKind.field) recheckPicks(s)
}

function addIn(s: number, from: number): void {
    let ins = flow.slotIns[s]
    if (!ins) flow.slotIns[s] = ins = []
    ins.push(from)
    scalarUse(from >= 0 ? from : -from - 1, s)
    dirtyScalar(s)
    if (flow.pickWatch.size && flow.slotKind[s] === SlotKind.field) recheckPicks(s)
}

function addOrigin(s: number, origin: number): void {
    let set = flow.slotOriginSet[s]
    if (!set) flow.slotOriginSet[s] = set = new Set()
    if (set.has(origin)) return
    set.add(origin)
    flow.slotOrigins[s].push(origin)
    flow.queue.push(s)
    noteOrigin(s, origin)
    if (flow.pickWatch.size && flow.slotKind[s] === SlotKind.field) recheckPicks(s)
}

function listen(s: number, kind: ListenerKind, target: number, key: number, extra: number, e: number = 0): void {
    let list = flow.slotListeners[s]
    if (!list) flow.slotListeners[s] = list = []
    const l: Listener = { kind, target, key, extra, e }
    list.push(l)
    const origins = flow.slotOrigins[s]
    const sent = flow.slotSent[s]
    for (let i = 0; i < sent; i++) deliver(l, origins[i])
}

const exprBits = 1048576

function writerId(inst: Instance, e: number): number {
    intrinsics.assert(e < exprBits, `value-flow: expression index ${e} of ${inst.summary.name} does not fit a writer id`)
    return inst.id * exprBits + e
}

function storeSlot(inst: Instance, e: number): number {
    const key = writerId(inst, e)
    const known = flow.storeSlots.get(key)
    if (known !== undefined) return known
    const slot = newSlot(SlotKind.expr, inst.id, e)
    flow.storeSlots.set(key, slot)
    exprUses(slot)
    return slot
}

function copyEdge(from: number, to: number): void {
    addIn(to, from)
    listen(from, ListenerKind.copy, to, 0, 0)
}

function partSlot(target: number, key: number): number {
    let byKey = flow.parts.get(target)
    if (!byKey) flow.parts.set(target, byKey = new Map())
    const known = byKey.get(key)
    if (known !== undefined) return known
    const p = newSlot(SlotKind.part, target, key)
    byKey.set(key, p)
    copyEdge(p, target)
    return p
}

function ownerSlot(slot: number): number {
    let at = slot
    while (flow.slotKind[at] === SlotKind.part) at = flow.slotOwner[at]
    return at
}

function drain(): void {
    let next = 0
    for (;;) {
        if (next >= flow.queue.length) {
            if (flow.seedList.length) {
                seedPending()
                continue
            }
            if (!flow.scalarQueue.length) break
            drainScalars()
            continue
        }
        const s = flow.queue[next++]
        const origins = flow.slotOrigins[s]
        while (flow.slotSent[s] < origins.length) {
            const origin = origins[flow.slotSent[s]]
            flow.slotSent[s]++
            const list = flow.slotListeners[s]
            if (!list) continue
            for (let i = 0; i < list.length; i++) deliver(list[i], origin)
        }
    }
    flow.queue.length = 0
}

function originOf(kind: OriginKind, cell: number, qual: number, node: number, owner: Summary | undefined): number {
    const k = `${kind}:${cell}:${qual}:${node}:${owner ? owner.id : 0}`
    const known = flow.originIndex.get(k)
    if (known !== undefined) return known
    const id = flow.originKind.length
    flow.originIndex.set(k, id)
    flow.originKind.push(kind)
    flow.originCell.push(cell)
    flow.originQual.push(qual)
    flow.originFn.push(kind === OriginKind.static || (kind === OriginKind.fresh && !owner!.scopes.has(cell)) ? undefined : null)
    flow.originProto.push(undefined)
    flow.originOwner.push(owner)
    flow.originNode.push(node)
    flow.originFields.push(new Map())
    flow.fieldWatch.push(undefined)
    flow.originPending.push(undefined)
    flow.originSeen.push(0)
    if (kind === OriginKind.static || kind === OriginKind.fresh) flow.seedList.push(id)
    return id
}

function seedPending(): void {
    while (flow.seedList.length) {
        const origin = flow.seedList.pop()!
        if (flow.originKind[origin] === OriginKind.static && originHostFn(origin)) continue
        const state = heapState(origin)
        if (state === undefined || (!heap.isOrdinaryObject(state) && !originHostFn(origin))) continue
        const keys = dataKeys(state)
        charge(keys.length)
        for (const key of keys) fieldSlot(origin, key as number)
    }
}

function constantBuffer(origin: number, s: number, value: Handle): boolean {
    if (flow.originKind[origin] !== OriginKind.static || !flow.host.constantElements) return false
    const cell = flow.originCell[origin]
    const construction = flow.host.session.constructions.get(cell as u32)?.graph
    if (!construction || !constructedAllocation(construction, value)) return false
    const elements = flow.host.constantElements(heap.deref(cell as Handle))
    if (!elements) return false
    const buffer = originOf(OriginKind.slice, cell, origin, 0, undefined)
    flow.originSeen[buffer] = flow.originSeen[origin]
    for (let i = 0; i < elements.length; i++) {
        const f = fieldSlot(buffer, elements.length > maxTuple ? elemKey : posKey(i))
        addForm(f, 'vm_value')
        heapValue(elements[i], f, 0, undefined, 0)
    }
    addOrigin(s, buffer)
    return true
}

function originFunction(origin: number): Function | undefined {
    const fn = originHostFn(origin)
    if (!fn || flow.originKind[origin] === OriginKind.fn) return fn
    return flow.host.traceable(fn) ? fn : undefined
}

function originHostFn(origin: number): Function | undefined {
    const known = flow.originFn[origin]
    if (known !== undefined) return known ?? undefined
    const cell = flow.originCell[origin]
    const fn = cell <= 1 || heap.isString(cell as Handle) || heap.isBoxedF64(cell as Handle) ? undefined : flow.host.functionOf(cell as u32)
    flow.originFn[origin] = fn ?? null
    return fn
}

function callableOf(cell: number): Function | undefined {
    if (cell <= 1 || heap.isString(cell as Handle) || heap.isBoxedF64(cell as Handle)) return
    const fn = flow.host.functionOf(cell as u32)
    return fn && flow.host.traceable(fn) ? fn : undefined
}

function fnOrigin(fn: Function): number {
    const s = summaryOf(fn)
    const id = originOf(OriginKind.fn, 0, 0, 0, s)
    flow.originFn[id] = fn
    return id
}

function strOrigin(): number {
    if (flow.strOrigin < 0) flow.strOrigin = originOf(OriginKind.str, heap.typeNames.string as number, 0, 0, undefined)
    return flow.strOrigin
}

function qualOf(origin: number): number {
    return flow.originKind[origin] === OriginKind.str ? 0 : origin
}

function qualified(kind: OriginKind, cell: number, qual: number, node: number, owner: Summary): number {
    while (qual > 0 && flow.originOwner[qual] === owner) qual = flow.originQual[qual]
    let at = qual
    while (at > 0) {
        if (flow.originKind[at] === kind && flow.originCell[at] === cell && flow.originNode[at] === node && flow.originOwner[at] === owner && sameQualifier(flow.originQual[at], qual)) return at
        at = flow.originQual[at]
    }
    return originOf(kind, cell, qual, node, owner)
}

function sameQualifier(a: number, b: number): boolean {
    if (a <= 0 || b <= 0) return a === b
    return flow.originKind[a] === flow.originKind[b] && flow.originCell[a] === flow.originCell[b] && flow.originNode[a] === flow.originNode[b] && flow.originOwner[a] === flow.originOwner[b]
}

function staticOrigin(cell: number): number {
    const owner = flow.freshOwner.get(cell)
    if (owner) return originOf(OriginKind.fresh, cell, 0, 0, owner)
    return originOf(OriginKind.static, cell, 0, 0, undefined)
}

function isScope(origin: number): boolean {
    return flow.originKind[origin] === OriginKind.fresh && flow.originOwner[origin]!.scopes.has(flow.originCell[origin])
}

function fieldSlot(origin: number, key: number): number {
    const fields = flow.originFields[origin]
    const known = fields.get(key)
    if (known !== undefined) return known
    const s = newSlot(SlotKind.field, origin, key)
    fields.set(key, s)
    seedField(origin, key, s)
    const pending = flow.originPending[origin]?.get(key)
    if (pending) for (const target of pending) readField(s, target)
    const watch = flow.fieldWatch[origin]
    if (watch) for (let i = 0; i < watch.length; i += 2) fieldSeen(watch[i], watch[i + 1], key, s)
    return s
}

function watchFields(origin: number, kind: FieldWatch, target: number): void {
    let list = flow.fieldWatch[origin]
    if (!list) flow.fieldWatch[origin] = list = []
    list.push(kind, target)
    for (const [key, s] of flow.originFields[origin]) fieldSeen(kind, target, key, s)
}

function fieldSeen(kind: FieldWatch, target: number, key: number, s: number): void {
    switch (kind) {
        case FieldWatch.elem: if (isPosKey(key)) readField(s, target)
        case FieldWatch.assign: assignField(target, key, s)
        case FieldWatch.keyed: if (key >= 0 || key === dynKey) readField(s, target)
        case FieldWatch.named: if (key === dynKey) keyedInto(s, target)
    }
}

function keyedRead(origin: number, target: number): void {
    const state = heapState(origin)
    if (state !== undefined && heap.isOrdinaryObject(state)) for (const key of dataKeys(state)) fieldSlot(origin, key as number)
    watchFields(origin, FieldWatch.keyed, target)
    addConst(target, UNDEF)
}

function namedRead(origin: number, target: number): void {
    watchFields(origin, FieldWatch.named, target)
}

function keyedInto(keyed: number, target: number): void {
    readField(keyed, target)
    addConst(target, UNDEF)
}

function heapState(origin: number): Handle | undefined {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.static) return heap.deref(flow.originCell[origin] as Handle)
    if (kind !== OriginKind.fresh || isScope(origin)) return undefined
    const cell = flow.originCell[origin] as Handle
    if (flow.host.session.templateOf(cell as u32)) return heap.deref(cell)
    if (originHostFn(origin)) return heap.isIndirect(cell) ? heap.indirectTarget(cell) : heap.deref(cell)
    return undefined
}

function seedField(origin: number, key: number, s: number): void {
    if (key < 0) return
    const state = heapState(origin)
    if (state === undefined) return
    const descriptor = heap.getOwnProperty(state, key as Handle)
    if (!descriptor) return
    const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
    if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
    addForm(s, 'init')
    if (constantBuffer(origin, s, d.slot0 as Handle)) return
    heapValue(d.slot0 as Handle, s, flow.originQual[origin], flow.originOwner[origin], origin)
}

function addForm(field: number, form: string): void {
    let list = flow.fieldForms.get(field)
    if (!list) flow.fieldForms.set(field, list = [])
    if (!list.includes(form)) list.push(form)
}

function heldStatic(init: Function): number {
    const id = instance(init, 0, -1, -1)
    flow.heldStatics.add(id)
    return id
}

function readField(field: number, target: number): void {
    const init = flow.heldInits.get(field)
    if (init) {
        flow.heldInits.delete(field)
        copyEdge(flow.instances[heldStatic(init)].ret, field)
    }
    copyEdge(field, target)
    let list = flow.fieldReaders.get(field)
    if (!list) flow.fieldReaders.set(field, list = [])
    list.push(ownerSlot(target))
}

function writeField(field: number, value: number, writer: number, form: string, stored: boolean): void {
    copyEdge(value, field)
    addForm(field, form)
    if (stored) flow.fieldStored.add(field)
    let list = flow.fieldWriters.get(field)
    if (!list) flow.fieldWriters.set(field, list = [])
    if (!list.includes(writer)) list.push(writer)
}

function created(origin: number, inst: Instance): number {
    const owner = inst.site ?? inst
    let list = flow.originCreators.get(origin)
    if (!list) flow.originCreators.set(origin, list = [])
    if (list.includes(owner.id)) return origin
    list.push(owner.id)
    const seeds = flow.originSeeds.get(origin)
    if (seeds) for (let i = 0; i < seeds.length; i += 2) copyEdge(at(owner, seeds[i + 1]), seeds[i])
    return origin
}

function heapValue(value: Handle, s: number, qual: number, owner: Summary | undefined, seeded: number): void {
    if (!value || heap.isNullishHandle(value)) return addConst(s, UNDEF)
    const init = flow.host.session.statics.get(value)
    if (init && flow.host.traceable(init)) {
        if (flow.slotKind[s] === SlotKind.field && !flow.fieldReaders.has(s)) {
            flow.heldInits.set(s, init)
            return
        }
        return copyEdge(flow.instances[heldStatic(init)].ret, s)
    }
    if (heap.isBoxedF64(value)) {
        const id = heap.boxedNanId(value)
        if (!id) return addConst(s, literalScalar(heap.unboxF64(value)))
        const e = owner?.exprOf.get(id)
        if (e !== undefined && seeded > 0) {
            let seeds = flow.originSeeds.get(seeded)
            if (!seeds) flow.originSeeds.set(seeded, seeds = [])
            seeds.push(s, e)
            for (const c of flow.originCreators.get(seeded) ?? []) copyEdge(at(flow.instances[c], e), s)
            return
        }
        return addConst(s, UNKNOWN)
    }
    if (heap.isString(value)) {
        addConst(s, strScalar(value))
        return addOrigin(s, strOrigin())
    }
    const cell = flow.host.session.runtime!.objects.intern(flow.host.heapValue ? flow.host.heapValue(value) : value) as number
    if (opaqueHandle(cell)) return addConst(s, UNKNOWN)
    const own = flow.freshOwner.get(cell)
    if (own) return addOrigin(s, own === owner ? qualified(OriginKind.fresh, cell, qual, 0, own) : originOf(OriginKind.fresh, cell, 0, 0, own))
    const origin = staticOrigin(cell)
    addOrigin(s, origin)
}


function opaqueHandle(cell: number): boolean {
    if (heap.isFrameProxy(cell as Handle) || flow.host.functionOf(cell as u32)) return false
    const inner = heap.deref(cell as Handle)
    return !inner || !heap.isOrdinaryObject(inner)
}

function summaryOf(fn: Function): Summary {
    const known = flow.summaries.get(fn)
    if (known) return known
    const traceStart = performance.now()
    const g = flow.host.graphOf(fn)
    flow.traceMs += performance.now() - traceStart
    const cells = flow.host.freshCells!(fn)
    const fresh = new Set<number>()
    for (const c of cells.allocations) fresh.add(c)
    for (const c of cells.closures) fresh.add(c)
    for (const c of cells.frames) fresh.add(c)
    const s: Summary = {
        fn, id: flow.summaryList.length + 1, g, name: fn.name || '<anon>', exprs: [], exprOf: new Map(), konsts: new Map(), origins: new Map(),
        params: 0, hasThis: false, usesCtx: false, rets: [], fresh, scopes: new Set(cells.frames), returnsFresh: false, returnsSlice: false,
        local: undefined, width: 0, owned: [], order: undefined, regions: undefined, tested: new Set(), guards: new Map(), narrowExprs: new Map(), gateOf: new Map(), stores: [], cone: undefined, allocNodes: new Map(), retExpr: -1, selects: [], blockGates: [], regionRets: new Map(), predicates: undefined, initializer: undefined, bound: undefined, proofs: undefined,
    }
    flow.summaries.set(fn, s)
    flow.summaryList.push(s)
    for (const cell of fresh) flow.freshOwner.set(cell, s)
    flow.totalNodes += g.nodes.size
    flow.budget = budgetFactor * flow.totalNodes
    buildSummary(s)
    return s
}

function expr(s: Summary, op: ExprOp, node: number, a: number, b: number, key: number, args: number[], sub: number): number {
    const id = s.exprs.length
    const type = node > 0 && op !== ExprOp.konst && op !== ExprOp.origin && op !== ExprOp.param && op !== ExprOp.union ? nodeType(s.g, node) : -1
    s.exprs.push({ op, node, a, b, key, args, sub, type, gates: undefined })
    return id
}

function nodeType(g: Graph, id: number): number {
    const n = getNode(g, id)
    if (!n || n.op === NodeOp.param || n.op === NodeOp.after || n.op === NodeOp.select || n.op === NodeOp.inlined) return -1
    if (n.op === NodeOp.rt && getLiteral(g, n, 1) === RtOp.sliceWrite) return elementType(g, n)
    if (n.op === NodeOp.store) return typeOf(n)
    const T0 = resultType(g, n)
    if (BitwiseOps.has(n.op) && (T0 === Types.f64 || T0 === Types.f32)) return Types.i64
    if (T0 === Types.u64 && n.op !== NodeOp.load && n.op !== NodeOp.convert && n.op !== NodeOp.bitconvert && !NumericOps.has(n.op)) return -1
    return T0
}

function opaqueScalar(s: Summary, x: Expr): number {
    const n = x.node ? getNode(s.g, x.node) : undefined
    if (!n) return UNKNOWN
    const T0 = resultType(s.g, n)
    if (T0 === Types.vm_value || T0 === Types.unknown || T0 === Types.void) return UNKNOWN
    return typeRange(T0)
}

function withoutUnknown(t: number): number {
    const f = scalars.flags[t]
    return scalar(f & ~ScalarFlag.unknown, scalars.lo[t], scalars.hi[t], scalars.strs[t], scalars.nums[t])
}

function withoutNumbers(t: number): number {
    const f = scalars.flags[t]
    return scalar(f & ~(ScalarFlag.int | ScalarFlag.float), 0, 0, scalars.strs[t])
}

function typedScalar(t: number, T0: number): number {
    if (T0 < 0 || t === NONE) return t
    if (T0 === Types.bool) return boolScalar(t)
    const f = scalars.flags[t]
    if (T0 === Types.unknown_number) return f & ScalarFlag.unknown ? unite(withoutUnknown(t), FLOAT) : t
    if (T0 === Types.u64 || T0 === Types.usize || T0 === Types.ptr) return f & ScalarFlag.unknown ? unite(withoutUnknown(t), typeRange(T0)) : t
    if (T0 === Types.vm_value || T0 === Types.fnptr || T0 === Types.void || T0 === Types.unknown || T0 === Types.handle) return t
    const bound = typeRange(T0)
    let out = f & ScalarFlag.unknown ? unite(withoutUnknown(t), bound) : t
    const g = scalars.flags[out]
    if (!(g & (ScalarFlag.int | ScalarFlag.float))) return out
    if (bound === FLOAT) return g & ScalarFlag.int ? unite(withoutNumbers(out), FLOAT) : out
    if (g & ScalarFlag.float || scalars.lo[out] < scalars.lo[bound] || scalars.hi[out] > scalars.hi[bound]) out = unite(withoutNumbers(out), bound)
    return out
}

function konst(s: Summary, t: number): number {
    const known = s.konsts.get(t)
    if (known !== undefined) return known
    const id = expr(s, ExprOp.konst, 0, t, 0, 0, [], 0)
    s.konsts.set(t, id)
    return id
}

function pullMember(s: Summary, e: number, cell: number): void {
    const x = s.exprs[e]
    const object = addNode(s.g, NodeOp.heapHandle, [{ literal: cell }])
    putCopy(s.g, x.node, getNode(s.g, x.node)!)
    setRef(getNode(s.g, x.node)!, 1, object)
    const origin = staticOrigin(cell)
    const pulled = originExpr(s, origin)
    s.exprOf.set(object, pulled)
    const local = layout(s)
    if (pulled >= local.length) {
        const grown = new Int32Array(s.exprs.length)
        grown.set(local)
        s.local = grown
    }
    s.local![pulled] = -constSlot(NONE, origin) - 1
    x.a = pulled
    for (const inst of flow.instances) {
        if (inst.summary !== s || (inst.map && !inst.map.has(e))) continue
        listen(constSlot(NONE, origin), ListenerKind.member, at(inst, e), x.key, 0)
    }
}

function methodOrigin(cell: number): number {
    const origin = staticOrigin(cell)
    return originFunction(origin) ? origin : 0
}

function originExpr(s: Summary, origin: number): number {
    const known = s.origins.get(origin)
    if (known !== undefined) return known
    const id = expr(s, ExprOp.origin, 0, origin, 0, 0, [], 0)
    s.origins.set(origin, id)
    return id
}

function operand(s: Summary, user: number, n: GraphNode, i: number): number {
    const ref = getRef(n, i)
    if (!ref) return konst(s, literalScalar(getLiteral(s.g, n, i)))
    const base = exprOfNode(s, ref)
    const region = s.regions ? demandRegion(s.regions, user, n, i) : -1
    return region < 0 ? base : narrowed(s, ref, base, region)
}

const arithOps = new Set<NodeOp>([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.subsat, NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.neg, NodeOp.not, NodeOp.clz])
const compareOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne])
const numberOps = new Set<NodeOp>([NodeOp.load, NodeOp.convert, NodeOp.bitconvert, NodeOp.pstack, NodeOp.stackalloc, NodeOp.mem, NodeOp.crc32, NodeOp.frameAddress, NodeOp.pc, NodeOp.poolEntry])
const neverOps = new Set<NodeOp>([NodeOp.ret, NodeOp.apply, NodeOp.panic, NodeOp.trap, NodeOp.unreachable, NodeOp.nilEffect, NodeOp.block, NodeOp.store, NodeOp.stackfree])

function orderingCall(g: Graph, id: number): number {
    const n = id ? getNode(g, id) : undefined
    if (n?.op !== NodeOp.after) return 0
    for (let i = 0; i < countIds(n) - 1; i++) {
        if (getNode(g, getRef(n, i))?.op === NodeOp.inlined) return getRef(n, i)
    }
    return 0
}

function exprOfNode(s: Summary, id: number): number {
    const known = s.exprOf.get(id)
    if (known !== undefined) return known
    const g = s.g
    const n = getNode(g, id)
    if (!n) return konst(s, UNKNOWN)
    charge(1)
    let e = -1
    const op = n.op
    if (op === NodeOp.after) {
        e = operand(s, id, n, countIds(n) - 1)
    } else if (op === NodeOp.param) {
        e = expr(s, ExprOp.union, id, 0, 0, 0, [], 0)
    } else if (op === NodeOp.heapHandle) {
        const cell = getLiteral(g, n, 0)
        if (heap.isNullishHandle(cell as Handle)) e = konst(s, UNDEF)
        else if (heap.isString(cell as Handle)) e = expr(s, ExprOp.konst, id, strScalar(cell), 0, 0, [], strOrigin())
        else if (s.fresh.has(cell)) {
            e = expr(s, ExprOp.alloc, id, cell, 0, 0, [], 0)
            if (!s.allocNodes.has(cell)) s.allocNodes.set(cell, id)
        } else if (opaqueHandle(cell)) {
            e = konst(s, UNKNOWN)
        } else {
            const origin = staticOrigin(cell)
            intrinsics.assert(id < 16777216, `value-flow: node ${id} of ${s.name} does not fit a seen-site key`)
            if (!flow.originSeen[origin]) flow.originSeen[origin] = s.id * 16777216 + id
            e = originExpr(s, origin)
        }
    } else if (op === NodeOp.localTarget) {
        const fn = flow.host.localFunction(getLiteral(g, n, 0))
        e = fn && flow.host.traceable(fn) ? originExpr(s, fnOrigin(fn)) : expr(s, ExprOp.opaque, id, 0, 0, 0, [], 0)
    } else if (op === NodeOp.callContext) {
        s.usesCtx = true
        e = expr(s, ExprOp.param, id, -2, 0, 0, [], 0)
    } else if (op === NodeOp.getProp) {
        const obj = operand(s, id, n, 1)
        const keyRef = getRef(n, 2)
        e = keyRef ? expr(s, ExprOp.member, id, obj, exprOfNode(s, keyRef), dynKey, [], 0) : expr(s, ExprOp.member, id, obj, 0, getLiteral(g, n, 2), [], 0)
    } else if (op === NodeOp.setProp) {
        const obj = operand(s, id, n, 1)
        const keyRef = getRef(n, 2)
        const value = operand(s, id, n, 3)
        e = keyRef ? expr(s, ExprOp.store, id, obj, value, dynKey, [exprOfNode(s, keyRef)], 0) : expr(s, ExprOp.store, id, obj, value, getLiteral(g, n, 2), [], 0)
    } else if (op === NodeOp.call) {
        const target = getRef(n, 1) ? operand(s, id, n, 1) : -1
        const recv = getRef(n, 2) ? operand(s, id, n, 2) : konst(s, UNDEF)
        const args: number[] = []
        for (let i = 3; i < countIds(n); i++) args.push(operand(s, id, n, i))
        const opaque = target < 0 || s.exprs[target].op === ExprOp.opaque || s.exprs[target].op === ExprOp.konst || s.exprs[target].op === ExprOp.num
        e = opaque ? expr(s, ExprOp.opaque, id, 0, 0, 0, args, 0) : expr(s, ExprOp.call, id, target, recv, 0, args, 0)
    } else if (op === NodeOp.static) {
        const target = operand(s, id, n, 0)
        const opaque = s.exprs[target].op !== ExprOp.origin
        e = opaque ? expr(s, ExprOp.opaque, id, 0, 0, 0, [], 0) : expr(s, ExprOp.call, id, target, konst(s, UNDEF), 0, [], 0)
    } else if (op === NodeOp.select) {
        e = expr(s, ExprOp.union, id, 0, 0, 0, [operand(s, id, n, 1), operand(s, id, n, 2)], 0)
        s.selects.push(e)
    } else if (op === NodeOp.inlined) {
        e = expr(s, ExprOp.union, id, 0, 0, 0, [operand(s, id, n, 0)], 0)
        s.exprs[e].gates = [-1]
    } else if (op === NodeOp.typeof) {
        e = expr(s, ExprOp.ntype, id, operand(s, id, n, 0), 0, 0, [], 0)
    } else if (op === NodeOp.void) {
        e = konst(s, UNDEF)
    } else if (arithOps.has(op)) {
        const a = operand(s, id, n, 0)
        const b = countIds(n) > 1 ? operand(s, id, n, 1) : konst(s, literalScalar(0))
        e = expr(s, ExprOp.arith, id, a, b, op, [], typeOf(n))
    } else if (compareOps.has(op)) {
        e = expr(s, ExprOp.cmp, id, operand(s, id, n, 0), operand(s, id, n, 1), op, [], 0)
    } else if (op === NodeOp.literal) {
        e = konst(s, typeOf(n) === Types.f64 ? FLOAT : typeOf(n) === Types.bool ? truthScalar(getLiteral(g, n, 0) !== 0) : literalScalar(getLiteral(g, n, 0)))
    } else if (op === NodeOp.pstack && (getRef(n, 3) || getLiteral(g, n, 3) > 0)) {
        e = expr(s, ExprOp.rt, id, RtOp.slice, 0, 0, [], 0)
    } else if (op === NodeOp.store) {
        e = expr(s, ExprOp.rt, id, RtOp.sliceWrite, 0, 0, [operand(s, id, n, 1), operand(s, id, n, 2), operand(s, id, n, 3)], 0)
    } else if (numberOps.has(op)) {
        const T0 = typeOf(n)
        e = expr(s, ExprOp.num, id, T0 === Types.vm_value || T0 === Types.unknown ? UNKNOWN : typeRange(T0), 0, 0, [], 0)
    } else if (isDelete(g, n)) {
        const obj = operand(s, id, n, 2)
        const keyRef = getRef(n, 3)
        const value = konst(s, UNDEF)
        e = keyRef ? expr(s, ExprOp.store, id, obj, value, dynKey, [exprOfNode(s, keyRef)], 0) : expr(s, ExprOp.store, id, obj, value, getLiteral(g, n, 3), [], 0)
    } else if (op === NodeOp.rt && getLiteral(g, n, 1) === RtOp.addOrConcat) {
        e = expr(s, ExprOp.arith, id, operand(s, id, n, 2), operand(s, id, n, 3), NodeOp.add, [], Types.unknown_number)
    } else if (op === NodeOp.rt) {
        const args: number[] = []
        for (let i = 2; i < countIds(n); i++) args.push(operand(s, id, n, i))
        e = expr(s, ExprOp.rt, id, getLiteral(g, n, 1), 0, 0, args, 0)
    } else if (neverOps.has(op)) {
        e = konst(s, NONE)
    } else {
        e = expr(s, ExprOp.opaque, id, 0, 0, 0, [], 0)
    }
    s.exprOf.set(id, e)
    return e
}

enum GuardFlag {
    truthy = 1,
    falsy = 2,
    nullish = 4,
    defined = 8,
    isNumber = 16,
    isString = 32,
    isObject = 64,
    isFunction = 128,
    isUndefined = 256,
    notNumber = 512,
    notString = 1024,
    notObject = 2048,
    notFunction = 4096,
    notUndefined = 8192,
    bounded = 16384,
    nonzero = 32768,
    isBoolean = 65536,
    notBoolean = 131072,
    notTrue = 262144,
    notFalse = 524288,
    hasProto = 1048576,
    lacksProto = 2097152,
}

function computeRegions(s: Summary): GraphRegions {
    const g = s.g
    const regions = graphRegions(g, charge)
    s.regions = regions
    const seenConds = new Set<number>()
    for (const id of regions.blockOf.keys()) {
        const n = getNode(g, id)!
        if (n.op === NodeOp.select) testedRefs(s, getRef(n, 0), seenConds)
    }
    return regions
}

function testedRefs(s: Summary, cond: number, seen: Set<number>): void {
    const g = s.g
    const out = s.tested
    const [id] = pg.condition(g, cond, true)
    const n = id ? getNode(g, id) : undefined
    if (!n || seen.has(id)) return
    seen.add(id)
    charge(1)
    out.add(id)
    if (n.op === NodeOp.getProp) {
        if (getRef(n, 1)) out.add(getRef(n, 1))
        return
    }
    if (n.op === NodeOp.call) {
        for (let i = 3; i < countIds(n); i++) {
            const r = getRef(n, i)
            if (!r) continue
            out.add(r)
        }
        return
    }
    if (n.op === NodeOp.rt && getLiteral(g, n, 1) === RtOp.hasPrototype && getRef(n, 2)) {
        out.add(getRef(n, 2))
        return
    }
    const block = s.regions ? s.regions.paramBlock.get(id) : undefined
    if (n.op === NodeOp.param && block) {
        const index = g.blocks[block].params.indexOf(id)
        for (const apply of s.regions!.arrivals[block]) {
            const arg = getRef(getNode(g, apply)!, index + 1)
            if (arg) testedRefs(s, arg, seen)
        }
        return
    }
    if (!compareOps.has(n.op)) return
    for (let i = 0; i < 2; i++) {
        const r = getRef(n, i)
        if (!r) continue
        out.add(r)
        const m = getNode(g, strippedRef(g, r))
        if (m?.op === NodeOp.rt && getRef(m, 2)) out.add(getRef(m, 2))
    }
}

function strippedRef(g: Graph, id: number): number {
    let n = getNode(g, id)
    while (n?.op === NodeOp.after) {
        id = getRef(n, countIds(n) - 1)
        n = getNode(g, id)
    }
    return id
}

interface Guard {
    flags: number
    lo: number
    hi: number
    picks: number[]
    protos?: number[]
}

const noGuard: Guard = { flags: 0, lo: MinI64, hi: MaxU64, picks: [] }
const deadGuard: Guard = { flags: GuardFlag.truthy | GuardFlag.falsy | GuardFlag.nullish, lo: MinI64, hi: MaxU64, picks: [] }

function narrowed(s: Summary, ref: number, base: number, use: number): number {
    const regions = s.regions!
    if (regions.depth[use] === 0 && regions.link[use] < 0) return base
    if (!s.tested.has(ref)) return base
    const guard = guardAt(s, ref, use)
    let byGuard = s.narrowExprs.get(ref)
    if (!byGuard) s.narrowExprs.set(ref, byGuard = new Map())
    let e = byGuard.get(guard)
    if (e === undefined) {
        e = guard.flags ? expr(s, ExprOp.narrow, 0, base, guard.lo, guard.flags, [base], guard.hi) : base
        for (const pick of guard.picks) e = expr(s, ExprOp.pick, 0, e, pick & 1, pick >> 1, [e], 0)
        for (const proto of guard.protos ?? []) e = expr(s, ExprOp.narrow, 0, e, Math.abs(proto), proto > 0 ? GuardFlag.hasProto : GuardFlag.lacksProto, [e], 0)
        byGuard.set(guard, e)
    }
    return e
}

function guardAt(s: Summary, ref: number, use: number): Guard {
    const regions = s.regions!
    let guards = s.guards.get(ref)
    if (!guards) s.guards.set(ref, guards = new Map())
    const owner = regions.paramBlock.get(ref)
    const home = owner !== undefined ? (owner === 0 ? -1 : regions.roots[owner]) : regions.shared.has(ref) ? -1 : regions.of.get(ref) ?? -1
    const path: number[] = []
    let at = use
    while (at >= 0 && at !== home && !guards.has(at)) {
        path.push(at)
        at = regionUp(regions, at)
    }
    let guard = at >= 0 && at !== home ? guards.get(at)! : noGuard
    for (let i = path.length - 1; i >= 0; i--) {
        const r = path[i]
        charge(1)
        if (regions.depth[r] > 0) guard = meetGuard(guard, guardOn(s, getRef(getNode(s.g, regions.origin[r])!, 0), ref, regions.slot[r] === 1))
        guards.set(r, guard)
    }
    return guard
}

function meetGuard(a: Guard, b: Guard): Guard {
    if (b === noGuard || a === deadGuard) return a
    if (a === noGuard || b === deadGuard) return b
    const flags = a.flags | b.flags
    const lo = a.lo > b.lo ? a.lo : b.lo
    const hi = a.hi < b.hi ? a.hi : b.hi
    if (contradicts(flags) || lo > hi) return deadGuard
    const picks = a.picks.slice()
    for (const p of b.picks) {
        if (!picks.includes(p)) picks.push(p)
    }
    const protos = (a.protos ?? []).slice()
    for (const p of b.protos ?? []) {
        if (protos.includes(-p)) return deadGuard
        if (!protos.includes(p)) protos.push(p)
    }
    if (flags === a.flags && lo === a.lo && hi === a.hi && picks.length === a.picks.length && protos.length === (a.protos ?? []).length) return a
    return protos.length ? { flags, lo, hi, picks, protos } : { flags, lo, hi, picks }
}

const excludesObjects = GuardFlag.falsy | GuardFlag.nullish | GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isFunction | GuardFlag.isUndefined | GuardFlag.notObject | GuardFlag.isBoolean

function holdsProto(guard: Guard, proto: number): boolean {
    if (guard.protos?.includes(proto)) return true
    return proto < 0 && (guard.flags & excludesObjects) !== 0
}

function joinGuard(a: Guard, b: Guard): Guard {
    if (a === deadGuard) return b
    if (b === deadGuard) return a
    if (a === noGuard || b === noGuard) return noGuard
    const flags = a.flags & b.flags
    const bounded = (flags & GuardFlag.bounded) !== 0
    const lo = bounded ? Math.min(a.lo, b.lo) : MinI64
    const hi = bounded ? Math.max(a.hi, b.hi) : MaxU64
    const picks = a.picks.filter(p => b.picks.includes(p))
    const protos: number[] = []
    for (const p of a.protos ?? []) {
        if (holdsProto(b, p)) protos.push(p)
    }
    for (const p of b.protos ?? []) {
        if (!protos.includes(p) && holdsProto(a, p)) protos.push(p)
    }
    if (!flags && !picks.length && !protos.length) return noGuard
    return protos.length ? { flags, lo, hi, picks, protos } : { flags, lo, hi, picks }
}

function contradicts(flags: number): boolean {
    if ((flags & GuardFlag.truthy) && (flags & GuardFlag.falsy)) return true
    if ((flags & GuardFlag.nullish) && (flags & (GuardFlag.defined | GuardFlag.truthy | GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction))) return true
    return false
}

function guardOn(s: Summary, cond: number, ref: number, yes: boolean, calls: boolean = true): Guard {
    const g = s.g
    const [id, positive] = pg.condition(g, cond, yes)
    if (!id) return noGuard
    if (id === ref) return { flags: positive ? GuardFlag.truthy : GuardFlag.falsy, lo: MinI64, hi: MaxU64, picks: [] }
    const n = getNode(g, id)!
    if (n.op === NodeOp.getProp && !getRef(n, 2) && getRef(n, 1) === ref) return { flags: 0, lo: MinI64, hi: MaxU64, picks: [getLiteral(g, n, 2) * 2 + (positive ? 1 : 0)] }
    if (n.op === NodeOp.call) return calls ? predicateGuard(s, n, ref, positive) : noGuard
    if (n.op === NodeOp.param) return arrivalGuard(s, id, ref, positive, calls)
    const proto = protoGuard(s, n, ref, positive)
    if (proto) return proto
    if (n.op !== NodeOp.eq && n.op !== NodeOp.ne && n.op !== NodeOp.lt && n.op !== NodeOp.le && n.op !== NodeOp.gt && n.op !== NodeOp.ge) return noGuard
    const equal = n.op === NodeOp.eq ? positive : n.op === NodeOp.ne ? !positive : positive
    const a = getRef(n, 0)
    const b = getRef(n, 1)
    const other = a === ref ? 1 : b === ref ? 0 : -1
    if (other < 0) {
        if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) return noGuard
        const side = typeofOf(s, a, ref) ? 1 : typeofOf(s, b, ref) ? 0 : -1
        if (side < 0) return noGuard
        const name = constantCell(s, getRef(n, side))
        const flag = name === heap.typeNames.number ? (equal ? GuardFlag.isNumber : GuardFlag.notNumber)
            : name === heap.typeNames.string ? (equal ? GuardFlag.isString : GuardFlag.notString)
            : name === heap.typeNames.object ? (equal ? GuardFlag.isObject : GuardFlag.notObject)
            : name === heap.typeNames.function ? (equal ? GuardFlag.isFunction : GuardFlag.notFunction)
            : name === heap.typeNames.undefined ? (equal ? GuardFlag.isUndefined : GuardFlag.notUndefined)
            : name === heap.typeNames.boolean ? (equal ? GuardFlag.isBoolean : GuardFlag.notBoolean) : 0
        return { flags: flag, lo: MinI64, hi: MaxU64, picks: [] }
    }
    const otherRef = getRef(n, other)
    if (n.op === NodeOp.eq || n.op === NodeOp.ne) {
        if (otherRef && heap.isNullishHandle(constantCell(s, otherRef) as intrinsics.Handle)) return { flags: equal ? GuardFlag.nullish : GuardFlag.defined, lo: MinI64, hi: MaxU64, picks: [] }
        const truth = otherRef ? boolLiteral(g, otherRef) : -1
        if (truth >= 0 && equal) return { flags: GuardFlag.isBoolean | GuardFlag.bounded, lo: truth, hi: truth, picks: [] }
        if (truth >= 0) return { flags: truth ? GuardFlag.notTrue : GuardFlag.notFalse, lo: MinI64, hi: MaxU64, picks: [] }
        if (otherRef) return noGuard
        const v = getLiteral(g, n, other)
        if (equal) return { flags: GuardFlag.bounded, lo: v, hi: v, picks: [] }
        if (v === 0) return { flags: GuardFlag.nonzero, lo: MinI64, hi: MaxU64, picks: [] }
        return noGuard
    }
    if (otherRef) return noGuard
    const v = getLiteral(g, n, other)
    const refLeft = other === 1
    let op = n.op
    if (!positive) op = op === NodeOp.lt ? NodeOp.ge : op === NodeOp.le ? NodeOp.gt : op === NodeOp.gt ? NodeOp.le : NodeOp.lt
    if (!refLeft) op = op === NodeOp.lt ? NodeOp.gt : op === NodeOp.le ? NodeOp.ge : op === NodeOp.gt ? NodeOp.lt : NodeOp.le
    if (op === NodeOp.lt) return { flags: GuardFlag.bounded, lo: MinI64, hi: Math.ceil(v) - 1, picks: [] }
    if (op === NodeOp.le) return { flags: GuardFlag.bounded, lo: MinI64, hi: Math.floor(v), picks: [] }
    if (op === NodeOp.gt) return { flags: GuardFlag.bounded, lo: Math.floor(v) + 1, hi: MaxU64, picks: [] }
    return { flags: GuardFlag.bounded, lo: Math.ceil(v), hi: MaxU64, picks: [] }
}

const pendingArrivals = new Set<number>()

function arrivalGuard(s: Summary, param: number, ref: number, positive: boolean, calls: boolean): Guard {
    const g = s.g
    const regions = s.regions!
    const block = regions.paramBlock.get(param)
    if (!block || pendingArrivals.has(param)) return noGuard
    if (regions.paramBlock.get(ref) !== 0 && regions.blockOf.get(ref) !== 0) return noGuard
    const index = g.blocks[block].params.indexOf(param)
    pendingArrivals.add(param)
    let joined = deadGuard
    for (const apply of regions.arrivals[block]) {
        charge(1)
        const n = getNode(g, apply)!
        const arg = getRef(n, index + 1)
        const truth = literalTruth(g, arg, getLiteral(g, n, index + 1))
        const own = truth >= 0 ? (truth === 1) === positive ? noGuard : deadGuard : guardOn(s, arg, ref, positive, calls)
        if (own === deadGuard) continue
        joined = joinGuard(joined, meetGuard(pathGuard(s, ref, apply), own))
        if (joined === noGuard) break
    }
    pendingArrivals.delete(param)
    return joined
}

function pathGuard(s: Summary, ref: number, node: number): Guard {
    const region = s.regions!.of.get(node)
    return region === undefined ? noGuard : guardAt(s, ref, region)
}

function literalTruth(g: Graph, ref: number, literal: number): number {
    if (!ref) return literal ? 1 : 0
    const n = getNode(g, strippedRef(g, ref))
    if (n?.op !== NodeOp.literal || getRef(n, 0)) return -1
    return getLiteral(g, n, 0) ? 1 : 0
}

function protoGuard(s: Summary, n: GraphNode, ref: number, positive: boolean): Guard | undefined {
    const g = s.g
    let test = n
    let yes = positive
    if ((n.op === NodeOp.eq || n.op === NodeOp.ne) && (!getRef(n, 0) || !getRef(n, 1))) {
        const side = getRef(n, 0) ? 0 : 1
        if (!getRef(n, side) || getLiteral(g, n, 1 - side) !== 0) return
        test = getNode(g, strippedRef(g, getRef(n, side)))!
        yes = n.op === NodeOp.ne ? positive : !positive
    }
    if (test.op !== NodeOp.rt || getLiteral(g, test, 1) !== RtOp.hasPrototype || getRef(test, 2) !== ref) return
    const cell = constantCell(s, getRef(test, 3))
    if (cell <= 0) return
    const proto = heap.deref(cell as Handle) as number
    return { flags: 0, lo: MinI64, hi: MaxU64, picks: [], protos: [yes ? proto : -proto] }
}

function typeofOf(s: Summary, id: number, ref: number): boolean {
    const n = id ? getNode(s.g, id) : undefined
    return n?.op === NodeOp.rt && getLiteral(s.g, n, 1) === RtOp.typeof && getRef(n, 2) === ref
}

function constantCell(s: Summary, id: number): number {
    let n = getNode(s.g, id)
    while (n?.op === NodeOp.after) n = getNode(s.g, getRef(n, countIds(n) - 1))
    return n?.op === NodeOp.heapHandle && !getRef(n, 0) ? getLiteral(s.g, n, 0) : -1
}

function predicateGuard(s: Summary, call: GraphNode, ref: number, positive: boolean): Guard {
    const callee = predicateCallee(s, call)
    const table = callee ? tableOf(callee) : null
    if (!table) return noGuard
    for (let i = 3; i < countIds(call) && (i - 3) * 2 < table.length; i++) {
        if (getRef(call, i) !== ref) continue
        const guard = table[(i - 3) * 2 + (positive ? 0 : 1)]
        if (guard.flags || guard.protos) return guard
    }
    return noGuard
}

function predicateCallee(s: Summary, call: GraphNode): Summary | undefined {
    const g = s.g
    const target = getRef(call, 1) ? getNode(g, getRef(call, 1)) : undefined
    if (!target) return
    const host = flow.host
    let fn: Function | undefined
    if (target.op === NodeOp.localTarget) fn = host.localFunction(getLiteral(g, target, 0))
    else if (target.op === NodeOp.heapHandle && !getRef(target, 0) && !s.fresh.has(getLiteral(g, target, 0))) fn = callableOf(getLiteral(g, target, 0))
    if (!fn || !host.traceable(fn)) return
    return summaryOf(boundCallee(host, fn, call))
}

function tableOf(callee: Summary): Guard[] | null {
    const known = callee.predicates
    if (known !== undefined) return known
    const cg = callee.g
    const rets: number[] = []
    for (const [id, n] of cg.nodes) {
        if (n.op === NodeOp.ret && !callee.regionRets.has(id)) rets.push(id)
    }
    callee.predicates = null
    if (callee.usesCtx || !rets.length) return null
    const table: Guard[] = []
    for (const p of cg.blocks[0].params) {
        if (isThisParam(getNode(cg, p)!)) continue
        for (const positive of [true, false]) {
            let joined = deadGuard
            for (const r of rets) {
                charge(1)
                const n = getNode(cg, r)!
                const truth = literalTruth(cg, getRef(n, 0), getLiteral(cg, n, 0))
                if (truth >= 0 && (truth === 1) !== positive) continue
                const own = truth >= 0 ? noGuard : guardOn(callee, getRef(n, 0), p, positive, false)
                joined = joinGuard(joined, meetGuard(pathGuard(callee, p, r), own))
                if (joined === noGuard) break
            }
            table.push(joined.picks.length ? { flags: joined.flags, lo: joined.lo, hi: joined.hi, picks: [], protos: joined.protos } : joined)
        }
    }
    callee.predicates = table
    return table
}

interface Bound {
    param: number
    recv: number
    ret: number
}

function proofScope(s: Summary): pg.ProofScope {
    if (s.proofs) return s.proofs
    const regions = s.regions!
    s.proofs = {
        g: s.g,
        regions,
        charge,
        skipKey: key => flow.skippedKeys.add(key),
        proofs: new Map(),
        segRoots: new Map(),
        keyRoots: new Map(),
    }
    return s.proofs
}

function summarizeBounds(s: Summary, ids: number[], retArgs: number[]): void {
    const g = s.g
    const regions = s.regions!
    const entry = g.blocks[0]
    const plain = entry.params.filter(p => !isThisParam(getNode(g, p)!))
    const self = entry.params.find(p => isThisParam(getNode(g, p)!))
    for (const e of s.selects) {
        const select = s.exprs[e].node
        const ru = regions.of.get(select)
        if (ru === undefined) continue
        for (let arm = 1; arm <= 2; arm++) {
            const rel = pg.relationOf(g, getRef(getNode(g, select)!, 0), arm === 1)
            if (!rel || rel.below) continue
            const param = plain.indexOf(rel.index)
            const obj = pg.lengthOwner(g, rel.length)
            const recv = obj === self && self !== undefined ? -1 : plain.indexOf(obj)
            if (param < 0 || (recv < 0 && obj !== self)) continue
            const root = pg.segRoot(proofScope(s), getRef(getNode(g, rel.length)!, 0))
            const t = root ? getNode(g, root) : undefined
            if (t?.op !== NodeOp.nilEffect || getRef(t, 0) !== entry.id) continue
            const region = childRegion(regions, ru, select, arm)
            const args: number[] = []
            const gates: number[] = []
            const all = s.exprs[s.retExpr].gates!
            let k = 0
            for (const id of ids) {
                if (getNode(g, id)!.op !== NodeOp.ret || s.regionRets.has(id)) continue
                if (!within(regions, regions.of.get(id) ?? -1, region)) {
                    args.push(retArgs[k])
                    gates.push(all[k])
                }
                k++
            }
            if (args.length === retArgs.length) continue
            const ret = expr(s, ExprOp.union, 0, 0, 0, 0, args, 0)
            s.exprs[ret].gates = gates
            s.bound = { param, recv, ret }
            return
        }
    }
}

function within(regions: GraphRegions, r: number, target: number): boolean {
    let at = r
    while (at >= 0) {
        charge(1)
        if (at === target) return true
        at = regionUp(regions, at)
    }
    return false
}

function refineReturn(callee: Instance, target: number): number {
    const b = callee.summary.bound
    if (!b) return callee.ret
    if (flow.slotKind[ownerSlot(target)] !== SlotKind.expr) return callee.ret
    const from = instOfSlot(target)
    const node = exprAt(target).node
    const n = node ? getNode(from.summary.g, node) : undefined
    if (!n) return callee.ret
    const args: number[] = []
    let recv = 0
    if (n.op === NodeOp.getProp && getRef(n, 2)) {
        args.push(getRef(n, 2))
        recv = getRef(n, 1)
    } else if (n.op === NodeOp.call) {
        for (let i = 3; i < countIds(n); i++) args.push(getRef(n, i))
        recv = getRef(n, 2)
    } else return callee.ret
    if (b.param >= args.length) return callee.ret
    const owner = b.recv < 0 ? recv : b.recv < args.length ? args[b.recv] : 0
    if (!owner || !args[b.param]) return callee.ret
    return pg.inBounds(proofScope(from.summary), node, args[b.param], owner) ? at(callee, b.ret) : callee.ret
}

function checkSkippedKeys(): void {
    for (const key of flow.skippedKeys) intrinsics.assert(!flow.setterKeys.has(key), `value-flow: a store to ${heap.describeKey(key as Handle) ?? key} was taken as plain while proving two reads equal, but that key has a setter`)
}

function buildSummary(s: Summary): void {
    const g = s.g
    s.regions = computeRegions(s)
    const params = g.blocks[0].params
    let declared = 0
    for (let i = 0; i < params.length; i++) {
        const p = getNode(g, params[i])!
        if (isThisParam(p)) {
            s.hasThis = true
            s.exprOf.set(params[i], expr(s, ExprOp.param, params[i], -1, 0, 0, [], 0))
            continue
        }
        s.exprOf.set(params[i], expr(s, ExprOp.param, params[i], declared, 0, 0, [], 0))
        declared++
    }
    s.params = declared
    const ids: number[] = []
    for (const id of g.nodes.keys()) ids.push(id)
    ids.sort((a, b) => a - b)
    s.regionRets = regionRets(g)
    const retArgs: number[] = []
    const gated: number[] = []
    for (const id of ids) {
        const n = getNode(g, id)!
        if (n.op === NodeOp.ret) {
            const value = operand(s, id, n, 0)
            const region = s.regionRets.get(id)
            if (region !== undefined) {
                const u = exprOfNode(s, region)
                s.exprs[u].args.push(value)
                gated.push(u, s.exprs[u].args.length - 1, id)
                continue
            }
            s.rets.push(value)
            retArgs.push(value)
            continue
        }
        if (n.op === NodeOp.apply) {
            const block = g.blockIndex.get(getRef(n, 0))
            if (!block) continue
            for (let j = 0; j < block.params.length; j++) {
                const merge = exprOfNode(s, block.params[j])
                s.exprs[merge].args.push(operand(s, id, n, j + 1))
                gated.push(merge, s.exprs[merge].args.length - 1, id)
            }
            continue
        }
        exprOfNode(s, id)
    }
    if (retArgs.length) {
        s.retExpr = expr(s, ExprOp.union, 0, 0, 0, 0, retArgs, 0)
        const gates: number[] = []
        let k = 0
        for (const id of ids) if (getNode(g, id)!.op === NodeOp.ret && !s.regionRets.has(id)) gates[k++] = nodeGate(s, id)
        s.exprs[s.retExpr].gates = gates
    }
    const retGates = s.retExpr >= 0 ? s.exprs[s.retExpr].gates! : []
    for (let i = 0; i < gated.length; i += 3) {
        const x = s.exprs[gated[i]]
        if (!x.gates) x.gates = []
        while (x.gates.length < gated[i + 1]) x.gates.push(-1)
        x.gates[gated[i + 1]] = nodeGate(s, gated[i + 2])
    }
    const regions = s.regions!
    for (const e of s.selects) {
        const x = s.exprs[e]
        const ru = regions.of.get(x.node)
        if (ru !== undefined) x.gates = [regionGate(s, childRegion(regions, ru, x.node, 1)), regionGate(s, childRegion(regions, ru, x.node, 2))]
    }
    let k = 0
    const reached = new Map<number, number>()
    for (const id of ids) {
        if (getNode(g, id)!.op !== NodeOp.ret || s.regionRets.has(id)) continue
        const call = orderingCall(g, getRef(getNode(g, id)!, 0))
        if (call) retGates[k] = expr(s, ExprOp.gate, 0, retGates[k], reachOf(s, exprOfNode(s, call), reached), 1, [], 0)
        k++
    }
    const count = s.exprs.length
    for (let e = 0; e < count; e++) {
        const x = s.exprs[e]
        if ((x.op !== ExprOp.call && x.op !== ExprOp.rt && x.op !== ExprOp.store && x.op !== ExprOp.alloc) || !x.node) continue
        const gate = nodeGate(s, x.node)
        if (gate >= 0) x.gates = [gate]
    }
    for (let b = 0; b < g.blocks.length; b++) {
        const gates: number[] = []
        for (const apply of regions.arrivals[b]) gates.push(nodeGate(s, apply))
        s.blockGates.push(gates)
    }
    if (retArgs.length) summarizeBounds(s, ids, retArgs)
    s.returnsSlice = freshReturn(s, true)
    s.returnsFresh = freshReturn(s, false)
}

function reachOf(s: Summary, e: number, reached: Map<number, number>): number {
    const known = reached.get(e)
    if (known !== undefined) return known
    const x = s.exprs[e]
    const op = x.node ? getNode(s.g, x.node)?.op : undefined
    if (x.op === ExprOp.konst && x.a === NONE) return e
    if (x.op !== ExprOp.union || op === NodeOp.param) return konst(s, literalScalar(1))
    const args: number[] = []
    for (const a of x.args) args.push(reachOf(s, a, reached))
    const out = expr(s, ExprOp.union, 0, 0, 0, 0, args, 0)
    if (x.gates) s.exprs[out].gates = x.gates.slice()
    reached.set(e, out)
    return out
}

function nodeGate(s: Summary, id: number): number {
    const regions = s.regions
    const r = regions ? regions.of.get(id) : undefined
    return r === undefined ? -1 : regionGate(s, r)
}

function regionGate(s: Summary, r: number): number {
    const regions = s.regions!
    const known = s.gateOf.get(r)
    if (known !== undefined) return known
    let gate = -1
    if (regions.depth[r] > 0) {
        const select = getNode(s.g, regions.origin[r])!
        const cond = getRef(select, 0)
        const parent = regionGate(s, regions.parent[r])
        if (cond) gate = expr(s, ExprOp.gate, 0, parent, exprOfNode(s, cond), regions.slot[r], [], 0)
        else gate = (getLiteral(s.g, select, 0) !== 0) === (regions.slot[r] === 1) ? parent : expr(s, ExprOp.konst, 0, NONE, 0, 0, [], 0)
    } else if (regions.link[r] >= 0) gate = regionGate(s, regions.link[r])
    s.gateOf.set(r, gate)
    return gate
}

function freshCallee(origin: number): boolean {
    const fn = originFunction(origin)
    if (!fn) return false
    const callee = summaryOf(fn)
    return !callee.hasThis && callee.returnsSlice
}

function freshReturn(s: Summary, slices: boolean): boolean {
    if (!s.rets.length) return false
    const seen = new Set<number>()
    const work = s.rets.slice()
    let found = false
    while (work.length) {
        const e = work.pop()!
        if (seen.has(e)) continue
        seen.add(e)
        const x = s.exprs[e]
        if (x.op === ExprOp.rt && x.a === RtOp.slice) found = true
        else if (!slices && (x.op === ExprOp.alloc || (x.op === ExprOp.call && s.exprs[x.b].op === ExprOp.alloc))) found = true
        else if (x.op === ExprOp.call && s.exprs[x.a].op === ExprOp.origin && freshCallee(s.exprs[x.a].a)) found = true
        else if (x.op === ExprOp.union || x.op === ExprOp.narrow || x.op === ExprOp.pick) for (const a of x.args) work.push(a)
        else if (x.op === ExprOp.konst && (x.a === UNDEF || x.a === NONE)) continue
        else return false
    }
    return found
}

function instance(fn: Function, qual: number, lit: number, litParam: number): number {
    let byQual = flow.instanceOf.get(fn)
    if (!byQual) flow.instanceOf.set(fn, byQual = new Map())
    intrinsics.assert(lit < 15, `value-flow: literal context ${lit} does not fit an instance key`)
    const memo = qual * 16 + lit + 1
    const known = byQual.get(memo)
    if (known !== undefined) return known
    const s = summaryOf(fn)
    const id = flow.instances.length
    layout(s)
    const base = flow.slotKind.length
    for (const e of s.owned) newSlot(SlotKind.expr, id, e)
    const sigs: number[] = []
    const recv = s.hasThis ? receiverQual(qual) : 0
    const pinned = recv > 0 && flow.originKind[recv] !== OriginKind.str ? paramOffset(s, -1) : -1
    for (let i = 0; i < sigWidth(s); i++) sigs.push(i === pinned ? constSlot(NONE, recv) : newSlot(SlotKind.sig, id, i))
    const inst: Instance = { id, summary: s, qual, base, sigs, ret: -1, callers: [], lit, litParam, site: undefined, map: undefined }
    inst.ret = s.retExpr >= 0 ? at(inst, s.retExpr) : newSlot(SlotKind.ret, id, 0)
    flow.instances.push(inst)
    byQual.set(memo, id)
    for (const e of s.owned) exprUses(at(inst, e))
    for (const e of s.owned) watchString(inst, e)
    wire(inst)
    return id
}

function receiverQual(qual: number): number {
    return flow.originKind[qual] === OriginKind.site ? 0 : qual
}

function paramSlot(inst: Instance, index: number): number {
    return inst.sigs[paramOffset(inst.summary, index)]
}

function thisPinned(inst: Instance): boolean {
    return inst.summary.hasThis && flow.slotKind[paramSlot(inst, -1)] === SlotKind.konst
}

function paramOffset(s: Summary, index: number): number {
    if (index === -1) return s.params
    if (index === -2) return s.params + (s.hasThis ? 1 : 0)
    return index
}

function sigWidth(s: Summary): number {
    return s.params + (s.hasThis ? 1 : 0) + (s.usesCtx ? 1 : 0)
}


function layout(s: Summary): Int32Array {
    if (s.local) return s.local
    const n = s.exprs.length
    const local = new Int32Array(n)
    let width = 0
    for (let e = 0; e < n; e++) {
        const x = s.exprs[e]
        if (x.op === ExprOp.store || (x.op === ExprOp.rt && x.a === RtOp.sliceWrite)) {
            local[e] = -constSlot(NONE, 0) - 1
            s.stores.push(e)
        } else if (x.op === ExprOp.konst || x.op === ExprOp.num) local[e] = -constSlot(x.a, x.op === ExprOp.konst ? x.sub : 0) - 1
        else if (x.op === ExprOp.origin) local[e] = -constSlot(NONE, x.a) - 1
        else if (x.op !== ExprOp.param) {
            local[e] = width++
            s.owned.push(e)
        }
    }
    for (let e = 0; e < n; e++) {
        const x = s.exprs[e]
        if (x.op === ExprOp.param) local[e] = width + paramOffset(s, x.a)
    }
    s.local = local
    s.width = width
    return local
}

function at(inst: Instance, e: number): number {
    const s = inst.summary
    if (inst.map) {
        const own = inst.map.get(e)
        if (own !== undefined) return own
        const x = s.exprs[e]
        if (x.op === ExprOp.param && x.a >= 0) return inst.sigs[x.a]
        return at(inst.site!, e)
    }
    const local = s.local![e]
    if (local < 0) return -local - 1
    return local < s.width ? inst.base + local : inst.sigs[local - s.width]
}

function constSlot(t: number, origin: number): number {
    intrinsics.assert(origin < 4194304, `value-flow: origin ${origin} does not fit a constant-slot key`)
    const key = t * 4194304 + origin
    const known = flow.constSlots.get(key)
    if (known !== undefined) return known
    const slot = newSlot(SlotKind.konst, -1, 0)
    flow.constSlots.set(key, slot)
    addConst(slot, t)
    if (origin) addOrigin(slot, origin)
    return slot
}

function wire(inst: Instance): void {
    const s = inst.summary
    const local = s.local!
    charge(s.width + s.stores.length)
    for (let e = 0; e < s.exprs.length; e++) {
        if (local[e] < 0 || local[e] >= s.width) continue
        const x = s.exprs[e]
        if ((x.op === ExprOp.call || x.op === ExprOp.rt || x.op === ExprOp.alloc) && gated(inst, x, e)) continue
        wireExpr(inst, x, inst.base + local[e])
    }
    for (const e of s.stores) {
        if (!gated(inst, s.exprs[e], e)) wireStore(inst, e)
    }
}

function gated(inst: Instance, x: Expr, e: number): boolean {
    if (!x.gates || x.gates[0] < 0) return false
    const gate = at(inst, x.gates[0])
    if (flow.scalar[gate] !== NONE) return false
    let waiting = flow.gateWaits.get(gate)
    if (!waiting) flow.gateWaits.set(gate, waiting = [])
    waiting.push(inst.id, e)
    return true
}

function wireEffect(inst: Instance, e: number): void {
    const x = inst.summary.exprs[e]
    if (x.op === ExprOp.store || (x.op === ExprOp.rt && x.a === RtOp.sliceWrite)) return wireStore(inst, e)
    wireExpr(inst, x, at(inst, e))
}

function wireStore(inst: Instance, e: number): void {
    const x = inst.summary.exprs[e]
    if (x.op === ExprOp.store) listen(at(inst, x.a), ListenerKind.store, inst.id, x.key, at(inst, x.b), e)
    else listen(at(inst, x.args[0]), ListenerKind.store, inst.id, slotKey(inst, x.args[1]), at(inst, x.args[2]), e)
}

function wireExpr(inst: Instance, x: Expr, slot: number): void {
    const s = inst.summary
    switch (x.op) {
        case ExprOp.alloc: addOrigin(slot, created(qualified(OriginKind.fresh, x.a, inst.qual, 0, s), inst))
        case ExprOp.union:
            for (const a of x.args) listen(at(inst, a), ListenerKind.copy, slot, 0, 0)
        case ExprOp.narrow: listen(at(inst, x.a), ListenerKind.narrow, slot, x.key, x.b)
        case ExprOp.pick: listen(at(inst, x.a), ListenerKind.pick, slot, x.key, x.b)
        case ExprOp.member:
            listen(at(inst, x.a), ListenerKind.member, slot, x.key, x.key === dynKey ? at(inst, x.b) : 0)
        case ExprOp.call:
            listen(at(inst, x.a), ListenerKind.callTarget, slot, 0, 0)
            listen(at(inst, x.b), ListenerKind.callRecv, slot, 0, 0)
        case ExprOp.opaque:
            markOpaque(slot)
        case ExprOp.rt: wireRt(inst, x, slot)
        case ExprOp.arith:
            if (x.key !== NodeOp.add && x.key !== NodeOp.sub) return
            listen(at(inst, x.a), ListenerKind.offset, slot, 0, 0)
            if (x.key === NodeOp.add) listen(at(inst, x.b), ListenerKind.offset, slot, 0, 0)
    }
}

function returnCone(s: Summary): number[] | null {
    if (s.cone !== undefined) return s.cone
    s.cone = null
    if (s.hasThis || s.usesCtx || !s.rets.length) return null
    const order: number[] = []
    const state = new Uint8Array(s.exprs.length)
    const work: number[] = []
    let params = 0
    for (const r of s.rets) work.push(r)
    while (work.length) {
        const e = work[work.length - 1]
        if (state[e] === 2) {
            work.pop()
            continue
        }
        const x = s.exprs[e]
        if (state[e] === 1) {
            state[e] = 2
            work.pop()
            order.push(e)
            continue
        }
        state[e] = 1
        charge(1)
        if (x.op === ExprOp.param || x.op === ExprOp.konst || x.op === ExprOp.origin || x.op === ExprOp.alloc) {
            if (x.op === ExprOp.param) params++
            state[e] = 2
            work.pop()
            continue
        }
        if (x.op !== ExprOp.narrow && x.op !== ExprOp.pick && x.op !== ExprOp.member && x.op !== ExprOp.union) return null
        if (x.op === ExprOp.member && x.key === dynKey) return null
        if (x.op === ExprOp.member && !state[x.a]) work.push(x.a)
        for (const a of x.args) if (!state[a]) work.push(a)
    }
    if (!params) return null
    s.cone = order
    return order
}

function siteReturn(callee: Instance, from: Instance, x: Expr, callSlot: number, into: number, cone: number[]): void {
    const s = callee.summary
    const id = flow.instances.length
    const sigs: number[] = []
    for (let i = 0; i < s.params; i++) sigs.push(i < x.args.length ? at(from, x.args[i]) : constSlot(UNDEF, 0))
    const site: Instance = { id, summary: s, qual: 0, base: 0, sigs, ret: -1, callers: [callSlot], lit: -1, litParam: -1, site: callee, map: new Map() }
    flow.instances.push(site)
    charge(cone.length)
    for (const e of cone) site.map!.set(e, newSlot(SlotKind.expr, id, e))
    for (const e of cone) exprUses(site.map!.get(e)!)
    for (const e of cone) wireExpr(site, s.exprs[e], site.map!.get(e)!)
    for (const r of s.rets) copyEdge(at(site, r), into)
}

function wireRt(inst: Instance, x: Expr, slot: number): void {
    const op = x.a
    if (op === RtOp.toNumber) return
    if (op === RtOp.slice) return addOrigin(slot, created(qualified(OriginKind.slice, 0, inst.qual, x.node, inst.summary), inst))
    if (op === RtOp.sliceRead) return listen(at(inst, x.args[0]), ListenerKind.member, slot, slotKey(inst, x.args[1]), 0)
    if (op === RtOp.create) {
        const made = created(qualified(OriginKind.created, 0, inst.qual, x.node, inst.summary), inst)
        const proto = inst.summary.exprs[x.args[0]]
        flow.originCell[made] = proto.op === ExprOp.origin ? flow.originCell[proto.a] : 0
        return addOrigin(slot, made)
    }
    if (op === RtOp.assign) return listen(at(inst, x.args[1]), ListenerKind.assignSource, slot, 0, slot)
    if (stringRt.has(op)) addOrigin(slot, strOrigin())
    const impl = bindingOf(op)?.impl
    if (pg.pureRt.has(op) && (!impl || !flow.host.traceable(impl))) return
    if (!impl || !flow.host.traceable(impl)) {
        if (op !== RtOp.concat) markOpaque(slot)
        return
    }
    const s = summaryOf(impl)
    if (s.returnsFresh) return bindRt(inst, x, slot, impl, qualified(OriginKind.site, 0, inst.qual, x.node, inst.summary), 0)
    if (!x.args.length) return bindRt(inst, x, slot, impl, 0, 0)
    flow.rtPending.push(slot)
    listen(at(inst, x.args[0]), ListenerKind.rtSubject, slot, 0, 0)
}

function bindPendingRt(): boolean {
    let bound = false
    const pending = flow.rtPending
    flow.rtPending = []
    for (const slot of pending) {
        const inst = instOfSlot(slot)
        const x = exprAt(slot)
        charge(1)
        const origins = flow.slotOrigins[at(inst, x.args[0])]
        if (origins.length && !origins.some(a => flow.originKind[a] === OriginKind.str)) continue
        bindRt(inst, x, slot, bindingOf(x.a)!.impl!, 0, 0)
        bound = true
    }
    return bound
}

function addCaller(callee: Instance, slot: number): void {
    callee.callers.push(slot)
    initCallerAdded(callee, slot)
}

function bindRt(inst: Instance, x: Expr, slot: number, impl: Function, qual: number, subject: number): void {
    const lit = subject && x.args.length > 1 ? smallLiteral(inst.summary, x.args[1]) : -1
    const callee = flow.instances[instance(impl, qual, lit, lit < 0 ? -1 : 1)]
    addCaller(callee, slot)
    const params = callee.summary.params
    for (let i = 0; i < x.args.length && i < params; i++) {
        if (i === 0 && subject) {
            addOrigin(callee.sigs[0], subject)
            addIn(callee.sigs[0], -at(inst, x.args[0]) - 1)
            continue
        }
        if (i === 0 && !qual) {
            addIn(callee.sigs[0], -at(inst, x.args[0]) - 1)
            continue
        }
        copyEdge(at(inst, x.args[i]), callee.sigs[i])
    }
    for (let i = x.args.length; i < params; i++) addConst(callee.sigs[i], UNDEF)
    const part = partSlot(slot, subject)
    const from = stringRt.has(x.a) || x.a === RtOp.hasPrototype || x.a === RtOp.hasProperty ? -1 : callee.ret
    flow.partBind.set(part, { callee: callee.id, from, kind: BindKind.rt, target: qual, recv: subject })
    if (from >= 0) copyEdge(from, part)
}

const stringRt = new Set<number>([RtOp.concat, RtOp.toString, RtOp.stringOf])

function stringy(slot: number): boolean {
    return (scalars.flags[flow.scalar[slot]] & (ScalarFlag.str | ScalarFlag.anyStr)) !== 0 || (flow.originMask[slot] & 2) !== 0
}

function generic(slot: number): boolean {
    return (scalars.flags[flow.scalar[slot]] & ScalarFlag.anyStr) !== 0
}

function rtOperands(inst: Instance, x: Expr, part: number): number[] {
    if (coerces(x) && flow.slotIndex[part] !== compareKey) return [flow.slotIndex[part] ? x.b : x.a]
    if (x.op === ExprOp.cmp || x.op === ExprOp.arith) return [x.a, x.b]
    if (x.op === ExprOp.union) return [inst.summary.exprOf.get(getRef(getNode(inst.summary.g, x.node)!, 0))!]
    return x.args
}

const compareKey = 2

function coerces(x: Expr): boolean {
    if (x.op === ExprOp.arith) return coercingOps.has(x.key)
    return x.op === ExprOp.cmp && relationalOps.has(x.key)
}

function concatSite(inst: Instance, x: Expr): boolean {
    return x.op === ExprOp.arith && x.key === NodeOp.add && getNode(inst.summary.g, x.node)?.op === NodeOp.rt
}

function watchString(inst: Instance, e: number): void {
    const s = inst.summary
    const x = s.exprs[e]
    if (coerces(x) || (x.op === ExprOp.rt && x.a === RtOp.toNumber) || concatSite(inst, x)) {
        flow.stringSite[at(inst, e)] = 1
        return
    }
    if (x.op === ExprOp.cmp && (x.key === NodeOp.eq || x.key === NodeOp.ne)) {
        flow.stringSite[at(inst, e)] = 1
        return
    }
    if (x.op !== ExprOp.union || !x.node || getNode(s.g, x.node)?.op !== NodeOp.select) return
    const cond = s.exprOf.get(getRef(getNode(s.g, x.node)!, 0))
    if (cond === undefined) return
    const slot = at(inst, e)
    flow.stringSite[slot] = 1
    scalarUse(at(inst, cond), slot)
}

function checkString(slot: number): void {
    const inst = instOfSlot(slot)
    const x = exprAt(slot)
    if (x.op === ExprOp.rt) {
        if (!numericConversion(at(inst, x.args[0]))) return
        flow.stringSite[slot] = 0
        return bindCoercion(inst, slot, x.args[0], 0)
    }
    if (concatSite(inst, x)) {
        if (!stringy(at(inst, x.a)) && !stringy(at(inst, x.b))) return
        flow.stringSite[slot] = 0
        return bindStringRt(inst, x, slot, RtOp.addOrConcat, 0)
    }
    if (coerces(x)) {
        const a = numericConversion(at(inst, x.a))
        const b = numericConversion(at(inst, x.b))
        if (x.op === ExprOp.cmp && stringy(at(inst, x.a)) && stringy(at(inst, x.b))) {
            flow.stringSite[slot] = 0
            return bindStringRt(inst, x, slot, RtOp.compare, compareKey)
        }
        if (a) bindCoercion(inst, slot, x.a, 0)
        if (b) bindCoercion(inst, slot, x.b, 1)
        if (a && b) flow.stringSite[slot] = 0
        return
    }
    charge(1)
    if (x.op === ExprOp.cmp) {
        const a = at(inst, x.a)
        const b = at(inst, x.b)
        if (!stringy(a) || !stringy(b) || (!generic(a) && !generic(b))) return
        flow.stringSite[slot] = 0
        return bindStringRt(inst, x, slot, RtOp.strictEqual, 0)
    }
    const cond = inst.summary.exprOf.get(getRef(getNode(inst.summary.g, x.node)!, 0))!
    if (!stringy(at(inst, cond))) return
    flow.stringSite[slot] = 0
    bindStringRt(inst, x, slot, RtOp.truthy, 0)
}

function bindStringRt(inst: Instance, x: Expr, slot: number, op: number, key: number): void {
    if (flow.parts.get(slot)?.has(key)) return
    const impl = bindingOf(op)!.impl!
    const callee = flow.instances[instance(impl, 0, -1, -1)]
    addCaller(callee, slot)
    const part = partSlot(slot, key)
    const args = rtOperands(inst, x, part)
    for (let i = 0; i < callee.summary.params; i++) {
        if (i < args.length) copyEdge(at(inst, args[i]), callee.sigs[i])
        else addConst(callee.sigs[i], UNDEF)
    }
    const from = op === RtOp.addOrConcat ? callee.ret : -1
    flow.partBind.set(part, { callee: callee.id, from, kind: BindKind.rt, target: 0, recv: 0 })
    if (from >= 0) copyEdge(from, part)
}

function bindCoercion(inst: Instance, slot: number, operand: number, key: number): void {
    if (flow.parts.get(slot)?.has(key)) return
    charge(1)
    const callee = flow.instances[instance(bindingOf(RtOp.toNumber)!.impl!, 0, -1, -1)]
    addCaller(callee, slot)
    copyEdge(at(inst, operand), callee.sigs[0])
    for (let i = 1; i < callee.summary.params; i++) addConst(callee.sigs[i], UNDEF)
    flow.partBind.set(partSlot(slot, key), { callee: callee.id, from: -1, kind: BindKind.rt, target: 0, recv: 0 })
}

function stringsIn(t: number, origins: number[]): boolean {
    return (scalars.flags[t] & (ScalarFlag.str | ScalarFlag.anyStr)) !== 0 || origins.some(a => flow.originKind[a] === OriginKind.str)
}

function convertedMembers(t: number, strings: boolean): number {
    return unite(strings ? unite(FLOAT, I64) : NONE, undefinedMembers(t))
}

function undefinedMembers(t: number): number {
    // XXX: policy B: an undefined member reaching a numeric op is assume-unreachable, so it converts to nothing and binds no call. NaN (A) returns FLOAT here and the toNumber binding follows; a trap mode binds a trapping call for these members instead.
    return NONE
}

function numericConversion(slot: number): boolean {
    return convertedMembers(flow.scalar[slot], stringy(slot)) !== NONE
}

function coercedScalar(slot: number, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    const t = value(slot)
    const f = scalars.flags[t]
    const converted = convertedMembers(t, stringsIn(t, originsOf(slot)))
    if (converted === NONE && !(f & (ScalarFlag.str | ScalarFlag.anyStr | ScalarFlag.undef | ScalarFlag.void | ScalarFlag.no | ScalarFlag.yes))) return t
    const numbers = scalar(f & (ScalarFlag.int | ScalarFlag.float | ScalarFlag.unknown), scalars.lo[t], scalars.hi[t], [], scalars.nums[t])
    return unite(boolNumbers(scalar(f & (ScalarFlag.no | ScalarFlag.yes), 0, 0, [])), unite(numbers, converted))
}

function operandNumber(inst: Instance, x: Expr, e: number, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    return coerces(x) ? coercedScalar(at(inst, e), value, originsOf) : value(at(inst, e))
}

function deliver(l: Listener, origin: number): void {
    charge(1)
    switch (l.kind) {
        case ListenerKind.copy: addOrigin(l.target, origin)
        case ListenerKind.member: resolveMember(origin, l.key, partSlot(l.target, origin), l.extra)
        case ListenerKind.store: resolveStore(origin, l.key, flow.instances[l.target], l.e, l.extra)
        case ListenerKind.callTarget: callTarget(l.target, origin)
        case ListenerKind.callRecv: callRecv(l.target, origin)
        case ListenerKind.rtSubject: rtSubject(l.target, origin)
        case ListenerKind.assignSource: assignSource(origin, l.extra)
        case ListenerKind.assignTarget: assignTarget(l.target, origin)
        case ListenerKind.narrow: if (originPasses(origin, l.key, l.extra)) addOrigin(l.target, origin)
        case ListenerKind.pick: pickOrigin(l.target, origin, l.key, l.extra)
        case ListenerKind.offset: if (flow.originKind[origin] === OriginKind.slice) addOrigin(l.target, origin)
    }
}

function pickOrigin(target: number, origin: number, key: number, truthy: number): void {
    const f = flow.originFields[origin].get(key)
    if (f === undefined || !pickRejects(f, truthy)) return addOrigin(target, origin)
    let list = flow.pickWatch.get(f)
    if (!list) flow.pickWatch.set(f, list = [])
    list.push(target, origin, truthy)
}

function boolLiteral(g: Graph, id: number): number {
    const n = getNode(g, id)
    if (!n || n.op !== NodeOp.literal || typeOf(n) !== Types.bool) return -1
    return getLiteral(g, n, 0) ? 1 : 0
}

function pickRejects(f: number, truthy: number): boolean {
    let t = flow.slotConst[f]
    const ins = flow.slotIns[f]
    if (ins) {
        for (const from of ins) {
            const slot = from >= 0 ? from : -from - 1
            if (flow.slotKind[slot] !== SlotKind.konst || flow.slotIns[slot]?.length) return false
            t = unite(t, flow.slotConst[slot])
        }
    }
    const objects = flow.slotOrigins[f].length > 0
    const fl = scalars.flags[t]
    const falsy = !objects && !(fl & ~(ScalarFlag.undef | ScalarFlag.void | ScalarFlag.int | ScalarFlag.no)) && (!(fl & ScalarFlag.int) || (scalars.lo[t] === 0 && scalars.hi[t] === 0))
    const truthyOnly = !(fl & ~(ScalarFlag.int | ScalarFlag.yes)) && (!(fl & ScalarFlag.int) || scalars.lo[t] > 0 || scalars.hi[t] < 0) && (objects || (fl & (ScalarFlag.int | ScalarFlag.yes)) !== 0)
    return truthy ? falsy && (t !== NONE || objects) : truthyOnly
}

function recheckPicks(f: number): void {
    const list = flow.pickWatch.get(f)
    if (!list) return
    let keep = 0
    for (let i = 0; i < list.length; i += 3) {
        if (pickRejects(f, list[i + 2])) {
            list[keep++] = list[i]
            list[keep++] = list[i + 1]
            list[keep++] = list[i + 2]
        } else addOrigin(list[i], list[i + 1])
    }
    list.length = keep
}

function originPasses(origin: number, flags: number, proto: number): boolean {
    if (flags & (GuardFlag.nullish | GuardFlag.isNumber | GuardFlag.isUndefined | GuardFlag.isBoolean)) return false
    const k = flow.originKind[origin]
    const str = k === OriginKind.str
    const fn = !str && !!originHostFn(origin)
    const obj = !str && !fn
    if (flags & GuardFlag.hasProto) return chainHas(origin, proto as Handle) !== 0
    if (flags & GuardFlag.lacksProto) return !obj || chainHas(origin, proto as Handle) !== 1
    if ((flags & GuardFlag.falsy) && !str) return false
    if ((flags & GuardFlag.isString) && !str) return false
    if ((flags & GuardFlag.notString) && str) return false
    if ((flags & GuardFlag.isFunction) && !fn) return false
    if ((flags & GuardFlag.notFunction) && fn) return false
    if ((flags & GuardFlag.isObject) && !obj) return false
    if ((flags & GuardFlag.notObject) && obj) return false
    return true
}

function filterScalar(t: number, flags: number, lo: number, hi: number): number {
    let f = scalars.flags[t]
    if (f & ScalarFlag.unknown) return t
    if (flags & GuardFlag.hasProto) return NONE
    let tlo = scalars.lo[t]
    let thi = scalars.hi[t]
    let strs = scalars.strs[t]
    if (flags & (GuardFlag.truthy | GuardFlag.defined | GuardFlag.notUndefined | GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.bounded)) f = f & ~(ScalarFlag.undef | ScalarFlag.void)
    if (flags & (GuardFlag.nullish | GuardFlag.isUndefined)) f = f & (ScalarFlag.undef | ScalarFlag.void)
    if (flags & GuardFlag.isBoolean) f = f & (ScalarFlag.no | ScalarFlag.yes)
    if (flags & (GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.notBoolean)) f = f & ~(ScalarFlag.no | ScalarFlag.yes)
    if (flags & (GuardFlag.truthy | GuardFlag.nonzero)) f = f & ~ScalarFlag.no
    if (flags & (GuardFlag.falsy | GuardFlag.notTrue)) f = f & ~ScalarFlag.yes
    if (flags & GuardFlag.notFalse) f = f & ~ScalarFlag.no
    if ((flags & GuardFlag.bounded) && (lo > 0 || hi < 0)) f = f & ~ScalarFlag.no
    if ((flags & GuardFlag.bounded) && (lo > 1 || hi < 1)) f = f & ~ScalarFlag.yes
    if (flags & (GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.notNumber)) f = f & ~(ScalarFlag.int | ScalarFlag.float)
    if (flags & (GuardFlag.isNumber | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.notString)) f = f & ~(ScalarFlag.str | ScalarFlag.anyStr)
    if (flags & GuardFlag.bounded) f = f & ~(ScalarFlag.str | ScalarFlag.anyStr)
    if ((flags & (GuardFlag.truthy | GuardFlag.nonzero)) && (f & ScalarFlag.int)) {
        if (tlo === 0 && thi === 0 && !(f & ScalarFlag.float)) f = f & ~ScalarFlag.int
        else if (tlo === 0) tlo = 1
        else if (thi === 0) thi = -1
    }
    if (flags & GuardFlag.falsy) {
        if ((f & ScalarFlag.int) && tlo <= 0 && thi >= 0) {
            tlo = 0
            thi = 0
        } else f = f & ~ScalarFlag.int
    }
    if ((flags & GuardFlag.bounded) && (f & ScalarFlag.int)) {
        if (lo > tlo) tlo = lo
        if (hi < thi) thi = hi
    }
    if ((f & ScalarFlag.int) && tlo > thi) f = f & ~ScalarFlag.int
    const nums = scalars.nums[t].filter(v => v >= tlo && v <= thi && (v !== 0 || !(flags & (GuardFlag.truthy | GuardFlag.nonzero))))
    if (scalars.nums[t].length && !nums.length) f = f & ~ScalarFlag.int
    if (!(f & (ScalarFlag.str | ScalarFlag.anyStr))) strs = []
    if (!f) return NONE
    if (nums.length === 1) return scalar(f, nums[0], nums[0], strs)
    return scalar(f, tlo, thi, strs, nums)
}

function exprAt(slot: number): Expr {
    const owner = ownerSlot(slot)
    return flow.instances[flow.slotOwner[owner]].summary.exprs[flow.slotIndex[owner]]
}

function instOfSlot(slot: number): Instance {
    return flow.instances[flow.slotOwner[ownerSlot(slot)]]
}

function chainHas(origin: number, proto: Handle): number {
    const kind = flow.originKind[origin]
    const cell = flow.originCell[origin]
    if (kind === OriginKind.str) return 0
    if (kind !== OriginKind.created && kind !== OriginKind.static && kind !== OriginKind.fresh) return -1
    if (!cell || isScope(origin)) return -1
    if (kind !== OriginKind.created && (heap.isBoxedF64(cell as Handle) || heap.isString(cell as Handle))) return 0
    let at = protoOf(origin)
    while (at) {
        if (at === proto) return 1
        at = heap.getPrototypeOf(at)
    }
    return 0
}

function protoOf(origin: number): Handle {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.created) return flow.originCell[origin] ? heap.deref(flow.originCell[origin] as Handle) : 0 as Handle
    if (kind === OriginKind.str) return heap.getPrototypeOf(flow.originCell[origin] as Handle)
    if (kind === OriginKind.static || kind === OriginKind.fresh) {
        if (isScope(origin)) return 0 as Handle
        let proto = flow.originProto[origin]
        if (proto === undefined) flow.originProto[origin] = proto = heap.getPrototypeOf(heap.deref(flow.originCell[origin] as Handle))
        return proto
    }
    return 0 as Handle
}

function smallLiteral(s: Summary, e: number): number {
    const x = s.exprs[e]
    if (x.op !== ExprOp.konst) return -1
    return constIndex(x.a)
}

function constIndex(t: number): number {
    if (scalars.flags[t] !== ScalarFlag.int || scalars.lo[t] !== scalars.hi[t]) return -1
    const v = scalars.lo[t]
    return v >= 0 && v < maxTuple ? v : -1
}

function slotKey(inst: Instance, index: number): number {
    if (inst.lit < 0) return elemKey
    let x = inst.summary.exprs[index]
    while (x.op === ExprOp.narrow || x.op === ExprOp.pick) x = inst.summary.exprs[x.a]
    return x.op === ExprOp.param && x.a === inst.litParam ? posKey(inst.lit) : elemKey
}

function virtualCall(target: number, fnValue: Handle, recv: number, args: number[], argConsts: number[]): void {
    const fn = callableOf(flow.host.session.runtime!.objects.intern(fnValue) as number)
    if (!fn) {
        markOpaque(target)
        return
    }
    const s = summaryOf(fn)
    const index = argConsts.length && (args.length === 0 || args[0] < 0) ? constIndex(argConsts[0]) : -1
    const callee = flow.instances[instance(fn, s.hasThis ? qualOf(recv) : 0, index, index < 0 ? -1 : 0)]
    addCaller(callee, target)
    if (s.hasThis) addOrigin(paramSlot(callee, -1), recv)
    for (let i = 0; i < s.params; i++) {
        if (i < args.length && args[i] >= 0) copyEdge(args[i], callee.sigs[i])
        else if (i < argConsts.length) addConst(callee.sigs[i], argConsts[i])
        else addConst(callee.sigs[i], UNDEF)
    }
    const from = refineReturn(callee, target)
    copyEdge(from, target)
    flow.partBind.set(target, { callee: callee.id, from, kind: BindKind.virtual, target: 0, recv })
}

function isIndexKey(key: number): boolean {
    return key === dynKey || (key >= 0 && heap.keyIndex(key as Handle) !== undefined)
}

function resolveMember(origin: number, key: number, target: number, keySlot: number): void {
    if (key === elemKey) return elemRead(origin, target)
    if (isPosKey(key)) {
        readField(fieldSlot(origin, key), target)
        return readField(fieldSlot(origin, elemKey), target)
    }
    const kind = flow.originKind[origin]
    if (kind === OriginKind.fn || kind === OriginKind.site || kind === OriginKind.slice) {
        addConst(target, UNDEF)
        return
    }
    const scope = isScope(origin)
    if (!scope && isIndexKey(key)) {
        const proxy = trapOf(origin)
        if (proxy) {
            const index = key === dynKey ? -1 : heap.keyIndex(key as Handle)!
            return virtualCall(target, heap.getProxyGetter(proxy), origin, [key === dynKey ? keySlot : -1], [index < 0 ? NONE : literalScalar(index)])
        }
    }
    if (key === dynKey && !scope && (kind === OriginKind.fresh || kind === OriginKind.created || kind === OriginKind.static)) return keyedRead(origin, target)
    if (key < 0 || scope) {
        const own = fieldSlot(origin, key)
        readField(own, target)
        flow.missing.push(target, own)
        return
    }
    const state = heapState(origin)
    const ownDescriptor = state === undefined ? 0 : heap.getOwnProperty(state, key as Handle)
    if (ownDescriptor) {
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(ownDescriptor))
        if (d.flags & heap.PropFlags.has_getter) return virtualCall(target, d.slot0 as Handle, origin, [], [])
        return readField(fieldSlot(origin, key), target)
    }
    let at = protoOf(origin)
    while (at) {
        const descriptor = heap.getOwnProperty(at, key as Handle)
        if (descriptor) {
            const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
            if (d.flags & heap.PropFlags.has_getter) return virtualCall(target, d.slot0 as Handle, origin, [], [])
            if (d.flags & heap.PropFlags.has_setter) return addConst(target, UNDEF)
            ownLater(origin, key, target)
            return heapValue(d.slot0 as Handle, target, 0, undefined, 0)
        }
        at = heap.getPrototypeOf(at)
    }
    const own = fieldSlot(origin, key)
    readField(own, target)
    flow.missing.push(target, own)
    if (kind === OriginKind.fresh || kind === OriginKind.created) namedRead(origin, target)
}

function elemRead(origin: number, target: number): void {
    readField(fieldSlot(origin, elemKey), target)
    watchFields(origin, FieldWatch.elem, target)
}

function ownLater(origin: number, key: number, target: number): void {
    const known = flow.originFields[origin].get(key)
    if (known !== undefined) return readField(known, target)
    let pending = flow.originPending[origin]
    if (!pending) flow.originPending[origin] = pending = new Map()
    let list = pending.get(key)
    if (!list) pending.set(key, list = [])
    list.push(target)
}

function trapOf(origin: number): Handle {
    let at = protoOf(origin)
    while (at) {
        if (heap.isProxy(at)) return at
        at = heap.getPrototypeOf(at)
    }
    return 0 as Handle
}

function deferInit(inst: Instance, x: Expr, origin: number, key: number, e: number, valueSlot: number): boolean {
    if (!initStore(inst, x, origin)) return false
    const owner = flow.originOwner[origin]
    const allocated = allocNodeOf(origin)
    if (!owner || !allocated || !inst.callers.length) return false
    for (const slot of inst.callers) {
        if (!killedBy(slot, origin, key, inst)) return false
    }
    const held = flow.heldWrites
    let list = held.get(inst.id)
    if (!list) held.set(inst.id, list = [])
    list.push(origin, key, e, valueSlot)
    return true
}

function initCallerAdded(inst: Instance, slot: number): void {
    const held = flow.heldWrites.get(inst.id)
    if (!held) return
    const pending = held.splice(0, held.length)
    for (let i = 0; i < pending.length; i += 4) {
        if (killedBy(slot, pending[i], pending[i + 1], inst)) {
            held.push(pending[i], pending[i + 1], pending[i + 2], pending[i + 3])
            continue
        }
        writeField(fieldSlot(pending[i], pending[i + 1]), pending[i + 3], writerId(inst, pending[i + 2]), 'prop', true)
    }
}

function initStore(inst: Instance, x: Expr, origin: number): boolean {
    const kind = flow.originKind[origin]
    if (kind !== OriginKind.fresh && kind !== OriginKind.created) return false
    const s = inst.summary
    const recv = s.exprs[x.a]
    if (recv.op !== ExprOp.param || recv.a !== -1) return false
    let known = s.initializer
    if (known === undefined) s.initializer = known = pg.initializer(s.g, protoOf(origin))
    return known
}

function allocNodeOf(origin: number): number {
    const owner = flow.originOwner[origin]
    if (!owner) return 0
    if (flow.originKind[origin] === OriginKind.fresh) return owner.allocNodes.get(flow.originCell[origin]) ?? 0
    return flow.originNode[origin]
}

function killedBy(slot: number, origin: number, key: number, inst: Instance): boolean {
    const owner = flow.originOwner[origin]!
    if (instOfSlot(slot).summary !== owner) return false
    charge(1)
    const regions = owner.regions
    const regionOf = (id: number) => regions ? regions.of.get(id) : undefined
    return pg.killedAfter(owner.g, exprAt(slot).node, allocNodeOf(origin), key as Handle, protoOf(origin), returnsSelf(inst.summary.g), regionOf)
}

function resolveStore(origin: number, key: number, inst: Instance, e: number, valueSlot: number): void {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.fn || kind === OriginKind.site || kind === OriginKind.str) return
    const scope = isScope(origin)
    if (key !== elemKey && !scope && isIndexKey(key)) {
        const proxy = trapOf(origin)
        if (proxy) {
            const x = inst.summary.exprs[e]
            const index = key === dynKey ? -1 : heap.keyIndex(key as Handle)!
            const keyArg = key === dynKey ? at(inst, x.args[0]) : -1
            return virtualCall(storeSlot(inst, e), heap.getProxySetter(proxy), origin, [keyArg, valueSlot], [index < 0 ? NONE : literalScalar(index), NONE])
        }
    }
    if (key >= 0 && !scope) {
        let at = protoOf(origin)
        while (at) {
            const descriptor = heap.getOwnProperty(at, key as Handle)
            if (descriptor) {
                const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
                if (d.flags & heap.PropFlags.has_setter) {
                    flow.setterKeys.add(key)
                    return virtualCall(storeSlot(inst, e), d.slot1 as Handle, origin, [valueSlot], [])
                }
                break
            }
            at = heap.getPrototypeOf(at)
        }
    }
    const x = inst.summary.exprs[e]
    if (x.op === ExprOp.store && key >= 0 && receiverQual(inst.qual) === origin && deferInit(inst, x, origin, key, e, valueSlot)) return
    if (x.op === ExprOp.store) return writeField(fieldSlot(origin, key), valueSlot, writerId(inst, e), 'prop', true)
    writeField(fieldSlot(origin, key), typedStore(inst, e, valueSlot), writerId(inst, e), typeName(x.type), true)
}

function typedStore(inst: Instance, e: number, valueSlot: number): number {
    const key = writerId(inst, e)
    const known = flow.storeSlots.get(key)
    if (known !== undefined) return known
    const slot = storeSlot(inst, e)
    copyEdge(valueSlot, slot)
    return slot
}

function assignSource(origin: number, assign: number): void {
    flow.originCopied.add(origin)
    watchFields(origin, FieldWatch.assign, assign)
}

function assignField(assign: number, key: number, field: number): void {
    const inst = instOfSlot(assign)
    const x = exprAt(assign)
    const n = getNode(inst.summary.g, x.node)!
    if (assignExcluded(inst.summary.g, n).includes(key as Handle)) return
    listen(at(inst, x.args[0]), ListenerKind.assignTarget, field, key, 0)
}

function assignTarget(fromField: number, origin: number): void {
    writeField(fieldSlot(origin, flow.slotIndex[fromField]), fromField, -1, 'prop', false)
}

function callTarget(callSlot: number, target: number): void {
    const fn = originFunction(target)
    if (!fn) {
        if (flow.originKind[target] !== OriginKind.str) markOpaque(callSlot)
        return
    }
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    const s = summaryOf(fn)
    if (!s.hasThis) return bindCall(callSlot, target, 0)
    const recvExpr = inst.summary.exprs[x.b]
    if (recvExpr.op === ExprOp.konst) bindCall(callSlot, target, 0)
    const recv = at(inst, x.b)
    const origins = flow.slotOrigins[recv]
    const sent = flow.slotSent[recv]
    for (let i = 0; i < sent; i++) if (methodOf(inst, x, target, origins[i])) bindCall(callSlot, target, origins[i])
}

function methodOf(inst: Instance, x: Expr, target: number, recv: number): boolean {
    const m = inst.summary.exprs[x.a]
    if (m.op !== ExprOp.member || m.a !== x.b) return true
    const part = flow.parts.get(at(inst, x.a))?.get(recv)
    return part !== undefined && flow.slotOrigins[part].includes(target)
}

function callRecv(callSlot: number, recv: number): void {
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    const targetSlot = at(inst, x.a)
    const origins = flow.slotOrigins[targetSlot]
    const sent = flow.slotSent[targetSlot]
    for (let i = 0; i < sent; i++) {
        const fn = originFunction(origins[i])
        if (fn && summaryOf(fn).hasThis && methodOf(inst, x, origins[i], recv)) bindCall(callSlot, origins[i], recv)
    }
}

function rtSubject(callSlot: number, subject: number): void {
    if (flow.originKind[subject] === OriginKind.str) return
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    bindRt(inst, x, callSlot, bindingOf(x.a)!.impl!, subject, subject)
}

function bindCall(callSlot: number, target: number, recv: number): void {
    intrinsics.assert(recv < 4194304, `value-flow: origin ${recv} does not fit a call-binding key`)
    const key = target * 4194304 + recv
    if (flow.parts.get(callSlot)?.has(key)) return
    const x = exprAt(callSlot)
    const inst = instOfSlot(callSlot)
    const fn = boundCallee(flow.host, originFunction(target)!, getNode(inst.summary.g, x.node)!)
    const s = summaryOf(fn)
    const kind = flow.originKind[target]
    const perSite = s.returnsFresh && (!s.hasThis || s.params > 0) && getNode(inst.summary.g, x.node)?.op !== NodeOp.static
    const qual = s.hasThis && !perSite ? qualOf(recv) : !s.hasThis && kind === OriginKind.fresh ? target : perSite ? qualified(OriginKind.site, 0, inst.qual, x.node, inst.summary) : 0
    const callee = flow.instances[instance(fn, qual, -1, -1)]
    addCaller(callee, callSlot)
    for (let i = 0; i < s.params; i++) {
        if (i < x.args.length) copyEdge(at(inst, x.args[i]), callee.sigs[i])
        else addConst(callee.sigs[i], UNDEF)
    }
    if (s.hasThis) {
        if (recv) addOrigin(paramSlot(callee, -1), recv)
        if (!thisPinned(callee)) addIn(paramSlot(callee, -1), -at(inst, x.b) - 1)
    }
    if (s.usesCtx) addOrigin(paramSlot(callee, -2), target)
    const part = partSlot(callSlot, key)
    const cone = qual === 0 && !s.hasThis ? returnCone(s) : null
    const from = cone ? callee.ret : refineReturn(callee, part)
    flow.partBind.set(part, { callee: callee.id, from, kind: BindKind.call, target, recv })
    if (cone) siteReturn(callee, inst, x, callSlot, part, cone)
    else copyEdge(from, part)
}

function fillMissing(): boolean {
    let filled = false
    const missing = flow.missing
    flow.missing = []
    for (let i = 0; i < missing.length; i += 2) {
        const target = missing[i]
        const own = missing[i + 1]
        if (flow.slotIns[own]?.length || flow.slotConst[own] !== NONE) continue
        addConst(target, UNDEF)
        filled = true
    }
    return filled
}

function globalOrigins(slot: number): number[] {
    return flow.slotOrigins[slot]
}

function evalSlot(slot: number, value: (s: number) => number, originsOf: (s: number) => number[] = globalOrigins): number {
    let out = flow.slotConst[slot]
    const ins = flow.slotIns[slot]
    if (ins) for (const from of ins) out = unite(out, value(from >= 0 ? from : -from - 1))
    if (flow.slotOpaque[slot] && flow.slotKind[slot] !== SlotKind.expr) out = unite(out, UNKNOWN)
    if (flow.slotKind[slot] !== SlotKind.expr) return out
    const inst = flow.instances[flow.slotOwner[slot]]
    const x = inst.summary.exprs[flow.slotIndex[slot]]
    if (flow.slotOpaque[slot]) out = unite(out, opaqueScalar(inst.summary, x))
    switch (x.op) {
        case ExprOp.union:
            for (let i = 0; i < x.args.length; i++) {
                const gate = x.gates ? x.gates[i] ?? -1 : -1
                if (gate >= 0 && value(at(inst, gate)) === NONE) continue
                out = unite(out, value(at(inst, x.args[i])))
            }
        case ExprOp.gate:
            if (x.a >= 0 && value(at(inst, x.a)) === NONE) return out
            if (admits(value(at(inst, x.b)), originsOf(at(inst, x.b)).length > 0, x.key === 1)) out = unite(out, literalScalar(1))
        case ExprOp.ntype: out = unite(out, ntypeScalar(value(at(inst, x.a)), originsOf(at(inst, x.a)).length > 0))
        case ExprOp.narrow: out = unite(out, filterScalar(value(at(inst, x.a)), x.key, x.b, x.sub))
        case ExprOp.pick: out = unite(out, value(at(inst, x.a)))
        case ExprOp.arith: out = unite(out, arithScalar(x.key, x.sub, operandNumber(inst, x, x.a, value, originsOf), operandNumber(inst, x, x.b, value, originsOf)))
        case ExprOp.cmp: out = unite(out, foldCompare(x.key, operandNumber(inst, x, x.a, value, originsOf), operandNumber(inst, x, x.b, value, originsOf), originsOf(at(inst, x.a)), originsOf(at(inst, x.b))))
        case ExprOp.rt: out = unite(out, rtScalar(inst, x, value, originsOf))
        case ExprOp.member: if (scalars.flags[value(at(inst, x.a))] & ScalarFlag.unknown) out = unite(out, UNKNOWN)
    }
    return typedScalar(out, x.type)
}

function admits(t: number, objects: boolean, truthy: boolean): boolean {
    const f = scalars.flags[t]
    if (f & (ScalarFlag.unknown | ScalarFlag.float | ScalarFlag.anyStr)) return true
    if (truthy) {
        if (objects || (f & ScalarFlag.yes)) return true
        if ((f & ScalarFlag.int) && !(scalars.lo[t] === 0 && scalars.hi[t] === 0)) return true
        return scalars.strs[t].length > 0
    }
    if (f & (ScalarFlag.undef | ScalarFlag.void | ScalarFlag.no)) return true
    if ((f & ScalarFlag.int) && scalars.lo[t] <= 0 && scalars.hi[t] >= 0) return true
    for (const h of scalars.strs[t]) if (heap.stringToJs(h as Handle) === '') return true
    return false
}

function ntypeScalar(t: number, objects: boolean): number {
    const f = scalars.flags[t]
    if (t === NONE && !objects) return NONE
    if (f & ScalarFlag.unknown) return numScalar(Types.u64, Types.f64)
    const float = (f & ScalarFlag.float) !== 0
    const other = objects || (f & ~ScalarFlag.float) !== 0
    if (float && other) return numScalar(Types.u64, Types.f64)
    return literalScalar(float ? Types.f64 : Types.u64)
}

function onlyInts(t: number, origins: number[]): boolean {
    return scalars.flags[t] === ScalarFlag.int && origins.length === 0
}

function disjoint(a: number, b: number): boolean {
    const la = literalsOf(a)
    const lb = literalsOf(b)
    if (!la || !lb) return false
    for (const v of la) if (lb.includes(v)) return false
    return true
}

function foldCompare(op: NodeOp, a0: number, b0: number, originsA: number[], originsB: number[]): number {
    if ((a0 === NONE && !originsA.length) || (b0 === NONE && !originsB.length)) return NONE
    const a = boolNumbers(a0)
    const b = boolNumbers(b0)
    const fa = scalars.flags[a]
    const fb = scalars.flags[b]
    if ((fa | fb) & ScalarFlag.unknown) return BOOL
    if (onlyInts(a, originsA) && onlyInts(b, originsB)) {
        const alo = scalars.lo[a]
        const ahi = scalars.hi[a]
        const blo = scalars.lo[b]
        const bhi = scalars.hi[b]
        switch (op) {
            case NodeOp.lt: return ahi < blo ? TRUE : alo >= bhi ? FALSE : BOOL
            case NodeOp.le: return ahi <= blo ? TRUE : alo > bhi ? FALSE : BOOL
            case NodeOp.gt: return alo > bhi ? TRUE : ahi <= blo ? FALSE : BOOL
            case NodeOp.ge: return alo >= bhi ? TRUE : ahi < blo ? FALSE : BOOL
            case NodeOp.eq:
                if (alo === ahi && blo === bhi && alo === blo) return TRUE
                return ahi < blo || bhi < alo || disjoint(a, b) ? FALSE : BOOL
            case NodeOp.ne:
                if (alo === ahi && blo === bhi && alo === blo) return FALSE
                return ahi < blo || bhi < alo || disjoint(a, b) ? TRUE : BOOL
        }
        return BOOL
    }
    if (op !== NodeOp.eq && op !== NodeOp.ne) return BOOL
    const equal = op === NodeOp.eq
    const strA = fa === ScalarFlag.str && scalars.strs[a].length === 1 && onlyStrOrigins(originsA)
    const strB = fb === ScalarFlag.str && scalars.strs[b].length === 1 && onlyStrOrigins(originsB)
    if (strA && strB) {
        const same = scalars.strs[a][0] === scalars.strs[b][0] || heap.stringToJs(scalars.strs[a][0] as Handle) === heap.stringToJs(scalars.strs[b][0] as Handle)
        return truthScalar(same === equal)
    }
    if (fa === ScalarFlag.str && fb === ScalarFlag.str && onlyStrOrigins(originsA) && onlyStrOrigins(originsB) && distinctStrings(scalars.strs[a], scalars.strs[b])) {
        return truthScalar(!equal)
    }
    const undefA = (fa & ~(ScalarFlag.undef | ScalarFlag.void)) === 0 && (fa & (ScalarFlag.undef | ScalarFlag.void)) !== 0 && !originsA.length
    const undefB = (fb & ~(ScalarFlag.undef | ScalarFlag.void)) === 0 && (fb & (ScalarFlag.undef | ScalarFlag.void)) !== 0 && !originsB.length
    const definedA = (fa & (ScalarFlag.undef | ScalarFlag.void)) === 0 && (originsA.length > 0 || (fa & (ScalarFlag.str | ScalarFlag.anyStr | ScalarFlag.int | ScalarFlag.float | ScalarFlag.no | ScalarFlag.yes)) !== 0)
    const definedB = (fb & (ScalarFlag.undef | ScalarFlag.void)) === 0 && (originsB.length > 0 || (fb & (ScalarFlag.str | ScalarFlag.anyStr | ScalarFlag.int | ScalarFlag.float | ScalarFlag.no | ScalarFlag.yes)) !== 0)
    const truths = ScalarFlag.no | ScalarFlag.yes
    const numbers = ScalarFlag.int | ScalarFlag.float | ScalarFlag.unknown | truths
    const ra = scalars.flags[a0]
    const rb = scalars.flags[b0]
    const boolA = ra !== 0 && (ra & ~truths) === 0 && !originsA.length
    const boolB = rb !== 0 && (rb & ~truths) === 0 && !originsB.length
    if ((boolA && !(rb & numbers)) || (boolB && !(ra & numbers))) return truthScalar(!equal)
    if (undefA && undefB) return truthScalar(equal)
    if ((undefA && definedB) || (definedA && undefB)) return truthScalar(!equal)
    const numberA = ra !== 0 && (ra & ~(ScalarFlag.int | ScalarFlag.float)) === 0 && !originsA.length
    const numberB = rb !== 0 && (rb & ~(ScalarFlag.int | ScalarFlag.float)) === 0 && !originsB.length
    if ((numberA && !(rb & numbers)) || (numberB && !(ra & numbers))) return truthScalar(!equal)
    return BOOL
}

function distinctStrings(a: number[], b: number[]): boolean {
    for (const x of a) {
        const text = heap.stringToJs(x as Handle)
        for (const y of b) if (x === y || heap.stringToJs(y as Handle) === text) return false
    }
    return true
}

function onlyStrOrigins(origins: number[]): boolean {
    for (const a of origins) if (flow.originKind[a] !== OriginKind.str) return false
    return true
}

function rtScalar(inst: Instance, x: Expr, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    const op = x.a
    if (op === RtOp.typeof) return typeofScalar(at(inst, x.args[0]), value, originsOf)
    if (op === RtOp.toNumber) return coercedScalar(at(inst, x.args[0]), value, originsOf)
    if (stringRt.has(op)) return ANYSTR
    if (wordOps.has(op)) return numScalar(0, 2 ** 32 - 1)
    if (op === RtOp.hasPrototype) return prototypeScalar(inst, x, value, originsOf)
    if (op === RtOp.strictEqual || op === RtOp.truthy || op === RtOp.nullish || op === RtOp.hasProperty) return BOOL
    if (op === RtOp.paramCount || op === RtOp.restIndex) return I64
    return NONE
}

function prototypeScalar(inst: Instance, x: Expr, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    if (x.args.length < 2) return BOOL
    const holders = originsOf(at(inst, x.args[1]))
    if (holders.length !== 1 || value(at(inst, x.args[1])) !== NONE || flow.originKind[holders[0]] !== OriginKind.static || !flow.originCell[holders[0]]) return BOOL
    const proto = heap.deref(flow.originCell[holders[0]] as Handle)
    const t = value(at(inst, x.args[0]))
    if (scalars.flags[t] & ScalarFlag.unknown) return BOOL
    let yes = false
    let no = t !== NONE
    for (const origin of originsOf(at(inst, x.args[0]))) {
        const has = chainHas(origin, proto)
        if (has < 0) return BOOL
        if (has) yes = true
        else no = true
    }
    if (yes && no) return BOOL
    return yes ? TRUE : no ? FALSE : NONE
}

function typeofScalar(slot: number, value: (s: number) => number, originsOf: (s: number) => number[]): number {
    const t = value(slot)
    const f = scalars.flags[t]
    if (f & ScalarFlag.unknown) return ANYSTR
    const names: number[] = []
    if (f & (ScalarFlag.int | ScalarFlag.float)) names.push(heap.typeNames.number as number)
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) names.push(heap.typeNames.string as number)
    if (f & (ScalarFlag.undef | ScalarFlag.void)) names.push(heap.typeNames.undefined as number)
    if (f & (ScalarFlag.no | ScalarFlag.yes)) names.push(heap.typeNames.boolean as number)
    for (const a of originsOf(slot)) {
        const k = flow.originKind[a]
        const name = (k === OriginKind.str ? heap.typeNames.string : originHostFn(a) ? heap.typeNames.function : heap.typeNames.object) as number
        if (!names.includes(name)) names.push(name)
    }
    names.sort((a, b) => a - b)
    return scalar(ScalarFlag.str, 0, 0, names)
}

function exprUses(slot: number): void {
    const inst = flow.instances[flow.slotOwner[slot]]
    const x = inst.summary.exprs[flow.slotIndex[slot]]
    if (x.op === ExprOp.union) for (const a of x.args) scalarUse(at(inst, a), slot)
    if (x.gates) for (const gate of x.gates) if (gate >= 0) scalarUse(at(inst, gate), slot)
    if (x.op === ExprOp.gate) {
        if (x.a >= 0) scalarUse(at(inst, x.a), slot)
        scalarUse(at(inst, x.b), slot)
    }
    if (x.op === ExprOp.ntype || x.op === ExprOp.narrow || x.op === ExprOp.pick) scalarUse(at(inst, x.a), slot)
    if (x.op === ExprOp.cmp || x.op === ExprOp.arith) {
        scalarUse(at(inst, x.a), slot)
        scalarUse(at(inst, x.b), slot)
    }
    if (x.op === ExprOp.rt && (x.a === RtOp.typeof || x.a === RtOp.toNumber || x.a === RtOp.hasPrototype)) scalarUse(at(inst, x.args[0]), slot)
    if (x.op === ExprOp.member) scalarUse(at(inst, x.a), slot)
}

function components(n: number, roots: number[], edgesOf: (v: number) => number[], emit: (group: number[], cyclic: boolean, edges: number[][]) => void): void {
    const index = new Int32Array(n).fill(-1)
    const low = new Int32Array(n)
    const onStack = new Uint8Array(n)
    const lists: number[][] = new Array(n)
    const stack: number[] = []
    const call: number[] = []
    const edgeAt: number[] = []
    let counter = 0
    const enter = (v: number) => {
        index[v] = low[v] = counter++
        stack.push(v)
        onStack[v] = 1
        lists[v] = edgesOf(v)
        call.push(v)
        edgeAt.push(0)
    }
    for (const root of roots) {
        if (index[root] >= 0) continue
        enter(root)
        while (call.length) {
            const v = call[call.length - 1]
            const list = lists[v]
            const k = edgeAt[edgeAt.length - 1]
            if (k < list.length) {
                edgeAt[edgeAt.length - 1] = k + 1
                const w = list[k]
                if (index[w] < 0) enter(w)
                else if (onStack[w] && index[w] < low[v]) low[v] = index[w]
                continue
            }
            call.pop()
            edgeAt.pop()
            if (call.length) {
                const u = call[call.length - 1]
                if (low[v] < low[u]) low[u] = low[v]
            }
            if (low[v] !== index[v]) continue
            const group: number[] = []
            for (;;) {
                const w = stack.pop()!
                onStack[w] = 0
                group.push(w)
                if (w === v) break
            }
            emit(group, group.length > 1 || list.includes(v), lists)
            for (const w of group) lists[w] = []
        }
    }
}

function widens(slot: number): boolean {
    if (flow.slotKind[slot] !== SlotKind.expr) return true
    const op = exprAt(slot).op
    return op !== ExprOp.narrow && op !== ExprOp.pick && op !== ExprOp.arith
}

function globalValue(slot: number): number {
    return flow.scalar[slot]
}

function drainScalars(): void {
    const queue = flow.scalarQueue
    let i = 0
    while (i < queue.length) {
        const s = queue[i++]
        flow.scalarQueued[s] = 0
        updateScalar(s)
    }
    queue.length = 0
}

function updateScalar(s: number): void {
    charge(1)
    if (flow.stringSite[s]) checkString(s)
    const old = flow.scalar[s]
    let next = unite(old, evalSlot(s, globalValue))
    if (next === old) return
    if (widens(s) && (scalars.flags[next] & ScalarFlag.int) && (scalars.flags[old] & ScalarFlag.int) && (scalars.lo[next] !== scalars.lo[old] || scalars.hi[next] !== scalars.hi[old])) {
        flow.scalarChanges[s]++
        if (flow.scalarChanges[s] >= 2) {
            const lo = scalars.lo[next] < scalars.lo[old] ? (scalars.lo[old] > 0 ? 0 : MinI64) : scalars.lo[next]
            const hi = scalars.hi[next] > scalars.hi[old] ? (lo < 0 ? MaxI64 : MaxU64) : scalars.hi[next]
            next = unite(next, numScalar(lo, hi))
        }
    }
    flow.scalar[s] = next
    dirtyUsers(s)
    if (old !== NONE) return
    const waiting = flow.gateWaits.get(s)
    if (!waiting) return
    flow.gateWaits.delete(s)
    for (let i = 0; i < waiting.length; i += 2) wireEffect(flow.instances[waiting[i]], waiting[i + 1])
}

function groupUsers(group: number[], edges: number[][]): number[][] {
    const local = new Map<number, number>()
    for (let i = 0; i < group.length; i++) local.set(group[i], i)
    const users: number[][] = []
    for (let i = 0; i < group.length; i++) users.push([])
    for (let i = 0; i < group.length; i++) {
        for (const d of edges[group[i]]) {
            const at = local.get(d)
            if (at !== undefined) users[at].push(i)
        }
    }
    return users
}

function settleGroup(group: number[], users: number[][], step: (i: number, v: number) => boolean): void {
    const dirty = new Uint8Array(group.length).fill(1)
    let pending = group.length
    while (pending > 0) {
        for (let i = 0; i < group.length; i++) {
            if (!dirty[i]) continue
            dirty[i] = 0
            pending--
            if (!step(i, group[i])) continue
            for (const u of users[i]) {
                if (dirty[u]) continue
                dirty[u] = 1
                pending++
            }
        }
    }
}

function seedRoot(fn: Function, qual: number): number[] {
    const inst = flow.instances[instance(fn, summaryOf(fn).hasThis ? qual : 0, -1, -1)]
    flow.rooted.add(inst.id)
    const g = inst.summary.g
    let declared = 0
    for (const p of g.blocks[0].params) {
        const n = getNode(g, p)!
        if (isThisParam(n)) continue
        addConst(inst.sigs[declared], typeRange(typeOf(n)))
        declared++
    }
    const s = inst.summary
    if (s.usesCtx) for (const x of s.exprs) {
        if (x.op === ExprOp.param && x.a === -2) addConst(paramSlot(inst, -2), opaqueScalar(s, x))
    }
    return inst.sigs.slice(0, s.params)
}

interface Spec {
    inst: Instance
    global: boolean
    params: number[]
    paramOrigins: number[][]
    scalar: number[]
    origins: number[][]
    calls: Map<number, Spec>
    dead: Set<number>
}

interface SpecState {
    globals: Map<number, Spec>
    memo: Map<number, Map<string, Spec>>
    grown: Map<Spec, number>
    recursive: Set<number>
    active: Set<number>
    classes: (string | undefined)[]
}

interface Arrival {
    from: Spec | undefined
    part: number
    params: number[]
    origins: number[][]
}

const widenAfter = 3
const directRt = new Set<number>([RtOp.slice, RtOp.create, RtOp.concat, RtOp.toString, RtOp.assign, RtOp.stringOf])

function callerInstance(slot: number): Instance {
    const inst = instOfSlot(slot)
    return inst.site ?? inst
}

function callOrder(): [number[], boolean][] {
    const edges = new Map<number, number[]>()
    for (const [part, bind] of flow.partBind) {
        const owner = callerInstance(part)
        if (bind.kind !== BindKind.virtual && owner === instOfSlot(part)) {
            const [params, origins] = callArgs(globalSpec(owner), part, bind)
            if (impossibleArgs(flow.instances[bind.callee], params, origins)) continue
        }
        const from = owner.id
        let list = edges.get(from)
        if (!list) edges.set(from, list = [])
        list.push(bind.callee)
        charge(1)
    }
    for (const [slot, callees] of flow.runtimeBinds) {
        const from = callerInstance(slot).id
        let list = edges.get(from)
        if (!list) edges.set(from, list = [])
        for (const callee of callees) list.push(callee)
    }
    const out: [number[], boolean][] = []
    const roots: number[] = []
    for (const inst of flow.instances) if (!inst.site) roots.push(inst.id)
    components(flow.instances.length, roots, v => edges.get(v) ?? [], (members, recursive) => out.push([members, recursive]))
    out.reverse()
    return out
}

function sigIndex(spec: Spec, slot: number): number {
    return flow.slotKind[slot] === SlotKind.sig && flow.slotOwner[slot] === spec.inst.id ? flow.slotIndex[slot] : -1
}

function globalSpec(inst: Instance): Spec {
    const known = flow.spec.globals.get(inst.id)
    if (known) return known
    const params: number[] = []
    const paramOrigins: number[][] = []
    for (const sig of inst.sigs) {
        params.push(flow.scalar[sig])
        paramOrigins.push(flow.slotOrigins[sig])
    }
    const spec: Spec = { inst, global: true, params, paramOrigins, scalar: [], origins: [], calls: new Map(), dead: new Set() }
    flow.spec.globals.set(inst.id, spec)
    return spec
}

function specScalar(spec: Spec, slot: number): number {
    if (spec.global) return flow.scalar[slot]
    const k = slot - spec.inst.base
    if (k >= 0 && k < spec.inst.summary.width && flow.slotKind[slot] === SlotKind.expr) {
        return spec.scalar[k]
    }
    const i = sigIndex(spec, slot)
    if (i >= 0) return spec.params[i]
    if (flow.slotKind[slot] === SlotKind.part && ownsPart(spec, slot)) {
        if (!partLive(spec, slot) || spec.dead.has(slot)) return NONE
        const c = spec.calls.get(slot)
        if (c && !c.global && flow.partBind.get(slot)!.from >= 0) return specScalar(c, flow.partBind.get(slot)!.from)
    }
    return flow.scalar[slot]
}

function specOrigins(spec: Spec, slot: number): number[] {
    if (spec.global) return flow.slotOrigins[slot]
    const k = slot - spec.inst.base
    if (k >= 0 && k < spec.inst.summary.width && flow.slotKind[slot] === SlotKind.expr) {
        return spec.origins[k]
    }
    const i = sigIndex(spec, slot)
    if (i >= 0) return spec.paramOrigins[i]
    if (flow.slotKind[slot] === SlotKind.part && ownsPart(spec, slot)) {
        if (!partLive(spec, slot) || spec.dead.has(slot)) return []
        const c = spec.calls.get(slot)
        if (c && !c.global && flow.partBind.get(slot)!.from >= 0) return specOrigins(c, flow.partBind.get(slot)!.from)
    }
    return flow.slotOrigins[slot]
}

function ownsPart(spec: Spec, part: number): boolean {
    const owner = flow.slotOwner[part]
    const k = owner - spec.inst.base
    return k >= 0 && k < spec.inst.summary.width && flow.slotKind[owner] === SlotKind.expr
}

function partLive(spec: Spec, part: number): boolean {
    const owner = flow.slotOwner[part]
    const inst = spec.inst
    const x = inst.summary.exprs[flow.slotIndex[owner]]
    const bind = flow.partBind.get(part)
    const gate = x.gates && (x.op === ExprOp.call || x.op === ExprOp.rt) ? x.gates[0] : -1
    if (gate >= 0 && specScalar(spec, at(inst, gate)) === NONE) return false
    if (bind?.kind === BindKind.call) return specOrigins(spec, at(inst, x.a)).includes(bind.target) && (!bind.recv || specOrigins(spec, at(inst, x.b)).includes(bind.recv))
    if (bind?.kind === BindKind.rt && coerces(x) && flow.slotIndex[part] === compareKey) return specStringy(spec, at(inst, x.a)) && specStringy(spec, at(inst, x.b))
    if (bind?.kind === BindKind.rt && (coerces(x) || (x.op === ExprOp.rt && x.a === RtOp.toNumber))) {
        const operand = at(inst, rtOperands(inst, x, part)[0])
        return convertedMembers(specScalar(spec, operand), specStringy(spec, operand)) !== NONE
    }
    if (bind?.kind === BindKind.rt && concatSite(inst, x)) return specStringy(spec, at(inst, x.a)) || specStringy(spec, at(inst, x.b))
    if (bind?.kind === BindKind.rt) return !bind.recv || specOrigins(spec, at(inst, x.args[0])).includes(bind.recv)
    if (x.op === ExprOp.member) return specOrigins(spec, at(inst, x.a)).includes(flow.slotIndex[part])
    if (x.op === ExprOp.rt && x.args.length) return specOrigins(spec, at(inst, x.args[0])).includes(flow.slotIndex[part])
    return true
}

function specStringy(spec: Spec, slot: number): boolean {
    return stringsIn(specScalar(spec, slot), specOrigins(spec, slot))
}

function addOrigins(into: number[], from: number[]): number[] {
    let out = into
    for (const a of from) {
        if (out.includes(a)) continue
        if (out === into) out = into.slice()
        out.push(a)
    }
    return out
}

function partOrigins(spec: Spec, slot: number, into: number[]): number[] {
    let out = into
    const parts = flow.parts.get(slot)
    if (!parts) return out
    for (const part of parts.values()) out = addOrigins(out, specOrigins(spec, part))
    return out
}

function localOrigins(spec: Spec, x: Expr, slot: number): number[] {
    const inst = spec.inst
    switch (x.op) {
        case ExprOp.union: {
            let out: number[] = []
            for (let i = 0; i < x.args.length; i++) {
                const gate = x.gates ? x.gates[i] ?? -1 : -1
                if (gate >= 0 && specScalar(spec, at(inst, gate)) === NONE) continue
                out = addOrigins(out, specOrigins(spec, at(inst, x.args[i])))
            }
            return out
        }
        case ExprOp.narrow:
        case ExprOp.pick: {
            const from = specOrigins(spec, at(inst, x.a))
            const all = flow.slotOrigins[slot]
            return from.filter(a => all.includes(a))
        }
        case ExprOp.member:
        case ExprOp.call: return partOrigins(spec, slot, [])
        case ExprOp.rt: return directRt.has(x.a) ? flow.slotOrigins[slot] : partOrigins(spec, slot, [])
    }
    return flow.slotOrigins[slot]
}

function localFix(spec: Spec): void {
    const inst = spec.inst
    const s = inst.summary
    spec.scalar = new Array(s.width).fill(NONE)
    spec.origins = []
    for (let k = 0; k < s.width; k++) spec.origins.push([])
    const changes = new Uint8Array(s.width)
    const value = (slot: number) => specScalar(spec, slot)
    const originsOf = (slot: number) => specOrigins(spec, slot)
    const step = (i: number, e: number): boolean => {
        const k = s.local![e]
        const slot = inst.base + k
        charge(1)
        bindLocalCalls(spec, slot)
        let t = unite(spec.scalar[k], evalSlot(slot, value, originsOf))
        let origins = addOrigins(spec.origins[k], localOrigins(spec, s.exprs[e], slot))
        if (t === spec.scalar[k] && origins.length === spec.origins[k].length) return false
        if (changes[k] < 255) changes[k]++
        if (changes[k] > widenAfter) {
            t = unite(t, flow.scalar[slot])
            origins = addOrigins(origins, flow.slotOrigins[slot])
        }
        spec.scalar[k] = t
        spec.origins[k] = origins
        return true
    }
    const order = orderOf(s)
    for (let g = 0; g < order.groups.length; g++) {
        const users = order.users[g]
        if (users) settleGroup(order.groups[g], users, step)
        else step(0, order.groups[g][0])
    }
}

function orderOf(s: Summary): Order {
    if (s.order) return s.order
    const order: Order = { groups: [], users: [] }
    components(s.exprs.length, s.owned, e => ownedOperands(s, e), (group, cyclic, edges) => {
        order.groups.push(group)
        order.users.push(cyclic ? groupUsers(group, edges) : undefined)
    })
    s.order = order
    return order
}

function ownedOperands(s: Summary, e: number): number[] {
    const x = s.exprs[e]
    const all: number[] = []
    if (x.gates) for (const gate of x.gates) all.push(gate)
    switch (x.op) {
        case ExprOp.union:
        case ExprOp.rt:
        case ExprOp.opaque:
            for (const a of x.args) all.push(a)
        case ExprOp.narrow:
        case ExprOp.pick:
        case ExprOp.ntype:
            all.push(x.a)
        case ExprOp.gate:
        case ExprOp.arith:
        case ExprOp.cmp:
            all.push(x.a)
            all.push(x.b)
        case ExprOp.member:
            all.push(x.a)
            if (x.key === dynKey) all.push(x.b)
        case ExprOp.call:
            all.push(x.a)
            all.push(x.b)
            for (const a of x.args) all.push(a)
    }
    const n = x.op === ExprOp.union && x.node ? getNode(s.g, x.node) : undefined
    if (n?.op === NodeOp.select) all.push(s.exprOf.get(getRef(n, 0)) ?? -1)
    const out: number[] = []
    for (const a of all) if (a >= 0 && s.local![a] >= 0 && s.local![a] < s.width) out.push(a)
    return out
}

function callArgs(spec: Spec, part: number, bind: Bind): [number[], number[][]] {
    const inst = spec.inst
    const x = exprAt(part)
    const callee = flow.instances[bind.callee]
    const cs = callee.summary
    const params: number[] = []
    const origins: number[][] = []
    for (const sig of callee.sigs) {
        params.push(flow.scalar[sig])
        origins.push(flow.slotOrigins[sig])
    }
    const set = (i: number, t: number, a: number[]) => {
        if (i < 0 || i >= callee.sigs.length || flow.slotKind[callee.sigs[i]] !== SlotKind.sig) return
        params[i] = t
        origins[i] = a
    }
    if (bind.kind === BindKind.rt) {
        const args = rtOperands(inst, x, part)
        for (let i = 0; i < cs.params; i++) {
            if (i >= args.length) set(i, UNDEF, [])
            else if (i === 0 && bind.recv) set(0, specScalar(spec, at(inst, args[0])), [bind.recv])
            else if (i === 0 && !bind.target && x.op === ExprOp.rt && x.a !== RtOp.toNumber) set(0, specScalar(spec, at(inst, args[0])), [])
            else set(i, specScalar(spec, at(inst, args[i])), specOrigins(spec, at(inst, args[i])))
        }
        return [params, origins]
    }
    for (let i = 0; i < cs.params; i++) {
        if (i >= x.args.length) set(i, UNDEF, [])
        else set(i, specScalar(spec, at(inst, x.args[i])), specOrigins(spec, at(inst, x.args[i])))
    }
    if (cs.hasThis) set(paramOffset(cs, -1), bind.kind === BindKind.call ? specScalar(spec, at(inst, x.b)) : NONE, bind.recv ? [bind.recv] : [])
    if (cs.usesCtx) set(paramOffset(cs, -2), NONE, [bind.target])
    return [params, origins]
}

function joinArrivals(inst: Instance, list: Arrival[]): Spec {
    const params = list[0].params.slice()
    const paramOrigins = list[0].origins.slice()
    for (let k = 1; k < list.length; k++) {
        for (let i = 0; i < params.length; i++) {
            params[i] = unite(params[i], list[k].params[i])
            paramOrigins[i] = addOrigins(paramOrigins[i], list[k].origins[i])
        }
    }
    return specOf(inst, params, paramOrigins, true)
}

function covers(spec: Spec, params: number[], paramOrigins: number[][], exact: boolean): boolean {
    if (spec.global && !exact) return true
    for (let i = 0; i < params.length; i++) {
        if (exact && (spec.params[i] !== params[i] || spec.paramOrigins[i].length !== paramOrigins[i].length)) return false
        if (unite(spec.params[i], params[i]) !== spec.params[i]) return false
        for (const a of paramOrigins[i]) if (!spec.paramOrigins[i].includes(a)) return false
    }
    return true
}

function specOf(inst: Instance, params: number[], paramOrigins: number[][], exact: boolean): Spec {
    if (flow.spec.recursive.has(inst.id) || flow.spec.active.has(inst.id)) return globalSpec(inst)
    let memo = flow.spec.memo.get(inst.id)
    if (!memo) flow.spec.memo.set(inst.id, memo = new Map())
    const key = arrivalClass(inst, { from: undefined, part: -1, params, origins: paramOrigins })
    const known = memo.get(key)
    if (known && covers(known, params, paramOrigins, exact)) return known
    let joined = params
    let joinedOrigins = paramOrigins
    if (known && !exact) {
        joined = params.slice()
        joinedOrigins = paramOrigins.slice()
        for (let i = 0; i < joined.length; i++) {
            joined[i] = unite(joined[i], known.params[i])
            joinedOrigins[i] = addOrigins(joinedOrigins[i], known.paramOrigins[i])
        }
    }
    const grown = known ? (flow.spec.grown.get(known) ?? 0) + 1 : 0
    if (grown > widenAfter) {
        const spec = globalSpec(inst)
        if (!exact) memo.set(key, spec)
        return spec
    }
    const spec: Spec = { inst, global: false, params: joined, paramOrigins: joinedOrigins, scalar: [], origins: [], calls: new Map(), dead: new Set() }
    flow.spec.grown.set(spec, grown)
    flow.spec.active.add(inst.id)
    localFix(spec)
    flow.spec.active.delete(inst.id)
    memo.set(key, spec)
    return spec
}

function bindLocalCalls(spec: Spec, slot: number): void {
    const parts = flow.parts.get(slot)
    if (!parts) return
    for (const part of parts.values()) {
        const bind = flow.partBind.get(part)
        if (!bind || bind.kind === BindKind.virtual) continue
        if (!partLive(spec, part)) {
            spec.calls.delete(part)
            continue
        }
        const callee = flow.instances[bind.callee]
        const [params, origins] = callArgs(spec, part, bind)
        if (impossibleArgs(callee, params, origins)) {
            spec.calls.delete(part)
            spec.dead.add(part)
            continue
        }
        spec.dead.delete(part)
        spec.calls.set(part, specOf(callee, params, origins, false))
    }
}

function nullishOnly(t: number, origins: number[]): boolean {
    return t !== NONE && (scalars.flags[t] & ~(ScalarFlag.undef | ScalarFlag.void)) === 0 && !origins.length
}

function impossibleExpr(spec: Spec, e: number, memo: Map<number, boolean>): boolean {
    const known = memo.get(e)
    if (known !== undefined) return known
    memo.set(e, false)
    const inst = spec.inst
    const s = inst.summary
    const x = s.exprs[e]
    let dead = false
    const operand = (a: number) => a >= 0 && impossibleExpr(spec, a, memo)
    switch (x.op) {
        case ExprOp.konst:
        case ExprOp.origin:
        case ExprOp.param:
        case ExprOp.alloc:
        case ExprOp.union:
            break
        case ExprOp.member:
            dead = operand(x.a) || nullishOnly(specScalar(spec, at(inst, x.a)), specOrigins(spec, at(inst, x.a)))
            break
        case ExprOp.call:
        case ExprOp.rt: {
            for (const a of x.args) if (operand(a)) dead = true
            const parts = s.local![e] >= 0 && s.local![e] < s.width ? flow.parts.get(inst.base + s.local![e]) : undefined
            if (!dead && parts && parts.size) {
                let all = true
                for (const part of parts.values()) if (!spec.dead.has(part)) all = false
                dead = all
            }
            break
        }
        case ExprOp.arith:
        case ExprOp.cmp:
            dead = operand(x.a) || operand(x.b)
            break
        case ExprOp.narrow:
        case ExprOp.pick:
        case ExprOp.ntype:
            dead = operand(x.a)
            break
    }
    memo.set(e, dead)
    return dead
}

function impossibleArgs(callee: Instance, params: number[], origins: number[][]): boolean {
    for (let i = 0; i < params.length; i++) {
        if (flow.slotKind[callee.sigs[i]] === SlotKind.sig && params[i] === NONE && !origins[i].length) return true
    }
    return false
}

function globalArrival(inst: Instance, from: Spec | undefined, part: number): Arrival {
    const spec = globalSpec(inst)
    return { from, part, params: spec.params, origins: spec.paramOrigins }
}

function originClass(origin: number): string {
    const known = flow.spec.classes[origin]
    if (known !== undefined) return known
    const kind = flow.originKind[origin]
    let name = 'Scope'
    if (kind === OriginKind.slice) name = 'buffer'
    else if (kind === OriginKind.site) name = 'site'
    else if (!isScope(origin)) {
        const state = heapState(origin)
        name = state !== undefined && heap.isArray(state) ? 'Array' : constructorName(protoOf(origin))
        const elements = elementClass(origin)
        if (elements) name = `${name}<${elements}>`
    }
    flow.spec.classes[origin] = name
    return name
}

function elementClass(origin: number): string {
    let t = NONE
    let origins: number[] = []
    const visit = (owner: number) => {
        for (const [key, slot] of flow.originFields[owner]) {
            if (key !== elemKey && !isPosKey(key)) continue
            t = unite(t, flow.scalar[slot])
            origins = addOrigins(origins, flow.slotOrigins[slot])
        }
    }
    visit(origin)
    for (const slot of flow.originFields[origin].values()) for (const a of flow.slotOrigins[slot]) if (flow.originKind[a] === OriginKind.slice) visit(a)
    if (t === NONE && !origins.length) return ''
    const f = scalars.flags[t]
    const parts = new Set<string>()
    if (f & ScalarFlag.unknown) parts.add('?')
    if (f & (ScalarFlag.undef | ScalarFlag.void)) parts.add('u')
    if (f & (ScalarFlag.int | ScalarFlag.float)) parts.add('n')
    if (f & (ScalarFlag.no | ScalarFlag.yes)) parts.add('b')
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) parts.add('s')
    for (const a of origins) parts.add(flow.originKind[a] === OriginKind.str ? 's' : originHostFn(a) ? 'f' : 'o')
    return [...parts].sort().join('|')
}

function classOfValue(t: number, origins: number[]): string {
    const f = scalars.flags[t]
    const parts = new Set<string>()
    if (f & ScalarFlag.unknown) parts.add('?')
    if (f & (ScalarFlag.undef | ScalarFlag.void)) parts.add('u')
    if (f & ScalarFlag.int) parts.add('i')
    if (f & ScalarFlag.float) parts.add('d')
    if (f & (ScalarFlag.no | ScalarFlag.yes)) parts.add('b')
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) parts.add('s')
    for (const a of origins) {
        const fn = originHostFn(a)
        if (flow.originKind[a] === OriginKind.str) parts.add('s')
        else if (fn) parts.add(`f${unitKeyOf(fn)}`)
        else parts.add(`o${originClass(a)}`)
    }
    if (parts.has('d')) {
        parts.delete('i')
        parts.delete('u')
    }
    if (parts.has('i')) parts.delete('u')
    return [...parts].sort().join('|')
}

function arrivalClass(inst: Instance, a: Arrival): string {
    const sigs = inst.sigs
    let key = ''
    for (let i = 0; i < sigs.length; i++) if (flow.slotKind[sigs[i]] === SlotKind.sig) key += `${classOfValue(a.params[i], a.origins[i])},`
    return key
}

interface FrameInfo {
    inst: Instance
    members: Spec[]
    key: string
    sites: Site[]
}

function buildFrames(): void {
    const bindsInto = new Map<number, number>()
    const coneParts = new Map<number, number[]>()
    for (const [part, bind] of flow.partBind) {
        bindsInto.set(bind.callee, (bindsInto.get(bind.callee) ?? 0) + 1)
        const owner = callerInstance(part)
        if (owner === instOfSlot(part)) continue
        let list = coneParts.get(owner.id)
        if (!list) coneParts.set(owner.id, list = [])
        list.push(part)
    }
    const arrivals = new Map<number, Arrival[]>()
    const built = new Map<number, Spec>()
    const edges: [Spec, number, Spec][] = []
    const arrive = (callee: number, a: Arrival) => {
        charge(1)
        const fixed = built.get(callee)
        if (fixed) {
            edges.push([a.from!, a.part, fixed])
            return
        }
        let list = arrivals.get(callee)
        if (!list) arrivals.set(callee, list = [])
        list.push(a)
    }
    const leave = (spec: Spec) => {
        const s = spec.inst.summary
        for (const e of s.owned) {
            const slot = spec.inst.base + s.local![e]
            for (const callee of flow.runtimeBinds.get(slot) ?? []) arrive(callee, globalArrival(flow.instances[callee], spec, slot))
            const parts = flow.parts.get(slot)
            if (!parts) continue
            for (const part of parts.values()) {
                const bind = flow.partBind.get(part)
                if (!bind) continue
                if (!spec.global && !partLive(spec, part)) continue
                const callee = flow.instances[bind.callee]
                if (bind.kind === BindKind.virtual) {
                    arrive(callee.id, globalArrival(callee, spec, part))
                    continue
                }
                const [params, origins] = callArgs(spec, part, bind)
                if (impossibleArgs(callee, params, origins)) continue
                arrive(callee.id, { from: spec, part, params, origins })
            }
        }
        for (const e of s.stores) {
            const slot = flow.storeSlots.get(writerId(spec.inst, e))
            const bind = slot === undefined ? undefined : flow.partBind.get(slot)
            if (bind) arrive(bind.callee, globalArrival(flow.instances[bind.callee], spec, slot!))
            if (slot !== undefined) for (const callee of flow.runtimeBinds.get(slot) ?? []) arrive(callee, globalArrival(flow.instances[callee], spec, slot))
        }
        for (const part of coneParts.get(spec.inst.id) ?? []) {
            const callee = flow.instances[flow.partBind.get(part)!.callee]
            arrive(callee.id, globalArrival(callee, spec, part))
        }
    }
    const frameOfSpec = new Map<Spec, number>()
    const order = callOrder()
    for (const [members, recursive] of order) if (recursive) for (const id of members) flow.spec.recursive.add(id)
    const forced = (inst: Instance) => flow.rooted.has(inst.id) || flow.heldStatics.has(inst.id) || inst.callers.length > (bindsInto.get(inst.id) ?? 0)
    for (const [members, recursive] of order) {
        const specs: Spec[] = []
        if (!members.some(id => arrivals.has(id) || forced(flow.instances[id]))) continue
        for (const id of members) {
            const inst = flow.instances[id]
            const list = arrivals.get(id) ?? []
            arrivals.delete(id)
            if (forced(inst)) list.push(globalArrival(inst, undefined, -1))
            if (!list.length && !recursive) continue
            const groups = new Map<string, Arrival[]>()
            if (recursive) groups.set('*', list)
            else {
                for (const a of list) {
                    const k = arrivalClass(inst, a)
                    const known = groups.get(k)
                    if (known) known.push(a)
                    else groups.set(k, [a])
                }
            }
            for (const [key, group] of groups) {
                const spec = recursive ? globalSpec(inst) : joinArrivals(inst, group)
                for (const a of group) if (a.from) edges.push([a.from, a.part, spec])
                if (frameOfSpec.has(spec)) continue
                frameOfSpec.set(spec, flow.frames.length)
                flow.frames.push({ inst, members: [spec], key, sites: [] })
                specs.push(spec)
            }
            if (recursive) built.set(id, globalSpec(inst))
        }
        for (const spec of specs) leave(spec)
    }
    const recorded = new Set<string>()
    for (const [from, part, to] of edges) {
        const frame = frameOfSpec.get(to)!
        const caller = frameOfSpec.get(from)!
        const owner = callerInstance(part)
        const node = exprAt(part).node
        const operand = coerces(exprAt(part)) && flow.partBind.get(part)?.kind === BindKind.rt && flow.slotIndex[part] !== compareKey ? flow.slotIndex[part] : undefined
        const k = `${frame}:${caller}:${node}:${operand}`
        if (recorded.has(k)) continue
        recorded.add(k)
        flow.frames[frame].sites.push({ unit: owner.summary.fn, node, frame: caller, operand })
    }
}

function unitKeyOf(fn: Function): number {
    let k = flow.unitKeys.get(fn)
    if (k === undefined) flow.unitKeys.set(fn, k = flow.unitKeys.size)
    return k
}

let constructorKey = 0

function constructorName(proto: Handle): string {
    if (!proto) return 'Object'
    if (!constructorKey) constructorKey = heap.fromJsString('constructor') as number
    const ctor = heap.getOwnProperty(proto, constructorKey as Handle)
    if (!ctor) return 'Object'
    const fn = flow.host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32)
    return fn?.name || 'Object'
}

function keyLabel(key: number): string {
    if (key === elemKey || key === dynKey) return numberKey
    if (isPosKey(key)) return `@${posBase - key}`
    const index = heap.keyIndex(key as Handle)
    if (index !== undefined) return `[${index}]`
    if (heap.isString(key as Handle)) {
        const name = heap.stringToJs(key as Handle)
        return name.startsWith('!') ? `!${name}` : name
    }
    return `!${heap.describeKey(key as Handle) ?? ''}#${key}`
}

export function flowAccesses(roots: Function[], host: AccessHost, fallbacks = false): Accesses {
    return newFlow(roots, host, () => {
        analyzeFlow(roots, fallbacks)
        return exportAccesses()
    })
}

function freshFlow(roots: Function[], host: AccessHost): FlowState {
    return {
        host, roots, strOrigin: -1, dynamicOrigins: new Set(),
        spec: { globals: new Map(), memo: new Map(), grown: new Map(), recursive: new Set(), active: new Set(), classes: [] },
        frames: [],
        unitKeys: new Map(),
        work: 0, traceMs: 0, budget: 0, totalNodes: 0,
        summaries: new Map(), summaryList: [], instances: [], instanceOf: new Map(),
        originKind: [OriginKind.none], originCell: [0], originQual: [0], originFn: [null], originProto: [undefined], originOwner: [undefined], originNode: [0], originIndex: new Map(), originFields: [new Map()], fieldWatch: [undefined], originPending: [undefined], pickWatch: new Map(),
        freshOwner: new Map(),
        slotKind: [], slotOwner: [], slotIndex: [], slotOrigins: [], slotOriginSet: [], slotSent: [], slotListeners: [], slotIns: [], slotConst: [], slotOpaque: [],
        queue: [], storeSlots: new Map(), constSlots: new Map(), missing: [], gateWaits: new Map(),
        scalar: [], scalarUsers: [], scalarQueue: [], scalarQueued: [], scalarChanges: [], originMask: [], stringSite: [],
        fieldForms: new Map(), fieldReaders: new Map(), fieldWriters: new Map(), fieldStored: new Set(), originSeen: [0], originCopied: new Set(), heldInits: new Map(), heldStatics: new Set(), rtPending: [], parts: new Map(), partBind: new Map(), rooted: new Set(), originCreators: new Map(), originSeeds: new Map(), seedList: [], setterKeys: new Set(), runtimeBinds: new Map(), heldWrites: new Map(), skippedKeys: new Set(),
        exported: { types: new Map(), allocations: [], allocOf: new Map(), fnObjects: new Map(), locations: [], locOf: new Map(), frameOf: new Map(), framesOf: new Map(), frames: [], slotTypes: new Map() },
    }
}

function withFlow<R>(next: FlowState, run: () => R): R {
    const outer = flow
    flow = next
    const out = run()
    flow = outer
    return out
}

function newFlow<R>(roots: Function[], host: AccessHost, run: () => R): R {
    return withFlow(freshFlow(roots, host), run)
}

function numberReceiver(slot: number): boolean {
    if (flow.slotOrigins[slot].length || flow.slotOpaque[slot]) return false
    const f = scalars.flags[flow.scalar[slot]]
    return f !== 0 && (f & ~(ScalarFlag.int | ScalarFlag.float)) === 0
}

function numberMethod(proto: Handle, key: number): number {
    const cell = pg.dataMethod(proto, key)
    if (cell < 0) return 0
    return methodOrigin(cell)
}

function methodRead(s: Summary, call: Expr): Expr | undefined {
    if (call.op !== ExprOp.call || call.a < 0) return
    const target = s.exprs[call.a]
    if (target.op !== ExprOp.member || target.key === dynKey) return
    return target
}

function pulledFrom(s: Summary, target: Expr, proto: Handle): boolean {
    const object = s.exprs[target.a]
    return object.op === ExprOp.origin && flow.originCell[object.a] === proto
}

function pullNumberMethods(): boolean {
    const proto = pg.numberPrototype(flow.host)
    const view: pg.MethodView = {
        calls: visit => {
            for (const inst of flow.instances) {
                const s = inst.summary
                for (const e of s.owned) {
                    const call = s.exprs[e]
                    const target = methodRead(s, call)
                    if (!target || target.a !== call.b) continue
                    visit(s.id, call.a, at(inst, call.b), target.key)
                }
            }
        },
        numberOnly: numberReceiver,
        method: key => numberMethod(proto, key) !== 0,
    }
    for (const [unit, member] of pg.numberMembers(view)) pullMember(flow.summaryList[unit - 1], member, proto)
    let bound = false
    for (const inst of flow.instances) {
        const s = inst.summary
        for (const e of s.owned) {
            const call = s.exprs[e]
            const target = methodRead(s, call)
            if (!target || !pulledFrom(s, target, proto)) continue
            const recv = at(inst, call.b)
            if (flow.slotOrigins[recv].length) throw `value-flow: ${s.name} %${target.node} reads a number method for a receiver that is not a number`
            if (!numberReceiver(recv)) continue
            const method = numberMethod(proto, target.key)
            const slot = at(inst, e)
            if (!method || flow.parts.get(slot)?.has(method * 4194304)) continue
            bindCall(slot, method, 0)
            bound = true
        }
    }
    return bound
}

function settle(): void {
    drain()
    while (bindPendingRt() || fillMissing()) drain()
}

function solve(): number {
    settle()
    while (pullNumberMethods()) settle()
    const discovery = performance.now()
    checkSkippedKeys()
    if (bindDynamic()) settle()
    return discovery
}

function analyzeFlow(roots: Function[], fallbacks: boolean): void {
    const start = performance.now()
    const detail = new Set<string>()
    let dumpAll = false
    for (const a of argv) {
        if (a === 'flow-dump') dumpAll = true
        else if (a.startsWith('flow-dump:')) detail.add(a.slice('flow-dump:'.length))
    }
    for (const fn of roots) seedRoot(fn, 0)
    if (fallbacks) for (const op of fallbackOps) seedRoot(bindingOf(op)!.impl!, 0)
    const discovery = solve()
    const end = performance.now()
    const out: string[] = []
    if (dumpAll || detail.size) dumpFlow(detail, dumpAll, out)
    if (argv.includes('flow-cost') || dumpAll || detail.size > 0) out.push(`flow cost: work=${flow.work} nodes=${flow.totalNodes} ratio=${(flow.work / Math.max(1, flow.totalNodes)).toFixed(2)} fns=${flow.summaryList.length} instances=${flow.instances.length} slots=${flow.slotKind.length} origins=${flow.originKind.length} ms=${(end - start - flow.traceMs).toFixed(1)} trace=${flow.traceMs.toFixed(1)} (discovery ${(discovery - start).toFixed(1)}, resolve ${(end - discovery).toFixed(1)})`)
    if (out.length) console.log(out.join('\n'))
}

function bindDynamic(): boolean {
    const view = dynamicView()
    flow.dynamicOrigins = pg.markDynamic(view)
    return view.bound
}

function scalarKinds(t: number): number {
    const f = scalars.flags[t]
    let out = 0
    if (f & (ScalarFlag.undef | ScalarFlag.void)) out |= pg.ValueKind.undef
    if (f & (ScalarFlag.int | ScalarFlag.no | ScalarFlag.yes)) out |= pg.ValueKind.int
    if (f & ScalarFlag.float) out |= pg.ValueKind.float
    if (f & (ScalarFlag.str | ScalarFlag.anyStr)) out |= pg.ValueKind.text
    if (f & ScalarFlag.unknown) out |= pg.ValueKind.other
    return out
}

function dynamicView(): pg.DynamicView & { bound: boolean } {
    const view = {
        bound: false,
        accesses: (visit: (site: number, store: boolean, keyed: boolean, object: number, key: number, value: number) => void) => {
            for (const inst of flow.instances) {
                if (inst.site) continue
                const s = inst.summary
                for (const e of s.owned) {
                    const x = s.exprs[e]
                    if (x.op !== ExprOp.member) continue
                    visit(at(inst, e), false, x.key === dynKey, at(inst, x.a), x.key === dynKey ? at(inst, x.b) : -1, at(inst, e))
                }
                for (const e of s.stores) {
                    const x = s.exprs[e]
                    if (x.op !== ExprOp.store) continue
                    const removal = isDelete(s.g, getNode(s.g, x.node)!)
                    visit(storeSlot(inst, e), true, x.key === dynKey, at(inst, x.a), x.key === dynKey ? at(inst, x.args[0]) : -1, removal ? -1 : at(inst, x.b))
                }
            }
        },
        origins: (slot: number) => slot < 0 ? [] : flow.slotOrigins[slot],
        kinds: (slot: number) => slot < 0 ? 0 : scalarKinds(flow.scalar[slot]),
        candidate: (origin: number) => flow.originKind[origin] === OriginKind.fresh && !isScope(origin) && !originHostFn(origin) && !protoOf(origin),
        text: (origin: number) => flow.originKind[origin] === OriginKind.str,
        allocSlots: (origin: number) => {
            const owner = flow.originOwner[origin]!
            const node = owner.allocNodes.get(flow.originCell[origin])
            const e = node === undefined ? undefined : owner.exprOf.get(node)
            const out: number[] = []
            if (e === undefined) return out
            for (const id of flow.originCreators.get(origin) ?? []) {
                const inst = flow.instances[id]
                if (inst.summary === owner) out.push(at(inst, e))
            }
            return out
        },
        bind: (slot: number, fn: Function, params: intrinsics.Types[]) => {
            const callee = instance(fn, 0, -1, -1)
            flow.rooted.add(callee)
            for (let i = 0; i < params.length; i++) addConst(flow.instances[callee].sigs[i], typeRange(params[i]))
            view.bound = true
            let list = flow.runtimeBinds.get(slot)
            if (!list) flow.runtimeBinds.set(slot, list = [])
            if (!list.includes(callee)) list.push(callee)
        },
    }
    return view
}

interface Export {
    types: Map<string, Type>
    allocations: Allocation[]
    allocOf: Map<number, number>
    fnObjects: Map<Function, number>
    locations: Location[]
    locOf: Map<number, number>
    frameOf: Map<number, number>
    framesOf: Map<number, number[]>
    frames: FrameSignature[]
    slotTypes: Map<number, Type>
}

function staticClosure(origin: number): boolean {
    if (flow.originKind[origin] !== OriginKind.fresh) return false
    const cell = flow.originCell[origin] as Handle
    return !heap.isIndirect(cell) || !flow.host.session.templateOf(cell as u32) || flow.host.session.sealed.has(cell)
}

function addSorted(list: number[], v: number): void {
    if (list.includes(v)) return
    let i = list.length
    while (i > 0 && list[i - 1] > v) i--
    list.splice(i, 0, v)
}

function addFunction(type: Type, fn: Function): void {
    if (type.functions.includes(fn)) return
    const k = unitKeyOf(fn)
    let i = type.functions.length
    while (i > 0 && unitKeyOf(type.functions[i - 1]) > k) i--
    type.functions.splice(i, 0, fn)
}

function hullInto(type: Type, lo: number, hi: number): void {
    type.range = type.range ? [Math.min(type.range[0], lo), Math.max(type.range[1], hi)] : [lo, hi]
}

function internType(type: Type): Type {
    const key = `${type.undefined ? 1 : 0}${type.unknown ? 1 : 0}${type.float ? 1 : 0}${type.bools}|${type.literals.join(',')}|${type.range ? type.range.join(':') : ''}|${type.strings.join(',')}|${type.objects.join(',')}|${type.functions.map(unitKeyOf).join(',')}|${type.closures.join(',')}`
    const known = flow.exported.types.get(key)
    if (known) return known
    flow.exported.types.set(key, type)
    return type
}

function scalarInto(type: Type, t: number): void {
    const f = scalars.flags[t]
    if (f & ScalarFlag.undef) type.undefined = true
    if (f & ScalarFlag.unknown) type.unknown = true
    if (f & ScalarFlag.anyStr) addSorted(type.strings, 0)
    for (const h of scalars.strs[t]) addSorted(type.strings, h)
    if (f & ScalarFlag.int) {
        const lo = scalars.lo[t]
        const hi = scalars.hi[t]
        if (scalars.nums[t].length) for (const v of scalars.nums[t]) addSorted(type.literals, v)
        else if (lo === hi) addSorted(type.literals, lo)
        else hullInto(type, lo, hi)
    }
    if (f & ScalarFlag.float) type.float = true
    if (f & ScalarFlag.no) type.bools = type.bools | 1
    if (f & ScalarFlag.yes) type.bools = type.bools | 2
}

function originInto(type: Type, origin: number, t: number): void {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.site) return
    if (kind === OriginKind.str) {
        if (!(scalars.flags[t] & (ScalarFlag.str | ScalarFlag.anyStr))) addSorted(type.strings, 0)
        return
    }
    if (kind === OriginKind.fn) return addFunction(type, flow.originFn[origin]!)
    const fn = originHostFn(origin)
    if (fn && (kind === OriginKind.static || staticClosure(origin))) {
        addFunction(type, fn)
        addSorted(type.closures, functionObject(fn, origin))
        return
    }
    const allocation = allocationOf(origin)
    if (!fn) return addSorted(type.objects, allocation)
    addFunction(type, fn)
    addSorted(type.closures, allocation)
}

function typeFrom(t: number, origins: number[]): Type {
    const type = emptyType()
    scalarInto(type, t)
    for (const origin of origins) originInto(type, origin, t)
    return internType(type)
}

function slotType(slot: number): Type {
    const known = flow.exported.slotTypes.get(slot)
    if (known) return known
    const type = typeFrom(flow.scalar[slot], flow.slotOrigins[slot])
    flow.exported.slotTypes.set(slot, type)
    return type
}

function specType(spec: Spec, slot: number): Type {
    if (spec.global) return slotType(slot)
    return typeFrom(specScalar(spec, slot), specOrigins(spec, slot))
}

function joinType(into: Type | undefined, b: Type): Type {
    if (!into || into === b) return b
    const type = emptyType()
    type.undefined = into.undefined || b.undefined
    type.unknown = into.unknown || b.unknown
    type.bools = into.bools | b.bools
    type.float = into.float || b.float
    for (const t of [into, b]) {
        for (const v of t.literals) addSorted(type.literals, v)
        if (t.range) hullInto(type, t.range[0], t.range[1])
        for (const v of t.strings) addSorted(type.strings, v)
        for (const v of t.objects) addSorted(type.objects, v)
        for (const fn of t.functions) addFunction(type, fn)
        for (const v of t.closures) addSorted(type.closures, v)
    }
    return internType(type)
}

function joinTypes(list: Type[]): Type | undefined {
    const distinct = [...new Set(list)]
    if (distinct.length < 3) {
        let out: Type | undefined
        for (const t of distinct) out = joinType(out, t)
        return out
    }
    const type = emptyType()
    const literals = new Set<number>()
    const strings = new Set<number>()
    const objects = new Set<number>()
    const closures = new Set<number>()
    const functions = new Set<Function>()
    for (const t of distinct) {
        type.undefined ||= t.undefined
        type.unknown ||= t.unknown
        type.float ||= t.float
        type.bools = type.bools | t.bools
        for (const v of t.literals) literals.add(v)
        if (t.range) hullInto(type, t.range[0], t.range[1])
        for (const v of t.strings) strings.add(v)
        for (const v of t.objects) objects.add(v)
        for (const fn of t.functions) functions.add(fn)
        for (const v of t.closures) closures.add(v)
    }
    const order = (a: number, b: number) => a < b ? -1 : a > b ? 1 : 0
    type.literals = [...literals].sort(order)
    type.strings = [...strings].sort(order)
    type.objects = [...objects].sort(order)
    type.closures = [...closures].sort(order)
    type.functions = [...functions].sort((a, b) => unitKeyOf(a) - unitKeyOf(b))
    return internType(type)
}

function frameOfInstance(id: number): number | undefined {
    const inst = flow.instances[id]
    return flow.exported.frameOf.get(inst.site ? inst.site.id : id)
}

function siteOfOrigin(origin: number): Site {
    const owner = flow.originOwner[origin]
    const kind = flow.originKind[origin]
    if ((kind === OriginKind.slice || kind === OriginKind.created) && owner) return { unit: owner.fn, node: flow.originNode[origin] }
    if (kind === OriginKind.fresh) return { unit: owner!.fn, node: owner!.allocNodes.get(flow.originCell[origin]) ?? 0 }
    const seen = flow.originSeen[origin]
    if (seen) return { unit: flow.summaryList[Math.floor(seen / 16777216) - 1].fn, node: seen % 16777216 }
    return { unit: flow.roots[0], node: 0 }
}

function liveFrames(origin: number): [number[], number] {
    const creators = flow.originCreators.get(origin) ?? []
    const frames: number[] = []
    const seen: number[] = []
    for (const c of creators) {
        const inst = flow.instances[c]
        for (const f of flow.exported.framesOf.get(inst.site ? inst.site.id : c) ?? []) {
            if (seen.includes(f)) continue
            seen.push(f)
            if (allocLive(flow.frames[f], origin)) frames.push(f)
        }
    }
    return [frames, seen.length]
}

function allocationOf(origin: number): number {
    const known = flow.exported.allocOf.get(origin)
    if (known !== undefined) return known
    const id = flow.exported.allocations.length
    flow.exported.allocOf.set(origin, id)
    const kind = flow.originKind[origin]
    const cell = flow.originCell[origin]
    const site = siteOfOrigin(origin)
    const creator = flow.originCreators.get(origin)?.[0] ?? -1
    const frame = creator >= 0 ? frameOfInstance(creator) : undefined
    let allocation: Allocation
    if (kind === OriginKind.static) {
        const state = heap.deref(cell as Handle)
        const proto = heap.getPrototypeOf(state)
        const native = !!heap.getOwnProperty(state, heap.closureCallKey) || heap.isFrameProxy(state)
        allocation = { site, kind: heap.isArray(state) ? AllocKind.array : AllocKind.object, state, handle: cell as Handle, proto, constant: true, native }
    } else if (kind === OriginKind.slice) {
        allocation = { site, frame, kind: AllocKind.buffer, proto: undefined, constant: !flow.originOwner[origin] }
    } else if (kind === OriginKind.created) {
        const proto = cell ? heap.deref(cell as Handle) : undefined
        allocation = { site, frame, kind: AllocKind.object, proto, constant: false }
    } else if (isScope(origin)) {
        allocation = { site, frame, kind: AllocKind.scope, handle: cell as Handle, proto: undefined, constant: false, native: true }
    } else if (originHostFn(origin)) {
        const state = heap.isIndirect(cell as Handle) ? heap.indirectTarget(cell as Handle) : heap.deref(cell as Handle)
        const proto = heap.getPrototypeOf(state)
        allocation = { site, frame, kind: AllocKind.object, state, proto, constant: false, native: true }
    } else {
        const state = heap.deref(cell as Handle)
        const proto = heap.getPrototypeOf(state)
        allocation = { site, frame, kind: heap.isArray(state) ? AllocKind.array : AllocKind.object, state, proto, constant: false }
    }
    if (flow.originCopied.has(origin)) allocation.copied = true
    if (flow.dynamicOrigins.has(origin)) allocation.dynamic = true
    const [frames, all] = liveFrames(origin)
    if (kind !== OriginKind.static && frames.length && (frame === undefined || !frames.includes(frame))) allocation.frame = frames[0]
    if (frames.length > 1 || frames.length < all) allocation.frames = frames
    flow.exported.allocations.push(allocation)
    return id
}

function functionObject(fn: Function, origin: number): number {
    const known = flow.exported.fnObjects.get(fn)
    if (known !== undefined) return known
    const state = heap.makeObject(0 as Handle)
    heap.setReadonlyProperty(state, heap.closureCallKey, flow.originCell[origin] as Handle)
    const id = flow.exported.allocations.length
    flow.exported.fnObjects.set(fn, id)
    flow.exported.allocations.push({ site: siteOfOrigin(origin), kind: AllocKind.object, state, handle: heap.makeIndirect(state), proto: heap.getPrototypeOf(state), constant: true, native: true, function: fn })
    const code = emptyType()
    addFunction(code, fn)
    flow.exported.locations.push({ allocation: id, key: keyLabel(heap.closureCallKey), handle: heap.closureCallKey, type: internType(code), forms: ['init'], readers: [], writers: [], stored: false })
    return id
}

function allocLive(frame: FrameInfo, origin: number): boolean {
    const s = frame.inst.summary
    const node = flow.originKind[origin] === OriginKind.fresh && flow.originOwner[origin] === s ? s.allocNodes.get(flow.originCell[origin]) : undefined
    if (node === undefined || !s.regions) return true
    const r = s.regions.of.get(node)
    const gate = r === undefined ? undefined : s.gateOf.get(r)
    if (gate === undefined || gate < 0 || s.local![gate] === undefined) return true
    for (const m of frame.members) if (specScalar(m, at(m.inst, gate)) !== NONE) return true
    return false
}

function slotSite(slot: number): Site {
    const inst = flow.instances[flow.slotOwner[slot]]
    const owner = inst.site ?? inst
    return { unit: owner.summary.fn, node: owner.summary.exprs[flow.slotIndex[slot]].node }
}

const noSite: Site = { unit: () => 0, node: -1 }

function writerSite(w: number): Site {
    if (w < 0) return noSite
    const inst = flow.instances[Math.floor(w / exprBits)]
    return { unit: inst.summary.fn, node: inst.summary.exprs[w % exprBits].node }
}

function exportLocations(): void {
    for (let origin = 1; origin < flow.originKind.length; origin++) {
        const fields = flow.originFields[origin]
        if (!fields.size) continue
        const kind = flow.originKind[origin]
        if (kind === OriginKind.fn || kind === OriginKind.site || kind === OriginKind.str) continue
        if (kind === OriginKind.fresh && originHostFn(origin) && staticClosure(origin)) continue
        const allocation = allocationOf(origin)
        for (const [key, slot] of fields) {
            const readers: Site[] = []
            for (const r of flow.fieldReaders.get(slot) ?? []) readers.push(slotSite(r))
            const writers: Site[] = []
            for (const w of flow.fieldWriters.get(slot) ?? []) writers.push(writerSite(w))
            const id = flow.exported.locations.length
            flow.exported.locOf.set(slot, id)
            flow.exported.locations.push({ allocation, key: keyLabel(key), handle: key >= 0 && heap.keyIndex(key as Handle) === undefined ? key as Handle : undefined, type: slotType(slot), forms: (flow.fieldForms.get(slot) ?? []).slice(), readers, writers, stored: flow.fieldStored.has(slot) })
        }
    }
}

function wordAccessSlots(inst: Instance, x: Expr): number[] {
    const out: number[] = []
    const key = slotKey(inst, x.args[1])
    for (const origin of flow.slotOrigins[at(inst, x.args[0])]) {
        const fields = flow.originFields[origin]
        const exact = fields.get(key)
        if (exact !== undefined && flow.exported.locOf.has(exact)) out.push(flow.exported.locOf.get(exact)!)
        if (key !== elemKey) continue
        for (const [k, f] of fields) if (isPosKey(k) && flow.exported.locOf.has(f)) out.push(flow.exported.locOf.get(f)!)
    }
    return out
}

function wordLoadExpr(s: Summary, e: number): Expr | undefined {
    const x = s.exprs[e]
    if (x.op !== ExprOp.rt || x.a !== RtOp.sliceRead) return
    const n = getNode(s.g, x.node)
    return n && elementType(s.g, n) === Types.vm_value ? x : undefined
}

function derefParams(s: Summary): Set<number> {
    const marked = new Uint8Array(s.exprs.length)
    const work: number[] = []
    const mark = (e: number) => {
        if (e < 0 || e >= s.exprs.length || marked[e]) return
        marked[e] = 1
        work.push(e)
    }
    for (const x of s.exprs) {
        if (x.op === ExprOp.member || x.op === ExprOp.store) mark(x.a)
        else if (x.op === ExprOp.call) {
            mark(x.a)
            mark(x.b)
        } else if (x.op === ExprOp.opaque || (x.op === ExprOp.rt && x.a !== RtOp.typeof)) {
            for (const a of x.args) mark(a)
        }
    }
    while (work.length) {
        const x = s.exprs[work.pop()!]
        if (x.op === ExprOp.union) for (const a of x.args) mark(a)
        else if (x.op === ExprOp.narrow || x.op === ExprOp.pick) mark(x.a)
    }
    const out = new Set<number>()
    for (let e = 0; e < s.exprs.length; e++) if (marked[e] && s.exprs[e].op === ExprOp.param) out.add(s.exprs[e].a)
    return out
}

function exportFrame(frame: FrameInfo): FrameSignature {
    const inst = frame.inst
    const s = inst.summary
    const g = s.g
    const params: { label: string, type: Type, opaque: boolean }[] = []
    const paramIds = (slot: number) => {
        let out: Type | undefined
        for (const m of frame.members) out = joinType(out, specType(m, slot))
        return out ?? internType(emptyType())
    }
    let plain = 0
    const derefs = derefParams(s)
    for (const p of g.blocks[0].params) {
        if (isThisParam(getNode(g, p)!)) params.push({ label: 'this', type: paramIds(paramSlot(inst, -1)), opaque: !derefs.has(-1) })
        else {
            params.push({ label: `p${plain}`, type: paramIds(inst.sigs[plain]), opaque: !derefs.has(plain) })
            plain++
        }
    }
    const accesses: WordAccess[] = []
    for (const e of s.stores) {
        const x = s.exprs[e]
        if (x.op !== ExprOp.rt || x.a !== RtOp.sliceWrite || getNode(g, x.node)!.op !== NodeOp.rt) continue
        if (elementType(g, getNode(g, x.node)!) !== Types.vm_value) continue
        accesses.push({ node: x.node, store: true, slots: wordAccessSlots(inst, x) })
    }
    for (const r of s.rets) {
        const x = wordLoadExpr(s, r)
        if (!x) continue
        accesses.push({ node: x.node, store: false, slots: wordAccessSlots(inst, x) })
    }
    const merges: number[][] = []
    for (const e of s.owned) {
        const x = s.exprs[e]
        if (x.op !== ExprOp.union || !x.node) continue
        const op = getNode(g, x.node)?.op
        if (op !== NodeOp.select && op !== NodeOp.param) continue
        const type = paramIds(at(inst, e))
        if (type.objects.length > 1) merges.push(type.objects)
    }
    return {
        unit: s.fn, heldStatic: flow.heldStatics.has(inst.id), sites: frame.sites, accesses, params, returns: paramIds(inst.ret), merges,
    }
}

function resolveUnit(frames: number[]): UnitTypes {
    const members = frames.flatMap(f => flow.frames[f].members)
    const s = members[0].inst.summary
    const g = s.g
    const nodes = new Map<number, Type>()
    const slices = new Map<number, number[]>()
    for (const [node, e] of s.exprOf) {
        const out = joinTypes(members.map(m => specType(m, at(m.inst, e))))
        if (out && inhabited(out)) nodes.set(node, out)
    }
    for (let e = 0; e < s.exprs.length; e++) {
        const x = s.exprs[e]
        if (x.op !== ExprOp.rt || (x.a !== RtOp.slice && x.a !== RtOp.sliceRead && x.a !== RtOp.sliceWrite)) continue
        if (getNode(g, x.node)?.op !== NodeOp.rt) continue
        const touched: number[] = []
        for (const m of members) {
            const slot = x.a === RtOp.slice ? at(m.inst, e) : at(m.inst, x.args[0])
            for (const origin of specOrigins(m, slot)) {
                if (flow.originKind[origin] !== OriginKind.slice) continue
                const allocation = allocationOf(origin)
                if (!touched.includes(allocation)) touched.push(allocation)
            }
        }
        if (touched.length) slices.set(x.node, touched)
    }
    const live = (gate: number) => {
        if (gate < 0) return true
        for (const m of members) if (specScalar(m, at(m.inst, gate)) !== NONE) return true
        return false
    }
    const memos = members.map(() => new Map<number, boolean>())
    const impossible = (e: number) => members.every((m, i) => impossibleExpr(m, e, memos[i]))
    const exits = new Map<number, boolean>()
    const deadExit = (id: number): boolean => {
        const known = exits.get(id)
        if (known !== undefined) return known
        exits.set(id, false)
        const n = getNode(g, id)
        let dead = false
        if (n?.op === NodeOp.apply) {
            for (let i = 1; i < countIds(n) && !dead; i++) {
                const e = getRef(n, i) ? s.exprOf.get(getRef(n, i)) : undefined
                if (e !== undefined && impossible(e)) dead = true
            }
            const block = g.blockIndex.get(getRef(n, 0))
            if (!dead && block) dead = deadExit(block.bodyId)
        } else if (n?.op === NodeOp.ret) {
            const e = getRef(n, 0) ? s.exprOf.get(getRef(n, 0)) : undefined
            dead = e !== undefined && impossible(e)
        } else if (n?.op === NodeOp.select) {
            dead = deadExit(getRef(n, 1)) && deadExit(getRef(n, 2))
        } else if (n?.op === NodeOp.after) {
            for (let i = 0; i < countIds(n) && !dead; i++) {
                const e = getRef(n, i) ? s.exprOf.get(getRef(n, i)) : undefined
                if (e !== undefined && impossible(e)) dead = true
            }
            if (!dead && getRef(n, countIds(n) - 1)) dead = deadExit(getRef(n, countIds(n) - 1))
        }
        exits.set(id, dead)
        return dead
    }
    const possible = (x: Expr, i: number) => {
        const e = x.args[i]
        const op = s.exprs[e].op
        if (op !== ExprOp.konst) return !impossible(e)
        const arm = getRef(getNode(g, x.node)!, i + 1)
        return !arm || !deadExit(arm)
    }
    const blocks = new Set<number>()
    for (let b = 0; b < g.blocks.length; b++) {
        if (b === 0 || s.blockGates[b].some(live)) blocks.add(g.blocks[b].id)
    }
    const selects = new Map<number, boolean[]>()
    for (const x of s.exprs) {
        if (x.op !== ExprOp.union || !x.node || !x.gates || getNode(g, x.node)?.op !== NodeOp.select) continue
        const arms = x.gates.map((gate, i) => live(gate) && possible(x, i))
        if (arms.some(a => !a)) selects.set(x.node, arms)
    }
    return { nodes, slices, blocks, selects }
}

function exportAccesses(): Accesses {
    const exported = flow.exported
    buildFrames()
    flow.frames.forEach((frame, id) => {
        if (!exported.frameOf.has(frame.inst.id)) exported.frameOf.set(frame.inst.id, id)
        let list = exported.framesOf.get(frame.inst.id)
        if (!list) exported.framesOf.set(frame.inst.id, list = [])
        list.push(id)
    })
    for (let origin = 1; origin < flow.originKind.length; origin++) {
        const kind = flow.originKind[origin]
        const fn = originHostFn(origin)
        if (fn && (kind === OriginKind.static || staticClosure(origin))) {
            functionObject(fn, origin)
            continue
        }
        if (kind === OriginKind.fresh || kind === OriginKind.slice || kind === OriginKind.created || (kind === OriginKind.static && !fn)) allocationOf(origin)
    }
    exportLocations()
    for (const frame of flow.frames) exported.frames.push(exportFrame(frame))
    const solved = flow
    return {
        allocations: exported.allocations, locations: exported.locations, frames: exported.frames,
        resolve: (list: number[]) => withFlow(solved, () => resolveUnit(list)),
    }
}

function numericUse(g: Graph, user: GraphNode, slot: number): boolean {
    if (user.op === NodeOp.load || user.op === NodeOp.store) return slot === 1 || slot === 2
    const slice = sliceOf(g, user)
    if (slice !== undefined) return slot === 2 || (slot === 3 && slice !== RtOp.slice)
    if (user.op === NodeOp.lt || user.op === NodeOp.le || user.op === NodeOp.gt || user.op === NodeOp.ge) return true
    if (user.op === NodeOp.eq || user.op === NodeOp.ne) return false
    if (user.op === NodeOp.add && typeOf(user) === Types.unknown_number) return false
    return NumericOps.has(user.op) || user.op === NodeOp.convert
}

function genericFlow(methods: Function[], proto: intrinsics.Handle, host: AccessHost): GenericFlow {
    return newFlow(methods, host, () => {
        const self = originOf(OriginKind.created, proto as number, 0, 0, undefined)
        const params = methods.map(fn => seedRoot(fn, self))
        solve()
        return genericView(self, params, methods)
    })
}

export function analyzeGenerics(name: string, proto: Handle, ctor: Function, host: AccessHost): Generic {
    const start = performance.now()
    const methods: [string, Function][] = [['constructor', ctor]]
    function add(label: string, handle: u32): void {
        const fn = handle ? host.functionOf(handle) : undefined
        if (fn && fn !== ctor && host.traceable(fn) && !methods.some(([, m]) => m === fn)) methods.push([label, fn])
    }
    for (let k: u32 = 0; k < heap.ownPropertyCount(proto); k++) {
        const key = heap.ownPropertyKeyAt(proto, k)
        const addr = heap.getOwnProperty(proto, key)
        if (!addr) continue
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        if (d.flags & heap.PropFlags.has_getter) add(`get ${propertyLabel(key)}`, d.slot0)
        if (d.flags & heap.PropFlags.has_setter) add(`set ${propertyLabel(key)}`, d.slot1)
        if (!(d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter))) add(propertyLabel(key), d.slot0)
    }
    const trap = heap.getPropertyProxy(proto, heap.indexKey(0 as u32))
    if (trap) {
        add('get [index]', heap.getProxyGetter(trap) as u32)
        add('set [index]', heap.getProxySetter(trap) as u32)
    }
    const solved = genericFlow(methods.map(([, fn]) => fn), proto, host)
    const shape = pg.genericShape(solved, numberKey, constantIndex)
    const ms = performance.now() - start
    const lines = [`GENERIC ${name}${shape.params.length ? `<${shape.params.map(p => p.name).join(', ')}>` : ''} ${ms.toFixed(1)}ms units=${solved.units.length}`]
    lines.push(...shape.lines)
    return { name, ms, params: shape.params, paths: shape.paths, lines }
}

function scalarKind(t: number): number {
    const f = scalars.flags[t]
    const numbers = ScalarFlag.int | ScalarFlag.float | ScalarFlag.no | ScalarFlag.yes
    return (f & numbers ? pg.GenericKind.number : 0) | (f & ~numbers ? pg.GenericKind.other : 0)
}

function converts(T0: number): boolean {
    return T0 >= 0 && T0 !== Types.vm_value && T0 !== Types.unknown && T0 !== Types.void && T0 !== Types.fnptr && T0 !== Types.handle
}

function objectOrigin(origin: number): boolean {
    const kind = flow.originKind[origin]
    return (kind === OriginKind.fresh || kind === OriginKind.created || kind === OriginKind.slice || kind === OriginKind.static) && !originHostFn(origin)
}

function genericView(self: number, params: number[][], methods: Function[]): GenericFlow {
    const selecting = GuardFlag.falsy | GuardFlag.nullish | GuardFlag.isNumber | GuardFlag.isString | GuardFlag.isObject | GuardFlag.isFunction | GuardFlag.isUndefined | GuardFlag.isBoolean | GuardFlag.bounded | GuardFlag.hasProto
    const n = flow.slotKind.length
    const sources: (number[] | undefined)[] = new Array(n)
    const kinds = new Uint8Array(n)
    for (let slot = 0; slot < n; slot++) {
        const list: number[] = []
        const ins = flow.slotIns[slot]
        if (ins) for (const from of ins) list.push(from >= 0 ? from : -from - 1)
        let t = flow.slotConst[slot]
        if (flow.slotKind[slot] === SlotKind.expr) {
            const inst = flow.instances[flow.slotOwner[slot]]
            const x = inst.summary.exprs[flow.slotIndex[slot]]
            if (converts(x.type)) {
                list.length = 0
                t = unite(t, flow.scalar[slot])
            } else if (x.op === ExprOp.union) for (const a of x.args) list.push(at(inst, a))
            else if (x.op === ExprOp.pick || (x.op === ExprOp.narrow && !(x.key & selecting))) list.push(at(inst, x.a))
            else if (x.op !== ExprOp.member && x.op !== ExprOp.call && !ins) t = unite(t, flow.scalar[slot])
        }
        if (list.length) sources[slot] = list
        kinds[slot] = scalarKind(t) | (flow.slotOrigins[slot].length || flow.slotOpaque[slot] ? pg.GenericKind.other : 0)
    }
    const fields = new Map<number, [string, number][]>()
    const objects = new Map<number, number[]>()
    for (let origin = 1; origin < flow.originKind.length; origin++) {
        const list: [string, number][] = []
        for (const [key, slot] of flow.originFields[origin]) {
            list.push([keyLabel(key), slot])
            const inner = flow.slotOrigins[slot].filter(objectOrigin)
            if (inner.length) objects.set(slot, inner)
        }
        if (list.length) fields.set(origin, list)
    }
    const numeric: number[] = []
    for (const inst of flow.instances) {
        const s = inst.summary
        for (const x of s.exprs) {
            const n = x.node ? getNode(s.g, x.node) : undefined
            if (!n) continue
            if (x.op === ExprOp.arith || x.op === ExprOp.cmp) {
                if (numericUse(s.g, n, 0)) numeric.push(at(inst, x.a))
                if (numericUse(s.g, n, 1)) numeric.push(at(inst, x.b))
            }
            if (x.op !== ExprOp.rt) continue
            const first = n.op === NodeOp.store ? 1 : 2
            for (let i = 0; i < x.args.length; i++) if (numericUse(s.g, n, first + i)) numeric.push(at(inst, x.args[i]))
        }
    }
    const names: string[] = []
    methods.forEach((fn, m) => params[m].forEach((_, i) => names.push(`?${fn.name || '<anon>'}.p${i}`)))
    return { sources, kinds, params, names, numeric, self, fields, objects, units: flow.summaryList.map(s => s.fn) }
}

const exprNames = ['const', 'origin', 'alloc', 'param', 'union', 'member', 'call', 'arith', 'cmp', 'num', 'rt', 'opaque', 'store', 'narrow', 'pick', 'gate', 'typeof']

function dumpFlow(detail: Set<string>, dumpAll: boolean, out: string[]): void {
    for (const inst of flow.instances) {
        const name = inst.summary.name
        if (inst.site) continue
        if (!dumpAll && !detail.has(name)) continue
        if (argv.includes(`vgraph:${name}`)) out.push(dumpGraph(inst.summary.g))
        dumpInstance(inst, detail.has(name), out)
    }
    const multiplicity = new Map<Summary, number>()
    for (const inst of flow.instances) multiplicity.set(inst.summary, (multiplicity.get(inst.summary) ?? 0) + 1)
    const ranked = [...multiplicity].sort((a, b) => b[1] * b[0].exprs.length - a[1] * a[0].exprs.length).slice(0, 12)
    out.push(`flow instances: ${ranked.map(([s, k]) => `${s.name}x${k}(${s.width}/${s.exprs.length})`).join(' ')}`)
}

function scalarText(t: number): string {
    const f = scalars.flags[t]
    const parts: string[] = []
    if (f & ScalarFlag.unknown) parts.push('unknown')
    if (f & ScalarFlag.undef) parts.push('undefined')
    if (f & ScalarFlag.void) parts.push('void')
    if (f & ScalarFlag.int) {
        const lo = scalars.lo[t]
        const hi = scalars.hi[t]
        if (scalars.nums[t].length) parts.push(`{${scalars.nums[t].join(',')}}`)
        else if (lo === hi) parts.push(`${lo}`)
        else if (lo === 0 && hi === MaxU64) parts.push('u64')
        else if (lo === MinI64 && hi === MaxI64) parts.push('i64')
        else if (lo === 0 && hi === 2 ** 32 - 1) parts.push('u32')
        else parts.push(`${lo}..${hi}`)
    }
    if (f & ScalarFlag.float) parts.push('f64')
    if ((f & ScalarFlag.no) && (f & ScalarFlag.yes)) parts.push('boolean')
    else if (f & ScalarFlag.no) parts.push('false')
    else if (f & ScalarFlag.yes) parts.push('true')
    if (f & ScalarFlag.anyStr) parts.push('string')
    for (const s of scalars.strs[t]) parts.push(JSON.stringify(heap.stringToJs(s as Handle)))
    return parts.join('|')
}

const narrowNames = ['truthy', 'falsy', 'nullish', 'defined', 'number', 'string', 'object', 'function', 'undefined', '!number', '!string', '!object', '!function', '!undefined', '', 'nonzero']

function narrowText(x: Expr): string {
    const parts: string[] = []
    for (let i = 0; i < narrowNames.length; i++) {
        if ((x.key & (1 << i)) && narrowNames[i]) parts.push(narrowNames[i])
    }
    if (x.key & GuardFlag.bounded) parts.push(`${x.b <= MinI64 ? '' : x.b}..${x.sub >= MaxU64 ? '' : x.sub}`)
    if (x.key & GuardFlag.hasProto) parts.push(`proto ${x.b}`)
    if (x.key & GuardFlag.lacksProto) parts.push(`!proto ${x.b}`)
    return parts.join(' ')
}

function originText(origin: number): string {
    const kind = flow.originKind[origin]
    const owner = flow.originOwner[origin]
    const q = flow.originQual[origin] ? `@${originShort(flow.originQual[origin])}` : ''
    if (kind === OriginKind.fn) return `fn ${flow.originFn[origin]?.name || '<anon>'}`
    if (kind === OriginKind.str) return 'string'
    if (kind === OriginKind.site) return `site ${owner?.name}%${flow.originNode[origin]}${q}`
    if (kind === OriginKind.slice) return `slice ${owner?.name}%${flow.originNode[origin]}${q}`
    if (kind === OriginKind.created) return `created ${owner?.name}%${flow.originNode[origin]}${q}`
    const fn = originHostFn(origin)
    if (kind === OriginKind.fresh) {
        if (fn) return `closure ${fn.name || '<anon>'}#${origin}${q}`
        if (isScope(origin)) return `scope ${owner?.name}#${origin}${q}`
        return `obj ${owner?.name}#${origin}${q}${protoName(origin)}`
    }
    if (fn) return `fn ${fn.name || '<anon>'}`
    return `static #${origin}${protoName(origin)}`
}

function originShort(origin: number): string {
    const kind = flow.originKind[origin]
    if (kind === OriginKind.site) return `site%${flow.originNode[origin]}`
    if (kind === OriginKind.fn) return `fn ${flow.originFn[origin]?.name}`
    return `#${origin}`
}

function protoName(origin: number): string {
    const proto = protoOf(origin)
    return proto ? `<${constructorName(proto)}>` : ''
}

function slotText(s: number): string {
    const parts: string[] = []
    const t = flow.scalar[s]
    if (t !== NONE) parts.push(scalarText(t))
    const origins = flow.slotOrigins[s]
    for (let i = 0; i < origins.length && i < 6; i++) {
        if (flow.originKind[origins[i]] === OriginKind.str && (scalars.flags[t] & (ScalarFlag.str | ScalarFlag.anyStr))) continue
        parts.push(originText(origins[i]))
    }
    if (origins.length > 6) parts.push(`+${origins.length - 6} origins`)
    return parts.length ? parts.join(' | ') : 'never'
}

function keyText(key: number): string {
    if (key === elemKey) return '[elem]'
    if (isPosKey(key)) return `[#${posBase - key}]`
    if (key === dynKey) return '[key]'
    return heap.describeKey(key as Handle) ?? `#${key}`
}

function exprText(s: Summary, e: number, depth: number): string {
    const x = s.exprs[e]
    if (depth > 4) return `e${e}`
    switch (x.op) {
        case ExprOp.konst: return scalarText(x.a)
        case ExprOp.origin: return originText(x.a)
        case ExprOp.alloc: return `alloc%${x.node}`
        case ExprOp.param: return x.a === -1 ? 'this' : x.a === -2 ? 'ctx' : `p${x.a}`
        case ExprOp.union: return getNode(s.g, x.node)?.op === NodeOp.param ? `param%${x.node}` : `(${x.args.map(a => exprText(s, a, depth + 1)).join(' | ')})`
        case ExprOp.member: return `${exprText(s, x.a, depth + 1)}${x.key === dynKey ? `[${exprText(s, x.b, depth + 1)}]` : keyText(x.key)}`
        case ExprOp.call: return `${exprText(s, x.a, depth + 1)}(${x.args.map(a => exprText(s, a, depth + 1)).join(', ')})`
        case ExprOp.arith: return `${opText(x.key)}(${exprText(s, x.a, depth + 1)}, ${exprText(s, x.b, depth + 1)})`
        case ExprOp.cmp: return `${opText(x.key)}(${exprText(s, x.a, depth + 1)}, ${exprText(s, x.b, depth + 1)})`
        case ExprOp.num: return scalarText(x.a)
        case ExprOp.rt: return `rt.${rtName(x.a)}(${x.args.map(a => exprText(s, a, depth + 1)).join(', ')})`
        case ExprOp.store: return `${exprText(s, x.a, depth + 1)}${x.key === dynKey ? `[${exprText(s, x.args[0], depth + 1)}]` : keyText(x.key)} := ${exprText(s, x.b, depth + 1)}`
        case ExprOp.opaque: return `opaque%${x.node}`
        case ExprOp.narrow: return `narrow(${exprText(s, x.args[0], depth + 1)}, ${narrowText(x)})`
        case ExprOp.pick: return `pick(${exprText(s, x.args[0], depth + 1)}, ${x.b ? '' : '!'}${keyText(x.key)})`
    }
    return exprNames[x.op]
}

function opText(op: number): string {
    for (const k of Object.keys(NodeOp)) if ((NodeOp as any)[k] === op) return k
    return `${op}`
}

function sigText(inst: Instance): string {
    const s = inst.summary
    const parts: string[] = []
    for (let i = 0; i < s.params; i++) parts.push(`p${i}=${slotText(inst.sigs[i])}`)
    if (s.hasThis) parts.push(`this=${slotText(paramSlot(inst, -1))}`)
    if (s.usesCtx) parts.push(`ctx=${slotText(paramSlot(inst, -2))}`)
    return parts.join(' ')
}

function dumpInstance(inst: Instance, callers: boolean, out: string[]): void {
    const s = inst.summary
    const stores = new Set(s.stores)
    out.push(`INSTANCE ${s.name}#${inst.id}${inst.qual ? ` @${originText(inst.qual)}` : ''} nodes=${s.g.nodes.size} exprs=${s.exprs.length} callers=${inst.callers.length}`)
    out.push(`  signature: ${sigText(inst)}`)
    out.push(`  returns: ${s.rets.map(r => exprText(s, r, 0)).join(' | ') || 'never'} => ${slotText(inst.ret)}`)
    for (let e = 0; e < s.exprs.length; e++) {
        const x = s.exprs[e]
        if (x.op !== ExprOp.alloc && !(x.op === ExprOp.rt && (x.a === RtOp.slice || x.a === RtOp.create))) continue
        if (s.local![e] < 0) continue
        for (const a of flow.slotOrigins[at(inst, e)]) {
            const fields: string[] = []
            for (const [key, f] of flow.originFields[a]) fields.push(`${keyText(key)}: ${slotText(f)}`)
            out.push(`  alloc %${x.node} ${originText(a)} { ${fields.join(', ')} }`)
        }
    }
    for (let e = 0; e < s.exprs.length; e++) {
        const x = s.exprs[e]
        if (stores.has(e)) {
            out.push(`  effect %${x.node} ${exprText(s, e, 0)}`)
            continue
        }
        if (s.local![e] < 0) continue
        const slot = at(inst, e)
        if (x.op === ExprOp.store) continue
        else if (x.op === ExprOp.call || x.op === ExprOp.opaque || (x.op === ExprOp.rt && flow.parts.has(slot))) {
            const callees: string[] = []
            for (const part of flow.parts.get(slot)?.values() ?? []) {
                const bind = flow.partBind.get(part)
                const text = bind ? `${flow.instances[bind.callee].summary.name}#${bind.callee}` : ''
                if (bind && !callees.includes(text)) callees.push(text)
            }
            out.push(`  call %${x.node} ${exprText(s, e, 0)} -> [${callees.join(', ')}]${flow.slotOpaque[slot] ? ' opaque' : ''} => ${slotText(slot)}`)
        } else if (x.op === ExprOp.member || x.op === ExprOp.rt) out.push(`  open %${x.node} ${exprText(s, e, 0)} => ${slotText(slot)}`)
        else if (x.op === ExprOp.union && getNode(s.g, x.node)?.op === NodeOp.param) out.push(`  param %${x.node} => ${slotText(slot)}`)
    }
    if (!callers) return
    for (const c of inst.callers) {
        const from = instOfSlot(c)
        const x = exprAt(c)
        out.push(`  caller ${from.summary.name}#${from.id} %${x.node} ${exprText(from.summary, flow.slotIndex[ownerSlot(c)], 0)} args ${x.args.map(a => slotText(at(from, a))).join(', ')}`)
    }
}
