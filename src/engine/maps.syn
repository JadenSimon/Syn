    function arrayObjects(n: u32): u32 {
        const a: { v: u32 }[] = []
        for (let i: u32 = 0; i < n; i++) a.push({ v: i * 3 + 1 })
        let total: u32 = 0
        for (let i: u32 = 0; i < a.length; i++) total = total + a[i].v
        const last = a.at(n - 1)
        const missing = a.at(n)
        return total + (missing === undefined ? 1000 : 0) + (last === undefined ? 0 : 10000 + last.v * 100000)
