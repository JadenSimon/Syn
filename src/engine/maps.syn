/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import { allocate, programStackTop, releaseProgramStack } from './builtin/memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

class Hidden {
    #items: any[]
    #count: number
    constructor() {
        this.#items = []
        this.#count = 0
    }
    push(x: any): void {
        this.#items.push(x)
        this.#count = this.#count + 1
    }
    at(i: number): any {
        return i < this.#count ? this.#items[i] : undefined
    }
    count(): number {
        return this.#count
    }
}

class Even {
    static [Symbol.hasInstance](value: any): boolean {
        return value % 2 === 0
    }
}

const settingsA = { scale: 3, offset: 7 }
const settingsB = { scale: 5, offset: 11 }
const readSettings = intrinsics.tagNoInline(function readSettings(s: { scale: number, offset: number }, n: u32): u32 {
    return s.scale * n + s.offset
})
const sameObject = intrinsics.tagNoInline(function sameObject(a: any, b: any): u32 {
    return a === b ? 1 : 0
})
const shiftScale = intrinsics.tagNoInline(function shiftScale(s: { scale: number, offset: number }, by: u32): void {
    s.scale = s.scale + by
})
const readCaptured = intrinsics.tagNoInline(function readCaptured(n: u32): u32 {
    return settingsA.scale * n + settingsA.offset
})
const tableHolder = { table: [3, 5, 7] as u32[], scale: 2 as u32 }
const labelNames = ['alpha', 'beta']
const staticCounter = { n: 0 as u32 }
const bumpStatic = intrinsics.tagNoInline(function bumpStatic(): u32 {
    staticCounter.n = staticCounter.n + 1
    return staticCounter.n
})
const readStatic = intrinsics.tagNoInline(function readStatic(): u32 {
    return staticCounter.n
})
const dropStatic = intrinsics.tagNoInline(function dropStatic(by: u32): void {
    staticCounter.n = staticCounter.n - by
})
const staticNest = { inner: { n: 0 as u32 }, m: 5 as u32 }
const bumpNested = intrinsics.tagNoInline(function bumpNested(k: u32): u32 {
    staticNest.inner.n = staticNest.inner.n + k
    return staticNest.m
})
const readNested = intrinsics.tagNoInline(function readNested(): u32 {
    return staticNest.inner.n
})
const dropNested = intrinsics.tagNoInline(function dropNested(by: u32): void {
    staticNest.inner.n = staticNest.inner.n - by
})
const staticParamTarget = { n: 0 as u32 }
const bumpParam = intrinsics.tagNoInline(function bumpParam(o: { n: u32 }, k: u32): u32 {
    o.n = o.n + k
    return o.n
})
const readParamTarget = intrinsics.tagNoInline(function readParamTarget(): u32 {
    return staticParamTarget.n
})
const dropParam = intrinsics.tagNoInline(function dropParam(o: { n: u32 }, by: u32): void {
    o.n = o.n - by
})
const staticFlag = { on: 0 as u32 }
const raiseFlag = intrinsics.tagNoInline(function raiseFlag(): void {
    staticFlag.on = 1
})
const lowerFlag = intrinsics.tagNoInline(function lowerFlag(): void {
    staticFlag.on = 0
})
const flagValue = intrinsics.tagNoInline(function flagValue(): u32 {
    return staticFlag.on ? 7 : 3
})
const staticTally = new Map<number, number>()
const tallyAdd = intrinsics.tagNoInline(function tallyAdd(k: u32): void {
    staticTally.set(k, (staticTally.get(k) ?? 0) + 1)
})
const tallyGet = intrinsics.tagNoInline(function tallyGet(k: u32): u32 {
    return staticTally.get(k) ?? 0
})
const tallyDrop = intrinsics.tagNoInline(function tallyDrop(k: u32): void {
    staticTally.delete(k)
})
const staticWeights = [3, 1, 4, 1, 5, 9, 2, 6] as u32[]
const weightAt = intrinsics.tagNoInline(function weightAt(i: u32): u32 {
    return staticWeights[i]
})
const staticPair = [1, 2] as u32[]
const flipPair = intrinsics.tagNoInline(function flipPair(): void {
    staticPair.reverse()
})
const pairHead = intrinsics.tagNoInline(function pairHead(): u32 {
    return staticPair[0]
})
const staticLog: u32[] = []
const logPush = intrinsics.tagNoInline(function logPush(x: u32): void {
    staticLog.push(x)
})
const logPop = intrinsics.tagNoInline(function logPop(): u32 {
    return staticLog.pop()
})
const logLength = intrinsics.tagNoInline(function logLength(): u32 {
    return staticLog.length
})
const ownerTable = new Map<number, number>()
class TableUser {
    declare k: number
    constructor(k: number) {
        this.k = k
    }
    put(v: number): void {
        ownerTable.set(this.k, v)
    }
    get(): number {
        return ownerTable.get(this.k) ?? 0
    }
    drop(): void {
        ownerTable.delete(this.k)
    }
}
const staticAcc = { total: 0 as u32 }
const eachUpTo = intrinsics.tagNoInline(function eachUpTo(n: u32, f: (i: u32) => void): void {
    for (let i: u32 = 0; i < n; i++) f(i)
})
const accTotal = intrinsics.tagNoInline(function accTotal(): u32 {
    const total = staticAcc.total
    return total > 0 ? total * 2 : 1
})

const nullableBox = intrinsics.tagNoInline(function nullableBox(flag: u32, v: u32): { x: u32 | undefined } {
    return flag ? { x: v } : { x: undefined }
})
const readNullable = intrinsics.tagNoInline(function readNullable(o: { x: u32 | undefined }): u32 {
    return o.x === undefined ? 100 : o.x + 1
})
const nullableParam = intrinsics.tagNoInline(function nullableParam(x: u32 | undefined): u32 {
    return x === undefined ? 100 : x + 1
})
const maybeZeroOf = intrinsics.tagNoInline(function maybeZeroOf(flag: u32): u32 | undefined {
    if (flag) return 0
    return undefined
})

if (intrinsics.argv()[0] === 'maps') {
    function staticStringLength(n: u32): number {
        return labelNames[n % 2].length
    }
    function arrayIndexOf(n: u32): number {
        const a = [1, n, 3]
        return a.indexOf(n) + (a.includes(3) ? 10 : 0)
    }
    function nullableMerge(flag: u32, v: u32): u32 {
        let x: u32 | undefined = undefined
        if (flag) x = v
        return x === undefined ? 100 : x + 1
    }
    function nullableLoop(n: u32): u32 {
        let found: u32 | undefined = undefined
        for (let i: u32 = 0; i < n; i++) if (i % 3 === 0) found = i
        return found === undefined ? 99 : found + 1
    }
    function nullableReturnedField(flag: u32, v: u32): u32 {
        const b = nullableBox(flag, v)
        return b.x === undefined ? 100 : b.x + 1
    }
    function nullableFieldStore(flag: u32, v: u32): u32 {
        const o: { x: u32 | undefined } = { x: undefined }
        if (flag) o.x = v
        return readNullable(o)
    }
    function nullableElement(i: u32, v: u32): u32 {
        const a: (u32 | undefined)[] = [v, undefined, v + 1]
        const e = a[i]
        return e === undefined ? 100 : e + 1
    }
    function nullableArg(flag: u32, v: u32): u32 {
        return nullableParam(flag ? v : undefined)
    }
    function taggedZeroTest(flag: u32): u32 {
        const v = maybeZeroOf(flag)
        if (v === 0) return 11
        return v === undefined ? 22 : 33
    }
    function nullableFalsy(flag: u32): u32 {
        const v = maybeZeroOf(flag)
        return (!v ? 10 : 20) + (v === 0 ? 1 : 2)
    }
    function mapGetDefault(n: u32): u32 {
        const m = new Map<u32, u32>()
        for (let i: u32 = 0; i < n * 3; i++) m.set(i % 3, i)
        return (m.get(0) ?? 99) * 1000 + (m.get(7) ?? 99)
    }
    function untaggedZeroTest(flag: u32): u32 {
        return maybeZeroOf(flag) === 0 ? 11 : 22
    }
    function staticArrayField(n: u32): u32 {
        return tableHolder.table[n] * tableHolder.scale + tableHolder.table.length
    }
    function constantObjectShared(n: u32): u32 {
        shiftScale(settingsA, 1)
        const seen = readCaptured(n)
        shiftScale(settingsA, -1)
        return seen
    }
    function constantObjectMutation(n: u32): u32 {
        shiftScale(settingsA, 1)
        const seen = readSettings(settingsA, n)
        shiftScale(settingsA, -1)
        return seen
    }
    function constantObjectIdentity(n: u32): u32 {
        return sameObject(settingsA, settingsA) * 10 + sameObject(settingsA, settingsB) + n - n
    }
    function constantObjectArg(n: u32): u32 {
        return readSettings(settingsA, n) + readSettings(settingsA, n + 1)
    }
    function constantObjectArgs(n: u32): u32 {
        return readSettings(settingsA, n) * 100 + readSettings(settingsB, n)
    }
    function staticWriteRead(k: u32): u32 {
        bumpStatic()
        bumpStatic()
        const seen = readStatic() * 10 + k
        dropStatic(2)
        return seen
    }
    function staticNestedWrite(k: u32): u32 {
        bumpNested(k)
        bumpNested(k)
        const seen = readNested() * 10 + k
        dropNested(k * 2)
        return seen
    }
    function staticParamWrite(k: u32): u32 {
        bumpParam(staticParamTarget, k)
        const seen = readParamTarget() * 10 + k
        dropParam(staticParamTarget, k)
        return seen
    }
    function staticFlagAcross(k: u32): u32 {
        const before = flagValue()
        raiseFlag()
        const after = flagValue()
        lowerFlag()
        return before * 100 + after * 10 + k
    }
    function staticMapAcross(k: u32): u32 {
        tallyAdd(k)
        tallyAdd(k)
        tallyAdd(k + 1)
        const seen = tallyGet(k) * 100 + tallyGet(k + 1) * 10 + tallyGet(k + 2)
        tallyDrop(k)
        tallyDrop(k + 1)
        return seen
    }
    function staticWeightLoop(n: u32): u32 {
        let sum: u32 = 0
        for (let i: u32 = 0; i < staticWeights.length; i++) sum = sum + staticWeights[i] * (i + n)
        return sum * 10 + weightAt(n)
    }
    function staticPairFlip(k: u32): u32 {
        const before = pairHead()
        flipPair()
        const after = pairHead()
        flipPair()
        return before * 100 + after * 10 + k
    }
    function staticLogPush(k: u32): u32 {
        logPush(k)
        logPush(k + 5)
        const seen = logLength() * 1000 + staticLog[0] * 10 + staticLog[1]
        const last = logPop()
        logPop()
        return seen * 100 + last * 10 + logLength()
    }
    function staticMapOwners(n: u32): u32 {
        const a = new TableUser(1)
        const b = new TableUser(1)
        a.put(n + 4)
        const seen = b.get()
        b.drop()
        return seen * 2
    }
    function staticCallbackWrite(n: u32): u32 {
        eachUpTo(n, i => {
            staticAcc.total = staticAcc.total + i
        })
        const seen = accTotal()
        eachUpTo(1, i => {
            staticAcc.total = i
        })
        return seen * 10 + accTotal()
    }
    function instanceofOps(n: u32): u32 {
        const h = new Hidden()
        const m = new Map<number, number>()
        let r: u32 = 0
        if (h instanceof Hidden) r = r + 1
        if (!(h instanceof Map)) r = r + 2
        if (m instanceof Map) r = r + 4
        if ((n as any) instanceof Even) r = r + 8
        if (!((n + 1 as any) instanceof Even)) r = r + 16
        return r
    }
    function hiddenOps(n: u32): u32 {
        const h = new Hidden()
        for (let i: u32 = 0; i < n; i++) h.push(i * 3)
        return h.at(n - 1) + h.count() * 100
    }
    function pstackPair(k: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, k, Types.u32)
        Intrinsics.store(p, 4, k + 1, Types.u32)
        return Intrinsics.load(p, 0, Types.u32) * 10 + Intrinsics.load(p, 4, Types.u32)
    }
    function pstackLoop(n: u32): u32 {
        const mark = programStackTop()
        const p = allocate(n * 4)
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i * 3, Types.u32)
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 4, Types.u32)
        const used = programStackTop() - mark
        releaseProgramStack(mark)
        return total + used * 1000 + (programStackTop() === mark ? 7 : 0)
    }
    function arrayPair(k: u32): u32 {
        const a = [k, k + 1]
        return a[0] * 10 + a[1]
    }
    function arrayPushLoop(n: u32): u32 {
        const a: u32[] = []
        for (let i: u32 = 0; i < n; i++) a.push(i * 3)
        return a[n - 1] + a.length * 100
    }
    function mapNew(): u32 {
        const m = new Map<u32, u32>()
        return m.size + 1
    }
    function mapSetGet(k: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(k, 7)
        return m.get(k)!
    }
    function mapOverwrite(k: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(k, 1)
        m.set(k, 2)
        return m.get(k)! * 10 + m.size
    }
    function mapHas(k: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(k, 1)
        return (m.has(k) ? 10 : 0) + (m.has(k + 1) ? 1 : 0)
    }
    function mapMany(n: u32): u32 {
        const m = new Map<u32, u32>()
        for (let i: u32 = 0; i < n; i++) m.set(i, i * 2)
        return m.get(n - 1)! + m.size * 100
    }

    function makePair(k: u32) {
        if (k > 100) return { a: k, b: 0 }
        return { a: k, b: k + 1 }
    }
    function returnedPair(k: u32): u32 {
        const p = makePair(k)
        return p.a * 10 + p.b
    }
    function findIndex(n: u32, target: u32): number {
        for (let i: u32 = 0; i < n; i++) {
            if (i * 3 === target) return i
        }
        return -1
    }
    function sentinelSum(n: u32): u32 {
        let total: u32 = 0
        for (let t: u32 = 0; t < n * 3; t++) {
            const i = findIndex(n, t)
            if (i === -1) continue
            total = total + i
        }
        return total
    }
    function sentinelMixed(n: u32): u32 {
        let total: u32 = 0
        for (let t: u32 = 0; t < n * 3; t++) {
            const i = findIndex(n, t)
            if (i === -1) continue
            total = total + i
        }
        return total * 100 + (findIndex(n, 3) + 1) * 10 + (findIndex(n, 4) + 1)
    }
    function algebra(n: u32, m: u32): u32 {
        const a = (n + m) - m
        const b = (n + 7) - 7
        const c = (n ^ n) + (m - m) + (n & n)
        const d = (n + 3) + (m - n) - 3
        return a + b + c + d
    }
    function setAddHas(k: u32): u32 {
        const s = new Set<u32>()
        s.add(k)
        s.add(k)
        return (s.has(k) ? 10 : 0) + (s.has(k + 1) ? 1 : 0) + s.size * 100
    }
    function setFrom(n: u32): u32 {
        const s = new Set<u32>([n, n + 1, n])
        return s.size * 10 + (s.has(n + 1) ? 1 : 0)
    }
    function setDelete(n: u32): u32 {
        const s = new Set<u32>()
        for (let i: u32 = 0; i < n; i++) s.add(i)
        s.delete(1)
        let total: u32 = 0
        for (const v of s) total = total * 10 + v
        return total + s.size * 100000
    }

    function u32ArrayNew(n: u32): u32 {
        const a = new Uint32Array(n)
        return a.length * 10 + a[n - 1]
    }
    function u32ArraySetGet(k: u32): u32 {
        const a = new Uint32Array(4)
        a[1] = k
        a[2] = k + 1
        return a[1] * 100 + a[2] * 10 + a[3]
    }
    function u32ArrayFrom(k: u32): u32 {
        const a = new Uint32Array([k, k + 1, 7])
        return a.length * 1000 + a[2] * 100 + a[1] * 10 + a[0]
    }
    function u32ArraySlice(k: u32): u32 {
        const a = new Uint32Array([k, k + 1, k + 2, k + 3])
        const b = a.slice(1, 3)
        b[0] = 9
        return b.length * 1000 + b[0] * 100 + b[1] * 10 + a[1]
    }
    function u32ArrayLoop(n: u32): u32 {
        const a = new Uint32Array(n)
        for (let i: u32 = 0; i < n; i++) a[i] = i * 3
        let total: u32 = 0
        for (let i: u32 = 0; i < a.length; i++) total = total + a[i]
        return total
    }

    function f64Scale(n: u32): u32 {
        const p = allocate(16)
        Intrinsics.store(p, 0, n * 1.5, Types.f64)
        Intrinsics.store(p, 8, 2, Types.f64)
        return Intrinsics.load(p, 0, Types.f64) * Intrinsics.load(p, 8, Types.f64)
    }
    function f64Sum(n: u32): u32 {
        const p = allocate(n * 8)
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 8, i + 0.25, Types.f64)
        let total = 0.5
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 8, Types.f64)
        return total
    }
    function f64Compare(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, n + 0.5, Types.f64)
        const v = Intrinsics.load(p, 0, Types.f64)
        return v < 3.25 ? 1 : v > 10 ? 2 : 3
    }
    function f64NaN(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, 0, Types.u32)
        Intrinsics.store(p, 4, 0x7FF00000 + n - 1, Types.u32)
        const x = Intrinsics.load(p, 0, Types.f64)
        const nan = x - x
        return nan < 1 ? 1 : nan >= 1 ? 2 : nan === nan ? 4 : 3
    }
    function performanceNow(n: u32): u32 {
        const before = performance.now()
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + i
        const after = performance.now()
        const elapsed = after - before
        return elapsed >= 0 && elapsed < 10000 && before > 1000 && total >= 0 ? 1 : 0
    }
    function consoleHello(n: u32): u32 {
        console.log('hello from console.log')
        return n + 1
    }

    const capturedLookup = new Map<u32, u32>()
    for (let i: u32 = 0; i < 64; i++) capturedLookup.set(i * 7, i)
    function capturedMapHits(n: u32): u32 {
        let hits: u32 = 0
        for (let i: u32 = 0; i < n; i++) if (capturedLookup.has(i * 7)) hits = hits + 1
        return hits
    }
    const capturedMembers = new Set<u32>()
    for (let i: u32 = 0; i < 64; i++) capturedMembers.add(i * 5)
    function capturedSetHits(n: u32): u32 {
        let hits: u32 = 0
        for (let i: u32 = 0; i < n; i++) if (capturedMembers.has(i * 5)) hits = hits + 1
        return hits
    }
    function numberStatics(n: u32): u32 {
        const half = n + 0.5
        let r: u32 = 0
        if (Number.isInteger(n)) r = r + 1
        if (!Number.isInteger(half)) r = r + 2
        if (Number.isSafeInteger(n)) r = r + 4
        if (!Number.isSafeInteger(half)) r = r + 8
        if (Number.isInteger(half + 0.5)) r = r + 16
        return r
    }
    const cases: [fn: Function, args: number[]][] = [
        [pstackPair, [4]],
        [pstackLoop, [5]],
        [arrayPair, [4]],
        [arrayPushLoop, [5]],
        [mapNew, []],
        [mapSetGet, [3]],
        [mapOverwrite, [3]],
        [mapHas, [3]],
        [mapMany, [5]],
        [returnedPair, [3], [200]],
        [sentinelSum, [5]],
        [sentinelMixed, [5]],
        [algebra, [5, 9]],
        [setAddHas, [3]],
        [setFrom, [3]],
        [setDelete, [5]],
        [hiddenOps, [5]],
        [instanceofOps, [4], [3]],
        [constantObjectArg, [4]],
        [constantObjectIdentity, [4]],
        [constantObjectMutation, [4]],
        [constantObjectShared, [4]],
        [constantObjectArgs, [4]],
        [staticWriteRead, [3]],
        [staticNestedWrite, [3]],
        [staticParamWrite, [3]],
        [u32ArrayNew, [3]],
        [u32ArraySetGet, [3]],
        [u32ArrayFrom, [3]],
        [u32ArraySlice, [3]],
        [u32ArrayLoop, [5]],
        [u32ArraySort, [200], [7]],
        [consoleHello, [1]],
        [f64Scale, [4]],
        [f64Sum, [4]],
        [f64Compare, [2], [20], [5]],
        [f64NaN, [1]],
        [performanceNow, [1000]],
        [capturedMapHits, [100]],
        [capturedSetHits, [100]],
        [numberStatics, [3]],
        [staticArrayField, [1]],
        // [staticStringLength, [3], [4]],
        // [arrayIndexOf, [3]],
        [staticFlagAcross, [2]],
        [staticMapAcross, [3]],
        [staticWeightLoop, [0], [5]],
        [staticPairFlip, [3]],
        [staticLogPush, [3]],
        [staticCallbackWrite, [5], [0]],
        [staticMapOwners, [3]],
        [nullableMerge, [1, 0], [0, 0], [1, 5]],
        [nullableLoop, [0], [1], [5]],
        // [nullableReturnedField, [1, 0], [0, 0], [1, 5]],
        // [nullableFieldStore, [1, 0], [0, 0], [1, 5]],
        // [nullableElement, [0, 0], [1, 0], [2, 0]],
        [nullableArg, [1, 0], [0, 0], [1, 5]],
        [taggedZeroTest, [1], [0]],
        [untaggedZeroTest, [1], [0]],
        [nullableFalsy, [1], [0]],
        [mapGetDefault, [0], [1], [2]],
    ]
    function u32ArraySort(n: u32): u32 {
        const a = new Uint32Array(n)
        let x: u32 = 7
        for (let i: u32 = 0; i < n; i++) {
            x = (x * 75 + 74) % 65537
            a[i] = x % 50
        }
        a.sort()
        let inversions: u32 = 0
        for (let i: u32 = 1; i < n; i++) if (a[i - 1] > a[i]) inversions = inversions + 1
        return inversions * 1000000 + a[0] * 1000 + a[n - 1] * 10 + a[n >>> 1]
    }
    function capturedMapBenchHas(iters: u32, n: u32): u32 {
        let hits: u32 = 0
        for (let k: u32 = 0; k < iters; k++) if (capturedLookup.has((k % n) * 7)) hits = hits + 1
        return hits
    }
    function capturedSetBenchHas(iters: u32, n: u32): u32 {
        let hits: u32 = 0
        for (let k: u32 = 0; k < iters; k++) if (capturedMembers.has((k % n) * 7)) hits = hits + 1
        return hits
    }
    function u32BenchSort(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a = new Uint32Array(n)
        let total: u32 = 0
        let x: u32 = 7
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < n; i++) {
                x = (x * 75 + 74) % 65537
                a[i] = x
            }
            a.sort()
            total = total ^ a[k % n]
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function u32BenchNew(iters: u32, n: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const mark = intrinsics.isNative() ? programStackTop() : 0
            const a = new Uint32Array(n)
            total = total ^ (a.length + k)
            if (intrinsics.isNative()) releaseProgramStack(mark)
        }
        return total
    }
    function u32BenchFillSum(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a = new Uint32Array(n)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < n; i++) a[i] = i + k
            for (let i: u32 = 0; i < n; i++) total = total ^ a[i]
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function rawBenchFillSum(iters: u32, n: u32): u32 {
        const mark = programStackTop()
        const p = allocate(n * 4)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i + k, Types.u32)
            for (let i: u32 = 0; i < n; i++) total = total ^ Intrinsics.load(p, i * 4, Types.u32)
        }
        releaseProgramStack(mark)
        return total
    }
    function u32BenchSlice(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a = new Uint32Array(n)
        for (let i: u32 = 0; i < n; i++) a[i] = i
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const inner = intrinsics.isNative() ? programStackTop() : 0
            const b = a.slice(1, n - 1)
            total = total ^ (b[k % b.length] + b.length)
            if (intrinsics.isNative()) releaseProgramStack(inner)
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function arrayPushBench(iters: u32, n: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const inner = intrinsics.isNative() ? programStackTop() : 0
            const a: u32[] = []
            for (let i: u32 = 0; i < n; i++) a.push(i ^ k)
            total = total ^ (a[k % n] + a.length)
            if (intrinsics.isNative()) releaseProgramStack(inner)
        }
        return total
    }
    function arrayMapBench(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const src: u32[] = []
        for (let i: u32 = 0; i < n; i++) src.push(i)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const inner = intrinsics.isNative() ? programStackTop() : 0
            const out = src.map(x => x * 3)
            total = total ^ (out[k % n] + out.length)
            if (intrinsics.isNative()) releaseProgramStack(inner)
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }

    function mapNumBuild(iters: u32, n: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const mark = intrinsics.isNative() ? programStackTop() : 0
            const m = new Map<u32, u32>()
            for (let i: u32 = 0; i < n; i++) m.set(i * 3, i + k)
            for (let i: u32 = 0; i < n; i++) m.set(i * 3, i)
            total = total + m.size + m.get((k & (n - 1)) * 3)!
            if (intrinsics.isNative()) releaseProgramStack(mark)
        }
        return total
    }
    function mapNumLookup(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const m = new Map<u32, u32>()
        for (let i: u32 = 0; i < n; i++) m.set(i * 3, i)
        const mask = n * 4 - 1
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const key = (k * 5) & mask
            const v = m.get(key)
            if (v !== undefined) total = total + v
            if (m.has(key + 1)) total = total + 1
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    const words = ['alpha', 'beta', 'gamma', 'delta', 'epsilon', 'zeta', 'eta', 'theta', 'iota', 'kappa', 'lambda', 'mu', 'nu', 'xi', 'omicron', 'pi']
    function mapStrLookup(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const m = new Map<string, u32>()
        for (let i: u32 = 0; i < 12; i++) m.set(words[i], i + n)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const v = m.get(words[k & 15])
            if (v !== undefined) total = total + v
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function setAddHasBench(iters: u32, n: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const mark = intrinsics.isNative() ? programStackTop() : 0
            const s = new Set<u32>()
            for (let i: u32 = 0; i < n; i++) s.add((i * 7) & (n - 1))
            for (let i: u32 = 0; i < n * 2; i++) if (s.has(i + k)) total = total + 1
            if (intrinsics.isNative()) releaseProgramStack(mark)
        }
        return total
    }
    function arrayPushForOf(iters: u32, n: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const mark = intrinsics.isNative() ? programStackTop() : 0
            const a: u32[] = []
            for (let i: u32 = 0; i < n; i++) a.push(i + k)
            for (const x of a) total = total ^ x
            if (intrinsics.isNative()) releaseProgramStack(mark)
        }
        return total
    }
    function arrayIndexSum(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a: u32[] = []
        for (let i: u32 = 0; i < n; i++) a.push(i * 3)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < a.length; i++) total = total + (a[i] ^ k)
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function mapEntriesBench(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const m = new Map<u32, u32>()
        for (let i: u32 = 0; i < n; i++) m.set(i * 3, i)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (const [key, v] of m) total = total + (key ^ k) * v
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function sumWith(a: u32[], f: (x: u32) => u32): u32 {
        let s: u32 = 0
        for (const x of a) s = s + f(x)
        return s
    }
    function closureBench(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a: u32[] = []
        for (let i: u32 = 0; i < n; i++) a.push(i)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const bias = k & 7
            let odd: u32 = 0
            a.every(x => {
                odd = odd + (x & 1)
                return true
            })
            total = total + odd + sumWith(a, x => x * 3 + bias)
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function structBench(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const ps: { x: u32, y: u32, vx: u32, vy: u32 }[] = []
        for (let i: u32 = 0; i < n; i++) ps.push({ x: i, y: i * 2, vx: (i & 3) + 1, vy: (i & 5) + 1 })
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < ps.length; i++) {
                const p = ps[i]
                p.x = (p.x + p.vx) & 1023
                p.y = (p.y + p.vy) & 1023
                total = total + (p.x ^ p.y)
            }
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }

    const dumped = intrinsics.argv().find(a => a.startsWith('v8-dump:'))?.slice(8)
    if (dumped) {
        const candidates = [...cases.map(([fn]) => fn), u32BenchNew, u32BenchFillSum, rawBenchFillSum, u32BenchSlice, u32BenchSort, capturedMapBenchHas]
        const found = candidates.find(fn => fn.name === dumped)!
        ;(globalThis as any).v8.setFlagsFromString(`--print-opt-code --print-opt-code-filter=${dumped} --code-comments`)
        let total = 0
        for (let i = 0; i < 50; i++) total += Number((found as any)(100_000, 128))
        console.log('v8-dump done', total)
    }

    if (harness.benching()) {
        const benches = harness.createBenches()
        benches.bench(u32BenchNew, [200_000, 16], { reps: 1, ops: 200_000 })
        benches.bench(u32BenchFillSum, [2_000, 1024], { reps: 1, ops: 2_000 * 2048 })
        benches.bench(rawBenchFillSum, [2_000, 1024], { reps: 1, ops: 2_000 * 2048 })
        benches.bench(u32BenchSlice, [100_000, 64], { reps: 1, ops: 100_000 })
        benches.bench(u32BenchSort, [200, 1024], { reps: 1, ops: 200 * 1024 })
        benches.bench(arrayPushBench, [20_000, 256], { reps: 1, ops: 20_000 * 256 })
        benches.bench(arrayMapBench, [20_000, 256], { reps: 1, ops: 20_000 * 256 })
        benches.bench(capturedMapBenchHas, [1_000_000, 128], { reps: 1, ops: 1_000_000 })
        benches.bench(capturedSetBenchHas, [1_000_000, 128], { reps: 1, ops: 1_000_000 })
        benches.bench(mapNumBuild, [2_000, 256], { reps: 1, ops: 2_000 * 512 })
        benches.bench(mapNumLookup, [1_000_000, 1024], { reps: 1, ops: 2_000_000 })
        benches.bench(mapStrLookup, [1_000_000, 3], { reps: 1, ops: 1_000_000 })
        benches.bench(setAddHasBench, [2_000, 256], { reps: 1, ops: 2_000 * 768 })
        benches.bench(arrayPushForOf, [2_000, 1024], { reps: 1, ops: 2_000 * 2048 })
        benches.bench(arrayIndexSum, [2_000, 1024], { reps: 1, ops: 2_000 * 1024 })
        benches.bench(mapEntriesBench, [2_000, 1024], { reps: 1, ops: 2_000 * 1024 })
        benches.bench(closureBench, [2_000, 1024], { reps: 1, ops: 2_000 * 2048 })
        benches.bench(structBench, [2_000, 1024], { reps: 1, ops: 2_000 * 1024 })
        benches.run()
    }

    harness.runCases({ prefix: 'maps' }, cases)
}
