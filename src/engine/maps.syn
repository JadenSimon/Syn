        return (x < 0 ? 1 : 0) + (x + n * 4294967296 === -7 ? 10 : 0) + a[1] * 100
    }
    function arrayMixedWide(n: u32): u32 {
        const a: number[] = []
        for (let i: u32 = 0; i < n; i++) a.push(i % 2 === 1 ? i * 4294967296 + i : i)
        let wide: u32 = 0
        let total: u32 = 0
        for (let i: u32 = 0; i < a.length; i++) {
            const x = a[i]
            if (x > 4294967295) wide = wide + 1
            if (x === i * 4294967296 + i || x === i) total = total + i
        }
        return wide * 1000 + total
    }
    function arraySignedU32(n: u32): u32 {
        const a: number[] = []
