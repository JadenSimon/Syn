/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as native from './native'
import { allocate, programStackTop, releaseProgramStack } from './builtin/memory'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

if (intrinsics.argv()[0] === 'maps') {
    function pstackPair(k: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, k, Types.u32)
        Intrinsics.store(p, 4, k + 1, Types.u32)
        return Intrinsics.load(p, 0, Types.u32) * 10 + Intrinsics.load(p, 4, Types.u32)
    }
    function pstackLoop(n: u32): u32 {
        const mark = programStackTop()
        const p = allocate(n * 4)
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i * 3, Types.u32)
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 4, Types.u32)
        const used = programStackTop() - mark
        releaseProgramStack(mark)
        return total + used * 1000 + (programStackTop() === mark ? 7 : 0)
    }
    function arrayPair(k: u32): u32 {
        const a = [k, k + 1]
        return a[0] * 10 + a[1]
    }
    function arrayPushLoop(n: u32): u32 {
        const a: u32[] = []
        for (let i: u32 = 0; i < n; i++) a.push(i * 3)
        return a[n - 1] + a.length * 100
    }
    function mapNew(): u32 {
        const m = new Map<u32, u32>()
        return m.size + 1
    }
    function mapSetGet(k: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(k, 7)
        return m.get(k)!
    }
    function mapOverwrite(k: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(k, 1)
        m.set(k, 2)
        return m.get(k)! * 10 + m.size
    }
    function mapHas(k: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(k, 1)
        return (m.has(k) ? 10 : 0) + (m.has(k + 1) ? 1 : 0)
    }
    function mapMany(n: u32): u32 {
        const m = new Map<u32, u32>()
        for (let i: u32 = 0; i < n; i++) m.set(i, i * 2)
        return m.get(n - 1)! + m.size * 100
    }

    function makePair(k: u32) {
        if (k > 100) return { a: k, b: 0 }
        return { a: k, b: k + 1 }
    }
    function returnedPair(k: u32): u32 {
        const p = makePair(k)
        return p.a * 10 + p.b
    }
    function findIndex(n: u32, target: u32): number {
        for (let i: u32 = 0; i < n; i++) {
            if (i * 3 === target) return i
        }
        return -1
    }
    function sentinelSum(n: u32): u32 {
        let total: u32 = 0
        for (let t: u32 = 0; t < n * 3; t++) {
            const i = findIndex(n, t)
            if (i === -1) continue
            total = total + i
        }
        return total
    }
    function sentinelMixed(n: u32): u32 {
        let total: u32 = 0
        for (let t: u32 = 0; t < n * 3; t++) {
            const i = findIndex(n, t)
            if (i === -1) continue
            total = total + i
        }
        return total * 100 + (findIndex(n, 3) + 1) * 10 + (findIndex(n, 4) + 1)
    }
    function algebra(n: u32, m: u32): u32 {
        const a = (n + m) - m
        const b = (n + 7) - 7
        const c = (n ^ n) + (m - m) + (n & n)
        const d = (n + 3) + (m - n) - 3
        return a + b + c + d
    }
    function setAddHas(k: u32): u32 {
        const s = new Set<u32>()
        s.add(k)
        s.add(k)
        return (s.has(k) ? 10 : 0) + (s.has(k + 1) ? 1 : 0) + s.size * 100
    }
    function setFrom(n: u32): u32 {
        const s = new Set<u32>([n, n + 1, n])
        return s.size * 10 + (s.has(n + 1) ? 1 : 0)
    }
    function setDelete(n: u32): u32 {
        const s = new Set<u32>()
        for (let i: u32 = 0; i < n; i++) s.add(i)
        s.delete(1)
        let total: u32 = 0
        for (const v of s) total = total * 10 + v
        return total + s.size * 100000
    }

    function u32ArrayNew(n: u32): u32 {
        const a = new Uint32Array(n)
        return a.length * 10 + a[n - 1]
    }
    function u32ArraySetGet(k: u32): u32 {
        const a = new Uint32Array(4)
        a[1] = k
        a[2] = k + 1
        return a[1] * 100 + a[2] * 10 + a[3]
    }
    function u32ArrayFrom(k: u32): u32 {
        const a = new Uint32Array([k, k + 1, 7])
        return a.length * 1000 + a[2] * 100 + a[1] * 10 + a[0]
    }
    function u32ArraySlice(k: u32): u32 {
        const a = new Uint32Array([k, k + 1, k + 2, k + 3])
        const b = a.slice(1, 3)
        b[0] = 9
        return b.length * 1000 + b[0] * 100 + b[1] * 10 + a[1]
    }
    function u32ArrayLoop(n: u32): u32 {
        const a = new Uint32Array(n)
        for (let i: u32 = 0; i < n; i++) a[i] = i * 3
        let total: u32 = 0
        for (let i: u32 = 0; i < a.length; i++) total = total + a[i]
        return total
    }

    function f64Scale(n: u32): u32 {
        const p = allocate(16)
        Intrinsics.store(p, 0, n * 1.5, Types.f64)
        Intrinsics.store(p, 8, 2, Types.f64)
        return Intrinsics.load(p, 0, Types.f64) * Intrinsics.load(p, 8, Types.f64)
    }
    function f64Sum(n: u32): u32 {
        const p = allocate(n * 8)
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 8, i + 0.25, Types.f64)
        let total = 0.5
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 8, Types.f64)
        return total
    }
    function f64Compare(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, n + 0.5, Types.f64)
        const v = Intrinsics.load(p, 0, Types.f64)
        return v < 3.25 ? 1 : v > 10 ? 2 : 3
    }
    function f64NaN(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, 0, Types.u32)
        Intrinsics.store(p, 4, 0x7FF00000 + n - 1, Types.u32)
        const x = Intrinsics.load(p, 0, Types.f64)
        const nan = x - x
        return nan < 1 ? 1 : nan >= 1 ? 2 : nan === nan ? 4 : 3
    }
    function consoleHello(n: u32): u32 {
        console.log('hello from console.log')
        return n + 1
    }

    const cases: [fn: Function, args: number[]][] = [
        [pstackPair, [4]],
        [pstackLoop, [5]],
        [arrayPair, [4]],
        [arrayPushLoop, [5]],
        [mapNew, []],
        [mapSetGet, [3]],
        [mapOverwrite, [3]],
        [mapHas, [3]],
        [mapMany, [5]],
        [returnedPair, [3]],
        [returnedPair, [200]],
        [sentinelSum, [5]],
        [sentinelMixed, [5]],
        [algebra, [5, 9]],
        [setAddHas, [3]],
        [setFrom, [3]],
        [setDelete, [5]],
        [u32ArrayNew, [3]],
        [u32ArraySetGet, [3]],
        [u32ArrayFrom, [3]],
        [u32ArraySlice, [3]],
        [u32ArrayLoop, [5]],
        [u32ArraySort, [200]],
        [u32ArraySort, [7]],
        [consoleHello, [1]],
        [f64Scale, [4]],
        [f64Sum, [4]],
        [f64Compare, [2]],
        [f64Compare, [20]],
        [f64Compare, [5]],
        [f64NaN, [1]],
    ]
    function u32ArraySort(n: u32): u32 {
        const a = new Uint32Array(n)
        let x: u32 = 7
        for (let i: u32 = 0; i < n; i++) {
            x = (x * 75 + 74) % 65537
            a[i] = x % 50
        }
        a.sort()
        let inversions: u32 = 0
        for (let i: u32 = 1; i < n; i++) if (a[i - 1] > a[i]) inversions = inversions + 1
        return inversions * 1000000 + a[0] * 1000 + a[n - 1] * 10 + a[n >>> 1]
    }
    function u32BenchSort(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a = new Uint32Array(n)
        let total: u32 = 0
        let x: u32 = 7
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < n; i++) {
                x = (x * 75 + 74) % 65537
                a[i] = x
            }
            a.sort()
            total = total ^ a[k % n]
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function u32BenchNew(iters: u32, n: u32): u32 {
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const mark = intrinsics.isNative() ? programStackTop() : 0
            const a = new Uint32Array(n)
            total = total ^ (a.length + k)
            if (intrinsics.isNative()) releaseProgramStack(mark)
        }
        return total
    }
    function u32BenchFillSum(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a = new Uint32Array(n)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < n; i++) a[i] = i + k
            for (let i: u32 = 0; i < n; i++) total = total ^ a[i]
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }
    function rawBenchFillSum(iters: u32, n: u32): u32 {
        const mark = programStackTop()
        const p = allocate(n * 4)
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i + k, Types.u32)
            for (let i: u32 = 0; i < n; i++) total = total ^ Intrinsics.load(p, i * 4, Types.u32)
        }
        releaseProgramStack(mark)
        return total
    }
    function u32BenchSlice(iters: u32, n: u32): u32 {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const a = new Uint32Array(n)
        for (let i: u32 = 0; i < n; i++) a[i] = i
        let total: u32 = 0
        for (let k: u32 = 0; k < iters; k++) {
            const inner = intrinsics.isNative() ? programStackTop() : 0
            const b = a.slice(1, n - 1)
            total = total ^ (b[k % b.length] + b.length)
            if (intrinsics.isNative()) releaseProgramStack(inner)
        }
        if (intrinsics.isNative()) releaseProgramStack(mark)
        return total
    }

    if (intrinsics.argv().includes('bench')) {
        const benches: [fn: Function, iters: number, n: number, perIter: number][] = [
            [u32BenchNew, 200_000, 16, 1],
            [u32BenchFillSum, 2_000, 1024, 2048],
            [rawBenchFillSum, 2_000, 1024, 2048],
            [u32BenchSlice, 100_000, 64, 1],
            [u32BenchSort, 200, 1024, 1024],
        ]
        const natives: any = native.createNatives(Object.fromEntries(benches.map(([fn]) => [fn.name, fn])))
        for (const [fn, iters, n, perIter] of benches) {
            const ops = iters * perIter
            const run = (f: Function) => {
                f(10, n)
                const start = performance.now()
                const result = f(iters, n)
                return { ms: performance.now() - start, result: Number(result) }
            }
            const nat = run(natives[fn.name])
            const host = run(fn)
            const agree = nat.result === host.result ? '' : ` RESULT MISMATCH ${nat.result} vs ${host.result}`
            console.log(`bench ${fn.name} (iters ${iters}, n ${n}): native ${nat.ms.toFixed(2)}ms (${(nat.ms / ops * 1e6).toFixed(2)} ns/op), host ${host.ms.toFixed(2)}ms (${(host.ms / ops * 1e6).toFixed(2)} ns/op)${agree}`)
        }
    }

    const only = intrinsics.argv().find(a => a.startsWith('only:'))?.slice(5)
    for (const [fn, args] of cases) {
        if (only && fn.name !== only) continue
        const expected = (fn as any)(...args)
        try {
            const natives: any = native.createNatives({ [fn.name]: fn })
            const actual = natives[fn.name](...args)
            if (Number(actual) === expected) console.log(`maps ${fn.name} ok`)
            else console.log(`maps ${fn.name} WRONG: ${actual}, expected ${expected}`)
        } catch (e) {
            console.log(`maps ${fn.name} FAILED: ${String(e).split('\n')[0].slice(0, 300)}`); if (intrinsics.argv().includes('maps-stack')) console.log((e as any)?.stack)
        }
    }
}
