/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import * as native from './native'
import { allocate, programStackTop, releaseProgramStack } from './builtins'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

class Hidden {
    #items: any[]
    #count: number
    constructor() {
        this.#items = []
        this.#count = 0
    }
    push(x: any): void {
        this.#items.push(x)
        this.#count = this.#count + 1
    }
    at(i: number): any {
        return i < this.#count ? this.#items[i] : undefined
    }
    count(): number {
        return this.#count
    }
}

class Even {
    static [Symbol.hasInstance](value: any): boolean {
        return value % 2 === 0
    }
}

const settingsA = { scale: 3, offset: 7 }
const settingsB = { scale: 5, offset: 11 }
const readSettings = intrinsics.tagNoInline(function readSettings(s: { scale: number, offset: number }, n: u32): u32 {
    return s.scale * n + s.offset
})
const sameObject = intrinsics.tagNoInline(function sameObject(a: any, b: any): u32 {
    return a === b ? 1 : 0
})
const shiftScale = intrinsics.tagNoInline(function shiftScale(s: { scale: number, offset: number }, by: u32): void {
    s.scale = s.scale + by
})
const readCaptured = intrinsics.tagNoInline(function readCaptured(n: u32): u32 {
    return settingsA.scale * n + settingsA.offset
})
const tableHolder = { table: [3, 5, 7] as u32[], scale: 2 as u32 }
const labelNames = ['alpha', 'beta']
const foldOne = new Set([1])
const foldKeywords = new Set(['if', 'else', 'for', 'while', 'return'])
const foldNames = ['zero', 'one', 'two', 'three']
const foldPrimes = [2, 3, 5, 7] as u32[]
const foldSquares = new Map([[2, 4], [3, 9]])
const foldHolder = { names: foldOne, scale: 3 as u32 }
const foldPrecedence = new Map([['+', 1], ['-', 1], ['*', 2], ['/', 2]])
const foldPairs = [['a', 1], ['b', 2]]
const foldMixed = ['x', 5, 'y', 7]
const foldObjectMix = [{ v: 3 }, 1]
const mixedWords = ['x', 5, 'y', 7]
const mixedTriple = [{ v: 4 }, 'x', 6]
const pickMixed = intrinsics.tagNoInline(function pickMixed(n: u32): string | number {
    if (n === 1) return 'one'
    if (n === 2) return 'two'
    return n * 3
})
const readHolder = intrinsics.tagNoInline(function readHolder(h: { names: Set<number>, scale: u32 }, n: u32): u32 {
    return h.scale + (h.names.has(n) ? 10 : 0)
})
const staticCounter = { n: 0 as u32 }
const bumpStatic = intrinsics.tagNoInline(function bumpStatic(): u32 {
    staticCounter.n = staticCounter.n + 1
    return staticCounter.n
})
const readStatic = intrinsics.tagNoInline(function readStatic(): u32 {
    return staticCounter.n
})
const dropStatic = intrinsics.tagNoInline(function dropStatic(by: u32): void {
    staticCounter.n = staticCounter.n - by
})
const staticNest = { inner: { n: 0 as u32 }, m: 5 as u32 }
const bumpNested = intrinsics.tagNoInline(function bumpNested(k: u32): u32 {
    staticNest.inner.n = staticNest.inner.n + k
    return staticNest.m
})
const readNested = intrinsics.tagNoInline(function readNested(): u32 {
    return staticNest.inner.n
})
const dropNested = intrinsics.tagNoInline(function dropNested(by: u32): void {
    staticNest.inner.n = staticNest.inner.n - by
})
const staticParamTarget = { n: 0 as u32 }
const bumpParam = intrinsics.tagNoInline(function bumpParam(o: { n: u32 }, k: u32): u32 {
    o.n = o.n + k
    return o.n
})
const readParamTarget = intrinsics.tagNoInline(function readParamTarget(): u32 {
    return staticParamTarget.n
})
const dropParam = intrinsics.tagNoInline(function dropParam(o: { n: u32 }, by: u32): void {
    o.n = o.n - by
})
const staticFlag = { on: 0 as u32 }
const raiseFlag = intrinsics.tagNoInline(function raiseFlag(): void {
    staticFlag.on = 1
})
const lowerFlag = intrinsics.tagNoInline(function lowerFlag(): void {
    staticFlag.on = 0
})
const flagValue = intrinsics.tagNoInline(function flagValue(): u32 {
    return staticFlag.on ? 7 : 3
})
const staticTally = new Map<number, number>()
const tallyAdd = intrinsics.tagNoInline(function tallyAdd(k: u32): void {
    staticTally.set(k, (staticTally.get(k) ?? 0) + 1)
})
const tallyGet = intrinsics.tagNoInline(function tallyGet(k: u32): u32 {
    return staticTally.get(k) ?? 0
})
const tallyDrop = intrinsics.tagNoInline(function tallyDrop(k: u32): void {
    staticTally.delete(k)
})
const staticWeights = [3, 1, 4, 1, 5, 9, 2, 6] as u32[]
const weightAt = intrinsics.tagNoInline(function weightAt(i: u32): u32 {
    return staticWeights[i]
})
const staticPair = [1, 2] as u32[]
const flipPair = intrinsics.tagNoInline(function flipPair(): void {
    staticPair.reverse()
})
const pairHead = intrinsics.tagNoInline(function pairHead(): u32 {
    return staticPair[0]
})
let heldPoint = { a: 1 as u32 }
const replaceHeld = intrinsics.tagNoInline(function replaceHeld(v: u32): u32 {
    heldPoint = { a: v }
    return heldPoint.a
})
const heldA = intrinsics.tagNoInline(function heldA(): u32 {
    return heldPoint.a
})
let staticTick: u32 = 0
const bumpTick = intrinsics.tagNoInline(function bumpTick(): u32 {
    staticTick = staticTick + 1
    return staticTick
})
const heldHolder = { p: { a: 1 as u32 } }
const replaceField = intrinsics.tagNoInline(function replaceField(v: u32): u32 {
    heldHolder.p = { a: v }
    return heldHolder.p.a
})
const fieldA = intrinsics.tagNoInline(function fieldA(): u32 {
    return heldHolder.p.a
})
const staticCounts = [0, 0, 0] as u32[]
const bumpCount = intrinsics.tagNoInline(function bumpCount(i: u32): void {
    staticCounts[i]++
})
const countAt = intrinsics.tagNoInline(function countAt(i: u32): u32 {
    return staticCounts[i]
})
const staticPoints = [{ a: 3 as u32 }, { a: 4 as u32 }]
const pointAt = intrinsics.tagNoInline(function pointAt(i: u32): u32 {
    return staticPoints[i].a
})
const staticLog: u32[] = []
const logPush = intrinsics.tagNoInline(function logPush(x: u32): void {
    staticLog.push(x)
})
const logPop = intrinsics.tagNoInline(function logPop(): u32 {
    return staticLog.pop()
})
const logLength = intrinsics.tagNoInline(function logLength(): u32 {
    return staticLog.length
})
const ownerTable = new Map<number, number>()
class TableUser {
    declare k: number
    constructor(k: number) {
        this.k = k
    }
    put(v: number): void {
        ownerTable.set(this.k, v)
    }
    get(): number {
        return ownerTable.get(this.k) ?? 0
    }
    drop(): void {
        ownerTable.delete(this.k)
    }
}
const staticAcc = { total: 0 as u32 }
const eachUpTo = intrinsics.tagNoInline(function eachUpTo(n: u32, f: (i: u32) => void): void {
    for (let i: u32 = 0; i < n; i++) f(i)
})
const accTotal = intrinsics.tagNoInline(function accTotal(): u32 {
    const total = staticAcc.total
    return total > 0 ? total * 2 : 1
})

const nullableBox = intrinsics.tagNoInline(function nullableBox(flag: u32, v: u32): { x: u32 | undefined } {
    return flag ? { x: v } : { x: undefined }
})
const readNullable = intrinsics.tagNoInline(function readNullable(o: { x: u32 | undefined }): u32 {
    return o.x === undefined ? 100 : o.x + 1
})
const nullableParam = intrinsics.tagNoInline(function nullableParam(x: u32 | undefined): u32 {
    return x === undefined ? 100 : x + 1
})
const maybeZeroOf = intrinsics.tagNoInline(function maybeZeroOf(flag: u32): u32 | undefined {
    if (flag) return 0
    return undefined
})
const maybeI64 = intrinsics.tagNoInline(function maybeI64(k: u32): number | undefined {
    if (k === 0) return undefined
    if (k === 1) return -1099511627776
    return 5
})
type Packed = { a: u32 | undefined, b: u32 | undefined, p: boolean, q: boolean }
const makePacked = intrinsics.tagNoInline(function makePacked(a: u32, b: u32, f: u32): Packed {
    return { a: a === 0 ? undefined : a - 1, b: b === 0 ? undefined : (b - 1) * 9, p: (f & 1) !== 0, q: (f & 2) !== 0 }
})
const readPacked = intrinsics.tagNoInline(function readPacked(o: Packed): u32 {
    let r: u32 = o.a === undefined ? 0 : o.a + 1
    r = r * 3 + (o.b === undefined ? 0 : o.b === 0 ? 1 : 2)
    r = r * 2 + (o.p ? 1 : 0)
    return r * 2 + (o.q ? 1 : 0)
})
type Maybes = { a: u32 | undefined, b: u32 | undefined, c: u32 }
const staticMaybes: Maybes = { a: 0, b: undefined, c: 5 }
const readMaybes = intrinsics.tagNoInline(function readMaybes(o: Maybes): u32 {
    return (o.a === undefined ? 0 : o.a + 1) * 100 + (o.b === undefined ? 0 : o.b + 1) * 10 + o.c
})
const editMaybes = intrinsics.tagNoInline(function editMaybes(o: Maybes, k: u32): void {
    if (k === 0) o.a = undefined
    else if (k === 1) o.b = 0
    else if (k === 2) o.c = 0
    else if (k === 3) o.a = 7
})
const editPacked = intrinsics.tagNoInline(function editPacked(o: Packed, k: u32): void {
    if (k === 0) o.a = undefined
    else if (k === 1) o.b = 0
    else if (k === 2) o.p = !o.p
    else if (k === 3) o.q = false
    else if (k === 4) o.a = 1
    else o.b = undefined
})

const maybeI32 = intrinsics.tagNoInline(function maybeI32(k: u32): i32 | undefined {
    if (k === 0) return undefined
    if (k === 1) return 0
    if (k === 2) return -1
    if (k === 3) return -2147483648
    return 2147483647
})
const maybeU32 = intrinsics.tagNoInline(function maybeU32(k: u32): u32 | undefined {
    if (k === 0) return undefined
    if (k === 1) return 0
    if (k === 2) return 4294967295
    return 7
})
const maybeBool = intrinsics.tagNoInline(function maybeBool(k: u32): boolean | undefined {
    if (k === 0) return undefined
    return k === 1
})
const i32OrSeven = intrinsics.tagNoInline(function i32OrSeven(x: i32 | undefined): number {
    return x === undefined ? 7 : x
})
const u32OrSeven = intrinsics.tagNoInline(function u32OrSeven(x: u32 | undefined): number {
    return x === undefined ? 7 : x
})
const relayU32 = intrinsics.tagNoInline(function relayU32(x: u32 | undefined): u32 | undefined {
    return x
})
const smallOps = new Set([0, 2, 3, 7, 31])
const wideOps = new Set([2, 31, 32, 63, 64, 71, 127, 255])
const otherOps = new Set([1, 4, 6])
const setQuery = intrinsics.tagNoInline(function setQuery(set: Set<number>, n: u32): u32 {
    return set.has(n) ? 1 : 0
})
const setMutate = intrinsics.tagNoInline(function setMutate(set: Set<number>, n: u32): void {
    set.add(n)
})
const setIdentity = intrinsics.tagNoInline(function setIdentity(set: Set<number>): Set<number> {
    return set
})
const fakeHas = intrinsics.tagNoInline(function fakeHas(value: number): boolean {
    return value === 42
})

export function suite() {
    function foldSetHas(): boolean {
        return foldOne.has(1)
    }
    function foldKeywordCount(n: u32): number {
        return (foldKeywords.has('for') ? 1 : 0) + (foldKeywords.has('foo') ? 10 : 0) + n
    }
    function foldNameLength(n: u32): number {
        return foldNames[2].length + n
    }
    function foldPrimeAt(n: u32): number {
        return foldPrimes[2] * 10 + foldPrimes.length + n
    }
    function foldSquareGet(n: u32): number {
        return (foldSquares.get(3) ?? 0) + (foldSquares.has(5) ? 100 : 0) + n
    }
    function foldHolderArg(n: u32): number {
        return readHolder(foldHolder, n) + n
    }
    function foldPrecUse(n: u32): number {
        return (foldPrecedence.get('*') ?? 0) * 10 + (foldPrecedence.get('+') ?? 0) + n
    }
    function foldPairAt(i: u32): number {
        const p = foldPairs[i]
        return (p[1] as number) * 10 + (p[0] === 'b' ? 1 : 0)
    }
    function foldMixedAt(n: u32): number {
        return (foldMixed[1] as number) * 10 + (foldMixed[2] === 'y' ? 1 : 0) + n
    }
    function staticObjectMixAt(i: u32): number {
        const x = foldObjectMix[i]
        return typeof x === 'number' ? x + 10 : x.v
    }
    function mixedStaticEq(i: u32): number {
        return mixedWords[i] === 'y' ? 1 : 0
    }
    function mixedDynamicEq(i: u32): number {
        const a = ['x', i, 'y', 7]
        return a[i] === 'y' ? 1 : 0
    }
    function mixedStaticTypeof(i: u32): number {
        const v = mixedWords[i]
        return typeof v === 'string' ? 100 : v
    }
    function mixedDynamicTypeof(i: u32): number {
        const a = ['x', i + 3, 'y', 7]
        const v = a[i]
        return typeof v === 'number' ? v : v === 'y' ? 200 : 100
    }
    function mixedObjectTypeof(i: u32): number {
        const v = mixedTriple[i]
        if (typeof v === 'string') return 100
        if (typeof v === 'number') return v
        return typeof v === 'object' ? 50 : 0
    }
    function mixedReturn(n: u32): number {
        const v = pickMixed(n)
        if (v === 'two') return 200
        return typeof v === 'number' ? v : 100
    }
    function tuplePairAt(i: u32): number {
        const pairs = [['a', i], ['b', i + 1]]
        const p = pairs[i]
        return (p[1] as number) * 10 + (p[0] === 'b' ? 1 : 0)
    }
    function staticStringLength(n: u32): number {
        return labelNames[n % 2].length
    }
    function arrayIndexOf(n: u32): number {
        const a = [1, n, 3]
        return a.indexOf(n) + (a.includes(3) ? 10 : 0)
    }
    function nullableMerge(flag: u32, v: u32): u32 {
        let x: u32 | undefined = undefined
        if (flag) x = v
        return x === undefined ? 100 : x + 1
    }
    function nullableLoop(n: u32): u32 {
        let found: u32 | undefined = undefined
        for (let i: u32 = 0; i < n; i++) if (i % 3 === 0) found = i
        return found === undefined ? 99 : found + 1
    }
    function nullableReturnedField(flag: u32, v: u32): u32 {
        const b = nullableBox(flag, v)
        return b.x === undefined ? 100 : b.x + 1
    }
    function nullableFieldStore(flag: u32, v: u32): u32 {
        const o: { x: u32 | undefined } = { x: undefined }
        if (flag) o.x = v
        return readNullable(o)
    }
    function nullableElement(i: u32, v: u32): u32 {
        const a: (u32 | undefined)[] = [v, undefined, v + 1]
        const e = a[i]
        return e === undefined ? 100 : e + 1
    }
    function nullablePackedOne(a: u32, b: u32, f: u32): u32 {
        const o = makePacked(a, b, f)
        const before = readPacked(o)
        editPacked(o, a + b + f)
        return before * 100 + readPacked(o)
    }
    function nullablePacked(n: u32): u32 {
        let sum: u32 = 0
        for (let a: u32 = 0; a < 3; a++) {
            for (let b: u32 = 0; b < 3; b++) {
                for (let f: u32 = 0; f < 4; f++) {
                    const o = makePacked(a, b, f)
                    sum = (sum * 31 + readPacked(o)) % 1000003
                    editPacked(o, (a + b + f + n) % 6)
                    sum = (sum * 31 + readPacked(o)) % 1000003
                }
            }
        }
        return sum
    }
    function nullableStatic(k: u32): u32 {
        const before = readMaybes(staticMaybes) * 10 + (staticMaybes.b === undefined ? 1 : 2)
        editMaybes(staticMaybes, k)
        const after = readMaybes(staticMaybes) * 10 + (staticMaybes.a === undefined ? 1 : 2)
        staticMaybes.a = 0
        staticMaybes.b = undefined
        staticMaybes.c = 5
        return before * 10000 + after
    }
    function nullablePackedLocal(a: u32, b: u32, f: u32): u32 {
        const o: Packed = { a: a === 0 ? undefined : a - 1, b: b === 0 ? undefined : (b - 1) * 9, p: (f & 1) !== 0, q: (f & 2) !== 0 }
        if (f === 3) o.a = 0
        if (a === 2) o.p = false
        return readPacked(o)
    }
    function nullableArg(flag: u32, v: u32): u32 {
        return nullableParam(flag ? v : undefined)
    }
    function taggedZeroTest(flag: u32): u32 {
        const v = maybeZeroOf(flag)
        if (v === 0) return 11
        return v === undefined ? 22 : 33
    }
    function nullableFalsy(flag: u32): u32 {
        const v = maybeZeroOf(flag)
        return (!v ? 10 : 20) + (v === 0 ? 1 : 2)
    }
    function mapGetDefault(n: u32): u32 {
        const m = new Map<u32, u32>()
        for (let i: u32 = 0; i < n * 3; i++) m.set(i % 3, i)
        return (m.get(0) ?? 99) * 1000 + (m.get(7) ?? 99)
    }
    function taggedI64Return(k: u32): number {
        const v = maybeI64(k)
        return v === undefined ? 1000 : v
    }
    function narrowI32Return(k: u32): number {
        const v = maybeI32(k)
        return v === undefined ? 1000 : v
    }
    function narrowI32Local(k: u32): number {
        let v = maybeI32(k)
        if (v === undefined) v = 5
        return v * 2
    }
    function narrowI32Arg(k: u32): number {
        return i32OrSeven(maybeI32(k)) + i32OrSeven(k > 2 ? -3 : undefined)
    }
    function narrowI32Compare(k: u32): number {
        const v = maybeI32(k)
        return (v === 0 ? 1 : 0) + (v === undefined ? 10 : 0) + (v === -1 ? 100 : 0) + (v !== 2147483647 ? 1000 : 0)
    }
    function narrowU32Return(k: u32): number {
        const v = maybeU32(k)
        return v === undefined ? 1 : v + 2
    }
    function narrowU32Truthy(k: u32): number {
        const v = maybeU32(k)
        return (v ? 1 : 0) + (!v ? 10 : 0) + (v === undefined ? 100 : 0)
    }
    function narrowU32Arg(k: u32): number {
        return u32OrSeven(k > 1 ? maybeU32(k) : undefined) + u32OrSeven(maybeU32(k))
    }
    function narrowRelay(k: u32): number {
        const v = relayU32(maybeU32(k))
        return v === undefined ? 1 : v === 0 ? 2 : 3
    }
    function narrowBool(k: u32): number {
        const b = maybeBool(k)
        return b === undefined ? 2 : b ? 1 : 0
    }
    function narrowLoop(n: u32): number {
        let found: i32 | undefined = undefined
        for (let i: u32 = 0; i < n; i++) {
            const v = maybeI32(i % 5)
            if (v !== undefined && v < 0) found = v
        }
        return found === undefined ? 99 : found
    }
    function untaggedZeroTest(flag: u32): u32 {
        return maybeZeroOf(flag) === 0 ? 11 : 22
    }
    function staticArrayField(n: u32): u32 {
        return tableHolder.table[n] * tableHolder.scale + tableHolder.table.length
    }
    function constantObjectShared(n: u32): u32 {
        shiftScale(settingsA, 1)
        const seen = readCaptured(n)
        shiftScale(settingsA, -1)
        return seen
    }
    function constantObjectMutation(n: u32): u32 {
        shiftScale(settingsA, 1)
        const seen = readSettings(settingsA, n)
        shiftScale(settingsA, -1)
        return seen
    }
    function constantObjectIdentity(n: u32): u32 {
        return sameObject(settingsA, settingsA) * 10 + sameObject(settingsA, settingsB) + n - n
    }
    function constantObjectArg(n: u32): u32 {
        return readSettings(settingsA, n) + readSettings(settingsA, n + 1)
    }
    function constantObjectArgs(n: u32): u32 {
        return readSettings(settingsA, n) * 100 + readSettings(settingsB, n)
    }
    function staticWriteRead(k: u32): u32 {
        bumpStatic()
        bumpStatic()
        const seen = readStatic() * 10 + k
        dropStatic(2)
        return seen
    }
    function staticNestedWrite(k: u32): u32 {
        bumpNested(k)
        bumpNested(k)
        const seen = readNested() * 10 + k
        dropNested(k * 2)
        return seen
    }
    function staticParamWrite(k: u32): u32 {
        bumpParam(staticParamTarget, k)
        const seen = readParamTarget() * 10 + k
        dropParam(staticParamTarget, k)
        return seen
    }
    function staticFlagAcross(k: u32): u32 {
        const before = flagValue()
        raiseFlag()
        const after = flagValue()
        lowerFlag()
        return before * 100 + after * 10 + k
    }
    function staticMapAcross(k: u32): u32 {
        tallyAdd(k)
        tallyAdd(k)
        tallyAdd(k + 1)
        const seen = tallyGet(k) * 100 + tallyGet(k + 1) * 10 + tallyGet(k + 2)
        tallyDrop(k)
        tallyDrop(k + 1)
        return seen
    }
    function staticWeightLoop(n: u32): u32 {
        let sum: u32 = 0
        for (let i: u32 = 0; i < staticWeights.length; i++) sum = sum + staticWeights[i] * (i + n)
        return sum * 10 + weightAt(n)
    }
    function staticPairFlip(k: u32): u32 {
        const before = pairHead()
        flipPair()
        const after = pairHead()
        flipPair()
        return before * 100 + after * 10 + k
    }
    let mutPoint = { a: 1 as u32 }
    function staticLetMut(v: u32): u32 {
        mutPoint = { a: v }
        return mutPoint.a
    }
    function staticLetObject(v: u32): u32 {
        const r = replaceHeld(v)
        const seen = heldA()
        replaceHeld(1)
        return r * 100 + seen * 10 + heldA()
    }
    function staticFieldObject(v: u32): u32 {
        const r = replaceField(v)
        const seen = fieldA()
        replaceField(1)
        return r * 100 + seen * 10 + fieldA()
    }
    function staticLetCounter(k: u32): u32 {
        const a = bumpTick()
        const b = bumpTick()
        staticTick = staticTick - 2
        return a * 100 + b * 10 + k
    }
    function staticTableBump(i: u32): u32 {
        bumpCount(i)
        bumpCount(i)
        bumpCount(2 - i)
        const seen = countAt(0) * 100 + countAt(1) * 10 + countAt(2)
        staticCounts[i] = 0
        staticCounts[2 - i] = 0
        return seen
    }
    function staticObjectTable(i: u32): u32 {
        return pointAt(i) * 10 + pointAt(1 - i)
    }
    function staticLogPush(k: u32): u32 {
        logPush(k)
        logPush(k + 5)
        const seen = logLength() * 1000 + staticLog[0] * 10 + staticLog[1]
        const last = logPop()
        logPop()
        return seen * 100 + last * 10 + logLength()
    }
    function staticMapOwners(n: u32): u32 {
        const a = new TableUser(1)
        const b = new TableUser(1)
        a.put(n + 4)
        const seen = b.get()
        b.drop()
        return seen * 2
    }
    function staticCallbackWrite(n: u32): u32 {
        eachUpTo(n, i => {
            staticAcc.total = staticAcc.total + i
        })
        const seen = accTotal()
        eachUpTo(1, i => {
            staticAcc.total = i
        })
        return seen * 10 + accTotal()
    }
    function instanceofOps(n: u32): u32 {
        const h = new Hidden()
        const m = new Map<number, number>()
        let r: u32 = 0
        if (h instanceof Hidden) r = r + 1
        if (!(h instanceof Map)) r = r + 2
        if (m instanceof Map) r = r + 4
        if ((n as any) instanceof Even) r = r + 8
        if (!((n + 1 as any) instanceof Even)) r = r + 16
        return r
    }
    function hiddenOps(n: u32): u32 {
