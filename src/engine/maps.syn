            objs.push({ v: i + 1 })
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + objs[i].v + (nums[i] > 4294967296 ? 100 : 0)
        return total + (objs.at(n) === undefined ? 10000 : 0)
    }
    function arrayLiteralKinds(n: u32): u32 {
        const objs = [{ v: n }, { v: n + 1 }]
        const nums = [n * 4294967296 + 3, 7]
