    }
    function pstackLoop(n: u32): u32 {
        const mark = programStackTop()
        const p = allocate(n * 4)
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i * 3, Types.u32)
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 4, Types.u32)
        const used = programStackTop() - mark
        releaseProgramStack(mark)
        return total + used * 1000 + (programStackTop() === mark ? 7 : 0)
    }
