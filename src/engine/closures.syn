/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as native from './native'

if (intrinsics.argv()[0] === 'closures') {
    function readCapture(n: u32): u32 {
        function add(x: u32): u32 {
            return x + n
        }
        return add(1)
    }
    function writeCapture(n: u32): u32 {
        let c: u32 = 0
        function bump(): void {
            c = c + n
        }
        bump()
        bump()
        return c
    }
    function loopCall(n: u32): u32 {
        let s: u32 = 0
        function step(i: u32): void {
            s = s + i
        }
        for (let i: u32 = 0; i < n; i++) step(i)
        return s
    }
    function nestedCapture(n: u32): u32 {
        function outer(a: u32): u32 {
            function inner(b: u32): u32 {
                return a + b + n
            }
            return inner(2)
        }
        return outer(1)
    }
    function skipLevel(n: u32): u32 {
        function outer(a: u32): u32 {
            function inner(b: u32): u32 {
                return b + n
            }
            return inner(a) + 1
        }
        return outer(2)
    }
    function threeLevels(n: u32): u32 {
        let total: u32 = 0
        function outer(a: u32): u32 {
            function middle(b: u32): u32 {
                function inner(c: u32): void {
                    total = total + a + b + c + n
                }
                inner(3)
                return total
            }
            return middle(2)
        }
        return outer(1) + total
    }
    function applyTwice(f: (x: u32) => u32, x: u32): u32 {
        return f(f(x))
    }
    function passedDown(n: u32): u32 {
        function add(x: u32): u32 {
            return x + n
        }
        return applyTwice(add, 1)
    }
    function returned(n: u32): u32 {
        function makeAdder(k: u32) {
            function add(x: u32): u32 {
                return x + k
            }
            return add
        }
        const f = makeAdder(n)
        return f(1)
    }
    function arrow(n: u32): u32 {
        const add = (x: u32): u32 => x + n
        return add(1)
    }
    function expression(n: u32): u32 {
        const add = function(x: u32): u32 { return x + n }
        return add(1)
    }
    function method(n: u32): u32 {
        const o = { get: function(): u32 { return n } }
        return o.get() + 1
    }
    function deferred(n: u32): u32 {
        let s: u32 = n
        defer s = 0
        return s
    }
    function deferAfterReturn(n: u32): u32 {
        let total: u32 = 0
        function work(): u32 {
            defer total = total + n
            total = total * 2 + 1
            return total
        }
        const r = work()
        return r * 100 + total
    }
    function deferOrder(n: u32): u32 {
        let s: u32 = 0
        function work(): void {
            defer s = s * 10 + 1
            defer s = s * 10 + 2
            s = n
        }
        work()
        return s
    }
    function deferEarly(n: u32): u32 {
        let s: u32 = 0
        function work(x: u32): u32 {
            defer s = s + 1
            if (x > 2) return x
            return 0
        }
        const a = work(n)
        const b = work(1)
        return a + b * 10 + s * 100
    }

    function iteratedClosures(n: u32): u32 {
        let s: u32 = 0
        function bump(): u32 {
            s = s + n
            return s
        }
        const steps = [bump, bump]
        let total: u32 = 0
        for (const step of steps) total = total + step()
        return total
    }

    const cases: [fn: Function, args: number[]][] = [
        [readCapture, [4]],
        [writeCapture, [3]],
        [loopCall, [5]],
        [nestedCapture, [3]],
        [skipLevel, [3]],
        [threeLevels, [3]],
        [passedDown, [3]],
        [returned, [3]],
        [arrow, [3]],
        [expression, [3]],
        [method, [3]],
        [deferred, [3]],
        [deferAfterReturn, [3]],
        [deferOrder, [3]],
        [deferEarly, [3]],
        [iteratedClosures, [3]],
    ]
    const only = intrinsics.argv().find(a => a.startsWith('only:'))?.slice(5)
    for (const [fn, args] of cases) {
        if (only && fn.name !== only) continue
        const expected = (fn as any)(...args)
        try {
            const natives: any = native.createNatives({ [fn.name]: fn })
            const actual = natives[fn.name](...args)
            if (Number(actual) === expected) console.log(`closures native ${fn.name} ok`)
            else console.log(`closures native ${fn.name} WRONG: ${actual}, expected ${expected}`)
        } catch (e) {
            console.log(`closures native ${fn.name} FAILED: ${String(e).split('\n')[0].slice(0, 300)}`)
        }
    }
}
