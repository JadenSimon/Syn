        if (code.words.some((word: number) => ((word & 0xfc000000) >>> 0) === 0x94000000 || ((word & 0xfffffc1f) >>> 0) === 0xd63f0000)) harness.fail(`presized rows must write elements directly:\n${code.listing}`)
    }, 'aarch64')
