    harness.test('dominatedCompares', () => {
        const references = { dominatedJoin, dominatedLoop, dominatedLoopJoin, dominatedMixedPaths, dominatedRebound }
        const natives: any = native.createNatives(references)
        for (const [name, reference] of Object.entries(references)) {
            for (const n of [0, 1, 2, 7, 31]) for (const x of [0, 1, 6, 7, 19, 20, 21, 30, 31, 40]) {
                const expected = (reference as any)(n, x)
