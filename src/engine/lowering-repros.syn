        const p = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const join = gn.addNode(g, gn.NodeOp.block, [])
        const q = gn.addNode(g, gn.NodeOp.param, [], Types.vm_value)
        const enter = gn.addNode(g, gn.NodeOp.apply, [join, p])
        const ret = gn.addNode(g, gn.NodeOp.ret, [q, join])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [p], bodyId: enter, bodyConst: 0 }, { id: join, params: [q], bodyId: ret, bodyConst: 0 }])
        const int: Rep = { kind: 'number', format: { bits: 64, signed: true }, members: 0, shapes: [], nullable: false }
        const word: Rep = { kind: 'union', members: RepMember.string, shapes: [], nullable: true }
        native.realizeRepresentations(g, codecRequest(new Map([[p, int], [q, word]]), [int], word, { mode: 'keep', returns: Types.vm_value, tags: [] }), false)
        const boxed = gn.getNode(g, gn.getRef(gn.getNode(g, enter)!, 1))
        if (boxed?.op !== gn.NodeOp.box || gn.getRef(boxed, 0) !== p) harness.fail(`an i64 arriving at a union-word param must be boxed: ${gn.getRef(gn.getNode(g, enter)!, 1)}`)
        if (gn.getRef(gn.getNode(g, ret)!, 0) !== q) harness.fail('a union word returned as a word must pass through')
        lowerValueGraph(g)
    })
    harness.test('realizeTagsStandalone', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const p = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const ret = gn.addNode(g, gn.NodeOp.ret, [p, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [p], bodyId: ret, bodyConst: 0 }])
        const maybe: Rep = { kind: 'number', format: { bits: 32, signed: false }, members: 0, shapes: [], nullable: true }
        const request = codecRequest(new Map([[p, maybe]]), [maybe], maybe, { mode: 'tagged', returns: Types.u64, tags: [0] })
        request.tracked.set(p, true)
        native.realizeRepresentations(g, request, true)
        const params = g.blocks[0].params
        const pair = gn.getNode(g, gn.getRef(gn.getNode(g, ret)!, 0))
        if (params.length !== 2 || pair?.op !== gn.NodeOp.record || gn.getRef(pair, 1) !== p || gn.getRef(pair, 3) !== params[1]) harness.fail('a tagged nullable param must gain a tag param and return a payload/tag record')
        if (lowerValueGraph(g).words.length !== 1) harness.fail('the payload and tag params already sit in the return registers')
