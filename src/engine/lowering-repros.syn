        if (load.op !== gn.NodeOp.load || gn.typeOf(load) !== Types.f64 || at?.op !== gn.NodeOp.mul || gn.getLiteral(g, at, 1) !== 8) harness.fail('an f64 slice must read raw 8-byte floats')
