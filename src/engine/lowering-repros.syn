        native.bindParams(shared.callee, new Map([[shared.callee.blocks[0].params[1], { literal: 7 }]]))
        const sum = gn.getNode(shared.callee, gn.getRef(gn.getNode(shared.callee, shared.callee.blocks[0].bodyId)!, 0))!
        const lifted = shared.callee.blocks[0].params[2]
        if (gn.getRef(gn.getNode(shared.caller, shared.call)!, 5) !== twin || gn.getRef(sum, 0) !== lifted || gn.getRef(sum, 1) || gn.getLiteral(shared.callee, sum, 1) !== 7) harness.fail('shareValues must pass the twin as a new param; bindParams must fold the literal param')
