            stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
            if (actual !== expected) harness.fail(`repro pstackReturnedThis FAILED: pstackTally(${n}) returned ${actual}, expected ${expected}`)
        }
        const perCall = (growth[1] - growth[0]) / (2048 - 256)
        console.log(`repro pstackReturnedThis: ${growth[0]} B at 256, ${growth[1]} B at 2048 (${perCall.toFixed(1)} B per iteration)`)
        if (perCall > 16) harness.fail(`repro pstackReturnedThis FAILED: pstackTally grows the pstacks ${perCall.toFixed(1)} B per iteration; pstackCountInto returns the caller's map, which it did not allocate, so its scratch words must still be reset`)
