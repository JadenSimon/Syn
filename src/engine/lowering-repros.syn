const siteMap = new Map<any, any>()
function siteSetA(x: any): void {
    siteMap.set('aaa', x)
}
;(siteSetA as any).shouldNotInline = true
function siteSetB(x: any): void {
    siteMap.set(2, x)
}
;(siteSetB as any).shouldNotInline = true

class SwapStack {
    items: number[]

    constructor() {
        this.items = []
    }

    push(x: number): void {
        this.items.push(x)
    }

    top(): number {
        return this.items[this.items.length - 1]
    }
}

class TallyView {
    count: number

    constructor(tally: Tally) {
        this.count = peekTally(tally)
    }
}

const mixedMap = new Map<number, number | { a: number }>([[1, 2.5], [2, { a: 7 }]])
function mixedSlots(n: u32): number {
    const xs: (number | { v: number })[] = [n, { v: n + 1 }]
    let s = 0
    for (const x of xs) s += typeof x === 'number' ? x : x.v
    return s
}

function wideNullableSlots(n: u32): number {
    const xs: (number | undefined)[] = []
    xs.push(n > 2 ? undefined : n * 4294967296)
    return xs[0] === undefined ? 7 : 3
}

function truthySlots(n: u32): number {
    const xs: (number | undefined)[] = []
    xs.push(n > 2 ? undefined : n)
    xs.push(7)
    let s = 0
    let i = 0
    while (i < xs.length) {
        if (xs[i]) s++
        i++
    }
    return s
}

const fixedNames = ['ab', 'cde', 'f']
function fixedStepSum(n: u32): number {
    let s = 0
    let i = 0
    while (i < fixedNames.length) {
        s += fixedNames[i].length * n
        i++
    }
    return s
}

const pairSlots = [1, 2]
function weighSlots(slots: number[]): number {
    return slots.length * 100 + (slots[1] ?? 7)
}
;(weighSlots as any).shouldNotInline = true
function spliceStart(k: u32): number | undefined {
    if (k > 63) return undefined
    if (k & 1) return k - 1
    return k * 0.5
}
function directPair(k: u32): number {
    let s = pairSlots.length * 10
    for (const x of pairSlots) s += x
    return s + (pairSlots[k & 3] ?? 7) * 100
}
;(directPair as any).shouldNotInline = true
function staticSlotsRead(k: u32): number {
    const fresh = [4, 5, 6, 7, 8].splice(spliceStart(k)!, 2)
    return weighSlots(pairSlots) * 1000 + weighSlots(fresh) + directPair(k) * 1000000
}

const grownIds: number[] = []
function growIds(k: u32): number {
    grownIds.push(k)
    grownIds.push(k + 1)
    let s = 0
    for (const id of grownIds) s += id
    const fresh = [4, 5, 6, 7, 8].splice(spliceStart(k)!, 2)
    s = s * 100000 + weighSlots(grownIds) * 1000 + weighSlots(fresh)
    grownIds.length = 0
    return s
}

function pushFirstMatch(target: number[], ids: number[]): boolean {
    for (const id of ids) {
        if (id % 3 !== 1) {
            target.push(id)
            return true
        }
    }
    return false
}

function forOfReturnPush(n: u32): number {
    const target: number[] = [n]
    const found = pushFirstMatch(target, [n, n + 1, n + 2])
    return (found ? 1000 : 2000) + target.length * 100 + target[target.length - 1]
}

function remainderWords(v: number): number {
    let rest = v
    let words = 0
    let i = 0
    while (i < 4) {
        if (rest % 65536 !== 0) words++
        rest = Math.floor(rest / 65536)
        i++
    }
    return words
}

const halfRemainder = intrinsics.tagNoInline(function halfRemainder(x: number): number {
    return 7 % (x + 0.5)
})

function remainderWordsOf(n: u32): number {
    return remainderWords(n * 65537.5) * 10 + halfRemainder(n)
}

const scaledPushes = intrinsics.tagInline(function scaledPushes(out: number[], scale: number, count: u32): void {
    let i: u32 = 0
    while (i < count) {
        out.push(scale * i)
        i++
    }
})

const encodedScales = [1.5, 2, 2.5, 3]

function guardedReadInlinedLoop(n: u32): number {
    const out: number[] = []
    scaledPushes(out, encodedScales[n & 3], n & 7)
    return out.length + out[out.length - 1]
}

interface HeldAddress {
    at: number
    n: u32
}

let heldAddress: HeldAddress | undefined

function addressInField(phase: u32, n: u32): number {
    if (phase === 0) {
        const at = Intrinsics.pstack(programStack, 0, 16)
        Intrinsics.store(at, 8, n * 3, Types.u64)
        heldAddress = { at, n }
    }
    const held = heldAddress!
    heldAddress = undefined
    const kept = Intrinsics.load(held.at, 8, Types.u64)
    Intrinsics.pstack(programStack, held.at, 0)
    return kept + held.n
}

let heldAddressCell = 0

function addressInGlobal(phase: u32, n: u32): number {
    if (phase === 0) {
        const at = Intrinsics.pstack(programStack, 0, 16)
        Intrinsics.store(at, 8, n * 3, Types.u64)
        heldAddressCell = at
    }
    const at = heldAddressCell
    heldAddressCell = 0
    const kept = Intrinsics.load(at, 8, Types.u64)
    Intrinsics.pstack(programStack, at, 0)
    return kept + n
}

const pstackScratch = intrinsics.tagNoInline(function pstackScratch(n: u32): u32 {
    const xs: u32[] = []
    let i: u32 = 0
    while (i < (n & 31) + 8) {
        xs.push(i * 3)
        i++
    }
    let total: u32 = 0
    let j = 0
    while (j < xs.length) {
        total = (total + xs[j]) & 0xffff
        j++
    }
    return total
})

function pstackKeptOut(n: u32): number {
    const out: number[] = []
    let i: u32 = 0
    while (i < n) {
        out.push(pstackScratch(i))
        i++
    }
    return out.length + out[out.length - 1]
}

function pstackKeptPairs(n: u32): number {
    const out: number[] = []
    let i: u32 = 0
    while (i < n) {
        const a = pstackScratch(i)
        const b = pstackScratch(i + 1)
        out.push(a * 3 + b)
        i++
    }
    return out.length + out[out.length - 1]
}

function pstackKeyHits(n: u32): number {
    const m = new Map<string, u32>()
    m.set('k0', 1)
    m.set('k1', 2)
    const out: number[] = []
    let i: u32 = 0
    while (i < n) {
        const first = m.get('k0') ?? 99
        out.push(first * 100 + (m.has(`k${i}`) ? 10 : 0) + (m.has('k1') ? 1 : 0))
        i++
    }
    return out.length + out[out.length - 1]
}

function pstackPushScratch(out: number[], i: u32): void {
    out.push(pstackScratch(i))
}

function pstackKeptInlined(n: u32): number {
    const out: number[] = []
    let i: u32 = 0
    while (i < n) {
        pstackPushScratch(out, i)
        i++
    }
    return out.length + out[out.length - 1]
}

function pstackKeptRows(n: u32): number {
    const rows: number[][] = []
    let i: u32 = 0
    while (i < n) {
        const row: number[] = []
        let j: u32 = 0
        while (j < 4) {
            row.push(pstackScratch(i + j))
            j++
        }
        rows.push(row)
        i++
    }
    return rows.length + rows[rows.length - 1][3]
}

interface PickedCell {
    a: number
    b: number
}

const keptCell = intrinsics.tagNoInline(function keptCell(cells: PickedCell[], k: u32): PickedCell {
    return cells[k]
})

const pstackWordLabel = intrinsics.tagNoInline(function pstackWordLabel(n: u32): string {
    const words = new Uint32Array((n & 31) + 8)
    let i = 0
    while (i < words.length) {
        words[i] = i * 3
        i++
    }
    let total: u32 = 0
    let j = 0
    while (j < words.length) {
        total = (total + words[j]) & 0xffff
        j++
    }
    return `k${total}`
})

function pstackNestedScratch(n: u32): number {
    let total: u32 = 0
    let i: u32 = 0
    while (i < n) {
        let j: u32 = 0
        while (j < 4) {
            const words = new Uint32Array((j & 3) + 4)
            words[0] = i + j
            total = (total + words[0]) & 0xffff
            j++
        }
        i++
    }
    return total
}

const pstackCountInto = intrinsics.tagNoInline(function pstackCountInto(m: Map<number, number>, n: u32): Map<number, number> {
    const words = new Uint32Array((n & 31) + 8)
    let i = 0
    while (i < words.length) {
        words[i] = i * 5 + n
        i++
    }
    let total: u32 = 0
    let j = 0
    while (j < words.length) {
        total = (total + words[j]) & 0xffff
        j++
    }
    return m.set(n & 63, total)
})

function pstackTally(n: u32): number {
    const m = new Map<number, number>()
    let i: u32 = 0
    while (i < n) {
        pstackCountInto(m, i)
        i++
    }
    let total = 0
    for (const v of m.values()) total = (total + v) & 0xffffff
    return total + m.size
}

const pstackGrowInto = intrinsics.tagNoInline(function pstackGrowInto(m: Map<number, number>, n: u32): Map<number, number> {
    const words = new Uint32Array((n & 15) + 4)
    words[0] = n * 7
    return m.set(n, words[0] + words.length)
})

function pstackGrown(n: u32): number {
    const m = new Map<number, number>()
    let i: u32 = 0
    while (i < n) {
        pstackGrowInto(m, i)
        i++
    }
    let total = 0
    let k: u32 = 0
    while (k < n) {
        total = (total + (m.get(k) ?? 0)) & 0xffffff
        k++
    }
    return total + m.size
}

const pstackPairSum = intrinsics.tagNoInline(function pstackPairSum(p: { x: number, y: number }): number {
    return p.x + p.y
})

const pstackMakePair = intrinsics.tagNoInline(function pstackMakePair(i: u32): { x: number, y: number } {
    return { x: i, y: i * 2 }
})

const pstackArmWork = intrinsics.tagNoInline(function pstackArmWork(i: u32): number {
    return pstackPairSum(pstackMakePair(i))
})

const pstackArms = intrinsics.tagNoInline(function pstackArms(k: u32, i: u32): { x: number, y: number } | undefined {
    if (k === 0) return pstackArmWork(i) > 5 ? undefined : pstackArmKeep
    if (k === 1) return { x: pstackArmWork(i + 1), y: i }
    if (k > 2) return pstackArms(k - 3, i)
    return undefined
})

const pstackArmKeep = { x: 1, y: 2 }

function pstackArmLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = pstackArms(i % 7, i)
        if (p) total = (total + p.x + p.y) & 0xffffff
        i++
    }
    return total
}

const pstackSharedList = intrinsics.tagNoInline(function pstackSharedList(i: u32): number[] {
    return [i, i * 3, i + 7]
})

const pstackSharedA = intrinsics.tagNoInline(function pstackSharedA(i: u32): number {
    const xs = pstackSharedList(i)
    return xs[i % 3] + xs.length
})

const pstackSharedB = intrinsics.tagNoInline(function pstackSharedB(i: u32): number {
    const xs = pstackSharedList(i + 1)
    return xs[(i + 1) % 3] - xs[0]
})

function pstackSharedLoop(n: u32): number {
    const kept: { v: number }[] = []
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = (total + pstackSharedA(i) + pstackSharedB(i)) & 0xffffff
        if ((i & 63) === 0) kept.push({ v: i })
        i++
    }
    return total + kept.length
}

const pstackIdleProbe = intrinsics.tagNoInline(function pstackIdleProbe(path: number[], at: number): number | undefined {
    return path.length === at ? undefined : path.length + at
})

const pstackIdleUse = intrinsics.tagNoInline(function pstackIdleUse(merged: number[], total: number[]): void {
    total[0] += merged.length
})

const pstackIdleFill = intrinsics.tagNoInline(function pstackIdleFill(kept: number[], x: number): void {
    kept.push(x)
})

let pstackIdleCount = 0

const pstackIdleSome = intrinsics.tagNoInline(function pstackIdleSome(params: number[], at: u32, paths: number[][], total: number[]): boolean {
    if (at > 0) return pstackIdleSome(params, at - 1, paths, total)
    if (!params.length) return false
    const deciding = params.filter(p => p > 0)
    pstackIdleCount++
    if (deciding.length > 12) return false
    if (!deciding.length) return false
    const sites: [from: number, path: number[]][] = []
    for (const path of paths) {
        if (!path.length) return false
        sites.push([path[0], path])
    }
    if (sites.length < 2) return false
    const kept: number[] = []
    const literal = (p: number) => {
        for (const [, path] of sites) {
            if (pstackIdleProbe(path, p) === undefined) return false
        }
        return true
    }
    if (!deciding.some(literal)) return false
    const merged: number[] = []
    for (const [from, path] of sites) {
        const m = pstackIdleProbe(path, from)
        if (m === undefined) return false
        merged.push(merged.length > 0 ? m + from : m)
    }
    pstackIdleFill(kept, merged.length)
    pstackIdleUse(merged, total)
    pstackIdleUse(kept, total)
    return true
})

function pstackSomeLoop(n: u32): number {
    const paths = [[4, 5], [6, 7, 8]]
    const total = [0]
    let count = 0
    let i: u32 = 0
    while (i < n) {
        if (pstackIdleSome([i & 7, (i + 1) & 7], i & 1, paths, total)) count++
        i++
    }
    return count + total[0]
}

function pstackKeptRecords(n: u32): number {
    const kept: { v: number }[] = []
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const pair = pstackMakePair(i)
        total = (total + pstackPairSum(pair)) & 0xffffff
        if ((i & 63) === 0) kept.push({ v: i })
        i++
    }
    return total + kept.length
}

function pstackLabelled(n: u32): number {
    const names: string[] = []
    let i: u32 = 0
    while (i < n) {
        names.push(pstackWordLabel(i))
        i++
    }
    return names.length + names[names.length - 1].length
}

const pstackTouched = { hits: 0 }

const pstackTouch = intrinsics.tagNoInline(function pstackTouch(k: u32): u32 {
    pstackTouched.hits = pstackTouched.hits + 1
    return k + 1
})

function pstackQuietScratch(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = { x: i, y: i + 1 }
        total = total + pstackTouch(p.x) + p.y
        i++
    }
    return total
}

const exitPairSum = intrinsics.tagNoInline(function exitPairSum(xs: number[], k: u32): number {
    return xs[k % xs.length] + xs.length
})

function pstackQuietExitArm(n: u32): number {
    if (n > 50) return exitPairSum([n, n + 1, n + 2], n)
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = { x: i, y: i + 1 }
        total = total + pstackTouch(p.x) + p.y
        i++
    }
    return total
}

function pstackQuietPlain(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pstackTouch(i) + (i + 1)
        i++
    }
    return total
}

const pstackCheckedStep = intrinsics.tagNoInline(function pstackCheckedStep(k: u32, limit: u32): u32 {
    if (k > limit) {
        const parts = [k, limit]
        throw `step ${parts.join(' > ')}`
    }
    return k + 1
})

function pstackCheckedSum(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pstackCheckedStep(i, n)
        i++
    }
    return total
}

const pstackQuietInner = intrinsics.tagNoInline(function pstackQuietInner(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = { x: i, y: i + 1 }
        total = total + pstackTouch(p.x) + p.y
        i++
    }
    return total
})

function pstackQuietOuter(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pstackQuietInner(i & 7)
        i++
    }
    return total
}

const pstackReadPoint = intrinsics.tagNoInline(function pstackReadPoint(p: { x: number, y: number }): number {
    return p.x + p.y
})

const pstackStaleInner = intrinsics.tagNoInline(function pstackStaleInner(k: u32): number {
    const p = { x: k, y: k + 1 }
    return pstackReadPoint(p)
})

function pstackStaleOuter(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pstackStaleInner(i)
        i++
    }
    return total
}

const pstackStaleChain = intrinsics.tagNoInline(function pstackStaleChain(k: u32): number {
    if (k === 0) return 0
    const p = { x: k, y: k + 1 }
    return pstackReadPoint(p) + pstackStaleChain(k - 1)
})

function pstackStaleChainOuter(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pstackStaleChain(i & 3)
        i++
    }
    return total
}

const pstackEdges: number[][] = [[1, 2], [3], [3, 4], [5], [5, 6], [], [7], []]

const pstackReaches = intrinsics.tagNoInline(function pstackReaches(roots: number[], target: number, stopAt: number): boolean {
    const seen = new Set<number>()
    const stack = roots.slice()
    while (stack.length) {
        const id = stack.pop()!
        if (seen.has(id)) continue
        if (id === target) return true
        seen.add(id)
        if (id === stopAt) continue
        const next = pstackEdges[id]
        if (!next) continue
        for (let i = 0; i < next.length; i++) stack.push(next[i])
    }
    return false
})

const pstackSyscallTouch = intrinsics.tagNoInline(function pstackSyscallTouch(k: u32): number {
    return (intrinsics.isNative() ? write(2, 0, 0) : 0) + k
})

const literalCellHolder: { cell: { a: number, b: number } | undefined } = { cell: undefined }

const literalCellSum = intrinsics.tagNoInline(function literalCellSum(k: number, depth: number): number {
    const c = literalCellHolder.cell
    return c ? c.a * 10 + c.b + k + depth : k + depth
})

function storedLiteralArgument(k: number, depth: number): number {
    if (k === 3) literalCellHolder.cell = { a: k, b: depth }
    return literalCellSum(k, depth)
}

function syscallKeepsValues(a: u32, b: u32, c: u32): number {
    const w = intrinsics.isNative() ? write(2, 0, 0) : 0
    return w + a * 3 + (b ^ 5) + c
}

const keepsThirdArg = intrinsics.tagNoInline(function keepsThirdArg(a: u32, b: u32, c: u32): u32 {
    return (a * 3 + b) ^ c
})

function sameConstantArg(a: u32, b: u32): u32 {
    const x = keepsThirdArg(a, b, 1)
    const y = keepsThirdArg(x, b ^ 9, 1)
    return keepsThirdArg(y, x, 2) + x
}

const mixesPair = intrinsics.tagNoInline(function mixesPair(a: u32, b: u32): u32 {
    return (a * 5) ^ b
})

function savedForShortValue(a: u32, b: u32, c: u32): u32 {
    const x = mixesPair(a, b)
    const y = mixesPair(x, c)
    const t = y * 7
    return (t ^ (t >> 3)) + x
}

const crowdedCall = intrinsics.tagNoInline(function crowdedCall(n: u32): u32 {
    return crowdedLoop(n, n)
})

function freedBeforeCall(a: u32, b: u32, c: u32, n: u32): u32 {
    return crowdedCall(n) + ((a * b) ^ c)
}

function crowdedLoop(n: u32, a: u32): u32 {
    let s0 = a + 0
    let s1 = a + 1
    let s2 = a + 2
    let s3 = a + 3
    let s4 = a + 4
    let s5 = a + 5
    let s6 = a + 6
    let s7 = a + 7
    let s8 = a + 8
    let s9 = a + 9
    let s10 = a + 10
    let s11 = a + 11
    let s12 = a + 12
    let i: u32 = 0
    while (i < n) {
        s0 = s0 + (i ^ 1)
        s1 = s1 + (i ^ 2)
        s2 = s2 + (i ^ 3)
        s3 = s3 + (i ^ 4)
        s4 = s4 + (i ^ 5)
        s5 = s5 + (i ^ 6)
        s6 = s6 + (i ^ 7)
        s7 = s7 + (i ^ 8)
        s8 = s8 + (i ^ 9)
        s9 = s9 + (i ^ 10)
        s10 = s10 + (i ^ 11)
        s11 = s11 + (i ^ 12)
        s12 = s12 + (i ^ 13)
        i++
    }
    return s0 ^ s1 ^ s2 ^ s3 ^ s4 ^ s5 ^ s6 ^ s7 ^ s8 ^ s9 ^ s10 ^ s11 ^ s12
}

const voidTallies = [0, 0, 0, 0]
const tallyAt = intrinsics.tagNoInline(function tallyAt(i: u32): void {
    voidTallies[i & 3] = voidTallies[i & 3] + 1
})

function voidResultKeepsX0(a: u32): number {
    tallyAt(a)
    tallyAt(a + 2)
    return voidTallies[1] + voidTallies[3]
}

const markCleared = intrinsics.tagNoInline(function markCleared(p: u32): void {
    Intrinsics.store(p, 80, 1, Types.u64)
})

function zeroStoresBeforeTailCall(p: u32): void {
    Intrinsics.store(p, 24, 0, Types.u64)
    Intrinsics.store(p, 32, 0, Types.u64)
    Intrinsics.store(p, 40, 0, Types.u64)
    Intrinsics.store(p, 48, 0, Types.u64)
    Intrinsics.store(p, 0, 0, Types.u64)
    Intrinsics.store(p, 8, 0, Types.u64)
    Intrinsics.store(p, 16, 0, Types.u64)
    Intrinsics.store(p, 56, 0, Types.u64)
    Intrinsics.store(p, 64, 0, Types.u64)
    Intrinsics.store(p, 72, 0, Types.u64)
    markCleared(p)
}

function pstackSyscallLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = { x: i, y: i + 1 }
        total = total + pstackSyscallTouch(p.x) + p.y
        i++
    }
    return total
}

class SlabEdgeIndex {
    items: number[]

    constructor() {
        this.items = []
    }

    append(x: number): void {
        this.items.push(x)
    }

    clear(): void {
        this.items = []
    }

    rebuild(step: number): void {
        const next: number[] = []
        for (const x of this.items) {
            if (x % step !== 0) next.push(x + step)
        }
        this.items = next
    }

    sum(): number {
        let total = 0
        for (const x of this.items) total = total + x
        return total
    }
}

function slabIndexRounds(rounds: u32): number {
    const index = new SlabEdgeIndex()
    let total = 0
    let r: u32 = 0
    while (r < rounds) {
        let i: u32 = 0
        while (i < 64) {
            index.append(r * 64 + i)
            i++
        }
        index.rebuild(3)
        total = total + index.sum()
        if ((r & 3) === 3) index.clear()
        r++
    }
    return total
}

function slabIndexGrowth(n: u32): number {
    const index = new SlabEdgeIndex()
    index.clear()
    let i: u32 = 0
    while (i < n) {
        index.append(i)
        i++
    }
    return index.sum()
}

function slabLocalTemp(n: u32): number {
    const tmp: number[] = []
    let i: u32 = 0
    while (i < n) {
        tmp.push(i * 3)
        i++
    }
    let total = 0
    for (const x of tmp) total = total + x
    return total
}

function pstackReachCount(n: u32): number {
    let hits = 0
    let i: u32 = 0
    while (i < n) {
        if (pstackReaches([i & 7], (i * 3) & 7, (i >> 3) & 7)) hits++
        i++
    }
    return hits
}

const pstackMarkWalk = intrinsics.tagNoInline(function pstackMarkWalk(p: { v: number, w: number }, k: u32): number {
    if (k === 0) return p.v
    p.w = p.w + k
    return pstackMarkWalk(p, k - 1)
})

function pstackMarkInner(n: u32): number {
    const p = { v: n, w: 0 }
    const r = pstackMarkWalk(p, n & 7)
    return r + p.w
}

const pstackMarkRec = intrinsics.tagNoInline(function pstackMarkRec(k: u32, n: u32): number {
    if (k > 0) return pstackMarkRec(k - 1, n) + 1
    let s: u32 = 0
    let j: u32 = 0
    while (j < n) {
        if (s > 40) break
        s = s ^ (j * 3)
        j++
    }
    const a = pstackMarkInner(s)
    return a + pstackMarkWalk({ v: a, w: 1 }, 2)
})

const outlinedExitStep = intrinsics.tagNoInline(function outlinedExitStep(params: number[], at: u32, paths: number[][], total: number[]): boolean {
    if (at > 0) return outlinedExitStep(params, 0, paths, total)
    const deciding = params.filter(p => p > 0)
    if (!deciding.length) return false
    const sites: number[][] = []
    for (const path of paths) {
        if (!path.length) return false
        sites.push(path)
    }
    if (sites.length < 2) return false
    const kept: number[] = []
    const literal = (p: number) => {
        for (const path of sites) {
            if (path.length === p) return false
        }
        return true
    }
    if (!deciding.some(literal)) return false
    const merged: number[] = []
    for (const path of sites) merged.push(path.length)
    kept.push(merged.length)
    total[0] += kept.length
    return true
})

function outlinedExitOrdering(n: u32): number {
    const paths = [[4, 5], [6, 7, 8]]
    const total = [0]
    let count = 0
    let i: u32 = 0
    while (i < n) {
        if (outlinedExitStep([i & 7, (i + 1) & 7], i & 1, paths, total)) count++
        i++
    }
    return count + total[0]
}


function pstackMarkExit(n: u32): number {
    return pstackMarkRec(3, n)
}

const downCount = intrinsics.tagNoInline(function downCount(n: u32): number {
    function down(m: number, acc: number[]): number[] | undefined {
        if (m <= 0) return acc.length > 0 ? acc : undefined
        return down(m - 1, [...acc, m])
    }
    const got = down(n, [])
    return got ? got.length : 99
})

function resetsAfterCall(reps: u32, n: u32): number {
    let total = 0
    for (let i: u32 = 0; i < reps; i++) total = total + downCount(n + (i & 1))
    return total
}

function pstackCellStores(listing: string): string[] {
    const lines = listing.split('\n')
    const found: string[] = []
    let k = 1
    while (k < lines.length) {
        const cell = /ldr (x\d+), entry/.exec(lines[k - 1])
        if (cell && new RegExp(`\\b(?:str \\S+|stp \\S+ \\S+), \\[${cell[1]}, #(?:0|8|16|24|32)\\]`).test(lines[k])) found.push(lines[k].trim())
        k++
    }
    return found
}

function allocationLines(listing: string): string[] {
    const found: string[] = []
    const tops = new Set<string>()
    for (const line of listing.split('\n')) {
        const instruction = /^\s*\d+: [0-9a-f]+\s+(\w+)\s+(.*)$/.exec(line)
        if (!instruction) continue
        const [, op, operands] = instruction
        const top = /^str \S+, \[(x\d+)(?:, #\d+)?\]/.exec(`${op} ${operands}`)
        if (top && tops.has(top[1])) found.push(line.trim())
        if (/^add x\d+, sp, #/.test(`${op} ${operands}`)) found.push(line.trim())
        if (op === 'bl') tops.clear()
        if (op.startsWith('st') || op.startsWith('b') || op.startsWith('cb') || op === 'ret') continue
        const written = /^(x\d+)(?:, (x\d+))?/.exec(operands)
        if (!written) continue
        tops.delete(written[1])
        if (op === 'ldp' && written[2]) tops.delete(written[2])
        if (op === 'ldr' && /^x\d+, entry/.test(operands)) tops.add(written[1])
    }
    return found
}

class CountedSteps {
    i: number
    n: number
    constructor(n: number) {
        this.i = 0
        this.n = n
    }
    next(): { done: boolean, value: number } {
        if (this.i >= this.n) return { done: true, value: 0 }
        const value = this.i + 5
        this.i++
        return { done: false, value }
    }
}
intrinsics.tagNoInline(CountedSteps.prototype.next)

class DoubledSteps {
    inner: CountedSteps
    constructor(inner: CountedSteps) {
        this.inner = inner
    }
    next(): { done: boolean, value: number } {
        const step = this.inner.next()
        if (step.done) return step
        return { done: false, value: step.value * 2 }
    }
    [Symbol.iterator]() {
        return this
    }
}
intrinsics.tagNoInline(DoubledSteps.prototype.next)

function doubledStepSum(n: u32): number {
    let total = 0
    for (const v of new DoubledSteps(new CountedSteps(n))) total = total + v
    return total
}

const pickFromPair = intrinsics.tagNoInline(function pickFromPair(p: { x: number, y: number }, k: u32): number {
    if (k & 1) return p.x * 3
    return p.y
})

function pickPairLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pickFromPair({ x: i, y: i + 7 }, i)
        i++
    }
    return total
}

interface KeptPair {
    kept: { x: number, y: number } | undefined
    count: number
}

const keepOnThird = intrinsics.tagNoInline(function keepOnThird(p: { x: number, y: number }, k: u32, holder: KeptPair): number {
    if (k === 3) holder.kept = p
    return p.x + p.y
})

function keepThirdLoop(n: u32): number {
    const holder: KeptPair = { kept: undefined, count: 0 }
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + keepOnThird({ x: i, y: i * 2 }, i, holder)
        i++
    }
    const kept = holder.kept
    return kept ? total * 100 + kept.x * 10 + kept.y : total
}

const bumpPairX = intrinsics.tagNoInline(function bumpPairX(p: { x: number, y: number }, k: u32): number {
    if (k & 1) p.x = p.x + 10
    return p.y
})

function bumpPairLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = { x: i, y: i + 1 }
        total = total + bumpPairX(p, i) + p.x
        i++
    }
    return total
}

const pinnedPair = { x: 1, y: 2 }

const isPinnedPair = intrinsics.tagNoInline(function isPinnedPair(p: { x: number, y: number }, k: u32): number {
    if (k & 1) return p === pinnedPair ? 100 : p.x
    return p.y
})

function pinnedPairLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + isPinnedPair({ x: i, y: i + 3 }, i)
        i++
    }
    return total + isPinnedPair(pinnedPair, 1)
}

const keepPairAlways = intrinsics.tagNoInline(function keepPairAlways(p: { x: number, y: number }, holder: KeptPair): number {
    holder.kept = p
    return p.y
})

function keptThenMutated(n: u32): number {
    const holder: KeptPair = { kept: undefined, count: 0 }
    const p = { x: n, y: n + 1 }
    const y = keepPairAlways(p, holder)
    p.x = n + 50
    return holder.kept!.x * 10 + y
}

interface FiveFields {
    a: number
    b: number
    c: number
    d: number
    e: number
}

const pickFromWide = intrinsics.tagNoInline(function pickFromWide(p: FiveFields, k: u32): number {
    if (k & 1) return p.a + p.b * 2 + p.c * 3
    return p.d + p.e * 5
})

function wideLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + pickFromWide({ a: i, b: i + 1, c: i + 2, d: i + 3, e: i + 4 }, i)
        i++
    }
    return total
}

interface LatestPair {
    first: { x: number, y: number } | undefined
    kept: { x: number, y: number } | undefined
}

const keepLatest = intrinsics.tagNoInline(function keepLatest(p: { x: number, y: number }, k: u32, holder: LatestPair): number {
    if (k === 1) holder.first = holder.kept
    holder.kept = p
    return p.x
})

function keepAcrossLoop(n: u32): number {
    const holder: LatestPair = { first: undefined, kept: undefined }
    const p = { x: n, y: n + 1 }
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + keepLatest(p, i, holder)
        i++
    }
    return holder.first !== undefined && holder.first === holder.kept ? total + 1000 : total
}

const iterated = [3, 1, 4, 1, 5, 9, 2, 6]

function valuesTwiceSum(n: u32): number {
    let total = 0
    for (const x of iterated.values()) total = total + x * n
    for (const x of iterated.values()) total = total * 2 + x
    return total
}

class StepCursor {
    i: number
    n: number
    constructor(n: number) {
        this.i = 0
        this.n = n
    }
    next(): { done: boolean, value: number } {
        if (this.i >= this.n) return { done: true, value: 0 }
        const value = this.i * 3
        this.i = this.i + 1
        return { done: false, value }
    }
}
intrinsics.tagNoInline(StepCursor.prototype.next)

function cursorSum(n: u32): number {
    const it = new StepCursor(n)
    let total = 0
    let r = it.next()
    while (!r.done) {
        total = total + r.value
        r = it.next()
    }
    return total
}

interface PairBox {
    kept: { x: number, y: number }
}

const bumpThenRead = intrinsics.tagNoInline(function bumpThenRead(p: { x: number, y: number }, box: PairBox, k: u32): number {
    if (k & 1) p.x = p.x + 10
    return box.kept.x + p.y
})

function aliasedBumpLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        const p = { x: i, y: i + 1 }
        const box: PairBox = { kept: p }
        total = total + bumpThenRead(p, box, i) + p.x
        i++
    }
    return total
}

const bumpUnlessPinned = intrinsics.tagNoInline(function bumpUnlessPinned(p: { x: number, y: number }, k: u32): number {
    if (p === pinnedPair) return 100
    if (k & 1) p.x = p.x + 10
    return p.x + p.y
})

function pinnedBumpLoop(n: u32): number {
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + bumpUnlessPinned({ x: i, y: i + 3 }, i)
        i++
    }
    return total
}

function capturedCounter(n: u32): number {
    let count = 0
    let step = 1
    function bump(k: number): number {
        if (k & 1) count = count + k * step
        else count = count - k + step * 3
        if (count > 1000) count = count - 1000
        return count
    }
    let total = 0
    let i: u32 = 0
    while (i < n) {
        total = total + bump(i)
        step = step + 1
        i++
    }
    total = total + bump(total)
    return total + count
}

function unitListing(natives: any, name: string): string {
    return natives[name].units.find((unit: any) => unit.name === name).code.listing.replace(/L\d+/g, 'L').replace(/#p\d+$/gm, '')
}

function labelledSum(n: u32): number {
    let total = 0
    for (let i: u32 = 0; i < n; i++) {
        if (i & 1) total = total + i
        else total = total - 1
    }
    return total
}

function labelledProduct(n: u32): number {
    let total = 1
    for (let i: u32 = 0; i < n; i++) total = total * 3 + i
    return total
}

function calledStep(n: u32): u32 {
    return (n * 7) ^ (n >> 3)
}
;(calledStep as any).shouldNotInline = true

function namedCalls(n: u32): u32 {
    return calledStep(n) + calledStep(n + 1)
}

function observedWordPush(n: u32): number {
    const values: (u32 | undefined)[] = []
    let total = 0
    for (let i: u32 = 0; i < (n & 7); i++) {
        total += values.length
        values.push(i === 1 ? undefined : i)
    }
    return total + values.length + (values[0] ?? 0)
}

function observedNumberPush(n: u32): number {
    const values = [1, 2, 3, 4].slice(0, n & 3)
    let total = 0
    for (let i = 0; i < (n & 7); i++) {
        total += values.length
        values.push(i)
    }
    return total + values.length
}

// XXX: IF THIS FAILS, TRY MAKING THE TARGET CODE MORE COMPLICATED
function pairCompiled(name: string, roots: any, args: number[]): void {
    const alone: any = native.createNatives(roots)
    const beside: any = native.createNatives({ ...roots, entriesLiteralSum, mixedSlots, wideNullableSlots, fixedStepSum })
    for (const n of args) {
        const expected = roots[name](n)
        if (Number(alone[name](n)) !== expected) harness.fail(`${name}(${n}) = ${alone[name](n)}, expected ${expected}`)
        if (Number(beside[name](n)) !== expected) harness.fail(`${name}(${n}) beside the polluter roots = ${beside[name](n)}, expected ${expected}`)
    }
    const own = unitListing(alone, name)
    const paired = unitListing(beside, name)
    const pooled = /[0-9a-f]{8}( +\S+ \S+, )entry-\d+/g
    if (own.replace(pooled, '$1entry') !== paired.replace(pooled, '$1entry')) harness.fail(`${name} must compile the same beside the polluter roots:\n${own}\n--- beside entriesLiteralSum, mixedSlots, wideNullableSlots, fixedStepSum ---\n${paired}`)
}

let phaseItems: number[] = []
let phaseOut: number[] = []

function resetPhaseItems(): void {
    phaseItems = []
}

function phaseItemAt(i: number): number {
    return phaseItems[i]
}

function runPhasePasses(passes: ((x: number) => number)[], n: number): number {
    let total = n
    for (const pass of passes) {
        total = pass(total)
        phaseItems.push(total)
    }
    return total
}

function phaseWork(phase: u32, n: u32): number {
    if (phase === 2) return phaseItems.length
    if (phase === 3) return phaseItemAt(n)
    if (phase === 0) {
        resetPhaseItems()
        const passes = [(x: number) => x + 1, (x: number) => {
            phaseItems.push(x)
            return x * 2
        }]
        phaseOut = [runPhasePasses(passes, n)]
    }
    return phaseOut[0]
}

function bigIntQuotient(n: u32, d: u32): number {
    return Number(BigInt(n) / BigInt(d))
}

function bigIntCeiling(k: u32, c: u32, shifted: u32): number {
    let bound = BigInt(k)
    let steps = 0
    while (steps < 2) {
        const scale = shifted ? BigInt(2) ** BigInt(c) : BigInt(c)
        if (scale === BigInt(0)) break
        const below = bound / scale
        bound = below * scale === bound ? below : below + BigInt(1)
        steps++
    }
    return Number(bound)
}

function bigIntNumber(n: u32, d: u32): number {
    return Number(BigInt(n) / BigInt(d)) / 4
}

function bigIntGrowing(n: u32): number {
    let acc = BigInt(7)
    let scale = BigInt(1)
    let i = 0
    while (i < n) {
        acc = acc * BigInt(3)
        scale = scale * BigInt(2)
        i++
    }
    return Number(acc / scale)
}

function bigIntRatio(a: bigint, b: bigint): bigint {
    return a / b
}

function bigIntCall(n: u32, d: u32): number {
    return Number(bigIntRatio(BigInt(n), BigInt(d)))
}

function bigIntWhole(n: u32, d: u32): number {
    const k = n / 2
    if (!Number.isInteger(k)) return -1
    return Number(BigInt(k) / BigInt(d))
}

function bigIntMaybe(n: u32, d: u32): number {
    const m = new Map<number, number>()
    m.set(0, n)
    m.set(1, d)
    const a = BigInt(m.get(0))
    const b = BigInt(m.get(1))
    return Number(a / b)
}

interface PrefixFields {
    a: number
    b: number
}
const prefixSum = intrinsics.tagNoInline(function prefixSum(o: PrefixFields): number {
    return o.a * 5 + o.b
})
const prefixRead = intrinsics.tagNoInline(function prefixRead(o: PrefixFields): number {
    return prefixSum(o) * 3 + o.a
})
const prefixPair = intrinsics.tagNoInline(function prefixPair(n: u32): number {
    const o = { a: n, b: n + 1 }
    return prefixRead(o)
})
const prefixTriple = intrinsics.tagNoInline(function prefixTriple(n: u32): number {
    const o = { a: n + 2, b: n + 3, c: n + 4 }
    return prefixRead(o) * 7 + o.c
})
function prefixShapes(n: u32): number {
    return prefixPair(n) + prefixTriple(n)
}

const prefixBump = intrinsics.tagNoInline(function prefixBump(o: PrefixFields, n: u32): void {
    o.a = o.a * 3 + n
})
function prefixWrites(n: u32): number {
    const pair = { a: n, b: n + 1 }
    const triple = { a: n + 2, b: n + 3, c: n + 4 }
    prefixBump(pair, n)
    prefixBump(triple, n + 1)
    prefixBump(pair, 2)
    return pair.a * 7 + pair.b + triple.a * 5 + triple.b + triple.c
}

class SizedBox<T> {
    items: T[]
    count: number
    constructor() {
        this.items = []
        this.count = 0
    }
    add(item: T): void {
        this.items.push(item)
        this.count++
    }
    size(): number {
        return this.count * 2 + 1
    }
}
intrinsics.tagNoInline(SizedBox.prototype.size)
function sizedBoxes(n: u32): number {
    const numbers = new SizedBox<number>()
    const strings = new SizedBox<string>()
    for (let i: u32 = 0; i < n; i++) {
        numbers.add(i)
        if (i & 1) strings.add(`s${i}`)
    }
    return numbers.size() * 100 + strings.size() + numbers.items[0] + strings.items[0].length
}

class DepthPair {
    a: number
    b: number
    constructor(a: number, b: number) {
        this.a = a
        this.b = b
    }
    depth(n: u32): number {
        if (n === 0) return this.a
        return this.depth(n - 1) * 3 + this.b
    }
}
class DepthTriple extends DepthPair {
    c: number
    constructor(a: number, b: number, c: number) {
        super(a, b)
        this.c = c
    }
}
function prefixRecursive(n: u32): number {
    const pair = new DepthPair(n, n + 1)
    const triple = new DepthTriple(n + 2, n + 3, n + 4)
    return pair.depth(n & 7) + triple.depth(n & 3) * 7 + triple.c
}

class DepthSwapped {
    b: number
    a: number
    constructor(a: number, b: number) {
        this.b = b
        this.a = a
    }
    depth(n: u32): number {
        if (n === 0) return this.a
        return this.depth(n - 1) * 3 + this.b
    }
}
class DepthFloat {
    a: number
    b: number
    constructor(a: number, b: number) {
        this.a = a
        this.b = b
    }
    depth(n: u32): number {
        if (n === 0) return this.a
        return this.depth(n - 1) * 3 + this.b
    }
}
const prefixCopied = intrinsics.tagNoInline(function prefixCopied(o: { b: number }): number {
    return o.b * 2
})
class DepthSpread {
    a: number
    b: number
    constructor(a: number, b: number) {
        this.a = a
        this.b = b
    }
    depth(n: u32): number {
        if (n === 0) return prefixCopied({ ...this }) + this.a
        return this.depth(n - 1) * 3 + this.b
    }
}
class DepthSpreadTriple extends DepthSpread {
    c: number
    constructor(a: number, b: number, c: number) {
        super(a, b)
        this.c = c
    }
}
class DepthTested {
    a: number
    b: number
    constructor(a: number, b: number) {
        this.a = a
        this.b = b
    }
    depth(n: u32): number {
        if (n === 0) return this instanceof DepthTestedTriple ? this.c : this.a
        return this.depth(n - 1) * 3 + this.b
    }
}
class DepthTestedTriple extends DepthTested {
    c: number
    constructor(a: number, b: number, c: number) {
        super(a, b)
        this.c = c
    }
}
function prefixMismatched(n: u32): number {
    const pair = new DepthPair(n, n + 1)
    const swapped = new DepthSwapped(n + 2, n + 3)
    const float = new DepthFloat((n + 2) / 4, n + 3)
    const spread = new DepthSpread(n, n + 1)
    const spreadTriple = new DepthSpreadTriple(n + 2, n + 3, n + 4)
    const tested = new DepthTested(n, n + 1)
    const testedTriple = new DepthTestedTriple(n + 2, n + 3, n + 4)
    return pair.depth(n & 3) + swapped.depth(n & 7) * 3 + float.depth(n & 3) * 5 + spread.depth(n & 3) * 7 + spreadTriple.depth(n & 7) * 11 + tested.depth(n & 3) * 13 + testedTriple.depth(n & 7) * 17
}

const skippedSteps = new Set<string>()
function namedDouble(n: number): number {
    return n * 2
}
function namedTriple(n: number): number {
    return n * 3
}
function namedSquare(n: number): number {
    return n * n
}
const stepNamed = intrinsics.tagNoInline(function stepNamed(pass: (n: number) => number, cells: number[], i: u32): number {
    if (skippedSteps.has(pass.name)) return 0
    return cells[i] * 5 + cells[i + 1]
})
function namedSteps(n: u32): number {
    const cells = [n, n + 1, n + 2, n + 3]
    return stepNamed(namedDouble, cells, n & 1) + stepNamed(namedTriple, cells, n & 2) * 7 + stepNamed(namedSquare, cells, (n >> 2) & 1) * 11 + namedDouble(cells[3])
}

function unitsNamed(natives: any, root: string, name: string): number {
    return natives[root].units.filter((unit: any) => unit.name.split('#')[0] === name).length
}

export function suite() {
    harness.test('bigIntQuotient', () => {
        const natives: any = native.createNatives({ bigIntQuotient })
        for (const [n, d] of [[10, 3], [9007199254740991 % 4294967296, 256], [7, 7], [1, 2]]) {
            const expected = bigIntQuotient(n, d)
            const actual = Number(natives.bigIntQuotient(n, d))
            if (actual !== expected) harness.fail(`bigIntQuotient(${n}, ${d}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('bigIntCeiling', () => {
        const natives: any = native.createNatives({ bigIntCeiling })
        for (const [k, c, shifted] of [[65535, 3, 1], [100, 7, 0], [0, 5, 0], [7, 0, 0], [4294967295, 16, 1]]) {
            const expected = bigIntCeiling(k, c, shifted)
            const actual = Number(natives.bigIntCeiling(k, c, shifted))
            if (actual !== expected) harness.fail(`bigIntCeiling(${k}, ${c}, ${shifted}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('bigIntNumber', () => {
        const natives: any = native.createNatives({ bigIntNumber })
        for (const [n, d] of [[10, 3], [7, 7], [9, 2]]) {
            const expected = bigIntNumber(n, d)
            const actual = Number(natives.bigIntNumber(n, d))
            if (actual !== expected) harness.fail(`bigIntNumber(${n}, ${d}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('bigIntGrowing', () => {
        const natives: any = native.createNatives({ bigIntGrowing })
        for (const n of [0, 3, 5]) {
            const expected = bigIntGrowing(n)
            const actual = Number(natives.bigIntGrowing(n))
            if (actual !== expected) harness.fail(`bigIntGrowing(${n}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('bigIntCall', () => {
        const natives: any = native.createNatives({ bigIntCall })
        for (const [n, d] of [[10, 3], [1, 2], [7, 7]]) {
            const expected = bigIntCall(n, d)
            const actual = Number(natives.bigIntCall(n, d))
            if (actual !== expected) harness.fail(`bigIntCall(${n}, ${d}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('bigIntWhole', () => {
        const natives: any = native.createNatives({ bigIntWhole })
        for (const [k, d] of [[20, 3], [2, 2], [14, 7], [9, 2]]) {
            const expected = bigIntWhole(k, d)
            const actual = Number(natives.bigIntWhole(k, d))
            if (actual !== expected) harness.fail(`bigIntWhole(${k}, ${d}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('bigIntMaybe', () => {
        const natives: any = native.createNatives({ bigIntMaybe })
        for (const [n, d] of [[10, 3], [1, 2], [7, 7]]) {
            const expected = bigIntMaybe(n, d)
            const actual = Number(natives.bigIntMaybe(n, d))
            if (actual !== expected) harness.fail(`bigIntMaybe(${n}, ${d}) returned ${actual}, expected ${expected}`)
        }
    })
    harness.test('phaseItems', () => {
        const natives: any = native.createNatives({ phaseWork })
        const calls = [[0, 5], [2, 0], [3, 2], [0, 2], [2, 0], [3, 1]]
        for (const [phase, n] of calls) {
            const expected = phaseWork(phase, n)
            const actual = Number(natives.phaseWork(phase, n))
            if (actual !== expected) harness.fail(`phaseWork(${phase}, ${n}) returned ${actual}, expected ${expected}`)
        }
    })
    function presizeWords(n: u32): number {
        const row: u32[] = []
        for (let i: u32 = 0; i < (n & 15); i++) row.push(i * 3)
        const other = [0.5]
        for (let i = 0; i < (n & 3); i++) other.push(i + 0.25)
        let total = 0
        for (let i = 0; i < row.length; i++) total += row[i]
        for (let i = 0; i < other.length; i++) total += other[i]
        return total
    }
    harness.test('presizeLayouts', () => {
        const references = { presizeWords }
        const natives: any = native.createNatives(references)
        for (const [name, reference] of Object.entries(references)) {
            for (const n of [0, 1, 2, 3, 7, 9, 31]) {
                const expected = reference(n)
                const actual = Number(natives[name](n))
                if (actual !== expected) harness.fail(`${name}(${n}) returned ${actual}, expected ${expected}`)
            }
        }
    })
    harness.test('forwardFloatCopies', () => {
        const inputs = new Float64Array(2)
        const output = new BigUint64Array(2)
        const floats = new Float64Array(output.buffer)
        const bits = new BigUint64Array(inputs.buffer)
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        for (const op of ['convert', 'add', 'reverse', 'same', 'neg', 'compare', 'select', 'move', 'bits', 'inplace', 'store']) for (const hazard of ['', 'source', 'entry', 'live', 'bits-source']) {
            const asm = hostTarget.createAssembler()
            asm.load(32, 0, 0, Types.f64)
            asm.load(33, 0, 8, Types.f64)
            if (op === 'select') asm.compareImm('gt', 10, 2, 0, false)
            if (hazard === 'entry') { asm.mov(50, 33); asm.jumpIfZero(2, 0) }
            if (hazard === 'bits-source') { asm.load(9, 0, 0, Types.u64); asm.mov(50, 9) }
            else asm.mov(50, 32)
            if (hazard === 'source') asm.mov(32, 33)
            if (hazard === 'entry') asm.bindLabel(0)
            if (op === 'convert') asm.convert(9, 50, Types.f64, Types.i64)
            else if (op === 'compare') asm.floatCompare('eq', 9, 50, 33, [Types.f64, Types.f64])
            else if (op === 'bits') asm.mov(9, 50)
            else if (op === 'neg') asm.floatUnary('neg', 51, 50, Types.f64)
            else if (op === 'reverse') asm.floatBinary('sub', 51, 33, 50, [Types.f64, Types.f64])
            else if (op === 'select') { asm.select(51, 10, 50, 33); asm.released([{ value: 0, home: 10 }]) }
            else if (op === 'move') asm.mov(51, 50)
            else if (op === 'store') asm.store(1, 0, 50, Types.f64)
            else asm.floatBinary('add', op === 'inplace' ? 50 : 51, 50, op === 'same' ? 50 : 33, [Types.f64, Types.f64])
            if (hazard !== 'live') asm.released([{ value: 0, home: 50 }])
            if (op !== 'store') asm.store(1, 0, ['convert', 'compare', 'bits'].includes(op) ? 9 : op === 'inplace' ? 50 : 51, ['convert', 'compare', 'bits'].includes(op) ? Types.u64 : Types.f64)
            if (hazard === 'live') asm.store(1, 8, 50, Types.f64)
            asm.movImm(0, 0)
            asm.ret()
            const listing = asm.listing()
            const folded = !hazard && op !== 'store'
            if (folded === /fmov d18,/.test(listing)) harness.fail(`float forwarding ${op}/${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const value of [-99.75, -0, 0, 1.5, 2 ** 40 + 0.5, NaN]) for (const flag of [0, 1]) {
                inputs[0] = value
                inputs[1] = 3.25
                run(ptr(inputs), ptr(output), flag)
                const left = hazard === 'entry' && flag === 0 ? inputs[1] : value
                const expected = op === 'convert' ? BigInt.asUintN(64, Number.isNaN(left) ? BigInt(0) : BigInt(Math.trunc(left)))
                    : op === 'compare' ? BigInt(left === inputs[1] ? 1 : 0)
                    : op === 'bits' ? bits[hazard === 'entry' && flag === 0 ? 1 : 0]
                    : op === 'neg' ? -left : op === 'same' ? left + left
                    : op === 'reverse' ? inputs[1] - left : op === 'select' ? flag ? left : inputs[1]
                    : op === 'add' || op === 'inplace' ? left + inputs[1] : left
                const actual = typeof expected === 'bigint' ? output[0] : floats[0]
                if (!Object.is(actual, expected)) harness.fail(`float forwarding ${op}/${hazard}(${value},${flag}): ${actual}, expected ${expected}`)
                const retained = op === 'inplace' ? left + inputs[1] : left
                if (hazard === 'live' && !Object.is(floats[1], retained)) harness.fail(`float forwarding lost live ${op}(${value}): ${floats[1]}, expected ${retained}`)
            }
        }
        const asm = hostTarget.createAssembler()
        asm.load(32, 0, 0, Types.f64)
        asm.mov(9, 32)
        asm.addImm(10, 9, 1)
        asm.released([{ value: 0, home: 9 }])
        asm.store(1, 0, 10, Types.u64)
        asm.movImm(0, 0)
        asm.ret()
        if (!asm.listing().includes('fmov x9, d0')) harness.fail(`float forwarding crossed register banks:\n${asm.listing()}`)
        const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
        for (const value of [-0, 0, 1.5, NaN, -Infinity]) {
            inputs[0] = value
            run(ptr(inputs), ptr(output))
            const expected = BigInt.asUintN(64, bits[0] + BigInt(1))
            if (output[0] !== expected) harness.fail(`float bit transfer(${value}): ${output[0]}, expected ${expected}`)
        }
    }, 'aarch64')
    harness.test('narrowMaskedLoads', () => {
        const data = new Uint8Array([0xff, 0x80, 0xab, 0xcd, 0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0xde, 0xf0, 0x81, 0x23, 0x45, 0x67])
        const saved = new BigUint64Array(1)
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        for (const T of [Types.u32, Types.u64]) for (const mask of [0xff, 0xffff, 0xffffffff, 0xfffe]) for (const offset of [0, 1]) for (const shared of [false, true]) {
            const g = gn.createGraph({})
            const root = gn.addNode(g, gn.NodeOp.block, [])
            const input = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
            const out = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const load = gn.addNode(g, gn.NodeOp.load, [nil, input, { literal: offset }], T)
            const value = gn.addNode(g, gn.NodeOp.and, offset ? [{ literal: mask }, load] : [load, { literal: mask }], Types.u64)
            const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
            const store = gn.addNode(g, gn.NodeOp.store, [nil, out, { literal: 0 }, load], Types.u64)
            g.root = root
            gn.setGraphBlocks(g, [{ id: root, params: [input, out], bodyId: shared ? gn.addNode(g, gn.NodeOp.after, [store, ret]) : ret, bodyConst: 0 }])
            const optimized = optimizePackaged(packageValueGraph(g, hostTarget), hostTarget)
            const work = [optimized.blocks[0].bodyId]
            const seen = new Set<number>()
            while (work.length) {
                const id = work.pop()!
                const n = gn.getNode(optimized, id)
                if (!n || seen.has(id) || n.op === gn.NodeOp.block) continue
                seen.add(id)
                const want = shared || mask === 0xfffe ? T : mask === 0xff ? Types.u8 : mask === 0xffff ? Types.u16 : Types.u32
                if (n.op === gn.NodeOp.load && gn.typeOf(n) !== want) harness.fail(`masked load ${T}/${mask}/${offset}/${shared}:\n${dumpGraph(optimized)}`)
                for (let i = 0; i < gn.countIds(n); i++) work.push(gn.getRef(n, i))
            }
            const code = lowerValueGraph(optimized)
            const run = (ts as any).createNativeFn(new Uint8Array(code.bytes))
            let loaded = BigInt(0)
            for (let i = 0; i < (T === Types.u32 ? 4 : 8); i++) loaded |= BigInt(data[offset + i]) << BigInt(i * 8)
            const actual = BigInt(run(ptr(data), ptr(saved)))
            const expected = loaded & BigInt(mask)
            if (actual !== expected || (shared && saved[0] !== loaded)) harness.fail(`masked load ${T}/${mask}/${offset}/${shared}: ${actual}, expected ${expected}`)
        }
    }, 'aarch64')
    harness.test('recordRelayParam', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const x = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const y = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const join = gn.addNode(g, gn.NodeOp.block, [])
        const a = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const record = gn.insertNode(g, gn.createRecordType(g, [{ key: 0, type: Types.u64 }, { key: 1, type: Types.u64 }]))
        const fnType = gn.insertNode(g, gn.createFnType(g, { ref: record }))
        const pure = { effect: 0, writes: 0, fresh: false, tagged: false, captures: 0, deepCaptures: 0, reads: [], outcomes: undefined }
        const target = gn.addNode(g, gn.NodeOp.localTarget, encodeCallSummary(g, 1, pure), { ref: fnType })
        const nil = gn.addNode(g, gn.NodeOp.startOf, [])
        const call = gn.addNode(g, gn.NodeOp.call, [nil, target, { literal: 0 }, a])
        const first = gn.addNode(g, gn.NodeOp.get, [call, { literal: 0 }])
        const second = gn.addNode(g, gn.NodeOp.get, [call, { literal: 1 }])
        const tested = gn.addNode(g, gn.NodeOp.eq, [a, { literal: 0 }], Types.bool)
        const loop = gn.addNode(g, gn.NodeOp.block, [])
        const arms = gn.addNode(g, gn.NodeOp.select, [tested, gn.addNode(g, gn.NodeOp.ret, [first, root]), gn.addNode(g, gn.NodeOp.apply, [loop, second])])
        const i = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const step = gn.addNode(g, gn.NodeOp.add, [i, { literal: 3 }])
        const more = gn.addNode(g, gn.NodeOp.lt, [i, { literal: 100 }], Types.bool)
        const back = gn.addNode(g, gn.NodeOp.select, [more, gn.addNode(g, gn.NodeOp.apply, [loop, step]), gn.addNode(g, gn.NodeOp.apply, [join, i])])
        const less = gn.addNode(g, gn.NodeOp.lt, [x, y], Types.bool)
        const entry = gn.addNode(g, gn.NodeOp.select, [less, gn.addNode(g, gn.NodeOp.apply, [join, x]), gn.addNode(g, gn.NodeOp.apply, [loop, y])])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [x, y], bodyId: entry, bodyConst: 0 }, { id: loop, params: [i], bodyId: back, bodyConst: 0 }, { id: join, params: [a], bodyId: arms, bodyConst: 0 }])
        const optimized = optimizePackaged(packageValueGraph(g, hostTarget), hostTarget)
        optimized.form = undefined
        lowerValueGraph(optimizePackaged(packageValueGraph(optimized, hostTarget), hostTarget))
    })
    harness.test('subtractMaskedValue', () => {
        for (const T of [Types.u64, Types.i64]) for (const mask of [3, 5, 10, 255, 65535, 2 ** 48 - 1, 2 ** 52 - 2, -4, -13]) for (const mode of ['', 'shared', 'other', 'narrow']) {
            const g = gn.createGraph({})
            const root = gn.addNode(g, gn.NodeOp.block, [])
            const x = gn.addNode(g, gn.NodeOp.param, [], T)
            const y = gn.addNode(g, gn.NodeOp.param, [], T)
            const out = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
            const masked = gn.addNode(g, gn.NodeOp.and, mask === 5 ? [{ literal: mask }, x] : [x, { literal: mask }], mode === 'narrow' ? Types.u32 : T)
            const sub = gn.addNode(g, gn.NodeOp.sub, [mode === 'other' ? y : x, masked], T)
            const ret = gn.addNode(g, gn.NodeOp.ret, [sub, root])
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const store = gn.addNode(g, gn.NodeOp.store, [nil, out, { literal: 0 }, masked], T)
            g.root = root
            gn.setGraphBlocks(g, [{ id: root, params: [x, y, out], bodyId: mode === 'shared' ? gn.addNode(g, gn.NodeOp.after, [store, ret]) : ret, bodyConst: 0 }])
            const optimized = optimizePackaged(packageValueGraph(g, hostTarget), hostTarget)
            const work = [optimized.blocks[0].bodyId]
            const seen = new Set<number>()
            let subtracts = 0
            while (work.length) {
                const id = work.pop()!
                const n = gn.getNode(optimized, id)
                if (!n || seen.has(id) || n.op === gn.NodeOp.block) continue
                seen.add(id)
                if (n.op === gn.NodeOp.sub) subtracts++
                for (let i = 0; i < gn.countIds(n); i++) work.push(gn.getRef(n, i))
            }
            const folded = mode === '' || (mode === 'narrow' && mask >= 0 && mask < 2 ** 32)
            if (folded !== (subtracts === 0)) harness.fail(`masked subtraction ${mask}/${mode}:\n${dumpGraph(optimized)}`)
            const code = lowerValueGraph(optimized)
            const run = (ts as any).createNativeFn(new Uint8Array(code.bytes))
            const saved = new BigUint64Array(1)
            const ptr = Number((ts as any).getArrayBufferPtr(saved.buffer))
            for (const value of [-1099511627899, -255, -1, 0, 1, 255, 65535, 1099511627899]) {
                const bits = mode === 'narrow' ? BigInt.asUintN(32, BigInt(value) & BigInt(mask)) : BigInt(value) & BigInt(mask)
                const expected = BigInt.asIntN(64, (mode === 'other' ? BigInt(19) : BigInt(value)) - bits)
                const actual = BigInt(run(value, 19, ptr))
                if (actual !== expected || (mode === 'shared' && saved[0] !== BigInt.asUintN(64, bits))) harness.fail(`masked subtraction ${mask}/${mode}(${value}): ${actual}, expected ${expected}`)
            }
        }
    })
    harness.test('reuseFloatConversions', () => {
        const values = new Float64Array(2)
        const results = new BigUint64Array(3)
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        const expected = (value: number, T: intrinsics.Types) => {
            const bits = T === Types.i32 || T === Types.u32 ? 32 : 64
            const signed = T === Types.i32 || T === Types.i64
            const one = BigInt(1)
            const min = signed ? -(one << BigInt(bits - 1)) : BigInt(0)
            const max = (one << BigInt(bits - (signed ? 1 : 0))) - one
            const n = Number.isNaN(value) ? BigInt(0) : value === Infinity ? max : value === -Infinity ? min : BigInt(Math.trunc(value))
            return BigInt.asUintN(bits, n < min ? min : n > max ? max : n)
        }
        for (const T of [Types.i64, Types.u64, Types.i32, Types.u32]) for (const hazard of ['', 'source', 'destination', 'entry', 'type']) {
            const other = hazard === 'type' ? T === Types.i64 ? Types.u64 : Types.i64 : T
            const asm = hostTarget.createAssembler()
            asm.load(32, 0, 0, Types.f64)
            asm.mov(50, 32)
            asm.convert(9, 50, Types.f64, T)
            asm.store(1, 0, 9, Types.u64)
            if (hazard === 'source') asm.load(50, 0, 8, Types.f64)
            if (hazard === 'destination') asm.movImm(9, 99)
            if (hazard === 'entry') { asm.jumpIfZero(2, 0); asm.movImm(9, 99); asm.bindLabel(0) }
            asm.convert(9, 50, Types.f64, other)
            asm.store(1, 8, 9, Types.u64)
            asm.convert(10, 32, Types.f64, T)
            asm.store(1, 16, 10, Types.u64)
            asm.movImm(0, 0)
            asm.ret()
            const listing = asm.listing()
            const count = (listing.match(/\bfcvtz[su]\b/g) ?? []).length
            const required = !hazard ? 1 : hazard === 'source' || hazard === 'type' || hazard === 'entry' ? 3 : 2
            if (count !== required) harness.fail(`conversion reuse ${T}/${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const value of [-100000.75, -1.8, -0, 0, 1.9, 2 ** 31, 2 ** 32 + 123, 2 ** 40 + 0.5, NaN, Infinity, -Infinity]) for (const flag of [0, 1]) {
                values[0] = value
                values[1] = 123.75
                run(ptr(values), ptr(results), flag)
                const want = [expected(value, T), expected(hazard === 'source' ? values[1] : value, other), expected(value, T)]
                if (results.some((v, i) => v !== want[i])) harness.fail(`conversion reuse ${T}/${hazard}(${value}): ${[...results]}, expected ${want}`)
            }
        }
    }, 'aarch64')
    harness.test('reuseCompareFlags', () => {
        for (const hazard of ['', 'flags', 'operand', 'entry', 'copy']) {
            const asm = hostTarget.createAssembler()
            asm.mov(9, 0)
            if (hazard === 'entry') asm.jumpIfZero(1, 1)
            asm.compareImm('lt', 10, 0, 3, false)
            asm.jumpIfNonZero(10, 0)
            asm.released([{ value: 0, home: 10 }])
            if (hazard === 'flags') asm.compareImm('eq', -1, 1, 7, false)
            if (hazard === 'operand') asm.mov(0, 1)
            asm.bindLabel(1)
            asm.compareImm('eq', 11, hazard === 'copy' ? 9 : 0, 3, false)
            asm.mov(0, 11)
            asm.released([{ value: 0, home: 11 }])
            asm.ret()
            asm.bindLabel(0)
            asm.movImm(0, 17)
            asm.ret()
            const listing = asm.listing()
            const count = (listing.match(/cmp x(?:0|9), #3/g) ?? []).length
            if (count !== (!hazard || hazard === 'copy' ? 1 : 2)) harness.fail(`flag reuse ${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const x of [-1, 0, 1, 2, 3, 4, 1000000000]) for (const y of [0, 3, 7]) {
                const skipped = hazard === 'entry' && y === 0
                const expected = !skipped && BigInt.asUintN(64, BigInt(x)) < BigInt(3) ? 17 : (hazard === 'operand' && !skipped ? y : x) === 3 ? 1 : 0
                const actual = Number(run(x, y))
                if (actual !== expected) harness.fail(`flag reuse ${hazard}(${x},${y}): ${actual}, expected ${expected}`)
            }
        }
    }, 'aarch64')
    harness.test('pairPastIndependentAccesses', () => {
        type Access = [load: boolean, reg: number, base: number, offset: number, T: intrinsics.Types]
        const ld = (reg: number, base: number, offset: number, T = Types.u64): Access => [true, reg, base, offset, T]
        const st = (base: number, offset: number, reg: number, T = Types.u64): Access => [false, reg, base, offset, T]
        const cases: [name: string, pairs: number, alias: boolean, accesses: Access[]][] = [
            ['load', 1, false, [ld(9, 0, 0), ld(12, 1, 0), ld(11, 0, 8)]],
            ['loadPastStore', 1, false, [ld(9, 0, 0), ld(12, 1, 0), st(0, 32, 12), ld(11, 0, 8)]],
            ['loadOverlap', 0, false, [ld(9, 0, 0), ld(12, 1, 0), st(0, 8, 12), ld(11, 0, 8)]],
            ['loadOtherStore', 0, true, [ld(9, 0, 0), st(1, 0, 3), ld(11, 0, 8)]],
            ['loadReg', 0, false, [ld(9, 0, 0), ld(11, 1, 0), ld(11, 0, 8)]],
            ['signed', 0, false, [ld(9, 0, 0, Types.i32), ld(12, 1, 0), ld(11, 0, 4, Types.i32)]],
            ['store', 1, false, [st(0, 0, 3), st(0, 32, 4), st(0, 8, 4)]],
            ['storeLoad', 1, false, [st(0, 0, 3), ld(12, 0, 32), st(0, 8, 4)]],
            ['storeOverlap', 0, false, [st(0, 0, 3), ld(12, 0, 8), st(0, 8, 4)]],
            ['storeOtherBase', 0, true, [st(0, 0, 3), st(1, 0, 4), st(0, 8, 3)]],
            ['storeMoves', 1, false, [st(0, 0, 3), ld(4, 0, 32), st(0, 8, 4)]],
            ['storeDefines', 0, false, [st(0, 0, 3), ld(3, 0, 32), ld(4, 0, 48), st(0, 8, 4)]],
        ]
        for (const [name, pairs, alias, accesses] of cases) {
            const asm = hostTarget.createAssembler()
            asm.movImm(4, -5)
            asm.movImm(9, 0)
            asm.movImm(11, 0)
            asm.movImm(12, 0)
            for (const [load, reg, base, offset, T] of accesses) {
                if (load) asm.load(reg, base, offset, T)
                else asm.store(base, offset, reg, T)
            }
            asm.store(2, 0, 9, Types.u64)
            asm.store(2, 16, 11, Types.u64)
            asm.store(2, 32, 12, Types.u64)
            asm.movImm(0, 0)
            asm.ret()
            const listing = asm.listing()
            const found = (listing.match(/\b(?:ldp|stp) [xw](?:9|11|3|4), /g) ?? []).length
            if (found !== pairs) harness.fail(`pair past accesses ${name}: ${found} pairs, expected ${pairs}:\n${listing}`)
            const memory = new BigUint64Array(16)
            const out = new BigUint64Array(6)
            for (let i = 0; i < 16; i++) memory[i] = BigInt(i + 1) * BigInt('0x9100000180000003')
            const model = new DataView(memory.slice().buffer)
            const base = Number((ts as any).getArrayBufferPtr(memory.buffer))
            const other = alias ? 8 : 64
            const regs = new Map<number, bigint>([[0, BigInt(0)], [1, BigInt(other)], [3, BigInt(77)], [4, BigInt(-5)], [9, BigInt(0)], [11, BigInt(0)], [12, BigInt(0)]])
            for (const [load, reg, rn, offset, T] of accesses) {
                const at = Number(regs.get(rn)!) + offset
                if (load) regs.set(reg, T === Types.i32 ? BigInt(model.getInt32(at, true)) : model.getBigUint64(at, true))
                else model.setBigUint64(at, BigInt.asUintN(64, regs.get(reg)!), true)
            }
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            run(base, base + other, Number((ts as any).getArrayBufferPtr(out.buffer)), 77)
            const want = [9, 11, 12].map(r => BigInt.asUintN(64, regs.get(r)!))
            const got = [out[0], out[2], out[4]]
            for (let i = 0; i < 16; i++) if (memory[i] !== model.getBigUint64(i * 8, true)) harness.fail(`pair past accesses ${name}: memory[${i}] = ${memory[i]}, expected ${model.getBigUint64(i * 8, true)}:\n${listing}`)
            if (got.some((v, i) => v !== want[i])) harness.fail(`pair past accesses ${name}: ${got}, expected ${want}:\n${listing}`)
        }
    }, 'aarch64')
    harness.test('composeBooleanCompares', () => {
        const conditions: [string, (a: bigint, b: bigint) => boolean][] = [
            ['lt', (a, b) => a < b], ['ge', (a, b) => a >= b], ['eq', (a, b) => a === b], ['gt', (a, b) => a > b],
        ]
        for (const [op, check] of conditions) for (const outer of ['eq', 'ne']) for (const hazard of ['', 'flags', 'select', 'live']) {
            const asm = hostTarget.createAssembler()
            asm.compare(op, 9, 0, 1, true)
            if (hazard === 'flags') asm.compareImm('gt', 11, 2, 5, false)
            asm.compareImm(outer, 10, 9, 0, false)
            if (hazard === '' || hazard === 'flags') asm.released([{ value: 0, home: 9 }])
            if (hazard === 'select') {
                asm.select(12, 9, 0, 1)
                asm.released([{ value: 0, home: 9 }])
                asm.binary('add', 10, 10, 12, false)
            }
            if (hazard === 'flags') asm.binary('add', 10, 10, 11, false)
            if (hazard === 'live') asm.binary('add', 10, 10, 9, false)
            asm.mov(0, 10)
            asm.ret()
            const listing = asm.listing()
            const folded = hazard === '' || hazard === 'live'
            const sets = (listing.match(/\bcset\b/g) ?? []).length
            if (folded && (/\bcmp x9, #0/.test(listing) || sets !== (hazard === 'live' ? 2 : 1))) harness.fail(`compose ${op}/${outer}/${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const a of [-5, -1, 0, 1, 3, 2 ** 40]) for (const b of [-1, 0, 3]) for (const c of [0, 2, 9]) {
                const inner = check(BigInt(a), BigInt(b)) ? 1 : 0
                let expected = (outer === 'eq' ? inner === 0 : inner !== 0) ? 1 : 0
                if (hazard === 'flags') expected += c > 5 ? 1 : 0
                if (hazard === 'select') expected += inner ? a : b
                if (hazard === 'live') expected += inner
                const actual = Number(BigInt.asIntN(64, BigInt(run(a, b, c))))
                if (actual !== expected) harness.fail(`compose ${op}/${outer}/${hazard}(${a},${b},${c}): ${actual}, expected ${expected}:\n${listing}`)
            }
        }
        for (const op of ['lt', 'ge']) for (const use of ['value', 'branch', 'select', 'kept']) {
            const asm = hostTarget.createAssembler()
            asm.compareImm(op, 9, 0, 0, true)
            if (use === 'value') {
                asm.mov(0, 9)
                asm.released([{ value: 0, home: 9 }])
                asm.ret()
            } else if (use === 'select') {
                asm.select(10, 9, 1, 2)
                asm.released([{ value: 0, home: 9 }])
                asm.mov(0, 10)
                asm.ret()
            } else {
                asm.jumpIfNonZero(9, 0)
                if (use === 'branch') asm.released([{ value: 0, home: 9 }])
                asm.movImm(0, 7)
                if (use === 'kept') asm.binary('add', 0, 0, 9, false)
                asm.ret()
                asm.bindLabel(0)
                asm.movImm(0, 11)
                if (use === 'kept') asm.binary('add', 0, 0, 9, false)
                asm.ret()
            }
            const listing = asm.listing()
            const wanted = use === 'branch' ? /\btb(n)?z x0, #63/ : use !== 'select' && op === 'lt' ? /lsr x9, x0, #63/ : /cmp x0, #0/
            if (!wanted.test(listing) || (use === 'branch' && /\bcmp\b|\blsr\b/.test(listing))) harness.fail(`sign test ${op}/${use}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const a of [-(2 ** 40), -1, 0, 1, 2 ** 40]) {
                const truth = op === 'lt' ? a < 0 : a >= 0
                const expected = use === 'value' ? (truth ? 1 : 0) : use === 'select' ? (truth ? 3 : 4) : (truth ? 11 : 7) + (use === 'kept' ? (truth ? 1 : 0) : 0)
                const actual = Number(BigInt.asIntN(64, BigInt(run(a, 3, 4))))
                if (actual !== expected) harness.fail(`sign test ${op}/${use}(${a}): ${actual}, expected ${expected}:\n${listing}`)
            }
        }
    }, 'aarch64')
    harness.test('sharedSelectFlags', () => {
        const asm = hostTarget.createAssembler()
        asm.movF64(32, 11)
        asm.movF64(33, 22)
        asm.movImm(13, 31)
        asm.movImm(14, 47)
        asm.compareImm('gt', 9, 0, 5, false)
        asm.select(34, 9, 32, 33)
        asm.select(10, 9, 13, 14)
        asm.released([{ value: 0, home: 9 }])
        asm.store(1, 0, 34, Types.f64)
        asm.mov(0, 10)
        asm.ret()
        const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
        const out = new Float64Array(1)
        const ptr = Number((ts as any).getArrayBufferPtr(out.buffer))
        for (const n of [0, 3, 5, 6, 9]) {
            const actual = Number(run(n, ptr))
            if (actual !== (n > 5 ? 31 : 47) || out[0] !== (n > 5 ? 11 : 22)) harness.fail(`shared select flags(${n}): ${actual}, ${out[0]}\n${asm.listing()}`)
        }
    }, 'aarch64')
    harness.test('guardedSelectFlags', () => {
        const conditions: [string, (a: number, b: number) => boolean][] = [
            ['eq', (a, b) => a === b], ['ne', (a, b) => a !== b],
            ['lt', (a, b) => a < b], ['ge', (a, b) => a >= b],
            ['le', (a, b) => a <= b], ['gt', (a, b) => a > b],
        ]
        for (const [op, check] of conditions) for (const imm of [-31, 0, 17, 31, 32]) for (const mode of ['imm64', 'imm32', 'reg']) for (const hazard of ['', 'flags', 'value', 'entry']) {
            const asm = hostTarget.createAssembler()
            asm.movImm(9, 7)
            asm.movImm(13, 8)
            if (mode === 'reg') asm.movImm(14, imm)
            if (hazard === 'entry') asm.jumpIfZero(3, 1)
            asm.compare('eq', 10, 0, 1, false)
            asm.jumpIfZero(10, 0)
            asm.released([{ value: 0, home: 10 }])
            asm.bindLabel(1)
            if (mode === 'reg') asm.compare(op, 11, 2, 14, true)
            else asm.compareImm(op, 11, 2, imm, true, undefined, mode === 'imm32')
            asm.select(9, 11, 3, hazard === 'value' ? 13 : 9)
            asm.released([{ value: 0, home: 11 }])
            asm.bindLabel(0)
            if (hazard === 'flags') {
                asm.compareImm('eq', 12, 0, 1, false, ['lt', false])
                asm.binaryImm('shl', 12, 12, 8, false)
                asm.binary('add', 9, 9, 12, false)
            } else asm.compareImm('eq', -1, 1, 0, false)
            asm.mov(0, 9)
            asm.ret()
            const listing = asm.listing()
            const folded = !hazard && (mode === 'reg' || imm <= 31)
            if (folded === /\bb\.ne\b/.test(listing)) harness.fail(`guarded ${op} ${imm} ${mode} ${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const a of [0, 1, 2]) for (const b of [0, 1, 2]) for (const c of [-32, -31, 0, 1, 17, 31, 32]) for (const value of [0, 19]) {
                const entered = a === b || (hazard === 'entry' && value === 0)
                let expected = entered ? check(c, imm) ? value : hazard === 'value' ? 8 : 7 : 7
                if (hazard === 'flags') {
                    const bits = mode === 'imm32' ? 32 : 64
                    const carry = a === b ? BigInt.asUintN(bits, BigInt(c)) >= BigInt.asUintN(bits, BigInt(imm)) : a >= b
                    if (!carry && a === 1) expected += 256
                }
                const actual = Number(run(a, b, c, value))
                if (actual !== expected) harness.fail(`guarded ${op} ${imm} ${mode} ${hazard} (${a},${b},${c},${value}): ${actual}, expected ${expected}`)
            }
        }
    }, 'aarch64')
    function staticBlockMethod(n: u32): number {
        const tally: any = new Tally(n)
        return tally.bump(2) * 10 + tally.bump(1)
    }
    function staticBlockFriend(n: u32): number {
        const tally = new Tally(n)
        return peekTally(tally) * 10 + peekTally(new Tally(n + 3))
    }
    function staticBlockIndexTrap(n: u32): number {
        const tally: any = new Tally(n)
        tally[1] = n + 5
        tally[2] = 7
        return tally[0] + tally[1] * 100 + tally[2] * 10000 + tally.bump(0) * 1000000 + (tally[3] === undefined ? 1 : 0)
    }
    function exportedLetFriend(n: u32): number {
        return tallyCount(new Tally(n)) + 1
    }
    function letFunctionFriend(n: u32): number {
        return plainFriend(n) + 1
    }
    function constructorLetFriend(n: u32): number {
        return new TallyView(new Tally(n)).count + 1
    }
    function andZeroEffects(n: u32): u32 {
        const cell = { value: n }
        function step(x: u32): u32 {
            cell.value++
            return x
        }
        const a = step(n) & 0
        const b = 0 & step(n + 2)
        return a + b + cell.value
    }
    function unusedFieldEffects(n: u32): u32 {
        let calls: u32 = 0
        function effect(): number[] {
            calls++
            return [n, n + 1]
        }
        const object = { unused: effect(), value: n }
        return object.value + calls * 100
    }
    function unusedFieldIdentity(n: u32): u32 {
        const a = { hidden: n, spare: n + 1 }
        const b = { hidden: n + 2, spare: n + 3 }
        const selected = n & 1 ? a : b
        return (selected === a ? 1 : 2) + (a === b ? 10 : 20)
    }
    function unusedFieldKeys(n: u32): u32 {
        const object = { a: n, b: n + 1, c: n + 2 }
        return Object.keys(object).length * 100 + object.a
    }
    function voidEffects(n: u32): u32 {
        let counter: u32 = n
        function bump(): undefined {
            return void counter++
        }
        const a = bump()
        const b = void bump()
        return (a === undefined ? 1 : 0) + (b === undefined ? 2 : 0) + counter * 10
    }
    function fill(p: u32, n: u32): void {
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i * 3 + 1, Types.u32)
    }
    function poke(p: u32, n: u32): u32 {
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 4, Types.u32)
        return total
    }

    function warLoadThenStore(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const old = Intrinsics.load(p, 4, Types.u32)
        Intrinsics.store(p, 4, 999, Types.u32)
        return old
    }
    function warAcrossCall(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const old = Intrinsics.load(p, 4, Types.u32)
        const seen = poke(p, n)
        Intrinsics.store(p, 4, 999, Types.u32)
        return old * 1000 + (seen & 255)
    }
    function warSwap(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const j = n - 1
        const a = Intrinsics.load(p, 4, Types.u32)
        const b = Intrinsics.load(p, j * 4, Types.u32)
        Intrinsics.store(p, 4, b, Types.u32)
        Intrinsics.store(p, j * 4, a, Types.u32)
        return Intrinsics.load(p, 4, Types.u32) * 1000 + Intrinsics.load(p, j * 4, Types.u32)
    }
    function warSwapRemove(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const last = Intrinsics.load(p, (n - 1) * 4, Types.u32)
        const removed = Intrinsics.load(p, 4, Types.u32)
        Intrinsics.store(p, 4, last, Types.u32)
        Intrinsics.store(p, (n - 1) * 4, 0, Types.u32)
        return removed * 1000 + Intrinsics.load(p, 4, Types.u32)
    }

    function headerStoreLoop(n: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        let count: u32 = 0
        for (;;) {
            Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 1, Types.u32)
            if (Intrinsics.load(p, 0, Types.u32) > n) break
            count++
        }
        return count * 100 + Intrinsics.load(p, 0, Types.u32)
    }
    function bump(p: u32): u32 {
        const next = Intrinsics.load(p, 0, Types.u32) + 1
        Intrinsics.store(p, 0, next, Types.u32)
        return next
    }
    function headerCallLoop(n: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        let count: u32 = 0
        while (bump(p) <= n) count++
        return count * 100 + Intrinsics.load(p, 0, Types.u32)
    }
    function headerCallLoopLive(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, 0, Types.u32)
        Intrinsics.store(p, 4, 7, Types.u32)
        const q = allocate(4)
        Intrinsics.store(q, 0, 0, Types.u32)
        let count: u32 = 0
        while (bump(p) <= n) {
            Intrinsics.store(q, 0, Intrinsics.load(q, 0, Types.u32) + Intrinsics.load(p, 4, Types.u32), Types.u32)
            count++
        }
        return count * 10000 + Intrinsics.load(q, 0, Types.u32) * 10 + Intrinsics.load(p, 4, Types.u32)
    }

    function arrayBuild(n: u32): number {
        const row: number[] = []
        for (let i = 0; i < (n & 31); i++) row.push(i + 3)
        let total = row.length * 100
        for (let i = 0; i < row.length; i++) total += row[i]
        return total
    }
    function arrayBuildWithClosure(n: u32): number {
        const row: number[] = []
        for (let i = 0; i < (n & 31); i++) row.push(i + 3)
        const weight = new Map<number, number>()
        for (let i = 0; i < row.length; i++) weight.set(row[i], (row[i] * 7) & 15)
        function infoOf(key: number) {
            return { key, weight: weight.get(key)! }
        }
        const infos = new Map<number, { key: number, weight: number }>()
        for (let i = 0; i < row.length; i++) infos.set(row[i], infoOf(row[i]))
        let total = row.length * 100
        for (const info of infos.values()) total += info.weight
        for (let round = 0; round < 2; round++) {
            const bias = round * 64
            const keys: number[] = []
            for (const key of weight.keys()) keys.push(key)
            keys.sort((a, b) => (weight.get(a)! - weight.get(b)!) * bias + a - b)
            if (keys.length) total += keys[0]
        }
        return total
    }
    function arrayBuildWithClosureRoot(n: u32): number {
        return arrayBuildWithClosure(n) + arrayBuildWithClosure(n + 1)
    }
    function arrayFixedPushes(n: u32): number {
        const row = [n]
        row.push(n + 1)
        const length = row.push(n + 2, n + 3)
        let total = length * 1000 + row.length * 100
        for (let i = 0; i < row.length; i++) total += row[i]
        return total
    }
    function arrayMultiplePushCalls(n: u32): number {
        const row = [4]
        for (let i = 0; i < (n & 31); i++) {
            row.push(i)
            row.push(i + 10)
        }
        row.push(7)
        row.push(8)
        let total = row.length * 100
        for (let i = 0; i < row.length; i++) total += row[i]
        return total
    }
    function arrayPushPairs(n: u32): number {
        const row = [10, 20]
        for (let i = 1; i < (n & 31); i++) row.push(i, i + 100)
        row.push(30, 40)
        let total = row.length * 1000
        for (let i = 0; i < row.length; i++) total += row[i] * (i + 1)
        return total
    }
    function arrayPushResult(n: u32): number {
        const row: number[] = []
        let total = 0
        for (let i = 0; i < (n & 31); i++) total += row.push(i, i + 1)
        return total * 100 + row.length
    }
    function arrayPushOffset(n: u32): number {
        const row = [4]
        for (let i = 3; i < (n & 31); i++) row.push(i)
        let total = row.length * 100
        for (let i = 0; i < row.length; i++) total += row[i]
        return total
    }
    function arrayThresholdRows(choices: Map<number, number[]>): number {
        const source = 0
        const sink = 1
        let vertices = 2
        const thresholds = new Map<number, number[]>()
        for (const [id, chain] of choices) {
            const row = [source]
            for (let i = 1; i < chain.length; i++) row.push(vertices++)
            row.push(sink)
            thresholds.set(id, row)
        }
        let total = vertices * 1000
        for (const [id, row] of thresholds) {
            total += id * row.length * 100
            for (let i = 0; i < row.length; i++) total += row[i] * (i + 1)
        }
        return total
    }
    ;(arrayThresholdRows as any).shouldNotInline = true
    function arrayThresholds(n: u32): number {
        const choices = new Map<number, number[]>()
        choices.set(0, [])
        choices.set(1, [n])
        choices.set(2, [n, n + 1, n + 2])
        return arrayThresholdRows(choices)
    }
    function arrayLengthObserved(n: u32): number {
        const row = [3]
        for (let i = 0; i < (n & 31); i++) row.push(row.length)
        let total = row.length * 100
        for (let i = 0; i < row.length; i++) total += row[i]
        return total
    }
    function arrayObserveLength(row: number[]): number {
        return row.length
    }
    ;(arrayObserveLength as any).shouldNotInline = true
    function arrayEarlyEscape(n: u32): number {
        const row = [3]
        const seen = arrayObserveLength(row)
        for (let i = 0; i < (n & 31); i++) row.push(i)
        return seen * 100 + row.length
    }
    function arrayPartialInitialization(n: u32): number {
        const row = [3]
        for (let i = 0; i < (n & 31); i++) {
            if (i === 3) break
            row.push(i)
        }
        return row.length
    }
    function arrayConditionalPush(n: u32): number {
        const row = [3]
        for (let i = 0; i < (n & 31); i++) if (i !== 3) row.push(i)
        return row.length
    }
    function arrayConditionalTail(n: u32): number {
        const row = [3]
        for (let i = 0; i < (n & 31); i++) row.push(i)
        if (n & 1) row.push(7)
        return row.length
    }
    function arrayLengthBeforeTail(n: u32): number {
        const row = [3]
        for (let i = 0; i < (n & 31); i++) row.push(i)
        const seen = row.length
        row.push(7)
        return seen * 100 + row.length
    }
    function arrayTwoPushLoops(n: u32): number {
        const row = [3]
        for (let i = 0; i < (n & 31); i++) row.push(i)
        for (let i = 0; i < (n & 31); i++) row.push(i + 10)
        return row.length
    }
    function arraySpreadPush(n: u32): number {
        const row = [3]
        const values = n & 1 ? [10, 20] : [30]
        for (let i = 0; i < (n & 7); i++) row.push(...values)
        return row.length * 100 + row[row.length - 1]
    }
    function arrayHeaderPush(n: u32): number {
        const row = [3]
        for (let i = 0; (row.push(i), i < (n & 31)); i++) row.push(i + 100)
        return row.length
    }
    function arrayMutatedBound(chain: number[]): number {
        const row = [3]
        for (let i = 1; i < chain.length; i++) {
            row.push(i)
            chain.pop()
        }
        row.push(7)
        return row.length * 100 + chain.length
    }
    ;(arrayMutatedBound as any).shouldNotInline = true
    function arrayPushedBound(chain: number[], n: u32): number {
        const other: number[] = [1]
        const target = (n & 1) ? chain : other
        const row = [3]
        target.push(5, 6)
        for (let i = 1; i < chain.length; i++) row.push(i)
        row.push(7)
        return row.length * 100 + chain.length * 10 + other.length
    }
    ;(arrayPushedBound as any).shouldNotInline = true
    function arrayGrowingBound(n: u32): number {
        const chain: number[] = []
        for (let i = 0; i < (n & 31); i++) chain.push(i)
        return arrayPushedBound(chain, n)
    }
    function arrayChangingBound(n: u32): number {
        const chain: number[] = []
        for (let i = 0; i < (n & 31); i++) chain.push(i)
        return arrayMutatedBound(chain)
    }
    class ArrayCountBox {
        calls = 0
        constructor(public value: number) {}
        get count(): number {
            this.calls++
            return this.value
        }
    }
    function arrayPrecomputedGetter(n: u32): number {
        const box = new ArrayCountBox(n & 31)
        const count = box.count
        const row = [3]
        for (let i = 0; i < count; i++) row.push(i)
        return box.calls * 1000 + row.length
    }
    function arrayFutureRead(n: u32): number {
