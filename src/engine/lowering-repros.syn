/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import { allocate } from './builtins'
import * as gn from './graph-node'
import * as native from './native'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

export function suite() {
    function fill(p: u32, n: u32): void {
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i * 3 + 1, Types.u32)
    }
    function poke(p: u32, n: u32): u32 {
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 4, Types.u32)
        return total
    }

    function warLoadThenStore(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const old = Intrinsics.load(p, 4, Types.u32)
        Intrinsics.store(p, 4, 999, Types.u32)
        return old
    }
    function warAcrossCall(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const old = Intrinsics.load(p, 4, Types.u32)
        const seen = poke(p, n)
        Intrinsics.store(p, 4, 999, Types.u32)
        return old * 1000 + (seen & 255)
    }
    function warSwap(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const j = n - 1
        const a = Intrinsics.load(p, 4, Types.u32)
        const b = Intrinsics.load(p, j * 4, Types.u32)
        Intrinsics.store(p, 4, b, Types.u32)
        Intrinsics.store(p, j * 4, a, Types.u32)
        return Intrinsics.load(p, 4, Types.u32) * 1000 + Intrinsics.load(p, j * 4, Types.u32)
    }
    function warSwapRemove(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const last = Intrinsics.load(p, (n - 1) * 4, Types.u32)
        const removed = Intrinsics.load(p, 4, Types.u32)
        Intrinsics.store(p, 4, last, Types.u32)
        Intrinsics.store(p, (n - 1) * 4, 0, Types.u32)
        return removed * 1000 + Intrinsics.load(p, 4, Types.u32)
    }

    function headerStoreLoop(n: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        let count: u32 = 0
        for (;;) {
            Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 1, Types.u32)
            if (Intrinsics.load(p, 0, Types.u32) > n) break
            count++
        }
        return count * 100 + Intrinsics.load(p, 0, Types.u32)
    }
    function bump(p: u32): u32 {
        const next = Intrinsics.load(p, 0, Types.u32) + 1
        Intrinsics.store(p, 0, next, Types.u32)
        return next
    }
    function headerCallLoop(n: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        let count: u32 = 0
        while (bump(p) <= n) count++
        return count * 100 + Intrinsics.load(p, 0, Types.u32)
    }
    function headerCallLoopLive(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, 0, Types.u32)
        Intrinsics.store(p, 4, 7, Types.u32)
        const q = allocate(4)
        Intrinsics.store(q, 0, 0, Types.u32)
        let count: u32 = 0
        while (bump(p) <= n) {
            Intrinsics.store(q, 0, Intrinsics.load(q, 0, Types.u32) + Intrinsics.load(p, 4, Types.u32), Types.u32)
            count++
        }
        return count * 10000 + Intrinsics.load(q, 0, Types.u32) * 10 + Intrinsics.load(p, 4, Types.u32)
    }

    function sharedRetNested(a: u32): u32 {
        if (a > 5) {
            if (a > 8) return 1
            return 0
        }
        return 1
    }
    function sharedRetDeep(a: u32, b: u32): u32 {
        if (a > 5) {
            if (b > 5) return 1
            if (b > 2) return 2
            return 1
        }
        if (b > 7) return 2
        return 1
    }

    function selectOrTail(a: u32, b: u32): u32 {
        const v = a > 4 ? a - 4 : 0
        return v || b + 1
    }
    function selectAndTail(a: u32, b: u32): u32 {
        const v = a > 4 ? a - 4 : 0
        return v && b + 1
    }

    function crossBlockField(n: u32): u32 {
        const o = { a: n * 3, b: n + 1 }
        let t: u32 = 0
        for (let i: u32 = 0; i < n; i++) t = t + i
        if (t > 2) return o.a + t
        return o.b
    }
    function crossBlockFieldLoop(n: u32): u32 {
        const o = { a: n * 3, b: n + 1 }
        let t: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            if (i & 1) t = t + o.a
            else t = t + o.b
        }
        return t
    }

    function powTwo(n: u32): u32 {
        return 2 ** n
    }
    function powThree(n: u32): u32 {
        return 3 ** n
    }
    function powBoth(n: u32, b: u32): u32 {
        return b ** n
    }

    function literal2p53(k: u32): u32 {
        const m = k > 3 ? 9007199254740992 : 1
        return m > 5 ? 7 : 3
    }
    function literal2p63(k: u32): u32 {
        const m = k > 3 ? 9223372036854775808 : 1
        return m > 5 ? 7 : 3
    }

    function diamondEffects(k: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        if (k & 1) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 1, Types.u32)
        if (k & 2) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 2, Types.u32)
        if (k & 4) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 3, Types.u32)
        if (k & 8) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 4, Types.u32)
        if (k & 16) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 5, Types.u32)
        if (k & 32) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 6, Types.u32)
        if (k & 64) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 7, Types.u32)
        if (k & 128) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 8, Types.u32)
        if (k & 256) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 9, Types.u32)
        if (k & 512) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 10, Types.u32)
        if (k & 1024) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 11, Types.u32)
        if (k & 2048) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 12, Types.u32)
        if (k & 4096) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 13, Types.u32)
        if (k & 8192) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 14, Types.u32)
        if (k & 16384) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 15, Types.u32)
        if (k & 32768) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 16, Types.u32)
        if (k & 65536) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 17, Types.u32)
        if (k & 131072) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 18, Types.u32)
        if (k & 262144) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 19, Types.u32)
        if (k & 524288) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 20, Types.u32)
        if (k & 1048576) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 21, Types.u32)
        if (k & 2097152) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 22, Types.u32)
        if (k & 4194304) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 23, Types.u32)
        if (k & 8388608) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 24, Types.u32)
        return Intrinsics.load(p, 0, Types.u32)
    }

    function chase(p: u32): u32 {
        const q = Intrinsics.load(p, 0, Types.u64)
        const r = Intrinsics.load(q, 0, Types.u64)
        return Intrinsics.load(r, 0, Types.u32) + Intrinsics.load(p, 8, Types.u32)
    }
    ;(chase as any).shouldNotInline = true
    function bumpChain(n: u32): u32 {
        const a = allocate(16)
        Intrinsics.store(a, 0, n, Types.u32)
        Intrinsics.store(a, 8, n + 1, Types.u32)
        const b = allocate(16)
        Intrinsics.store(b, 0, a, Types.u64)
        Intrinsics.store(b, 8, n + 2, Types.u32)
        const c = allocate(16)
        Intrinsics.store(c, 0, b, Types.u64)
        Intrinsics.store(c, 8, n + 3, Types.u32)
        const d = allocate(n * 8)
        Intrinsics.store(d, 0, c, Types.u64)
        fill(d + 8, n - 1)
        return poke(d + 8, n - 1) + chase(Intrinsics.load(d, 0, Types.u64))
    }

    class PeekBox {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            return this.n + v
        }
    }
    class PushBox {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            this.n = this.n * 10 + v
            return v
        }
    }
    ;(PeekBox.prototype.bump as any).shouldNotInline = true
    ;(PushBox.prototype.bump as any).shouldNotInline = true
    function unionMethodCall(k: u32): number {
        const o = k > 3 ? new PeekBox(k) : new PushBox(k)
        o.bump(k)
        return o.n
    }
    class PeekCell {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            return peekCell(this, v)
        }
    }
    class PushCell {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            return pushCell(this, v)
        }
    }
    function peekCell(o: PeekCell, v: number): number {
        return o.n + v
    }
    ;(peekCell as any).shouldNotInline = true
    function pushCell(o: PushCell, v: number): number {
        o.n = o.n * 10 + v
        return v
    }
    ;(pushCell as any).shouldNotInline = true
    function unionMethodInlined(k: u32): number {
        const o = k > 3 ? new PeekCell(k) : new PushCell(k)
        o.bump(k)
        return o.n
    }

    function addCopySlice(n: u32): number {
        const g = gn.createGraph()
        const p = gn.addNode(g, gn.NodeOp.param, [], Types.u32)
        const a = gn.addNode(g, gn.NodeOp.add, [p, { literal: n }], Types.u32)
        const c = gn.addCopy(g, gn.getNode(g, a)!)
        return c * 100 + gn.countIds(gn.getNode(g, c)!) + g.nodes.size * 1000
    }

    interface ParamBlock {
        params: number[]
        body: number
    }
    function emptyIndexOf(n: u32): number {
        const blocks: ParamBlock[] = [{ params: [n, n + 1], body: n + 1 }, { params: [], body: n }]
        let found = 0
        for (const b of blocks) {
            const at = b.params.indexOf(b.body)
            if (at >= 0) found = found + at + 1
        }
        return found
    }

    function nullableSetKeys(n: u32): number {
        const ints = new Int32Array(n)
        const floats = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) {
            ints[i] = i * 3 as i32
            floats[i] = i * 0.5
        }
        const halves: number[] = []
        const seen = new Set<number>()
        for (let i: u32 = 0; i < n; i++) {
            halves.push(floats[i])
            seen.add(ints[i])
        }
        return seen.size * 10 + halves[n - 1]
    }

    function joinedArrayKeys(n: u32): number {
        const ints: number[] = []
        const floats: number[] = []
        for (let i: u32 = 0; i < n; i++) {
            ints.push(i * 3)
            floats.push(i * 0.5)
        }
        const pick = n > 3 ? ints : floats
        const seen = new Set<number>()
        for (let i: u32 = 0; i < n; i++) seen.add(ints[i])
        return seen.size * 10 + pick[n - 1]
    }

    function floatLiteralMap(n: u32): number {
        const scale = new Float64Array(2)
        scale[1] = n
        const out = [1.5, 2].map(x => scale[1] * x)
        return out[1] * 10 + out[0]
    }

    interface WordBox {
        k: number
    }
    function pickWord(n: u32, box: WordBox): any {
        return n > 100 ? box : n + 1
    }
    ;(pickWord as any).shouldNotInline = true
    function unionWordStore(n: u32): number {
        const box: WordBox = { k: n }
        const v = pickWord(n, box)
        const p = allocate(8)
        Intrinsics.store(p, 0, v, Types.u32)
        return Intrinsics.load(p, 0, Types.u32) + box.k
    }

    function joinedQueue(n: u32): number {
        const targets = new Int32Array(n)
        const weights = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) {
            targets[i] = (i + 1) % n as i32
            weights[i] = i * 0.5
        }
        const queue = [0]
        const seen: number[] = []
        for (let i = 0; i < queue.length && i < n; i++) {
            const from = queue[i]
            queue.push(targets[from])
            seen.push(weights[from])
        }
        const pick = n > 3 ? queue : seen
        return queue[n - 1] * 100 + seen[n - 1] + pick.length
    }

    function nullableQueue(n: u32): number {
        const targets = new Int32Array(n)
        const weights = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) {
            targets[i] = (i + 1) % n as i32
            weights[i] = i * 0.5
        }
        const queue = [0]
        const seen: number[] = []
        for (let i = 0; i < queue.length && i < n; i++) {
            const from = queue[i]
            queue.push(targets[from])
            seen.push(weights[from])
        }
        return queue[n - 1] * 100 + seen[n - 1]
    }

    interface Held {
        v: number
    }
    function zeroObjectUndefined(k: u32): number {
        const items: (number | Held | undefined)[] = [0, { v: 3 }, undefined]
        const x = items[k]
        if (x === undefined) return 1
        if (typeof x === 'number') return 10 + x
        return 100 + x.v
    }
    function typeofUnionUndefined(k: u32): number {
        const items: (number | Held | undefined)[] = [0, { v: 3 }, undefined]
        const kind = typeof items[k]
        if (kind === 'undefined') return 1
        if (kind === 'number') return 2
        return 3
    }
    function truthyUnionWord(k: u32): number {
        const items: (number | Held | undefined)[] = [0, { v: 3 }, undefined, 5]
        return items[k] ? 1 : 2
    }
    function nullishVsZero(k: u32): number {
        const x = k > 1 ? undefined : k
        return (x === undefined ? 1 : 0) + (x === 0 ? 2 : 0) + (x ?? 7) * 10
    }
    function emptyStringFalsy(k: u32): number {
        const s = k > 1 ? '' : k > 0 ? 'a' : 'bc'
        return (s ? 1 : 2) + (s === '' ? 10 : 0) + s.length * 100
    }

    function maybeCell(n: u32): u32 {
        if (n < 4) return 0
        const p = allocate(8)
        Intrinsics.store(p, 0, n, Types.u32)
        Intrinsics.store(p, 4, n + 1, Types.u32)
        return p
    }
    ;(maybeCell as any).shouldNotInline = true
    function maybeBox(n: u32): { v: number, w: number } | undefined {
        if (n < 4) return undefined
        return { v: n, w: n + 1 }
    }
    ;(maybeBox as any).shouldNotInline = true
    function specNullableField(n: u32): number {
        const box = maybeBox(n)
        let total = 0
        for (let i: u32 = 0; i < n; i++) {
            if (box) total = total + box.w
            else total = total + i
        }
        return total
    }
    function specValueSelect(n: u32): u32 {
        const p = maybeCell(n)
        const v = p !== 0 ? Intrinsics.load(p, 0, Types.u32) : 7
        return v * 3 + n
    }
    function specGuardedLoop(n: u32): u32 {
        const p = maybeCell(n)
        const k = p !== 0 ? n : 0
        let total: u32 = 0
        for (let i: u32 = 0; i < k; i++) total = total + Intrinsics.load(p, 0, Types.u32)
        return total + n
    }
    function specArmInLoop(n: u32): u32 {
        const p = maybeCell(n)
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            if (p !== 0) total = total + Intrinsics.load(p, 4, Types.u32)
            else total = total + i
        }
        return total
    }
    function specSharedArms(n: u32, m: u32): u32 {
        const p = maybeCell(n)
        let total: u32 = 0
        for (let i: u32 = 0; i < m; i++) {
            if (p === 0) total = total + (i > 100 ? Intrinsics.load(p, 0, Types.u32) : i)
            else total = total + Intrinsics.load(p, 0, Types.u32) * 2
        }
        return total
    }
    function specConjunction(n: u32): u32 {
        const p = maybeCell(n)
        let found: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            if (p !== 0 && Intrinsics.load(p, 0, Types.u32) > i) found++
        }
        return found
    }
    function specStoredSelect(n: u32): u32 {
        const p = maybeCell(n)
        const q = allocate(8)
        Intrinsics.store(q, 0, p !== 0 ? Intrinsics.load(p, 4, Types.u32) : 9, Types.u32)
        Intrinsics.store(q, 4, n, Types.u32)
        return Intrinsics.load(q, 0, Types.u32) + Intrinsics.load(q, 4, Types.u32)
    }
    function specMixedSelect(n: u32, k: u32): u32 {
        const p = maybeCell(n)
        const v = p !== 0 ? Intrinsics.load(p, 0, Types.u32) : k
        return (v + k) * (v ^ n)
    }

    function specArrival(n: u32, m: u32): u32 {
        const p = maybeCell(n)
        const len: u32 = p !== 0 ? 2 : 0
        let t: u32 = 0
        for (let i: u32 = 0; i < m; i++) {
            const v = i < len ? Intrinsics.load(p, i * 4, Types.u32) : 0
            if (v > 1) t = t + v
            if (i < len) t = t + Intrinsics.load(p, i * 4, Types.u32) * 3
            t = t + 1
        }
        return t
    }

    function compareChains(a: u32, b: u32): u32 {
        const both: u32 = a > 2 && b < 7 ? 10 : 20
        const either: u32 = a === 3 || b > 40 ? 100 : 200
        let three: u32 = 0
        if (a < 9 && b !== 5 && a !== b) three = 1000
        return both + either + three
    }

    interface Slot {
        v: number | undefined
    }
    function takeSlot(s: Slot, n: u32): number {
        const old = s.v
        s.v = n
        return old ?? 7
    }
    ;(takeSlot as any).shouldNotInline = true
    function taggedFieldSwap(n: u32): number {
        const s: Slot = { v: n > 3 ? n : undefined }
        const a = takeSlot(s, n + 1)
        return a * 100 + (s.v ?? 0)
    }

    interface Pair {
        a: u32
        b: u32
    }
    function pairOf(n: u32): Pair {
        return { a: n + 1, b: n * 2 }
    }
    ;(pairOf as any).shouldNotInline = true
    interface Counter {
        count: u32
    }
    function tick(c: Counter): u32 {
        c.count = c.count + 1
        return c.count
    }
    ;(tick as any).shouldNotInline = true
    function recordCallArrival(n: u32): u32 {
        const c: Counter = { count: n }
        const k = tick(c)
        const t = pairOf(n).a > 3 ? k : n
        return t + pairOf(n).b
    }

    function findLoop(n: u32): number {
        const text = `ab${n}b`
        let count = 0
        let at = text.indexOf('b')
        while (at >= 0) {
            count++
            at = text.indexOf('b', at + 1)
        }
        return count
    }
    function nextBelow(at: number, n: number): number {
        if (at + 1 >= n) return -1
        return at + 1
    }
    ;(nextBelow as any).shouldNotInline = true
    function signedCarryLoop(n: u32): number {
        let count = 0
        let at = nextBelow(0, n)
        while (at >= 0) {
            count++
            at = nextBelow(at, n)
        }
        return count
    }

    interface Tally {
        n: number
    }
    type TallyPass = (t: Tally) => Tally | boolean | void
    function tallyPasses(k: u32): TallyPass[] {
        function fresh(t: Tally): Tally | boolean | void {
            if (k > 2) return { n: t.n + k }
        }
        function flag(t: Tally): Tally | boolean | void {
            t.n = t.n + 1
            return k > 1
        }
        function none(t: Tally): Tally | boolean | void {
            t.n = t.n * 2
        }
        return [fresh, flag, none]
    }
    function closureUnionResults(k: u32): number {
        const t: Tally = { n: k }
        let flags = 0
        for (const pass of tallyPasses(k)) {
            const result = pass(t)
            if (result === true) flags = flags + 10
            if (typeof result === 'object') flags = flags + 100
            if (result === undefined) flags = flags + 1000
        }
        return t.n + flags
    }
    function closureUnionDirect(k: u32): number {
        const t: Tally = { n: k }
        function flag(u: Tally): Tally | boolean | void {
            u.n = u.n + 1
            return k > 1
        }
        function fresh(u: Tally): Tally | boolean | void {
            if (k > 2) return { n: u.n + k }
        }
        const passes: TallyPass[] = [flag, fresh]
        let flags = 0
        for (const pass of passes) {
            if (pass(t) === undefined) flags = flags + 1000
        }
        const direct = flag(t)
        if (direct === true) flags = flags + 10
        return t.n + flags
    }
    function closureUnionNumbers(k: u32): number {
        function count(u: Tally): number | void {
            u.n = u.n + 1
            if (k > 1) return u.n * 3
        }
        function none(u: Tally): number | void {
            u.n = u.n * 2
        }
        const passes = [count, none]
        const t: Tally = { n: k }
        let total = 0
        for (const pass of passes) {
            const result = pass(t)
            if (result === undefined) total = total + 1000
            else total = total + result
        }
        return t.n + total
    }
    function closureUnionNarrow(k: u32): number {
        let t: Tally = { n: k }
        for (const pass of tallyPasses(k)) {
            const result = pass(t)
            if (typeof result === 'object') t = result
        }
        return t.n
    }

    const notes = new WeakMap<u32[], { text: string }>()
    function coldOpaqueRead(n: u32): u32 {
        const items = [n, n + 1]
        if (n > 100) {
            let text = ''
            for (const x of items) text = text + x
            const note = notes.get(items)
            throw new Error(text + (note ? note.text : ''))
        }
        return items[1]
    }

    function keepAll(xs: number[], keep: (x: number) => boolean = x => x >= 0): number {
        function visit(i: number): number {
            if (i >= xs.length) return 0
            return (keep(xs[i]) ? 1 : 0) + visit(i + 1)
        }
        return visit(0)
    }
    function closureSlotJoin(n: u32): number {
        return keepAll([1, 2, n], x => x > 1) * 10 + keepAll([n, n])
    }
    function closureSlotLayouts(n: u32): number {
        const low = n - 2
        return keepAll([1, 2, n], x => x > low) * 100 + keepAll([n, n], x => x > 1) * 10 + keepAll([n])
    }
    function closureSlotJoinCaptured(n: u32): number {
        const low = n - 2
        return keepAll([1, 2, n], x => x > low) * 10 + keepAll([n, 1], x => x < low)
    }

    function storeWidth(p: u32, w: u32, v: u32): void {
        if (w === 0) Intrinsics.store(p, 8, v, Types.u8)
        else if (w === 1) Intrinsics.store(p, 12, v, Types.u16)
        else Intrinsics.store(p, 16, v, Types.u32)
    }
    function loadWidth(p: u32, w: u32): u32 {
        if (w === 0) return Intrinsics.load(p, 8, Types.u8)
        if (w === 1) return Intrinsics.load(p, 12, Types.u16)
        return Intrinsics.load(p, 16, Types.u32)
    }
    function sharedArrivalFacts(k: u32): u32 {
        const p = allocate(24)
        Intrinsics.store(p, 4, k, Types.u32)
        const w = Intrinsics.load(p, 4, Types.u32)
        storeWidth(p, w, 0x10203)
        const t = loadWidth(p, w)
        return w === 1 ? t + 100000 : t
    }

    function evensUpTo(n: u32): u32[] {
        const a: u32[] = []
        for (let i: u32 = 0; i < n; i++) a.push(i * 2)
        return a
    }
    ;(evensUpTo as any).shouldNotInline = true
    function popAfterLength(n: u32): u32 {
        const a = evensUpTo(n)
        let t: u32 = 0
        while (a.length) {
            const v = a.pop()
            t = t + (v === undefined ? 1000 : v)
        }
        return t
    }
    function relationInBody(n: u32): u32 {
        let t: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            if (i > n) t = t + 100
            if (i + 1 > n) t = t + 1000
            t = t + i
        }
        return t
    }
    function numericOrCount(n: u32): string | number {
        return n > 100 ? '42' : n
    }
    ;(numericOrCount as any).shouldNotInline = true
    function maybeCount(n: u32): number | undefined {
        return n > 100 ? undefined : n
    }
    ;(maybeCount as any).shouldNotInline = true
    function undefinedOperand(n: u32): u32 {
        const x = maybeCount(n)
        return x < 1000 ? 9 : 3
    }
    function flagOrCount(n: u32): boolean | number {
        return n > 100 ? true : n
    }
    ;(flagOrCount as any).shouldNotInline = true
    function explicitNumber(n: u32): u32 {
        const r = Number(wordOrName(n)) - 1
        return r < 1000 ? r : 777
    }
    function explicitNumberOr(n: u32): u32 {
        return Number(wordOrName(n)) | 0
    }
    function coerceOr(n: u32): u32 {
        return wordOrName(n) | 0
    }
    function coerceAnd(n: u32): u32 {
        return wordOrName(n) & 255
    }
    function coerceShr(n: u32): u32 {
        return wordOrName(n) >> 1
    }
    function coerceUshr(n: u32): u32 {
        return wordOrName(n) >>> 0
    }
    function coerceSub(n: u32): u32 {
        const r = wordOrName(n) - 1
        return r < 1000 ? r : 777
    }
    function coerceMul(n: u32): u32 {
        const r = wordOrName(n) * 2
        return r < 1000 ? r : 777
    }
    function coerceNeg(n: u32): u32 {
        const r = -wordOrName(n)
        return r < 1 ? 5 : 777
    }
    function coercePlus(n: u32): u32 {
        const r = +wordOrName(n)
        return r < 1000 ? r : 777
    }
    function coerceLess(n: u32): u32 {
        const x = wordOrName(n)
        return x > 2 ? 9 : 3
    }
    function coerceNot(n: u32): u32 {
        const r = ~wordOrName(n)
        return r + 10
    }
    function coerceNumericString(n: u32): u32 {
        return numericOrCount(n) * 2
    }
    function coerceBothOperands(n: u32): u32 {
        return numericOrCount(n) - numericOrCount(n + 100) + 100
    }
    function coerceBoolOr(n: u32): u32 {
        return flagOrCount(n) | 0
    }
    function coerceBoolSub(n: u32): u32 {
        const r = flagOrCount(n) - 1
        return r < 1000 ? r : 777
    }

    function wordOrName(n: u32): string | number {
        return n > 100 ? 'big' : n
    }
    ;(wordOrName as any).shouldNotInline = true
    function typeofDisjoint(n: u32): u32 {
        const t = typeof wordOrName(n)
        return t === 'boolean' ? 9 : 3
    }
    interface PassBox {
        n: number
    }
    type BoxPass = (b: PassBox, k: number) => boolean | void
    function doublePass(b: PassBox, k: number): boolean | void {
        b.n = b.n * 2
        return true
    }
    function bumpPass(b: PassBox, k: number): boolean | void {
        b.n = b.n + k
        return false
    }
    const skippedPasses = new Set<string>(['skipped'])
    const passCounts = new Map<string, number>()
    function closurePipeline(k: u32): number {
        const add: BoxPass = b => {
            b.n = b.n + k
        }
        const over: BoxPass = (b, j) => b.n > j * 10
        const b: PassBox = { n: k }
        let changed = false
        const passes: BoxPass[] = [doublePass, add, bumpPass, over]
        for (const pass of passes) {
            if (skippedPasses.has(pass.name)) continue
            const key = `stage:${pass.name}`
            passCounts.set(key, (passCounts.get(key) ?? 0) + 1)
            const result = pass(b, k)
            changed ||= result === true
        }
        return b.n + (changed ? 1000 : 0)
    }
    function closureOnlyPipeline(k: u32): number {
        const add: BoxPass = b => {
            b.n = b.n + k
        }
        const over: BoxPass = (b, j) => b.n > j * 10
        const b: PassBox = { n: k }
        let changed = false
        const passes: BoxPass[] = [add, over, add]
        for (const pass of passes) {
            if (skippedPasses.has(pass.name)) continue
            const result = pass(b, k)
            changed ||= result === true
        }
        return b.n + (changed ? 1000 : 0)
    }
    function staticOnlyPipeline(k: u32): number {
        const b: PassBox = { n: k }
        let changed = false
        const passes: BoxPass[] = [doublePass, bumpPass, doublePass]
        for (const pass of passes) {
            const result = pass(b, k)
            changed ||= result === true
        }
        return b.n + (changed ? 1000 : 0)
    }
    function freshPass(b: PassBox, k: number): PassBox | boolean | void {
        return { n: b.n + k }
    }
    function truePass(b: PassBox, k: number): PassBox | boolean | void {
        b.n = b.n + 1
        return true
    }
    function voidPass(b: PassBox, k: number): PassBox | boolean | void {
        b.n = b.n * 3
    }
    function resultPipeline(k: u32): number {
        let b: PassBox = { n: k }
        let changed = false
        const passes: ((b: PassBox, k: number) => PassBox | boolean | void)[] = [truePass, freshPass, voidPass]
        for (const pass of passes) {
            const result = pass(b, k)
            if (typeof result === 'object') b = result
            changed ||= result === true
        }
        return b.n + (changed ? 1000 : 0)
    }

    interface Blk {
        id: number
    }
    function setBlks(holder: { blocks: Blk[] }, blocks: Blk[]): void {
        if (blocks.length && blocks[0].id !== 0) throw new Error('root first')
        holder.blocks = blocks
    }
    function sliceJoin(n: u32): number {
        const holder = { blocks: [{ id: 0 }] }
        const blocks: Blk[] = [{ id: 0 }]
        for (let i: u32 = 1; i < n; i++) blocks.push({ id: i })
        const tags: (Blk | string)[] = blocks.slice()
        tags.push('x')
        setBlks(holder, blocks)
        return holder.blocks.length + tags.length * 10
    }

    const cases: [Function, number[]][] = [
        [warLoadThenStore, [4]],
        [warAcrossCall, [4]],
        [warSwap, [5]],
        [warSwapRemove, [5]],
        [headerStoreLoop, [3]],
        [headerCallLoop, [3]],
        [headerCallLoopLive, [3]],
        [sharedRetNested, [3], [7], [9]],
        [sharedRetDeep, [6, 3], [6, 1], [2, 8]],
        [selectOrTail, [2, 5], [9, 5]],
        [selectAndTail, [2, 5], [9, 5]],
        [crossBlockField, [4], [1]],
        [crossBlockFieldLoop, [5]],
        [powTwo, [5]],
        [powThree, [5]],
        [powBoth, [3, 4]],
        [literal2p53, [5]],
        [literal2p63, [5]],
        [diamondEffects, [0xABCDEF]],
        [bumpChain, [5]],
        [unionMethodCall, [2], [5]],
        [unionMethodInlined, [2], [5]],
        [addCopySlice, [5]],
        [emptyIndexOf, [5]],
        [nullableSetKeys, [5]],
        [joinedArrayKeys, [5], [2]],
        [floatLiteralMap, [8]],
        [unionWordStore, [5]],
        [nullableQueue, [5]],
        [joinedQueue, [5]],
        [zeroObjectUndefined, [0], [1], [2]],
        [typeofUnionUndefined, [0], [1], [2]],
        [truthyUnionWord, [0], [1], [2], [3]],
        [nullishVsZero, [0], [1], [2]],
        [emptyStringFalsy, [0], [1], [2]],
        [specValueSelect, [2], [5]],
        [specGuardedLoop, [2], [5]],
        [specArmInLoop, [2], [5]],
        [specSharedArms, [2, 3], [5, 3]],
        [specConjunction, [2], [5]],
        [specStoredSelect, [2], [5]],
        [specMixedSelect, [2, 3], [5, 3]],
        [specArrival, [2, 3], [5, 3]],
        [specNullableField, [2], [5]],
        [compareChains, [3, 5], [1, 50], [4, 4], [9, 1], [5, 5]],
        [taggedFieldSwap, [2], [5]],
        [recordCallArrival, [2], [5]],
        [signedCarryLoop, [1], [4]],
        [findLoop, [3], [17]],
        [closureSlotJoin, [3]],
        [closureSlotJoinCaptured, [3], [5]],
        [sharedArrivalFacts, [0], [1], [2]],
        [popAfterLength, [0], [5]],
        [relationInBody, [0], [1], [6]],
        [typeofDisjoint, [5], [200]],
        [closureUnionResults, [1], [2], [5]],
        [closureUnionNarrow, [1], [2], [5]],
        [closureUnionDirect, [1], [2], [5]],
        [closureUnionNumbers, [1], [2], [5]],
        [staticOnlyPipeline, [2], [5]],
        [resultPipeline, [2], [5]],
        [closureSlotLayouts, [3], [5]],
        [closurePipeline, [2], [5]],
        [closureOnlyPipeline, [2], [5]],
        [sliceJoin, [3], [5]],
        [explicitNumber, [5], [200]],
        [explicitNumberOr, [5], [200]],
        [coerceOr, [5], [200]],
        [coerceAnd, [5], [200]],
        [coerceShr, [5], [200]],
        [coerceUshr, [5], [200]],
        [coerceSub, [5], [200]],
        [coerceMul, [5], [200]],
        [coerceNeg, [5], [200]],
        [coercePlus, [5], [200]],
        [coerceLess, [5], [200]],
        [coerceNot, [5], [200]],
        [coerceNumericString, [5], [200]],
        [coerceBothOperands, [5], [200]],
        [coerceBoolOr, [5], [200]],
        [coerceBoolSub, [5], [200]],
    ]
    harness.runCases({ prefix: 'repro', args: true }, cases)
    harness.test('undefinedOperand', () => {
        const natives: any = native.createNatives({ undefinedOperand })
        const got = [natives.undefinedOperand(5), natives.undefinedOperand(200)]
        if (got[0] !== 9 || got[1] !== 9) harness.fail(`repro undefinedOperand FAILED: ${got.join(',')}, expected 9,9 (an undefined operand is assume-unreachable)`)
        else console.log('repro undefinedOperand ok')
    })
    harness.test('coldOpaqueRead', () => {
        let message = ''
        try {
            native.createNatives({ coldOpaqueRead })
        } catch (e) {
            message = String(e).split('\n')[0]
        }
        if (!message.includes('coldOpaqueRead/cold0 reads a property of an opaque value')) harness.fail(`repro coldOpaqueRead FAILED: ${message || 'compiled'}`)
        else console.log('repro coldOpaqueRead ok')
    })
}
