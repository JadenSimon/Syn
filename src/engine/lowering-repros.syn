        const ids = params.map(T => gn.addNode(g, gn.NodeOp.param, [], T))
        g.root = root
        const ret = body(g, root, ids)
        gn.setGraphBlocks(g, [{ id: root, params: ids, bodyId: ret, bodyConst: 0 }])
        return g
    }
    function twoUnits(callee: (g: Graph, root: number, params: number[]) => number, arity: number, args: (g: Graph, x: number) => gn.Operand[]): { program: native.ProgramGraph, caller: Graph, callee: Graph, call: number } {
        let call = 0
        const caller = unitGraph('caller', undefined, [Types.u64], (g, root, [x]) => {
            call = gn.addNode(g, gn.NodeOp.call, [gn.addNode(g, gn.NodeOp.startOf, []), gn.addNode(g, gn.NodeOp.localTarget, [{ literal: 2 }], Types.u64), { literal: 0 }, ...args(g, x)])
            return gn.addNode(g, gn.NodeOp.ret, [call, root])
        })
        const unit = unitGraph('callee', caller, Array.from({ length: arity }, () => Types.u64), callee)
        const program = { units: new Map([[1, caller], [2, unit]]), roots: new Map(), noInline: new Set(), alwaysInline: new Set(), constructors: new Set(), unplanned: new Set(), tagged: new Set(), abi: new Map(), paramPositions: new Map(), hostReturns: new Map(), image: undefined, target: hostTarget } as any as native.ProgramGraph
        return { program, caller, callee: unit, call }
    }
    harness.test('signatureRewritesStandalone', () => {
