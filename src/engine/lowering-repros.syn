        const listing = natives.integerText.units.map((unit: any) => unit.code.listing).join('\n')
        if (/\bucvtf\b|\bscvtf\b|\bfcvtzs\b/.test(listing)) harness.fail(`integerText: formatting an integer must not round-trip through f64:\n${listing}`)
        if (Number(natives.integerText(2)) !== 102 || Number(natives.integerText(12345)) !== 505) harness.fail(`integerText(2) = ${natives.integerText(2)}, integerText(12345) = ${natives.integerText(12345)}`)
    }, 'aarch64')
    harness.test('inlinedSiteDecidesStore', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const test = gn.addNode(g, gn.NodeOp.block, [])
        const obj = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const k = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const x = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const nil = gn.addNode(g, gn.NodeOp.startOf, [])
        const field = gn.addNode(g, gn.NodeOp.load, [nil, obj, { literal: 8 }], Types.u64)
        const small = gn.addNode(g, gn.NodeOp.lt, [x, { literal: 1 }], Types.bool)
        const no = gn.addNode(g, gn.NodeOp.ret, [{ literal: 0 }, test])
        const odd = gn.addNode(g, gn.NodeOp.and, [x, { literal: 1 }], Types.u64)
        const yes = gn.addNode(g, gn.NodeOp.ret, [odd, test])
        const decide = gn.addNode(g, gn.NodeOp.select, [small, no, yes])
        const region = gn.addNode(g, gn.NodeOp.apply, [test, field])
        const site = gn.newId(g)
        gn.putNode(g, site, gn.NodeOp.inlined, [region, { literal: site }], Types.u64)
        const store = gn.addNode(g, gn.NodeOp.store, [field, obj, { literal: 16 }, k], Types.u64)
        const stored = gn.addNode(g, gn.NodeOp.ret, [{ literal: 1 }, root])
        const taken = gn.addNode(g, gn.NodeOp.after, [store, stored])
        const skipped = gn.addNode(g, gn.NodeOp.ret, [{ literal: 0 }, root])
        const body = gn.addNode(g, gn.NodeOp.select, [site, taken, skipped])
        g.root = root
        gn.setGraphBlocks(g, [
            { id: root, params: [obj, k], bodyId: body, bodyConst: 0 },
            { id: test, params: [x], bodyId: decide, bodyConst: 0 },
        ])
        const packaged = packageValueGraph(g, hostTarget)
        const work = [packaged.blocks[0].bodyId]
        const seen = new Set<number>()
        while (work.length) {
            const id = work.pop()!
            const n = id ? gn.getNode(packaged, id) : undefined
            if (!n || seen.has(id) || n.op === gn.NodeOp.block) continue
            seen.add(id)
            if (n.op === gn.NodeOp.store) harness.fail(`the store decided by the inlined site must stay out of the entry block:\n${dumpGraph(packaged)}`)
            for (let i = 0; i < gn.countIds(n); i++) work.push(gn.getRef(n, i))
        }
    })
    harness.test('sharedFloatStoreToken', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const obj = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const buf = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const flags = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const token = gn.addNode(g, gn.NodeOp.startOf, [])
        const stored = gn.addNode(g, gn.NodeOp.store, [token, buf, { literal: 8 }, { literal: 0 }], Types.f64)
        const shared = gn.addNode(g, gn.NodeOp.load, [stored, obj, { literal: 0 }], Types.u32)
        const bit = (k: number) => gn.addNode(g, gn.NodeOp.and, [flags, { literal: k }], Types.u64)
        const arm = (offset: number) => gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.add, [gn.addNode(g, gn.NodeOp.load, [stored, obj, { literal: offset }], Types.u32), shared], Types.u64), root])
        const inner = gn.addNode(g, gn.NodeOp.select, [bit(4), arm(16), arm(24)])
        const middle = gn.addNode(g, gn.NodeOp.select, [bit(2), arm(8), inner])
        const outer = gn.addNode(g, gn.NodeOp.select, [bit(1), gn.addNode(g, gn.NodeOp.ret, [{ literal: 1 }, root]), middle])
        const body = gn.addNode(g, gn.NodeOp.after, [stored, outer])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [obj, buf, flags], bodyId: body, bodyConst: 0 }])
        lowerValueGraph(g)
    })
    harness.test('narrowBeforeTruncate', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const param = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const sum = gn.addNode(g, gn.NodeOp.add, [param, { literal: 1 }], Types.u64)
        const value = gn.addNode(g, gn.NodeOp.convert, [sum], Types.u32)
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [param], bodyId: ret, bodyConst: 0 }])
        const code = lowerValueGraph(g)
        if (code.words.length !== 2 || !code.listing.includes('add w')) harness.fail(`truncate the ADD directly:\n${code.listing}`)
    }, 'aarch64')
    harness.test('threadGuardedReadModifyWrite', () => {
        for (const T of [Types.u64, Types.i64]) {
            const g = gn.createGraph({})
            const root = gn.addNode(g, gn.NodeOp.block, [])
            const join = gn.addNode(g, gn.NodeOp.block, [])
            const param = (type: intrinsics.Types) => gn.addNode(g, gn.NodeOp.param, [], type)
            const index = param(T), length = param(T), data = param(Types.ptr)
            const value = param(T), at = param(T), end = param(T), buffer = param(Types.ptr)
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const cond = gn.addNode(g, gn.NodeOp.ge, [index, length], Types.bool)
            const load = gn.addNode(g, gn.NodeOp.load, [nil, data, index], T)
            const missing = gn.addNode(g, gn.NodeOp.apply, [join, { literal: 0 }, index, length, data])
            const present = gn.addNode(g, gn.NodeOp.apply, [join, load, index, length, data])
            const entry = gn.addNode(g, gn.NodeOp.select, [cond, missing, present])
            const again = gn.addNode(g, gn.NodeOp.ge, [at, end], Types.bool)
            const next = gn.addNode(g, gn.NodeOp.add, [value, { literal: 1 }], T)
            const store = gn.addNode(g, gn.NodeOp.store, [nil, buffer, at, next], T)
            const absent = gn.addNode(g, gn.NodeOp.ret, [{ literal: 0 }, root])
            const result = gn.addNode(g, gn.NodeOp.ret, [next, root])
            const written = gn.addNode(g, gn.NodeOp.after, [store, result])
            const body = gn.addNode(g, gn.NodeOp.select, [again, absent, written])
            g.root = root
            gn.setGraphBlocks(g, [
                { id: root, params: [index, length, data], bodyId: entry, bodyConst: 0 },
                { id: join, params: [value, at, end, buffer], bodyId: body, bodyConst: 0 },
            ])
            const listing = lowerValueGraph(g).listing
            if (listing.split('cmp ').length !== 2 || !listing.includes('str ')) {
                harness.fail(`read/modify/write must share its guard, including signed indices:\n${listing}`)
            }
        }
    }, 'aarch64')
    harness.test('sharedShiftedAdds', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const a = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const b = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const i = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const scaled = gn.addNode(g, gn.NodeOp.shl, [i, { literal: 4 }], Types.u64)
        const x = gn.addNode(g, gn.NodeOp.add, [a, scaled], Types.u64)
        const y = gn.addNode(g, gn.NodeOp.add, [b, scaled], Types.u64)
        const value = gn.addNode(g, gn.NodeOp.xor, [x, y], Types.u64)
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [a, b, i], bodyId: ret, bodyConst: 0 }])
        const listing = lowerValueGraph(g).listing
        const fused = listing.split('lsl #4').length - 1
        if (fused < 2 && !listing.includes('lsl x')) harness.fail(`a shift shared by two adds must stay materialized unless both fuse it:\n${listing}`)
    }, 'aarch64')
    harness.test('internHashWrap', () => {
        const g = gn.createGraph({})
        const table = new Map<number, number>()
        const mask = 0x7fffffff
        const prefix = (gn.NodeOp.add * 31 + gn.encodeType(Types.u32)) * 31 * 31
        const a = Math.floor((mask - prefix) / 31)
        const b = mask - prefix - a * 31
        const intern = (x: number, y: number) => gn.internNode(g, table, gn.NodeOp.add, [gn.literalSlot(g, x), gn.literalSlot(g, y)], Types.u32)
        const first = intern(a, b)
        const second = intern(a - 1, b + 31)
        if (first === second || table.get(mask) !== first || table.get(0) !== second
            || intern(a, b) !== first || intern(a - 1, b + 31) !== second) {
            harness.fail('interning must resolve collisions across the hash wraparound')
        }
        const slots = Array.from({ length: 128 }, (_, i) => gn.literalSlot(g, i * 17))
        const wide = gn.internNode(g, table, gn.NodeOp.record, slots)
        if (gn.internNode(g, table, gn.NodeOp.record, slots.slice()) !== wide) harness.fail('long interned nodes must share')
        slots[127] = gn.literalSlot(g, -1)
        if (gn.internNode(g, table, gn.NodeOp.record, slots) === wide) harness.fail('long interned nodes must compare every operand')
    })
    function codecRequest(reps: Map<number, Rep>, params: Rep[], returns: Rep, abi: native.UnitAbi): native.CodecRequest {
        return { reps, params, returns, abi, codecs: new Map(), slices: new Map(), pointers: new Set(), encoded: new Set(), calls: new Map(), tracked: new Map(), fieldTags: new Map(), tagWrites: new Map(), wordWrites: new Map(), floatRecords: new Map(), wordBits: new Set(), observed: new Set() }
    }
    harness.test('realizeWordsStandalone', () => {
        const g = gn.createGraph({})
