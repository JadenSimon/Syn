    })
    harness.test('negatedShiftedOperand', () => {
        const natives: any = native.createNatives({ negScaledSlot })
        const listing: string = natives.negScaledSlot.units.find((unit: any) => unit.name === 'negScaledSlot').code.listing
        if (!/\bsub x\d+, x\d+, x\d+, lsl #2\n/.test(listing) || /\bneg\b/.test(listing)) harness.fail(`negScaledSlot: a dead neg feeding a shifted add must fold into sub ..., lsl #2:\n${listing}`)
        const memory = new BigInt64Array(64)
        const words = new Uint32Array(memory.buffer)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        const founds = [-1, 0, 5, 20, -10]
        founds.forEach((found, i) => memory[i] = BigInt(found))
        founds.forEach((found, i) => natives.negScaledSlot(ptr, i, 100 + i))
        founds.forEach((found, i) => {
            const at = (256 + (-found - 1) * 4) / 4
            if (words[at] !== 100 + i) harness.fail(`negScaledSlot(${found}): word ${at} = ${words[at]}, expected ${100 + i}:\n${listing}`)
        })
    })
    harness.test('negateSelect', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        for (const swapped of [false, true]) {
            const asm = hostTarget.createAssembler()
            asm.load(11, 0, 0, Types.i64)
            asm.compareImm('lt', 3, 11, 0, true)
            asm.unary('neg', 9, 11)
            if (swapped) asm.select(10, 3, 11, 9)
            else asm.select(10, 3, 9, 11)
            asm.released([{ value: 0, home: 9 }, { value: 1, home: 11 }])
            asm.store(0, 8, 10, Types.i64)
            asm.store(0, 16, 3, Types.i64)
            asm.ret()
            const listing = asm.listing()
            if (!new RegExp(`cneg x10, x11, ${swapped ? 'ge' : 'lt'}\\n`).test(listing) || /\bneg\b/.test(listing) || !/\bcset x3, lt\b/.test(listing)) harness.fail(`negate select ${swapped}: a dead neg feeding csel must become cneg, keeping the cset:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            const memory = new BigInt64Array(3)
            const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
            for (const v of [-(BigInt(2) ** BigInt(63)), BigInt(-5), BigInt(-1), BigInt(0), BigInt(1), BigInt(5), BigInt(2) ** BigInt(63) - BigInt(1)]) {
                memory[0] = v
                run(ptr)
                const negative = v < BigInt(0)
                const want = BigInt.asIntN(64, negative !== swapped ? -v : v)
                if (memory[1] !== want || memory[2] !== BigInt(negative ? 1 : 0)) harness.fail(`negate select ${swapped}(${v}): ${memory[1]}, ${memory[2]}, expected ${want}, ${negative ? 1 : 0}:\n${listing}`)
            }
        }
    })
    harness.test('unsignedZeroSelect', () => {
        const natives: any = native.createNatives({ clampedStore, clampedSigned })
        const listing: string = natives.clampedStore.units.find((unit: any) => unit.name === 'clampedStore').code.listing
        if (/\b(?:csel|cmp|cbz|cbnz)\b/.test(listing)) harness.fail(`clampedStore: an unsigned v > 0 ? v : 0 is v:\n${listing}`)
        const memory = new BigUint64Array(5)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        for (const v of [BigInt(0), BigInt(1), BigInt(5), BigInt(2) ** BigInt(63), BigInt(2) ** BigInt(64) - BigInt(1)]) {
            memory[4] = v
            natives.clampedStore(ptr, 4)
            if (memory[1] !== v || memory[2] !== v || memory[3] !== v) harness.fail(`clampedStore(${v}): ${memory[1]}, ${memory[2]}, ${memory[3]}:\n${listing}`)
        }
        const signed = new BigInt64Array(memory.buffer)
        for (const v of [-(BigInt(2) ** BigInt(63)), BigInt(-5), BigInt(0), BigInt(7)]) {
            signed[4] = v
            natives.clampedSigned(ptr, 4)
            if (signed[1] !== (v > BigInt(0) ? v : BigInt(0))) harness.fail(`clampedSigned(${v}): ${signed[1]}`)
        }
    })
    harness.test('negatedFloatLiteral', () => {
        const natives: any = native.createNatives({ farFloat })
        const listing: string = natives.farFloat.units.find((unit: any) => unit.name === 'farFloat').code.listing
        if ((listing.match(/\bmovz x16\b/g) ?? []).length !== 1 || !/\bfneg d\d+, d\d+\n/.test(listing)) harness.fail(`farFloat: -1e21 must be fneg of the 1e21 already in a register:\n${listing}`)
        const memory = new Float64Array(2)
        const flags = new Uint8Array(memory.buffer)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        const edge = 10 ** 21
        const below = edge - 131072
        for (const x of [edge, below, -edge, -below, 0, -0, NaN, Infinity, -Infinity, edge * 2, -edge * 2]) {
            memory[1] = x
            natives.farFloat(ptr, 1)
            if (flags[0] !== (x >= edge ? 1 : 0) || flags[1] !== (x <= -edge ? 1 : 0)) harness.fail(`farFloat(${x}): ${flags[0]}, ${flags[1]}:\n${listing}`)
        }
    })
    harness.test('rangeCheckOffset', () => {
        const natives: any = native.createNatives({ rangeWide, rangeUnsigned, rangeNarrow, signedBand })
        for (const name of ['rangeWide', 'rangeUnsigned', 'rangeNarrow', 'signedBand']) {
            const listing: string = natives[name].units.find((unit: any) => unit.name === name).code.listing
            const window = name === 'signedBand' ? /\badd (x\d+), x\d+, #40\n.*cmp \1, #37\n/ : /\bsub (x\d+), x\d+, #97\n.*cmp \1, #25\n/
            if (!window.test(listing) || /\bccmp\b/.test(listing)) harness.fail(`${name}: lo <= x && x <= hi must test x - lo <= hi - lo unsigned:\n${listing}`)
        }
        const two = BigInt(2)
        const between = (v: bigint, lo: number, hi: number) => v >= BigInt(lo) && v <= BigInt(hi)
        const digit = (v: bigint) => {
            const d = between(v, 48, 57) ? Number(v) - 48 : between(v, 97, 122) ? Number(v) - 87 : between(v, 65, 90) ? Number(v) - 55 : 80
            return d < 80 ? d : -1
        }
        const edges = [0, 47, 48, 57, 58, 64, 65, 90, 91, 96, 97, 122, 123]
        const wide = new BigInt64Array([...edges, -1, -41, -40, -3, -2].map(v => BigInt(v)).concat([-(two ** BigInt(63)), two ** BigInt(63) - BigInt(1)]))
        const wideAt = Number((ts as any).getArrayBufferPtr(wide.buffer))
        wide.forEach((v, i) => {
            if (Number(natives.rangeWide(wideAt, i)) !== digit(v)) harness.fail(`rangeWide(${v}) = ${natives.rangeWide(wideAt, i)}, expected ${digit(v)}`)
            const band = between(v, 48, 57) ? Number(v) - 48 : between(v, -40, -3) ? 70 : 99
            if (Number(natives.signedBand(wideAt, i)) !== band) harness.fail(`signedBand(${v}) = ${natives.signedBand(wideAt, i)}, expected ${band}`)
        })
        const unsigned = new BigUint64Array(edges.map(v => BigInt(v)).concat([two ** BigInt(32), two ** BigInt(63), two ** BigInt(64) - BigInt(1), two ** BigInt(64) - BigInt(40)]))
        const unsignedAt = Number((ts as any).getArrayBufferPtr(unsigned.buffer))
        unsigned.forEach((v, i) => {
            if (Number(natives.rangeUnsigned(unsignedAt, i)) !== digit(v)) harness.fail(`rangeUnsigned(${v}) = ${natives.rangeUnsigned(unsignedAt, i)}, expected ${digit(v)}`)
        })
        const narrow = new Uint32Array([...edges, 2 ** 31, 2 ** 32 - 1, 2 ** 32 - 40])
        const narrowAt = Number((ts as any).getArrayBufferPtr(narrow.buffer))
        narrow.forEach((v, i) => {
            if (Number(natives.rangeNarrow(narrowAt, i)) !== digit(BigInt(v))) harness.fail(`rangeNarrow(${v}) = ${natives.rangeNarrow(narrowAt, i)}, expected ${digit(BigInt(v))}`)
        })
    })
    harness.test('constantKeyHashFolds', () => {
        const natives: any = native.createNatives({ maybeKeyHash })
        const listing = natives.maybeKeyHash.units.map((unit: any) => unit.code.listing).join('\n')
        if ((listing.match(/\bcrc32w\b/g) ?? []).length !== 1 || !/#12538\b/.test(listing) || !/#59557\b/.test(listing)) harness.fail(`maybeKeyHash: the undefined key's hash must fold to the literal 3903140090 (raw CRC-32 of 17), leaving one crc32w for the small-int key:\n${listing}`)
        const got = [natives.maybeKeyHash(0, 1), natives.maybeKeyHash(7, 0)].map(Number)
        if (got.join() !== '3903140090,2648127673') harness.fail(`maybeKeyHash results ${got.join()}, expected 3903140090,2648127673`)
    })
    harness.test('cheapReturnArmFallsThrough', () => {
        const natives: any = native.createNatives({ scaledSum })
        for (const name of ['scaledOrPlain', 'plainOrScaled']) {
            const listing: string = natives.scaledSum.units.find((unit: any) => unit.name === name).code.listing
            if (listing.indexOf('ret') > listing.indexOf('udiv')) harness.fail(`${name}: the cheap a + 1 return must fall through, with the rem/mul arm after the first ret:\n${listing}`)
        }
        if (Number(natives.scaledSum(1010)) !== 601150) harness.fail(`scaledSum(1010) = ${natives.scaledSum(1010)}, expected 601150`)
    })
    harness.test('expensiveSelectArmsBranch', () => {
        const natives: any = native.createNatives({ hashedSlot })
        const listing = natives.hashedSlot.units.map((unit: any) => unit.code.listing).join('\n')
        if (/\bcsel\b/.test(listing) || !/\bucvtf\b/.test(listing)) harness.fail(`hashedSlot: the wide-key hash (ucvtf + crc32x) must branch, not run on every key and csel:\n${listing}`)
        const got = [natives.hashedSlot(7, 0xffffffff), natives.hashedSlot(2 ** 40, 0xffffffff)].map(Number)
        if (got.join() !== '2648127673,3085785418') harness.fail(`hashedSlot results ${got.join()}, expected 2648127673,3085785418`)
        const looped: any = native.createNatives({ hashedSum })
        const loopListing: string = looped.hashedSum.units.find((unit: any) => unit.name === 'hashedSum').code.listing
        const tail = loopListing.slice(loopListing.lastIndexOf('ret'))
        if (/\bcsel\b/.test(loopListing) || !/\bucvtf\b/.test(tail)) harness.fail(`hashedSum: the wide-key hash must sit out of line after the return, with the small-key hash straight-line in the loop:\n${loopListing}`)
        if (Number(looped.hashedSum(4, 0xffff)) !== 87966) harness.fail(`hashedSum(4, 0xffff) = ${looped.hashedSum(4, 0xffff)}, expected 87966`)
    })
    harness.test('calleeReadFootprint', () => {
        const natives: any = native.createNatives({ footprintMapKeys })
        const listing = natives.footprintMapKeys.units.find((unit: any) => unit.name === 'footprintMapKeys').code.listing
        const zeroStores = (listing.match(/\bst(?:r|p|ur)\s+xzr(?:, xzr)?, \[[^\]]*\](?!, #)/g) ?? []).reduce((n: number, store: string) => n + (store.includes('xzr, xzr') ? 2 : 1), 0)
        if (zeroStores !== 11) harness.fail(`footprintMapKeys: ${zeroStores} zero stores, expected 11 (push reads only its array, so the other Map fields' stores are dead; the array's own fields stay):\n${listing}`)
        const got = [natives.footprintMapKeys(7), natives.footprintMapKeys(0)].map(Number)
        if (got.join() !== '7,0') harness.fail(`footprintMapKeys results ${got.join()}, expected 7,0`)
    })
    harness.test('wideZeroFills', () => {
        const natives: any = native.createNatives({ zeroFillWords, zeroFillTable, zeroFillBytes, zeroFillGuarded })
        for (const name of ['zeroFillWords', 'zeroFillTable', 'zeroFillBytes']) {
            const listing = natives[name].units.find((unit: any) => unit.name === name).code.listing
            if (!/\bstp xzr, xzr, \[x\d+\], #16/.test(listing) || /\bstr[bh]? wzr, \[x\d+(?:, x\d+)?\]/.test(listing)) harness.fail(`${name}: a zero fill of a whole pstack allocation (or a multiple of 16 bytes) must step 16 bytes with stp xzr, xzr:\n${listing}`)
        }
        const into = natives.zeroFillGuarded.units.find((unit: any) => unit.name === 'zeroFillInto').code.listing
        if (/\bstp xzr\b|\bstr xzr\b/.test(into)) harness.fail(`zeroFillInto: a fill of caller memory with an unknown extent must not widen past its end:\n${into}`)
    })
    harness.test('taggedFloatReturnRegisters', () => {
        const natives: any = native.createNatives({ remInlineRaw, remTaggedParam })
        for (const name of ['remInlineRaw', 'remTaggedParam']) {
            for (const unit of natives[name].units) {
                const listing: string = unit.code.listing
                if (/\bfmov d\d+, x[01]\b/.test(listing) || (unit.name === 'halfOrNot' && /\bfmov x\d+, d\d+/.test(listing))) harness.fail(`${name}: a tagged f64 return must keep its payload in a float register (${unit.name}):\n${listing}`)
            }
        }
        if (Number(natives.remInlineRaw(1)) !== 0.5 || Number(natives.remTaggedParam(5)) !== 5) harness.fail(`remInlineRaw(1) = ${natives.remInlineRaw(1)}, remTaggedParam(5) = ${natives.remTaggedParam(5)}`)
    })
    harness.test('f64RoundingInstructions', () => {
        const natives: any = native.createNatives({ truncF64, floorF64, ceilF64, absF64 })
        const expected: Record<string, string> = { truncF64: 'frintz', floorF64: 'frintm', ceilF64: 'frintp', absF64: 'fabs' }
        for (const name of Object.keys(expected)) {
            const listing = natives[name].units.map((unit: any) => unit.code.listing).join('\n')
            if (!listing.includes(expected[name]) || /\bfcvtzs\b|\bfcsel\b|\bblr?\b/.test(listing)) harness.fail(`${name}: must select one ${expected[name]}:\n${listing}`)
        }
    })
    harness.test('negatedRegisterUsesZero', () => {
        const natives: any = native.createNatives({ negatedWhole })
        const listing = natives.negatedWhole.units.map((unit: any) => unit.code.listing).join('\n')
        if (/movz (x\d+), #0\n[^\n]*\bsub x\d+, \1, x/.test(listing) || !listing.includes('neg x')) harness.fail(`negatedWhole: 0 - x must negate through the zero register, not a materialized 0:\n${listing}`)
        if (Number(natives.negatedWhole(4)) !== 9 || Number(natives.negatedWhole(20)) !== 15) harness.fail(`negatedWhole(4) = ${natives.negatedWhole(4)}, negatedWhole(20) = ${natives.negatedWhole(20)}`)
    })
    harness.test('negativeRootArgsRejected', () => {
        const natives: any = native.createNatives({ negativeRootScaled, negativeRootCompare })
        for (const name of ['negativeRootScaled', 'negativeRootCompare']) {
            let message = ''
            try {
                natives[name](-7)
            } catch (e) {
                message = String((e as any)?.message ?? e)
            }
            if (!message.includes('root number params are u64')) harness.fail(`${name}(-7) must be rejected at the host boundary, got ${message || natives[name](-7)}`)
        }
        if (Number(natives.negativeRootScaled(3)) !== 6.5 || Number(natives.negativeRootCompare(3)) !== 2) harness.fail(`negativeRootScaled(3) = ${natives.negativeRootScaled(3)}, negativeRootCompare(3) = ${natives.negativeRootCompare(3)}`)
    })
    harness.test('foldLargeLiteralOperands', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const a = gn.addNode(g, gn.NodeOp.literal, [{ literal: 536870915 }], Types.u64)
        const b = gn.addNode(g, gn.NodeOp.literal, [{ literal: 536870912 }], Types.u64)
        const value = gn.addNode(g, gn.NodeOp.sub, [a, b], Types.u64)
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [], bodyId: ret, bodyConst: 0 }])
        const code = lowerValueGraph(g)
        if (code.words.length !== 2 || !code.listing.includes('#3')) harness.fail(`large literal operands must fold to 3:\n${code.listing}`)
    })
    harness.test('rotatedEntryGuardFolds', () => {
        const natives: any = native.createNatives({ constantEntrySearch })
        const listing = natives.constantEntrySearch.units.map((unit: any) => unit.code.listing).join('\n')
        if (/movz (x\d+), #32\n[^\n]*\bcmp \1, #2048/.test(listing)) harness.fail(`constantEntrySearch: a rotated loop's entry guard on literal arguments must fold:\n${listing}`)
    })
    harness.test('singleBitTests', () => {
        const natives: any = native.createNatives({ oddCount, lowBitFlag })
        const odd = natives.oddCount.units.filter((unit: any) => unit.name === 'oddTotal' || unit.name === 'oddCount').map((unit: any) => unit.code.listing).join('\n')
        const direct = /\btbz w\d+, #0\b/.test(odd) || (/\btst x\d+, #1\b/.test(odd) && /\bcsel\b/.test(odd))
        if (!direct || /\band x\d+, x\d+, #1\b/.test(odd)) harness.fail(`oddCount: a one-bit condition must use tbz or tst with csel:\n${odd}`)
        const flag = natives.lowBitFlag.units.filter((unit: any) => unit.name === 'lowBitFlag').map((unit: any) => unit.code.listing).join('\n')
        if (/\bcmp\b|\bcset\b/.test(flag) || (flag.match(/\btst\b/g) ?? []).length !== 2 || !/\bubfx x\d+, x\d+, #0, #1\b/.test(flag)) harness.fail(`lowBitFlag: mask tests must be tst, and a one-bit != 0 value a bit extract:\n${flag}`)
        for (const n of [0, 1, 2, 5, 12, 1000001]) {
            let s = 0
            for (const x of [n, n + 1, n + 2, 7]) if ((x & 1) !== 0) s = s * 3 + x
            const a1 = n + 3
            const want = ((n & 1) !== 0 ? 1 : 0) + ((a1 & 4) !== 0 ? 2 : 0) + ((a1 & 1) === 0 ? 4 : 0)
            if (Number(natives.oddCount(n)) !== s || Number(natives.lowBitFlag(n)) !== want) harness.fail(`oddCount(${n}) = ${natives.oddCount(n)} (${s}), lowBitFlag(${n}) = ${natives.lowBitFlag(n)} (${want})`)
        }
        if (!hostTarget.name.startsWith('aarch64')) return
        for (const mode of ['', 'shared']) {
            const shared = mode === 'shared'
            const asm = hostTarget.createAssembler()
            asm.binaryImm('and', 9, 0, 4, false)
            asm.compareImm('ne', 10, 9, 0, false)
            asm.released([{ value: 0, home: 9 }])
            asm.jumpIfZero(10, 0)
            if (shared) {
                asm.select(11, 10, 1, 2)
                asm.released([{ value: 0, home: 10 }])
                asm.mov(0, 11)
            } else {
                asm.released([{ value: 0, home: 10 }])
                asm.mov(0, 1)
            }
            asm.ret()
            asm.bindLabel(0)
            asm.movImm(0, 99)
            asm.ret()
            const listing = asm.listing()
            if (!shared && !/\btbz w0, #2\b/.test(listing)) harness.fail(`bit branch ${mode}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const v of [0, 3, 4, 5, 12, 2 ** 40 + 4]) {
                const expected = (v & 4) === 0 ? 99 : 7
                const actual = Number(run(v, 7, 8))
                if (actual !== expected) harness.fail(`bit branch ${mode}(${v}): ${actual}, expected ${expected}:\n${listing}`)
            }
        }
    })
    harness.test('negativeLoopStart', () => {
        const natives: any = native.createNatives({ literalIndexOf })
        const listing = natives.literalIndexOf.units.map((unit: any) => unit.code.listing).join('\n')
        if (/movz (x\d+), #0\n[^\n]*\bsub x\d+, \1, #/.test(listing)) harness.fail(`literalIndexOf: a stepped loop starting at 0 must enter with a literal -1, not sub #0 #1:\n${listing}`)
    })
    harness.test('unsignedFindResult', () => {
        const natives: any = native.createNatives({ hasZeroRun })
        const listing = natives.hasZeroRun.units.map((unit: any) => unit.code.listing).join('\n')
        if (/\bcset x\d+, (ge|lt)\b/.test(listing)) harness.fail(`hasZeroRun: a find result that only arrives as the unsigned position must not keep a signed test against 0:\n${listing}`)
        if (Number(natives.hasZeroRun(0)) !== 1 || Number(natives.hasZeroRun(3)) !== 0) harness.fail(`hasZeroRun(0) = ${natives.hasZeroRun(0)}, hasZeroRun(3) = ${natives.hasZeroRun(3)}`)
    })
    harness.test('booleanArrivalSelect', () => {
        const natives: any = native.createNatives({ slackFlag })
        const listing = natives.slackFlag.units.map((unit: any) => unit.code.listing).join('\n')
        if (/cbn?z (x\d+), L\d+\n[^\n]*movz \1, #[01]\n/.test(listing)) harness.fail(`slackFlag: a select of 1/0 on a param whose arrivals are all boolean must fold to the param:\n${listing}`)
        if (Number(natives.slackFlag(5)) !== 1 || Number(natives.slackFlag(7)) !== 0 || Number(natives.slackFlag(1)) !== 0) harness.fail(`slackFlag(5) = ${natives.slackFlag(5)}, slackFlag(7) = ${natives.slackFlag(7)}, slackFlag(1) = ${natives.slackFlag(1)}`)
    })
    harness.test('integerTextSkipsFloat', () => {
        const natives: any = native.createNatives({ integerText })
        const listing = natives.integerText.units.map((unit: any) => unit.code.listing).join('\n')
        if (/\bucvtf\b|\bscvtf\b|\bfcvtzs\b/.test(listing)) harness.fail(`integerText: formatting an integer must not round-trip through f64:\n${listing}`)
        if (Number(natives.integerText(2)) !== 102 || Number(natives.integerText(12345)) !== 505) harness.fail(`integerText(2) = ${natives.integerText(2)}, integerText(12345) = ${natives.integerText(12345)}`)
    })
    harness.test('inlinedSiteDecidesStore', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const test = gn.addNode(g, gn.NodeOp.block, [])
        const obj = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const k = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const x = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const nil = gn.addNode(g, gn.NodeOp.startOf, [])
        const field = gn.addNode(g, gn.NodeOp.load, [nil, obj, { literal: 8 }], Types.u64)
        const small = gn.addNode(g, gn.NodeOp.lt, [x, { literal: 1 }], Types.bool)
        const no = gn.addNode(g, gn.NodeOp.ret, [{ literal: 0 }, test])
        const odd = gn.addNode(g, gn.NodeOp.and, [x, { literal: 1 }], Types.u64)
        const yes = gn.addNode(g, gn.NodeOp.ret, [odd, test])
        const decide = gn.addNode(g, gn.NodeOp.select, [small, no, yes])
        const region = gn.addNode(g, gn.NodeOp.apply, [test, field])
        const site = gn.newId(g)
        gn.putNode(g, site, gn.NodeOp.inlined, [region, { literal: site }], Types.u64)
        const store = gn.addNode(g, gn.NodeOp.store, [field, obj, { literal: 16 }, k], Types.u64)
        const stored = gn.addNode(g, gn.NodeOp.ret, [{ literal: 1 }, root])
        const taken = gn.addNode(g, gn.NodeOp.after, [store, stored])
        const skipped = gn.addNode(g, gn.NodeOp.ret, [{ literal: 0 }, root])
        const body = gn.addNode(g, gn.NodeOp.select, [site, taken, skipped])
        g.root = root
        gn.setGraphBlocks(g, [
            { id: root, params: [obj, k], bodyId: body, bodyConst: 0 },
            { id: test, params: [x], bodyId: decide, bodyConst: 0 },
        ])
        const packaged = packageValueGraph(g, hostTarget)
        const work = [packaged.blocks[0].bodyId]
        const seen = new Set<number>()
        while (work.length) {
            const id = work.pop()!
            const n = id ? gn.getNode(packaged, id) : undefined
            if (!n || seen.has(id) || n.op === gn.NodeOp.block) continue
            seen.add(id)
            if (n.op === gn.NodeOp.store) harness.fail(`the store decided by the inlined site must stay out of the entry block:\n${dumpGraph(packaged)}`)
            for (let i = 0; i < gn.countIds(n); i++) work.push(gn.getRef(n, i))
        }
    })
    harness.test('sharedFloatStoreToken', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const obj = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const buf = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const flags = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const token = gn.addNode(g, gn.NodeOp.startOf, [])
        const stored = gn.addNode(g, gn.NodeOp.store, [token, buf, { literal: 8 }, { literal: 0 }], Types.f64)
        const shared = gn.addNode(g, gn.NodeOp.load, [stored, obj, { literal: 0 }], Types.u32)
        const bit = (k: number) => gn.addNode(g, gn.NodeOp.and, [flags, { literal: k }], Types.u64)
        const arm = (offset: number) => gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.add, [gn.addNode(g, gn.NodeOp.load, [stored, obj, { literal: offset }], Types.u32), shared], Types.u64), root])
        const inner = gn.addNode(g, gn.NodeOp.select, [bit(4), arm(16), arm(24)])
        const middle = gn.addNode(g, gn.NodeOp.select, [bit(2), arm(8), inner])
        const outer = gn.addNode(g, gn.NodeOp.select, [bit(1), gn.addNode(g, gn.NodeOp.ret, [{ literal: 1 }, root]), middle])
        const body = gn.addNode(g, gn.NodeOp.after, [stored, outer])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [obj, buf, flags], bodyId: body, bodyConst: 0 }])
        lowerValueGraph(g)
    })
    harness.test('narrowBeforeTruncate', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const param = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const sum = gn.addNode(g, gn.NodeOp.add, [param, { literal: 1 }], Types.u64)
        const value = gn.addNode(g, gn.NodeOp.convert, [sum], Types.u32)
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [param], bodyId: ret, bodyConst: 0 }])
        const code = lowerValueGraph(g)
        if (code.words.length !== 2 || !code.listing.includes('add w')) harness.fail(`truncate the ADD directly:\n${code.listing}`)
    })
    harness.test('threadGuardedReadModifyWrite', () => {
        for (const T of [Types.u64, Types.i64]) {
            const g = gn.createGraph({})
            const root = gn.addNode(g, gn.NodeOp.block, [])
            const join = gn.addNode(g, gn.NodeOp.block, [])
            const param = (type: intrinsics.Types) => gn.addNode(g, gn.NodeOp.param, [], type)
            const index = param(T), length = param(T), data = param(Types.ptr)
            const value = param(T), at = param(T), end = param(T), buffer = param(Types.ptr)
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const cond = gn.addNode(g, gn.NodeOp.ge, [index, length], Types.bool)
            const load = gn.addNode(g, gn.NodeOp.load, [nil, data, index], T)
            const missing = gn.addNode(g, gn.NodeOp.apply, [join, { literal: 0 }, index, length, data])
            const present = gn.addNode(g, gn.NodeOp.apply, [join, load, index, length, data])
            const entry = gn.addNode(g, gn.NodeOp.select, [cond, missing, present])
            const again = gn.addNode(g, gn.NodeOp.ge, [at, end], Types.bool)
            const next = gn.addNode(g, gn.NodeOp.add, [value, { literal: 1 }], T)
            const store = gn.addNode(g, gn.NodeOp.store, [nil, buffer, at, next], T)
            const absent = gn.addNode(g, gn.NodeOp.ret, [{ literal: 0 }, root])
            const result = gn.addNode(g, gn.NodeOp.ret, [next, root])
            const written = gn.addNode(g, gn.NodeOp.after, [store, result])
            const body = gn.addNode(g, gn.NodeOp.select, [again, absent, written])
            g.root = root
            gn.setGraphBlocks(g, [
                { id: root, params: [index, length, data], bodyId: entry, bodyConst: 0 },
                { id: join, params: [value, at, end, buffer], bodyId: body, bodyConst: 0 },
            ])
            const listing = lowerValueGraph(g).listing
            if (listing.split('cmp ').length !== 2 || !listing.includes('str ')) {
                harness.fail(`read/modify/write must share its guard, including signed indices:\n${listing}`)
            }
        }
    })
    harness.test('sharedShiftedAdds', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const a = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const b = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const i = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const scaled = gn.addNode(g, gn.NodeOp.shl, [i, { literal: 4 }], Types.u64)
        const x = gn.addNode(g, gn.NodeOp.add, [a, scaled], Types.u64)
        const y = gn.addNode(g, gn.NodeOp.add, [b, scaled], Types.u64)
        const value = gn.addNode(g, gn.NodeOp.xor, [x, y], Types.u64)
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [a, b, i], bodyId: ret, bodyConst: 0 }])
        const listing = lowerValueGraph(g).listing
        const fused = listing.split('lsl #4').length - 1
        if (fused < 2 && !listing.includes('lsl x')) harness.fail(`a shift shared by two adds must stay materialized unless both fuse it:\n${listing}`)
    })
    harness.test('internHashWrap', () => {
        const g = gn.createGraph({})
        const table = new Map<number, number>()
        const mask = 0x7fffffff
        const prefix = (gn.NodeOp.add * 31 + gn.encodeType(Types.u32)) * 31 * 31
        const a = Math.floor((mask - prefix) / 31)
        const b = mask - prefix - a * 31
        const intern = (x: number, y: number) => gn.internNode(g, table, gn.NodeOp.add, [gn.literalSlot(g, x), gn.literalSlot(g, y)], Types.u32)
        const first = intern(a, b)
        const second = intern(a - 1, b + 31)
        if (first === second || table.get(mask) !== first || table.get(0) !== second
            || intern(a, b) !== first || intern(a - 1, b + 31) !== second) {
            harness.fail('interning must resolve collisions across the hash wraparound')
        }
        const slots = Array.from({ length: 128 }, (_, i) => gn.literalSlot(g, i * 17))
        const wide = gn.internNode(g, table, gn.NodeOp.record, slots)
        if (gn.internNode(g, table, gn.NodeOp.record, slots.slice()) !== wide) harness.fail('long interned nodes must share')
        slots[127] = gn.literalSlot(g, -1)
        if (gn.internNode(g, table, gn.NodeOp.record, slots) === wide) harness.fail('long interned nodes must compare every operand')
    })
    function codecRequest(reps: Map<number, Rep>, params: Rep[], returns: Rep, abi: native.UnitAbi): native.CodecRequest {
        return { reps, params, returns, abi, codecs: new Map(), slices: new Map(), pointers: new Set(), encoded: new Set(), calls: new Map(), tracked: new Map(), fieldTags: new Map(), tagWrites: new Map(), wordWrites: new Map() }
    }
    harness.test('realizeWordsStandalone', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const p = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const join = gn.addNode(g, gn.NodeOp.block, [])
        const q = gn.addNode(g, gn.NodeOp.param, [], Types.vm_value)
        const enter = gn.addNode(g, gn.NodeOp.apply, [join, p])
        const ret = gn.addNode(g, gn.NodeOp.ret, [q, join])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [p], bodyId: enter, bodyConst: 0 }, { id: join, params: [q], bodyId: ret, bodyConst: 0 }])
        const int: Rep = { text: 'i64', kind: 'number', format: { bits: 64, signed: true }, targets: [], nullable: false }
        const word: Rep = { text: 'str?', kind: 'union', targets: ['str'], nullable: true }
        native.realizeWords(g, codecRequest(new Map([[p, int], [q, word]]), [int], word, { mode: 'keep', returns: Types.vm_value, tags: [] }))
        const boxed = gn.getNode(g, gn.getRef(gn.getNode(g, enter)!, 1))
        if (boxed?.op !== gn.NodeOp.box || gn.getRef(boxed, 0) !== p) harness.fail(`an i64 arriving at a union-word param must be boxed: ${gn.getRef(gn.getNode(g, enter)!, 1)}`)
        if (gn.getRef(gn.getNode(g, ret)!, 0) !== q) harness.fail('a union word returned as a word must pass through')
        lowerValueGraph(g)
    })
    harness.test('realizeTagsStandalone', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const p = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const ret = gn.addNode(g, gn.NodeOp.ret, [p, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [p], bodyId: ret, bodyConst: 0 }])
        const maybe: Rep = { text: 'int?', kind: 'number', format: { bits: 32, signed: false }, targets: [], nullable: true }
        const request = codecRequest(new Map([[p, maybe]]), [maybe], maybe, { mode: 'tagged', returns: Types.u64, tags: [0] })
        request.tracked.set(p, true)
        native.realizeWords(g, request)
        native.realizeTags(g, request)
        const params = g.blocks[0].params
        const pair = gn.getNode(g, gn.getRef(gn.getNode(g, ret)!, 0))
        if (params.length !== 2 || pair?.op !== gn.NodeOp.record || gn.getRef(pair, 1) !== p || gn.getRef(pair, 3) !== params[1]) harness.fail('a tagged nullable param must gain a tag param and return a payload/tag record')
        if (lowerValueGraph(g).words.length !== 1) harness.fail('the payload and tag params already sit in the return registers')
    })
    harness.test('realizeSlicesStandalone', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const data = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
        const index = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const token = gn.addNode(g, gn.NodeOp.startOf, [])
        const read = gn.addNode(g, gn.NodeOp.rt, [token, { literal: rt.Op.sliceRead }, data, index, { literal: Types.vm_value }])
        const ret = gn.addNode(g, gn.NodeOp.ret, [read, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [data, index], bodyId: ret, bodyConst: 0 }])
        const float: Rep = { text: 'f64', kind: 'number', targets: [], nullable: false }
        native.realizeSlices(g, new Map([[read, float]]), new Map([[read, float]]), undefined)
        const load = gn.getNode(g, read)!
        const at = gn.getNode(g, gn.getRef(load, 2))
        if (load.op !== gn.NodeOp.load || gn.typeOf(load) !== Types.f64 || at?.op !== gn.NodeOp.mul || gn.getLiteral(g, at, 1) !== 8) harness.fail('an f64 slice must read raw 8-byte floats')
    })
    function rootGraph(params: intrinsics.Types[], body: (g: Graph, root: number, params: number[]) => number): Graph {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const ids = params.map(T => gn.addNode(g, gn.NodeOp.param, [], T))
        g.root = root
        const ret = body(g, root, ids)
        gn.setGraphBlocks(g, [{ id: root, params: ids, bodyId: ret, bodyConst: 0 }])
        return g
    }
    harness.test('retypeValuesStandalone', () => {
        let load = 0
        const g = rootGraph([Types.u64, Types.u64], (g, root, [a, b]) => {
            load = gn.addNode(g, gn.NodeOp.load, [gn.addNode(g, gn.NodeOp.startOf, []), b, { literal: 0 }], Types.u64)
            return gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.add, [a, load], Types.u64), root])
        })
        const [a] = g.blocks[0].params
        native.retypeValues(g, new Map([[a, Types.i64], [load, Types.ptr]]))
        if (gn.typeOf(gn.getNode(g, a)!) !== Types.i64 || gn.typeOf(gn.getNode(g, load)!) !== Types.ptr) harness.fail('retypeValues must retype exactly the given values')
    })
    harness.test('runtimeCallsStandalone', () => {
        let select = 0
        let ne = 0
        let sum = 0
        const g = rootGraph([Types.vm_value, Types.vm_value], (g, root, [a, b]) => {
            ne = gn.addNode(g, gn.NodeOp.ne, [a, b], Types.bool)
            sum = gn.addNode(g, gn.NodeOp.rt, [gn.addNode(g, gn.NodeOp.startOf, []), { literal: rt.Op.addOrConcat }, a, b])
            select = gn.addNode(g, gn.NodeOp.select, [a, ne, sum])
            return gn.addNode(g, gn.NodeOp.ret, [select, root])
        })
        const linked: rt.Op[] = []
        const moves = native.runtimeCalls(g, { bound: new Set([select, ne]), compares: new Set(), masks: new Map(), target: op => {
            linked.push(op)
            return 1000 + linked.length
        } })
        const test = gn.getNode(g, gn.getRef(gn.getNode(g, select)!, 0))
        if (test?.op !== gn.NodeOp.call || gn.getNode(g, ne)?.op !== gn.NodeOp.eq || gn.getNode(g, sum)?.op !== gn.NodeOp.add) harness.fail('bound selects and compares become runtime calls; unbound addOrConcat becomes add')
        if (linked.join() !== [rt.Op.strictEqual, rt.Op.truthy].join() || moves.moved.length !== 2 || moves.dropped.join() !== String(select)) harness.fail(`runtimeCalls must report its moved calls: ${JSON.stringify(moves)}`)
    })
    harness.test('indexArrayIterationsStandalone', () => {
        const key = (name: string) => heap.fromJsString(name)
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const array = gn.addNode(g, gn.NodeOp.param, [], Types.vm_value)
        const loop = gn.addNode(g, gn.NodeOp.block, [])
        const exit = gn.addNode(g, gn.NodeOp.block, [])
        const tok = gn.addNode(g, gn.NodeOp.startOf, [])
        const symbol = gn.addNode(g, gn.NodeOp.getProp, [tok, array, { literal: heap.fromJsSymbol(Symbol.iterator) }])
        const made = gn.addNode(g, gn.NodeOp.call, [tok, symbol, array])
        const next = gn.addNode(g, gn.NodeOp.getProp, [made, made, { literal: key('next') }])
        const enter = gn.addNode(g, gn.NodeOp.apply, [loop])
        const inLoop = gn.addNode(g, gn.NodeOp.startOf, [loop])
        const call = gn.addNode(g, gn.NodeOp.call, [inLoop, next, made])
        const done = gn.addNode(g, gn.NodeOp.getProp, [call, call, { literal: key('done') }])
        const value = gn.addNode(g, gn.NodeOp.getProp, [call, call, { literal: key('value') }])
        const select = gn.addNode(g, gn.NodeOp.select, [done, gn.addNode(g, gn.NodeOp.apply, [exit]), gn.addNode(g, gn.NodeOp.apply, [loop])])
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, exit])
        g.root = root
        gn.setGraphBlocks(g, [
            { id: root, params: [array], bodyId: enter, bodyConst: 0 },
            { id: loop, params: [], bodyId: select, bodyConst: 0 },
            { id: exit, params: [], bodyId: ret, bodyConst: 0 },
        ])
        const rewritten = native.indexArrayIterations(g, new Map([[symbol, 0 as intrinsics.Handle]]))
        const read = gn.getNode(g, value)!
        if (rewritten.length !== 1 || rewritten[0].next !== call || g.blocks[1].params[0] !== rewritten[0].index) harness.fail(`one iteration must be indexed by a new loop param: ${JSON.stringify(rewritten)}`)
        else if (read.op !== gn.NodeOp.getProp || gn.getRef(read, 1) !== array || gn.getRef(read, 2) !== rewritten[0].index) harness.fail('the iterated value must read the array at the index')
    })
    harness.test('functionObjectsStandalone', () => {
        const g = rootGraph([Types.u64], (g, root, [p]) => {
            const code = gn.addNode(g, gn.NodeOp.heapHandle, [{ literal: 77 }])
            const call = gn.addNode(g, gn.NodeOp.call, [gn.addNode(g, gn.NodeOp.startOf, []), gn.addNode(g, gn.NodeOp.heapHandle, [{ literal: 88 }]), { literal: 0 }, p])
            return gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.after, [call, code]), root])
        })
        const ret = g.blocks[0].bodyId
        const after = gn.getRef(gn.getNode(g, ret)!, 0)
        native.functionObjectValues(g, new Map([[after, [1]]]), new Map([[77, 99 as intrinsics.Handle]]))
        native.functionObjectCalls(g, new Map([[88, 66 as intrinsics.Handle]]))
        native.substituteConstantParams(g, new Map([[0, { literal: 5 }]]))
        const object = gn.getNode(g, gn.getRef(gn.getNode(g, after)!, 1))!
        const call = gn.getNode(g, gn.getRef(gn.getNode(g, after)!, 0))!
        const target = gn.getNode(g, gn.getRef(call, 1))!
        const arg = gn.getNode(g, gn.getRef(call, 3))!
        if (gn.getLiteral(g, object, 0) !== 99 || gn.getLiteral(g, target, 0) !== 66 || arg.op !== gn.NodeOp.literal || gn.getLiteral(g, arg, 0) !== 5) harness.fail('function objects, call code and constant params must follow the given maps')
    })
    function unitGraph(name: string, space: Graph | undefined, params: intrinsics.Types[], body: (g: Graph, root: number, params: number[]) => number): Graph {
        const g = gn.createGraph(space ? { ids: space.ids, literals: space.literals, name } : { name })
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const ids = params.map(T => gn.addNode(g, gn.NodeOp.param, [], T))
        g.root = root
        const ret = body(g, root, ids)
        gn.setGraphBlocks(g, [{ id: root, params: ids, bodyId: ret, bodyConst: 0 }])
        return g
    }
    function twoUnits(callee: (g: Graph, root: number, params: number[]) => number, arity: number, args: (g: Graph, x: number) => gn.Operand[]): { program: native.ProgramGraph, caller: Graph, callee: Graph, call: number } {
        let call = 0
        const caller = unitGraph('caller', undefined, [Types.u64], (g, root, [x]) => {
            call = gn.addNode(g, gn.NodeOp.call, [gn.addNode(g, gn.NodeOp.startOf, []), gn.addNode(g, gn.NodeOp.localTarget, [{ literal: 2 }], Types.u64), { literal: 0 }, ...args(g, x)])
            return gn.addNode(g, gn.NodeOp.ret, [call, root])
        })
        const unit = unitGraph('callee', caller, Array.from({ length: arity }, () => Types.u64), callee)
        const program = { units: new Map([[1, caller], [2, unit]]), roots: new Map(), noInline: new Set(), alwaysInline: new Set(), constructors: new Set(), unplanned: new Set(), tagged: new Set(), abi: new Map(), hostReturns: new Map(), image: undefined, target: hostTarget } as any as native.ProgramGraph
        return { program, caller, callee: unit, call }
    }
    harness.test('signatureRewritesStandalone', () => {
        const touched = new Set<number>()
        const pruned = twoUnits((g, root, [a]) => gn.addNode(g, gn.NodeOp.ret, [a, root]), 2, (g, x) => [x, { literal: 7 }])
        native.pruneArgs(pruned.program, 2, new Set([1]), [[1, pruned.call]], touched)
        if (pruned.callee.blocks[0].params.length !== 1 || gn.countIds(gn.getNode(pruned.caller, pruned.call)!) !== 4) harness.fail('pruneArgs must drop the dead param and its args')
        const forwarded = twoUnits((g, root, [a]) => gn.addNode(g, gn.NodeOp.ret, [a, root]), 1, (g, x) => [x])
        native.forwardArg(forwarded.program, 2, 0, [[1, forwarded.call]], touched)
        const site = gn.getNode(forwarded.caller, forwarded.call)!
        const returned = gn.getNode(forwarded.callee, gn.getRef(gn.getNode(forwarded.callee, forwarded.callee.blocks[0].bodyId)!, 0))!
        if (site.op !== gn.NodeOp.after || gn.getRef(site, 1) !== forwarded.caller.blocks[0].params[0] || returned.op !== gn.NodeOp.void) harness.fail('forwardArg must hand the caller its own arg and void the return')
        let product = 0
        const shared = twoUnits((g, root, [a, b]) => {
            product = gn.addNode(g, gn.NodeOp.mul, [a, { literal: 3 }], Types.u64)
            return gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.add, [product, b], Types.u64), root])
        }, 2, (g, x) => [x, { literal: 7 }])
        const twin = gn.addNode(shared.caller, gn.NodeOp.mul, [shared.caller.blocks[0].params[0], { literal: 3 }], Types.u64)
        native.shareValues(shared.program, 2, new Map([[product, [twin]]]), [[1, shared.call]], touched)
        native.bindParams(shared.callee, new Map([[shared.callee.blocks[0].params[1], { literal: 7 }]]))
        const sum = gn.getNode(shared.callee, gn.getRef(gn.getNode(shared.callee, shared.callee.blocks[0].bodyId)!, 0))!
        const lifted = shared.callee.blocks[0].params[2]
        if (gn.getRef(gn.getNode(shared.caller, shared.call)!, 5) !== twin || gn.getRef(sum, 0) !== lifted || gn.getRef(sum, 1) || gn.getLiteral(shared.callee, sum, 1) !== 7) harness.fail('shareValues must pass the twin as a new param; bindParams must fold the literal param')
        if ([...touched].join() !== '2,1') harness.fail(`rewrites must report touched units: ${[...touched]}`)
    })
    harness.test('memoryRewritesStandalone', () => {
        let load = 0
        const hoisted = twoUnits((g, root, [p]) => {
            load = gn.addNode(g, gn.NodeOp.load, [gn.addNode(g, gn.NodeOp.startOf, []), p, { literal: 8 }], Types.u64)
            return gn.addNode(g, gn.NodeOp.ret, [load, root])
        }, 1, (g, x) => [x])
        native.hoistParamLoads(hoisted.program, { callee: 2, specialize: false, loads: [load], sites: [[1, hoisted.call]] }, new Set())
        const copied = gn.getNode(hoisted.caller, gn.getRef(gn.getNode(hoisted.caller, hoisted.call)!, 4))!
        const end = gn.getNode(hoisted.callee, hoisted.callee.blocks[0].bodyId)!
        if (copied.op !== gn.NodeOp.load || gn.getRef(copied, 1) !== hoisted.caller.blocks[0].params[0] || gn.getRef(end, 0) !== hoisted.callee.blocks[0].params[1]) harness.fail('hoistParamLoads must move the load into the caller')
        const state = twoUnits((g, root, [p]) => {
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const old = gn.addNode(g, gn.NodeOp.load, [nil, p, { literal: 0 }], Types.u64)
            const stored = gn.addNode(g, gn.NodeOp.store, [old, p, { literal: 0 }, gn.addNode(g, gn.NodeOp.add, [old, { literal: 1 }], Types.u64)], Types.u64)
            return gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.after, [stored, gn.addNode(g, gn.NodeOp.void, [])]), root])
        }, 1, (g, x) => [x])
        native.scalarizeState(state.program, { callee: 2, index: 0, fields: [[0, Types.u64]], outputs: [[0, Types.u64]], result: false, sites: [[1, state.call]] }, new Set())
        const scalar = gn.getNode(state.callee, state.callee.blocks[0].params[0])!
        const record = gn.getNode(state.callee, gn.getRef(gn.getNode(state.callee, state.callee.blocks[0].bodyId)!, 0))!
        if (state.callee.blocks[0].params.length !== 1 || gn.typeOf(scalar) !== Types.u64 || record.op !== gn.NodeOp.record || gn.getNode(state.caller, state.call)!.op !== gn.NodeOp.after) harness.fail('scalarizeState must pass the field in and out by value')
        let allocation = 0
        let store = 0
        let ret = 0
        let read = 0
        const records = twoUnits((g, root) => {
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            allocation = gn.addNode(g, gn.NodeOp.pstack, [nil, 0, 0, { literal: 8 }])
            store = gn.addNode(g, gn.NodeOp.store, [allocation, allocation, { literal: 0 }, { literal: 5 }], Types.u64)
            ret = gn.addNode(g, gn.NodeOp.ret, [allocation, root])
            return ret
        }, 0, () => [])
        const caller = records.caller
        read = gn.addNode(caller, gn.NodeOp.load, [records.call, records.call, { literal: 0 }], Types.u64)
        gn.setGraphBlocks(caller, [{ ...caller.blocks[0], bodyId: gn.addNode(caller, gn.NodeOp.ret, [read, caller.root]) }])
        const flow = (source: [number, number][], reads: [number, string][], exits: [number, number][]) => ({ source: new Map(source), reads: new Map(reads), inner: new Map(), stores: new Map(), exits, accessed: new Set<number>() })
        const own = flow([[allocation, allocation]], [], [[ret, 0]])
        own.stores.set(`${allocation}/0`, [[store, 0]])
        own.accessed.add(allocation)
        native.recordReturn(records.program, { callee: 2, own, allocations: [allocation], layout: new Map([['0', [0, Types.u64]]]), inner: new Map(), callers: [[1, flow([[records.call, records.call]], [[read, '0']], [])]] }, symbol => gn.graphIndex(records.program.units.get(symbol)!), new Set())
        const pair = gn.getNode(records.callee, gn.getRef(gn.getNode(records.callee, records.callee.blocks[0].bodyId)!, 0))!
        const field = gn.getNode(caller, gn.getRef(gn.getNode(caller, read)!, 1))!
        if (pair.op !== gn.NodeOp.record || field.op !== gn.NodeOp.get || gn.getRef(field, 0) !== records.call) harness.fail('recordReturn must return the fields as a record and read them with get')
    })
    harness.test('placeObjectsStandalone', () => {
        const session = createTraceSession()
        const runtime = session.enterTrace()
        defer finally {
            session.leaveTrace()
        }
        const key = heap.fromJsString('x')
        const layout = heap.makeObject(0 as intrinsics.Handle)
        heap.setProperty(layout, key, heap.boxF64(0) as intrinsics.Handle)
        let read = 0
        const g = gn.createGraph({ ids: runtime.ids, literals: runtime.literals, name: 'placed' })
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const object = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        read = gn.addNode(g, gn.NodeOp.getProp, [gn.addNode(g, gn.NodeOp.startOf, []), object, { literal: key }])
        const ret = gn.addNode(g, gn.NodeOp.ret, [read, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [object], bodyId: ret, bodyConst: 0 }])
        const codecs: native.Facts = new Map([[layout, new Map<string, native.Codec>([['0', { kind: 'int', encoded: false, type: Types.i64 }]])]])
        const placed = propertyEval.placeObjects(g, { session, frames: new Map(), params: new Map([[0, layout]]), layouts: { codecs, fixedCodecs: new Set([layout]) } })
        const value = gn.getNode(placed.graph, gn.getRef(gn.getNode(placed.graph, ret)!, 0))!
        const load = value.op === gn.NodeOp.after ? gn.getNode(placed.graph, gn.getRef(value, gn.countIds(value) - 1))! : value
        if (load.op !== gn.NodeOp.load || gn.getRef(load, 1) !== object || gn.getLiteral(placed.graph, load, 2) !== 0 || gn.typeOf(load) !== Types.i64) harness.fail(`a field read of a laid-out param must load at the layout offset: ${gn.opName(load.op)}`)
    })
    harness.test('exportedStaticBlockBinding', () => {
        intrinsics.assert(typeof loweringRepros.tallyCount === 'function', 'a static block assignment must reach the exported binding')
    })
    harness.test('undefinedOperand', () => {
        const natives: any = native.createNatives({ undefinedOperand })
        const got = [natives.undefinedOperand(5), natives.undefinedOperand(200)]
        if (got[0] !== 9 || got[1] !== 9) harness.fail(`repro undefinedOperand FAILED: ${got.join(',')}, expected 9,9 (an undefined operand is assume-unreachable)`)
        else console.log('repro undefinedOperand ok')
    })
    const compileFailures: [Function, string][] = [
        [unionWordLength, 'unionWordLength reads a property of an opaque value'],
        [dynWrittenKeys, 'uses a computed key on a memory object without an index trap'],
        [dynBadKeyTuple, 'uses a computed key on a memory object without an index trap'],
        [dynMixedKeys, 'reads through a key tuple whose fields lay out differently'],
        [dynWrittenKey, 'is read with a computed key through its companion array, but compiled code writes it'],
        [typedBitsFloat, 'accesses it as 10'],
    ]
    for (const [fn, expected] of compileFailures) {
        harness.test(fn.name, () => {
            let message = ''
            try {
                native.createNatives({ [fn.name]: fn })
            } catch (e) {
                message = String(e).split('\n')[0]
            }
            if (!message.includes(expected)) harness.fail(`repro ${fn.name} FAILED: ${message || 'compiled'}, expected a compile error with ${JSON.stringify(expected)}`)
            else console.log(`repro ${fn.name} ok (expected compile failure: ${message})`)
        })
    }
}
