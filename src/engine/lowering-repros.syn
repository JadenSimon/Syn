        for (const [name, fn] of [['setHasForeign', setHasForeign], ['mapGetForeign', mapGetForeign], ['setHasWider', setHasWider], ['setFromArraySize', setFromArraySize], ['setFromArrayHas', setFromArrayHas]] as const) {
