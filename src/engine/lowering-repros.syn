        s.push(n + 1)
        return s.top() + s.items.length
    }
    cases.push([stackSwap, [3]])
    function setIterationZeroKey(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        const prev = new Map<number, number>()
        for (const [block, successors] of next) {
            for (const successor of successors) prev.set(successor, (prev.get(successor) ?? 0) + block)
        }
        return prev.size * 100 + (prev.get(0) ?? 99)
    }
    cases.push([setIterationZeroKey, [2], [7]])
    function nullableOperandText(n: u32): string {
        const g = gn.createGraph()
        const p = gn.addNode(g, gn.NodeOp.param, [])
        const id = gn.addNode(g, gn.NodeOp.heapHandle, gn.heapHandleOperands(g, 64, n + 1, [1, 2], [p, { literal: n }]))
        const handle = gn.getNode(g, id)!
        const field = gn.heapField(g, handle, 1 + n % 3)
        return typeof field === 'number' ? `%${field}` : `#${field ? field.literal : 99}`
    }
    cases.push([nullableOperandText, [0], [1], [2]])
    function optionalInto(n: u32): number {
        const created: number[] = []
        let nilId = 7
        function nil(): number {
            if (created.length > 40) nilId = created.length
            return nilId
        }
        function join(values: number[], into?: number): number {
            if (const u = values.find(x => x === 99)) return u
            const sink = into && into !== nilId ? into : undefined
            const parts: number[] = []
            for (const x of values) {
                if (x > 7 && !parts.includes(x)) parts.push(x)
            }
            if (!parts.length) return into ?? nil()
            if (parts.length === 1) {
                if (!sink) return parts[0]
                created.push(parts[0], sink)
                return 100 + created.length
            }
            if (sink !== undefined) parts.push(sink)
            created.push(...parts)
            return 100 + created.length
        }
        function step(id: number): number {
            if (id <= 0) return join([7, 7])
            if (id % 3 === 0) return join([step(id - 1), id + 8], id)
            return join([step(id - 1), 7])
        }
        const a = join([7, 7])
        const b = step(n)
        const c = join([], n + 1)
        return a * 1000000 + b * 1000 + c + created.length * 100000000
    }
    cases.push([optionalInto, [1], [5]])
    const armExponents = [1, 2.5, 3]
    function armPair(x: number): number[] {
        return [x, x * 3]
    }
    function armLow(x: number): number {
        return armPair(x)[0] + 1
    }
    function armHigh(x: number): number {
        return armPair(x)[1] + 2
    }
    function sharedPowerArms(op: u32, x: u32): number {
        let base = x
        if (op === 7) base = armLow(base + 1)
        const m = 2 ** armExponents[armPair(base)[0] % 3]
        if (op === 1) return armLow(x) * m
        if (op === 3) return 3 ** armExponents[x % 3]
        return Math.floor(armHigh(x) / m)
    }
    cases.push([sharedPowerArms, [1, 5], [2, 7], [3, 1], [7, 2]])
    function loopClosureMapSelf(n: u32): number {
        const children = new Map<number, number[]>()
        let i = 1
        while (i < n) {
            const list = children.get(i >> 1)
            if (list) list.push(i)
            else children.set(i >> 1, [i])
            i++
        }
        let sum = 0
        for (const root of [0, 1]) {
            function weigh(id: number): number {
                const extra = children.get(id)
                const parts = id % 2 ? extra?.map(weigh) : extra?.map(weigh)
                let total = id + root
                for (const part of parts ?? []) total += part
                return total
            }
            sum += weigh(root)
        }
        return sum
    }
    cases.push([loopClosureMapSelf, [4], [9]])
    function templateValueNames(n: u32): string {
