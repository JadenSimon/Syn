    harness.test('presizedRowsRelease', () => {
        const natives: any = native.createNatives({ presizedPointsRepeated })
        const stacks: number[] = []
        for (let stack = 0; stack < stackCount; stack++) stacks.push(stack)
        const marks = stacks.map(stack => native.pstackMark(stack))
        const value = Number(natives.presizedPointsRepeated(1000))
        const growth = Math.max(...stacks.map((stack, i) => Number(native.pstackMark(stack) - marks[i])))
        stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
        if (value !== presizedPointsRepeated(1000)) harness.fail(`presizedPointsRepeated(1000) returned ${value}, expected ${presizedPointsRepeated(1000)}`)
        if (growth > 32768) harness.fail(`a presized row built inside a callee must be released per call, the loop kept ${growth} pstack bytes`)
    })
