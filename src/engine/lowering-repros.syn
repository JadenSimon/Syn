        return s.size * 1000000 + order
    }
    cases.push([setFromDuplicateValues, [1]])
    function emptySources(n: u32): number {
        const pairs: [number, number][] = []
        const values: number[] = []
        const a = new Map(pairs)
        const b = new Map(new Map<number, number>())
        const c = new Set(values)
        const d = new Set(new Set<number>())
        a.set(n, 1)
        b.set(n, 2)
        c.add(n)
        d.add(n + 1)
        return a.size + b.size * 10 + c.size * 100 + d.size * 1000 + a.get(n)! * 10000 + b.get(n)! * 100000 + (d.has(n + 1) ? 1000000 : 0)
    }
    cases.push([emptySources, [1]])
    function iterableSources(n: u32): number {
        let steps = 0
        const pairs = {
            [Symbol.iterator]() {
                let i = 0
                return {
                    next() {
                        steps++
                        if (i >= 5) return { done: true, value: [0, 0] as [number, number] }
                        i++
                        return { done: false, value: [i % 3 + n, i] as [number, number] }
                    },
                }
            },
        }
        const values = {
            [Symbol.iterator]() {
                let i = 0
                return {
                    next() {
                        steps += 10
                        if (i >= 5) return { done: true, value: 0 }
                        i++
                        return { done: false, value: i % 3 + n }
                    },
                }
            },
        }
        const m = new Map(pairs)
        const s = new Set(values)
        return steps * 10000 + m.size * 1000 + s.size * 100 + m.get(n + 1)! * 10 + (s.has(n + 2) ? 1 : 0)
    }
