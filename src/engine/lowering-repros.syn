        const natives: any = native.createNatives({ copiedSources })
        if (Number(natives.copiedSources(3)) !== copiedSources(3)) harness.fail(`copiedSources(3) = ${natives.copiedSources(3)}, expected ${copiedSources(3)}`)
    }, stdout => {
        const planned = stdout.split('\n').filter(line => /^PLAN (InstanceofOperator|OrdinaryHasInstance) planned=[1-9]/.test(line))
        if (planned.length) harness.fail(`new Map(pairs), new Map(map), new Set(array) and new Set(set) each pass the ctor one kind of source, so every instanceof in the ctor folds and nothing calls InstanceofOperator:\n${planned.join('\n')}`)
