        const flow = (source: [number, number][], reads: [number, string][], exits: [number, number][]) => ({ source: new Map(source), reads: new Map(reads), inner: new Map(), stores: new Map(), exits, accessed: new Set<number>() })
        const own = flow([[allocation, allocation]], [], [[ret, 0]])
        own.stores.set(`${allocation}/0`, [[store, 0]])
        own.accessed.add(allocation)
        native.recordReturn(records.program, { callee: 2, own, allocations: [allocation], layout: new Map([['0', [0, Types.u64]]]), inner: new Map(), callers: [[1, flow([[records.call, records.call]], [[read, '0']], [])]] }, symbol => gn.graphIndex(records.program.units.get(symbol)!), new Set())
        const pair = gn.getNode(records.callee, gn.getRef(gn.getNode(records.callee, records.callee.blocks[0].bodyId)!, 0))!
        const field = gn.getNode(caller, gn.getRef(gn.getNode(caller, read)!, 1))!
        if (pair.op !== gn.NodeOp.record || field.op !== gn.NodeOp.get || gn.getRef(field, 0) !== records.call) harness.fail('recordReturn must return the fields as a record and read them with get')
    })
    harness.test('placeObjectsStandalone', () => {
        const session = createTraceSession()
        const runtime = session.enterTrace()
        defer finally {
            session.leaveTrace()
        }
        const key = heap.fromJsString('x')
        const layout = heap.makeObject(0 as intrinsics.Handle)
        heap.setProperty(layout, key, heap.boxF64(0) as intrinsics.Handle)
        let read = 0
        const g = gn.createGraph({ ids: runtime.ids, literals: runtime.literals, name: 'placed' })
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const object = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        read = gn.addNode(g, gn.NodeOp.getProp, [gn.addNode(g, gn.NodeOp.startOf, []), object, { literal: key }])
        const ret = gn.addNode(g, gn.NodeOp.ret, [read, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [object], bodyId: ret, bodyConst: 0 }])
        const codecs: native.Facts = new Map([[layout, new Map<string, native.Codec>([['0', { kind: 'int', encoded: false, type: Types.i64 }]])]])
        const placed = propertyEval.placeObjects(g, { session, frames: new Map(), params: new Map([[0, layout]]), layouts: { codecs, fixedCodecs: new Set([layout]) } })
        const value = gn.getNode(placed.graph, gn.getRef(gn.getNode(placed.graph, ret)!, 0))!
        const load = value.op === gn.NodeOp.after ? gn.getNode(placed.graph, gn.getRef(value, gn.countIds(value) - 1))! : value
        if (load.op !== gn.NodeOp.load || gn.getRef(load, 1) !== object || gn.getLiteral(placed.graph, load, 2) !== 0 || gn.typeOf(load) !== Types.i64) harness.fail(`a field read of a laid-out param must load at the layout offset: ${gn.opName(load.op)}`)
    })
    harness.test('exportedStaticBlockBinding', () => {
        intrinsics.assert(typeof loweringRepros.tallyCount === 'function', 'a static block assignment must reach the exported binding')
    })
    harness.test('undefinedOperand', () => {
        const natives: any = native.createNatives({ undefinedOperand })
        const got = [natives.undefinedOperand(5), natives.undefinedOperand(200)]
        if (got[0] !== 9 || got[1] !== 9) harness.fail(`repro undefinedOperand FAILED: ${got.join(',')}, expected 9,9 (an undefined operand is assume-unreachable)`)
        else console.log('repro undefinedOperand ok')
    })
    const compileFailures: [Function, string][] = [
        [unionWordLength, 'unionWordLength reads a property of an opaque value'],
        [dynWrittenKeys, 'uses a computed key on a memory object without an index trap'],
        [dynBadKeyTuple, 'uses a computed key on a memory object without an index trap'],
        [dynMixedKeys, 'reads through a key tuple whose fields lay out differently'],
        [dynWrittenKey, 'is read with a computed key through its companion array, but compiled code writes it'],
        [spreadUnionSource, 'calls assignImpl, which the plan never entered'],
        [spreadStringSource, 'calls assignImpl, which the plan never entered'],
    ]
    for (const [fn, expected] of compileFailures) {
        harness.test(fn.name, () => {
            let message = ''
            try {
                native.createNatives({ [fn.name]: fn })
            } catch (e) {
                message = String(e).split('\n')[0]
            }
            if (!message.includes(expected)) harness.fail(`repro ${fn.name} FAILED: ${message || 'compiled'}, expected a compile error with ${JSON.stringify(expected)}`)
            else console.log(`repro ${fn.name} ok (expected compile failure: ${message})`)
        })
    }
    harness.test('heapFlatRecompile', () => {
        const live: number[] = []
        const misses: number[] = []
        let i = 0
        while (i < 6) {
            const natives: any = native.createNatives({ heapFlatWork })
            const got = natives.heapFlatWork(3)
            if (got !== 33) harness.fail(`repro heapFlatRecompile FAILED: got ${got}, expected 33`)
            live.push(intrinsics.heapStats().live)
            misses.push(traceStats.finalizeMisses)
            i++
        }
        const grown = live[5] - live[1]
        const materialized = misses[5] - misses[1]
        if (materialized > 0) harness.fail(`repro heapFlatRecompile FAILED: 4 recompiles of the same function materialized ${materialized} bytecode functions again (host heap +${grown} bytes)`)
        else console.log(`repro heapFlatRecompile ok (host heap +${grown} bytes over 4 recompiles)`)
    })
    harness.test('nullishForOf', () => {
        const references = { nullishForOf, guardedForOf }
        const natives: any = native.createNatives(references)
        for (const [name, reference] of Object.entries(references)) {
            for (const n of [0, 1, 2, 3, 9, 31]) {
                const expected = reference(n)
                const actual = Number(natives[name](n))
                if (actual !== expected) harness.fail(`${name}(${n}) returned ${actual}, expected ${expected}`)
            }
        }
    })
    harness.test('heapStaticsRecompile', () => {
        const session = createTraceSession()
        function compileGrowth(): number {
            const before = intrinsics.heapStats().live
            const natives: any = native.createNatives({ heapFlatWork })
            const grown = intrinsics.heapStats().live - before
            const got = natives.heapFlatWork(3)
            if (got !== 33) harness.fail(`repro heapStaticsRecompile FAILED: got ${got}, expected 33`)
            return grown
        }
        compileGrowth()
        const few = compileGrowth()
        const held: Map<number, number>[] = []
        let i = 0
        while (i < 256) {
            const map = new Map<number, number>()
            held.push(map)
            session.fromJsValue(map)
            i++
        }
        compileGrowth()
        const many = compileGrowth()
        if (many > few) harness.fail(`repro heapStaticsRecompile FAILED: one recompile grew the host heap ${few} bytes, then ${many} bytes after 256 more host statics`)
        else console.log(`repro heapStaticsRecompile ok (host heap +${many} bytes per recompile)`)
    })
