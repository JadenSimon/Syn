        Intrinsics.store(p, 0, v, Types.u32)
        return Intrinsics.load(p, 0, Types.u32) + box.k
    }

    function floatSlotWordLoad(n: u32): number {
        const p = Intrinsics.pstack(1, 0, 8)
        Intrinsics.store(p, 0, n + 0.75, Types.f64)
        const bits = Intrinsics.load(p, 0, Types.u64)
        return Math.floor(bits / 17592186044416)
    }
    function floatSlotOf(v: number): number {
        const p = Intrinsics.pstack(1, 0, 8)
        Intrinsics.store(p, 0, v, Types.f64)
        return p
    }
    function calleeFloatSlot(n: u32): number {
        const p = floatSlotOf(n + 0.75)
        return Math.floor(Intrinsics.load(p, 0, Types.u64) / 17592186044416)
    }
    function typedFloatBits(n: u32): number {
        const bits = new BigUint64Array(new Float64Array([n + 0.75]).buffer)[0]
        return Number(bits >> BigInt(44))
    }
    function typedBitsFloat(n: u32): number {
        const floats = new Float64Array(1)
        const words = new BigUint64Array(floats.buffer)
        words[0] = BigInt(n + 1023) << BigInt(52)
        return floats[0] + n
    }
    function dataViewFloatBits(n: u32): number {
        const view = new DataView(new ArrayBuffer(8))
        view.setFloat64(0, n + 0.75, true)
