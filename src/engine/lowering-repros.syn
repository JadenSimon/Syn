    function mapFromPairsPresized(n: u32): number {
        const pairs: [number, number][] = []
        for (let i: u32 = 0; i < 64; i++) pairs.push([i * 3 + n, i])
        const before = intrinsics.isNative() ? stackTops() : 0
        const m = new Map(pairs)
        const used = intrinsics.isNative() ? stackTops() - before : 0
        return m.size * 1000 + m.get(n + 9)! + (used > presizedBytes(64, 2) ? 1000000 : 0)
    }
    cases.push([mapFromPairsPresized, [1]])
    function mapFromMapPresized(n: u32): number {
        const source = new Map<number, number>()
        for (let i: u32 = 0; i < 80; i++) source.set(i * 5 + n, i)
        for (let i: u32 = 0; i < 80; i += 5) source.delete(i * 5 + n)
        const before = intrinsics.isNative() ? stackTops() : 0
        const m = new Map(source)
        const used = intrinsics.isNative() ? stackTops() - before : 0
        let order = 0
        for (const [key, value] of m) order = (order * 3 + key + value) % 1000003
        return m.size * 1000000 + order + (m.has(n) ? 7 : 0) + (used > presizedBytes(64, 2) ? 100000000 : 0)
    }
    cases.push([mapFromMapPresized, [1]])
    function setFromArrayPresized(n: u32): number {
        const values: number[] = []
        for (let i: u32 = 0; i < 64; i++) values.push(i * 7 + n)
        const before = intrinsics.isNative() ? stackTops() : 0
        const s = new Set(values)
        const used = intrinsics.isNative() ? stackTops() - before : 0
        return s.size * 10 + (s.has(n + 14) ? 1 : 0) + (used > presizedBytes(64, 1) ? 1000000 : 0)
    }
    cases.push([setFromArrayPresized, [1]])
    function setFromSetPresized(n: u32): number {
        const source = new Set<number>()
