        const objects = stdout.split('\n').filter(line => line.startsWith('PRIVATE ')).join(' ')
        const refused = ['bumpThenRead', 'bumpUnlessPinned'].filter(name => state.includes(` ${name}:`) || objects.includes(` ${name}:0=`))
