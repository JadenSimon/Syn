        }
        const listing = unitListing(natives, 'pickPairLoop')
        if (/add x\d+, sp, #|\bentry\b/.test(listing)) harness.fail(`pickPairLoop: pickFromPair only reads the pair, so the pair is passed as its fields and never allocated:\n${listing}`)
    }, 'aarch64')
    harness.test('privateParamBoundary', () => {
        const natives: any = native.createNatives({ keepThirdLoop })
        for (const n of [0, 3, 4, 9]) {
            if (Number(natives.keepThirdLoop(n)) !== keepThirdLoop(n)) harness.fail(`keepThirdLoop(${n}) = ${natives.keepThirdLoop(n)}, expected ${keepThirdLoop(n)}`)
        }
        const loop = unitListing(natives, 'keepThirdLoop')
        const callee = natives.keepThirdLoop.units.find((unit: any) => unit.name === 'keepOnThird')?.code.listing ?? ''
        const branch = callee.search(/\b(b\.\w+|cbz|cbnz|tbz|tbnz)\b/)
        const allocation = callee.search(/\bentry\b/)
        if (/add x\d+, sp, #|\bentry\b/.test(loop) || allocation < 0 || branch < 0 || branch > allocation) harness.fail(`keepThirdLoop: the pair is passed as its fields and keepOnThird allocates it only on the path that stores it:\n${loop}\n${callee}`)
    }, 'aarch64')
    harness.flagged('privateParamsRefused', ['hoist-stats', 'record-returns'], () => {
