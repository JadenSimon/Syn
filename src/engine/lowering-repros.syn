    function iterHeader(n: u32): number {
        const blocks: number[][] = []
        let b: u32 = 0
        while (b < n + 3) {
            blocks.push(b + 1 < n + 3 ? [b + 1, b % 3 === 2 ? b - 2 : b] : [0])
            b++
        }
        const tailTargets = new Map<number, number[]>()
        b = 0
        while (b < blocks.length) {
            const into: number[] = []
            for (const t of blocks[b]) into.push(t)
            tailTargets.set(b, into)
