    function dynDecode(n: u32): { opcode: u32, opname: string, reads: boolean, writes: boolean, regs: number[] } {
        const inst = { opcode: n, opname: dynOpNames[n] ?? 'X', reads: false, writes: false, regs: [] as number[] }
        if (n === 2) {
            inst.reads = true
            inst.regs.push(n)
