            allocation = gn.addNode(g, gn.NodeOp.pstack, [nil, 0, 0, { literal: 8 }])
            store = gn.addNode(g, gn.NodeOp.store, [allocation, allocation, { literal: 0 }, { literal: 5 }], Types.u64)
