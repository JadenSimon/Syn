    harness.test('assertedDivisionStaysInteger', () => {
        const natives: any = native.createNatives({ quarterOf, poolIndex })
        for (const name of ['quarterOf', 'poolIndex']) {
            const listing = natives[name].units.map((unit: any) => unit.code.listing).join('\n')
            if (/\bd1[67]\b|\bscvtf\b|\bfdiv\b|\bucvtf\b/.test(listing)) harness.fail(`${name}: an asserted exact division must stay integer:\n${listing}`)
        }
        if (Number(natives.quarterOf(12)) !== 3 || Number(natives.poolIndex(7, 3)) !== 2) harness.fail(`quarterOf(12) = ${natives.quarterOf(12)}, poolIndex(7, 3) = ${natives.poolIndex(7, 3)}`)
    }, 'aarch64')
    harness.test('floorDivisionStaysInteger', () => {
        const natives: any = native.createNatives({ floorPoolCells, truncSigned, assertedFloorCells })
        for (const name of ['floorPoolCells', 'truncSigned', 'assertedFloorCells']) {
            const listing = natives[name].units.map((unit: any) => unit.code.listing).join('\n')
            if (/\bd1[67]\b|\bscvtf\b|\bfdiv\b|\bucvtf\b/.test(listing)) harness.fail(`${name}: a truncated or non-negative floored division by a proven-nonzero divisor must stay integer:\n${listing}`)
        }
        if (Number(natives.truncSigned(3, 1)) !== -3) harness.fail(`truncSigned(3, 1) = ${natives.truncSigned(3, 1)}`)
        if (Number(natives.assertedFloorCells(100, 3)) !== 13 || Number(natives.assertedFloorCells(7, 1)) !== 1) harness.fail(`assertedFloorCells(100, 3) = ${natives.assertedFloorCells(100, 3)}, assertedFloorCells(7, 1) = ${natives.assertedFloorCells(7, 1)}`)
        if (Number(natives.floorPoolCells(100, 3)) !== 12 || Number(natives.floorPoolCells(7, 1)) !== 0) harness.fail(`floorPoolCells(100, 3) = ${natives.floorPoolCells(100, 3)}, floorPoolCells(7, 1) = ${natives.floorPoolCells(7, 1)}`)
    }, 'aarch64')
    harness.test('signedPowerWindow', () => {
        const natives: any = native.createNatives({ windowHashed, windowInlined, windowFlippedInlined, unsignedWindowInlined })
        for (const [name, k] of [['windowHashed', 30], ['windowInlined', 30], ['windowFlippedInlined', 27]] as [string, number][]) {
            const listing: string = natives[name].units.find((unit: any) => unit.name === name).code.listing
            const window = new RegExp(`asr (x\\d+), (x\\d+), #${k}\\n.*cmp \\1, \\2, asr #63\\n`)
            if (!window.test(listing) || /\bccmp\b|\bmovz? x1[67]\b/.test(listing)) harness.fail(`${name}: a signed window [-2^${k}, 2^${k}) must test (x >> ${k}) == (x >> 63) with asr + cmp asr #63:\n${listing}`)
        }
        const texts = ['-1073741825', '-1073741824', '1073741823', '1073741824', '-134217729', '-134217728', '134217727', '134217728', '0', '-1', '-9223372036854775808', '9223372036854775807']
        const values = new BigInt64Array(texts.map(v => BigInt(v)))
        const ptr = Number((ts as any).getArrayBufferPtr(values.buffer))
        const hashes = new Map([['-1073741825', 1644379477], ['-1073741824', 2607071920], ['1073741823', 1172300371], ['1073741824', 2162406425], ['0', 0], ['-1', 3736805603], ['-9223372036854775808', 1544773862], ['9223372036854775807', 2980832198]])
        const within = (v: bigint, k: number) => v >= -BigInt(2 ** k) && v < BigInt(2 ** k)
        for (let i = 0; i < values.length; i++) {
            const v = values[i]
            const got = [natives.windowInlined(ptr, i), natives.windowFlippedInlined(ptr, i), natives.unsignedWindowInlined(ptr, i)].map(Number)
            const want = [within(v, 30) ? 1 : 2, within(v, 27) ? 3 : 4, BigInt.asUintN(64, v) < BigInt(2 ** 30) ? 1 : 2]
            if (got.join() !== want.join()) harness.fail(`signed window(${v}): ${got.join()}, expected ${want.join()}`)
            const hash = hashes.get(texts[i])
            if (hash !== undefined && Number(natives.windowHashed(ptr, i)) !== hash) harness.fail(`windowHashed(${v}) = ${natives.windowHashed(ptr, i)}, expected ${hash}`)
        }
    }, 'aarch64')
    harness.test('registerEffectsFromWords', () => {
        const cases: [word: number, reads: number[], writes: number[]][] = [
            [0xf8617809, [0, 1], [9]], [0xeb89fc1f, [0, 9], []], [0x935efd20, [9], [0]], [0xfa500120, [9, 16], []],
            [0xf2585d3f, [9], []], [0x9a830040, [2, 3], [0]], [0x1ac94be0, [9], [0]], [0x9e620120, [9], [32]],
            [0x9e660000, [32], [0]], [0xf2bd14a0, [0], [0]], [0xd2a80011, [], [17]], [0x1e602240, [50, 32], []],
            [0xf85f8063, [3], [3]], [0x9b110520, [9, 17, 1], [0]], [0x5cfff7a0, [], [32]], [0x1e610c00, [32, 33], [32]],
            [0xfd000592, [12, 50], []], [0xa9409c69, [3], [9, 7]], [0xa9001466, [3, 6, 5], []], [0xa9bd7bf3, [19, 30], []],
            [0xa8c37bf3, [], [19, 30]], [0xd65f03c0, [30], []],
        ]
        for (const [word, reads, writes] of cases) {
            const effects = aarch64RegisterEffects(word)
            const text = (list: number[]) => [...list].sort((a, b) => a - b).join()
            if (!effects || text(effects[0]) !== text(reads) || text(effects[1]) !== text(writes)) harness.fail(`register effects of ${word.toString(16)}: ${effects ? `reads ${effects[0]} writes ${effects[1]}` : 'unknown'}, expected reads ${reads} writes ${writes}`)
        }
    })
    harness.test('unsignedHighBits', () => {
        const natives: any = native.createNatives({ highBitsBranch, highBitsFlag, highBitsPick, highBitsNarrow, highBitsBetween })
        for (const [name, mask, use] of [['highBitsBranch', -(2 ** 30), /\bb\.(?:eq|ne)\b/], ['highBitsFlag', -(2 ** 24), /\bcset x\d+, ne\b/], ['highBitsPick', -(2 ** 40), /\bcsel x\d+, x\d+, x\d+, eq\b/], ['highBitsNarrow', -(2 ** 16), /\bcset x\d+, ne\b/], ['highBitsBetween', -(2 ** 40), /\bmovz x16, #256, lsl #16\n.*ccmp x\d+, x16, #0, eq\n.*(?:b\.(?:lo|hs)|csel x\d+, x\d+, x\d+, (?:lo|hs))\b/]] as [string, number, RegExp][]) {
            const listing: string = natives[name].units.find((unit: any) => unit.name === name).code.listing
            if (!new RegExp(`tst x\\d+, #${mask}\\n`).test(listing) || !use.test(listing) || /\bmovz? x17\b/.test(listing)) harness.fail(`${name}: an unsigned compare against 2^k must test the high bits with tst #${mask}, not materialize 2^k:\n${listing}`)
        }
        const wide = new BigUint64Array(['1073741823', '1073741824', '16777215', '16777216', '1099511627775', '1099511627776', '0', '9223372036854775808', '18446744073709551615'].map(v => BigInt(v)))
        const wideAt = Number((ts as any).getArrayBufferPtr(wide.buffer))
        const hashes = new Map([['1073741823', 1172300371], ['16777215', 4089040750], ['16777216', 1996959894], ['0', 0]])
        for (let i = 0; i < wide.length; i++) {
            const v = wide[i]
            const got = [natives.highBitsBranch(wideAt, i), natives.highBitsFlag(wideAt, i), natives.highBitsPick(wideAt, i, 11, 22), natives.highBitsBetween(wideAt, i)].map(Number)
            const want = [v < BigInt(2 ** 30) ? hashes.get(v.toString()) : 7, v >= BigInt(2 ** 24) ? 1 : 0, (v <= BigInt(2 ** 40 - 1) ? 11 : 22) + i, v <= BigInt(2 ** 40 - 1) && v >= BigInt(2 ** 24) ? 5 : 9]
            if (got.join() !== want.join()) harness.fail(`unsigned high bits(${v}): ${got.join()}, expected ${want.join()}`)
        }
        const narrow = new Uint32Array([0xffff, 0x10000, 0, 0xffffffff])
        const narrowAt = Number((ts as any).getArrayBufferPtr(narrow.buffer))
        for (let i = 0; i < narrow.length; i++) {
            if (Number(natives.highBitsNarrow(narrowAt, i)) !== (narrow[i] > 0xffff ? 1 : 0)) harness.fail(`highBitsNarrow(${narrow[i]}) = ${natives.highBitsNarrow(narrowAt, i)}`)
        }
    }, 'aarch64')
    harness.test('negativeAddImmediate', () => {
        const natives: any = native.createNatives({ upperBytes })
        const listing: string = natives.upperBytes.units.find((unit: any) => unit.name === 'upperBytes').code.listing
        if (!/\bsub x\d+, x\d+, #32\n/.test(listing) || /\bmovn x17\b/.test(listing)) harness.fail(`upperBytes: adding -32 must select sub #32, not materialize -32:\n${listing}`)
        const bytes = new Uint8Array([0, 31, 32, 64, 96, 97, 98, 121, 122, 123, 160, 255])
        const want = bytes.map(b => b >= 97 && b <= 122 ? b - 32 : b)
        natives.upperBytes(Number((ts as any).getArrayBufferPtr(bytes.buffer)), bytes.length)
        if (bytes.join() !== want.join()) harness.fail(`upperBytes: ${bytes.join()}, expected ${want.join()}`)
    }, 'aarch64')
    harness.test('joinValueHome', () => {
        const natives: any = native.createNatives({ rangeSums })
        for (const n of [0, 3, 9]) {
            if (Number(natives.rangeSums(n)) !== rangeSums(n)) harness.fail(`rangeSums(${n}) = ${natives.rangeSums(n)}, expected ${rangeSums(n)}`)
        }
        const listing = unitListing(natives, 'rangeSums')
        if (/ldrsw (x\d+), \[[^\]]*\]\nL:\n\s*\d+: [0-9a-f]{8}\s+mov x\d+, \1\n/.test(listing)) harness.fail(`rangeSums: a join value whose block only widens it for the loop header must arrive in the header's register, not move there:\n${listing}`)
    }, 'aarch64')
    harness.test('copiedJoinValue', () => {
        const natives: any = native.createNatives({ levelScan })
        for (const n of [1, 3, 9]) {
            if (Number(natives.levelScan(n)) !== levelScan(n)) harness.fail(`levelScan(${n}) = ${natives.levelScan(n)}, expected ${levelScan(n)}`)
        }
        const listing = unitListing(natives, 'levelScan')
        if (/ldrsw (x\d+), \[[^\]]*\]\nL:\n\s*\d+: [0-9a-f]{8}\s+mov x\d+, \1\n/.test(listing)) harness.fail(`levelScan: a join value widened for its own block must stay in the register its arms wrote:\n${listing}`)
    }, 'aarch64')
    harness.test('negatedShiftedOperand', () => {
        const natives: any = native.createNatives({ negScaledSlot })
        const listing: string = natives.negScaledSlot.units.find((unit: any) => unit.name === 'negScaledSlot').code.listing
        if (!/\bsub x\d+, x\d+, x\d+, lsl #2\n/.test(listing) || /\bneg\b/.test(listing)) harness.fail(`negScaledSlot: a dead neg feeding a shifted add must fold into sub ..., lsl #2:\n${listing}`)
        const memory = new BigInt64Array(64)
        const words = new Uint32Array(memory.buffer)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        const founds = [-1, 0, 5, 20, -10]
        founds.forEach((found, i) => memory[i] = BigInt(found))
        founds.forEach((found, i) => natives.negScaledSlot(ptr, i, 100 + i))
        founds.forEach((found, i) => {
            const at = (256 + (-found - 1) * 4) / 4
            if (words[at] !== 100 + i) harness.fail(`negScaledSlot(${found}): word ${at} = ${words[at]}, expected ${100 + i}:\n${listing}`)
        })
    }, 'aarch64')
    harness.test('negateSelect', () => {
        for (const swapped of [false, true]) {
            const asm = hostTarget.createAssembler()
            asm.load(11, 0, 0, Types.i64)
            asm.compareImm('lt', 3, 11, 0, true)
            asm.unary('neg', 9, 11)
            if (swapped) asm.select(10, 3, 11, 9)
            else asm.select(10, 3, 9, 11)
            asm.released([{ value: 0, home: 9 }, { value: 1, home: 11 }])
            asm.store(0, 8, 10, Types.i64)
            asm.store(0, 16, 3, Types.i64)
            asm.ret()
            const listing = asm.listing()
            if (!new RegExp(`cneg x10, x11, ${swapped ? 'ge' : 'lt'}\\n`).test(listing) || /\bneg\b/.test(listing) || !/\bcset x3, lt\b/.test(listing)) harness.fail(`negate select ${swapped}: a dead neg feeding csel must become cneg, keeping the cset:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            const memory = new BigInt64Array(3)
            const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
            for (const v of [-(BigInt(2) ** BigInt(63)), BigInt(-5), BigInt(-1), BigInt(0), BigInt(1), BigInt(5), BigInt(2) ** BigInt(63) - BigInt(1)]) {
                memory[0] = v
                run(ptr)
                const negative = v < BigInt(0)
                const want = BigInt.asIntN(64, negative !== swapped ? -v : v)
                if (memory[1] !== want || memory[2] !== BigInt(negative ? 1 : 0)) harness.fail(`negate select ${swapped}(${v}): ${memory[1]}, ${memory[2]}, expected ${want}, ${negative ? 1 : 0}:\n${listing}`)
            }
        }
    }, 'aarch64')
    harness.test('slackWidenedFill', () => {
        const natives: any = native.createNatives({ slackFill, slackFillKept })
        const listing: string = natives.slackFill.units.find((unit: any) => unit.name === 'slackFillTable').code.listing
        if (!/\bstp xzr, xzr, \[x\d+\], #16\b/.test(listing)) harness.fail(`slackFillTable: a zero fill that ends 16+ bytes before the end of its fresh allocation stores 16 bytes per iteration:\n${listing}`)
        for (const n of [0, 1, 2, 3, 5, 8, 17]) {
            const actual = Number(natives.slackFill(n))
            if (actual !== n) harness.fail(`slackFill(${n}): ${actual}, expected ${n}`)
            const kept = Number(natives.slackFillKept(n))
            if (kept !== 7) harness.fail(`slackFillKept(${n}): ${kept}, expected 7: a store into the slack before the fill must survive`)
        }
    }, 'aarch64')
    harness.test('fusedHashBranch', () => {
        const natives: any = native.createNatives({ probeHashed, mapProbeSum, slotMatches })
        for (const [fn, name] of [[natives.probeHashed, 'probeHashed'], [natives.slotMatches, 'slotMatches']]) {
            const listing: string = fn.units.find((unit: any) => unit.name === name).code.listing
            if (/\b(?:tst|cmp)\b.*\n.*\bcset\b.*\n.*\b(?:tbz|tbnz|cbz|cbnz|b\.\w+)\b/.test(listing)) harness.fail(`${name}: a cset only feeding a branch fuses into b.cond:\n${listing}`)
        }
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        const table = new Uint32Array(8)
        const key = new BigUint64Array(1)
        for (const k of [BigInt(5), BigInt(2) ** BigInt(31) + BigInt(7)]) {
            key[0] = k
            table.fill(0)
            const miss = natives.probeHashed(ptr(table), 7, ptr(key))
            if (miss < -8 || miss > -1) harness.fail(`probeHashed miss(${k}): ${miss}`)
            table.fill(Number(k))
            const hit = natives.probeHashed(ptr(table), 7, ptr(key))
            if (hit !== Number(k)) harness.fail(`probeHashed hit(${k}): ${hit}`)
        }
        const words = new BigUint64Array([BigInt(3), BigInt(0), BigInt(3), BigInt(9)])
        for (const [i, want, expected] of [[0, 3, false], [0, 4, false], [2, 3, true], [2, 4, false]]) {
            const got = natives.slotMatches(ptr(words), i, want)
            if (Boolean(got) !== expected) harness.fail(`slotMatches(${i}, ${want}): ${got}, expected ${expected}`)
        }
        for (const n of [0, 1, 2, 5, 40]) {
            const got = natives.mapProbeSum(n)
            const want = n * (n - 1) / 2 - (n > 1 ? 1 : 0)
            if (got !== want) harness.fail(`mapProbeSum(${n}): ${got}, expected ${want}`)
        }
    }, 'aarch64')
    harness.test('threadedKnownArrival', () => {
        const natives: any = native.createNatives({ probeWithHoles })
        const listing: string = natives.probeWithHoles.units.find((unit: any) => unit.name === 'probeWithHoles').code.listing
        const known = knownArrivals(listing)
        if (known.length) harness.fail(`probeWithHoles: an arrival that sets the register a join branches on takes the decided arm directly:\n${known.join('\n')}\n${listing}`)
        const keys = new BigInt64Array([5, 13, 21, 7].map(k => BigInt(k)))
        const table = new Uint32Array(8)
        const holes = new Uint8Array(32)
        table[5] = 1
        table[6] = 2
        table[7] = 3
        table[0] = 4
        holes[16 + 1] = 1
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        for (const [key, withHoles, expected] of [[5, 0, 0], [13, 0, 1], [13, 1, -2], [21, 1, 2], [7, 1, 3], [7, 0, 3], [29, 0, -2], [29, 1, -2]]) {
            const actual = Number(natives.probeWithHoles(ptr(keys), ptr(table), 7, key, withHoles ? ptr(holes) : 0))
            if (actual !== expected) harness.fail(`probeWithHoles(${key}, ${withHoles}): ${actual}, expected ${expected}\n${listing}`)
        }
    }, 'aarch64')
    harness.test('readonlyStaticLength', () => {
        const natives: any = native.createNatives({ slotWidth, pokeWord })
        const listing: string = natives.slotWidth.units.find((unit: any) => unit.name === 'slotWidth').code.listing
        if (/\bldr [xw]\d+, \[x\d+, #\d+\]/.test(listing)) harness.fail(`slotWidth: the length and data of a static array that compiled code never writes fold, even when another unit stores through an unknown pointer:\n${listing}`)
        for (const [op, expected] of [[3, 1], [7, 2], [31, 1], [0, 0], [39, 0], [45, 0]]) {
            const got = Number(natives.slotWidth(op))
            if (got !== expected) harness.fail(`slotWidth(${op}): ${got}, expected ${expected}\n${listing}`)
        }
        const cell = new BigInt64Array(2)
        natives.pokeWord(Number((ts as any).getArrayBufferPtr(cell.buffer)), 9)
        if (cell[1] !== BigInt(9)) harness.fail(`pokeWord: ${cell[1]}, expected 9`)
    }, 'aarch64')
    harness.test('unsignedZeroSelect', () => {
        const natives: any = native.createNatives({ clampedStore, clampedSigned })
        const listing: string = natives.clampedStore.units.find((unit: any) => unit.name === 'clampedStore').code.listing
        if (/\b(?:csel|cmp|cbz|cbnz)\b/.test(listing)) harness.fail(`clampedStore: an unsigned v > 0 ? v : 0 is v:\n${listing}`)
        const memory = new BigUint64Array(5)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        for (const v of [BigInt(0), BigInt(1), BigInt(5), BigInt(2) ** BigInt(63), BigInt(2) ** BigInt(64) - BigInt(1)]) {
            memory[4] = v
            natives.clampedStore(ptr, 4)
            if (memory[1] !== v || memory[2] !== v || memory[3] !== v) harness.fail(`clampedStore(${v}): ${memory[1]}, ${memory[2]}, ${memory[3]}:\n${listing}`)
        }
        const signed = new BigInt64Array(memory.buffer)
        for (const v of [-(BigInt(2) ** BigInt(63)), BigInt(-5), BigInt(0), BigInt(7)]) {
            signed[4] = v
            natives.clampedSigned(ptr, 4)
            if (signed[1] !== (v > BigInt(0) ? v : BigInt(0))) harness.fail(`clampedSigned(${v}): ${signed[1]}`)
        }
    }, 'aarch64')
    harness.test('equalLengthReads', () => {
        const natives: any = native.createNatives({ equalLengthReads })
        const listing: string = natives.equalLengthReads.units.find((unit: any) => unit.name === 'equalLengthTables').code.listing
        const lengthLoads = listing.match(/\bldr x\d+, \[x0, #16\]/g)?.length ?? 0
        if (lengthLoads > 1) harness.fail(`edges.length is reloaded around constructor calls that cannot write it (${lengthLoads} loads):\n${listing}`)
        for (const n of [0, 1, 2, 5]) if (Number(natives.equalLengthReads(n)) !== equalLengthReads(n)) harness.fail(`equalLengthReads(${n}): ${natives.equalLengthReads(n)}, expected ${equalLengthReads(n)}`)
    }, 'aarch64')
    harness.test('farLengthReads', () => {
        const natives: any = native.createNatives({ farLengthReads })
        const listingOf = (name: string): string => natives.farLengthReads.units.find((unit: any) => unit.name === name).code.listing
        const lengthLoads = (listing: string): number => listing.match(/\bldr x\d+, \[x\d+, #0\]/g)?.length ?? 0
        const beyond = listingOf('lengthBeyondWindow')
        if (lengthLoads(beyond) !== 2) harness.fail(`xs.length is shared past the look-back window, across calls that keep it live (${lengthLoads(beyond)} loads):\n${beyond}`)
        const last = listingOf('lengthLastUse')
        if (lengthLoads(last) !== 1) harness.fail(`xs.length is reloaded although the reload is the last use of xs (${lengthLoads(last)} loads):\n${last}`)
        for (const n of [0, 1, 7]) if (Number(natives.farLengthReads(n)) !== farLengthReads(n)) harness.fail(`farLengthReads(${n}): ${natives.farLengthReads(n)}, expected ${farLengthReads(n)}`)
    }, 'aarch64')
    harness.test('negatedFloatLiteral', () => {
        const natives: any = native.createNatives({ farFloat })
        const listing: string = natives.farFloat.units.find((unit: any) => unit.name === 'farFloat').code.listing
        if ((listing.match(/\bmovz x16\b/g) ?? []).length !== 1 || !/\bfneg d\d+, d\d+\n/.test(listing)) harness.fail(`farFloat: -1e21 must be fneg of the 1e21 already in a register:\n${listing}`)
        const memory = new Float64Array(2)
        const flags = new Uint8Array(memory.buffer)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        const edge = 10 ** 21
        const below = edge - 131072
        for (const x of [edge, below, -edge, -below, 0, -0, NaN, Infinity, -Infinity, edge * 2, -edge * 2]) {
            memory[1] = x
            natives.farFloat(ptr, 1)
            if (flags[0] !== (x >= edge ? 1 : 0) || flags[1] !== (x <= -edge ? 1 : 0)) harness.fail(`farFloat(${x}): ${flags[0]}, ${flags[1]}:\n${listing}`)
        }
    }, 'aarch64')
    const factCase = (name: string, fn: (n: u32) => number, sites: string[], why: string) => harness.flagged(name, ['member-check'], () => {
        const natives: any = native.createNatives({ [fn.name]: fn })
        for (const n of [0, 5]) if (Number(natives[fn.name](n)) !== fn(n)) harness.fail(`${fn.name}(${n}) = ${natives[fn.name](n)}, expected ${fn(n)}`)
    }, stdout => {
        const lost = stdout.split('\n').filter(line => line.startsWith('MEMBER-LOST ') && sites.some(site => line.includes(site)))
        if (lost.length) harness.fail(`${why}:\n${lost.join('\n')}`)
    })
    factCase('memberFactsOfStaticReceivers', factStaticReceivers, ['@factStaticReceivers%'], 'a static object whose fields are never written after init passes its field values to the members that read them')
    factCase('memberFactsUnderParamTests', factParamTests, ['@factParamTests%', '@Array%'], 'a write behind a test of a constructor param the instance never takes is not part of the field type')
    factCase('memberFactsUnderIndexGuards', factIndexWrites, ['@arrayLiteral%'], 'index writes below the length never grow #length or #capacity')
    harness.flagged('instanceofNarrowsParam', ['flow-dump:sourceSize'], () => {
        const natives: any = native.createNatives({ narrowedSizes })
        for (const n of [1, 4]) if (Number(natives.narrowedSizes(n)) !== narrowedSizes(n)) harness.fail(`narrowedSizes(${n}) = ${natives.narrowedSizes(n)}, expected ${narrowedSizes(n)}`)
    }, stdout => {
        const returns = stdout.split('\n').filter(line => line.startsWith('  returns: ') && !line.endsWith('=> never'))
        if (returns.length !== 1 || !returns[0].endsWith('=> u64')) harness.fail(`x instanceof Map keeps only Maps in its true arm and drops them from its false arm, so neither .size nor .length reads undefined:\n${returns.join('\n')}`)
    })
