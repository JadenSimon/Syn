    function throwsError(n: u32): u32 {
        if (n > 3) throw new Error('boom')
        return n + 1
    }
    function throwsString(n: u32): u32 {
        if (n > 3) throw 'str'
        return n + 1
    }
    function throwsNumber(n: u32): u32 {
        if (n > 3) throw 42
        return n + 1
    }
    function throwingCallee(n: u32): u32 {
        if (n > 3) throw new Error(`deep ${n}`)
        return n * 2
    }
    ;(throwingCallee as any).shouldNotInline = true
    function leakStack0(n: u32): usize {
        let prev: usize = 0
        let i: u32 = 0
        while (i < n) {
            const p = Intrinsics.pstack(0, 0, 128)
            Intrinsics.store(p, 0, prev, Types.u64)
            Intrinsics.store(p, 8, i, Types.u32)
            prev = p
            i++
        }
        return prev
    }
    function verifyFailure(stage: string, id: number, reason: string): never {
        const error: any = new Error(`verify: ${stage}: %${id} ${reason}`)
        error.node = id
        throw error
    }
    function verifiesNode(n: u32): u32 {
        if (n > 3) verifyFailure('repro', n, 'is out of range')
        return n + 1
    }
    function throwsInCallee(n: u32): u32 {
        return throwingCallee(n) + 1
    }
    function throwingSibling(n: u32): u32 {
        if (n > 5) throw new Error('wide')
        return n * 3
    }
    ;(throwingSibling as any).shouldNotInline = true
    function throwsInEitherCallee(n: u32): u32 {
        return throwingCallee(n) + throwingSibling(n)
    }
    function trapsAbove(n: u32): u32 {
        if (n > 3) Intrinsics.trap(9)
        return n
    }
    ;(trapsAbove as any).shouldNotInline = true
    function dropsTrappingCall(n: u32): u32 {
        trapsAbove(n)
        return n + 1
    }
    function alwaysTraps(n: u32): u32 {
        Intrinsics.trap(11)
        return n
    }
    ;(alwaysTraps as any).shouldNotInline = true
    function wordFlagRoot(n: u32): boolean | number {
    if (n === 1) return true
    if (n === 2) return false
    return n
}

function cutLadder(n: u32): number {
    let a = n + 1
    let b = n * 3
    for (let i: u32 = 0; i < n; i++) {
        if ((i & 1) === 0) a = a + i * 3
        else b = b - i
        if (a > 1000) a = a % 97
        if (b < 5) b = b + 211
    }
    if (a > b) a = a - b
    else b = b - a
    for (let i: u32 = 0; i < 4; i++) {
        if (a % 3 === 0) a = a + 7
        else if (a % 3 === 1) b = b + a
        else a = a * 2 + 1
        if (b > 5000) b = b % 1013
    }
    return a * 31 + b
}

function optimizerRounds(stdout: string): string {
    return stdout.split('\n').filter(line => /^--- (optimize round \d+|\w+ changed B\d+) ---$/.test(line)).join('\n')
}

function optimizerSettles(stdout: string): boolean {
    let changed = false
    let started = false
    for (const line of stdout.split('\n')) {
        if (line === '--- optimize round 0 ---' && started && changed) return false
        if (line.startsWith('--- optimize round ')) {
            started = true
            changed = false
        } else if (/^--- \w+ changed B\d+ ---$/.test(line)) {
            changed = true
        }
    }
    return started && !changed
}

function twoReturns(n: u32): u32 {
    if (n > 3) return n * 2
    return n + 1
}

function mergeView(a: u32) {
    return { a }
}

function mergeAfterLift(n: u32, b: u32): u32 {
    let q = mergeView(n)
    if (n > 10) q = mergeView(b)
    return q.a
}

function wideCompares(x: u32, y: u32): u32 {
    return (x >= 3758096384 ? 1 : 0) + (y < 3758096384 ? 2 : 0)
}

function storesAfterNoreturn(p: usize, n: u32): u32 {
        Intrinsics.store(p, 0, n, Types.u32)
        const r = alwaysTraps(n)
        Intrinsics.store(p, 8, r, Types.u32)
        return r + n
    }
    function trapsThrough(n: u32): u32 {
        const r = alwaysTraps(n)
        return r * 3
    }
    ;(trapsThrough as any).shouldNotInline = true
    function storesAfterTrapsThrough(p: usize, n: u32): u32 {
        Intrinsics.store(p, 0, n, Types.u32)
        const r = trapsThrough(n)
        Intrinsics.store(p, 8, r, Types.u32)
        return r + n
    }
    function catchesThrow(n: u32): u32 {
        try {
            if (n > 3) throw new Error('caught')
            return n
        } catch (e) {
            return 100
        }
    }
    function setsStringLength(n: u32): u32 {
        const a = [n, n + 1]
        const value: any = n > 3 ? 'aa' : 1
        a.length = value
        return a.length
    }
    cases.push([throwsError, [2]], [throwsString, [2]], [throwsNumber, [2]], [throwsInCallee, [2]], [catchesThrow, [2], [5]], [setsStringLength, [2]])
    function floatIntoU32(n: u32): number {
        const words = new Float64Array(4)
        let k = 0
        while (k < 4) {
            words[k] = n * 3 + k
            k++
        }
        const read = (at: number) => words[at]
        const slots = new Uint32Array(2)
        let i = 0
        while (i < 2) {
            slots[i] = read((n + i) & 3)
            i++
        }
        return slots[0] * 100 + slots[1]
    }
    cases.push([floatIntoU32, [3], [4]])
    function floatTupleRead(k: number): number {
        const xs = [2.5, { x: 1 }]
        xs[1] = k
        const r = xs[1]
        return typeof r === 'number' ? r : r.x
    }
    function floatTupleWrite(n: number, k: number): number {
        const xs = [2.5, { x: 1 }]
        const ys = [k, { x: 3 }]
        xs[1] = ys[n]
        const r = xs[1]
        return typeof r === 'number' ? r : r.x
    }
    cases.push([floatTupleRead, [9]], [floatTupleWrite, [0, 9], [1, 9]])
    function embeddedSetterReceiver(n: u32): number {
        const holder = new ListHolder()
