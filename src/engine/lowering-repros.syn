    const table = [0, 0, 0, 4, 0, 0, 1, 1, 1, 3, 2, 1]
    for (let i = 0; i < 4; i++) {
        Intrinsics.store(p, i * 24, table[i * 3], Types.u32)
        Intrinsics.store(p, i * 24 + 4, table[i * 3 + 1], Types.u32)
        Intrinsics.store(p, i * 24 + 8, table[i * 3 + 1], Types.u32)
        Intrinsics.store(p, i * 24 + 12, table[i * 3 + 1], Types.u32)
        Intrinsics.store(p, i * 24 + 16, table[i * 3 + 2], Types.u32)
    }
    return producesAt(p, n & 3) ? 1 : 0
}

function boundedChain(p: number): number {
    const v = Intrinsics.load(p, 0, Types.i64)
    const w = Intrinsics.load(p, 8, Types.u64) === 1 ? Intrinsics.load(p, 16, Types.i64) : v
    if (w !== v || w < 0 || w > 0xffffffff) throw 'out of range'
