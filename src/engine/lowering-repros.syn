        function findLoops(root: number, within?: Set<number>, header = 0): void {
            const index = new Map<number, number>()
            const low = new Map<number, number>()
            const open: number[] = []
            function connect(v: number): void {
                index.set(v, index.size)
                low.set(v, index.get(v)!)
                open.push(v)
                for (const w of tailTargets.get(v)!) {
                    if (w === header || (within && !within.has(w))) continue
                    if (!index.has(w)) {
