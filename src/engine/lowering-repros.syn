let plainFriend: (n: number) => number = n => n
plainFriend = n => n * 2

class Tally {
    #count: number
    #slots: number[]

    constructor(n: number) {
        this.#count = n
        this.#slots = [n, n + 1]
    }

    static {
        function bump(this: Tally, k: number): number {
            this.#count = this.#count + k
            return this.#count
        }
        function getSlot(this: Tally, index: number): any {
            if (index >= this.#slots.length) return undefined
            return this.#slots[index] * 10
        }
        function setSlot(this: Tally, index: number, value: any): void {
            this.#slots[index] = value
            this.#count = this.#count + 1
        }
        (Tally.prototype as any).bump = bump
        Object.setPrototypeOf(Tally.prototype, intrinsics.setIndexDescriptor({}, getSlot, setSlot))
        peekTally = tally => tally.#count
        tallyCount = tally => tally.#count + tally.#slots.length
        registerTallyHook('first', () => 1)
        registerTallyHook('second', () => 2)
    }
}

sameValue(Tally)

