        native.retypeValues(g, new Map([[a, Types.i64], [load, Types.ptr]]))
        if (gn.typeOf(gn.getNode(g, a)!) !== Types.i64 || gn.typeOf(gn.getNode(g, load)!) !== Types.ptr) harness.fail('retypeValues must retype exactly the given values')
