        try {
            native.serializeImage(natives)
        } catch (e) {
            harness.fail(`two [[Init]] statics store through one table address: ${String(e).split('\n')[0]}`)
        }
    })
    harness.test('literalLoopHoists', () => {
        const natives: any = native.createNatives({ literalPairs })
        const listing: string = natives.literalPairs.units.find((unit: any) => unit.name === 'literalPairs').code.listing
        if (/\b(?:ldr|str|ldp|stp)\b/.test(listing)) harness.fail(`literalPairs: a loop whose blocks have spare params must hoist all its invariant loads, so the literals fold:\n${listing}`)
        for (const n of [0, 3, 9]) if (Number(natives.literalPairs(n)) !== literalPairs(n)) harness.fail(`literalPairs(${n}) = ${natives.literalPairs(n)}, expected ${literalPairs(n)}`)
    }, 'aarch64')
    harness.test('chainedGuardBounds', () => {
        const natives: any = native.createNatives({ boundedChain })
        const listing: string = natives.boundedChain.units.find((unit: any) => unit.name === 'boundedChain').code.listing
        if (/#11\b/.test(listing)) harness.fail(`boundedChain: a || b || c guards must bound the value on the fallthrough path:\n${listing}`)
        const data = new BigInt64Array([BigInt(5), BigInt(0), BigInt(7)])
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        if (Number(natives.boundedChain(ptr(data))) !== 22) harness.fail(`boundedChain(5) = ${natives.boundedChain(ptr(data))}`)
    }, 'aarch64')
    harness.test('rangeCheckOffset', () => {
        const natives: any = native.createNatives({ rangeWide, rangeUnsigned, rangeNarrow, signedBand })
        for (const name of ['rangeWide', 'rangeUnsigned', 'rangeNarrow', 'signedBand']) {
            const listing: string = natives[name].units.find((unit: any) => unit.name === name).code.listing
            const window = name === 'signedBand' ? /\badd (x\d+), x\d+, #40\n.*cmp \1, #37\n/ : /\bsub (x\d+), x\d+, #97\n.*cmp \1, #25\n/
            if (!window.test(listing) || /\bccmp\b/.test(listing)) harness.fail(`${name}: lo <= x && x <= hi must test x - lo <= hi - lo unsigned:\n${listing}`)
        }
        const two = BigInt(2)
        const between = (v: bigint, lo: number, hi: number) => v >= BigInt(lo) && v <= BigInt(hi)
        const digit = (v: bigint) => {
            const d = between(v, 48, 57) ? Number(v) - 48 : between(v, 97, 122) ? Number(v) - 87 : between(v, 65, 90) ? Number(v) - 55 : 80
            return d < 80 ? d : -1
        }
        const edges = [0, 47, 48, 57, 58, 64, 65, 90, 91, 96, 97, 122, 123]
        const wide = new BigInt64Array([...edges, -1, -41, -40, -3, -2].map(v => BigInt(v)).concat([-(two ** BigInt(63)), two ** BigInt(63) - BigInt(1)]))
        const wideAt = Number((ts as any).getArrayBufferPtr(wide.buffer))
        wide.forEach((v, i) => {
            if (Number(natives.rangeWide(wideAt, i)) !== digit(v)) harness.fail(`rangeWide(${v}) = ${natives.rangeWide(wideAt, i)}, expected ${digit(v)}`)
            const band = between(v, 48, 57) ? Number(v) - 48 : between(v, -40, -3) ? 70 : 99
            if (Number(natives.signedBand(wideAt, i)) !== band) harness.fail(`signedBand(${v}) = ${natives.signedBand(wideAt, i)}, expected ${band}`)
        })
        const unsigned = new BigUint64Array(edges.map(v => BigInt(v)).concat([two ** BigInt(32), two ** BigInt(63), two ** BigInt(64) - BigInt(1), two ** BigInt(64) - BigInt(40)]))
        const unsignedAt = Number((ts as any).getArrayBufferPtr(unsigned.buffer))
        unsigned.forEach((v, i) => {
            if (Number(natives.rangeUnsigned(unsignedAt, i)) !== digit(v)) harness.fail(`rangeUnsigned(${v}) = ${natives.rangeUnsigned(unsignedAt, i)}, expected ${digit(v)}`)
        })
        const narrow = new Uint32Array([...edges, 2 ** 31, 2 ** 32 - 1, 2 ** 32 - 40])
        const narrowAt = Number((ts as any).getArrayBufferPtr(narrow.buffer))
        narrow.forEach((v, i) => {
            if (Number(natives.rangeNarrow(narrowAt, i)) !== digit(BigInt(v))) harness.fail(`rangeNarrow(${v}) = ${natives.rangeNarrow(narrowAt, i)}, expected ${digit(BigInt(v))}`)
        })
    }, 'aarch64')
    harness.test('constantKeyHashFolds', () => {
        const natives: any = native.createNatives({ maybeKeyHash })
        const listing = natives.maybeKeyHash.units.map((unit: any) => unit.code.listing).join('\n')
        if ((listing.match(/\bcrc32w\b/g) ?? []).length !== 1 || !/#12538\b/.test(listing) || !/#59557\b/.test(listing)) harness.fail(`maybeKeyHash: the undefined key's hash must fold to the literal 3903140090 (raw CRC-32 of 17), leaving one crc32w for the small-int key:\n${listing}`)
        const got = [natives.maybeKeyHash(0, 1), natives.maybeKeyHash(7, 0)].map(Number)
        if (got.join() !== '3903140090,2648127673') harness.fail(`maybeKeyHash results ${got.join()}, expected 3903140090,2648127673`)
    }, 'aarch64')
    harness.test('loopHoistParamOrderFree', () => {
        const natives: any = native.createNatives({ relayHoists })
        const listingOf = (name: string): string => natives.relayHoists.units.find((unit: any) => unit.name === name)?.code.listing ?? ''
        const shape = (name: string) => listingOf(name)
            .split('\n')
            .filter((line: string) => /^\s*\d+: [0-9a-f]{8} /.test(line))
            .map((line: string) => line.replace(/^\s*\d+: [0-9a-f]{8}\s+/, '').replace(/\b[xw]\d+\b/g, 'r').replace(/\bL\d+\b/g, 'L'))
            .join('\n')
        const ab = shape('relayHoistAB')
        const ba = shape('relayHoistBA')
        if (!ab || !ba) harness.fail(`relayHoistAB and relayHoistBA must stay separate units:\n${natives.relayHoists.units.map((unit: any) => unit.name).join(', ')}`)
        else if (ab !== ba) harness.fail(`relayHoistAB and relayHoistBA differ only in parameter order, so their loops must hoist the same values:\n${ab}\n---\n${ba}`)
        if (Number(natives.relayHoists(5)) !== relayHoists(5)) harness.fail(`relayHoists(5) = ${natives.relayHoists(5)}, expected ${relayHoists(5)}`)
    }, 'aarch64')
    harness.test('cheapReturnArmFallsThrough', () => {
        const natives: any = native.createNatives({ scaledSum })
        for (const name of ['scaledOrPlain', 'plainOrScaled']) {
            const listing: string = natives.scaledSum.units.find((unit: any) => unit.name === name).code.listing
            if (listing.indexOf('ret') > listing.indexOf('udiv')) harness.fail(`${name}: the cheap a + 1 return must fall through, with the rem/mul arm after the first ret:\n${listing}`)
        }
        if (Number(natives.scaledSum(1010)) !== 601150) harness.fail(`scaledSum(1010) = ${natives.scaledSum(1010)}, expected 601150`)
    }, 'aarch64')
    harness.test('expensiveSelectArmsBranch', () => {
        const natives: any = native.createNatives({ hashedSlot })
        const listing = natives.hashedSlot.units.map((unit: any) => unit.code.listing).join('\n')
        if (/\bcsel\b/.test(listing) || !/\bucvtf\b/.test(listing)) harness.fail(`hashedSlot: the wide-key hash (ucvtf + crc32x) must branch, not run on every key and csel:\n${listing}`)
        const got = [natives.hashedSlot(7, 0xffffffff), natives.hashedSlot(2 ** 40, 0xffffffff)].map(Number)
        if (got.join() !== '2648127673,3085785418') harness.fail(`hashedSlot results ${got.join()}, expected 2648127673,3085785418`)
        const looped: any = native.createNatives({ hashedSum })
        const loopListing: string = looped.hashedSum.units.find((unit: any) => unit.name === 'hashedSum').code.listing
        const tail = loopListing.slice(loopListing.lastIndexOf('ret'))
        if (/\bcsel\b/.test(loopListing) || !/\bucvtf\b/.test(tail)) harness.fail(`hashedSum: the wide-key hash must sit out of line after the return, with the small-key hash straight-line in the loop:\n${loopListing}`)
        if (Number(looped.hashedSum(4, 0xffff)) !== 87966) harness.fail(`hashedSum(4, 0xffff) = ${looped.hashedSum(4, 0xffff)}, expected 87966`)
    }, 'aarch64')
    harness.test('movnComparePriced', () => {
        const natives: any = native.createNatives({ clampedGrowths })
        const growth = natives.clampedGrowths.units.find((unit: any) => unit.name === 'clampedGrowth').code.listing
        if (/\bmovk x\d+, #32767\b/.test(growth)) harness.fail(`clampedGrowth compares n * 2 + 4 with 0xffffffff, one movn; solving it to n > 0x7ffffffd needs movz + movk:\n${growth}`)
        for (const n of [0, 7, 3, 0x7ffffffd, 0x7ffffffe, 0xffffffff]) if (Number(natives.clampedGrowths(n)) !== clampedGrowths(n)) harness.fail(`clampedGrowths(${n}) = ${natives.clampedGrowths(n)}, expected ${clampedGrowths(n)}`)
    }, 'aarch64')
    harness.test('tableMaskNonnegative', () => {
        const natives: any = native.createNatives({ tableMasks })
        const listing = natives.tableMasks.units.find((unit: any) => unit.name === 'tableMaskOf').code.listing
        if (/#99\b/.test(listing)) harness.fail(`tableCapacity starts at 8 and only doubles below its maximum, so capacity - 1 is never negative:\n${listing}`)
        for (const n of [0, 1, 7, 100, 5000]) if (Number(natives.tableMasks(n)) !== tableMasks(n)) harness.fail(`tableMasks(${n}) = ${natives.tableMasks(n)}, expected ${tableMasks(n)}`)
    }, 'aarch64')
    harness.test('selectsShareCompare', () => {
        const natives: any = native.createNatives({ splitTally })
        const listing = natives.splitTally.units.find((unit: any) => unit.name === 'splitTally').code.listing
        const compares = listing.match(/\bcmp x\d+, #0\b/g) ?? []
        if (compares.length !== 1) harness.fail(`splitTally's two counters select on one condition, so one compare sets the flags for both:\n${listing}`)
        for (const n of [0, 7, 20]) if (Number(natives.splitTally(n)) !== splitTally(n)) harness.fail(`splitTally(${n}) = ${natives.splitTally(n)}, expected ${splitTally(n)}`)
    }, 'aarch64')
    harness.test('calleeReadFootprint', () => {
        const natives: any = native.createNatives({ footprintMapKeys })
        const listing = natives.footprintMapKeys.units.find((unit: any) => unit.name === 'footprintMapKeys').code.listing
        const zeroStores = (listing.match(/\bst(?:r|p|ur)\s+xzr(?:, xzr)?, \[[^\]]*\](?!, #)/g) ?? []).reduce((n: number, store: string) => n + (store.includes('xzr, xzr') ? 2 : 1), 0)
        if (zeroStores !== 11) harness.fail(`footprintMapKeys: ${zeroStores} zero stores, expected 11 (push reads only its array, so the other Map fields' stores are dead; the array's own fields stay):\n${listing}`)
        const got = [natives.footprintMapKeys(7), natives.footprintMapKeys(0)].map(Number)
        if (got.join() !== '7,0') harness.fail(`footprintMapKeys results ${got.join()}, expected 7,0`)
    }, 'aarch64')
    harness.test('countdownIndexedCopies', () => {
        const natives: any = native.createNatives({ copyIndexedWords, copyIndexedBytes, reserveIndexedWords, sumReservedWords, pushIndexedWord, readPushedWord, pushedWordsLoop, mapSetSites })
        for (const name of ['copyIndexedWords', 'copyIndexedBytes', 'reserveIndexedWords']) {
            const listing = natives[name].units.find((unit: any) => unit.name === name).code.listing
            const loop = listing.slice(listing.indexOf('\nL'))
            if (/\bcmp\b|\blsl\b|\bcbnz\b/.test(loop) || !/\bcbz\b/.test(listing)
                || !/\bsubs\b[^\n]*#1/.test(loop) || !/\bb\.ne\b/.test(loop)
                || !/\bldr[b]? [^\n]*\], #/.test(loop) || !/\bstr[b]? [^\n]*\], #/.test(loop)) {
                harness.fail(`${name}: indexed copies must use advancing addresses and a countdown:\n${listing}`)
            }
        }
        for (const n of [0, 1, 3, 8]) {
            const words = new Float64Array(8)
            for (let i = 0; i < words.length; i++) words[i] = i + 0.5
            const src = n ? Number((ts as any).getArrayBufferPtr(words.buffer)) : 0
            const header = new BigUint64Array([BigInt(0), BigInt(src), BigInt(n)])
            const ptr = Number((ts as any).getArrayBufferPtr(header.buffer))
            const sum = Number(natives.sumReservedWords(n + 3, ptr))
            if (sum !== n * n / 2 || header[0] !== BigInt(n + 3) || header[1] === BigInt(src) || header[2] !== BigInt(n)) {
                harness.fail(`reserveIndexedWords(${n}): sum ${sum}, header ${header.join()}`)
            }
        }
        for (const n of [0, 1, 3, 8]) for (const [src, dst] of [[0, 9], [0, 1], [1, 0], [0, 0]]) {
            const words = new Float64Array(18)
            for (let i = 0; i < words.length; i++) words[i] = i + 0.5
            const expected = new Float64Array(words)
            for (let i = 0; i < n; i++) expected[dst + i] = expected[src + i]
            const ptr = Number((ts as any).getArrayBufferPtr(words.buffer))
            const result = Number(natives.copyIndexedWords(ptr + dst * 8, ptr + src * 8, n))
            if (result !== ptr + dst * 8 || words.join() !== expected.join()) {
                harness.fail(`copyIndexedWords(${dst}, ${src}, ${n}): ${words.join()}, expected ${expected.join()}; returned ${result}`)
            }
            const bytes = new Uint8Array(18)
            for (let i = 0; i < bytes.length; i++) bytes[i] = i + 1
            const expectedBytes = new Uint8Array(bytes)
            for (let i = 0; i < n; i++) expectedBytes[dst + i] = expectedBytes[src + i]
            const bytePtr = Number((ts as any).getArrayBufferPtr(bytes.buffer))
            const byteResult = Number(natives.copyIndexedBytes(bytePtr + dst, bytePtr + src, n))
            if (byteResult !== bytePtr * 2 + dst + src + n || bytes.join() !== expectedBytes.join()) {
                harness.fail(`copyIndexedBytes(${dst}, ${src}, ${n}): ${bytes.join()}, expected ${expectedBytes.join()}; returned ${byteResult}`)
            }
        }
        if (Number(natives.copyIndexedWords(0, 0, 0)) !== 0) harness.fail('an empty copy must not access either pointer')
        const push = natives.pushIndexedWord.units.find((unit: any) => unit.name === 'pushIndexedWord').code.listing
        if (/\bmov x/.test(push.slice(0, push.search(/\bb\.\w+ /)))) harness.fail(`pushIndexedWord: the length must keep its register on the path that skips the copy:\n${push}`)
        const pushed = new BigUint64Array([BigInt(0), BigInt(0), BigInt(0)])
        const pushedPtr = Number((ts as any).getArrayBufferPtr(pushed.buffer))
        for (let i = 0; i < 9; i++) {
            if (Number(natives.pushIndexedWord(pushedPtr, i + 1)) !== i + 1) harness.fail(`pushIndexedWord(${i}) returned the wrong length`)
        }
        let pushedSum = 0
        for (let i = 0; i < 9; i++) pushedSum += Number(natives.readPushedWord(pushedPtr, i))
        if (pushed[2] !== BigInt(9) || pushed[0] < BigInt(9) || pushedSum !== 45) harness.fail(`pushIndexedWord: header ${pushed.join()}, sum ${pushedSum}`)
        const grown = natives.pushedWordsLoop.units.find((unit: any) => unit.name === 'pushedWordsLoop').code.listing
        if (/\bmov (x\d+), x\d+\n(?:[^\n]*\n){0,8}?[^\n]*\bmov x\d+, \1\n[^\n]*\bmov x\d+, \1\n/.test(grown)) {
            harness.fail(`pushedWordsLoop: the grown buffer must hand over from its own register, not through a copy:\n${grown}`)
        }
        for (const n of [1, 4, 5, 13]) {
            if (Number(natives.pushedWordsLoop(n)) !== (n - 1) * 3 + n * 100) harness.fail(`pushedWordsLoop(${n}) returned ${natives.pushedWordsLoop(n)}`)
        }
        for (const unit of natives.mapSetSites.units) {
            if (/\bcmp [^\n]*\n[^\n]*\bmov x\d+, x\d+\n[^\n]*\bb\.lo\b/.test(unit.code.listing)) {
                harness.fail(`mapSetSites: a length handed to a copy counter and to the code after the copy must stay in the carried register:\n${unit.code.listing}`)
            }
        }
        for (const n of [1, 2, 7]) {
            const expected = (n === 1 || n === 2 ? 2 : 3) + (n === 2 ? 5 : n - 1)
            if (Number(natives.mapSetSites(n)) !== expected) harness.fail(`mapSetSites(${n}) returned ${natives.mapSetSites(n)}, expected ${expected}`)
        }
    }, 'aarch64')
    harness.test('zeroStorePairings', () => {
        const natives: any = native.createNatives({ zeroStores80, zeroStores32, zeroStoresWithHole, zeroStoresObserved, zeroStoresBeforeScaledAdd, zeroStoresAfterValue, zeroStoresBetweenValues })
        const wide = natives.zeroStores80.units.find((unit: any) => unit.name === 'zeroStores80').code
        if ((wide.listing.match(/^\s*\d+: [0-9a-f]{8} /gm) ?? []).length !== 5
            || !/\bmovi v16\.2d, #0/.test(wide.listing) || !/\bstp q16, q16/.test(wide.listing)) {
            harness.fail(`zeroStores80 must clear 80 bytes in four instructions plus ret:\n${wide.listing}`)
        }
        for (const word of wide.words) if (!aarch64RegisterEffects(word)) harness.fail(`missing register effects for zeroStores80 instruction ${word.toString(16)}`)
        const small = natives.zeroStores32.units.find((unit: any) => unit.name === 'zeroStores32').code.listing
        if ((small.match(/\bstp xzr, xzr/g) ?? []).length !== 2 || /\bmovi\b|\bq16\b/.test(small)) {
            harness.fail(`zeroStores32 must use two integer pairs; a vector setup would not save instructions:\n${small}`)
        }
        for (const [name, bytes, hole] of [['zeroStores80', 80, -1], ['zeroStores32', 32, -1], ['zeroStoresWithHole', 80, 16]] as const) {
            const memory = new Uint8Array(bytes + 16).fill(0xa5)
            const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer)) + 8
            natives[name](ptr)
            for (let i = 0; i < memory.length; i++) {
                const at = i - 8
                const cleared = at >= 0 && at < bytes && !(hole >= 0 && at >= hole && at < hole + 8)
                if (memory[i] !== (cleared ? 0 : 0xa5)) harness.fail(`${name}: byte ${at} is ${memory[i]}`)
            }
        }
        const scaled = natives.zeroStoresBeforeScaledAdd.units.find((unit: any) => unit.name === 'zeroStoresBeforeScaledAdd').code.listing
        if (/\blsl x/.test(scaled) || !/, lsl #1\b/.test(scaled)) harness.fail(`zeroStoresBeforeScaledAdd must fold the shift into the add:\n${scaled}`)
        const afterValue = natives.zeroStoresAfterValue.units.find((unit: any) => unit.name === 'zeroStoresAfterValue').code.listing
        if ((afterValue.match(/^\s*\d+: [0-9a-f]{8} /gm) ?? []).length !== 3) {
            harness.fail(`zeroStoresAfterValue must pair the value with the first zero word and the other two zero words:\n${afterValue}`)
        }
        const paired = new BigUint64Array(5).fill(BigInt(77))
        natives.zeroStoresAfterValue(Number((ts as any).getArrayBufferPtr(paired.buffer)), 9)
        if (paired.join() !== '9,0,0,0,77') harness.fail(`zeroStoresAfterValue wrote ${paired.join()}`)
        const betweenValues = natives.zeroStoresBetweenValues.units.find((unit: any) => unit.name === 'zeroStoresBetweenValues').code.listing
        if ((betweenValues.match(/^\s*\d+: [0-9a-f]{8} /gm) ?? []).length !== 3) {
            harness.fail(`zeroStoresBetweenValues must pair each value with its neighboring zero word:\n${betweenValues}`)
        }
        const between = new BigUint64Array(5).fill(BigInt(77))
        natives.zeroStoresBetweenValues(Number((ts as any).getArrayBufferPtr(between.buffer)), 9, 11)
        if (between.join() !== '9,0,0,11,77') harness.fail(`zeroStoresBetweenValues wrote ${between.join()}`)
        const scratch = new BigUint64Array(4).fill(BigInt(77))
        const scratchPtr = Number((ts as any).getArrayBufferPtr(scratch.buffer))
        if (Number(natives.zeroStoresBeforeScaledAdd(scratchPtr, 5)) !== scratchPtr + 15 || scratch.some(word => word !== BigInt(0))) {
            harness.fail(`zeroStoresBeforeScaledAdd: ${scratch.join()}`)
        }
        const observed = new BigUint64Array(12).fill(BigInt(77))
        const ptr = Number((ts as any).getArrayBufferPtr(observed.buffer)) + 8
        if (Number(natives.zeroStoresObserved(ptr, ptr)) !== 77) harness.fail('zero stores moved across an observing load')
        if (observed[0] !== BigInt(77) || observed[11] !== BigInt(77)
            || observed.slice(1, 11).some(word => word !== BigInt(0))) harness.fail('zeroStoresObserved changed its memory footprint')
    }, 'aarch64')
    harness.test('negatedMinusOne', () => {
        const natives: any = native.createNatives({ negatedMinusOneSub, negatedMinusOneAdd, entriesLiteralSum, undefinedSlotPush })
        for (const n of [1, 5]) if (Number(natives.undefinedSlotPush(n)) !== undefinedSlotPush(n)) harness.fail(`undefinedSlotPush(${n}) = ${natives.undefinedSlotPush(n)}, expected ${undefinedSlotPush(n)}`)
        const entries: string = natives.entriesLiteralSum.units.find((unit: any) => unit.name === 'entriesLiteralSum').code.listing
        if ((entries.match(/^\s*\d+: [0-9a-f]{8} /gm) ?? []).length !== 2) harness.fail(`entriesLiteralSum must fold the literal values to one add:\n${entries}`)
        for (const n of [0, 5]) if (Number(natives.entriesLiteralSum(n)) !== entriesLiteralSum(n)) harness.fail(`entriesLiteralSum(${n}) = ${natives.entriesLiteralSum(n)}, expected ${entriesLiteralSum(n)}`)
        const memory = new BigInt64Array(2)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        for (const name of ['negatedMinusOneSub', 'negatedMinusOneAdd']) {
            const listing = natives[name].units.find((unit: any) => unit.name === name).code.listing
            if (!/\bmvn x/.test(listing) || /\bneg x|\bsub x/.test(listing)) harness.fail(`${name} must fold to a complement:\n${listing}`)
            for (const value of [-(BigInt(1) << BigInt(63)), BigInt(-12345), BigInt(-1), BigInt(0), BigInt(1), BigInt(12345), (BigInt(1) << BigInt(63)) - BigInt(1)]) {
                memory[0] = value
                memory[1] = BigInt(777)
                natives[name](ptr)
                if (memory[1] !== BigInt.asIntN(64, -value - BigInt(1))) harness.fail(`${name}(${value}) returned ${memory[1]}`)
            }
        }
    }, 'aarch64')
    harness.test('floatCompareZeroImmediate', () => {
        const natives: any = native.createNatives({ floatZeroRightEqual, floatZeroRightNotEqual, floatZeroRightLess, floatZeroRightLessEqual, floatZeroRightGreater, floatZeroRightGreaterEqual, floatZeroLeftEqual, floatZeroLeftNotEqual, floatZeroLeftLess, floatZeroLeftLessEqual, floatZeroLeftGreater, floatZeroLeftGreaterEqual })
        const memory = new Float64Array(1)
        const ptr = Number((ts as any).getArrayBufferPtr(memory.buffer))
        const cases: [string, (value: number) => boolean][] = [
            ['floatZeroRightEqual', value => value === 0],
            ['floatZeroRightNotEqual', value => value !== 0],
            ['floatZeroRightLess', value => value < 0],
            ['floatZeroRightLessEqual', value => value <= 0],
            ['floatZeroRightGreater', value => value > 0],
            ['floatZeroRightGreaterEqual', value => value >= 0],
            ['floatZeroLeftEqual', value => 0 === value],
            ['floatZeroLeftNotEqual', value => 0 !== value],
            ['floatZeroLeftLess', value => 0 < value],
            ['floatZeroLeftLessEqual', value => 0 <= value],
            ['floatZeroLeftGreater', value => 0 > value],
            ['floatZeroLeftGreaterEqual', value => 0 >= value],
        ]
        for (const [name, reference] of cases) {
            const listing = natives[name].units.find((unit: any) => unit.name === name).code.listing
            if (!/\bfcmp d\d+, #0/.test(listing) || /\bfmov d\d+, xzr|\bfcmp d\d+, d\d+/.test(listing)) harness.fail(`${name} must compare with immediate zero:\n${listing}`)
            for (const value of [-Infinity, -123.5, -Number.MIN_VALUE, -0, 0, Number.MIN_VALUE, 123.5, Infinity, NaN]) {
                memory[0] = value
                const expected = Number(reference(value))
                const actual = Number(natives[name](ptr))
                if (actual !== expected) harness.fail(`${name}(${value}) returned ${actual}, expected ${expected}`)
            }
        }
    }, 'aarch64')
    harness.test('pairedInitializations', () => {
        const references = { arrayBuild, arrayPushPairs, arrayFixedPushes, presizeWords }
        for (const [name, reference] of Object.entries(references)) {
            pairCompiled(name, { [name]: reference, observedWordPush, observedNumberPush }, [0, 1, 2, 7])
        }
    })
    harness.test('arrayPresizing', () => {
        const references = { arrayPresizedChain, arrayBuild, arrayPushPairs, arrayPushResult, arrayPushOffset, arrayThresholds, arrayFixedPushes, arrayMultiplePushCalls }
        const natives: any = native.createNatives(references)
        for (const [name, reference] of Object.entries(references)) for (const n of [0, 1, 2, 3, 7, 31]) {
            const expected = reference(n)
            const actual = Number(natives[name](n))
            if (actual !== expected) harness.fail(`${name}(${n}) returned ${actual}, expected ${expected}`)
        }
