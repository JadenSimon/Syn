        const trimmed = text.trim()
        const kind = trimmed === 'ab c' ? 1 : trimmed === 'ab' ? 2 : trimmed === '' ? 3 : trimmed === 'abc' ? 4 : trimmed === 'a\u00A0b' ? 5 : trimmed === '\u0085ab\u200B' ? 6 : 9
