    }
    harness.test('retypeValuesStandalone', () => {
        let load = 0
        const g = rootGraph([Types.u64, Types.u64], (g, root, [a, b]) => {
            load = gn.addNode(g, gn.NodeOp.load, [gn.addNode(g, gn.NodeOp.startOf, []), b, { literal: 0 }], Types.u64)
            return gn.addNode(g, gn.NodeOp.ret, [gn.addNode(g, gn.NodeOp.add, [a, load], Types.u64), root])
        })
