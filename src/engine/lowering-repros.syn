const dynCostTables = { arm: { words: (v: number) => v * 2, bits: 64 }, x86: { words: (v: number) => v + 1, bits: 32 } }
const elemFloatWords: (number | string)[] = [1.5, 'q']
const sortedMixedWords: (number | boolean | { x: number })[] = [3, 2.5, true, { x: 1 }]
const smapCosts = { latency: new Map([['convert', 0], ['mul', 3], ['load', 4]]) }
const dynNames: Record<number, string> = { [1]: 'LdaZero', [2]: 'Star', [3]: 'Return' }
const dynOpNames: Record<number, string> = { [1]: 'LdaZero', [2]: 'Star', [3]: 'Return', [4]: 'Add', [5]: 'LdaConst' }

interface Tree {
    v: number
    kids: Tree[]
}

function selfZeros(xs: number[], i: number): number {
    if (i >= xs.length) return 0
    const rest = () => selfZeros(xs, i + 1)
    if (xs[i] % 2 === 0) return Math.min(64, rest() + 1)
    return Math.max(rest(), i)
}

function sumTree(t: Tree, fn: (t: Tree) => number): number {
    let s = 0
    for (const k of t.kids) s += fn(k)
    return s
}
;(sumTree as any).shouldNotInline = true

function anyOf(xs: number[], fn: (x: number) => boolean): boolean {
    for (const x of xs) if (fn(x)) return true
    return false
}
;(anyOf as any).shouldNotInline = true

function edgeLists(edges: (v: number) => number[]): number[][] {
    const frames: number[][] = []
    const out: number[][] = []
    function enter(v: number): void {
        frames.push(edges(v))
    }
    enter(0)
    out.push([1])
    return out
}

function stronglyConnectedLike(roots: number[], edges: (v: number) => number[]): number[][] {
    const index = new Map<number, number>()
    const frames: { v: number, next: number[], at: number }[] = []
    const out: number[][] = []
    function enter(v: number): void {
        index.set(v, index.size)
        frames.push({ v, next: edges(v), at: 0 })
    }
    for (const root of roots) {
        if (index.has(root)) continue
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.next.length) {
                const w = frame.next[frame.at++]
                if (!index.has(w)) enter(w)
                continue
            }
            frames.pop()
            out.push([frame.v])
        }
    }
    return out
}

function stepUp(x: number): number {
    return x + 1
}

function shortTwo(a: number, b?: number): number {
    if (b === undefined) return a
    return a * b
}

function scaleItems(items: ({ v: number } | number)[], k: number, extra?: { w: number }): number {
    const out = items.map(o => {
        if (typeof o === 'number') return o + k
        return o.v * k
    })
    return out[0] + out[1] + (extra ? extra.w : 0)
}

interface MiniTarget {
    bits: number
    layout(n: number): { bytes: number, link: number }
}
function miniLayout(n: number): { bytes: number, link: number } {
    return { bytes: n * 8, link: n }
}
function miniLower(opts: { target?: MiniTarget } = {}): number {
    const target = opts.target ?? { bits: 64, layout: miniLayout }
    const layout = target.layout(3)
    return layout.bytes + layout.link + target.bits
}
;(miniLower as any).shouldNotInline = true

let peekTally: (tally: Tally) => number
export let tallyCount: (tally: Tally) => number
const tallyHooks: { name: string, lower: () => number }[] = []

function registerTallyHook(name: string, lower: () => number): void {
    tallyHooks.push({ name, lower })
}

function halfOf(x: number): number {
    return x / 2
}
;(halfOf as any).shouldNotInline = true

function quarterOf(x: number): number {
    intrinsics.assert(x % 4 === 0)
    return x / 4
}
;(quarterOf as any).shouldNotInline = true

function poolIndex(slot: number, cellSlots: number): number {
    intrinsics.assert(slot >= 1 && (slot - 1) % cellSlots === 0)
    return (slot - 1) / cellSlots
}
;(poolIndex as any).shouldNotInline = true

function floorPoolCells(avail: u32, cellBytes: u32): number {
    const slots = (cellBytes + 7) >> 3
    if (slots === 0) return 0
    return Math.floor(avail / (slots * 8))
}
;(floorPoolCells as any).shouldNotInline = true

function cellsSink(cells: number): number {
    return cells + 1
}
;(cellsSink as any).shouldNotInline = true

function assertedFloorCells(avail: u32, cellBytes: u32): number {
    const slots = (cellBytes + 7) >> 3
    intrinsics.assert(slots > 0)
    const cells = Math.floor(avail / (slots * 8))
    return cellsSink(cells)
}
;(assertedFloorCells as any).shouldNotInline = true

function floorSigned(a: u32, b: u32): number {
    return Math.floor((a - 10) / ((b & 7) + 1))
}
;(floorSigned as any).shouldNotInline = true

function truncSigned(a: u32, b: u32): number {
    return Math.trunc((a - 10) / ((b & 7) + 1))
}
;(truncSigned as any).shouldNotInline = true

function truncF64(a: u32): number {
    return Math.trunc((a - 10) * 0.75)
}
;(truncF64 as any).shouldNotInline = true

function floorF64(a: u32): number {
    return Math.floor((a - 10) * 0.75)
}
;(floorF64 as any).shouldNotInline = true

function ceilF64(a: u32): number {
    return Math.ceil((a - 10) * 0.75)
}
;(ceilF64 as any).shouldNotInline = true

function absF64(a: u32): number {
    return Math.abs((a - 10) * 0.75)
}
;(absF64 as any).shouldNotInline = true

function negatedWhole(a: u32): number {
    const whole = Intrinsics.convert((a - 10) * 1.5, Types.f64, Types.i64)
    return whole < 0 ? Intrinsics.sub(0, whole, Types.i64) : whole
}
;(negatedWhole as any).shouldNotInline = true

function negativeRootScaled(a: i32): number {
    return a * 2 + 0.5
}
;(negativeRootScaled as any).shouldNotInline = true

function negativeRootCompare(a: i32): number {
    return a < 0 ? 1 : 2
}
;(negativeRootCompare as any).shouldNotInline = true

function footprintMapKeys(n: u32): number {
    const m = new Map<number, number>()
    m.set(n, 1)
    return [...m.keys()][0]
}

function maybeKeyHash(k: number, skip: u32): u32 {
    return hashKey(skip ? undefined : k)
}

function scaledOrPlain(a: u32): u32 {
    if (a > 1000) return (a % 7) * (a % 11) * (a % 13)
    return a + 1
}
;(scaledOrPlain as any).shouldNotInline = true

function plainOrScaled(a: u32): u32 {
    if (a <= 1000) return (a % 7) * (a % 11) * (a % 13)
    return a + 1
}
;(plainOrScaled as any).shouldNotInline = true

function scaledSum(n: u32): u32 {
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total = total + scaledOrPlain(i) + plainOrScaled(i)
    return total
}

function hashedSlot(key: number, mask: u32): number {
    return hashKey(key) & mask
}

function keptHash(x: number): number {
    return x + 1
}
;(keptHash as any).shouldNotInline = true

function hashedSum(n: number, mask: u32): number {
    let total = 0
    for (let i = 0; i < n; i++) total = total + (hashKey(i * 7) & mask)
    return keptHash(total) + n
}

function highBitsBranch(p: number, i: number): number {
    const x = Intrinsics.load(p, i * 8, Types.u64)
    if (x < 0x40000000) return Intrinsics.crc32(0, x, Types.u32)
    return 7
}
;(highBitsBranch as any).shouldNotInline = true

function highBitsFlag(p: number, i: number): boolean {
    return Intrinsics.load(p, i * 8, Types.u64) >= 0x1000000
}
;(highBitsFlag as any).shouldNotInline = true

function highBitsPick(p: number, i: number, a: number, b: number): number {
    const x = Intrinsics.load(p, i * 8, Types.u64)
    return (x <= 0xffffffffff ? a : b) + i
}
;(highBitsPick as any).shouldNotInline = true

function inHighBand(x: number): boolean {
    return x <= 0xffffffffff && x >= 0x1000000
}

function highBitsBetween(p: number, i: number): number {
    return inHighBand(Intrinsics.load(p, i * 8, Types.u64)) ? 5 : 9
}
;(highBitsBetween as any).shouldNotInline = true

function highBitsNarrow(p: number, i: number): boolean {
    return Intrinsics.load(p, i * 4, Types.u32) > 0xffff
}
;(highBitsNarrow as any).shouldNotInline = true

function windowHashed(p: number, i: number): number {
    return hashKey(Intrinsics.load(p, i * 8, Types.i64))
}
;(windowHashed as any).shouldNotInline = true

function windowOf(x: number): number {
    if (x >= -0x40000000 && x < 0x40000000) return 1
    return 2
}

function windowInlined(p: number, i: number): number {
    return windowOf(Intrinsics.load(p, i * 8, Types.i64))
}
;(windowInlined as any).shouldNotInline = true

function windowFlipped(x: number): boolean {
    return -0x8000001 < x && 0x7ffffff >= x
}

function windowFlippedInlined(p: number, i: number): number {
    return windowFlipped(Intrinsics.load(p, i * 8, Types.i64)) ? 3 : 4
}
;(windowFlippedInlined as any).shouldNotInline = true

function unsignedWindowInlined(p: number, i: number): number {
    return windowOf(Intrinsics.load(p, i * 8, Types.u64))
}
;(unsignedWindowInlined as any).shouldNotInline = true

function shiftBand(p: number, n: number, lo: number, hi: number, shift: number): void {
    for (let i = 0; i < n; i++) {
        const b = Intrinsics.load(p, i, Types.u8)
        Intrinsics.store(p, i, b >= lo && b <= hi ? b + shift : b, Types.u8)
    }
}

function upperBytes(p: number, n: number): number {
    shiftBand(p, n, 97, 122, -32)
    return n
}
;(upperBytes as any).shouldNotInline = true

function negScaledSlot(p: number, i: number, v: u32): number {
    const found = Intrinsics.load(p, i * 8, Types.i64)
    Intrinsics.store(p, 256 + (-found - 1) * 4, v, Types.u32)
    return 0
}
;(negScaledSlot as any).shouldNotInline = true

function clampedStore(p: number, i: number): number {
    const v = Intrinsics.load(p, i * 8, Types.u64)
    Intrinsics.store(p, 8, v > 0 ? v : 0, Types.u64)
    Intrinsics.store(p, 16, 0 < v ? v : 0, Types.u64)
    Intrinsics.store(p, 24, v <= 0 ? 0 : v, Types.u64)
    return 0
}
;(clampedStore as any).shouldNotInline = true

function clampedSigned(p: number, i: number): number {
    const v = Intrinsics.load(p, i * 8, Types.i64)
    Intrinsics.store(p, 8, v > 0 ? v : 0, Types.i64)
    return 0
}
;(clampedSigned as any).shouldNotInline = true

function farFloat(p: number, i: number): number {
    const x = Intrinsics.load(p, i * 8, Types.f64)
    Intrinsics.store(p, 0, x >= 1e21 ? 1 : 0, Types.u8)
    Intrinsics.store(p, 1, x <= -1e21 ? 1 : 0, Types.u8)
    return 0
}
;(farFloat as any).shouldNotInline = true

function digitOrRadix(byte: number, radix: number): number {
    const digit = byte >= 48 && byte <= 57 ? byte - 48 : byte >= 97 && byte <= 122 ? byte - 87 : byte >= 65 && byte <= 90 ? byte - 55 : radix
    return digit < radix ? digit : -1
}
;(digitOrRadix as any).shouldInline = true

function rangeWide(p: number, i: number): number {
    return digitOrRadix(Intrinsics.load(p, i * 8, Types.i64), 80)
}
;(rangeWide as any).shouldNotInline = true

function rangeUnsigned(p: number, i: number): number {
    return digitOrRadix(Intrinsics.load(p, i * 8, Types.u64), 80)
}
;(rangeUnsigned as any).shouldNotInline = true

function rangeNarrow(p: number, i: number): number {
    return digitOrRadix(Intrinsics.load(p, i * 4, Types.u32), 80)
}
;(rangeNarrow as any).shouldNotInline = true

function signedBand(p: number, i: number): number {
    const b = Intrinsics.load(p, i * 8, Types.i64)
    return b >= 48 && b <= 57 ? b - 48 : b >= -40 && b <= -3 ? 70 : 99
}
;(signedBand as any).shouldNotInline = true

function sameValue<T>(value: T): T {
    return value
}
let plainFriend: (n: number) => number = n => n
plainFriend = n => n * 2

class Tally {
    #count: number
    #slots: number[]

    constructor(n: number) {
        this.#count = n
        this.#slots = [n, n + 1]
    }

    static {
        function bump(this: Tally, k: number): number {
            this.#count = this.#count + k
            return this.#count
        }
        function getSlot(this: Tally, index: number): any {
            if (index >= this.#slots.length) return undefined
            return this.#slots[index] * 10
        }
        function setSlot(this: Tally, index: number, value: any): void {
            this.#slots[index] = value
            this.#count = this.#count + 1
        }
        (Tally.prototype as any).bump = bump
        Object.setPrototypeOf(Tally.prototype, intrinsics.setIndexDescriptor({}, getSlot, setSlot))
        peekTally = tally => tally.#count
        tallyCount = tally => tally.#count + tally.#slots.length
        registerTallyHook('first', () => 1)
        registerTallyHook('second', () => 2)
    }
}

sameValue(Tally)

class ListHolder {
    #count: number
    #list: number[]

    constructor() {
        this.#count = 0
        this.#list = []
    }

    push(value: number): void {
        this.#count++
        this.#list.push(value)
    }

    clear(): void {
        this.#list.length = 0
    }

    get size(): number {
        return this.#list.length + this.#count * 10
    }
}

const reproTable = new Map<number, number>()

class TallyView {
    count: number

    constructor(tally: Tally) {
        this.count = peekTally(tally)
    }
}

const mixedMap = new Map<number, number | { a: number }>([[1, 2.5], [2, { a: 7 }]])
export function suite() {
    harness.test('forwardFloatCopies', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        const inputs = new Float64Array(2)
        const output = new BigUint64Array(2)
        const floats = new Float64Array(output.buffer)
        const bits = new BigUint64Array(inputs.buffer)
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        for (const op of ['convert', 'add', 'reverse', 'same', 'neg', 'compare', 'select', 'move', 'bits', 'inplace', 'store']) for (const hazard of ['', 'source', 'entry', 'live', 'bits-source']) {
            const asm = hostTarget.createAssembler()
            asm.load(32, 0, 0, Types.f64)
            asm.load(33, 0, 8, Types.f64)
            if (op === 'select') asm.compareImm('gt', 10, 2, 0, false)
            if (hazard === 'entry') { asm.mov(50, 33); asm.jumpIfZero(2, 0) }
            if (hazard === 'bits-source') { asm.load(9, 0, 0, Types.u64); asm.mov(50, 9) }
            else asm.mov(50, 32)
            if (hazard === 'source') asm.mov(32, 33)
            if (hazard === 'entry') asm.bindLabel(0)
            if (op === 'convert') asm.convert(9, 50, Types.f64, Types.i64)
            else if (op === 'compare') asm.floatCompare('eq', 9, 50, 33, [Types.f64, Types.f64])
            else if (op === 'bits') asm.mov(9, 50)
            else if (op === 'neg') asm.floatUnary('neg', 51, 50, Types.f64)
            else if (op === 'reverse') asm.floatBinary('sub', 51, 33, 50, [Types.f64, Types.f64])
            else if (op === 'select') { asm.select(51, 10, 50, 33); asm.released([{ value: 0, home: 10 }]) }
            else if (op === 'move') asm.mov(51, 50)
            else if (op === 'store') asm.store(1, 0, 50, Types.f64)
            else asm.floatBinary('add', op === 'inplace' ? 50 : 51, 50, op === 'same' ? 50 : 33, [Types.f64, Types.f64])
            if (hazard !== 'live') asm.released([{ value: 0, home: 50 }])
            if (op !== 'store') asm.store(1, 0, ['convert', 'compare', 'bits'].includes(op) ? 9 : op === 'inplace' ? 50 : 51, ['convert', 'compare', 'bits'].includes(op) ? Types.u64 : Types.f64)
            if (hazard === 'live') asm.store(1, 8, 50, Types.f64)
            asm.movImm(0, 0)
            asm.ret()
            const listing = asm.listing()
            const folded = !hazard && op !== 'store'
            if (folded === /fmov d18,/.test(listing)) harness.fail(`float forwarding ${op}/${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const value of [-99.75, -0, 0, 1.5, 2 ** 40 + 0.5, NaN]) for (const flag of [0, 1]) {
                inputs[0] = value
                inputs[1] = 3.25
                run(ptr(inputs), ptr(output), flag)
                const left = hazard === 'entry' && flag === 0 ? inputs[1] : value
                const expected = op === 'convert' ? BigInt.asUintN(64, Number.isNaN(left) ? BigInt(0) : BigInt(Math.trunc(left)))
                    : op === 'compare' ? BigInt(left === inputs[1] ? 1 : 0)
                    : op === 'bits' ? bits[hazard === 'entry' && flag === 0 ? 1 : 0]
                    : op === 'neg' ? -left : op === 'same' ? left + left
                    : op === 'reverse' ? inputs[1] - left : op === 'select' ? flag ? left : inputs[1]
                    : op === 'add' || op === 'inplace' ? left + inputs[1] : left
                const actual = typeof expected === 'bigint' ? output[0] : floats[0]
                if (!Object.is(actual, expected)) harness.fail(`float forwarding ${op}/${hazard}(${value},${flag}): ${actual}, expected ${expected}`)
                const retained = op === 'inplace' ? left + inputs[1] : left
                if (hazard === 'live' && !Object.is(floats[1], retained)) harness.fail(`float forwarding lost live ${op}(${value}): ${floats[1]}, expected ${retained}`)
            }
        }
        const asm = hostTarget.createAssembler()
        asm.load(32, 0, 0, Types.f64)
        asm.mov(9, 32)
        asm.binaryImm('add', 10, 9, 1, false)
        asm.released([{ value: 0, home: 9 }])
        asm.store(1, 0, 10, Types.u64)
        asm.movImm(0, 0)
        asm.ret()
        if (!asm.listing().includes('fmov x9, d0')) harness.fail(`float forwarding crossed register banks:\n${asm.listing()}`)
        const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
        for (const value of [-0, 0, 1.5, NaN, -Infinity]) {
            inputs[0] = value
            run(ptr(inputs), ptr(output))
            const expected = BigInt.asUintN(64, bits[0] + BigInt(1))
            if (output[0] !== expected) harness.fail(`float bit transfer(${value}): ${output[0]}, expected ${expected}`)
        }
    })
    harness.test('narrowMaskedLoads', () => {
        const data = new Uint8Array([0xff, 0x80, 0xab, 0xcd, 0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0xde, 0xf0, 0x81, 0x23, 0x45, 0x67])
        const saved = new BigUint64Array(1)
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        for (const T of [Types.u32, Types.u64]) for (const mask of [0xff, 0xffff, 0xffffffff, 0xfffe]) for (const offset of [0, 1]) for (const shared of [false, true]) {
            const g = gn.createGraph({})
            const root = gn.addNode(g, gn.NodeOp.block, [])
            const input = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
            const out = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const load = gn.addNode(g, gn.NodeOp.load, [nil, input, { literal: offset }], T)
            const value = gn.addNode(g, gn.NodeOp.and, offset ? [{ literal: mask }, load] : [load, { literal: mask }], Types.u64)
            const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
            const store = gn.addNode(g, gn.NodeOp.store, [nil, out, { literal: 0 }, load], Types.u64)
            g.root = root
            gn.setGraphBlocks(g, [{ id: root, params: [input, out], bodyId: shared ? gn.addNode(g, gn.NodeOp.after, [store, ret]) : ret, bodyConst: 0 }])
            const optimized = optimizePackaged(packageValueGraph(g, hostTarget), hostTarget)
            const work = [optimized.blocks[0].bodyId]
            const seen = new Set<number>()
            while (work.length) {
                const id = work.pop()!
                const n = gn.getNode(optimized, id)
                if (!n || seen.has(id) || n.op === gn.NodeOp.block) continue
                seen.add(id)
                const want = shared || mask === 0xfffe ? T : mask === 0xff ? Types.u8 : mask === 0xffff ? Types.u16 : Types.u32
                if (n.op === gn.NodeOp.load && gn.typeOf(n) !== want) harness.fail(`masked load ${T}/${mask}/${offset}/${shared}:\n${dumpGraph(optimized)}`)
                for (let i = 0; i < gn.countIds(n); i++) work.push(gn.getRef(n, i))
            }
            const code = lowerValueGraph(optimized)
            const run = (ts as any).createNativeFn(new Uint8Array(code.bytes))
            let loaded = BigInt(0)
            for (let i = 0; i < (T === Types.u32 ? 4 : 8); i++) loaded |= BigInt(data[offset + i]) << BigInt(i * 8)
            const actual = BigInt(run(ptr(data), ptr(saved)))
            const expected = loaded & BigInt(mask)
            if (actual !== expected || (shared && saved[0] !== loaded)) harness.fail(`masked load ${T}/${mask}/${offset}/${shared}: ${actual}, expected ${expected}`)
        }
    })
    harness.test('recordRelayParam', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const x = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const y = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const join = gn.addNode(g, gn.NodeOp.block, [])
        const a = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const record = gn.insertNode(g, gn.createRecordType(g, [{ key: 0, type: Types.u64 }, { key: 1, type: Types.u64 }]))
        const fnType = gn.insertNode(g, gn.createFnType(g, { ref: record }))
        const pure = { effect: 0, writes: 0, fresh: false, tagged: false, captures: 0, deepCaptures: 0, reads: [], outcomes: undefined }
        const target = gn.addNode(g, gn.NodeOp.localTarget, encodeCallSummary(g, 1, pure), { ref: fnType })
        const nil = gn.addNode(g, gn.NodeOp.startOf, [])
        const call = gn.addNode(g, gn.NodeOp.call, [nil, target, { literal: 0 }, a])
        const first = gn.addNode(g, gn.NodeOp.get, [call, { literal: 0 }])
        const second = gn.addNode(g, gn.NodeOp.get, [call, { literal: 1 }])
        const tested = gn.addNode(g, gn.NodeOp.eq, [a, { literal: 0 }], Types.bool)
        const loop = gn.addNode(g, gn.NodeOp.block, [])
        const arms = gn.addNode(g, gn.NodeOp.select, [tested, gn.addNode(g, gn.NodeOp.ret, [first, root]), gn.addNode(g, gn.NodeOp.apply, [loop, second])])
        const i = gn.addNode(g, gn.NodeOp.param, [], Types.u64)
        const step = gn.addNode(g, gn.NodeOp.add, [i, { literal: 3 }])
        const more = gn.addNode(g, gn.NodeOp.lt, [i, { literal: 100 }], Types.bool)
        const back = gn.addNode(g, gn.NodeOp.select, [more, gn.addNode(g, gn.NodeOp.apply, [loop, step]), gn.addNode(g, gn.NodeOp.apply, [join, i])])
        const less = gn.addNode(g, gn.NodeOp.lt, [x, y], Types.bool)
        const entry = gn.addNode(g, gn.NodeOp.select, [less, gn.addNode(g, gn.NodeOp.apply, [join, x]), gn.addNode(g, gn.NodeOp.apply, [loop, y])])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [x, y], bodyId: entry, bodyConst: 0 }, { id: loop, params: [i], bodyId: back, bodyConst: 0 }, { id: join, params: [a], bodyId: arms, bodyConst: 0 }])
        const optimized = optimizePackaged(packageValueGraph(g, hostTarget), hostTarget)
        optimized.form = undefined
        lowerValueGraph(optimizePackaged(packageValueGraph(optimized, hostTarget), hostTarget))
    })
    harness.test('subtractMaskedValue', () => {
        for (const T of [Types.u64, Types.i64]) for (const mask of [3, 5, 10, 255, 65535, 2 ** 48 - 1, 2 ** 52 - 2, -4, -13]) for (const mode of ['', 'shared', 'other', 'narrow']) {
            const g = gn.createGraph({})
            const root = gn.addNode(g, gn.NodeOp.block, [])
            const x = gn.addNode(g, gn.NodeOp.param, [], T)
            const y = gn.addNode(g, gn.NodeOp.param, [], T)
            const out = gn.addNode(g, gn.NodeOp.param, [], Types.ptr)
            const masked = gn.addNode(g, gn.NodeOp.and, mask === 5 ? [{ literal: mask }, x] : [x, { literal: mask }], mode === 'narrow' ? Types.u32 : T)
            const sub = gn.addNode(g, gn.NodeOp.sub, [mode === 'other' ? y : x, masked], T)
            const ret = gn.addNode(g, gn.NodeOp.ret, [sub, root])
            const nil = gn.addNode(g, gn.NodeOp.startOf, [])
            const store = gn.addNode(g, gn.NodeOp.store, [nil, out, { literal: 0 }, masked], T)
            g.root = root
            gn.setGraphBlocks(g, [{ id: root, params: [x, y, out], bodyId: mode === 'shared' ? gn.addNode(g, gn.NodeOp.after, [store, ret]) : ret, bodyConst: 0 }])
            const optimized = optimizePackaged(packageValueGraph(g, hostTarget), hostTarget)
            const work = [optimized.blocks[0].bodyId]
            const seen = new Set<number>()
            let subtracts = 0
            while (work.length) {
                const id = work.pop()!
                const n = gn.getNode(optimized, id)
                if (!n || seen.has(id) || n.op === gn.NodeOp.block) continue
                seen.add(id)
                if (n.op === gn.NodeOp.sub) subtracts++
                for (let i = 0; i < gn.countIds(n); i++) work.push(gn.getRef(n, i))
            }
            const folded = mode === '' || (mode === 'narrow' && mask >= 0 && mask < 2 ** 32)
            if (folded !== (subtracts === 0)) harness.fail(`masked subtraction ${mask}/${mode}:\n${dumpGraph(optimized)}`)
            const code = lowerValueGraph(optimized)
            const run = (ts as any).createNativeFn(new Uint8Array(code.bytes))
            const saved = new BigUint64Array(1)
            const ptr = Number((ts as any).getArrayBufferPtr(saved.buffer))
            for (const value of [-1099511627899, -255, -1, 0, 1, 255, 65535, 1099511627899]) {
                const bits = mode === 'narrow' ? BigInt.asUintN(32, BigInt(value) & BigInt(mask)) : BigInt(value) & BigInt(mask)
                const expected = BigInt.asIntN(64, (mode === 'other' ? BigInt(19) : BigInt(value)) - bits)
                const actual = BigInt(run(value, 19, ptr))
                if (actual !== expected || (mode === 'shared' && saved[0] !== BigInt.asUintN(64, bits))) harness.fail(`masked subtraction ${mask}/${mode}(${value}): ${actual}, expected ${expected}`)
            }
        }
    })
    harness.test('reuseFloatConversions', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        const values = new Float64Array(2)
        const results = new BigUint64Array(3)
        const ptr = (v: ArrayBufferView) => Number((ts as any).getArrayBufferPtr(v.buffer)) + v.byteOffset
        const expected = (value: number, T: intrinsics.Types) => {
            const bits = T === Types.i32 || T === Types.u32 ? 32 : 64
            const signed = T === Types.i32 || T === Types.i64
            const one = BigInt(1)
            const min = signed ? -(one << BigInt(bits - 1)) : BigInt(0)
            const max = (one << BigInt(bits - (signed ? 1 : 0))) - one
            const n = Number.isNaN(value) ? BigInt(0) : value === Infinity ? max : value === -Infinity ? min : BigInt(Math.trunc(value))
            return BigInt.asUintN(bits, n < min ? min : n > max ? max : n)
        }
        for (const T of [Types.i64, Types.u64, Types.i32, Types.u32]) for (const hazard of ['', 'source', 'destination', 'entry', 'type']) {
            const other = hazard === 'type' ? T === Types.i64 ? Types.u64 : Types.i64 : T
            const asm = hostTarget.createAssembler()
            asm.load(32, 0, 0, Types.f64)
            asm.mov(50, 32)
            asm.convert(9, 50, Types.f64, T)
            asm.store(1, 0, 9, Types.u64)
            if (hazard === 'source') asm.load(50, 0, 8, Types.f64)
            if (hazard === 'destination') asm.movImm(9, 99)
            if (hazard === 'entry') { asm.jumpIfZero(2, 0); asm.movImm(9, 99); asm.bindLabel(0) }
            asm.convert(9, 50, Types.f64, other)
            asm.store(1, 8, 9, Types.u64)
            asm.convert(10, 32, Types.f64, T)
            asm.store(1, 16, 10, Types.u64)
            asm.movImm(0, 0)
            asm.ret()
            const listing = asm.listing()
            const count = (listing.match(/\bfcvtz[su]\b/g) ?? []).length
            const required = !hazard ? 1 : hazard === 'source' || hazard === 'type' || hazard === 'entry' ? 3 : 2
            if (count !== required) harness.fail(`conversion reuse ${T}/${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const value of [-100000.75, -1.8, -0, 0, 1.9, 2 ** 31, 2 ** 32 + 123, 2 ** 40 + 0.5, NaN, Infinity, -Infinity]) for (const flag of [0, 1]) {
                values[0] = value
                values[1] = 123.75
                run(ptr(values), ptr(results), flag)
                const want = [expected(value, T), expected(hazard === 'source' ? values[1] : value, other), expected(value, T)]
                if (results.some((v, i) => v !== want[i])) harness.fail(`conversion reuse ${T}/${hazard}(${value}): ${[...results]}, expected ${want}`)
            }
        }
    })
    harness.test('reuseCompareFlags', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        for (const hazard of ['', 'flags', 'operand', 'entry', 'copy']) {
            const asm = hostTarget.createAssembler()
            asm.mov(9, 0)
            if (hazard === 'entry') asm.jumpIfZero(1, 1)
            asm.compareImm('lt', 10, 0, 3, false)
            asm.jumpIfNonZero(10, 0)
            asm.released([{ value: 0, home: 10 }])
            if (hazard === 'flags') asm.compareImm('eq', -1, 1, 7, false)
            if (hazard === 'operand') asm.mov(0, 1)
            asm.bindLabel(1)
            asm.compareImm('eq', 11, hazard === 'copy' ? 9 : 0, 3, false)
            asm.mov(0, 11)
            asm.released([{ value: 0, home: 11 }])
            asm.ret()
            asm.bindLabel(0)
            asm.movImm(0, 17)
            asm.ret()
            const listing = asm.listing()
            const count = (listing.match(/cmp x(?:0|9), #3/g) ?? []).length
            if (count !== (!hazard || hazard === 'copy' ? 1 : 2)) harness.fail(`flag reuse ${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const x of [-1, 0, 1, 2, 3, 4, 1000000000]) for (const y of [0, 3, 7]) {
                const skipped = hazard === 'entry' && y === 0
                const expected = !skipped && BigInt.asUintN(64, BigInt(x)) < BigInt(3) ? 17 : (hazard === 'operand' && !skipped ? y : x) === 3 ? 1 : 0
                const actual = Number(run(x, y))
                if (actual !== expected) harness.fail(`flag reuse ${hazard}(${x},${y}): ${actual}, expected ${expected}`)
            }
        }
    })
    harness.test('pairPastIndependentAccesses', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        type Access = [load: boolean, reg: number, base: number, offset: number, T: intrinsics.Types]
        const ld = (reg: number, base: number, offset: number, T = Types.u64): Access => [true, reg, base, offset, T]
        const st = (base: number, offset: number, reg: number, T = Types.u64): Access => [false, reg, base, offset, T]
        const cases: [name: string, pairs: number, alias: boolean, accesses: Access[]][] = [
            ['load', 1, false, [ld(9, 0, 0), ld(12, 1, 0), ld(11, 0, 8)]],
            ['loadPastStore', 1, false, [ld(9, 0, 0), ld(12, 1, 0), st(0, 32, 12), ld(11, 0, 8)]],
            ['loadOverlap', 0, false, [ld(9, 0, 0), ld(12, 1, 0), st(0, 8, 12), ld(11, 0, 8)]],
            ['loadOtherStore', 0, true, [ld(9, 0, 0), st(1, 0, 3), ld(11, 0, 8)]],
            ['loadReg', 0, false, [ld(9, 0, 0), ld(11, 1, 0), ld(11, 0, 8)]],
            ['signed', 0, false, [ld(9, 0, 0, Types.i32), ld(12, 1, 0), ld(11, 0, 4, Types.i32)]],
            ['store', 1, false, [st(0, 0, 3), st(0, 32, 4), st(0, 8, 4)]],
            ['storeLoad', 1, false, [st(0, 0, 3), ld(12, 0, 32), st(0, 8, 4)]],
            ['storeOverlap', 0, false, [st(0, 0, 3), ld(12, 0, 8), st(0, 8, 4)]],
            ['storeOtherBase', 0, true, [st(0, 0, 3), st(1, 0, 4), st(0, 8, 3)]],
            ['storeMoves', 1, false, [st(0, 0, 3), ld(4, 0, 32), st(0, 8, 4)]],
            ['storeDefines', 0, false, [st(0, 0, 3), ld(3, 0, 32), ld(4, 0, 48), st(0, 8, 4)]],
        ]
        for (const [name, pairs, alias, accesses] of cases) {
            const asm = hostTarget.createAssembler()
            asm.movImm(4, -5)
            asm.movImm(9, 0)
            asm.movImm(11, 0)
            asm.movImm(12, 0)
            for (const [load, reg, base, offset, T] of accesses) {
                if (load) asm.load(reg, base, offset, T)
                else asm.store(base, offset, reg, T)
            }
            asm.store(2, 0, 9, Types.u64)
            asm.store(2, 16, 11, Types.u64)
            asm.store(2, 32, 12, Types.u64)
            asm.movImm(0, 0)
            asm.ret()
            const listing = asm.listing()
            const found = (listing.match(/\b(?:ldp|stp) [xw](?:9|11|3|4), /g) ?? []).length
            if (found !== pairs) harness.fail(`pair past accesses ${name}: ${found} pairs, expected ${pairs}:\n${listing}`)
            const memory = new BigUint64Array(16)
            const out = new BigUint64Array(6)
            for (let i = 0; i < 16; i++) memory[i] = BigInt(i + 1) * BigInt('0x9100000180000003')
            const model = new DataView(memory.slice().buffer)
            const base = Number((ts as any).getArrayBufferPtr(memory.buffer))
            const other = alias ? 8 : 64
            const regs = new Map<number, bigint>([[0, BigInt(0)], [1, BigInt(other)], [3, BigInt(77)], [4, BigInt(-5)], [9, BigInt(0)], [11, BigInt(0)], [12, BigInt(0)]])
            for (const [load, reg, rn, offset, T] of accesses) {
                const at = Number(regs.get(rn)!) + offset
                if (load) regs.set(reg, T === Types.i32 ? BigInt(model.getInt32(at, true)) : model.getBigUint64(at, true))
                else model.setBigUint64(at, BigInt.asUintN(64, regs.get(reg)!), true)
            }
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            run(base, base + other, Number((ts as any).getArrayBufferPtr(out.buffer)), 77)
            const want = [9, 11, 12].map(r => BigInt.asUintN(64, regs.get(r)!))
            const got = [out[0], out[2], out[4]]
            for (let i = 0; i < 16; i++) if (memory[i] !== model.getBigUint64(i * 8, true)) harness.fail(`pair past accesses ${name}: memory[${i}] = ${memory[i]}, expected ${model.getBigUint64(i * 8, true)}:\n${listing}`)
            if (got.some((v, i) => v !== want[i])) harness.fail(`pair past accesses ${name}: ${got}, expected ${want}:\n${listing}`)
        }
    })
    harness.test('composeBooleanCompares', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        const conditions: [string, (a: bigint, b: bigint) => boolean][] = [
            ['lt', (a, b) => a < b], ['ge', (a, b) => a >= b], ['eq', (a, b) => a === b], ['gt', (a, b) => a > b],
        ]
        for (const [op, check] of conditions) for (const outer of ['eq', 'ne']) for (const hazard of ['', 'flags', 'select', 'live']) {
            const asm = hostTarget.createAssembler()
            asm.compare(op, 9, 0, 1, true)
            if (hazard === 'flags') asm.compareImm('gt', 11, 2, 5, false)
            asm.compareImm(outer, 10, 9, 0, false)
            if (hazard === '' || hazard === 'flags') asm.released([{ value: 0, home: 9 }])
            if (hazard === 'select') {
                asm.select(12, 9, 0, 1)
                asm.released([{ value: 0, home: 9 }])
                asm.binary('add', 10, 10, 12, false)
            }
            if (hazard === 'flags') asm.binary('add', 10, 10, 11, false)
            if (hazard === 'live') asm.binary('add', 10, 10, 9, false)
            asm.mov(0, 10)
            asm.ret()
            const listing = asm.listing()
            const folded = hazard === '' || hazard === 'live'
            const sets = (listing.match(/\bcset\b/g) ?? []).length
            if (folded && (/\bcmp x9, #0/.test(listing) || sets !== (hazard === 'live' ? 2 : 1))) harness.fail(`compose ${op}/${outer}/${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const a of [-5, -1, 0, 1, 3, 2 ** 40]) for (const b of [-1, 0, 3]) for (const c of [0, 2, 9]) {
                const inner = check(BigInt(a), BigInt(b)) ? 1 : 0
                let expected = (outer === 'eq' ? inner === 0 : inner !== 0) ? 1 : 0
                if (hazard === 'flags') expected += c > 5 ? 1 : 0
                if (hazard === 'select') expected += inner ? a : b
                if (hazard === 'live') expected += inner
                const actual = Number(BigInt.asIntN(64, BigInt(run(a, b, c))))
                if (actual !== expected) harness.fail(`compose ${op}/${outer}/${hazard}(${a},${b},${c}): ${actual}, expected ${expected}:\n${listing}`)
            }
        }
        for (const op of ['lt', 'ge']) for (const use of ['value', 'branch', 'select', 'kept']) {
            const asm = hostTarget.createAssembler()
            asm.compareImm(op, 9, 0, 0, true)
            if (use === 'value') {
                asm.mov(0, 9)
                asm.released([{ value: 0, home: 9 }])
                asm.ret()
            } else if (use === 'select') {
                asm.select(10, 9, 1, 2)
                asm.released([{ value: 0, home: 9 }])
                asm.mov(0, 10)
                asm.ret()
            } else {
                asm.jumpIfNonZero(9, 0)
                if (use === 'branch') asm.released([{ value: 0, home: 9 }])
                asm.movImm(0, 7)
                if (use === 'kept') asm.binary('add', 0, 0, 9, false)
                asm.ret()
                asm.bindLabel(0)
                asm.movImm(0, 11)
                if (use === 'kept') asm.binary('add', 0, 0, 9, false)
                asm.ret()
            }
            const listing = asm.listing()
            const wanted = use === 'branch' ? /\btb(n)?z x0, #63/ : use !== 'select' && op === 'lt' ? /lsr x9, x0, #63/ : /cmp x0, #0/
            if (!wanted.test(listing) || (use === 'branch' && /\bcmp\b|\blsr\b/.test(listing))) harness.fail(`sign test ${op}/${use}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const a of [-(2 ** 40), -1, 0, 1, 2 ** 40]) {
                const truth = op === 'lt' ? a < 0 : a >= 0
                const expected = use === 'value' ? (truth ? 1 : 0) : use === 'select' ? (truth ? 3 : 4) : (truth ? 11 : 7) + (use === 'kept' ? (truth ? 1 : 0) : 0)
                const actual = Number(BigInt.asIntN(64, BigInt(run(a, 3, 4))))
                if (actual !== expected) harness.fail(`sign test ${op}/${use}(${a}): ${actual}, expected ${expected}:\n${listing}`)
            }
        }
    })
    harness.test('sharedSelectFlags', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        const asm = hostTarget.createAssembler()
        asm.movF64(32, 11)
        asm.movF64(33, 22)
        asm.movImm(13, 31)
        asm.movImm(14, 47)
        asm.compareImm('gt', 9, 0, 5, false)
        asm.select(34, 9, 32, 33)
        asm.select(10, 9, 13, 14)
        asm.released([{ value: 0, home: 9 }])
        asm.store(1, 0, 34, Types.f64)
        asm.mov(0, 10)
        asm.ret()
        const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
        const out = new Float64Array(1)
        const ptr = Number((ts as any).getArrayBufferPtr(out.buffer))
        for (const n of [0, 3, 5, 6, 9]) {
            const actual = Number(run(n, ptr))
            if (actual !== (n > 5 ? 31 : 47) || out[0] !== (n > 5 ? 11 : 22)) harness.fail(`shared select flags(${n}): ${actual}, ${out[0]}\n${asm.listing()}`)
        }
    })
    harness.test('guardedSelectFlags', () => {
        if (!hostTarget.name.startsWith('aarch64')) return
        const conditions: [string, (a: number, b: number) => boolean][] = [
            ['eq', (a, b) => a === b], ['ne', (a, b) => a !== b],
            ['lt', (a, b) => a < b], ['ge', (a, b) => a >= b],
            ['le', (a, b) => a <= b], ['gt', (a, b) => a > b],
        ]
        for (const [op, check] of conditions) for (const imm of [-31, 0, 17, 31, 32]) for (const mode of ['imm64', 'imm32', 'reg']) for (const hazard of ['', 'flags', 'value', 'entry']) {
            const asm = hostTarget.createAssembler()
            asm.movImm(9, 7)
            asm.movImm(13, 8)
            if (mode === 'reg') asm.movImm(14, imm)
            if (hazard === 'entry') asm.jumpIfZero(3, 1)
            asm.compare('eq', 10, 0, 1, false)
            asm.jumpIfZero(10, 0)
            asm.released([{ value: 0, home: 10 }])
            asm.bindLabel(1)
            if (mode === 'reg') asm.compare(op, 11, 2, 14, true)
            else asm.compareImm(op, 11, 2, imm, true, undefined, mode === 'imm32')
            asm.select(9, 11, 3, hazard === 'value' ? 13 : 9)
            asm.released([{ value: 0, home: 11 }])
            asm.bindLabel(0)
            if (hazard === 'flags') {
                asm.compareImm('eq', 12, 0, 1, false, ['lt', false])
                asm.binaryImm('shl', 12, 12, 8, false)
                asm.binary('add', 9, 9, 12, false)
            } else asm.compareImm('eq', -1, 1, 0, false)
            asm.mov(0, 9)
            asm.ret()
            const listing = asm.listing()
            const folded = !hazard && (mode === 'reg' || imm <= 31)
            if (folded === /\bb\.ne\b/.test(listing)) harness.fail(`guarded ${op} ${imm} ${mode} ${hazard}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const a of [0, 1, 2]) for (const b of [0, 1, 2]) for (const c of [-32, -31, 0, 1, 17, 31, 32]) for (const value of [0, 19]) {
                const entered = a === b || (hazard === 'entry' && value === 0)
                let expected = entered ? check(c, imm) ? value : hazard === 'value' ? 8 : 7 : 7
                if (hazard === 'flags') {
                    const bits = mode === 'imm32' ? 32 : 64
                    const carry = a === b ? BigInt.asUintN(bits, BigInt(c)) >= BigInt.asUintN(bits, BigInt(imm)) : a >= b
                    if (!carry && a === 1) expected += 256
                }
                const actual = Number(run(a, b, c, value))
                if (actual !== expected) harness.fail(`guarded ${op} ${imm} ${mode} ${hazard} (${a},${b},${c},${value}): ${actual}, expected ${expected}`)
            }
        }
    })
    function staticBlockMethod(n: u32): number {
        const tally: any = new Tally(n)
        return tally.bump(2) * 10 + tally.bump(1)
    }
    function staticBlockFriend(n: u32): number {
        const tally = new Tally(n)
        return peekTally(tally) * 10 + peekTally(new Tally(n + 3))
    }
    function staticBlockIndexTrap(n: u32): number {
        const tally: any = new Tally(n)
        tally[1] = n + 5
        tally[2] = 7
        return tally[0] + tally[1] * 100 + tally[2] * 10000 + tally.bump(0) * 1000000 + (tally[3] === undefined ? 1 : 0)
    }
    function exportedLetFriend(n: u32): number {
        return tallyCount(new Tally(n)) + 1
    }
    function letFunctionFriend(n: u32): number {
        return plainFriend(n) + 1
    }
    function constructorLetFriend(n: u32): number {
        return new TallyView(new Tally(n)).count + 1
    }
    function andZeroEffects(n: u32): u32 {
        const cell = { value: n }
        function step(x: u32): u32 {
            cell.value++
            return x
        }
        const a = step(n) & 0
        const b = 0 & step(n + 2)
        return a + b + cell.value
    }
    function unusedFieldEffects(n: u32): u32 {
        let calls: u32 = 0
        function effect(): number[] {
            calls++
            return [n, n + 1]
        }
        const object = { unused: effect(), value: n }
        return object.value + calls * 100
    }
    function unusedFieldIdentity(n: u32): u32 {
        const a = { hidden: n, spare: n + 1 }
        const b = { hidden: n + 2, spare: n + 3 }
        const selected = n & 1 ? a : b
        return (selected === a ? 1 : 2) + (a === b ? 10 : 20)
    }
    function unusedFieldKeys(n: u32): u32 {
        const object = { a: n, b: n + 1, c: n + 2 }
