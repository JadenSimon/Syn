        let b: PassBox = { n: k }
        let changed = false
        const passes: ((b: PassBox, k: number) => PassBox | boolean | void)[] = [truePass, freshPass, voidPass]
        for (const pass of passes) {
            const result = pass(b, k)
            if (typeof result === 'object') b = result
            changed ||= result === true
        }
        return b.n + (changed ? 1000 : 0)
    }

    interface Blk {
        id: number
