        const loop = unitListing(natives, 'dominatedLoop')
        if (/\bccmp\b/.test(loop) || (loop.match(/\bcmp x\d+, x\d+/g) ?? []).length !== 1) harness.fail(`dominatedLoop: i >= length inside i < length on the same length must fold, leaving one bound compare per iteration:\n${loop}`)
    }, 'aarch64')
