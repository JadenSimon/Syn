    bigStaticSeed++
}

class BigTableUser {
    declare count: number
    constructor(n: number) {
        this.count = n
    }
    bump(n: number): number {
        bigStaticTable.set(n + 5000, this.count)
        return bigStaticTable.get(n + 5000)! + this.count
    }
}

function bigStaticTableBump(n: u32): number {
    return new BigTableUser(n).bump(n)
}

function lateMethodValue(this: { v: number }): number {
    return this.v
}

function lateMethodField(n: u32): number {
    const a = { v: n, m: lateMethodValue }
    const b = { v: n + 0.5, m: undefined as unknown as typeof lateMethodValue }
    let s = 0
    let i: u32 = 0
    while (i < 4) {
        const h = i > 1 ? b : a
        s += h.m()
        if (i === 0) b.m = lateMethodValue
        i++
    }
    return s
}

interface Tree {
    v: number
    kids: Tree[]
}

function selfZeros(xs: number[], i: number): number {
    if (i >= xs.length) return 0
    const rest = () => selfZeros(xs, i + 1)
    if (xs[i] % 2 === 0) return Math.min(64, rest() + 1)
    return Math.max(rest(), i)
}

function sumTree(t: Tree, fn: (t: Tree) => number): number {
    let s = 0
    for (const k of t.kids) s += fn(k)
    return s
}
;(sumTree as any).shouldNotInline = true

function treeLines(out: string[], succ: Map<number, number[]>, id: number, prefix: string, branch: string): void {
    out.push(`${prefix}${branch}${id}`)
    const next = succ.get(id) ?? []
    for (let i = 0; i < next.length; i++) {
        const last = i === next.length - 1
        treeLines(out, succ, next[i], prefix + (branch ? branch === '`' ? ' ' : '|' : ''), last ? '`' : '+')
    }
}

function evenStep(x: number): boolean {
    return x % 2 === 0
}

function oddStep(x: number): boolean {
    return x % 2 === 1
}

function heldTest(n: number, test: (x: number) => boolean = evenStep): number {
    const box = { test }
    return box.test(n) ? 1 : 2
}
;(heldTest as any).shouldNotInline = true

function presizedBytes(count: number, lists: number): number {
    const capacity = tableCapacity(count)
    return lists * count * 8 + capacity * 4 + 16 + (capacity >> 1) + 64
}

function copiedSize(source: Map<number, number> | [number, number][], key: number): number {
    const m = new Map(source)
    return m.size * 10 + m.get(key)!
}
;(copiedSize as any).shouldNotInline = true

function sourceSize(source: Map<number, number> | number[]): number {
    if (source instanceof Map) return source.size
    return source.length
}
;(sourceSize as any).shouldNotInline = true

function narrowedSizes(n: u32): number {
    const m = new Map<number, number>()
    m.set(n, 1)
    return sourceSize(m) * 100 + sourceSize([n, n + 1])
}

function emptyMapSize(n: u32): number {
    const m = new Map<number, number>()
    return m.size + n
}

function copiedSources(n: u32): number {
    const pairs: [number, number][] = [[n, 1], [n + 1, 2]]
    const fromPairs = new Map(pairs)
    const fromMap = new Map(fromPairs)
    const fromArray = new Set([n, n + 1, n])
    const fromSet = new Set(fromArray)
    return fromPairs.size + fromMap.get(n + 1)! * 10 + fromArray.size * 100 + (fromSet.has(n) ? 1000 : 0)
}

function isMapValue(v: any): boolean {
    return v instanceof Map
}
;(isMapValue as any).shouldNotInline = true

function scaledOrLength(p: number | string, useDefault: boolean): number {
    const s = useDefault ? 0 : p
    return typeof s === 'number' ? s * 2 : 7
}
;(scaledOrLength as any).shouldNotInline = true

function prefixedLines(out: string[], id: number, prefix = ''): void {
    out.push(`${prefix}B${id}`)
    if (id < 3) prefixedLines(out, id + 1, prefix + '  ')
}

class Window4 {
    len: number
    constructor(len: number) {
        this.len = len
    }
    cutFixed(start: number, end?: number): number {
        const to = end === undefined ? 4 : end > 4 ? 4 : end
        return to - start
    }
}

function anyOf(xs: number[], fn: (x: number) => boolean): boolean {
    for (const x of xs) if (fn(x)) return true
    return false
}
;(anyOf as any).shouldNotInline = true

function edgeLists(edges: (v: number) => number[]): number[][] {
    const frames: number[][] = []
    const out: number[][] = []
    function enter(v: number): void {
        frames.push(edges(v))
    }
    enter(0)
    out.push([1])
    return out
}

function substituteLike(xs: number[], leaf: (x: number) => number | undefined): number {
    if (xs.length < 2) return leaf(xs[0]) ?? xs[0]
    let changed = 0
    const ys = xs.map(x => {
        const next = substituteLike(x > 1 ? [x - 1, x - 2] : [x], leaf)
        if (next !== x) changed++
        return next
    })
    let total = changed
    for (const y of ys) total += y
    return total
}

function stronglyConnectedLike(roots: number[], edges: (v: number) => number[]): number[][] {
    const index = new Map<number, number>()
    const frames: { v: number, next: number[], at: number }[] = []
    const out: number[][] = []
    function enter(v: number): void {
        index.set(v, index.size)
        frames.push({ v, next: edges(v), at: 0 })
    }
    for (const root of roots) {
        if (index.has(root)) continue
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.next.length) {
                const w = frame.next[frame.at++]
                if (!index.has(w)) enter(w)
                continue
            }
            frames.pop()
            out.push([frame.v])
        }
    }
    return out
}

function stepUp(x: number): number {
    return x + 1
}

function shortTwo(a: number, b?: number): number {
    if (b === undefined) return a
    return a * b
}

function scaleItems(items: ({ v: number } | number)[], k: number, extra?: { w: number }): number {
    const out = items.map(o => {
        if (typeof o === 'number') return o + k
        return o.v * k
    })
    return out[0] + out[1] + (extra ? extra.w : 0)
}

interface MiniTarget {
    bits: number
    layout(n: number): { bytes: number, link: number }
}
function miniLayout(n: number): { bytes: number, link: number } {
    return { bytes: n * 8, link: n }
}
function miniLower(opts: { target?: MiniTarget } = {}): number {
    const target = opts.target ?? { bits: 64, layout: miniLayout }
    const layout = target.layout(3)
    return layout.bytes + layout.link + target.bits
}
;(miniLower as any).shouldNotInline = true

let peekTally: (tally: Tally) => number
export let tallyCount: (tally: Tally) => number
const tallyHooks: { name: string, lower: () => number }[] = []

function registerTallyHook(name: string, lower: () => number): void {
    tallyHooks.push({ name, lower })
}

function halfOf(x: number): number {
    return x / 2
}
;(halfOf as any).shouldNotInline = true

function quarterOf(x: number): number {
    intrinsics.assert(x % 4 === 0)
    return x / 4
}
;(quarterOf as any).shouldNotInline = true

function poolIndex(slot: number, cellSlots: number): number {
    intrinsics.assert(slot >= 1 && (slot - 1) % cellSlots === 0)
    return (slot - 1) / cellSlots
}
;(poolIndex as any).shouldNotInline = true

function floorPoolCells(avail: u32, cellBytes: u32): number {
    const slots = (cellBytes + 7) >> 3
    if (slots === 0) return 0
    return Math.floor(avail / (slots * 8))
}
;(floorPoolCells as any).shouldNotInline = true

function cellsSink(cells: number): number {
    return cells + 1
}
;(cellsSink as any).shouldNotInline = true

function assertedFloorCells(avail: u32, cellBytes: u32): number {
    const slots = (cellBytes + 7) >> 3
    intrinsics.assert(slots > 0)
    const cells = Math.floor(avail / (slots * 8))
    return cellsSink(cells)
}
;(assertedFloorCells as any).shouldNotInline = true

function floorSigned(a: u32, b: u32): number {
    return Math.floor((a - 10) / ((b & 7) + 1))
}
;(floorSigned as any).shouldNotInline = true

function truncSigned(a: u32, b: u32): number {
    return Math.trunc((a - 10) / ((b & 7) + 1))
}
;(truncSigned as any).shouldNotInline = true

function truncF64(a: u32): number {
