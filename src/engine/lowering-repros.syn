    harness.test('pstackSyscallQuiet', () => {
        const natives: any = native.createNatives({ pstackSyscallLoop })
        for (const n of [0, 5]) {
            if (Number(natives.pstackSyscallLoop(n)) !== pstackSyscallLoop(n)) harness.fail(`repro pstackSyscallQuiet FAILED: pstackSyscallLoop(${n}) returned ${natives.pstackSyscallLoop(n)}, expected ${pstackSyscallLoop(n)}`)
        }
