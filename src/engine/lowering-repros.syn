        if (scratch !== plain) harness.fail(`repro pstackQuietCall FAILED: pstackQuietScratch must compile like pstackQuietPlain once its point is scalar-replaced; pstackTouch writes memory but allocates on no pstack, so the loop's reset is idle:\n${scratch}\n--- pstackQuietPlain ---\n${plain}`)
