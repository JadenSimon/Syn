        const m = new Map(pairs)
        let order = 0
        for (const [key, value] of m) order = order * 7 + (key - n) * 100 + value
        return m.size * 1000000 + order % 1000003 + m.get(n + 2)! * 10
    }
    cases.push([mapFromDuplicatePairs, [1]])
    function setFromDuplicateValues(n: u32): number {
        const values: number[] = []
