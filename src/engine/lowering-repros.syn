        native.functionObjectCalls(g, new Map([[88, 66 as intrinsics.Handle]]))
        native.substituteConstantParams(g, new Map([[0, { literal: 5 }]]))
        const object = gn.getNode(g, gn.getRef(gn.getNode(g, after)!, 1))!
        const call = gn.getNode(g, gn.getRef(gn.getNode(g, after)!, 0))!
        const target = gn.getNode(g, gn.getRef(call, 1))!
        const arg = gn.getNode(g, gn.getRef(call, 3))!
        if (gn.getLiteral(g, object, 0) !== 99 || gn.getLiteral(g, target, 0) !== 66 || arg.op !== gn.NodeOp.literal || gn.getLiteral(g, arg, 0) !== 5) harness.fail('function objects, call code and constant params must follow the given maps')
    })
    function unitGraph(name: string, space: Graph | undefined, params: intrinsics.Types[], body: (g: Graph, root: number, params: number[]) => number): Graph {
        const g = gn.createGraph(space ? { ids: space.ids, literals: space.literals, name } : { name })
