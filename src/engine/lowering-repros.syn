    function loopBoundRead(n: u32): number {
        const a = new Int32Array(n + 1)
        a[1] = 5
        for (let i = 1; i <= n; i++) a[i] += a[i - 1]
        return a[n]
    }
    cases.push([loopBoundRead, [3], [6]])
    function loopJoinRead(n: u32): number {
        const a = [n, n + 1, n + 2, n + 3]
        const b = new Int32Array(8)
        let total = 0
        for (let i = 0; i < a.length; i++) {
            const v = a[i]
            if (v > 4) b[i] = v
            total += a[i]
        }
        return total + b[1]
    }
    cases.push([loopJoinRead, [3], [6]])
    function assertedCursorLoop(n: u32): number {
        const cursor = new Int32Array(n + 2)
        const stack = [0, 1, n]
        let total = 0
        while (stack.length) {
            const from = stack.pop()!
            intrinsics.assert(from < cursor.length)
            if (from === 7) continue
            while (cursor[from] < 3) cursor[from]++
            total += cursor[from]
        }
        return total
    }
    cases.push([assertedCursorLoop, [3], [6]])
