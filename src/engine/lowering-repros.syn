        }
        function scan(t: Tree): number {
            return t.v * 2 + sumTree(t, scan)
        }
        return visit(root) * 100 + scan(root) + visit(root.kids.find(t => t.v > 5))
    }
    function boolFieldsByIndex(n: u32): number {
        const fs: { on: boolean, off: boolean, k: number }[] = []
        for (let i = 0; i < n; i++) fs.push({ on: i % 3 === 0, off: i % 2 === 1, k: i })
        let s = 0
        for (let i = 0; i < n; i++) s += (fs[i].on ? fs[i].k : 0) + (fs[i].off ? 1000 : 0)
        return s
    }
    function maskedLiteralIndex(n: u32): number {
        const a = [1, 2, 3, 4, 5, 6, 7, 8]
        let s = 0
        for (let i = 0; i < n; i++) s += a[i & 7]
        return s
    }
    function moduloLiteralIndex(n: u32): number {
        const a = [1, 2, 3, 4, 5, 6, 7, 8]
        let s = 0
        for (let i = 0; i < n; i++) s += a[i % 8]
        return s
    }
    function envReassign(n: u32): u32 {
        let g = { v: n }
        function step(o: { v: u32 }): { v: u32 } {
            return { v: o.v + 1 }
        }
        function bump(): void {
            g = step(g)
        }
        for (let i: u32 = 0; i < n; i++) bump()
        return g.v
    }
    function envScc(n: u32): number {
        const targets = new Map<number, number>()
        const positions = new Map<number, { at: number }[]>()
        for (let id = 1; id <= 3; id++) {
            targets.set(id * 10, id < 3 ? id + 1 : n > 2 ? 1 : 0)
            positions.set(id, [{ at: id * 10 }])
        }
        function targetOf(p: { at: number }): number | undefined {
            const t = targets.get(p.at)!
            return t ? t : undefined
        }
        const edges = (id: number) => positions.get(id)!.flatMap(p => {
            const t = targetOf(p)
            return t === undefined ? [] : [t]
        })
        let c = 0
        for (const scc of stronglyConnected([1, 2, 3], edges)) c = c * 10 + scc.length
        return c
    }
    function mixedRecord(n: u32): { a: number, b: u32 } {
        return { a: n + 0.5, b: n + 3 }
    }
    ;(mixedRecord as any).shouldNotInline = true
    function mixedRecordRoot(n: u32): number {
        const r = mixedRecord(n)
        return r.a * 2 + r.b
    }
    function floatPairRecord(n: u32): { x: number, y: number } {
        return { x: n + 0.25, y: n * 1.5 }
    }
    ;(floatPairRecord as any).shouldNotInline = true
    function floatPairRecordRoot(n: u32): number {
        const r = floatPairRecord(n)
        return r.x * 4 + r.y
    }
    function literalFieldRecord(n: u32): { a: number, b: u32 } {
        if (n === 0) return { a: 1, b: 9 }
        return { a: n + 0.5, b: n }
    }
    ;(literalFieldRecord as any).shouldNotInline = true
    function literalFieldRecordRoot(n: u32): number {
        const r = literalFieldRecord(n)
        return r.a * 2 + r.b
    }
    function recursivePredicate(x: number | undefined, depth: u32): boolean {
        if (depth === 0) return x !== undefined
        if (!recursivePredicate(x, depth - 1)) return false
        return x! > 0
    }
    function recursiveGuard(n: u32): number {
        const x = n > 2 ? n : undefined
        return recursivePredicate(x, 3) ? x! + 1 : 0
    }
