        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackSyscallQuiet FAILED: pstackSyscallLoop resets a pstack (${stores.join('; ')}), though its callee only makes a syscall, which allocates on no pstack:\n${listing}`)
    }, 'aarch64')
    harness.test('storedLiteralArgument', () => {
        const natives: any = native.createNatives({ storedLiteralArgument })
        for (const [k, depth] of [[4, 1], [3, 2], [5, 6], [3, 7]]) {
            const expected = storedLiteralArgument(k, depth)
            const actual = Number(natives.storedLiteralArgument(k, depth))
            if (actual !== expected) harness.fail(`repro storedLiteralArgument FAILED: storedLiteralArgument(${k}, ${depth}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'storedLiteralArgument')
        const threes = listing.split('\n').filter(line => /\bmovz [xw]\d+, #3$/.test(line.trim()))
        if (threes.length !== 1) harness.fail(`repro storedLiteralArgument FAILED: on the k === 3 path the cell's field a and the argument k are both 3, so one register serves both, but the field's literal is materialized in a scratch register outside the allocator and the argument is materialized again (${threes.length} materializations):\n${listing}`)
    }, 'aarch64-darwin')
    harness.test('syscallKeepsValues', () => {
        const natives: any = native.createNatives({ syscallKeepsValues })
        for (const [a, b, c] of [[0, 0, 0], [3, 9, 11], [65535, 7, 1]]) {
            const expected = syscallKeepsValues(a, b, c)
            const actual = Number(natives.syscallKeepsValues(a, b, c))
            if (actual !== expected) harness.fail(`repro syscallKeepsValues FAILED: syscallKeepsValues(${a}, ${b}, ${c}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'syscallKeepsValues')
        const saves = listing.split('\n').filter(line => /\[sp\b|\bx(?:19|2\d)\b/.test(line)).map(line => line.trim())
        if (saves.length) harness.fail(`repro syscallKeepsValues FAILED: a darwin syscall writes only x0 and x1, so a, b and c can stay in caller-saved registers across the write, but the listing saves or uses callee-saved registers (${saves.join('; ')}):\n${listing}`)
    }, 'aarch64-darwin')
    harness.test('sameConstantArg', () => {
        const natives: any = native.createNatives({ sameConstantArg })
        for (const [a, b] of [[0, 0], [3, 9], [65535, 7]]) {
            const expected = sameConstantArg(a, b)
            const actual = Number(natives.sameConstantArg(a, b))
            if (actual !== expected) harness.fail(`repro sameConstantArg FAILED: sameConstantArg(${a}, ${b}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'sameConstantArg')
        const callee: string = natives.sameConstantArg.units.find((unit: any) => unit.name === 'keepsThirdArg').code.listing
        const sets = listing.split('\n').filter(line => /\bmovz [xw]2, #1\b/.test(line)).map(line => line.trim())
        if (sets.length > 1) harness.fail(`repro sameConstantArg FAILED: keepsThirdArg never writes x2, so the 1 passed in x2 to the first call is still there for the second, but the caller sets x2 to 1 ${sets.length} times (${sets.join('; ')}):\n${listing}\nkeepsThirdArg:\n${callee}`)
    }, 'aarch64-darwin')
    harness.test('savedForShortValue', () => {
        const natives: any = native.createNatives({ savedForShortValue })
        for (const [a, b, c] of [[0, 0, 0], [3, 9, 4], [65535, 7, 100000]]) {
            const expected = savedForShortValue(a, b, c)
            const actual = Number(natives.savedForShortValue(a, b, c))
            if (actual !== expected) harness.fail(`repro savedForShortValue FAILED: savedForShortValue(${a}, ${b}, ${c}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'savedForShortValue')
        const fresh = new Set(listing.match(/\b[xw](?:9|1[0-5])\b/g) ?? [])
        if (fresh.size > 1) harness.fail(`repro savedForShortValue FAILED: t lives only after the last call, and the callee-saved register that held c is already saved and free by then, but t takes another caller-saved register, which every caller then treats as clobbered (${[...fresh].join(', ')}):\n${listing}`)
    }, 'aarch64-darwin')
    harness.test('freedBeforeCall', () => {
        const natives: any = native.createNatives({ freedBeforeCall })
        for (const [a, b, c, n] of [[0, 0, 0, 0], [3, 9, 4, 5], [65535, 7, 100000, 40]]) {
            const expected = freedBeforeCall(a, b, c, n)
            const actual = Number(natives.freedBeforeCall(a, b, c, n))
            if (actual !== expected) harness.fail(`repro freedBeforeCall FAILED: freedBeforeCall(${a}, ${b}, ${c}, ${n}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'freedBeforeCall')
        const words = natives.freedBeforeCall.units.find((unit: any) => unit.name === 'freedBeforeCall').code.words.length
        if (words > 7) harness.fail(`repro freedBeforeCall FAILED: a, b and c die in (a * b) ^ c, which does not call, so evaluating it before crowdedCall leaves one value live across the call, but the call goes first and a, b and c cross it (${words} instructions, expected at most 7):\n${listing}`)
    }, 'aarch64-darwin')
    harness.test('crowdedLoop', () => {
        const natives: any = native.createNatives({ crowdedLoop })
        for (const [n, a] of [[0, 0], [5, 3], [40, 1000]]) {
            const expected = crowdedLoop(n, a)
            const actual = Number(natives.crowdedLoop(n, a))
            if (actual !== expected) harness.fail(`repro crowdedLoop FAILED: crowdedLoop(${n}, ${a}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'crowdedLoop')
        const saved = listing.split('\n').filter(line => /\bsp\b|\bx(?:19|2[0-8])\b/.test(line)).map(line => line.trim())
        if (saved.length) harness.fail(`repro crowdedLoop FAILED: the loop keeps n, i and 13 sums live plus one temporary, 16 values; x0-x7, x9-x15 and the caller-saved x8 hold them, but x8 is never allocated, so the leaf saves a callee-saved register or spills (${saved.join('; ')}):\n${listing}`)
    }, 'aarch64-darwin')
    harness.test('voidResultKeepsX0', () => {
        const natives: any = native.createNatives({ voidResultKeepsX0 })
        const actual = Number(natives.voidResultKeepsX0(1))
        if (actual !== 2) harness.fail(`repro voidResultKeepsX0 FAILED: voidResultKeepsX0(1) returned ${actual}, expected 2`)
        const listing = unitListing(natives, 'voidResultKeepsX0')
        const callee: string = natives.voidResultKeepsX0.units.find((unit: any) => unit.name === 'tallyAt').code.listing
        const copies = listing.split('\n').filter(line => /\bmov x\d+, x0\b/.test(line)).map(line => line.trim())
        if (copies.length) harness.fail(`repro voidResultKeepsX0 FAILED: tallyAt returns nothing and never writes x0, so a stays in x0 across the first call, but the caller binds the void result to x0 and moves a out of the way (${copies.join('; ')}):\n${listing}\ntallyAt:\n${callee}`)
    }, 'aarch64-darwin')
    harness.test('zeroStoresBeforeTailCall', () => {
        const natives: any = native.createNatives({ zeroStoresBeforeTailCall })
        const memory = new Uint8Array(96).fill(0xa5)
        natives.zeroStoresBeforeTailCall(Number((ts as any).getArrayBufferPtr(memory.buffer)))
        const words = new BigUint64Array(memory.buffer)
        if (words.slice(0, 10).some(w => w !== BigInt(0)) || words[10] !== BigInt(1)) harness.fail(`repro zeroStoresBeforeTailCall FAILED: memory ${words.join()}`)
        const listing = unitListing(natives, 'zeroStoresBeforeTailCall')
        if (!/\bmovi v16\.2d, #0/.test(listing) || !/\bstp q16, q16/.test(listing)) {
            harness.fail(`repro zeroStoresBeforeTailCall FAILED: the 80 cleared bytes take three vector stores, as in zeroStores80, but values released at the tail call never reach the assembler, so the zero stores are never compacted:\n${listing}`)
        }
    }, 'aarch64-darwin')
    harness.test('pstackMarkersQuiet', () => {
        const natives: any = native.createNatives({ pstackReachCount })
        for (const n of [0, 5, 64]) {
            if (Number(natives.pstackReachCount(n)) !== pstackReachCount(n)) harness.fail(`repro pstackMarkersQuiet FAILED: pstackReachCount(${n}) returned ${natives.pstackReachCount(n)}, expected ${pstackReachCount(n)}`)
        }
        const listing: string = natives.pstackReachCount.units.find((unit: any) => unit.name === 'pstackReaches').code.listing
        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackMarkersQuiet FAILED: pstackReaches resets a pstack (${stores.join('; ')}), though its loop allocates on none; the markers of its two latches keep each other alive:\n${listing}`)
    }, 'aarch64')
    harness.test('pstackCellsTogether', () => {
        const natives: any = native.createNatives({ resetsAfterCall })
        for (const [reps, n] of [[0, 0], [1, 2], [5, 3]]) {
            const expected = resetsAfterCall(reps, n)
            const actual = Number(natives.resetsAfterCall(reps, n))
            if (actual !== expected) harness.fail(`repro pstackCellsTogether FAILED: resetsAfterCall(${reps}, ${n}) returned ${actual}, expected ${expected}`)
        }
        const listing = unitListing(natives, 'resetsAfterCall')
        const after = listing.slice(listing.indexOf('bl downCount'))
        const cells = after.split('\n').filter(line => /\bldr x\d+, entry/.test(line)).map(line => line.trim())
        if (cells.length !== 1 || !/\bstp d\d+, d\d+, \[x\d+, #\d+\]/.test(after)) {
            harness.fail(`repro pstackCellsTogether FAILED: after each downCount call the loop writes back the tops of three pstacks; adjacent top cells take one address load and paired stores, but each cell sits at the base of its own pstack region, so each write loads its own address (${cells.join('; ')}):\n${listing}`)
        }
    }, 'aarch64-darwin')
    harness.test('pstackThrowOnlyCall', () => {
        const natives: any = native.createNatives({ pstackCheckedSum })
        for (const n of [0, 3, 40]) {
            if (Number(natives.pstackCheckedSum(n)) !== pstackCheckedSum(n)) harness.fail(`repro pstackThrowOnlyCall FAILED: pstackCheckedSum(${n}) returned ${natives.pstackCheckedSum(n)}, expected ${pstackCheckedSum(n)}`)
        }
        const listing = unitListing(natives, 'pstackCheckedSum')
        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackThrowOnlyCall FAILED: pstackCheckedSum resets a pstack (${stores.join('; ')}), though pstackCheckedStep allocates only on its throw path and never returns with a stack grown:\n${listing}`)
    }, 'aarch64')
    harness.test('pstackExitArmAllocation', () => {
        const natives: any = native.createNatives({ pstackQuietExitArm })
        for (const n of [0, 3, 40, 60]) {
            if (Number(natives.pstackQuietExitArm(n)) !== pstackQuietExitArm(n)) harness.fail(`repro pstackExitArmAllocation FAILED: pstackQuietExitArm(${n}) returned ${natives.pstackQuietExitArm(n)}, expected ${pstackQuietExitArm(n)}`)
        }
        const listing = unitListing(natives, 'pstackQuietExitArm')
        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackExitArmAllocation FAILED: pstackQuietExitArm resets a pstack (${stores.join('; ')}), though its loop allocates on none; the array is allocated on the exit arm, which never enters the loop:\n${listing}`)
    }, 'aarch64')
    harness.test('pstackMarkerOnlyCall', () => {
        const natives: any = native.createNatives({ pstackQuietOuter })
        for (const n of [0, 3, 40]) {
            if (Number(natives.pstackQuietOuter(n)) !== pstackQuietOuter(n)) harness.fail(`repro pstackMarkerOnlyCall FAILED: pstackQuietOuter(${n}) returned ${natives.pstackQuietOuter(n)}, expected ${pstackQuietOuter(n)}`)
        }
        const listing = unitListing(natives, 'pstackQuietOuter')
        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackMarkerOnlyCall FAILED: pstackQuietOuter resets a pstack (${stores.join('; ')}), though pstackQuietInner allocates on none; its loop's own marks and markers never grow a stack:\n${listing}`)
    }, 'aarch64')
    harness.test('pstackStaleCallee', () => {
        const natives: any = native.createNatives({ pstackStaleOuter })
        for (const n of [0, 3, 40]) {
            if (Number(natives.pstackStaleOuter(n)) !== pstackStaleOuter(n)) harness.fail(`repro pstackStaleCallee FAILED: pstackStaleOuter(${n}) returned ${natives.pstackStaleOuter(n)}, expected ${pstackStaleOuter(n)}`)
        }
        const listing = unitListing(natives, 'pstackStaleOuter')
        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackStaleCallee FAILED: pstackStaleOuter resets a pstack (${stores.join('; ')}), though pstackStaleInner's point becomes a frame slot when pstackStaleInner is lowered and it allocates on no pstack:\n${listing}`)
    }, 'aarch64')
    harness.test('pstackStaleRecursiveCallee', () => {
        const natives: any = native.createNatives({ pstackStaleChainOuter })
        for (const n of [0, 3, 40]) {
            if (Number(natives.pstackStaleChainOuter(n)) !== pstackStaleChainOuter(n)) harness.fail(`repro pstackStaleRecursiveCallee FAILED: pstackStaleChainOuter(${n}) returned ${natives.pstackStaleChainOuter(n)}, expected ${pstackStaleChainOuter(n)}`)
        }
        const listing = unitListing(natives, 'pstackStaleChainOuter')
        const stores = pstackCellStores(listing)
        if (stores.length) harness.fail(`repro pstackStaleRecursiveCallee FAILED: pstackStaleChainOuter resets a pstack (${stores.join('; ')}), though recursive pstackStaleChain's point is gone once it is lowered; its call to itself must not keep the stale stack bit:\n${listing}`)
    }, 'aarch64')
    harness.test('slabRebuiltField', () => {
        const roots: any = { slabIndexRounds, slabIndexGrowth, slabLocalTemp }
        const natives: any = native.createNatives(roots)
        const stacks = [0, 1, 2, 3, 4]
        function measure(name: string, n: number): [pstack: number, live: number, peak: number] {
            const marks = stacks.map(stack => native.pstackMark(stack))
            native.resetSlabPeak()
            const [before] = native.slabBytes()
            const expected = roots[name](n)
            const actual = Number(natives[name](n))
            const grown = stacks.reduce((sum, stack, i) => sum + Number(native.pstackMark(stack) - marks[i]), 0)
            const [live, peak] = native.slabBytes()
            stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
            if (actual !== expected) harness.fail(`repro slabRebuiltField FAILED: ${name}(${n}) returned ${actual}, expected ${expected}`)
            console.log(`repro slabRebuiltField: ${name}(${n}) pstack ${grown} B, slab live ${Number(live - before)} B, peak ${Number(peak - before)} B`)
            return [grown, Number(live - before), Number(peak - before)]
        }
        const temp = measure('slabLocalTemp', 1000)
        if (temp[2] !== 0) harness.fail(`repro slabRebuiltField FAILED: slabLocalTemp's array never leaves its frame, so its slices stay on the pstack, but the slab peaked ${temp[2]} B above its start`)
        const grown = measure('slabIndexGrowth', 1000)
        if (grown[1] <= 0) harness.fail(`repro slabRebuiltField FAILED: SlabEdgeIndex.items is held by the index and outlives the frames that grow it, so its slices come from the slab, but slab live grew ${grown[1]} B`)
        if (grown[1] >= grown[2]) harness.fail(`repro slabRebuiltField FAILED: reserve releases the slice it replaces, so slab live (${grown[1]} B) ends below its peak (${grown[2]} B)`)
        if (grown[1] > 8192) harness.fail(`repro slabRebuiltField FAILED: after 1000 appends slab live holds only the last slice of 1020 elements, but it is ${grown[1]} B`)
        const few = measure('slabIndexRounds', 64)
        const many = measure('slabIndexRounds', 512)
        if (few[1] <= 0 || many[1] <= 0) harness.fail(`repro slabRebuiltField FAILED: the rebuilt items come from the slab, but slab live grew ${few[1]} B and ${many[1]} B`)
        console.log(`repro slabRebuiltField: per round pstack ${((many[0] - few[0]) / 448).toFixed(1)} B, slab live ${((many[1] - few[1]) / 448).toFixed(1)} B`)
    })
    harness.test('prefixShapes', () => {
        const natives: any = native.createNatives({ prefixShapes })
        for (const n of [0, 3, 40]) {
            if (Number(natives.prefixShapes(n)) !== prefixShapes(n)) harness.fail(`repro prefixShapes FAILED: prefixShapes(${n}) returned ${natives.prefixShapes(n)}, expected ${prefixShapes(n)}`)
        }
        for (const name of ['prefixRead', 'prefixSum']) {
            const count = unitsNamed(natives, 'prefixShapes', name)
            if (count !== 1) harness.fail(`repro prefixShapes FAILED: ${name} reads only a and b of { a, b } and { a, b, c }, which share that layout prefix, so it compiles to one unit, not ${count}`)
        }
    })
    harness.test('prefixWrites', () => {
        const natives: any = native.createNatives({ prefixWrites })
        for (const n of [0, 3, 40]) {
            if (Number(natives.prefixWrites(n)) !== prefixWrites(n)) harness.fail(`repro prefixWrites FAILED: prefixWrites(${n}) returned ${natives.prefixWrites(n)}, expected ${prefixWrites(n)}`)
        }
        const count = unitsNamed(natives, 'prefixWrites', 'prefixBump')
        if (count !== 1) harness.fail(`repro prefixWrites FAILED: prefixBump writes only a of { a, b } and { a, b, c }, so it compiles to one unit, not ${count}`)
    })
    harness.test('sizedBoxes', () => {
        const natives: any = native.createNatives({ sizedBoxes })
        for (const n of [2, 3, 40]) {
            if (Number(natives.sizedBoxes(n)) !== sizedBoxes(n)) harness.fail(`repro sizedBoxes FAILED: sizedBoxes(${n}) returned ${natives.sizedBoxes(n)}, expected ${sizedBoxes(n)}`)
        }
        const count = unitsNamed(natives, 'sizedBoxes', 'size')
        if (count !== 1) harness.fail(`repro sizedBoxes FAILED: SizedBox<number>.size and SizedBox<string>.size never read T, so they compile to one unit, not ${count}`)
    })
    harness.test('prefixRecursive', () => {
        const natives: any = native.createNatives({ prefixRecursive })
        for (const n of [0, 3, 40]) {
            if (Number(natives.prefixRecursive(n)) !== prefixRecursive(n)) harness.fail(`repro prefixRecursive FAILED: prefixRecursive(${n}) returned ${natives.prefixRecursive(n)}, expected ${prefixRecursive(n)}`)
        }
        const count = unitsNamed(natives, 'prefixRecursive', 'depth')
        if (count !== 1) harness.fail(`repro prefixRecursive FAILED: depth reads only a and b of DepthPair and DepthTriple, which share that layout prefix; its two specializations differ only in calling themselves, so they compile to one unit, not ${count}`)
    })
    harness.test('prefixMismatched', () => {
        const natives: any = native.createNatives({ prefixMismatched })
        for (const n of [0, 3, 40]) {
            if (Number(natives.prefixMismatched(n)) !== prefixMismatched(n)) harness.fail(`repro prefixMismatched FAILED: prefixMismatched(${n}) returned ${natives.prefixMismatched(n)}, expected ${prefixMismatched(n)}`)
        }
    })
    harness.test('namedSteps', () => {
        const natives: any = native.createNatives({ namedSteps })
        for (const n of [0, 3, 40]) {
            if (Number(natives.namedSteps(n)) !== namedSteps(n)) harness.fail(`repro namedSteps FAILED: namedSteps(${n}) returned ${natives.namedSteps(n)}, expected ${namedSteps(n)}`)
        }
        const count = unitsNamed(natives, 'namedSteps', 'stepNamed')
        if (count !== 1) harness.fail(`repro namedSteps FAILED: stepNamed only reads pass.name, a handle address it never uses, so it compiles to one unit, not ${count}`)
    })
    harness.test('pstackStringScratch', () => {
        const natives: any = native.createNatives({ pstackLabelled })
        const stacks = [0, 1, 2, 3]
        const growth: number[] = []
        for (const n of [256, 2048]) {
            const marks = stacks.map(stack => native.pstackMark(stack))
            const expected = pstackLabelled(n)
            const actual = Number(natives.pstackLabelled(n))
            growth.push(stacks.reduce((sum, stack, i) => sum + Number(native.pstackMark(stack) - marks[i]), 0))
            stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
            if (actual !== expected) harness.fail(`repro pstackStringScratch FAILED: pstackLabelled(${n}) returned ${actual}, expected ${expected}`)
        }
        const perCall = (growth[1] - growth[0]) / (2048 - 256)
        console.log(`repro pstackStringScratch: ${growth[0]} B at 256, ${growth[1]} B at 2048 (${perCall.toFixed(1)} B per iteration)`)
        if (perCall > 64) harness.fail(`repro pstackStringScratch FAILED: pstackLabelled grows the pstacks ${perCall.toFixed(1)} B per iteration; the label's bytes escape into a heap string, but pstackWordLabel's words are dead once it returns and must not share their stack`)
    })
    harness.test('listingLabelsPerUnit', () => {
        const first: any = native.createNatives({ labelledSum })
        native.createNatives({ labelledProduct })
        const second: any = native.createNatives({ labelledSum })
        const listings: string[] = [first, second].map(natives => natives.labelledSum.units.find((unit: any) => unit.name === 'labelledSum').code.listing)
        if (listings[0] !== listings[1]) harness.fail(`repro listingLabelsPerUnit FAILED: labelledSum compiled twice must list the same text, not labels that follow what compiled before:\n${listings[0]}\n---\n${listings[1]}`)
        const defined = [...listings[0].matchAll(/^L(\d+):$/gm)].map(m => Number(m[1]))
        if (!defined.length || defined.some((label, i) => label !== i)) harness.fail(`repro listingLabelsPerUnit FAILED: labels must be numbered L0, L1, ... in the order they are defined, got ${defined.map(label => `L${label}`).join(' ')}:\n${listings[0]}`)
        for (const n of [0, 5, 40]) {
            if (Number(second.labelledSum(n)) !== labelledSum(n)) harness.fail(`repro listingLabelsPerUnit FAILED: labelledSum(${n}) returned ${second.labelledSum(n)}, expected ${labelledSum(n)}`)
        }
    })
    harness.test('listingCallsByName', () => {
        const alone: any = native.createNatives({ namedCalls })
        const beside: any = native.createNatives({ labelledSum, labelledProduct, namedCalls })
        const listings: string[] = [alone, beside].map(natives => natives.namedCalls.units.find((unit: any) => unit.name === 'namedCalls').code.listing)
        if (!/\bbl\b/.test(listings[0])) harness.fail(`repro listingCallsByName FAILED: namedCalls must call calledStep:\n${listings[0]}`)
        if (listings[0] !== listings[1]) harness.fail(`repro listingCallsByName FAILED: namedCalls must list the same text beside other roots, not calls named by unit index:\n${listings[0]}\n---\n${listings[1]}`)
        for (const n of [0, 5, 40]) {
            if (Number(beside.namedCalls(n)) !== namedCalls(n)) harness.fail(`repro listingCallsByName FAILED: namedCalls(${n}) returned ${beside.namedCalls(n)}, expected ${namedCalls(n)}`)
        }
    })
}
