    harness.flagged('typeofNarrowsUnknown', ['type-debug:next', 'type-debug-exprs'], () => native.classCutText(CheckedSize), stdout => {
        const lines = stdout.split('\n')
        const narrowed = lines.find(line => line.includes('narrow p0 by number =>'))
        const sum = lines.find(line => line.includes('arith add('))
        if (!narrowed?.endsWith('=> i64|f64') || !sum?.endsWith('=> i64|f64')) harness.fail(`CheckedSize.next: typeof value === 'number' must narrow an unknown input to a number:\n${narrowed}\n${sum}`)
    })
    harness.flagged('restFieldOfArray', ['cut-dump'], () => native.createNatives({ restFeeder }), stdout => {
        const feeder = stdout.split('\n').find(line => line.startsWith('  RestFeeder<'))
        if (!feeder || feeder.includes('SLOW PATH')) harness.fail(`RestCounter.add returns its rest param's length, a field of the Array summary:\n${feeder}`)
    })
    harness.flagged('loopReadsInBounds', ['cut-dump'], () => {
        const natives: any = native.createNatives({ loopKeysCase })
        for (const n of [0, 1, 5]) if (Number(natives.loopKeysCase(n)) !== loopKeysCase(n)) harness.fail(`loopKeysCase(${n}) = ${natives.loopKeysCase(n)}, expected ${loopKeysCase(n)}`)
    }, stdout => {
        const keyed = stdout.split('\n').filter(line => /^  (Set|Map)<.*  #\d+ loop(Pair|Hoisted|Call|Rest|Next)Keys%/.test(line))
        if (keyed.length !== 5 || keyed.some(line => line.includes('undefined'))) harness.fail(`chain[i] under i < chain.length (or i - 1, or a hoisted length, or after an unrelated call, or a hoisted rest length, or under i + 1 < row.length) is in bounds:\n${keyed.join('\n')}`)
        const guarded = stdout.split('\n').filter(line => /^  Set<.*  #\d+ first(Truthy|Falsy|Strict|Loose)Keys%/.test(line))
        if (guarded.length !== 4 || guarded.some(line => line.includes('undefined'))) harness.fail(`chain[0] under a nonzero chain.length (truthy, !falsy, !== 0, != 0) is in bounds:\n${guarded.join('\n')}`)
        const first = stdout.split('\n').filter(line => /^      \.get \[index\]\(.*\)  firstKey%/.test(line))
        if (first.length !== 1 || !first[0].includes('.get [index](0)')) harness.fail(`chain[0] is a call with index 0:\n${first.join('\n')}`)
        const cleared = stdout.split('\n').filter(line => /^  Set<.*  #\d+ shrinkBagKeys%/.test(line))
        if (cleared.length !== 1 || !cleared[0].includes('undefined')) harness.fail(`a #count store behind get length() clobbers this.length, so at(index) may be undefined:\n${cleared.join('\n')}`)
    })
    harness.flagged('cutDumpIsCodegen', ['cut-dump', 'generics'], () => {
        const natives: any = native.createNatives({ nestedMapValues })
        for (const n of [1, 5]) if (natives.nestedMapValues(n) !== nestedMapValues(n)) harness.fail(`nestedMapValues(${n}): ${natives.nestedMapValues(n)} !== ${nestedMapValues(n)}`)
    }, stdout => {
        const lines = stdout.split('\n')
        const keys = new Map<string, string>()
        for (const line of lines.filter(line => line.startsWith('INST '))) {
            const members = line.slice(line.lastIndexOf(' [') + 2, -1).split(' ')
            for (const member of members) keys.set(member, line.slice(line.indexOf(' ', 5) + 1, line.lastIndexOf(' [')))
        }
        const dumped = lines.filter(line => /^  \S.*  #\d+ /.test(line))
        if (!dumped.length) harness.fail(`cut-dump printed no instances:\n${stdout.slice(0, 2000)}`)
        for (const line of dumped) {
            const at = line.indexOf('  #', 2)
            const label = line.slice(2, at)
            const id = line.slice(at + 2).split(' ')[0]
            if (keys.get(id) !== label) harness.fail(`cut-dump labels ${id} ${label}, codegen instantiates it as ${keys.get(id)}:\n${line}`)
        }
    })
    harness.flagged('restReadsInBounds', ['cut-dump'], () => {
        for (const C of [RestPlain, RestStore, RestCall, RestMerge]) console.log(native.classCutText(C))
        native.createNatives({ setFromArraySize, setFromArrayHas })
    }, stdout => {
        const lines = stdout.split('\n')
        for (const name of ['RestPlain', 'RestStore', 'RestCall']) {
            const last = lines.slice(lines.findIndex(line => line.startsWith(`class ${name}<`))).find(line => line.trim().startsWith('last:'))
            if (last?.trim() !== 'last: T | 0') harness.fail(`${name}.put stores values[0] only when values.length === 1, so it is never undefined: ${last}`)
        }
        const data = lines.slice(lines.findIndex(line => line.startsWith('class Array<'))).find(line => line.trim().startsWith('#data:'))
        if (data?.trim() !== '#data: 0 | {[number]: T}') harness.fail(`Array elements are only what was stored: ${data}`)
        const sets = lines.filter(line => line.startsWith('  Set<'))
        if (sets.length !== 2 || sets.some(line => !line.startsWith('  Set<u64>  ') || line.includes('wider'))) harness.fail(`a Set built from an Array<u64> holds u64:\n${sets.join('\n')}`)
    })
    harness.test('intWideningStaysInt', () => {
        const step = native.classCutText(IntStep).split('\n').find(line => line.trim().startsWith('step<'))
        if (step?.trim() !== 'step<A>(A): A | i64') harness.fail(`k + 1 is integer arithmetic: it widens k to i64, not to a float: ${step}`)
        const count = native.classCutText(StepCounter).split('\n').find(line => line.trim().startsWith('#count:'))
        if (count?.trim() !== '#count: i64') harness.fail(`#count only ever holds 0 and step(#count): ${count}`)
    })
    harness.test('arrayLengthIsInt', () => {
        const length = native.builtinCutText('Array').split('\n').find(line => line.trim().startsWith('get length('))
        if (length?.trim() !== 'get length(): i64') harness.fail(`Array #length only holds integers: lengths are narrowed !float before they are stored: ${length}`)
        const count = native.classCutText(LengthHolder).split('\n').find(line => line.trim().startsWith('#count:'))
        if (count?.trim() !== '#count: i64') harness.fail(`#count holds an Array length: ${count}`)
    })
