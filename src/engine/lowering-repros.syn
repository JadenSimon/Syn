    function trimmedText(n: u32): number {
        const texts = ['  ab c  ', '\t\n\v\f\r ab\r\n', '\u00A0\uFEFFab\u2028\u3000', '\u1680\u2000\u200A\u202F\u205F\u2029ab\u2009', ' \t\n\u00A0\u3000\uFEFF ', '', 'abc', ' a\u00A0b\u3000', '\u0085ab\u200B']
