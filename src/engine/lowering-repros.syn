    harness.test('foldLargeLiteralOperands', () => {
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const a = gn.addNode(g, gn.NodeOp.literal, [{ literal: 536870915 }], Types.u64)
        const b = gn.addNode(g, gn.NodeOp.literal, [{ literal: 536870912 }], Types.u64)
        const value = gn.addNode(g, gn.NodeOp.sub, [a, b], Types.u64)
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, root])
        g.root = root
        gn.setGraphBlocks(g, [{ id: root, params: [], bodyId: ret, bodyConst: 0 }])
        const code = lowerValueGraph(g)
        if (code.words.length !== 2 || !code.listing.includes('#3')) harness.fail(`large literal operands must fold to 3:\n${code.listing}`)
    }, 'aarch64')
    harness.test('rotatedEntryGuardFolds', () => {
        const natives: any = native.createNatives({ constantEntrySearch })
        const listing = natives.constantEntrySearch.units.map((unit: any) => unit.code.listing).join('\n')
        if (/movz (x\d+), #32\n[^\n]*\bcmp \1, #2048/.test(listing)) harness.fail(`constantEntrySearch: a rotated loop's entry guard on literal arguments must fold:\n${listing}`)
    }, 'aarch64')
    harness.test('singleBitTests', () => {
        const natives: any = native.createNatives({ oddCount, lowBitFlag })
        const odd = natives.oddCount.units.filter((unit: any) => unit.name === 'oddTotal' || unit.name === 'oddCount').map((unit: any) => unit.code.listing).join('\n')
        const direct = /\btbz w\d+, #0\b/.test(odd) || (/\btst x\d+, #1\b/.test(odd) && /\bcsel\b/.test(odd))
        if (!direct || /\band x\d+, x\d+, #1\b/.test(odd)) harness.fail(`oddCount: a one-bit condition must use tbz or tst with csel:\n${odd}`)
        const flag = natives.lowBitFlag.units.filter((unit: any) => unit.name === 'lowBitFlag').map((unit: any) => unit.code.listing).join('\n')
        if (/\bcmp\b|\bcset\b/.test(flag) || (flag.match(/\btst\b/g) ?? []).length !== 2 || !/\bubfx x\d+, x\d+, #0, #1\b/.test(flag)) harness.fail(`lowBitFlag: mask tests must be tst, and a one-bit != 0 value a bit extract:\n${flag}`)
        for (const n of [0, 1, 2, 5, 12, 1000001]) {
            let s = 0
            for (const x of [n, n + 1, n + 2, 7]) if ((x & 1) !== 0) s = s * 3 + x
            const a1 = n + 3
            const want = ((n & 1) !== 0 ? 1 : 0) + ((a1 & 4) !== 0 ? 2 : 0) + ((a1 & 1) === 0 ? 4 : 0)
            if (Number(natives.oddCount(n)) !== s || Number(natives.lowBitFlag(n)) !== want) harness.fail(`oddCount(${n}) = ${natives.oddCount(n)} (${s}), lowBitFlag(${n}) = ${natives.lowBitFlag(n)} (${want})`)
        }
        for (const mode of ['', 'shared']) {
            const shared = mode === 'shared'
            const asm = hostTarget.createAssembler()
            asm.binaryImm('and', 9, 0, 4, false)
            asm.compareImm('ne', 10, 9, 0, false)
            asm.released([{ value: 0, home: 9 }])
            asm.jumpIfZero(10, 0)
            if (shared) {
                asm.select(11, 10, 1, 2)
                asm.released([{ value: 0, home: 10 }])
                asm.mov(0, 11)
            } else {
                asm.released([{ value: 0, home: 10 }])
                asm.mov(0, 1)
            }
            asm.ret()
            asm.bindLabel(0)
            asm.movImm(0, 99)
            asm.ret()
            const listing = asm.listing()
            if (!shared && !/\btbz w0, #2\b/.test(listing)) harness.fail(`bit branch ${mode}:\n${listing}`)
            const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
            for (const v of [0, 3, 4, 5, 12, 2 ** 40 + 4]) {
                const expected = (v & 4) === 0 ? 99 : 7
                const actual = Number(run(v, 7, 8))
                if (actual !== expected) harness.fail(`bit branch ${mode}(${v}): ${actual}, expected ${expected}:\n${listing}`)
            }
        }
    }, 'aarch64')
    harness.test('negativeLoopStart', () => {
        const natives: any = native.createNatives({ literalIndexOf })
        const listing = natives.literalIndexOf.units.map((unit: any) => unit.code.listing).join('\n')
        if (/movz (x\d+), #0\n[^\n]*\bsub x\d+, \1, #/.test(listing)) harness.fail(`literalIndexOf: a stepped loop starting at 0 must enter with a literal -1, not sub #0 #1:\n${listing}`)
    }, 'aarch64')
    harness.test('unsignedFindResult', () => {
        const natives: any = native.createNatives({ hasZeroRun, mixedKeyLookups })
        const lookups: string[] = natives.mixedKeyLookups.units.map((unit: any) => unit.code.listing).join('\n').split('\n')
        let at = 1
        while (at < lookups.length) {
            const truncated = /\bmov w\d+, w(\d+)$/.exec(lookups[at])
            if (truncated && new RegExp(`\\bcsel x${truncated[1]}, `).test(lookups[at - 1])) harness.fail(`mixedKeyLookups: an encoded key word is only read as its low 32 bits, so it needs no truncation:\n${lookups.slice(Math.max(0, at - 4), at + 4).join('\n')}`)
            at++
        }
        for (const n of [1, 4]) if (Number(natives.mixedKeyLookups(n)) !== mixedKeyLookups(n)) harness.fail(`mixedKeyLookups(${n}) = ${natives.mixedKeyLookups(n)}, expected ${mixedKeyLookups(n)}`)
        const listing = natives.hasZeroRun.units.map((unit: any) => unit.code.listing).join('\n')
        if (/\bcset x\d+, (ge|lt)\b/.test(listing)) harness.fail(`hasZeroRun: a find result that only arrives as the unsigned position must not keep a signed test against 0:\n${listing}`)
        if (Number(natives.hasZeroRun(0)) !== 1 || Number(natives.hasZeroRun(3)) !== 0) harness.fail(`hasZeroRun(0) = ${natives.hasZeroRun(0)}, hasZeroRun(3) = ${natives.hasZeroRun(3)}`)
    }, 'aarch64')
    harness.test('booleanArrivalSelect', () => {
        const natives: any = native.createNatives({ slackFlag, orderedPicks })
        const hits = natives.orderedPicks.units.map((unit: any) => unit.code.listing).join('\n')
        if (/cset (x\d+), \w+\n[^\n]*\band (x\d+), x\d+, \1\n[^\n]*\bcbn?z \2,/.test(hits)) harness.fail(`orderedPicks: a branch on a flag and a compare must test the flag and chain the compare:\n${hits}`)
        for (const n of [0, 3]) if (Number(natives.orderedPicks(n)) !== orderedPicks(n)) harness.fail(`orderedPicks(${n}) = ${natives.orderedPicks(n)}, expected ${orderedPicks(n)}`)
        const listing = natives.slackFlag.units.map((unit: any) => unit.code.listing).join('\n')
        if (/cbn?z (x\d+), L\d+\n[^\n]*movz \1, #[01]\n/.test(listing)) harness.fail(`slackFlag: a select of 1/0 on a param whose arrivals are all boolean must fold to the param:\n${listing}`)
        if (Number(natives.slackFlag(5)) !== 1 || Number(natives.slackFlag(7)) !== 0 || Number(natives.slackFlag(1)) !== 0) harness.fail(`slackFlag(5) = ${natives.slackFlag(5)}, slackFlag(7) = ${natives.slackFlag(7)}, slackFlag(1) = ${natives.slackFlag(1)}`)
    }, 'aarch64')
    harness.test('integerTextSkipsFloat', () => {
