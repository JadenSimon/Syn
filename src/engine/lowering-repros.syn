    harness.test('runtimeCallsStandalone', () => {
        let select = 0
        let ne = 0
        let sum = 0
        const g = rootGraph([Types.vm_value, Types.vm_value], (g, root, [a, b]) => {
            ne = gn.addNode(g, gn.NodeOp.ne, [a, b], Types.bool)
            sum = gn.addNode(g, gn.NodeOp.rt, [gn.addNode(g, gn.NodeOp.startOf, []), { literal: rt.Op.addOrConcat }, a, b])
            select = gn.addNode(g, gn.NodeOp.select, [a, ne, sum])
            return gn.addNode(g, gn.NodeOp.ret, [select, root])
        })
        const linked: rt.Op[] = []
        const moves = native.runtimeCalls(g, { bound: new Set([select, ne]), compares: new Set(), masks: new Map(), target: op => {
            linked.push(op)
            return 1000 + linked.length
        } })
        const test = gn.getNode(g, gn.getRef(gn.getNode(g, select)!, 0))
        if (test?.op !== gn.NodeOp.call || gn.getNode(g, ne)?.op !== gn.NodeOp.eq || gn.getNode(g, sum)?.op !== gn.NodeOp.add) harness.fail('bound selects and compares become runtime calls; unbound addOrConcat becomes add')
        if (linked.join() !== [rt.Op.strictEqual, rt.Op.truthy].join() || moves.moved.length !== 2 || moves.dropped.join() !== String(select)) harness.fail(`runtimeCalls must report its moved calls: ${JSON.stringify(moves)}`)
    })
    harness.test('indexArrayIterationsStandalone', () => {
        const key = (name: string) => heap.fromJsString(name)
        const g = gn.createGraph({})
        const root = gn.addNode(g, gn.NodeOp.block, [])
        const array = gn.addNode(g, gn.NodeOp.param, [], Types.vm_value)
        const loop = gn.addNode(g, gn.NodeOp.block, [])
        const exit = gn.addNode(g, gn.NodeOp.block, [])
        const tok = gn.addNode(g, gn.NodeOp.startOf, [])
        const symbol = gn.addNode(g, gn.NodeOp.getProp, [tok, array, { literal: heap.fromJsSymbol(Symbol.iterator) }])
        const made = gn.addNode(g, gn.NodeOp.call, [tok, symbol, array])
        const next = gn.addNode(g, gn.NodeOp.getProp, [made, made, { literal: key('next') }])
        const enter = gn.addNode(g, gn.NodeOp.apply, [loop])
        const inLoop = gn.addNode(g, gn.NodeOp.startOf, [loop])
        const call = gn.addNode(g, gn.NodeOp.call, [inLoop, next, made])
        const done = gn.addNode(g, gn.NodeOp.getProp, [call, call, { literal: key('done') }])
        const value = gn.addNode(g, gn.NodeOp.getProp, [call, call, { literal: key('value') }])
        const select = gn.addNode(g, gn.NodeOp.select, [done, gn.addNode(g, gn.NodeOp.apply, [exit]), gn.addNode(g, gn.NodeOp.apply, [loop])])
        const ret = gn.addNode(g, gn.NodeOp.ret, [value, exit])
        g.root = root
        gn.setGraphBlocks(g, [
            { id: root, params: [array], bodyId: enter, bodyConst: 0 },
            { id: loop, params: [], bodyId: select, bodyConst: 0 },
            { id: exit, params: [], bodyId: ret, bodyConst: 0 },
        ])
        const rewritten = native.indexArrayIterations(g, new Map([[symbol, 0 as intrinsics.Handle]]))
        const read = gn.getNode(g, value)!
        if (rewritten.length !== 1 || rewritten[0].next !== call || g.blocks[1].params[0] !== rewritten[0].index) harness.fail(`one iteration must be indexed by a new loop param: ${JSON.stringify(rewritten)}`)
        else if (read.op !== gn.NodeOp.getProp || gn.getRef(read, 1) !== array || gn.getRef(read, 2) !== rewritten[0].index) harness.fail('the iterated value must read the array at the index')
    })
    harness.test('functionObjectsStandalone', () => {
        const g = rootGraph([Types.u64], (g, root, [p]) => {
