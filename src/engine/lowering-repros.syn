        const over: BoxPass = (b, j) => b.n > j * 10
        const b: PassBox = { n: k }
        let changed = false
        const passes: BoxPass[] = [doublePass, add, bumpPass, over]
        for (const pass of passes) {
            if (skippedPasses.has(pass.name)) continue
            const key = `stage:${pass.name}`
            passCounts.set(key, (passCounts.get(key) ?? 0) + 1)
            const result = pass(b, k)
            changed ||= result === true
        }
        return b.n + (changed ? 1000 : 0)
    }
