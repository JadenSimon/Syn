        if (state.callee.blocks[0].params.length !== 1 || gn.typeOf(scalar) !== Types.u64 || record.op !== gn.NodeOp.record || gn.getNode(state.caller, state.call)!.op !== gn.NodeOp.after) harness.fail('scalarizeState must pass the field in and out by value')
        let allocation = 0
