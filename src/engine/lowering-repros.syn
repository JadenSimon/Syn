    function boolTypeof(n: u32): number {
        const local = n > 5
        const called = flagFor(n)
        let t = 0
        if (typeof local === 'boolean') t = t + 1
        if (typeof called === 'boolean') t = t + 10
        if (typeof true === 'boolean') t = t + 100
        if (typeof called === 'number') t = t + 1000
        return t
    }
    function scoreFlag(x: boolean | Held): number {
        if (typeof x === 'boolean') return x ? 1 : 2
        return x.v * 10
    }
    ;(scoreFlag as any).shouldNotInline = true
    function boolObjectParam(n: u32): number {
        return scoreFlag(n > 5) + scoreFlag({ v: n }) * 100 + scoreFlag(false) * 100000
    }
    function boolNumberSelect(n: u32): number {
        const r = n > 100 ? true : n > 50 ? false : n
        let t = 0
        if (typeof r === 'boolean') t = t + 1
        if (r === true) t = t + 10
        if (r === 1) t = t + 100
        if (r) t = t + 1000
        return t
    }
    interface FlagBox {
        r: boolean | number
    }
    function boolNumberField(n: u32): number {
        const box: FlagBox = { r: n }
        if (n > 100) box.r = true
        else if (n > 50) box.r = false
        const r = box.r
        let t = 0
        if (typeof r === 'boolean') t = t + 1
        if (r === true) t = t + 10
        if (r === 1) t = t + 100
        if (r) t = t + 1000
        return t
    }
    function boolNumberElement(k: u32): number {
        const items: (boolean | number)[] = [true, 0, 1, false]
        const r = items[k]
        let t = 0
        if (typeof r === 'boolean') t = t + 1
        if (r === true) t = t + 10
        if (r === 1) t = t + 100
        if (r) t = t + 1000
        return t
    }
    function boolObjectElement(k: u32): number {
        const items: (boolean | Held)[] = [true, { v: 3 }, false]
        const r = items[k]
        let t = 0
        if (typeof r === 'boolean') t = t + 1
        if (typeof r === 'object') t = t + 2 + r.v * 100000
        if (r === true) t = t + 10
        if (r) t = t + 1000
        return t
    }
    function boolTypeofPipeline(k: u32): number {
        let b: PassBox = { n: k }
        let changed = false
        let unknown = false
        const passes: ((b: PassBox, k: number) => PassBox | boolean | void)[] = [truePass, freshPass, voidPass, bumpPass]
        for (const pass of passes) {
            const result = pass(b, k)
            if (result) if (result !== true) b = result
            changed ||= result === true
            unknown ||= typeof result !== 'boolean'
        }
        return b.n + (changed ? 1000 : 0) + (unknown ? 10000 : 0)
    }

    const cases: [Function, number[]][] = [
