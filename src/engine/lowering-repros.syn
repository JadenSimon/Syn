    function boundsIndexedKey(n: u32): number {
        const a: number[] = []
        for (let i = 0; i < n; i++) a.push(i * 3)
        const m = new Map<number, number>()
        for (let i = 0; i < a.length; i++) m.set(a[i], i)
        return m.size * 10 + (m.get(3) ?? 7)
    }
    function boundsForOfKey(n: u32): number {
        const a: number[] = []
        for (let i = 0; i < n; i++) a.push(i * 2)
        const s = new Set<number>()
        for (const v of a) s.add(v)
        return s.size * 10 + (s.has(2) ? 1 : 0)
    }
    function boundsGuardedKey(n: u32): number {
        const a = [n, n + 1, n + 2]
        const s = new Set<number>()
        const i = n % 5
        if (i < a.length) s.add(a[i])
        return s.size * 10 + (s.has(n) ? 1 : 0)
    }
    function boundsAssertedKey(n: u32): number {
        const values = new Int32Array(n + 2)
        for (let i = 0; i < values.length; i++) values[i] = i * 3 as i32
        const order = [n + 1, 0, n]
        const s = new Set<number>()
        for (let i = 0; i < order.length; i++) {
            const at = order[i]
            intrinsics.assert(at < values.length)
            s.add(values[at])
        }
        return s.size * 10 + (s.has(3) ? 1 : 0)
    }
    function boundsShrunkRead(n: u32): number {
        const a = [n, n + 1, n + 2]
        const at = n % 3
        intrinsics.assert(at < a.length)
        a.pop()
        const v = a[at]
        return v === undefined ? 100 : v
    }
    cases.push([boundsIndexedKey, [0], [4]], [boundsForOfKey, [0], [3]], [boundsGuardedKey, [1], [4]], [boundsAssertedKey, [0], [5]], [boundsShrunkRead, [1], [2]])
    function negativeByteWrite(n: u32): number {
        const at = n - 5
        const a = new Uint8Array(8)
        const b = new Uint8Array(8)
        for (let i = 0; i < 8; i++) a[i] = n + i
        b[at] = 99
        b[0] = 1
        let t = 0
        for (let i = 0; i < 8; i++) t = t * 2 + a[i] + b[i]
        return t
    }
    function negativeHalfWrite(n: u32): number {
        const at = n - 5
        const a = new Uint16Array(8)
        const b = new Uint16Array(8)
        b[at] = 7
        b[0] = 1
        let t = 0
        for (let i = 0; i < 8; i++) t = t * 2 + a[i] + b[i]
        return t
    }
    function negativeWordWrite(n: u32): number {
        const at = n - 5
        const a = new Uint32Array(8)
        const b = new Uint32Array(8)
        b[at] = 7
        b[0] = 1
        let t = 0
        for (let i = 0; i < 8; i++) t = t * 2 + a[i] + b[i]
        return t
    }
    function negativeIntWrite(n: u32): number {
        const at = n - 5
        const a = new Int32Array(8)
        const b = new Int32Array(8)
        b[at] = 7
        b[0] = 1
        let t = 0
        for (let i = 0; i < 8; i++) t = t * 2 + a[i] + b[i]
        return t
    }
    function negativeFloatWrite(n: u32): number {
        const at = n - 5
        const a = new Float64Array(8)
        const b = new Float64Array(8)
        b[at] = 7
        b[0] = 1
        let t = 0
        for (let i = 0; i < 8; i++) t = t * 2 + a[i] + b[i]
        return t
    }
    function negativeWideWrite(n: u32): number {
        const at = n - 5
        const a = new BigUint64Array(8)
        const b = new BigUint64Array(8)
        b[at] = BigInt(7)
        b[0] = BigInt(1)
        let t = 0
        for (let i = 0; i < 8; i++) t = t * 2 + Number(a[i]) + Number(b[i])
        return t
    }
    function negativeArrayWrite(n: u32): number {
        const a = [n, n + 1, n + 2]
        const b = [n + 3, n + 4, n + 5]
        b[n - 3] = 99
        return a[n % 3] * 1000 + b[n % 3] * 10 + b.length
    }
    function spilledColdLiveIns(n: u32): u32 {
        const m = new Map<number, number>()
        let q = 0
        while (q < 12) {
            m.set(q, n * (q + 3) + q)
            q++
        }
        const a = m.get(0)!
        const b = m.get(1)!
        const c = m.get(2)!
        const d = m.get(3)!
        const e = m.get(4)!
        const f = m.get(5)!
        const g = m.get(6)!
        const h = m.get(7)!
        const i = m.get(8)!
        const j = m.get(9)!
        const k = m.get(10)!
        const l = m.get(11)!
        m.set(99, a + b)
        const got = m.get(99)!
        if (got > 1000) {
            let text = 'cold'
            for (const x of [a, b, c, d, e, f, g, h, i, j, k, l]) text = text + ' ' + x
            throw new Error(text)
        }
        return a + b + c + d + e + f + g + h + i + j + k + l + got
    }
    cases.push([negativeByteWrite, [2], [6]], [negativeHalfWrite, [2], [6]], [negativeWordWrite, [2], [6]], [negativeIntWrite, [2], [6]], [negativeFloatWrite, [2], [6]], [negativeWideWrite, [2], [6]])
    function sortMixedWords(n: u32): number {
        sortedMixedWords[0] = n
        sortedMixedWords.sort((a, b) => 0)
        return (sortedMixedWords[0] as number) + n
    }
    function sortFloatRecords(n: u32): number {
        const xs: any[] = [n, 3, 1, 2.5]
        xs.push({ x: 1 })
        xs.pop()
        xs.sort((a, b) => a < b ? -1 : a > b ? 1 : 0)
        return xs[0] + xs[1] * 10
    }
    cases.push([sortMixedWords, [3]], [sortFloatRecords, [3]])
    function scaledFloatConvert(n) {
        return n / 8
    }
    function scaledSignedFloatConvert(n) {
        const x = n - 100
        return x / 16
    }
    function sharedFloatConvert(n) {
        return n / 2 + n / 3 + 2 / (n + 1)
    }
    function addBeforeMask(n) {
        return ((n + 256) & 255) + ((n - 512) & 255) * 256 + ((n + 257) & 255) * 65536 + ((n + 256) & 511) * 16777216
    }
    cases.push([scaledFloatConvert, [0], [1], [7], [4294967295], [9007199254740994], [18446744073709549568]], [scaledSignedFloatConvert, [0], [99], [100], [103], [4294967295]], [sharedFloatConvert, [0], [1], [7], [4294967295]], [addBeforeMask, [0], [255], [256], [511], [512], [4294967295]])
    harness.runCases({ prefix: 'repro', args: true }, cases)
    harness.fatal('fatalError', ['panic-trap'], 'SIGTRAP', () => {
        const natives: any = native.createNatives({ throwsError })
        natives.throwsError(5)
