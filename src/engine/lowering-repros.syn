        const natives: any = native.createNatives({ negativeRootScaled, negativeRootCompare })
        for (const name of ['negativeRootScaled', 'negativeRootCompare']) {
            let message = ''
            try {
                natives[name](-7)
            } catch (e) {
                message = String((e as any)?.message ?? e)
            }
