        native.pruneArgs(pruned.program, 2, new Set([1]), [[1, pruned.call]], touched)
        if (pruned.callee.blocks[0].params.length !== 1 || gn.countIds(gn.getNode(pruned.caller, pruned.call)!) !== 4) harness.fail('pruneArgs must drop the dead param and its args')
        const forwarded = twoUnits((g, root, [a]) => gn.addNode(g, gn.NodeOp.ret, [a, root]), 1, (g, x) => [x])
