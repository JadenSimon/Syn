    function sameReceiverMaps(n: u32): number {
        const a = [{ id: 1 }, { id: n }]
        const names = a.map(x => `B${x.id}`)
        const next = a.map(x => ({ id: x.id + 1, k: 2 }))
        return names[1].length * 100 + next[1].id * 10 + next[1].k
    }
    function chainedMaps(n: u32): number {
        const a = [{ id: 1 }, { id: n }]
        const lengths = a.map(x => `B${x.id}`).map(s => ({ len: s.length }))
        return lengths[1].len * 10 + lengths[0].len
    }
    function callbackOwnedStorage(n: u32): number {
        const a = edgeLists(v => v < n ? [v + 1, 0] : [])
        const b = edgeLists(v => v === 1 ? [2] : [1])
        return a.length * 10 + b.length
    }
    function callbackOwnedFrames(n: u32): number {
        const a = stronglyConnectedLike([0], (v: number): number[] => v < n ? [v + 1, 0] : [])
        const b = stronglyConnectedLike([1, 2], (v: number): number[] => v === 1 ? [2] : [1])
        return a.length * 10 + b.length
    }
    function nullableCallbackParam(n: u32): number {
        const leaf = { v: n, kids: [] as Tree[] }
        const root = { v: 1, kids: [leaf, { v: 2, kids: [] as Tree[] }] }
        function visit(t: Tree | undefined): number {
            return t ? t.v + sumTree(t, visit) : 0
        }
        function scan(t: Tree): number {
            return t.v * 2 + sumTree(t, scan)
        }
        return visit(root) * 100 + scan(root) + visit(root.kids.find(t => t.v > 5))
    }
    function signedFieldJoin(n: u32): number {
        const leaf = { v: n - 20, kids: [] as Tree[] }
        const root = { v: 1, kids: [leaf, { v: 2, kids: [] as Tree[] }] }
        function visit(t: Tree | undefined): number {
            return t ? t.v + sumTree(t, visit) : 0
        }
        function scan(t: Tree): number {
            return t.v * 2 + sumTree(t, scan)
        }
        return visit(root) * 100 + scan(root) + visit(root.kids.find(t => t.v > 5))
    }
    function boolFieldsByIndex(n: u32): number {
        const fs: { on: boolean, off: boolean, k: number }[] = []
        for (let i = 0; i < n; i++) fs.push({ on: i % 3 === 0, off: i % 2 === 1, k: i })
        let s = 0
        for (let i = 0; i < n; i++) s += (fs[i].on ? fs[i].k : 0) + (fs[i].off ? 1000 : 0)
        return s
    }
    function maskedLiteralIndex(n: u32): number {
        const a = [1, 2, 3, 4, 5, 6, 7, 8]
        let s = 0
        for (let i = 0; i < n; i++) s += a[i & 7]
