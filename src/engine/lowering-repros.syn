        const two = new FixedWide(n + 1, n + 2)
        return one.fixed(n) + two.fixed(n + 10) * 100 + two.w
    }

    class Animal {
        n: number
        constructor(n: number) {
            this.n = n
        }
        speak(): number {
            return this.n
        }
        loud(): number {
            return this.speak() * 10
        }
        static triple(x: number): number {
            return x * 3
        }
    }
    class Dog extends Animal {
        speak(): number {
            return this.n * 2
        }
    }
    class Puppy extends Dog {
        age: number
        constructor(n: number) {
            super(n + 1)
            this.age = n
        }
        speak(): number {
            return super.speak() + this.age
        }
        static sextuple(x: number): number {
            return super.triple(x) * 2
        }
    }
    class Cat extends Animal {
        lives = 9
        speak(): number {
            return this.lives + super.speak()
        }
    }
    class Meter {
        k: number
        constructor(k: number) {
            this.k = k
        }
        get reading(): number {
            return this.k * 3
        }
    }
    class Gauge extends Meter {
        get reading(): number {
            return super.reading + 1
        }
    }
    function extendsSuperGetter(n: u32): number {
        return new Gauge(n).reading
    }
    function extendsOverride(n: u32): number {
        const a = n > 3 ? new Dog(n) : new Animal(n)
        return a.speak()
    }
    function extendsSuperCall(n: u32): number {
        const p = new Puppy(n)
        return p.speak() * 100 + p.age
    }
    function extendsInherited(n: u32): number {
        const d = new Dog(n)
        return d.loud() + d.n
    }
    function extendsField(n: u32): number {
        const c = new Cat(n)
        return c.speak() * 100 + c.lives
    }
    function extendsInstanceof(n: u32): number {
        const a = n > 3 ? new Puppy(n) : new Dog(n)
        return (a instanceof Animal ? 1 : 0) + (a instanceof Dog ? 10 : 0) + (a instanceof Puppy ? 100 : 0) + (a instanceof Cat ? 1000 : 0)
    }
    function extendsStatic(n: u32): number {
        return Dog.triple(n) * 100 + Puppy.sextuple(n)
    }
    function extendsChain(n: u32): number {
        const p = new Puppy(n)
        return p.loud() + (p instanceof Animal ? 1 : 0)
    }
    function extendsPolymorphic(n: u32): number {
        const xs: Animal[] = [new Animal(n), new Dog(n), new Puppy(n), new Cat(n)]
        let total = 0
        for (const x of xs) total = total + x.speak()
        return total
    }
    function extendsLocal(n: u32): number {
        class Base {
            v: number
            constructor(v: number) {
                this.v = v
            }
            get(): number {
                return this.v
            }
        }
        class Derived extends Base {
            constructor(v: number) {
                super(v + 1)
            }
            get(): number {
                return super.get() * 2
            }
        }
        return new Derived(n).get()
    }
