    harness.test('pstackPostCallReset', () => {
        const references = { pstackKeptOut, pstackKeptPairs, pstackKeyHits, pstackKeptRows, pstackKeptInlined }
        const natives: any = native.createNatives(references)
        const stacks: number[] = []
        for (let stack = 0; stack < stackCount; stack++) stacks.push(stack)
        for (const [name, reference] of Object.entries(references)) {
            const growth: number[] = []
            for (const n of [256, 2048]) {
                const marks = stacks.map(stack => native.pstackMark(stack))
                const expected = reference(n)
                const actual = Number(natives[name](n))
                growth.push(stacks.reduce((total, stack, i) => total + Number(native.pstackMark(stack) - marks[i]), 0))
                stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
                if (actual !== expected) harness.fail(`repro pstackPostCallReset FAILED: ${name}(${n}) returned ${actual}, expected ${expected}`)
            }
            const perCall = (growth[1] - growth[0]) / (2048 - 256)
            console.log(`repro pstackPostCallReset ${name}: ${growth[0]} B at 256, ${growth[1]} B at 2048 (${perCall.toFixed(1)} B per iteration)`)
            if (perCall > 160) harness.fail(`repro pstackPostCallReset FAILED: ${name} grows the pstacks ${perCall.toFixed(1)} B per iteration; pstackScratch's temporaries are dead once it returns, so the call site must reset them`)
        }
    })
