    harness.test('negatedRegisterUsesZero', () => {
        const natives: any = native.createNatives({ negatedWhole })
        const listing = natives.negatedWhole.units.map((unit: any) => unit.code.listing).join('\n')
        if (/movz (x\d+), #0\n[^\n]*\bsub x\d+, \1, x/.test(listing) || !listing.includes('neg x')) harness.fail(`negatedWhole: 0 - x must negate through the zero register, not a materialized 0:\n${listing}`)
        if (Number(natives.negatedWhole(4)) !== 9 || Number(natives.negatedWhole(20)) !== 15) harness.fail(`negatedWhole(4) = ${natives.negatedWhole(4)}, negatedWhole(20) = ${natives.negatedWhole(20)}`)
    }, 'aarch64')
