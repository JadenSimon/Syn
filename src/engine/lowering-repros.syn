/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import { allocate } from './builtins'
import * as gn from './graph-node'
import * as native from './native'
import * as bytecode from './bytecode-emitter'
import { lowerValueGraph, stronglyConnected, type Graph } from './lowering2'
import type { Rep } from './value-types'
import * as rt from './rt'
import * as heap from './heap'
import { hostTarget } from './lowering'
import { createTraceSession } from './trace2'
import * as propertyEval from './property-eval'

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics

enum DynColor {
    red = 1,
    green = 2,
    blue = 4,
}

const sharedList: number[] = [1, 2, 3]
const constFloatTexts: (number | string)[] = ['ab', 2.5, 7]
const dynMasks: Record<number, number> = { [1]: 10, [2]: 20, [4]: 40 }
const dynTargets = { arm: { name: 'arm64', bits: 64 }, x86: { name: 'x86', bits: 32 } }
const dynNames: Record<number, string> = { [1]: 'LdaZero', [2]: 'Star', [3]: 'Return' }
const dynOpNames: Record<number, string> = { [1]: 'LdaZero', [2]: 'Star', [3]: 'Return', [4]: 'Add', [5]: 'LdaConst' }

interface Tree {
    v: number
    kids: Tree[]
}

function selfZeros(xs: number[], i: number): number {
    if (i >= xs.length) return 0
    const rest = () => selfZeros(xs, i + 1)
    if (xs[i] % 2 === 0) return Math.min(64, rest() + 1)
    return Math.max(rest(), i)
}

function sumTree(t: Tree, fn: (t: Tree) => number): number {
    let s = 0
    for (const k of t.kids) s += fn(k)
    return s
}
;(sumTree as any).shouldNotInline = true

function anyOf(xs: number[], fn: (x: number) => boolean): boolean {
    for (const x of xs) if (fn(x)) return true
    return false
}
;(anyOf as any).shouldNotInline = true

function edgeLists(edges: (v: number) => number[]): number[][] {
    const frames: number[][] = []
    const out: number[][] = []
    function enter(v: number): void {
        frames.push(edges(v))
    }
    enter(0)
    out.push([1])
    return out
}

function stronglyConnectedLike(roots: number[], edges: (v: number) => number[]): number[][] {
    const index = new Map<number, number>()
    const frames: { v: number, next: number[], at: number }[] = []
    const out: number[][] = []
    function enter(v: number): void {
        index.set(v, index.size)
        frames.push({ v, next: edges(v), at: 0 })
    }
    for (const root of roots) {
        if (index.has(root)) continue
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.next.length) {
                const w = frame.next[frame.at++]
                if (!index.has(w)) enter(w)
                continue
            }
            frames.pop()
            out.push([frame.v])
        }
    }
    return out
}

function stepUp(x: number): number {
    return x + 1
}

function shortTwo(a: number, b?: number): number {
    if (b === undefined) return a
    return a * b
}

function scaleItems(items: ({ v: number } | number)[], k: number, extra?: { w: number }): number {
    const out = items.map(o => {
        if (typeof o === 'number') return o + k
        return o.v * k
    })
    return out[0] + out[1] + (extra ? extra.w : 0)
}

export function suite() {
    function andZeroEffects(n: u32): u32 {
        const cell = { value: n }
        function step(x: u32): u32 {
            cell.value++
            return x
        }
        const a = step(n) & 0
        const b = 0 & step(n + 2)
        return a + b + cell.value
    }
    function unusedFieldEffects(n: u32): u32 {
        let calls: u32 = 0
        function effect(): number[] {
            calls++
            return [n, n + 1]
        }
        const object = { unused: effect(), value: n }
        return object.value + calls * 100
    }
    function unusedFieldIdentity(n: u32): u32 {
        const a = { hidden: n, spare: n + 1 }
        const b = { hidden: n + 2, spare: n + 3 }
        const selected = n & 1 ? a : b
        return (selected === a ? 1 : 2) + (a === b ? 10 : 20)
    }
    function unusedFieldKeys(n: u32): u32 {
        const object = { a: n, b: n + 1, c: n + 2 }
        return Object.keys(object).length * 100 + object.a
    }
    function voidEffects(n: u32): u32 {
        let counter: u32 = n
        function bump(): undefined {
            return void counter++
        }
        const a = bump()
        const b = void bump()
        return (a === undefined ? 1 : 0) + (b === undefined ? 2 : 0) + counter * 10
    }
    function fill(p: u32, n: u32): void {
        for (let i: u32 = 0; i < n; i++) Intrinsics.store(p, i * 4, i * 3 + 1, Types.u32)
    }
    function poke(p: u32, n: u32): u32 {
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + Intrinsics.load(p, i * 4, Types.u32)
        return total
    }

    function warLoadThenStore(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const old = Intrinsics.load(p, 4, Types.u32)
        Intrinsics.store(p, 4, 999, Types.u32)
        return old
    }
    function warAcrossCall(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const old = Intrinsics.load(p, 4, Types.u32)
        const seen = poke(p, n)
        Intrinsics.store(p, 4, 999, Types.u32)
        return old * 1000 + (seen & 255)
    }
    function warSwap(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const j = n - 1
        const a = Intrinsics.load(p, 4, Types.u32)
        const b = Intrinsics.load(p, j * 4, Types.u32)
        Intrinsics.store(p, 4, b, Types.u32)
        Intrinsics.store(p, j * 4, a, Types.u32)
        return Intrinsics.load(p, 4, Types.u32) * 1000 + Intrinsics.load(p, j * 4, Types.u32)
    }
    function warSwapRemove(n: u32): u32 {
        const p = allocate(n * 4)
        fill(p, n)
        const last = Intrinsics.load(p, (n - 1) * 4, Types.u32)
        const removed = Intrinsics.load(p, 4, Types.u32)
        Intrinsics.store(p, 4, last, Types.u32)
        Intrinsics.store(p, (n - 1) * 4, 0, Types.u32)
        return removed * 1000 + Intrinsics.load(p, 4, Types.u32)
    }

    function headerStoreLoop(n: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        let count: u32 = 0
        for (;;) {
            Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 1, Types.u32)
            if (Intrinsics.load(p, 0, Types.u32) > n) break
            count++
        }
        return count * 100 + Intrinsics.load(p, 0, Types.u32)
    }
    function bump(p: u32): u32 {
        const next = Intrinsics.load(p, 0, Types.u32) + 1
        Intrinsics.store(p, 0, next, Types.u32)
        return next
    }
    function headerCallLoop(n: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        let count: u32 = 0
        while (bump(p) <= n) count++
        return count * 100 + Intrinsics.load(p, 0, Types.u32)
    }
    function headerCallLoopLive(n: u32): u32 {
        const p = allocate(8)
        Intrinsics.store(p, 0, 0, Types.u32)
        Intrinsics.store(p, 4, 7, Types.u32)
        const q = allocate(4)
        Intrinsics.store(q, 0, 0, Types.u32)
        let count: u32 = 0
        while (bump(p) <= n) {
            Intrinsics.store(q, 0, Intrinsics.load(q, 0, Types.u32) + Intrinsics.load(p, 4, Types.u32), Types.u32)
            count++
        }
        return count * 10000 + Intrinsics.load(q, 0, Types.u32) * 10 + Intrinsics.load(p, 4, Types.u32)
    }

    function sharedRetNested(a: u32): u32 {
        if (a > 5) {
            if (a > 8) return 1
            return 0
        }
        return 1
    }
    function sharedRetDeep(a: u32, b: u32): u32 {
        if (a > 5) {
            if (b > 5) return 1
            if (b > 2) return 2
            return 1
        }
        if (b > 7) return 2
        return 1
    }

    function selectOrTail(a: u32, b: u32): u32 {
        const v = a > 4 ? a - 4 : 0
        return v || b + 1
    }
    function selectAndTail(a: u32, b: u32): u32 {
        const v = a > 4 ? a - 4 : 0
        return v && b + 1
    }

    function crossBlockField(n: u32): u32 {
        const o = { a: n * 3, b: n + 1 }
        let t: u32 = 0
        for (let i: u32 = 0; i < n; i++) t = t + i
        if (t > 2) return o.a + t
        return o.b
    }
    function crossBlockFieldLoop(n: u32): u32 {
        const o = { a: n * 3, b: n + 1 }
        let t: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            if (i & 1) t = t + o.a
            else t = t + o.b
        }
        return t
    }

    function powTwo(n: u32): u32 {
        return 2 ** n
    }
    function powThree(n: u32): u32 {
        return 3 ** n
    }
    function powBoth(n: u32, b: u32): u32 {
        return b ** n
    }

    function literal2p53(k: u32): u32 {
        const m = k > 3 ? 9007199254740992 : 1
        return m > 5 ? 7 : 3
    }
    function literal2p63(k: u32): u32 {
        const m = k > 3 ? 9223372036854775808 : 1
        return m > 5 ? 7 : 3
    }

    function diamondEffects(k: u32): u32 {
        const p = allocate(4)
        Intrinsics.store(p, 0, 0, Types.u32)
        if (k & 1) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 1, Types.u32)
        if (k & 2) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 2, Types.u32)
        if (k & 4) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 3, Types.u32)
        if (k & 8) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 4, Types.u32)
        if (k & 16) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 5, Types.u32)
        if (k & 32) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 6, Types.u32)
        if (k & 64) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 7, Types.u32)
        if (k & 128) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 8, Types.u32)
        if (k & 256) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 9, Types.u32)
        if (k & 512) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 10, Types.u32)
        if (k & 1024) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 11, Types.u32)
        if (k & 2048) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 12, Types.u32)
        if (k & 4096) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 13, Types.u32)
        if (k & 8192) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 14, Types.u32)
        if (k & 16384) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 15, Types.u32)
        if (k & 32768) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 16, Types.u32)
        if (k & 65536) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 17, Types.u32)
        if (k & 131072) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 18, Types.u32)
        if (k & 262144) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 19, Types.u32)
        if (k & 524288) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 20, Types.u32)
        if (k & 1048576) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 21, Types.u32)
        if (k & 2097152) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 22, Types.u32)
        if (k & 4194304) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 23, Types.u32)
        if (k & 8388608) Intrinsics.store(p, 0, Intrinsics.load(p, 0, Types.u32) + 24, Types.u32)
        return Intrinsics.load(p, 0, Types.u32)
    }

    function chase(p: u32): u32 {
        const q = Intrinsics.load(p, 0, Types.u64)
        const r = Intrinsics.load(q, 0, Types.u64)
        return Intrinsics.load(r, 0, Types.u32) + Intrinsics.load(p, 8, Types.u32)
    }
    ;(chase as any).shouldNotInline = true
    function bumpChain(n: u32): u32 {
        const a = allocate(16)
        Intrinsics.store(a, 0, n, Types.u32)
        Intrinsics.store(a, 8, n + 1, Types.u32)
        const b = allocate(16)
        Intrinsics.store(b, 0, a, Types.u64)
        Intrinsics.store(b, 8, n + 2, Types.u32)
        const c = allocate(16)
        Intrinsics.store(c, 0, b, Types.u64)
        Intrinsics.store(c, 8, n + 3, Types.u32)
        const d = allocate(n * 8)
        Intrinsics.store(d, 0, c, Types.u64)
        fill(d + 8, n - 1)
        return poke(d + 8, n - 1) + chase(Intrinsics.load(d, 0, Types.u64))
    }

    class PeekBox {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            return this.n + v
        }
    }
    class PushBox {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            this.n = this.n * 10 + v
            return v
        }
    }
    ;(PeekBox.prototype.bump as any).shouldNotInline = true
    ;(PushBox.prototype.bump as any).shouldNotInline = true
    function unionMethodCall(k: u32): number {
        const o = k > 3 ? new PeekBox(k) : new PushBox(k)
        o.bump(k)
        return o.n
    }
    class PeekCell {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            return peekCell(this, v)
        }
    }
    class PushCell {
        n: number
        constructor(n: number) {
            this.n = n
        }
        bump(v: number): number {
            return pushCell(this, v)
        }
    }
    function peekCell(o: PeekCell, v: number): number {
        return o.n + v
    }
    ;(peekCell as any).shouldNotInline = true
    function pushCell(o: PushCell, v: number): number {
        o.n = o.n * 10 + v
        return v
    }
    ;(pushCell as any).shouldNotInline = true
    function unionMethodInlined(k: u32): number {
        const o = k > 3 ? new PeekCell(k) : new PushCell(k)
        o.bump(k)
        return o.n
    }

    class SelfCell {
        v: number
        constructor() {
            this.v = 0
        }
        bump(k: number): this {
            this.v = this.v + k
            return this
        }
    }
    ;(SelfCell.prototype.bump as any).shouldNotInline = true
    class SelfHolder {
        cell: SelfCell
        constructor(k: number) {
            this.cell = new SelfCell().bump(k)
        }
    }
    function embeddedSelfReturn(n: u32): number {
        const h = new SelfHolder(n)
        const other = new SelfCell()
        const pick = n > 3 ? other : h.cell
        pick.bump(2)
        return h.cell.v * 100 + other.v
    }

    interface RemapGraph {
        blocks: number[]
    }
    function copyRemap(g: RemapGraph): RemapGraph {
        return { blocks: g.blocks.map(b => b) }
    }
    function embeddedRemap(n: u32): number {
        const m = new Map<number, number>()
        m.set(n, 1)
        const g: RemapGraph = { blocks: [n, n + 1] }
        const out = copyRemap(g)
        out.blocks = out.blocks.map(b => b + m.get(n)!)
        const again = copyRemap(n > 3 ? out : g)
        again.blocks = again.blocks.map(b => b * 2)
        return again.blocks[1] * 100 + out.blocks[0]
    }

    function addCopySlice(n: u32): number {
        const g = gn.createGraph()
        const p = gn.addNode(g, gn.NodeOp.param, [], Types.u32)
        const a = gn.addNode(g, gn.NodeOp.add, [p, { literal: n }], Types.u32)
        const c = gn.addCopy(g, gn.getNode(g, a)!)
        return c * 100 + gn.countIds(gn.getNode(g, c)!) + gn.countNodes(g) * 1000
    }

    interface ParamBlock {
        params: number[]
        body: number
    }
    function emptyIndexOf(n: u32): number {
        const blocks: ParamBlock[] = [{ params: [n, n + 1], body: n + 1 }, { params: [], body: n }]
        let found = 0
        for (const b of blocks) {
            const at = b.params.indexOf(b.body)
            if (at >= 0) found = found + at + 1
        }
        return found
    }

    function nullableSetKeys(n: u32): number {
        const ints = new Int32Array(n)
        const floats = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) {
            ints[i] = i * 3 as i32
            floats[i] = i * 0.5
        }
        const halves: number[] = []
        const seen = new Set<number>()
        for (let i: u32 = 0; i < n; i++) {
            halves.push(floats[i])
            seen.add(ints[i])
        }
        return seen.size * 10 + halves[n - 1]
    }

    function joinedArrayKeys(n: u32): number {
        const ints: number[] = []
        const floats: number[] = []
        for (let i: u32 = 0; i < n; i++) {
            ints.push(i * 3)
            floats.push(i * 0.5)
        }
        const pick = n > 3 ? ints : floats
        const seen = new Set<number>()
        for (let i: u32 = 0; i < n; i++) seen.add(ints[i])
        return seen.size * 10 + pick[n - 1]
    }

    function floatLiteralMap(n: u32): number {
        const scale = new Float64Array(2)
        scale[1] = n
        const out = [1.5, 2].map(x => scale[1] * x)
        return out[1] * 10 + out[0]
    }

    interface WordBox {
        k: number
    }
    function pickWord(n: u32, box: WordBox): any {
        return n > 100 ? box : n + 1
    }
    ;(pickWord as any).shouldNotInline = true
    function unionWordStore(n: u32): number {
        const box: WordBox = { k: n }
        const v = pickWord(n, box)
        const p = allocate(8)
        Intrinsics.store(p, 0, v, Types.u32)
        return Intrinsics.load(p, 0, Types.u32) + box.k
    }

    function joinedQueue(n: u32): number {
        const targets = new Int32Array(n)
        const weights = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) {
            targets[i] = (i + 1) % n as i32
            weights[i] = i * 0.5
        }
        const queue = [0]
        const seen: number[] = []
        for (let i = 0; i < queue.length && i < n; i++) {
            const from = queue[i]
            queue.push(targets[from])
            seen.push(weights[from])
        }
        const pick = n > 3 ? queue : seen
        return queue[n - 1] * 100 + seen[n - 1] + pick.length
    }

    function nullableQueue(n: u32): number {
        const targets = new Int32Array(n)
        const weights = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) {
            targets[i] = (i + 1) % n as i32
            weights[i] = i * 0.5
        }
        const queue = [0]
        const seen: number[] = []
        for (let i = 0; i < queue.length && i < n; i++) {
            const from = queue[i]
            queue.push(targets[from])
            seen.push(weights[from])
        }
        return queue[n - 1] * 100 + seen[n - 1]
    }

    interface Held {
        v: number
    }
    function zeroObjectUndefined(k: u32): number {
        const items: (number | Held | undefined)[] = [0, { v: 3 }, undefined]
        const x = items[k]
        if (x === undefined) return 1
        if (typeof x === 'number') return 10 + x
        return 100 + x.v
    }
    function typeofUnionUndefined(k: u32): number {
        const items: (number | Held | undefined)[] = [0, { v: 3 }, undefined]
        const kind = typeof items[k]
        if (kind === 'undefined') return 1
        if (kind === 'number') return 2
        return 3
    }
    function truthyUnionWord(k: u32): number {
        const items: (number | Held | undefined)[] = [0, { v: 3 }, undefined, 5]
        return items[k] ? 1 : 2
    }
    function nullishVsZero(k: u32): number {
        const x = k > 1 ? undefined : k
        return (x === undefined ? 1 : 0) + (x === 0 ? 2 : 0) + (x ?? 7) * 10
    }
    function emptyStringFalsy(k: u32): number {
        const s = k > 1 ? '' : k > 0 ? 'a' : 'bc'
        return (s ? 1 : 2) + (s === '' ? 10 : 0) + s.length * 100
    }

    function maybeCell(n: u32): u32 {
        if (n < 4) return 0
        const p = allocate(8)
        Intrinsics.store(p, 0, n, Types.u32)
        Intrinsics.store(p, 4, n + 1, Types.u32)
        return p
    }
    ;(maybeCell as any).shouldNotInline = true
    function maybeBox(n: u32): { v: number, w: number } | undefined {
        if (n < 4) return undefined
        return { v: n, w: n + 1 }
    }
    ;(maybeBox as any).shouldNotInline = true
    function specNullableField(n: u32): number {
        const box = maybeBox(n)
        let total = 0
        for (let i: u32 = 0; i < n; i++) {
            if (box) total = total + box.w
            else total = total + i
        }
        return total
    }
    function specValueSelect(n: u32): u32 {
        const p = maybeCell(n)
        const v = p !== 0 ? Intrinsics.load(p, 0, Types.u32) : 7
        return v * 3 + n
    }
    function specGuardedLoop(n: u32): u32 {
        const p = maybeCell(n)
        const k = p !== 0 ? n : 0
        let total: u32 = 0
        for (let i: u32 = 0; i < k; i++) total = total + Intrinsics.load(p, 0, Types.u32)
        return total + n
    }
    function specArmInLoop(n: u32): u32 {
        const p = maybeCell(n)
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            if (p !== 0) total = total + Intrinsics.load(p, 4, Types.u32)
            else total = total + i
        }
        return total
    }
    function specSharedArms(n: u32, m: u32): u32 {
        const p = maybeCell(n)
        let total: u32 = 0
        for (let i: u32 = 0; i < m; i++) {
            if (p === 0) total = total + (i > 100 ? Intrinsics.load(p, 0, Types.u32) : i)
            else total = total + Intrinsics.load(p, 0, Types.u32) * 2
        }
        return total
