}
;(negativeRootCompare as any).shouldNotInline = true

function summaryOneSite(n: u32): number {
    const m = new Map<number, number>()
    const a: number[] = []
    m.set(n, n + 1)
    a.push(m.get(n) ?? 0)
    return a.length + a[0]
}

function summaryThreeSites(n: u32): number {
    const m = new Map<number, number>()
    const a: number[] = []
    m.set(n, n + 1)
    m.set(n + 1, n + 2)
    m.set(n + 2, n + 3)
    a.push(m.get(n) ?? 0)
    a.push(m.get(n + 1) ?? 0)
    a.push(m.get(n + 2) ?? 0)
    return a.length + a[0] + a[1] + a[2]
}

function summaryTwoMaps(n: u32): number {
    const m = new Map<number, number>()
    const k = new Map<number, number>()
    const a: number[] = []
    const b: number[] = []
    m.set(n, n + 1)
    k.set(n + 1, n + 2)
    a.push(m.get(n) ?? 0)
    b.push(k.get(n + 1) ?? 0)
    return a.length + a[0] + b[0]
}

function memberMapNoDelete(n: u32): number {
    const m = new Map<number, number>()
    for (let i = 0; i < n; i++) m.set(i * 3, i)
    let total = 0
    for (let i = 0; i < n + 2; i++) total += m.get(i * 3) ?? 7
    return total + m.size
}

function memberMapDelete(n: u32): number {
    const m = new Map<number, number>()
    for (let i = 0; i < n; i++) m.set(i * 3, i)
    m.delete(3)
    let total = 0
    for (let i = 0; i < n + 2; i++) total += m.get(i * 3) ?? 7
    return total + m.size
}

function memberMapBoth(n: u32): number {
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    for (let i = 0; i < n; i++) {
        kept.set(i * 3, i)
        pruned.set(i * 5, i)
    }
    pruned.delete(5)
    let total = 0
    for (let i = 0; i < n + 2; i++) total += (kept.get(i * 3) ?? 7) + (pruned.get(i * 5) ?? 11)
    return total + kept.size * 100 + pruned.size
}

class MemberCounter {
    count: number
    bias: number
    constructor() {
        this.count = 0
        this.bias = 0
    }
    bump(): void {
        this.count = this.count + 1
    }
    rebias(b: number): void {
        this.bias = b
    }
    read(): number {
        return this.count + this.bias
    }
}

function memberUnusedWriter(n: u32): number {
    const c = new MemberCounter()
    for (let i = 0; i < n; i++) c.bump()
    return c.read()
}

class MemberBag<T> {
    #items: T[]
    #skip: u32
    constructor() {
        this.#items = []
        this.#skip = 0
    }
    add(x: T): void {
        this.#items.push(x)
    }
    drop(): void {
        this.#skip = this.#skip + 1
    }
    at(i: number): T | undefined {
        if (i + this.#skip >= this.#items.length) return undefined
        return this.#items[i + this.#skip]
    }
}

function memberGenericTwice(n: u32): number {
    const plain = new MemberBag<number>()
    const skipping = new MemberBag<number>()
    for (let i = 0; i < n + 3; i++) {
        plain.add(i * 2)
        skipping.add(i * 7)
    }
    skipping.drop()
    return (plain.at(1) ?? 5) * 100 + (skipping.at(1) ?? 9)
}

function memberGenericOnce(n: u32): number {
    const plain = new MemberBag<number>()
    for (let i = 0; i < n + 3; i++) plain.add(i * 2)
    return plain.at(1) ?? 5
}

function memberCollectionSites(n: u32): number {
    const a = new Map<number, number>()
    const b = new Map<number, number>()
    const c = new Map<number, number>()
    const s = new Set<number>()
    const t = new Set<number>()
    for (let i = 0; i < n + 4; i++) {
        a.set(i, i + 1)
        b.set(i * 2, i + 2)
        c.set(i * 3, i + 3)
        s.add(i * 5)
        t.add(i * 7)
    }
    c.delete(3)
    t.delete(7)
    let total = 0
    for (let i = 0; i < n + 6; i++) {
        total += (a.get(i) ?? 1) + (b.get(i) ?? 2) + (c.get(i) ?? 3)
        total += (s.has(i) ? 10 : 20) + (t.has(i) ? 30 : 40)
    }
    return total + a.size + b.size * 10 + c.size * 100 + s.size * 1000 + t.size * 10000
}

function memberFillMap(m: Map<number, number>, n: u32, scale: number): void {
    for (let i = 0; i < n; i++) m.set(i * scale, i)
}
;(memberFillMap as any).shouldNotInline = true

function memberSumMap(m: Map<number, number>, n: u32, scale: number): number {
    let total = 0
    for (let i = 0; i < n; i++) total += m.get(i * scale) ?? 7
    return total + m.size
}
;(memberSumMap as any).shouldNotInline = true

function memberSharedHelpers(n: u32): number {
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    memberFillMap(kept, n + 3, 3)
    memberFillMap(pruned, n + 3, 5)
    pruned.delete(5)
    return memberSumMap(kept, n + 5, 3) * 1000 + memberSumMap(pruned, n + 5, 5)
}

function memberMakeMap(): Map<number, number> {
    return new Map<number, number>()
}
;(memberMakeMap as any).shouldNotInline = true

function memberSharedSite(n: u32): number {
    const kept = memberMakeMap()
    const pruned = memberMakeMap()
    for (let i = 0; i < n + 3; i++) {
        kept.set(i * 3, i)
        pruned.set(i * 5, i)
    }
    pruned.delete(5)
    let total = 0
    for (let i = 0; i < n + 5; i++) total += (kept.get(i * 3) ?? 7) * 100 + (pruned.get(i * 5) ?? 11)
    return total + kept.size * 10 + pruned.size
}

function memberCounterPair(n: u32): number {
    const plain = new MemberCounter()
    const biased = new MemberCounter()
    for (let i = 0; i < n; i++) {
        if (i % 3) plain.bump()
        if (i % 2) biased.bump()
    }
    biased.rebias(n * 7)
    return plain.read() * 1000 + biased.read()
}

function memberCountKeys(s: Set<number>, n: u32, scale: number): number {
    let total = 0
    for (let i = 0; i < n; i++) total += s.has(i * scale) ? 1 : 0
    return total + s.size * 10
}
;(memberCountKeys as any).shouldNotInline = true

function memberMixedHelpers(n: u32): number {
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    const own = new Map<number, number>()
    const plain = new Set<number>()
    const holed = new Set<number>()
    memberFillMap(kept, n + 3, 3)
    memberFillMap(pruned, n + 3, 5)
    for (let i = 0; i < n + 4; i++) {
        own.set(i * 7, i)
        plain.add(i * 2)
        holed.add(i * 3)
    }
    pruned.delete(5)
    holed.delete(3)
    let total = memberSumMap(kept, n + 5, 3) * 1000 + memberSumMap(pruned, n + 5, 5)
    total += memberCountKeys(plain, n + 6, 2) * 100 + memberCountKeys(holed, n + 6, 3)
    for (let i = 0; i < n + 6; i++) total += (own.get(i * 7) ?? 13) + (plain.has(i) ? 3 : 4)
    return total + own.size
}

class MemberLink {
    #mark: u32
    constructor() {
        this.#mark = 0
    }
    stamp(other: MemberLink, v: u32): void {
        other.#mark = v
    }
    peek(): number {
        return this.#mark ? this.#mark + 1 : 0
    }
}

function memberCrossWrite(n: u32): number {
    const a = new MemberLink()
    const b = new MemberLink()
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    const plain = new Set<number>()
    const holed = new Set<number>()
    memberFillMap(kept, n + 2, 3)
    memberFillMap(pruned, n + 2, 5)
    for (let i = 0; i < n + 3; i++) {
        plain.add(i * 2)
        holed.add(i * 3)
    }
    pruned.delete(5)
    holed.delete(3)
    a.stamp(b, n + 1)
    const maps = memberSumMap(kept, n + 3, 3) * 100 + memberSumMap(pruned, n + 3, 5)
    const sets = memberCountKeys(plain, n + 4, 2) * 100 + memberCountKeys(holed, n + 4, 3)
    return (b.peek() * 10 + a.peek()) * 1000000 + maps * 1000 + sets
}

class MemberRelay {
    #mark: u32
    #spins: u32
    constructor() {
        this.#mark = 0
        this.#spins = 0
    }
    #put(v: u32): void {
        let spins = 0
        while (spins < this.#mark + 2) spins++
        this.#mark = v
        this.#spins = spins
    }
    clear(): void {
        this.#put(0)
    }
    relay(other: MemberRelay, v: u32): void {
        other.#put(v)
    }
    peek(): number {
        return this.#mark ? this.#mark + 1 : 0
    }
}

;(MemberRelay.prototype.clear as any).shouldNotInline = true
;(MemberRelay.prototype.relay as any).shouldNotInline = true

function memberRelayWrite(n: u32): number {
    const a = new MemberRelay()
    const b = new MemberRelay()
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    const plain = new Set<number>()
    const holed = new Set<number>()
    memberFillMap(kept, n + 2, 3)
    memberFillMap(pruned, n + 2, 5)
    for (let i = 0; i < n + 3; i++) {
        plain.add(i * 2)
        holed.add(i * 3)
    }
    pruned.delete(5)
    holed.delete(3)
    b.clear()
    a.relay(b, n + 5)
    const maps = memberSumMap(kept, n + 3, 3) * 100 + memberSumMap(pruned, n + 3, 5)
    const sets = memberCountKeys(plain, n + 4, 2) * 100 + memberCountKeys(holed, n + 4, 3)
    return (b.peek() * 100 + a.peek()) * 1000000 + maps * 1000 + sets
}

class MemberCursor {
    #pos: u32
    constructor() {
        this.#pos = 0
    }
    #move(v: u32): void {
        this.#pos = v
    }
    step(v: u32): void {
        this.#move(v)
    }
    [Symbol.iterator](): MemberCursor {
        return this
    }
    next(): { done: boolean, value: number } {
        const done = this.#pos > 0
        this.#move(7)
        return { done, value: 3 }
    }
    peek(): number {
        return this.#pos ? this.#pos + 1 : 0
    }
}

;(MemberCursor.prototype.step as any).shouldNotInline = true
;(MemberCursor.prototype.next as any).shouldNotInline = true

function memberIteratedWrite(n: u32): number {
    const c = new MemberCursor()
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    const plain = new Set<number>()
    const holed = new Set<number>()
    for (let i = 0; i < n + 3; i++) {
        kept.set(i * 3, i)
        pruned.set(i * 5, i)
        plain.add(i * 2)
        holed.add(i * 3)
    }
    pruned.delete(5)
    holed.delete(3)
    c.step(0)
    let total = 0
    for (const v of c) total += v
    for (let i = 0; i < n + 4; i++) total += (kept.get(i * 3) ?? 7) + (pruned.get(i * 5) ?? 11) * 10 + (plain.has(i) ? 3 : 4) + (holed.has(i) ? 5 : 6)
    return c.peek() * 100000 + total * 10 + kept.size + pruned.size + plain.size + holed.size
}

class FloatCursor {
    #pos: u32
    #items: (number | { literal: number })[]
    constructor(items: (number | { literal: number })[]) {
        this.#pos = 0
        this.#items = items
    }
    next(): { done: boolean, value: number | { literal: number } | undefined } {
        const index = this.#pos
        if (index >= this.#items.length) return { done: true, value: undefined }
        this.#pos = index + 1
        return { done: false, value: floatAt(this.#items, index) }
    }
}

function floatAt(items: (number | { literal: number })[], i: u32): number | { literal: number } {
    return items[i]
}

;(floatAt as any).shouldNotInline = true
;(FloatCursor.prototype.next as any).shouldNotInline = true

class MemberGate {
    armed: u32
    constructor() {
        this.armed = 0
    }
    pass(x: number): number {
        return this.armed ? x : 0
    }
}

function memberExteriorWrite(n: u32): number {
    const g = new MemberGate()
    const h = new MemberGate()
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    const plain = new Set<number>()
    const holed = new Set<number>()
    h.armed = 1
    for (let i = 0; i < n + 3; i++) {
        kept.set(i * 3, i)
        pruned.set(i * 5, i)
        plain.add(i * 2)
        holed.add(i * 3)
    }
    pruned.delete(5)
    holed.delete(3)
    let total = 0
    for (let i = 0; i < n + 4; i++) total += (kept.get(i * 3) ?? 7) + (pruned.get(i * 5) ?? 11) * 10 + (plain.has(i) ? 3 : 4) + (holed.has(i) ? 5 : 6)
    return (g.pass(n + 3) * 100 + h.pass(n + 5)) * 100000 + total * 10 + kept.size + pruned.size + plain.size + holed.size
}

function guardSumMap(m: Map<number, number>): number {
    let total = 0
    for (const [k, v] of m) total += k * 3 + v
    return total + m.size
}
;(guardSumMap as any).shouldNotInline = true

function guardSumSet(s: Set<number>): number {
    let total = 0
    for (const k of s) total += k
    return total * 10 + s.size
}
;(guardSumSet as any).shouldNotInline = true

function guardIteratedMaps(n: u32): number {
    const kept = new Map<number, number>()
    const pruned = new Map<number, number>()
    const own = new Map<number, number>()
    const plain = new Set<number>()
    const holed = new Set<number>()
    const lone = new Set<number>()
    for (let i = 0; i < n + 12; i++) {
        kept.set(i * 3, i)
        pruned.set(i * 5, i)
        own.set(i * 7, i)
        plain.add(i * 2)
        holed.add(i * 3)
        lone.add(i * 11)
    }
    pruned.delete(5)
    holed.delete(3)
    let total = guardSumMap(kept) * 1000 + guardSumMap(pruned)
    total += guardSumSet(plain) * 100 + guardSumSet(holed)
    for (const k of own.keys()) total += k
    for (const k of lone.keys()) total += k * 2
    return total
}

function guardPickFirst(values: number[]): number {
    if (const u = values.find(x => x > 90)) return u
    return values.length
}
;(guardPickFirst as any).shouldNotInline = true

function guardIndexWrites(n: u32): number {
    const pair = [n, 7]
    const other = [n + 1, 9]
    const grown = [n]
    pair[1] = n + 8
    other[0] = n * 2
    grown[1] = n + 3
    grown[2] = n + 4
    const picks = guardPickFirst(pair) * 100 + guardPickFirst(other)
    return picks * 1000 + pair.length + other.length * 10 + grown.length * 100 + grown[2]
}

const factWeights = { scale: 3, offset: 7 }
const factSteps = [2, 3, 5]

function factWeigh(w: { scale: number, offset: number }, n: number): number {
    return w.scale * n + w.offset
}
;(factWeigh as any).shouldNotInline = true

function factSum(values: number[]): number {
    let total = 0
    for (let i = 0; i < values.length; i++) total += values[i]
    return total
}
;(factSum as any).shouldNotInline = true

function factStaticReceivers(n: u32): number {
    return factWeigh(factWeights, n) * 100 + factSum(factSteps)
}

function factWordCount(words: Uint32Array): number {
    return words.length
}
;(factWordCount as any).shouldNotInline = true

function factListCount(list: number[]): number {
    return list.length
}
;(factListCount as any).shouldNotInline = true

function factParamTests(n: u32): number {
    const words = new Uint32Array(4)
    words[1] = n
    const list: number[] = new Array()
    return factWordCount(words) * 100 + factListCount(list) * 10 + words[1]
}

function factIndexWrites(n: u32): number {
    const triple = [n, 7, 9]
    triple[0] = n + 1
    triple[2] = n + 2
    return factListCount(triple) * 100 + triple[0] + triple[2]
}

function clampedGrowth(n: u32): number {
    let capacity = n * 2 + 4
    if (capacity > 0xffffffff) capacity = 0xffffffff
    return capacity * 3 + 1
}
;(clampedGrowth as any).shouldNotInline = true

function clampedGrowths(n: u32): number {
    return clampedGrowth(n) + clampedGrowth(n * 0x4000)
}

function tableMaskOf(n: number): number {
    const mask = tableCapacity(n) - 1
    if (mask < 0) return 99
    return mask & 0xff
}
;(tableMaskOf as any).shouldNotInline = true

function tableMasks(n: u32): number {
    return tableMaskOf(n) + tableMaskOf(n * 100)
}

function splitTally(n: number): number {
    let hits = 0
    let misses = 0
    for (let i = 0; i < n; i++) {
        if (i % 3) hits++
        else misses++
    }
    return hits * 100 + misses
}

function footprintMapKeys(n: u32): number {
    const m = new Map<number, number>()
    m.set(n, 1)
    return [...m.keys()][0]
}

function maybeKeyHash(k: number, skip: u32): u32 {
    return hashKey(skip ? undefined : k)
}

function scaledOrPlain(a: u32): u32 {
    if (a > 1000) return (a % 7) * (a % 11) * (a % 13)
    return a + 1
}
;(scaledOrPlain as any).shouldNotInline = true

function plainOrScaled(a: u32): u32 {
    if (a <= 1000) return (a % 7) * (a % 11) * (a % 13)
    return a + 1
}
;(plainOrScaled as any).shouldNotInline = true

function scaledSum(n: u32): u32 {
    let total: u32 = 0
    for (let i: u32 = 0; i < n; i++) total = total + scaledOrPlain(i) + plainOrScaled(i)
    return total
}

function hashedSlot(key: number, mask: u32): number {
    return hashKey(key) & mask
}

function keptHash(x: number): number {
    return x + 1
}
;(keptHash as any).shouldNotInline = true

function hashedSum(n: number, mask: u32): number {
    let total = 0
    for (let i = 0; i < n; i++) total = total + (hashKey(i * 7) & mask)
    return keptHash(total) + n
}

function highBitsBranch(p: number, i: number): number {
    const x = Intrinsics.load(p, i * 8, Types.u64)
    if (x < 0x40000000) return Intrinsics.crc32(0, x, Types.u32)
    return 7
}
;(highBitsBranch as any).shouldNotInline = true

function highBitsFlag(p: number, i: number): boolean {
    return Intrinsics.load(p, i * 8, Types.u64) >= 0x1000000
}
;(highBitsFlag as any).shouldNotInline = true

function highBitsPick(p: number, i: number, a: number, b: number): number {
    const x = Intrinsics.load(p, i * 8, Types.u64)
    return (x <= 0xffffffffff ? a : b) + i
}
;(highBitsPick as any).shouldNotInline = true

function inHighBand(x: number): boolean {
    return x <= 0xffffffffff && x >= 0x1000000
}

function highBitsBetween(p: number, i: number): number {
    return inHighBand(Intrinsics.load(p, i * 8, Types.u64)) ? 5 : 9
}
;(highBitsBetween as any).shouldNotInline = true

function highBitsNarrow(p: number, i: number): boolean {
    return Intrinsics.load(p, i * 4, Types.u32) > 0xffff
}
;(highBitsNarrow as any).shouldNotInline = true

function windowHashed(p: number, i: number): number {
    return hashKey(Intrinsics.load(p, i * 8, Types.i64))
}
;(windowHashed as any).shouldNotInline = true

function windowOf(x: number): number {
    if (x >= -0x40000000 && x < 0x40000000) return 1
    return 2
}

function windowInlined(p: number, i: number): number {
    return windowOf(Intrinsics.load(p, i * 8, Types.i64))
}
;(windowInlined as any).shouldNotInline = true

function windowFlipped(x: number): boolean {
    return -0x8000001 < x && 0x7ffffff >= x
}

function windowFlippedInlined(p: number, i: number): number {
    return windowFlipped(Intrinsics.load(p, i * 8, Types.i64)) ? 3 : 4
}
;(windowFlippedInlined as any).shouldNotInline = true

function unsignedWindowInlined(p: number, i: number): number {
    return windowOf(Intrinsics.load(p, i * 8, Types.u64))
}
;(unsignedWindowInlined as any).shouldNotInline = true

function shiftBand(p: number, n: number, lo: number, hi: number, shift: number): void {
    for (let i = 0; i < n; i++) {
        const b = Intrinsics.load(p, i, Types.u8)
        Intrinsics.store(p, i, b >= lo && b <= hi ? b + shift : b, Types.u8)
    }
}

function upperBytes(p: number, n: number): number {
    shiftBand(p, n, 97, 122, -32)
    return n
}
;(upperBytes as any).shouldNotInline = true

function rangeVisit(v: number): number {
    return v * 3 + 1
}
;(rangeVisit as any).shouldNotInline = true

function rangeSums(n: u32): number {
    const offsets = new Int32Array(n + 2)
    for (let i = 0; i <= n; i++) offsets[i + 1] = offsets[i] + (i & 3)
    const targets = new Int32Array(offsets[n + 1])
    const queue = [0, n >> 1, n]
    let total = 0
    for (let k = 0; k < queue.length; k++) {
        const from = queue[k]
        for (let i = offsets[from]; i < offsets[from + 1]; i++) total += rangeVisit(targets[i])
    }
    return total
}

function levelScan(n: u32): number {
    const adjacency = new Int32Array(n)
    const level = new Int32Array(n)
    for (let i = 0; i < n; i++) adjacency[i] = (i * 7) % n
    for (let i = 0; i < n; i++) level[i] = i % 5
    let total = 0
    for (let from = 0; from < n; from++) {
        const edge = adjacency[adjacency[from]]
        if (level[edge] === level[from] + 1) total++
    }
    return total
}

function negScaledSlot(p: number, i: number, v: u32): number {
    const found = Intrinsics.load(p, i * 8, Types.i64)
    Intrinsics.store(p, 256 + (-found - 1) * 4, v, Types.u32)
    return 0
}
;(negScaledSlot as any).shouldNotInline = true

function clampedStore(p: number, i: number): number {
    const v = Intrinsics.load(p, i * 8, Types.u64)
    Intrinsics.store(p, 8, v > 0 ? v : 0, Types.u64)
    Intrinsics.store(p, 16, 0 < v ? v : 0, Types.u64)
    Intrinsics.store(p, 24, v <= 0 ? 0 : v, Types.u64)
    return 0
}
;(clampedStore as any).shouldNotInline = true

interface LengthEdge {
    from: number
    to: number
}

function equalLengthTables(edges: LengthEdge[]): number {
    const adjacency = new Int32Array(edges.length * 2)
    const targets = new Int32Array(edges.length * 2)
    const residual = new Float64Array(edges.length * 2)
    let total = 0
    for (let i = 0; i < edges.length; i++) {
        const edge = edges[i]
        adjacency[i * 2] = edge.from as i32
        targets[i * 2 + 1] = edge.to as i32
        residual[i * 2] = adjacency[i * 2] + targets[i * 2 + 1]
        total += residual[i * 2]
    }
    return total
}
;(equalLengthTables as any).shouldNotInline = true

function equalLengthReads(n: u32): number {
    const edges: LengthEdge[] = []
    for (let i = 0; i < n; i++) edges.push({ from: i, to: i + 2 })
    return equalLengthTables(edges)
}

let windowLog: number[] = []

function windowStep(v: number): number {
    windowLog.push(v)
    return v * 3 + 1
}
;(windowStep as any).shouldNotInline = true

function windowSum(xs: number[]): number {
    let total = 0
    for (const x of xs) total += x
    return total
}
;(windowSum as any).shouldNotInline = true

function lengthBeyondWindow(xs: number[]): number {
    const before = xs.length
    const a = windowStep(before)
    const b = windowStep(a)
    const c = windowStep(b)
    const d = windowStep(c)
    const e = windowStep(d)
    const f = windowStep(e)
    return xs.length + a + b + c + d + e + f + windowSum(xs)
}
;(lengthBeyondWindow as any).shouldNotInline = true

function lengthLastUse(xs: number[]): number {
    const sum = windowSum(xs)
    const before = xs.length
    const a = windowStep(before)
    const b = windowStep(a)
    const c = windowStep(b)
    const d = windowStep(c)
    const e = windowStep(d)
    const f = windowStep(e)
    return xs.length * 10 + before + sum + a + b + c + d + e + f
}
;(lengthLastUse as any).shouldNotInline = true

function farLengthReads(n: u32): number {
    const xs: number[] = []
    for (let i = 0; i < n; i++) xs.push(i * 2)
    return lengthBeyondWindow(xs) + lengthLastUse(xs) * 3
}

class ListPusher {
    constructor(list: number[], n: number) {
        list.push(n)
    }
}

class HeldShrinker {
    constructor(holder: { items: number[] }) {
        holder.items.pop()
    }
}

class Invoker {
    constructor(run: () => void) {
        run()
    }
}

let heldList: number[] = []

class HeldListGrower {
    constructor() {
        heldList.push(1)
    }
}

class ListGrower {
    list: number[]
    constructor(list: number[]) {
        this.list = list
    }
    get grown(): number {
        this.list.push(1)
        return 0
    }
    set item(value: number) {
        this.list.push(value)
    }
}

function lengthAcrossArgument(n: u32): number {
    const xs = [n]
    xs.push(n + 1)
    const before = xs.length
    new ListPusher(xs, n)
    return xs.length * 10 + before
}

function lengthAcrossClosure(n: u32): number {
    const xs = [n]
    const before = xs.length
    new Invoker(() => {
        xs.push(n)
    })
    return xs.length * 10 + before
}

function lengthAcrossHolder(n: u32): number {
    const xs = [n, n]
    const holder = { items: xs }
    const before = xs.length
    new HeldShrinker(holder)
    return xs.length * 10 + before
}

function lengthAcrossGlobal(n: u32): number {
    const xs = [n]
    heldList = xs
    const before = xs.length
    new HeldListGrower()
    return xs.length * 10 + before
}

function lengthAcrossGetter(n: u32): number {
    const xs = [n]
    const grower = new ListGrower(xs)
    const before = xs.length
    const extra = grower.grown
    const scratch = new Int32Array(n)
    return xs.length * 10 + before + extra + scratch.length
}

function lengthAcrossSetter(n: u32): number {
    const xs = [n]
    const grower = new ListGrower(xs)
    const before = xs.length
    grower.item = n
    const scratch = new Int32Array(n)
    return xs.length * 10 + before + scratch.length
}

function slackFillTable(count: u32): number {
    const table = allocate(count * 4 + 16 + (count >> 1))
    for (let i: u32 = 0; i < count; i++) Intrinsics.store(table, i * 4, 0, Types.u32)
    return table
}
;(slackFillTable as any).shouldNotInline = true

function slackFill(n: u32): number {
    const top = programStackTop()
    const table = slackFillTable(n)
    let sum = 0
    for (let i: u32 = 0; i < n; i++) sum += Intrinsics.load(table, i * 4, Types.u32)
    Intrinsics.pstack(programStack, top, 0)
    return sum + n
}

function slackFillKept(n: u32): number {
    const top = programStackTop()
    const table = allocate(n * 4 + 16)
    Intrinsics.store(table, n * 4, 7, Types.u32)
    for (let i: u32 = 0; i < n; i++) Intrinsics.store(table, i * 4, 0, Types.u32)
    const kept = Intrinsics.load(table, n * 4, Types.u32)
    Intrinsics.pstack(programStack, top, 0)
    return kept
}
;(slackFillKept as any).shouldNotInline = true
function slotWord(p: number, i: number): number {
    return Intrinsics.load(p, i * 8, Types.u64)
}
;(slotWord as any).shouldNotInline = true

function slotFollow(p: number, i: number): boolean {
    return Intrinsics.load(p, i * 8 + 8, Types.u64) !== 0
}
;(slotFollow as any).shouldNotInline = true

function slotIs(p: number, i: number, want: number): boolean {
    return slotWord(p, i) === want
}

function slotMatches(p: number, i: number, want: number): boolean {
    if (!slotIs(p, i, want)) return false
    return slotFollow(p, i)
}

;(slotMatches as any).shouldNotInline = true

function mapProbeSum(n: u32): number {
    const m = new Map<number, number>()
    for (let i = 0; i < n; i++) m.set(i * 3 - 5, i)
    m.delete(-2)
    let sum = 0
    for (let i = 0; i < n; i++) sum += m.get(i * 3 - 5) ?? 0
    return sum
}

function probeHashed(table: number, mask: number, p: number): number {
    const key = Intrinsics.load(p, 0, Types.u64)
    let slot = hashKey(key) & mask
    let entry = Intrinsics.load(table, slot * 4, Types.u32)
    while (entry) {
        if (entry === key) return entry
        slot = (slot + 1) & mask
        entry = Intrinsics.load(table, slot * 4, Types.u32)
    }
    return -slot - 1
}
;(probeHashed as any).shouldNotInline = true

function probeWithHoles(keys: number, table: number, mask: number, key: number, holes: number): number {
    let slot = key & mask
    let entry = Intrinsics.load(table, slot * 4, Types.u32)
    while (entry) {
        const stored = Intrinsics.load(keys, (entry - 1) * 8, Types.i64)
        if (stored === key && (!holes || !Intrinsics.load(holes, 16 + entry - 1, Types.u8))) return entry - 1
        slot = (slot + 1) & mask
        entry = Intrinsics.load(table, slot * 4, Types.u32)
    }
    return -slot - 1
}
;(probeWithHoles as any).shouldNotInline = true

function knownArrivals(listing: string): string[] {
    const lines = listing.split('\n').map(l => l.trim())
    const firstAfter = new Map<string, string>()
    for (let i = 0; i < lines.length; i++) {
        const label = /^(L\d+):$/.exec(lines[i])
        if (!label) continue
        let j = i + 1
        while (j < lines.length && /^L\d+:$/.test(lines[j])) j++
        firstAfter.set(label[1], lines[j] ?? '')
    }
    const found: string[] = []
    for (let i = 1; i < lines.length; i++) {
        const jump = /\bb (L\d+)$/.exec(lines[i])
        const falls = /^L\d+:$/.test(lines[i]) && !/\b(?:b L\d+|ret|br x\d+)$/.test(lines[i - 1])
        const next = jump ? firstAfter.get(jump[1]) : falls ? firstAfter.get(lines[i].slice(0, -1)) : undefined
        const reg = next ? /\b(?:cbz|cbnz|tbz|tbnz) [xw](\d+),/.exec(next) : undefined
        if (!reg) continue
        let k = i - 1
        while (k >= 0 && !/^L\d+:$/.test(lines[k]) && !/  (?:b|b\.\w+|cbz|cbnz|tbz|tbnz|ret|br|bl|blr) /.test(` ${lines[k]} `)) {
            const op = /^\d+: [0-9a-f]+  (\S+) [xw](\d+),/.exec(lines[k])
            if (op && op[2] === reg[1] && !/^(?:st|cmp|cmn|tst|ccmp)/.test(op[1])) {
                if (/^(?:movz|movn|cset)$/.test(op[1])) found.push(`${lines[k]} -> ${lines[i]} -> ${next}`)
                break
            }
            k--
        }
    }
    return found
}

const slotWidths = new Uint8Array(40)
slotWidths[3] = 1
slotWidths[7] = 2
slotWidths[31] = 1

function slotWidth(op: number): number {
    return slotWidths[op]
}
;(slotWidth as any).shouldNotInline = true

function pokeWord(p: number, v: number): void {
    Intrinsics.store(p, 8, v, Types.i64)
}
;(pokeWord as any).shouldNotInline = true

function clampedSigned(p: number, i: number): number {
    const v = Intrinsics.load(p, i * 8, Types.i64)
    Intrinsics.store(p, 8, v > 0 ? v : 0, Types.i64)
    return 0
}
;(clampedSigned as any).shouldNotInline = true

function farFloat(p: number, i: number): number {
    const x = Intrinsics.load(p, i * 8, Types.f64)
    Intrinsics.store(p, 0, x >= 1e21 ? 1 : 0, Types.u8)
    Intrinsics.store(p, 1, x <= -1e21 ? 1 : 0, Types.u8)
    return 0
}
;(farFloat as any).shouldNotInline = true

function mixedKeyLookups(n: u32): number {
    const byFn = new Map<Function, number>()
    byFn.set(farFloat, n)
    const byText = new Map<string, number>()
    byText.set(`k${n}`, n + 1)
    const byBox = new Map<object, number>()
    const box = { v: n }
    byBox.set(box, n + 2)
    return byFn.get(farFloat)! * 100 + byText.get(`k${n}`)! * 10 + byBox.get(box)!
}

function nullishIterationValues(n: u32): number[] | null | undefined {
    if (n === 0) return null
    if (n === 1) return undefined
    if (n === 2) return []
    return [n, n + 1, n + 2]
}
;(nullishIterationValues as any).shouldNotInline = true

function nullishForOf(n: u32): number {
    let sum = 0
    for (const x of nullishIterationValues(n) ?? []) sum = sum * 10 + x
    return sum
}

function guardedForOf(n: u32): number {
    const values = nullishIterationValues(n)
    let sum = 0
    if (values !== null && values !== undefined) {
        for (const x of values) sum = sum * 10 + x
    }
    return sum
}

function orderedPicks(n: u32): number {
    const order = new Map<number, number>()
    for (let i = 0; i < 6; i++) order.set(n + i, 6 - i)
    function unordered(a: number): boolean {
        return !order.has(a)
    }
    function precedes(a: number, b: number): boolean {
        return (order.get(a) ?? 0) < (order.get(b) ?? 0)
    }
    function pick(tokens: number[]): number {
        let result = 0
        for (const token of tokens.filter(token => token > 0 && !unordered(token))) {
            if (tokens.some(other => other !== token && precedes(token, other))) continue
            result = result * 10 + token
        }
        return result
    }
    let total = 0
    for (let i = 0; i < 3; i++) total += pick([n + i, n + 1, 0, n + 9])
    return total
}

function undefinedSlotPush(n: u32): number {
    const xs: (number | undefined)[] = []
    xs.push(n > 2 ? undefined : n * 0.5)
    return xs[0] === undefined ? 7 : 3
}

function entriesLiteralSum(n: u32): number {
    let s = 0
    for (const [k, v] of Object.entries({ a: 1, b: 2 })) s += v
    return s + n
}

function digitOrRadix(byte: number, radix: number): number {
    const digit = byte >= 48 && byte <= 57 ? byte - 48 : byte >= 97 && byte <= 122 ? byte - 87 : byte >= 65 && byte <= 90 ? byte - 55 : radix
    return digit < radix ? digit : -1
}
;(digitOrRadix as any).shouldInline = true

function rangeWide(p: number, i: number): number {
    return digitOrRadix(Intrinsics.load(p, i * 8, Types.i64), 80)
}
;(rangeWide as any).shouldNotInline = true

function rangeUnsigned(p: number, i: number): number {
    return digitOrRadix(Intrinsics.load(p, i * 8, Types.u64), 80)
}
;(rangeUnsigned as any).shouldNotInline = true

function rangeNarrow(p: number, i: number): number {
    return digitOrRadix(Intrinsics.load(p, i * 4, Types.u32), 80)
}
;(rangeNarrow as any).shouldNotInline = true

class CheckedSize {
    #size = 0
    set size(value: number) {
        if (typeof value !== 'number') throw 'Invalid size'
        if (value < 0 || value > 255) throw 'Invalid size'
        this.#size = value
    }
    next(value: number): number {
        if (typeof value !== 'number') throw 'Invalid size'
        return value + this.#size
    }
    get size(): number {
        return this.#size
    }
}

class RestCounter {
    #total = 0
    add(...items: any[]): number {
        const count = items.length
        this.#total = this.#total + count
        return count
    }
}

class FloatPairItem {
    id: number
    constructor(id: number) {
        this.id = id
    }
}

class IntStep {
    step(k: number): number {
        return k + 1
    }
}

class StepCounter {
    #step = new IntStep()
    #count = 0
    feed(): void {
        this.#count = this.#step.step(this.#count)
    }
}

class LengthHolder {
    #items: number[] = []
    #count = 0
    push(x: number): void {
        this.#items.push(x)
        this.#count = this.#items.length
    }
}

class ModePick {
    #mode = 0
    pick(a: any): any {
        return this.#mode === 1 ? a : 0
    }
    choose(a: any): any {
        if (this.#mode === 1) return a
        return 0
    }
}

class RestFeeder {
    #count: any
    constructor(source: any) {
        this.#count = source.add()
    }
    get count(): any {
        return this.#count
    }
}

function restFeeder(n: u32): u32 {
    const counter = new RestCounter()
    counter.add(n, n)
    const feeder = new RestFeeder(counter)
    return feeder.count + 1
}

function nestedMapValues(n: u32): number {
    const lists = new Map<number, number[]>()
    lists.set(1, [0])
    lists.set(2, [n - 1])
    return lists.get(1)!.length + lists.get(2)!.length + lists.get(2)![0]
}

function rotatedRefs(n: u32): number {
    function rotated<T>(a: T[]): T[] {
        return [...a.slice(n & 1), a[0]]
    }
    const tags = rotated([{ literal: n }, { literal: n + 1 }])
    const ids = rotated([n, n + 2, n + 3])
    return sumRefs(ids) + tags[0].literal
}

function sumRefs(ids: number[]): number {
    let total = 0
    for (let i = 0; i < ids.length; i++) total += ids[i]
    return total
}
;(sumRefs as any).shouldNotInline = true

interface WordPool {
    raw: number[]
}

function poolLength(pool: WordPool, at: number): number {
    return pool.raw[at]
}

function poolAt(pool: WordPool, at: number, i: number): number {
    return pool.raw[at + 1 + i]
}

function decodeFromPool(pool: WordPool, at: number): number[] | undefined {
    if (at < 100) return undefined
    const words = poolLength(pool, at)
    const base = 7 + poolAt(pool, at, 6)
    intrinsics.assert(words === base, `no layout at ${at}`)
    const reads: number[] = []
    let k = 7
    while (k < base) {
        reads.push(poolAt(pool, at, k))
        k++
    }
    return reads
}
;(decodeFromPool as any).shouldNotInline = true

function emptyPoolDecode(n: u32): number {
    const pool: WordPool = { raw: [] }
    const decoded = decodeFromPool(pool, n)
    const live: number[] = []
    live.push(n)
    const boxes: { v: number }[] = []
    boxes.push({ v: n })
    return decoded ? decoded.length : live.length + boxes[0].v + n
}

function nanSlow(n: number): number {
    return n + 1000
}
;(nanSlow as any).shouldNotInline = true

function nanFast(n: number): number {
    return n + 1
}
;(nanFast as any).shouldNotInline = true

function halfIsNumber(i: u32): number {
    const x = i * 0.5
    return x !== x ? nanSlow(i) : nanFast(i)
}

function quotientMayBeNaN(i: u32, j: u32): number {
    const x = (i - j) / (j - i)
    return x !== x ? nanSlow(i) : nanFast(i)
}

function pickedClosure(n: u32): number {
    const seen: number[] = [n]
    const held: number[] = []
    const visit = (id: number | undefined, b: number[] | undefined) => {
        seen.push((id ?? 1) + (b ? b.length : 3))
    }
    const hold = (id: number | undefined, b: number[] | undefined) => {
        held.push((id ?? 2) * 2 + (b ? b.length : 5))
    }
    let i = 0
    while (i < n) {
        const onward = (i & 1) ? hold : visit
        onward(seen[i + 5], seen)
        i++
    }
    const spare = n > 4 ? held : undefined
    visit(n + 1, spare)
    hold(n + 2, spare)
    return seen.length * 100 + held.length
}

function pickedClosureTwoSites(n: u32): number {
    const seen: number[] = [n]
    const held: number[] = []
    const visit = (id: number | undefined, b: number[] | undefined) => {
        seen.push((id ?? 1) + (b ? b.length : 3))
    }
    const hold = (id: number | undefined, b: number[] | undefined) => {
        held.push((id ?? 2) * 2 + (b ? b.length : 5))
    }
    let i = 0
    while (i < n) {
        const onward = (i & 1) ? hold : visit
        if (i & 2) onward(seen[i + 5], seen)
        else onward(i, i > 4 ? held : undefined)
        i++
    }
    return seen.length * 100 + held.length
}

function floatOrUndefinedSteps(n: u32): number {
    const steps: (number | undefined)[] = []
    let i = 0
    while (i < n) {
        steps.push(i & 1 ? undefined : i * 0.5)
        i++
    }
    let total = 0
    let k = 0
    while (k < n) {
        const step = steps[k]
        if (step !== undefined) total += step
        k++
    }
    return total * 2
}

function stepPair(k: number, scale: number): [number, number | undefined] {
    if (k & 1) return [k, scale * 0.5]
    return [k, undefined]
}
;(stepPair as any).shouldNotInline = true

function pairSteps(n: u32): number {
    let total = 0
    let i = 0
    while (i < n) {
        const pair = stepPair(i, n)
        const step = pair[1]
        if (step !== undefined) total += step + pair[0]
        i++
    }
    return total * 2
}

interface MiniDeriveNode {
    op: number
    slots: number[]
}

function miniDerive(n: u32): number {
    const literals: number[] = []
    while (literals.length < n) literals.push(literals.length * 0.75)
    const nodes: MiniDeriveNode[] = []
    let k = 0
    while (k < n) {
        nodes.push({ op: k % 3, slots: [k & 1 ? 1000 + k : k, (k * 7) % n] })
        k++
    }
    function ref(node: MiniDeriveNode, i: number): number {
        const v = node.slots[i]
        return v >= 1000 ? v - 1000 : 0
    }
    function literal(node: MiniDeriveNode, i: number): f64 {
        const v = node.slots[i]
        return (v >= 1000 ? 0 : literals[v]) as f64
    }
    const added: number[] = []
    function addNode(op: number, a: number, b: number): number {
        added.push(op * 100 + a + b)
        return added.length
    }
    function addCopy(op: number, operands: any[]): number {
        let sum = op
        for (const x of operands) sum += typeof x === 'number' ? x : x.literal
        added.push(sum)
        return added.length
    }
    const chain: [id: number, from: number][] = []
    k = 0
    while (k < (n >> 1)) {
        chain.push([k, k & 1])
        k++
    }
    const scale = 2
    function replay(value: [number, number], operand: (id: number, value: number) => [number, number]) {
        for (const [id, from] of chain) {
            const node = nodes[id]
            const ids = [0, 0]
            const consts = [0, 0]
            ids[from] = value[0]
            consts[from] = value[1]
            const x = operand(ref(node, from ^ 1), literal(node, from ^ 1))
            ids[from ^ 1] = x[0]
            consts[from ^ 1] = x[1]
            if (ids[0] || ids[1]) {
                value = [addCopy(node.op, ids.map((id, i) => id || { literal: consts[i] })), 0]
            } else if (node.op === 0) {
                value = [0, consts[0] + consts[1]]
            } else if (node.op === 1) {
                value = [0, consts[0] * consts[1]]
            } else {
                value = [0, consts[0] - consts[1]]
            }
        }
        return value
    }
    const addr = n & 1 ? n : 0
    const bias = addr ? replay([0, 0], (id, value) => [id, value])[1] : 0
    function address(value: [number, number], outside: (id: number, value: number) => [number, number]): [number, number] {
        const base = outside(addr, 0)
        if (!value[0] && !value[1]) return base
        const offset = value[0] ? addNode(3, value[0], scale) : 0
        return [addNode(4, base[0] || base[1], offset || value[1] * scale + bias), 0]
    }
    const limits: [param: number, bound: [number, number]][] = []
    k = 0
    while (k < n) {
        if (k & 2) limits.push([k, [ref(nodes[k], 0), literal(nodes[k], 1)]])
        k++
    }
    const operands: any[] = []
    for (const app of nodes) {
        function outside(id: number, value: number): [number, number] {
            if (!id) return [0, value]
            const i = id % 2
            return [ref(app, i), literal(app, i)]
        }
        const derive = addr ? address : replay
        const d = derive([ref(app, 0), literal(app, 0)], outside)
        operands.push(d[0] || { literal: d[1] })
        for (const [, bound] of limits) {
            const [id, value] = derive(outside(...bound), outside)
            operands.push(id || { literal: value })
        }
    }
    let total = 0
    for (const x of operands) total += typeof x === 'number' ? x : x.literal
    return total + added.length
}

function scaledTruth(n: u32): number {
    const terms: number[] = []
    while (terms.length < n) terms.push(((terms.length * 3) % 5) * 0.75)
    const kept: any[] = []
    function scalar(at: number): number | undefined {
        return at & 4 ? undefined : terms[at]
    }
    function splitScaled(at: number): [term: number, offset: number] {
        if (at >= terms.length) return [at, 0]
        const right = scalar(at)
        if (right !== undefined && right > 2) {
            const [rest, offset] = splitScaled(at + 1)
            return [rest, offset + right]
        }
        const scaleAt = at & 1
        const amount = scalar(at + 1)
        if (amount === undefined) return [at, 0]
        const [rest, offset] = splitScaled(at + 2)
        if (!offset) return [at, 0]
        const operands: any[] = [0, 0]
        operands[scaleAt ^ 1] = rest
        operands[scaleAt] = { literal: amount }
        kept.push(operands)
        return [rest + 1, offset * amount]
    }
    let total = 0
    let i = 0
    while (i < n) {
        const [rest, offset] = splitScaled(i)
        if (!offset) total += rest
        else total += rest + offset * 10
        i++
    }
    return total + kept.length
}

function sharedIndexTruth(n: u32): number {
    const items: any[] = [n * 0.25, { literal: n }]
    items[n & 1] = items[(n & 1) ^ 1]
    const words: any[] = [n * 0.5, `w${n}`]
    words[n & 1] = words[(n & 1) ^ 1]
    const x = items[1]
    let total = 0
    if (!x) total += 1000
    else total += typeof x === 'number' ? x : x.literal
    const w = words[1]
    return total + (typeof w === 'number' ? w : 7)
}

function coveredLike(at: Map<number, number>, m: { pos: number }): boolean {
    for (let i = m.pos - 4; i <= m.pos; i++) {
        const width = at.get(i)
        if (width !== undefined && m.pos + 4 <= i + width) return true
    }
    return false
}

function literalPairs(n: u32): number {
    const ps = [{ x: 1, y: 2 }, { x: n, y: 3 }, { x: 5, y: n }]
    let total = 0
    for (let i = 0; i < ps.length; i++) total = total * 10 + ps[i].x + ps[i].y
    return total
}

function coveredCase(n: u32): number {
    const at = new Map([[n, 8], [n + 8, 4]])
    const mems = [{ pos: n }, { pos: n + 9 }]
    return coveredLike(at, mems[n & 1]) ? 1 : 0
}

interface TaggedChoice {
    owner: number | undefined
    slot: number | undefined
}

function writeBody(b: { body: number }, log: number[]): void {
    b.body = 100
    for (let i = 0; i < log.length; i++) log[i]++
}

function readThenWrite(b: { body: number }, c: TaggedChoice, log: number[]): number {
    log.push(1)
    let bodyId = b.body
    if (c.owner !== undefined) bodyId = c.owner + (c.slot ?? 7)
    else writeBody(b, log)
    return bodyId
}

function readSlotThenWrite(b: { body: number }, c: TaggedChoice, log: number[]): number {
    log.push(1)
    let bodyId = b.body
    if (c.slot !== undefined) bodyId = c.slot + (c.owner ?? 7)
    else writeBody(b, log)
    return bodyId
}

function taggedWarCase(n: u32): number {
    const log = [n]
    const blocks = [{ body: n + 5 }, { body: n + 7 }]
    const choices: TaggedChoice[] = [{ owner: n & 2 ? n : undefined, slot: n & 2 ? n + 1 : undefined }, { owner: undefined, slot: n & 4 ? n : undefined }]
    return readThenWrite(blocks[n & 1], choices[n & 1], log) * 1000 + readSlotThenWrite(blocks[(n + 1) & 1], choices[(n + 1) & 1], log)
}

function producesAt(p: number, id: number): boolean {
    if (!id) return false
    const op = Intrinsics.load(p, id * 24, Types.u32)
    if (op === 1) return producesAt(p, Intrinsics.load(p, id * 24 + 4, Types.u32))
    if (op === 2) return producesAt(p, Intrinsics.load(p, id * 24 + 8, Types.u32))
    if (op === 3) return producesAt(p, Intrinsics.load(p, id * 24 + 12, Types.u32)) && producesAt(p, Intrinsics.load(p, id * 24 + 16, Types.u32))
    return op === 4
}

