        }
        if (Number(natives.negativeRootScaled(3)) !== 6.5 || Number(natives.negativeRootCompare(3)) !== 2) harness.fail(`negativeRootScaled(3) = ${natives.negativeRootScaled(3)}, negativeRootCompare(3) = ${natives.negativeRootCompare(3)}`)
