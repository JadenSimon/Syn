/// @synth

"use wrapped";

import * as heap from './heap'
import * as intrinsics from './intrinsics'
import * as rt from './rt'
import { blockOrder, countIds, RecomputableOps, heapFieldCount, heapInterior, rawSlot, rawWords, getBlock, getLiteral, getNode, getRef, machineType, NodeOp, opName, orderRegions, resultType, sameSlotBits, typeOf, typeRefOf, nodeEntries, buildIndex, refreshStale, refreshable, watchIndex, type GraphIndex, GraphKinds, kindOf } from './graph-node'
import type { Graph, GraphBlock, GraphNode, MemAnalysis } from './lowering2'
import type { CompileError } from './native'

const Types = intrinsics.Types

export interface CallEdge {
    raw: boolean
    params: Map<number, { word: boolean, pointer: boolean }>
}

function fail(stage: string, g: Graph, id: number, reason: string): never {
    const error: CompileError = new Error(`verify: ${stage}: ${g.name || '<anonymous>'} %${id} ${reason}`)
    error.unit = g.name
    error.node = id
    throw error
}

function heapHandleShape(stage: string, g: Graph, id: number, n: GraphNode): void {
    if (getRef(n, 0)) fail(stage, g, id, '(heap-handle) has no literal identity')
    if (countIds(n) === (heapInterior(g, n) ? 2 : 1)) return
    const fields = heapFieldCount(n)
    const raw = getRef(n, countIds(n) - fields - 1)
    if (getNode(g, raw)?.op !== NodeOp.rawbuffer || rawWords(g, raw) !== fields) fail(stage, g, id, '(heap-handle) carries more than its identity, interior and keyed fields')
}

export function verifyGraph(g: Graph, stage: string, packaged: boolean): void {
    const constants = new Map<number, boolean>()
    function constant(id: number): boolean {
        const known = constants.get(id)
        if (known !== undefined) return known
        const n = getNode(g, id)
        let result = !!n && RecomputableOps.has(n.op)
        for (let i = 0; result && i < countIds(n!); i++) {
            const ref = getRef(n!, i)
            if (ref && !constant(ref)) result = false
        }
        constants.set(id, result)
        return result
    }
    const base = g.epoch + 1
    const index = new Map<number, number>()
    for (let k = 0; k < g.blocks.length; k++) {
        const b = g.blocks[k]
        index.set(b.id, k)
        for (const p of b.params) {
            const n = getNode(g, p)
            if (n?.op !== NodeOp.param) fail(stage, g, b.id, `is a block whose param %${p} is missing`)
            n.epoch = base + k
        }
    }
    g.epoch = base + g.blocks.length
    const projections: number[] = []
    const slotTypes = new Map<string, [number, intrinsics.Types]>()
    function slotAccess(id: number, n: GraphNode): void {
        const at = getRef(n, 1)
        const base = at ? getNode(g, at) : undefined
        if (base?.op !== NodeOp.alloca && base?.op !== NodeOp.pstack) return
        if (getRef(n, 2)) return
        const key = `${at}:${getLiteral(g, n, 2)}`
        const T = machineType(typeOf(n))
        const known = slotTypes.get(key)
        if (!known) {
            slotTypes.set(key, [id, T])
            return
        }
        if (!sameSlotBits(known[1], T)) fail(stage, g, id, `(${opName(n.op)}) accesses %${at}+${getLiteral(g, n, 2)} as ${T}, but %${known[0]} accesses it as ${known[1]}`)
    }
    const reached = new Set<number>([g.root])
    const blocks = [g.root]
    const work: number[] = []
    let next = 0
    while (next < blocks.length) {
        const b = getBlock(g, blocks[next++])!
        const epoch = packaged ? base + index.get(b.id)! : base
        if (!getNode(g, b.bodyId)) fail(stage, g, b.id, `is a block whose body %${b.bodyId} is missing`)
        work.push(b.bodyId)
        while (work.length) {
            const id = work.pop()!
            const n = getNode(g, id)!
            if (n.op === NodeOp.param) {
                if (packaged && n.epoch !== epoch) fail(stage, g, id, `is a param of ${n.epoch >= base ? `B${g.blocks[n.epoch - base].id}` : 'no block'} used in B${b.id}`)
                continue
            }
            if (n.epoch === epoch) continue
            if (n.epoch >= base && packaged && !constant(id)) fail(stage, g, id, `(${opName(n.op)}) is shared by B${g.blocks[n.epoch - base].id} and B${b.id}`)
            if (n.epoch >= base) continue
            n.epoch = epoch
            if (n.op === NodeOp.get && getNode(g, getRef(n, 0))?.op === NodeOp.call) projections.push(id)
            if (n.op === NodeOp.load || n.op === NodeOp.store) slotAccess(id, n)
            if (n.op === NodeOp.heapHandle) heapHandleShape(stage, g, id, n)
            if (n.op === NodeOp.localTarget && countIds(n) > 1 && rawSlot(n) < 0) fail(stage, g, id, '(local-target) carries more than its symbol and a raw summary reference')
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const m = getNode(g, ref)
                if (!m) fail(stage, g, id, `(${opName(n.op)}) slot ${i} names missing %${ref}`)
                if (m.op !== NodeOp.block) {
                    work.push(ref)
                    continue
                }
                if (n.op !== NodeOp.apply || i) continue
                if (!getBlock(g, ref)) fail(stage, g, id, `(apply) targets B${ref}, which is not a block of the graph`)
                if (!reached.has(ref)) {
                    reached.add(ref)
                    blocks.push(ref)
                }
            }
            const T = typeRefOf(n)
            if (T && !getNode(g, T)) fail(stage, g, id, `(${opName(n.op)}) type slot names missing %${T}`)
        }
    }
    if (!packaged) return
    for (const id of projections) {
        const call = getRef(getNode(g, id)!, 0)
        const at = getNode(g, id)!.epoch - base
        const home = getNode(g, call)!.epoch - base
        if (at !== home) fail(stage, g, id, `(get) projects call %${call} of B${g.blocks[home].id} in B${g.blocks[at].id}`)
    }
}

export function verifyOrderingSlots(g: Graph, stage: string, ordering: (n: GraphNode) => number, hollow: (id: number) => boolean): void {
    for (const [id, n] of nodeEntries(g)) {
        const end = ordering(n)
        for (let i = 0; i < end; i++) {
            const ref = getRef(n, i)
            if (ref && hollow(ref)) fail(stage, g, id, `(${opName(n.op)}) is ordered after %${ref} (${opName(getNode(g, ref)!.op)}), which carries no effect of its own`)
        }
    }
}

export function verifyTailEffects(g: Graph, stage: string, offTail: number[]): void {
    if (offTail.length) fail(stage, g, offTail[0], `(select) has an effect in an arm but sits outside its block's tail`)
}

function tailSlot(n: GraphNode, i: number): boolean {
    if (n.op === NodeOp.after) return i === countIds(n) - 1
    if (n.op === NodeOp.select) return i > 0
    return n.op === NodeOp.inlined && i === 0
}

export function verifyTokenSelects(g: Graph, stage: string): void {
    for (const b of g.blocks) {
        const tail = new Set<number>()
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (tail.has(id)) continue
            tail.add(id)
            const n = getNode(g, id)!
            for (let i = 0; i < countIds(n); i++) {
                if (getRef(n, i) && tailSlot(n, i)) stack.push(getRef(n, i))
            }
        }
        const seen = new Set<number>([b.bodyId])
        stack.push(b.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            const n = getNode(g, id)!
            if (n.op === NodeOp.param || n.op === NodeOp.block) continue
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const m = getNode(g, ref)!
                if (m.op === NodeOp.select && !(tail.has(id) && tailSlot(n, i))) {
                    for (let k = 1; k < countIds(m); k++) {
                        if (getRef(m, k) && getNode(g, getRef(m, k))!.op === NodeOp.startOf) fail(stage, g, ref, `(select) has a start-of arm %${getRef(m, k)} but sits outside its block's tail`)
                    }
                }
                if (seen.has(ref)) continue
                seen.add(ref)
                stack.push(ref)
            }
        }
    }
}

interface OrderEntry {
    id: number
    index: number
    lifted: number
    proxy: number
    proxyIndex: number
}

interface OrderSlots {
    widest: number
    at: Map<number, OrderEntry[]>
    anywhere: OrderEntry[]
}

interface OrderBase {
    stores: OrderSlots
    loads: OrderSlots
}

function orderSlots(): OrderSlots {
    return { widest: 0, at: new Map(), anywhere: [] }
}

function collectSlots(slots: OrderSlots, pos: number | undefined, bytes: number, out: OrderEntry[]): void {
    for (const e of slots.anywhere) out.push(e)
    if (pos === undefined) {
        for (const entries of slots.at.values()) {
            for (const e of entries) out.push(e)
        }
        return
    }
    for (let at = pos - slots.widest + 1; at < pos + bytes; at++) {
        for (const e of slots.at.get(at) ?? []) out.push(e)
    }
}

function addSlot(slots: OrderSlots, e: OrderEntry, pos: number | undefined, bytes: number): void {
    if (pos === undefined) {
        slots.anywhere.push(e)
        return
    }
    let entries = slots.at.get(pos)
    if (!entries) slots.at.set(pos, entries = [])
    entries.push(e)
    if (bytes > slots.widest) slots.widest = bytes
}

function pruneSlots(g: Graph, mem: MemAnalysis, b: GraphBlock, slots: OrderSlots, store: GraphNode, pos: number | undefined, bytes: number): void {
    if (pos === undefined) {
        slots.anywhere = []
        slots.at.clear()
        return
    }
    for (let at = pos - slots.widest + 1; at < pos + bytes; at++) {
        const entries = slots.at.get(at)
        if (!entries) continue
        const kept: OrderEntry[] = []
        for (const e of entries) {
            if (!mem.covers(b, store, getNode(g, e.id)!)) kept.push(e)
        }
        if (kept.length) slots.at.set(at, kept)
        else slots.at.delete(at)
    }
}

export function verifyMemoryOrder(g: Graph, stage: string, getMem: () => MemAnalysis): void {
    for (const b of g.blocks) {
        verifyBlockMemoryOrder(g, stage, getMem, b)
    }
}

function verifyBlockMemoryOrder(g: Graph, stage: string, getMem: () => MemAnalysis, b: GraphBlock): void {
    const order = blockOrder(g, b)
    const index = new Map<number, number>()
    let accesses = 0
    for (let k = 0; k < order.length; k++) {
        index.set(order[k], k)
        const op = getNode(g, order[k])?.op
        if (op === NodeOp.load || op === NodeOp.store) accesses++
    }
    if (accesses < 2) return
    const regions = orderRegions(g, order)
    const byRegion: [id: number, lifted: number][][] = []
    for (let r = 0; r < regions.parent.length; r++) byRegion.push([])
    for (const id of order) {
        const op = getNode(g, id)!.op
        if (op !== NodeOp.load && op !== NodeOp.store) continue
        let lifted = 0
        let r = regions.of.get(id) ?? -1
        while (r >= 0) {
            byRegion[r].push([id, lifted])
            lifted = regions.origin[r]
            r = regions.parent[r]
        }
    }
    const chains = new Map<number, [chain: number, seq: number]>()
    const tails = new Map<number, number>()
    for (const id of order) {
        const n = getNode(g, id)!
        const t = getRef(n, 0)
        const parent = t ? chains.get(t) : undefined
        const link: [number, number] = parent && tails.get(parent[0]) === t ? [parent[0], parent[1] + 1] : [id, 0]
        chains.set(id, link)
        tails.set(link[0], id)
    }
    function chained(later: number, earlier: number): boolean {
        const x = chains.get(later)!
        const y = chains.get(earlier)!
        return x[0] === y[0] && x[1] > y[1]
    }
    const reached = new Map<number, number>()
    let stamp = 0
    function search(from: number, floor: number): void {
        stamp++
        const work = [from]
        while (work.length) {
            const id = work.pop()!
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
            for (let i = 0; i < countIds(n); i++) {
                const x = getRef(n, i)
                const at = x ? index.get(x) : undefined
                if (at === undefined || at < floor || reached.get(x) === stamp) continue
                reached.set(x, stamp)
                work.push(x)
            }
        }
    }
    for (const region of byRegion) {
        if (region.length < 2) continue
        const mem = getMem()
        const bases = new Map<number, OrderBase>()
        for (const [id, lifted] of region) {
            const n = getNode(g, id)!
            const store = n.op === NodeOp.store
            const m = mem.access(b, n)
            if (!m) continue
            const bytes = intrinsics.intrinsicBitWidth(typeOf(n)) / 8
            let base = bases.get(m.base)
            if (!base) bases.set(m.base, base = { stores: orderSlots(), loads: orderSlots() })
            const candidates: OrderEntry[] = []
            collectSlots(base.stores, m.pos, bytes, candidates)
            if (store) collectSlots(base.loads, m.pos, bytes, candidates)
            const conflicts: OrderEntry[] = []
            let floor = index.get(id)!
            for (const e of candidates) {
                if (lifted && e.lifted === lifted) continue
                if (mem.disjoint(b, n, b, getNode(g, e.id)!)) continue
                if (chained(id, e.proxy) || chained(id, e.id)) {
                    e.proxy = id
                    e.proxyIndex = index.get(id)!
                    continue
                }
                conflicts.push(e)
                if (e.proxyIndex < floor) floor = e.proxyIndex
            }
            if (conflicts.length) {
                search(id, floor)
                const missing: OrderEntry[] = []
                floor = index.get(id)!
                for (const e of conflicts) {
                    if (reached.get(e.proxy) === stamp || reached.get(e.id) === stamp) continue
                    missing.push(e)
                    if (e.index < floor) floor = e.index
                }
                if (missing.length) search(id, floor)
                for (const e of missing) {
                    if (reached.get(e.id) !== stamp) fail(stage, g, id, `(${opName(n.op)}) is not ordered after conflicting %${e.id} (${opName(getNode(g, e.id)!.op)}) on the same path in B${b.id}`)
                }
                for (const e of conflicts) {
                    e.proxy = id
                    e.proxyIndex = index.get(id)!
                }
            }
            if (store && !lifted) {
                pruneSlots(g, mem, b, base.stores, n, m.pos, bytes)
                pruneSlots(g, mem, b, base.loads, n, m.pos, bytes)
            }
            const at = index.get(id)!
            addSlot(store ? base.stores : base.loads, { id, index: at, lifted, proxy: id, proxyIndex: at }, m.pos, bytes)
        }
    }
}

export function verifyAllocationTokens(g: Graph, stage: string, tokens: Map<u32, { token?: number }> | undefined): void {
    if (!tokens?.size) return
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const token = tokens.get(getLiteral(g, n, 0) as u32)?.token
        if (token !== undefined && !getNode(g, token)) fail(stage, g, id, `allocates with token %${token}, which is not in the graph`)
    }
}

function keyHandle(key: number): boolean {
    return heap.isCell(key as intrinsics.Handle) && heap.describeKey(key as intrinsics.Handle) !== undefined
}

export function verifyKeys(g: Graph, stage: string): void {
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.getProp && n.op !== NodeOp.setProp) continue
        if (getRef(n, 2)) continue
        const key = getLiteral(g, n, 2)
        if (!keyHandle(key)) fail(stage, g, id, `(${opName(n.op)}) key slot holds literal ${key}, not a key handle`)
    }
}

function valueOf(g: Graph, id: number): number {
    let n = getNode(g, id)
    while (n?.op === NodeOp.after) {
        id = getRef(n, countIds(n) - 1)
        n = getNode(g, id)
    }
    return id
}

function wordOf(g: Graph, words: Set<number>, vmValues: boolean): (x: number) => string {
    return x => {
        const v = valueOf(g, x)
        const n = v ? getNode(g, v) : undefined
        if (!n) return ''
        if (n.op === NodeOp.encode || n.op === NodeOp.box) return `%${v} is ${opName(n.op)}`
        if (words.has(x) || words.has(v)) return `%${v} (${opName(n.op)}) is a word by resolve or plan`
        if (vmValues && resultType(g, n) === Types.vm_value) return `%${v} (${opName(n.op)}) is vm_value`
        return ''
    }
}

function rawStringHandle(g: Graph, n: GraphNode): boolean {
    return n.op === NodeOp.heapHandle && !getRef(n, 0) && heap.isString(getLiteral(g, n, 0) as intrinsics.Handle)
}

function rawOf(g: Graph, edges: Map<number, CallEdge>): (x: number) => string {
    return x => {
        const v = valueOf(g, x)
        const n = v ? getNode(g, v) : undefined
        if (!n) return ''
        if (n.op === NodeOp.decode) return `%${v} is decode`
        if (n.op === NodeOp.call && edges.get(v)?.raw) return `%${v} is a call to a raw-mode callee`
        if (rawStringHandle(g, n)) return `%${v} is a raw string handle`
        return ''
    }
}

export function verifyCodecs(g: Graph, stage: string, words: Set<number>, edges: Map<number, CallEdge>): void {
    const word = wordOf(g, words, false)
    const raw = rawOf(g, edges)
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.box && n.op !== NodeOp.encode && n.op !== NodeOp.decode) continue
        const x = getRef(n, 0)
        if (!x) continue
        const why = n.op === NodeOp.decode ? raw(x) : word(x)
        if (why) fail(stage, g, id, `(${opName(n.op)}) takes %${x}, which is already ${n.op === NodeOp.decode ? 'raw' : 'a word'}: ${why}`)
    }
}

export function verifyArrivals(g: Graph, stage: string, words: Set<number>, edges: Map<number, CallEdge>): void {
    const word = wordOf(g, words, true)
    const raw = rawOf(g, edges)
    for (const [call, edge] of edges) {
        const n = getNode(g, call)
        if (n?.op !== NodeOp.call) continue
        for (const [index, param] of edge.params) {
            const x = 3 + index < countIds(n) ? getRef(n, 3 + index) : 0
            if (!x) continue
            const why = param.pointer ? word(x) : param.word ? raw(x) : ''
            if (why) fail(stage, g, call, `passes %${x} into ${param.pointer ? 'raw pointer' : 'word'} param ${index}: ${why}`)
        }
    }
}

export function verifyNumericUses(g: Graph, stage: string, unions: Set<number>, ops: Set<NodeOp>, rets: number[], bits: Set<number>): void {
    function word(x: number): boolean {
        return unions.has(x) || unions.has(valueOf(g, x))
    }
    for (const [id, n] of nodeEntries(g)) {
        if (n.op === NodeOp.store && typeOf(n) !== intrinsics.Types.vm_value) {
            const x = getRef(n, 3)
            if (x && word(x)) fail(stage, g, id, `(store) writes %${x}, a union word by plan, into a raw slot`)
        }
        if (n.op === NodeOp.rt && rt.handleOps.has(getLiteral(g, n, 1))) {
            const x = getRef(n, 2)
            if (x && word(x)) fail(stage, g, id, `(rt ${rt.opName(getLiteral(g, n, 1))}) takes %${x}, a union word by plan, as a handle`)
        }
        if (!ops.has(n.op) || bits.has(id)) continue
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            if (x && word(x)) fail(stage, g, id, `(${opName(n.op)}) computes on %${x}, a union word by plan`)
        }
    }
    for (const id of rets) {
        const x = getRef(getNode(g, id)!, 0)
        if (x && word(x)) fail(stage, g, id, `(ret) returns %${x}, a union word by plan, from a unit whose ABI returns a number`)
    }
}

export function verifyNumberClasses(g: Graph, stage: string, floats: Set<number>, integral: (g: Graph, n: GraphNode) => number[], arith: Set<NodeOp> | undefined): void {
    function float(n: GraphNode, i: number): boolean {
        const x = getRef(n, i)
        return x ? floats.has(x) : !Number.isInteger(getLiteral(g, n, i))
    }
    for (const [id, n] of nodeEntries(g)) {
        for (const i of integral(g, n)) {
            if (float(n, i)) fail(stage, g, id, `(${opName(n.op)}) slot ${i} takes ${getRef(n, i) ? `%${getRef(n, i)} (${opName(getNode(g, getRef(n, i))!.op)})` : `literal ${getLiteral(g, n, i)}`}, an f64, where an integer is required`)
        }
        if (rt.floatArith.has(n.op) && floats.has(id)) fail(stage, g, id, `(${opName(n.op)}) is f64, which only rt.${rt.opName(rt.floatArith.get(n.op)!)} computes`)
        if (!arith?.has(n.op) || !floats.has(id)) continue
        let some = false
        for (let i = 0; i < countIds(n); i++) some ||= float(n, i)
        if (!some) fail(stage, g, id, `(${opName(n.op)}) is f64 but none of its operands is, so it lowers as integer code into a float register`)
    }
}

export function verifySlotBounds(g: Graph, stage: string, size: (g: Graph, n: GraphNode) => number): void {
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.load && n.op !== NodeOp.store) continue
        const base = getRef(n, 1)
        if (!base || getRef(n, 2)) continue
        const bytes = size(g, getNode(g, base)!)
        if (!bytes) continue
        const end = getLiteral(g, n, 2) + (intrinsics.intrinsicBitWidth(typeOf(n)) >> 3)
        if (end > bytes) fail(stage, g, id, `(${opName(n.op)}) reaches byte ${end} of %${base} (${opName(getNode(g, base)!.op)}), which holds ${bytes}`)
    }
}

export function verifyCallClasses(stage: string, units: Map<number, Graph>, floatsOf: (symbol: number) => Set<number>, callee: (g: Graph, n: GraphNode) => number | undefined, explain?: (symbol: number, x: number) => string, explainParam?: (symbol: number, param: number) => string): void {
    for (const [symbol, g] of units) {
        for (const [id, n] of nodeEntries(g)) {
            if (n.op !== NodeOp.call) continue
            const target = callee(g, n)
            const unit = target === undefined ? undefined : units.get(target)
            if (!unit) continue
            const params = unit.blocks[0].params
            const theirs = floatsOf(target!)
            for (let i = 0; i < params.length && 3 + i < countIds(n); i++) {
                const x = getRef(n, 3 + i)
                if (!x || getNode(g, x)!.op === NodeOp.uninitialized) continue
                const mine = floatsOf(symbol).has(x)
                if (mine === theirs.has(params[i])) continue
                const derivation = explain ? `\n  argument %${x} in ${g.name || '<anonymous>'}:\n${explain(symbol, x)}\n  param ${i} (%${params[i]}) of ${unit.name || `symbol ${target}`}: ${explainParam?.(target!, params[i]) ?? ''}\n${explain(target!, params[i])}` : ''
                fail(stage, g, id, `(call) passes %${x} (${opName(getNode(g, x)!.op)}), ${mine ? 'an f64' : 'an integer'}, as param ${i} of ${unit.name || `symbol ${target}`}, which takes ${mine ? 'an integer' : 'an f64'}${derivation}`)
            }
        }
    }
}

export function verifyReturns(g: Graph, stage: string, words: Set<number>, edges: Map<number, CallEdge>, rets: number[], returns: 'word' | 'raw' | undefined): void {
    if (!returns) return
    const word = wordOf(g, words, false)
    const raw = rawOf(g, edges)
    for (const id of rets) {
        const x = getRef(getNode(g, id)!, 0)
        if (!x) continue
        const why = returns === 'word' ? raw(x) : word(x)
        if (why) fail(stage, g, id, `(ret) returns %${x} from a unit whose ABI returns ${returns === 'word' ? 'a word' : 'raw'}: ${why}`)
    }
}

export function verifyStringCompares(g: Graph, stage: string, words: Set<number>, stringy: (x: number) => boolean): void {
    const word = wordOf(g, words, false)
    for (const [id, n] of nodeEntries(g)) {
        if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) continue
        for (let at = 0; at < 2; at++) {
            const x = getRef(n, at)
            const other = getRef(n, 1 - at)
            if (!x || !other) continue
            const v = valueOf(g, x)
            const m = getNode(g, v)
            if (!m || (!rawStringHandle(g, m) && !stringy(v))) continue
            const why = word(other)
            if (why) fail(stage, g, id, `(${opName(n.op)}) compares raw string %${v} with a union word: ${why}`)
        }
    }
}

export function verifyStringOperands(g: Graph, stage: string, stringy: (x: number) => string): void {
    for (const id of g.blocks.flatMap(b => blockOrder(g, b))) {
        const n = getNode(g, id)!
        let at = -1
        if (n.op === NodeOp.decode) at = 0
        else if (n.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.typeof) at = 2
        if (at < 0 || !getRef(n, at)) continue
        const why = stringy(getRef(n, at))
        if (why) fail(stage, g, id, `(${n.op === NodeOp.rt ? 'rt typeof' : opName(n.op)}) takes %${getRef(n, at)}, which may be a string: ${why}`)
    }
}

export const indexCheck = intrinsics.argv().includes('index-check')
const indexCheckDetail = intrinsics.argv().includes('index-check-detail')
const primedIndexes = new Map<Graph, GraphIndex>()
const indexBuildSites = new WeakMap<GraphIndex, string>()
const reportedIndexDiffs = new WeakMap<GraphIndex, Set<string>>()
const reportedLiveIndexes = new WeakSet<GraphIndex>()


const IsolatedOps = new Set<NodeOp>([...RecomputableOps, NodeOp.type, NodeOp.recordType, NodeOp.fnType, NodeOp.rawbuffer, NodeOp.block])
const reportedCaptures = new Set<string>()

function checkIsolation(g: Graph, ix: GraphIndex, where: string): void {
    if (!refreshable(g)) return
    for (const id of ix.shared) {
        const n = getNode(g, id)!
        if (IsolatedOps.has(n.op)) continue
        const key = `${g.name ?? '?'}:${id}`
        if (reportedCaptures.has(key)) continue
        reportedCaptures.add(key)
        console.log(`index-check capture ${where} ${g.name ?? '?'} %${id} ${opName(n.op)} held by B${ix.visited.get(id)}`)
        return
    }
}

function indexDiff(g: Graph, ix: GraphIndex, where: string): Map<number, Set<string>> {
    const fresh = buildIndex(g)
    checkIsolation(g, fresh, where)
    const kinds = new Map<number, Set<string>>()
    function mark(block: number, kind: string): void {
        let set = kinds.get(block)
        if (!set) kinds.set(block, set = new Set())
        set.add(kind)
    }
    function compare(block: number, kind: string, expected: Iterable<number> | undefined, actual: Iterable<number> | undefined): void {
        const want = new Set(expected ?? [])
        const have = new Set(actual ?? [])
        for (const v of want) {
            if (have.has(v)) continue
            mark(block, `${kind}-`)
            if (indexCheckDetail) console.log(`index-check detail B${block} ${kind}- ${v}`)
            break
        }
        for (const v of have) {
            if (want.has(v)) continue
            mark(block, `${kind}+`)
            if (indexCheckDetail) console.log(`index-check detail B${block} ${kind}+ ${v}`)
            break
        }
    }
    const freshBlocks: number[] = []
    for (const b of fresh.reachableBlocks) freshBlocks.push(b.id)
    const indexedBlocks: number[] = []
    for (const b of ix.reachableBlocks) indexedBlocks.push(b.id)
    compare(0, 'reach', freshBlocks, indexedBlocks)
    for (const block of freshBlocks) {
        compare(block, 'succ', fresh.successors.get(block), ix.successors.get(block))
        compare(block, 'preds', fresh.preds.get(block), ix.preds.get(block))
        const ops = fresh.byOp.get(block)
        const indexedOps = ix.byOp.get(block)
        const opKeys = new Set<NodeOp>([...ops?.keys() ?? [], ...indexedOps?.keys() ?? []])
        for (const op of opKeys) compare(block, 'byOp', ops?.get(op), indexedOps?.get(op))
        for (const ids of ops?.values() ?? []) {
            for (const id of ids) {
                compare(block, 'deps', fresh.dependents.get(id), ix.dependents.get(id))
            }
        }
    }
    for (const block of ix.stale) mark(block, 'marked')
    return kinds
}

function formatIndexDiff(diff: Map<number, Set<string>>): string {
    const out: string[] = []
    for (const block of [...diff.keys()].sort((a, b) => a - b)) out.push(`B${block}[${[...diff.get(block)!].join(',')}]`)
    return out.join(' ')
}

function verifyReusedIndex(g: Graph, ix: GraphIndex): void {
    const diff = indexDiff(g, ix, 'reuse')
    if (diff.size) console.log(`index-check stale-read ${g.name ?? '?'} ${new Error().stack?.split('\n').slice(3, 14).map(line => line.trim()).join(' < ') ?? ''} built ${indexBuildSites.get(ix) ?? '?'}: ${formatIndexDiff(diff)}`)
}

export function verifyLiveIndex(g: Graph, where: string): void {
    const ix = g.index
    if (!ix || ix.stale.size || reportedLiveIndexes.has(ix)) return
    const diff = indexDiff(g, ix, where)
    if (!diff.size) return
    reportedLiveIndexes.add(ix)
    console.log(`index-check stale-cache ${where} ${g.name ?? '?'} built ${indexBuildSites.get(ix) ?? '?'}: ${formatIndexDiff(diff)}`)
}

function recordIndexBuild(g: Graph, ix: GraphIndex): void {
    indexBuildSites.set(ix, new Error().stack?.split('\n').slice(3, 15).map(line => line.trim()).join(' < ') ?? '')
}

function rewrotePrimed(g: Graph, ids: Iterable<number>): void {
    const primed = primedIndexes.get(g)
    if (!primed) return
    const wanted = new Set(ids)
    for (const [block, ops] of primed.byOp) {
        for (const list of ops.values()) {
            if (list.some(id => wanted.has(id))) primed.stale.add(block)
        }
    }
}

function dropPrimedIndex(g: Graph): void {
    primedIndexes.delete(g)
}

function stalePrimedBlock(g: Graph, block: number): void {
    primedIndexes.get(g)?.stale.add(block)
}

export function primeIndexCheck(g: Graph, where: string): void {
    const ix = buildIndex(g)
    checkIsolation(g, ix, where)
    primedIndexes.set(g, ix)
}

export function verifyIndex(g: Graph, where: string): void {
    const primed = primedIndexes.get(g)
    if (!primed) return
    primedIndexes.delete(g)
    if (primed.stale.size) refreshStale(g, primed)
    const diff = indexDiff(g, primed, where)
    if (diff.size) console.log(`index-check ${where} ${g.name ?? '?'} miss: ${formatIndexDiff(diff)}`)
}

export function verifyMaintainedIndex(g: Graph, ix: GraphIndex, where: string): void {
    const diff = indexDiff(g, ix, `optimize:${where}`)
    const reported = reportedIndexDiffs.get(ix) ?? new Set<string>()
    const current = new Set<string>()
    const added = new Map<number, Set<string>>()
    for (const [block, kinds] of diff) {
        for (const kind of kinds) {
            if (kind === 'marked') continue
            current.add(`${block}:${kind}`)
            if (reported.has(`${block}:${kind}`)) continue
            let set = added.get(block)
            if (!set) added.set(block, set = new Set())
            set.add(kind)
        }
    }
    reportedIndexDiffs.set(ix, current)
    if (added.size) console.log(`index-check optimize:${where} ${g.name ?? '?'} maintained: ${formatIndexDiff(added)}`)
}

const reportedKinds = new WeakMap<Graph, number>()

export function verifyKinds(g: Graph, where: string): void {
    const reported = reportedKinds.get(g) ?? 0
    let missing = 0
    const found: string[] = []
    for (const [id, n] of nodeEntries(g)) {
        const kind = kindOf(n.op) & ~g.kinds & ~reported & ~missing
        if (!kind) continue
        missing |= kind
        found.push(`${Object.keys(GraphKinds).find(k => (GraphKinds as any)[k] === kind)} %${id} ${opName(n.op)}`)
    }
    if (!missing) return
    reportedKinds.set(g, reported | missing)
    console.log(`index-check kinds ${where} ${g.name ?? '?'} unmarked: ${found.join(', ')}`)
}

if (indexCheck) watchIndex({ reused: verifyReusedIndex, built: recordIndexBuild, dropped: dropPrimedIndex, staled: stalePrimedBlock, rewrote: rewrotePrimed })
