"use wrapped";

import ts from 'typescript' // XXX: used for `api.zig`
import * as heap from './heap'
import * as intrinsics from './intrinsics'
import * as bytecode from './bytecode-emitter'
import { Op, createInterpreter } from './vm'
import * as lowering from './lowering'

// bound eagerly so the module evaluates (and runs its self-test) at load time
const lowerResidual = lowering.lowerResidual

const Types = intrinsics.Types
const Intrinsics = intrinsics.Intrinsics
const inRange = intrinsics.inRange
const assert = intrinsics.assert

type usize = u32
type Handle = heap.Handle

const TerminalOpcodes = new Set<number>([Op.Return, Op.Throw, Op.ReThrow])

const CallOpcodes = new Set<number>([
    Op.Call, Op.CallConst, Op.CallConstFrom, Op.Construct, Op.ConstructConst,
])

type BlockKind = 'linear' | 'jump' | 'branch' | 'exit'

interface CfgBlock {
    index: number
    start: number   
    end: number     // pc of the terminating instruction
    kind: BlockKind
    succs: number[]
    preds: number[]
    idom: number
    ipdom: number   // immediate post-dominator
    loop: number    // innermost enclosing loop header, -1 if none

    liveIn: Set<number>
    unknownIn: Set<number>
    unknownOut: Set<number>
    hasUnknown: boolean
    unknownBranch: boolean
}

interface Cfg {
    blocks: CfgBlock[]
    blockAt: Map<number, number>      // leader pc -> block index
    loops: Map<number, Set<number>>   // header block -> body blocks
    paramCount: number
    anyUnknown: boolean
    // merge block -> the registers that need a block parameter there
    mergeParams: Map<number, Set<number>>
    // merges with a call somewhere in the region they close. The call token
    // merges there like any other value, and it has no register to live in
    mergeCalls: Set<number>
}

function computeIdoms(n: number, entry: number, preds: number[][], succs: number[][]): number[] {
    const postorder: number[] = []
    const seen = new Set<number>()
    const stackNode: number[] = [entry]
    const stackNext: number[] = [0]
    seen.add(entry)
    while (stackNode.length) {
        const depth = stackNode.length - 1
        const b = stackNode[depth]
        const i = stackNext[depth]
        if (i < succs[b].length) {
            stackNext[depth] = i + 1
            const s = succs[b][i]
            if (!seen.has(s)) {
                seen.add(s)
                stackNode.push(s)
                stackNext.push(0)
            }
            continue
        }
        stackNode.pop()
        stackNext.pop()
        postorder.push(b)
    }

    const rpoNum: number[] = []
    for (let i = 0; i < n; i++) rpoNum.push(-1)
    const rpo: number[] = []
    for (let i = postorder.length - 1; i >= 0; i--) {
        rpoNum[postorder[i]] = rpo.length
        rpo.push(postorder[i])
    }

    const idom: number[] = []
    for (let i = 0; i < n; i++) idom.push(-1)
    idom[entry] = entry

    function intersect(a: number, b: number): number {
        while (a !== b) {
            while (rpoNum[a] > rpoNum[b]) a = idom[a]
            while (rpoNum[b] > rpoNum[a]) b = idom[b]
        }
        return a
    }

    let changed = true
    while (changed) {
        changed = false
        for (let i = 1; i < rpo.length; i++) {
            const b = rpo[i]
            let newIdom = -1
            for (const p of preds[b]) {
                if (rpoNum[p] === -1 || idom[p] === -1) continue
                newIdom = newIdom === -1 ? p : intersect(p, newIdom)
            }
            if (newIdom !== -1 && idom[b] !== newIdom) {
                idom[b] = newIdom
                changed = true
            }
        }
    }
    return idom
}

function buildCfg(code: readonly u8[], paramCount: number): Cfg {
    const insts: bytecode.CodeInstruction[] = []
    {
        const it = bytecode.createCodeIterator(code)
        while (const inst = it.next()) insts.push(inst)
    }
    const codeLen = code.length

    function endOf(i: number): number {
        return i + 1 < insts.length ? insts[i + 1].pos : codeLen
    }

    const leaderSet = new Set<number>()
    leaderSet.add(0)
    for (let i = 0; i < insts.length; i++) {
        const inst = insts[i]
        if (TerminalOpcodes.has(inst.opcode)) {
            leaderSet.add(endOf(i))
            continue
        }
        if (inst.jumpTarget !== undefined) {
            leaderSet.add(inst.jumpTarget)
            leaderSet.add(endOf(i))
            continue
        }
        if (inst.opcode === Op.JumpAcc || inst.opcode === Op.JumpLabel) {
            throw `trace2: indirect jump at ${inst.pos} is not supported yet`
        }
    }

    const leaders: number[] = []
    for (const l of leaderSet) {
        if (l < codeLen) leaders.push(l)
    }
    leaders.sort((a, b) => a - b)

    const blockAt = new Map<number, number>()
    for (let i = 0; i < leaders.length; i++) blockAt.set(leaders[i], i)

    const blocks: CfgBlock[] = []
    for (let i = 0; i < leaders.length; i++) {
        blocks.push({
            index: i,
            start: leaders[i],
            end: leaders[i],
            kind: 'linear',
            succs: [],
            preds: [],
            idom: -1,
            ipdom: -1,
            loop: -1,
            liveIn: new Set<number>(),
            unknownIn: new Set<number>(),
            unknownOut: new Set<number>(),
            hasUnknown: false,
            unknownBranch: false,
        })
    }

    const blockInsts: bytecode.CodeInstruction[][] = []
    for (let i = 0; i < blocks.length; i++) blockInsts.push([])
    const posToIdx = new Map<number, number>()
    {
        let bi = 0
        for (let i = 0; i < insts.length; i++) {
            posToIdx.set(insts[i].pos, i)
            while (bi + 1 < blocks.length && insts[i].pos >= blocks[bi + 1].start) bi++
            blockInsts[bi].push(insts[i])
        }
    }

    for (let bi = 0; bi < blocks.length; bi++) {
        const b = blocks[bi]
        const own = blockInsts[bi]
        if (own.length === 0) throw `trace2: empty block at ${b.start}`
        const last = own[own.length - 1]
        const lastIdx = posToIdx.get(last.pos)!
        b.end = last.pos

        if (TerminalOpcodes.has(last.opcode)) {
            b.kind = 'exit'
            continue
        }
        if (last.jumpTarget !== undefined) {
            if (bytecode.ConditionalJumpOps.has(last.opcode)) {
                b.kind = 'branch'
                b.succs.push(blockAt.get(endOf(lastIdx))!)
                b.succs.push(blockAt.get(last.jumpTarget)!)
            } else {
                b.kind = 'jump'
                b.succs.push(blockAt.get(last.jumpTarget)!)
            }
            continue
        }
        const fall = endOf(lastIdx)
        if (fall < codeLen) b.succs.push(blockAt.get(fall)!)
    }

    for (const b of blocks) {
        for (const s of b.succs) blocks[s].preds.push(b.index)
    }

    const n = blocks.length
    const succs: number[][] = []
    const preds: number[][] = []
    for (const b of blocks) {
        succs.push(b.succs)
        preds.push(b.preds)
    }

    const idom = computeIdoms(n, 0, preds, succs)
    for (let i = 0; i < n; i++) blocks[i].idom = idom[i]

    function dominates(a: number, b: number): boolean {
        let cur = b
        for (;;) {
            if (cur === a) return true
            if (cur === 0 || cur === -1) return false
            cur = blocks[cur].idom
        }
    }

    {
        const rsuccs: number[][] = []
        const rpreds: number[][] = []
        for (let i = 0; i < n; i++) {
            rsuccs.push(preds[i].slice())
            rpreds.push(succs[i].slice())
        }
        const exitNodes: number[] = []
        for (let i = 0; i < n; i++) {
            if (succs[i].length === 0) {
                exitNodes.push(i)
                rpreds[i].push(n)
            }
        }
        rsuccs.push(exitNodes)
        rpreds.push([])
        const ipdom = computeIdoms(n + 1, n, rpreds, rsuccs)
        for (let i = 0; i < n; i++) blocks[i].ipdom = ipdom[i] === n ? -1 : ipdom[i]
    }

    const loops = new Map<number, Set<number>>()
    for (let u = 0; u < n; u++) {
        for (const v of blocks[u].succs) {
            if (!dominates(v, u)) continue
            let body = loops.get(v)
            if (!body) loops.set(v, body = new Set<number>())
            body.add(v)
            const stack = [u]
            while (stack.length) {
                const x = stack.pop()!
                if (body.has(x)) continue
                body.add(x)
                for (const p of blocks[x].preds) stack.push(p)
            }
        }
    }

    for (const entry of loops) {
        const header = entry[0]
        const body = entry[1]
        for (const b of body) {
            const cur = blocks[b].loop
            if (cur === -1 || body.size < loops.get(cur)!.size) blocks[b].loop = header
        }
    }

    const mergeParams = new Map<number, Set<number>>()
    const mergeCalls = new Set<number>()
    const anyUnknown = propagateUnknowns(blocks, blockInsts, loops, paramCount, mergeParams, mergeCalls)

    return { blocks, blockAt, loops, paramCount, anyUnknown, mergeParams, mergeCalls }
}

function setEquals(a: Set<number>, b: Set<number>): boolean {
    if (a.size !== b.size) return false
    for (const x of a) {
        if (!b.has(x)) return false
    }
    return true
}

function propagateUnknowns(
    blocks: CfgBlock[],
    blockInsts: bytecode.CodeInstruction[][],
    loops: Map<number, Set<number>>,
    paramCount: number,
    mergeParams: Map<number, Set<number>>,
    mergeCalls: Set<number>,
): boolean {
    const n = blocks.length

    const seeds: Set<number>[] = []
    for (let i = 0; i < n; i++) seeds.push(new Set<number>())

    function transfer(bi: number): boolean {
        const b = blocks[bi]
        const live = new Set<number>(b.unknownIn)
        let hasUnknown = false
        let unknownBranch = false

        const own = blockInsts[bi]
        for (let i = 0; i < own.length; i++) {
            const inst = own[i]
            const reads = bytecode.getRegReads(inst)
            let tainted = false
            for (const r of reads) {
                if (live.has(r)) { tainted = true; break }
            }
            if (tainted) {
                hasUnknown = true
                if (i === own.length - 1 && b.kind === 'branch') unknownBranch = true
            }
            for (const w of bytecode.getRegWrites(inst)) {
                if (tainted) live.add(w)
                else live.delete(w)
            }
        }

        b.hasUnknown = hasUnknown
        b.unknownBranch = unknownBranch
        if (setEquals(live, b.unknownOut)) return false
        b.unknownOut = live
        return true
    }

    function dataFixpoint(): void {
        let changed = true
        while (changed) {
            changed = false
            for (let bi = 0; bi < n; bi++) {
                const b = blocks[bi]
                const merged = new Set<number>(seeds[bi])
                if (bi === 0) {
                    for (let i = 0; i < paramCount; i++) merged.add(i)
                }
                for (const p of b.preds) {
                    for (const r of blocks[p].unknownOut) merged.add(r)
                }
                if (!setEquals(merged, b.unknownIn)) {
                    b.unknownIn = merged
                    changed = true
                }
                if (transfer(bi)) changed = true
            }
        }
    }

    // The blocks an unknown branch decides between, and where they rejoin. For
    // a loop-exit branch that is the whole body rejoining at the header;
    // otherwise the arms rejoining at the post-dominator.
    function regionOf(b: CfgBlock): [merge: number, region: number[]] {
        if (b.loop !== -1 && b.succs.length === 2) {
            const body = loops.get(b.loop)!
            if (body.has(b.succs[0]) !== body.has(b.succs[1])) return [b.loop, [...body]]
        }
        const merge = b.ipdom
        if (merge === -1) return [-1, []]
        const seen = new Set<number>()
        const stack = b.succs.slice()
        while (stack.length) {
            const x = stack.pop()!
            if (x === merge || seen.has(x)) continue
            seen.add(x)
            for (const s of blocks[x].succs) stack.push(s)
        }
        return [merge, [...seen]]
    }

    function writesIn(region: number[]): Set<number> {
        const w = new Set<number>()
        for (const x of region) {
            for (const inst of blockInsts[x]) {
                if (bytecode.isAlwaysLiteral(inst)) continue
                for (const r of bytecode.getRegWrites(inst)) w.add(r)
            }
        }
        return w
    }

    function addControlSeeds(): boolean {
        let added = false
        for (const b of blocks) {
            if (!b.unknownBranch) continue
            const [merge, region] = regionOf(b)
            if (merge === -1) continue
            const seed = seeds[merge]
            const prev = seed.size
            for (const w of writesIn(region)) {
                seed.add(w)
            }
            added ||= seed.size - prev > 0
        }
        return added
    }

    // Backward liveness. The unknown sets are a "may" analysis and control
    // dependence makes them very coarse: a register written anywhere under an
    // unknown branch is assumed to differ by path at the rejoin. Often it does
    // not -- a clobber with a constant, or with anything the region computes
    // the same way on every path, leaves it known -- but the analysis cannot
    // tell, so it over-approximates. That is sound, and costs at most a
    // parameter whose incoming value turns out identical on every edge.
    //
    // Intersecting with live-in removes the part that is not merely imprecise
    // but meaningless: the interior temporaries of a concrete inner loop. A
    // register the block cannot read yet is not a value arriving at the block
    // at all, whatever the analysis says about it.
    function liveness(): void {
        let changed = true
        while (changed) {
            changed = false
            for (let bi = n - 1; bi >= 0; bi--) {
                const b = blocks[bi]
                const out = new Set<number>()
                for (const s of b.succs) {
                    for (const r of blocks[s].liveIn) out.add(r)
                }
                const own = blockInsts[bi]
                for (let i = own.length - 1; i >= 0; i--) {
                    for (const w of bytecode.getRegWrites(own[i])) out.delete(w)
                    for (const r of bytecode.getRegReads(own[i])) out.add(r)
                }
                if (setEquals(out, b.liveIn)) continue
                b.liveIn = out
                changed = true
            }
        }
    }

    for (let round = 0; round <= n + 1; round++) {
        dataFixpoint()
        if (!addControlSeeds()) break
    }

    liveness()
    for (const b of blocks) {
        for (const r of b.unknownIn) {
            if (!b.liveIn.has(r)) b.unknownIn.delete(r)
        }
    }

    // A register needs a parameter at a merge when it can hold an unknown
    // there, is still live, and the arms could have given it different values.
    // Anything the region never writes arrives identical on every edge and is
    // simply the value itself.
    for (const b of blocks) {
        if (!b.unknownBranch) continue
        const [merge, region] = regionOf(b)
        if (merge === -1) continue
        const writes = writesIn(region)
        outer: for (const x of region) {
            for (const inst of blockInsts[x]) {
                if (CallOpcodes.has(inst.opcode)) {
                    mergeCalls.add(merge)
                    break outer
                }
            }
        }
        let need = mergeParams.get(merge)
        if (!need) mergeParams.set(merge, need = new Set<number>())
        for (const r of blocks[merge].unknownIn) {
            if (r >= 0 && writes.has(r)) need.add(r)
        }
    }

    for (const b of blocks) {
        if (b.hasUnknown) return true
    }
    return false
}

function printCfg(cfg: Cfg): string {
    function regs(s: Set<number>): string {
        const parts: string[] = []
        for (const r of s) {
            parts.push(r === -1 ? 'acc' : r < cfg.paramCount ? `p${r}` : `r${r - cfg.paramCount}`)
        }
        parts.sort()
        return parts.join(',')
    }
    const lines: string[] = []
    lines.push(cfg.anyUnknown ? 'function may see unknowns' : 'function is fully concrete')
    for (const b of cfg.blocks) {
        let line = `B${b.index} [${b.start}..${b.end}] ${b.kind}`
        if (b.succs.length) line = line + ` -> ${b.succs.map(s => 'B' + s).join(', ')}`
        if (b.kind === 'branch' && b.ipdom !== -1) line = line + `  (rejoins at B${b.ipdom})`
        if (cfg.loops.has(b.index)) {
            const body = [...cfg.loops.get(b.index)!].map(x => 'B' + x).join(',')
            line = line + `  [loop header, body {${body}}]`
        }
        line = line + (b.hasUnknown ? '  unknown' : '  concrete')
        if (b.unknownBranch) line = line + '/branch'
        if (b.unknownIn.size) line = line + ` in{${regs(b.unknownIn)}}`
        if (b.unknownOut.size) line = line + ` out{${regs(b.unknownOut)}}`
        lines.push(line)
    }
    return lines.join('\n')
}

// The value graph closes on itself because the identity is stable, so nothing
// has to be written down in the trace stream to express the merge.
interface BlockParam {
    label: number
    value: number                    // tagged nan: the stable identity
    block: number                    // rejoin point that owns it
    slot: number
    incoming: Map<TraceEdge, number>
}

// A branch whose predicate was unknown. The predicate is already an ordinary
// traced value (`lt`, `ne`, ...) whose operands bottom out in the same symbols
// everything else uses
//
// It is recorded per incoming edge, because the predicate usually lives in the
// accumulator, which is edge-carried and has no memory slot to publish. For a
// rotated loop the entry edge computes `i < n` from the initial i while the
// back edge computes it from the incremented one. Multiple conditions can 
// exist for a single branch, so they are stored as block params.
// An edge is not a place, it is the bundle of values that arrive at a node
// together. It needs no name: the branch owns its two, the residual owns the
// entry one, and identity is the object itself. Blocks that fold away never
// get mentioned, because nothing ever names them.
interface TraceEdge {
    label: number
    target: number   // node this bundle arrives at, -1 if it returns
}

interface SymbolicBranch {
    block: number
    condByEdge: Map<TraceEdge, number>
    thenEdge: TraceEdge
    elseEdge: TraceEdge
    exitEdge: TraceEdge | undefined   // the arm that leaves the loop, if any
}

type RegionKind = 'loop' | 'forward'

interface Region {
    kind: RegionKind
    merge: number      // block idx where control rejoins
    changed: boolean   
    entries: number
}

const maxLoopIterations = 64
const maxRuns = 16

function trace(code: string, opts: { verbose?: boolean, showCfg?: boolean } = {}) {
    const compiled = bytecode.compile(code)
    const cfg = buildCfg(compiled.code as u8[], compiled.paramCount)
    const regCount = compiled.paramCount + compiled.registerCount

    // The register file lives in shadow memory, but `unknownIn` is indexed by
    // bytecode register. This is the only place the two meet: the frame layout
    // stays here and register numbers never reach the memory hooks.
    let regsBase = 0
    function slotForReg(r: number): number {
        return regsBase - r * 4
    }

    if (opts.verbose) {
        console.log(bytecode.disassemble(compiled.code as any, compiled.paramCount, compiled.registerCount))
    }
    if (opts.verbose || opts.showCfg) {
        console.log(printCfg(cfg))
    }
    function makeSetFilter(numbers: number[]) {
        const bits = new Uint32Array((numbers[numbers.length - 1] >>> 5) + 1)

        for (let i = 0; i < numbers.length; i++) {
            const x = numbers[i]
            bits[x >>> 5] |= 1 << (x & 31)
        }

        return (x: number) =>
            (bits[x >>> 5] & (1 << (x & 31))) !== 0
    }

    const isBlock = makeSetFilter([...cfg.blockAt.keys()])

    const finalized = bytecode.finalize(compiled)
    const interpret = createInterpreter(true, true, true)

    const mem = new Float64Array(intrinsics.heapMaxAddress * 2)
    // The call token: not a value the program can name, so it has no address.
    // It merges like everything else, which is the whole point, so it borrows
    // the slot machinery through a name that is not an address
    const tokenSlot = -1
    let callToken: number = 0
    function readSlot(s: number): any {
        return s === tokenSlot ? callToken : mem[s]
    }
    function writeSlot(s: number, v: any): void {
        if (s === tokenSlot) callToken = v
        else mem[s] = v as f64
    }
    let lowSp = mem.length

    const load = Intrinsics.load
    const store = Intrinsics.store
    const stackalloc = Intrinsics.stackalloc
    const sp = Intrinsics.sp

    const blockParamByNan = new Map<number, BlockParam>()
    const paramByNan = new Map<number, string>()
    const published = new Map<number, Map<number, BlockParam>>()
    const symbolicBranches = new Map<number, SymbolicBranch>()
    // block -> the register slots an equality narrowed on the way here, and
    // what they held before. Applied on arrival, because that is where the two
    // arms rejoin and the value differs by path again
    // the id, not the double: a tagged nan does not survive a round trip
    // through an ordinary array, the same reason `paramIds` keeps ids
    const pendingRestores = new Map<number, [slot: number, id: number, constant: number][]>()
    let valueCounter = 0

    function publish(block: number, slot: number): void {
        let bySlot = published.get(block)
        if (!bySlot) published.set(block, bySlot = new Map<number, BlockParam>())
        if (bySlot.has(slot)) return
        const value = tracer.createUniqueNan()
        const bp: BlockParam = {
            label: valueCounter++,
            value,
            block,
            slot,
            incoming: new Map<TraceEdge, number>(),
        }
        bySlot.set(slot, bp)
        blockParamByNan.set(tracer.getNanId(value), bp)
    }

    function sameValue(a: number, b: number): boolean {
        if (a === b) return true
        const ia = tracer.getNanId(a)
        const ib = tracer.getNanId(b)
        if (ia && ib) return ia === ib
        return false
    }

    const regions: Region[] = []
    const regionAtMerge = new Map<number, Region>()
    const symbolicHeaders = new Set<number>()

    function openRegion(kind: RegionKind, merge: number): Region {
        const r: Region = { kind, merge, changed: true, entries: 0 }
        regions.push(r)
        regionAtMerge.set(merge, r)
        return r
    }

    function closeRegion(r: Region): void {
        const i = regions.indexOf(r)
        if (i >= 0) regions.splice(i, 1)
        if (regionAtMerge.get(r.merge) === r) regionAtMerge.delete(r.merge)
    }

    let curBlock = -1
    let edgeLabels = 0
    function newEdge(): TraceEdge {
        const e = { label: edgeLabels++, target: -1 }
        return e
    }
    const entryEdge = newEdge()
    let curEdge = entryEdge
    let inEdge = entryEdge   // the bundle we arrived at the current node on
    const retNodes = new Set<number>()
    const nodeOut = new Map<number, TraceEdge>()   // out-edge of a node with no branch
    const edgeCalls = new Map<TraceEdge, number[]>()   // in order, first seen wins
    function isNode(b: number): boolean {
        return published.has(b) || symbolicBranches.has(b) || retNodes.has(b)
    }
    let lastReportedPc = -1
    const exitIds: number[] = []    // value id, or 0 when the return folded
    const exitConsts: number[] = [] // the folded value, when it did
    const exitBlocks: number[] = [] // which block returned
    // the last call on the way out. A call is kept because something uses its
    // value, and the tail has no user -- so the exit is its user. Rooting it
    // holds the whole chain up, and lets a region that turns out unreachable
    // take its calls down with it
    const exitTokens: number[] = []

    function onEnterBlock(b: number): void {
        const pred = curEdge
        curBlock = b
        if (const rs = pendingRestores.get(b)) {
            for (const r of rs) mem[r[0]] = (r[1] ? intrinsics.getNanFromId(r[1]) : r[2]) as f64
            rs.length = 0
        }
        if (isNode(b) || symbolicHeaders.has(b)) {
            curEdge.target = b
            inEdge = curEdge
            // leave along this node's own out-edge; a branch replaces it
            let out = nodeOut.get(b)
            if (!out) nodeOut.set(b, out = newEdge())
            curEdge = out   // a branch replaces this with one of its own
        }

        if (!regionAtMerge.has(b) && symbolicHeaders.has(b)) openRegion('loop', b)

        const region = regionAtMerge.get(b)
        if (!region) return

        region.entries++
        if (region.entries > maxLoopIterations) {
            throw `trace2: region at B${b} did not converge after ${maxLoopIterations} entries`
        }
        region.changed = false

        const bySlot = published.get(b)
        if (bySlot) {
            for (const entry of bySlot) {
                const slot = entry[0]
                const bp = entry[1]
                const arriving = readSlot(slot)
                const prev = bp.incoming.get(pred)
                if (prev === undefined || !sameValue(prev, arriving)) {
                    bp.incoming.set(pred, arriving)
                    region.changed = true
                }
                writeSlot(slot, bp.value as any)
            }
        }

        if (region.kind === 'forward') {
            // the enclosing loop must keep going until this rejoin settles too
            if (region.changed) {
                for (const r of regions) {
                    if (r.kind === 'loop') r.changed = true
                }
            }
            closeRegion(region)
        }
    }

    let decisions: number[] = []
    let decisionIdx = 0
    function decideForward(v1: number, v2: number): number {
        if (decisionIdx < decisions.length) {
            const d = decisions[decisionIdx]
            decisionIdx++
            return d ? v1 : v2
        }
        decisions.push(0)
        decisionIdx++
        return v2
    }
    const armVisits = new Map<number, number>()

    function enclosingLoop(): Region | undefined {
        for (const r of regions) {
            if (r.kind === 'loop') return r
        }
        return undefined
    }

    // A loop may not exit while a branch inside it still has an arm we have
    // never travelled: an early `return` out of the body is such an arm, and
    // the only chance to record it is from inside. The header's own exit arm is
    // the exception -- it leaves by definition, so it cannot be covered while
    // we are still going around.
    // `asking` excludes the branch putting the question, which is about to
    // travel one of its own arms and would otherwise be waiting on itself.
    function armsCovered(header: number, asking: number): boolean {
        const body = cfg.loops.get(header)
        if (!body) return true
        for (const b of body) {
            if (b === asking) continue
            const sb = symbolicBranches.get(b)
            if (!sb) continue
            for (const e of [sb.thenEdge, sb.elseEdge]) {
                if (e.target !== -1) continue
                // the header's own exit leaves by definition, so it cannot be
                // covered while we are still going around
                if (b === header && e === sb.exitEdge) continue
                return false
            }
        }
        return true
    }

    // Every bundle has to be travelled once for the residual to describe it.
    // A run that ends in an early return leaves the paths past it unexplored,
    // so we simply go again: what is already recorded holds the run back from
    // repeating itself.
    function edgesCovered(): boolean {
        for (const entry of symbolicBranches) {
            const sb = entry[1]
            if (sb.thenEdge.target === -1 || sb.elseEdge.target === -1) return false
        }
        return true
    }
    function advancePath(): boolean {
        while (decisions.length && decisions[decisions.length - 1] === 1) decisions.pop()
        if (!decisions.length) return false
        decisions[decisions.length - 1] = 1
        return true
    }
    const tracer = intrinsics.createIntrinsicsTracer(Intrinsics, {
        stackalloc: (amt) => {
            const p = stackalloc(amt)
            lowSp = Math.min(lowSp, p)
            return p
        },
        load: cfg.anyUnknown ? (ptr, offset, T) => {
            if (ptr > intrinsics.heapMaxAddress) {
                tracer.markHandled()
                return mem[ptr + offset]
            }
            return load(ptr, offset, T)
        } : undefined,
        store: cfg.anyUnknown ? (ptr, offset, val, T) => {
            if (ptr <= intrinsics.heapMaxAddress) return store(ptr, offset, val, T)
            mem[ptr + offset] = val as any
            tracer.markHandled()
        } : undefined,
        dispatch: cfg.anyUnknown ? pc => {
            if (pc !== lastReportedPc && isBlock(pc)) {
                if (const b = cfg.blockAt.get(pc)) onEnterBlock(b)
            }
            lastReportedPc = pc
            return pc
        } : undefined,
        branch: cfg.anyUnknown ? (cond, v1, v2) => {
            if (!regions.length) {
                if (!isNaN(cond as any)) {
                    return cond ? v1 : v2
                }
            }

            tracer.markHandled()

            // leaving this node travels one of its bundles; which one is a
            // property of the branch, not of the block we happen to land in
            const site = curBlock
            // v1 is the target when the predicate holds, so it is always the
            // then-edge. A rotated loop happens to continue on v1, but an early
            // `return` out of a body leaves on it, and the residual reads the
            // predicate, not the shape of the loop
            function taking(pc: number): number {
                const sb = symbolicBranches.get(site)
                if (sb) curEdge = pc === v1 ? sb.thenEdge : sb.elseEdge
                refine(pc)
                return pc
            }

            // An equality that holds makes both sides the same value, so the
            // wider one may as well be the narrower everywhere it is held. The
            // register file is the whole of "everywhere": once a slot carries
            // the narrower value every later load returns it, and folding and
            // cse follow with no further help. Only the true arm proves
            // anything -- the false arm says the two differ, which is nothing.
            function refine(pc: number): void {
                if (pc !== v1) return
                const id = tracer.getNanId(cond as any)
                if (!id) return
                const t = tracer.getTraceById(id)
                if (!t || t.op !== 'eq') return
                const ops = lowering.operandIndices(t)
                if (ops.length !== 2) return

                // a literal is narrower than anything; between two symbols the
                // merge parameter is the wider, being a join of many values
                function widerIndex(): number {
                    const a = t!.argIds[ops[0]] ?? 0
                    const b = t!.argIds[ops[1]] ?? 0
                    if (!a && !b) return -1
                    if (!b) return 0
                    if (!a) return 1
                    if (blockParamByNan.has(a) && !blockParamByNan.has(b)) return 0
                    if (blockParamByNan.has(b) && !blockParamByNan.has(a)) return 1
                    return -1
                }
                const w = widerIndex()
                if (w === -1) return
                const wide = t.argIds[ops[w]] ?? 0
                const narrowId = t.argIds[ops[1 - w]] ?? 0
                const narrow = narrowId
                    ? intrinsics.getNanFromId(narrowId) as any
                    : t.args[ops[1 - w]]

                // the arms rejoin at the post-dominator, and the value is only
                // this one on the way there. no post-dominator means they never
                // rejoin: this path exits, so there is nothing to put back
                const rejoin = cfg.blocks[site].ipdom
                let rs: [slot: number, id: number, konst: number][] | undefined = undefined
                if (rejoin !== -1) {
                    rs = pendingRestores.get(rejoin)
                    if (!rs) pendingRestores.set(rejoin, rs = [])
                }
                for (let r = 0; r < regCount; r++) {
                    const slot = slotForReg(r)
                    const held = mem[slot]
                    if (tracer.getNanId(held) !== wide) continue
                    if (rs) rs.push([slot, wide, held])
                    mem[slot] = narrow
                }
            }

            const header = cfg.blocks[curBlock].loop
            let isLoopBranch = false
            let contPc = 0
            let exitPc = 0
            if (header !== -1) {
                const body = cfg.loops.get(header)!
                const in1 = body.has(cfg.blockAt.get(v1)!)
                const in2 = body.has(cfg.blockAt.get(v2)!)
                if (in1 !== in2) {
                    isLoopBranch = true
                    contPc = in1 ? v1 : v2
                    exitPc = in1 ? v2 : v1
                }
            }

            if (!isNaN(cond as any)) {
                const taken = taking(cond ? v1 : v2)
                if (isLoopBranch && taken === exitPc) {
                    if (const r = regionAtMerge.get(header)) closeRegion(r)
                }
                return taken
            }

            assert(cfg.blocks[curBlock].hasUnknown)

            let sb = symbolicBranches.get(curBlock)
            if (!sb) {
                sb = {
                    block: curBlock,
                    condByEdge: new Map<TraceEdge, number>(),
                    thenEdge: newEdge(),
                    elseEdge: newEdge(),
                    exitEdge: undefined,
                }
                if (isLoopBranch) sb.exitEdge = exitPc === v1 ? sb.thenEdge : sb.elseEdge
                symbolicBranches.set(curBlock, sb)
            }
            // per edge, and overwritten each visit, only the last one is converged
            sb.condByEdge.set(inEdge, cond as any)

            if (isLoopBranch) {
                symbolicHeaders.add(header)
                const r = regionAtMerge.get(header) ?? openRegion('loop', header)
                if (r.changed || !armsCovered(header, curBlock)) return taking(contPc)
                closeRegion(r)
                return taking(exitPc)
            }

            const rejoin = cfg.blocks[curBlock].ipdom
            if (rejoin !== -1 && !regionAtMerge.has(rejoin)) openRegion('forward', rejoin)
            if (enclosingLoop() !== undefined) {
                const n = (armVisits.get(curBlock) ?? 0) + 1
                armVisits.set(curBlock, n)
                return taking((n & 1) ? v2 : v1)
            }
            return taking(decideForward(v1, v2))
        } : undefined,
        canexit: (acc) => {
            tracer.markHandled()
            const at = curBlock < 0 ? 0 : curBlock
            retNodes.add(at)
            curEdge.target = at
            const id = tracer.getNanId(acc as any)
            exitIds.push(id)
            exitConsts.push(id ? 0 : acc as any)
            exitBlocks.push(curBlock === -1 ? 0 : curBlock)
            exitTokens.push(tracer.getNanId(callToken))
            return true
        },
        call: (target: any, thisArg: any, regStart: any, nargs: any, cb: any) => {
            tracer.markHandled()
            const cargs = new Float64Array(3 + nargs)
            cargs[0] = callToken as f64
            cargs[1] = target ? target : mem[regStart + nargs * 4]
            cargs[2] = thisArg
            for (let i = 0; i < nargs; i++) cargs[3+i] = mem[regStart + i * 4]
            callToken = tracer.traceOp('call', cargs, Types.u32)
            let here = edgeCalls.get(curEdge)
            if (!here) edgeCalls.set(curEdge, here = [])
            const id = tracer.getNanId(callToken)
            if (here.indexOf(id) < 0) here.push(id)
            return callToken
        },
    })
    defer tracer.dispose()

    const spBefore = sp()
    const args = Intrinsics.stackalloc(4 + compiled.paramCount * 4 as u32)
    const paramSlots: number[] = []
    // registers descend in index as addresses ascend, so the first parameter
    // sits at the top of the block. paramIds is in the caller's order, which is
    // the order lowering pins them to argument registers
    for (let i: u32 = 0; i < compiled.paramCount; i++) {
        paramSlots.push(args + (compiled.paramCount - 1 - i) * 4)
    }
    regsBase = args - 4 + compiled.paramCount * 4
    const paramIds: number[] = []

    // A parameter is needed exactly where an unknown value can arrive from more
    // than one place, and the cfg already knows where that is: `unknownIn` at
    // the merge of a branch whose predicate is unknown. Placing them up front
    // means the first pass through a loop body already computes in terms of the
    // final symbols, so there is nothing to converge to. A concrete interior has
    // no unknown branch, so nothing is placed and it keeps unrolling.
    for (const entry of cfg.mergeParams) {
        const merge = entry[0]
        if (cfg.loops.has(merge)) symbolicHeaders.add(merge)
        for (const r of entry[1]) publish(merge, slotForReg(r))
    }
    for (const merge of cfg.mergeCalls) publish(merge, tokenSlot)

    function runOnce(): void {
        mem.fill(0, lowSp)
        Intrinsics.store(args, compiled.paramCount * 4 as u32, finalized, Types.u32)
        for (let i: u32 = 0; i < compiled.paramCount; i++) {
            // incoming symbols are created once and reused on every path, so
            // values computed on different paths unify into one graph. we keep
            // the id and rebuild the nan, rather than storing the double
            if (paramIds.length <= i) {
                const arg = tracer.createUniqueNan()
                paramIds[i] = tracer.getNanId(arg)
                paramByNan.set(paramIds[i], `p${i}`)
            }
            Intrinsics.store(args, (compiled.paramCount - 1 - i) * 4 as u32,
                intrinsics.getNanFromId(paramIds[i]) as any, Types.u32)
        }
        curBlock = -1
        curEdge = entryEdge
        callToken = 0
        lastReportedPc = -1
        regions.length = 0
        regionAtMerge.clear()
        decisionIdx = 0
        armVisits.clear()
        interpret(finalized, 0, args, compiled.paramCount as u32)
    }

    for (let run = 0; ; run++) {
        runOnce()
        if (advancePath()) continue
        if (edgesCovered()) break
        if (run >= maxRuns) throw `trace2: an arm was still unexplored after ${maxRuns} runs`
    }
    sp(spBefore)

    function slotName(slot: number): string {
        if (slot === tokenSlot) return 'call'
        const pi = paramSlots.indexOf(slot)
        if (pi >= 0) return `p${pi}`
        const r = (regsBase - slot) / 4
        return r < compiled.paramCount ? `p${r}` : `r${r - compiled.paramCount}`
    }

    const rendering = new Set<number>()
    function renderId(id: number): string {
        if (const bp = blockParamByNan.get(id)) return `v${bp.label}`
        if (const name = paramByNan.get(id)) return name
        if (rendering.has(id)) return `?${id}`
        if (const t = tracer.getTraceById(id)) {
            rendering.add(id)
            const s = renderTrace(t)
            rendering.delete(id)
            return s
        }
        return `?${id}`
    }

    function renderTrace(t: any): string {
        if (!t) return '?'
        const parts: string[] = []
        for (const j of lowering.operandIndices(t)) {
            const id = t.argIds[j] ?? 0
            parts.push(id === 0 ? String(t.args[j]) : renderId(id))
        }
        return `(${t.op}, ${parts.join(', ')})`
    }

    function render(v: number): string {
        const id = tracer.getNanId(v)
        if (!id) return String(v)
        return renderId(id)
    }

    const liveParams = new Set<number>()
    const markedIds = new Set<number>()
    function markId(id: number): void {
        if (markedIds.has(id)) return
        markedIds.add(id)
        if (const bp = blockParamByNan.get(id)) {
            if (liveParams.has(bp.label)) return
            liveParams.add(bp.label)
            for (const e of bp.incoming) markValue(e[1])
            return
        }
        if (const t = tracer.getTraceById(id)) {
            for (const j of lowering.operandIndices(t)) {
                const aid = t.argIds[j] ?? 0
                if (aid !== 0) markId(aid)
            }
        }
    }
    function markValue(v: number): void {
        const id = tracer.getNanId(v)
        if (id) markId(id)
    }
    for (const id of exitIds) { if (id) markId(id) }
    for (const id of exitTokens) { if (id) markId(id) }
    for (const entry of symbolicBranches) {
        for (const e of entry[1].condByEdge) markValue(e[1])
    }

    // ---- structured residual ---------------------------------------------
    // Nodes are the places values merge, branch, or return. Edges are the value
    // bundles between them. Neither refers to a cfg block except as a label, so
    // everything that folded away is simply absent.
    const valueNames = new Map<number, string>()
    function buildResidual(): lowering.Residual {
        const nodeIds: number[] = []
        for (let i = 0; i < cfg.blocks.length; i++) {
            if (isNode(i)) nodeIds.push(i)
        }
        const indexOfNode = new Map<number, number>()
        for (let i = 0; i < nodeIds.length; i++) indexOfNode.set(nodeIds[i], i)

        const edges: lowering.ResidualEdge[] = []
        const indexOfEdge = new Map<TraceEdge, number>()
        function edgeIndex(e: TraceEdge): number {
            if (const i = indexOfEdge.get(e)) return i
            const i = edges.length
            indexOfEdge.set(e, i)
            edges.push({
                target: e.target >= 0 ? (indexOfNode.get(e.target) ?? -1) : -1,
                args: [], argConsts: [],
                calls: edgeCalls.get(e) ?? [],
            })
            return i
        }

        const nodes: lowering.ResidualNode[] = []
        const paramsOf: BlockParam[][] = []
        const condParamOf: number[] = []
        for (const b of nodeIds) {
            const bySlot = published.get(b)
            const br = symbolicBranches.get(b)
            const params: BlockParam[] = []
            if (bySlot) {
                for (const p of bySlot.values()) {
                    if (liveParams.has(p.label)) params.push(p)
                }
            }
            // a predicate computed in the block is the same on every edge; one
            // that arrived through the accumulator differs, so it is a parameter
            let condParam = 0
            let condInBlock = 0
            if (br) {
                const distinct = new Set<number>()
                for (const e of br.condByEdge) distinct.add(tracer.getNanId(e[1]))
                if (distinct.size > 1) {
                    condParam = tracer.getNanId(tracer.createUniqueNan())
                    valueNames.set(condParam, 'c:cond')
                }
                else for (const e of br.condByEdge) condInBlock = tracer.getNanId(e[1])
            }
            paramsOf.push(params)
            condParamOf.push(condParam)

            const n: lowering.ResidualNode = {
                label: b, idom: cfg.blocks[b].idom,
                params: params.map(p => {
                    const id = tracer.getNanId(p.value)
                    valueNames.set(id, `v${p.label}:${slotName(p.slot)}`)
                    return id
                }),
                term: br ? 'branch' : retNodes.has(b) ? 'ret' : 'goto',
                condId: condParam || condInBlock,
                thenEdge: -1, elseEdge: -1, gotoEdge: -1, retId: 0, retConst: 0,
                retTokenId: 0,
            }
            if (condParam) {
                n.params.push(condParam)
            }
            if (br) {
                n.thenEdge = edgeIndex(br.thenEdge)
                n.elseEdge = edgeIndex(br.elseEdge)
            } else if (n.term === 'goto') {
                const out = nodeOut.get(b)
                if (out) n.gotoEdge = edgeIndex(out)
            }
            nodes.push(n)
        }

        for (let k = 0; k < exitIds.length; k++) {
            const i = indexOfNode.get(exitBlocks[k])
            if (i === undefined) continue
            nodes[i].retId = exitIds[k]
            nodes[i].retConst = exitConsts[k]
            nodes[i].retTokenId = exitTokens[k]
        }

        // fill each bundle with the values it carries, in parameter order
        function put(e: TraceEdge, slot: number, v: number, width: number): void {
            const ei = edgeIndex(e)
            const re = edges[ei]
            while (re.args.length < width) { re.args.push(0); re.argConsts.push(0) }
            const id = tracer.getNanId(v)
            re.args[slot] = id
            if (!id) re.argConsts[slot] = v
        }
        for (let i = 0; i < nodes.length; i++) {
            const width = nodes[i].params.length
            const params = paramsOf[i]
            for (let k = 0; k < params.length; k++) {
                for (const e of params[k].incoming) put(e[0], k, e[1], width)
            }
            if (condParamOf[i]) {
                const br = symbolicBranches.get(nodeIds[i])!
                for (const e of br.condByEdge) put(e[0], width - 1, e[1], width)
            }
        }

        return {
            entryEdge: edgeIndex(entryEdge),
            nodes,
            edges,
            paramIds,
            traces: tracer.getTraces(),
        }
    }

    const residual = buildResidual()

    function shortName(id: number): string {
        const n = valueNames.get(id)
        return n ? n.split(':')[0] : renderId(id)
    }
    const lines: string[] = []
    for (let i = 0; i < residual.nodes.length; i++) {
        const n = residual.nodes[i]
        const names = n.params.map(p => valueNames.get(p) ?? `?${p}`)
        lines.push(`B${n.label}${names.length ? `(${names.join(', ')})` : ''}:`)
        for (let ei = 0; ei < residual.edges.length; ei++) {
            const e = residual.edges[ei]
            if (e.target !== i || (!n.params.length && ei !== residual.entryEdge)) continue
            const from = ei === residual.entryEdge ? 'entry' : `e${ei}`
            const args = n.params.map((p, k) =>
                `${shortName(p)} = ${e.args[k] ? renderId(e.args[k]) : String(e.argConsts[k])}`)
            const calls = e.calls.length ? `  calls ${e.calls.map(shortName).join(', ')}` : ''
            lines.push(`  <- ${from}(${args.join(', ')})${calls}`)
        }
        if (n.term === 'branch') {
            const t = residual.edges[n.thenEdge].target
            const f = residual.edges[n.elseEdge].target
            lines.push(`  br ${shortName(n.condId)} ? B${residual.nodes[t].label} : B${residual.nodes[f].label}`)
        } else if (n.term === 'ret') {
            if (n.retTokenId) lines.push(`  effect ${renderId(n.retTokenId)}`)
            lines.push(`  ret ${n.retId ? renderId(n.retId) : String(n.retConst)}`)
        }
    }

    const seenExits = new Set<string>()
    for (let k = 0; k < exitIds.length; k++) {
        const id = exitIds[k]
        const s = `ret ${id ? renderId(id) : String(exitConsts[k])}`
        if (seenExits.has(s)) continue
        seenExits.add(s)
        lines.push(s)
    }
    return {
        cfg,
        residual,
        exitIds,
        text: lines.join('\n'),
        traces: tracer.getTraces(),
    }
}

function testTrace(fn: Function, name: string = fn.name, verbose = false) {
    const start = (performance as any).now()
    console.log(`--- ${name} ---`)
    const r = trace(fn.toString(), { verbose, showCfg: true })
    console.log(r.text)
    console.log('dur', (performance as any).now() - start)
}

// js source -> bytecode -> trace -> residual -> machine code
function testCompile(fn: Function, name: string = fn.name, regBudget?: number, args?: number[]) {
    console.log(`=== compile ${name}${regBudget ? ` (${regBudget} regs)` : ''} ===`)
    const r = trace(fn.toString(), { showCfg: (globalThis as any).__cfg })!
    console.log(r.text)
    const l = lowerResidual(r.residual, { regBudget })
    console.log(l.listing)
    const bytes = new Uint8Array(l.bytes)
    if (args) {
        const result = (ts as any).createNativeFn(bytes)
        const expected = fn(...args)
        const actual = result(...args)
        console.log(fn.name, 'actual:', actual, 'expected:', expected)
        assert(actual === expected)
    }
    return bytes
}

function t(n: number) {
    let c = 0
    for (let i = 0; i < 10; i++) {
        c += i
    }
    let s = 0; for (let i = 0; i < n; i += 1) { s += i } return s + c
}

testTrace(t, 't', true)

testTrace(function allConcrete() {
    let s = 0
    for (let i = 0; i < 10; i++) s += i
    return s * 2
})

testTrace(function linear(n: number) {
    const a = n * 3
    const b = a + 1
    return b - n
})

testTrace(function ifElse(n: number) {
    let x = 1
    if (n > 3) { x = n + 10 } else { x = 20 }
    return x + 5
})

testTrace(function maybeZero(n: number) {
    let x = 5
    let i = 0
    while (i < n) { x = x + 1; i = i + 1 }
    return x
})

testTrace(function nested(n: number) {
    let s = 0
    for (let i = 0; i < n; i = i + 1) {
        for (let j = 0; j < 3; j = j + 1) s = s + j
    }
    return s
})

testTrace(function nested2(n: number) {
    let s = 0
    for (let i = 0; i < n; i = i + 1) {
        for (let j = 0; j < i; j = j + 1) {
            for (let k = j; k >= 0; k += i) {
                s = s + k
            }
        }
    }
    return s
})

testTrace(function allConcrete2() {
    let s = 0
    for (let i = 0; i < 10_000; i++) {
        s += i
        if (s > 10) {
            s -= i % 5
        }
        if (s > 100_000) {
            s -= 100_000
        }
    }
    return s * 2
})

testTrace(function withCall(x: number, f: any) {
    const x1 = x*8
    const x2 = x*8
    return f(x1, x2) + f(x1, x2)
})

testTrace(function withCall2(f: any, e: number) {
    const a = 2*e
    const b = f(a)
    return f()
})

testTrace(function callInLoop(n: number, f: any) {
    let s = 0
    for (let i = 0; i < n; i++) s = s + f(i)
    return s
})

testTrace(function callInBranch(n: number, f: any) {
    let s = 0
    if (n > 3) s = f(n)
    return s + f(1)
})

