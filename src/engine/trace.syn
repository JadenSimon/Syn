testCompile(t, 't', undefined, [10])
testCompile(function folds() { let s = 0; for (let i = 0; i < 10; i++) s += i; return s * 2 }, 'folds', undefined, [])
;(globalThis as any).__cfg = true
testCompile(function sumTo2(n: number) { 
    // adding the "c" adds an extra ~100 intructions BUT it should ideally be peeled away
    // conventional optimizing compilers struggle with this case too
    let s = 0; 
    // let c = 0
    for (let i = 0; i < n; i++) {
        s = s + i; 
        if (s > 10) {
            s -= i % 5;
        }
        // if (c < 1) c += 1
    }
    return s // + c
}, 'sumTo2', undefined, [20])

// constant on the left of the comparison: `10 < s`  is commuted into `s > 10`
testCompile(function cmpLeft(n: number) {
    let s = 0
    for (let i = 0; i < n; i++) {
        s = s + i
        if (10 < s) s = s - 3
    }
    return s
}, 'cmpLeft', undefined, [10])

// uses artificial register pressure to force spills
testCompile(function sumTo2b(n: number) {
    let s = 0
    for (let i = 0; i < n; i++) {
        s = s + i
        if (s > 10) s -= i % 5
    }
    return s
}, 'sumTo2 spilled', 1, [10])


testCompile(function constantInterior(n: number) {
    let s = 0
    for (let i = 0; i < n; i++) {
        s = s + i
        let d = 0
        for (let j = 0; j < 3; j++) d += j
        s += d
    }
    return s
}, void 0, void 0, [10])

