// the equality narrows `n` to 5 on the then arm only: the arms rejoin, so the
// value has to be `n` again by the time it is added to x
testCompile(function refineRejoin(n: number) {
    let x = 0
    if (n === 5) x = 1
    return n + x
}, void 0, void 0, [7])

testCompile(function bitwiseOr(a: number, b: number) {
    return a | (b << 30)
}, void 0, void 0, [1, 4])

// same, one loop level down, where the restore competes with the header
// reinstalling its own parameters
// blr xN, whatever N is
function countBlr(bytes: Uint8Array): number {
    let n = 0
    for (let i = 0; i + 3 < bytes.length; i += 4) {
        const w = (bytes[i] as number) | ((bytes[i + 1] as number) << 8)
            | ((bytes[i + 2] as number) << 16) | ((bytes[i + 3] as number) << 24)
        if ((w & 0xFFFFFC1F) >>> 0 === 0xD63F0000) n++
    }
    return n
}

{
    const callee = testCompile(function sub2(a: number, b: number) { return a - b }, 'sub2', undefined, [9, 2])
    const addr = (ts as any).toNativePtrAddr((ts as any).createNativeFn(callee))
    const caller = testCompile(function callThrough(fl: number, fh: number, x: number) {
        const f: any = fl | (fh << 32)
        const v1 = f(x, 2)
        return f(v1, 3)
    }, 'callThrough')
    const fn = (ts as any).createNativeFn(caller)
    const actual = fn(addr & 0xFFFF_FFFF, Math.trunc(addr / 0x1_0000_0000), 10)
    console.log('callThrough actual:', actual, 'expected:', 5)
    assert(actual === 5)
    assert(countBlr(caller) === 2)
}

