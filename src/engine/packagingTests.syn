/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

import * as intrinsics from './intrinsics'
import { Graph, GraphNode, lowerValueGraph } from './lowering2'
import { packageBlocks2 } from './packaging'
import { trace2 } from './trace2'
import { createAarch64Assembler } from './lowering'

function testSharedApplication(): void {
    const nodes = new Map<number, GraphNode>()
    function n(id: number, op: string, ids: number[], values: number[] = [], label?: string): number {
        const constants = new Float64Array(ids.length)
        constants.set(values)
        nodes.set(id, { op, argIds: ids, argConsts: constants, label,
            T: intrinsics.Types.u32, U: intrinsics.Types.u32 })
        return id
    }
    n(1, 'param', []) // pointer
    n(2, 'nil-effect', [])
    n(3, 'load', [2, 1, 0])
    n(10, 'block', [])
    n(11, 'param', []) // data
    n(12, 'param', []) // token
    n(13, 'add', [11, 0], [0, 1])
    n(14, 'store', [12, 1, 0, 13])
    n(15, 'after', [14, 11])
    n(16, 'state', [2, 15], [], 'return')
    n(20, 'apply', [10, 3, 3])
    n(21, 'proj', [20, 0], [0, 9], 'return.token')
    n(22, 'proj', [20], [], 'return.return')
    n(23, 'add', [22, 22])
    n(24, 'after', [21, 23])
    const graph: Graph = { maxId: 25, nodes, params: [1], blocks: [
        { id: 0, params: [1], bodyId: 24, bodyConst: 0 },
        { id: 10, params: [11, 12], inputs: [8, 9], slots: [9], effectSlot: 9,
            consumesEffectToken: true, bodyId: 16, bodyConst: 0 },
    ] }
    for (const packaged of [packageBlocks2(graph), packageBlocks2(packageBlocks2(graph))]) {
        const code = lowerValueGraph(packaged)
        const fn = (ts as any).createNativeFn(new Uint8Array(code.bytes))
        const memory = new Uint32Array([7])
        const ptr = (ts as any).getArrayBufferPtr(memory.buffer)
        intrinsics.assert(Number(fn(ptr)) === 14)
        intrinsics.assert(memory[0] === 8)
    }
}

function testSharedPredicate(): void {
    function shared(a: u32, b: u32): u32 {
        const yes = a > b
        const x = yes ? a + 3 : b + 5
        const y = b > 10 ? a + 7 : b + 11
        const z = yes ? y + 13 : x + 17
        return x + y + z
    }
    const graph = packageBlocks2(trace2(shared).graph)
    const code = lowerValueGraph(graph)
    const fn = (ts as any).createNativeFn(new Uint8Array(code.bytes))
    for (const a of [0, 1, 7, 31]) for (const b of [0, 3, 12, 40]) {
        intrinsics.assert(Number(fn(a, b)) === shared(a, b))
    }
}

testSharedApplication()
testSharedPredicate()
{
    const asm = createAarch64Assembler()
    asm.compareImm('gt', 2, 0, 3, false)
    asm.jumpIfZero(2, 1)
    asm.movImm(0, 0)
    asm.jump(2)
    asm.bindLabel(1)
    asm.movImm(0, 10)
    asm.bindLabel(2)
    asm.binary('add', 0, 0, 2, false)
    asm.ret()
    const fn = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
    intrinsics.assert(Number(fn(7, 0, 99)) === 1)
    intrinsics.assert(Number(fn(1, 0, 99)) === 10)
}
console.log('packaging2 self-test passed')
