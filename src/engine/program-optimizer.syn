/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import * as harness from './harness'
import * as rt from './rt'
import type { Graph, GraphNode } from './lowering2'
import type { FastTraced } from './fast-trace'
import { verifyTokenForks } from './verify'
import { NodeOp, NodeFlags, addNode, countIds, deleteNode, getLiteral, getNode, getOperand, getRef, isThisParam, opName, blockOrder, putCopy, putNode, typeOf, withNodes, type Operand } from './graph-node'
import {
    Kinds, anyKinds, baseContract, blockParamAt, calleeOf, calleesFirst, callersFirst, copyContract, count, createProgram, strip, useGraph, usesCallee, valueUses, versionOf, walkUses,
    type Contract, type Host, type Layout, type Program, type UseGraph, type Version, type Walk,
} from './call-graph'

const Types = intrinsics.Types

type Handle = intrinsics.Handle

export const numberKinds = Kinds.int | Kinds.double
export const nullishKinds = Kinds.undefined | Kinds.null

export const typeofKinds: Record<string, [inside: number, outside: number]> = {
    number: [numberKinds, numberKinds],
    string: [Kinds.string, Kinds.string],
    boolean: [Kinds.boolean, Kinds.boolean],
    undefined: [Kinds.undefined, Kinds.undefined],
    object: [Kinds.object | Kinds.null, Kinds.null],
    function: [Kinds.function, Kinds.function],
}

export interface Optimizer extends Program {
    summaries: Map<Function, Summary | null>
    layouts: Map<Function, UnitFacts>
    generic: Map<Function, GenericSummary>
    disabled: Set<string>
    planned: boolean
    writes: Writes
    receivers: Map<Function, ReceiverUse>
    constructed: Map<Function, Map<number, Layout | null>>
}

interface Writes {
    keys: Set<string>
    defined: Set<string>
    numeric: boolean
    poison: string
    hard: string
    folded: Set<string>
    sealed: Set<string>
    impls: Set<Function>
    seen: number
}

export interface Route {
    version: Version
    cell: number
}

export interface Optimized {
    traced: FastTraced
    routes: Map<number, Route>
}

interface Unit {
    p: Optimizer
    traced: FastTraced
    contract: Contract | undefined
    assumed: number[] | undefined
    routes: Map<number, Route>
    ordered: Set<number>
    epoch: number
    kinds: KindResult | undefined
    kindsEpoch: number
}

interface Pass {
    name: string
    consumes: number
    produces: number
    run(u: Unit): number
}

const Effect = { objects: 1, calls: 2, routes: 4 }

const roundCap = 2

const pipeline: Pass[] = [
    { name: 'constants', consumes: Effect.objects, produces: Effect.calls, run: constantReads },
    { name: 'dead', consumes: Effect.objects, produces: 0, run: deadObjects },
    { name: 'stack', consumes: Effect.objects, produces: 0, run: stackRecords },
    { name: 'devirt', consumes: Effect.objects | Effect.calls, produces: Effect.calls, run: devirtualize },
    { name: 'containers', consumes: Effect.objects | Effect.calls, produces: Effect.calls | Effect.routes, run: containers },
    { name: 'layouts', consumes: Effect.objects | Effect.calls, produces: Effect.routes, run: fieldLayouts },
    { name: 'fast', consumes: Effect.calls | Effect.routes, produces: Effect.routes, run: fastCalls },
]

export function enabled(p: Optimizer, pass: string): boolean {
    return !p.disabled.has(pass)
}

export function createOptimizer(host: Host, roots: Function[]): Optimizer {
    const disabled = new Set(intrinsics.argv().filter(a => a.startsWith('no-opt:')).map(a => a.slice(7)))
    const writes: Writes = { keys: new Set(), defined: new Set(), numeric: false, poison: '', hard: '', folded: new Set(), sealed: new Set(), impls: new Set(), seen: 0 }
    const p: Optimizer = { ...createProgram(host, roots), summaries: new Map(), layouts: new Map(), generic: new Map(), disabled, planned: false, writes, receivers: new Map(), constructed: new Map() }
    if (enabled(p, 'constants')) indexWrites(p)
    count(p, 'callgraph:units', p.calls.order.length)
    count(p, 'callgraph:edges', p.calls.edges)
    if (writes.poison) count(p, `constants:poison:${writes.poison}`)
    if (writes.hard) count(p, `constants:hard:${writes.hard}`)
    count(p, 'constants:written', writes.keys.size)
    if (enabled(p, 'layouts')) planLayouts(p)
    return p
}

export function optimizeUnit(p: Optimizer, traced: FastTraced, contract: Contract | undefined): Optimized {
    const assumed = contract ? contract.params.slice(1).map(p => p.kind) : undefined
    if (enabled(p, 'constants')) indexWrites(p)
    const u: Unit = { p, traced, contract, assumed, routes: new Map(), ordered: new Set(), epoch: 0, kinds: undefined, kindsEpoch: -1 }
    const later = pipeline.map(() => Effect.objects | Effect.calls | Effect.routes)
    let round = 0
    while (round < roundCap) {
        const wanted = later.slice()
        later.fill(0)
        let ran = 0
        for (let i = 0; i < pipeline.length; i++) {
            const pass = pipeline[i]
            if (!enabled(p, pass.name) || !(wanted[i] & pass.consumes)) continue
            ran++
            const changes = pass.run(u)
            if (!changes) continue
            if (enabled(p, 'verify')) verifyTokenForks(u.traced.graph, `opt ${pass.name}`)
            count(p, round ? `${pass.name}:round${round + 1}` : pass.name, changes)
            for (let j = 0; j < i; j++) later[j] |= pass.produces
        }
        if (!ran) break
        round++
    }
    const represented = enabled(p, 'kinds') ? representKinds(u) : 0
    count(p, 'kinds', represented)
    if (represented && enabled(p, 'verify')) verifyTokenForks(u.traced.graph, 'opt kinds')
    return { traced: u.traced, routes: u.routes }
}

function rewrite(u: Unit, g: Graph): void {
    u.traced = { ...u.traced, graph: g }
    u.epoch++
}

function kindsOf(u: Unit): KindResult {
    if (u.kinds && u.kindsEpoch === u.epoch) return u.kinds
    u.kinds = analyzeKinds(u.p, u.traced, u.assumed, u.routes)
    u.kindsEpoch = u.epoch
    return u.kinds
}

function routeWith(u: Unit, call: number, unit: Function, cell: number, update: (c: Contract) => boolean): boolean {
    const known = u.routes.get(call)
    const c = known ? copyContract(known.version.contract) : baseContract(u.p, unit)
    if (!update(c)) return false
    const version = versionOf(u.p, c)
    if (version === known?.version) return false
    u.routes.set(call, { version, cell: known?.cell || cell })
    u.epoch++
    return true
}

function hasOp(g: Graph, ops: Set<NodeOp>): boolean {
    for (const n of g.nodes.values()) {
        if (ops.has(n.op)) return true
    }
    return false
}

const binaryOps = new Set<NodeOp>([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr])
const compareOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge])
const controlOps = new Set<NodeOp>([NodeOp.apply, NodeOp.ret, NodeOp.panic, NodeOp.unreachable, NodeOp.trap])
const machineOps = new Set<NodeOp>([NodeOp.crc32, NodeOp.pstack, NodeOp.stackalloc, NodeOp.stackfree, NodeOp.mem, NodeOp.clz, NodeOp.alloca])
const intOps = new Set<NodeOp>([NodeOp.add, NodeOp.sub, NodeOp.mul])
const bitwiseOps = new Set<NodeOp>([NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr])
const intTypes = new Set<number>([Types.u8, Types.u16, Types.u32, Types.u64, Types.i8, Types.i16, Types.i32, Types.i64, Types.usize])
const callOps = new Set<NodeOp>([NodeOp.call])

export interface KindResult {
    kinds: Map<number, number>
    narrowed: Map<number, Map<number, number>>
    preferred: number[]
    returns: number
}

export interface Summary {
    preferred: number[]
    coarseReturns: number
    fastReturns: number
    params: number
    fast: boolean
    coarse: KindResult
}

export function intKind(kind: number): boolean {
    return kind !== 0 && !(kind & ~Kinds.int)
}

export function stringKind(kind: number): boolean {
    return kind !== 0 && !(kind & ~Kinds.string)
}

function literalKind(value: number): number {
    return Number.isInteger(value) && !Object.is(value, -0) ? Kinds.int : Kinds.double
}

function machineKind(T: number): number {
    if (T === Types.bool) return Kinds.boolean
    if (T === Types.f64 || T === Types.f32) return Kinds.double
    if (intTypes.has(T)) return Kinds.int
    if (T === Types.unknown_number) return numberKinds
    return anyKinds
}

function cellKind(cell: number): number {
    if (cell === heap.undefinedHandle) return Kinds.undefined
    if (cell === heap.nullHandle) return Kinds.null
    if (cell === heap.trueHandle || cell === heap.falseHandle) return Kinds.boolean
    if (heap.isBoxedF64(cell as Handle)) {
        if (heap.boxedNanId(cell as Handle)) return Kinds.double
        return literalKind(heap.unboxF64(cell as Handle))
    }
    if (!heap.isCell(cell as Handle)) return anyKinds
    const state = heap.deref(cell as Handle)
    if (heap.isString(state)) return Kinds.string
    if (heap.isCallable(state)) return Kinds.function
    return Kinds.object
}

export function perInvocationCell(traced: FastTraced, cell: number): boolean {
    return traced.allocations.has(cell as u32) || traced.frames.has(cell as u32) || traced.closures.has(cell)
}

export function summaryOf(p: Optimizer, fn: Function): Summary | undefined {
    if (p.summaries.has(fn)) return p.summaries.get(fn) ?? undefined
    p.summaries.set(fn, null)
    const signature = p.host.signature(fn)
    if (!signature) return
    const traced = p.host.trace(fn)
    if (!traced) return
    const coarse = analyzeKinds(p, traced, undefined, undefined)
    const fast = !signature.rest && coarse.preferred.some(p => p !== anyKinds)
    const fastReturns = fast ? analyzeKinds(p, traced, coarse.preferred, undefined).returns : coarse.returns
    const summary: Summary = { preferred: coarse.preferred, coarseReturns: coarse.returns, fastReturns, params: coarse.preferred.length, fast, coarse }
    if (intrinsics.argv().includes('kinds-debug')) console.log(`KINDS ${fn.name} preferred=[${summary.preferred.join(',')}] coarse->${summary.coarseReturns} fast=${fast} fast->${fastReturns}`)
    count(p, 'kinds:summaries')
    p.summaries.set(fn, summary)
    return summary
}

export function fastContract(p: Optimizer, fn: Function): Contract | undefined {
    const s = summaryOf(p, fn)
    if (!s?.fast) return
    const c = baseContract(p, fn)
    for (let i = 0; i < s.params && i + 1 < c.params.length; i++) c.params[i + 1].kind = s.preferred[i]
    c.returnsInt = intKind(s.fastReturns)
    return c
}

function matchesFast(summary: Summary, argKinds: number[]): boolean {
    if (!summary.fast || argKinds.length !== summary.params) return false
    for (let i = 0; i < argKinds.length; i++) {
        if (argKinds[i] & ~summary.preferred[i]) return false
    }
    return true
}

function withinPreferred(s: Summary, c: Contract): boolean {
    if (!s.fast) return false
    for (let i = 0; i < s.params; i++) {
        const kind = c.params[i + 1]?.kind ?? anyKinds
        if (kind & ~s.preferred[i]) return false
    }
    return true
}

function routeKind(p: Optimizer, c: Contract): number {
    if (c.returnsInt) return Kinds.int
    const s = summaryOf(p, c.unit)
    if (!s) return anyKinds
    return withinPreferred(s, c) ? s.fastReturns : s.coarseReturns
}

export function operandKindOf(result: KindResult, src: Graph, n: GraphNode, id: number, slot: number): number {
    const ref = getRef(n, slot)
    if (!ref) return literalKind(getLiteral(src, n, slot))
    const narrowed = result.narrowed.get(id)?.get(slot)
    if (narrowed !== undefined) return narrowed
    return result.kinds.get(ref) ?? anyKinds
}

function isControl(src: Graph, id: number, memo: Map<number, boolean>): boolean {
    const known = memo.get(id)
    if (known !== undefined) return known
    const n = getNode(src, id)
    let result = false
    if (n && controlOps.has(n.op)) result = true
    else if (n?.op === NodeOp.after && getRef(n, countIds(n) - 1)) result = isControl(src, getRef(n, countIds(n) - 1), memo)
    else if (n?.op === NodeOp.select) {
        for (let i = 1; i < countIds(n); i++) {
            if (getRef(n, i) && isControl(src, getRef(n, i), memo)) result = true
        }
    }
    memo.set(id, result)
    return result
}

function analyzeKinds(p: Optimizer, traced: FastTraced, assumed: number[] | undefined, routes: Map<number, Route> | undefined): KindResult {
    const src = traced.graph
    const entry = src.blocks[0]
    const control = new Map<number, boolean>()
    const u = useGraph(src)
    function constantCell(n: GraphNode, slot: number): number | undefined {
        const ref = getRef(n, slot)
        if (!ref) return
        const m = getNode(src, ref)
        if (m?.op !== NodeOp.heapHandle) return
        const cell = getLiteral(src, m, 0)
        if (perInvocationCell(traced, cell)) return
        return cell
    }
    function typeofOperand(n: GraphNode, slot: number): number {
        const ref = getRef(n, slot)
        const m = ref ? getNode(src, ref) : undefined
        if (!m || m.op !== NodeOp.rt || getLiteral(src, m, 1) !== rt.Op.typeof) return 0
        return getRef(m, 2)
    }
    function typeofName(cell: number | undefined): string | undefined {
        if (cell === undefined || !heap.isCell(cell as Handle) || !heap.isString(heap.deref(cell as Handle))) return
        const name = heap.stringToJs(heap.deref(cell as Handle))
        return typeofKinds[name] ? name : undefined
    }
    function conditionFacts(select: GraphNode, slot: number): Map<number, number> | undefined {
        if (countIds(select) !== 3) return
        const cond = getRef(select, 0)
        if (!cond) return
        const truth = slot === 1
        const m = getNode(src, cond)
        if (!m) return
        if (m.op === NodeOp.eq || m.op === NodeOp.ne) {
            const positive = (m.op === NodeOp.eq) === truth
            for (let side = 0; side < 2; side++) {
                const other = getRef(m, 1 - side)
                if (!other) continue
                const cell = constantCell(m, side)
                const name = typeofName(cell)
                const subject = typeofOperand(m, 1 - side)
                if (name !== undefined && subject) {
                    const [inside, outside] = typeofKinds[name]
                    return new Map([[subject, positive ? inside : anyKinds & ~outside]])
                }
                if (cell === heap.undefinedHandle) return new Map([[other, positive ? nullishKinds : anyKinds & ~nullishKinds]])
                if (cell === heap.nullHandle) return new Map([[other, positive ? Kinds.null : anyKinds & ~Kinds.null]])
            }
            return
        }
        if (!truth) return
        if (m.op === NodeOp.rt && getLiteral(src, m, 1) === rt.Op.truthy && getRef(m, 2)) return new Map([[getRef(m, 2), anyKinds & ~nullishKinds]])
        if (typeOf(m) === Types.bool) return
        return new Map([[cond, anyKinds & ~nullishKinds]])
    }
    const parents: number[] = []
    const facts: (Map<number, number> | undefined)[] = []
    function region(up: number, known: Map<number, number> | undefined): number {
        parents.push(up)
        facts.push(known)
        return parents.length - 1
    }
    const placement = new Map<number, number>()
    const armRegions = new Map<number, number[]>()
    const blockRegions = new Map<number, number>()
    const arrivals = new Map<number, number[]>()
    for (const b of src.blocks) blockRegions.set(b.id, region(-1, undefined))
    const walkStack: number[] = []
    for (const b of src.blocks) walkStack.push(b.bodyId, blockRegions.get(b.id)!)
    while (walkStack.length) {
        const at = walkStack.pop()!
        const id = walkStack.pop()!
        const n = getNode(src, id)
        if (!n || placement.has(id)) continue
        placement.set(id, at)
        if (n.op === NodeOp.select && isControl(src, id, control)) {
            const regions = [at]
            for (let i = 1; i < countIds(n); i++) {
                const child = region(at, conditionFacts(n, i))
                regions.push(child)
                if (getRef(n, i)) walkStack.push(getRef(n, i), child)
            }
            armRegions.set(id, regions)
            continue
        }
        if (n.op === NodeOp.after) {
            const last = getRef(n, countIds(n) - 1)
            if (last && isControl(src, last, control)) walkStack.push(last, at)
            continue
        }
        if (n.op === NodeOp.apply) {
            let list = arrivals.get(getRef(n, 0))
            if (!list) arrivals.set(getRef(n, 0), list = [])
            list.push(id)
        }
    }
    for (const b of src.blocks) {
        const list = arrivals.get(b.id)
        if (b.id === entry.id || !list || list.length !== 1) continue
        parents[blockRegions.get(b.id)!] = placement.get(list[0])!
    }
    const depths: number[] = []
    for (let r = 0; r < parents.length; r++) {
        const chain: number[] = []
        let at = r
        while (at >= 0 && depths[at] === undefined && !chain.includes(at)) {
            chain.push(at)
            at = parents[at]
        }
        if (at >= 0 && depths[at] === undefined) {
            parents[at] = -1
            depths[at] = 0
        }
        let depth = at >= 0 ? depths[at] : -1
        for (let i = chain.length - 1; i >= 0; i--) {
            depth++
            depths[chain[i]] = depth
        }
    }
    function common(a: number, b: number): number {
        let x = a
        let y = b
        while (x !== y && x >= 0 && y >= 0) {
            if (depths[x] >= depths[y]) x = parents[x]
            else y = parents[y]
        }
        return x === y ? x : -1
    }
    function useRegion(user: number, slot: number): number | undefined {
        const n = getNode(src, user)!
        if (n.op === NodeOp.select && armRegions.has(user)) return slot === 0 ? placement.get(user) : armRegions.get(user)![slot]
        return placement.get(user)
    }
    const reached = new Set<number>()
    for (const b of src.blocks) {
        for (const id of b.params) reached.add(id)
        for (const id of blockOrder(src, b)) reached.add(id)
    }
    const order = [...reached]
    for (let k = order.length - 1; k >= 0; k--) {
        const id = order[k]
        if (placement.has(id)) continue
        const list = u.users.get(id)
        if (!list) continue
        let at = -2
        for (const [user, slot] of list) {
            const r = useRegion(user, slot)
            if (r === undefined) {
                at = -1
                break
            }
            at = at === -2 ? r : common(at, r)
            if (at < 0) break
        }
        if (at >= 0) placement.set(id, at)
    }
    function envMask(start: number | undefined, ref: number): number {
        let mask = anyKinds
        let at = start ?? -1
        while (at >= 0) {
            const known = facts[at]?.get(ref)
            if (known !== undefined) mask &= known
            at = parents[at]
        }
        return mask
    }
    const kinds = new Map<number, number>()
    const narrowed = new Map<number, Map<number, number>>()
    function operandKind(user: number, n: GraphNode, slot: number): number {
        const ref = getRef(n, slot)
        if (!ref) return literalKind(getLiteral(src, n, slot))
        const own = kinds.get(ref) ?? 0
        let kind = own & envMask(useRegion(user, slot), ref)
        if (n.op === NodeOp.select && slot > 0 && !armRegions.has(user)) kind &= conditionFacts(n, slot)?.get(ref) ?? anyKinds
        if (kind === own) {
            narrowed.get(user)?.delete(slot)
            return kind
        }
        let slots = narrowed.get(user)
        if (!slots) narrowed.set(user, slots = new Map())
        slots.set(slot, kind)
        return kind
    }
    function callKind(n: GraphNode, id: number): number {
        if (n.flags & NodeFlags.spread) return anyKinds
        const route = routes?.get(id)
        if (route) return routeKind(p, route.version.contract)
        const unit = p.host.direct(traced, n)
        if (!unit) return anyKinds
        const summary = summaryOf(p, unit)
        if (!summary) return anyKinds
        const args: number[] = []
        for (let i = 3; i < countIds(n); i++) args.push(operandKind(id, n, i))
        return matchesFast(summary, args) ? summary.fastReturns : summary.coarseReturns
    }
    function rtKind(n: GraphNode, id: number): number {
        const op = getLiteral(src, n, 1)
        if (op === rt.Op.addOrConcat) {
            const a = operandKind(id, n, 2)
            const b = operandKind(id, n, 3)
            if (!(a & ~Kinds.int) && !(b & ~Kinds.int)) return Kinds.int
            if ((a && !(a & ~Kinds.string)) || (b && !(b & ~Kinds.string))) return Kinds.string
            const primitive = numberKinds | Kinds.boolean | nullishKinds
            if (!(a & ~primitive) && !(b & ~primitive)) return numberKinds
            return numberKinds | Kinds.string
        }
        if (op === rt.Op.concat || op === rt.Op.toString || op === rt.Op.typeof || op === rt.Op.stringOf) return Kinds.string
        if (op === rt.Op.toNumber) {
            const a = operandKind(id, n, 2)
            return a && !(a & ~Kinds.int) ? Kinds.int : numberKinds
        }
        if (op === rt.Op.compare) return numberKinds
        if (op === rt.Op.strictEqual || op === rt.Op.truthy) return Kinds.boolean
        if (op === rt.Op.hasPrototype) return Kinds.int
        if (op === rt.Op.create || op === rt.Op.ownKeys || op === rt.Op.assign) return Kinds.object
        if (op === rt.Op.handleof || op === rt.Op.handleHash) return Kinds.int
        if (op === rt.Op.sliceRead && getLiteral(src, n, 4) === Types.i64) return Kinds.int
        if (op === rt.Op.sliceRead && getLiteral(src, n, 4) === Types.f64) return numberKinds
        return anyKinds
    }
    function nodeKind(id: number, n: GraphNode): number {
        const op = n.op
        if (op === NodeOp.literal) return typeOf(n) === Types.bool ? Kinds.boolean : literalKind(getLiteral(src, n, 0))
        if (op === NodeOp.void) return Kinds.undefined
        if (op === NodeOp.heapHandle) {
            const cell = getLiteral(src, n, 0)
            if (traced.closures.has(cell)) return Kinds.function
            if (perInvocationCell(traced, cell)) return Kinds.object
            return cellKind(cell)
        }
        if (binaryOps.has(op)) {
            if (typeOf(n) !== Types.unknown_number) return machineKind(typeOf(n))
            if (bitwiseOps.has(op)) return Kinds.int
            if (intOps.has(op) && !(operandKind(id, n, 0) & ~Kinds.int) && !(operandKind(id, n, 1) & ~Kinds.int)) return Kinds.int
            return numberKinds
        }
        if (op === NodeOp.neg) return operandKind(id, n, 0) & ~Kinds.int ? numberKinds : Kinds.int
        if (op === NodeOp.not) return Kinds.int
        if (compareOps.has(op) || op === NodeOp.eq || op === NodeOp.ne) return Kinds.boolean
        if (op === NodeOp.rt) return rtKind(n, id)
        if (op === NodeOp.call) return callKind(n, id)
        if (op === NodeOp.select) {
            let kind = 0
            for (let i = 1; i < countIds(n); i++) kind |= operandKind(id, n, i)
            return kind
        }
        if (op === NodeOp.after) return operandKind(id, n, countIds(n) - 1)
        if (op === NodeOp.load || op === NodeOp.convert || op === NodeOp.bitconvert) return typeOf(n) === Types.vm_value ? anyKinds : machineKind(typeOf(n))
        if (op === NodeOp.typeof || op === NodeOp.poolEntry || machineOps.has(op)) return Kinds.int
        return anyKinds
    }
    let frozen = false
    let passes = 0
    let changed = true
    while (changed) {
        changed = false
        for (const id of order) {
            const n = getNode(src, id)!
            if (isControl(src, id, control) || n.op === NodeOp.block || n.op === NodeOp.nilEffect) continue
            let kind: number
            const position = u.positions.get(id)
            const param = u.blockOf.get(id)
            if (position !== undefined && position > 0) kind = assumed ? assumed[position - 1] : anyKinds
            else if (param !== undefined) {
                kind = 0
                if (frozen) kind = anyKinds
                for (const apply of arrivals.get(param[0]) ?? []) kind |= operandKind(apply, getNode(src, apply)!, param[1] + 1)
            } else if (n.op === NodeOp.param) kind = anyKinds
            else kind = nodeKind(id, n)
            if (kinds.get(id) === kind) continue
            kinds.set(id, kind)
            if (param !== undefined) changed = true
        }
        passes++
        if (changed && passes >= 8) frozen = true
        if (passes > 9) break
    }
    const preferred: number[] = []
    for (const [p, position] of u.positions) {
        if (!position) continue
        let demand = 0
        let tested = 0
        let open = false
        for (const [user, slot] of u.users.get(p) ?? []) {
            const n = getNode(src, user)!
            if ((binaryOps.has(n.op) || n.op === NodeOp.neg || n.op === NodeOp.not) && typeOf(n) === Types.unknown_number) demand |= Kinds.int
            else if (compareOps.has(n.op)) demand |= Kinds.int
            else if (n.op === NodeOp.rt && getLiteral(src, n, 1) === rt.Op.addOrConcat) {
                const other = operandKind(user, n, slot === 2 ? 3 : 2)
                demand |= other && !(other & ~Kinds.string) ? Kinds.string : Kinds.int
            } else if (n.op === NodeOp.rt && getLiteral(src, n, 1) === rt.Op.typeof) open = true
            else if (n.op === NodeOp.eq || n.op === NodeOp.ne) {
                const cell = constantCell(n, 1 - slot)
                if (cell === heap.undefinedHandle) tested |= nullishKinds
                else if (cell === heap.nullHandle) tested |= Kinds.null
            }
        }
        const single = demand === Kinds.int || demand === Kinds.string
        preferred[position - 1] = open || !single ? anyKinds : demand | tested
    }
    let returns = 0
    for (const [id, n] of src.nodes) {
        if (n.op === NodeOp.ret) returns |= operandKind(id, n, 0)
    }
    return { kinds, narrowed, preferred, returns }
}

function machineLike(src: Graph, reps: Map<number, number>, ref: number): boolean {
    if (reps.has(ref)) return true
    const m = getNode(src, ref)
    if (!m) return false
    if (compareOps.has(m.op) || m.op === NodeOp.eq || m.op === NodeOp.ne) return true
    if (binaryOps.has(m.op)) return typeOf(m) !== Types.unknown_number
    if (m.op === NodeOp.convert || m.op === NodeOp.bitconvert || m.op === NodeOp.load) return typeOf(m) !== Types.vm_value
    return m.op === NodeOp.typeof || m.op === NodeOp.poolEntry || machineOps.has(m.op)
}

function foldCompare(src: Graph, traced: FastTraced, kinds: KindResult, id: number, n: GraphNode): number | undefined {
    if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) return
    for (let side = 0; side < 2; side++) {
        const ref = getRef(n, side)
        const other = getRef(n, 1 - side)
        const m = ref ? getNode(src, ref) : undefined
        const o = other ? getNode(src, other) : undefined
        if (!m || !o || m.op !== NodeOp.heapHandle) continue
        const cell = getLiteral(src, m, 0)
        if (perInvocationCell(traced, cell)) continue
        if (o.op === NodeOp.rt && getLiteral(src, o, 1) === rt.Op.typeof && heap.isCell(cell as Handle) && heap.isString(heap.deref(cell as Handle))) {
            const known = typeofKinds[heap.stringToJs(heap.deref(cell as Handle))]
            if (!known) continue
            const kind = operandKindOf(kinds, src, o, other, 2)
            if (kind && !(kind & ~known[0])) return 1
            if (!(kind & known[0])) return 0
            if (!(known[0] & nullishKinds) && !(kind & ~(known[0] | nullishKinds))) return -getRef(o, 2)
            continue
        }
        const kind = operandKindOf(kinds, src, n, id, 1 - side)
        if (cell === heap.undefinedHandle) {
            if (!(kind & nullishKinds)) return 0
            if (kind && !(kind & ~nullishKinds)) return 1
        }
        if (cell === heap.nullHandle && !(kind & Kinds.null)) return 0
    }
}

function representKinds(u: Unit): number {
    const src = u.traced.graph
    const kinds = kindsOf(u)
    const g = withNodes(src, new Map(src.nodes))
    const uses = useGraph(src)
    const reps = new Map<number, number>()
    const unboxes = new Map<string, number>()
    const boxes = new Map<number, number>()
    const control = new Map<number, boolean>()
    let undefinedNode = 0
    let nullNode = 0
    let changes = 0
    const intAt = (id: number, n: GraphNode, slot: number) => intKind(operandKindOf(kinds, src, n, id, slot))
    function unboxed(ref: number, T: number): number {
        const key = `${ref}:${T}`
        let known = unboxes.get(key)
        if (known === undefined) unboxes.set(key, known = addNode(g, NodeOp.unbox, [ref], T))
        return known
    }
    function boxed(ref: number): number {
        let known = boxes.get(ref)
        if (known === undefined) boxes.set(ref, known = addNode(g, NodeOp.box, [ref], Types.vm_value))
        return known
    }
    function present(ref: number): number {
        if (!undefinedNode) undefinedNode = addNode(g, NodeOp.void, [])
        if (!nullNode) nullNode = addNode(g, NodeOp.heapHandle, [{ literal: heap.nullHandle }])
        const defined = addNode(g, NodeOp.ne, [ref, undefinedNode], Types.bool)
        const nonNull = addNode(g, NodeOp.ne, [ref, nullNode], Types.bool)
        return addNode(g, NodeOp.and, [defined, nonNull], Types.bool)
    }
    function operands(n: GraphNode, map: (slot: number, ref: number) => Operand | undefined): Operand[] | undefined {
        let changed = false
        const out: Operand[] = []
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            const next = ref ? map(i, ref) : undefined
            if (next !== undefined) changed = true
            out.push(next ?? getOperand(src, n, i))
        }
        return changed ? out : undefined
    }
    function wide(n: GraphNode, slot: number): Operand {
        const ref = getRef(n, slot)
        if (!ref) return getOperand(src, n, slot)
        const m = getNode(src, ref)!
        if (machineLike(src, reps, ref) || m.op === NodeOp.literal || m.op === NodeOp.void || m.op === NodeOp.heapHandle) return ref
        return unboxed(ref, Types.i64)
    }
    function retype(id: number, n: GraphNode, op: NodeOp, slots: number[], T: number): void {
        putNode(g, id, op, slots.map(i => wide(n, i)), T)
        reps.set(id, T)
        changes++
    }
    function truth(id: number, n: GraphNode): Operand | undefined {
        const ref = getRef(n, 0)
        if (!ref || machineLike(src, reps, ref) || getNode(src, ref)!.op === NodeOp.literal) return
        const kind = operandKindOf(kinds, src, n, id, 0)
        if (kind && !(kind & ~Kinds.boolean)) return unboxed(ref, Types.bool)
        if (intKind(kind)) return addNode(g, NodeOp.ne, [ref, { literal: 0 }], Types.bool)
        if (!kind || (kind & ~(Kinds.object | Kinds.function | nullishKinds))) return
        if (!(kind & nullishKinds)) return { literal: 1 }
        return present(ref)
    }
    const order = new Set<number>()
    for (const b of src.blocks) {
        for (const id of b.params) order.add(id)
        for (const id of blockOrder(src, b)) order.add(id)
    }
    for (const id of order) {
        const n = getNode(src, id)!
        const op = n.op
        if (op === NodeOp.param) {
            const position = uses.positions.get(id)
            if (position !== undefined && position > 0 && u.assumed?.[position - 1] === Kinds.int) reps.set(id, Types.i64)
            if (position === undefined && uses.blockOf.has(id) && intKind(kinds.kinds.get(id) ?? 0)) retype(id, n, NodeOp.param, [], Types.i64)
            continue
        }
        if (binaryOps.has(op) && typeOf(n) === Types.unknown_number) {
            if ((intOps.has(op) || bitwiseOps.has(op)) && intAt(id, n, 0) && intAt(id, n, 1)) retype(id, n, op, [0, 1], Types.i64)
            continue
        }
        if (op === NodeOp.neg || op === NodeOp.not) {
            const ref = getRef(n, 0)
            if (ref && reps.has(ref)) reps.set(id, reps.get(ref)!)
            else if (!(ref && machineLike(src, reps, ref)) && intAt(id, n, 0)) retype(id, n, op, [0], Types.i64)
            continue
        }
        if (op === NodeOp.rt) {
            const rtOp = getLiteral(src, n, 1)
            if (rtOp === rt.Op.addOrConcat && intAt(id, n, 2) && intAt(id, n, 3)) retype(id, n, NodeOp.add, [2, 3], Types.i64)
            else if (rtOp === rt.Op.addOrConcat && (stringKind(operandKindOf(kinds, src, n, id, 2)) || stringKind(operandKindOf(kinds, src, n, id, 3)))) {
                const next: Operand[] = []
                for (let i = 0; i < countIds(n); i++) next.push(i === 1 ? { literal: rt.Op.concat } : getOperand(src, n, i))
                putCopy(g, id, n, next)
                changes++
            } else if (rtOp === rt.Op.sliceRead && (getLiteral(src, n, 4) === Types.i64 || getLiteral(src, n, 4) === Types.f64)) reps.set(id, getLiteral(src, n, 4))
            continue
        }
        if (op === NodeOp.call) {
            if (u.routes.get(id)?.version.contract.returnsInt) reps.set(id, Types.i64)
            continue
        }
        if (op === NodeOp.after) {
            const last = getRef(n, countIds(n) - 1)
            if (last && reps.has(last)) reps.set(id, reps.get(last)!)
            continue
        }
        if (op === NodeOp.select) {
            const cond = truth(id, n)
            if (cond !== undefined) {
                const next: Operand[] = [cond]
                for (let i = 1; i < countIds(n); i++) next.push(getOperand(src, n, i))
                putCopy(g, id, n, next)
                changes++
            }
            if (isControl(src, id, control)) continue
            const first = getRef(n, 1)
            let T = first ? reps.get(first) : undefined
            for (let i = 1; i < countIds(n) && T !== undefined; i++) {
                if (reps.get(getRef(n, i)) !== T) T = undefined
            }
            if (T !== undefined) reps.set(id, T)
            continue
        }
        if (!compareOps.has(op) && op !== NodeOp.eq && op !== NodeOp.ne) continue
        const folded = foldCompare(src, u.traced, kinds, id, n)
        if (folded !== undefined && folded < 0) {
            const subject = reps.has(-folded) ? boxed(-folded) : -folded
            putNode(g, id, NodeOp.eq, [present(subject), { literal: op === NodeOp.eq ? 1 : 0 }], Types.bool)
            changes++
            continue
        }
        if (folded !== undefined) {
            putNode(g, id, NodeOp.literal, [{ literal: folded === (op === NodeOp.eq ? 1 : 0) ? 1 : 0 }], Types.bool)
            changes++
            continue
        }
        const int = intAt(id, n, 0) && intAt(id, n, 1)
        const next = operands(n, (slot, ref) => {
            if (int) return wide(n, slot) === ref ? undefined : wide(n, slot)
            return reps.has(ref) ? boxed(ref) : undefined
        })
        if (!next) continue
        putCopy(g, id, n, next)
        changes++
    }
    const returnsInt = !!u.contract?.returnsInt
    for (const [id, n] of src.nodes) {
        let slots: number[] = []
        if (n.op === NodeOp.apply) {
            const params = src.blockIndex.get(getRef(n, 0))?.params ?? []
            for (let i = 1; i < countIds(n); i++) {
                if (reps.get(params[i - 1]) === Types.i64) slots.push(i)
            }
        } else if (n.op === NodeOp.call) {
            const c = u.routes.get(id)?.version.contract
            for (let k = 1; c && k < c.params.length && k + 2 < countIds(n); k++) {
                if (c.params[k].kind === Kinds.int) slots.push(k + 2)
            }
        } else if (n.op === NodeOp.ret && returnsInt) slots = [0]
        if (!slots.length) continue
        const next = operands(n, (slot, ref) => slots.includes(slot) && wide(n, slot) !== ref ? wide(n, slot) : undefined)
        if (!next) continue
        putCopy(g, id, n, next)
        changes++
    }
    count(u.p, 'kinds:retyped', reps.size)
    count(u.p, 'kinds:unboxes', unboxes.size)
    count(u.p, 'kinds:boxes', boxes.size)
    if (!changes && !unboxes.size && !boxes.size) return 0
    rewrite(u, g)
    return changes
}

function fastCalls(u: Unit): number {
    const p = u.p
    if (!enabled(p, 'kinds') || !hasOp(u.traced.graph, callOps)) return 0
    const src = u.traced.graph
    const kinds = kindsOf(u)
    const decided: [call: number, c: Contract][] = []
    for (const [id, n] of src.nodes) {
        if (n.op !== NodeOp.call || (n.flags & NodeFlags.spread)) continue
        const known = u.routes.get(id)
        const unit = known ? known.version.contract.unit : p.host.direct(u.traced, n)
        if (!unit) continue
        const s = summaryOf(p, unit)
        if (!s?.fast) continue
        const argKinds: number[] = []
        for (let i = 3; i < countIds(n); i++) argKinds.push(operandKindOf(kinds, src, n, id, i))
        if (!known) {
            if (!matchesFast(s, argKinds)) continue
            const bound = p.host.bound(unit, argKinds.length)
            if (bound !== undefined && bound !== unit) continue
            decided.push([id, fastContract(p, unit)!])
            continue
        }
        const c = copyContract(known.version.contract)
        let changed = false
        for (let k = 0; k < s.params && k < argKinds.length && k + 1 < c.params.length; k++) {
            if (s.preferred[k] !== Kinds.int || c.params[k + 1].kind === Kinds.int || !intKind(argKinds[k])) continue
            c.params[k + 1].kind = Kinds.int
            changed = true
        }
        if (changed) decided.push([id, c])
    }
    for (const [id, c] of decided) {
        const cell = u.routes.get(id)?.cell ?? 0
        u.routes.set(id, { version: versionOf(p, c), cell })
    }
    return decided.length
}

export interface Desc {
    layout: Layout | undefined
    params: number[]
    calls: number[]
}

export interface LocalShapes {
    descs: Map<number, Desc | null>
    births: Set<number>
    born: Map<number, number>
    rets: Desc | null
    calls: number[]
    sites: number
    allocs: number
}

export interface CallFacts {
    returns: Desc | null
    params: (Layout | undefined)[] | undefined
}

export interface UnitFacts {
    returns: Desc | null
    params: (Layout | undefined)[]
}

const slotWidth = 4
const orderedOps = new Set<NodeOp>([NodeOp.getProp, NodeOp.setProp, NodeOp.call, NodeOp.rt, NodeOp.load, NodeOp.store, NodeOp.trap, NodeOp.ret, NodeOp.panic])
const atomLimit = 4

const keyNames = new Map<number, string | undefined>()

function keyName(key: number): string | undefined {
    if (keyNames.has(key)) return keyNames.get(key)
    let name: string | undefined
    if (heap.isCell(key as Handle) && heap.keyIndex(key as Handle) === undefined) {
        const described = heap.describeKey(key as Handle)
        if (described !== undefined) name = described.startsWith('.') ? described : `#${key}`
    }
    keyNames.set(key, name)
    return name
}

function commonPrefix(a: Layout | undefined, b: Layout | undefined): Layout | undefined {
    if (!a) return b
    if (!b) return a
    let i = 0
    while (i < a.length && i < b.length && a[i] === b[i]) i++
    if (i === a.length) return a
    if (i === b.length) return b
    return a.slice(0, i)
}

function covers(have: Layout | undefined, need: Layout): boolean {
    if (!have || have.length < need.length) return false
    let i = 0
    while (i < need.length) {
        if (have[i] !== need[i]) return false
        i++
    }
    return true
}

function union(a: number[], b: number[]): number[] | undefined {
    if (!b.length) return a
    if (!a.length) return b
    const out = a.slice()
    for (const x of b) {
        if (!out.includes(x)) out.push(x)
    }
    return out.length > atomLimit ? undefined : out
}

function merge(a: Desc | null | undefined, b: Desc | null | undefined): Desc | null | undefined {
    if (a === undefined) return b
    if (b === undefined) return a
    if (a === null || b === null) return null
    const layout = commonPrefix(a.layout, b.layout)
    if (layout && !layout.length) return null
    const params = union(a.params, b.params)
    const calls = union(a.calls, b.calls)
    if (!params || !calls) return null
    return { layout, params, calls }
}

function sameDesc(a: Desc | null | undefined, b: Desc | null | undefined): boolean {
    if (a === b) return true
    if (!a || !b) return false
    if (a.params.length !== b.params.length || a.calls.length !== b.calls.length) return false
    if ((a.layout?.length ?? -1) !== (b.layout?.length ?? -1)) return false
    for (let i = 0; i < a.params.length; i++) {
        if (a.params[i] !== b.params[i]) return false
    }
    for (let i = 0; i < a.calls.length; i++) {
        if (a.calls[i] !== b.calls[i]) return false
    }
    return true
}

interface Found {
    proxy: number
    accessor: boolean
    writable: boolean
    slot: number
}

function lookup(proto: number, key: number): Found | undefined {
    let at = proto
    while (at) {
        const state = heap.deref(at as Handle)
        const d = heap.getOwnProperty(state, key as Handle)
        if (d) {
            const full = heap.FullPropertyDescriptor(heap.resolveHeapCell(d))
            return { proxy: 0, accessor: !!(full.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)), writable: !!(full.flags & heap.PropFlags.writable), slot: full.slot0 as number }
        }
        if (heap.isProxy(state) && heap.trapsKey(state, key as Handle)) return { proxy: state, accessor: false, writable: false, slot: 0 }
        at = heap.getPrototypeOf(state)
    }
}

type Allocations = Map<u32, { token: number | undefined, call: number | undefined }>

function allocationNodes(src: Graph, allocations: Allocations): Map<number, [cell: number, token: number]> {
    const counts = new Map<number, number>()
    for (const n of src.nodes.values()) {
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(src, n, 0)
        if (allocations.has(cell as u32)) counts.set(cell, (counts.get(cell) ?? 0) + 1)
    }
    const out = new Map<number, [cell: number, token: number]>()
    for (const [id, n] of src.nodes) {
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(src, n, 0)
        const allocation = allocations.get(cell as u32)
        if (!allocation || allocation.call !== undefined || counts.get(cell) !== 1) continue
        out.set(id, [cell, allocation.token ?? 0])
    }
    return out
}

function birthsOf(src: Graph, users: Map<number, [user: number, slot: number][]>, id: number, token: number, proto: number, births: Set<number>): [keys: Layout, head: number] {
    const keys: Layout = []
    let head = token
    let stepped = true
    while (head && stepped) {
        stepped = false
        let next = 0
        let forks = 0
        for (const [user, slot] of users.get(head) ?? []) {
            const op = getNode(src, user)!.op
            if (op === NodeOp.after || (slot === 0 && orderedOps.has(op))) {
                forks++
                next = user
            }
        }
        if (forks !== 1) break
        for (const [user, slot] of users.get(head) ?? []) {
            const n = getNode(src, user)!
            if (user !== next || slot !== 0 || n.op !== NodeOp.setProp || getRef(n, 1) !== id || getRef(n, 2)) continue
            const key = getLiteral(src, n, 2)
            const name = keyName(key)
            if (!name || (proto && lookup(proto, key))) continue
            births.add(user)
            if (!keys.includes(name)) keys.push(name)
            head = user
            stepped = true
            break
        }
    }
    return [keys, head]
}

type Constructed = (cell: number, call: number) => Layout | undefined

export function localShapes(src: Graph, allocations: Allocations, constructed?: Constructed): LocalShapes {
    const u = useGraph(src)
    const users = u.users
    const births = new Set<number>()
    const born = new Map<number, number>()
    const siteLayouts = new Map<number, Layout>()
    const allocated = allocationNodes(src, allocations)
    for (const [id, [cell, token]] of allocated) {
        const [keys, head] = birthsOf(src, users, id, token, heap.getPrototypeOf(heap.deref(cell as Handle)), births)
        if (!keys.length) continue
        siteLayouts.set(id, keys)
        born.set(id, head)
    }
    for (const [cell, allocation] of allocations) {
        const layout = allocation.call !== undefined && constructed ? constructed(cell, allocation.call) : undefined
        if (layout) siteLayouts.set(allocation.call!, layout)
    }
    const control = new Map<number, boolean>()
    const descs = new Map<number, Desc | null>()
    const order = new Set<number>()
    for (const b of src.blocks) {
        for (const id of b.params) order.add(id)
        for (const id of blockOrder(src, b)) order.add(id)
    }
    function operandDesc(n: GraphNode, slot: number): Desc | null | undefined {
        const ref = getRef(n, slot)
        if (!ref) return null
        return descs.has(ref) ? descs.get(ref) : undefined
    }
    function compute(id: number, n: GraphNode): Desc | null | undefined {
        const layout = siteLayouts.get(id)
        if (layout) return { layout, params: [], calls: [] }
        const at = u.positions.get(id)
        if (at !== undefined) return { layout: undefined, params: [at], calls: [] }
        const param = u.blockOf.get(id)
        if (param !== undefined) {
            let out: Desc | null | undefined = undefined
            for (const apply of u.arrivals.get(param[0]) ?? []) {
                out = merge(out, operandDesc(getNode(src, apply)!, param[1] + 1))
                if (out === null) break
            }
            return out
        }
        if (n.op === NodeOp.after) return operandDesc(n, countIds(n) - 1)
        if (n.op === NodeOp.call) return { layout: undefined, params: [], calls: [id] }
        if (n.op === NodeOp.select && !isControl(src, id, control)) {
            let out: Desc | null | undefined = undefined
            for (let i = 1; i < countIds(n); i++) {
                out = merge(out, operandDesc(n, i))
                if (out === null) break
            }
            return out
        }
        return null
    }
    let changed = true
    let rounds = 0
    while (changed && rounds < 8) {
        changed = false
        rounds++
        for (const id of order) {
            const n = getNode(src, id)!
            const next = compute(id, n)
            if (next === undefined) continue
            if (descs.has(id) && sameDesc(descs.get(id), next)) continue
            descs.set(id, next)
            if (u.blockOf.has(id)) changed = true
        }
    }
    if (changed) {
        for (const id of u.blockOf.keys()) descs.set(id, null)
        for (const id of order) {
            if (u.blockOf.has(id)) continue
            const next = compute(id, getNode(src, id)!)
            descs.set(id, next === undefined ? null : next)
        }
    }
    let rets: Desc | null | undefined = undefined
    const calls: number[] = []
    for (const [id, n] of src.nodes) {
        if (n.op === NodeOp.call) calls.push(id)
        if (n.op !== NodeOp.ret) continue
        rets = merge(rets, operandDesc(n, 0) ?? null)
    }
    return { descs, births, born, rets: rets ?? null, calls, sites: siteLayouts.size, allocs: allocated.size }
}

function makeResolver(src: Graph, local: LocalShapes, facts: (call: number) => CallFacts | undefined) {
    const memo = new Map<number, Desc | null>()
    const active = new Set<number>()
    function argDesc(call: number, position: number): Desc | null {
        const n = getNode(src, call)!
        const at = position + 2
        if (at >= countIds(n) || !getRef(n, at)) return null
        return local.descs.get(getRef(n, at)) ?? null
    }
    function resolveCall(call: number): Desc | null {
        if (memo.has(call)) return memo.get(call)!
        if (active.has(call)) return null
        active.add(call)
        let out: Desc | null = null
        const returns = facts(call)?.returns
        if (returns) {
            let acc: Desc | null | undefined = { layout: returns.layout, params: [], calls: [] }
            for (const i of returns.params) {
                acc = merge(acc, resolve(argDesc(call, i)))
                if (acc === null) break
            }
            out = acc ?? null
        }
        active.delete(call)
        memo.set(call, out)
        return out
    }
    function resolve(desc: Desc | null | undefined): Desc | null {
        if (!desc) return null
        let acc: Desc | null | undefined = { layout: desc.layout, params: desc.params, calls: [] }
        for (const call of desc.calls) {
            acc = merge(acc, resolveCall(call))
            if (acc === null) return null
        }
        return acc ?? null
    }
    function concrete(desc: Desc | null | undefined, params: (Layout | undefined)[] | undefined): Layout | undefined {
        const resolved = resolve(desc)
        if (!resolved) return
        let layout = resolved.layout
        for (const i of resolved.params) {
            const known = params?.[i]
            if (!known) return
            layout = commonPrefix(layout, known)
        }
        return layout && layout.length ? layout : undefined
    }
    return { resolve, concrete, argDesc }
}

function layoutParams(p: Optimizer, fn: Function): number {
    const signature = p.host.signature(fn)
    if (!signature || signature.rest) return 0
    return signature.params + 1
}

function planLayouts(p: Optimizer): void {
    keyNames.clear()
    const graph = p.calls
    const locals = new Map<Function, [Graph, LocalShapes]>()
    const returns = calleesFirst<Function, Desc | null>(graph, (unit, outer) => {
        const traced = p.host.trace(unit)
        if (!traced) return null
        const local = localShapes(traced.graph, traced.allocations, (cell, call) => constructedLayout(p, traced, cell, call))
        locals.set(unit, [traced.graph, local])
        count(p, 'layouts:sites', local.sites)
        const resolver = makeResolver(traced.graph, local, call => {
            const known = outer(call)
            return known === undefined ? undefined : { returns: known, params: undefined }
        })
        const out = resolver.resolve(local.rets)
        return out && (out.layout || out.params.length) ? out : null
    })
    const params = callersFirst<Function, Layout>(graph, unit => layoutParams(p, unit), (unit, agreed) => {
        const found = locals.get(unit)
        if (!found) return
        const callees = graph.callees.get(unit)
        const component = graph.component.get(unit)
        const resolver = makeResolver(found[0], found[1], call => {
            const callee = callees?.get(call)
            if (callee === undefined || graph.component.get(callee) === component) return
            return { returns: returns.get(callee) ?? null, params: undefined }
        })
        return (call, k) => resolver.concrete(resolver.argDesc(call, k), agreed)
    }, (a, b) => {
        const joined = commonPrefix(a, b)!
        return joined.length ? joined : undefined
    })
    for (const unit of graph.order) {
        const facts: UnitFacts = { returns: returns.get(unit) ?? null, params: params.get(unit) ?? [] }
        p.layouts.set(unit, facts)
        if (facts.returns) count(p, 'layouts:known-returns')
        if (facts.params.some(p => p)) count(p, 'layouts:known-params')
        if (facts.returns || facts.params.some(p => p)) p.planned = true
    }
}

interface ReceiverUse {
    keys: string[]
    methods: boolean
}

function receiverUse(p: Optimizer, fn: Function): ReceiverUse {
    const known = p.receivers.get(fn)
    if (known) return known
    const out: ReceiverUse = { keys: [], methods: false }
    p.receivers.set(fn, out)
    const traced = p.host.trace(fn)
    if (!traced) return out
    const src = traced.graph
    const self = src.blocks[0].params.find(id => isThisParam(getNode(src, id)!))
    if (self === undefined) return out
    for (const n of src.nodes.values()) {
        if (n.op === NodeOp.call && strip(src, getRef(n, 2)) === self && getNode(src, getRef(n, 1))?.op === NodeOp.getProp) out.methods = true
        if ((n.op !== NodeOp.getProp && n.op !== NodeOp.setProp) || getRef(n, 2) || strip(src, getRef(n, 1)) !== self) continue
        const name = keyName(getLiteral(src, n, 2))
        if (name !== undefined && !out.keys.includes(name)) out.keys.push(name)
    }
    return out
}

function receiverCalls(p: Optimizer, traced: FastTraced): boolean {
    for (const n of traced.graph.nodes.values()) {
        if (n.op !== NodeOp.call || !getRef(n, 2)) continue
        const unit = calleeOf(p, traced, n)
        if (unit && receiverUse(p, unit).keys.length) return true
    }
    return false
}

function receiverLayout(p: Optimizer, fn: Function, have: Layout | undefined): Layout | undefined {
    if (!have) return
    let last = -1
    for (const name of receiverUse(p, fn).keys) last = Math.max(last, have.indexOf(name))
    return last < 0 ? undefined : have.slice(0, last + 1)
}

function constructedLayout(p: Optimizer, traced: FastTraced, cell: number, call: number): Layout | undefined {
    const src = traced.graph
    const n = getNode(src, call)
    const receiver = n?.op === NodeOp.call ? getNode(src, strip(src, getRef(n, 2))) : undefined
    if (receiver?.op !== NodeOp.heapHandle || getLiteral(src, receiver, 0) !== cell) return
    const unit = calleeOf(p, traced, n!)
    if (!unit) return
    const proto = heap.getPrototypeOf(heap.deref(cell as Handle))
    let byProto = p.constructed.get(unit)
    if (!byProto) p.constructed.set(unit, byProto = new Map())
    if (byProto.has(proto)) return byProto.get(proto) ?? undefined
    byProto.set(proto, null)
    const inner = p.host.trace(unit)
    if (!inner) return
    const g = inner.graph
    const self = g.blocks[0].params.find(id => isThisParam(getNode(g, id)!))
    let entry = 0
    for (const [id, m] of g.nodes) {
        if (m.op === NodeOp.nilEffect && getRef(m, 0) === g.blocks[0].id) entry = id
    }
    if (self === undefined || !entry) return
    for (const m of g.nodes.values()) {
        if (m.op === NodeOp.ret && strip(g, getRef(m, 0)) !== self) return
    }
    const [keys] = birthsOf(g, useGraph(g).users, self, entry, proto, new Set())
    if (!keys.length) return
    byProto.set(proto, keys)
    count(p, 'layouts:constructors')
    return keys
}

function callFacts(p: Optimizer, traced: FastTraced, call: number): CallFacts | undefined {
    const n = getNode(traced.graph, call)
    if (!n) return
    const unit = calleeOf(p, traced, n)
    if (!unit) return
    const facts = p.layouts.get(unit) ?? demandFacts(p, unit)
    return { returns: facts.returns, params: facts.params.some(p => p) ? facts.params : undefined }
}

function demandFacts(p: Optimizer, unit: Function): UnitFacts {
    const facts: UnitFacts = { returns: null, params: [] }
    p.layouts.set(unit, facts)
    const traced = p.host.trace(unit)
    if (!traced) return facts
    const local = localShapes(traced.graph, traced.allocations, (cell, call) => constructedLayout(p, traced, cell, call))
    const out = makeResolver(traced.graph, local, call => callFacts(p, traced, call)).resolve(local.rets)
    if (out && (out.layout || out.params.length)) facts.returns = out
    count(p, 'layouts:demanded')
    return facts
}

function freshReceiver(traced: FastTraced, ref: number): boolean {
    const n = getNode(traced.graph, strip(traced.graph, ref))
    return n?.op === NodeOp.heapHandle && perInvocationCell(traced, getLiteral(traced.graph, n, 0))
}

function numericName(name: string): boolean {
    const text = name.slice(1)
    return name.startsWith('.') && String(Number(text)) === text
}

function indexWrites(p: Optimizer): void {
    const w = p.writes
    const units = p.host.units(w.seen)
    w.seen += units.length
    for (const [fn, traced] of units) {
        if (traced) noteWrites(p, fn, traced)
    }
}

function noteWrites(p: Optimizer, fn: Function, traced: FastTraced): void {
    const src = traced.graph
    const w = p.writes
    function written(name: string): void {
        intrinsics.assert(!w.folded.has(name), `program-optimizer: ${fn.name} writes ${name}, which was folded`)
        w.keys.add(name)
    }
    function defined(name: string): void {
        intrinsics.assert(!w.folded.has(name) && !w.sealed.has(name), `program-optimizer: ${fn.name} defines ${name}, which was folded`)
        w.defined.add(name)
    }
    function poison(why: string): void {
        intrinsics.assert(!w.folded.size, `program-optimizer: ${fn.name} writes unknown keys (${why}) after folding`)
        if (!w.poison) w.poison = why
    }
    function hard(why: string): void {
        intrinsics.assert(!w.folded.size && !w.sealed.size, `program-optimizer: ${fn.name} redefines objects (${why}) after folding`)
        if (!w.hard) w.hard = why
    }
    function dynamicKey(id: number, n: GraphNode, slot: number): void {
        const m = getNode(src, strip(src, getRef(n, slot)))
        if (m?.op === NodeOp.heapHandle && !getRef(m, 0)) {
            const cell = getLiteral(src, m, 0)
            const name = keyName(cell)
            if (name !== undefined) return written(name)
            if (heap.keyIndex(cell as Handle) !== undefined) return
            if (!heap.isBoxedF64(cell as Handle)) return poison('key')
        } else {
            const coarse = summaryOf(p, fn)?.coarse
            const kind = coarse ? operandKindOf(coarse, src, n, id, slot) : anyKinds
            if (!kind || kind & ~numberKinds) return poison(opName(n.op))
        }
        for (const name of w.folded) intrinsics.assert(!numericName(name), `program-optimizer: ${fn.name} writes numeric keys after folding ${name}`)
        w.numeric = true
    }
    function write(id: number, n: GraphNode, object: number, key: number): void {
        if (freshReceiver(traced, getRef(n, object))) return
        if (getRef(n, key)) return dynamicKey(id, n, key)
        const literal = getLiteral(src, n, key)
        const name = keyName(literal)
        if (name !== undefined) written(name)
        else if (heap.keyIndex(literal as Handle) === undefined) poison('literal')
    }
    function define(n: GraphNode): void {
        if (freshReceiver(traced, getRef(n, 2))) return
        const m = getRef(n, 3) ? getNode(src, strip(src, getRef(n, 3))) : undefined
        const key = !getRef(n, 3) ? getLiteral(src, n, 3) : m?.op === NodeOp.heapHandle && !getRef(m, 0) ? getLiteral(src, m, 0) : 0
        const name = key ? keyName(key) : undefined
        if (name === undefined) hard('defineAccessor')
        else defined(name)
    }
    for (const [id, n] of src.nodes) {
        if (n.op === NodeOp.setProp) write(id, n, 1, 2)
        if (n.op !== NodeOp.rt) continue
        const op = getLiteral(src, n, 1)
        if (op === rt.Op.setprop) write(id, n, 2, 3)
        else if (op === rt.Op.defineAccessor) define(n)
        else if ((op === rt.Op.assign || op === rt.Op.copyDataProperties || op === rt.Op.setPrototypeOf) && !freshReceiver(traced, getRef(n, 2))) hard(rt.opName(op))
        const impl = rt.bindingOf(op)?.impl
        if (!impl || w.impls.has(impl)) continue
        w.impls.add(impl)
        const inner = p.host.trace(impl)
        if (inner) noteWrites(p, impl, inner)
    }
}

function constantObject(traced: FastTraced, cell: number): boolean {
    if (!heap.isCell(cell as Handle) || heap.isOddballHandle(cell as Handle) || heap.isBoxedF64(cell as Handle) || perInvocationCell(traced, cell)) return false
    if (heap.isFrameProxy(cell as Handle) || heap.isTypeDescriptor(cell as Handle) || heap.isArray(cell as Handle)) return false
    const state = heap.deref(cell as Handle)
    return !heap.isString(state) && !heap.isProxy(state)
}

function foldableSlot(traced: FastTraced, slot: number): boolean {
    if (!slot) return false
    if (heap.isBoxedF64(slot as Handle)) return !heap.boxedNanId(slot as Handle)
    return heap.isCell(slot as Handle) && !perInvocationCell(traced, slot)
}

function constantReads(u: Unit): number {
    const p = u.p
    const w = p.writes
    if (w.hard) return 0
    const src = u.traced.graph
    const folds = new Map<number, number>()
    let sealed = 0
    function constantAt(ref: number): number {
        const id = strip(src, ref)
        const m = getNode(src, id)
        if (m?.op === NodeOp.heapHandle && !getRef(m, 0)) return getLiteral(src, m, 0)
        return m?.op === NodeOp.getProp ? fold(id, m) : 0
    }
    function fold(id: number, n: GraphNode): number {
        const known = folds.get(id)
        if (known !== undefined) return known
        folds.set(id, 0)
        if (getRef(n, 2)) return 0
        const key = getLiteral(src, n, 2)
        const name = keyName(key)
        if (name === undefined || w.defined.has(name)) return 0
        const cell = constantAt(getRef(n, 1))
        if (!cell || !constantObject(u.traced, cell)) return 0
        const found = dataSlot(cell, key)
        if (!found || !foldableSlot(u.traced, found.slot)) return 0
        if (found.writable && (w.poison || w.keys.has(name) || (w.numeric && numericName(name)))) return 0
        if (found.writable) w.folded.add(name)
        else {
            w.sealed.add(name)
            sealed++
        }
        folds.set(id, found.slot)
        return found.slot
    }
    for (const [id, n] of src.nodes) {
        if (n.op === NodeOp.getProp) fold(id, n)
    }
    for (const [id, slot] of folds) {
        if (!slot) folds.delete(id)
    }
    if (!folds.size) return 0
    const g = withNodes(src, new Map(src.nodes))
    const values = new Map<number, number>()
    for (const [id, slot] of folds) {
        let value = values.get(slot)
        if (value === undefined) values.set(slot, value = addNode(g, NodeOp.heapHandle, [{ literal: slot }]))
        putNode(g, id, NodeOp.after, [getOperand(src, getNode(src, id)!, 0), value])
    }
    let calls = 0
    for (const [id, n] of src.nodes) {
        if (n.op !== NodeOp.call || !folds.has(getRef(n, 1))) continue
        const operands: Operand[] = []
        for (let i = 0; i < countIds(n); i++) operands.push(i === 1 ? values.get(folds.get(getRef(n, 1))!)! : getOperand(src, n, i))
        putCopy(g, id, n, operands)
        calls++
    }
    count(p, 'constants:reads', folds.size)
    count(p, 'constants:sealed', sealed)
    count(p, 'constants:calls', calls)
    rewrite(u, g)
    return folds.size
}

interface StackOrigin {
    id: number
    token: number
    keys: Layout
    accesses: number[]
    params: number[]
}

function deadObjects(u: Unit): number {
    const src = u.traced.graph
    const roots = new Map<number, number[]>()
    for (const [id, n] of src.nodes) {
        if (n.op === NodeOp.rt && rt.allocOps.has(getLiteral(src, n, 1))) roots.set(-id, [id])
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(src, n, 0)
        if (!u.traced.allocations.has(cell as u32)) continue
        const known = roots.get(cell)
        if (known) known.push(id)
        else roots.set(cell, [id])
    }
    if (!roots.size) return 0
    const uses = useGraph(src)
    const dead = new Map<number, number>()
    for (const members of roots.values()) {
        const writes: number[] = []
        const w = walkUses(uses, members, (walk, user, slot, n) => {
            const write = (n.op === NodeOp.setProp && slot === 1 && !walk.member(getRef(n, 2)) && !walk.member(getRef(n, 3))) || (n.op === NodeOp.rt && slot === 2 && rt.targetWriteOps.has(getLiteral(src, n, 1)) && !walk.member(getRef(n, 3)) && !walk.member(getRef(n, 4)))
            if (!write) {
                walk.fail(opName(n.op))
                return
            }
            writes.push(user)
        })
        if (w.escape) {
            count(u.p, `dead:escape:${w.escape}`)
            continue
        }
        if (w.merged.length) {
            count(u.p, 'dead:escape:merge')
            continue
        }
        let ok = true
        for (const m of w.members) {
            const n = getNode(src, m)!
            if (n.op === NodeOp.after && countIds(n) !== 2) ok = false
        }
        if (!ok) {
            count(u.p, 'dead:escape:after')
            continue
        }
        for (const m of w.members) {
            const n = getNode(src, m)!
            if (n.op === NodeOp.rt || n.op === NodeOp.after) dead.set(m, getRef(n, 0))
        }
        for (const id of writes) dead.set(id, getRef(getNode(src, id)!, 0))
        count(u.p, 'dead:objects')
        count(u.p, 'dead:writes', writes.length)
    }
    if (!dead.size) return 0
    function live(ref: number): number {
        let at = ref
        while (dead.has(at)) at = dead.get(at)!
        return at
    }
    const g = withNodes(src, new Map(src.nodes))
    for (const id of dead.keys()) deleteNode(g, id)
    for (const [id, n] of src.nodes) {
        if (dead.has(id)) continue
        let changed = false
        const operands: Operand[] = []
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (ref && dead.has(ref)) {
                const to = live(ref)
                intrinsics.assert(!!to, `dead: ${src.name} ${id} loses its token`)
                operands.push(to)
                changed = true
                continue
            }
            operands.push(getOperand(src, n, i))
        }
        if (changed) putCopy(g, id, n, operands)
    }
    rewrite(u, g)
    return dead.size
}

function stackRecords(u: Unit): number {
    const src = u.traced.graph
    const candidates: [id: number, token: number][] = []
    for (const [id, [cell, token]] of allocationNodes(src, u.traced.allocations)) {
        if (!heap.getPrototypeOf(heap.deref(cell as Handle))) candidates.push([id, token])
    }
    if (!candidates.length) return 0
    const uses = useGraph(src)
    const origins: StackOrigin[] = []
    for (const [id, token] of candidates) {
        const o: StackOrigin = { id, token, keys: [], accesses: [], params: [] }
        const w = walkUses(uses, [id], (walk, user, slot, n) => {
            const name = (n.op === NodeOp.getProp || n.op === NodeOp.setProp) && slot === 1 && !getRef(n, 2) ? keyName(getLiteral(src, n, 2)) : undefined
            if (name === undefined) {
                walk.fail(opName(n.op))
                return
            }
            if (!o.keys.includes(name)) o.keys.push(name)
            o.accesses.push(user)
        })
        if (w.escape) continue
        o.params = w.merged
        origins.push(o)
    }
    if (!origins.length) return 0
    const g = withNodes(src, new Map(src.nodes))
    let entryToken = 0
    let undefinedValue = 0
    let looseToken = 0
    for (const o of origins) {
        if (!o.token && !entryToken) entryToken = addNode(g, NodeOp.nilEffect, [g.root])
        if (!undefinedValue) undefinedValue = addNode(g, NodeOp.void, [])
        if (!looseToken) looseToken = addNode(g, NodeOp.nilEffect, [])
        const record = addNode(g, NodeOp.alloca, [looseToken, { literal: Math.max(1, o.keys.length) * slotWidth }, { literal: 8 }])
        let last: number = o.token || entryToken
        for (let i = 0; i < o.keys.length; i++) last = addNode(g, NodeOp.store, [last, record, { literal: i * slotWidth }, undefinedValue], Types.vm_value)
        putNode(g, o.id, NodeOp.after, [last, record])
        for (const p of o.params) putNode(g, p, NodeOp.param, [], Types.ptr)
        for (const access of o.accesses) {
            const n = getNode(src, access)!
            const offset = { literal: o.keys.indexOf(keyName(getLiteral(src, n, 2))!) * slotWidth }
            if (n.op === NodeOp.getProp) putNode(g, access, NodeOp.load, [getOperand(src, n, 0), getOperand(src, n, 1), offset], Types.vm_value)
            else putNode(g, access, NodeOp.store, [getOperand(src, n, 0), getOperand(src, n, 1), offset, getOperand(src, n, 3)], Types.vm_value)
        }
    }
    rewrite(u, g)
    return origins.length
}

export function isRecordParam(n: GraphNode | undefined): boolean {
    return !!n && n.op === NodeOp.param && typeOf(n) === Types.ptr
}

function fieldLayouts(u: Unit): number {
    const p = u.p
    const src = u.traced.graph
    const params = u.contract ? u.contract.params.map(p => p.layout) : undefined
    const triggered = !!params?.some(p => p) || (p.planned && hasOp(src, callOps)) || allocationNodes(src, u.traced.allocations).size > 0 || receiverCalls(p, u.traced)
    if (!triggered) return 0
    const local = localShapes(src, u.traced.allocations, (cell, call) => constructedLayout(p, u.traced, cell, call))
    const resolver = makeResolver(src, local, call => callFacts(p, u.traced, call))
    const known = new Map<number, Layout | undefined>()
    function layoutOf(ref: number): Layout | undefined {
        if (known.has(ref)) return known.get(ref)
        const out = resolver.concrete(local.descs.get(ref), params)
        known.set(ref, out)
        return out
    }
    const g = withNodes(src, new Map(src.nodes))
    let changes = 0
    const ordered = new Map<number, number>()
    for (const [origin, last] of local.born) {
        if (u.ordered.has(origin)) continue
        u.ordered.add(origin)
        ordered.set(origin, addNode(g, NodeOp.after, [last, origin]))
    }
    if (ordered.size) {
        changes += ordered.size
        for (const [id, n] of src.nodes) {
            if (local.births.has(id)) continue
            let changed = false
            const operands: Operand[] = []
            for (let i = 0; i < countIds(n); i++) {
                const replaced = ordered.get(getRef(n, i))
                if (replaced !== undefined) changed = true
                operands.push(replaced ?? getOperand(src, n, i))
            }
            if (changed) putCopy(g, id, n, operands)
        }
    }
    const offsets = heap.ownEntryOffsets
    const w = p.writes
    let looseToken = 0
    let fixed = 0
    let stores = 0
    for (const [id, n] of src.nodes) {
        if ((n.op !== NodeOp.getProp && n.op !== NodeOp.setProp) || local.births.has(id)) continue
        const object = getRef(n, 1)
        if (!object || getRef(n, 2)) continue
        const layout = layoutOf(object)
        if (!layout) continue
        const name = keyName(getLiteral(src, n, 2))
        const index = name === undefined ? -1 : layout.indexOf(name)
        if (index < 0) continue
        if (n.op === NodeOp.setProp && (!enabled(p, 'constants') || w.hard || w.defined.has(name!))) continue
        if (!looseToken) looseToken = addNode(g, NodeOp.nilEffect, [])
        const handle = addNode(g, NodeOp.rt, [looseToken, { literal: rt.Op.handleof }, getOperand(g, getNode(g, id)!, 1)])
        let address = addNode(g, NodeOp.rt, [looseToken, { literal: rt.Op.heapaddr }, handle])
        const steps = [offsets.properties, offsets.entries, index * offsets.entrySize + offsets.descriptor]
        for (const step of steps) {
            const cell = addNode(g, NodeOp.load, [looseToken, address, { literal: step }], Types.u32)
            address = addNode(g, NodeOp.rt, [looseToken, { literal: rt.Op.heapaddr }, cell])
        }
        if (n.op === NodeOp.getProp) {
            putNode(g, id, NodeOp.load, [getOperand(src, n, 0), address, { literal: offsets.value }], Types.vm_value)
            fixed++
            continue
        }
        putNode(g, id, NodeOp.store, [getOperand(src, n, 0), address, { literal: offsets.value }, getOperand(g, getNode(g, id)!, 3)], Types.vm_value)
        stores++
    }
    changes += fixed + stores
    count(p, 'layouts:fixed', fixed)
    count(p, 'layouts:stores', stores)
    let sites = 0
    for (const call of local.calls) {
        const n = getNode(src, call)!
        const unit = calleeOf(p, u.traced, n)
        if (!unit) continue
        const wanted = (callFacts(p, u.traced, call)?.params ?? []).slice()
        const receiver = getRef(n, 2) ? receiverLayout(p, unit, layoutOf(getRef(n, 2))) : undefined
        if (receiver) wanted[0] = receiver
        if (!wanted.some(p => p)) continue
        let fed = true
        for (let k = 0; k < wanted.length; k++) {
            const need = wanted[k]
            if (!need) continue
            const ref = k + 2 < countIds(n) ? getRef(n, k + 2) : 0
            if (!ref || !covers(layoutOf(ref), need)) fed = false
        }
        if (!fed) continue
        const routed = routeWith(u, call, unit, 0, c => {
            let changed = false
            for (let k = 0; k < wanted.length && k < c.params.length; k++) {
                if (!wanted[k] || c.params[k].layout) continue
                c.params[k].layout = wanted[k]
                changed = true
            }
            return changed
        })
        if (routed) sites++
    }
    count(p, 'layouts:site-calls', sites)
    changes += sites
    if (ordered.size || fixed || stores) rewrite(u, g)
    return changes
}

const Element = { none: 0, int: 1, number: 2, any: 3 }

type ElementOf = (user: number, n: GraphNode, slot: number) => number

interface CopyCall {
    unit: Function
    cell: number
    reps: number[]
    protos: number[]
    ret: number
    retProto: number
    ints: number[]
}

interface Redirect {
    id: number
    form: number
    cell: number
    unit: Function
    position: number
    touches: boolean
    inputs: number[]
    prop: number
    key: number
}

interface Facts {
    escape: string
    proto: number
    storage: string
    touches: boolean
    returned: boolean
    members: Set<number>
    storageValues: Set<number>
    sliceOps: number[]
    inputs: [user: number, slot: number][]
    params: number[]
    element: number
    written: string[]
    plain: string[]
    reads: number[]
    methods: string[]
    redirects: Redirect[]
}

interface GenericSummary {
    uses: Map<string, Facts | null>
    fresh: Facts | null | undefined
    freshObject: Facts | null | undefined
}

interface Ctx {
    p: Optimizer
    traced: FastTraced
    src: Graph
    u: UseGraph
    elementOf: ElementOf | undefined
    keyOf: ElementOf | undefined
    objects: boolean
}

const Form = { method: 1, get: 2, set: 3, rt: 4, direct: 5, fresh: 6, result: 7 }

function memberName(key: number): string {
    return keyName(key) ?? `#${key}`
}

function elementTypeOf(element: number): number {
    if (element === Element.int) return Types.i64
    if (element === Element.number) return Types.f64
    return 0
}

function literalElement(value: number): number {
    return Number.isInteger(value) && !Object.is(value, -0) ? Element.int : Element.number
}

function newFacts(proto: number): Facts {
    return {
        escape: '', proto, storage: '', touches: false, returned: false, members: new Set(), storageValues: new Set(), sliceOps: [], inputs: [], params: [],
        element: Element.none, written: [], plain: [], reads: [], methods: [], redirects: [],
    }
}

function elementOfKinds(result: KindResult, src: Graph): ElementOf {
    return (user, n, slot) => {
        const kind = operandKindOf(result, src, n, user, slot)
        if (kind && !(kind & ~Kinds.int)) return Element.int
        if (kind && !(kind & ~numberKinds)) return Element.number
        return Element.any
    }
}

function calleeElements(p: Optimizer, fn: Function, traced: FastTraced): ElementOf | undefined {
    const signature = p.host.signature(fn)
    if (!signature || signature.rest) return
    const s = summaryOf(p, fn)
    return s ? elementOfKinds(s.coarse, traced.graph) : undefined
}

function sliceSlot(op: number): number {
    if (op === rt.Op.slice) return 3
    if (op === rt.Op.sliceRead) return 4
    if (op === rt.Op.sliceWrite) return 5
    return 0
}

function contextOf(p: Optimizer, traced: FastTraced, elementOf: ElementOf | undefined, keyOf: ElementOf | undefined, objects = false): Ctx {
    return { p, traced, src: traced.graph, u: useGraph(traced.graph), elementOf, keyOf, objects }
}

function dataSlot(proto: number, key: number): Found | undefined {
    const found = lookup(proto, key)
    return found && !found.proxy && !found.accessor ? found : undefined
}

function resolveTrap(proto: number, setter: boolean): number {
    let at = proto
    while (at) {
        const state = heap.deref(at as Handle)
        if (heap.isProxy(state)) return (setter ? heap.getProxySetter(state) : heap.getProxyGetter(state)) as number
        at = heap.getPrototypeOf(state)
    }
    return 0
}

function nonNegative(c: Ctx, n: GraphNode, slot: number, seen: Set<number>): boolean {
    const ref = getRef(n, slot)
    if (!ref) {
        const value = getLiteral(c.src, n, slot)
        return Number.isInteger(value) && value >= 0
    }
    const id = strip(c.src, ref)
    const m = getNode(c.src, id)
    if (!m) return false
    if (m.op === NodeOp.literal) {
        const value = getLiteral(c.src, m, 0)
        return Number.isInteger(value) && value >= 0
    }
    if (m.op === NodeOp.add) return nonNegative(c, m, 0, seen) && nonNegative(c, m, 1, seen)
    const param = c.u.blockOf.get(id)
    if (!param) return false
    if (seen.has(id)) return true
    seen.add(id)
    for (const apply of c.u.arrivals.get(param[0]) ?? []) {
        if (!nonNegative(c, getNode(c.src, apply)!, param[1] + 1, seen)) return false
    }
    return true
}

function walkOrigin(c: Ctx, roots: number[], f: Facts): void {
    let w: Walk = undefined!
    function escape(why: string): void {
        w.fail(why)
    }
    function setStorage(name: string): void {
        if (c.objects) return
        if (f.storage && f.storage !== name) escape('storages')
        f.storage = name
    }
    function storageUse(user: number, value: number): void {
        if (c.objects) return
        const m = getNode(c.src, user)!
        const slot = sliceSlot(getLiteral(c.src, m, 1))
        if (getLiteral(c.src, m, slot) !== Types.vm_value) {
            escape('slice-type')
            return
        }
        f.sliceOps.push(user)
        f.touches = true
        f.storageValues.add(value)
        if (getLiteral(c.src, m, 1) === rt.Op.sliceWrite) f.inputs.push([user, 4])
    }
    function isSliceAccess(m: GraphNode, slot: number): boolean {
        if (m.op !== NodeOp.rt || slot !== 2) return false
        const op = getLiteral(c.src, m, 1)
        return op === rt.Op.sliceRead || op === rt.Op.sliceWrite
    }
    function absorb(use: Facts, site: number, slotOf: (position: number) => number, count: number): void {
        if (use.storage) setStorage(use.storage)
        f.touches = f.touches || use.touches
        f.element = Math.max(f.element, use.element)
        for (const p of use.params) {
            const slot = slotOf(p)
            if (slot >= count) {
                f.element = Element.any
                continue
            }
            f.inputs.push([site, slot])
        }
        for (const k of use.written) f.written.push(k)
        for (const k of use.plain) f.plain.push(k)
        for (const k of use.methods) f.methods.push(k)
        for (const k of use.reads) f.reads.push(k)
    }
    function calleeUse(fn: Function | undefined, position: number): Facts | undefined {
        if (!fn) {
            escape('callee')
            return
        }
        const use = useOf(c.p, fn, position, f.proto, c.objects)
        if (!use) {
            escape(`callee:${fn.name}`)
            return
        }
        if (use.escape) {
            escape(`${fn.name}:${use.escape}`)
            return
        }
        return use
    }
    function once(n: GraphNode, from: number, position: number): boolean {
        for (let i = from; i < countIds(n); i++) {
            if (i !== position && w.member(getRef(n, i))) {
                escape('passed-twice')
                return false
            }
        }
        return true
    }
    function methodCall(call: number, key: number, prop: number): void {
        const m = getNode(c.src, call)!
        const cell = dataSlot(f.proto, key)?.slot ?? 0
        if (!cell) {
            escape(`method:${memberName(key)}`)
            return
        }
        const unit = c.p.host.unit(cell)
        const bound = unit ? c.p.host.bound(unit, countIds(m) - 3) : undefined
        if (!once(m, 3, -1)) return
        const use = calleeUse(bound, 0)
        if (!use) return
        absorb(use, call, p => p + 2, countIds(m))
        f.methods.push(memberName(key))
        f.redirects.push({ id: call, form: Form.method, cell, unit: bound!, position: 0, touches: use.touches, inputs: use.params, prop, key: -1 })
        if (use.returned) w.alias(call)
    }
    function readProp(user: number, n: GraphNode): void {
        if (getRef(n, 2)) {
            indexAccess(user, n, false, -1)
            return
        }
        const key = getLiteral(c.src, n, 2)
        const index = heap.keyIndex(key as Handle)
        if (index !== undefined) {
            indexAccess(user, n, false, index)
            return
        }
        const name = memberName(key)
        let plain = false
        let storage = false
        const calls: number[] = []
        for (const [u, s] of valueUses(c.u, user)) {
            const m = getNode(c.src, u)!
            if (m.op === NodeOp.call && s === 1 && w.member(getRef(m, 2))) {
                calls.push(u)
                continue
            }
            if (isSliceAccess(m, s)) {
                storage = true
                storageUse(u, user)
                continue
            }
            plain = true
        }
        if (storage) setStorage(name)
        if (plain) {
            f.plain.push(name)
            f.reads.push(key)
        }
        for (const call of calls) methodCall(call, key, user)
    }
    function indexAccess(user: number, n: GraphNode, setter: boolean, key: number): void {
        if (!c.objects && key < 0 && (!c.keyOf || c.keyOf(user, n, 2) !== Element.int || !nonNegative(c, n, 2, new Set()))) {
            escape(setter ? 'index-set' : 'index-get')
            return
        }
        const cell = resolveTrap(f.proto, setter)
        if (c.objects && !cell) {
            if (setter && key < 0) escape('dynamic-write')
            return
        }
        const unit = cell ? c.p.host.unit(cell) : undefined
        const bound = unit ? c.p.host.bound(unit, setter ? 2 : 1) : undefined
        const use = calleeUse(bound, 0)
        if (!use) return
        absorb(use, user, p => p + 1, countIds(n))
        f.redirects.push({ id: user, form: setter ? Form.set : Form.get, cell, unit: bound!, position: 0, touches: use.touches, inputs: use.params, prop: 0, key })
    }
    function writeProp(user: number, n: GraphNode): void {
        if (getRef(n, 2)) {
            indexAccess(user, n, true, -1)
            return
        }
        const index = heap.keyIndex(getLiteral(c.src, n, 2) as Handle)
        if (index !== undefined) {
            indexAccess(user, n, true, index)
            return
        }
        const name = memberName(getLiteral(c.src, n, 2))
        f.written.push(name)
        if (c.objects) return
        const ref = getRef(n, 3)
        if (!ref) {
            if (getLiteral(c.src, n, 3) !== 0) f.plain.push(name)
            return
        }
        const id = strip(c.src, ref)
        const m = getNode(c.src, id)!
        if (m.op === NodeOp.literal && getLiteral(c.src, m, 0) === 0) return
        if (m.op !== NodeOp.rt || getLiteral(c.src, m, 1) !== rt.Op.slice) {
            f.plain.push(name)
            return
        }
        setStorage(name)
        if (f.storageValues.has(id)) return
        storageUse(id, id)
        for (const [u, s] of valueUses(c.u, id)) {
            const k = getNode(c.src, u)!
            if (isSliceAccess(k, s)) {
                storageUse(u, id)
                continue
            }
            if (k.op === NodeOp.setProp && s === 3 && w.member(getRef(k, 1)) && !getRef(k, 2) && memberName(getLiteral(c.src, k, 2)) === name) continue
            escape(`slice-leak:${opName(k.op)}@${s}`)
        }
    }
    function callArg(user: number, n: GraphNode, slot: number): void {
        if (slot === 1) {
            escape('call-target')
            return
        }
        if (slot === 2) {
            const target = getNode(c.src, getRef(n, 1))
            if (target?.op === NodeOp.getProp && !getRef(target, 2) && w.member(getRef(target, 1))) return
        }
        const position = slot - 2
        if (!once(n, 2, slot)) return
        const unit = c.p.host.direct(c.traced, n)
        const bound = unit ? c.p.host.bound(unit, countIds(n) - 3) : undefined
        const use = calleeUse(bound, position)
        if (!use) return
        absorb(use, user, p => p + 2, countIds(n))
        f.redirects.push({ id: user, form: Form.direct, cell: 0, unit: bound!, position, touches: use.touches, inputs: use.params, prop: 0, key: -1 })
        if (use.returned) w.alias(user)
    }
    function rtArg(user: number, n: GraphNode, slot: number): void {
        const op = getLiteral(c.src, n, 1)
        const impl = rt.bindingOf(op)?.impl
        if (!impl || sliceSlot(op)) {
            escape(`rt:${rt.opName(op)}`)
            return
        }
        if (!once(n, 2, slot)) return
        const position = slot - 1
        const use = calleeUse(impl, position)
        if (!use) return
        absorb(use, user, p => p + 1, countIds(n))
        f.redirects.push({ id: user, form: Form.rt, cell: 0, unit: impl, position, touches: use.touches, inputs: use.params, prop: 0, key: -1 })
        if (use.returned) w.alias(user)
    }
    const walk = walkUses(c.u, roots, (current, user, slot, n) => {
        w = current
        const op = n.op
        if (op === NodeOp.getProp && slot === 1) readProp(user, n)
        else if (op === NodeOp.setProp && slot === 1) writeProp(user, n)
        else if (op === NodeOp.call) callArg(user, n, slot)
        else if (op === NodeOp.rt && slot >= 2) rtArg(user, n, slot)
        else if (op === NodeOp.ret && slot === 0) f.returned = true
        else if (op === NodeOp.eq || op === NodeOp.ne) return
        else if (op === NodeOp.setProp && slot === 3) escape('stored')
        else escape(opName(op))
    })
    f.members = walk.members
    f.escape = walk.escape
    if (f.escape) return
    if (f.storage && (f.plain.includes(f.storage) || f.methods.includes(f.storage))) f.escape = 'storage-leak'
    for (const name of f.methods) {
        if (f.written.includes(name) && !f.escape) f.escape = 'shadowed'
    }
}

function checkReads(f: Facts): void {
    for (const key of f.reads) {
        if (f.escape) return
        if (!f.written.includes(memberName(key)) && !dataSlot(f.proto, key)) f.escape = `read:${memberName(key)}`
    }
}

function resolveInputs(c: Ctx, f: Facts): void {
    for (const [user, slot] of f.inputs) {
        const n = getNode(c.src, user)!
        const ref = getRef(n, slot)
        if (!ref) {
            f.element = Math.max(f.element, literalElement(getLiteral(c.src, n, slot)))
            continue
        }
        const id = strip(c.src, ref)
        const m = getNode(c.src, id)!
        if (m.op === NodeOp.rt && getLiteral(c.src, m, 1) === rt.Op.sliceRead && f.storageValues.has(strip(c.src, getRef(m, 2)))) continue
        if (c.elementOf) {
            f.element = Math.max(f.element, c.elementOf(user, n, slot))
            continue
        }
        const position = c.u.positions.get(id)
        if (position !== undefined) {
            if (!f.params.includes(position)) f.params.push(position)
            continue
        }
        if (m.op === NodeOp.literal) {
            f.element = Math.max(f.element, literalElement(getLiteral(c.src, m, 0)))
            continue
        }
        f.element = Element.any
    }
}

function genericSummary(p: Optimizer, fn: Function): GenericSummary {
    let s = p.generic.get(fn)
    if (!s) p.generic.set(fn, s = { uses: new Map(), fresh: undefined, freshObject: undefined })
    return s
}

function useOf(p: Optimizer, fn: Function, position: number, proto: number, objects: boolean): Facts | undefined {
    const s = genericSummary(p, fn)
    const key = `${position}:${proto}:${objects ? 'o' : 'c'}`
    if (s.uses.has(key)) return s.uses.get(key) ?? undefined
    s.uses.set(key, null)
    const traced = p.host.trace(fn)
    if (!traced) return
    const c = contextOf(p, traced, undefined, objects ? undefined : calleeElements(p, fn, traced), objects)
    const f = newFacts(proto)
    const param = c.u.params[position]
    if (param !== undefined) walkOrigin(c, [param], f)
    if (!f.escape && f.returned && !returnsOrigin(c, f)) f.escape = 'returned-mixed'
    if (!f.escape && !objects) resolveInputs(c, f)
    if (!f.escape && !objects && f.element === Element.any) f.escape = 'element'
    s.uses.set(key, f)
    return f
}

function allocationOrigins(c: Ctx): [root: number, proto: number][] {
    const out: [number, number][] = []
    for (const [id, n] of c.src.nodes) {
        if (n.op !== NodeOp.heapHandle) continue
        const cell = getLiteral(c.src, n, 0)
        const allocation = c.traced.allocations.get(cell as u32)
        if (!allocation || allocation.call === undefined) continue
        out.push([id, heap.getPrototypeOf(heap.deref(cell as Handle))])
    }
    return out
}

function returnsOrigin(c: Ctx, f: Facts): boolean {
    for (const n of c.src.nodes.values()) {
        if (n.op === NodeOp.ret && !f.members.has(strip(c.src, getRef(n, 0)))) return false
    }
    return true
}

function objectOrigins(c: Ctx): [root: number, proto: number][] {
    const out: [number, number][] = []
    for (const [id, n] of c.src.nodes) {
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(c.src, n, 0)
        if (!c.traced.allocations.has(cell as u32)) continue
        const proto = heap.getPrototypeOf(heap.deref(cell as Handle))
        if (proto && !perInvocationCell(c.traced, proto)) out.push([id, proto])
    }
    return out
}

function freshOf(p: Optimizer, fn: Function, objects: boolean): Facts | undefined {
    const s = genericSummary(p, fn)
    const known = objects ? s.freshObject : s.fresh
    if (known !== undefined) return known ?? undefined
    if (objects) s.freshObject = null
    else s.fresh = null
    const traced = p.host.trace(fn)
    if (!traced) return
    const c = contextOf(p, traced, undefined, objects ? undefined : calleeElements(p, fn, traced), objects)
    for (const [root, proto] of objects ? objectOrigins(c) : allocationOrigins(c)) {
        const f = newFacts(proto)
        walkOrigin(c, [root], f)
        if (!objects) checkReads(f)
        if (f.escape || !f.returned || !returnsOrigin(c, f)) continue
        if (!objects && !f.touches) continue
        if (!objects) resolveInputs(c, f)
        if (!objects && f.element === Element.any) continue
        if (objects) s.freshObject = f
        else s.fresh = f
        count(p, objects ? 'fresh:objects' : 'fresh:containers')
        return f
    }
}

function seedFresh(f: Facts, fresh: Facts, n: GraphNode, root: number, first: number): void {
    f.storage = fresh.storage
    f.touches = true
    f.element = fresh.element
    for (const p of fresh.params) {
        if (p + first < countIds(n)) f.inputs.push([root, p + first])
        else f.element = Element.any
    }
    for (const k of fresh.written) f.written.push(k)
    for (const k of fresh.plain) f.plain.push(k)
    for (const k of fresh.reads) f.reads.push(k)
}

function containers(u: Unit): number {
    const p = u.p
    if (!enabled(p, 'kinds')) return 0
    const src = u.traced.graph
    const contract = u.contract
    const hasReps = !!contract && (contract.ret !== 0 || contract.params.some(p => p.rep))
    let candidate = hasReps
    for (const n of src.nodes.values()) {
        if (candidate) break
        if (n.op === NodeOp.heapHandle && u.traced.allocations.get(getLiteral(src, n, 0) as u32)?.call !== undefined) candidate = true
        if (n.op === NodeOp.rt && rt.bindingOf(getLiteral(src, n, 1))?.impl && !sliceSlot(getLiteral(src, n, 1))) candidate = true
    }
    if (!candidate) return 0
    const elementOf = elementOfKinds(kindsOf(u), src)
    const c = contextOf(p, u.traced, elementOf, elementOf)
    const origins: [facts: Facts, rep: number][] = []
    const escapes = new Map<string, number>()
    if (contract && hasReps) {
        contract.params.forEach((p, position) => {
            if (!p.rep) return
            const param = c.u.params[position]
            if (param === undefined) return
            const f = newFacts(p.proto)
            walkOrigin(c, [param], f)
            intrinsics.assert(!f.escape, `containers: ${src.name} position ${position} breaks its contract (${f.escape})`)
            origins.push([f, p.rep])
        })
    }
    const candidates: [roots: number[], proto: number, fresh: Facts | undefined, impl: Function | undefined][] = []
    for (const [root, proto] of allocationOrigins(c)) candidates.push([[root], proto, undefined, undefined])
    for (const [id, n] of src.nodes) {
        if (n.op !== NodeOp.rt) continue
        const impl = rt.bindingOf(getLiteral(src, n, 1))?.impl
        if (!impl || sliceSlot(getLiteral(src, n, 1))) continue
        const fresh = freshOf(p, impl, false)
        if (fresh) candidates.push([[id], fresh.proto, fresh, impl])
    }
    if (enabled(p, 'fresh')) {
        for (const [id, n] of src.nodes) {
            const unit = n.op === NodeOp.call ? calleeOf(p, u.traced, n) : undefined
            const fresh = unit ? freshOf(p, unit, false) : undefined
            if (fresh) candidates.push([[id], fresh.proto, fresh, unit])
        }
    }
    for (const [roots, proto, fresh, impl] of candidates) {
        const f = newFacts(proto)
        if (fresh) {
            const n = getNode(src, roots[0])!
            const call = n.op === NodeOp.call
            seedFresh(f, fresh, n, roots[0], call ? 2 : 1)
            f.redirects.push({ id: roots[0], form: call ? Form.result : Form.fresh, cell: 0, unit: impl!, position: -1, touches: true, inputs: fresh.params, prop: 0, key: -1 })
        }
        walkOrigin(c, roots, f)
        checkReads(f)
        if (!f.escape && f.returned && (!contract?.ret || !returnsOrigin(c, f))) f.escape = 'returned'
        if (!f.escape && !f.touches) continue
        if (f.escape) {
            escapes.set(f.escape, (escapes.get(f.escape) ?? 0) + 1)
            continue
        }
        resolveInputs(c, f)
        const rep = f.returned ? contract!.ret : elementTypeOf(f.element)
        if (!rep) {
            escapes.set('generic', (escapes.get('generic') ?? 0) + 1)
            continue
        }
        origins.push([f, rep])
    }
    if (intrinsics.argv().includes('containers-debug')) console.log(`CONTAINERS ${src.name} origins=${origins.length} escapes=${[...escapes].map(([k, v]) => `${k}:${v}`).join(',')}`)
    for (const [why, n] of escapes) count(p, `containers:escape:${why.split(':')[0]}`, n)
    if (!origins.length) return 0
    const g = withNodes(src, new Map(src.nodes))
    const held = allocationTokens(u.traced)
    const copies = new Map<number, [copy: CopyCall, r: Redirect]>()
    for (const [f, rep] of origins) {
        for (const id of f.sliceOps) {
            const n = getNode(g, id)!
            const slot = sliceSlot(getLiteral(g, n, 1))
            const operands: Operand[] = []
            for (let i = 0; i < countIds(n); i++) operands.push(i === slot ? { literal: rep } : getOperand(g, n, i))
            putNode(g, id, NodeOp.rt, operands)
        }
        for (const r of f.redirects) {
            if (!r.touches) continue
            let entry = copies.get(r.id)
            if (!entry) copies.set(r.id, entry = [{ unit: r.unit, cell: r.cell, reps: [], protos: [], ret: 0, retProto: 0, ints: [] }, r])
            const copy = entry[0]
            if (r.position < 0) {
                copy.ret = rep
                copy.retProto = f.proto
            } else {
                copy.reps[r.position] = rep
                copy.protos[r.position] = f.proto
            }
            if (rep !== Types.i64) continue
            for (const p of r.inputs) {
                if (!copy.ints.includes(p)) copy.ints.push(p)
            }
        }
    }
    let changes = 0
    for (const [f, rep] of origins) changes += f.sliceOps.length
    for (const [id, [copy, r]] of copies) {
        redirect(g, src, p, r, c.u.users, held)
        const routed = routeWith(u, id, copy.unit, copy.cell, next => {
            for (let position = 0; position < next.params.length; position++) {
                if (copy.reps[position]) {
                    next.params[position].rep = copy.reps[position]
                    next.params[position].proto = copy.protos[position]
                }
                if (copy.ints.includes(position)) next.params[position].kind = Kinds.int
            }
            next.ret = copy.ret
            next.retProto = copy.retProto
            return true
        })
        if (routed) changes++
    }
    if (!changes) return 0
    count(p, 'containers:origins', origins.length)
    count(p, 'containers:copies', copies.size)
    rewrite(u, g)
    return changes
}

function devirtualize(u: Unit): number {
    const p = u.p
    const src = u.traced.graph
    let candidate = false
    for (const n of src.nodes.values()) {
        if (n.op === NodeOp.call && getNode(src, getRef(n, 1))?.op === NodeOp.getProp) candidate = true
    }
    if (!candidate) return 0
    const roots: [roots: number[], proto: number][] = []
    for (const [id, n] of src.nodes) {
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(src, n, 0)
        if (!u.traced.allocations.has(cell as u32)) continue
        const proto = heap.getPrototypeOf(heap.deref(cell as Handle))
        if (proto && !perInvocationCell(u.traced, proto)) roots.push([[id], proto])
    }
    const c = contextOf(p, u.traced, undefined, undefined, true)
    u.contract?.params.forEach((p, position) => {
        const param = c.u.params[position]
        if (p.proto && param !== undefined) roots.push([[param], p.proto])
    })
    const seeds = new Map<number, Facts>()
    if (enabled(p, 'fresh')) {
        for (const [id, n] of src.nodes) {
            const unit = n.op === NodeOp.call ? calleeOf(p, u.traced, n) : undefined
            const fresh = unit ? freshOf(p, unit, true) : undefined
            if (!fresh) continue
            seeds.set(id, fresh)
            roots.push([[id], fresh.proto])
        }
    }
    if (!roots.length) return 0
    const resolved: Redirect[] = []
    const protos = new Map<number, number>()
    for (const [members, proto] of roots) {
        const f = newFacts(proto)
        const fresh = seeds.get(members[0])
        if (fresh) seedFresh(f, fresh, getNode(src, members[0])!, members[0], 2)
        walkOrigin(c, members, f)
        if (f.escape) {
            count(p, `devirt:escape:${f.escape.split(':')[0]}`)
            continue
        }
        for (const r of f.redirects) {
            if (r.form !== Form.method || perInvocationCell(u.traced, r.cell)) continue
            resolved.push(r)
            protos.set(r.id, proto)
        }
    }
    if (!resolved.length) return 0
    const g = withNodes(src, new Map(src.nodes))
    const held = allocationTokens(u.traced)
    const targets = new Map<number, number>()
    for (const r of resolved) {
        let target = targets.get(r.cell)
        if (target === undefined) {
            target = usesCallee(p, r.unit) ? addNode(g, NodeOp.heapHandle, [{ literal: r.cell }]) : addNode(g, NodeOp.localTarget, [{ literal: p.host.symbol(r.unit) }], Types.u32)
            targets.set(r.cell, target)
        }
        const n = getNode(g, r.id)!
        const only = !held.has(r.prop) && (c.u.users.get(r.prop) ?? []).every(([user]) => user === r.id)
        const token = getRef(n, 0) === r.prop && only ? getOperand(src, getNode(src, r.prop)!, 0) : getOperand(g, n, 0)
        const operands: Operand[] = [token, target]
        for (let i = 2; i < countIds(n); i++) operands.push(getOperand(g, n, i))
        putCopy(g, r.id, n, operands)
        if (only) deleteNode(g, r.prop)
        const proto = protos.get(r.id)!
        if (receiverUse(p, r.unit).methods && routeWith(u, r.id, r.unit, r.cell, c => {
            if (c.params[0].proto) return false
            c.params[0].proto = proto
            return true
        })) count(p, 'devirt:receivers')
    }
    count(p, 'devirt:calls', resolved.length)
    rewrite(u, g)
    return resolved.length
}

function allocationTokens(traced: FastTraced): Set<number> {
    const out = new Set<number>()
    for (const allocation of traced.allocations.values()) {
        if (allocation.token !== undefined) out.add(allocation.token)
    }
    return out
}

function redirect(g: Graph, src: Graph, p: Optimizer, r: Redirect, users: Map<number, [number, number][]>, held: Set<number>): void {
    const n = getNode(g, r.id)!
    const direct = (): number => addNode(g, NodeOp.localTarget, [{ literal: p.host.symbol(r.unit) }], Types.u32)
    if (r.form === Form.method) {
        const prop = getNode(src, r.prop)!
        const target = direct()
        const only = !held.has(r.prop) && (users.get(r.prop) ?? []).every(([user]) => user === r.id)
        const viaProp = getRef(n, 0) === r.prop
        const token = viaProp && only ? getOperand(src, prop, 0) : getOperand(g, n, 0)
        const operands: Operand[] = [token, target]
        for (let i = 2; i < countIds(n); i++) operands.push(getOperand(g, n, i))
        putNode(g, r.id, NodeOp.call, operands)
        if (only) deleteNode(g, r.prop)
        return
    }
    if (r.form === Form.get || r.form === Form.set) {
        const target = direct()
        const operands: Operand[] = [getOperand(g, n, 0), target, getOperand(g, n, 1), r.key >= 0 ? { literal: r.key } : getOperand(g, n, 2)]
        if (r.form === Form.set) operands.push(getOperand(g, n, 3))
        putNode(g, r.id, NodeOp.call, operands)
        return
    }
    if (r.form === Form.rt || r.form === Form.fresh) {
        const target = direct()
        const operands: Operand[] = [getOperand(g, n, 0), target, { literal: 0 }]
        for (let i = 2; i < countIds(n); i++) operands.push(getOperand(g, n, i))
        putNode(g, r.id, NodeOp.call, operands)
    }
}

export function printStats(p: Optimizer): void {
    const keys = [...p.stats.keys()].sort()
    for (const key of keys) console.log(`OPT ${key} ${p.stats.get(key)}`)
}

function kindsSuite() {
    function sumTo(n: number): number {
        let total = 0
        for (let i = 0; i < n; i++) total = total + i * 2
        return total
    }
    function mulAdd(a: number, b: number): number {
        return a * b + 1
    }
    function callsMulAdd(n: number): number {
        return mulAdd(n, n + 1) + mulAdd(2, 3)
    }
    function cat(a: string, b: string): string {
        return a + b
    }
    function catLength(n: number): number {
        const s = cat('ab', n > 2 ? 'cde' : 'f')
        return s.length
    }
    function readA(o: { a: number, b: number }): number {
        return o.a + o.b
    }
    function fieldRead(n: number): number {
        const o = { a: n, b: 2 }
        return readA(o) * 3
    }
    function guarded(x: number | undefined): number {
        if (x === undefined) return 0
        return x + 1
    }
    function narrowing(n: number): number {
        const v = n > 3 ? n : undefined
        const w = v ?? 7
        return guarded(v) + w + (typeof v === 'number' ? v : 1)
    }
    harness.runCases({ prefix: 'kinds', args: true }, [
        [sumTo, [10]],
        [callsMulAdd, [4]],
        [catLength, [1], [5]],
        [fieldRead, [4]],
        [narrowing, [2], [9]],
    ])
}

function shapesSuite() {
    function localPair(n: number): number {
        const o = { a: n, b: 3 }
        return o.a * 2 + o.b
    }
    function widened(n: number): number {
        const o: Record<string, number> = { a: n }
        if (n > 3) o.b = n + 1
        return o.a + (o.b ?? 100)
    }
    function loopCarried(n: number): number {
        const acc = { total: 0, count: 0 }
        for (let i = 0; i < n; i++) {
            acc.total = acc.total + i
            acc.count = acc.count + 1
        }
        return acc.total * 10 + acc.count
    }
    function readA(o: { a: number, b: number }): number {
        return o.a + o.b
    }
    function fieldRead(n: number): number {
        const o = { a: n, b: 2 }
        return readA(o) * 3
    }
    function bump(c: { count: number }): number {
        c.count = c.count + 1
        return c.count
    }
    function callMutates(n: number): number {
        const c = { count: n }
        const k = bump(c)
        return k * 100 + c.count
    }
    function heapCaller(n: number): number {
        const o = { a: n, b: 5 }
        const keep = [o]
        return readA(o) + keep.length + keep[0].b
    }
    function pairOf(n: number): { a: number, b: number } {
        return { a: n + 1, b: n * 2 }
    }
    function factoryRead(n: number): number {
        const p = pairOf(n)
        const q = pairOf(n + 1)
        return p.a * 100 + q.b + readA(p)
    }
    function step(state: { value: number, done: boolean }, n: number): { value: number, done: boolean } {
        if (state.value >= n) return { value: state.value, done: true }
        return { value: state.value + 1, done: false }
    }
    function iterateResults(n: number): number {
        let state = { value: 0, done: false }
        let total = 0
        while (!state.done) {
            total = total + state.value
            state = step(state, n)
        }
        return total
    }
    function passThrough(o: { a: number, b: number }): { a: number, b: number } {
        return o
    }
    function chained(n: number): number {
        const o = passThrough(pairOf(n))
        o.b = o.b + 1
        return o.a + o.b
    }
    function identity(n: number): number {
        const a = { v: n }
        const b = { v: n }
        const same = n & 1 ? a : b
        return (same === a ? 1 : 2) + a.v
    }
    function absentKey(n: number): number {
        const o: Record<string, number> = { a: n }
        return o.z === undefined ? 7 : 8
    }
    const protoGetter = { get v(): number { return 5 } }
    function protoRead(n: number): number {
        const o = Object.create(protoGetter)
        o.k = n
        return o.v + o.k
    }
    function passedTwice(a: { v: number }, b: { v: number }): number {
        b.v = 9
        return a.v
    }
    function aliasArgs(n: number): number {
        const o = { v: n }
        return passedTwice(o, o) * 10 + o.v
    }
    function grown(n: number): number {
        const o: Record<string, number> = { a: n, b: 1 }
        const keep = [o]
        keep[0].c = 5
        return o.a + o.b + o.c + Object.keys(o).length
    }
    function sumFields(p: { a: number, b: number }, n: number): number {
        let total = 0
        for (let i = 0; i < n; i++) total = total + p.a + p.b
        return total
    }
    function fieldLoop(n: number): number {
        return sumFields(pairOf(n & 7), n)
    }
    const benches = harness.createBenches()
    benches.bench(fieldLoop, [100000])
    benches.run()
    harness.runCases({ prefix: 'shapes', args: true }, [
        [localPair, [4]],
        [widened, [2], [5]],
        [loopCarried, [5]],
        [fieldRead, [4]],
        [callMutates, [6]],
        [heapCaller, [3]],
        [factoryRead, [4]],
        [iterateResults, [5]],
        [chained, [3]],
        [identity, [1], [2]],
        [absentKey, [3]],
        [protoRead, [2]],
        [aliasArgs, [3]],
        [grown, [2]],
        [fieldLoop, [5]],
    ])
}

function genericsSuite() {
    function intSum(n: number): number {
        const xs: number[] = []
        for (let i = 0; i < n; i++) xs.push(i * 3)
        let total = 0
        for (let i = 0; i < xs.length; i++) total = total + xs[i]
        return total
    }
    function pushIterate(n: number): number {
        const xs: number[] = []
        for (let i = 0; i < n; i++) xs.push(i + 1)
        let total = 0
        for (const x of xs) total = total + x
        return total + xs.length
    }
    function floatSum(n: number): number {
        const xs = [0.5, 1.25]
        for (let i = 0; i < n; i++) xs.push(i * 0.5)
        let total = 0.25
        for (let i = 0; i < xs.length; i++) total = total + xs[i]
        return total
    }
    function indexWrite(n: number): number {
        const xs: number[] = []
        for (let i = 0; i < n; i++) xs[i] = i * 2
        let total = 0
        for (let i = 0; i < xs.length; i++) total = total + xs[i]
        return total * 10 + xs.length
    }
    function sumOf(xs: number[]): number {
        let total = 0
        for (let i = 0; i < xs.length; i++) total = total + xs[i]
        return total
    }
    function passed(n: number): number {
        const xs = [n, 2]
        for (let i = 0; i < n; i++) xs.push(i)
        return sumOf(xs)
    }
    function mixed(n: number): number {
        const xs: any[] = [n, 'a']
        xs.push(n + 1)
        return xs.length * 100 + (xs[1] === 'a' ? 10 : 0) + xs[2]
    }
    function widened(n: number): number {
        const xs = [1, 2]
        xs.push(n / 4)
        return xs[2] * 8 + xs[0]
    }
    function escaped(n: number): number {
        const xs = [n, n + 1]
        const holder = { list: xs }
        holder.list.push(3)
        return holder.list.length * 10 + xs[1]
    }
    function identity(n: number): number {
        const xs = [n * 2]
        const ys = xs
        ys.push(5)
        return (ys === xs ? 100 : 0) + xs.length * 10 + xs[1]
    }
    function outOfRange(n: number): number {
        const xs = [n, n + 1]
        const v = xs[n + 2]
        return v === undefined ? 7 : v
    }
    function popAll(n: number): number {
        const xs: number[] = []
        for (let i = 0; i < n; i++) xs.push(i + 1)
        let total = 0
        let v = xs.pop()
        while (v !== undefined) {
            total = total + v
            v = xs.pop()
        }
        return total * 10 + xs.length
    }
    function pick(a: any[], b: any[], n: number): any[] {
        if (n > 2) return a
        return b
    }
    function mixedReturn(n: number): number {
        const xs = [1, 2]
        const ys: any[] = ['s']
        const r = pick(xs, ys, n)
        r.push('t')
        return xs.length * 10 + ys.length + (xs[0] + xs[1]) * 100
    }
    function lookup(x: number): { op: number } | undefined {
        return x > 2 ? { op: x } : undefined
    }
    function opIn(n: number): number {
        return [5, 54, 2, 52].includes(lookup(n)?.op) ? 1 : 0
    }
    const benches = harness.createBenches()
    benches.bench(intSum, [1000], { ops: 1000 })
    benches.bench(floatSum, [1000], { ops: 1000 })
    benches.bench(indexWrite, [1000], { ops: 1000 })
    benches.bench(pushIterate, [1000], { ops: 1000 })
    benches.bench(popAll, [1000], { ops: 1000 })
    benches.run()
    harness.runCases({ prefix: 'generics', args: true }, [
        [intSum, [0], [10]],
        [pushIterate, [0], [6]],
        [floatSum, [0], [7]],
        [indexWrite, [0], [5]],
        [passed, [0], [4]],
        [mixed, [3]],
        [widened, [3], [8]],
        [escaped, [3]],
        [identity, [4]],
        [outOfRange, [0], [1]],
        [popAll, [0], [5]],
        [mixedReturn, [1], [3]],
        [opIn, [1], [5], [54]],
    ])
}

class Accumulator {
    total: number
    count: number
    constructor(start: number) {
        this.total = start
        this.count = 0
    }
    add(v: number): void {
        this.total = this.total + v
        this.count = this.count + 1
    }
    mean(): number {
        return this.count ? this.total / this.count : 0
    }
}

function makeAccumulator(start: number): Accumulator {
    return new Accumulator(start)
}

function objectsSuite() {
    function methodLoop(n: number): number {
        const acc = new Accumulator(0)
        for (let i = 0; i < n; i++) acc.add(i)
        return acc.total + acc.count
    }
    function shadowedMethod(n: number): number {
        const acc: any = new Accumulator(1)
        acc.add = (v: number) => {
            acc.total = acc.total * v
        }
        acc.add(n)
        return acc.total
    }
    function storedMethod(n: number): number {
        const acc = new Accumulator(n)
        const keep = [acc]
        keep[0].add(3)
        acc.add(2)
        return acc.total * 10 + acc.count
    }
    function factoryLoop(n: number): number {
        const acc = makeAccumulator(1)
        for (let i = 0; i < n; i++) acc.add(i)
        return acc.total + acc.mean()
    }
    function chainedFactory(n: number): number {
        makeAccumulator(n).add(2)
        const acc = makeAccumulator(n)
        acc.add(n)
        return acc.total
    }
    const benches = harness.createBenches()
    benches.bench(methodLoop, [1000], { ops: 1000 })
    benches.bench(factoryLoop, [1000], { ops: 1000 })
    benches.run()
    harness.runCases({ prefix: 'objects', args: true }, [
        [methodLoop, [0], [5]],
        [shadowedMethod, [3]],
        [storedMethod, [4]],
        [factoryLoop, [0], [6]],
        [chainedFactory, [3]],
    ])
}

export function suite() {
    kindsSuite()
    shapesSuite()
    genericsSuite()
    objectsSuite()
}
