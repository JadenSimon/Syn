/// @synth
"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import { lowerValueGraph } from './lowering2'
import { hostTarget } from './lowering'
import { createGraph, addNode, setGraphBlocks, NodeOp } from './graph-node'

const Types = intrinsics.Types

export function suite() {
    function loopSwap(n: u32): f64 {
        let a = 0.25
        let b = 1.5
        for (let i: u32 = 0; i < n; i++) {
            const old = a
            a = b + 0.25
            b = old * 0.5
        }
        return a + b
    }
    const mixed = intrinsics.tagNoInline(function mixed(x: f64, k: u32, y: f64): f64 {
        return x * 3 + k + y
    })
    function mixedCalls(n: u32): f64 {
        return mixed(n + 0.25, n + 2, n + 0.5) + mixed(n + 0.75, n, n + 0.125)
    }
    const relay = intrinsics.tagNoInline(function relay(x: f64, k: u32, y: f64): f64 {
        return mixed(x, k, y)
    })
    function tailCalls(n: u32): f64 {
        return relay(n + 0.25, n, n + 0.5)
    }
    const predicate = intrinsics.tagNoInline(function predicate(x: f64): u32 {
        return x > 2.5 ? 7 : 3
    })
    function integerResult(n: u32): u32 {
        return predicate(n + 0.25)
    }
    const wideMixed = intrinsics.tagNoInline(function wideMixed(i0: u32, f0: f64, i1: u32, f1: f64, i2: u32, f2: f64, i3: u32, f3: f64, i4: u32, f4: f64, i5: u32, f5: f64, i6: u32, f6: f64, i7: u32, f7: f64, i8: u32, f8: f64): f64 {
        return i0 + f0 * 2 + i1 * 3 + f1 * 4 + i2 * 5 + f2 * 6 + i3 * 7 + f3 * 8 + i4 * 9 + f4 * 10 + i5 * 11 + f5 * 12 + i6 * 13 + f6 * 14 + i7 * 15 + f7 * 16 + i8 * 17 + f8 * 18
    })
    function mixedStackCalls(n: u32): f64 {
        return wideMixed(n, n + 0.125, n + 1, n + 0.25, n + 2, n + 0.375, n + 3, n + 0.5, n + 4, n + 0.625, n + 5, n + 0.75, n + 6, n + 0.875, n + 7, n + 1.125, n + 8, n + 1.25)
    }
    function acrossCalls(n: u32): f64 {
        let a = n + 0.125
        let b = n + 0.25
        for (let i: u32 = 0; i < n; i++) {
            a += mixed(b, i, a)
            b = b * 0.5 + a
        }
        return a + b
    }
    function memory(n: u32): f64 {
        const xs = new Float64Array(4)
        for (let i: u32 = 0; i < 4; i++) xs[i] = n + i + 0.25
        xs[1] = -xs[2]
        return xs[0] + xs[1] * xs[3]
    }
    function choose(n: u32): f64 {
        const x = n + 0.25
        const y = n + 0.75
        return (n & 1) ? x * y : x / y
    }
    const truthValue = intrinsics.tagNoInline(function truthValue(n: u32): f64 {
        if (n === 0) return 0.5
        if (n === 1) return 0
        if (n === 2) return -0
        if (n === 3) return NaN
        return -1.5
    })
    function truthy(n: u32): u32 {
        const value = truthValue(n)
        return value ? 7 : 3
    }
    const literal = intrinsics.tagNoInline(function literal(n: u32): f64 {
        if (n > 1) return 3
        if (n) return 0.5
        return n + 0.75
    })
    function literalReturns(n: u32): f64 {
        return literal(n) + literal(n + 1)
    }
    function floatingLoop(n: u32): f64 {
        let value = 0.25
        for (let i: u32 = 0; i < n; i++) value = value * 0.999 + (i & 3) * 0.125
        return value
    }
    function floatingCallsLoop(n: u32): f64 {
        let value = 0.25
        for (let i: u32 = 0; i < n; i++) value = mixed(value * 0.125, i & 3, 0.125)
        return value
    }
    if (harness.benching()) {
        const benches = harness.createBenches()
        benches.bench(floatingLoop, [10_000], { ops: 10_000, reps: 100 })
        benches.bench(floatingCallsLoop, [10_000], { ops: 10_000, reps: 100 })
        benches.run()
        return
    }
    harness.runCases({ prefix: 'floating', args: true, value: true, stacks: true }, [
        [loopSwap, [0], [1], [2], [8]],
        [mixedCalls, [0], [3], [100]],
        [tailCalls, [0], [3], [100]],
        [integerResult, [0], [2], [3]],
        [mixedStackCalls, [0], [3], [100]],
        [acrossCalls, [0], [1], [5]],
        [memory, [0], [3], [100]],
        [choose, [0], [1], [2], [3]],
        [truthy, [0], [1], [2], [3], [4]],
        [literalReturns, [0], [1], [2]],
        [floatingLoop, [0], [1], [10]],
        [floatingCallsLoop, [0], [1], [10]],
    ])

    harness.test('floatSpills', () => {
        const input = new Float64Array(32)
        for (let i = 0; i < input.length; i++) input[i] = i + 0.125
        const ptr = (ts as any).getArrayBufferPtr(input.buffer)
        for (const budget of [2, 3, 32]) {
            const g = createGraph()
            const block = addNode(g, NodeOp.block, [])
            const p = addNode(g, NodeOp.param, [], Types.u64)
            const nil = addNode(g, NodeOp.nilEffect, [block])
            let values: number[] = []
            for (let i = 0; i < input.length; i++) values.push(addNode(g, NodeOp.load, [nil, p, { literal: i * 8 }], Types.f64))
            while (values.length > 1) {
                const next: number[] = []
                for (let i = 0; i < values.length; i += 2) next.push(addNode(g, NodeOp.add, [values[i], values[i + 1]], Types.f64))
                values = next
            }
            const expected = addNode(g, NodeOp.literal, [{ literal: input.reduce((a, b) => a + b, 0) }], Types.f64)
            const equal = addNode(g, NodeOp.eq, [values[0], expected], Types.u64)
            const ret = addNode(g, NodeOp.ret, [equal, block])
            g.root = block
            setGraphBlocks(g, [{ id: block, params: [p], bodyId: ret, bodyConst: 0 }])
            const code = lowerValueGraph(g, { regBudget: budget })
            const run = (ts as any).createNativeFn(new Uint8Array(code.bytes))
            intrinsics.assert(Number(run(ptr)) === 1, `floating spills at budget ${budget}`)
        }
    })

    harness.test('floatImmediates', () => {
        const values: number[] = []
        for (const sign of [-1, 1]) {
            for (let exponent = -3; exponent <= 4; exponent++) {
                for (let fraction = 0; fraction < 16; fraction++) values.push(sign * (1 + fraction / 16) * 2 ** exponent)
            }
        }
        values.push(0, -0, Infinity, -Infinity, NaN, Number.MIN_VALUE, Math.PI, 1e300)
        const expected = new Float64Array(values)
        const asm = hostTarget.createAssembler()
        asm.movImm(4, 1)
        for (let i = 0; i < values.length; i++) {
            asm.movF64(32, values[i])
            asm.mov(1, 32)
            asm.load(2, 0, i * 8, Types.u64)
            asm.compare('eq', 3, 1, 2, false)
            asm.binary('and', 4, 4, 3, false)
        }
        asm.mov(0, 4)
        asm.ret()
        const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
        intrinsics.assert(Number(run((ts as any).getArrayBufferPtr(expected.buffer))) === 1, 'float constant bit patterns')
    })

    harness.test('floatPredicates', () => {
        const values = [0, -0, NaN, Infinity, -Infinity, 0.5, -0.5]
        const asm = hostTarget.createAssembler()
        asm.movImm(0, 0)
        let expected = 0
        for (let i = 0; i < values.length; i++) {
            const positive = 1 << (i * 2)
            const negative = 1 << (i * 2 + 1)
            asm.movF64(32, values[i])
            asm.jumpIfZero(32, i * 2)
            asm.addImm(0, 0, positive)
            asm.bindLabel(i * 2)
            asm.jumpIfNonZero(32, i * 2 + 1)
            asm.addImm(0, 0, negative)
            asm.bindLabel(i * 2 + 1)
            expected += values[i] ? positive : negative
        }
        asm.ret()
        const run = (ts as any).createNativeFn(new Uint8Array(asm.bytes()))
        intrinsics.assert(Number(run()) === expected, 'float conditional branches')
        for (const value of values) {
            const select = hostTarget.createAssembler()
            select.movF64(32, value)
            select.movImm(1, 7)
            select.movImm(2, 3)
            select.select(0, 32, 1, 2)
            select.ret()
            const choose = (ts as any).createNativeFn(new Uint8Array(select.bytes()))
            intrinsics.assert(Number(choose()) === (value ? 7 : 3), 'float select predicate')
        }
    })
}
