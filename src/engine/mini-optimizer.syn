        [sizeClasses, [1], [3], [7]],
        [widthPlaceScan, [5]],
        [slotChain, [3]],
        [scaledScan, [4]],
        [reindexFill, [3]],
        [inlinedKillArm, [2], [5]],
        [usersClosure, [2, 0], [2, 1], [2, 2]],
        [usersOf, [4, 0], [4, 1], [4, 2]],
        [closureMemo, [3]],
        // [rawBranch, [3]],
        // [rawCreate, [3]],
        [mapCreateOne, [3]],
        [mapCreateNoJoin, [3]],
        [mapCreateCount, [3]],
        [mapBranch, [3]],
        [mapLoop, [3]],
        [mapCreate, [3]],
        [mapObject, [4]],
        [mapOfMap, [4]],
        [mapOfMaps, [3]],
        [mapOfMapsSigned, [3], [0], [12]],
        [oneShape, [4]],
        [twoShapes, [4]],
        [arrayElement, [4]],
        [returnedField, [4]],
        [iterated, [4]],
        [miniOptimize, [4, 0], [4, 1], [4, 2], [4, 3], [4, 4]],
    ]
    const dumped = intrinsics.argv().find(a => a.startsWith('v8-dump:'))?.slice(8)
    if (dumped) {
        const found = cases.find(([fn]) => fn.name === dumped)!
        ;(globalThis as any).v8.setFlagsFromString(`--print-opt-code --print-opt-code-filter=${dumped} --code-comments`)
        let total = 0
        for (let i = 0; i < 50000; i++) total += (found[0] as any)(...found[1])
        console.log('v8-dump done', total)
    }
    if (harness.benching()) {
        function sumLoop(n: u32): u32 {
            let total: u32 = 0
            for (let i: u32 = 0; i < n; i++) total = total + i * 3
            return total
        }
        const zeroArmFlip = intrinsics.tagNoInline(function zeroArmFlip(p: usize, key: u32): u32 {
            const n = intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32)
            if (n !== 0) {
                const start = (key ^ (key >>> 3)) & 3
                for (let i: u32 = 0; i < n; i++) {
                    if (intrinsics.Intrinsics.load(p, 16 + ((start + i) & 3) * 4, intrinsics.Types.u32) === key) return i + 10
                }
                return 0
            }
            for (let i: u32 = 0; i < 4; i++) {
                if (intrinsics.Intrinsics.load(p, 16 + i * 4, intrinsics.Types.u32) === key) return i + 1
            }
            return 0
        })
        const slotValueThreaded = intrinsics.tagNoInline(function slotValueThreaded(p: usize, mask: u32, key: u32): u32 {
            for (let i: u32 = 0; i <= mask; i++) {
                const slot = (key + i) & mask
                if (intrinsics.Intrinsics.load(p, slot * 4, intrinsics.Types.u32) === key) return intrinsics.Intrinsics.load(p, 64 + slot * 4, intrinsics.Types.u32)
            }
            return 0
        })
        function zeroTable(n: u32): usize {
            const p = allocate(32)
            intrinsics.Intrinsics.store(p, 0, n, intrinsics.Types.u32)
            for (let i: u32 = 0; i < 4; i++) intrinsics.Intrinsics.store(p, 16 + i * 4, i * 3, intrinsics.Types.u32)
            return p
        }
        function slotTable(n: u32): usize {
            const p = allocate(128)
            for (let i: u32 = 0; i < 16; i++) {
                intrinsics.Intrinsics.store(p, i * 4, i * n, intrinsics.Types.u32)
                intrinsics.Intrinsics.store(p, 64 + i * 4, i + 100, intrinsics.Types.u32)
            }
            return p
        }
        function slotTableDirect(n: u32): usize {
            const p = allocate(128)
            for (let i: u32 = 0; i < 16; i++) {
                intrinsics.Intrinsics.store(p, i * 4, i + 16 * n, intrinsics.Types.u32)
                intrinsics.Intrinsics.store(p, 64 + i * 4, i + 100, intrinsics.Types.u32)
            }
            return p
        }
        function slotValueFirstHit(n: u32): u32 {
            const p = slotTableDirect(n)
            let total: u32 = 0
            for (let i: u32 = 0; i < 1000; i++) total += slotValue(p, 15, (i & 15) + 16 * n)
            return total
        }
        function slotValueThreadedFirstHit(n: u32): u32 {
            const p = slotTableDirect(n)
            let total: u32 = 0
            for (let i: u32 = 0; i < 1000; i++) total += slotValueThreaded(p, 15, (i & 15) + 16 * n)
            return total
        }
        function zeroArmHot(n: u32): u32 {
            const p = zeroTable(n)
            let total: u32 = 0
            for (let i: u32 = 0; i < 1000; i++) total += zeroArm(p, (i & 3) * 3)
            return total
        }
        function zeroArmFlipHot(n: u32): u32 {
            const p = zeroTable(n)
            let total: u32 = 0
            for (let i: u32 = 0; i < 1000; i++) total += zeroArmFlip(p, (i & 3) * 3)
            return total
        }
        function slotValueHit(n: u32): u32 {
            const p = slotTable(n)
            let total: u32 = 0
            for (let i: u32 = 0; i < 1000; i++) total += slotValue(p, 15, (i & 15) * n)
            return total
        }
        function slotValueThreadedHit(n: u32): u32 {
            const p = slotTable(n)
            let total: u32 = 0
            for (let i: u32 = 0; i < 1000; i++) total += slotValueThreaded(p, 15, (i & 15) * n)
            return total
        }
        const chaseNew = intrinsics.tagNoInline(function chaseNew(heap: usize, next: u32, payload: u32): u32 {
            const id = intrinsics.Intrinsics.load(heap, 24, intrinsics.Types.u32)
            intrinsics.assert(id < intrinsics.Intrinsics.load(heap, 28, intrinsics.Types.u32))
            const node = intrinsics.Intrinsics.load(heap, 8, intrinsics.Types.u64) as usize + id * 32
            const link = node + 16
            intrinsics.Intrinsics.store(node, 0, next, intrinsics.Types.u32)
            intrinsics.Intrinsics.store(node, 4, payload, intrinsics.Types.u32)
            intrinsics.Intrinsics.store(node, 8, link, intrinsics.Types.u64)
            intrinsics.Intrinsics.store(link, 0, next, intrinsics.Types.u32)
            intrinsics.Intrinsics.store(intrinsics.Intrinsics.load(heap, 0, intrinsics.Types.u64) as usize, id * 8, node, intrinsics.Types.u64)
            intrinsics.Intrinsics.store(heap, 24, id + 1, intrinsics.Types.u32)
            return id
        })
        const chaseWalk2 = intrinsics.tagNoInline(function chaseWalk2(heap: usize, head: u32): u32 {
            let total: u32 = 0
            let id = head
            while (id !== 0) {
                intrinsics.assert(id < intrinsics.Intrinsics.load(heap, 24, intrinsics.Types.u32))
                const node = intrinsics.Intrinsics.load(intrinsics.Intrinsics.load(heap, 0, intrinsics.Types.u64) as usize, id * 8, intrinsics.Types.u64) as usize
                total = total + intrinsics.Intrinsics.load(node, 4, intrinsics.Types.u32)
                id = intrinsics.Intrinsics.load(node, 0, intrinsics.Types.u32)
            }
            return total + intrinsics.Intrinsics.load(heap, 24, intrinsics.Types.u32)
        })
        const chaseWalk3 = intrinsics.tagNoInline(function chaseWalk3(heap: usize, head: u32): u32 {
            let total: u32 = 0
            let id = head
            while (id !== 0) {
                intrinsics.assert(id < intrinsics.Intrinsics.load(heap, 24, intrinsics.Types.u32))
                const node = intrinsics.Intrinsics.load(intrinsics.Intrinsics.load(heap, 0, intrinsics.Types.u64) as usize, id * 8, intrinsics.Types.u64) as usize
                total = total + intrinsics.Intrinsics.load(node, 4, intrinsics.Types.u32)
                const link = intrinsics.Intrinsics.load(node, 8, intrinsics.Types.u64) as usize
                id = intrinsics.Intrinsics.load(link, 0, intrinsics.Types.u32)
            }
            return total + intrinsics.Intrinsics.load(heap, 24, intrinsics.Types.u32)
        })
        function chaseHeap(n: u32): usize {
            const heap = allocate(32)
            intrinsics.Intrinsics.store(heap, 0, allocate((n + 1) * 8), intrinsics.Types.u64)
            intrinsics.Intrinsics.store(heap, 8, allocate((n + 1) * 32), intrinsics.Types.u64)
            intrinsics.Intrinsics.store(heap, 24, 1, intrinsics.Types.u32)
            intrinsics.Intrinsics.store(heap, 28, n + 1, intrinsics.Types.u32)
            return heap
        }
        function chaseLists(heap: usize, nodes: u32, lists: u32, scatter: u32): usize {
            const heads = allocate(lists * 4)
            for (let l: u32 = 0; l < lists; l++) intrinsics.Intrinsics.store(heads, l * 4, 0, intrinsics.Types.u32)
            let seed: u32 = 7
            let run: u32 = 0
            let cur: u32 = 0
            for (let i: u32 = 0; i < nodes; i++) {
                seed = (seed * 75 + 74) % 65537
                const l = scatter ? seed % lists : cur
                const id = chaseNew(heap, intrinsics.Intrinsics.load(heads, l * 4, intrinsics.Types.u32), i)
                intrinsics.Intrinsics.store(heads, l * 4, id, intrinsics.Types.u32)
                run = run + 1
                if (run === 3) {
                    run = 0
                    cur = cur + 1 === lists ? 0 : cur + 1
                }
            }
            return heads
        }
        function chaseRun(n: u32, lists: u32, scatter: u32, deep: u32): u32 {
            const heap = chaseHeap(n)
            const heads = chaseLists(heap, n, lists, scatter)
            let total: u32 = 0
            for (let w: u32 = 0; w < 20; w++) {
                for (let l: u32 = 0; l < lists; l++) {
                    const head = intrinsics.Intrinsics.load(heads, l * 4, intrinsics.Types.u32)
                    total = total + (deep ? chaseWalk3(heap, head) : chaseWalk2(heap, head))
                }
            }
            return total
        }
        function chaseShort(n: u32): u32 { return chaseRun(50, 500, 1, n & 0) }
        function chaseShortSeq(n: u32): u32 { return chaseRun(50, 500, 0, n & 0) }
        function chaseLong(n: u32): u32 { return chaseRun(3000, 1, 0, n & 0) }
        function chaseShortDeep(n: u32): u32 { return chaseRun(50, 500, 1, (n & 0) + 1) }
        function chaseLongDeep(n: u32): u32 { return chaseRun(3000, 1, 0, (n & 0) + 1) }
        function pressureLoop(n: u32): u32 {
            let s0: u32 = 0
            let s1: u32 = 1
            let s2: u32 = 2
            let s3: u32 = 3
            let s4: u32 = 4
            let s5: u32 = 5
            let s6: u32 = 6
            let s7: u32 = 7
            let s8: u32 = 8
            let s9: u32 = 9
            let s10: u32 = 10
            let s11: u32 = 11
            let s12: u32 = 12
            let s13: u32 = 13
            let s14: u32 = 14
            let s15: u32 = 15
            let s16: u32 = 16
            let s17: u32 = 17
            let s18: u32 = 18
            let s19: u32 = 19
            let s20: u32 = 20
            let s21: u32 = 21
            let s22: u32 = 22
            let s23: u32 = 23
            let s24: u32 = 24
            let s25: u32 = 25
            let s26: u32 = 26
            let s27: u32 = 27
            for (let i: u32 = 0; i < n; i++) {
                s0 = s0 + (i ^ 0)
                s1 = s1 + (i ^ 1)
                s2 = s2 + (i ^ 2)
                s3 = s3 + (i ^ 3)
                s4 = s4 + (i ^ 4)
                s5 = s5 + (i ^ 5)
                s6 = s6 + (i ^ 6)
                s7 = s7 + (i ^ 7)
                s8 = s8 + (i ^ 8)
                s9 = s9 + (i ^ 9)
                s10 = s10 + (i ^ 10)
                s11 = s11 + (i ^ 11)
                s12 = s12 + (i ^ 12)
                s13 = s13 + (i ^ 13)
                s14 = s14 + (i ^ 14)
                s15 = s15 + (i ^ 15)
                s16 = s16 + (i ^ 16)
                s17 = s17 + (i ^ 17)
                s18 = s18 + (i ^ 18)
                s19 = s19 + (i ^ 19)
                s20 = s20 + (i ^ 20)
                s21 = s21 + (i ^ 21)
                s22 = s22 + (i ^ 22)
                s23 = s23 + (i ^ 23)
                s24 = s24 + (i ^ 24)
                s25 = s25 + (i ^ 25)
                s26 = s26 + (i ^ 26)
                s27 = s27 + (i ^ 27)
            }
            return s0 + s1 * 3 + s2 * 4 + s3 * 5 + s4 * 6 + s5 * 7 + s6 * 8 + s7 * 2 + s8 * 1 + s9 * 3 + s10 * 4 + s11 * 5 + s12 * 6 + s13 * 7 + s14 * 8 + s15 * 2 + s16 * 1 + s17 * 3 + s18 * 4 + s19 * 5 + s20 * 6 + s21 * 7 + s22 * 8 + s23 * 2 + s24 * 1 + s25 * 3 + s26 * 4 + s27 * 5
        }
        function pressureBranch(n: u32, a: u32, b: u32): u32 {
            let s0: u32 = a
            let s1: u32 = b
            let s2: u32 = a + 2
            let s3: u32 = b + 3
            let s4: u32 = a + 4
            let s5: u32 = b + 5
            let s6: u32 = a + 6
            let s7: u32 = b + 7
            let s8: u32 = a + 8
            let s9: u32 = b + 9
            let s10: u32 = a + 10
            let s11: u32 = b + 11
            let s12: u32 = a + 12
            let s13: u32 = b + 13
            let s14: u32 = a + 14
            let s15: u32 = b + 15
            let s16: u32 = a + 16
            let s17: u32 = b + 17
            let s18: u32 = a + 18
            let s19: u32 = b + 19
            let s20: u32 = a + 20
            let s21: u32 = b + 21
            let s22: u32 = a + 22
            let s23: u32 = b + 23
            let s24: u32 = a + 24
            let s25: u32 = b + 25
            for (let i: u32 = 0; i < n; i++) {
                let x: u32 = b
                if ((i & 1) === 0) x = a
                s0 = s0 + (x ^ 0)
                s1 = s1 + (x ^ 1)
                s2 = s2 + (x ^ 2)
                s3 = s3 + (x ^ 3)
                s4 = s4 + (x ^ 4)
                s5 = s5 + (x ^ 5)
                s6 = s6 + (x ^ 6)
                s7 = s7 + (x ^ 7)
                s8 = s8 + (x ^ 8)
                s9 = s9 + (x ^ 9)
                s10 = s10 + (x ^ 10)
                s11 = s11 + (x ^ 11)
                s12 = s12 + (x ^ 12)
                s13 = s13 + (x ^ 13)
                s14 = s14 + (x ^ 14)
                s15 = s15 + (x ^ 15)
                s16 = s16 + (x ^ 16)
                s17 = s17 + (x ^ 17)
                s18 = s18 + (x ^ 18)
                s19 = s19 + (x ^ 19)
                s20 = s20 + (x ^ 20)
                s21 = s21 + (x ^ 21)
                s22 = s22 + (x ^ 22)
                s23 = s23 + (x ^ 23)
                s24 = s24 + (x ^ 24)
                s25 = s25 + (x ^ 25)
            }
            return s0 + s1 * 3 + s2 * 4 + s3 * 5 + s4 * 6 + s5 * 7 + s6 * 8 + s7 * 2 + s8 * 1 + s9 * 3 + s10 * 4 + s11 * 5 + s12 * 6 + s13 * 7 + s14 * 8 + s15 * 2 + s16 * 1 + s17 * 3 + s18 * 4 + s19 * 5 + s20 * 6 + s21 * 7 + s22 * 8 + s23 * 2 + s24 * 1 + s25 * 3
        }
        const benches = harness.createBenches()
        benches.bench(chaseShort, [3000])
        benches.bench(chaseShortSeq, [3000])
        // benches.bench(chaseLong, [3000])
        benches.bench(chaseShortDeep, [3000])
        // benches.bench(chaseLongDeep, [3000])
        benches.bench(zeroArmHot, [3])
        benches.bench(zeroArmFlipHot, [3])
        benches.bench(slotValueHit, [5])
        benches.bench(slotValueThreadedHit, [5])
        benches.bench(slotValueFirstHit, [5])
        benches.bench(slotValueThreadedFirstHit, [5])
        benches.bench(sumLoop, [10000])
        benches.bench(pressureLoop, [2000])
        benches.bench(pressureBranch, [2000, 5, 9])
        benches.bench(mapLoop, [300])
        benches.bench(mapOfMaps, [60])
        benches.bench(usersClosure, [150, 0])
        benches.bench(miniOptimize, [120, 0])
        benches.run()
    }
    harness.runCases({ prefix: 'mini', args: true, stacks: true }, cases)
}
