        const table = allocate((n + 1) * 8)
        intrinsics.Intrinsics.store(h, 0, table, intrinsics.Types.u64)
        for (let i: u32 = 1; i <= n; i++) {
            const entry = allocate(8)
            intrinsics.Intrinsics.store(table, i * 8, entry, intrinsics.Types.u64)
            intrinsics.Intrinsics.store(entry, 0, i % 2 === 0 ? 2 : 1, intrinsics.Types.u8)
            intrinsics.Intrinsics.store(entry, 2, i % 3, intrinsics.Types.u16)
            intrinsics.Intrinsics.store(entry, 4, i < n ? i + 1 : 0, intrinsics.Types.u16)
