/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as native from './native'

enum Op {
    lit,
    add,
    mul,
}

interface Node {
    op: u32
    args: u32[]
    value: u32
}

interface Block {
    id: u32
    body: u32[]
}

interface Known {
    known: boolean
    value: u32
}

if (intrinsics.argv()[0] === 'mini-optimizer') {
    function miniOptimize(n: u32, part: u32): u32 {
        const nodes = new Map<u32, Node>()
        const usedBy = new Map<u32, Set<u32>>()
        const byOp = new Map<u32, Map<u32, u32[]>>()
        const blocks: Block[] = []
        const memo = new Map<u32, Known>()
        let nextId: u32 = 1

        function add(op: u32, args: u32[], value: u32): u32 {
            const id = nextId++
            nodes.set(id, { op, args, value })
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
            return id
        }

        function index(b: Block): void {
            let ops = byOp.get(b.id)
            if (!ops) {
                ops = new Map<u32, u32[]>()
                byOp.set(b.id, ops)
            }
            for (const id of b.body) {
                const op = nodes.get(id)!.op
                let ids = ops.get(op)
                if (!ids) {
                    ids = []
                    ops.set(op, ids)
                }
                ids.push(id)
            }
        }

        function fold(): boolean {
            let changed = false
            for (const b of blocks) {
                const adds = byOp.get(b.id)?.get(Op.add) ?? []
                for (const id of adds) {
                    const node = nodes.get(id)!
                    if (node.op !== Op.add) continue
                    const x = nodes.get(node.args[0])!
                    const y = nodes.get(node.args[1])!
                    if (x.op !== Op.lit || y.op !== Op.lit) continue
                    node.op = Op.lit
                    node.value = x.value + y.value
                    node.args = []
                    changed = true
                }
            }
            return changed
        }

        function evaluate(id: u32): Known {
            const hit = memo.get(id)
            if (hit) return hit
            const node = nodes.get(id)!
            let result: Known = { known: false, value: 0 }
            if (node.op === Op.lit) {
                result = { known: true, value: node.value }
            } else if (node.op === Op.mul) {
                const x = evaluate(node.args[0])
                const y = evaluate(node.args[1])
                if (x.known && y.known) result = { known: true, value: x.value * y.value }
            }
            memo.set(id, result)
            return result
        }

        function countUses(): u32 {
            let total: u32 = 0
            for (const b of blocks) {
                for (const id of b.body) {
                    for (const u of usedBy.get(id) ?? []) total = total + u
                }
            }
            return total
        }

        for (let i: u32 = 0; i < n; i++) {
            const l1 = add(Op.lit, [], i)
            const l2 = add(Op.lit, [], i * 2)
            const s = add(Op.add, [l1, l2], 0)
            const t = add(Op.add, [s, l1], 0)
            const m = add(Op.mul, [t, s], 0)
            blocks.push({ id: i, body: [l1, l2, s, t, m] })
        }
        for (const b of blocks) index(b)

        const passes = [fold, fold]
        let rounds: u32 = 0
        for (const pass of passes) {
            if (pass()) rounds++
        }

        let values: u32 = 0
        let evaluated: u32 = 0
        for (const b of blocks) {
            for (const id of b.body) {
                const node = nodes.get(id)!
                values = values + node.op * 100 + node.value
            }
            evaluated = evaluated + evaluate(b.body[b.body.length - 1]).value
        }
        const uses = countUses()
        if (part === 1) return rounds
        if (part === 2) return uses
        if (part === 3) return values
        if (part === 4) return evaluated
        return (values + evaluated + uses + rounds * 1000) & 0xFFFFFF
    }

    function arrayElement(n: u32): u32 {
        const bs: Block[] = [{ id: n, body: [] }]
        return bs[0].id
    }
    function wrap(b: Block): { done: boolean, value: Block } {
        return { done: false, value: b }
    }
    function returnedField(n: u32): u32 {
        return wrap({ id: n, body: [] }).value.id
    }
    function iterated(n: u32): u32 {
        const bs: Block[] = [{ id: n, body: [] }, { id: n + 1, body: [] }]
        let total: u32 = 0
        for (const b of bs) total = total + b.id
        return total
    }

    function twoShapes(n: u32): u32 {
        const a: any[] = []
        a.push({ id: n, body: [] })
        const b: any[] = []
        b.push({ x: 1, id: n + 1 })
        b.push({ x: 2, id: n + 2 })
        return a.length * 10 + b.length
    }

    function oneShape(n: u32): u32 {
        const a: any[] = []
        a.push({ id: n })
        const b: any[] = []
        b.push({ id: n + 1 })
        return a.length * 10 + b.length
    }

    function mapOfMaps(n: u32): u32 {
        const byOp = new Map<u32, Map<u32, u32[]>>()
        for (let i: u32 = 0; i < n; i++) {
            let ops = byOp.get(i)
            if (!ops) {
                ops = new Map<u32, u32[]>()
                byOp.set(i, ops)
            }
            let ids = ops.get(1)
            if (!ids) {
                ids = []
                ops.set(1, ids)
            }
            ids.push(i + 10)
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            const adds = byOp.get(i)?.get(1) ?? []
            for (const id of adds) total = total + id
        }
        return total
    }

    function mapObject(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        m.set(1, { x: n })
        return m.get(1)!.x
    }
    function mapOfMap(n: u32): u32 {
        const m = new Map<u32, Map<u32, u32>>()
        const inner = new Map<u32, u32>()
        inner.set(2, n)
        m.set(1, inner)
        return m.get(1)!.get(2)!
    }

    function mapLoop(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) m.set(i, { x: i + 10 })
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }
    function mapCreate(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            let o = m.get(i)
            if (!o) {
                o = { x: i + 10 }
                m.set(i, o)
            }
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }

    function mapCreateCount(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            let o = m.get(i)
            if (!o) {
                o = { x: i + 10 }
                m.set(i, o)
            }
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + (m.get(i) ? 1 : 0)
        return total * 100 + m.size
    }
    function mapBranch(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (i < 100) m.set(i, { x: i + 10 })
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }

    function mapCreateOne(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            let o = m.get(i)
            if (!o) {
                o = { x: i + 10 }
                m.set(i, o)
            }
        }
        return m.get(1)!.x
    }
    function mapCreateNoJoin(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (!m.get(i)) m.set(i, { x: i + 10 })
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }

    function rawBranch(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (i < 100) m.set(i, { x: i + 10 })
        }
        return m.get(0) as any
    }
    function rawCreate(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (!m.get(i)) m.set(i, { x: i + 10 })
        }
        return m.get(0) as any
    }

    function closureMemo(n: u32): u32 {
        const memo = new Map<u32, Known>()
        function ev(id: u32): Known {
            const hit = memo.get(id)
            if (hit) return hit
            let r: Known = { known: false, value: 0 }
            if (id < n) r = { known: true, value: id * 2 }
            memo.set(id, r)
            return r
        }
        return ev(1).value + ev(1).value * 10 + ev(5).value * 100
    }

    function usersOf(n: u32, part: u32): u32 {
        const usedBy = new Map<u32, Set<u32>>()
        for (let id: u32 = 1; id <= n; id++) {
            const args: u32[] = [id % 2, (id + 1) % 3]
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
        }
        let total: u32 = 0
        let count: u32 = 0
        for (let k: u32 = 0; k < 4; k++) {
            for (const u of usedBy.get(k) ?? []) {
                total = total + u
                count++
            }
        }
        if (part === 1) return count
        if (part === 2) return usedBy.size
        return total
    }

    function usersClosure(n: u32, part: u32): u32 {
        const usedBy = new Map<u32, Set<u32>>()
        let nextId: u32 = 1
        function add(args: u32[]): u32 {
            const id = nextId++
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
            return id
        }
        function count(): u32 {
            let total: u32 = 0
            for (const u of usedBy.get(1) ?? []) total = total + u
            for (const u of usedBy.get(2) ?? []) total = total + u * 10
            for (const u of usedBy.get(7) ?? []) total = total + u * 100
            return total
        }
        for (let i: u32 = 0; i < n; i++) {
            const x = add([])
            const y = add([x])
            add([x, y])
        }
        if (part === 1) return nextId
        if (part === 2) return usedBy.size
        return count()
    }

    function twoNew(n: u32): u32 {
        const usedBy = new Map<u32, Set<u32>>()
        let nextId: u32 = 1
        function add(args: u32[]): u32 {
            const id = nextId++
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
            return id
        }
        for (let i: u32 = 0; i < n; i++) {
            const x = add([])
            const y = add([])
            add([x, y])
        }
        let total: u32 = 0
        for (const u of usedBy.get(1) ?? []) total = total * 100 + u
        return total
    }

    function getOrCreate(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        let o = m.get(n)
        if (!o) {
            o = { x: n }
            m.set(n, o)
        }
        return o.x
    }

    function nestedCreate(n: u32): u32 {
        const outer = new Map<u32, Map<u32, u32>>()
        for (let i: u32 = 0; i < n; i++) {
            let inner = outer.get(i)
            if (!inner) {
                inner = new Map<u32, u32>()
                outer.set(i, inner)
            }
            inner.set(1, i)
        }
        return outer.size
    }

    function stringLiteralJoin(n: u32): u32 {
        const s = n > 2 ? 'add' : 'lit'
        return s.length
    }
    function stringParamLength(n: u32): u32 {
        function len(op: string): u32 {
            return op.length
        }
        return len('add') + len('mul') * n
    }
    function stringFieldLength(n: u32): u32 {
        const m = new Map<u32, { op: string }>()
        m.set(1, { op: 'add' })
        m.set(2, { op: 'load' })
        return m.get(1)!.op.length + m.get(2)!.op.length * n
    }
    function stringFieldEquals(n: u32): u32 {
        const m = new Map<u32, { op: string }>()
        m.set(1, { op: 'add' })
        m.set(2, { op: 'mul' })
        return (m.get(1)!.op === 'add' ? 1 : 0) + (m.get(2)!.op === 'add' ? 10 : 0) + n
    }
    function stringConcatEquals(n: u32): u32 {
        function check(prefix: string): u32 {
            return prefix + 'd' === 'add' ? 1 : 2
        }
        return check('ad') * 10 + check('mu') + n
    }
    function mapEntries(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        let total: u32 = 0
        for (const [k, v] of m) total = total + k * 10 + v
        return total
    }
    function mapKeysValues(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        let total: u32 = 0
        for (const k of m.keys()) total = total + k * 100
        for (const v of m.values()) total = total + v
        return total
    }
    function mapDeleteForEach(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        m.set(3, n * 3)
        const removed = m.delete(2) ? 1000 : 0
        const missing = m.delete(7) ? 2000 : 0
        let total: u32 = removed + missing + m.size * 100
        m.forEach((v, k) => { total = total + k * 10 + v })
        m.clear()
        return total + m.size + (m.has(1) ? 5000 : 0)
    }
    function mapDeleteSize(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        m.delete(2)
        return m.size
    }
    function localClass(n: u32): u32 {
        class Box {
            declare size: u32
            declare list: u32[]
            constructor() {
                this.size = 0
                this.list = []
            }
            add(v: u32): void {
                this.list.push(v)
                this.size = this.size + 1
            }
            drop(): boolean {
                this.size = this.size - 1
                this.list.length = this.size
                return true
            }
        }
        const b = new Box()
        b.add(n)
        b.add(n)
        const dropped = b.drop() ? 1000 : 0
        return dropped + b.size * 10 + b.list.length
    }
    function closureSignedResult(n: u32): u32 {
        function cmp(x: u32, y: u32): number {
            return x - y
        }
        return (cmp(1, n) > 0 ? 10 : 20) + (cmp(n, 1) > 0 ? 1 : 2)
    }
    function closureReturnsObject(n: u32): u32 {
        function make(v: u32): { value: u32 } {
            return { value: v }
        }
        return make(n).value + 1
    }

    function functionKeyedMap(n: u32): u32 {
        function a(x: u32): u32 { return x + 1 }
        function b(x: u32): u32 { return x * 2 }
        const seen = new Map<(x: u32) => u32, u32>()
        seen.set(a, 1)
        seen.set(b, 2)
        return (seen.get(a) ?? 0) * 10 + (seen.get(b) ?? 0) + n
    }
    function templateKeyMap(n: u32): u32 {
        const keys = new Map<string, u32>()
        let made: u32 = 0
        function intern(op: string, x: u32, y: u32): u32 {
            const key = `${op}:${x},${y}`
            const known = keys.get(key)
            if (known !== undefined) return known
            made++
            keys.set(key, made)
            return made
        }
        return intern('add', 1, n) * 100 + intern('add', 1, n) * 10 + intern('mul', 1, n)
    }
    function labeledContinue(n: u32): u32 {
        let total: u32 = 0
        outer: for (let i: u32 = 0; i < n; i++) {
            for (let j: u32 = 0; j < n; j++) {
                if (j === i) continue outer
                total = total + j
            }
        }
        return total
    }
    function setSpread(n: u32): u32 {
        const s = new Set<u32>()
        for (let i: u32 = 0; i < n; i++) s.add(i * 3)
        const arr = [...s]
        return arr.length * 100 + arr[arr.length - 1]
    }
    function arraySortComparator(n: u32): u32 {
        const arr: u32[] = [n, 1, n * 3, 2]
        arr.sort((x, y) => x - y)
        return arr[0] * 1000 + arr[1] * 100 + arr[3]
    }
    function arrayFilterMap(n: u32): u32 {
        const arr: u32[] = [1, 2, 3, 4, 5, 6]
        const out = arr.filter(x => x > n).map(x => x * 2)
        let total: u32 = 0
        for (const x of out) total = total + x
        return total
    }
    function arraySomeEvery(n: u32): u32 {
        const arr: u32[] = [2, 4, 6]
        return (arr.some(x => x === n) ? 10 : 0) + (arr.every(x => x % 2 === 0) ? 1 : 0)
    }
    function deferPop(n: u32): u32 {
        const stack: u32[] = []
        function visit(x: u32): u32 {
            stack.push(x)
            defer stack.pop()
            if (x === 0) return stack.length
            return visit(x - 1)
        }
        return visit(n) * 10 + stack.length
    }
    function memoReplaceAll(n: u32): u32 {
        const nodes = new Map<u32, u32[]>()
        let nextId: u32 = 10
        nodes.set(1, [])
        nodes.set(2, [1])
        nodes.set(3, [2, 1])
        function replaceAll(id: u32, replacements: Map<u32, u32>): u32 {
            const known = replacements.get(id)
            if (known !== undefined) return known
            const args = nodes.get(id)!
            let changed = false
            const next: u32[] = []
            for (const a of args) {
                const r = replaceAll(a, replacements)
                if (r !== a) changed = true
                next.push(r)
            }
            if (!changed) return id
            const copy = nextId++
            nodes.set(copy, next)
            replacements.set(id, copy)
            return copy
        }
        const r = new Map<u32, u32>()
        r.set(1, n)
        nodes.set(n, [])
        return replaceAll(3, r) * 100 + nodes.size
    }
    function epochField(n: u32): u32 {
        const nodes = new Map<u32, { epoch: u32, args: u32[] }>()
        nodes.set(1, { epoch: 0, args: [] })
        nodes.set(2, { epoch: 0, args: [1] })
        nodes.set(3, { epoch: 0, args: [1, 2] })
        let visits: u32 = 0
        function walk(id: u32, epoch: u32): void {
            const node = nodes.get(id)!
            if (node.epoch === epoch) return
            node.epoch = epoch
            visits++
            for (const a of node.args) walk(a, epoch)
        }
        walk(3, n)
        walk(3, n)
        walk(3, n + 1)
        return visits
    }
    function typedArrayField(n: u32): u32 {
        const node = { op: 1, slots: new Uint32Array(3) }
        node.slots[0] = n
        node.slots[1] = n * 2
        node.slots[2] = node.slots[0] + node.slots[1]
        return node.slots[2] + node.slots.length
    }
    function stringSwitch(n: u32): u32 {
        function cost(op: string): u32 {
            switch (op) {
                case 'add': return 1
                case 'mul': return 3
                default: return 10
            }
        }
        return cost('add') + cost('mul') * 10 + cost('load') * 100 + n
    }
    function passList(n: u32): u32 {
        let state: u32 = n
        function double(b: u32): boolean { state = state * 2 + b; return true }
        function bump(b: u32): boolean { state = state + b; return false }
        const passes = [double, bump, double]
        let changes: u32 = 0
        for (let b: u32 = 0; b < 2; b++) {
            for (const pass of passes) if (pass(b)) changes++
        }
        return state * 10 + changes
    }
    function operandUnion(n: u32): u32 {
        function encode(x: number | { literal: number }): number {
            return typeof x === 'number' ? x + 1000 : x.literal
        }
        return encode(n) + encode({ literal: 7 }) * 10000
    }
    function operandArray(n: u32): u32 {
        const ops: (number | { literal: number })[] = [n, { literal: 7 }, n * 2]
        let total: u32 = 0
        for (const op of ops) total = total + (typeof op === 'number' ? op : op.literal * 100)
        return total
    }
    function typedArrayCopy(n: u32): u32 {
        const node = { op: 'add', slots: new Uint32Array(2) }
        node.slots[0] = n
        node.slots[1] = n + 1
        const copy = node.slots.slice()
        copy[0] = 9
        const grown = new Uint32Array(node.slots.length + 1)
        for (let i = 0; i < node.slots.length; i++) grown[i] = node.slots[i]
        grown[node.slots.length] = 5
        node.slots = grown
        return node.slots[0] + copy[0] * 10 + node.slots.length * 100 + node.slots[2] * 1000
    }
    function slotEncoding(n: u32): u32 {
        const refBias = 2 ** 29
        const mask = 0x0FFFFFFF
        function encode(v: number): number { return v & mask }
        function decode(v: number): number { return Number.asIntN(28, v) }
        function getRef(slot: number): number {
            const id = slot - refBias as i32
            return id >= 0 ? id : 0
        }
        const pos = decode(encode(-5))
        return getRef(refBias + n) * 10 + (pos === -5 ? 1 : 0) + getRef(3) * 100
    }
    function objectSpread(n: u32): u32 {
        function create(init?: { a?: u32, b?: u32 }) {
            return { a: 1, b: 2, ...init }
        }
        const x = create()
        const y = create({ b: n })
        return x.a + x.b * 10 + y.b * 100 + y.a * 1000
    }
    function defaultParams(n: u32): u32 {
        function count(xs: u32[]): number { return xs.length }
        function clamp(arity: number, start: number, end: number): number[] {
            const from = start < 0 ? Math.max(arity + start, 0) : Math.min(start, arity)
            const to = end < 0 ? Math.max(arity + end, 0) : Math.min(end, arity)
            return [from, Math.max(to, from)]
        }
        function range(xs: u32[], start = 0, end = count(xs)): number {
            const [from, to] = clamp(xs.length, start, end)
            return to - from
        }
        const xs = [n, n, n, n]
        return range(xs) + range(xs, 1) * 10 + range(xs, 1, 3) * 100
    }
    function customIterator(n: u32): u32 {
        function refs(xs: u32[]) {
            let i = 0
            return {
                next() {
                    while (i < xs.length) {
                        const r = xs[i++]
                        if (r) return { done: false, value: r }
                    }
                    return { done: true, value: 0 }
                },
                [Symbol.iterator]() { return this },
            }
        }
        let total: u32 = 0
        for (const r of refs([n, 0, n + 1])) total = total + r
        return total
    }
    function arrayPresized(n: u32): u32 {
        const out = new Array<u32>(n)
        for (let i: u32 = 0; i < n; i++) out[i] = i * 3
        return out[n - 1] + out.length * 100
    }
    function stringSet(n: u32): u32 {
        const typed = new Set<string>(['param', 'add', 'load'])
        function slots(op: string): u32 { return typed.has(op) ? 1 : 0 }
        const nodes = [{ op: 'add' }, { op: 'call' }, { op: 'load' }]
        let total: u32 = n
        for (const node of nodes) total = total + slots(node.op) * 10
        return total
    }
    function floatPool(n: u32): u32 {
        const allocated: number[] = []
        const at = new Map<number, number>()
        function intern(v: number): number {
            let i = at.get(v)
            if (i === undefined) {
                i = allocated.length
                allocated.push(v)
                at.set(v, i)
            }
            return i
        }
        const a = intern(1.5)
        const b = intern(n + 0.25)
        const c = intern(1.5)
        return a + b * 10 + c * 100 + Math.floor(allocated[1] * 4) * 1000
    }
    function mathProbe(n: u32): u32 {
        return Math.max(n, 7) + Math.min(n, 1) * 10 + Math.max(n * 3, 2) * 100 + Math.floor(n) * 1000
    }
    function stringLengths(n: u32): u32 {
        function lengths(a: string, b: string): u32 {
            return a.length + b.length * 10
        }
        const o = { s: 'abcd' }
        return lengths('abc', 'de') + lengths('x', 'wxyz') * 100 + ('a' + 'a').length * 10000 + o.s.length * 100000 + n
    }
    function defaultRecursive(n: u32): u32 {
        function sum(i: u32, acc: u32 = 100): u32 {
            if (i === 0) return acc
            return sum(i - 1, acc + i)
        }
        return sum(n) + sum(n, 5) * 1000
    }
    function literalMethod(n: u32): u32 {
        const o = { base: n, add(x: u32, y: u32): u32 { return this.base + x + y } }
        return o.add(1, 10) + o.add(1, 2) * 100
    }
    function rootDefault(n: u32, k: u32 = 7): u32 {
        return n * 10 + k
    }
    function restArgs(n: u32): u32 {
        function total(base: u32, ...xs: u32[]): u32 {
            let sum = base
            for (const x of xs) sum = sum + x
            return sum * 10 + xs.length
        }
        return total(n) + total(n, 1) * 100 + total(n, 1, 2, 3) * 10000
    }
    function restSpread(n: u32): u32 {
        function total(...xs: u32[]): u32 {
            let sum: u32 = 0
            for (const x of xs) sum = sum + x
            return sum * 10 + xs.length
        }
        const ys = [n, 4, 5]
        return total(...ys) + total(1, ...ys) * 1000
    }
    function plainSpread(n: u32): u32 {
        function three(a: u32, b: u32, c: u32): u32 { return a + b * 10 + c * 100 }
        const ys = [n, 4, 5]
        return three(...ys)
    }
    function float64Array(n: u32): u32 {
        const out = new Float64Array(3)
        out[0] = n
        out[1] = n + 1
        out[2] = out[0] + out[1]
        return out[2] + out.length * 100
    }
    function negativeCompare(n: u32): u32 {
        const start = n - 5
        const from = start < 0 ? Math.max(4 + start, 0) : Math.min(start, 4)
        return from * 10 + (start < 0 ? 1 : 2)
    }
    function negativeArg(n: u32): u32 {
        function clamp(arity: number, end: number): number {
            return end < 0 ? Math.max(arity + end, 0) : Math.min(end, arity)
        }
        return clamp(4, -1) + clamp(n + 1, -2) * 10 + clamp(4, n) * 100
    }
    function absNegative(n: u32): u32 {
        return Math.abs(n - 5) + Math.abs(n) * 10
    }
    function bitconvertWidths(n: u32): u32 {
        const Intrinsics = intrinsics.Intrinsics
        const Types = intrinsics.Types
        const low = Intrinsics.bitconvert(n + 0x1_0000_0000, Types.u64, Types.u32)
        const unsigned = Intrinsics.bitconvert(n - 5, Types.i32, Types.u32)
        const signed = Intrinsics.bitconvert(unsigned, Types.u32, Types.i32)
        return low + (unsigned === 0xFFFF_FFFE ? 10 : 0) + (signed === -2 ? 100 : 0) + (signed < 0 ? 1000 : 0)
    }
    function powInt(n: u32): u32 {
        function p(b: u32, e: u32): u32 { return b ** e }
        return p(n, 3) + p(2, n) * 1000 + p(n, 0) * 100000 + n ** 2 * 1000000
    }
    function closureSetLoop(n: u32): u32 {
        const typed = new Set<u32>([1, 2, 4])
        function slots(op: u32): u32 { return typed.has(op) ? 1 : 0 }
        let total: u32 = n
        for (const op of [2, 3, 4]) total = total + slots(op) * 10
        return total
    }
    const cases: [fn: Function, ...args: number[][]][] = [
        [functionKeyedMap, [3]],
        [powInt, [3]],
        [bitconvertWidths, [3]],
        [negativeArg, [3]],
        [absNegative, [3]],
        // [float64Array, [3]],
        [negativeCompare, [3]],
        [stringLengths, [3]],
        [mathProbe, [3]],
        // [operandUnion, [3]],
        // [operandArray, [3]],
        [typedArrayCopy, [3]],
        [slotEncoding, [3]],
        // [objectSpread, [3]],
        [defaultParams, [3]],
        [defaultRecursive, [3]],
        [rootDefault, [3, 2], [4, 1]],
        [restArgs, [3]],
        [restSpread, [3]],
        [plainSpread, [3]],
        [literalMethod, [3]],
        // [customIterator, [3]],
        [arrayPresized, [3]],
        [stringSet, [3]],
        [closureSetLoop, [3]],
        // [floatPool, [3]],
        // [templateKeyMap, [3]],
        [labeledContinue, [4]],
        [setSpread, [4]],
        [arraySortComparator, [3]],
        [arrayFilterMap, [3]],
        [arraySomeEvery, [4]],
        [deferPop, [3]],
        [memoReplaceAll, [5]],
        [epochField, [3]],
        [typedArrayField, [3]],
        [stringSwitch, [3]],
        [passList, [3]],
        [stringLiteralJoin, [1], [4]],
        [stringParamLength, [3]],
        [stringFieldLength, [3]],
        [stringFieldEquals, [3]],
        // [stringConcatEquals, [3]],
        [mapEntries, [3]],
        [closureReturnsObject, [3]],
        [mapKeysValues, [3]],
        [mapDeleteForEach, [3]],
        [mapDeleteSize, [3]],
        // [localClass, [3]],
        [closureSignedResult, [3]],
        [nestedCreate, [3]],
        [twoNew, [1]],
        [getOrCreate, [4]],
        [usersClosure, [2, 0], [2, 1], [2, 2]],
        [usersOf, [4, 0], [4, 1], [4, 2]],
        [closureMemo, [3]],
        // [rawBranch, [3]],
        // [rawCreate, [3]],
        [mapCreateOne, [3]],
        [mapCreateNoJoin, [3]],
        [mapCreateCount, [3]],
        [mapBranch, [3]],
        [mapLoop, [3]],
        [mapCreate, [3]],
        [mapObject, [4]],
        [mapOfMap, [4]],
        [mapOfMaps, [3]],
        [oneShape, [4]],
        [twoShapes, [4]],
        [arrayElement, [4]],
        [returnedField, [4]],
        [iterated, [4]],
        [miniOptimize, [4, 0], [4, 1], [4, 2], [4, 3], [4, 4]],
    ]
    const dumped = intrinsics.argv().find(a => a.startsWith('v8-dump:'))?.slice(8)
    if (dumped) {
        const found = cases.find(([fn]) => fn.name === dumped)!
        ;(globalThis as any).v8.setFlagsFromString(`--print-opt-code --print-opt-code-filter=${dumped} --code-comments`)
        let total = 0
        for (let i = 0; i < 50000; i++) total += (found[0] as any)(...found[1])
        console.log('v8-dump done', total)
    }
    const only = intrinsics.argv().find(a => a.startsWith('only:'))?.slice(5)
    if (intrinsics.argv().includes('bench')) {
        const benches: [fn: Function, args: number[]][] = [
            [mapLoop, [300]],
            [mapOfMaps, [60]],
            [usersClosure, [150, 0]],
            [miniOptimize, [120, 0]],
        ]
        for (const [fn, args] of benches) {
            if (only && fn.name !== only) continue
            const natives: any = native.createNatives({ [fn.name]: fn })
            const run = natives[fn.name]
            let nativeBest = Infinity
            let jsBest = Infinity
            let nativeResult = 0
            let jsResult = 0
            for (let i = 0; i < 4; i++) {
                let start = performance.now()
                nativeResult = Number(run(...args))
                nativeBest = Math.min(nativeBest, performance.now() - start)
                start = performance.now()
                jsResult = (fn as any)(...args)
                jsBest = Math.min(jsBest, performance.now() - start)
            }
            const check = nativeResult === jsResult ? '' : ` MISMATCH native=${nativeResult} js=${jsResult}`
            console.log(`bench ${fn.name}(${args.join(', ')}) native ${nativeBest.toFixed(3)} ms, js ${jsBest.toFixed(3)} ms${check}`)
        }
    }
    function failed(fn: Function, args: number[], e: unknown): void {
        console.log(`mini ${fn.name}(${args.join(', ')}) FAILED: ${String(e).slice(0, 1200)}`)
        if (intrinsics.argv().includes('mini-stack')) console.log((e as any)?.stack)
    }
    for (const [fn, ...argSets] of intrinsics.argv().includes('bench') ? [] : cases) {
        if (only && fn.name !== only) continue
        const expected = argSets.map(args => (fn as any)(...args))
        let run: any
        try {
            run = (native.createNatives({ [fn.name]: fn }) as any)[fn.name]
        } catch (e) {
            for (const args of argSets) failed(fn, args, e)
            continue
        }
        argSets.forEach((args, i) => {
            try {
                const actual = run(...args)
                if (Number(actual) === expected[i]) console.log(`mini ${fn.name}(${args.join(', ')}) ok`)
                else console.log(`mini ${fn.name}(${args.join(', ')}) WRONG: ${actual}, expected ${expected[i]}`)
            } catch (e) {
                failed(fn, args, e)
            }
        })
    }
}
