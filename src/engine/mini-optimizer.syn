/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import { allocate } from './builtins'

enum Op {
    lit,
    add,
    mul,
}

interface Node {
    op: u32
    args: u32[]
    value: u32
}

interface Block {
    id: u32
    body: u32[]
}

interface Known {
    known: boolean
    value: u32
}

export function suite() {
    function miniOptimize(n: u32, part: u32): u32 {
        const nodes = new Map<u32, Node>()
        const usedBy = new Map<u32, Set<u32>>()
        const byOp = new Map<u32, Map<u32, u32[]>>()
        const blocks: Block[] = []
        const memo = new Map<u32, Known>()
        let nextId: u32 = 1

        function add(op: u32, args: u32[], value: u32): u32 {
            const id = nextId++
            nodes.set(id, { op, args, value })
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
            return id
        }

        function index(b: Block): void {
            let ops = byOp.get(b.id)
            if (!ops) {
                ops = new Map<u32, u32[]>()
                byOp.set(b.id, ops)
            }
            for (const id of b.body) {
                const op = nodes.get(id)!.op
                let ids = ops.get(op)
                if (!ids) {
                    ids = []
                    ops.set(op, ids)
                }
                ids.push(id)
            }
        }

        function fold(): boolean {
            let changed = false
            for (const b of blocks) {
                const adds = byOp.get(b.id)?.get(Op.add) ?? []
                for (const id of adds) {
                    const node = nodes.get(id)!
                    if (node.op !== Op.add) continue
                    const x = nodes.get(node.args[0])!
                    const y = nodes.get(node.args[1])!
                    if (x.op !== Op.lit || y.op !== Op.lit) continue
                    node.op = Op.lit
                    node.value = x.value + y.value
                    node.args = []
                    changed = true
                }
            }
            return changed
        }

        function evaluate(id: u32): Known {
            const hit = memo.get(id)
            if (hit) return hit
            const node = nodes.get(id)!
            let result: Known = { known: false, value: 0 }
            if (node.op === Op.lit) {
                result = { known: true, value: node.value }
            } else if (node.op === Op.mul) {
                const x = evaluate(node.args[0])
                const y = evaluate(node.args[1])
                if (x.known && y.known) result = { known: true, value: x.value * y.value }
            }
            memo.set(id, result)
            return result
        }

        function countUses(): u32 {
            let total: u32 = 0
            for (const b of blocks) {
                for (const id of b.body) {
                    for (const u of usedBy.get(id) ?? []) total = total + u
                }
            }
            return total
        }

        for (let i: u32 = 0; i < n; i++) {
            const l1 = add(Op.lit, [], i)
            const l2 = add(Op.lit, [], i * 2)
            const s = add(Op.add, [l1, l2], 0)
            const t = add(Op.add, [s, l1], 0)
            const m = add(Op.mul, [t, s], 0)
            blocks.push({ id: i, body: [l1, l2, s, t, m] })
        }
        for (const b of blocks) index(b)

        const passes = [fold, fold]
        let rounds: u32 = 0
        for (const pass of passes) {
            if (pass()) rounds++
        }

        let values: u32 = 0
        let evaluated: u32 = 0
        for (const b of blocks) {
            for (const id of b.body) {
                const node = nodes.get(id)!
                values = values + node.op * 100 + node.value
            }
            evaluated = evaluated + evaluate(b.body[b.body.length - 1]).value
        }
        const uses = countUses()
        if (part === 1) return rounds
        if (part === 2) return uses
        if (part === 3) return values
        if (part === 4) return evaluated
        return (values + evaluated + uses + rounds * 1000) & 0xFFFFFF
    }

    function arrayElement(n: u32): u32 {
        const bs: Block[] = [{ id: n, body: [] }]
        return bs[0].id
    }
    function wrap(b: Block): { done: boolean, value: Block } {
        return { done: false, value: b }
    }
    function returnedField(n: u32): u32 {
        return wrap({ id: n, body: [] }).value.id
    }
    function iterated(n: u32): u32 {
        const bs: Block[] = [{ id: n, body: [] }, { id: n + 1, body: [] }]
        let total: u32 = 0
        for (const b of bs) total = total + b.id
        return total
    }

    function twoShapes(n: u32): u32 {
        const a: any[] = []
        a.push({ id: n, body: [] })
        const b: any[] = []
        b.push({ x: 1, id: n + 1 })
        b.push({ x: 2, id: n + 2 })
        return a.length * 10 + b.length
    }

    function oneShape(n: u32): u32 {
        const a: any[] = []
        a.push({ id: n })
        const b: any[] = []
        b.push({ id: n + 1 })
        return a.length * 10 + b.length
    }

    function mapOfMaps(n: u32): u32 {
        const byOp = new Map<u32, Map<u32, u32[]>>()
        for (let i: u32 = 0; i < n; i++) {
            let ops = byOp.get(i)
            if (!ops) {
                ops = new Map<u32, u32[]>()
                byOp.set(i, ops)
            }
            let ids = ops.get(1)
            if (!ids) {
                ids = []
                ops.set(1, ids)
            }
            ids.push(i + 10)
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            const adds = byOp.get(i)?.get(1) ?? []
            for (const id of adds) total = total + id
        }
        return total
    }

    function mapOfMapsSigned(n: u32): number {
        const byOp = new Map<u32, Map<u32, number[]>>()
        for (let i: u32 = 0; i < n; i++) {
            let ops = byOp.get(i)
            if (!ops) {
                ops = new Map<u32, number[]>()
                byOp.set(i, ops)
            }
            let ids = ops.get(1)
            if (!ids) {
                ids = []
                ops.set(1, ids)
            }
            ids.push(i > 1 ? -5 : 7)
        }
        let total = 0
        for (let i: u32 = 0; i < n; i++) {
            const adds = byOp.get(i)?.get(1) ?? []
            for (const id of adds) total = total + id
        }
        return total
    }

    function mapObject(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        m.set(1, { x: n })
        return m.get(1)!.x
    }
    function mapOfMap(n: u32): u32 {
        const m = new Map<u32, Map<u32, u32>>()
        const inner = new Map<u32, u32>()
        inner.set(2, n)
        m.set(1, inner)
        return m.get(1)!.get(2)!
    }

    function mapLoop(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) m.set(i, { x: i + 10 })
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }
    function mapCreate(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            let o = m.get(i)
            if (!o) {
                o = { x: i + 10 }
                m.set(i, o)
            }
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }

    function mapCreateCount(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            let o = m.get(i)
            if (!o) {
                o = { x: i + 10 }
                m.set(i, o)
            }
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + (m.get(i) ? 1 : 0)
        return total * 100 + m.size
    }
    function mapBranch(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (i < 100) m.set(i, { x: i + 10 })
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }

    function mapCreateOne(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            let o = m.get(i)
            if (!o) {
                o = { x: i + 10 }
                m.set(i, o)
            }
        }
        return m.get(1)!.x
    }
    function mapCreateNoJoin(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (!m.get(i)) m.set(i, { x: i + 10 })
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) total = total + m.get(i)!.x
        return total
    }

    function rawBranch(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (i < 100) m.set(i, { x: i + 10 })
        }
        return m.get(0) as any
    }
    function rawCreate(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        for (let i: u32 = 0; i < n; i++) {
            if (!m.get(i)) m.set(i, { x: i + 10 })
        }
        return m.get(0) as any
    }

    function closureMemo(n: u32): u32 {
        const memo = new Map<u32, Known>()
        function ev(id: u32): Known {
            const hit = memo.get(id)
            if (hit) return hit
            let r: Known = { known: false, value: 0 }
            if (id < n) r = { known: true, value: id * 2 }
            memo.set(id, r)
            return r
        }
        return ev(1).value + ev(1).value * 10 + ev(5).value * 100
    }

    function usersOf(n: u32, part: u32): u32 {
        const usedBy = new Map<u32, Set<u32>>()
        for (let id: u32 = 1; id <= n; id++) {
            const args: u32[] = [id % 2, (id + 1) % 3]
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
        }
        let total: u32 = 0
        let count: u32 = 0
        for (let k: u32 = 0; k < 4; k++) {
            for (const u of usedBy.get(k) ?? []) {
                total = total + u
                count++
            }
        }
        if (part === 1) return count
        if (part === 2) return usedBy.size
        return total
    }

    function usersClosure(n: u32, part: u32): u32 {
        const usedBy = new Map<u32, Set<u32>>()
        let nextId: u32 = 1
        function add(args: u32[]): u32 {
            const id = nextId++
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
            return id
        }
        function count(): u32 {
            let total: u32 = 0
            for (const u of usedBy.get(1) ?? []) total = total + u
            for (const u of usedBy.get(2) ?? []) total = total + u * 10
            for (const u of usedBy.get(7) ?? []) total = total + u * 100
            return total
        }
        for (let i: u32 = 0; i < n; i++) {
            const x = add([])
            const y = add([x])
            add([x, y])
        }
        if (part === 1) return nextId
        if (part === 2) return usedBy.size
        return count()
    }

    function twoNew(n: u32): u32 {
        const usedBy = new Map<u32, Set<u32>>()
        let nextId: u32 = 1
        function add(args: u32[]): u32 {
            const id = nextId++
            for (const a of args) {
                let users = usedBy.get(a)
                if (!users) {
                    users = new Set<u32>()
                    usedBy.set(a, users)
                }
                users.add(id)
            }
            return id
        }
        for (let i: u32 = 0; i < n; i++) {
            const x = add([])
            const y = add([])
            add([x, y])
        }
        let total: u32 = 0
        for (const u of usedBy.get(1) ?? []) total = total * 100 + u
        return total
    }

    function poolEntry(h: usize, id: u32): usize {
        const table = intrinsics.Intrinsics.load(h, 0, intrinsics.Types.u64) as usize
        return intrinsics.Intrinsics.load(table, id * 8, intrinsics.Types.u64) as usize
    }

    const poolTake = intrinsics.tagNoInline(function poolTake(entry: usize): u32 {
        const used = intrinsics.Intrinsics.load(entry, 2, intrinsics.Types.u16)
        if (used >= 3) return 0
        intrinsics.Intrinsics.store(entry, 2, used + 1, intrinsics.Types.u16)
        return 1
    })

    function poolFind(h: usize, child: u32): u32 {
        while (child !== 0) {
            const entry = poolEntry(h, child)
            if (intrinsics.Intrinsics.load(entry, 0, intrinsics.Types.u8) === 2 && poolTake(entry) !== 0) return child
            child = intrinsics.Intrinsics.load(poolEntry(h, child), 4, intrinsics.Types.u16)
        }
        return 0
    }

    function takeInline(entry: usize): u32 {
        const used = intrinsics.Intrinsics.load(entry, 2, intrinsics.Types.u16)
        if (used >= 3) return 0
        intrinsics.Intrinsics.store(entry, 2, used + 1, intrinsics.Types.u16)
        return 1
    }

    function takeOrNext(entry: usize): u32 {
        if (intrinsics.Intrinsics.load(entry, 0, intrinsics.Types.u8) === 2 && takeInline(entry) !== 0) return 0
        return intrinsics.Intrinsics.load(entry, 4, intrinsics.Types.u16)
    }

    function takeOrNextOnce(entry: usize): u32 {
        if (intrinsics.Intrinsics.load(entry, 0, intrinsics.Types.u8) === 2 && takeInline(entry) !== 0) return 0
        return intrinsics.Intrinsics.load(entry, 4, intrinsics.Types.u16)
    }

    function inlinedKillArm(n: u32): u32 {
        const entry = allocate(8)
        intrinsics.Intrinsics.store(entry, 0, n % 3, intrinsics.Types.u8)
        intrinsics.Intrinsics.store(entry, 2, n, intrinsics.Types.u16)
        intrinsics.Intrinsics.store(entry, 4, 7, intrinsics.Types.u16)
        return takeOrNextOnce(entry) * 100 + intrinsics.Intrinsics.load(entry, 2, intrinsics.Types.u16)
    }

    function selectEqualsOne(n: u32): u32 {
        const small: u32 = n > 3 ? 0 : 1
        if (small === 1) return 10
        return 20
    }
    function canonicalBooleanSelect(n: u32, k: u32): u32 {
        const selected = n ? k < 5 : false
        return selected ? 1 : 0
    }
    function nonBooleanSelect(n: u32): u32 {
        const selected = n ? 7 : 0
        return selected ? 1 : 0
    }
    function guardedBooleanLoad(n: u32): u32 {
        let ptr: u32 = 0
        if (n) {
            ptr = allocate(4)
            intrinsics.Intrinsics.store(ptr, 0, n, intrinsics.Types.u32)
        }
        const selected = n > 0 && intrinsics.Intrinsics.load(ptr, 0, intrinsics.Types.u32) > 2
        return selected ? 1 : 0
    }
    function booleanSelectEffects(n: u32): u32 {
        let calls: u32 = 0
        function predicate(): boolean { calls++; return n < 4 }
        const selected = n > 0 && predicate()
        return calls * 10 + (selected ? 1 : 0)
    }
    function booleanSelectNaN(n: u32): u32 {
        const value = n ? n : NaN
        return (n < 5 && value < 3) ? 1 : 0
    }
    function unswitchTruthy(n: u32, k: u32): u32 {
        let h: u32 = n + k
        h = ((h * 31) ^ (h >>> 1)) * 33 ^ (h >>> 2)
        h = ((h * 35) ^ (h >>> 3)) * 37 ^ (h >>> 4)
        h = ((h * 39) ^ (h >>> 5)) * 41 ^ (h >>> 6)
        h = ((h * 43) ^ (h >>> 7)) * 45 ^ (h >>> 1)
        h = ((h * 47) ^ (h >>> 2)) * 49 ^ (h >>> 3)
        h = ((h * 51) ^ (h >>> 4)) * 53 ^ (h >>> 5)
        h = ((h * 55) ^ (h >>> 6)) * 57 ^ (h >>> 7)
        h = ((h * 59) ^ (h >>> 1)) * 61 ^ (h >>> 2)
        h = ((h * 63) ^ (h >>> 3)) * 65 ^ (h >>> 4)
        h = ((h * 67) ^ (h >>> 5)) * 69 ^ (h >>> 6)
        h = ((h * 71) ^ (h >>> 7)) * 73 ^ (h >>> 1)
        h = ((h * 75) ^ (h >>> 2)) * 77 ^ (h >>> 3)
        const p = allocate(16)
        intrinsics.Intrinsics.store(p, 8, h, intrinsics.Types.u32)
        intrinsics.Intrinsics.store(p, 0, 0, intrinsics.Types.u32)
        for (let i: u32 = 0; i < n; i++) {
            const s = intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32)
            if (k & 4) intrinsics.Intrinsics.store(p, 0, s + (k & 4), intrinsics.Types.u32)
            else intrinsics.Intrinsics.store(p, 4, s + 1, intrinsics.Types.u32)
        }
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) + (intrinsics.Intrinsics.load(p, 8, intrinsics.Types.u32) & 0)
    }
    function liftCountdown(a: u32): u32 {
        let n: u32 = 5
        let acc = a
        while (n) {
            acc = acc + n
            n = n - 1
        }
        return acc
    }
    const bumpTally = intrinsics.tagNoInline(function bumpTally(p: usize, x: u32): u32 {
        const v = intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) + 1
        intrinsics.Intrinsics.store(p, 0, v, intrinsics.Types.u32)
        return x + v
    })
    function signedArm(n: u32): u32 {
        const p = allocate(16)
        intrinsics.Intrinsics.store(p, 0, 0, intrinsics.Types.u32)
        intrinsics.Intrinsics.store(p, 8, n * 3, intrinsics.Types.u32)
        const x = (n as i32) - 5
        const v = intrinsics.Intrinsics.load(p, 8, intrinsics.Types.u32)
        if (x < 0) return bumpTally(p, v) * 10 + 1
        return bumpTally(p, v) * 10 + 2
    }
    const recordArm = intrinsics.tagNoInline(function recordArm(c: u32, n: u32): u32 {
        const p = allocate(8)
        if (n > 5) intrinsics.Intrinsics.store(p, 0, n * 2, intrinsics.Types.u32)
        else intrinsics.Intrinsics.store(p, 0, n, intrinsics.Types.u32)
        intrinsics.Intrinsics.store(p, 4, 5, intrinsics.Types.u32)
        if (c > 1) {
            intrinsics.Intrinsics.store(p, 4, 7, intrinsics.Types.u32)
            return p
        }
        return p
    })
    function recordArmReturn(n: u32): u32 {
        const p = recordArm(n, n)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) * 100 + intrinsics.Intrinsics.load(p, 4, intrinsics.Types.u32)
    }
    const armStoreEarly = intrinsics.tagNoInline(function armStoreEarly(c: u32, n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 4, 5, intrinsics.Types.u32)
        if (n > 5) intrinsics.Intrinsics.store(p, 0, n * 2, intrinsics.Types.u32)
        else intrinsics.Intrinsics.store(p, 0, n, intrinsics.Types.u32)
        if (c > 1) {
            intrinsics.Intrinsics.store(p, 4, 7, intrinsics.Types.u32)
            return p
        }
        return p
    })
    function armStoreEarlyReturn(n: u32): u32 {
        const p = armStoreEarly(n, n)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) * 100 + intrinsics.Intrinsics.load(p, 4, intrinsics.Types.u32)
    }
    function widenCount(n: u32): u32 {
        const p = allocate(n * 8)
        let c: u32 = 0
        for (let i: u32 = 0; i < n * 8; i++) {
            intrinsics.Intrinsics.store(p, i, 1, intrinsics.Types.u8)
            c = c + 3
        }
        return c + intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u8)
    }
    function widenNegative(n: u32): u32 {
        const p = allocate(n * 4)
        for (let i: u32 = 0; i < n * 4; i++) intrinsics.Intrinsics.store(p, i, -1, intrinsics.Types.u8)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) === 4294967295 ? 1 : 2
    }
    function reverseFloatSum(n: u32): u32 {
        const p = allocate(32)
        intrinsics.Intrinsics.store(p, 0, 1e16, intrinsics.Types.f64)
        intrinsics.Intrinsics.store(p, 8, 1, intrinsics.Types.f64)
        intrinsics.Intrinsics.store(p, 16, 1, intrinsics.Types.f64)
        intrinsics.Intrinsics.store(p, 24, 1, intrinsics.Types.f64)
        let sum = 0
        const end = p + n * 8
        for (let q = p; q < end; q = q + 8) sum = sum + intrinsics.Intrinsics.load(q, 0, intrinsics.Types.f64)
        return sum === 1e16 ? 1 : 2
    }
    const sinkPeek = intrinsics.tagNoInline(function sinkPeek(p: usize, n: u32, k: u32): u32 {
        let x: u32 = n
        let seen: u32 = 0
        for (let i: u32 = 0; i < k; i++) {
            seen = seen + intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32)
            intrinsics.Intrinsics.store(p, 0, x, intrinsics.Types.u32)
            seen = seen + bumpTally(p, 0)
            x = intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32)
        }
        return seen
    })
    function sinkPeekRun(n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 0, 100, intrinsics.Types.u32)
        return sinkPeek(p, n, 3)
    }
    function forwardBits(n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 0, 1.5, intrinsics.Types.f64)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u64) === 4609434218613702656 ? n : n + 1
    }
    function forwardNegative(n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 0, -1, intrinsics.Types.u32)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) > n ? 1 : 2
    }
    const storeThenMatch = intrinsics.tagNoInline(function storeThenMatch(p: usize, x: u32): u32 {
        intrinsics.Intrinsics.store(p, 0, x, intrinsics.Types.u32)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) === x ? 1 : 0
    })
    function storeBeforeCompare(n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 0, 0, intrinsics.Types.u32)
        return storeThenMatch(p, n + 1) * 100 + intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32)
    }
    function promotedSigned(n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 0, (n as i32) - 5, intrinsics.Types.i32)
        let s: u32 = 0
        for (let i: u32 = 0; i < 3; i++) {
            if (intrinsics.Intrinsics.load(p, 0, intrinsics.Types.i32) < 0) s = s + 1
            intrinsics.Intrinsics.store(p, 0, intrinsics.Intrinsics.load(p, 0, intrinsics.Types.i32) + 1, intrinsics.Types.i32)
