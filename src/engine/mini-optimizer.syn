        intrinsics.Intrinsics.store(p, 0, intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32) + 1, intrinsics.Types.u32)
        return 1
    })
    function sharedArmCall(n: u32): u32 {
        const p = allocate(8)
        intrinsics.Intrinsics.store(p, 0, 0, intrinsics.Types.u32)
        let current = n
        while (current !== 0) {
            bumpCount(p)
            current = current - 1
        }
        if (n > 5) bumpCount(p)
        return intrinsics.Intrinsics.load(p, 0, intrinsics.Types.u32)
    }

    function groupByResidue(n: u32): u32 {
        const groups = new Map<u32, Set<u32>>()
        for (let i: u32 = 0; i < n; i++) {
            const key = i % 3
            let group = groups.get(key)
            if (!group) {
                group = new Set<u32>()
                groups.set(key, group)
            }
            group.add(i)
        }
        let total: u32 = 0
        for (let k: u32 = 0; k < 3; k++) total = total * 10 + (groups.get(k)?.size ?? 0)
        return total
    }
    function freshSetsPerKey(n: u32): u32 {
        const seen = new Map<u32, Set<u32>>()
        let made: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            const s = new Set<u32>()
            s.add(i)
            s.add(i + n)
            seen.set(i, s)
            made = made + s.size
        }
        return made * 10 + seen.size
    }

    function poolScan(n: u32): u32 {
        const h = allocate(8)
        const table = allocate((n + 1) * 8)
        intrinsics.Intrinsics.store(h, 0, table, intrinsics.Types.u64)
        for (let i: u32 = 1; i <= n; i++) {
            const entry = allocate(8)
            intrinsics.Intrinsics.store(table, i * 8, entry, intrinsics.Types.u64)
            intrinsics.Intrinsics.store(entry, 0, i % 2 === 0 ? 2 : 1, intrinsics.Types.u8)
            intrinsics.Intrinsics.store(entry, 2, 0, intrinsics.Types.u16)
            intrinsics.Intrinsics.store(entry, 4, i < n ? i + 1 : 0, intrinsics.Types.u16)
        }
        let total = poolTake(poolEntry(h, 1))
        for (let k: u32 = 0; k < 5; k++) total = total * 10 + poolFind(h, 1)
        return total * 10 + poolFind(h, 3)
    }

    function getOrCreate(n: u32): u32 {
        const m = new Map<u32, { x: u32 }>()
        let o = m.get(n)
        if (!o) {
            o = { x: n }
            m.set(n, o)
        }
        return o.x
    }

    function nestedCreate(n: u32): u32 {
        const outer = new Map<u32, Map<u32, u32>>()
        for (let i: u32 = 0; i < n; i++) {
            let inner = outer.get(i)
            if (!inner) {
                inner = new Map<u32, u32>()
                outer.set(i, inner)
            }
            inner.set(1, i)
        }
        return outer.size
    }

    function stringLiteralJoin(n: u32): u32 {
        const s = n > 2 ? 'add' : 'lit'
        return s.length
    }
    function stringParamLength(n: u32): u32 {
        function len(op: string): u32 {
            return op.length
        }
        return len('add') + len('mul') * n
    }
    function literalStringLength(n: u32): u32 {
        const s = 'abcd'
        return 'abc'.length * 10 + s.length + n
    }
    function literalStringTruthy(n: u32): u32 {
        const a = 'abc'
        const b = ''
        return (a ? 1 : 0) + (b ? 10 : 0) + (n ? 100 : 0)
    }
    const emptyLabel = ''
    const fullLabel = 'full'
    function capturedStringTruthy(n: u32): u32 {
        return (emptyLabel ? 1 : 0) + (fullLabel ? 10 : 0) + (!emptyLabel ? 1000 : 0) + (!fullLabel ? 10000 : 0) + (emptyLabel.length + fullLabel.length) * 100 + n
    }
    function stringParamTruthy(n: u32): u32 {
        function test(s: string): u32 {
            return s ? 1 : 2
        }
        return test(n > 1 ? 'x' : '') * 10 + test('')
    }
    function runtimeStringTruthy(n: u32): u32 {
        let s = ''
        for (let i: u32 = 0; i < n; i++) s = s + 'a'
        return s ? 10 + s.length : 20
    }
    function nullableStringTruthy(n: u32): u32 {
        const m = new Map<u32, string>()
        m.set(1, '')
        m.set(2, 'b')
        m.set(3, `${n}`)
        const s = m.get(n)
        if (s) return 1
        return s === undefined ? 2 : 3
    }
    function nullableStringMissing(n: u32): u32 {
        const m = new Map<u32, string>()
        m.set(1, '')
        m.set(2, 'b')
        const s = m.get(n)
        return s === undefined ? 2 : 3
    }
    function stringFieldLength(n: u32): u32 {
        const m = new Map<u32, { op: string }>()
        m.set(1, { op: 'add' })
        m.set(2, { op: 'load' })
        return m.get(1)!.op.length + m.get(2)!.op.length * n
    }
    function stringFieldEquals(n: u32): u32 {
        const m = new Map<u32, { op: string }>()
        m.set(1, { op: 'add' })
        m.set(2, { op: 'mul' })
        return (m.get(1)!.op === 'add' ? 1 : 0) + (m.get(2)!.op === 'add' ? 10 : 0) + n
    }
    function stringConcatEquals(n: u32): u32 {
        function check(prefix: string): u32 {
            return prefix + 'd' === 'add' ? 1 : 2
        }
        return check('ad') * 10 + check('mu') + n
    }
    function concatPairEquals(n: u32): u32 {
        const a = `x${n}`
        const b = `x${n % 3}`
        const c = 'x' + `${n}`
        return (a === b ? 1 : 0) + (a === c ? 10 : 0) + (a !== b ? 100 : 0) + (b !== c ? 1000 : 0)
    }
    function runtimeKeyMap(n: u32): u32 {
        const m = new Map<string, u32>()
        for (let i: u32 = 0; i < n; i++) m.set(`k${i % 3}`, i + 1)
        const first = m.get('k0') ?? 99
        return m.size * 1000 + first * 100 + (m.has(`k${n}`) ? 10 : 0) + (m.has('k1') ? 1 : 0)
    }
    function mixedKeyMaps(n: u32): u32 {
        const ids = new Map<u32, u32[]>()
        ids.set(1, [0, n])
        ids.set(2, [1])
        ids.set(3, [0, n])
        const cache = new Map<string, u32>()
        let hits: u32 = 0
        for (const [id, chain] of ids) {
            const key = chain.join(',')
            const known = cache.get(key)
            if (known !== undefined) hits = hits + known * 10
            else cache.set(key, id)
        }
        return hits * 100 + cache.size
    }
    function runtimeStringSet(n: u32): u32 {
        const s = new Set<string>()
        for (let i: u32 = 0; i < n; i++) s.add(`v${i % 2}`)
        s.add('v1')
        return s.size * 10 + (s.has('v0') ? 1 : 0) + (s.has(`v${n}`) ? 100 : 0)
    }
    function runtimeStringSwitch(n: u32): u32 {
        const key = `op${n}`
        switch (key) {
            case 'op0': return 10
            case 'op1': return 20
            case 'op2': return 30
            default: return 40
        }
    }
    function mapEntries(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        let total: u32 = 0
        for (const [k, v] of m) total = total + k * 10 + v
        return total
    }
    function mapKeysValues(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        let total: u32 = 0
        for (const k of m.keys()) total = total + k * 100
        for (const v of m.values()) total = total + v
        return total
    }
    function mapDeleteForEach(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        m.set(3, n * 3)
        const removed = m.delete(2) ? 1000 : 0
        const missing = m.delete(7) ? 2000 : 0
        let total: u32 = removed + missing + m.size * 100
        m.forEach((v, k) => { total = total + k * 10 + v })
        m.clear()
        return total + m.size + (m.has(1) ? 5000 : 0)
    }
    function mapDeleteSize(n: u32): u32 {
        const m = new Map<u32, u32>()
        m.set(1, n)
        m.set(2, n * 2)
        m.delete(2)
        return m.size
    }
    function localClass(n: u32): u32 {
        class Box {
            declare size: u32
            declare list: u32[]
            constructor() {
                this.size = 0
                this.list = []
            }
            add(v: u32): void {
                this.list.push(v)
                this.size = this.size + 1
            }
            drop(): boolean {
                this.size = this.size - 1
                this.list.length = this.size
                return true
            }
        }
        const b = new Box()
        b.add(n)
        b.add(n)
        const dropped = b.drop() ? 1000 : 0
        return dropped + b.size * 10 + b.list.length
    }
    function localClassCapture(n: u32): u32 {
        const scale: u32 = n + 2
        class Scaled {
            declare value: u32
            constructor(v: u32) {
                this.value = v
            }
            get(): u32 {
                return this.value * scale
            }
        }
        const a = new Scaled(n)
        const b = new Scaled(5)
        return a.get() * 100 + b.get()
    }
    const readScaled = intrinsics.tagNoInline(function readScaled(s: { get(): u32 }): u32 {
        return s.get() + 1
    })
    function localClassEscape(n: u32): u32 {
        const scale: u32 = n + 2
        class Scaled {
            declare value: u32
            constructor(v: u32) {
                this.value = v
            }
            get(): u32 {
                return this.value * scale
            }
        }
        return readScaled(new Scaled(n)) * 100 + readScaled(new Scaled(5))
    }
    function localClassLoop(n: u32): u32 {
        class Counter {
            declare count: u32
            constructor() {
                this.count = 0
            }
            bump(by: u32): void {
                this.count = this.count + by
            }
        }
        const first = new Counter()
        const second = new Counter()
        for (let i: u32 = 0; i < n; i++) {
            first.bump(i)
            second.bump(2)
        }
        return first.count * 100 + second.count
    }
    function localClassInLoop(n: u32): u32 {
        const step: u32 = n + 1
        class Cell {
            declare value: u32
            constructor(v: u32) {
                this.value = v
            }
            scaled(): u32 {
                return this.value * step
            }
        }
        let total: u32 = 0
        for (let i: u32 = 0; i < n; i++) {
            const cell = new Cell(i)
            total = total + cell.scaled()
        }
        return total
    }
    function localClassGetter(n: u32): u32 {
        const bias: u32 = n * 2
        class Pair {
            declare a: u32
            declare b: u32
            constructor(a: u32, b: u32) {
                this.a = a
                this.b = b
            }
            get sum(): u32 {
                return this.a + this.b
            }
            get biased(): u32 {
                return this.a + bias
            }
        }
        const p = new Pair(n, 3)
        return p.sum * 100 + p.biased
    }
    function localClassStatic(n: u32): u32 {
        const base: u32 = n + 5
        class Maker {
            declare value: u32
            constructor(v: u32) {
                this.value = v
            }
            static of(v: u32): Maker {
                return new Maker(v + base)
            }
            get(): u32 {
                return this.value
            }
        }
        return Maker.of(n).get()
    }
    function localClassInstanceof(n: u32): u32 {
        const step: u32 = n + 1
        class Tag {
            declare value: u32
            constructor(v: u32) {
                this.value = v
            }
            get(): u32 {
                return this.value + step
            }
        }
        class Other {
            get(): u32 {
                return step
            }
        }
        const t = new Tag(n)
        return (t instanceof Tag ? 100 : 0) + (t instanceof Other ? 10 : 0) + t.get() + new Other().get()
    }
    function closureSignedResult(n: u32): u32 {
        function cmp(x: u32, y: u32): number {
            return x - y
        }
        return (cmp(1, n) > 0 ? 10 : 20) + (cmp(n, 1) > 0 ? 1 : 2)
    }
    function closureReturnsObject(n: u32): u32 {
        function make(v: u32): { value: u32 } {
            return { value: v }
        }
        return make(n).value + 1
    }

    function functionKeyedMap(n: u32): u32 {
        function a(x: u32): u32 { return x + 1 }
        function b(x: u32): u32 { return x * 2 }
        const seen = new Map<(x: u32) => u32, u32>()
        seen.set(a, 1)
        seen.set(b, 2)
        return (seen.get(a) ?? 0) * 10 + (seen.get(b) ?? 0) + n
    }
    function nullishCounts(n: u32): u32 {
        const counts = new Map<u32, u32>()
        for (let i: u32 = 0; i < n; i++) counts.set(i * 2, i + 1)
        let total: u32 = 0
        for (let i: u32 = 0; i < n * 2; i++) {
            total = total * 3 + (counts.get(i) ?? 0)
            total = total + (counts.get(i + 1) ?? 7)
        }
        return total
    }
    function templateKeyMap(n: u32): u32 {
        const keys = new Map<string, u32>()
        let made: u32 = 0
        function intern(op: string, x: u32, y: u32): u32 {
            const key = `${op}:${x},${y}`
            const known = keys.get(key)
            if (known !== undefined) return known
            made++
            keys.set(key, made)
            return made
        }
        return intern('add', 1, n) * 100 + intern('add', 1, n) * 10 + intern('mul', 1, n)
    }
    function labeledContinue(n: u32): u32 {
        let total: u32 = 0
        outer: for (let i: u32 = 0; i < n; i++) {
            for (let j: u32 = 0; j < n; j++) {
                if (j === i) continue outer
                total = total + j
            }
        }
        return total
    }
    function setSpread(n: u32): u32 {
        const s = new Set<u32>()
        for (let i: u32 = 0; i < n; i++) s.add(i * 3)
        const arr = [...s]
        return arr.length * 100 + arr[arr.length - 1]
    }
    function arraySortComparator(n: u32): u32 {
        const arr: u32[] = [n, 1, n * 3, 2]
        arr.sort((x, y) => x - y)
        return arr[0] * 1000 + arr[1] * 100 + arr[3]
    }
    function arrayFilterMap(n: u32): u32 {
        const arr: u32[] = [1, 2, 3, 4, 5, 6]
        const out = arr.filter(x => x > n).map(x => x * 2)
        let total: u32 = 0
        for (const x of out) total = total + x
        return total
    }
    function constantTable(n: u32): number {
        const t = [1, 2, 300000, 5, 8, 13, 21, 34]
        let total = 0
        for (let k: u32 = 0; k < n; k++) total = total + t[k & 7]
        return total + t[n & 7]
    }
    function negativeTable(n: u32): number {
        const t = [1, -2, 300000, -5, 8, -13, 21, -34]
        let total = 0
        for (let k: u32 = 0; k < n; k++) total = total + t[k & 7]
        return total + t[n & 7]
    }
    const fieldBelow = intrinsics.tagNoInline(function fieldBelow(o: { v: number }, k: number): number {
        return o.v < k ? 1 : 2
    })
    function fieldDifference(n: u32): number {
        const a = { v: n - 5 }
        const b = { v: n + 1 }
        return fieldBelow(a, 0) * 10 + fieldBelow(b, 0)
    }
    function fieldNegative(n: u32): number {
        return fieldBelow({ v: n > 4 ? -1 : 1 }, 0) * 10 + fieldBelow({ v: n }, 0)
    }
    const elementBelow = intrinsics.tagNoInline(function elementBelow(t: number[], k: number): number {
        return t[0] < k ? 1 : 2
    })
    function elementDifference(n: u32): number {
        return elementBelow([n - 5], 0) * 10 + elementBelow([n + 1], 0)
    }
    function elementNegative(n: u32): number {
        return elementBelow([n > 4 ? -1 : 1], 0) * 10 + elementBelow([n], 0)
    }
    const readV = intrinsics.tagNoInline(function readV(o: { v: number }): number {
        return o.v
    })
    function fieldDifferenceValue(n: u32): number {
        const a = { v: n - 5 }
        return readV(a) * 3 + fieldBelow(a, 0)
    }
    const readFirst = intrinsics.tagNoInline(function readFirst(t: number[]): number {
        return t[0]
    })
    function elementDifferenceValue(n: u32): number {
        const t = [n - 5]
