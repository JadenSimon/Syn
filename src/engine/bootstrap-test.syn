/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import { Intrinsics, isNative } from './intrinsics'
import { allocate, markStacks, releaseStacks, stackTops } from './builtins'
import * as lowering2 from './lowering2'
import { buildIndex, countNodes, graphBytes, graphFloatsAt, graphLayout, writeGraph } from './graph-node'
import * as harness from './harness'
import * as native from './native'
import { NormalizeKind, nativeNormalize } from './native'
import { type Entry, makeBranchGraph, makeGraph, makeJoinGraph, makeWideStoreGraph, rawGraph, runCensus } from './census'

export function suite() {
    function l2Normalize(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeGraph(n)))
    }
    function l2NormalizeBranch(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeBranchGraph(n)))
    }
    function l2RawNormalize(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(rawGraph(n)))
    }
    function l2NormalizeWideStore(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeWideStoreGraph(n)))
    }
    function l2IndexTwice(n: u32): number {
        const marks = markStacks()
        buildIndex(makeJoinGraph(n))
        if (isNative()) releaseStacks(marks)
        const probe: number[] = new Array(1 << 18)
        for (let i = 0; i < probe.length; i++) probe[i] = 7
        buildIndex(makeJoinGraph(n))
        let touched = 0
        for (let i = 0; i < probe.length; i++) {
            if (probe[i] !== 7) touched++
        }
        return touched
    }
    function l2NormalizeTwice(n: u32): number {
        const g = makeGraph(n)
        const layout = graphLayout(g, 0, 0)
        const input = allocate(graphBytes(layout))
        const floats = input + graphFloatsAt(layout.words) * 4
        writeGraph(g, NormalizeKind.again, layout, (at, v) => Intrinsics.store(input, at * 4, v, intrinsics.Types.u32), (k, v) => Intrinsics.store(floats, k * 8, v, intrinsics.Types.f64))
        const cap = 1 << 20
        const output = allocate(cap)
        const before = stackTops()
        nativeNormalize(0, NormalizeKind.again, input >>> 32, input & 4294967295, output >>> 32, output & 4294967295, cap)
        nativeNormalize(0, NormalizeKind.again, input >>> 32, input & 4294967295, output >>> 32, output & 4294967295, cap)
        return stackTops() - before
    }
    const entries: Entry[] = [
        ['lowering2', l2Normalize, [3]],
        ['lowering2', l2NormalizeBranch, [3]],
        ['lowering2', l2RawNormalize, [3]],
        ['lowering2', l2NormalizeWideStore, [3]],
        ['lowering2', l2IndexTwice, [64]],
    ]
    runCensus(entries)
    harness.test('l2NormalizeTwice', () => {
        const natives: any = native.createNatives({ l2NormalizeTwice, nativeNormalize })
        const left = Number(natives.l2NormalizeTwice(3))
        if (left !== 0) harness.fail(`l2NormalizeTwice: two native normalize calls left ${left} bytes on the pstacks`)
        else console.log('l2NormalizeTwice ok')
    })
}
