/// @synth

"use wrapped";

import { Intrinsics, isNative } from './intrinsics'
import { programStack } from './builtins'
import * as lowering2 from './lowering2'
import { buildIndex, countNodes } from './graph-node'
import { type Entry, makeBranchGraph, makeGraph, makeJoinGraph, makeWideStoreGraph, rawGraph, runCensus } from './census'

export function suite() {
    function l2Normalize(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeGraph(n)))
    }
    function l2NormalizeBranch(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeBranchGraph(n)))
    }
    function l2RawNormalize(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(rawGraph(n)))
    }
    function l2NormalizeWideStore(n: u32): number {
        return countNodes(lowering2.normalizeValueGraph(makeWideStoreGraph(n)))
    }
    function l2IndexTwice(n: u32): number {
        const stackMark = Intrinsics.pstack(programStack, 0, 0)
        const scratchMark = Intrinsics.pstack(0, 0, 0)
        buildIndex(makeJoinGraph(n))
        if (isNative()) {
            Intrinsics.pstack(programStack, stackMark, 0)
            Intrinsics.pstack(0, scratchMark, 0)
        }
        const probe: number[] = new Array(1 << 18)
        for (let i = 0; i < probe.length; i++) probe[i] = 7
        buildIndex(makeJoinGraph(n))
        let touched = 0
        for (let i = 0; i < probe.length; i++) {
            if (probe[i] !== 7) touched++
        }
        return touched
    }
    const entries: Entry[] = [
        ['lowering2', l2Normalize, [3]],
        ['lowering2', l2NormalizeBranch, [3]],
        ['lowering2', l2RawNormalize, [3]],
        ['lowering2', l2NormalizeWideStore, [3]],
        ['lowering2', l2IndexTwice, [64]],
    ]
    runCensus(entries)
}
