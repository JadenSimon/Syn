/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as native from './native'
import { maxFlow, solvePlacements, type FlowEdge, type FlowResult } from './placement-flow'
import { createGraph, getArgIds, makeNode, NodeOp } from './graph-node'
import { type Graph, type GraphNode } from './lowering2'
import { programStack, programStackTop, releaseProgramStack } from './builtin/memory'

if (intrinsics.argv()[0] === 'lowering-attempts') {
    function maxFlowRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 1 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 1 })
        }
        return maxFlow(n + 1, edges, 0, n).value
    }
    function flowEdges(n: u32): FlowEdge[] {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 3 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 2 })
            edges.push({ from: 0, to: i + 1, capacity: i % 3 + 1 })
        }
        return edges
    }
    function flowLengthRoot(n: u32): number {
        return maxFlow(n + 1, flowEdges(n), 0, n).flows.length
    }
    function setIterRoot(n: u32): number {
        const s = new Set<number>()
        for (let i: u32 = 0; i < n; i++) s.add(i % 13)
        let total = 0
        for (const x of s) total = total + x
        for (const x of s.values()) total = total + x * 2
        return total
    }
    function mapIterRoot(n: u32): number {
        const m = new Map<number, number>()
        for (let i: u32 = 0; i < n; i++) m.set(i % 11, i)
        let total = 0
        for (const k of m.keys()) total = total + k
        for (const v of m.values()) total = total + v * 3
        return total
    }
    function forOfRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) edges.push({ from: i % 7, to: (i * 3) % 7, capacity: 1 })
        const offsets = new Int32Array(8)
        for (const edge of edges) {
            offsets[edge.from + 1]++
            offsets[edge.to + 1]++
        }
        return offsets[1] + offsets[3] * 100
    }
    function edgeLoopRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) edges.push({ from: i, to: i + 1, capacity: i % 3 })
        let total = 0
        for (let i = 0; i < edges.length; i++) {
            const edge = edges[i]
            total = total + edge.from * edge.capacity
        }
        return total
    }
    function scanRoot(n: u32): number {
        const cursor = new Int32Array(n)
        const adjacency = new Int32Array(n * 4)
        const level = new Int32Array(n)
        for (let i: u32 = 0; i < n * 4; i++) adjacency[i] = (i * 7) % n
        for (let i: u32 = 0; i < n; i++) level[i] = i % 5
        let total = 0
        for (let from = 0; from < n; from++) {
            const end = (from + 1) * 4
            cursor[from] = from * 4
            while (cursor[from] < end) {
                const edge = adjacency[cursor[from]]
                if (level[edge] === level[from] + 1) break
                cursor[from]++
            }
            total = total + cursor[from]
        }
        return total
    }
    function floatPushRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const xs: number[] = []
        xs.push(residual[1])
        return xs[0] * 4
    }
    function intPushRoot(n: u32): number {
        const xs: number[] = []
        xs.push(n * 3)
        return xs[0] * 4
    }
    function floatClosureMapRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const out = [1, 2].map(x => residual[1] * x)
        return out[1] * 10
    }
    function floatIndexMapRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const out = [1, 2].map((x, i) => residual[i] * x)
        return out[1] * 10
    }
    function floatMapRoot(n: u32): number {
        const residual = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) residual[i] = i * 2
        const xs = [{ c: 10 }, { c: 20 }, { c: n }]
        const out = xs.map((x, i) => x.c - residual[i])
        return out[0] + out[1] * 10 + out[2] * 100
    }
    function maxFlowChecksumRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 3 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 2 })
            edges.push({ from: 0, to: i + 1, capacity: i % 3 + 1 })
        }
        const result = maxFlow(n + 1, edges, 0, n)
        let total = result.value * 1000 + result.sourceSide.size * 100
        for (let i = 0; i < result.flows.length; i++) total = total + result.flows[i] * (i + 1)
        return total
    }

    function scaled(xs: number[], k: number): number[] {
        const scale = k * 2
        return xs.map(x => x * scale)
    }
    function mapCaptureRoot(n: u32): number {
        return scaled([1, 2, n], n)[2]
    }

    function rootMapCapture(n: u32): number {
        const scale = n * 2
        return [1, 2, n].map(x => x * scale)[2]
    }
    function applyLocal(k: number): number {
        const scale = k * 2
        const f = (x: number) => x * scale
        return f(3)
    }
    function calleeCaptureRoot(n: u32): number {
        return applyLocal(n)
    }

    function objectMapRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        return xs.map(x => x.v * 2)[1]
    }
    function doubled(xs: { v: number }[]): number[] {
        return xs.map(x => x.v * 2)
    }
    function objectMapCalleeRoot(n: u32): number {
        return doubled([{ v: 1 }, { v: n }])[1]
    }

    function objectIterateRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        let total = 0
        for (const x of xs) total = total + x.v * 2
        return total
    }
    function objectSomeRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        return xs.some(x => x.v === n) ? 1 : 0
    }

    function heapTop(): u32 {
        return intrinsics.Intrinsics.pstack(0, 0, 0)
    }
    function releaseHeap(mark: u32): void {
        intrinsics.Intrinsics.pstack(0, mark, 0)
    }
    function maxFlowPromoted(vertexCount: number, edges: FlowEdge[], source: number, sink: number): FlowResult {
        const offsets = new Int32Array(vertexCount + 1)
        for (const edge of edges) {
            offsets[edge.from + 1]++
            offsets[edge.to + 1]++
        }
        for (let i = 1; i <= vertexCount; i++) offsets[i] += offsets[i - 1]
        const adjacency = new Int32Array(edges.length * 2)
        const targets = new Int32Array(edges.length * 2)
        const residual = new Float64Array(edges.length * 2)
        const fill = offsets.slice()
        for (let i = 0; i < edges.length; i++) {
            const edge = edges[i]
            const index = i * 2
            adjacency[fill[edge.from]++] = index as i32
            adjacency[fill[edge.to]++] = index + 1 as i32
            targets[index] = edge.to as i32
            targets[index + 1] = edge.from as i32
            residual[index] = edge.capacity as f64
        }
        let value = 0
        const level = new Int32Array(vertexCount)
        for (;;) {
            level.fill(-1)
            level[source] = 0
            const queue = [source]
            for (let i = 0; i < queue.length; i++) {
                const from = queue[i]
                for (let i = offsets[from]; i < offsets[from + 1]; i++) {
                    const edge = adjacency[i]
                    const to = targets[edge]
                    if (residual[edge] <= 0 || level[to] >= 0) continue
                    level[to] = level[from] + 1
                    queue.push(to)
                }
            }
            if (level[sink] < 0) {
                const sourceSide = new Set<number>()
                for (const vertex of queue) sourceSide.add(vertex)
                return { value, sourceSide, flows: edges.map((edge, i) => edge.capacity - residual[i * 2]) }
            }
            const cursor = offsets.slice(0, vertexCount)
            const vertices = [source]
            const path: number[] = []
            while (vertices.length) {
                const from = vertices[vertices.length - 1]
                if (from === sink) {
                    let amount = Infinity
                    for (const edge of path) amount = Math.min(amount, residual[edge])
                    for (const edge of path) {
                        residual[edge] -= amount
                        residual[edge ^ 1] += amount
                    }
                    value += amount
                    vertices.length = 1
                    path.length = 0
                    continue
                }
                const end = offsets[from + 1]
                const want = level[from] + 1
                let c = cursor[from]
                while (c < end) {
                    const edge = adjacency[c]
                    if (residual[edge] > 0 && level[targets[edge]] === want) break
                    c++
                }
                cursor[from] = c
                if (c === end) {
                    vertices.pop()
                    if (path.length) {
                        path.pop()
                        cursor[vertices[vertices.length - 1]]++
                    }
                    continue
                }
                const edge = adjacency[c]
                path.push(edge)
                vertices.push(targets[edge])
            }
        }
    }
    function flowPromotedRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const result = maxFlowPromoted(n, edges, 0, n - 1)
        let total = result.value * 1000 + result.sourceSide.size
        for (let i = 0; i < result.flows.length; i++) total = total + result.flows[i] * (i % 7)
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return total
    }
    function flowSetupRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const vertexCount = n
        const offsets = new Int32Array(vertexCount + 1)
        for (const edge of edges) {
            offsets[edge.from + 1]++
            offsets[edge.to + 1]++
        }
        for (let i = 1; i <= vertexCount; i++) offsets[i] += offsets[i - 1]
        const adjacency = new Int32Array(edges.length * 2)
        const targets = new Int32Array(edges.length * 2)
        const residual = new Float64Array(edges.length * 2)
        const fill = offsets.slice()
        for (let i = 0; i < edges.length; i++) {
            const edge = edges[i]
            const index = i * 2
            adjacency[fill[edge.from]++] = index as i32
            adjacency[fill[edge.to]++] = index + 1 as i32
            targets[index] = edge.to as i32
            targets[index + 1] = edge.from as i32
            residual[index] = edge.capacity as f64
        }
        const total = adjacency[7] + targets[9] + residual[4] + offsets[n]
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return total
    }
    function flowBuildRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const count = edges.length
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return count
    }
    function maxFlowNoExit(vertexCount: number, edges: FlowEdge[], source: number, sink: number): number {
        const offsets = new Int32Array(vertexCount + 1)
        for (const edge of edges) {
            offsets[edge.from + 1]++
            offsets[edge.to + 1]++
        }
        for (let i = 1; i <= vertexCount; i++) offsets[i] += offsets[i - 1]
        const adjacency = new Int32Array(edges.length * 2)
        const targets = new Int32Array(edges.length * 2)
        const residual = new Float64Array(edges.length * 2)
        const fill = offsets.slice()
        for (let i = 0; i < edges.length; i++) {
            const edge = edges[i]
            const index = i * 2
            adjacency[fill[edge.from]++] = index as i32
            adjacency[fill[edge.to]++] = index + 1 as i32
            targets[index] = edge.to as i32
            targets[index + 1] = edge.from as i32
            residual[index] = edge.capacity as f64
        }
        let value = 0
        const level = new Int32Array(vertexCount)
        for (;;) {
            level.fill(-1)
            level[source] = 0
            const queue = [source]
            for (let i = 0; i < queue.length; i++) {
                const from = queue[i]
                for (let i = offsets[from]; i < offsets[from + 1]; i++) {
                    const edge = adjacency[i]
                    intrinsics.assert(edge < targets.length)
                    const to = targets[edge]
                    if (residual[edge] <= 0 || level[to] >= 0) continue
                    level[to] = level[from] + 1
                    queue.push(to)
                }
            }
            if (level[sink] < 0) {
                return value * 1000 + queue.length
            }
            const cursor = offsets.slice(0, vertexCount)
            const vertices = [source]
            const path: number[] = []
            while (vertices.length) {
                const from = vertices[vertices.length - 1]
                if (from === sink) {
                    let amount = Infinity
                    for (const edge of path) amount = Math.min(amount, residual[edge])
                    for (const edge of path) {
                        residual[edge] -= amount
                        residual[edge ^ 1] += amount
                    }
                    value += amount
                    vertices.length = 1
                    path.length = 0
                    continue
                }
                const end = offsets[from + 1]
                while (cursor[from] < end) {
                    const edge = adjacency[cursor[from]]
                    if (residual[edge] > 0 && level[targets[edge]] === level[from] + 1) break
                    cursor[from]++
                }
                if (cursor[from] === end) {
                    vertices.pop()
                    if (path.length) {
                        path.pop()
                        cursor[vertices[vertices.length - 1]]++
                    }
                    continue
                }
                const edge = adjacency[cursor[from]]
                path.push(edge)
                vertices.push(targets[edge])
            }
        }
    }
    function flowNoExitRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const total = maxFlowNoExit(n, edges, 0, n - 1)
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return total
    }
    function staticSeed(): number {
        return 41
    }
    function staticRoot(n: u32): number {
        return (intrinsics.Intrinsics as any).static(staticSeed) + n
    }
    function staticMapSeed(): Map<number, number> {
        const m = new Map<number, number>()
        for (let i = 0; i < 4; i++) m.set(i, i * 10)
        return m
    }
    function staticMapRoot(n: u32): number {
        const m = (intrinsics.Intrinsics as any).static(staticMapSeed) as Map<number, number>
        return m.get(n)! + m.size
    }
    const capturedPairs = [[1, 10], [3, 30]]
    function capturedPairsRoot(n: u32): number {
        let sum = 0
        for (let i = 0; i < capturedPairs.length; i++) sum = sum + capturedPairs[i][0] * capturedPairs[i][1]
        return sum + n
    }
    const capturedTable = new Map<number, number>([[1, 10], [3, 30]])
    function capturedTableRoot(n: u32): number {
        return capturedTable.get(n)! + capturedTable.size
    }
    function mapOfSetsTwoSites(n: u32): number {
        const next = new Map<number, Set<number>>()
        next.set(n, new Set())
        const first = next.get(n)!.size
        next.set(n + 1, new Set())
        return first + next.get(n + 1)!.size
    }
    function getOrCreate(n: u32): number {
        const prev = new Map<number, number[]>()
        for (let i: u32 = 0; i < n; i++) {
            const key = i % 3
            let list = prev.get(key)
            if (!list) prev.set(key, list = [])
            list.push(i)
        }
        return prev.get(0)!.length + prev.get(1)!.length * 10
    }
    function getOrCreateCaptured(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        const prev = new Map<number, number[]>()
        for (const [block, successors] of next) {
            for (const successor of successors) {
                let list = prev.get(successor)
                if (!list) prev.set(successor, list = [])
                list.push(block)
            }
        }
        function count(block: number): number {
            let total = 0
            for (const p of prev.get(block) ?? []) total += p
            return total
        }
        return count(0) + count(1) * 100
    }
    function entrySetSizes(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (const [block, successors] of next) total += block * 10 + successors.size
        return total
    }
    function pairSetSize(n: u32): number {
        const s = new Set([n, n + 1])
        const pair: [number, Set<number>] = [n, s]
        return pair[1].size * 10 + pair[0]
    }
    function mapSetSizes(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (let i = 0; i < n; i++) total += next.get(i)!.size
        return total
    }
    function entrySetBoth(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (const [block, successors] of next) total += next.get(block)!.size * 1000 + successors.size
        return total
    }
    function entryArrayLengths(n: u32): number {
        const next = new Map<number, number[]>()
        for (let i = 0; i < n; i++) next.set(i, [i, i + 1, i + 2])
        let total = 0
        for (const [block, list] of next) total += block * 10 + list.length
        return total
    }
    function entryArrayIdentity(n: u32): number {
        const next = new Map<number, number[]>()
        for (let i = 0; i < n; i++) next.set(i, [i, i + 1, i + 2])
        let total = 0
        for (const [block, list] of next) total += block * 10 + (list === next.get(block) ? 1 : 0)
        return total
    }
    function entryArrayMask(n: u32): number {
        const next = new Map<number, number[]>()
        for (let i = 0; i < n; i++) next.set(i, [i, i + 1, i + 2])
        let mask = 0
        for (const [block, list] of next) if (list === next.get(block)) mask = mask + (1 << block)
        return mask
    }
    function entryObjectField(n: u32): number {
        const next = new Map<number, { s: number }>()
        for (let i = 0; i < n; i++) next.set(i, { s: i * 3 })
        let total = 0
        for (const [block, value] of next) total += block * 10 + value.s
        return total
    }
    function entrySetMembers(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (const [block, successors] of next) for (const successor of successors) total += block * 100 + successor
        return total
    }
    function checkedResult(n: u32): { count: number, other: number } {
        if (n === 0) throw 'checkedResult: zero'
        return { count: n * 2, other: n }
    }
    function inlinedThrowReturn(n: u32): number {
        return checkedResult(n).count
    }
    function loopedResult(n: u32): { count: number, other: number } {
        let total = 0
        for (let i: u32 = 0; i < n; i++) {
            if (i > 100) throw 'loopedResult: too many'
            total = total + i
        }
        return { count: total, other: n }
    }
    function inlinedLoopReturn(n: u32): number {
        return loopedResult(n).count
    }
    function crossBlockRead(n: u32): number {
        const chain = [n, n + 1, n + 2, n + 3]
        const seen = new Map<number, number>()
        let total = 0
        for (let i = 1; i < chain.length; i++) {
            if (chain[i - 1] > 100) total = total + 1000
            seen.set(chain[i - 1], i)
            total = total + seen.get(chain[i - 1])!
        }
        return total
    }
    function closurePairs(n: u32): number {
        const hard: [number, number][] = []
        function imply(from: number, to: number) {
            hard.push([from, to])
        }
        for (let i = 0; i < n; i++) imply(i, i + 2)
        let last = 0
        for (const [from, to] of hard) last = from * 10 + to
        return last
    }
    function lastKey(choices: Map<number, number[]>): number {
        let last = 0
        for (const [id, chain] of choices) if (chain.length) last = id
        return last
    }
    function mapKeyJoin(n: u32): number {
        const choices = new Map<number, number[]>()
        choices.set(1, [0])
        choices.set(2, [n - 1])
