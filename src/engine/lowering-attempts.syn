/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as native from './native'
import { maxFlow, type FlowEdge } from './placement-flow'
import { programStackTop, releaseProgramStack } from './builtin/memory'

if (intrinsics.argv()[0] === 'lowering-attempts') {
    function maxFlowRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 1 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 1 })
        }
        return maxFlow(n + 1, edges, 0, n).value
    }
    function flowEdges(n: u32): FlowEdge[] {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 3 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 2 })
            edges.push({ from: 0, to: i + 1, capacity: i % 3 + 1 })
        }
        return edges
    }
    function flowLengthRoot(n: u32): number {
        return maxFlow(n + 1, flowEdges(n), 0, n).flows.length
    }
    function floatPushRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const xs: number[] = []
        xs.push(residual[1])
        return xs[0] * 4
    }
    function intPushRoot(n: u32): number {
        const xs: number[] = []
        xs.push(n * 3)
        return xs[0] * 4
    }
    function floatClosureMapRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const out = [1, 2].map(x => residual[1] * x)
        return out[1] * 10
    }
    function floatIndexMapRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const out = [1, 2].map((x, i) => residual[i] * x)
        return out[1] * 10
    }
    function floatMapRoot(n: u32): number {
        const residual = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) residual[i] = i * 2
        const xs = [{ c: 10 }, { c: 20 }, { c: n }]
        const out = xs.map((x, i) => x.c - residual[i])
        return out[0] + out[1] * 10 + out[2] * 100
    }
    function maxFlowChecksumRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 3 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 2 })
            edges.push({ from: 0, to: i + 1, capacity: i % 3 + 1 })
        }
        const result = maxFlow(n + 1, edges, 0, n)
        let total = result.value * 1000 + result.sourceSide.size * 100
        for (let i = 0; i < result.flows.length; i++) total = total + result.flows[i] * (i + 1)
        return total
    }

    function scaled(xs: number[], k: number): number[] {
        const scale = k * 2
        return xs.map(x => x * scale)
    }
    function mapCaptureRoot(n: u32): number {
        return scaled([1, 2, n], n)[2]
    }

    function rootMapCapture(n: u32): number {
        const scale = n * 2
        return [1, 2, n].map(x => x * scale)[2]
    }
    function applyLocal(k: number): number {
        const scale = k * 2
        const f = (x: number) => x * scale
        return f(3)
    }
    function calleeCaptureRoot(n: u32): number {
        return applyLocal(n)
    }

    function objectMapRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        return xs.map(x => x.v * 2)[1]
    }
    function doubled(xs: { v: number }[]): number[] {
        return xs.map(x => x.v * 2)
    }
    function objectMapCalleeRoot(n: u32): number {
        return doubled([{ v: 1 }, { v: n }])[1]
    }

    function objectIterateRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        let total = 0
        for (const x of xs) total = total + x.v * 2
        return total
    }
    function objectSomeRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        return xs.some(x => x.v === n) ? 1 : 0
    }

    function heapTop(): u32 {
        return intrinsics.Intrinsics.pstack(0, 0, 0)
    }
    function releaseHeap(mark: u32): void {
        intrinsics.Intrinsics.pstack(0, mark, 0)
    }
    function flowBuildRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const count = edges.length
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return count
    }
    function flowBenchRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const result = maxFlow(n, edges, 0, n - 1)
        let total = result.value * 1000 + result.sourceSide.size
        for (let i = 0; i < result.flows.length; i++) total = total + result.flows[i] * (i % 7)
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return total
    }
    if (intrinsics.argv().includes('bench')) {
        const sizes = (intrinsics.argv().find(a => a.startsWith('sizes:'))?.slice(6) ?? '1000,4000').split(',').map(Number)
        const runs = Number(intrinsics.argv().find(a => a.startsWith('runs:'))?.slice(5) ?? '15')
        const compileStart = performance.now()
        const natives: any = native.createNatives({ flowBuildRoot, flowBenchRoot })
        console.log(`bench compile ${(performance.now() - compileStart).toFixed(0)}ms`)
        function best(f: () => number): [number, number] {
            let value = 0
            let fastest = Infinity
            for (let r = 0; r < runs; r++) {
                const t = performance.now()
                value = f()
                fastest = Math.min(fastest, performance.now() - t)
            }
            return [fastest, value]
        }
        for (const n of sizes) {
            const [nb, nbv] = best(() => Number(natives.flowBuildRoot(n)))
            const [jb, jbv] = best(() => flowBuildRoot(n))
            const [nf, nfv] = best(() => Number(natives.flowBenchRoot(n)))
            const [jf, jfv] = best(() => flowBenchRoot(n))
            const ok = nbv === jbv && nfv === jfv ? 'ok' : `MISMATCH native ${nbv}/${nfv} js ${jbv}/${jfv}`
            console.log(`bench n=${n} edges=${jbv} build native ${nb.toFixed(3)}ms js ${jb.toFixed(3)}ms | total native ${nf.toFixed(3)}ms js ${jf.toFixed(3)}ms | maxFlow native ${(nf - nb).toFixed(3)}ms js ${(jf - jb).toFixed(3)}ms ratio ${((nf - nb) / (jf - jb)).toFixed(2)} ${ok}`)
        }
    }

    const attempts: [fn: Function, args: number[]][] = [
        [objectIterateRoot, [5]],
        [objectSomeRoot, [5]],
        [objectMapRoot, [5]],
        [objectMapCalleeRoot, [5]],
        [rootMapCapture, [5]],
        [calleeCaptureRoot, [5]],
        [mapCaptureRoot, [5]],
        [maxFlowRoot, [8]],
        [maxFlowRoot, [40]],
        [intPushRoot, [8]],
        [floatPushRoot, [8]],
        [floatClosureMapRoot, [8]],
        [floatIndexMapRoot, [8]],
        [floatMapRoot, [8]],
        [flowLengthRoot, [8]],
        [maxFlowChecksumRoot, [8]],
        [maxFlowChecksumRoot, [40]],
    ]
    const only = intrinsics.argv().find(a => a.startsWith('only:'))?.slice(5)
    for (const [fn, args] of attempts) {
        if (only && fn.name !== only) continue
        const expected = Number((fn as any)(...args))
        try {
            const natives: any = native.createNatives({ [fn.name]: fn })
            const actual = Number(natives[fn.name](...args))
            if (actual === expected) console.log(`attempt ${fn.name}(${args.join(', ')}) ok = ${actual}`)
            else console.log(`attempt ${fn.name}(${args.join(', ')}) FAILED (miscompile): ${actual}, expected ${expected}`)
        } catch (e) {
            console.log(`attempt ${fn.name}(${args.join(', ')}) FAILED: ${String(e).split('\n')[0].slice(0, 400)}`)
            if (intrinsics.argv().includes('stack')) console.log((e as any)?.stack)
        }
    }
}
