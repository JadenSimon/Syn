        choices.set(3, [0, 1, n - 1])
        const operandsOf = new Map<number, number[]>()
        operandsOf.set(1, [])
        operandsOf.set(2, [1])
        operandsOf.set(3, [])
        return usersLoop(choices, operandsOf)
    }
