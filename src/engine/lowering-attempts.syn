    }
    function regionOptions(n: u32, extra?: Map<number, number>, options?: { onRegion?: (name: string, ms: number) => void }): number {
        const profile = options?.onRegion
        let regionStart = profile ? (performance as any).now() : 0
        function region(name: string) {
            if (!profile) return
            const end = (performance as any).now()
            profile(name, end - regionStart)
            regionStart = (performance as any).now()
        }
        let s = 0
        for (let i: u32 = 0; i < n; i++) s += i
        region('first')
        for (let i: u32 = 0; i < n; i++) s += i * 2
        region('second')
        return s + (extra ? extra.size : 0)
    }
    ;(regionOptions as any).shouldNotInline = true
    function optionalRegions(n: u32): number {
        return regionOptions(n)
    }
