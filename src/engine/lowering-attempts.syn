    function floatRecord(n: u32): { value: number, side: Set<number>, flows: number[] } {
        const residual = new Float64Array(n + 1)
        for (let i = 0; i <= n; i++) residual[i] = i + 2
        let value = 0
        let amount = Infinity
        for (let i = 0; i <= n; i++) amount = Math.min(amount, residual[i])
        value += amount
        const side = new Set<number>()
        side.add(n)
        return { value, side, flows: [1] }
    }
    ;(floatRecord as any).shouldNotInline = true
    function floatRecordRoot(n: u32): number {
        return floatRecord(n).value
    }
    function floatOnly(n: u32): { value: number } {
