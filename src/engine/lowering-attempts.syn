    function chainLookups(choices: Map<number, number[]>): number {
        const cache = new Map<string, { chain: number[], hits: number }>()
        const info = new Map<number, { chain: number[], hits: number }>()
        for (const [value, chain] of choices) {
            const key = chain.join(',')
            let found = cache.get(key)
            if (!found) cache.set(key, found = { chain, hits: 0 })
            info.set(value, found)
        }
        let total = 0
        for (const [value] of choices) total += info.get(value)!.chain.length
        return total
    }
