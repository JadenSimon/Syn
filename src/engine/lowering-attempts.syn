    function entriesTwoValueShapes(n: u32): number {
        const lists = new Map<number, number[]>()
        const sets = new Map<number, Set<number>>()
        for (let i: u32 = 0; i < n; i++) {
            lists.set(i, [i, i])
            sets.set(i, new Set([i]))
        }
        lists.delete(n + 5)
        sets.delete(n + 5)
        let total = 0
        for (const [k, list] of lists) total = total + k + list.length
        for (const [k, set] of sets) total = total + k + set.size
        return total
    }
    function floatPushIntKeys(n: u32): number {
        const m = new Map<number, number>()
        for (let i: u32 = 0; i < n; i++) m.set(i, i)
        const halves: number[] = []
        halves.push(n * 0.5)
        let total = 0
        for (const [k, v] of m) total = total + k * 10 + v
        return total + (m.has(2) ? 1000 : 0) + halves.length
    }
    function someTwoClosures(n: u32): number {
        const xs = [n, n + 1]
        const k = n
        const zero = xs.some(x => x === 0)
        const next = xs.some(x => x === k + 1)
        return (zero ? 1 : 0) + (next ? 10 : 0)
    }
    function someManyClosures(n: u32): number {
        const xs = [n, n + 1, n + 2, n + 3]
        const k = n
        let total = 0
        if (xs.some(x => x === 0)) total += 1
        if (xs.some(x => x === k)) total += 2
        if (xs.some(x => x === k + 1)) total += 4
        if (xs.some(x => x === k + 2)) total += 8
        if (xs.some(x => x === k + 3)) total += 16
        if (xs.some(x => x === k + 4)) total += 32
        if (xs.some(x => x > k + 2)) total += 64
        if (xs.some(x => x < k)) total += 128
        if (xs.some(x => x * 2 === k + 6)) total += 256
        if (xs.some(x => (x & 1) === 1)) total += 512
        if (xs.some(x => x - k === 3)) total += 1024
        if (xs.some(x => x + k === 99)) total += 2048
        return total
    }
    function dynKeyMembers(n: u32): number {
        const o: Record<string, string> = {}
        for (let i: u32 = 0; i < n; i++) o['k' + i] = 'v' + i
        let hits = 0
        for (let i: u32 = 0; i < n + 3; i++) {
            if (o['k' + i] !== undefined) hits++
        }
        const named = o.k1 !== undefined ? 100 : 0
        return hits + named
    }
    function dynKeyNested(n: u32): number {
        const outer: Record<string, Record<string, string>> = {}
        for (let i: u32 = 0; i < n; i++) {
            const inner: Record<string, string> = {}
            inner['v' + i] = 'k' + i
            outer['k' + i] = inner
        }
        let hits = 0
        for (let i: u32 = 0; i < n + 2; i++) {
            const inner = outer['k' + i]
            if (inner !== undefined && inner['v' + i] !== undefined) hits++
            if (inner !== undefined && inner['v' + (i + 1)] !== undefined) hits += 100
        }
        return hits
    }
    function dynKeyWords(n: u32): number {
        const o: Record<string, number> = {}
        o['a' + n] = n * 1000000000
        o['b' + n] = n - 7
        o['c' + n] = 0
        const missing = o['z' + n] === undefined ? 1 : 0
        const zero = o['c' + n] === undefined ? 0 : 10
        return (o['a' + n] ?? 0) + (o['b' + n] ?? 0) + missing + zero
    }
    function dynKeyFloats(n: u32): number {
