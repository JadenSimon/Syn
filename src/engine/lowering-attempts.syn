    interface Boxed { size: number, items: number[], index: Map<number, number>, tag?: number }
    function indexItems(g: Boxed, items: number[]): void {
        g.items = items
        g.index = new Map()
        for (const x of items) g.index.set(x, x)
    }
    function makeBoxed(init?: Partial<Boxed>): Boxed {
        const g: Boxed = {
            size: init?.size ?? 1,
            items: init?.items ?? [],
            index: new Map(),
            tag: init?.tag,
        }
        indexItems(g, g.items)
        return g
    }
    function explicitFieldsRoot(n: u32): number {
        const b = makeBoxed({ size: n })
        return b.size + b.items.length + b.index.size
    }
