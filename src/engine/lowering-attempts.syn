/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as harness from './harness'
import { maxFlow, solvePlacements, type FlowEdge } from './placement-flow'
import { addNode, createGraph, getArgIds, getLiteral, getOperands, makeNode, NodeOp, NodeFlags, getNode, putCopy, retypeNode, typeOf, copyNode, countIds, setGraphBlocks, enumerateRefs, makeNodeFromSlots, refSlot, opName, slotKey } from './graph-node'
import * as lowering from './lowering'
import * as lowering2 from './lowering2'
import { type Graph, type GraphNode } from './lowering2'
import { programStackTop, releaseProgramStack } from './builtins'

export function suite() {
    function maxFlowRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 1 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 1 })
        }
        return maxFlow(n + 1, edges, 0, n).value
    }
    function flowEdges(n: u32): FlowEdge[] {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 3 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 2 })
            edges.push({ from: 0, to: i + 1, capacity: i % 3 + 1 })
        }
        return edges
    }
    function flowLengthRoot(n: u32): number {
        return maxFlow(n + 1, flowEdges(n), 0, n).flows.length
    }
    function setIterRoot(n: u32): number {
        const s = new Set<number>()
        for (let i: u32 = 0; i < n; i++) s.add(i % 13)
        let total = 0
        for (const x of s) total = total + x
        for (const x of s.values()) total = total + x * 2
        return total
    }
    function mapIterRoot(n: u32): number {
        const m = new Map<number, number>()
        for (let i: u32 = 0; i < n; i++) m.set(i % 11, i)
        let total = 0
        for (const k of m.keys()) total = total + k
        for (const v of m.values()) total = total + v * 3
        return total
    }
    function forOfRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) edges.push({ from: i % 7, to: (i * 3) % 7, capacity: 1 })
        const offsets = new Int32Array(8)
        for (const edge of edges) {
            offsets[edge.from + 1]++
            offsets[edge.to + 1]++
        }
        return offsets[1] + offsets[3] * 100
    }
    function edgeLoopRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) edges.push({ from: i, to: i + 1, capacity: i % 3 })
        let total = 0
        for (let i = 0; i < edges.length; i++) {
            const edge = edges[i]
            total = total + edge.from * edge.capacity
        }
        return total
    }
    function scanRoot(n: u32): number {
        const cursor = new Int32Array(n)
        const adjacency = new Int32Array(n * 4)
        const level = new Int32Array(n)
        for (let i: u32 = 0; i < n * 4; i++) adjacency[i] = (i * 7) % n
        for (let i: u32 = 0; i < n; i++) level[i] = i % 5
        let total = 0
        for (let from = 0; from < n; from++) {
            const end = (from + 1) * 4
            cursor[from] = from * 4
            while (cursor[from] < end) {
                const edge = adjacency[cursor[from]]
                if (level[edge] === level[from] + 1) break
                cursor[from]++
            }
            total = total + cursor[from]
        }
        return total
    }
    function floatPushRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const xs: number[] = []
        xs.push(residual[1])
        return xs[0] * 4
    }
    function intPushRoot(n: u32): number {
        const xs: number[] = []
        xs.push(n * 3)
        return xs[0] * 4
    }
    function floatClosureMapRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const out = [1, 2].map(x => residual[1] * x)
        return out[1] * 10
    }
    function floatIndexMapRoot(n: u32): number {
        const residual = new Float64Array(2)
        residual[1] = n
        const out = [1, 2].map((x, i) => residual[i] * x)
        return out[1] * 10
    }
    function floatMapRoot(n: u32): number {
        const residual = new Float64Array(n)
        for (let i: u32 = 0; i < n; i++) residual[i] = i * 2
        const xs = [{ c: 10 }, { c: 20 }, { c: n }]
        const out = xs.map((x, i) => x.c - residual[i])
        return out[0] + out[1] * 10 + out[2] * 100
    }
    function maxFlowChecksumRoot(n: u32): number {
        const edges: FlowEdge[] = []
        for (let i: u32 = 0; i < n; i++) {
            edges.push({ from: i, to: i + 1, capacity: (i * 7) % 5 + 3 })
            edges.push({ from: i, to: (i + 3) % (n + 1), capacity: (i * 3) % 4 + 2 })
            edges.push({ from: 0, to: i + 1, capacity: i % 3 + 1 })
        }
        const result = maxFlow(n + 1, edges, 0, n)
        let total = result.value * 1000 + result.sourceSide.size * 100
        for (let i = 0; i < result.flows.length; i++) total = total + result.flows[i] * (i + 1)
        return total
    }

    function scaled(xs: number[], k: number): number[] {
        const scale = k * 2
        return xs.map(x => x * scale)
    }
    function mapCaptureRoot(n: u32): number {
        return scaled([1, 2, n], n)[2]
    }

    function rootMapCapture(n: u32): number {
        const scale = n * 2
        return [1, 2, n].map(x => x * scale)[2]
    }
    function applyLocal(k: number): number {
        const scale = k * 2
        const f = (x: number) => x * scale
        return f(3)
    }
    function calleeCaptureRoot(n: u32): number {
        return applyLocal(n)
    }

    function objectMapRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        return xs.map(x => x.v * 2)[1]
    }
    function doubled(xs: { v: number }[]): number[] {
        return xs.map(x => x.v * 2)
    }
    function objectMapCalleeRoot(n: u32): number {
        return doubled([{ v: 1 }, { v: n }])[1]
    }

    function objectIterateRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        let total = 0
        for (const x of xs) total = total + x.v * 2
        return total
    }
    function objectSomeRoot(n: u32): number {
        const xs = [{ v: 1 }, { v: n }]
        return xs.some(x => x.v === n) ? 1 : 0
    }

    function heapTop(): u32 {
        return intrinsics.Intrinsics.pstack(0, 0, 0)
    }
    function releaseHeap(mark: u32): void {
        intrinsics.Intrinsics.pstack(0, mark, 0)
    }
    function flowBuildRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const count = edges.length
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return count
    }
    function staticSeed(): number {
        return 41
    }
    function staticRoot(n: u32): number {
        return (intrinsics.Intrinsics as any).static(staticSeed) + n
    }
    function staticMapSeed(): Map<number, number> {
        const m = new Map<number, number>()
        for (let i = 0; i < 4; i++) m.set(i, i * 10)
        return m
    }
    function staticMapRoot(n: u32): number {
        const m = (intrinsics.Intrinsics as any).static(staticMapSeed) as Map<number, number>
        return m.get(n)! + m.size
    }
    const capturedPairs = [[1, 10], [3, 30]]
    function capturedPairsRoot(n: u32): number {
        let sum = 0
        for (let i = 0; i < capturedPairs.length; i++) sum = sum + capturedPairs[i][0] * capturedPairs[i][1]
        return sum + n
    }
    const capturedTable = new Map<number, number>([[1, 10], [3, 30]])
    function capturedTableRoot(n: u32): number {
        return capturedTable.get(n)! + capturedTable.size
    }
    function mapOfSetsTwoSites(n: u32): number {
        const next = new Map<number, Set<number>>()
        next.set(n, new Set())
        const first = next.get(n)!.size
        next.set(n + 1, new Set())
        return first + next.get(n + 1)!.size
    }
    function getOrCreate(n: u32): number {
        const prev = new Map<number, number[]>()
        for (let i: u32 = 0; i < n; i++) {
            const key = i % 3
            let list = prev.get(key)
            if (!list) prev.set(key, list = [])
            list.push(i)
        }
        return prev.get(0)!.length + prev.get(1)!.length * 10
    }
    function getOrCreateCaptured(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        const prev = new Map<number, number[]>()
        for (const [block, successors] of next) {
            for (const successor of successors) {
                let list = prev.get(successor)
                if (!list) prev.set(successor, list = [])
                list.push(block)
            }
        }
        function count(block: number): number {
            let total = 0
            for (const p of prev.get(block) ?? []) total += p
            return total
        }
        return count(0) + count(1) * 100
    }
    function entrySetSizes(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (const [block, successors] of next) total += block * 10 + successors.size
        return total
    }
    function pairSetSize(n: u32): number {
        const s = new Set([n, n + 1])
        const pair: [number, Set<number>] = [n, s]
        return pair[1].size * 10 + pair[0]
    }
    function mapSetSizes(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (let i = 0; i < n; i++) total += next.get(i)!.size
        return total
    }
    function entrySetBoth(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (const [block, successors] of next) total += next.get(block)!.size * 1000 + successors.size
        return total
    }
    function entryArrayLengths(n: u32): number {
        const next = new Map<number, number[]>()
        for (let i = 0; i < n; i++) next.set(i, [i, i + 1, i + 2])
        let total = 0
        for (const [block, list] of next) total += block * 10 + list.length
        return total
    }
    function entryArrayIdentity(n: u32): number {
        const next = new Map<number, number[]>()
        for (let i = 0; i < n; i++) next.set(i, [i, i + 1, i + 2])
        let total = 0
        for (const [block, list] of next) total += block * 10 + (list === next.get(block) ? 1 : 0)
        return total
    }
    function entryArrayMask(n: u32): number {
        const next = new Map<number, number[]>()
        for (let i = 0; i < n; i++) next.set(i, [i, i + 1, i + 2])
        let mask = 0
        for (const [block, list] of next) if (list === next.get(block)) mask = mask + (1 << block)
        return mask
    }
    function entryObjectField(n: u32): number {
        const next = new Map<number, { s: number }>()
        for (let i = 0; i < n; i++) next.set(i, { s: i * 3 })
        let total = 0
        for (const [block, value] of next) total += block * 10 + value.s
        return total
    }
    function entrySetMembers(n: u32): number {
        const next = new Map<number, Set<number>>()
        for (let i = 0; i < n; i++) next.set(i, new Set([(i + 1) % n, (i + 2) % n]))
        let total = 0
        for (const [block, successors] of next) for (const successor of successors) total += block * 100 + successor
        return total
    }
    function checkedResult(n: u32): { count: number, other: number } {
        if (n === 0) throw 'checkedResult: zero'
        return { count: n * 2, other: n }
    }
    function inlinedThrowReturn(n: u32): number {
        return checkedResult(n).count
    }
    function loopedResult(n: u32): { count: number, other: number } {
        let total = 0
        for (let i: u32 = 0; i < n; i++) {
            if (i > 100) throw 'loopedResult: too many'
            total = total + i
        }
        return { count: total, other: n }
    }
    function inlinedLoopReturn(n: u32): number {
        return loopedResult(n).count
    }
    function crossBlockRead(n: u32): number {
        const chain = [n, n + 1, n + 2, n + 3]
        const seen = new Map<number, number>()
        let total = 0
        for (let i = 1; i < chain.length; i++) {
            if (chain[i - 1] > 100) total = total + 1000
            seen.set(chain[i - 1], i)
            total = total + seen.get(chain[i - 1])!
        }
        return total
    }
    function closurePairs(n: u32): number {
        const hard: [number, number][] = []
        function imply(from: number, to: number) {
            hard.push([from, to])
        }
        for (let i = 0; i < n; i++) imply(i, i + 2)
        let last = 0
        for (const [from, to] of hard) last = from * 10 + to
        return last
    }
    function pairsIntoOperands(n: u32): number {
        const hard: [number, number][] = []
        for (let i = 0; i < n; i++) hard.push([i, i + 2])
        const ops: (number | { literal: number })[] = [{ literal: 7 }]
        for (const [from, to] of hard) {
            ops.push(from)
            ops.push(to)
        }
        let total = 0
        for (const op of ops) total = total + operandWeight(op)
        return total
    }
    function lastKey(choices: Map<number, number[]>): number {
        let last = 0
        for (const [id, chain] of choices) if (chain.length) last = id
        return last
    }
    function mapKeyJoin(n: u32): number {
        const choices = new Map<number, number[]>()
        choices.set(1, [0])
        choices.set(2, [n - 1])
        choices.set(3, [0, 1, n - 1])
        return lastKey(choices)
    }
    function pickedResult(n: u32): { count: number, other: number } {
        if (n > 3) return { count: n, other: 1 }
        return { count: n * 2, other: 0 }
    }
    function inlinedTwoReturns(n: u32): number {
        return pickedResult(n).count
    }
    function templateKeyOne(n: u32): number {
        function key(from: number): string {
            return `${from}:`
        }
        return key(n).length + (key(n * 1000) + key(n)).length
    }
    function templateKeyDirect(n: u32): number {
        const signed = intrinsics.Intrinsics.convert(n, intrinsics.Types.u32, intrinsics.Types.i64)
        const zero = intrinsics.Intrinsics.sub(signed, 3, intrinsics.Types.i64)
        const negative = intrinsics.Intrinsics.sub(signed, 15, intrinsics.Types.i64)
        return `${n}:`.length + `${zero}`.length + `${negative}`.length + `${n * 41152}`.length
    }
    function templateNegOnly(n: u32): number {
        const signed = intrinsics.Intrinsics.convert(n, intrinsics.Types.u32, intrinsics.Types.i64)
        return `${intrinsics.Intrinsics.sub(signed, 15, intrinsics.Types.i64)}`.length
    }
    function templatePosOnly(n: u32): number {
        return `${n * 41152}`.length
    }
    function templateTwo(n: u32): number {
        return `${n}`.length + `${n + 10}`.length
    }
    function templateNested(n: u32): number {
        return `${n * 41152}:`.length
    }
    function opaqueNode(...refs: number[]): GraphNode {
        const slots = new Uint32Array(refs.length)
        for (let i = 0; i < refs.length; i++) slots[i] = 2 ** 29 + refs[i]
        return { op: NodeOp.opaque, slots, flags: 0, scratchFlags: 0, epoch: 0 } as GraphNode
    }
    function hasRelayedKeys(choices: Map<number, number>): number {
        const rows = new Map<number, number[]>()
        for (const [id] of choices) rows.set(id, [0])
        let found = 0
        for (const [value] of rows) if (choices.has(value)) found++
        return found
    }
    function relayedKeyLookup(n: u32): number {
        const choices = new Map<number, number>()
        choices.set(1, 0)
        choices.set(2, n)
        return hasRelayedKeys(choices)
    }
    function spreadGraph(n: u32): number {
        const nodes = new Map<number, GraphNode>()
        nodes.set(1, opaqueNode())
        const g = createGraph({ nodes, ids: { next: n } })
        return g.ids.next + g.nodes.size * 10 + g.blocks.length * 100
    }
    function nodeCount(g: Graph): number {
        return g.ids.next + g.nodes.size * 10
    }
    ;(nodeCount as any).shouldNotInline = true
    function passedGraph(n: u32): number {
        const nodes = new Map<number, GraphNode>()
        nodes.set(1, opaqueNode())
        return nodeCount(createGraph({ nodes, ids: { next: n } }))
    }
    function numberLabelLength(n: u32): number {
        return ('n' + n).length
    }
    function joinedTextLength(n: u32): number {
        const a = n > 2 ? 'abc' : 'de'
        return (a + 'x').length
    }
    function chainedLabelLength(n: u32): number {
        return ('a' + n + 'bc').length
    }
    function returnedLabel(n: u32): string {
        return 'v' + n
    }
    ;(returnedLabel as any).shouldNotInline = true
    function returnedLabelLength(n: u32): number {
        return returnedLabel(n).length + returnedLabel(n * 100).length
    }
    function readOptional(n: u32, o?: { x: number }): number {
        const x = o?.x
        return x ? x + n : n
    }
    function optionalOmitted(n: u32): number {
        return readOptional(n)
    }
    function optionalExplicit(n: u32): number {
        return readOptional(n, undefined)
    }
    function scaledBy(x: number, n: u32): number {
        return x * n
    }
    function iterateMap(m: Map<number, number>, n: u32): number {
        let s = 0
        for (const [k, v] of m) {
            if (v > 1000) throw 'iterateMap: too large'
            s += scaledBy(v, n) + k
        }
        return s
    }
    ;(iterateMap as any).shouldNotInline = true
    function forOfMap(n: u32): number {
        const m = new Map<number, number>()
        m.set(1, n)
        m.set(2, n + 1)
        return iterateMap(m, n)
    }
    function callOptional(n: u32, f?: (x: number) => number): number {
        const g = f
        function region(x: number): number {
            if (!g) return x
            return g(x)
        }
        return region(n) + region(n + 1)
    }
    ;(callOptional as any).shouldNotInline = true
    function optionalCallback(n: u32): number {
        return callOptional(n)
    }
    function regionLoop(n: u32, onRegion?: (name: number, at: number) => void): number {
        const profile = onRegion
        let start = profile ? (performance as any).now() : 0
        function region(name: number) {
            if (!profile) return
            const end = (performance as any).now()
            profile(name, end - start)
            start = (performance as any).now()
        }
        let s = 0
        for (let i: u32 = 0; i < n; i++) {
            s += i
            region(i)
        }
        return s + (start ? 1 : 0)
    }
    ;(regionLoop as any).shouldNotInline = true
    function optionalRegion(n: u32): number {
        return regionLoop(n)
    }
    function startOnly(n: u32, onRegion?: (name: number) => void): number {
        const profile = onRegion
        let start = profile ? (performance as any).now() : 0
        function region() {
            if (!profile) return
            profile((performance as any).now() - start)
            start = (performance as any).now()
        }
        region()
        return n + (start ? 1 : 0)
    }
    ;(startOnly as any).shouldNotInline = true
    function optionalStart(n: u32): number {
        return startOnly(n)
    }
    function mapValueLengths(n: u32): number {
        const m = new Map<number, number[]>()
        m.set(1, [n])
        m.set(2, [n, n])
        let s = 0
        for (const row of m.values()) s += row.length
        return s
    }
    function boxOf(o: { a: number, b: number }): { value: number } {
        return { value: o.a + o.b }
    }
    ;(boxOf as any).shouldNotInline = true
    function capturedToken(n: u32): number {
        const o = { a: n, b: n + 1 }
        const x = boxOf(o)
        let s = 0
        for (let i: u32 = 0; i < n; i++) s += x.value + i
        return s
    }
    function sideA(n: number): number {
        return n * 2
    }
    ;(sideA as any).shouldNotInline = true
    function sideB(a: number, b: number): number {
        return a + b
    }
    ;(sideB as any).shouldNotInline = true
    function loadAcrossCall(o: { a: number, b: number }, p: { a: number, b: number }, n: number): number {
        const r = sideA(n)
        const x = p.b
        o.a = 0
        o.b = 0
        return sideB(r, x)
    }
    ;(loadAcrossCall as any).shouldNotInline = true
    function alreadyDone(n: u32): number {
        const o = { a: n, b: n + 1 }
        const p = { a: n + 2, b: n + 3 }
        return loadAcrossCall(o, p, n) + loadAcrossCall(p, p, n) + o.a
    }
    function clearA(o: { a: number }): void {
        o.a = 0
    }
    ;(clearA as any).shouldNotInline = true
    function lostStore(n: u32): number {
        const o = { a: n }
        clearA(o)
        return o.a
    }
    function clearWithCall(o: { a: number }, n: number): number {
        const r = sideA(n)
        o.a = 0
        return r
    }
    ;(clearWithCall as any).shouldNotInline = true
    function lostStoreCall(n: u32): number {
        const o = { a: n }
        return clearWithCall(o, n) + o.a
    }
    function readA(q: { a: number, b: number }): number {
        return q.a
    }
    ;(readA as any).shouldNotInline = true
    function warAcross(o: { a: number, b: number }, p: { a: number, b: number }, n: number): number {
        const x = p.b
        const r = readA(p)
        o.a = r + n
        return sideB(r, x)
    }
    ;(warAcross as any).shouldNotInline = true
    function warBranch(o: { a: number, b: number }, p: { a: number, b: number }, n: number): number {
        const x = p.b
        const r = readA(p)
        o.a = r + n
        if (n > 2) return sideB(r, x)
        return r
    }
    ;(warBranch as any).shouldNotInline = true
