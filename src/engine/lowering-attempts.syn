    }
    function chainLookups(choices: Map<number, number[]>): number {
        const cache = new Map<string, { chain: number[], hits: number }>()
        const info = new Map<number, { chain: number[], hits: number }>()
        for (const [value, chain] of choices) {
            const key = chain.join(',')
            let found = cache.get(key)
            if (!found) cache.set(key, found = { chain, hits: 0 })
            info.set(value, found)
        }
        let total = 0
        for (const [value] of choices) total += info.get(value)!.chain.length
        return total
    }
    ;(chainLookups as any).shouldNotInline = true
    function chainInfoRoot(n: u32): number {
        const choices = new Map<number, number[]>()
        choices.set(1, [0])
        choices.set(2, [n - 1])
        choices.set(3, [0, 1, n - 1])
        return chainLookups(choices)
    }
    function usersLoop(choices: Map<number, number[]>, operandsOf: Map<number, number[]>): number {
        const info = new Map<number, { chain: number[] }>()
        for (const [value, chain] of choices) info.set(value, { chain })
        const users = new Map<number, Set<number>>()
        for (const [id] of choices) users.set(id, new Set())
        for (const [user] of choices) {
            for (const operand of operandsOf.get(user)!) if (operand && choices.has(operand)) users.get(operand)!.add(user)
        }
        let total = 0
        for (const [operand, consumers] of users) {
            for (const consumer of consumers) total += info.get(operand)!.chain.length * 10 + choices.get(consumer)!.length
        }
        return total
    }
