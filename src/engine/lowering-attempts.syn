        for (let i = 0; i <= n; i++) amount = Math.min(amount, i + 2)
        return { value: amount }
    }
    ;(floatOnly as any).shouldNotInline = true
    function floatOnlyRoot(n: u32): number {
        return floatOnly(n).value
    }
