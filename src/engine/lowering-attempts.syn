        const users = new Map<number, Set<number>>()
        for (const [id] of choices) users.set(id, new Set())
        for (const [user] of choices) {
            for (const operand of operandsOf.get(user)!) if (operand && choices.has(operand)) users.get(operand)!.add(user)
        }
        let total = 0
        for (const [operand, consumers] of users) {
