    function chainsToSets(choices: Map<number, number[]>): number {
        const next = new Map<number, Set<number>>()
        for (const [id, chain] of choices) {
            for (const block of chain) if (!next.has(block)) next.set(block, new Set())
            for (let i = 1; i < chain.length; i++) next.get(chain[i - 1])!.add(chain[i])
        }
        let total = 0
