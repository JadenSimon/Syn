    function setsInMap(n: u32): number {
        const m = new Map<number, Set<number>>()
        for (let i: u32 = 0; i < n; i++) {
            if (!m.has(i % 2)) m.set(i % 2, new Set())
            m.get(i % 2)!.add(i)
        }
        return m.get(0)!.size * 10 + m.get(1)!.size
    }
    function chainsToSets(choices: Map<number, number[]>): number {
        const next = new Map<number, Set<number>>()
        for (const [id, chain] of choices) {
            for (const block of chain) if (!next.has(block)) next.set(block, new Set())
            for (let i = 1; i < chain.length; i++) next.get(chain[i - 1])!.add(chain[i])
        }
        let total = 0
        for (const [b, s] of next) total += b * s.size
        return total
    }
    ;(chainsToSets as any).shouldNotInline = true
    function setsFromChains(n: u32): number {
        const choices = new Map<number, number[]>()
