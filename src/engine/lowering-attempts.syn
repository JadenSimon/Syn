        choices.set(3, [0, 1, n - 1])
        choices.set(4, [0, 2, n - 1])
        return solvePlacements(g, choices).parameterCount
    }
    function flushRoot(n: u32): number {
        let a = 1
        let b = 2
        let c = 3
        const out: number[] = []
        function bump() { a = a + b + c }
        for (let i: u32 = 0; i < n; i++) out.push(i)
        bump()
        return a + out.length
    }
    function flowBenchRoot(n: u32): number {
        const mark = intrinsics.isNative() ? programStackTop() : 0
        const heapMark = intrinsics.isNative() ? heapTop() : 0
        const edges: FlowEdge[] = []
        let seed: u32 = 12345
        for (let i: u32 = 0; i + 1 < n; i++) {
            seed = (seed * 48271) % 2147483647
            edges.push({ from: i, to: i + 1, capacity: seed % 10 + 1 })
        }
        for (let i: u32 = 0; i < n * 3; i++) {
            seed = (seed * 48271) % 2147483647
            const from = seed % n
            seed = (seed * 48271) % 2147483647
            const to = seed % n
            seed = (seed * 48271) % 2147483647
            if (from !== to) edges.push({ from, to, capacity: seed % 10 + 1 })
        }
        const result = maxFlow(n, edges, 0, n - 1)
        let total = result.value * 1000 + result.sourceSide.size
        for (let i = 0; i < result.flows.length; i++) total = total + result.flows[i] * (i % 7)
        if (intrinsics.isNative()) {
            releaseProgramStack(mark)
            releaseHeap(heapMark)
        }
        return total
    }
    if (intrinsics.argv().includes('bench')) {
        const sizes = (intrinsics.argv().find(a => a.startsWith('sizes:'))?.slice(6) ?? '1000,4000').split(',').map(Number)
        const runs = Number(intrinsics.argv().find(a => a.startsWith('runs:'))?.slice(5) ?? '15')
        const compileStart = performance.now()
        const natives: any = native.createNatives(intrinsics.argv().includes('promoted') ? { flowBuildRoot, flowBenchRoot: flowPromotedRoot } : { flowBuildRoot, flowBenchRoot })
        console.log(`bench compile ${(performance.now() - compileStart).toFixed(0)}ms`)
        function best(f: () => number): [number, number] {
            let value = 0
            let fastest = Infinity
            for (let r = 0; r < runs; r++) {
                const t = performance.now()
                value = f()
                fastest = Math.min(fastest, performance.now() - t)
            }
            return [fastest, value]
        }
        if (intrinsics.argv().includes('setup-split')) {
            const split: any = native.createNatives({ flowBuildRoot, flowSetupRoot, flowBenchRoot })
            for (const n of sizes) {
                const [b] = best(() => Number(split.flowBuildRoot(n)))
                const [s2, sv] = best(() => Number(split.flowSetupRoot(n)))
                const [f] = best(() => Number(split.flowBenchRoot(n)))
                console.log(`split n=${n} build ${b.toFixed(3)}ms setup ${(s2 - b).toFixed(3)}ms phases ${(f - s2).toFixed(3)}ms total ${f.toFixed(3)}ms (setup check ${sv === flowSetupRoot(n) ? 'ok' : 'MISMATCH'})`)
            }
        }
        if (intrinsics.argv().includes('exit-split')) {
            const split: any = native.createNatives({ flowBuildRoot, flowNoExitRoot, flowBenchRoot })
            for (const n of sizes) {
                const [b] = best(() => Number(split.flowBuildRoot(n)))
                const [x] = best(() => Number(split.flowNoExitRoot(n)))
                const [f] = best(() => Number(split.flowBenchRoot(n)))
                console.log(`exit n=${n} build ${b.toFixed(3)}ms noexit ${(x - b).toFixed(3)}ms full ${(f - b).toFixed(3)}ms exit ${(f - x).toFixed(3)}ms (${((f - x) / (f - b) * 100).toFixed(1)}%)`)
            }
        }
        if (intrinsics.argv().includes('native-only')) {
            for (const n of sizes) {
                const [nf, nfv] = best(() => Number(natives.flowBenchRoot(n)))
                console.log(`bench n=${n} native ${nf.toFixed(3)}ms = ${nfv}`)
            }
        }
        else for (const n of sizes) {
            const [nb, nbv] = best(() => Number(natives.flowBuildRoot(n)))
            const [jb, jbv] = best(() => flowBuildRoot(n))
            const [nf, nfv] = best(() => Number(natives.flowBenchRoot(n)))
            const [jf, jfv] = best(() => flowBenchRoot(n))
            const ok = nbv === jbv && nfv === jfv ? 'ok' : `MISMATCH native ${nbv}/${nfv} js ${jbv}/${jfv}`
            console.log(`bench n=${n} edges=${jbv} build native ${nb.toFixed(3)}ms js ${jb.toFixed(3)}ms | total native ${nf.toFixed(3)}ms js ${jf.toFixed(3)}ms | maxFlow native ${(nf - nb).toFixed(3)}ms js ${(jf - jb).toFixed(3)}ms ratio ${((nf - nb) / (jf - jb)).toFixed(2)} ${ok}`)
        }
    }

    if (intrinsics.argv().includes('bench')) {
        function repeated(fn: (n: u32) => number) {
            return function repeated(reps: u32, n: u32): number {
                let total = 0
                for (let i: u32 = 0; i < reps; i++) total = total + fn(n)
                return total
            }
        }
        const benches: [fn: (n: u32) => number, n: u32][] = [
            [placementRoot, 4 as u32],
        ]
        const stacks = [0, programStack]
        for (const [fn, n] of benches) {
            const wrapper = repeated(fn)
            const compileStart = performance.now()
            const run: any = native.createNatives({ [fn.name]: wrapper })[fn.name]
            const compiled = performance.now() - compileStart
            const marks = stacks.map(stack => native.pstackMark(stack))
            const release = () => stacks.forEach((stack, i) => native.pstackRelease(stack, marks[i]))
            run(1, n)
            const perCall = Math.max(...stacks.map((stack, i) => Number(native.pstackMark(stack) - marks[i])))
            release()
            const fits = perCall ? Math.max(1, Math.floor((8 << 20) / perCall)) : Infinity
            const reps = Math.min(fits, Number(intrinsics.argv().find(a => a.startsWith('reps:'))?.slice(5) ?? 200)) as u32
            let nativeResult = 0
            let jsResult = 0
            const jsTop = programStackTop()
            for (let i = 0; i < 5; i++) {
                nativeResult = Number(run(reps, n))
                release()
                jsResult = wrapper(reps, n)
                releaseProgramStack(jsTop)
            }
            let nativeBest = Infinity
            let jsBest = Infinity
            for (let sample = 0; sample < 7; sample++) {
                let start = performance.now()
                nativeResult = Number(run(reps, n))
                nativeBest = Math.min(nativeBest, (performance.now() - start) / reps)
                release()
                start = performance.now()
                jsResult = wrapper(reps, n)
                jsBest = Math.min(jsBest, (performance.now() - start) / reps)
                releaseProgramStack(jsTop)
            }
            const check = nativeResult === jsResult ? '' : ` MISMATCH native=${nativeResult} js=${jsResult}`
            const ratio = nativeBest / jsBest
            const verdict = ratio > 1 ? `${ratio.toFixed(2)}x slower` : `${(1 / ratio).toFixed(2)}x faster`
            console.log(`bench ${fn.name}(${n}) compile ${compiled.toFixed(0)}ms, native ${(nativeBest * 1000).toFixed(2)} us, js ${(jsBest * 1000).toFixed(2)} us, native ${verdict}, ${(perCall / 1024).toFixed(1)} KB pstack/call, reps ${reps}${check}`)
        }
    }

    const attempts: [fn: Function, args: number[]][] = [
        [objectIterateRoot, [5]],
        [objectSomeRoot, [5]],
        [objectMapRoot, [5]],
        [objectMapCalleeRoot, [5]],
        [rootMapCapture, [5]],
        [calleeCaptureRoot, [5]],
        [mapCaptureRoot, [5]],
        [maxFlowRoot, [8]],
        [maxFlowRoot, [40]],
        [setIterRoot, [50]],
        [mapIterRoot, [50]],
        [forOfRoot, [50]],
        [edgeLoopRoot, [50]],
        [scanRoot, [50]],
        [intPushRoot, [8]],
        [floatPushRoot, [8]],
        [floatClosureMapRoot, [8]],
        [floatIndexMapRoot, [8]],
        [floatMapRoot, [8]],
        [flowLengthRoot, [8]],
        [maxFlowChecksumRoot, [8]],
        [maxFlowChecksumRoot, [40]],
        [placementRoot, [4]],
        [staticRoot, [1]],
        [staticMapRoot, [2]],
        [capturedPairsRoot, [1]],
        [mapOfSetsTwoSites, [3]],
        [getOrCreate, [7]],
        [inlinedTwoReturns, [5]],
        [crossBlockRead, [5]],
        [closurePairs, [5]],
        [mapKeyJoin, [5]],
        [relayedKeyLookup, [4]],
        [spreadGraph, [4]],
        [passedGraph, [4]],
        [numberLabelLength, [42]],
        [joinedTextLength, [4]],
        [chainedLabelLength, [7]],
        [returnedLabelLength, [42]],
        [optionalOmitted, [4]],
        [optionalExplicit, [4]],
        [forOfMap, [3]],
        [optionalCallback, [3]],
        [optionalRegion, [4]],
        [optionalStart, [4]],
        [getOrCreateCaptured, [7]],
        [entrySetSizes, [7]],
        [pairSetSize, [7]],
        [entrySetBoth, [7]],
        [entryArrayLengths, [7]],
        [entryObjectField, [7]],
        [entryArrayIdentity, [7]],
        [entryArrayMask, [7]],
        [mapSetSizes, [7]],
        [entrySetMembers, [7]],
        [templateKeyOne, [3]],
        [templateKeyDirect, [3]],
        [templateNegOnly, [3]],
        [templatePosOnly, [3]],
        [templateTwo, [3]],
        [templateNested, [3]],
        [capturedTableRoot, [3]],
        [inlinedLoopReturn, [5]],
        [inlinedThrowReturn, [5]],
        [mapValueLengths, [3]],
        [capturedToken, [3]],
        [alreadyDone, [3]],
        [lostStore, [3]],
        [lostStoreCall, [3]],
        [loadJoinedCall, [3]],
        [loadJoinedBranch, [3]],
        [optionalRegions, [3]],
        [arrayJoin, [3]],
        [floatRecordRoot, [3]],
        [floatOnlyRoot, [3]],
        [halfRecordRoot, [3]],
        [floatWithSetRoot, [3]],
        [plainWithSetRoot, [3]],
        [setsInMap, [5]],
        [setsFromChains, [5]],
        [storedResults, [3]],
        [chainInfoRoot, [4]],
        [usersRoot, [4]],
        [twoMapsIterate, [3]],
        [nodeOperands, [3]],
        [twoValueKinds, [3]],
        [unknownKeysFirst, [3]],
        [unknownKeysInline, [3]],
        [optionalKeys, [3]],
        [encodedKeys, [3]],
        [encodedKeysSmall, [3]],
        [mapEntriesSum, [3]],
        [mapParamEntries, [3]],
        [arrayReverse, [3]],
        [minLoop, [3]],
        [minFloat64, [3]],
        [int32Prefix, [3]],
        [int32Negative, [3]],
        [capturedBytesRead, [3]],
        [capturedWordsRead, [4]],
        [capturedWordsLength, [4]],
        [capturedBuilt, [4]],
        [absentKeyRoot, [4]],
        [absentKeyInline, [4]],
        [explicitFieldsRoot, [4]],
        [capturedListRead, [4]],
        [capturedMapSize, [4]],
        [flushRoot, [5]],
    ]
    const only = intrinsics.argv().find(a => a.startsWith('only:'))?.slice(5)
    for (const [fn, args] of attempts) {
        if (only && fn.name !== only) continue
        const expected = Number((fn as any)(...args))
        try {
            const natives: any = native.createNatives({ [fn.name]: fn })
            if (intrinsics.argv().includes('compile-only')) {
                console.log(`attempt ${fn.name}(${args.join(', ')}) compiled`)
                continue
            }
            const actual = Number(natives[fn.name](...args))
            if (actual === expected) console.log(`attempt ${fn.name}(${args.join(', ')}) ok = ${actual}`)
            else console.log(`attempt ${fn.name}(${args.join(', ')}) FAILED (miscompile): ${actual}, expected ${expected}`)
        } catch (e) {
            console.log(`attempt ${fn.name}(${args.join(', ')}) FAILED: ${(e as any)?.stack ?? String(e)}`)
        }
    }
}
