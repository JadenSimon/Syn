"use wrapped";

import * as intrinsics from './intrinsics'
import * as lowering from './lowering'
import { solvePlacements } from './placement-flow'
import { flattenRecords } from './records'
import {
    addGraphBlock, clearOperands, cloneLiterals, cloneRefs, copyNode, countIds, countLiterals,
    createConvert, createRecordParam, getArgConsts, getArgIds, getBlock, getDebugLabel, getLiteral,
    getRef, getTypeT, getTypeU, makeNode, pushRefs, setDebugLabel, setGraphBlocks, setLiteral, setRef,
    typeSlots,
} from './graph-node'

const Types = intrinsics.Types
const assert = intrinsics.assert

export interface GraphNode {
    op: string
    slots: Uint32Array
    epoch: number
}

export interface GraphBlock {
    id: number
    params: number[]
    bodyId: number
    bodyConst: number
    consumesEffectToken?: boolean // DO NOT USE THIS
}

export interface Graph {
    maxId: number
    nodes: Map<number, GraphNode>
    blocks: GraphBlock[]
    blockIndex: Map<number, GraphBlock>
    epoch: number
    debugLabels: Map<number, string>
    name?: string
}

export function isParam(nodes: Map<number, GraphNode>, id: number): boolean {
    return !!nodes.get(id) && nodes.get(id)!.op === 'param'
}

function nextEpoch(g: Graph): number {
    return ++g.epoch
}

function markVisited(n: GraphNode, epoch: number): boolean {
    if (n.epoch === epoch) return false
    assert(n.epoch < epoch, 'markVisited: epoch went backwards')
    n.epoch = epoch
    return true
}

function hasStructuredTail(g: Graph, id: number): boolean {
    while (id) {
        const n = g.nodes.get(id)
        if (!n) return false
        if (n.op !== 'after') {
            return n.op === 'select' || n.op === 'apply' || n.op === 'panic'
                || n.op === 'ret' || n.op === 'unreachable'
        }
        id = getRef(n, countIds(n) - 1)
    }
    return false
}

function tailOf(g: Graph, id: number): number {
    let n = g.nodes.get(id)
    while (n?.op === 'after') {
        id = getRef(n, countIds(n) - 1)
        n = g.nodes.get(id)
    }
    return id
}

function recordKeys(g: Graph, id: number): number[] | undefined {
    const n = g.nodes.get(tailOf(g, id))
    if (!n) return
    if (n.op === 'record') {
        const keys: number[] = []
        for (let i = 0; i < countLiterals(n); i += 2) keys.push(getLiteral(n, i))
        return keys
    }
    if (n.op === 'param' && countIds(n)) return Array.from(cloneLiterals(n, 1))
    if (n.op === 'select') return recordKeys(g, getRef(n, 1))
}

function detachRecordOrdering(g: Graph, tokenBlocks: Set<number>) {
    const owners = new Map<number, number>()
    for (const b of g.blocks) {
        for (const p of b.params) {
            const u = g.nodes.get(p)
            if (u && countIds(u)) owners.set(p, b.id)
        }
    }
    if (!owners.size) return
    const nils = new Map<number, number>()
    function detach(n: GraphNode, i: number) {
        const owner = owners.get(getRef(n, i))
        if (owner === undefined) return
        let nil = nils.get(owner)
        if (!nil) nils.set(owner, nil = createNode(g, 'nil-effect', [literal(owner)]))
        setRef(n, i, nil)
    }
    for (const n of [...g.nodes.values()]) {
        if (n.op === 'after') {
            for (let i = 0; i < countIds(n) - 1; i++) detach(n, i)
        } else if (n.op === 'load' || n.op === 'store' || n.op === 'call') {
            detach(n, 0)
        } else if (n.op === 'apply' && tokenBlocks.has(getRef(n, 0))) {
            detach(n, countIds(n) - 1)
        }
    }
}

function paramNode(): GraphNode {
    return makeNode('param', [], new Float64Array(0), Types.u64, Types.u64)
}

const BinaryOps = new Set<string>([
    'add', 'sub', 'mul', 'div', 'rem', 'or', 'and', 'xor', 'shl', 'shr', 'ushr', 'subsat',
])
const CompareOps = new Set<string>(['lt', 'le', 'gt', 'ge', 'eq', 'ne'])
const InverseCompare: Record<string, string> = {
    eq: 'ne', ne: 'eq', lt: 'ge', ge: 'lt', le: 'gt', gt: 'le',
}
const UnaryOps = new Set<string>(['neg', 'not'])
const PureOps = new Set<string>([
    'add', 'sub', 'mul', 'div', 'rem', 'or', 'and', 'xor', 'shl', 'shr', 'ushr', 'subsat',
    'lt', 'le', 'gt', 'ge', 'eq', 'ne', 'neg', 'not', 'select', 'convert', 'bitconvert',
    'syscall-target', 'local-target', 'indirect-target', 'call-context', 'pool-entry', 'void',
    'param', 'heap-handle', 'nil-effect', 'block', 'literal', 'get', 'record', 'unreachable'
])
const Commutative = new Set<string>(['add', 'mul', 'and', 'or', 'xor', 'ne', 'eq'])
const SwappedCmp: Record<string, string> = {
    lt: 'gt', gt: 'lt', le: 'ge', ge: 'le', eq: 'eq', ne: 'ne',
}

// TODO: move these to assembler
const SP = 31
const LR = 30
const XZR = 31

export interface LowerGraphOptions {
    target?: lowering.Target
    regBudget?: number
    debug?: boolean
    skipNormalized?: boolean
}

export interface LowerGraphResult {
    target: lowering.Target
    words: number[]
    bytes: number[]
    relocations: lowering.Relocation[]
    listing: string
}

// TODO:
// V1: (call, nil, p2, 0)
// = (select, p0, V1, (select, p1, (call, (call, nil, p3, 0), p2, 0), V1))
//
// can be turned into (select, (and, p0, (not, p1)), (call, nil, p2, 0), (call, (call, nil, p3, 0), p2, 0))

export function pureValues(g: Graph): Set<number> {
    const pure = new Set<number>()
    const checked = new Set<number>()
    pure.add(0)
    checked.add(0)
    function walk(id: number): boolean {
        if (checked.has(id)) return pure.has(id)
        checked.add(id)
        pure.add(id)
        const n = g.nodes.get(id)
        let ok = true
        if (n) {
            ok = PureOps.has(n.op)
            if (ok) for (const a of getArgIds(n)) if (!walk(a)) { ok = false; break }
        }
        if (!ok) pure.delete(id)
        return ok
    }
    for (const [id, n] of g.nodes) {
        walk(id)
        for (const a of getArgIds(n)) walk(a)
    }
    for (const b of g.blocks) {
        for (const p of b.params) walk(p)
        walk(b.bodyId)
    }
    return pure
}

function literalValue(u: GraphNode) {
    return getLiteral(u, 0)
}

const CompareEval: Record<string, (a: number, b: number) => boolean> = {
    lt: (a, b) => a < b, le: (a, b) => a <= b, gt: (a, b) => a > b,
    ge: (a, b) => a >= b, eq: (a, b) => a === b, ne: (a, b) => a !== b,
}

function scalarOperand(nodes: Map<number, GraphNode>, n: GraphNode, i: number): number | undefined {
    const id = getRef(n, i)
    if (!id) return getLiteral(n, i)
    const u = nodes.get(id)
    return u?.op === 'literal' ? literalValue(u) : undefined
}

function nodeKey(n: GraphNode, argIds = getArgIds(n), argConsts = getArgConsts(n)): string {
    const parts = [n.op]
    for (let i = 0; i < argIds.length; i++) {
        parts.push(argIds[i] ? `v${argIds[i]}` : `c${Object.is(argConsts[i], -0) ? '-0' : argConsts[i]}`)
    }
    const slots = typeSlots(n.op)
    if (slots) parts.push(`t${getTypeT(n)}`)
    if (slots > 1) parts.push(`t${getTypeU(n)}`)
    return parts.join(',')
}

function createNode(g: Graph, op: string, operands: (number | GraphNode)[], original?: GraphNode): number {
    const argIds = new Array(operands.length)
    const argConsts = new Float64Array(operands.length)
    for (let i = 0; i < argIds.length; i++) {
        const o = operands[i]
        argIds[i] = 0
        if (typeof o === 'number') {
            argIds[i] = o
            continue
        }
        assert(o.op === 'literal')
        argConsts[i] = literalValue(o)
    }
    const id = g.maxId++
    g.nodes.set(id, original ? copyNode(original, argIds, argConsts, op) : makeNode(op, argIds, argConsts))
    return id
}

function literal(v: number): GraphNode {
    return makeNode('literal', [0], new Float64Array([v]))
}

function forEachOperand(g: Graph, vid: number, fn: (n: GraphNode, id: number, idx: number) => number | undefined | void) {
    if (!vid) return vid
    const n = g.nodes.get(vid)
    if (!n) return vid
    const vals: [number, number][] = []
    for (let i = 0; i < countIds(n); i++) {
        const id = getRef(n, i)
        if (!id) continue
        if (const u = g.nodes.get(id)) {
            const r = fn(u, id, i)
            if (r && r !== id) {
                vals.push([i, r])
            }
        }
    }
    if (!vals.length) return vid
    const operands = new Array(countIds(n))
    for (let i = 0; i < countIds(n); i++) {
        if (vals.length && vals[0][0] === i) {
            const x = vals.shift()!
            operands[i] = x[1]
            continue
        }
        const id = getRef(n, i)
        if (!id) {
            operands[i] = literal(getLiteral(n, i))
        } else {
            operands[i] = id
        }
    }
    return createNode(g, n.op, operands, n)
}

function sweepBlocks(g: Graph, andNodes = true) {
    const seen = new Set<number>()
    seen.add(0)
    function visit(n: GraphNode, id: number) {
        if (andNodes || n.op === 'block') {
            if (seen.has(id)) return
            seen.add(id)
        }
        if (n.op === 'block') {
            const b = getBlock(g, id)!
            for (const p of b.params) seen.add(p)
            seen.add(b.bodyId)
            forEachOperand(g, b.bodyId, visit)
        } else {
            forEachOperand(g, id, visit)
        }
    }
    forEachOperand(g, g.blocks[0].bodyId, visit)
    if (seen.size === (andNodes ? g.nodes.size : g.blocks.length)) {
        return g
    }
    for (const k of g.nodes.keys()) {
        if (!seen.has(k)) {
            g.nodes.delete(k)
        }
    }
    const result = g.blocks.filter(x => seen.has(x.id))
    assert(result[0].id === 0)
    const out = { ...g }
    setGraphBlocks(out, result)
    return out
}

function operand(n: GraphNode, idx: number) {
    const id = getRef(n, idx)
    return id || literal(getLiteral(n, idx))
}

function transformVoids(g: Graph) {
    function producesVoid(id: number): boolean {
        if (!id) return false
        const n = g.nodes.get(id)
        if (!n) return false
        if (n.op === 'void') return true
        if (n.op === 'ret') return producesVoid(getRef(n, 0))
        if (n.op === 'after') return producesVoid(getRef(n, countIds(n)-1))
        if (n.op === 'select') return producesVoid(getRef(n, 1)) && producesVoid(getRef(n, 2))
        return false
    }
    function replaceVoids(id: number): number | GraphNode {
        const n = g.nodes.get(id)!
        if (n.op === 'void') return literal(0)
        if (n.op !== 'ret' && n.op !== 'after' && n.op !== 'select') return id
        const vals: [number, number | GraphNode][] = []
        const start = n.op === 'select' ? 1 : n.op === 'after' ? countIds(n)-1 : 0
        for (let i = start; i < countIds(n); i++) {
            const arg = getRef(n, i)
            if (!arg) continue
            const r = replaceVoids(arg)
            if (r !== arg) vals.push([i, r])
        }
        if (!vals.length) return id
        const operands: (number | GraphNode)[] = getArgIds(n).map((arg, i) => arg || literal(getLiteral(n, i)))
        for (const [i, r] of vals) operands[i] = r
        return createNode(g, n.op, operands, n)
    }
    const seen = new Set<number>()
    const replacements = new Map<number, number>()
    const rets = new Map<number, number[]>()
    let currentInline = 0
    function visit(n: GraphNode, id: number): number | undefined {
        if (const r = replacements.get(id)) {
            const value = visit(g.nodes.get(r)!, r) ?? r
            replacements.set(id, value)
            return value
        }
        if (seen.has(id)) return
        seen.add(id)
        if (n.op === 'block') {
            const b = getBlock(g, id)!
            b.bodyId = visit(g.nodes.get(b.bodyId)!, b.bodyId) ?? b.bodyId
            return
        }
        if (n.op === 'inlined') {
            const saveInlined = currentInline
            defer currentInline = saveInlined
            currentInline = id
            const r = forEachOperand(g, id, visit)
            if (r && r !== id) replacements.set(id, r)
            return r
        }
        if (n.op === 'ret') {
            let arr = rets.get(currentInline)
            if (!arr) rets.set(currentInline, arr = [])
            arr.push(id)
        }
        const r = forEachOperand(g, id, visit)
        if (r && r !== id) replacements.set(id, r)
        return r
    }
    const root = g.blocks[0].bodyId
    visit(g.nodes.get(root)!, root)
    for (const returns of rets.values()) {
        if (returns.every(producesVoid)) continue
        for (const id of returns) {
            const r = replaceVoids(id) as number
            if (r !== id) replacements.set(id, r)
        }
    }
    seen.clear()
    g.blocks[0].bodyId = visit(g.nodes.get(root)!, root) ?? root
    return g
}

function makeTailsUnique(g: Graph) {
    function cloneTail(id: number) {
        if (!id) return id
        const n = g.nodes.get(id)
        assert(n)
        const next = g.maxId++
        const argIds = cloneRefs(n)
        const argConsts = cloneLiterals(n)
        g.nodes.set(next, copyNode(n, argIds, argConsts))
        if (n.op === 'select') {
            for (let i = 1; i < countIds(n); i++) {
                const uid = getRef(n, i)
                if (!uid) continue
                const u = g.nodes.get(uid)
                assert(u)
                setRef(n, i, cloneTail(uid))
            }
        }
        return next
    }
    for (const b of g.blocks) {
        b.bodyId = cloneTail(b.bodyId)
    }
}

function replaceAll(g: Graph, id: number, replacements: Map<number, number>, cloneAll = false, epoch = 0): number {
    if (!id) return id
    if (const replacement = replacements.get(id)) {
        return replacement
    }
    const n = g.nodes.get(id)
    if (!n || isParam(g.nodes, id)) return id
    if (!epoch) epoch = nextEpoch(g)
    if (!markVisited(n, epoch)) return id
    const ids = getArgIds(n)
    const idReplacements: [idx: number, id: number][] = []
    for (let i = 0; i < ids.length; i++) {
        const next = replaceAll(g, ids[i], replacements, false, epoch)
        if (next !== ids[i]) { 
            idReplacements.push([i, next])
        }
    }
    if (!idReplacements.length && !cloneAll) return id
    const newIds = new Array(ids.length)
    for (let i = 0; i < ids.length; i++) {
        if (idReplacements[0]?.[0] === i) {
            newIds[i] = idReplacements.shift()![1]
        } else {
            newIds[i] = ids[i] || literal(getLiteral(n, i))
        }
    }
    const copy = createNode(g, n.op, newIds, n)
    replacements.set(id, copy)
    return copy
}

function replaceLiterals(g: Graph) {
    for (const [id, n] of g.nodes) {
        if (n.op === 'literal') continue
        for (let i = 0; i < countIds(n); i++) {
            const uid = getRef(n, i)
            if (!uid) continue
            const u = g.nodes.get(uid)!
            if (u.op !== 'literal') continue
            setLiteral(n, i, literalValue(u))
        }
    }
}

function outlineReturns(g: Graph): Graph {
    const blockId = createNode(g, 'block', [])
    let replaced = false
    let hasLiterals = false
    for (const [id, n] of g.nodes) {
        if (n.op !== 'ret') continue
        replaced = true
        const v = operand(n, 0)
        if (!getRef(n, 0)) hasLiterals = true
        g.nodes.set(id, g.nodes.get(createNode(g, 'apply', [blockId, v], n))!)
    }
    if (!replaced) {
        g.nodes.delete(blockId)
        return g
    }
    const parameter = createNode(g, 'param', [])
    const bodyId = createNode(g, 'ret', [parameter])
    addGraphBlock(g, { id: blockId, params: [parameter], bodyId, bodyConst: 0 })
    if (hasLiterals) replaceLiterals(g)
    return g
}

function replacePanics(g: Graph & { hasInlinedVals?: boolean }): typeof g {
    for (const [id, n] of g.nodes) {
        if (n.op === 'inlined') {
            g.hasInlinedVals = true
        }
        if (n.op !== 'panic') continue
        const unreachable = createNode(g, 'unreachable', [], n)
        if (!getRef(n, 0)) {
            g.nodes.set(id, g.nodes.get(unreachable)!)
            continue
        }
        const op = g.nodes.get(getRef(n, 0))!.op
        if (op !== 'param' && PureOps.has(op)) {
            g.nodes.set(id, g.nodes.get(unreachable)!)
            continue
        }
        const v = operand(n, 0)
        const a = createNode(g, 'after', [v, unreachable])
        g.nodes.set(id, g.nodes.get(a)!)
    }
    return g
}

function outlinePanics(g: Graph): Graph {
    const blockId = createNode(g, 'block', [])
    let replaced = false
    let hasLiterals = false
    for (const [id, n] of g.nodes) {
        if (n.op !== 'panic') continue
        replaced = true
        const v = operand(n, 0)
        if (!getRef(n, 0)) hasLiterals = true
        g.nodes.set(id, g.nodes.get(createNode(g, 'apply', [blockId, v], n))!)
    }
    if (!replaced) {
        g.nodes.delete(blockId)
        return g
    }
    const parameter = createNode(g, 'param', [])
    const bodyId = createNode(g, 'panic', [parameter])
    addGraphBlock(g, { id: blockId, params: [parameter], bodyId, bodyConst: 0 })
    if (hasLiterals) replaceLiterals(g)
    return g
}

function stripJoins(g: Graph): Graph {
    let hasJoin = false
    for (const [id, n] of g.nodes) {
        if (n.op !== 'join') continue
        hasJoin = true
        break
    }
    if (!hasJoin) return g

    const epoch = nextEpoch(g)
    const replacements = new Map<number, number>()
    const visit = (n: GraphNode, vid: number) => {
        if (!markVisited(n, epoch)) {
            if (const x = replacements.get(vid)) return x
            return
        }
        if (n.op === 'block') {
            const b = getBlock(g, vid)!
            b.bodyId = forEachOperand(g, b.bodyId, visit)
            return
        }
        if (n.op === 'join' && cloneRefs(n, 0, -1).every(x => !x || g.nodes.get(x)?.op === 'heap-handle')) {
            const x = forEachOperand(g, getRef(n, countIds(n)-1), visit)
            replacements.set(vid, x)
            return x
        }
        const x = forEachOperand(g, vid, visit)
        if (x !== vid) replacements.set(vid, x)
        return x
    }
    const rootBlock = g.blocks[0]
    rootBlock.bodyId = forEachOperand(g, rootBlock.bodyId, visit)
    return g
}


export function inlineBlocks(g: Graph) {
    makeTailsUnique(g)
    transformVoids(g)
    function reduceInlined() {
        const refs: number[] = []
        const jumped = new Set<number>()
        function findSite(root: number): number {
            refs.length = 0
            const seen = new Set<number>()
            function find(id: number): number {
                if (!id || seen.has(id)) return 0
                seen.add(id)
                const n = g.nodes.get(id)
                if (!n) return 0
                if (n.op === 'block') {
                    refs.push(id)
                    return 0
                }
                if (n.op === 'inlined') return id
                for (let i = countIds(n) - 1; i >= 0; i--) {
                    const found = find(getRef(n, i))
                    if (found) return found
                }
                return 0
            }
            return find(root)
        }

        function convert(block: GraphBlock, site: number) {
            const source = g.nodes.get(site)!
            const memo = new Map<number, boolean>()
            function reaches(id: number): boolean {
                if (id === site) return true
                if (!id) return false
                const known = memo.get(id)
                if (known !== undefined) return known
                const n = g.nodes.get(id)
                const out = !!n && n.op !== 'block' && getArgIds(n).some(arg => reaches(arg))
                memo.set(id, out)
                return out
            }

            let parent = 0
            let slot = 0
            let at = block.bodyId
            let body = at
            let bodyParent = parent
            let bodySlot = slot
            while (at !== site) {
                const n = g.nodes.get(at)!
                if (n.op === 'ret' || jumped.has(at)) {
                    body = at
                    bodyParent = parent
                    bodySlot = slot
                    break
                }
                let next = -1
                if (n.op === 'select') {
                    if (reaches(getRef(n, 0))) break
                    let arms = 0
                    for (let i = 1; i < countIds(n); i++) {
                        if (!reaches(getRef(n, i))) continue
                        arms++
                        next = i
                    }
                    if (arms > 1) {
                        body = at
                        bodyParent = parent
                        bodySlot = slot
                        break
                    }
                } else if (n.op === 'after') {
                    const last = countIds(n) - 1
                    let leading = false
                    for (let i = 0; i < last; i++) if (reaches(getRef(n, i))) leading = true
                    if (leading) break
                    next = last
                }
                if (next < 0) break
                parent = at
                slot = next
                at = getRef(n, next)
                if (n.op === 'select') {
                    body = at
                    bodyParent = parent
                    bodySlot = slot
                }
            }

            const jumps: number[] = []
            const walked = new Set<number>()
            function collect(id: number): void {
                if (!id || walked.has(id)) return
                walked.add(id)
                const n = g.nodes.get(id)
                if (!n) return
                assert(!jumped.has(id), `inlined ${site}: ret ${id} already exits another inlined value`)
                if (n.op === 'ret') jumps.push(id)
                else if (n.op === 'after') collect(getRef(n, countIds(n) - 1))
                else if (n.op === 'select') for (let i = 1; i < countIds(n); i++) collect(getRef(n, i))
                else if (n.op === 'apply') collect(getBlock(g, getRef(n, 0))?.bodyId ?? 0)
            }
            collect(getRef(source, 0))
            const shape = jumps.length ? recordKeys(g, getRef(g.nodes.get(jumps[0])!, 0)) : undefined

            const blockId = g.maxId++
            g.nodes.set(blockId, makeNode('block', [], new Float64Array(0)))
            for (const id of jumps) {
                const n = g.nodes.get(id)!
                jumped.add(id)
                g.nodes.set(id, makeNode('apply', [blockId, getRef(n, 0)], new Float64Array([0, getLiteral(n, 0)])))
            }
            if (bodyParent) {
                const p = g.nodes.get(bodyParent)!
                const argIds = cloneRefs(p)
                const argConsts = cloneLiterals(p)
                argIds[bodySlot] = getRef(source, 0)
                argConsts[bodySlot] = getLiteral(source, 0)
                g.nodes.set(bodyParent, copyNode(p, argIds, argConsts))
            } else {
                block.bodyId = getRef(source, 0)
                block.bodyConst = getLiteral(source, 0)
            }
            const param = shape ? createRecordParam(shape) : makeNode('param', [], new Float64Array(0))
            g.nodes.set(site, param)
            setDebugLabel(g, site, `inline${site}`)
            const continuation: GraphBlock = { id: blockId, params: [site], bodyId: body, bodyConst: 0 }
            addGraphBlock(g, continuation)
        }

        const queue: GraphBlock[] = [g.blocks[0]]
        const queued = new Set<number>([g.blocks[0].id])
        for (let i = 0; i < queue.length; i++) {
            const block = queue[i]
            for (let site = findSite(block.bodyId); site; site = findSite(block.bodyId)) {
                convert(block, site)
            }
            for (const ref of refs) {
                if (queued.has(ref) || !getBlock(g, ref)) continue
                queued.add(ref)
                queue.push(getBlock(g, ref)!)
            }
        }
    }
    g = replacePanics(g)
    if ((g as ReturnType<typeof replacePanics>).hasInlinedVals) {
        reduceInlined()
        ;(g as ReturnType<typeof replacePanics>).hasInlinedVals = false
    }
    return g
}

export function packageBlocksFINAL(g: Graph) {
    g = outlineReturns(g)
    g = outlinePanics(g)
    // g = stripJoins(g)
    const successors = new Map<number, Set<number>>()
    const preds = new Map<number, Set<number>>()
    const savedPreds = new Map<number, Set<number>>()
    const seenInBlock = new Map<number, Set<number>>()
    const depth = new Map<number, number>()
    function addTo(m: Map<number, Set<number>>, key: number, val: number) {
        let s = m.get(key)
        if (!s) m.set(key, s = new Set())
        s.add(val)
    }

    const ancestors = new Map<number, Set<number>>()
    function ancestorsOf(bid: number) {
        if (const m = ancestors.get(bid)) return m
        const r = new Set<number>()
        ancestors.set(bid, r)
        if (bid === 0) return r
        const l = [...preds.get(bid)!]
        while (const x = l.pop()) {
            r.add(x)
            for (const q of ancestorsOf(x)) {
                if (r.has(q)) continue
                l.push(q)
            }
        }
        return r
    }

    function uniqueLca(s: Set<number>): number {
        assert(s.size)
        if (s.has(0)) return 0
        if (s.size === 1) return s.values().next().value!
        const arr = [...s]
        const c = new Set<number>(ancestorsOf(arr[0]))
        c.add(arr[0])
        for (let i = 1; i < arr.length; i++) {
            const b = arr[i]
            const c2 = ancestorsOf(b)
            for (const x of c) {
                if (!c2.has(x) && x !== b) {
                    c.delete(x)
                }
            }
        }
        for (const x of c) {
            if (!c.has(x)) continue
            for (const a of ancestorsOf(x)) {
                c.delete(a)
            }
        }
        const r = uniqueLca(c)
        return r
    }
    function addAndCheck(m: Map<number, Set<number>>, key: number, val: number) {
        let s = m.get(key)
        if (!s) {
            m.set(key, s = new Set())
            s.add(val)
            return true
        }
        const q = s.size
        s.add(val)
        return s.size !== q
    }
    const pinned = new Map<number, number>()
    function isPlaceholder(n: GraphNode) {
        return n.op === 'param' || (n.op === 'nil-effect' && countLiterals(n) === 1)
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== 'param' && isPlaceholder(n)) pinned.set(id, getLiteral(n, 0))
    }
    function visitBlock(b: GraphBlock, blocksSeen: Set<number>) {
        for (const x of b.params) {
            pinned.set(x, b.id)
        }
        pinned.set(b.bodyId, b.id)
        function visit(id: number) {
            if (!id) return
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'block') {
                addTo(successors, b.id, id)
                addTo(preds, id, b.id)
                if (!blocksSeen.has(id)) {
                    blocksSeen.add(id)
                    visitBlock(getBlock(g, id)!, blocksSeen)
                }
                return
            }
            if (!countIds(n) && !isPlaceholder(n)) return
            const didAdd = addAndCheck(seenInBlock, id, b.id)
            if (!didAdd) return
            for (let i = 0; i < countIds(n); i++) {
                visit(getRef(n, i))
            }
        }
        visit(b.bodyId)
    }
    visitBlock(g.blocks[0], new Set())

    for (const [k, v] of preds) {
        savedPreds.set(k, new Set(v))
    }

    const seen = new Set<number>()
    const active = new Set<number>()
    function visit(bid: number) {
        if (seen.has(bid)) return
        seen.add(bid)
        active.add(bid)
        for (const to of successors.get(bid) ?? []) {
            if (active.has(to)) {
                preds.get(to)?.delete(bid)
                continue
            }
            visit(to)
        }
        active.delete(bid)
    }
    for (const [k, v] of preds) {
        visit(k)
    }
    function depthOf(b: number) {
        if (const d = depth.get(b)) return d
        if (b === 0) return 0
        const p = preds.get(b)
        assert(p)
        let r = 0
        for (const x of p) {
            r = Math.max(depthOf(x), r)
        }
        r += 1
        depth.set(b, r)
        return r
    }
    const firstPossibleUseCache = new Map<number, number>()
    function firstPossibleUse(vid: number) {
        if (!vid) return -1
        if (const x = pinned.get(vid)) return x
        const n = g.nodes.get(vid)
        if (!n || countIds(n) === 0) return -1
        if (n.op === 'block') return -1
        if (const x = firstPossibleUseCache.get(vid)) return x
        let c = -1
        for (let i = 0; i < countIds(n); i++) {
            const q = firstPossibleUse(getRef(n, i))
            if (c === q || q === -1) continue
            if (c === -1 || !ancestorsOf(c).has(q)) {
                c = q
            }
        }
        firstPossibleUseCache.set(vid, c)
        return c
    }
    function isCapture(from: number, vid: number) {
        if (!vid) return false
        if (const x = pinned.get(vid)) return x !== from
        const n = g.nodes.get(vid)
        if (!n || n.op === 'block') return false
        for (let i = 0; i < countIds(n); i++) {
            if (isCapture(from, getRef(n, i))) return true
        }
        return false
    }
    const blocksForPlacement = new Map<number, number[]>()
    function placeBlock(bid: number) {
        if (!blocksForPlacement.has(bid)) {
            blocksForPlacement.set(bid, [])
        }
        return bid
    }
    const placements = new Map<number, number[]>()
    function addPlacements(vid: number, s: Set<number>) {
        if (const b = pinned.get(vid)) {
            placements.set(vid, [placeBlock(b)])
            return
        }

        const m = firstPossibleUse(vid)
        if (m === -1) return
        const l = uniqueLca(s)
        if (m === l) {
            placements.set(vid, [placeBlock(m)])
            return
        }
        const c = new Set(ancestorsOf(l))
        c.add(l)
        for (const x of ancestorsOf(m)) {
            c.delete(x)
        }
        const res = [...c]
        res.sort((a, b) => depthOf(a) - depthOf(b))
        // sigh... what am i doing
        outer: for (let i = res.length-1; i > 0; i--) {
            const a = ancestorsOf(res[i])
            for (let j = 0; j < i; j++) {
                if (!a.has(res[j])) {
                    res.length = i
                    continue outer
                }
            }
        }
        assert(res.includes(m))
        placements.set(vid, res.map(placeBlock))
    }
    function pinBlock(bid: number) {
        function pinTail(vid: number, tail = true) {
            if (!vid) return
            if (const u = g.nodes.get(vid)) {
                if (u.op === 'param') return

                if (u.op === 'apply') {
                    pinned.set(vid, bid)
                    for (let i = 1; i < countIds(u); i++) {
                        pinTail(getRef(u, i), false)
                    }
                } else if (u.op === 'select') {
                    if (!tail) return
                    pinned.set(vid, bid)
                    for (let i = 1; i < countIds(u); i++) {
                        pinTail(getRef(u, i), true)
                    }
                } else if (u.op === 'ret') {
                    pinned.set(vid, bid)
                }
            }
        }
        pinTail(getBlock(g, bid)!.bodyId)
    }
    for (const b of g.blocks) {
        pinBlock(b.id)
    }
    for (const [k, v] of seenInBlock) {
        const n = g.nodes.get(k)
        if (n && isPlaceholder(n)) {
            addPlacements(k, v)
            continue
        }
        if (!n || !countIds(n)) continue
        addPlacements(k, v)
    }

    for (const [k] of blocksForPlacement) {
        const s = successors.get(k)
        if (!s) continue
        blocksForPlacement.set(k, [...s].filter(x => blocksForPlacement.has(x)))
    }
    // console.log(blocksForPlacement)
    // for (const [k, v] of placements) {
    //     console.log(k, v)
    // }
    // console.log(dumpGraph(g))
    const solved = solvePlacements(g, placements, blocksForPlacement)
    for (const [vid, placed] of solved.placements) {
        const first = firstPossibleUse(vid)
        const seen = new Set<number>()
        function populate(bid: number) {
            if (bid === first || seen.has(bid)) return
            seen.add(bid)
            if (!solved.parameters.get(bid)?.has(vid)) {
                addTo(solved.parameters, bid, vid)
                solved.parameterCount++
            }
            for (const pred of savedPreds.get(bid) ?? []) populate(pred)
        }
        const b = seenInBlock.get(vid)
        assert(b)
        for (const bid of b) {
            if (bid === placed) continue
            populate(bid)
        }
    }
    if (solved.parameters.has(0)) {
        console.log(solved)
        console.log(dumpBlockGraph(g))
        console.log(dumpGraph(g))
        console.log('placements', [...solved.parameters.get(0)!].map(x => solved.placements.get(x)))
        throw `found block 0 capturing a value: ${[...solved.parameters.get(0)!].join(', ')}`
    }
    const order: number[] = []
    {
        const stack = [0]
        const seen = new Set<number>()
        while (const x = stack.shift()) {
            if (solved.parameters.has(x)) order.push(x)
            const s = successors.get(x)
            if (!s) continue
            for (const y of s) {
                if (seen.has(y)) continue
                seen.add(y)
                stack.push(y)
            }
        }
    }

    const valToParam = new Map<number, Map<number, number>>()
    function updateApplies(from: number, to: number, captures: Set<number>) {
        const epoch = nextEpoch(g)
        const mapping = valToParam.get(from)
        const stack = [getBlock(g, from)!.bodyId]
        while (const x = stack.pop()) {
            if (const u = g.nodes.get(x)) {
                if (!markVisited(u, epoch)) continue
                for (let i = 0; i < countIds(u); i++) {
                    const z = getRef(u, i)
                    if (!z) continue
                    if (mapping?.has(z)) {
                        const next = mapping!.get(z)!
                        setRef(u, i, next)
                        stack.push(next)
                        continue
                    }
                    stack.push(z)
                }

                if (u.op === 'apply') {
                    if (getRef(u, 0) !== to) continue
                    const added: number[] = []
                    for (const s of captures) {
                        const t = mapping?.get(s) ?? s
                        stack.push(t)
                        added.push(t)
                    }
                    pushRefs(u, added)
                }
            }
        }
    }
    for (const bid of order) {
        const b = getBlock(g, bid)!
        const vals = solved.parameters.get(bid)!
        const mapping = new Map<number, number>()
        for (const vid of vals) {
            const id = g.maxId++
            mapping.set(vid, id)
            b.params.push(id)
            g.nodes.set(id, paramNode())
        }
        valToParam.set(bid, mapping)
        const p = savedPreds.get(bid)
        assert(p)
        for (const x of p) {
            updateApplies(x, bid, vals)
        }
        const epoch = nextEpoch(g)
        const stack: number[] = [b.bodyId]
        while (const x = stack.pop()) {
            if (const u = g.nodes.get(x)) {
                if (!markVisited(u, epoch)) continue
                for (let i = 0; i < countIds(u); i++) {
                    const id = getRef(u, i)
                    if (!id) continue
                    if (vals.has(id)) {
                        setRef(u, i, mapping.get(id)!)
                        continue
                    }
                    stack.push(id)
                }
            }
        }
    }
    for (const n of g.nodes.values()) {
        if (n.op !== 'nil-effect' || !countIds(n)) continue
        clearOperands(n)
    }
    return g
}

const optimizeTimers = intrinsics.argv().includes('optimize-stats') ? new Map<string, number>() : undefined

export function printOptimizeStats(): void {
    if (!optimizeTimers) return
    for (const [name, ms] of [...optimizeTimers].sort((a, b) => b[1] - a[1])) console.log('optimize step', ms.toFixed(1), name)
}

function optimizeValueGraph(g: Graph) {
    const optimizeStart = performance.now()
    const usedBy = new Map<number, number[]>()
    const demands = new Map<number, Set<number>>()
    const dependents = new Map<number, Set<number>>()
    const dependencies = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) {
            let arr = usedBy.get(to)
            if (!arr) usedBy.set(to, arr = [])
            arr.push(from)
            let d = demands.get(from)
            if (!d) demands.set(from, d = new Set())
            d.add(to)
        }
        let set = dependencies.get(from)
        if (!set) dependencies.set(from, set = new Set())
        set.add(to)
        let d = dependents.get(to)
        if (!d) dependents.set(to, d = new Set())
        d.add(from)
    }

    function getGraphBlock(id: number) {
        const b = getBlock(g, id)
        assert(b)
        return b
    }

    const byOp = new Map<number, Map<string, number[]>>()
    function indexValue(id: number, op: string, blockId: number) {
        let m = byOp.get(blockId)
        if (!m) byOp.set(blockId, m = new Map())
        let arr = m.get(op)
        if (!arr) m.set(op, arr = [])
        arr.push(id)
    }

    function findValues(blockId: number, op: string) {
        if (const m = byOp.get(blockId)) {
            return m.get(op)
        }
    }

    function findValuesFrom(blockId: number, op: string, target: number) {
        if (const arr = findValues(blockId, op)) {
            return arr.filter(x => reaches(target, x))
        }
    }

    function reaches(from: number, to: number) {
        const deps = dependencies.get(from)
        if (!deps) return false
        for (const u of deps) {
            if (u === to) return true
            if (reaches(u, to)) return true
        }
        return false
    }

    function reachesAnyOf(from: number, to: Set<number>) {
        const deps = dependencies.get(from)
        if (!deps) return false
        for (const u of deps) {
            if (to.has(u)) return true
            if (reachesAnyOf(u, to)) return true
        }
        return false
    }

    function collectSubgraph(from: number, dst: Set<number> = new Set()) {
        const deps = dependencies.get(from)
        dst.add(from)
        if (!deps) return dst
        for (const u of deps) {
            if (dst.has(u)) continue
            collectSubgraph(u, dst)
        }
        return dst
    }

    function collectSubgraphOf(iter: Iterable<number>) {
        const dst = new Set<number>()
        for (const x of iter) collectSubgraph(x, dst)
        return dst
    }

    function visitBlock(b: GraphBlock) {
        if (visited.has(b.id)) return
        reachableBlocks.add(b)
        visited.set(b.id, visited.size)
        blockStack.push(b)
        defer blockStack.pop()
        visit(b.bodyId, false)
    }

    const successors = new Map<number, Set<number>>()
    const preds = new Map<number, Set<number>>()
    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reachableBlocks = new Set<GraphBlock>()
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        const n = g.nodes.get(id)!
        if (n.op === 'nil-effect' || n.op === 'void') return
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (visited.has(id)) return
        visited.set(id, visited.size)

        const currentBlockId = blockStack[blockStack.length-1].id
        if (n.op === 'param') {
            indexValue(id, 'param', currentBlockId)
            return
        }

        indexValue(id, n.op, currentBlockId)
        if (!countIds(n)) return

        stack.push(id)
        defer stack.pop()

        if (n.op === 'after') {
            const last = countIds(n) - 1
            for (let i = 0; i < last; i++) visit(getRef(n, i), false)
            visit(getRef(n, last), true)
            return
        }
        if (n.op === 'call' || n.op === 'store' || n.op === 'load') {
            visit(getRef(n, 0), false)
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            return
        }
        if (n.op === 'apply') {
            let s = successors.get(currentBlockId)
            if (!s) successors.set(currentBlockId, s = new Set())
            s.add(getRef(n, 0))
            s = preds.get(getRef(n, 0))
            if (!s) preds.set(getRef(n, 0), s = new Set())
            s.add(currentBlockId)
            const b = getGraphBlock(getRef(n, 0))
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            visitBlock(b)
            return
        }
        for (const x of getArgIds(n)) {
            visit(x, true)
        }
    }

    function indexGraph() {
        usedBy.clear()
        demands.clear()
        dependents.clear()
        dependencies.clear()
        byOp.clear()
        successors.clear()
        preds.clear()
        visited.clear()
        blockStack.length = 0
        reachableBlocks.clear()
        visited.set(0, 0)
        blockStack.push(g.blocks[0])
        reachableBlocks.add(g.blocks[0])
        const bodyId = g.blocks[0].bodyId
        if (bodyId) visit(bodyId, false)
    }
    indexGraph()

    function insert(n: GraphNode): number {
        const id = g.maxId++
        g.nodes.set(id, n)
        return id
    }

    function addNode(op: string, argIds: number[], argConsts: Float64Array, from?: GraphNode): number {
        return insert(from ? copyNode(from, argIds, argConsts, op) : makeNode(op, argIds, argConsts))
    }

    function addParam(): number {
        const id = g.maxId++
        g.nodes.set(id, paramNode())
        return id
    }

    function addBlock(params: number[], body: number): number {
        const id = addNode('block', [], new Float64Array())
        addGraphBlock(g, { id, bodyConst: 0, bodyId: body, params })
        return id
    }

    function removeBlock(b: GraphBlock) {
        cleanBlockData(b)
        reachableBlocks.delete(b)
    }

    function cleanBlockData(b: GraphBlock) {
        if (const s = successors.get(b.id)) {
            successors.delete(b.id)
            for (const x of s) {
                if (const p = preds.get(x)) {
                    p.delete(b.id)
                }
            }
        }

        if (const m = byOp.get(b.id)) {
            byOp.delete(b.id)
            for (const arr of m.values()) {
                for (const id of arr) cleanEdges(id)
            }
            function cleanEdges(id: number) {
                if (const arr = dependencies.get(id)) {
                    dependencies.delete(id)
                    for (const dependency of arr) {
                        const users = dependents.get(dependency)
                        users?.delete(id)
                        if (users?.size === 0) dependents.delete(dependency)
                    }
                }
                if (const arr = demands.get(id)) {
                    demands.delete(id)
                    for (const demand of arr) {
                        const users = usedBy.get(demand)
                        if (!users) continue
                        const remaining = users.filter(x => x !== id)
                        if (remaining.length) usedBy.set(demand, remaining)
                        else usedBy.delete(demand)
                    }
                }
                visited.delete(id)
            }
        }
    }

    const versions = new Map<number, number>()
    const passVersions = new Map<(b: GraphBlock) => unknown, Map<number, number>>()
    function touch(b: GraphBlock) {
        versions.set(b.id, (versions.get(b.id) ?? 0) + 1)
    }

    function time(name: string, dur: number) {
        optimizeTimers!.set(name, (optimizeTimers!.get(name) ?? 0) + dur)
    }
    function step(pass: (b: GraphBlock) => unknown, b: GraphBlock): boolean {
        if (!optimizeTimers) return runStep(pass, b)
        const s = performance.now()
        const changed = runStep(pass, b)
        time(pass.name, performance.now() - s)
        return changed
    }
    function runStep(pass: (b: GraphBlock) => unknown, b: GraphBlock): boolean {
        if (exempt.has(pass)) {
            return !!pass(b)
        }
        let seen = passVersions.get(pass)
        if (!seen) passVersions.set(pass, seen = new Map())
        if (seen.get(b.id) === (versions.get(b.id) ?? 0)) return false
        const changed = !!pass(b)
        seen.set(b.id, versions.get(b.id) ?? 0)
        return changed
    }

    function revisitBlock(b: GraphBlock) {
        touch(b)
        cleanBlockData(b)
        visited.delete(b.id)
        visitBlock(b)
    }

    function replaceAll(id: number, replacements: Map<number, number>, cloneAll = false, epoch = 0): number {
        if (!id) return id
        if (const replacement = replacements.get(id)) {
            return replacement
        }
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id)) return id
        if (!epoch) epoch = nextEpoch(g)
        if (!markVisited(n, epoch)) return id
        const ids = getArgIds(n)
        const idReplacements: [idx: number, id: number][] = []
        for (let i = 0; i < ids.length; i++) {
            const next = replaceAll(ids[i], replacements, false, epoch)
            if (next !== ids[i]) { 
                idReplacements.push([i, next])
            }
        }
        if (!idReplacements.length && !cloneAll) return id
        const newIds = new Array(ids.length)
        for (let i = 0; i < ids.length; i++) {
            if (idReplacements[0]?.[0] === i) {
                newIds[i] = idReplacements.shift()![1]
            } else {
                newIds[i] = ids[i]
            }
        }
        const copy = addNode(n.op, newIds, cloneLiterals(n), n)
        replacements.set(id, copy)
        return copy
    }

    function findInboundApplies(target: GraphBlock) {
        const res: [blockId: number, valId: number][] = []
        function visit(b: GraphBlock) {
            const applies = findValues(b.id, 'apply')!
            for (const u of applies) {
                const n = g.nodes.get(u)!
                const t = getRef(n, 0)
                if (t !== target.id) continue
                res.push([b.id, u])
            }
        }
        const x = preds.get(target.id)
        if (!x) return res
        for (const k of x) {
            visit(getGraphBlock(k))
        }
        return res
    }

    function skipAfter(id: number) {
        while (id) {
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'after') {
                id = getRef(n, countIds(n)-1)
                continue
            }
            return id
        }
        return
    }

    function simplifySelect(target: GraphBlock) {
        const loops = (id: number) => {
            const n = g.nodes.get(skipAfter(id) ?? 0)
            return n?.op === 'apply' && getRef(n, 0) === target.id
        }
        const diverges = (id: number) => isUnreachable(skipAfter(id) ?? 0)
        const r = new Map<number, number>()
        for (const id of findValues(target.id, 'select') ?? []) {
            const n = g.nodes.get(id)!
            if (diverges(getRef(n, 2))) {
                const x = createNode(g, 'after', [getRef(n, 0), operand(n, 1)])
                r.set(id, x)
                continue
            }
            if (diverges(getRef(n, 1))) {
                const x = createNode(g, 'after', [getRef(n, 0), operand(n, 2)])
                r.set(id, x)
                continue
            }
            if (countIds(n) !== 3 || loops(getRef(n, 1)) || !loops(getRef(n, 2))) continue
            const cond = g.nodes.get(getRef(n, 0))
            if (!cond || !CompareOps.has(cond.op)) continue
            const inverted = addNode(InverseCompare[cond.op], cloneRefs(cond), cloneLiterals(cond), cond)
            r.set(id, addNode('select', [inverted, getRef(n, 2), getRef(n, 1)],
                Float64Array.from([0, getLiteral(n, 2), getLiteral(n, 1)]), n))
        }
        if (!r.size) return false
        target.bodyId = replaceAll(target.bodyId, r)
        revisitBlock(target)
        simplifySelect(target)
        return true
    }

    function deduplicateValues(target: GraphBlock) {
        const representatives = new Map<string, number>()
        const canonical = new Map<number, number>()
        let changed = false
        function visit(id: number): number {
            if (!id) return 0
            const known = canonical.get(id)
            if (known !== undefined) return known
            const n = g.nodes.get(id)
            if (!n || n.op === 'block' || isParam(g.nodes, id)) {
                canonical.set(id, id)
                return id
            }
            const argIds = getArgIds(n).map(a => visit(a))
            if (n.op === 'select' && argIds[1] && argIds[1] === argIds[2]) {
                canonical.set(id, argIds[1])
                changed = true
                return argIds[1]
            }
            const key = nodeKey(n, argIds)
            let rep = representatives.get(key)
            if (rep === undefined) {
                rep = argIds.every((a, i) => a === getRef(n, i)) ? id : addNode(n.op, argIds, cloneLiterals(n), n)
                representatives.set(key, rep)
            }
            if (rep !== id) changed = true
            canonical.set(id, rep)
            return rep
        }
        const bodyId = visit(target.bodyId)
        if (!changed) return false
        target.bodyId = bodyId
        revisitBlock(target)
        return true
    }

    function interchangeSelects(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return false
        if ((findValues(target.id, 'select')?.length ?? 0) < 2) return false
        const loops = (id: number) => {
            const n = g.nodes.get(skipAfter(id) ?? 0)
            return n?.op === 'apply' && getRef(n, 0) === target.id
        }
        function collect(id: number, into: Set<number>): Set<number> {
            const n = id ? g.nodes.get(id) : undefined
            if (!n || into.has(id) || n.op === 'param' || isArgless(n)) return into
            into.add(id)
            for (const x of getArgIds(n)) collect(x, into)
            return into
        }
        const outer = g.nodes.get(target.bodyId)
        if (!outer || outer.op !== 'select' || countIds(outer) !== 3) return false
        for (const a of [1, 2]) {
            const inner = g.nodes.get(getRef(outer, a))
            if (!inner || inner.op !== 'select' || countIds(inner) !== 3) continue
            const b = loops(getRef(inner, 1)) ? 1 : loops(getRef(inner, 2)) ? 2 : 0
            if (!b || loops(getRef(inner, 3 - b)) || loops(getRef(outer, 3 - a))) continue
            const c1 = g.nodes.get(getRef(outer, 0))
            const c2 = g.nodes.get(getRef(inner, 0))
            if (!c1 || !c2 || !CompareOps.has(c1.op) || !CompareOps.has(c2.op)) continue
            const guarded = collect(getRef(outer, 0), new Set())
            let extra = 0
            let speculatable = true
            for (const id of collect(getRef(inner, 0), new Set())) {
                if (guarded.has(id)) continue
                const n = g.nodes.get(id)!
                extra++
                if (!PureOps.has(n.op) && !(n.op === 'load' && g.nodes.get(getRef(n, 0))?.op === 'nil-effect')) {
                    speculatable = false
                    break
                }
            }
            if (!speculatable || extra > 3) continue
            const guard = a === 1 ? getRef(outer, 0) : addNode(InverseCompare[c1.op], cloneRefs(c1), cloneLiterals(c1), c1)
            const test = b === 1 ? getRef(inner, 0) : addNode(InverseCompare[c2.op], cloneRefs(c2), cloneLiterals(c2), c2)
            const both = addNode('and', [guard, test], new Float64Array(2), c2)
            const rest = addNode('select', [guard, getRef(inner, 3 - b), getRef(outer, 3 - a)], new Float64Array(3), inner)
            target.bodyId = addNode('select', [both, getRef(inner, b), rest], new Float64Array(3), outer)
            revisitBlock(target)
            return true
        }
        return false
    }

    const debug = intrinsics.argv().includes('debug') // TODO: intrinsics.assert could have this (but it needs to be derived/configurable)
    const keyBits = 25
    const maxValId = 2**keyBits
    function keyOfPair(a: number, b: number, skipsort?: boolean) {
        if (debug) {
            assert(a >= 0 && a < maxValId)
            assert(b >= 0 && b < maxValId)
        }
        if (!skipsort && a > b) {
            let tmp = a
            a = b
            b = tmp
        }
        return (a << keyBits) + b
    }

    const precedesCache = new Map<number, boolean>()
    function precedes(a: number, b: number, checkedFirst?: boolean): boolean {
        if (a >= b) return false
        const nb = g.nodes.get(b)!
        const lb = countIds(nb)
        if (!lb) return false

        if (!checkedFirst) {
            const na = g.nodes.get(a)!
            if (!countIds(na)) return true
        }

        const k = keyOfPair(a, b, true)
        if (const v = precedesCache.get(k)) return v

        let result = false
        for (let i = 0; i < lb; i++) {
            const q = getRef(nb, i)
            if (precedes(a, q, true)) {
                result = true
                break
            }
        }

        precedesCache.set(k, result)
        return result
    }

    function isUnreachable(vid: number) {
        return vid === _unreachable || g.nodes.get(vid)?.op === 'unreachable'
    }

    let _unreachable: number | undefined
    function unreachable(original?: GraphNode) {
        // TODO: use `original` but reserve id space for primitives. or some other strategy...
        //if (original) return createNode(g, 'unreachable', [], original)
        initPrimitives()
        return _unreachable!
    }

    let _nil: number | undefined
    function nil(original?: GraphNode) {
        //if (original) return createNode(g, 'nil-effect', [], original)
        initPrimitives()
        return _nil!
    }

    let _void: number | undefined
    function Void(original?: GraphNode) {
        //if (original) return createNode(g, 'void', [], original)
        initPrimitives()
        return _void!
    }

    function initPrimitives() {
        if (_nil !== undefined) return
        for (const [k, v] of g.nodes) {
            switch (v.op) {
                case 'void':
                    _void = k
                case 'nil-effect':
                    _nil = k
                case 'unreachable':
                    _unreachable = k
            }
        }
        _nil ??= createNode(g, 'nil-effect', [])
        _void ??= createNode(g, 'void', [])
        _unreachable ??= createNode(g, 'unreachable', [])
    }

    function effectsJoin(values: number[], into?: number) {
        if (const u = values.find(x => isUnreachable(x))) {
            return u
        }
        const pruned = values.filter(x => !isNilOrVoid(x))
        if (!pruned.length) return into ?? nil()
        if (pruned.length === 1) {
            const v = pruned[0]
            if (!into) return v
            return precedes(v, into) ? into : createNode(g, 'after', [v, into])
        }
        if (!into) {
            pruned.push(Void())
            return createNode(g, 'after', pruned)
        }
        const rem = pruned.filter(x => !precedes(x, into))
        if (!rem.length) return into
        rem.push(into)
        return createNode(g, 'after', rem)
    }

    function simplifyOrdering(
        vid: number,
        unordered = new Set<number>(),
        from?: GraphNode,
    ): number | undefined {
        if (!vid || unordered.has(vid)) return
        const u = g.nodes.get(vid)
        if (!u) return
        if (u.op === 'param') return vid
        if (u.op === 'nil-effect') return vid
        if (u.op === 'unreachable') return vid
        if (u.op === 'ret' || u.op === 'panic') {
            return unreachable(u)
        }
        if (u.op === 'apply') {
            // `apply` is assumed to already be in tail position by this point
            return unreachable(u)
        }
        if (u.op === 'select') {
            let changed = false
            const arr: number[] = []
            for (let i = 1; i < countIds(u); i++) {
                const q = simplifyOrdering(getRef(u, i), unordered, from)
                if (q !== getRef(u, i)) changed = true
                arr.push(q ?? nil())
            }
            if (!changed) return vid
            if (arr.every(x => x === arr[0])) {
                return g.nodes.get(arr[0])?.op === 'nil-effect' ? undefined : arr[0]
            }
            return createNode(g, 'select', [getRef(u, 0), ...arr], u)
        }
        if (u.op === 'after') {
            const end = countIds(u)-1
            const r = simplifyOrdering(getRef(u, end), unordered, from)
            // if (r && (!isUnordered(r) || isParam(g.nodes, r))) {
            //     return vid
            // }
            if (countIds(u) === 2) {
                return simplifyOrdering(getRef(u, 0), unordered, from)
            }
            assert(countIds(u) > 1)
            let changed = r !== getRef(u, end)
            const arr: number[] = []
            for (let i = 0; i < end; i++) {
                const q = simplifyOrdering(getRef(u, i), unordered, u)
                if (q !== getRef(u, i)) changed = true
                if (!q) continue
                if (isUnreachable(q)) return q
                arr.push(q)
            }
            if (!changed) return vid
            return effectsJoin(arr, r)
        }
        if (u.op === 'call' || u.op === 'load' || u.op === 'store') {
            if (u.op === 'load' && (from?.op === 'load' || from?.op === 'after')) {
                return simplifyOrdering(getRef(u, 0), unordered, from)
            }
            return vid
        }
        if (isUnordered(vid)) return
        return vid
    }

    function reduceOrdering(target: GraphBlock, unordered?: Set<number>) {
        const seen = new Set<number>()
        const replacements = new Map<number, number>()
        const visit = (n: GraphNode, vid: number) => {
            if (seen.has(vid)) return
            seen.add(vid)
            if (n.op === 'load')
            forEachOperand(g, vid, visit)
        }
        forEachOperand(g, target.bodyId, visit)
    }

    function isNilOrVoid(vid?: number) {
        if (!vid) return true
        if (vid === _void || vid === _nil) return true
        const op = g.nodes.get(vid)?.op
        return op === 'nil-effect' || op === 'void'
    }

    function reduceBlockOrdering(target: GraphBlock, unordered?: Set<number>): boolean {
        let changed = false
        const epoch = nextEpoch(g)
        const replacements = new Map<number, number>()
        function visit(id: number): void {
            if (!id) return
            const n = g.nodes.get(id)
            if (!n || !markVisited(n, epoch)) return
            for (let i = 0; i < countIds(n); i++) visit(getRef(n, i))

            if (n.op !== 'after' && n.op !== 'call' && n.op !== 'load' && n.op !== 'store') return
            const end = n.op === 'after' ? countIds(n) - 1 : 1
            let argIds: number[] | undefined
            let argConsts: Float64Array | undefined
            for (let i = 0; i < end; i++) {
                const q = replacements.get(getRef(n, i)) ?? getRef(n, i)
                const ordering = simplifyOrdering(q, unordered, n)
                if (ordering === q || (isNilOrVoid(ordering) && isNilOrVoid(q))) {
                    continue
                }
                if (!argIds) argIds = cloneRefs(n)
                if (!argConsts) argConsts = cloneLiterals(n)
                argIds[i] = ordering ?? createNode(g, 'nil-effect', [])
                argConsts[i] = 0
            }
            const orderings = (argIds ?? getArgIds(n)).slice(0, end)
            if (n.op === 'after' && getRef(n, end) && orderings.every(isNilOrVoid)) {
                replacements.set(id, replacements.get(getRef(n, end)) ?? getRef(n, end))
                return
            }
            if (!argIds || !argConsts) return
            for (let i = end; i < countIds(n); i++) {
                const q = argIds[i]
                if (q) argIds[i] = replacements.get(q) ?? q
            }
            g.nodes.set(id, copyNode(n, argIds, argConsts))
            changed = true
        }
        visit(target.bodyId)
        if (!changed && !replacements.size) return false
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    // finds values that never differ across applications and moves them to a pred
    function hoistInvariants(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = g.nodes.get(t)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const filtered = inbound.filter(x => {
            if (x[0] === target.id) return false
            return true
        })
        if (filtered.length !== 1) return
        const pred = filtered[0]
        const self = inbound.filter(x => x[0] === target.id)
        if (!self.length) return

        const inboundArgs = target.params.map((p, i) => {
            const arr: [blockId: number, val: number, isConst: boolean][] = []
            for (const [otherId, app] of inbound) {
                const n = g.nodes.get(app)!
                const v = getRef(n, i+1)
                if (!v) {
                    arr.push([otherId, getLiteral(n, i+1), true])
                } else {
                    arr.push([otherId, v, false])
                }
            }
            return arr
        })

        const obvious = inboundArgs.map((arr, i) => {
            for (const el of arr) {
                if (el[2]) continue

                if (el[0] === target.id) {
                    if (target.params[i] !== el[1]) return false
                } else {
                    const b = getBlock(g, el[0])!
                    if (!b.params.includes(el[1])) return false
                }
            }
            return true
        }).map((x, i) => x ? i : -1).filter(x => x !== -1)

        if (!obvious.length) return

        const work = obvious.map(x => target.params[x])
        const invariants = new Set<number>(obvious.map(x => target.params[x]))
        const seen = new Set<number>(target.params)
        const writes = !!findValues(target.id, 'store')?.length || !!findValues(target.id, 'call')?.length
        function isInvariant(id: number): boolean {
            if (!id) return true
            if (invariants.has(id)) return true
            if (seen.has(id)) return false
            seen.add(id)
            const n = g.nodes.get(id)!
            if (n.op === 'apply') return false
            if (n.op === 'ret') return false
            if (n.op === 'select') return false
            if (n.op === 'after' || n.op === 'store' || n.op === 'call') return false
            if (n.op === 'load') {
                if (writes) return false
                if (!isNilOrVoid(getRef(n, 0))) return false
            }
            for (let i = n.op === 'load' ? 1 : 0; i < countIds(n); i++) {
                if (!isInvariant(getRef(n, i))) return false
            }
            work.push(id)
            invariants.add(id)
            return true
        }

        const covered = new Set<number>()
        while (work.length) {
            const next = work.pop()!
            const s = dependents.get(next)
            if (!s) continue
            let fullyCovered = true
            for (const u of s) {
                if (!isInvariant(u)) {
                    if (fullyCovered && !!inbound.find(x => x[1] === u)) continue
                    fullyCovered = false
                }
            }
            if (fullyCovered) {
                covered.add(next)
            }
        }
        const maxLoopParams = 6
        const headroom = Math.max(0, maxLoopParams - target.params.length)
        for (const idx of obvious) {
            const p = target.params[idx]
            if (!covered.has(p) && !headroom) {
                invariants.delete(p)
                const s = dependents.get(p)
                if (!s) continue
                for (const u of s) invariants.delete(u)
            }
        }
        const roots = new Map<number, [dependent: number, pos: number][]>()
        function addRoot(from: number, to: number, pos: number) {
            let arr = roots.get(from)
            if (!arr) roots.set(from, arr = [])
            arr.push([to, pos])
        }
        for (const x of invariants) {
            if (target.params.includes(x)) continue
            const uses = usedBy.get(x)!
            for (const y of uses) {
                if (invariants.has(y)) continue
                const u = g.nodes.get(y)!
                for (let i = 0; i < countIds(u); i++) {
                    if (getRef(u, i) === x) {
                        addRoot(x, y, i)
                    }
                }
            }
        }
        const iterating = new Set<number>()
        function markIterating(id: number): void {
            if (!id || iterating.has(id)) return
            const n = g.nodes.get(id)
            if (!n || n.op === 'block') return
            iterating.add(id)
            for (const x of getArgIds(n)) markIterating(x)
        }
        for (const path of applicationPaths(target, target.id)) {
            for (const id of path) {
                const n = g.nodes.get(id)!
                if (n.op === 'select') markIterating(getRef(n, 0))
                else if (n.op === 'after') for (let i = 0; i < countIds(n) - 1; i++) markIterating(getRef(n, i))
                else markIterating(id)
            }
        }
        const coveredParams = target.params.filter(x => covered.has(x))
        const extra = roots.size - coveredParams.length
        if (extra > 0 && [...roots.keys()].some(x => !iterating.has(x))) return
        if (extra > headroom) {
            // console.log('ROOTS', roots)
            // console.log('too many roots vs params:', coveredParams)
            return
        }
        if (!roots.size) return

        const replacements = new Map<number, number>()
        const newParams = target.params.filter(x => !coveredParams.includes(x))
        const paramToRoot = new Map<number, number>()
        for (const r of roots) {
            const p = addParam()
            replacements.set(r[0], p)
            paramToRoot.set(p, r[0])
            newParams.push(p)
        }

        const oldParams = [...target.params]

        {
            const replacements = new Map<number, number>()
            const forwardedParams = oldParams.map(x => {
                const p = addParam()
                replacements.set(x, p)
                return p
            })
            const hoisted = [...roots.keys()].map(x => {
                return replaceAll(x, replacements)
            })
            const o = oldParams.filter(x => !coveredParams.includes(x))
            const argIds = new Array(1+newParams.length)
            const argConsts = new Float64Array(1+newParams.length)
            for (let i = 0; i < o.length; i++) {
                argIds[i+1] = replacements.get(newParams[i])
            }
            for (let i = 0; i < hoisted.length; i++) {
                argIds[i+1+o.length] = hoisted[i]
            }
            argIds[0] = target.id
            const forward = addNode('apply', argIds, argConsts)
            const blk = addBlock(forwardedParams, forward)
            const callerReplacements = new Map<number, number>()
            callerReplacements.set(target.id, blk)
            const caller = getGraphBlock(filtered[0][0])
            caller.bodyId = replaceAll(caller.bodyId, callerReplacements)
            revisitBlock(caller)
            revisitBlock(getBlock(g, blk)!)
        }

        {
            for (const x of self) {
                const app = x[1]
                const u = g.nodes.get(app)!
                const o = oldParams.filter(x => !coveredParams.includes(x))
                const argIds = new Array(1+newParams.length)
                const argConsts = new Float64Array(1+newParams.length)
                let j = 0
                for (let i = 0; i < o.length; i++) {
                    if (coveredParams.includes(target.params[j])) {
                        j += 1
                        i -= 1
                        continue
                    }
                    argIds[i+1] = replaceAll(getRef(u, j+1), replacements)
                    argConsts[i+1] = getLiteral(u, j+1)
                    j += 1
                }
                for (let i = 0; i < roots.size; i++) {
                    argIds[i+1+o.length] = newParams[i+o.length]
                }
                argIds[0] = x[0]
                const newApp = addNode('apply', argIds, argConsts)
                replacements.set(app, newApp)
            }
        }  
        target.params = newParams
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function rootsOf(sg: Set<number>) {
        const res = new Set<number>(sg)
        for (const x of sg) {
            const deps = dependencies.get(x)
            if (!deps) continue
            for (const y of deps) res.delete(y)
        }
        return res
    }

    function isOrdered(vid: number): boolean {
        if (!vid) return false
        const u = g.nodes.get(vid)
        if (!u) return false
        if (!PureOps.has(u.op)) return true
        if (u.op === 'after' || u.op === 'param') {
            return true
        }
        for (let i = 0; i < countIds(u); i++) {
            if (isOrdered(getRef(u, i))) return true
        }
        return false
    }

    function pruneUnusedParams(b: GraphBlock) {
        if (b === g.blocks[0]) return false
        function used(p: number, owner: GraphBlock, epoch = nextEpoch(g)): boolean {
            if (owner.bodyId === p) return true
            if (!markVisited(g.nodes.get(p)!, epoch)) return false
            const uses = dependents.get(p)
            if (!uses) return false
            for (const id of uses) {
                const u = g.nodes.get(id)!
                if (u.op !== 'apply') return true
            }
            for (const id of uses) {
                const u = g.nodes.get(id)!
                const target = getGraphBlock(getRef(u, 0))
                for (let i = 1; i < countIds(u); i++) {
                    if (getRef(u, i) === p && used(target.params[i - 1], target, epoch)) return true
                }
            }
            return false
        }
        const safe = new Set(b.params.filter(p => used(p, b)))
        if (safe.size === b.params.length) return false
        const inbound = findInboundApplies(b)
        const newParams = [...safe]
        const safeIndices = newParams.map(x => b.params.indexOf(x) + 1)
        b.params = newParams
        const replacements = new Map<number, number>()
        const changedBlocks = new Set<number>()
        for (const x of inbound) {
            changedBlocks.add(x[0])
            const u = g.nodes.get(x[1])!
            const o = [getRef(u, 0)] as (number | GraphNode)[]
            const rem: number[] = []
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (safeIndices.includes(i)) {
                    if (a) o.push(a)
                    else o.push(literal(getLiteral(u, i)))
                } else if (a && (isOrdered(a) && !isParam(g.nodes, a)) && !rem.includes(a)) {
                    rem.push(a)
                }
            }
            let app = createNode(g, 'apply', o, u)
            if (rem.length) app = createNode(g, 'after', [...rem, app])
            replacements.set(x[1], app)
        }
        for (const bid of changedBlocks) {
            const b = getGraphBlock(bid)
            b.bodyId = replaceAll(b.bodyId, replacements)
        }
        for (const bid of changedBlocks) {
            revisitBlock(getGraphBlock(bid))
        }
        // for (const bid of changedBlocks) {
        //     if (bid === b.id) continue
        //     pruneUnusedParams(getGraphBlock(bid))
        // }
        return true
    }

    function getApplyInputs(val: number, params: number[]) {
        const n = g.nodes.get(val)
        assert(n && n.op === 'apply')
        const b = getBlock(g, getRef(n, 0))
        assert(b)
        return params.map(x => {
            const idx = b.params.indexOf(x)
            assert(idx !== -1)
            if (!getRef(n, idx)) {
                return { val: getLiteral(n, 1+idx), const: true }
            }
            return { val: getRef(n, 1+idx), const: false }
        })
    }

    function findLoopCriticalSubgraph(target: GraphBlock) {
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = g.nodes.get(t)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const filtered = inbound.filter(x => x[0] === target.id)
        if (!filtered.length) return
        if (!getArgIds(tail).includes(filtered[0][1])) return

        const cond = getRef(tail, 0)
        const dependentParams = findValuesFrom(target.id, 'param', cond)
        if (!dependentParams?.length) return

        const criticalValues = filtered
            .map(x => getApplyInputs(x[1], dependentParams)).flat()
            .filter(x => !x.const).map(x => x.val)
            .filter(x => !dependentParams.includes(x))

        if (!criticalValues.length) return

        const sg = collectSubgraphOf(criticalValues)

        return { 
            sg,
            tail,
            inbound,
            criticalValues,
            dependentParams,
        }
    }

    const orderedCache = new Map<number, boolean>()
    function isUnordered(id: number): boolean {
        if (!id) return true
        const known = orderedCache.get(id)
        if (known !== undefined) return known
        orderedCache.set(id, true)
        const n = g.nodes.get(id)
        if (!n) return true
        let ok = PureOps.has(n.op)
        if (ok) for (const a of getArgIds(n)) if (!isUnordered(a)) { ok = false; break }
        orderedCache.set(id, ok)
        return ok
    }

    const guaranteedEffects = new Map<number, Set<number>>()
    guaranteedEffects.set(0, new Set())
    function guaranteed(id: number): Set<number> {
        const known = guaranteedEffects.get(id)
        if (known) return known
        const n = g.nodes.get(id)!
        const out = new Set<number>()
        guaranteedEffects.set(id, out)
        if (n.op === 'select') {
            for (const effect of guaranteed(getRef(n, 0))) out.add(effect)
            const yes = guaranteed(getRef(n, 1))
            const no = guaranteed(getRef(n, 2))
            for (const effect of yes) if (no.has(effect)) out.add(effect)
        } else if (n) {
            const end = n.op === 'after' ? countIds(n) - 1 : countIds(n)
            for (let i = 0; i < end; i++) {
                for (const effect of guaranteed(getRef(n, i))) out.add(effect)
            }
            if (n.op === 'call' || n.op === 'store' || n.op === 'load') out.add(id)
        }
        return out
    }

    function liftCommonEffects(target: GraphBlock) {
        const selects = findValues(target.id, 'select')
        if (!selects) return
        const lifts = new Map<number, number>()
        for (const id of selects) {
            const n = g.nodes.get(id)
            if (!n || n.op !== 'select') continue
            const before = guaranteed(getRef(n, 0))
            const yes = guaranteed(getRef(n, 1))
            const no = guaranteed(getRef(n, 2))
            const common: number[] = []
            for (const effect of yes) {
                if (no.has(effect) && !before.has(effect)) common.push(effect)
            }
            const latest = common.filter(effect => {
                for (const other of common) {
                    if (other !== effect && guaranteed(other).has(effect)) return false
                }
                return true
            })
            if (latest.length === 1) lifts.set(id, latest[0])
        }
        if (!lifts.size) return
        for (const [id, effect] of lifts) {
            const select = g.nodes.get(id)!
            const inner = addNode(select.op, getArgIds(select), getArgConsts(select), select)
            g.nodes.set(id, makeNode('after', [effect, inner], new Float64Array(2)))
        }
        revisitBlock(target)
        return true
    }

    function liftCommonApplication(id: number) {
        const n = g.nodes.get(id)
        if (!n || n.op !== 'select') return false
        const yes = g.nodes.get(getRef(n, 1))
        const no = g.nodes.get(getRef(n, 2))
        if (!yes || yes.op !== 'apply' || !no || no.op !== 'apply') return false
        if (getRef(yes, 0) !== getRef(no, 0) || countIds(yes) !== countIds(no)) return false

        const block = getGraphBlock(getRef(yes, 0))
        const differ: number[] = []
        for (let i = 1; i < countIds(yes); i++) {
            if (getRef(yes, i) === getRef(no, i)
                && (getRef(yes, i) || Object.is(getLiteral(yes, i), getLiteral(no, i)))) continue
            if (!isUnordered(getRef(yes, i)) || !isUnordered(getRef(no, i))) return false
            differ.push(i)
        }
        if (!differ.length && !isUnordered(getRef(n, 0))) return false

        const argIds = cloneRefs(yes)
        const argConsts = cloneLiterals(yes)
        for (const at of differ) {
            argIds[at] = addNode('select', [getRef(n, 0), getRef(yes, at), getRef(no, at)],
                new Float64Array([getLiteral(n, 0), getLiteral(yes, at), getLiteral(no, at)]), n)
            argConsts[at] = 0
        }
        g.nodes.set(id, copyNode(yes, argIds, argConsts))
        return true
    }

    function liftCommonApplications(target: GraphBlock) {
        const selects = findValues(target.id, 'select')
        if (!selects) return
        let changed = false
        for (let i = selects.length - 1; i >= 0; i--) {
            if (liftCommonApplication(selects[i])) changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    function isCountedIncrement(n: GraphNode | undefined, param: number) {
        if (!n || n.op !== 'add') return false
        return (getRef(n, 0) === param && !getRef(n, 1) && getLiteral(n, 1) === 1)
            || (getRef(n, 1) === param && !getRef(n, 0) && getLiteral(n, 0) === 1)
    }

    function closeCountedLoop(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (self.length !== 1 || !entries.length) return
        if (getRef(tail, 1) !== self[0][1]) return
        const exit = g.nodes.get(getRef(tail, 2))
        if (!exit || exit.op !== 'apply') return
        const cond = g.nodes.get(getRef(tail, 0))
        if (!cond || cond.op !== 'lt') return
        if (lowering.isSignedType(getTypeT(cond)) || lowering.isSignedType(getTypeU(cond))) return

        const back = g.nodes.get(self[0][1])!
        const params = target.params
        const invariants = new Set<number>()
        for (let i = 0; i < params.length; i++) {
            if (getRef(back, i+1) === params[i]) invariants.add(params[i])
        }
        function invariantOperand(id: number, value: number) {
            if (!id) return { id: 0, value }
            if (invariants.has(id)) return { id, value: 0 }
        }

        const ivAt = params.indexOf(getRef(cond, 0))
        if (ivAt < 0) return
        if (!isCountedIncrement(g.nodes.get(getRef(back, ivAt+1)), params[ivAt])) return
        const bound = invariantOperand(getRef(cond, 1), getLiteral(cond, 1))
        if (!bound) return

        const accumulators: [at: number, step: { id: number, value: number }, of: GraphNode][] = []
        for (let i = 0; i < params.length; i++) {
            if (i === ivAt || invariants.has(params[i])) continue
            const update = g.nodes.get(getRef(back, i+1))
            if (!update || update.op !== 'add') return
            const at = getRef(update, 0) === params[i] ? 1
                : getRef(update, 1) === params[i] ? 0 : -1
            if (at < 0) return
            const step = invariantOperand(getRef(update, at), getLiteral(update, at))
            if (!step) return
            accumulators.push([i, step, update])
        }

        const paramSet = new Set<number>(params)

        for (let i = 1; i < countIds(exit); i++) {
            const id = getRef(exit, i)
            if (!paramSet.has(id) && reachesAnyOf(id, paramSet)) return
        }

        const touched: number[] = []
        for (const [blockId, appId] of entries) {
            const app = g.nodes.get(appId)!
            if (getRef(app, ivAt+1) || getLiteral(app, ivAt+1) !== 0) continue
            function argOf(at: number) {
                return { id: getRef(app, at+1), value: getLiteral(app, at+1) }
            }
            function outside(operand: { id: number, value: number }) {
                return operand.id ? argOf(params.indexOf(operand.id)) : operand
            }

            const trip = outside(bound)
            const finals = new Map<number, { id: number, value: number }>()
            for (let i = 0; i < params.length; i++) finals.set(params[i], argOf(i))
            finals.set(params[ivAt], trip)
            for (const [at, step, of] of accumulators) {
                const s = outside(step)
                const total = addNode('mul', [trip.id, s.id],
                    new Float64Array([trip.value, s.value]), of)
                const initial = argOf(at)
                const final = initial.id || initial.value
                    ? addNode('add', [initial.id, total], new Float64Array([initial.value, 0]), of)
                    : total
                finals.set(params[at], { id: final, value: 0 })
            }

            const argIds = cloneRefs(exit)
            const argConsts = cloneLiterals(exit)
            for (let i = 1; i < argIds.length; i++) {
                const final = finals.get(argIds[i])
                if (!final) continue
                argIds[i] = final.id
                argConsts[i] = final.value as f64
            }
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addNode('apply', argIds, argConsts, exit)]]))
            touched.push(blockId)
        }
        if (!touched.length) return
        for (const blockId of touched) revisitBlock(getGraphBlock(blockId))
        return true
    }

    function deriveIncrementor(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return
        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (!self.length || !entries.length) return
        const selfIds = new Set(self.map(x => x[1]))
        const backs = self.map(x => g.nodes.get(x[1])!)
        const params = target.params
        const invariants = new Set<number>()
        for (let i = 0; i < params.length; i++) {
            if (backs.every(back => getRef(back, i + 1) === params[i])) invariants.add(params[i])
        }
        function invariant(n: GraphNode, i: number) {
            return !getRef(n, i) || invariants.has(getRef(n, i))
        }
        function derivation(n: GraphNode, from: number) {
            if (countIds(n) !== 2) return -1
            const at = getRef(n, 0) === from ? 0 : getRef(n, 1) === from ? 1 : -1
            if (at < 0) return -1
            if (n.op === 'add') return invariant(n, at ^ 1) ? at : -1
            if (n.op === 'mul') return !getRef(n, at ^ 1) && getLiteral(n, at ^ 1) > 0 ? at : -1
            if (n.op === 'shl') return at === 0 && !getRef(n, 1) ? at : -1
            return -1
        }

        for (let at = 0; at < params.length; at++) {
            const p = params[at]
            if (invariants.has(p)) continue
            function strideOf(back: GraphNode) {
                const step = g.nodes.get(getRef(back, at + 1))
                if (!step || step.op !== 'add') return
                const strideAt = derivation(step, p) ^ 1
                if (strideAt < 0 || strideAt > 1 || getRef(step, strideAt)) return
                for (const u of dependents.get(getRef(back, at + 1)) ?? []) {
                    if (!selfIds.has(u)) return
                }
                return getLiteral(step, strideAt)
            }
            const strides = backs.map(strideOf)
            if (strides.some(x => x === undefined)) continue
            const steps = new Set(backs.map(back => getRef(back, at + 1)))
            if (backs.some(back => getArgIds(back).some((id, i) => i !== at + 1 && steps.has(id)))) continue

            const chain: [id: number, from: number][] = []
            const compares: number[] = []
            let valid = true
            for (const u of dependents.get(p) ?? []) {
                if (steps.has(u)) continue
                const n = g.nodes.get(u)!
                if (CompareOps.has(n.op) && invariant(n, getRef(n, 0) === p ? 1 : 0)) {
                    if (lowering.isSignedType(getTypeT(n)) || lowering.isSignedType(getTypeU(n))) valid = false
                    compares.push(u)
                    continue
                }
                const from = derivation(n, p)
                if (from < 0 || chain.length) valid = false
                chain.push([u, from])
            }
            if (!valid || !chain.length) continue
            for (;;) {
                const uses = dependents.get(chain[chain.length - 1][0])
                if (!uses || uses.size !== 1) break
                let next = 0
                for (const u of uses) next = u
                const from = derivation(g.nodes.get(next)!, chain[chain.length - 1][0])
                if (from < 0) break
                chain.push([next, from])
            }

            let scale = 1
            for (const [id, from] of chain) {
                const n = g.nodes.get(id)!
                if (n.op === 'mul') scale *= getLiteral(n, from ^ 1)
                if (n.op === 'shl') scale *= 2 ** getLiteral(n, 1)
            }
            if (strides.some(x => !Number.isSafeInteger(x! * scale))) continue

            function replay(value: [number, number], operand: (id: number, value: number) => [number, number]) {
                for (const [id, from] of chain) {
                    const n = g.nodes.get(id)!
                    const ids = [0, 0]
                    const consts = [0, 0]
                    ids[from] = value[0]
                    consts[from] = value[1]
                    const x = operand(getRef(n, from ^ 1), getLiteral(n, from ^ 1))
                    ids[from ^ 1] = x[0]
                    consts[from ^ 1] = x[1]
                    if (ids[0] || ids[1]) {
                        value = [addNode(n.op, ids, Float64Array.from(consts), n), 0]
                    } else if (n.op === 'add') {
                        value = [0, consts[0] + consts[1]]
                    } else if (n.op === 'mul') {
                        value = [0, consts[0] * consts[1]]
                    } else {
                        value = [0, consts[0] * 2 ** consts[1]]
                    }
                }
                return value
            }
            const closed = chain.every(([id, from]) => !getRef(g.nodes.get(id)!, from ^ 1))

            function moved(a: number[]) {
                return [...a.slice(0, at + 1), ...a.slice(at + 2, params.length + 1), a[at + 1], ...a.slice(params.length + 1)]
            }
            const derived = chain[chain.length - 1][0]
            let addr = 0
            const memory: [id: number, offset: number][] = []
            function locate(id: number, offset: number): boolean {
                for (const u of dependents.get(id) ?? []) {
                    const n = g.nodes.get(u)!
                    if (n.op === 'add' && countIds(n) === 2) {
                        const at = getRef(n, 0) === id ? 1 : 0
                        if (getRef(n, at) || !locate(u, offset + getLiteral(n, at))) return false
                        continue
                    }
                    if (n.op !== 'load' && n.op !== 'store') return false
                    if (getRef(n, 2) !== id || getRef(n, 3) === id || !invariants.has(getRef(n, 1))) return false
                    if (addr && addr !== getRef(n, 1)) return false
                    addr = getRef(n, 1)
                    memory.push([u, offset])
                }
                return true
            }
            if (!closed || !locate(derived, 0)) addr = 0
            const bias = addr ? replay([0, 0], (id, value) => [id, value])[1] : 0
            function address(value: [number, number], outside: (id: number, value: number) => [number, number]): [number, number] {
                const base = outside(addr, 0)
                if (!value[0] && !value[1]) return base
                const offset = value[0] ? addNode('mul', [value[0], 0], new Float64Array([0, scale])) : 0
                return [addNode('add', [base[0], offset], new Float64Array([base[1], value[0] ? 0 : value[1] * scale])), 0]
            }

            const replacements = new Map<number, number>()
            if (!addr) replacements.set(derived, p)
            const limits: [param: number, bound: [number, number]][] = []
            for (const id of compares) {
                const n = g.nodes.get(id)!
                const boundAt = getRef(n, 0) === p ? 1 : 0
                const ids = cloneRefs(n)
                const consts = cloneLiterals(n)
                if (closed && !addr && !ids[boundAt]) {
                    consts[boundAt] = replay([0, consts[boundAt]], (id, value) => [id, value])[1] as f64
                } else {
                    const limit = addParam()
                    limits.push([limit, [ids[boundAt], consts[boundAt]]])
                    ids[boundAt] = limit
                    consts[boundAt] = 0
                }
                replacements.set(id, addNode(n.op, ids, Float64Array.from(consts), n))
            }
            for (const [id, offset] of addr ? memory : []) {
                const n = g.nodes.get(id)!
                const ids = cloneRefs(n)
                const consts = cloneLiterals(n)
                ids[1] = p
                ids[2] = 0
                consts[2] = bias + offset as f64
                g.nodes.set(id, copyNode(n, ids, Float64Array.from(consts)))
            }

            for (let k = 0; k < backs.length; k++) {
                const back = backs[k]
                const backIds = [target.id]
                const backConsts = [0]
                for (let i = 1; i < countIds(back); i++) {
                    backIds.push(i === at + 1 ? 0 : replaceAll(getRef(back, i), replacements))
                    backConsts.push(getLiteral(back, i))
                }
                const step = g.nodes.get(getRef(back, at + 1))!
                backIds[at + 1] = addNode('add', [p, 0], new Float64Array([0, strides[k]! * scale]), step)
                for (const [limit] of limits) {
                    backIds.push(limit)
                    backConsts.push(0)
                }
                replacements.set(self[k][1], addNode('apply', moved(backIds), Float64Array.from(moved(backConsts)), back))
            }

            for (const [blockId, appId] of entries) {
                const app = g.nodes.get(appId)!
                function outside(id: number, value: number): [number, number] {
                    if (!id) return [0, value]
                    const i = params.indexOf(id) + 1
                    return [getRef(app, i), getLiteral(app, i)]
                }
                const ids = cloneRefs(app)
                const consts = Array.from(cloneLiterals(app))
                const derive = addr ? address : replay
                const n = derive([ids[at + 1], consts[at + 1]], outside)
                ids[at + 1] = n[0]
                consts[at + 1] = n[1]
                for (const [, bound] of limits) {
                    const [id, value] = derive(outside(...bound), outside)
                    ids.push(id)
                    consts.push(value)
                }
                const caller = getGraphBlock(blockId)
                caller.bodyId = replaceAll(caller.bodyId,
                    new Map([[appId, addNode('apply', moved(ids), Float64Array.from(moved(consts)), app)]]))
                revisitBlock(caller)
            }

            target.params = moved([target.id, ...params, ...limits.map(x => x[0])]).slice(1)
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
    }

    function reverseLoop(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return
        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (self.length !== 1 || !entries.length) return
        const backId = self[0][1]
        if (getRef(tail, 1) !== backId) return
        const exit = getRef(tail, 2)
        if (findValues(target.id, 'select')?.length !== 1) return
        if (findValues(target.id, 'store')?.length) return
        if (findValues(target.id, 'call')?.length) return

        const condId = getRef(tail, 0)
        const cond = g.nodes.get(condId)
        if (!cond || cond.op !== 'lt') return
        if (lowering.isSignedType(getTypeT(cond)) || lowering.isSignedType(getTypeU(cond))) return
        const params = target.params
        const at = params.indexOf(getRef(cond, 0))
        const boundAt = params.indexOf(getRef(cond, 1))
        if (at < 0 || boundAt < 0) return
        const p = params[at]
        const bound = params[boundAt]
        const back = g.nodes.get(backId)!
        if (getRef(back, boundAt + 1) !== bound) return
        for (const u of dependents.get(bound) ?? []) {
            if (u !== condId && u !== backId) return
        }

        const stepId = getRef(back, at + 1)
        const step = g.nodes.get(stepId)
        if (!step || step.op !== 'add' || getRef(step, 0) !== p || getRef(step, 1)) return
        const stride = getLiteral(step, 1)
        if (!Number.isSafeInteger(stride) || stride <= 0) return
        if (dependents.get(stepId)?.size !== 1) return
        if (reaches(exit, p)) return

        const accumulating = new Set<string>(['add', 'mul', 'and', 'or', 'xor'])
        const accumulators = new Map<number, number>()
        for (let i = 0; i < params.length; i++) {
            if (i === at || getRef(back, i + 1) === params[i]) continue
            const uses = dependents.get(params[i])
            if (!uses?.size) continue
            const updateId = getRef(back, i + 1)
            const update = g.nodes.get(updateId)
            if (!update || !accumulating.has(update.op)) return
            const x = getRef(update, 0) === params[i] ? 1 : getRef(update, 1) === params[i] ? 0 : -1
            if (x < 0) return
            for (const u of uses) {
                if (u !== updateId && u !== exit) return
            }
            if (dependents.get(updateId)?.size !== 1) return
            accumulators.set(params[i], getRef(update, x))
        }
        const accumulated = new Set<number>(accumulators.keys())
        for (const x of accumulators.values()) {
            if (x && (accumulated.has(x) || reachesAnyOf(x, accumulated))) return
        }

        const memory: number[] = []
        let direct = true
        for (const u of dependents.get(p) ?? []) {
            if (u === condId || u === stepId) continue
            const n = g.nodes.get(u)!
            if ((n.op === 'load' || n.op === 'store') && getRef(n, 1) === p && !getRef(n, 2) && getRef(n, 3) !== p) {
                memory.push(u)
            } else {
                direct = false
            }
        }

        function arg(app: GraphNode, i: number): [number, number] {
            return [getRef(app, i + 1), getLiteral(app, i + 1)]
        }
        function multiple(id: number, value: number) {
            if (stride === 1) return true
            if (!id) return value % stride === 0
            const n = g.nodes.get(id)
            if (!n || getRef(n, 1)) return false
            if (n.op === 'mul') return getLiteral(n, 1) % stride === 0
            if (n.op === 'shl') return 2 ** getLiteral(n, 1) % stride === 0
            return false
        }
        function aligned(app: GraphNode) {
            const start = arg(app, at)
            const limit = arg(app, boundAt)
            if (!start[0] && !start[1]) return multiple(limit[0], limit[1])
            if (!start[0] || !limit[0]) return false
            const n = g.nodes.get(limit[0])
            if (!n || n.op !== 'add') return false
            const other = getRef(n, 0) === start[0] ? 1 : getRef(n, 1) === start[0] ? 0 : -1
            return other >= 0 && multiple(getRef(n, other), getLiteral(n, other))
        }
        if (!entries.every(x => aligned(g.nodes.get(x[1])!))) return

        const zero = entries.every(x => {
            const start = arg(g.nodes.get(x[1])!, at)
            return !start[0] && !start[1]
        })
        if (!zero && !memory.length) return
        const bias = !zero && direct ? Math.min(...memory.map(u => getLiteral(g.nodes.get(u)!, 2))) : 0

        for (const u of bias ? memory : []) {
            const n = g.nodes.get(u)!
            const consts = cloneLiterals(n)
            consts[2] = consts[2] - bias
            g.nodes.set(u, copyNode(n, getArgIds(n), Float64Array.from(consts)))
        }
        const next = addNode('sub', [p, 0], new Float64Array([0, stride]), step)
        const test = addNode('ne', [p, zero ? 0 : bound], new Float64Array([0, 0]), cond)
        target.bodyId = replaceAll(target.bodyId, new Map([[condId, test], [stepId, next], [p, next]]))

        function shifted(value: [number, number]): [number, number] {
            if (!bias) return value
            if (!value[0]) return [0, value[1] + bias]
            return [addNode('add', [value[0], 0], new Float64Array([0, bias])), 0]
        }
        function rebased(app: GraphNode, stop: [number, number]): [number, number] {
            const limit = g.nodes.get(getRef(app, boundAt + 1))!
            const other = getRef(limit, 0) === getRef(app, at + 1) ? 1 : 0
            return [addNode('add', [stop[0], getRef(limit, other)], new Float64Array([stop[1], getLiteral(limit, other)])), 0]
        }
        for (const [blockId, appId] of entries) {
            const app = g.nodes.get(appId)!
            const ids = cloneRefs(app)
            const consts = cloneLiterals(app)
            const stop = shifted(arg(app, at))
            const start = bias ? rebased(app, stop) : arg(app, boundAt)
            ids[at + 1] = start[0]
            consts[at + 1] = start[1] as f64
            ids[boundAt + 1] = stop[0]
            consts[boundAt + 1] = stop[1] as f64
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addNode('apply', ids, Float64Array.from(consts), app)]]))
            revisitBlock(caller)
        }
        revisitBlock(target)
        return true
    }

    function rotateLoop(target: GraphBlock) {
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return
        const back = g.nodes.get(getRef(tail, 1))
        if (!back || back.op !== 'apply' || getRef(back, 0) !== target.id) return

        function gather(id: number, out: Set<number>): Set<number> {
            if (!id || out.has(id)) return out
            const n = g.nodes.get(id)
            if (!n || n.op === 'block') return out
            out.add(id)
            for (let i = n.op === 'apply' ? 1 : 0; i < countIds(n); i++) gather(getRef(n, i), out)
            return out
        }
        const inCond = gather(getRef(tail, 0), new Set())
        const inBack = new Set<number>()
        for (let i = 1; i < countIds(back); i++) gather(getRef(back, i), inBack)
        const inExit = gather(getRef(tail, 2), new Set())

        let shared = false
        for (let i = 1; i < countIds(back); i++) {
            const arg = getRef(back, i)
            if (arg && g.nodes.has(arg) && !isParam(g.nodes, arg) && inCond.has(arg)) { shared = true; break }
        }
        if (!shared) return

        const unconditional = new Set(inCond)
        for (const id of inBack) if (inExit.has(id)) unconditional.add(id)
        function speculatable(id: number): boolean {
            if (!id || unconditional.has(id)) return true
            const n = g.nodes.get(id)
            if (!n || isParam(g.nodes, id)) return true
            if (n.op !== 'after' && !PureOps.has(n.op)) return false
            for (const arg of getArgIds(n)) if (!speculatable(arg)) return false
            return true
        }
        for (let i = 1; i < countIds(back); i++) {
            if (!speculatable(getRef(back, i))) return
        }

        const params: number[] = []
        const args: number[] = []
        const lowered = new Map<number, [id: number, konst: number]>()
        function drag(id: number, konst: number): [id: number, konst: number] {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const p = addParam()
            const out: [id: number, konst: number] = [p, 0]
            lowered.set(id, out)
            params.push(p)
            args.push(id)
            return out
        }
        function lower(id: number, konst: number): [id: number, konst: number] | undefined {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const n = g.nodes.get(id)
            if (!n || isParam(g.nodes, id) || inBack.has(id)) return drag(id, konst)
            if (n.op !== 'after' && !PureOps.has(n.op)) return
            const ids = cloneRefs(n)
            const consts = cloneLiterals(n)
            for (let i = 0; i < ids.length; i++) {
                const arg = lower(ids[i], consts[i])
                if (!arg) return
                ids[i] = arg[0]
                consts[i] = arg[1] as f64
            }
            const out: [id: number, konst: number] = [addNode(n.op, ids, consts, n), 0]
            lowered.set(id, out)
            return out
        }

        const backIds = [target.id]
        const backConsts = [0]
        for (let i = 1; i < countIds(back); i++) {
            const [id, konst] = drag(getRef(back, i), getLiteral(back, i))
            backIds.push(id)
            backConsts.push(konst)
        }

        const cond = lower(getRef(tail, 0), getLiteral(tail, 0))
        if (!cond) return

        let exit: [id: number, konst: number] | undefined
        const exitNode = g.nodes.get(getRef(tail, 2))
        if (exitNode?.op === 'apply') {
            const ids = [getRef(exitNode, 0)]
            const consts = [0]
            for (let i = 1; i < countIds(exitNode); i++) {
                const arg = lower(getRef(exitNode, i), getLiteral(exitNode, i))
                if (!arg) return
                ids.push(arg[0])
                consts.push(arg[1])
            }
            exit = [addNode('apply', ids, Float64Array.from(consts), exitNode), 0]
        } else {
            exit = lower(getRef(tail, 2), getLiteral(tail, 2))
        }
        if (!exit) return

        const backApply = addNode('apply', backIds, Float64Array.from(backConsts), back)
        const body = addNode('select', [cond[0], backApply, exit[0]],
            Float64Array.from([cond[1], 0, exit[1]]), tail)
        const blockId = addBlock(params, body)
        const entryIds = [blockId, ...args]
        target.bodyId = addNode('apply', entryIds, new Float64Array(entryIds.length), back)
        revisitBlock(target)
        return true
    }

    function eliminatePassthru(b: GraphBlock) {
        if (b.params.length > 1) return false
        let bodyId = b.bodyId
        let body = g.nodes.get(bodyId)
        assert(body)
        if (body.op === 'ret') {
            return false
        }
        const isVoid = body.op === 'void'
        const isUnreachable = body.op === 'unreachable'
        if (!isVoid && !isUnreachable && !b.params.includes(bodyId)) return false

        const applies = findInboundApplies(b)
        const byBlock = new Map<number, number[]>()
        for (const x of applies) {
            let arr = byBlock.get(x[0])
            if (!arr) byBlock.set(x[0], arr = [])
            arr.push(x[1])
        }
        for (const [k, v] of byBlock) {
            const r = new Map<number, number>()
            for (const x of v) {
                const a = g.nodes.get(x)!
                if ((isVoid || isUnreachable) && !b.params.length) {
                    r.set(x, b.bodyId)
                    continue
                }
                if (isUnreachable) {
                    throw `todo: unreachable in a block with params`
                }
                const arg = getRef(a, 1)
                if (arg) {
                    if (isVoid) {
                        r.set(x, addNode('after', [arg, b.bodyId], new Float64Array(2)))
                    } else {
                        r.set(x, arg)
                    }
                    continue
                }
                const c = getLiteral(a, 1)
                const literal = addNode('literal', [0], new Float64Array([c]))
                if (isVoid) {
                    r.set(x, addNode('after', [literal, b.bodyId], new Float64Array(2)))
                } else {
                    r.set(x, literal)
                }
            }
            const t = getBlock(g, k)!
            t.bodyId = replaceAll(t.bodyId, r)
            revisitBlock(t)
        }
        removeBlock(b)
        return true
    }

    function foldPanics(b: GraphBlock) {
        const r = new Map<number, number>()
        const panics = findValues(b.id, 'panic') ?? []
        for (const v of panics) {
            const uses = dependents.get(v) ?? []
            for (const u of uses) {
                const n = g.nodes.get(u)!
                if (n.op === 'select' && getRef(n, 0) !== v) continue
                r.set(u, v)
            }
        }
        if (!r.size) return false
        b.bodyId = replaceAll(b.bodyId, r)
        revisitBlock(b)
        foldPanics(b)
        return true
    }

    function mergeBlocks(target: GraphBlock): boolean {
        const next = successors.get(target.id)
        if (!next || next.size !== 1) return false
        const b = getGraphBlock([...next][0])
        if (b.id === target.id || b.id === g.blocks[0].id || preds.get(b.id)?.size !== 1) return false
        const tail = g.nodes.get(b.bodyId)
        if (!tail || tail.op === 'ret' || tail.op === 'panic') return false
        if ((findValues(b.id, 'apply')?.length ?? 0) > 1) return false

        const paths = applicationPaths(target, b.id)
        if (paths.length !== 1) return false
        const path = paths[0]
        const site = path[path.length - 1]
        const app = g.nodes.get(site)!
        if (countIds(app) !== b.params.length + 1) return false
        if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false

        const merged = inlineApplication(path, b, b.bodyId)
        if (merged === undefined) return false

        removeBlock(b)
        target.bodyId = replaceAll(target.bodyId, new Map([[site, merged]]))
        internBody(target)
        revisitBlock(target)
        mergeBlocks(target)
        return true
    }

    function foldKnownConditions(target: GraphBlock): boolean {
        if ((findValues(target.id, 'select')?.length ?? 0) < 2) return false
        function keyOf(id: number): string | undefined {
            const n = g.nodes.get(id)
            if (!n) return
            return n.op === 'param' || n.op === 'block' ? `#${id}` : nodeKey(n)
        }
        function assume(known: Map<string, number>, cond: number, value: number): Map<string, number> {
            const next = new Map(known)
            const key = keyOf(cond)
            if (key === undefined) return next
            next.set(key, value)
            const n = g.nodes.get(cond)!
            if (CompareOps.has(n.op)) next.set(nodeKey(copyNode(n, getArgIds(n), getArgConsts(n), InverseCompare[n.op])), value ? 0 : 1)
            return next
        }
        function lookup(known: Map<string, number>, cond: number): number | undefined {
            if (!cond || !known.size) return
            const key = keyOf(cond)
            return key === undefined ? undefined : known.get(key)
        }
        function rewrite(id: number, known: Map<string, number>): number {
            if (!known.size) return id
            const r = new Map<number, number>()
            const walked = new Set<number>()
            function visit(x: number): void {
                if (!x || walked.has(x)) return
                walked.add(x)
                const n = g.nodes.get(x)
                if (!n || n.op === 'param' || n.op === 'block') return
                for (const a of getArgIds(n)) visit(a)
                if (n.op !== 'select' || countIds(n) !== 3) return
                const k = lookup(known, getRef(n, 0))
                if (k === undefined) return
                const arm = k ? 1 : 2
                r.set(x, getRef(n, arm)
                    ? replaceAll(getRef(n, arm), r)
                    : addNode('literal', [0], new Float64Array([getLiteral(n, arm)])))
            }
            visit(id)
            return r.size ? replaceAll(id, r) : id
        }
        function tails(id: number, known: Map<string, number>): number {
            const n = g.nodes.get(id)
            if (!n) return id
            if (n.op === 'select' && countIds(n) === 3) {
                const k = lookup(known, getRef(n, 0))
                if (k !== undefined) return getRef(n, k ? 1 : 2) ? tails(getRef(n, k ? 1 : 2), known) : rewrite(id, known)
                const a = tails(getRef(n, 1), assume(known, getRef(n, 0), 1))
                const b = tails(getRef(n, 2), assume(known, getRef(n, 0), 0))
                const c = rewrite(getRef(n, 0), known)
                if (a === getRef(n, 1) && b === getRef(n, 2) && c === getRef(n, 0)) return id
                return addNode('select', [c, a, b], cloneLiterals(n), n)
            }
            if (n.op === 'after') {
                const last = countIds(n) - 1
                const argIds = getArgIds(n).map((x, i) => i === last ? tails(x, known) : rewrite(x, known))
                if (argIds.every((x, i) => x === getRef(n, i))) return id
                return addNode('after', argIds, cloneLiterals(n), n)
            }
            return rewrite(id, known)
        }
        const body = tails(target.bodyId, new Map())
        if (body === target.bodyId) return false
        target.bodyId = body
        revisitBlock(target)
        return true
    }

    function applicationPaths(from: GraphBlock, to: number): number[][] {
        const paths: number[][] = []
        function tails(id: number, path: number[]): void {
            const n = g.nodes.get(id)
            if (!n) return
            path.push(id)
            if (n.op === 'apply' && getRef(n, 0) === to) paths.push(path.slice())
            else if (n.op === 'after') tails(getRef(n, countIds(n) - 1), path)
            else if (n.op === 'select') for (let i = 1; i < countIds(n); i++) tails(getRef(n, i), path)
            path.pop()
        }
        tails(from.bodyId, [])
        return paths
    }

    function inlineApplication(path: number[], b: GraphBlock, bodyId: number): number | undefined {
        const app = g.nodes.get(path[path.length - 1])!
        const orderedness = new Map<number, boolean>()
        function ordered(id: number): boolean {
            const n = g.nodes.get(id)
            if (!n || n.op === 'nil-effect' || n.op === 'param' || n.op === 'block' || n.op === 'void') return false
            if (n.op === 'load' || n.op === 'store' || n.op === 'call') return true
            let known = orderedness.get(id)
            if (known === undefined) {
                orderedness.set(id, false)
                known = getArgIds(n).some(x => ordered(x))
                orderedness.set(id, known)
            }
            return known
        }
        let conditional = false
        function frontier(id: number, into: Set<number>): void {
            if (!id || into.has(id) || !ordered(id)) return
            const n = g.nodes.get(id)!
            if (n.op === 'load' || n.op === 'store' || n.op === 'call') {
                into.add(id)
            } else if (n.op === 'select') {
                frontier(getRef(n, 0), into)
                if (cloneRefs(n, 1).some(x => ordered(x))) conditional = true
            } else {
                for (const x of getArgIds(n)) frontier(x, into)
            }
        }
        const order = new Set<number>()
        for (const id of path.slice(0, -1)) {
            const n = g.nodes.get(id)!
            const end = n.op === 'after' ? countIds(n) - 1 : 1
            for (let i = 0; i < end; i++) frontier(getRef(n, i), order)
        }
        const context = new Set(order)
        for (let i = 1; i < countIds(app); i++) frontier(getRef(app, i), order)
        if (conditional) return
        const implied = new Set<number>()
        for (const id of order) {
            for (const x of getArgIds(g.nodes.get(id)!)) frontier(x, implied)
        }
        const kept = [...order].filter(id => !implied.has(id))
        const join = kept.length > 1
            ? addNode('after', [...kept, addNode('void', [], new Float64Array())], new Float64Array(kept.length + 1))
            : kept[0] ?? 0

        const r = new Map<number, number>()
        for (let i = 0; i < b.params.length; i++) {
            r.set(b.params[i], getRef(app, i + 1) || addNode('literal', [0], new Float64Array([getLiteral(app, i + 1)])))
        }
        if (join) {
            const walked = new Set<number>()
            function nils(id: number): void {
                if (!id || walked.has(id)) return
                walked.add(id)
                const n = g.nodes.get(id)
                if (n?.op === 'nil-effect' || n?.op === 'void') r.set(id, join)
                else for (const x of n ? getArgIds(n) : []) nils(x)
            }
            nils(bodyId)
        }
        let merged = replaceAll(bodyId, r)
        const dropped = kept.filter(id => !context.has(id))
        if (dropped.length) merged = addNode('after', [...dropped, merged], new Float64Array(dropped.length + 1))
        return merged
    }

    function internBody(target: GraphBlock) {
        const interned = new Map<string, number>()
        const canonical = new Map<number, number>()
        function intern(id: number): number {
            if (!id) return id
            const known = canonical.get(id)
            if (known !== undefined) return known
            const n = g.nodes.get(id)
            if (!n || n.op === 'param' || n.op === 'block') return id
            const argIds = getArgIds(n).map(x => intern(x))
            const key = nodeKey(n, argIds)
            let result = interned.get(key)
            if (result === undefined) {
                result = argIds.some((x, i) => x !== getRef(n, i)) ? addNode(n.op, argIds, cloneLiterals(n), n) : id
                interned.set(key, result)
            }
            canonical.set(id, result)
            return result
        }
        target.bodyId = intern(target.bodyId)
    }

    function constantOf(n: GraphNode, i: number): number | undefined {
        let id = getRef(n, i)
        let konst = getLiteral(n, i)
        for (;;) {
            if (!id) return konst
            const u = g.nodes.get(id)
            if (!u) return
            if (u.op === 'literal') return literalValue(u)
            if (u.op !== 'after') return
            const last = countIds(u) - 1
            for (let j = 0; j < last; j++) {
                const op = g.nodes.get(getRef(u, j))?.op
                if (getRef(u, j) && op !== 'nil-effect' && op !== 'void') return
            }
            id = getRef(u, last)
            konst = getLiteral(u, last)
        }
    }

    function threadConstantBranches(target: GraphBlock): boolean {
        if (target.id === g.blocks[0].id) return false
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select' || countIds(tail) !== 3) return false
        const at = target.params.indexOf(getRef(tail, 0))
        if (at < 0) return false
        const froms = preds.get(target.id)
        if (!froms || froms.has(target.id)) return false

        const sites: [from: GraphBlock, path: number[], arm: number][] = []
        const seen = new Set<number>()
        const chosen = new Set<number>()
        for (const k of froms) {
            const from = getGraphBlock(k)
            for (const path of applicationPaths(from, target.id)) {
                const site = path[path.length - 1]
                if (seen.has(site)) return false
                seen.add(site)
                const app = g.nodes.get(site)!
                if (countIds(app) !== target.params.length + 1) return false
                if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false
                const value = constantOf(app, at + 1)
                if (value === undefined) return false
                const arm = value ? 1 : 2
                if (!getRef(tail, arm) || chosen.has(arm)) return false
                chosen.add(arm)
                sites.push([from, path, getRef(tail, arm)])
            }
        }
        if (sites.length !== findInboundApplies(target).length) return false

        const merged: number[] = []
        for (const [, path, arm] of sites) {
            const m = inlineApplication(path, target, arm)
            if (m === undefined) return false
            merged.push(m)
        }
        const edits = new Map<GraphBlock, Map<number, number>>()
        for (let i = 0; i < sites.length; i++) {
            const [from, path] = sites[i]
            let r = edits.get(from)
            if (!r) edits.set(from, r = new Map())
            r.set(path[path.length - 1], merged[i])
        }
        removeBlock(target)
        for (const [from, r] of edits) {
            from.bodyId = replaceAll(from.bodyId, r)
            internBody(from)
            revisitBlock(from)
        }
        return true
    }

    function absorbConditions(target: GraphBlock): boolean {
        if (target.id === g.blocks[0].id) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const apps = inbound.map(([, id]) => g.nodes.get(id)!)
        if (apps.some(app => countIds(app) !== target.params.length + 1)) return false
        const sites = new Set(inbound.map(([, id]) => id))
        for (const select of findValues(target.id, 'select') ?? []) {
            const at = target.params.indexOf(getRef(g.nodes.get(select)!, 0))
            if (at < 0) continue
            const conds = apps.map(app => g.nodes.get(getRef(app, at + 1)))
            const shape = conds.find(n => n && CompareOps.has(n.op))
            if (!shape) continue
            const op = shape.op
            const fixed = [0, 1].map(j => {
                const k = scalarOperand(g.nodes, shape, j)
                if (k === undefined) return undefined
                return conds.some(n => n && CompareOps.has(n.op) && scalarOperand(g.nodes, n, j) !== k) ? undefined : k
            })
            const varying = [0, 1].filter(j => fixed[j] === undefined)
            if (!varying.length || fixed.some(k => k !== undefined && k < 0)) continue
            const candidates = [0, 1, ...fixed.flatMap(k => k === undefined ? [] : [k, k + 1])]
            function solve(want: number, chosen: number[]): number[] | undefined {
                if (chosen.length === varying.length) {
                    const [a, b] = [0, 1].map(j => fixed[j] ?? chosen[varying.indexOf(j)])
                    return +CompareEval[op](a, b) === want ? chosen : undefined
                }
                for (const c of candidates) {
                    const found = solve(want, [...chosen, c])
                    if (found) return found
                }
                return undefined
            }

            const operands: { id: number, konst: number }[][] = []
            for (let i = 0; i < apps.length; i++) {
                const cond = conds[i]
                if (cond && CompareOps.has(cond.op)) {
                    if (cond.op !== op || getTypeT(cond) !== getTypeT(shape) || getTypeU(cond) !== getTypeU(shape)) break
                    if ([...dependents.get(getRef(apps[i], at + 1)) ?? []].some(user => !sites.has(user))) break
                    operands.push(varying.map(j => ({ id: getRef(cond, j), konst: getLiteral(cond, j) })))
                    continue
                }
                const k = scalarOperand(g.nodes, apps[i], at + 1)
                const solved = k === 0 || k === 1 ? solve(k, []) : undefined
                if (!solved) break
                operands.push(solved.map(konst => ({ id: 0, konst })))
            }
            if (operands.length !== apps.length) continue

            const reuse = varying.map((_, v) => target.params.findIndex((_, p) => p !== at && operands.every((o, i) => {
                const id = getRef(apps[i], p + 1)
                return id ? id === o[v].id : !o[v].id && getLiteral(apps[i], p + 1) === o[v].konst
            })))
            const extra = varying.map((_, v) => v).filter(v => reuse[v] < 0)
            if (extra.length > 1) continue
            const slots = varying.map((_, v) => reuse[v] < 0 ? addParam() : target.params[reuse[v]])
            const compare = addNode(op, [0, 1].map(j => fixed[j] === undefined ? slots[varying.indexOf(j)] : 0),
                Float64Array.from([0, 1].map(j => fixed[j] ?? 0)), shape)
            const replaced = target.params[at]
            const edits = new Map<number, Map<number, number>>()
            for (let i = 0; i < apps.length; i++) {
                const ids = cloneRefs(apps[i])
                const consts = Array.from(getArgConsts(apps[i]))
                ids[at + 1] = extra.length ? operands[i][extra[0]].id : 0
                consts[at + 1] = extra.length ? operands[i][extra[0]].konst : 0
                for (const v of extra.slice(1)) {
                    ids.push(operands[i][v].id)
                    consts.push(operands[i][v].konst)
                }
                const [from, id] = inbound[i]
                let r = edits.get(from)
                if (!r) edits.set(from, r = new Map())
                r.set(id, addNode('apply', ids, Float64Array.from(consts), apps[i]))
            }
            for (const [from, r] of edits) {
                const b = getGraphBlock(from)
                b.bodyId = replaceAll(b.bodyId, r)
                if (b !== target) revisitBlock(b)
            }
            const params = target.params.slice()
            params[at] = extra.length ? slots[extra[0]] : addParam()
            params.push(...extra.slice(1).map(v => slots[v]))
            target.params = params
            target.bodyId = replaceAll(target.bodyId, new Map([[replaced, compare]]))
            revisitBlock(target)
            absorbConditions(target)
            return true
        }
        return false
    }

    function forwardMemory(target: GraphBlock): boolean {
        function sameOperand(a: GraphNode, b: GraphNode, i: number): boolean {
            if (getRef(a, i) && getRef(a, i) === getRef(b, i)) return true
            const x = scalarOperand(g.nodes, a, i)
            return x !== undefined && x === scalarOperand(g.nodes, b, i)
        }
        const sameLocation = (a: GraphNode, b: GraphNode) => sameOperand(a, b, 1) && sameOperand(a, b, 2)
        const bits = (n: GraphNode) => intrinsics.intrinsicBitWidth(getTypeT(n))

        function stored(store: GraphNode, load: GraphNode): number {
            const value = getRef(store, 3)
            const constant = scalarOperand(g.nodes, store, 3)
            const width = bits(load)
            if (constant !== undefined && (width === 64 || !lowering.isSignedType(getTypeT(load)))) {
                return addNode('literal', [0], new Float64Array([width === 64 ? constant : constant % 2 ** width]))
            }
            const source = g.nodes.get(value)
            if (value && (width === 64 || (source?.op === 'load' && getTypeT(source) === getTypeT(load)))) return value
            return insert(createConvert('convert', [value],
                new Float64Array([value ? 0 : constant ?? 0]), Types.u64, getTypeT(load)))
        }
        
        const r = new Map<number, number>()
        for (const id of findValues(target.id, 'load') ?? []) {
            const load = g.nodes.get(id)!
            let prior = getRef(load, 0)
            for (;;) {
                const n = g.nodes.get(prior)
                if (!n || n.op === 'nil-effect' || n.op === 'void') break
                if (n.op === 'store') {
                    if (sameLocation(n, load) && bits(n) === bits(load)) {
                        r.set(id, stored(n, load))
                    }
                    break
                }
                if (n.op === 'after' && countIds(n) !== 2) break // TODO: handle multiple
                if (n.op === 'after' && !isUnordered(getRef(n, 1))) break
                if (n.op === 'load' || n.op === 'after') {
                    prior = getRef(n, 0)
                } else {
                    break
                }
            }
        }
        if (!r.size) {
            for (const id of findValues(target.id, 'store') ?? []) {
                const store = g.nodes.get(id)!
                let overwritten = false
                let dead = true
                for (const user of dependents.get(id) ?? []) {
                    const n = g.nodes.get(user)
                    if (!n) continue
                    if (n.op === 'after' && getRef(n, countIds(n) - 1) !== id) continue
                    if ((n.op === 'load' || n.op === 'store') && getRef(n, 0) === id) {
                        if (!sameLocation(n, store)) continue
                        if (n.op === 'store' && bits(n) >= bits(store)) { 
                            overwritten = true 
                            continue 
                        }
                    }
                    dead = false
                    break
                }
                if (overwritten && dead) r.set(id, getRef(store, 0) || addNode('nil-effect', [], new Float64Array()))
            }
        }
        if (!r.size) return false
        target.bodyId = replaceAll(target.bodyId, r)
        revisitBlock(target)
        forwardMemory(target)
        return true
    }

    function reduceEffectDependencies(target: GraphBlock) {
        const selects = findValues(target.id, 'select') ?? []
        const afters = findValues(target.id, 'after') ?? []
        const calls = findValues(target.id, 'call') ?? []
        const stores = findValues(target.id, 'store') ?? []
        const loads = findValues(target.id, 'load') ?? []
        if (!selects.length && !afters.length && !calls.length && !stores.length && !loads.length) return

        const divergesMemo = new Map<number, boolean>()
        function diverges(id: number): boolean {
            if (!id) return false
            const known = divergesMemo.get(id)
            if (known !== undefined) return known
            const n = g.nodes.get(id)
            let out = false
            if (n) {
                if (n.op === 'panic' || n.op === 'unreachable') out = true
                else if (n.op === 'after') out = getArgIds(n).some(diverges)
                else if (n.op === 'select') out = diverges(getRef(n, 1)) && diverges(getRef(n, 2))
                else if (n.op === 'apply') {
                    for (let i = 1; !out && i < countIds(n); i++) out = diverges(getRef(n, i))
                }
            }
            divergesMemo.set(id, out)
            return out
        }

        let changed = false
        for (const id of selects) {
            const n = g.nodes.get(id)!
            if (n.op !== 'select') continue
            let survivor = -1
            for (let i = 1; i < countIds(n); i++) {
                if (diverges(getRef(n, i))) continue
                if (survivor >= 0) { survivor = -2; break }
                survivor = i
            }
            if (survivor < 0) continue
            const args = new Float64Array(2)
            args[0] = getLiteral(n, 0)
            args[1] = getLiteral(n, survivor)
            g.nodes.set(id, copyNode(n, [getRef(n, 0), getRef(n, survivor)], args, 'after'))
            changed = true
        }

        const siblingOf = new Map<number, number>()
        const ambiguous = new Set<number>()
        for (const id of selects) {
            const n = g.nodes.get(id)!
            if (n.op !== 'select') continue
            const a = getRef(n, 1)
            const b = getRef(n, 2)
            if (!a || !b || a === b) {
                if (a) ambiguous.add(a)
                if (b) ambiguous.add(b)
                continue
            }
            const prevA = siblingOf.get(a)
            if (prevA !== undefined && prevA !== b) ambiguous.add(a)
            else siblingOf.set(a, b)
            const prevB = siblingOf.get(b)
            if (prevB !== undefined && prevB !== a) ambiguous.add(b)
            else siblingOf.set(b, a)
        }

        const members = new Set<number>()
        for (const arr of byOp.get(target.id)!.values()) for (const id of arr) members.add(id)
        function escapes(users?: Iterable<number>): boolean {
            if (users) for (const u of users) if (!members.has(u)) return true
            return false
        }

        const evalArms = new Map<number, Set<number>>()
        const dataArms = new Map<number, Set<number>>()
        const demanded = new Set<number>()
        const checked = new Set<number>()
        if (calls.length || stores.length) {
            const queue: [id: number, arms: Set<number>, used: boolean][] = []
            const none = new Set<number>()
            function send(id: number, arms: Set<number>, mark: number, used: boolean): void {
                if (!id) return
                const next = new Set<number>(arms)
                if (mark) next.add(mark)
                queue.push([id, next, used])
            }
            function narrow(map: Map<number, Set<number>>, id: number, arms: Set<number>): boolean {
                const prev = map.get(id)
                if (!prev) { map.set(id, new Set<number>(arms)); return true }
                const drop: number[] = []
                for (const a of prev) if (!arms.has(a)) drop.push(a)
                for (const a of drop) prev.delete(a)
                return drop.length > 0
            }
            send(target.bodyId, none, 0, false)
            send(target.bodyId, none, 0, true)
            while (queue.length) {
                const [id, arms, used] = queue.pop()!
                if (!checked.has(id)) {
                    checked.add(id)
                    if (escapes(dependents.get(id))) queue.push([id, none, false])
                    if (escapes(usedBy.get(id))) queue.push([id, none, true])
                }
                if (used) demanded.add(id)
                if (!narrow(used ? dataArms : evalArms, id, arms)) continue
                if (!members.has(id)) continue
                const n = g.nodes.get(id)
                if (!n) continue
                const evalCtx = evalArms.get(id) ?? arms
                const dataCtx = dataArms.get(id) ?? evalCtx
                const isUsed = demanded.has(id)
                if (n.op === 'select') {
                    send(getRef(n, 0), evalCtx, 0, false)
                    if (isUsed) send(getRef(n, 0), dataCtx, 0, true)
                    for (let i = 1; i < countIds(n); i++) {
                        const arm = getRef(n, i)
                        if (!arm) continue
                        const mark = ambiguous.has(arm) ? 0 : arm
                        send(arm, evalCtx, mark, false)
                        if (isUsed) send(arm, dataCtx, mark, true)
                    }
                } else if (n.op === 'after') {
                    const last = countIds(n) - 1
                    for (let i = 0; i <= last; i++) send(getRef(n, i), evalCtx, 0, false)
                    if (isUsed) send(getRef(n, last), dataCtx, 0, true)
                } else if (n.op === 'call' || n.op === 'store' || n.op === 'load') {
                    send(getRef(n, 0), evalCtx, 0, false)
                    for (let i = 1; i < countIds(n); i++) {
                        send(getRef(n, i), evalCtx, 0, false)
                        send(getRef(n, i), evalCtx, 0, true)
                    }
                } else if (n.op === 'apply') {
                    for (let i = 1; i < countIds(n); i++) {
                        send(getRef(n, i), evalCtx, 0, false)
                        send(getRef(n, i), evalCtx, 0, true)
                    }
                } else {
                    for (const a of getArgIds(n)) {
                        send(a, evalCtx, 0, false)
                        if (isUsed) send(a, dataCtx, 0, true)
                    }
                }
            }
        }

        function released(load: number, at: number): boolean {
            const reads = dataArms.get(load)
            const runs = evalArms.get(at)
            if (!reads || !runs) return false
            for (const arm of reads) {
                const other = siblingOf.get(arm)
                if (other !== undefined && runs.has(other)) return true
            }
            return false
        }

        let nil = 0
        function nilFor(current: number): number {
            if (g.nodes.get(current)?.op === 'nil-effect') return current
            if (!nil) nil = addNode('nil-effect', [], new Float64Array(0))
            return nil
        }
        function join(source: GraphNode, argIds: number[]): number {
            const id = g.maxId++
            g.nodes.set(id, copyNode(source, argIds, new Float64Array(argIds.length), 'after'))
            return id
        }
        function sequence(a: number, b: number, source: GraphNode): number {
            if (!a) return b
            if (!b || a === b) return a
            return join(source, [a, b])
        }
        let empty = 0
        function parallel(order: number[], tail: number, source: GraphNode): number {
            const parts = [...new Set(order)].filter(x => x && x !== tail && g.nodes.get(x)?.op !== 'nil-effect' && g.nodes.get(x)?.op !== 'void')
            if (!parts.length) return tail
            if (!tail && parts.length === 1) return parts[0]
            if (!tail) {
                if (!empty) empty = addNode('void', [], new Float64Array(0))
                tail = empty
            }
            return join(source, [...parts, tail])
        }

        const memos = [new Map<number, number>(), new Map<number, number>()]
        const active = new Set<number>()
        function effects(id: number, ordered: boolean, forceParam = false): number {
            if (!id) return 0
            const memo = memos[ordered ? 1 : 0]
            const known = memo.get(id)
            if (known !== undefined) return known
            if (active.has(id)) return id
            active.add(id)
            const n = isParam(g.nodes, id) ? undefined : g.nodes.get(id)
            let out = id
            if (!n) out = forceParam ? id : 0
            else if (n.op === 'nil-effect' || n.op === 'void') out = 0
            else if (n.op === 'after') {
                const last = countIds(n) - 1
                const parts = getArgIds(n).map((arg, i) => effects(arg, ordered, i < last))
                out = parts.every((p, i) => p === getRef(n, i)) ? id : parallel(parts.slice(0, last), parts[last], n)
            } else if (n.op === 'load' && ordered && (demanded.has(id) || !checked.has(id))) {
                out = id
            } else if (n.op === 'load' || n.op === 'is-state' || PureOps.has(n.op)) {
                out = parallel(getArgIds(n).map(arg => effects(arg, ordered)), 0, n)
            }
            active.delete(id)
            memo.set(id, out)
            return out
        }

        function isOperand(n: GraphNode, id: number): boolean {
            if (n.op === 'after') return getRef(n, countIds(n) - 1) === id
            for (let i = 1; i < countIds(n); i++) if (getRef(n, i) === id) return true
            return false
        }

        function flatten(id: number, out: number[]): void {
            const n = g.nodes.get(id)
            if (n?.op === 'after') {
                for (const arg of getArgIds(n)) flatten(arg, out)
                return
            }
            if (id) out.push(id)
        }

        function dropReleased(effect: number, at: number, source: GraphNode): number {
            const parts: number[] = []
            flatten(effect, parts)
            let drops = 0
            for (const p of parts) if (g.nodes.get(p)?.op === 'load' && released(p, at)) drops++
            if (!drops) return effect
            let out = 0
            for (const p of parts) {
                if (g.nodes.get(p)?.op === 'load' && released(p, at)) continue
                out = sequence(out, p, source)
            }
            return out
        }

        function strip(effect: number, n: GraphNode): number {
            const e = g.nodes.get(effect)
            if (!e) return effect
            if (e.op === 'load' && isOperand(n, effect)) return 0
            if (e.op !== 'after') return effect
            const last = countIds(e) - 1
            const tail = getRef(e, last)
            if (g.nodes.get(tail)?.op !== 'load' || !isOperand(n, tail)) return effect
            return parallel(cloneRefs(e, 0, last).map(x => strip(x, n)), 0, e)
        }

        const reduced: [id: number, n: GraphNode][] = []
        for (const id of [...afters, ...selects]) {
            const n = g.nodes.get(id)!
            if (n.op !== 'after') continue
            const last = countIds(n) - 1
            const tail = getRef(n, last)
            const parts = cloneRefs(n, 0, last).map(arg => strip(effects(arg, false, true), n))
            const kept = [...new Set(parts)].filter(x => x && x !== tail && g.nodes.get(x)?.op !== 'nil-effect' && g.nodes.get(x)?.op !== 'void')
            const argIds = [...(kept.length ? kept : [nilFor(getRef(n, 0))]), tail]
            if (argIds.length === countIds(n) && argIds.every((x, i) => x === getRef(n, i))) continue
            const argConsts = new Float64Array(argIds.length)
            argConsts[argIds.length - 1] = getLiteral(n, last)
            reduced.push([id, copyNode(n, argIds, argConsts)])
        }
        for (const id of [...calls, ...stores, ...loads]) {
            const n = g.nodes.get(id)!
            let effect = strip(dropReleased(effects(getRef(n, 0), n.op !== 'load', true), id, n), n)
            if (!effect) effect = nilFor(getRef(n, 0))
            if (effect === getRef(n, 0)) continue
            const argIds = cloneRefs(n)
            argIds[0] = effect
            reduced.push([id, copyNode(n, argIds)])
        }
        for (const [id, n] of reduced) g.nodes.set(id, n)
        if (changed || reduced.length) revisitBlock(target)
    }

    function simplifyBitOperations(target: GraphBlock) {
        let changed = false
        function foldOffset(id: number) {
            const n = g.nodes.get(id)!
            const scalar = scalarOperand(g.nodes, n, 2)
            let term = scalar === undefined ? getRef(n, 2) : 0
            let offset = scalar ?? 0
            for (;;) {
                const t = g.nodes.get(term)
                if (!t || (t.op !== 'add' && t.op !== 'sub')) break
                const right = scalarOperand(g.nodes, t, 1)
                const left = t.op === 'add' ? scalarOperand(g.nodes, t, 0) : undefined
                if (right !== undefined && left === undefined) {
                    offset += t.op === 'add' ? right : -right
                    term = getRef(t, 0)
                } else if (left !== undefined && right === undefined) {
                    offset += left
                    term = getRef(t, 1)
                } else break
            }
            if (term === getRef(n, 2) || !Number.isSafeInteger(offset)) return
            const argIds = cloneRefs(n)
            const argConsts = cloneLiterals(n)
            if (term && offset) {
                argIds[1] = addNode('add', [getRef(n, 1), term], Float64Array.from([getLiteral(n, 1), 0]))
                argConsts[1] = 0
                argIds[2] = 0
                argConsts[2] = offset as f64
            } else {
                argIds[2] = term
                argConsts[2] = (term ? 0 : offset) as f64
            }
            g.nodes.set(id, copyNode(n, argIds, argConsts))
            changed = true
        }
        function foldTest(id: number) {
            const n = g.nodes.get(id)
            if (!n || countIds(n) < 2) return
            const valueAt = !getRef(n, 0) && getLiteral(n, 0) === 0 ? 1
                : !getRef(n, 1) && getLiteral(n, 1) === 0 ? 0 : -1
            if (valueAt < 0) return
            foldTest(getRef(n, valueAt))
            const inner = g.nodes.get(getRef(n, valueAt))
            if (!inner || !CompareOps.has(inner.op)) return
            const op = n.op === 'eq' ? InverseCompare[inner.op] : inner.op
            g.nodes.set(id, copyNode(inner, cloneRefs(inner), cloneLiterals(inner), op))
            changed = true
        }
        for (const id of findValues(target.id, 'load') ?? []) foldOffset(id)
        for (const id of findValues(target.id, 'store') ?? []) foldOffset(id)
        for (const id of findValues(target.id, 'eq') ?? []) foldTest(id)
        for (const id of findValues(target.id, 'ne') ?? []) foldTest(id)
        for (const id of findValues(target.id, 'mul') ?? []) {
            const n = g.nodes.get(id)!
            const valueAt = getRef(n, 0) && !getRef(n, 1) ? 0
                : getRef(n, 1) && !getRef(n, 0) ? 1 : -1
            if (valueAt < 0) continue
            const shift = Math.log2(getLiteral(n, valueAt ^ 1))
            if (!Number.isSafeInteger(shift) || shift <= 0) continue
            changed = true
            g.nodes.set(id, copyNode(n, [getRef(n, valueAt), 0], new Float64Array([0, shift]), 'shl'))
        }
        for (const id of findValues(target.id, 'and') ?? []) {
            const n = g.nodes.get(id)!
            const shiftAt = getRef(n, 0) ? 0 : getRef(n, 1) ? 1 : -1
            if (shiftAt < 0) continue
            const maskAt = shiftAt ^ 1
            if (getRef(n, maskAt)) continue
            const shiftId = getRef(n, shiftAt)
            const shift = g.nodes.get(shiftId)
            if (!shift || shift.op !== 'ushr' || getRef(shift, 1)) continue
            const width = Math.log2(getLiteral(n, maskAt) + 1)
            const U = width === 8 ? Types.u8 : width === 16 ? Types.u16 : width === 32 ? Types.u32 : undefined
            if (U === undefined) continue
            changed = true
            g.nodes.set(id, createConvert('convert', [shiftId], new Float64Array(1), getTypeT(shift), U))
        }
        if (changed) touch(target)
    }

    function foldLiterals(b: GraphBlock) {
        const literals = findValues(b.id, 'literal')
        if (!literals) return
        let changed = false
        for (const id of literals) {
            const u = g.nodes.get(id)!
            const uses = dependents.get(id) ?? []
            for (const x of uses) {
                const n = g.nodes.get(x)!
                let slot = getArgIds(n).indexOf(id)
                assert(slot !== -1)
                do {
                    setLiteral(n, slot, literalValue(u))
                    slot = getArgIds(n).indexOf(id)
                    changed = true
                } while (slot !== -1)
            }
        }
        if (changed) touch(b)
    }

    function deduplicateParams(): boolean {
        let canonicalParams = new Map<number, number>()
        const applies = new Map<GraphBlock, number[]>()
        let candidates = false
        for (const b of reachableBlocks) {
            if (b === g.blocks[0] || b.params.length < 2) continue
            const inbound = findInboundApplies(b)
            if (!inbound.length) continue
            const representatives = new Map<string, number>()
            let duplicated = false
            for (const p of b.params) {
                const key = nodeKey(g.nodes.get(p)!)
                const rep = representatives.get(key)
                if (rep === undefined) representatives.set(key, p)
                else duplicated = true
                canonicalParams.set(p, rep ?? p)
            }
            if (!duplicated) continue
            applies.set(b, inbound.map(x => x[1]))
            candidates = true
        }
        if (!candidates) return false

        while (true) {
            let changed = false
            const sizes = new Map<number, number>()
            for (const rep of canonicalParams.values()) sizes.set(rep, (sizes.get(rep) ?? 0) + 1)
            const representatives = new Map<string, number>()
            const canonical = new Map<number, number>()
            function visit(id: number): number {
                if (!id) return 0
                const known = canonical.get(id)
                if (known !== undefined) return known
                const n = g.nodes.get(id)
                let rep = canonicalParams.get(id) ?? id
                if (n && n.op !== 'param' && n.op !== 'block') {
                    const key = nodeKey(n, getArgIds(n).map(visit))
                    rep = representatives.get(key) ?? id
                    representatives.set(key, rep)
                }
                canonical.set(id, rep)
                return rep
            }
            const next = new Map<number, number>()
            for (const [b, ids] of applies) {
                if (b.params.every(p => sizes.get(canonicalParams.get(p)!) === 1)) {
                    applies.delete(b)
                    continue
                }
                for (let i = 0; i < b.params.length; i++) {
                    const p = b.params[i]
                    if (sizes.get(canonicalParams.get(p)!) === 1) {
                        next.set(p, p)
                        continue
                    }
                    const argIds = [canonicalParams.get(p)!]
                    const argConsts = new Float64Array(ids.length + 1)
                    for (let j = 0; j < ids.length; j++) {
                        const u = g.nodes.get(ids[j])!
                        argIds.push(visit(getRef(u, i + 1)))
                        argConsts[j + 1] = getLiteral(u, i + 1)
                    }
                    const key = nodeKey(g.nodes.get(p)!, argIds, argConsts)
                    const rep = representatives.get(key) ?? p
                    representatives.set(key, rep)
                    if (rep !== canonicalParams.get(p)) changed = true
                    next.set(p, rep)
                }
            }
            canonicalParams = next
            if (!changed) break
        }

        const replacements = new Map<number, number>()
        for (const [p, rep] of canonicalParams) {
            if (p !== rep) replacements.set(p, rep)
        }
        if (!replacements.size) return false
        const changedBlocks: GraphBlock[] = []
        for (const b of reachableBlocks) {
            const bodyId = replaceAll(b.bodyId, replacements)
            if (bodyId === b.bodyId) continue
            b.bodyId = bodyId
            changedBlocks.push(b)
        }
        for (const b of changedBlocks) {
            revisitBlock(b)
        }
        return true
    }

    const exempt = new Set<(b: GraphBlock) => unknown>([
        mergeBlocks, absorbConditions, threadConstantBranches, deriveIncrementor,
        closeCountedLoop, reverseLoop, hoistInvariants, pruneUnusedParams,
    ])

    for (let round = 0; round < 2; round++) {
        for (const b of reachableBlocks) {
            step(reduceEffectDependencies, b)
        }
        for (const b of reachableBlocks) {
            step(mergeBlocks, b)
            step(absorbConditions, b)
            step(threadConstantBranches, b)
            step(foldKnownConditions, b)
            step(forwardMemory, b)
            step(liftCommonEffects, b)
            step(liftCommonApplications, b)
        }
        for (const b of reachableBlocks) {
            step(deriveIncrementor, b)
            if (step(closeCountedLoop, b)) continue
            step(reverseLoop, b)
            step(hoistInvariants, b)
            if (step(eliminatePassthru, b)) continue
        }
        for (const b of reachableBlocks) {
            step(rotateLoop, b)
            step(simplifySelect, b)
            step(reduceBlockOrdering, b)
            step(interchangeSelects, b)
        }
        const dedupeStart = performance.now()
        deduplicateParams()
        if (optimizeTimers) time('deduplicateParams', performance.now() - dedupeStart)
        for (const b of reachableBlocks) {
            step(pruneUnusedParams, b)
        }
        for (const b of reachableBlocks) {
            step(foldLiterals, b)
            step(simplifyBitOperations, b)
            step(deduplicateValues, b)
        }
    }
    setGraphBlocks(g, [...reachableBlocks])
    if (optimizeTimers) time('(total)', performance.now() - optimizeStart)
    return g
}

export function analyzeValueGraph(g: Graph, opts?: LowerGraphOptions) {
    const implicitParams: number[] = []
    for (const [id, n] of g.nodes) if (n.op === 'call-context') implicitParams.push(id)
    const usedBy = new Map<number, number[]>()
    const demands = new Map<number, Set<number>>()
    const dependencies = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) {
            let arr = usedBy.get(to)
            if (!arr) usedBy.set(to, arr = [])
            arr.push(from)
            let d = demands.get(from)
            if (!d) demands.set(from, d = new Set())
            d.add(to)
        }
        let set = dependencies.get(from)
        if (!set) dependencies.set(from, set = new Set())
        set.add(to)
    }

    const inArgPos = new Map<number, [parent: number, idx: number][]>()
    const inStatePos = new Map<number, [parent: number, idx: number][]>()
    const returnsAt = new Map<number, number>()

    const blockBodyValues = new Map<number, number[]>()
    const hasCallEffects = new Set<number>()

    function getGraphBlock(id: number) {
        const b = getBlock(g, id)
        assert(b)
        return b
    }

    const tailTargets = new Map<number, number[]>()
    function collectTargets(id: number, into: number[]): void {
        const n = g.nodes.get(tailOf(g, id))
        if (n?.op === 'apply') into.push(getRef(n, 0))
        else if (n?.op === 'select') for (let i = 1; i < countIds(n); i++) collectTargets(getRef(n, i), into)
    }
    for (const b of g.blocks) {
        const into: number[] = []
        collectTargets(b.bodyId, into)
        tailTargets.set(b.id, into)
    }
    const loopsOf = new Map<number, number[]>()
    for (const b of g.blocks) loopsOf.set(b.id, [])
    function findLoops(root: number, within?: Set<number>, header = 0): void {
        const index = new Map<number, number>()
        const low = new Map<number, number>()
        const open: number[] = []
        function connect(v: number): void {
            index.set(v, index.size)
            low.set(v, index.get(v)!)
            open.push(v)
            for (const w of tailTargets.get(v)!) {
                if (w === header || (within && !within.has(w))) continue
                if (!index.has(w)) {
                    connect(w)
                    low.set(v, Math.min(low.get(v)!, low.get(w)!))
                } else if (open.includes(w)) {
                    low.set(v, Math.min(low.get(v)!, index.get(w)!))
                }
            }
            if (low.get(v) !== index.get(v)) return
            const members = new Set(open.splice(open.lastIndexOf(v)))
            if (members.size === 1 && (v === header || !tailTargets.get(v)!.includes(v))) return
            for (const m of members) loopsOf.get(m)!.push(v)
            findLoops(v, members, v)
        }
        connect(root)
    }
    findLoops(g.blocks[0].id)
    const looped = new Set<number>()
    for (const [k, v] of loopsOf) if (v.length) looped.add(k)
    for (const [k, v] of loopsOf) {
        if (v.length === 0 || !v.includes(k)) {
            loopsOf.delete(k)
        }
    }

    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reverseOrder = new Map<number, number>()
    const incoming = new Map<number, number[]>()
    const cycleChildren = new Map<number, Set<number>>()
    const applyOwner = new Map<number, number>()
    function enterBlock(b: GraphBlock): void {
        visited.set(b.id, visited.size)
        {
            blockStack.push(b)
            defer blockStack.pop()
            assert(!blockBodyValues.has(b.id))
            blockBodyValues.set(b.id, [])
            for (const x of b.params) {
                visit(x, false, true)
            }
            visit(b.bodyId, false)
        }
    }
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        const n = g.nodes.get(id)
        if (n?.op === 'nil-effect') return
        if (n?.op === 'void') return
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (visited.has(id)) return
        visited.set(id, visited.size)
        stack.push(id)
        defer stack.pop()

        const valId = id
        defer {
            reverseOrder.set(valId, reverseOrder.size)
            if (blockStack.length) {
                const blockId = blockStack[blockStack.length-1].id
                if (n && n.op !== 'param') {
                    blockBodyValues.get(blockId)!.push(valId)
                }
            }
        }

        if (!n || !countIds(n)) return

        if (n.op === 'after') {
            const result = countIds(n) - 1
            for (let i = 0; i < result; i++) visit(getRef(n, i), false)
            visit(getRef(n, result), true)
            return
        }
        if (n.op === 'call' || n.op === 'store' || n.op === 'load') {
            visit(getRef(n, 0), false)
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            if (n.op === 'call') {
                hasCallEffects.add(id)
                if (blockStack.length) {
                    hasCallEffects.add(blockStack[blockStack.length-1].id)
                }
            }
            return
        }
        if (n.op === 'apply') {
            const b = getGraphBlock(getRef(n, 0))
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            let into = incoming.get(b.id)
            if (!into) incoming.set(b.id, into = [])
            into.push(id)
            applyOwner.set(id, blockStack[blockStack.length-1].id)
            if (!blockStack.includes(b) && tailTargets.get(b.id)!.length) {
                for (const x of blockStack) {
                    if (!loopsOf.has(x.id)) continue
                    let s = cycleChildren.get(x.id)
                    if (!s) cycleChildren.set(x.id, s = new Set())
                    s.add(b.id)
                }
            }
            if (visited.has(b.id)) return
            enterBlock(b)
            return
        }
        for (const x of getArgIds(n)) {
            if (!x) continue
            visit(x, true)
        }
    }
    visited.set(0, 0)
    blockStack.push(g.blocks[0])
    blockBodyValues.set(g.blocks[0].id, [])
    const bodyId = g.blocks[0].bodyId
    if (bodyId) visit(bodyId, false)

    // BAGGAGE CLAIM
    const shouldSpillUntil = new Map<number, number>()
    const visitOrder = new Map<number, number>()
    const operandOrder = new Map<number, number[]>()
    {
        const tmp = new Set<number>()
        interface ClaimState {
            live: Set<number>
            seen: Set<number>
            done: Set<number>
            excluded: Set<number>
            crosses: Map<number, Set<number>>
        }
        function initState(save?: ClaimState): ClaimState {
            return {
                live: new Set(save?.live),
                seen: new Set(save?.seen),
                done: new Set(save?.done),
                excluded: new Set(save?.excluded),
                crosses: new Map(save?.crosses),
            }
        }
        let state = initState()
        function addCross(spilled: number, crossed: number, targetState = state) {
            let s = targetState.crosses.get(spilled)
            if (!s) targetState.crosses.set(spilled, s = new Set())
            s.add(crossed)
        }
        function getBaggage(root: number, clearTmp = true): number {
            if (clearTmp) tmp.clear()
            const allUses: number[][] = []
            function visit(id: number) {
                if (!id) return 0
                if (state.seen.has(id) || tmp.has(id) || state.excluded.has(id)) return 0
                tmp.add(id)
                const uses = usedBy.get(id)?.filter(x => !state.seen.has(x) && !state.excluded.has(x))
                if (uses?.length) allUses.push(uses)
                const n = g.nodes.get(id)
                if (!n) return
                for (let i = 0; i < countIds(n); i++) {
                    visit(getRef(n, i))
                }
            }
            visit(root)
            let c = 0
            for (const arr of allUses) {
                if (arr.some(x => !tmp.has(x))) c += 1
            }
            return c
        }
        function selectBaggage(selectId: number, u: GraphNode, isTail = true) {
            assert(u.op === 'select')

            tmp.clear()
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (!a) continue
                getBaggage(a, false)
            }
            if (!tmp.size) return

            const newlySeen = new Set(tmp)
            newlySeen.add(selectId)
            const joinState = initState()
            const joinDead = new Set<number>()

            {
                const saveState = state
                defer state = saveState

                for (let i = 1; i < countIds(u); i++) {
                    const a = getRef(u, i)
                    if (!a || saveState.seen.has(a)) continue
                    let excl: Set<number>
                    {
                        state = saveState
                        getBaggage(a)
                        assert(tmp.size)
                        const excluded = new Set(newlySeen)
                        for (const x of tmp) {
                            excluded.delete(x)
                        }
                        for (const x of saveState.excluded) {
                            excluded.add(x)
                        }
                        excl = excluded
                    }
                    state = initState(saveState)
                    state.excluded = excl
                    for (const x of state.live) {
                        if (allUsesDone(usedBy.get(x))) {
                            state.live.delete(x)
                        }
                    }
                    scheduleFrom(a)
                    for (const [k, s] of state.crosses) {
                        for (const v of s) addCross(k, v, joinState)
                    }
                    if (!isTail) {
                        for (const x of state.live) joinState.live.add(x)
                        for (const x of state.done) joinState.done.add(x)
                        for (const x of saveState.live) {
                            if (!state.live.has(x)) joinDead.add(x)
                        }
                    }
                }
            }

            if (!isTail) {
                for (const id of newlySeen) state.seen.add(id)
                for (const id of joinState.done) state.done.add(id)
                for (const id of joinState.live) state.live.add(id)
                for (const id of joinDead) state.live.delete(id)
            }
            for (const [k, s] of joinState.crosses) {
                for (const v of s) addCross(k, v)
            }
        }

        function findSchedule(n: GraphNode) {
            const args = getArgIds(n)
            if (n.op === 'store') {
                return [0, 1, 2, 3]
            }
            if (n.op === 'load') {
                return [0, 1, 2]
            }
            const pinned = n.op === 'after' ? args.length - 1 : -1
            const calls = new Array(countIds(n)) as boolean[]
            for (let i = 0; i < countIds(n); i++) calls[i] = false
            const baggage = args.map((x, i) => {
                if (i === pinned) return 0
                const b = getBaggage(x)
                for (const id of tmp) {
                    if (!hasCallEffects.has(id)) continue
                    calls[i] = true
                    break
                }
                return b
            })
            const order = args.map((_, i) => i).filter(i => i !== pinned).sort((a, b) => {
                if (calls[a] === calls[b]) {
                    return baggage[a] - baggage[b]
                }
                return calls[a] ? -1 : 1
            })
            if (pinned >= 0) order.push(pinned)
            return order
        }
        function updateLiveAfter(id: number, partial?: number) {
            if (const d = demands.get(id)) {
                for (const x of d) {
                    if (!state.live.has(x)) continue
                    if (partial && x !== partial) continue
                    if (allUsesDone(usedBy.get(x), id)) {
                        state.live.delete(x)
                        continue
                    }
                }
            }
        }
        function materialize(id: number, partial?: number) {
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            state.done.add(id)
            updateLiveAfter(id, partial)
        }
        function allUsesDone(uses: number[] | undefined, from?: number) {
            if (!uses) return true
            const len = uses.length
            for (let i = 0; i < len; i++) {
                const v = uses[i]
                if (!v) continue
                if (v === from) continue
                if (!state.done.has(v) && !state.excluded.has(v)) {
                    return false
                }
            }
            return true
        }
        function scheduleFrom(id: number) {
            if (!id) return
            if (state.seen.has(id)) {
                if (state.live.has(id)) {
                    if (allUsesDone(usedBy.get(id))) {
                        state.live.delete(id)
                    }
                }
                return
            }
            state.seen.add(id)
            const u = g.nodes.get(id)
            assert(u)
            if (u.op === 'select') {
                operandOrder.set(id, [0, 1, 2])
                scheduleFrom(getRef(u, 0))
                materialize(id, getRef(u, 0))
                selectBaggage(id, u)
                materialize(id)
                return
            }
            const order = findSchedule(u)
            operandOrder.set(id, order)
            for (const idx of order) {
                scheduleFrom(getRef(u, idx))
            }
            if (const q = visitOrder.get(id)) {
                visitOrder.set(id, Math.min(q, state.done.size))
            } else {
                visitOrder.set(id, state.done.size)
            }
            if (!hasCallEffects.has(id)) return materialize(id)
            updateLiveAfter(id)
            for (const x of state.live) {
                // if (const p = dominatingParent(x, id)) {
                //     addCross(p, id)
                //     continue
                // }
                addCross(x, id)
            }
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            state.done.add(id)
        }
        // function dominatingParent(id: number, cur: number) {
        //     if (state.crosses.has(id)) return
        //     let found: number | undefined
        //     for (const x of usedBy.get(id) ?? []) {
        //         if (x === cur) continue
        //         if (state.excluded.has(x)) continue
        //         if (!state.live.has(x)) continue
        //         if (found) return
        //         found = x
        //     }
        //     return found
        // }
        function scheduleFromBlock(b: GraphBlock) {
            assert(b.bodyId)
            for (const p of b.params) {
                state.live.add(p)
                state.seen.add(p)
            }
            if (b === g.blocks[0]) {
                for (const p of implicitParams) {
                    state.live.add(p)
                    state.seen.add(p)
                }
            }
            scheduleFrom(b.bodyId)
            state.live.clear()
        }
        for (const b of g.blocks) state.seen.add(b.id)
        for (const b of g.blocks) {
            if (!b.bodyId) continue
            scheduleFromBlock(b)
        }
        const seenForSpill = new Set<number>()
        function visitForSpill(id: number, crossed: Set<number>) {
            if (seenForSpill.has(id)) return
            seenForSpill.add(id)
            const uses = usedBy.get(id)
            if (!uses) return
            let last = 0
            let best = -1
            for (const call of crossed) {
                const rank = visitOrder.get(call) ?? -1
                if (rank > best) { best = rank; last = call }
            }
            if (!last) return
            shouldSpillUntil.set(id, last)
        }
        for (const res of state.crosses) {
            visitForSpill(res[0], res[1])
        }
        if (opts?.debug) {
            const claimed = [...visitOrder]
            claimed.sort((a, b) => a[1] - b[1])
            console.log('claim order', claimed.map(x => x[0]).join(' '))
        }
    }

    const reached = [...blockBodyValues.keys()]
    const blockOrder: number[] = []
    const succ = new Map<number, number[]>()
    const post: number[] = []
    {
        const open = new Set<number>()
        const done = new Set<number>()
        function search(id: number): void {
            open.add(id)
            const out: number[] = []
            succ.set(id, out)
            for (const t of tailTargets.get(id)!) {
                if (open.has(t)) continue
                if (!out.includes(t)) out.push(t)
                if (!done.has(t)) search(t)
            }
            open.delete(id)
            done.add(id)
            post.push(id)
        }
        search(g.blocks[0].id)
    }
    const chainOf = new Map<number, number[]>()
    const chains: number[][] = []
    for (const id of post) {
        const targets = succ.get(id)!
        const next = targets.length ? chainOf.get(targets[0]) : undefined
        if (next && targets.includes(next[0]) && targets.every(t => chainOf.get(t) === next)) {
            next.unshift(id)
            chainOf.set(id, next)
            continue
        }
        const chain = [id]
        chains.push(chain)
        chainOf.set(id, chain)
    }
    const rpo = new Map<number, number>()
    for (let i = 0; i < post.length; i++) rpo.set(post[i], post.length - 1 - i)
    const entry = chainOf.get(g.blocks[0].id)!
    const returns = (c: number[]) => !tailTargets.get(c[c.length - 1])!.length
    chains.sort((a, b) => {
        if (a === entry || b === entry) return a === entry ? -1 : 1
        if (returns(a) !== returns(b)) return returns(a) ? 1 : -1
        if (returns(a) && a.length !== b.length) return b.length - a.length
        return rpo.get(a[0])! - rpo.get(b[0])!
    })
    if (intrinsics.argv().includes('no-clone-exits')) blockOrder.push(...reached)
    else {
        for (const c of chains) for (const id of c) blockOrder.push(id)
        for (const id of reached) if (!chainOf.has(id)) blockOrder.push(id)
    }
    const rotated = new Map<number, number>()
    const cyclicSelect = new Set<number>() // only for non-self cycle
    const pure = pureValues(g)
    function findSelectFromApp(app: number, cur = app): { select: number, arm: number } | undefined {
        const d = usedBy.get(cur)
        if (!d) return
        if (d.length !== 1) return
        const s = g.nodes.get(d[0])!
        if (s.op === 'after') {
            return findSelectFromApp(app, d[0])
        }
        if (s.op !== 'select') return
        const idx = getArgIds(s).indexOf(cur)
        if (getArgIds(s).lastIndexOf(cur) !== idx) return
        return { select: d[0], arm: idx }
    }
    outer: for (const [bid, group] of loopsOf) {
        const inc = incoming.get(bid)
        assert(inc)
        const children = cycleChildren.get(bid)
        if (!children) {
            let backedge: number | undefined
            for (const app of inc) {
                const owner = applyOwner.get(app)!
                if (owner !== bid) continue
                if (backedge !== undefined) continue outer
                backedge = app
            }
            if (backedge === undefined) continue
            const o = findSelectFromApp(backedge)
            if (!o || o.arm !== 1) continue
            if (tailOf(g, getGraphBlock(bid).bodyId) !== o.select) continue
            rotated.set(o.select, bid)
            continue
        }
        let backedge: number | undefined
        for (const app of inc) {
            const owner = applyOwner.get(app)!
            if (!children.has(owner)) continue
            if (backedge !== undefined) continue outer
            backedge = app
        }
        if (backedge === undefined) continue
        const o = findSelectFromApp(backedge)
        if (!o || o.arm !== 1) continue
        if (tailOf(g, getGraphBlock(bid).bodyId) !== o.select) continue
        cyclicSelect.add(o.select)
    }
    function notePos(into: Map<number, [parent: number, idx: number][]>, id: number, parent: number, idx: number): void {
        if (!id) return
        const at = into.get(id)
        if (at) at.push([parent, idx])
        else into.set(id, [[parent, idx]])
    }
    for (const [id, n] of g.nodes) {
        if (!visited.has(id)) continue
        if (n.op === 'call') {
            for (let k = 3; k < countIds(n); k++) notePos(inArgPos, getRef(n, k), id, k - 3)
        } else if (n.op === 'apply') {
            for (let k = 1; k < countIds(n); k++) notePos(inArgPos, getRef(n, k), id, k - 1)
        }
    }
    for (const b of g.blocks) {
        function tails(at: number): void {
            if (!at) return
            if (isParam(g.nodes, at)) { notePos(inStatePos, at, b.id, -1); return }
            const t = g.nodes.get(at)!
            if (t.op === 'select') {
                for (let i = 1; i < countIds(t); i++) tails(getRef(t, i))
                return 
            }
            if (t.op === 'after') { tails(getRef(t, countIds(t)-1)); return }
            if (t.op === 'ret') { tails(getRef(t, 0)); return }
            if (t.op === 'apply') return
            notePos(inStatePos, at, b.id, -1)
        }
        tails(b.bodyId)
    }

    const callsUnderCache = new Map<number, Set<number>>()
    function callsUnder(id: number): Set<number> {
        const cached = callsUnderCache.get(id)
        if (cached) return cached
        const out = new Set<number>()
        callsUnderCache.set(id, out)
        if (hasCallEffects.has(id)) out.add(id)
        const deps = dependencies.get(id)
        if (deps) {
            for (const d of deps) {
                if (d === id) continue
                for (const c of callsUnder(d)) out.add(c)
            }
        }
        return out
    }

    function precedingValues(id: number, use: number): number[] {
        const n = g.nodes.get(use)
        if (n && n.op === 'select') {
            return precedingValues(id, getRef(n, 0))
        }
        const deps = dependencies.get(use)
        return deps ? [...deps] : []
    }

    for (const uses of usedBy.values()) {
        uses.sort((a, b) => (reverseOrder.get(a) ?? -1) - (reverseOrder.get(b) ?? -1))
    }
    for (const [id, uses] of usedBy) {
        const available = callsUnder(id)
        const crossed = new Set<number>()
        for (const use of uses) {
            for (const p of precedingValues(id, use)) {
                for (const c of callsUnder(p)) {
                    if (c === use || available.has(c)) continue
                    crossed.add(c)
                }
            }
        }
    }
    const releaseAt = new Map<number, Set<number>>()
    const reachCache = new Map<number, Set<number>>()
    function reachable(id: number): Set<number> {
        const known = reachCache.get(id)
        if (known) return known
        const out = new Set<number>()
        reachCache.set(id, out)
        const n = g.nodes.get(id)
        if (n) {
            for (const a of getArgIds(n)) {
                if (!a) continue
                out.add(a)
                for (const x of reachable(a)) out.add(x)
            }
        }
        return out
    }
    const narrowsAt = new Map<number, Set<number>>()
    for (const b of g.blocks) {
        function forkPath(at: number, live: Set<number>): void {
            const n = g.nodes.get(at)
            if (!n) return
            if (n.op === 'after') { forkPath(getRef(n, countIds(n)-1), live); return }
            if (n.op !== 'select') return
            const asking = new Set<number>(live)
            for (const x of reachable(getRef(n, 0))) asking.add(x)
            if (getRef(n, 0)) asking.add(getRef(n, 0))
            for (const k of [1, 2]) {
                const arm = getRef(n, k)
                if (!arm) continue
                const wanted = reachable(arm)
                const dead = new Set<number>()
                for (const v of asking) {
                    if (v !== arm && !wanted.has(v) && usedBy.has(v)) dead.add(v)
                }
                if (dead.size) narrowsAt.set(arm, dead)
                const carried = new Set<number>()
                for (const v of asking) if (!dead.has(v)) carried.add(v)
                for (const x of wanted) carried.add(x)
                forkPath(arm, carried)
            }
        }
        forkPath(b.bodyId, new Set<number>(b.params))
    }

    const through = new Map<number, number>()
    const lastOn = new Map<number, Map<number, number>>()
    for (const b of g.blocks) {
        interface PathStep { value: number, fork?: number }
        function walkPath(at: number, steps: PathStep[]): void {
            const n = g.nodes.get(at)
            if (n && n.op === 'after' && hasStructuredTail(g, getRef(n, countIds(n) - 1))) {
                const next = [...steps]
                for (let i = 0; i < countIds(n) - 1; i++) next.push({ value: getRef(n, i) })
                walkPath(getRef(n, countIds(n) - 1), next)
                return
            }
            if (n && n.op === 'select') {
                const next = [...steps, { value: getRef(n, 0), fork: at }]
                walkPath(getRef(n, 1), next)
                walkPath(getRef(n, 2), next)
                return
            }
            const scheduled = new Set<number>()
            const order: number[] = []
            function schedule(id: number): void {
                if (!id || scheduled.has(id)) return
                scheduled.add(id)
                const n = g.nodes.get(id)
                if (!n) return
                for (const i of operandOrder.get(id) ?? []) schedule(getRef(n, i))
                order.push(id)
            }
            for (const step of steps) {
                schedule(step.value)
                const fork = step.fork
                if (fork && !scheduled.has(fork)) { scheduled.add(fork); order.push(fork) }
            }
            schedule(at)
            if (opts?.debug) console.log('path order', order.join(' '))
            const predicated = new Set<number>()
            for (const step of steps) if (step.fork) predicated.add(step.fork)
            const last = new Map<number, number>()
            for (const site of order) {
                through.set(site, (through.get(site) ?? 0) + 1)
                const n = g.nodes.get(site)
                if (n?.op === 'select' && predicated.has(site)) {
                    if (getRef(n, 0)) last.set(getRef(n, 0), site)
                    continue
                }
                for (const v of demands.get(site) ?? []) last.set(v, site)
            }
            for (const [v, site] of last) {
                if (v === at) continue
                let tally = lastOn.get(site)
                if (!tally) lastOn.set(site, tally = new Map<number, number>())
                tally.set(v, (tally.get(v) ?? 0) + 1)
            }
        }
        walkPath(b.bodyId, [])
    }
    for (const [site, tally] of lastOn) {
        const every = through.get(site) ?? 0
        for (const [v, seen] of tally) {
            if (seen < every) continue
            const here = releaseAt.get(site)
            if (here) here.add(v)
            else releaseAt.set(site, new Set<number>([v]))
        }
    }

    return {
        inArgPos,
        inStatePos,
        returnsAt,
        pure,
        shouldSpillUntil,
        blockOrder,
        releaseAt,
        narrowsAt,
        usedBy,
        operandOrder,
        reverseOrder,
        callsUnderValue: callsUnderCache,
        rotated,
    }
}

export function rematerializeValues(g: Graph, analysis = analyzeValueGraph(g)): Graph | undefined {
    const MAX_COST = 1
    const costs = new Map<number, number>()
    function cost(id: number): number {
        if (!id) return 0
        const known = costs.get(id)
        if (known !== undefined) return known
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id) || !analysis.pure.has(id) || n.op === 'select') return MAX_COST + 1
        if ((n.op === 'convert' || n.op === 'bitconvert') && getRef(n, 0)) {
            const inner = g.nodes.get(getRef(n, 0))
            if (inner && (inner.op === 'shl' || inner.op === 'shr' || inner.op === 'ushr')
                && !getRef(inner, 1)) {
                costs.set(id, 1)
                costs.set(getRef(n, 0), 1)
                return 1
            }
        }
        let c = 1
        const immediate = n.op === 'add' || n.op === 'sub' || n.op === 'shl'
            || n.op === 'shr' || n.op === 'ushr' || CompareOps.has(n.op)
        if (!immediate) {
            for (let i = 0; i < countIds(n); i++) if (!getRef(n, i)) c++
        }
        costs.set(id, c)
        for (const a of getArgIds(n)) {
            if (!a || !g.nodes.has(a) || isParam(g.nodes, a)) continue
            c += cost(a)
            if (c > MAX_COST) break
        }
        costs.set(id, c)
        return c
    }

    let nextId = g.maxId

    let nodes: Map<number, GraphNode> | undefined
    function writable(): Map<number, GraphNode> {
        if (nodes) return nodes
        nodes = new Map<number, GraphNode>()
        for (const [id, n] of g.nodes) {
            nodes.set(id, copyNode(n, cloneRefs(n), cloneLiterals(n)))
        }
        return nodes
    }
    function cloneValue(id: number, boundary: number, into: Map<number, GraphNode>, memo: Map<number, number>): number {
        const known = memo.get(id)
        if (known !== undefined) return known
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id) || !analysis.pure.has(id) || n.op === 'select' || cost(id) > MAX_COST) {
            const ordered = nextId++
            memo.set(id, ordered)
            into.set(ordered, makeNode('after', [boundary, id], new Float64Array(2)))
            return ordered
        }
        const clone = nextId++
        memo.set(id, clone)
        const args = cloneRefs(n)
        for (let i = 0; i < args.length; i++) {
            if (args[i]) args[i] = cloneValue(args[i], boundary, into, memo)
        }
        into.set(clone, copyNode(n, args, cloneLiterals(n)))
        return clone
    }
    function cloneModifier(id: number, into: Map<number, GraphNode>, memo: Map<number, number>): number {
        const known = memo.get(id)
        if (known !== undefined) return known
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id) || cost(id) > MAX_COST) return id
        const clone = nextId++
        memo.set(id, clone)
        const args = cloneRefs(n)
        for (let i = 0; i < args.length; i++) {
            if (args[i] && g.nodes.has(args[i]) && cost(args[i]) <= MAX_COST) {
                args[i] = cloneModifier(args[i], into, memo)
            }
        }
        into.set(clone, copyNode(n, args, cloneLiterals(n)))
        return clone
    }

    for (const [id, boundary] of analysis.shouldSpillUntil) {
        const n = g.nodes.get(id)
        const call = g.nodes.get(boundary)
        const uses = analysis.usedBy.get(id) ?? []
        const callRank = analysis.reverseOrder.get(boundary) ?? -1
        if (!n || isParam(g.nodes, id) || call?.op !== 'call' || uses.length < 2 || cost(id) > MAX_COST || callRank < 0) continue
        let hasEarlyUse = false
        for (const use of uses) {
            if ((analysis.reverseOrder.get(use) ?? -1) <= callRank) { hasEarlyUse = true; break }
        }
        if (!hasEarlyUse) continue
        const lateUses: number[] = []
        for (const use of new Set<number>(uses)) {
            if ((analysis.reverseOrder.get(use) ?? -1) <= callRank) continue
            if (!analysis.callsUnderValue.get(use)?.has(boundary)) continue
            lateUses.push(use)
        }
        if (!lateUses.length) continue
        const into = writable()
        const clone = cloneValue(id, boundary, into, new Map<number, number>())
        for (const use of lateUses) {
            const consumer = into.get(use)
            if (!consumer) continue
            for (let i = 0; i < countIds(consumer); i++) {
                if (getRef(consumer, i) === id) setRef(consumer, i, clone)
            }
        }
    }

    const selectConditions = new Set<number>()
    for (const n of g.nodes.values()) if (n.op === 'select' && getRef(n, 0)) selectConditions.add(getRef(n, 0))
    for (const [id] of analysis.shouldSpillUntil) {
        if (cost(id) > MAX_COST) continue
        for (const use of new Set(analysis.usedBy.get(id) ?? [])) {
            if (!selectConditions.has(use)) continue
            const consumer = g.nodes.get(use)
            if (!consumer || !CompareOps.has(consumer.op)) continue
            const useRank = analysis.reverseOrder.get(use) ?? -1
            if (useRank < 0 || (analysis.usedBy.get(id) ?? []).some(other =>
                other !== use && (analysis.reverseOrder.get(other) ?? -1) < useRank)) continue
            const into = writable()
            const clone = cloneModifier(id, into, new Map<number, number>())
            const updated = into.get(use)!
            for (let i = 0; i < countIds(updated); i++) {
                if (getRef(updated, i) === id) setRef(updated, i, clone)
            }
        }
    }
    return nodes ? { ...g, maxId: nextId, nodes, blocks: g.blocks } : undefined
}

export function dumpGraph(g: Graph): string {
    const out: string[] = []
    if (g.name) {
        out.push(`--- vgraph for ${g.name} ---`)
    }
    for (const b of g.blocks) {
        out.push(`B${b.id}(${b.params.join(', ')})${b.consumesEffectToken ? ' [tok]' : ''} -> ${b.bodyId || b.bodyConst}`)
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'param' || n.op === 'block') return // noisy
            for (const a of getArgIds(n)) walk(a)
            const parts: string[] = []
            for (let i = 0; i < countIds(n); i++) {
                const cid = getRef(n, i)
                let missing = false
                if (cid) {
                    if (const c = g.nodes.get(cid)) {
                        if (c.op === 'block') {
                            parts.push(`B${cid}`)
                            continue
                        }
                    } else {
                        missing = true
                    }
                }
                parts.push(cid ? `%${cid}${missing ? '?' : ''}` : `#${getLiteral(n, i)}`)
            }
            const label = getDebugLabel(g, id)
            out.push(`  %${id} = ${n.op} ${parts.join(' ')}${label ? ' ' + label : ''}`)
        }
        walk(b.bodyId)
    }
    return out.join('\n')
}

export function dumpBlockGraph(g: Graph): string {
    const successors = new Map<number, number[]>()
    const blockIds = new Set<number>(g.blocks.map(b => b.id))
    for (const b of g.blocks) {
        const found = new Set<number>()
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'block') {
                if (blockIds.has(id)) found.add(id)
                return
            }
            for (const arg of getArgIds(n)) walk(arg)
        }
        walk(b.bodyId)
        successors.set(b.id, [...found])
    }

    const out: string[] = []
    if (g.name) out.push(`--- blocks for ${g.name} ---`)
    const expanded = new Set<number>()
    const active = new Set<number>()
    function render(id: number, prefix = '', branch = ''): void {
        if (active.has(id)) {
            out.push(`${prefix}${branch}B${id} (cycle)`)
            return
        }
        if (expanded.has(id)) {
            out.push(`${prefix}${branch}B${id} (seen)`)
            return
        }
        out.push(`${prefix}${branch}B${id}`)
        expanded.add(id)
        active.add(id)
        const next = successors.get(id) ?? []
        for (let i = 0; i < next.length; i++) {
            const last = i === next.length - 1
            render(next[i], prefix + (branch ? branch === '`-- ' ? '    ' : '|   ' : ''), last ? '`-- ' : '|-- ')
        }
        active.delete(id)
    }

    if (g.blocks.length) render(g.blocks[0].id)
    for (const b of g.blocks) {
        if (expanded.has(b.id)) continue
        if (out.length) out.push('')
        render(b.id)
    }
    return out.join('\n')
}

interface MiniBlock {
    key: number
    inputs: number[]
}

interface OutlineBlock {
    block: GraphBlock
    uses: Map<number, number>
    tails: number[]
    cut: Map<string, MiniBlock>
    closed: Map<string, MiniBlock>
    below: Map<number, Set<number>>
}

// XXX: need to refactor graph nodes, zzz...
function smuggledOperands(n: GraphNode): string {
    if (n.op === 'load' || n.op === 'store') return `:${getTypeT(n)}`
    if (n.op === 'convert' || n.op === 'bitconvert') return `:${getTypeT(n)}:${getTypeU(n)}`
    if (BinaryOps.has(n.op) || CompareOps.has(n.op)) {
        return lowering.isSignedType(getTypeT(n)) || lowering.isSignedType(getTypeU(n)) ? ':signed' : ''
    }
    return ''
}

function isArgless(n: GraphNode): boolean {
    if (n.op === 'param') return false
    for (const x of getArgIds(n)) if (x) return false
    return true
}

function outlineBlocks(g: Graph): Graph {
    const interned = new Map<string, number>()
    function intern(s: string): number {
        let k = interned.get(s)
        if (k === undefined) interned.set(s, k = interned.size + 1)
        return k
    }

    const infos = new Map<number, OutlineBlock>()
    const postOrder: OutlineBlock[] = []
    const appliesTo = new Map<number, number[]>()
    function enter(b: GraphBlock): void {
        if (infos.has(b.id)) return
        const info: OutlineBlock = { block: b, uses: new Map(), tails: [b.bodyId], cut: new Map(), closed: new Map(), below: new Map() }
        infos.set(b.id, info)
        const successors: number[] = []
        const epoch = nextEpoch(g)
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id) continue
            const n = g.nodes.get(id)
            if (!n || !markVisited(n, epoch)) continue
            if (n.op === 'apply') {
                successors.push(getRef(n, 0))
                let arr = appliesTo.get(getRef(n, 0))
                if (!arr) appliesTo.set(getRef(n, 0), arr = [])
                arr.push(id)
            }
            for (const x of getArgIds(n)) {
                if (!x) continue
                info.uses.set(x, (info.uses.get(x) ?? 0) + 1)
                stack.push(x)
            }
        }
        for (const id of info.tails) {
            const n = g.nodes.get(id)
            const next = n?.op === 'select' ? cloneRefs(n, 1) : n?.op === 'after' ? cloneRefs(n, -1) : []
            for (const x of next) if (x && info.uses.get(x) === 1) info.tails.push(x)
        }
        for (const s of successors) enter(getBlock(g, s)!)
        postOrder.push(info)
    }

    const classOf = new Map<number, number>()
    function isInput(info: OutlineBlock, id: number, cut: boolean): boolean {
        const n = g.nodes.get(id)!
        return n.op === 'param' || (cut && !isArgless(n) && !hasStructuredTail(g, id) && info.uses.get(id)! > 1)
    }
    function truncated(id: number, depth: number): boolean {
        return depth <= 1 && !isArgless(g.nodes.get(id)!) && !hasStructuredTail(g, id)
    }
    function mini(info: OutlineBlock, id: number, cut: boolean, depth = Infinity, conditional = false): MiniBlock {
        const memo = cut ? info.cut : info.closed
        const known = memo.get(`${id}:${depth}:${conditional}`)
        if (known) return known
        const n = g.nodes.get(id)!
        const orders = Commutative.has(n.op) && countIds(n) === 2 ? [[0, 1], [1, 0]]
            : n.op === 'apply' ? [applyOrder(n)] : [getArgIds(n).map((_, i) => i)]
        let best: { text: string, inputs: number[] } | undefined
        for (const order of orders) {
            const inputs: number[] = []
            function at(x: number): number {
                let i = inputs.indexOf(x)
                if (i < 0) inputs.push(x), i = inputs.length - 1
                return i
            }
            const parts: string[] = []
            for (const i of order) {
                const x = getRef(n, i)
                const u = x ? g.nodes.get(x) : undefined
                const arm = conditional || (n.op === 'select' && i > 0)
                if (!u) parts.push(`#${getLiteral(n, i)}`)
                else if (u.op === 'param' || (!arm && (isInput(info, x, cut) || truncated(x, depth)))) parts.push(`$${at(x)}`)
                else if (isArgless(u)) parts.push(u.op === 'block' ? `B${classOf.get(x) ?? `#${x}`}` : `${u.op}:${getArgConsts(u).join()}`)
                else if (cut && arm && info.uses.get(x)! > 1) parts.push(`!${x}`)
                else {
                    const m = mini(info, x, cut, arm ? Infinity : depth - 1, cut && arm)
                    parts.push(`${m.key}[${m.inputs.map(at).join()}]`)
                }
            }
            const text = `${n.op}${smuggledOperands(n)}(${parts.join(' ')})`
            if (!best || text < best.text) best = { text, inputs }
        }
        const out = { key: intern(best!.text), inputs: best!.inputs }
        memo.set(`${id}:${depth}:${conditional}`, out)
        return out
    }
    function applyOrder(n: GraphNode): number[] {
        const target = infos.get(getRef(n, 0))
        if (!target || !classOf.has(target.block.id)) return getArgIds(n).map((_, i) => i)
        const params = target.block.params
        const inputs = mini(target, target.block.bodyId, false).inputs.map(p => params.indexOf(p) + 1)
        const rest = params.map((_, i) => i + 1).filter(i => !inputs.includes(i))
        return [0, ...inputs, ...rest]
    }
    function below(info: OutlineBlock, id: number): Set<number> {
        const known = info.below.get(id)
        if (known) return known
        const out = new Set<number>()
        info.below.set(id, out)
        for (const x of getArgIds(g.nodes.get(id)!)) {
            const u = x ? g.nodes.get(x) : undefined
            if (!u || u.op === 'param' || isArgless(u)) continue
            out.add(x)
            for (const y of below(info, x)) out.add(y)
        }
        return out
    }
    function nested(info: OutlineBlock, inputs: number[]): boolean {
        for (const a of inputs) for (const b of inputs) if (a !== b && below(info, a).has(b)) return true
        return false
    }
    function tree(info: OutlineBlock, id: number, depth = Infinity, conditional = false, out = new Set<number>()): Set<number> {
        if (out.has(id)) return out
        out.add(id)
        const n = g.nodes.get(id)!
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            const u = x ? g.nodes.get(x) : undefined
            const arm = conditional || (n.op === 'select' && i > 0)
            if (!u || u.op === 'param' || isArgless(u)) continue
            if (!arm && (isInput(info, x, true) || truncated(x, depth))) continue
            tree(info, x, arm ? Infinity : depth - 1, arm, out)
        }
        return out
    }

    enter(g.blocks[0])

    const representative = new Map<number, OutlineBlock>()
    const merged = new Map<number, OutlineBlock>()
    for (const info of postOrder) {
        const b = info.block
        const body = g.nodes.get(b.bodyId)
        if (!body || body.op === 'param') continue
        const key = mini(info, b.bodyId, false).key
        classOf.set(b.id, key)
        if (b === g.blocks[0]) continue
        const prior = representative.get(key)
        if (prior) merged.set(b.id, prior)
        else representative.set(key, info)
    }

    const groups = new Map<number, [OutlineBlock, number, number][]>()
    for (const info of postOrder) {
        if (merged.has(info.block.id)) continue
        for (const id of info.tails) {
            const n = g.nodes.get(id)
            if (!n || n.op === 'param' || isArgless(n) || info.uses.get(id)! > 1) continue
            for (let depth = 1, size = 0; ; depth++) {
                const grown = tree(info, id, depth).size
                if (grown === size) break
                size = grown
                const m = mini(info, id, true, depth)
                if (nested(info, m.inputs)) continue
                const key = m.key
                let arr = groups.get(key)
                if (!arr) groups.set(key, arr = [])
                arr.push([info, id, depth])
            }
        }
    }

    const claimed = new Map<OutlineBlock, Set<number>>()
    const chosen: [OutlineBlock, number, number][][] = []
    const candidates = [...groups.values()].filter(sites => sites.length > 1)
        .map(sites => ({ sites, size: tree(sites[0][0], sites[0][1], sites[0][2]).size }))
        .sort((a, b) => ((b.sites.length - 1) * b.size - b.sites.length) - ((a.sites.length - 1) * a.size - a.sites.length))
    for (const { sites, size } of candidates) {
        const local = new Map<OutlineBlock, Set<number>>()
        const accepted = sites.filter(([info, id, depth]) => {
            let mine = local.get(info)
            if (!mine) local.set(info, mine = new Set())
            const taken = claimed.get(info)
            const nodes = tree(info, id, depth)
            for (const x of nodes) if (mine.has(x) || taken?.has(x)) return false
            for (const x of nodes) mine.add(x)
            return true
        })
        if (accepted.length < 2 || (accepted.length - 1) * size - accepted.length <= 0) continue
        for (const [info, nodes] of local) {
            let taken = claimed.get(info)
            if (!taken) claimed.set(info, taken = new Set())
            for (const x of nodes) taken.add(x)
        }
        chosen.push(accepted)
    }

    for (const [dup, rep] of merged) {
        const d = getBlock(g, dup)!
        const r = rep.block
        const dInputs = mini(infos.get(dup)!, d.bodyId, false).inputs
        const rInputs = mini(rep, r.bodyId, false).inputs
        for (const id of appliesTo.get(dup) ?? []) {
            const a = g.nodes.get(id)!
            const operands: (number | GraphNode)[] = [r.id]
            for (const p of r.params) {
                const at = rInputs.indexOf(p)
                const k = at < 0 ? -1 : d.params.indexOf(dInputs[at])
                operands.push(k < 0 ? literal(0) : getRef(a, k + 1) || literal(getLiteral(a, k + 1)))
            }
            g.nodes.set(id, g.nodes.get(createNode(g, 'apply', operands, a))!)
        }
    }

    const replacements = new Map<OutlineBlock, Map<number, number>>()
    for (const sites of chosen) {
        const [first, root, depth] = sites[0]
        const inside = tree(first, root, depth)
        const cloned = new Map<number, number>()
        const params = mini(first, root, true, depth).inputs.map(x => {
            const p = createNode(g, 'param', [])
            cloned.set(x, p)
            return p
        })
        function clone(id: number): number {
            if (!inside.has(id)) return cloned.get(id) ?? id
            const known = cloned.get(id)
            if (known) return known
            const n = g.nodes.get(id)!
            const argIds = getArgIds(n).map(x => x && clone(x))
            const copy = g.maxId++
            g.nodes.set(copy, copyNode(n, argIds, cloneLiterals(n)))
            cloned.set(id, copy)
            return copy
        }
        const blockId = createNode(g, 'block', [])
        addGraphBlock(g, { id: blockId, params, bodyId: clone(root), bodyConst: 0 })
        for (const [info, id, d] of sites) {
            let m = replacements.get(info)
            if (!m) replacements.set(info, m = new Map())
            m.set(id, createNode(g, 'apply', [blockId, ...mini(info, id, true, d).inputs]))
        }
    }
    for (const [info, m] of replacements) info.block.bodyId = replaceAll(g, info.block.bodyId, m)
    return g
}

function countUses(g: Graph, root: number): Map<number, number> {
    const uses = new Map<number, number>()
    const epoch = nextEpoch(g)
    const stack = [root]
    while (stack.length) {
        const id = stack.pop()!
        if (!id) continue
        const n = g.nodes.get(id)
        if (!n || !markVisited(n, epoch)) continue
        for (const x of getArgIds(n)) {
            if (!x) continue
            uses.set(x, (uses.get(x) ?? 0) + 1)
            stack.push(x)
        }
    }
    return uses
}

function retFor(g: Graph, exits: Map<number, number>, n: GraphNode, operand: (id: number) => number): GraphNode {
    const at = exits.get(getRef(n, 0))!
    const ret = g.nodes.get(g.blocks.find(x => x.id === getRef(n, 0))!.bodyId)!
    return copyNode(ret, [at < 0 ? 0 : operand(getRef(n, at + 1))],
        new Float64Array([at < 0 ? getLiteral(ret, 0) : getLiteral(n, at + 1)]))
}

function outlineArm(g: Graph, uses: Map<number, number>, arm: number, exits = new Map<number, number>()): number {
    const inside = new Set<number>()
    const refs = new Map<number, number>()
    function take(id: number): void {
        inside.add(id)
        for (const x of getArgIds(g.nodes.get(id)!)) {
            if (!x || inside.has(x)) continue
            const k = (refs.get(x) ?? 0) + 1
            refs.set(x, k)
            const u = g.nodes.get(x)!
            if (u.op === 'param' || u.op === 'block' || u.op === 'call') continue
            if (k === uses.get(x) || hasStructuredTail(g, x)) take(x)
        }
    }
    take(arm)
    for (const id of inside) {
        const n = g.nodes.get(id)!
        const effects = n.op === 'after' ? cloneRefs(n, 0, -1)
            : n.op === 'load' || n.op === 'store' || n.op === 'call' ? cloneRefs(n, 0, 1) : []
        if (effects.some(x => x && !inside.has(x) && !isArgless(g.nodes.get(x)!))) return 0
    }
    const params: number[] = []
    const inputs: number[] = []
    const cloned = new Map<number, number>()
    function clone(id: number): number {
        if (!id) return id
        const known = cloned.get(id)
        if (known) return known
        const n = g.nodes.get(id)!
        if (!inside.has(id) && isArgless(n)) return id
        const copy = g.maxId++
        if (!inside.has(id)) {
            g.nodes.set(copy, makeNode('param', [], new Float64Array(0)))
            params.push(copy)
            inputs.push(id)
        } else if (n.op === 'apply' && exits.has(getRef(n, 0))) {
            g.nodes.set(copy, retFor(g, exits, n, clone))
        } else {
            g.nodes.set(copy, copyNode(n, getArgIds(n).map(clone), cloneLiterals(n)))
        }
        cloned.set(id, copy)
        return copy
    }
    const blockId = createNode(g, 'block', [])
    addGraphBlock(g, { id: blockId, params, bodyId: clone(arm), bodyConst: 0 })
    return createNode(g, 'apply', [blockId, ...inputs])
}

export function cloneExits(g: Graph): Graph {
    const exits = new Map<number, number>()
    for (const b of g.blocks) {
        const ret = g.nodes.get(b.bodyId)
        if (ret?.op !== 'ret') continue
        const at = b.params.indexOf(getRef(ret!, 0))
        if (at >= 0 || !getRef(ret!, 0)) exits.set(b.id, at)
    }
    if (!exits.size) return g
    for (const b of g.blocks.slice()) {
        if (exits.has(b.id)) continue
        const uses = countUses(g, b.bodyId)
        function walk(id: number): void {
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'after') return walk(getRef(n, countIds(n) - 1))
            if (n.op === 'apply' && exits.has(getRef(n, 0))) {
                g.nodes.set(id, retFor(g, exits, n, x => x))
                return
            }
            if (n.op !== 'select') return
            for (let i = 1; i < countIds(n); i++) {
                const arm = getRef(n, i)
                const t = g.nodes.get(tailOf(g, arm))
                const at = t?.op === 'apply' ? exits.get(getRef(t, 0)) : undefined
                const returned = at !== undefined && at >= 0 ? g.nodes.get(getRef(t!, at + 1)) : undefined
                const outlined = at !== undefined && returned?.op !== 'call' && uses.get(arm) === 1 ? outlineArm(g, uses, arm, exits) : 0
                if (outlined) setRef(n, i, outlined)
                else walk(arm)
            }
        }
        walk(b.bodyId)
    }
    return g
}

function checkCreationOrder(g: Graph, stage: string, known: Set<string>) {
    const seen = new Set<number>()
    const stack: number[] = []
    const found: string[] = []
    for (const b of g.blocks) stack.push(b.bodyId)
    while (stack.length) {
        const id = stack.pop()!
        if (!id || seen.has(id)) continue
        seen.add(id)
        const n = g.nodes.get(id)
        if (!n) continue
        for (const a of getArgIds(n)) {
            if (!a) continue
            stack.push(a)
            if (a < id) continue
            const u = g.nodes.get(a)
            if (!u || getArgIds(u).every(x => !x)) continue
            const key = `${id}:${a}`
            if (known.has(key)) continue
            known.add(key)
            found.push(`%${id} = ${n.op} uses %${a} = ${u.op}`)
        }
    }
    if (!found.length) return
    console.log(`creation order: ${g.name || '<anonymous>'} after ${stage}: ${found.length} new\n  ${found.slice(0, 8).join('\n  ')}`)
}

function removeOrderingParams(g: Graph): Graph {
    const tokens = new Map<number, number>()
    const tokenBlocks = new Set<number>()
    for (const b of g.blocks) {
        if (!b.consumesEffectToken) continue
        tokens.set(b.params[b.params.length - 1], createNode(g, 'nil-effect', [literal(b.id)]))
        tokenBlocks.add(b.id)
        b.consumesEffectToken = false
    }
    if (tokens.size) {
        for (const b of g.blocks) b.bodyId = replaceAll(g, b.bodyId, tokens)
    }
    detachRecordOrdering(g, tokenBlocks)
    return g
}

function checkCaptures(g: Graph) {
    if (!intrinsics.argv().includes('check-captures')) return
    const owners = new Map<number, number>()
    for (const b of g.blocks) for (const p of b.params) owners.set(p, b.id)

    const succs = new Map<number, Set<number>>()
    const used = new Map<number, Set<number>>()
    let targets = new Set<number>()
    let params = new Set<number>()
    let epoch = 0
    function scan(n: GraphNode, id: number) {
        if (!markVisited(n, epoch)) return
        if (n.op === 'block') {
            targets.add(id)
            return
        }
        if (n.op === 'param') {
            params.add(id)
            return
        }
        forEachOperand(g, id, scan)
    }
    for (const b of g.blocks) {
        targets = new Set<number>()
        params = new Set<number>()
        epoch = nextEpoch(g)
        succs.set(b.id, targets)
        used.set(b.id, params)
        if (const body = g.nodes.get(b.bodyId)) scan(body, b.bodyId)
    }

    const entry = g.blocks[0].id
    const order: number[] = []
    const seen = new Set<number>([entry])
    const pending = [entry]
    while (pending.length) {
        const id = pending.pop()!
        order.push(id)
        for (const s of succs.get(id) ?? []) {
            if (seen.has(s)) continue
            seen.add(s)
            pending.push(s)
        }
    }
    const preds = new Map<number, number[]>()
    for (const id of order) preds.set(id, [])
    for (const id of order) {
        for (const s of succs.get(id) ?? []) {
            if (seen.has(s)) preds.get(s)!.push(id)
        }
    }
    const dominators = new Map<number, Set<number>>()
    for (const id of order) dominators.set(id, new Set<number>(id === entry ? [entry] : order))
    let changed = true
    while (changed) {
        changed = false
        for (const id of order) {
            if (id === entry) continue
            const incoming = preds.get(id)!
            if (!incoming.length) continue
            const next = new Set<number>()
            for (const x of dominators.get(incoming[0])!) {
                let all = true
                for (let i = 1; i < incoming.length; i++) {
                    if (dominators.get(incoming[i])!.has(x)) continue
                    all = false
                    break
                }
                if (all) next.add(x)
            }
            next.add(id)
            if (next.size === dominators.get(id)!.size) continue
            dominators.set(id, next)
            changed = true
        }
    }

    for (const id of order) {
        for (const p of used.get(id) ?? []) {
            const owner = owners.get(p)
            if (owner === undefined || owner === id) continue
            if (dominators.get(id)!.has(owner)) continue
            console.log(dumpGraph(g))
            throw `lowering2: ${g.name || '<anonymous>'} impossible capture of %${p} owned by B${owner} used in B${id}`
        }
    }
}

export function normalizeValueGraph(g: Graph): Graph {
    const profile = intrinsics.argv().includes('graph-transform-cost')
    const profileThresh = 1 // ms, only affects display
    const totals = new Map<string, number>()
    function updateTotal(name: string, amt: number) {
        totals.set(name, (totals.get(name) ?? 0) + amt)
    }
    const debugTransform = intrinsics.argv().includes(`graph-debug:${g.name}`)
    function run(transform: (g: Graph) => Graph | undefined, name = transform.name): void {
        if (debugTransform) {
            console.log(`before transform: ${name}\n`, dumpGraph(g))
        }
        if (!profile) {
            const start = performance.now()
            g = transform(g) ?? g
            if (optimizeTimers) optimizeTimers.set(`normalize:${name}`, (optimizeTimers.get(`normalize:${name}`) ?? 0) + performance.now() - start)
            checkOrder(name)
            checkCaptures(g)
            return
        }
        const beforeNodes = g.nodes.size
        const start = (performance as any).now()
        g = transform(g) ?? g
        const elapsed = (performance as any).now() - start
        updateTotal(name, elapsed)
        if (elapsed >= profileThresh) {
            console.log('graph transform cost', g.name || '<anonymous>', name,
                `${elapsed.toFixed(3)}ms`, `${beforeNodes}->${g.nodes.size}`)
        }
        checkOrder(name)
    }
    const orderViolations = intrinsics.argv().includes('check-creation-order') ? new Set<string>() : undefined
    function checkOrder(stage: string) {
        if (orderViolations) checkCreationOrder(g, stage, orderViolations)
    }
    checkCaptures(g)
    const normalizeStart = performance.now()
    checkOrder('trace')
    run(inlineBlocks)
    run(removeOrderingParams)
    run(flattenRecords)
    run(packageBlocksFINAL)
    run(specializeBlockApplications)
    run(optimizeValueGraph)
    run(outlineBlocks)
    run(cloneExits)

    // validate
    {
        const epoch = nextEpoch(g)
        function visit(n: GraphNode, id: number) {
            if (n.op === 'block') {
                if (!markVisited(n, epoch)) return
                forEachOperand(g, getBlock(g, id)!.bodyId, visit)
                return
            }
            if (n.op === 'heap-handle') {
                const handle = !getRef(n, 0) ? getLiteral(n, 0) : '?'
                console.log(dumpGraph(g))
                throw `lowering2: unresolved heap handle ${handle} at %${id}`
            }
            forEachOperand(g, id, visit)
        }
        if (intrinsics.argv().includes('check-heap-handles')) {
            forEachOperand(g, g.blocks[0].bodyId, visit)
        }
    }

    if (profile) {
        let t = 0
        for (const [k, v] of totals) {
            t += v
            if (v < profileThresh) continue
            console.log(`  ${k}: ${v.toFixed(3)}ms`)
        }
        if (t >= profileThresh) console.log(`  TOTAL (${g.name}): ${t.toFixed(3)}ms`)
    }

    if (optimizeTimers) optimizeTimers.set('normalize:(total)', (optimizeTimers.get('normalize:(total)') ?? 0) + performance.now() - normalizeStart)
    return g
}

export function lowerValueGraph(g: Graph, opts: LowerGraphOptions = {}): LowerGraphResult {
    if (!opts.skipNormalized) g = normalizeValueGraph(g)

    const target = opts.target ?? lowering.aarch64
    const asm = target.createAssembler()
    let analysis = analyzeValueGraph(g, opts)
    const rematerialized = rematerializeValues(g, analysis)
    if (rematerialized) {
        g = rematerialized
        analysis = analyzeValueGraph(g, opts)
    }
    if (opts?.debug) {
        console.log(dumpGraph(g))
        const sets = (m: Map<number, Set<number>>) => [...m]
            .map(([at, values]) => `${at}:${[...values].join(',')}`).join(' ')
        console.log('release at', sets(analysis.releaseAt))
        console.log('narrow at', sets(analysis.narrowsAt))
        console.log('spill until', [...analysis.shouldSpillUntil]
            .map(([value, at]) => `${value}:${at}`).join(' '))
    }

    const acrossCall = analysis.shouldSpillUntil
    const inArgPos = analysis.inArgPos
    const inStatePos = analysis.inStatePos
    const pure = analysis.pure
    const order = analysis.blockOrder
    const releaseAt = analysis.releaseAt
    const narrowsAt = analysis.narrowsAt
    const callContexts: number[] = []
    for (const [id, n] of g.nodes) if (n.op === 'call-context') callContexts.push(id)

    const budget = opts.regBudget === undefined ? Infinity : Math.max(2, opts.regBudget)
    const allocatable: number[] = []
    const readsIndirectContext = [...g.nodes.values()].some(n => n.op === 'call-context')
    for (const r of target.allocatable) {
        if (target.scratch.indexOf(r) >= 0) continue
        if (readsIndirectContext && r === target.indirectContextReg) continue
        allocatable.push(r)
    }
    const volatiles: number[] = allocatable.slice(0, budget === Infinity ? allocatable.length : budget)
    // caller saved non-args first
    const spread: number[] = []
    for (const r of volatiles) if (target.argRegs.indexOf(r) < 0) spread.push(r)
    for (const r of volatiles) if (target.argRegs.indexOf(r) >= 0) spread.push(r)
    const preserved: number[] = []
    for (const r of target.calleeSaved) {
        if (preserved.length >= budget) continue
        preserved.push(r)
    }
    const CALLEE = target.scratch[1]
    const SWAP = target.scratch[0]
    const usedPreserved = new Set<number>()
    let callsOut = false
    const tails = new Set<number>()
    let tailCalls = false
    let reachesExit = false
    function isPreserved(r: number): boolean { return target.calleeSaved.indexOf(r) >= 0 }

    const OPEN = 1 << 30
    function isSlot(h: number): boolean { return h < 0 }
    let slotCount = 0
    const reusableSlots = new Set<number>()
    let frameBase = 0
    function slotOffset(h: number): number { return frameBase + (-h - 1) * 8 }
    function takeSlot(): number {
        const reused = reusableSlots.values().next()
        if (!reused.done) {
            reusableSlots.delete(reused.value)
            return reused.value
        }
        slotCount++
        return -slotCount
    }

    interface EmitRegion {
        parent?: EmitRegion
        children: EmitRegion[]
        writes: Set<number>
        owned: number[]
        exitLabel: number
        group: number
    }
    const rootRegion: EmitRegion = {
        children: [], writes: new Set(), owned: [], exitLabel: -1, group: -1,
    }
    let currentRegion = rootRegion
    let currentBlock = 0
    let nextRegionGroup = 0
    interface ReleaseEvent { released: { value: number, home: number }[] }
    interface TransferEvent {
        dst: number
        src: number
        consumed?: { value: number, home: number }
    }
    const code: ((() => void) | ReleaseEvent | TransferEvent)[] = []
    function put(fn: () => void): void { code.push(fn) }
    function transfer(dst: number, src: number, consumed?: { value: number, home: number }): void {
        if (!Number.isInteger(dst) || dst === OPEN || dst > 31) {
            console.log(dumpGraph(g))
            throw `lowering3: invalid transfer destination ${dst} while queuing %${materializing} in B${currentBlock}`
        }
        if (!Number.isInteger(src) || src === OPEN || src > 31) {
            console.log(dumpGraph(g))
            throw `lowering3: invalid transfer source ${src} while queuing %${materializing} in B${currentBlock}`
        }
        code.push({ dst, src, consumed })
    }

    const homeOf = new Map<number, number>()
    const heldBy = new Map<number, number>()
    const done = new Set<number>()
    const temporariesAt = new Map<number, number[]>()
    const freedAt = new Map<number, number>()
    let materializing = 0
    let synth = 0


    const NOTHING = new Set<number>()
    function bind(id: number, reg: number): number {
        if (opts.debug) console.log('home +', id, reg, 'at', materializing, 'over', heldBy.get(reg) ?? '-')
        homeOf.set(id, reg)
        heldBy.set(reg, id)
        if (isPreserved(reg)) {
            usedPreserved.add(reg)
            currentRegion.writes.add(reg)
        }
        return reg
    }
    function place(id: number, home: number): void {
        if (isSlot(home)) {
            reusableSlots.delete(home)
            homeOf.set(id, home)
        }
        else bind(id, home)
    }
    function freeValue(v: number, site = materializing): void {
        const home = homeOf.get(v)
        if (home === undefined) return
        if (opts.debug) console.log('home -', v, home, 'at', site)
        homeOf.delete(v)
        freedAt.set(v, site)
        if (!isSlot(home) && heldBy.get(home) === v) heldBy.delete(home)
    }
    function finish(id = materializing): void {
        done.add(id)
        const released: { value: number, home: number }[] = []
        function release(v: number): void {
            const home = homeOf.get(v)
            if (home !== undefined) {
                released.push({ value: v, home })
                freeValue(v, id)
            }
        }
        for (const v of releaseAt.get(id) ?? []) release(v)
        for (const v of temporariesAt.get(id) ?? []) release(v)
        temporariesAt.delete(id)
        if (released.length) code.push({ released })
    }

    function narrowTo(root: number): void {
        for (const v of narrowsAt.get(root) ?? []) freeValue(v, root)
    }
    function freeReg(pool: number[], avoid: Set<number>): number {
        for (const r of pool) if (!heldBy.has(r) && !avoid.has(r)) return r
        for (const r of pool) {
            const v = heldBy.get(r)
            if (v === undefined || avoid.has(r)) continue
            const slot = takeSlot()
            transfer(slot, r)
            homeOf.set(v, slot)
            heldBy.delete(r)
            return r
        }
        return -1
    }
    const avoidsArgRegs = new Set<number>()
    for (const [id, uses] of analysis.usedBy) {
        if (uses.length < 2 || acrossCall.has(id)) continue
        if (inArgPos.has(id) || analysis.inStatePos.has(id)) continue
        avoidsArgRegs.add(id)
    }
    function regFor(id: number, want: number): number {
        const first = acrossCall.has(id) ? preserved
            : avoidsArgRegs.has(id) ? spread : volatiles
        const second = first === preserved ? volatiles : preserved
        if (want >= 0) {
            const willRelease = releaseAt.get(id)?.has(heldBy.get(want) ?? 0)
            if (!heldBy.has(want) && (first.indexOf(want) >= 0 || first !== preserved)) {
                return bind(id, want)
            }
            if (willRelease && (first.indexOf(want) >= 0 || first !== preserved)) {
                return bind(id, want)
            }
        }
        let r = freeReg(first, NOTHING)
        if (r < 0) r = freeReg(second, NOTHING)
        if (r < 0) throw 'lowering3: out of registers'
        return bind(id, r)
    }
    function at(v: number, avoid: Set<number>): number {
        const home = homeOf.get(v)
        if (home === undefined) {
            console.log(dumpGraph(g), materializing)
            throw `lowering3: value ${v} is not live`
        }
        if (!isSlot(home)) return home
        const first = acrossCall.has(v) ? preserved : volatiles
        const second = first === preserved ? volatiles : preserved
        let r = freeReg(first, avoid)
        if (r < 0) r = freeReg(second, avoid)
        if (r < 0) throw 'lowering3: out of registers'
        transfer(r, home)
        reusableSlots.add(home)
        return bind(v, r)
    }
    interface Snapshot { homes: number[][], held: number[][], ran: number[] }
    function snapshot(): Snapshot {
        const homes: number[][] = []
        for (const [k, v] of homeOf) homes.push([k, v])
        const held: number[][] = []
        for (const [k, v] of heldBy) held.push([k, v])
        return { homes, held, ran: [...done] }
    }
    function restore(s: Snapshot): void {
        homeOf.clear()
        for (const e of s.homes) homeOf.set(e[0], e[1])
        heldBy.clear()
        for (const e of s.held) heldBy.set(e[0], e[1])
        reusableSlots.clear()
        const occupied = new Set<number>()
        for (const h of homeOf.values()) if (isSlot(h)) occupied.add(h)
        for (let i = 1; i <= slotCount; i++) if (!occupied.has(-i)) reusableSlots.add(-i)
        done.clear()
        for (const v of s.ran) done.add(v)
    }

    interface Move { dst: number, src: number }
    function shuffle(moves: Move[]): void {
        const scratch = moves.some(m => isSlot(m.dst)) ? CALLEE : SWAP
        const pending: Move[] = []
        for (const m of moves) if (m.dst !== m.src) pending.push(m)
        while (pending.length) {
            let ready = -1
            for (let i = 0; i < pending.length && ready < 0; i++) {
                let blocked = false
                for (let j = 0; j < pending.length; j++) {
                    if (i !== j && pending[j].src === pending[i].dst) { blocked = true; break }
                }
                if (!blocked) ready = i
            }
            if (ready < 0) {
                const stuck = pending[0].src
                transfer(scratch, stuck)
                for (const m of pending) if (m.src === stuck) m.src = scratch
                continue
            }
            const m = pending.splice(ready, 1)[0]
            transfer(m.dst, m.src)
        }
    }

    let nextLabel = 0
    for (const b of g.blocks) if (b.id >= nextLabel) nextLabel = b.id + 1
    const exitLabel = nextLabel++
    rootRegion.exitLabel = exitLabel
    const entryLabels = new Map<number, number>()
    for (const [k, v] of analysis.rotated) {
        entryLabels.set(v, nextLabel++)
    }
    const savedIndex = new Map<number, number>()

    function regionExit(region: EmitRegion | undefined): number {
        while (region && region !== rootRegion && !region.owned.length) region = region.parent
        return region && region !== rootRegion ? region.exitLabel : exitLabel
    }

    function jumpToExit(tail = 0): void {
        const region = currentRegion
        put(() => {
            if (tailCalls && tails.has(tail)) return
            reachesExit = true
            asm.jump(regionExit(region))
        })
    }

    const sig = new Map<number, number[]>()
    const inbound = new Map<number, GraphNode[]>()
    {
        const seen = new Set<number>()
        const stack = order.map(id => getBlock(g, id)!.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) continue
            if (n.op === 'apply') {
                let arr = inbound.get(getRef(n, 0))
                if (!arr) inbound.set(getRef(n, 0), arr = [])
                arr.push(n)
            }
            for (const x of getArgIds(n)) stack.push(x)
        }
    }
    const forwards = (b: GraphBlock) => g.nodes.get(b.bodyId)?.op === 'apply'
    const assignOrder: number[] = []
    for (const id of order.slice().reverse()) if (!forwards(getBlock(g, id)!)) assignOrder.push(id)
    for (const id of order.slice().reverse()) if (forwards(getBlock(g, id)!)) assignOrder.push(id)
    for (const id of assignOrder) {
        const b = getBlock(g, id)!
        const taken = new Set<number>()
        const inherits = new Set<number>()
        for (const n of inbound.get(id) ?? []) {
            for (let i = 0; i < b.params.length; i++) {
                if (acrossCall.has(getRef(n, i + 1))) inherits.add(i)
            }
        }
        const fixed = new Map<number, number>()
        outer: for (let i = 0; i < b.params.length; i++) {
            const p = b.params[i]
            if (id === g.blocks[0].id) {
                fixed.set(i, target.argRegs[i])
                continue
            }
            for (const at of inStatePos.get(p) ?? []) {
                if (at[1] === -1) { 
                    fixed.set(i, target.retReg)
                    continue outer 
                }
            }
            for (const at of inArgPos.get(p) ?? []) {
                const n = g.nodes.get(at[0])!
                if (n.op === 'call') {
                    if ((inbound.get(id)?.length ?? 0) > 1) continue
                    const callee = g.nodes.get(getRef(n, 1))
                    const regs = callee?.op === 'syscall-target' ? target.syscall.argRegs : target.argRegs
                    fixed.set(i, regs[at[1]])
                    break
                }
                const home = sig.get(getRef(n, 0))?.[at[1]]
                if (home !== undefined && home !== OPEN) { fixed.set(i, home); break }
            }
        }
        const homes: number[] = []
        for (let i = 0; i < b.params.length; i++) {
            const p = b.params[i]
            const safe = acrossCall.has(p)
            let r = -1
            const fixedHome = fixed.get(i)
            if (fixedHome !== undefined && isSlot(fixedHome) && !taken.has(fixedHome)) {
                homes.push(fixedHome)
                taken.add(fixedHome)
                continue
            }
            const wanted = fixedHome ?? -1
            if (wanted >= 0 && (!safe || isPreserved(wanted)) && !taken.has(wanted)) r = wanted
            if (r < 0 && !safe && !inherits.has(i)) { homes.push(OPEN); continue }
            if (r < 0) {
                const pool = safe || inherits.has(i) ? preserved : volatiles
                for (const c of pool) if (!taken.has(c)) { r = c; break }
            }
            if (r < 0) for (const c of preserved) if (!taken.has(c)) { r = c; break }
            if (r < 0 && !safe) for (const c of volatiles) if (!taken.has(c)) { r = c; break }
            if (r < 0) { homes.push(takeSlot()); continue }
            taken.add(r)
            homes.push(r)
            if (isPreserved(r)) {
                usedPreserved.add(r)
                rootRegion.writes.add(r)
            }
        }
        sig.set(id, homes)
    }
    const passesTo = new Map<number, number>()
    for (const b of g.blocks) {
        const body = g.nodes.get(b.bodyId)
        if (!body || body.op !== 'select' || !sig.has(b.id)) continue
        const cond = g.nodes.get(getRef(body, 0))
        const simple = isParam(g.nodes, getRef(body, 0))
            || (!!cond && CompareOps.has(cond.op) && getArgIds(cond).every(x => !x || isParam(g.nodes, x)))
        if (!simple) continue
        for (const arm of cloneRefs(body, 1)) {
            const n = g.nodes.get(tailOf(g, arm))
            if (!n || n.op !== 'apply' || getRef(n, 0) === b.id || !sig.has(getRef(n, 0))) continue
            if (countIds(n) !== b.params.length + 1 || !b.params.every((p, i) => getRef(n, i + 1) === p)) continue
            passesTo.set(b.id, getRef(n, 0))
            break
        }
    }
    for (const id of passesTo.keys()) {
        const seen = new Set([id])
        let root = passesTo.get(id)!
        while (passesTo.has(root) && !seen.has(root)) {
            seen.add(root)
            root = passesTo.get(root)!
        }
        sig.set(id, sig.get(root)!)
    }

    function demand(id: number, konst: number, want = -1): number {
        if (!id) {
            const k = --synth
            let temps = temporariesAt.get(materializing)
            if (!temps) temporariesAt.set(materializing, temps = [])
            temps.push(k)
            let r = freeReg(volatiles, NOTHING)
            if (r < 0) r = freeReg(preserved, NOTHING)
            if (r < 0) throw 'lowering3: out of registers'
            bind(k, r)
            put(() => asm.movImm(r, konst))
            return k
        }
        const n = g.nodes.get(id)
        if (n?.op === 'void') return 0
        if (!homeOf.has(id)) {
            if (isParam(g.nodes, id)) {
                throw `lowering3: parameter ${id} was released at ${freedAt.get(id)} before rematerializing ${materializing} (freed at ${freedAt.get(materializing)})\n${dumpGraph(g)}`
            }
            if (done.has(id) && (n?.op === 'store'
                || (n?.op === 'after' && g.nodes.get(getRef(n, countIds(n) - 1))?.op === 'void'))) return 0
            if (done.has(id)) {
                console.log(dumpGraph(g), id, g.nodes.get(id))
            }
            assert(!done.has(id))
            build(id, want)
            if ((n?.op === 'after' || n?.op === 'store') && !homeOf.has(id)) return 0
        }
        return id
    }

    function orderedOperands(site: number, wanted: number[]): number[] {
        const out: number[] = []
        const remaining = new Set<number>(wanted)
        for (const i of analysis.operandOrder.get(site) ?? []) {
            if (!remaining.delete(i)) continue
            out.push(i)
        }
        for (const i of wanted) if (remaining.has(i)) out.push(i)
        return out
    }

    function orderingOperands(site: number, n: GraphNode): number[] {
        return orderedOperands(site, cloneRefs(n, 0, -1).map((_, i) => i))
    }

    function build(id: number, want = -1): void {
        const outer = materializing
        if (opts.debug) console.log('build', id, 'from', outer)
        materializing = id
        defer materializing = outer
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id)) throw `lowering3: no definition for value ${id} while materializing ${materializing}`
        const signed = lowering.isSignedType(getTypeT(n)) || lowering.isSignedType(getTypeU(n))

        if (n.op === 'call') { buildCall(id, n); return }
        if (n.op === 'after') { buildAfter(id, n, want); return }
        if (n.op === 'select') { buildSelect(id, n, want); return }
        if (n.op === 'nil-effect') return
        if (n.op === 'void') { finish(); return }
        if (n.op === 'store') {
            buildStore(id, n)
            finish()
            return 
        }
        if (n.op === 'pool-entry') {
            const slot = getLiteral(n, 0)
            assert(!getRef(n, 0) && Number.isSafeInteger(slot) && slot >= 0)
            finish()
            const dst = regFor(id, want)
            put(() => asm.loadPool(dst, slot))
            return
        }
        if (n.op === 'call-context') {
            throw `lowering3: indirect call context ${id} was not bound at entry`
        }
        if (BinaryOps.has(n.op) || CompareOps.has(n.op)) { buildArith(id, n, signed, want); return }
        if (UnaryOps.has(n.op)) {
            const op = n.op
            const a = demand(getRef(n, 0), getLiteral(n, 0))
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => asm.unary(op, dst, ra))
            return
        }
        if (n.op === 'convert' || n.op === 'bitconvert') {
            const T = getTypeT(n)
            const U = getTypeU(n)
            const converts = n.op === 'convert'
            const a = demand(getRef(n, 0), getLiteral(n, 0))
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => converts ? asm.convert(dst, ra, T, U) : asm.mov(dst, ra))
            return
        }
        if (n.op === 'load') {
            return buildLoad(id, n, want)
        }
        if (n.op === 'literal') {
            finish()
            const dst = regFor(id, want)
            const k = literalValue(n)
            put(() => asm.movImm(dst, k))
            return
        }
        throw `lowering3: cannot produce '${n.op}' @ %${id}\n${dumpGraph(g)}`
    }

    function buildArith(id: number, n: GraphNode, signed: boolean, want: number): void {
        const swap = !getRef(n, 0) && getRef(n, 1) !== 0
            && (Commutative.has(n.op) || SwappedCmp[n.op] !== undefined)
        const op = swap ? SwappedCmp[n.op] ?? n.op : n.op
        const cmp = CompareOps.has(op)
        const li = swap ? 1 : 0
        const ri = swap ? 0 : 1
        const imm = getLiteral(n, ri)
        if (!getRef(n, ri) && (op === 'and' || op === 'or' || op === 'xor'
            || op === 'shl' || op === 'shr' || op === 'ushr')) {
            const a = demand(getRef(n, li), getLiteral(n, li))
            const ra = at(a, NOTHING)
            finish(id)
            const dst = regFor(id, want)
            put(() => asm.binaryImm(op, dst, ra, imm, signed))
            return
        }
        if (!getRef(n, ri) && imm >= 0 && imm <= 0xFFF && (cmp || op === 'add' || op === 'sub')) {
            const a = demand(getRef(n, li), getLiteral(n, li))
            const ra = at(a, NOTHING)
            finish(id)
            const dst = regFor(id, want)
            put(() => cmp ? asm.compareImm(op, dst, ra, imm, signed)
                : op === 'add' ? asm.addImm(dst, ra, imm) : asm.subImm(dst, ra, imm))
            return
        }
        let a = 0, b = 0
        for (const i of orderedOperands(id, [li, ri])) {
            const v = demand(getRef(n, i), getLiteral(n, i))
            if (i === li) a = v
            else b = v
        }
        const guard = new Set<number>()
        const ra = at(a, guard)
        guard.add(ra)
        const rb = at(b, guard)
        finish(id)
        const dst = regFor(id, want)
        put(() => cmp ? asm.compare(op, dst, ra, rb, signed) : asm.binary(op, dst, ra, rb, signed))
    }

    function buildAfter(id: number, n: GraphNode, want: number): void {
        const result = countIds(n) - 1
        assert(result >= 0)
        for (const i of orderingOperands(id, n)) effect(getRef(n, i))
        const value = demand(getRef(n, result), getLiteral(n, result), want)
        if (!value) { finish(id); return }
        const src = at(value, NOTHING)
        finish(id)
        const dst = regFor(id, want >= 0 ? want : src)
        transfer(dst, src)
    }

    interface Handover { dst: number, id: number, konst: number, rank?: number, settle?: (reg: number) => void }
    function handOver(site: number, slots: Handover[], sequence: [number, () => void], elide = OPEN): number {
        const args: Move[] = []
        const consts: Move[] = []
        const feeds = new Map<Handover, number>()
        let sequenced = false
        for (let i = 0; i < slots.length; i++) {
            const s = slots[i]
            if (sequence[0] === i) {
                assert(!sequenced)
                sequence[1]()
                sequenced = true
            }
            if (!s.id) continue
            const want = s.dst === OPEN || isSlot(s.dst) ? -1 : s.dst
            const value = demand(s.id, s.konst, want)
            if (value) feeds.set(s, value)
        }
        if (!sequenced) sequence[1]()
        slots = slots.filter(s => !s.id || feeds.has(s))
        const settled = new Map<number, number>()
        for (const v of feeds.values()) settled.set(v, homeOf.get(v)!)
        const claimed = new Set<number>()
        for (const s of slots) if (s.dst !== OPEN) claimed.add(s.dst)
        const open = slots.filter(s => s.dst === OPEN)
        open.sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0))
        for (const s of open) {
            if (s.dst !== OPEN) continue
            const v = feeds.get(s)
            const here = v === undefined ? undefined : settled.get(v)
            if (here === undefined || claimed.has(here)) continue
            claimed.add(here)
            if (isPreserved(here)) {
                usedPreserved.add(here)
                currentRegion.writes.add(here)
            }
            s.dst = here
            s.settle!(here)
        }
        for (const s of open) {
            if (s.dst !== OPEN) continue
            let r = -1
            for (const c of volatiles) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of preserved) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of volatiles) if (!claimed.has(c)) { r = c; break }
            if (r < 0) for (const c of preserved) if (!claimed.has(c)) { r = c; break }
            if (r < 0) r = takeSlot()
            claimed.add(r)
            if (isPreserved(r)) {
                usedPreserved.add(r)
                currentRegion.writes.add(r)
            }
            s.dst = r
            s.settle!(r)
        }
        for (const s of slots) {
            if (!s.id) { consts.push({ dst: s.dst, src: s.konst }); continue }
            args.push({ dst: s.dst, src: feeds.get(s)! })
        }
        if (opts.debug) {
            console.log('handover', site, slots.map(s => [s.dst, s.id, s.konst]),
                [...settled], 'elide', elide)
        }
        finish(site)
        const dsts = new Set<number>()
        for (const a of args) if (a.dst !== elide) dsts.add(a.dst)
        for (const c of consts) dsts.add(c.dst)
        let landed = elide
        const moves: Move[] = []
        for (const a of args) {
            const src = settled.get(a.src)!
            if (a.dst === elide && !isSlot(src) && !dsts.has(src)) { landed = src; continue }
            moves.push({ dst: a.dst, src })
        }
        shuffle(moves)
        for (const c of consts) {
            if (isSlot(c.dst)) put(() => {
                asm.movImm(SWAP, c.src)
                asm.store(SP, slotOffset(c.dst), SWAP, Types.u64)
            })
            else put(() => asm.movImm(c.dst, c.src))
        }
        return landed
    }

    function buildCall(id: number, n: GraphNode): void {
        const callee = g.nodes.get(getRef(n, 1))
        const syscall = callee?.op === 'syscall-target' ? callee : undefined
        const local = callee?.op === 'local-target' ? callee : undefined
        const indirect = callee?.op === 'indirect-target' ? callee : undefined
        const fixedTarget = syscall ?? local
        if (syscall) tails.delete(id)
        else callsOut ||= !tails.has(id)
        const argRegs = syscall ? target.syscall.argRegs : target.argRegs
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const i of analysis.operandOrder.get(id) ?? []) {
            if (i === 0) sequenceIdx = slots.length
            if (i === 1 && indirect) {
                for (const j of analysis.operandOrder.get(getRef(n, 1)) ?? [0, 1]) {
                    slots.push({
                        dst: j === 0 ? CALLEE : target.indirectContextReg,
                        id: getRef(indirect, j), konst: getLiteral(indirect, j),
                    })
                }
                continue
            }
            if (i < 3 && (i !== 1 || fixedTarget)) continue
            slots.push({
                dst: i === 1 ? CALLEE : argRegs[i - 3],
                id: getRef(n, i), konst: getLiteral(n, i),
            })
        }
        done.add(id)
        const linkReg = handOver(id, slots, [sequenceIdx, () => effect(getRef(n, 0))], CALLEE)
        if (syscall) {
            const number = getLiteral(syscall, 0)
            assert(!getRef(syscall, 0) && Number.isSafeInteger(number))
            put(() => asm.syscall(number))
        } else if (local) {
            const target = getLiteral(local, 0)
            const name = getDebugLabel(g, getRef(n, 1))
            assert(!getRef(local, 0) && Number.isSafeInteger(target) && target >= 0)
            put(() => tailCalls && tails.has(id) ? asm.jumpLocal(target, name) : asm.callLocal(target, name))
        } else {
            put(() => tailCalls && tails.has(id) ? asm.br(linkReg) : asm.blr(linkReg))
        }
        for (const x of volatiles) {
            if (const v = heldBy.get(x)) {
                freedAt.set(v, id)
                heldBy.delete(x)
            }
        }
        const retReg = syscall ? target.syscall.retReg : target.retReg
        transfer(regFor(id, retReg), retReg)
    }

    function effect(id: number): void {
        if (!id) return
        const n = g.nodes.get(id)
        if (!n) return
        if (n.op === 'call') {
            if (!done.has(id) && !homeOf.has(id)) build(id)
        } else if (n.op === 'after') {
            if (done.has(id)) return
            for (const i of orderingOperands(id, n)) effect(getRef(n, i))
        } else if (n.op === 'store') {
            if (!done.has(id)) buildStore(id, n)
        } else if (n.op === 'load') {
            if (!done.has(id) && !homeOf.has(id)) build(id)
        } else if (n.op === 'select') {
            const taken = g.nodes.get(getRef(n, 1))?.op === 'panic' ? 2
                : g.nodes.get(getRef(n, 2))?.op === 'panic' ? 1 : 0
            if (!taken && preferBranchless(n)) {
                for (let i = 0; i < countIds(n); i++) {
                    effect(getRef(n, i))
                }
            } else {
                if (!taken) throw `lowering3: effect ${id} branches before the tail\n${dumpGraph(g)}`
                effect(getRef(n, taken))
            }
        } else if (n.op === 'nil-effect') return
        if (!analysis.usedBy.has(id)) {
            freeValue(id)
        }
    }

    function buildStore(id: number, n: GraphNode): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        effect(getRef(n, 0))
        const T = getTypeT(n)
        const b = demand(getRef(n, 1), getLiteral(n, 1))
        let o = 0
        if (getRef(n, 2)) o = demand(getRef(n, 2), getLiteral(n, 2))
        const zero = !getRef(n, 3) && getLiteral(n, 3) === 0
        const v = zero ? 0 : demand(getRef(n, 3), getLiteral(n, 3))
        const guard = new Set<number>()
        const base = at(b, guard)
        guard.add(base)
        const ro = o ? at(o, guard) : -1
        if (o) guard.add(ro)
        const rv = zero ? XZR : at(v, guard)
        guard.add(rv)
        finish()
        if (ro < 0) {
            const offset = getLiteral(n, 2)
            put(() => asm.store(base, offset, rv, T))
            return
        }
        put(() => asm.storeIndexed(base, ro, rv, T))
    }

    function buildLoad(id: number, n: GraphNode, want: number) {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        effect(getRef(n, 0))
        const T = getTypeT(n)
        if (!getRef(n, 2)) {
            const b0 = demand(getRef(n, 1), getLiteral(n, 1))
            const base0 = at(b0, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => asm.load(dst, base0, getLiteral(n, 2), T))
            return
        }
        let b = 0, o = 0
        for (const i of orderedOperands(id, [1, 2])) {
            const v = demand(getRef(n, i), getLiteral(n, i))
            if (i === 1) b = v
            else o = v
        }
        const guard = new Set<number>()
        const rb = at(b, guard)
        guard.add(rb)
        const ro = at(o, guard)
        finish()
        const dst = regFor(id, want)
        put(() => asm.loadIndexed(dst, rb, ro, T))
    }

    function condition(site: number, id: number, konst: number, target: number, whenTrue = false): void {
        const outer = materializing
        materializing = id || site
        defer materializing = outer
        const branch = (r: number) => whenTrue ? asm.jumpIfNonZero(r, target) : asm.jumpIfZero(r, target)
        const n = id ? g.nodes.get(id) : undefined
        function operands(c: GraphNode, limit: number) {
            const flip = !getRef(c, 0) && getRef(c, 1) !== 0 && SwappedCmp[c.op] !== undefined
            const li = flip ? 1 : 0
            const ri = flip ? 0 : 1
            const imm = !getRef(c, ri) && getLiteral(c, ri) >= 0 && getLiteral(c, ri) <= limit ? getLiteral(c, ri) : -1
            const a = demand(getRef(c, li), getLiteral(c, li))
            const b = imm < 0 ? demand(getRef(c, ri), getLiteral(c, ri)) : 0
            return { op: flip ? SwappedCmp[c.op] : c.op, signed: lowering.isSignedType(getTypeT(c)) || lowering.isSignedType(getTypeU(c)), imm, a, b }
        }
        function compareWith(o: { op: string, signed: boolean, imm: number, a: number, b: number }, guard: Set<number>) {
            const ra = at(o.a, guard)
            guard.add(ra)
            const rb = o.imm < 0 ? at(o.b, guard) : -1
            if (rb >= 0) guard.add(rb)
            return (dst: number, when?: [op: string, signed: boolean]) => o.imm < 0
                ? asm.compare(o.op, dst, ra, rb, o.signed, when)
                : asm.compareImm(o.op, dst, ra, o.imm, o.signed, when)
        }
        if (n && CompareOps.has(n.op) && !homeOf.has(id) && releaseAt.get(site)?.has(id)) {
            const emit = compareWith(operands(n, 0xFFF), new Set())
            finish(id)
            const flag = freeReg(volatiles, NOTHING)
            if (flag < 0) throw 'lowering: out of registers'
            put(() => {
                emit(flag)
                branch(flag)
                asm.released([{ value: id, home: flag }])
            })
            return
        }
        const left = n?.op === 'and' ? g.nodes.get(getRef(n, 0)) : undefined
        const right = n?.op === 'and' ? g.nodes.get(getRef(n, 1)) : undefined
        if (n && left && right && CompareOps.has(left.op) && CompareOps.has(right.op) && !homeOf.has(getRef(n, 0)) && !homeOf.has(getRef(n, 1))
            && !homeOf.has(id) && releaseAt.get(site)?.has(id)) {
            const first = operands(left, 0xFFF)
            const second = operands(right, 31)
            const guard = new Set<number>()
            const one = compareWith(first, guard)
            const two = compareWith(second, guard)
            finish(id)
            const flag = freeReg(volatiles, NOTHING)
            if (flag < 0) throw 'lowering: out of registers'
            put(() => {
                one(-1)
                two(flag, [first.op, first.signed])
                branch(flag)
                asm.released([{ value: id, home: flag }])
            })
            return
        }
        const v = demand(id, konst)
        const r = at(v, NOTHING)
        finish(id)
        put(() => branch(r))
    }

    function preferBranchless(n: GraphNode) {
        if (countIds(n) !== 3) return false
        for (let i = 1; i < 3; i++) {
            const u = getRef(n, i)
            if (!u || u) continue
            if (homeOf.has(u) || done.has(u)) continue
            if (!pure.has(u) && g.nodes.get(u)?.op !== 'param') return false
            const p = g.nodes.get(u)
            if (!p) continue
            for (let j = 0; j < countIds(p); j++) {
                const q = getRef(p, j)
                if (!q) continue
                //if (!homeOf.has(q) && !done.has(q) && g.nodes.get(q)) return false
            }
        }
        return true
    }

    function buildSelect(id: number, n: GraphNode, want: number): void {
        if (preferBranchless(n)) {
            const slots: number[] = []
            for (const i of orderedOperands(id, [0, 1, 2])) {
                const v = demand(getRef(n, i), getLiteral(n, i))
                slots[i] = v
            }
            const guard = new Set<number>()
            const rc = at(slots[0], guard)
            guard.add(rc)
            const rx = at(slots[1], guard)
            guard.add(rx)
            const ry = at(slots[2], guard)
            finish(id)
            const dst = regFor(id, want)
            put(() => asm.select(dst, rc, rx, ry))
            return
        }
        console.log(dumpGraph(g))
        throw `lowering3: select ${id} branches in value position`
    }

    function returnValue(site: number, id: number, konst: number): void {
        if (!id) put(() => asm.movImm(target.retReg, konst))
        else {
            const k = g.nodes.get(id)?.op === 'literal' ? literalValue(g.nodes.get(id)!) : undefined
            if (k !== undefined) {
                put(() => asm.movImm(target.retReg, k))
                return jumpToExit()
            }
            if (g.nodes.get(id)?.op === 'call') tails.add(id)
            const v = demand(id, konst, target.retReg)
            const src = v ? homeOf.get(v)! : undefined
            finish(site)
            if (v) {
                transfer(target.retReg, src!, { value: v, home: src! })
            }
        }
        jumpToExit(id)
    }

    function emitApply(id: number, n: GraphNode, jump = true): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        const b = getBlock(g, getRef(n, 0))
        if (!b) throw 'lowering3: apply of something that is not a block'
        const homes = sig.get(b.id)!
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const at of analysis.operandOrder.get(id) ?? []) {
            if (at < 1 || at > b.params.length) continue
            const i = at - 1
            slots.push({
                dst: homes[i], id: getRef(n, i + 1), konst: getLiteral(n, i + 1), rank: i,
                settle: (r: number) => { homes[i] = r },
            })
        }
        handOver(id, slots, [sequenceIdx, () => {}])
        if (jump) {
            const label = entryLabels.get(b.id) ?? b.id
            put(() => asm.jump(label))
        }
        else {
            for (let i = 0; i < b.params.length; i++) {
                if (!getRef(n, i + 1)) continue
                place(getRef(n, i + 1), homes[i])
            }
        }
    }

    function exitsFunction(id: number, seen = new Set<number>()): boolean {
        if (!id || seen.has(id)) return true
        seen.add(id)
        const n = g.nodes.get(id)
        if (!n) return true
        if (n.op === 'after') return exitsFunction(getRef(n, countIds(n)-1), seen)
        if (n.op === 'select') {
            return exitsFunction(getRef(n, 1), new Set(seen))
                && exitsFunction(getRef(n, 2), new Set(seen))
        }
        if (n.op === 'apply') return false
        return true
    }

    function emitTailRegion(id: number, konst: number, group: number): void {
        if (currentBlock !== g.blocks[0].id || !exitsFunction(id)) {
            emitTail(id, konst)
            return
        }
        const parent = currentRegion
        const region: EmitRegion = {
            parent, children: [], writes: new Set(), owned: [], exitLabel: nextLabel++, group,
        }
        parent.children.push(region)
        currentRegion = region
        put(() => {
            for (const r of region.owned) asm.store(SP, savedIndex.get(r)! * 8, r, Types.u64)
        })
        emitTail(id, konst)
        currentRegion = parent
    }

    function emitTail(id: number, konst: number): void {
        const n = id ? g.nodes.get(id) : undefined
        if (!n) { returnValue(id, id, konst); return }
        if (n.op === 'after') {
            const result = countIds(n) - 1
            if (hasStructuredTail(g, getRef(n, result))) {
                for (const i of orderingOperands(id, n)) effect(getRef(n, i))
                emitTail(getRef(n, result), getLiteral(n, result))
                return
            }
        }
        if (n.op === 'select') {
            if (const target = analysis.rotated.get(id)) {
                const codeLen = code.length
                const entry = entryLabels.get(target)!
                put(() => asm.bindLabel(entry))
                condition(id, getRef(n, 0), getLiteral(n, 0), currentBlock, true)
                const header = code.splice(codeLen, code.length-codeLen)
                const before = snapshot()
                const group = nextRegionGroup++
                narrowTo(getRef(n, 1))
                emitTailRegion(getRef(n, 1), getLiteral(n, 1), group)
                restore(before)
                code.push(...header)
                narrowTo(getRef(n, 2))
                emitTailRegion(getRef(n, 2), getLiteral(n, 2), group)
                finish(id)
                return
            }
            const next = order[order.indexOf(currentBlock) + 1]
            function into(arm: number): number {
                const t = g.nodes.get(tailOf(g, arm))
                return !t || t.op !== 'apply' ? 0 : getRef(t, 0)
            }
            const first = into(getRef(n, 1)) === next && into(getRef(n, 2)) !== next ? 2 : 1
            const otherwise = nextLabel++
            condition(id, getRef(n, 0), getLiteral(n, 0), otherwise, first === 2)
            const before = snapshot()
            const group = nextRegionGroup++
            narrowTo(getRef(n, first))
            emitTailRegion(getRef(n, first), getLiteral(n, first), group)
            restore(before)
            put(() => asm.bindLabel(otherwise))
            narrowTo(getRef(n, 3 - first))
            emitTailRegion(getRef(n, 3 - first), getLiteral(n, 3 - first), group)
            finish(id)
            return
        }
        if (n.op === 'apply') { emitApply(id, n); return }
        if (n.op === 'panic') { jumpToExit(); return }
        if (n.op === 'ret') {
            return emitTail(getRef(n!, 0), getLiteral(n!, 0))
        }
        returnValue(id, id, konst)
    }

    for (const id of order) {
        const b = getBlock(g, id)!
        currentBlock = id
        currentRegion = rootRegion
        homeOf.clear()
        heldBy.clear()
        done.clear()
        reusableSlots.clear()
        for (let i = 1; i <= slotCount; i++) reusableSlots.add(-i)
        put(() => asm.bindLabel(b.id))
        if (id === g.blocks[0].id) {
            for (const context of callContexts) {
                if (acrossCall.has(context)) {
                    const r = freeReg(preserved, NOTHING)
                    if (r < 0) throw 'lowering: no register for indirect call context'
                    bind(context, r)
                    transfer(r, target.indirectContextReg)
                } else {
                    bind(context, target.indirectContextReg)
                }
            }
            for (let i = 0; i < b.params.length; i++) {
                const p = b.params[i]
                const arrives = target.argRegs[i]
                if (acrossCall.has(p)) {
                    const r = freeReg(preserved, new Set<number>())
                    if (r >= 0) { bind(p, r); transfer(r, arrives); continue }
                }
                bind(p, arrives)
            }
            emitTail(b.bodyId, b.bodyConst)
            continue
        }
        const homes = sig.get(id)!
        for (let i = 0; i < b.params.length; i++) {
            if (homes[i] !== OPEN) place(b.params[i], homes[i])
        }
        for (let i = 0; i < b.params.length; i++) {
            if (homes[i] === OPEN) place(b.params[i], homes[i] = freeReg(volatiles, NOTHING))
        }
        emitTail(b.bodyId, b.bodyConst)
    }

    function promoteCommonRegionWrites(region: EmitRegion): Set<number> {
        const subtree: Set<number>[] = []
        const groups = new Map<number, number[]>()
        for (let i = 0; i < region.children.length; i++) {
            const child = region.children[i]
            subtree.push(promoteCommonRegionWrites(child))
            const siblings = groups.get(child.group)
            if (siblings) siblings.push(i)
            else groups.set(child.group, [i])
        }
        for (const siblings of groups.values()) {
            if (siblings.length < 2) continue
            const common = new Set(subtree[siblings[0]])
            for (let i = 1; i < siblings.length; i++) {
                const writes = subtree[siblings[i]]
                for (const r of common) if (!writes.has(r)) common.delete(r)
            }
            for (const r of common) region.writes.add(r)
        }
        const all = new Set(region.writes)
        for (const writes of subtree) for (const r of writes) all.add(r)
        return all
    }

    function assignRegionRegisters(region: EmitRegion, inherited: Set<number>): void {
        region.owned = [...region.writes].filter(r => !inherited.has(r))
        const watermark = new Set(inherited)
        for (const r of region.owned) watermark.add(r)
        for (const child of region.children) assignRegionRegisters(child, watermark)
    }
    promoteCommonRegionWrites(rootRegion)
    assignRegionRegisters(rootRegion, new Set())

    tailCalls = !usedPreserved.size && !slotCount && !callsOut
    if (!tailCalls && tails.size) callsOut = true
    const saved = target.calleeSaved.filter(r => usedPreserved.has(r))
    for (let i = 0; i < saved.length; i++) savedIndex.set(saved[i], i)
    frameBase = (saved.length + (callsOut ? 1 : 0)) * 8
    const frameBytes = (frameBase + slotCount * 8 + 15) & ~15
    if (frameBytes) asm.spAdjust(frameBytes)
    for (const r of rootRegion.owned) asm.store(SP, savedIndex.get(r)! * 8, r, Types.u64)
    if (callsOut) asm.store(SP, saved.length * 8, LR, Types.u64)
    let released: { value: number, home: number }[] = []
    for (const item of code) {
        if (typeof item !== 'function') {
            if ('released' in item) {
                released.push(...item.released)
                continue
            }
            const { dst, src, consumed } = item
            if (isSlot(src) && isSlot(dst)) {
                asm.load(SWAP, SP, slotOffset(src), Types.u64)
                asm.store(SP, slotOffset(dst), SWAP, Types.u64)
            } else if (isSlot(src)) asm.load(dst, SP, slotOffset(src), Types.u64)
            else if (isSlot(dst)) asm.store(SP, slotOffset(dst), src, Types.u64)
            else asm.mov(dst, src)
            if (consumed) released.push(consumed)
            released = released.filter(value => value.home !== dst)
            if (released.length) {
                asm.released(released)
                released = []
            }
            continue
        }
        item()
        if (released.length) {
            asm.released(released)
            released = []
        }
    }

    const epilogues: EmitRegion[] = []
    function collectEpilogues(region: EmitRegion): void {
        for (const child of region.children) collectEpilogues(child)
        if (region !== rootRegion && region.owned.length) epilogues.push(region)
    }
    collectEpilogues(rootRegion)
    for (let i = 0; i < epilogues.length; i++) {
        const region = epilogues[i]
        asm.bindLabel(region.exitLabel)
        for (const r of region.owned) asm.load(r, SP, savedIndex.get(r)! * 8, Types.u64)
        const target = regionExit(region.parent)
        const next = i + 1 < epilogues.length ? epilogues[i + 1].exitLabel : exitLabel
        if (target !== next) asm.jump(target)
    }
    asm.bindLabel(exitLabel)
    for (const r of rootRegion.owned) asm.load(r, SP, savedIndex.get(r)! * 8, Types.u64)
    if (callsOut) asm.load(LR, SP, saved.length * 8, Types.u64)
    if (frameBytes) asm.spAdjust(-frameBytes)
    if (reachesExit || !tailCalls) asm.ret()

    return {
        target, words: asm.words(), bytes: asm.bytes(), relocations: asm.relocations(),
        listing: asm.listing(),
    }
}

function specializeBlockApplications(g: Graph): Graph {
    const applications = new Map<number, number>()
    for (const n of g.nodes.values()) {
        if (n.op === 'apply') applications.set(getRef(n, 0), (applications.get(getRef(n, 0)) ?? 0) + 1)
    }
    const candidates = new Map<number, GraphBlock>()
    for (const b of g.blocks) {
        if (g.nodes.get(b.bodyId)?.op === 'apply') candidates.set(b.id, b)
    }
    const pure = pureValues(g)
    const nodes = new Map(g.nodes)
    let nextId = g.maxId
    type Value = { id: number, value: number }
    const interned = new Map<string, number>()
    for (const [id, n] of nodes) {
        if (n.op === 'param' || n.op === 'block' || n.op === 'nil-effect') continue
        const key = nodeKey(n)
        interned.set(key, id)
    }
    function intern(n: GraphNode): Value {
        const k = nodeKey(n)
        let id = interned.get(k)
        if (id === undefined) {
            id = nextId++
            nodes.set(id, n)
            interned.set(k, id)
            if ((PureOps.has(n.op) || n.op === 'after') && getArgIds(n).every(a => pure.has(a))) pure.add(id)
        }
        return { id, value: 0 }
    }
    function ordering(values: Value[]): Value {
        const frontier = new Set<number>()
        const seen = new Set<number>()
        function collect(id: number): void {
            if (!id || pure.has(id) || seen.has(id)) return
            seen.add(id)
            const n = nodes.get(id)!
            if (n.op === 'select' || (n.op !== 'after' && !PureOps.has(n.op))) frontier.add(id)
            else for (const a of getArgIds(n)) collect(a)
        }
        for (const v of values) collect(v.id)
        const implied = new Set<number>()
        function dependencies(id: number): void {
            if (!id || pure.has(id) || implied.has(id)) return
            implied.add(id)
            const n = nodes.get(id)!
            if (n.op === 'select') dependencies(getRef(n, 0))
            else for (const a of getArgIds(n)) dependencies(a)
        }
        if (frontier.size > 1) {
            for (const id of frontier) for (const a of getArgIds(nodes.get(id)!)) dependencies(a)
        }
        const ids = [...frontier].filter(id => !implied.has(id))
        if (!ids.length) return { id: 0, value: 0 }
        if (ids.length === 1) return { id: ids[0], value: 0 }
        const empty = intern(makeNode('void', [], new Float64Array(0)))
        return intern(makeNode('after', [...ids, empty.id], new Float64Array(ids.length + 1)))
    }
    const active = new Set<number>()
    const entryTokens = new Map<number, number[]>()
    function tokensOf(block: GraphBlock): number[] {
        const known = entryTokens.get(block.id)
        if (known) return known
        const tokens: number[] = []
        const epoch = nextEpoch(g)
        function walk(id: number): void {
            if (!id) return
            const n = nodes.get(id)
            if (!n || !markVisited(n, epoch) || n.op === 'param' || n.op === 'block') return
            if (n.op === 'nil-effect') { tokens.push(id); return }
            for (const x of getArgIds(n)) walk(x)
        }
        walk(block.bodyId)
        entryTokens.set(block.id, tokens)
        return tokens
    }
    function rewrite(id: number, value: number, env: Map<number, Value>, memo: Map<number, Value>, before: Value = { id: 0, value: 0 }): Value {
        if (!id) return { id, value }
        const replacement = env.get(id) ?? memo.get(id)
        if (replacement) return replacement
        const n = nodes.get(id)
        if (!n || n.op === 'param' || n.op === 'block' || n.op === 'nil-effect') return { id, value: 0 }
        const args: Value[] = []
        for (let i = 0; i < countIds(n); i++) {
            const prior = n.op === 'after' && i === countIds(n) - 1 ? ordering([before, ...args])
                : n.op === 'select' && i > 0 ? ordering([before, args[0]]) : before
            args.push(rewrite(getRef(n, i), getLiteral(n, i), env, memo, prior))
        }
        let result: Value | undefined
        const block = n.op === 'apply' ? candidates.get(getRef(n, 0)) : undefined
        if (block && !active.has(block.id) && (nodes.get(block.bodyId)?.op === 'apply'
            || applications.get(block.id) === 1 || args.slice(1).some(arg => !arg.id))) {
            const bindings = new Map(env)
            for (let i = 0; i < block.params.length; i++) bindings.set(block.params[i], args[i + 1])
            const o = ordering([before, ...args.slice(1)])
            if (o.id) for (const token of tokensOf(block)) bindings.set(token, o)
            active.add(block.id)
            result = rewrite(block.bodyId, block.bodyConst, bindings, new Map(), o)
            active.delete(block.id)
            if (o.id) result = intern(makeNode('after', [o.id, result.id],
                new Float64Array([0, result.value])))
        } else if (n.op === 'select') {
            if (!args[0].id) result = args[0].value ? args[1] : args[2]
            else if (args[1].id === args[2].id && (args[1].id || Object.is(args[1].value, args[2].value))) {
                result = pure.has(args[0].id) ? args[1] : intern(makeNode('after',
                    [args[0].id, args[1].id], new Float64Array([0, args[1].value])))
            }
        } else if (n.op === 'after') {
            const last = args[args.length - 1]
            const ids = [...new Set(args.slice(0, -1).map(a => a.id))]
            const order = ids.filter(x => x && x !== last.id && nodes.get(x)?.op !== 'nil-effect' && nodes.get(x)?.op !== 'void').map(id => ({ id, value: 0 }))
            if (!order.length) result = last
            else if (order.length < args.length - 1) {
                result = intern(copyNode(n, [...order.map(a => a.id), last.id],
                    new Float64Array([...order.map(() => 0), last.value])))
            }
        } else if (args.length === 2 && args.every(arg => !arg.id)
            && args[0].value >= 0 && args[1].value >= 0) {
            const a = args[0].value, b = args[1].value
            let folded: number | undefined
            if (n.op === 'add') folded = a + b
            else if (n.op === 'sub' && a >= b) folded = a - b
            else if (n.op === 'mul') folded = a * b
            else if (n.op === 'lt') folded = a < b ? 1 : 0
            else if (n.op === 'le') folded = a <= b ? 1 : 0
            else if (n.op === 'gt') folded = a > b ? 1 : 0
            else if (n.op === 'ge') folded = a >= b ? 1 : 0
            else if (n.op === 'eq') folded = a === b ? 1 : 0
            else if (n.op === 'ne') folded = a !== b ? 1 : 0
            const T = getTypeT(n)
            if (folded !== undefined
                && (T === Types.u64 || T === Types.u32) && getTypeU(n) === T
                && (T !== Types.u32 || (a <= 0xFFFFFFFF && b <= 0xFFFFFFFF && folded <= 0xFFFFFFFF))) {
                result = { id: 0, value: folded }
            }
        }
        if (!result && args.length === 2 && getTypeT(n) <= Types.i64 && getTypeU(n) <= Types.i64) {
            const left = (value: number) => !args[0].id && args[0].value === value
            const right = (value: number) => !args[1].id && args[1].value === value
            if (n.op === 'add' || n.op === 'or' || n.op === 'xor') {
                if (right(0)) result = args[0]
                else if (left(0)) result = args[1]
            } else if (n.op === 'sub' || n.op === 'shl' || n.op === 'shr' || n.op === 'ushr') {
                if (right(0)) result = args[0]
            } else if (n.op === 'mul') {
                if (right(1)) result = args[0]
                else if (left(1)) result = args[1]
            } else if (n.op === 'div' && right(1)) result = args[0]
        }
        if (!result) {
            result = intern(copyNode(n, args.map(a => a.id), new Float64Array(args.map(a => a.value))))
        }
        memo.set(id, result)
        return result
    }
    const memo = new Map<number, Value>()
    const env = new Map<number, Value>()
    const blocks = g.blocks.map(b => {
        active.add(b.id)
        const body = rewrite(b.bodyId, b.bodyConst, env, memo)
        active.delete(b.id)
        return { ...b, bodyId: body.id, bodyConst: body.value }
    })
    const out = { ...g, maxId: nextId, nodes }
    setGraphBlocks(out, blocks)
    const reachable = new Set<number>()
    const liveNodes = new Map<number, GraphNode>()
    function visit(id: number): void {
        if (!id || liveNodes.has(id)) return
        const n = nodes.get(id)
        if (!n) return
        liveNodes.set(id, n)
        if (n.op === 'apply') visitBlock(getRef(n, 0))
        for (const arg of getArgIds(n)) visit(arg)
    }
    function visitBlock(id: number): void {
        if (reachable.has(id)) return
        reachable.add(id)
        const b = getBlock(out, id)!
        for (const param of b.params) visit(param)
        visit(b.bodyId)
    }
    visitBlock(0)
    out.nodes = liveNodes
    setGraphBlocks(out, blocks.filter(b => reachable.has(b.id)))
    return out
}
