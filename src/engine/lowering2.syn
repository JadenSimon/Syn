/// @synth
"use wrapped";

import * as gn from './graph-node'
import * as heap from './heap'
import * as intrinsics from './intrinsics'
import * as lowering from './lowering'
import { solvePlacements } from './placement-flow'
import { flattenRecords } from './records'
import { snapshotKeys } from './heap-records'
import * as rt from './rt'
import {
    addGraphBlock, clearOperands, cloneRefs, copyNode, countIds, countLiterals,
    createRecordType, getArgConsts, getArgIds, getBlock, getDebugLabel, getLiteral,
    getOperand, getOperands, getRef, makeNode, type Operand, operandType, pushRefs, setDebugLabel, setGraphBlocks, setLiteral,
    recordFields, resultType, setOperand, setRef, setType, typeOf, typeRefOf, typeSlots, withRefs,
} from './graph-node'

const Types = intrinsics.Types
const assert = intrinsics.assert
type Types = (typeof Types)[keyof typeof Types]

export interface GraphNode {
    op: string
    slots: Uint32Array
    flags: u8
    scratchFlags: u8
    epoch: number
}

export interface GraphBlock {
    id: number
    params: number[]
    bodyId: number
    bodyConst: number
}

export type GraphForm = 'packaged' | 'optimized' | 'lowerable'

export interface Graph {
    form?: GraphForm
    maxId: number
    nodes: Map<number, GraphNode>
    blocks: GraphBlock[]
    blockIndex: Map<number, GraphBlock>
    epoch: number
    debugLabels: Map<number, string>
    name?: string
    level?: number
}

export function isParam(nodes: Map<number, GraphNode>, id: number): boolean {
    return !!nodes.get(id) && nodes.get(id)!.op === 'param'
}

function nextEpoch(g: Graph): number {
    return ++g.epoch
}

function markVisited(n: GraphNode, epoch: number): boolean {
    if (n.epoch === epoch) return false
    assert(n.epoch < epoch, 'markVisited: epoch went backwards')
    n.epoch = epoch
    return true
}

function hasStructuredTail(g: Graph, id: number): boolean {
    while (id) {
        const n = g.nodes.get(id)
        if (!n) return false
        if (n.op !== 'after') {
            return n.op === 'select' || n.op === 'apply' || n.op === 'panic'
                || n.op === 'trap' || n.op === 'ret' || n.op === 'unreachable'
        }
        id = getRef(n, countIds(n) - 1)
    }
    return false
}

export function tailOf(g: Graph, id: number): number {
    let n = g.nodes.get(id)
    while (n?.op === 'after') {
        id = getRef(n, countIds(n) - 1)
        n = g.nodes.get(id)
    }
    return id
}

export function tailScalar(g: Graph, n: GraphNode, at: number): number | undefined {
    for (let m = g.nodes.get(getRef(n, at)); m?.op === 'after'; m = g.nodes.get(getRef(n, at))) {
        n = m
        at = countIds(m) - 1
    }
    return scalarOperand(g.nodes, n, at)
}

export type SelectPath = [select: number, arm: number][]
export interface TailPosition { at: number, tokens: number[], path: SelectPath }

export function tailPositions(g: Graph, bodyId: number): TailPosition[] {
    const out: TailPosition[] = []
    function walk(id: number, tokens: number[], path: SelectPath): void {
        const n = g.nodes.get(id)
        if (!n) return
        if (n.op === 'after') {
            const last = countIds(n) - 1
            const next = tokens.slice()
            for (let i = 0; i < last; i++) {
                const op = g.nodes.get(getRef(n, i))?.op
                if (op && op !== 'nil-effect' && op !== 'void') next.push(getRef(n, i))
            }
            walk(getRef(n, last), next, path)
        } else if (n.op === 'select') {
            for (let i = 1; i < countIds(n); i++) walk(getRef(n, i), tokens, [...path, [id, i]])
        } else {
            out.push({ at: id, tokens, path })
        }
    }
    walk(bodyId, [], [])
    return out
}

export function tailRoots(g: Graph, p: TailPosition): number[] {
    const roots = p.tokens.slice()
    for (const [select] of p.path) roots.push(getRef(g.nodes.get(select)!, 0))
    roots.push(...getArgIds(g.nodes.get(p.at)!))
    return roots
}

type Facts = [cond: number, truth: boolean][]

function pathFacts(g: Graph, path: SelectPath): Facts {
    const facts: Facts = []
    for (const [select, arm] of path) {
        const n = g.nodes.get(select)!
        if (countIds(n) === 3 && getRef(n, 0)) facts.push([getRef(n, 0), arm === 1])
    }
    return facts
}

function comparisons(g: Graph, facts: Facts, ref: number): [k: number, equal: boolean][] {
    const out: [number, boolean][] = []
    for (const [cond, truth] of facts) {
        if (cond === ref) {
            out.push([0, !truth])
            continue
        }
        const c = g.nodes.get(cond)
        if (!c || (c.op !== 'eq' && c.op !== 'ne')) continue
        const k = getRef(c, 0) === ref ? scalarOperand(g.nodes, c, 1) : getRef(c, 1) === ref ? scalarOperand(g.nodes, c, 0) : undefined
        if (k !== undefined) out.push([k, (c.op === 'eq') === truth])
    }
    return out
}

function unsignedBits(T: Types): number | undefined {
    if (T === Types.bool) return 1
    if (lowering.isSignedType(T) || T === Types.f16 || T === Types.f32 || T === Types.f64) return
    const bits = intrinsics.intrinsicBitWidth(T)
    return bits && bits < 64 ? bits : undefined
}

function lowZeros(g: Graph, ref: number, literal: number): number {
    if (!ref) {
        if (!Number.isSafeInteger(literal)) return 0
        if (literal === 0) return 64
        let zeros = 0
        for (let v = Math.abs(literal); v % 2 === 0; v /= 2) zeros++
        return zeros
    }
    const n = g.nodes.get(ref)
    if (!n) return 0
    const a = () => lowZeros(g, getRef(n, 0), getLiteral(n, 0))
    const b = () => lowZeros(g, getRef(n, 1), getLiteral(n, 1))
    if (n.op === 'literal') return lowZeros(g, 0, getLiteral(n, 0))
    if (n.op === 'shl' && !getRef(n, 1)) return Math.min(64, a() + getLiteral(n, 1))
    if (n.op === 'mul') return Math.min(64, a() + b())
    if (n.op === 'and') return Math.max(a(), b())
    if (n.op === 'add' || n.op === 'sub' || n.op === 'or' || n.op === 'xor') return Math.min(a(), b())
    return 0
}

function highBits(g: Graph, ref: number, literal: number): number | undefined {
    if (!ref) return Number.isSafeInteger(literal) && literal >= 0 ? Math.ceil(Math.log2(literal + 1)) : undefined
    const n = g.nodes.get(ref)
    if (!n) return
    if (n.op === 'literal') return highBits(g, 0, getLiteral(n, 0))
    if (n.op === 'load' || n.op === 'convert') return unsignedBits(typeOf(n))
    if (n.op === 'and') {
        const a = highBits(g, getRef(n, 0), getLiteral(n, 0))
        const b = highBits(g, getRef(n, 1), getLiteral(n, 1))
        return a === undefined ? b : b === undefined ? a : Math.min(a, b)
    }
    if (n.op === 'ushr' && !getRef(n, 1)) {
        const a = highBits(g, getRef(n, 0), getLiteral(n, 0))
        return a === undefined ? undefined : Math.max(0, a - getLiteral(n, 1))
    }
}

function nonZero(g: Graph, ref: number, literal: number, facts: Facts): boolean {
    if (!ref) return literal !== 0
    const n = g.nodes.get(ref)
    if (!n) return false
    if (n.op === 'literal') return getLiteral(n, 0) !== 0
    if (n.op === 'pstack' || n.op === 'alloca' || n.op === 'frame-address') return true
    if (n.op === 'after') return nonZero(g, getRef(n, countIds(n) - 1), getLiteral(n, countIds(n) - 1), facts)
    if (comparisons(g, facts, ref).some(([k, equal]) => k === 0 && !equal)) return true
    if (n.op === 'or') return nonZero(g, getRef(n, 0), getLiteral(n, 0), facts) || nonZero(g, getRef(n, 1), getLiteral(n, 1), facts)
    if (n.op === 'add') {
        for (const [x, y] of [[0, 1], [1, 0]]) {
            const bits = highBits(g, getRef(n, y), getLiteral(n, y))
            if (bits !== undefined && lowZeros(g, getRef(n, x), getLiteral(n, x)) >= bits && nonZero(g, getRef(n, y), getLiteral(n, y), facts)) return true
        }
    }
    return false
}

export function stronglyConnected(roots: Iterable<number>, edges: (v: number) => number[]): number[][] {
    const index = new Map<number, number>()
    const low = new Map<number, number>()
    const stack: number[] = []
    const onStack = new Set<number>()
    const frames: { v: number, next: number[], at: number }[] = []
    const out: number[][] = []
    function enter(v: number): void {
        index.set(v, index.size)
        low.set(v, index.get(v)!)
        stack.push(v)
        onStack.add(v)
        frames.push({ v, next: edges(v), at: 0 })
    }
    for (const root of roots) {
        if (index.has(root)) continue
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.next.length) {
                const w = frame.next[frame.at++]
                if (!index.has(w)) enter(w)
                else if (onStack.has(w)) low.set(frame.v, Math.min(low.get(frame.v)!, index.get(w)!))
                continue
            }
            frames.pop()
            if (frames.length) {
                const parent = frames[frames.length - 1].v
                low.set(parent, Math.min(low.get(parent)!, low.get(frame.v)!))
            }
            if (low.get(frame.v) !== index.get(frame.v)) continue
            const scc: number[] = []
            for (;;) {
                const w = stack.pop()!
                onStack.delete(w)
                scc.push(w)
                if (w === frame.v) break
            }
            out.push(scc)
        }
    }
    return out
}

export interface GraphLoops {
    tailTargets: Map<number, number[]>
    loopsOf: Map<number, number[]>
    loopMembers: Map<number, Set<number>>
    loopDepth: Map<number, number>
}

export function graphLoops(g: Graph): GraphLoops {
    const tailTargets = new Map<number, number[]>()
    function collectTargets(id: number, into: number[]): void {
        const n = g.nodes.get(tailOf(g, id))
        if (n?.op === 'apply') into.push(getRef(n, 0))
        else if (n?.op === 'select') for (let i = 1; i < countIds(n); i++) collectTargets(getRef(n, i), into)
    }
    for (const b of g.blocks) {
        const into: number[] = []
        collectTargets(b.bodyId, into)
        tailTargets.set(b.id, into)
    }
    const loopsOf = new Map<number, number[]>()
    const loopMembers = new Map<number, Set<number>>()
    for (const b of g.blocks) loopsOf.set(b.id, [])
    function findLoops(root: number, within?: Set<number>, header = 0): void {
        const index = new Map<number, number>()
        const low = new Map<number, number>()
        const open: number[] = []
        function connect(v: number): void {
            index.set(v, index.size)
            low.set(v, index.get(v)!)
            open.push(v)
            for (const w of tailTargets.get(v)!) {
                if (w === header || (within && !within.has(w))) continue
                if (!index.has(w)) {
                    connect(w)
                    low.set(v, Math.min(low.get(v)!, low.get(w)!))
                } else if (open.includes(w)) {
                    low.set(v, Math.min(low.get(v)!, index.get(w)!))
                }
            }
            if (low.get(v) !== index.get(v)) return
            const members = new Set(open.splice(open.lastIndexOf(v)))
            if (members.size === 1 && (v === header || !tailTargets.get(v)!.includes(v))) return
            for (const m of members) loopsOf.get(m)!.push(v)
            loopMembers.set(v, members)
            findLoops(v, members, v)
        }
        connect(root)
    }
    findLoops(g.blocks[0].id)
    const loopDepth = new Map<number, number>()
    for (const [k, v] of loopsOf) loopDepth.set(k, v.length)
    return { tailTargets, loopsOf, loopMembers, loopDepth }
}

export interface HotCold {
    targets: Map<number, Map<number, number>>
    arrivals: Map<number, number>
    hotArm: Map<number, number>
}

type End = 'doomed' | 'zero' | number | undefined

function joinEnds(a: End | null, b: End | null): End | null {
    if (a === null || a === 'doomed') return b ?? a
    if (b === null || b === 'doomed') return a
    return a === b ? a : undefined
}

export function hotCold(g: Graph, loops: GraphLoops): HotCold {
    const out: HotCold = { targets: new Map(), arrivals: new Map(), hotArm: new Map() }
    if (intrinsics.argv().includes('no-static-odds')) return out
    const positions = new Map<number, TailPosition[]>()
    for (const b of g.blocks) positions.set(b.id, tailPositions(g, b.bodyId))
    function targetOf(p: TailPosition): number | undefined {
        const n = g.nodes.get(p.at)!
        return n.op === 'apply' ? getRef(n, 0) : undefined
    }
    const ends = new Map<number, End>()
    function returned(n: GraphNode, at: number, params: number[]): End {
        if (tailScalar(g, n, at) === 0) return 'zero'
        const k = params.indexOf(tailOf(g, getRef(n, at)))
        return k >= 0 ? k : undefined
    }
    function endOf(p: TailPosition, params: number[], internal?: Set<number>): End | null {
        const n = g.nodes.get(p.at)!
        if (n.op === 'unreachable' || n.op === 'panic') return 'doomed'
        if (n.op === 'ret') return returned(n, 0, params)
        if (n.op !== 'apply') return undefined
        if (internal?.has(getRef(n, 0))) return null
        const end = ends.get(getRef(n, 0))
        return typeof end === 'number' ? returned(n, end + 1, params) : end
    }
    for (const scc of stronglyConnected(g.blocks.map(b => b.id), id => positions.get(id)!.flatMap(p => targetOf(p) ?? []))) {
        const members = new Set(scc)
        const cyclic = scc.length > 1 || positions.get(scc[0])!.some(p => targetOf(p) === scc[0])
        let end: End | null = null
        for (const id of scc) {
            const params = cyclic ? [] : getBlock(g, id)!.params
            for (const p of positions.get(id)!) end = joinEnds(end, endOf(p, params, members))
        }
        for (const id of scc) ends.set(id, end ?? undefined)
    }
    function coldCompare(cond: number): number {
        const c = g.nodes.get(cond)
        if (!c || !CompareOps.has(c.op) || comparesFloats(g, c)) return 0
        for (const [x, k] of [[0, 1], [1, 0]]) {
            const value = scalarOperand(g.nodes, c, k)
            if (value === undefined || !getRef(c, x)) continue
            const op = k === 1 ? c.op : SwappedCmp[c.op]
            if (value === 0 || value === -1 || value === 0xffffffff) {
                if (op === 'eq') return 1
                if (op === 'ne') return 2
            }
            if (value === 0 && lowering.isSignedType(operandType(g, c, x))) {
                if (op === 'lt' || op === 'le') return 1
                if (op === 'gt' || op === 'ge') return 2
            }
        }
        return 0
    }
    for (const b of g.blocks) {
        const headers = loops.loopsOf.get(b.id) ?? []
        const loop = headers.length ? loops.loopMembers.get(headers[headers.length - 1]) : undefined
        const once = g.level === 0 && !headers.length
        const targets = new Map<number, number>()
        function walk(id: number, cold: number): void {
            const at = tailOf(g, id)
            const n = g.nodes.get(at)
            if (!n) return
            if (n.op === 'apply') {
                targets.set(getRef(n, 0), Math.min(targets.get(getRef(n, 0)) ?? Infinity, cold))
                out.arrivals.set(at, Math.min(out.arrivals.get(at) ?? Infinity, cold))
                return
            }
            if (n.op !== 'select') return
            const arms: { end: End | null, stays: boolean }[] = []
            for (let i = 1; i < countIds(n); i++) {
                let end: End | null = null
                let stays = false
                for (const p of tailPositions(g, getRef(n, i))) {
                    end = joinEnds(end, endOf(p, b.params))
                    if (loop?.has(targetOf(p) ?? -1)) stays = true
                }
                arms.push({ end, stays })
            }
            const staying = arms.some(arm => arm.stays)
            const zeroes = arms.filter(arm => arm.end === 'zero').length
            const coldness = arms.map(arm => arm.end === 'doomed' ? Infinity
                : (staying && !arm.stays ? 1 : 0) + (arm.end === 'zero' && zeroes < arms.length ? 1 : 0))
            const compared = arms.length === 2 ? coldCompare(getRef(n, 0)) : 0
            if (compared) coldness[compared - 1]++
            if (once) coldness.fill(0)
            if (arms.length === 2 && coldness[0] !== coldness[1]) out.hotArm.set(at, coldness[0] < coldness[1] ? 1 : 2)
            for (let i = 1; i < countIds(n); i++) walk(getRef(n, i), cold + coldness[i - 1])
        }
        walk(b.bodyId, 0)
        out.targets.set(b.id, targets)
    }
    return out
}

export interface ValueFacts { is?: number, not?: number }

export function valueFacts(g: Graph, path: SelectPath, ref: number): ValueFacts {
    const facts = pathFacts(g, path)
    const known = comparisons(g, facts, ref)
    return {
        is: known.find(([, equal]) => equal)?.[0],
        not: nonZero(g, ref, 0, facts) ? 0 : known.find(([, equal]) => !equal)?.[0],
    }
}

function recordKeys(g: Graph, id: number): number[] | undefined {
    const n = g.nodes.get(tailOf(g, id))
    if (!n) return
    if (n.op === 'record') {
        const keys: number[] = []
        for (let i = 0; i < countLiterals(n); i += 2) keys.push(getLiteral(n, i))
        return keys
    }
    const type = n.op === 'param' ? g.nodes.get(typeRefOf(n)) : undefined
    if (type?.op === 'record-type') return recordFields(type).map(field => field.key)
    if (n.op === 'heap-handle' && !getRef(n, 0) && countIds(n) > 1) return snapshotKeys(getLiteral(n, 1) as intrinsics.Handle)
    if (n.op === 'select') return recordKeys(g, getRef(n, 1))
}

function detachRecordOrdering(g: Graph): Graph {
    const owners = new Map<number, number>()
    for (const b of g.blocks) {
        for (const p of b.params) {
            const u = g.nodes.get(p)
            if (u && recordKeys(g, p)) owners.set(p, b.id)
        }
    }
    if (!owners.size) return g
    const nils = new Map<number, number>()
    function detach(n: GraphNode, i: number) {
        const owner = owners.get(getRef(n, i))
        if (owner === undefined) return
        let nil = nils.get(owner)
        if (!nil) nils.set(owner, nil = createNode(g, 'nil-effect', [literal(owner)]))
        setRef(n, i, nil)
    }
    for (const n of [...g.nodes.values()]) {
        if (n.op === 'after') {
            for (let i = 0; i < countIds(n) - 1; i++) detach(n, i)
        } else if (OrderedValues.has(n.op)) {
            detach(n, 0)
        }
    }
    return g
}

function paramNode(): GraphNode {
    return makeNode('param', [])
}

const BinaryOps = new Set<string>([
    'add', 'sub', 'mul', 'div', 'rem', 'pow', 'or', 'and', 'xor', 'shl', 'shr', 'ushr', 'subsat',
])
const CompareOps = new Set<string>(['lt', 'le', 'gt', 'ge', 'eq', 'ne'])
const InverseCompare: Record<string, string> = {
    eq: 'ne', ne: 'eq', lt: 'ge', ge: 'lt', le: 'gt', gt: 'le',
}
const UnaryOps = new Set<string>(['neg', 'not'])
export const NumericOps = new Set<string>([...BinaryOps, ...CompareOps, ...UnaryOps])

type Range = [lo: number, hi: number]
const RangeLimit = 2 ** 53
const ArrivalShapes = new Set<string>(['param', 'literal', 'after', 'and', 'or', 'xor', 'shl', 'ushr', 'add', 'sub', 'mul', 'convert', 'select'])

const RangedTypes = new Set<Types>([Types.u8, Types.u16, Types.u32, Types.u64, Types.i8, Types.i16, Types.i32, Types.i64, Types.bool])

function rangeMax(T: Types): number {
    if (!RangedTypes.has(T)) return Infinity
    if (T === Types.bool) return 1
    const bits = intrinsics.intrinsicBitWidth(T) - (lowering.isSignedType(T) ? 1 : 0)
    return bits < 53 ? 2 ** bits - 1 : Infinity
}

function truncated(T: Types): Range {
    return RangedTypes.has(T) && !lowering.isSignedType(T) ? [0, rangeMax(T)] : [0, Infinity]
}

function rangeOf(T: Types, lo: number, hi: number): Range {
    return hi <= rangeMax(T) && hi < RangeLimit ? [lo, hi] : [0, Infinity]
}

export interface RangeFacts {
    range(ref: number, literal: number, facts: Facts): Range
    le(a: number, ak: number, b: number, bk: number, facts: Facts): boolean
    lt(a: number, ak: number, b: number, bk: number, facts: Facts): boolean
}

export function rangeFacts(g: Graph, arrivalsOf: (block: number) => TailPosition[]): RangeFacts {
    let owners: Map<number, [block: GraphBlock, index: number]> | undefined
    function ownerOf(param: number): [block: GraphBlock, index: number] | undefined {
        if (!owners) {
            owners = new Map()
            for (const b of g.blocks) for (let i = 0; i < b.params.length; i++) owners.set(b.params[i], [b, i])
        }
        return owners.get(param)
    }
    const inbound = new Map<number, TailPosition[]>()
    function arrivals(block: number): TailPosition[] {
        let list = inbound.get(block)
        if (!list) inbound.set(block, list = arrivalsOf(block))
        return list
    }

    const params = new Map<number, Range>()
    const pending = new Set<number>()
    function paramRange(p: number): Range {
        const memo = params.get(p)
        if (memo) return memo
        const T = typeOf(g.nodes.get(p)!)
        const full = rangeOf(T, 0, Infinity)
        if (pending.has(p)) return full
        const closure = [p]
        const seen = new Set<number>([p])
        const inputs: [ref: number, literal: number, facts: Facts][] = []
        for (let i = 0; i < closure.length; i++) {
            const [b, k] = ownerOf(closure[i])!
            if (b === g.blocks[0]) return full
            for (const pos of arrivals(b.id)) {
                const app = g.nodes.get(pos.at)!
                if (countIds(app) !== b.params.length + 1) return full
                const ref = getRef(app, k + 1)
                const facts = pathFacts(g, pos.path)
                if (ref && g.nodes.get(ref)?.op === 'param' && ownerOf(ref) && !comparisons(g, facts, ref).length) {
                    if (!seen.has(ref)) {
                        seen.add(ref)
                        closure.push(ref)
                    }
                    continue
                }
                inputs.push([ref, getLiteral(app, k + 1), facts])
            }
        }
        for (const q of closure) pending.add(q)
        let lo = Infinity
        let hi = 0
        for (const [ref, literal, facts] of inputs) {
            const [l, h] = range(ref, literal, facts)
            lo = Math.min(lo, l)
            hi = Math.max(hi, h)
        }
        for (const q of closure) pending.delete(q)
        const out = inputs.length ? rangeOf(T, lo, hi) : full
        params.set(p, out)
        return out
    }

    function shape(n: GraphNode, facts: Facts): Range {
        const T = typeOf(n)
        const operand = (i: number) => range(getRef(n, i), getLiteral(n, i), facts)
        const fits = (lo: number, hi: number): Range => rangeOf(T, lo, hi)
        const full = fits(0, Infinity)
        if (CompareOps.has(n.op)) return [0, 1]
        if (n.op === 'literal') return range(0, getLiteral(n, 0), facts)
        if (n.op === 'after') return operand(countIds(n) - 1)
        if (n.op === 'load') return truncated(T)
        if (n.op === 'convert') {
            const [lo, hi] = operand(0)
            return hi <= rangeMax(T) && hi < RangeLimit ? [lo, hi] : truncated(T)
        }
        if (n.op === 'and') return fits(0, Math.min(operand(0)[1], operand(1)[1]))
        if (n.op === 'or' || n.op === 'xor') {
            const h = Math.max(operand(0)[1], operand(1)[1])
            return h === Infinity ? full : fits(0, 2 ** Math.ceil(Math.log2(h + 1)) - 1)
        }
        if ((n.op === 'ushr' || n.op === 'shl') && !getRef(n, 1)) {
            const a = operand(0)
            const m = 2 ** getLiteral(n, 1)
            if (n.op === 'shl') return fits(a[0] * m, a[1] * m)
            const hi = a[1] !== Infinity ? Math.floor(a[1] / m) : 64 - getLiteral(n, 1) < 53 ? 2 ** (64 - getLiteral(n, 1)) - 1 : Infinity
            return fits(Math.floor(a[0] / m), hi)
        }
        if (n.op === 'add') {
            const a = operand(0)
            const b = operand(1)
            return fits(a[0] + b[0], a[1] + b[1])
        }
        if (n.op === 'mul') {
            const a = operand(0)
            const b = operand(1)
            return fits(a[0] * b[0], a[1] * b[1])
        }
        if (n.op === 'sub') {
            const a = operand(0)
            const b = operand(1)
            return a[0] >= b[1] ? fits(a[0] - b[1], a[1] - b[0]) : full
        }
        if (n.op === 'select') {
            let lo = Infinity
            let hi = 0
            for (let i = 1; i < countIds(n); i++) {
                const [l, h] = operand(i)
                lo = Math.min(lo, l)
                hi = Math.max(hi, h)
            }
            return fits(lo, hi)
        }
        return full
    }

    const plain = new Map<number, Range>()
    function range(ref: number, literal: number, facts: Facts): Range {
        if (!ref) return Number.isSafeInteger(literal) && literal >= 0 ? [literal, literal] : [0, Infinity]
        const n = g.nodes.get(ref)
        if (!n) return [0, Infinity]
        if (n.op === 'param' && ownerOf(ref)) return refine(ref, paramRange(ref), facts)
        if (facts.length) return refine(ref, shape(n, facts), facts)
        const memo = plain.get(ref)
        if (memo) return memo
        const r = shape(n, facts)
        plain.set(ref, r)
        return r
    }

    function refine(ref: number, r: Range, facts: Facts): Range {
        for (const [k, equal] of comparisons(g, facts, ref)) {
            if (!Number.isSafeInteger(k) || k < 0) continue
            if (equal) return [k, k]
            if (k === r[0] && r[0] < r[1]) r = [r[0] + 1, r[1]]
            else if (k === r[1] && r[0] < r[1]) r = [r[0], r[1] - 1]
        }
        return r
    }

    const pairs = new Map<string, boolean>()
    function related(a: number, b: number, kind: string, test: (x: number, xk: number, y: number, yk: number, facts: Facts) => boolean): boolean {
        const pa = a && g.nodes.get(a)?.op === 'param' ? ownerOf(a) : undefined
        const pb = b && g.nodes.get(b)?.op === 'param' ? ownerOf(b) : undefined
        if (!pa || !pb || pa[0] !== pb[0] || pa[0] === g.blocks[0]) return false
        const key = `${kind}${a}:${b}`
        const memo = pairs.get(key)
        if (memo !== undefined) return memo
        pairs.set(key, false)
        const block = pa[0]
        const list = arrivals(block.id)
        let holds = list.length > 0
        for (const pos of list) {
            const app = g.nodes.get(pos.at)!
            if (countIds(app) !== block.params.length + 1
                || !test(getRef(app, pa[1] + 1), getLiteral(app, pa[1] + 1), getRef(app, pb[1] + 1), getLiteral(app, pb[1] + 1), pathFacts(g, pos.path))) {
                holds = false
                break
            }
        }
        pairs.set(key, holds)
        return holds
    }

    function le(a: number, ak: number, b: number, bk: number, facts: Facts, depth = 0): boolean {
        if (a === b && (a || ak === bk)) return true
        if (!a && ak === 0) return true
        if (range(a, ak, facts)[1] <= range(b, bk, facts)[0]) return true
        if (depth > 4) return false
        const n = a ? g.nodes.get(a) : undefined
        if (n?.op === 'and') {
            for (const i of [0, 1]) if (le(getRef(n, i), getLiteral(n, i), b, bk, facts, depth + 1)) return true
        }
        return related(a, b, 'le', (x, xk, y, yk, f) => le(x, xk, y, yk, f, depth + 1))
    }

    function lt(a: number, ak: number, b: number, bk: number, facts: Facts, depth = 0): boolean {
        if (range(a, ak, facts)[1] < range(b, bk, facts)[0]) return true
        if (depth > 4) return false
        const m = b ? g.nodes.get(b) : undefined
        if (m?.op === 'add') {
            for (const i of [0, 1]) {
                if (getRef(m, i ^ 1) || getLiteral(m, i ^ 1) < 1) continue
                const c = range(getRef(m, i), getLiteral(m, i), facts)
                const top = c[1] + getLiteral(m, i ^ 1)
                if (top <= rangeMax(typeOf(m)) && top < RangeLimit && le(a, ak, getRef(m, i), getLiteral(m, i), facts, depth + 1)) return true
            }
        }
        return related(a, b, 'lt', (x, xk, y, yk, f) => lt(x, xk, y, yk, f, depth + 1))
    }

    return { range, le, lt }
}

export function isNumeric(g: Graph, id: number, entry: (param: number) => boolean, visiting = new Set<number>()): boolean {
    if (!id) return true
    const n = g.nodes.get(id)
    if (!n) return false
    if (n.op === 'literal' || NumericOps.has(n.op)) return true
    if (n.op === 'select') return isNumeric(g, getRef(n, 1), entry, visiting) && isNumeric(g, getRef(n, 2), entry, visiting)
    if (n.op !== 'param') return false
    if (visiting.has(id)) return true
    const block = g.blocks.find(b => b.params.includes(id))
    if (!block) return false
    if (!block.id) return entry(id)
    visiting.add(id)
    const at = block.params.indexOf(id) + 1
    let arrived = false
    for (const m of g.nodes.values()) {
        if (m.op !== 'apply' || getRef(m, 0) !== block.id) continue
        if (!isNumeric(g, getRef(m, at), entry, visiting)) return false
        arrived = true
    }
    return arrived
}
const FloatArith = new Set(['add', 'sub', 'mul', 'div', 'neg'])

export function floatValues(g: Graph): Set<number> {
    const floats = new Set<number>()
    const flows = new Map<number, number[]>()
    const pending: number[] = []
    function mark(id: number): void {
        if (!id || floats.has(id)) return
        floats.add(id)
        pending.push(id)
    }
    function flow(from: number, to: number, literal: number): void {
        if (!from) {
            if (!Number.isInteger(literal)) mark(to)
            return
        }
        const list = flows.get(from)
        if (list) list.push(to)
        else flows.set(from, [to])
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== 'store' && typeSlots(n.op) && typeOf(n) === Types.f64) mark(id)
        if (n.op === 'literal' && !Number.isInteger(literalValue(n))) mark(id)
        if (n.op === 'call' && resultType(g, n) === Types.f64) mark(id)
        if (FloatArith.has(n.op)) {
            for (let i = 0; i < countIds(n); i++) flow(getRef(n, i), id, getLiteral(n, i))
        } else if (n.op === 'select') {
            for (let i = 1; i < countIds(n); i++) flow(getRef(n, i), id, getLiteral(n, i))
        } else if (n.op === 'after') {
            flow(getRef(n, countIds(n) - 1), id, getLiteral(n, countIds(n) - 1))
        } else if (n.op === 'apply') {
            const block = getBlock(g, getRef(n, 0))
            if (!block) continue
            block.params.forEach((p, i) => flow(getRef(n, i + 1), p, getLiteral(n, i + 1)))
        }
    }
    while (pending.length) for (const to of flows.get(pending.pop()!) ?? []) mark(to)
    return floats
}

function comparesFloats(g: Graph, c: GraphNode): boolean {
    for (let i = 0; i < 2; i++) {
        if (getRef(c, i) ? operandType(g, c, i) === Types.f64 : !Number.isInteger(getLiteral(c, i))) return true
    }
    return false
}

const TargetingValues = new Set([
    'syscall-target', 'local-target', 'indirect-target'
])
export const OrderedValues = new Set([
    'load', 'store', 'call', 'pstack', 'rt'
])
function firstNonOrderingSlot(n: GraphNode): number {
    return n.op === 'after' ? countIds(n) - 1 : OrderedValues.has(n.op) ? 1 : 0
}
const PureOps = new Set<string>([
    'mem',
    'add', 'sub', 'mul', 'div', 'rem', 'pow', 'or', 'and', 'xor', 'shl', 'shr', 'ushr', 'subsat',
    'lt', 'le', 'gt', 'ge', 'eq', 'ne', 'neg', 'not', 'select', 'convert', 'bitconvert',
    'pool-entry', 'void', 'param', 'heap-handle', 'nil-effect', 'block', 
    'literal', 'get', 'record', 'unreachable', 'alloca', 'frame-address', 'pc', 'encode', 'decode', 'box', 'unbox',
    ...TargetingValues
])
const Commutative = new Set<string>(['add', 'mul', 'and', 'or', 'xor', 'ne', 'eq'])
const OrderingOps = new Set<string>(['after', 'nil-effect'])
function latency(costs: lowering.TargetCosts, op: string): number {
    if (OrderingOps.has(op)) return 0
    return costs.latency.get(op) ?? 1
}
const commutativeKeys = intrinsics.argv().includes('commutative-keys')
const framedTailCalls = intrinsics.argv().includes('framed-tail-calls')

const LiftableSlots: Record<string, number[]> = {
    load: [1, 2],
    store: [1, 2, 3],
    select: [1, 2],
    ret: [0],
}

function inlineableLiteral(costs: lowering.TargetCosts, v: f64): boolean {
    const bound = costs.inlineLiteral
    return !Number.isSafeInteger(v) || (v > -bound && v < bound)
}

export function liftableSlot(op: string, slot: number): boolean {
    if (op === 'call') return slot >= 3
    if (BinaryOps.has(op) || CompareOps.has(op)) return slot < 2
    if (UnaryOps.has(op) || op === 'convert' || op === 'bitconvert') return slot === 0
    return LiftableSlots[op]?.includes(slot) ?? false
}
const SwappedCmp: Record<string, string> = {
    lt: 'gt', gt: 'lt', le: 'ge', ge: 'le', eq: 'eq', ne: 'ne',
}

export interface LowerGraphOptions {
    target?: lowering.Target
    regBudget?: number
    debug?: boolean
    clobbersOf?: (symbol: number) => Set<number> | undefined
    poolSlot?: (value: number) => number
    poolValue?: (slot: number) => number | undefined
}

export interface LowerGraphResult {
    target: lowering.Target
    words: number[]
    bytes: number[]
    relocations: lowering.Relocation[]
    listing: string
    clobbers: Set<number>
    localCalls: Set<number>
    island?: number[]
}

// TODO:
// V1: (call, nil, p2, 0)
// = (select, p0, V1, (select, p1, (call, (call, nil, p3, 0), p2, 0), V1))
//
// can be turned into (select, (and, p0, (not, p1)), (call, nil, p2, 0), (call, (call, nil, p3, 0), p2, 0))

export function pureValues(g: Graph): Set<number> {
    const impure = new Set<number>()
    const epoch = nextEpoch(g)
    function walk(id: number): boolean {
        if (!id) return true
        const n = g.nodes.get(id)!
        if (!markVisited(n, epoch)) return !impure.has(id)
        let ok = PureOps.has(n.op) || islandLoad(g, n)
        if (ok) for (const a of gn.enumerateRefs(n)) if (!walk(a)) { ok = false; break }
        if (!ok) impure.add(id)
        return ok
    }
    for (const b of g.blocks) {
        for (const p of b.params) walk(p)
        walk(b.bodyId)
    }
    return impure
}

function literalValue(u: GraphNode) {
    return getLiteral(u, 0)
}

const CompareEval: Record<string, (a: number, b: number) => boolean> = {
    lt: (a, b) => a < b, le: (a, b) => a <= b, gt: (a, b) => a > b,
    ge: (a, b) => a >= b, eq: (a, b) => a === b, ne: (a, b) => a !== b,
}

function latencyDepth(g: Graph, costs: lowering.TargetCosts): (id: number) => number {
    const depths = new Map<number, number>()
    function depthOf(id: number): number {
        const known = depths.get(id)
        if (known !== undefined) return known
        depths.set(id, 0)
        const n = g.nodes.get(id)
        let d = 0
        if (n && n.op !== 'param' && n.op !== 'block' && n.op !== 'literal') {
            for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) d = Math.max(d, depthOf(getRef(n, i)))
            d += latency(costs, n.op)
        }
        depths.set(id, d)
        return d
    }
    return depthOf
}

function scalarOperand(nodes: Map<number, GraphNode>, n: GraphNode, i: number): number | undefined {
    const id = getRef(n, i)
    if (!id) return getLiteral(n, i)
    const u = nodes.get(id)
    return u?.op === 'literal' ? literalValue(u) : undefined
}

function nodeKey(n: GraphNode, argIds = getArgIds(n), argConsts = getArgConsts(n), ignoreWordWidth = false): string {
    const parts = [n.flags ? `${n.op}!${n.flags}` : n.op]
    for (let i = 0; i < argIds.length; i++) {
        parts.push(argIds[i] ? `v${argIds[i]}` : `c${argConsts[i]}`)
    }
    if (commutativeKeys && argIds.length === 2 && Commutative.has(n.op) && parts[1] > parts[2]) parts.push(...parts.splice(1, 1))
    for (let i = argIds.length; i < argConsts.length; i++) {
        parts.push(`c${argConsts[i]}`)
    }
    const slots = typeSlots(n.op)
    // XXX: graph arithmetic can carry u32/u64 decoration that lowering treats identically.
    const word = (type: number) => type === Types.u32 || type === Types.u64
    const eraseWidth = ignoreWordWidth && BinaryOps.has(n.op) && word(typeOf(n))
    if (slots) parts.push(eraseWidth ? 'tuword' : typeRefOf(n) ? `t%${typeRefOf(n)}` : `t${typeOf(n)}`)
    return parts.join(',')
}

function createNode(g: Graph, op: string, operands: (number | GraphNode)[], original?: GraphNode): number {
    const converted = operands.map((o): Operand => {
        if (typeof o === 'number') return o
        assert(o.op === 'literal')
        return { literal: literalValue(o) }
    })
    const id = g.maxId++
    g.nodes.set(id, original ? copyNode(original, converted, op) : makeNode(op, converted))
    return id
}

function literal(v: number): GraphNode {
    return makeNode('literal', [{ literal: v }])
}

const orderingSink = makeNode('after', [0, 0])

const sigStats = intrinsics.argv().includes('sig-stats') ? {
    applyMoves: 0, fromParam: 0, fromValue: 0, swaps: 0,
    steered: 0, steerFailed: 0, edges: 0, edgesBlocked: 0,
    displaced: 0, mismatch: 0, displacedToSlot: 0, dstIsSlot: 0,
    leaked: 0, leakedBlocks: 0, blocks: 0, leakKinds: new Map<string, number>(),
} : undefined
if (sigStats) process.on('beforeExit', () => {
    console.log('SIGSTATS', JSON.stringify({
        applyMoves: sigStats.applyMoves, fromParam: sigStats.fromParam,
        fromValue: sigStats.fromValue, swaps: sigStats.swaps,
        steered: sigStats.steered, steerFailed: sigStats.steerFailed,
        displaced: sigStats.displaced, mismatch: sigStats.mismatch,
        displacedToSlot: sigStats.displacedToSlot, dstIsSlot: sigStats.dstIsSlot,
        blocksEmitted: sigStats.blocks, blocksLeakingHomes: sigStats.leakedBlocks,
        homesLeakedAtBlockEnd: sigStats.leaked,
        affinityEdges: sigStats.edges, affinityBlocked: sigStats.edgesBlocked,
    }))
    console.log('  leak kinds', [...sigStats.leakKinds].sort((a, b) => b[1] - a[1])
        .map(([k, v]) => `${k}:${v}`).join(' '))
})

function forEachOperand(g: Graph, vid: number, fn: (n: GraphNode, id: number, idx: number) => number | undefined | void) {
    if (!vid) return vid
    const n = g.nodes.get(vid)!
    const vals: [number, number][] = []
    for (let i = 0; i < countIds(n); i++) {
        const id = getRef(n, i)
        if (!id) continue
        if (const u = g.nodes.get(id)) {
            const r = fn(u, id, i)
            if (r && r !== id) {
                vals.push([i, r])
            }
        }
    }
    if (!vals.length) return vid
    const operands = new Array(countIds(n))
    for (let i = 0; i < countIds(n); i++) {
        if (vals.length && vals[0][0] === i) {
            const x = vals.shift()!
            operands[i] = x[1]
            continue
        }
        const id = getRef(n, i)
        if (!id) {
            operands[i] = literal(getLiteral(n, i))
        } else {
            operands[i] = id
        }
    }
    return createNode(g, n.op, operands, n)
}

export function sweepBlocks(g: Graph) {
    const epoch = nextEpoch(g)
    let seenCount = 0
    function see(n: GraphNode) {
        if (!markVisited(n, epoch)) return false
        seenCount += 1
        return true
    }
    function visit(n: GraphNode, id: number) {
        if (!see(n)) return
        const type = gn.typeRefOf(n)
        if (type) visit(g.nodes.get(type)!, type)
        if (n.op === 'block') {
            const b = getBlock(g, id)!
            for (const p of b.params) {
                visit(g.nodes.get(p)!, p)
            }
            if (!b.bodyId) return
            visit(g.nodes.get(b.bodyId)!, b.bodyId)
            return
        }
        const refSlots = gn.countIds(n)
        for (let i = 0; i < refSlots; i++) {
            const x = gn.getRef(n, i)
            if (!x) continue
            visit(g.nodes.get(x)!, x)
        }
    }
    const rootBlock = g.blocks[0]
    if (!g.nodes.has(0)) {
        g.nodes.set(0, gn.makeNodeFromSlots('block', new Uint32Array([])))
    }
    see(g.nodes.get(0)!)
    for (const p of rootBlock.params) {
        see(g.nodes.get(p)!)
    }
    if (rootBlock.bodyId) {
        const n = g.nodes.get(rootBlock.bodyId)!
        visit(n, rootBlock.bodyId)
    }
    if (seenCount === g.nodes.size) {
        return g
    }
    for (const [k, v] of g.nodes) {
        if (v.epoch !== epoch) {
            g.nodes.delete(k)
        }
    }
    const result = g.blocks.filter(x => g.nodes.has(x.id))
    assert(result[0].id === 0)
    setGraphBlocks(g, result)
    return g
}

function operand(n: GraphNode, idx: number) {
    const id = getRef(n, idx)
    return id || literal(getLiteral(n, idx))
}

function transformVoids(g: Graph) {
    function producesVoid(id: number): boolean {
        if (!id) return false
        const n = g.nodes.get(id)
        if (!n) return false
        if (n.op === 'void') return true
        if (n.op === 'ret') return producesVoid(getRef(n, 0))
        if (n.op === 'after') return producesVoid(getRef(n, countIds(n)-1))
        if (n.op === 'select') return producesVoid(getRef(n, 1)) && producesVoid(getRef(n, 2))
        return false
    }
    function replaceVoids(id: number): number | GraphNode {
        const n = g.nodes.get(id)!
        if (n.op === 'void') return literal(0)
        if (n.op !== 'ret' && n.op !== 'after' && n.op !== 'select') return id
        const vals: [number, number | GraphNode][] = []
        const start = n.op === 'select' ? 1 : n.op === 'after' ? countIds(n)-1 : 0
        for (let i = start; i < countIds(n); i++) {
            const arg = getRef(n, i)
            if (!arg) continue
            const r = replaceVoids(arg)
            if (r !== arg) vals.push([i, r])
        }
        if (!vals.length) return id
        const operands: (number | GraphNode)[] = getArgIds(n).map((arg, i) => arg || literal(getLiteral(n, i)))
        for (const [i, r] of vals) operands[i] = r
        return createNode(g, n.op, operands, n)
    }
    let epoch = nextEpoch(g)
    const replacements = new Map<number, number>()
    const rets = new Map<number, number[]>()
    let currentInline = 0
    function visit(n: GraphNode, id: number): number | undefined {
        if (const r = replacements.get(id)) {
            const value = visit(g.nodes.get(r)!, r) ?? r
            replacements.set(id, value)
            return value
        }
        if (!markVisited(n, epoch)) return
        if (n.op === 'block') {
            const b = getBlock(g, id)!
            b.bodyId = visit(g.nodes.get(b.bodyId)!, b.bodyId) ?? b.bodyId
            return
        }
        if (n.op === 'inlined') {
            const saveInlined = currentInline
            defer currentInline = saveInlined
            currentInline = id
            const r = forEachOperand(g, id, visit)
            if (r && r !== id) replacements.set(id, r)
            return r
        }
        if (n.op === 'ret') {
            let arr = rets.get(currentInline)
            if (!arr) rets.set(currentInline, arr = [])
            arr.push(id)
        }
        const r = forEachOperand(g, id, visit)
        if (r && r !== id) replacements.set(id, r)
        return r
    }
    const root = g.blocks[0].bodyId
    visit(g.nodes.get(root)!, root)
    for (const returns of rets.values()) {
        if (returns.every(producesVoid)) continue
        for (const id of returns) {
            const r = replaceVoids(id) as number
            if (r !== id) replacements.set(id, r)
        }
    }
    epoch = nextEpoch(g)
    g.blocks[0].bodyId = visit(g.nodes.get(root)!, root) ?? root
    return g
}

function makeTailsUnique(g: Graph) {
    function cloneTail(id: number) {
        if (!id) return id
        const n = g.nodes.get(id)
        assert(n)
        const next = g.maxId++
        const copy = copyNode(n)
        g.nodes.set(next, copy)
        if (n.op === 'select') {
            for (let i = 1; i < countIds(n); i++) {
                const uid = getRef(n, i)
                if (!uid) continue
                const u = g.nodes.get(uid)
                assert(u)
                setRef(copy, i, cloneTail(uid))
            }
        } else if (n.op === 'after' && getRef(n, countIds(n) - 1)) {
            setRef(copy, countIds(n) - 1, cloneTail(getRef(n, countIds(n) - 1)))
        }
        return next
    }
    for (const b of g.blocks) {
        b.bodyId = cloneTail(b.bodyId)
    }
}

function replaceAll(g: Graph, id: number, replacements: Map<number, number>, cloneAll = false, epoch = nextEpoch(g)): number {
    if (!id) return id
    if (const replacement = replacements.get(id)) {
        return replacement
    }
    const n = g.nodes.get(id)
    if (!n || isParam(g.nodes, id)) return id
    if (!markVisited(n, epoch)) return id
    const ids = getArgIds(n)
    const idReplacements: [idx: number, id: number][] = []
    for (let i = 0; i < ids.length; i++) {
        const next = replaceAll(g, ids[i], replacements, false, epoch)
        if (next !== ids[i]) { 
            idReplacements.push([i, next])
        }
    }
    if (!idReplacements.length && !cloneAll) return id
    const newIds = new Array(ids.length)
    for (let i = 0; i < ids.length; i++) {
        if (idReplacements[0]?.[0] === i) {
            newIds[i] = idReplacements.shift()![1]
        } else {
            newIds[i] = ids[i] || literal(getLiteral(n, i))
        }
    }
    const copy = createNode(g, n.op, newIds, n)
    replacements.set(id, copy)
    return copy
}

function replaceLiterals(g: Graph) {
    for (const [id, n] of g.nodes) {
        if (n.op === 'literal') continue
        for (let i = 0; i < countIds(n); i++) {
            const uid = getRef(n, i)
            if (!uid) continue
            const u = g.nodes.get(uid)!
            if (u.op !== 'literal') continue
            setLiteral(n, i, literalValue(u))
        }
    }
}

function returnedRecord(g: Graph, ret: GraphNode): GraphNode | undefined {
    const n = g.nodes.get(getRef(ret, 0))
    return n?.op === 'record' ? n : undefined
}

function outlineReturns(g: Graph): Graph {
    const blockId = createNode(g, 'block', [])
    let replaced = false
    let hasLiterals = false
    let fields = 0
    for (const n of g.nodes.values()) {
        if (n.op !== 'ret') continue
        const record = returnedRecord(g, n)
        const width = record ? countIds(record) / 2 : 0
        assert(!replaced || fields === width, 'lowering: returns disagree on shape')
        replaced = true
        fields = width
    }
    replaced = false
    for (const [id, n] of g.nodes) {
        if (n.op !== 'ret') continue
        replaced = true
        const operands: (number | GraphNode)[] = [blockId]
        const record = returnedRecord(g, n)
        if (record) {
            for (let i = 0; i < fields; i++) {
                assert(getLiteral(record, i * 2) === i, 'lowering: returned record is not in slot order')
                operands.push(operand(record, i * 2 + 1))
            }
        } else {
            operands.push(operand(n, 0))
            if (!getRef(n, 0)) hasLiterals = true
        }
        g.nodes.set(id, g.nodes.get(createNode(g, 'apply', operands, n))!)
    }
    if (!replaced) {
        g.nodes.delete(blockId)
        return g
    }
    const params: number[] = []
    for (let i = 0; i < Math.max(fields, 1); i++) params.push(createNode(g, 'param', []))
    const values: (number | GraphNode)[] = []
    for (let i = 0; i < fields; i++) values.push(literal(i), params[i])
    const bodyId = createNode(g, 'ret', [fields ? createNode(g, 'record', values) : params[0]])
    addGraphBlock(g, { id: blockId, params, bodyId, bodyConst: 0 })
    if (hasLiterals) replaceLiterals(g)
    return g
}

function replacePanics(g: Graph & { hasInlinedVals?: boolean }): typeof g {
    for (const [id, n] of g.nodes) {
        if (n.op === 'inlined') {
            g.hasInlinedVals = true
        }
        if (n.op !== 'panic') continue
        const unreachable = createNode(g, 'unreachable', [], n)
        if (!getRef(n, 0)) {
            g.nodes.set(id, g.nodes.get(unreachable)!)
            continue
        }
        const op = g.nodes.get(getRef(n, 0))!.op
        if (op !== 'param' && PureOps.has(op)) {
            g.nodes.set(id, g.nodes.get(unreachable)!)
            continue
        }
        const v = operand(n, 0)
        const a = createNode(g, 'after', [v, unreachable])
        g.nodes.set(id, g.nodes.get(a)!)
    }
    return g
}

function outlinePanics(g: Graph): Graph {
    const blockId = createNode(g, 'block', [])
    let replaced = false
    let hasLiterals = false
    for (const [id, n] of g.nodes) {
        if (n.op !== 'panic') continue
        replaced = true
        const v = operand(n, 0)
        if (!getRef(n, 0)) hasLiterals = true
        g.nodes.set(id, g.nodes.get(createNode(g, 'apply', [blockId, v], n))!)
    }
    if (!replaced) {
        g.nodes.delete(blockId)
        return g
    }
    const parameter = createNode(g, 'param', [])
    const bodyId = createNode(g, 'panic', [parameter])
    addGraphBlock(g, { id: blockId, params: [parameter], bodyId, bodyConst: 0 })
    if (hasLiterals) replaceLiterals(g)
    return g
}

export function inlineBlocks(g: Graph) {
    makeTailsUnique(g)
    transformVoids(g)
    function reduceInlined() {
        const refs: number[] = []
        const jumped = new Set<number>()
        const jumpedBy = new Map<number, number>()
        function logInlinedBlocks() {
            const sites = new Map<number, Set<number>>()
            for (const b of g.blocks) {
                const epoch = nextEpoch(g)
                function walk(id: number): void {
                    if (!id) return
                    const n = g.nodes.get(id)
                    if (!n || !markVisited(n, epoch)) return
                    if (n.op === 'block') return
                    if (n.op === 'inlined') {
                        let s = sites.get(id)
                        if (!s) sites.set(id, s = new Set())
                        s.add(b.id)
                    }
                    for (let i = 0; i < countIds(n); i++) walk(getRef(n, i))
                }
                walk(b.bodyId)
            }
            const succ = new Map<number, Set<number>>()
            for (const b of g.blocks) {
                const epoch = nextEpoch(g)
                const out = new Set<number>()
                succ.set(b.id, out)
                function edges(id: number): void {
                    if (!id) return
                    const n = g.nodes.get(id)
                    if (!n || !markVisited(n, epoch)) return
                    if (n.op === 'block') { out.add(id); return }
                    for (let i = 0; i < countIds(n); i++) edges(getRef(n, i))
                }
                edges(b.bodyId)
            }
            function reaches(from: number, to: number): boolean {
                const seen = new Set<number>([from])
                const queue = [from]
                while (const cur = queue.pop()) {
                    if (cur === to) return true
                    for (const nx of succ.get(cur) ?? []) {
                        if (seen.has(nx)) continue
                        seen.add(nx)
                        queue.push(nx)
                    }
                }
                return false
            }
            for (const [id, blocks] of sites) {
                if (blocks.size < 2) continue
                const arr = [...blocks]
                const head = arr.filter(a => arr.every(b => a === b || reaches(a, b)))
                const pairs: string[] = []
                for (let i = 0; i < arr.length; i++) {
                    for (let j = i + 1; j < arr.length; j++) {
                        if (!reaches(arr[i], arr[j]) && !reaches(arr[j], arr[i])) pairs.push(`B${arr[i]}/B${arr[j]}`)
                    }
                }
                console.log(`inlined ${id} in ${arr.map(x => `B${x}`).join(', ')}`)
                console.log(`    reaches-all: ${head.length ? head.map(x => `B${x}`).join(', ') : 'NONE'}`
                    + (pairs.length ? `   divergent: ${pairs.join(' ')}` : '   (total order)'))
            }
            return sites
        }
        const siteBlocks = intrinsics.argv().includes('inline-debug') ? logInlinedBlocks() : undefined
        function findSite(root: number): number | undefined {
            refs.length = 0
            const epoch = nextEpoch(g)
            function find(id: number): number | undefined {
                if (!id) return
                const n = g.nodes.get(id)
                if (!n || !markVisited(n, epoch)) return
                if (n.op === 'block') {
                    refs.push(id)
                    return
                }
                if (n.op === 'inlined') return id
                for (let i = countIds(n) - 1; i >= 0; i--) {
                    const found = find(getRef(n, i))
                    if (found) return found
                }
                return
            }
            return find(root)
        }

        function convert(block: GraphBlock, site: number) {
            const source = g.nodes.get(site)!
            if (siteBlocks) {
                const seen = siteBlocks.get(site)
                const where = seen ? [...seen].map(x => `B${x}`).join(', ') : '<none>'
                const picked = seen?.has(block.id) ? '' : ' NOT-IN-SET'
                console.log(`convert site=${site} at B${block.id} of ${seen?.size ?? 0}: ${where}${picked}`)
            }
            const memo = new Map<number, boolean>()
            function reaches(id: number): boolean {
                if (id === site) return true
                if (!id) return false
                const known = memo.get(id)
                if (known !== undefined) return known
                const n = g.nodes.get(id)
                const out = !!n && n.op !== 'block' && getArgIds(n).some(arg => reaches(arg))
                memo.set(id, out)
                return out
            }

            let parent = 0
            let slot = 0
            let at = block.bodyId
            let body = at
            let bodyParent = parent
            let bodySlot = slot
            while (at !== site) {
                const n = g.nodes.get(at)!
                if (n.op === 'ret' || jumped.has(at)) {
                    body = at
                    bodyParent = parent
                    bodySlot = slot
                    break
                }
                let next = -1
                if (n.op === 'select') {
                    if (reaches(getRef(n, 0))) break
                    let arms = 0
                    for (let i = 1; i < countIds(n); i++) {
                        if (!reaches(getRef(n, i))) continue
                        arms++
                        next = i
                    }
                    if (arms > 1) {
                        body = at
                        bodyParent = parent
                        bodySlot = slot
                        break
                    }
                } else if (n.op === 'after') {
                    const last = countIds(n) - 1
                    let leading = false
                    for (let i = 0; i < last; i++) if (reaches(getRef(n, i))) leading = true
                    if (leading) break
                    next = last
                }
                if (next < 0) break
                parent = at
                slot = next
                at = getRef(n, next)
                if (n.op === 'select') {
                    body = at
                    bodyParent = parent
                    bodySlot = slot
                }
            }

            const jumps: number[] = []
            const epoch = nextEpoch(g)
            function collect(id: number): void {
                if (!id) return
                const n = g.nodes.get(id)
                if (!n || !markVisited(n, epoch)) return
                if (n.op === 'ret') {
                    assert(!jumped.has(id), `inlined ${site}: ret ${id} already exits another inlined value`)
                    jumps.push(id)
                }
                else if (n.op === 'after') collect(getRef(n, countIds(n) - 1))
                else if (n.op === 'select') for (let i = 1; i < countIds(n); i++) collect(getRef(n, i))
                else if (n.op === 'apply') collect(getBlock(g, getRef(n, 0))?.bodyId ?? 0)
            }
            collect(getRef(source, 0))
            const shape = jumps.length ? recordKeys(g, getRef(g.nodes.get(jumps[0])!, 0)) : undefined
            const blockId = g.maxId++
            g.nodes.set(blockId, makeNode('block', []))
            for (const id of jumps) {
                const n = g.nodes.get(id)!
                jumped.add(id)
                jumpedBy.set(id, site)
                g.nodes.set(id, makeNode('apply', [blockId, getOperand(n, 0)]))
            }
            if (bodyParent) {
                const p = g.nodes.get(bodyParent)!
                const copy = copyNode(p)
                setOperand(copy, bodySlot, getOperand(source, 0))
                g.nodes.set(bodyParent, copy)
            } else {
                block.bodyId = getRef(source, 0)
                block.bodyConst = getLiteral(source, 0)
            }
            let param = makeNode('param', [])
            if (shape) {
                const type = g.maxId++
                g.nodes.set(type, createRecordType(shape.map(key => ({ key, type: Types.u64 }))))
                param = makeNode('param', [], { ref: type })
            }
            g.nodes.set(site, param)
            setDebugLabel(g, site, `inline${site}`)
            addGraphBlock(g, { id: blockId, params: [site], bodyId: body, bodyConst: 0 })
        }

        const queue: GraphBlock[] = [g.blocks[0]]
        const queued = new Set<number>([g.blocks[0].id])
        for (let i = 0; i < queue.length; i++) {
            const block = queue[i]
            while (const site = findSite(block.bodyId)) convert(block, site)
            for (const ref of refs) {
                if (queued.has(ref) || !getBlock(g, ref)) continue
                queued.add(ref)
                queue.push(getBlock(g, ref)!)
            }
        }
    }
    g = replacePanics(g)
    if ((g as ReturnType<typeof replacePanics>).hasInlinedVals) {
        reduceInlined()
        ;(g as ReturnType<typeof replacePanics>).hasInlinedVals = false
    }
    return g
}

function copyCallTargets(g: Graph) {
    const targeted = new Set<number>()
    for (const [id, n] of g.nodes) {
        const target = n.op === 'call' ? g.nodes.get(getRef(n, 1)) : undefined
        if (!target || !TargetingValues.has(target.op) || !countIds(target)) continue
        if (!targeted.has(getRef(n, 1))) {
            targeted.add(getRef(n, 1))
            continue
        }
        const copy = g.maxId++
        g.nodes.set(copy, copyNode(target))
        g.nodes.set(id, copyNode(n, withRefs(n, cloneRefs(n).map((ref, i) => i === 1 ? copy : ref))))
    }
    return g
}

const placementRegions = intrinsics.argv().includes('optimize-stats') ? new Map<string, number>() : undefined

export function packageBlocksFINAL(g: Graph) {
    g = outlineReturns(g)
    g = outlinePanics(g)
    g = copyCallTargets(g)
    const successors = new Map<number, Set<number>>()
    const preds = new Map<number, Set<number>>()
    const savedPreds = new Map<number, Set<number>>()
    const seenInBlock = new Map<number, Set<number>>()
    const depth = new Map<number, number>()
    function addTo(m: Map<number, Set<number>>, key: number, val: number) {
        let s = m.get(key)
        if (!s) m.set(key, s = new Set())
        s.add(val)
    }

    const ancestors = new Map<number, Set<number>>()
    function ancestorsOf(bid: number) {
        if (const m = ancestors.get(bid)) return m
        const r = new Set<number>()
        ancestors.set(bid, r)
        if (bid === 0) return r
        const l = [...preds.get(bid)!]
        while (const x = l.pop()) {
            if (r.has(x)) continue
            r.add(x)
            for (const q of ancestorsOf(x)) {
                if (r.has(q)) continue
                l.push(q)
            }
        }
        return r
    }

    function uniqueLca(s: Set<number>): number {
        assert(s.size)
        if (s.has(0)) return 0
        if (s.size === 1) return s.values().next().value!
        const arr = [...s]
        const c = new Set<number>(ancestorsOf(arr[0]))
        c.add(arr[0])
        for (let i = 1; i < arr.length; i++) {
            const b = arr[i]
            const c2 = ancestorsOf(b)
            for (const x of c) {
                if (!c2.has(x) && x !== b) {
                    c.delete(x)
                }
            }
        }
        for (const x of c) {
            if (!c.has(x)) continue
            for (const a of ancestorsOf(x)) {
                c.delete(a)
            }
        }
        const r = uniqueLca(c)
        return r
    }
    function addAndCheck(m: Map<number, Set<number>>, key: number, val: number) {
        let s = m.get(key)
        if (!s) {
            m.set(key, s = new Set())
            s.add(val)
            return true
        }
        const q = s.size
        s.add(val)
        return s.size !== q
    }
    const pinned = new Map<number, number>()
    function isPlaceholder(n: GraphNode) {
        return n.op === 'param' || (n.op === 'nil-effect' && countLiterals(n) === 1)
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== 'param' && isPlaceholder(n)) pinned.set(id, getLiteral(n, 0))
        else if (n.op === 'nil-effect' && countLiterals(n) === 0) pinned.set(id, 0)
    }
    function visitBlock(b: GraphBlock, blocksSeen: Set<number>) {
        for (const x of b.params) {
            pinned.set(x, b.id)
        }
        pinned.set(b.bodyId, b.id)
        function visit(id: number) {
            if (!id) return
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'block') {
                addTo(successors, b.id, id)
                addTo(preds, id, b.id)
                if (!blocksSeen.has(id)) {
                    blocksSeen.add(id)
                    visitBlock(getBlock(g, id)!, blocksSeen)
                }
                return
            }
            if (!countIds(n) && !isPlaceholder(n)) return
            const didAdd = addAndCheck(seenInBlock, id, b.id)
            if (!didAdd) return
            for (let i = 0; i < countIds(n); i++) {
                visit(getRef(n, i))
            }
        }
        visit(b.bodyId)
    }
    visitBlock(g.blocks[0], new Set())

    for (const [k, v] of preds) {
        savedPreds.set(k, new Set(v))
    }

    const seen = new Set<number>()
    const active = new Set<number>()
    function visit(bid: number) {
        if (seen.has(bid)) return
        seen.add(bid)
        active.add(bid)
        for (const to of successors.get(bid) ?? []) {
            if (active.has(to)) {
                preds.get(to)?.delete(bid)
                continue
            }
            visit(to)
        }
        active.delete(bid)
    }
    for (const [k, v] of preds) {
        visit(k)
    }
    function depthOf(b: number) {
        if (const d = depth.get(b)) return d
        if (b === 0) return 0
        const p = preds.get(b)
        assert(p)
        let r = 0
        for (const x of p) {
            r = Math.max(depthOf(x), r)
        }
        r += 1
        depth.set(b, r)
        return r
    }
    const firstPossibleUseCache = new Map<number, number>()
    function firstPossibleUse(vid: number) {
        if (!vid) return -1
        if (const x = pinned.get(vid)) return x
        const n = g.nodes.get(vid)
        if (!n || countIds(n) === 0) return -1
        if (n.op === 'block') return -1
        if (const x = firstPossibleUseCache.get(vid)) return x
        let c = -1
        for (let i = 0; i < countIds(n); i++) {
            const q = firstPossibleUse(getRef(n, i))
            if (c === q || q === -1) continue
            if (c === -1 || !ancestorsOf(c).has(q)) {
                c = q
            }
        }
        firstPossibleUseCache.set(vid, c)
        return c
    }
    function isCapture(from: number, vid: number) {
        if (!vid) return false
        if (const x = pinned.get(vid)) return x !== from
        const n = g.nodes.get(vid)
        if (!n || n.op === 'block') return false
        for (let i = 0; i < countIds(n); i++) {
            if (isCapture(from, getRef(n, i))) return true
        }
        return false
    }
    const blocksForPlacement = new Map<number, number[]>()
    function placeBlock(bid: number) {
        if (!blocksForPlacement.has(bid)) {
            blocksForPlacement.set(bid, [])
        }
        return bid
    }
    const placements = new Map<number, number[]>()
    function addPlacements(vid: number, s: Set<number>) {
        if (const b = pinned.get(vid)) {
            placements.set(vid, [placeBlock(b)])
            return
        }

        const m = firstPossibleUse(vid)
        if (m === -1) return
        const l = uniqueLca(s)
        if (m === l) {
            placements.set(vid, [placeBlock(m)])
            return
        }
        const c = new Set(ancestorsOf(l))
        c.add(l)
        for (const x of ancestorsOf(m)) {
            c.delete(x)
        }
        const res = [...c]
        res.sort((a, b) => depthOf(a) - depthOf(b))
        // sigh... what am i doing
        outer: for (let i = res.length-1; i > 0; i--) {
            const a = ancestorsOf(res[i])
            for (let j = 0; j < i; j++) {
                if (!a.has(res[j])) {
                    res.length = i
                    continue outer
                }
            }
        }
        assert(res.includes(m), `package: ${g.name ?? '<anonymous>'} placement for %${vid} misses B${m} (uses B${[...s].join(',B')}, lca B${l})`)
        placements.set(vid, res.map(placeBlock))
    }
    function pinBlock(bid: number) {
        function pinTail(vid: number, tail = true) {
            if (!vid) return
            if (const u = g.nodes.get(vid)) {
                if (u.op === 'param') return

                if (u.op === 'apply') {
                    pinned.set(vid, bid)
                    for (let i = 1; i < countIds(u); i++) {
                        pinTail(getRef(u, i), false)
                    }
                } else if (u.op === 'select') {
                    if (!tail) return
                    pinned.set(vid, bid)
                    for (let i = 1; i < countIds(u); i++) {
                        pinTail(getRef(u, i), true)
                    }
                } else if (u.op === 'ret') {
                    pinned.set(vid, bid)
                } else if (u.op === 'after') {
                    if (!tail) return
                    pinned.set(vid, bid)
                    pinTail(getRef(u, countIds(u) - 1), true)
                }
            }
        }
        pinTail(getBlock(g, bid)!.bodyId)
    }
    for (const b of g.blocks) {
        pinBlock(b.id)
    }
    for (const [k, v] of seenInBlock) {
        const n = g.nodes.get(k)!
        if (isPlaceholder(n)) {
            addPlacements(k, v)
            continue
        }
        if (!countIds(n)) continue
        if (TargetingValues.has(n.op)) continue
        addPlacements(k, v)
    }

    for (const [k] of blocksForPlacement) {
        const s = successors.get(k)
        if (!s) continue
        blocksForPlacement.set(k, [...s].filter(x => blocksForPlacement.has(x)))
    }
    // console.log(blocksForPlacement)
    // for (const [k, v] of placements) {
    //     console.log(k, v)
    // }
    // console.log(dumpGraph(g))
    const solved = solvePlacements(g, placements, blocksForPlacement, placementRegions && {
        onRegion: (name, ms) => placementRegions.set(name, (placementRegions.get(name) ?? 0) + ms),
    })
    for (const [vid, placed] of solved.placements) {
        const first = firstPossibleUse(vid)
        const seen = new Set<number>()
        function populate(bid: number) {
            if (bid === first || seen.has(bid)) return
            seen.add(bid)
            if (!solved.parameters.get(bid)?.has(vid)) {
                addTo(solved.parameters, bid, vid)
                solved.parameterCount++
            }
            for (const pred of savedPreds.get(bid) ?? []) populate(pred)
        }
        const b = seenInBlock.get(vid)
        assert(b)
        for (const bid of b) {
            if (bid === placed) continue
            populate(bid)
        }
    }
    if (solved.parameters.has(0)) {
        console.log(solved)
        console.log(dumpBlockGraph(g))
        console.log(errorDump(g))
        console.log('placements', [...solved.parameters.get(0)!].map(x => solved.placements.get(x)))
        throw `found block 0 capturing a value: ${[...solved.parameters.get(0)!].join(', ')}`
    }
    const order: number[] = []
    {
        const stack = [0]
        const seen = new Set<number>()
        while (const x = stack.shift()) {
            if (solved.parameters.has(x)) order.push(x)
            const s = successors.get(x)
            if (!s) continue
            for (const y of s) {
                if (seen.has(y)) continue
                seen.add(y)
                stack.push(y)
            }
        }
    }

    const valToParam = new Map<number, Map<number, number>>()
    function updateApplies(from: number, to: number, captures: Set<number>) {
        const epoch = nextEpoch(g)
        const mapping = valToParam.get(from)
        const stack = [getBlock(g, from)!.bodyId]
        while (const x = stack.pop()) {
            if (const u = g.nodes.get(x)) {
                if (!markVisited(u, epoch)) continue
                for (let i = 0; i < countIds(u); i++) {
                    const z = getRef(u, i)
                    if (!z) continue
                    if (mapping?.has(z)) {
                        const next = mapping!.get(z)!
                        setRef(u, i, next)
                        stack.push(next)
                        continue
                    }
                    stack.push(z)
                }

                if (u.op === 'apply') {
                    if (getRef(u, 0) !== to) continue
                    const added: number[] = []
                    for (const s of captures) {
                        const t = mapping?.get(s) ?? s
                        stack.push(t)
                        added.push(t)
                    }
                    pushRefs(u, added)
                }
            }
        }
    }
    for (const bid of order) {
        const b = getBlock(g, bid)!
        const vals = solved.parameters.get(bid)!
        const mapping = new Map<number, number>()
        for (const vid of vals) {
            const id = g.maxId++
            mapping.set(vid, id)
            b.params.push(id)
            g.nodes.set(id, paramNode())
        }
        valToParam.set(bid, mapping)
        const p = savedPreds.get(bid)
        assert(p)
        for (const x of p) {
            updateApplies(x, bid, vals)
        }
        const epoch = nextEpoch(g)
        const stack: number[] = [b.bodyId]
        while (const x = stack.pop()) {
            if (const u = g.nodes.get(x)) {
                if (!markVisited(u, epoch)) continue
                for (let i = 0; i < countIds(u); i++) {
                    const id = getRef(u, i)
                    if (!id) continue
                    if (vals.has(id)) {
                        setRef(u, i, mapping.get(id)!)
                        continue
                    }
                    stack.push(id)
                }
            }
        }
    }
    for (const n of g.nodes.values()) {
        if (n.op !== 'nil-effect' || !countIds(n)) continue
        clearOperands(n)
    }
    return g
}

const optimizeTimers = intrinsics.argv().includes('optimize-stats') ? new Map<string, number>() : undefined
const optimizeChanges = new Map<string, [calls: number, changes: number]>()
const optimizeIdle = new Map<string, number>()

export function isJumbo(g: Graph): boolean {
    return g.nodes.size > 1_000
}

const optimizeRounds = Number(intrinsics.argv().find(a => a.startsWith('optimize-rounds:'))?.slice(16) ?? 0)
const disabledPasses = new Set(intrinsics.argv().filter(a => a.startsWith('no-pass:')).map(a => a.slice(8)))
const unswitchScan = intrinsics.argv().includes('unswitch-scan')

function debugsGraph(flag: string, g: Graph): boolean {
    return intrinsics.argv().includes(flag) || (g.name !== undefined && intrinsics.argv().includes(`${flag}:${g.name}`))
}

function recordPass(key: string, elapsed: number, changed: boolean): void {
    if (!optimizeTimers) return
    optimizeTimers.set(key, (optimizeTimers.get(key) ?? 0) + elapsed)
    if (!changed) optimizeIdle.set(key, (optimizeIdle.get(key) ?? 0) + elapsed)
    const counts = optimizeChanges.get(key) ?? [0, 0]
    counts[0]++
    if (changed) counts[1]++
    optimizeChanges.set(key, counts)
}

export function printOptimizeStats(): void {
    if (!optimizeTimers) return
    for (const [name, ms] of [...optimizeTimers].sort((a, b) => b[1] - a[1])) {
        const counts = optimizeChanges.get(name)
        const idle = optimizeIdle.get(name)
        console.log('optimize step', ms.toFixed(1), name, counts ? `${counts[1]}/${counts[0]}` : '', idle !== undefined ? `idle ${idle.toFixed(1)}` : '')
    }
    for (const [name, ms] of [...placementRegions!].sort((a, b) => b[1] - a[1])) console.log('placement region', ms.toFixed(1), name)
    placementRegions!.clear()
    optimizeTimers.clear()
    optimizeChanges.clear()
    optimizeIdle.clear()
}

const ResultUsedFlag = 1
const FoldableOps = new Set(['add', 'sub', 'mul', 'div', 'pow', 'and', 'or', 'xor', 'shl', 'shr', 'ushr', 'lt', 'le', 'gt', 'ge', 'eq', 'ne'])

export const MemFresh = 0, MemPre = 1, MemUnknown = 2, MemInt = 3
export const WritesUnknown = 1 << 30
export const ReturnsFresh = 1 << 29
export const CapturesAll = (1 << 29) - 1
const IntegerOps = new Set(['mul', 'div', 'rem', 'pow', 'shl', 'shr', 'ushr', 'xor', 'neg', 'not', 'lt', 'le', 'gt', 'ge', 'eq', 'ne'])
const MemAbsolute = 0
export interface Mem { base: number, pos: number | undefined, kind: number, pending?: boolean }
export interface MemAnalysis {
    of(id: number): Mem
    access(n: GraphNode): Mem | undefined
    disjoint(a: GraphNode, b: GraphNode): boolean
    covers(outer: GraphNode, inner: GraphNode): boolean
    clobbers(call: number, load: GraphNode, returned?: number): boolean
    flows(root: number, viaReturn: boolean): MemFlow
    users(id: number): Iterable<number>
}
export interface MemFlow { own: boolean, calls: [call: number, arg: number][] }
export interface CallOutcomes {
    literals: Map<number, [effect: number, mask: number]>
    excluding: Map<number, [effect: number, mask: number]>
    other: [effect: number, mask: number] | undefined
}

const CaptureSlot = 3
export const DeepCaptureSlot = 4
const outcomeSlot = 5

export function targetCaptures(g: Graph, call: number, k: number, slot = CaptureSlot): boolean {
    const target = g.nodes.get(getRef(g.nodes.get(call)!, 1))
    if (!target || target.op !== 'local-target' || getRef(target, 0) || countIds(target) <= slot || k >= 29) return true
    return (getLiteral(target, slot) & (1 << k)) !== 0
}

export function encodeCallOutcomes(outcomes: CallOutcomes | undefined): Operand[] {
    if (!outcomes) return []
    const slots: Operand[] = [
        { literal: outcomes.literals.size }, { literal: outcomes.excluding.size },
        { literal: outcomes.other?.[0] ?? -1 }, { literal: outcomes.other?.[1] ?? 0 },
    ]
    for (const table of [outcomes.literals, outcomes.excluding]) {
        for (const [value, [effect, mask]] of table) slots.push({ literal: value }, { literal: effect }, { literal: mask })
    }
    return slots
}

function targetEffects(target: GraphNode | undefined, returned?: number): [effect: number, mask: number] {
    if (!target || target.op !== 'local-target' || getRef(target, 0)) return [2, WritesUnknown]
    const effect = countIds(target) > 1 ? getLiteral(target, 1) : 2
    const mask = countIds(target) > 2 ? getLiteral(target, 2) : WritesUnknown
    if (returned === undefined || countIds(target) < outcomeSlot + 4) return [effect, mask]
    const literals = getLiteral(target, outcomeSlot)
    const excluding = getLiteral(target, outcomeSlot + 1)
    let joined = getLiteral(target, outcomeSlot + 2)
    let joinedMask = joined < 0 ? 0 : getLiteral(target, outcomeSlot + 3)
    for (let i = 0; i < literals + excluding; i++) {
        const at = outcomeSlot + 4 + i * 3
        const value = getLiteral(target, at)
        if ((i < literals) !== (value === returned)) continue
        joined = Math.max(joined, getLiteral(target, at + 1))
        joinedMask |= getLiteral(target, at + 2)
    }
    return joined < 0 ? [0, mask & ReturnsFresh] : [joined, joinedMask | (mask & ReturnsFresh)]
}

function usedPastToken(n: GraphNode, x: number): boolean {
    for (let i = 1; i < countIds(n); i++) if (getRef(n, i) === x) return true
    return false
}

export function memAnalysis(g: Graph, inbound?: (block: GraphBlock) => number[], dependents?: (id: number) => Iterable<number>): MemAnalysis {
    const cache = new Map<number, Mem>()
    const arrivals = new Map<number, [ref: number, literal: number][]>()
    const inFlight = new Set<number>()
    let owners: Map<number, GraphBlock> | undefined
    let applies: Map<number, number[]> | undefined
    let pending = 0
    let solving: Set<number> | undefined
    function ownerOf(param: number): GraphBlock | undefined {
        if (!owners) {
            owners = new Map()
            for (const b of g.blocks) for (const p of b.params) owners.set(p, b)
        }
        return owners.get(param)
    }
    function appliesInto(block: GraphBlock): number[] {
        if (inbound) return inbound(block)
        if (!applies) {
            applies = new Map()
            for (const [id, n] of g.nodes) {
                if (n.op !== 'apply') continue
                const list = applies.get(getRef(n, 0))
                if (list) list.push(id)
                else applies.set(getRef(n, 0), [id])
            }
        }
        return applies.get(block.id) ?? []
    }
    function arrivalsOf(param: number): [ref: number, literal: number][] {
        const known = arrivals.get(param)
        if (known) return known
        const owner = ownerOf(param)!
        const at = owner.params.indexOf(param) + 1
        const list = appliesInto(owner).map((app): [number, number] => {
            const apply = g.nodes.get(app)!
            return [getRef(apply, at), getLiteral(apply, at)]
        })
        arrivals.set(param, list)
        return list
    }
    function inner(param: number): boolean {
        const owner = ownerOf(param)
        return !!owner && owner !== g.blocks[0]
    }
    function of(id: number): Mem {
        const cached = cache.get(id)
        if (cached) return cached
        const before = pending
        const m = compute(id)
        if (!m.pending && pending === before) cache.set(id, m)
        return m
    }
    function compute(id: number): Mem {
        const n = g.nodes.get(id)
        const own = (kind: number): Mem => ({ base: id, pos: 0, kind })
        if (!n) return own(MemUnknown)
        if (n.op === 'after') return of(getRef(n, countIds(n) - 1))
        if (n.op === 'pstack') return own(!getRef(n, 2) && !getLiteral(n, 2) && (getRef(n, 3) || getLiteral(n, 3)) ? MemFresh : MemUnknown)
        if (n.op === 'alloca' || n.op === 'mem') return own(MemFresh)
        if (n.op === 'call') {
            const target = g.nodes.get(getRef(n, 1))
            const fresh = target?.op === 'local-target' && !getRef(target, 0) && countIds(target) > 2 && (getLiteral(target, 2) & ReturnsFresh) !== 0
            return own(fresh ? MemFresh : MemUnknown)
        }
        if (n.op === 'literal') return { base: MemAbsolute, pos: getLiteral(n, 0), kind: MemPre }
        if (n.op === 'pool-entry') return own(MemPre)
        if (IntegerOps.has(n.op)) return own(MemInt)
        if (n.op === 'add' || n.op === 'sub') return shifted(id, n)
        if (n.op === 'select') return settle(id, gather(id, [[getRef(n, 1), getLiteral(n, 1)], [getRef(n, 2), getLiteral(n, 2)]]))
        if (n.op !== 'param') return own(MemUnknown)
        if (!ownerOf(id)) return own(MemUnknown)
        if (!inner(id)) return own(MemPre)
        if (solving?.has(id)) {
            pending++
            return { base: id, pos: 0, kind: MemUnknown, pending: true }
        }
        assert(!inFlight.has(id), 'memAnalysis: param queried outside its component')
        solve(id)
        return cache.get(id) ?? own(MemUnknown)
    }
    function shifted(id: number, n: GraphNode): Mem {
        if (n.op === 'sub' && getRef(n, 0) && getRef(n, 1)) {
            const left = of(getRef(n, 0))
            const right = of(getRef(n, 1))
            if (!left.pending && !right.pending && left.kind !== MemInt && left.base === right.base) return { base: id, pos: 0, kind: MemInt }
        }
        const sides: (Mem | undefined)[] = []
        for (let i = 0; i < 2; i++) {
            const m = getRef(n, i) && (i === 0 || n.op === 'add') ? of(getRef(n, i)) : undefined
            sides.push(m && !m.pending && m.kind === MemInt ? undefined : m)
        }
        if (!sides[0] && !sides[1] && (getRef(n, 0) || getRef(n, 1))) {
            const ints = [0, 1].every(i => !getRef(n, i) || (i === 1 && n.op === 'sub') || of(getRef(n, i)).kind === MemInt)
            if (ints) return { base: id, pos: 0, kind: MemInt }
        }
        const leads = sides.map(m => !!m && (m.pending || m.kind === MemFresh))
        if (leads[0] && leads[1]) return { base: id, pos: 0, kind: MemUnknown }
        let at = leads[0] ? 0 : leads[1] ? 1 : -1
        if (at < 0) {
            const refs = [0, 1].filter(i => sides[i] !== undefined)
            if (refs.length !== 1) {
                const pre = refs.length > 0 && refs.every(i => sides[i]!.kind === MemPre)
                return { base: id, pos: 0, kind: pre ? MemPre : MemUnknown }
            }
            at = refs[0]
        }
        const base = sides[at]!
        const other = at === 0 ? 1 : 0
        const step = getRef(n, other) ? undefined : getLiteral(n, other) * (n.op === 'sub' ? -1 : 1)
        return { base: base.base, pos: base.pos === undefined || step === undefined ? undefined : base.pos + step, kind: base.kind, pending: base.pending }
    }
    interface Gathered { joined: Mem | null, mixed: boolean, pre: boolean, cyclic: boolean, relayed: boolean, ints: number, literals: number, others: number }
    function gathered(): Gathered {
        return { joined: null, mixed: false, pre: true, cyclic: false, relayed: false, ints: 0, literals: 0, others: 0 }
    }
    function gather(self: number, operands: [ref: number, literal: number][]): Gathered {
        const r = gathered()
        for (const [ref, literal] of operands) {
            if (ref === self) continue
            const m = ref ? of(ref) : { base: MemAbsolute, pos: literal, kind: MemPre }
            if (m.pending) {
                r.relayed = true
                if (m.pos !== 0) r.cyclic = true
                continue
            }
            if (m.kind === MemInt) r.ints++
            else if (m.base === MemAbsolute) r.literals++
            else r.others++
            if (m.kind !== MemPre) r.pre = false
            if (r.joined === null) r.joined = m
            else if (r.joined.base !== m.base) r.mixed = true
            else if (r.joined.pos !== m.pos) r.joined = { base: r.joined.base, pos: undefined, kind: r.joined.kind }
        }
        return r
    }
    function integral(r: Gathered): boolean {
        return r.others === 0 && (r.ints > 0 || (r.literals > 0 && r.cyclic))
    }
    function settle(self: number, r: Gathered): Mem {
        if (integral(r)) return { base: self, pos: 0, kind: MemInt }
        if (r.mixed) return { base: self, pos: 0, kind: r.pre ? MemPre : MemUnknown }
        if (r.joined === null) return { base: self, pos: r.cyclic ? undefined : 0, kind: MemUnknown, pending: r.relayed }
        if (!r.cyclic) return r.joined
        return { base: r.joined.base, pos: undefined, kind: r.joined.kind }
    }
    function paramDeps(param: number): number[] {
        const deps: number[] = []
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id) || cache.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'param') {
                if (inner(id)) deps.push(id)
            } else if (n.op === 'after') walk(getRef(n, countIds(n) - 1))
            else if (n.op === 'add' || n.op === 'sub') {
                walk(getRef(n, 0))
                walk(getRef(n, 1))
            } else if (n.op === 'select') {
                walk(getRef(n, 1))
                walk(getRef(n, 2))
            }
        }
        for (const [ref] of arrivalsOf(param)) walk(ref)
        return deps
    }
    function solve(root: number): void {
        const index = new Map<number, number>()
        const low = new Map<number, number>()
        const stack: number[] = []
        const frames: { v: number, deps: number[], at: number }[] = []
        function enter(v: number): void {
            index.set(v, index.size)
            low.set(v, index.get(v)!)
            stack.push(v)
            inFlight.add(v)
            frames.push({ v, deps: paramDeps(v), at: 0 })
        }
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.deps.length) {
                const w = frame.deps[frame.at++]
                if (cache.has(w)) continue
                if (!index.has(w)) {
                    if (!inFlight.has(w)) enter(w)
                } else if (inFlight.has(w)) low.set(frame.v, Math.min(low.get(frame.v)!, index.get(w)!))
                continue
            }
            frames.pop()
            if (frames.length) {
                const parent = frames[frames.length - 1].v
                low.set(parent, Math.min(low.get(parent)!, low.get(frame.v)!))
            }
            if (low.get(frame.v) !== index.get(frame.v)) continue
            const scc: number[] = []
            for (;;) {
                const w = stack.pop()!
                scc.push(w)
                if (w === frame.v) break
            }
            solveComponent(scc)
            for (const w of scc) inFlight.delete(w)
        }
    }
    function solveComponent(scc: number[]): void {
        const outerSolving = solving
        solving = new Set(scc)
        const shared = gathered()
        for (const p of scc) {
            const part = gather(p, arrivalsOf(p))
            if (part.cyclic) shared.cyclic = true
            if (part.mixed) shared.mixed = true
            if (!part.pre) shared.pre = false
            shared.ints += part.ints
            shared.literals += part.literals
            shared.others += part.others
            if (part.joined === null) continue
            if (shared.joined === null) shared.joined = part.joined
            else if (shared.joined.base !== part.joined.base) shared.mixed = true
            else if (shared.joined.pos !== part.joined.pos) shared.joined = { base: shared.joined.base, pos: undefined, kind: shared.joined.kind }
        }
        solving = outerSolving
        if (!shared.mixed && !integral(shared)) {
            const value = shared.joined === null ? undefined
                : shared.cyclic ? { base: shared.joined.base, pos: undefined, kind: shared.joined.kind } : shared.joined
            for (const p of scc) cache.set(p, value ?? { base: p, pos: 0, kind: MemUnknown })
            return
        }
        const kind = integral(shared) ? MemInt : shared.pre ? MemPre : MemUnknown
        for (const p of scc) cache.set(p, { base: p, pos: 0, kind })
    }
    function access(n: GraphNode): Mem | undefined {
        const m = getRef(n, 1) ? of(getRef(n, 1)) : { base: MemAbsolute, pos: getLiteral(n, 1), kind: MemPre }
        if (m.pending) return
        const kind = m.kind === MemInt ? MemUnknown : m.kind
        return { base: m.base, pos: getRef(n, 2) || m.pos === undefined ? undefined : m.pos + getLiteral(n, 2), kind }
    }
    const bytes = (n: GraphNode) => intrinsics.intrinsicBitWidth(typeOf(n)) / 8
    function disjoint(a: GraphNode, b: GraphNode): boolean {
        const x = access(a)
        const y = access(b)
        if (!x || !y) return false
        if (x.base === y.base) {
            if (x.pos === undefined || y.pos === undefined) return false
            return x.pos + bytes(a) <= y.pos || y.pos + bytes(b) <= x.pos
        }
        return (x.kind === MemFresh && y.kind !== MemUnknown) || (y.kind === MemFresh && x.kind !== MemUnknown)
    }
    function covers(outer: GraphNode, inner: GraphNode): boolean {
        const x = access(outer)
        const y = access(inner)
        if (!x || !y || x.base !== y.base || x.pos === undefined || y.pos === undefined) return false
        return x.pos <= y.pos && y.pos + bytes(inner) <= x.pos + bytes(outer)
    }
    let users: Map<number, number[]> | undefined
    function usersOf(id: number): Iterable<number> {
        if (dependents) return dependents(id)
        if (!users) {
            users = new Map()
            for (const [u, n] of g.nodes) {
                for (let i = 0; i < countIds(n); i++) {
                    const r = getRef(n, i)
                    if (!r) continue
                    const list = users.get(r)
                    if (list) list.push(u)
                    else users.set(r, [u])
                }
            }
        }
        return users.get(id) ?? []
    }
    const flowCache = new Map<number, MemFlow>()
    function flows(root: number, viaReturn: boolean): MemFlow {
        const key = viaReturn ? -root : root
        const known = flowCache.get(key)
        if (known) return known
        const flow: MemFlow = { own: false, calls: [] }
        const seen = new Set<number>([root])
        const work = [root]
        const visit = (id: number) => {
            if (seen.has(id)) return
            seen.add(id)
            work.push(id)
        }
        while (work.length && !flow.own) {
            const x = work.pop()!
            for (const u of usersOf(x)) {
                const n = g.nodes.get(u)
                if (!n || n.op === 'load') continue
                if (n.op === 'store' || n.op === 'ret') {
                    if ((n.op === 'store' ? getRef(n, 3) : viaReturn ? getRef(n, 0) : 0) === x) flow.own = true
                } else if (n.op === 'call') {
                    for (let i = 1; i < countIds(n); i++) {
                        if (getRef(n, i) !== x) continue
                        if (i < 3) flow.own = true
                        else flow.calls.push([u, i - 3])
                    }
                } else if (n.op === 'apply') {
                    const block = getBlock(g, getRef(n, 0))
                    for (let i = 1; i < countIds(n); i++) {
                        if (getRef(n, i) !== x) continue
                        if (block) visit(block.params[i - 1])
                        else flow.own = true
                    }
                } else if (n.op === 'after') {
                    if (getRef(n, countIds(n) - 1) === x) visit(u)
                } else if (n.op === 'select') {
                    if (getRef(n, 1) === x || getRef(n, 2) === x) visit(u)
                } else if (OrderedValues.has(n.op) && !usedPastToken(n, x)) {
                    continue
                } else if (!CompareOps.has(n.op)) {
                    if (PureOps.has(n.op)) visit(u)
                    else flow.own = true
                }
                if (flow.own) break
            }
        }
        flowCache.set(key, flow)
        return flow
    }
    function escaped(root: number): boolean {
        const flow = flows(root, false)
        return flow.own || flow.calls.some(([call, k]) => targetCaptures(g, call, k))
    }
    function clobbers(call: number, load: GraphNode, returned?: number): boolean {
        const n = g.nodes.get(call)!
        const target = g.nodes.get(getRef(n, 1))
        if (!target || target.op !== 'local-target' || getRef(target, 0)) return true
        const [effect, mask] = targetEffects(target, returned)
        if (effect <= 1) return false
        const x = access(load)
        if (!x) return true
        if (mask & WritesUnknown) {
            if (x.kind !== MemFresh || escaped(x.base)) return true
            return flows(x.base, false).calls.some(([c]) => c === call)
        }
        for (let k = 0; k < 29; k++) {
            if (!(mask & (1 << k))) continue
            const arg = getRef(n, 3 + k)
            const y = arg ? of(arg) : { base: MemAbsolute, pos: getLiteral(n, 3 + k), kind: MemPre }
            if (y.pending || y.base === x.base) return true
            if (!((x.kind === MemFresh && y.kind !== MemUnknown) || (y.kind === MemFresh && x.kind !== MemUnknown))) return true
        }
        return false
    }
    return { of, access, disjoint, covers, clobbers, flows, users: usersOf }
}

function optimizeValueGraph(g: Graph, costs: lowering.TargetCosts) {
    const optimizeStart = performance.now()
    const dependents = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) g.nodes.get(to)!.scratchFlags |= ResultUsedFlag
        let d = dependents.get(to)
        if (!d) dependents.set(to, d = new Set())
        d.add(from)
    }

    function isResultUsed(id: number): boolean {
        return (g.nodes.get(id)!.scratchFlags & ResultUsedFlag) !== 0
    }

    function usesForResult(user: number, id: number): boolean {
        const u = g.nodes.get(user)!
        for (let i = firstNonOrderingSlot(u); i < countIds(u); i++) if (getRef(u, i) === id) return true
        return false
    }

    function usedForResult(id: number): boolean {
        for (const u of dependents.get(id) ?? []) if (usesForResult(u, id)) return true
        return false
    }

    function getGraphBlock(id: number) {
        const b = getBlock(g, id)
        assert(b)
        return b
    }

    const byOp = new Map<number, Map<string, number[]>>()
    function indexValue(id: number, op: string, blockId: number) {
        let m = byOp.get(blockId)
        if (!m) byOp.set(blockId, m = new Map())
        let arr = m.get(op)
        if (!arr) m.set(op, arr = [])
        arr.push(id)
    }

    function findValues(blockId: number, op: string) {
        if (const m = byOp.get(blockId)) {
            return m.get(op)
        }
    }

    function findValuesFrom(blockId: number, op: string, target: number) {
        if (const arr = findValues(blockId, op)) {
            return arr.filter(x => reaches(target, x))
        }
    }

    interface ArityClosure {
        id: number
        support: number[]
        values: number[]
        inputs: number[]
    }
    interface BlockClosureInfo {
        block: GraphBlock
        termOf: Map<number, number>
        term: (id: number) => number
        closures: ArityClosure[]
        closureOf: Map<number, number>
        byParam: Map<number, number[]>
        bySupport: Map<string, number[]>
    }
    const blockClosureInfo = new Map<number, BlockClosureInfo>()

    function operandEdge(n: GraphNode, i: number): number {
        if (i === 0 && n.op === 'apply') return 0
        const ref = getRef(n, i)
        return isNilOrVoid(ref) ? 0 : ref
    }

    function reaches(from: number, to: number) {
        const n = g.nodes.get(from)
        if (!n) return false
        for (let i = 0; i < countIds(n); i++) {
            const u = operandEdge(n, i)
            if (!u) continue
            if (u === to) return true
            if (reaches(u, to)) return true
        }
        return false
    }

    function reachesAnyOf(from: number, to: Set<number>) {
        const n = g.nodes.get(from)
        if (!n) return false
        for (let i = 0; i < countIds(n); i++) {
            const u = operandEdge(n, i)
            if (!u) continue
            if (to.has(u)) return true
            if (reachesAnyOf(u, to)) return true
        }
        return false
    }

    function collectSubgraph(from: number, dst: Set<number> = new Set()) {
        dst.add(from)
        const n = g.nodes.get(from)
        if (!n) return dst
        for (let i = 0; i < countIds(n); i++) {
            const u = operandEdge(n, i)
            if (!u || dst.has(u)) continue
            collectSubgraph(u, dst)
        }
        return dst
    }

    function collectSubgraphOf(iter: Iterable<number>) {
        const dst = new Set<number>()
        for (const x of iter) collectSubgraph(x, dst)
        return dst
    }

    function visitBlock(b: GraphBlock) {
        if (visited.has(b.id)) return
        reachableBlocks.add(b)
        visited.set(b.id, visited.size)
        blockStack.push(b)
        defer blockStack.pop()
        visit(b.bodyId, false)
    }

    const successors = new Map<number, Set<number>>()
    const preds = new Map<number, Set<number>>()
    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reachableBlocks = new Set<GraphBlock>()
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        const n = g.nodes.get(id)!
        if (n.op === 'nil-effect' || n.op === 'void') return
        const seen = visited.has(id)
        if (!seen) n.scratchFlags &= ~ResultUsedFlag
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (seen) return
        visited.set(id, visited.size)

        const currentBlockId = blockStack[blockStack.length-1].id
        if (n.op === 'param') {
            indexValue(id, 'param', currentBlockId)
            return
        }

        indexValue(id, n.op, currentBlockId)
        if (!countIds(n)) return

        stack.push(id)
        defer stack.pop()

        if (n.op === 'after') {
            const last = countIds(n) - 1
            for (let i = 0; i < last; i++) visit(getRef(n, i), false)
            visit(getRef(n, last), true)
            return
        }
        if (n.op === 'apply') {
            let s = successors.get(currentBlockId)
            if (!s) successors.set(currentBlockId, s = new Set())
            s.add(getRef(n, 0))
            s = preds.get(getRef(n, 0))
            if (!s) preds.set(getRef(n, 0), s = new Set())
            s.add(currentBlockId)
            const b = getGraphBlock(getRef(n, 0))
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            const outer = stack.splice(0)
            visitBlock(b)
            stack.push(...outer)
            return
        }
        if (OrderedValues.has(n.op)) {
            visit(getRef(n, 0), false)
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            return
        }
        for (const x of gn.enumerateRefs(n)) {
            visit(x, true)
        }
    }

    function indexGraph() {
        dependents.clear()
        byOp.clear()
        successors.clear()
        preds.clear()
        visited.clear()
        blockStack.length = 0
        reachableBlocks.clear()
        visited.set(0, 0)
        blockStack.push(g.blocks[0])
        reachableBlocks.add(g.blocks[0])
        const bodyId = g.blocks[0].bodyId
        if (bodyId) visit(bodyId, false)
    }
    indexGraph()

    function insert(n: GraphNode): number {
        const id = g.maxId++
        g.nodes.set(id, n)
        return id
    }

    function addNode(op: string, operands: Operand[], from?: GraphNode): number {
        return insert(from ? copyNode(from, operands, op) : makeNode(op, operands))
    }

    function paramLike(value: number): number {
        const n = value ? g.nodes.get(value) : undefined
        if (!n) return addParam()
        const ref = typeRefOf(n)
        return addParam(ref ? { ref } : resultType(g, n))
    }

    function addParam(T?: TypeOperand): number {
        const id = g.maxId++
        g.nodes.set(id, T === undefined ? paramNode() : makeNode('param', [], T))
        return id
    }

    function addBlock(params: number[], body: number): number {
        const id = addNode('block', [])
        addGraphBlock(g, { id, bodyConst: 0, bodyId: body, params })
        return id
    }

    function removeBlock(b: GraphBlock) {
        cleanBlockData(b)
        reachableBlocks.delete(b)
    }

    function cleanBlockData(b: GraphBlock) {
        blockClosureInfo.delete(b.id)

        if (const s = successors.get(b.id)) {
            successors.delete(b.id)
            for (const x of s) {
                if (const p = preds.get(x)) {
                    p.delete(b.id)
                }
            }
        }

        if (const m = byOp.get(b.id)) {
            byOp.delete(b.id)
            for (const arr of m.values()) {
                for (const id of arr) cleanEdges(id)
            }
            function cleanEdges(id: number) {
                dependents.delete(id)
                visited.delete(id)
            }
        }
    }

    const versions = new Map<number, number>()
    const inboundVersions = new Map<number, number>()
    const passVersions = new Map<(b: GraphBlock) => unknown, Map<number, number>>()
    const inboundPassVersions = new Map<(b: GraphBlock) => unknown, Map<number, number>>()
    let graphEpoch = 0
    function touch(b: GraphBlock) {
        graphEpoch++
        versions.set(b.id, (versions.get(b.id) ?? 0) + 1)
        inboundVersions.set(b.id, (inboundVersions.get(b.id) ?? 0) + 1)
        if (const p = successors.get(b.id)) {
            for (const x of p) {
                inboundVersions.set(x, (inboundVersions.get(x) ?? 0) + 1)
            }
        }
    }
    function runWithInboundChecks(pass: (b: GraphBlock) => unknown, b: GraphBlock) {
        if (!usesFindInboundApplies.has(pass)) return false
        const bid = b.id
        let seen = inboundPassVersions.get(pass)
        if (!seen) inboundPassVersions.set(pass, seen = new Map())
        if (seen.get(bid) === (inboundVersions.get(bid) ?? 0)) return false
        const changed = !!pass(b)
        seen.set(bid, inboundVersions.get(bid) ?? 0)
        return changed
    }

    function time(name: string, dur: number) {
        optimizeTimers!.set(name, (optimizeTimers!.get(name) ?? 0) + dur)
    }
    const passDebug = debugsGraph('pass-debug', g)
    function step(pass: (b: GraphBlock) => unknown, b: GraphBlock): boolean {
        if (disabledPasses.has(pass.name)) return false
        if (!optimizeTimers && !passDebug) return runStep(pass, b)
        const s = performance.now()
        const changed = runStep(pass, b)
        recordPass(pass.name, performance.now() - s, changed)
        if (passDebug && changed) console.log(`--- ${pass.name} changed B${b.id} ---\n${dumpGraph(g)}`)
        return changed
    }
    function runStep(pass: (b: GraphBlock) => unknown, b: GraphBlock): boolean {
        let seen = passVersions.get(pass)
        if (!seen) passVersions.set(pass, seen = new Map())
        if (seen.get(b.id) === (versions.get(b.id) ?? 0)) {
            return runWithInboundChecks(pass, b)
        }
        const version = versions.get(b.id) ?? 0
        const changed = !!pass(b)
        seen.set(b.id, version)
        return changed
    }

    let didAnyChange = false
    function revisitBlock(b: GraphBlock, incremental = false) {
        touch(b)
        didAnyChange = true
        if (!incremental) {
            cleanBlockData(b)
            visited.delete(b.id)
            visitBlock(b)
            return
        }
        blockClosureInfo.delete(b.id)
        if (const s = successors.get(b.id)) {
            successors.delete(b.id)
            for (const x of s) preds.get(x)?.delete(b.id)
        }
        visited.delete(b.id)
        visitBlock(b)
        const ops = byOp.get(b.id)
        if (!ops) return
        const members = new Set<number>()
        for (const ids of ops.values()) for (const id of ids) members.add(id)
        const dropped = new Set<number>()
        function drop(id: number): void {
            if (dropped.has(id) || id === b.bodyId || !members.has(id) || dependents.get(id)?.size) return
            if (g.nodes.get(id)?.op === 'param') return
            dropped.add(id)
            dependents.delete(id)
            visited.delete(id)
            const n = g.nodes.get(id)
            for (let i = 0; n && i < countIds(n); i++) {
                const d = operandEdge(n, i)
                if (!d) continue
                const users = dependents.get(d)
                if (users) {
                    users.delete(id)
                    if (!users.size) dependents.delete(d)
                }
                const node = g.nodes.get(d)
                if (node && node.scratchFlags & ResultUsedFlag && !usedForResult(d)) node.scratchFlags &= ~ResultUsedFlag
                drop(d)
            }
        }
        for (const id of members) drop(id)
        if (dropped.size) {
            for (const [op, ids] of [...ops]) {
                const kept = ids.filter(id => !dropped.has(id))
                if (kept.length) ops.set(op, kept)
                else ops.delete(op)
            }
        }
        for (const id of ops.get('apply') ?? []) {
            const to = getRef(g.nodes.get(id)!, 0)
            let s = successors.get(b.id)
            if (!s) successors.set(b.id, s = new Set())
            s.add(to)
            let p = preds.get(to)
            if (!p) preds.set(to, p = new Set())
            p.add(b.id)
        }
    }

    function replaceAll(id: number, replacements: Map<number, number>, epoch = nextEpoch(g)): number {
        if (!id) return id
        if (const replacement = replacements.get(id)) {
            return replacement
        }
        const n = g.nodes.get(id)!
        if (n.op === 'param') return id
        if (!markVisited(n, epoch)) return id
        const refSlots = countIds(n)
        const idReplacements: [idx: number, id: number][] = []
        for (let i = 0; i < refSlots; i++) {
            const r = gn.getRef(n, i)
            const next = replaceAll(r, replacements, epoch)
            if (next !== r) { 
                idReplacements.push([i, next])
            }
        }
        if (!idReplacements.length) return id
        const slots = n.slots.slice()
        for (let i = 0; i < slots.length; i++) {
            if (idReplacements[0]![0] === i) {
                slots[i] = gn.encodeSlot(idReplacements.shift()![1], 0) as u32
                if (!idReplacements.length) break
            }
        }
        const copy = insert(gn.makeNodeFromSlots(n.op, slots))
        replacements.set(id, copy)
        return copy
    }

    function replaceTransitive(id: number, replacements: Map<number, number>, memo = new Map<number, number>(), epoch = nextEpoch(g)): number {
        if (!id) return id
        const known = memo.get(id)
        if (known !== undefined) return known
        const replacement = replacements.get(id)
        if (replacement !== undefined && replacement !== id) {
            memo.set(id, id)
            const result = replaceTransitive(replacement, replacements, memo, epoch)
            memo.set(id, result)
            return result
        }
        const n = g.nodes.get(id)!
        if (n.op === 'param' || !markVisited(n, epoch)) return id
        let slots: u32[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            const r = gn.getRef(n, i)
            const next = replaceTransitive(r, replacements, memo, epoch)
            if (next === r) continue
            slots ??= n.slots.slice()
            slots[i] = gn.encodeSlot(next, 0) as u32
        }
        if (!slots) return id
        const copy = insert(gn.makeNodeFromSlots(n.op, slots))
        memo.set(id, copy)
        return copy
    }

    function findInboundApplies(target: GraphBlock) {
        if (target.id === 0) return []
        const res: [blockId: number, valId: number][] = []
        function visit(b: GraphBlock) {
            const applies = findValues(b.id, 'apply')!
            for (const u of applies) {
                const n = g.nodes.get(u)!
                const t = getRef(n, 0)
                if (t !== target.id) continue
                res.push([b.id, u])
            }
        }
        const x = preds.get(target.id)
        if (!x) return res
        for (const k of x) {
            visit(getGraphBlock(k))
        }
        return res
    }

    function skipAfter(id: number) {
        while (id) {
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'after') {
                id = getRef(n, countIds(n)-1)
                continue
            }
            return id
        }
        return
    }

    function simplifySelect(target: GraphBlock) {
        const loops = (id: number) => {
            const n = g.nodes.get(skipAfter(id) ?? 0)
            return n?.op === 'apply' && getRef(n, 0) === target.id
        }
        const diverges = (id: number) => isUnreachable(skipAfter(id) ?? 0)
        const r = new Map<number, number>()
        for (const id of findValues(target.id, 'select') ?? []) {
            const n = g.nodes.get(id)!
            if (countIds(n) === 3 && !getRef(n, 0)) {
                const arm = getLiteral(n, 0) ? 1 : 2
                r.set(id, getRef(n, arm) || addNode('literal', [{ literal: getLiteral(n, arm) }]))
                continue
            }
            if (diverges(getRef(n, 2))) {
                const x = createNode(g, 'after', [getRef(n, 0), operand(n, 1)])
                r.set(id, x)
                continue
            }
            if (diverges(getRef(n, 1))) {
                const x = createNode(g, 'after', [getRef(n, 0), operand(n, 2)])
                r.set(id, x)
                continue
            }
            if (countIds(n) !== 3 || loops(getRef(n, 1)) || !loops(getRef(n, 2))) continue
            const cond = g.nodes.get(getRef(n, 0))
            if (!cond || !CompareOps.has(cond.op)) continue
            if (comparesFloats(g, cond)) continue
            const inverted = addNode(InverseCompare[cond.op], getOperands(cond), cond)
            r.set(id, addNode('select', [inverted, getOperand(n, 2), getOperand(n, 1)], n))
        }
        if (!r.size) return false
        target.bodyId = replaceAll(target.bodyId, r)
        revisitBlock(target)
        simplifySelect(target)
        return true
    }

    function deduplicateValues(target: GraphBlock) {
        const representatives = new Map<string, number>()
        const canonical = new Map<number, number>()
        let changed = false
        function visit(id: number): number {
            if (!id) return 0
            const n = g.nodes.get(id)!
            if (n.op === 'block' || n.op === 'param') {
                return id
            }
            const known = canonical.get(id)
            if (known !== undefined) return known
            const argIds = getArgIds(n).map(a => visit(a))
            if (n.op === 'select' && argIds[1] && argIds[1] === argIds[2]) {
                canonical.set(id, argIds[1])
                changed = true
                return argIds[1]
            }
            const key = nodeKey(n, argIds)
            let rep = representatives.get(key)
            if (rep === undefined) {
                rep = argIds.every((a, i) => a === getRef(n, i)) ? id : addNode(n.op, withRefs(n, argIds), n)
                representatives.set(key, rep)
            }
            if (rep !== id) changed = true
            canonical.set(id, rep)
            return rep
        }
        const bodyId = visit(target.bodyId)
        if (!changed) return false
        target.bodyId = bodyId
        revisitBlock(target, true)
        return true
    }

    function interchangeSelects(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return false
        if ((findValues(target.id, 'select')?.length ?? 0) < 2) return false
        const loops = (id: number) => {
            const n = g.nodes.get(skipAfter(id) ?? 0)
            return n?.op === 'apply' && getRef(n, 0) === target.id
        }
        function collect(id: number, into: Set<number>): Set<number> {
            const n = id ? g.nodes.get(id) : undefined
            if (!n || into.has(id) || n.op === 'param' || isArgless(n)) return into
            into.add(id)
            for (const x of getArgIds(n)) collect(x, into)
            return into
        }
        const outer = g.nodes.get(target.bodyId)
        if (!outer || outer.op !== 'select' || countIds(outer) !== 3) return false
        for (const a of [1, 2]) {
            const inner = g.nodes.get(getRef(outer, a))
            if (!inner || inner.op !== 'select' || countIds(inner) !== 3) continue
            const b = loops(getRef(inner, 1)) ? 1 : loops(getRef(inner, 2)) ? 2 : 0
            if (!b || loops(getRef(inner, 3 - b)) || loops(getRef(outer, 3 - a))) continue
            const c1 = g.nodes.get(getRef(outer, 0))
            const c2 = g.nodes.get(getRef(inner, 0))
            if (!c1 || !c2 || !CompareOps.has(c1.op) || !CompareOps.has(c2.op)) continue
            if (comparesFloats(g, c1) || comparesFloats(g, c2)) continue
            const guarded = collect(getRef(outer, 0), new Set())
            let extra = 0
            let speculatable = true
            for (const id of collect(getRef(inner, 0), new Set())) {
                if (guarded.has(id)) continue
                const n = g.nodes.get(id)!
                extra++
                if (!PureOps.has(n.op) && !(n.op === 'load' && g.nodes.get(getRef(n, 0))?.op === 'nil-effect')) {
                    speculatable = false
                    break
                }
            }
            if (!speculatable || extra > 3) continue
            const guard = a === 1 ? getRef(outer, 0) : addNode(InverseCompare[c1.op], getOperands(c1), c1)
            const test = b === 1 ? getRef(inner, 0) : addNode(InverseCompare[c2.op], getOperands(c2), c2)
            const both = addNode('and', [guard, test], c2)
            const rest = addNode('select', [guard, getRef(inner, 3 - b), getRef(outer, 3 - a)], inner)
            target.bodyId = addNode('select', [both, getRef(inner, b), rest], outer)
            revisitBlock(target)
            return true
        }
        return false
    }

    const debug = intrinsics.argv().includes('debug') // TODO: intrinsics.assert could have this (but it needs to be derived/configurable)
    const keyBits = 25
    const maxValId = 2**keyBits
    function keyOfPair(a: number, b: number, skipsort?: boolean) {
        if (debug) {
            assert(a >= 0 && a < maxValId)
            assert(b >= 0 && b < maxValId)
        }
        if (!skipsort && a > b) {
            let tmp = a
            a = b
            b = tmp
        }
        return a * maxValId + b
    }

    const precedesCache = new Map<number, boolean>()
    function precedes(a: number, b: number, checkedFirst?: boolean): boolean {
        if (a >= b) return false
        const nb = g.nodes.get(b)!
        const lb = countIds(nb)
        if (!lb) return false

        if (!checkedFirst) {
            const na = g.nodes.get(a)!
            if (!countIds(na)) return true
        }

        const k = keyOfPair(a, b, true)
        if (const v = precedesCache.get(k)) return v

        let result = false
        for (let i = 0; i < lb; i++) {
            const q = getRef(nb, i)
            if (q === a || precedes(a, q, true)) {
                result = true
                break
            }
        }

        precedesCache.set(k, result)
        return result
    }

    function isRead(n: GraphNode | undefined) {
        return n?.op === 'load' || (n?.op === 'call' && callEffect(n) <= 1)
    }

    function isUnreachable(vid: number) {
        return vid === _unreachable || g.nodes.get(vid)?.op === 'unreachable'
    }

    let _unreachable: number | undefined
    function unreachable(original?: GraphNode) {
        // TODO: use `original` but reserve id space for primitives. or some other strategy...
        //if (original) return createNode(g, 'unreachable', [], original)
        initPrimitives()
        return _unreachable!
    }

    let _nil: number | undefined
    function nil(original?: GraphNode) {
        //if (original) return createNode(g, 'nil-effect', [], original)
        initPrimitives()
        return _nil!
    }

    let _void: number | undefined
    function Void(original?: GraphNode) {
        //if (original) return createNode(g, 'void', [], original)
        initPrimitives()
        return _void!
    }

    function initPrimitives() {
        if (_nil !== undefined) return
        for (const [k, v] of g.nodes) {
            switch (v.op) {
                case 'void':
                    _void = k
                case 'nil-effect':
                    _nil = k
                case 'unreachable':
                    _unreachable = k
            }
        }
        _nil ??= createNode(g, 'nil-effect', [])
        _void ??= createNode(g, 'void', [])
        _unreachable ??= createNode(g, 'unreachable', [])
    }

    function effectsJoin(values: number[], into?: number) {
        if (const u = values.find(x => isUnreachable(x))) {
            return u
        }
        const sink = into && !isNilOrVoid(into) ? into : undefined
        const pruned: number[] = []
        function add(x: number): void {
            if (isNilOrVoid(x)) return
            const n = g.nodes.get(x)!
            const last = countIds(n) - 1
            if (n.op !== 'after' || !isNilOrVoid(getRef(n, last))) {
                pruned.push(x)
                return
            }
            for (let i = 0; i < last; i++) add(getRef(n, i))
        }
        for (const x of values) add(x)
        const parts = [...new Set(pruned)]
        if (!parts.length) return into ?? nil()
        if (parts.length === 1) {
            const v = parts[0]
            if (!sink) return v
            return v === sink ? sink : createNode(g, 'after', [v, sink])
        }
        if (!sink) {
            parts.push(Void())
            return createNode(g, 'after', parts)
        }
        const rem = parts.filter(x => x !== sink)
        if (!rem.length) return sink
        rem.push(sink)
        return createNode(g, 'after', rem)
    }

    function callEffect(n: GraphNode, returned?: number): number {
        return targetEffects(g.nodes.get(getRef(n, 1)), returned)[0]
    }

    function simplifyOrdering(
        vid: number,
        from?: GraphNode,
    ): number | undefined {
        if (!vid) return
        const u = g.nodes.get(vid)
        if (!u) return
        if (u.op === 'param') return
        if (u.op === 'nil-effect') return vid
        if (u.op === 'unreachable') return vid
        if (u.op === 'ret' || u.op === 'panic') {
            return unreachable(u)
        }
        if (u.op === 'apply') {
            // `apply` is assumed to already be in tail position by this point
            return unreachable(u)
        }
        if (u.op === 'select') {
            let changed = false
            const arr: number[] = []
            for (let i = 1; i < countIds(u); i++) {
                const q = simplifyOrdering(getRef(u, i), from)
                if (q !== getRef(u, i)) changed = true
                arr.push(q ?? nil())
            }
            if (!changed) return vid
            if (arr.every(x => x === arr[0])) {
                return g.nodes.get(arr[0])?.op === 'nil-effect' ? undefined : arr[0]
            }
            return createNode(g, 'select', [getRef(u, 0), ...arr], u)
        }
        if (u.op === 'after') {
            const end = countIds(u)-1
            const r = simplifyOrdering(getRef(u, end), from)
            // if (r && (!isUnordered(r) || isParam(g.nodes, r))) {
            //     return vid
            // }
            assert(countIds(u) > 1)
            let changed = r !== getRef(u, end) && !(r === undefined && isNilOrVoid(getRef(u, end)))
            const arr: number[] = []
            for (let i = 0; i < end; i++) {
                const q = simplifyOrdering(getRef(u, i), from)
                if (q !== getRef(u, i)) changed = true
                if (!q) continue
                if (isUnreachable(q)) return q
                arr.push(q)
            }
            if (r) arr.push(r)
            if (changed) return effectsJoin(arr)
            const fresh = g.maxId
            const joined = effectsJoin(arr)
            if (joined < fresh || countIds(g.nodes.get(joined)!) - 1 < arr.length || !isNilOrVoid(getRef(u, end))) return joined
            g.nodes.delete(joined)
            return vid
        }
        if (OrderedValues.has(u.op)) {
            const clobbers = u.op === 'store' || (u.op === 'call' && callEffect(u) > 1)
            const pure = u.op === 'load' || (u.op === 'call' && !clobbers)
            if (pure && (from?.op === 'apply' || from?.op === 'ret')) {
                return simplifyOrdering(getRef(u, 0), from)
            }
            if (!clobbers && isRead(from)) {
                return simplifyOrdering(getRef(u, 0), from)
            }
            return vid
        }
        if (isUnordered(vid)) return
        if (!OrderedValues.has(u.op) && u.op !== 'param') {
            const arr: number[] = []
            let changed = false
            for (let i = 0; i < countIds(u); i++) {
                const q = simplifyOrdering(getRef(u, i), from)
                if (q !== getRef(u, i)) changed = true
                if (!q) continue
                if (isUnreachable(q)) return q
                arr.push(q)
            }
            if (changed) return effectsJoin(arr)
        }
        return vid
    }

    function rematerializable(id: number): boolean {
        const n = id ? g.nodes.get(id) : undefined
        return !!n && n.op !== 'nil-effect' && isArgless(n)
    }

    function isNilOrVoid(vid?: number) {
        if (!vid) return true
        if (vid === _void || vid === _nil) return true
        const op = g.nodes.get(vid)?.op
        return op === 'nil-effect' || op === 'void'
    }

    function slotParts(id: number): Set<number> {
        const parts = new Set<number>()
        const n = g.nodes.get(id)
        if (!n) return parts
        function add(x: number): void {
            if (isNilOrVoid(x) || parts.has(x)) return
            const m = g.nodes.get(x)!
            const last = countIds(m) - 1
            if (m.op === 'after' && isNilOrVoid(getRef(m, last))) {
                for (let i = 0; i < last; i++) add(getRef(m, i))
                return
            }
            parts.add(x)
        }
        if (n.op === 'after') {
            for (let i = 0; i < countIds(n) - 1; i++) add(getRef(n, i))
            return parts
        }
        if (!OrderedValues.has(n.op)) return parts
        add(getRef(n, 0))
        return parts
    }

    function writes(n: GraphNode | undefined): boolean {
        return !!n && (n.op === 'store' || n.op === 'pstack' || (n.op === 'call' && callEffect(n) > 1))
    }
    function orderedUse(id: number, seen = new Set<number>()): boolean {
        if (seen.has(id)) return false
        seen.add(id)
        for (const u of dependents.get(id) ?? []) {
            const n = g.nodes.get(u)
            if (!n) continue
            if (OrderedValues.has(n.op) && getRef(n, 0) === id) return true
            if (n.op !== 'after') continue
            const last = countIds(n) - 1
            for (let i = 0; i < last; i++) if (getRef(n, i) === id) return true
            if (getRef(n, last) === id && orderedUse(u, seen)) return true
        }
        return false
    }

    function reduceBlockOrdering(target: GraphBlock): boolean {
        let changed = false
        const epoch = nextEpoch(g)
        const replacements = new Map<number, number>()
        const relaxedTo = new Map<number, number>()
        function visit(id: number): void {
            if (!id) return
            let n = g.nodes.get(id)
            if (!n || !markVisited(n, epoch)) return
            for (let i = 0; i < countIds(n); i++) visit(getRef(n, i))

            let resolved: number[] | undefined
            for (let i = 0; i < countIds(n); i++) {
                let r = replacements.get(getRef(n, i))
                const ordering = i < firstNonOrderingSlot(n)
                if (!ordering) r = relaxedTo.get(r ?? getRef(n, i)) ?? r
                if (r === undefined) continue
                if (!resolved) resolved = cloneRefs(n)
                resolved[i] = r
            }
            if (resolved) {
                n = copyNode(n, withRefs(n, resolved))
                markVisited(n, epoch)
                g.nodes.set(id, n)
                changed = true
            }

            if (n.op !== 'after' && !OrderedValues.has(n.op)) return
            const end = n.op === 'after' ? countIds(n) - 1 : 1
            const tail = n.op === 'after' ? g.nodes.get(replacements.get(getRef(n, end)) ?? getRef(n, end)) : undefined
            const from = tail?.op === 'apply' || tail?.op === 'ret' ? tail : n
            let argIds: number[] | undefined
            for (let i = 0; i < end; i++) {
                const q = replacements.get(getRef(n, i)) ?? getRef(n, i)
                if (g.nodes.get(q)?.op === 'void') {
                    if (!argIds) argIds = cloneRefs(n)
                    argIds[i] = nil()
                    continue
                }
                const ordering = n.op === 'call' && callEffect(n) === 0 ? undefined : simplifyOrdering(q, from)
                if (ordering === q || (isNilOrVoid(ordering) && isNilOrVoid(q))) {
                    continue
                }
                if (!argIds) argIds = cloneRefs(n)
                argIds[i] = ordering ?? nil()
            }
            const orderings = (argIds ?? getArgIds(n)).slice(0, end)
            const isPointlessAfter = n.op === 'after' && orderings.every(isNilOrVoid)
            if (isPointlessAfter) {
                if (getRef(n, end)) {
                    replacements.set(id, replacements.get(getRef(n, end)) ?? getRef(n, end))
                } else {
                    const nextId = g.maxId++
                    g.nodes.set(nextId, literal(getLiteral(n, end)))
                    replacements.set(id, nextId)
                }
                return
            }
            if (n.op === 'after' && !isNilOrVoid(getRef(n, end))) {
                const fresh = g.maxId
                const sink = replacements.get(getRef(n, end)) ?? getRef(n, end)
                const covered = slotParts(sink)
                const unordered = !orderedUse(id) && !writes(g.nodes.get(sink))
                const kept = orderings.filter(p => !covered.has(p) && !(unordered && isRead(g.nodes.get(p))))
                const joined = effectsJoin(kept, sink)
                if (joined < fresh) {
                    replacements.set(id, joined)
                    return
                }
                const j = g.nodes.get(joined)!
                g.nodes.delete(joined)
                if (countIds(j) === countIds(n) && getArgIds(j).every((x, i) => x === getRef(n, i))) return
                g.nodes.set(id, j)
                changed = true
                return
            }
            if (!argIds) return
            for (let i = end; i < argIds.length; i++) {
                const q = argIds[i]
                if (q) argIds[i] = replacements.get(q) ?? q
            }
            changed = true
            if (isRead(n) && argIds[0] !== getRef(n, 0) && !isNilOrVoid(getRef(n, 0))) {
                const copy = copyNode(n, withRefs(n, argIds))
                markVisited(copy, epoch)
                const relaxed = insert(copy)
                const joined = makeNode('after', [getRef(n, 0), relaxed, Void()])
                markVisited(joined, epoch)
                g.nodes.set(id, joined)
                relaxedTo.set(id, relaxed)
                precedesCache.clear()
                return
            }
            g.nodes.set(id, copyNode(n, withRefs(n, argIds)))
        }
        visit(target.bodyId)
        if (!changed && !replacements.size) return false
        target.bodyId = replaceTransitive(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function liftAfters(target: GraphBlock): boolean {
        const members = new Set<number>()
        const users = new Set<number>()
        for (const a of findValues(target.id, 'after') ?? []) {
            const n = g.nodes.get(a)
            if (!n || isNilOrVoid(getRef(n, countIds(n) - 1))) continue
            for (const u of dependents.get(a) ?? []) if (usesForResult(u, a)) users.add(u)
        }
        if (!users.size) return false
        for (const ids of byOp.get(target.id)!.values()) for (const id of ids) members.add(id)
        let changed = false
        for (const id of users) {
            let n = g.nodes.get(id)
            if (!n || !members.has(id)) continue
            const first = OrderedValues.has(n.op) || n.op === 'apply' ? 1 : n.op === 'ret' ? 0 : countIds(n)
            let lifted: number[] | undefined
            const parts: number[] = []
            for (let i = first; i < countIds(n); i++) {
                const a = g.nodes.get(getRef(n, i))
                if (a?.op !== 'after') continue
                const last = countIds(a) - 1
                if (isNilOrVoid(getRef(a, last))) continue
                const v = getRef(a, last)
                const value = g.nodes.get(v)!
                if (OrderedValues.has(value.op) && cloneRefs(a, 0, last).every(p => {
                    const q = simplifyOrdering(p, n)
                    return isNilOrVoid(q) || q === v
                })) {
                    if (!lifted) lifted = cloneRefs(n)
                    lifted[i] = v
                    continue
                }
                if (!OrderedValues.has(n.op) && !isUnordered(getRef(a, last))) continue
                if (!lifted) lifted = cloneRefs(n)
                lifted[i] = getRef(a, last)
                for (let j = 0; j < last; j++) parts.push(getRef(a, j))
            }
            if (!lifted) continue
            if (OrderedValues.has(n.op)) {
                lifted[0] = effectsJoin([getRef(n, 0), ...parts])
                n = copyNode(n, withRefs(n, lifted))
            } else {
                const inner = g.maxId++
                g.nodes.set(inner, copyNode(n, withRefs(n, lifted)))
                n = copyNode(n, [...parts, inner], 'after')
            }
            g.nodes.set(id, n)
            changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    function eliminateUnusedPureValues(target: GraphBlock): boolean {
        const replacements = new Map<number, number>()
        for (const id of findValues(target.id, 'load') ?? []) {
            if (isResultUsed(id)) continue
            replacements.set(id, getRef(g.nodes.get(id)!, 0))
        }
        for (const id of findValues(target.id, 'call') ?? []) {
            if (isResultUsed(id)) continue
            const n = g.nodes.get(id)!
            if (callEffect(n) > 1) continue
            replacements.set(id, getRef(n, 0))
        }
        if (!replacements.size) return false
        target.bodyId = replaceTransitive(target.bodyId, replacements)
        revisitBlock(target, true)
        return true
    }

    const maxLoopParams = 8
    function workingParams(block: GraphBlock): number {
        let count = 0
        for (const p of block.params) {
            for (const user of dependents.get(p) ?? []) {
                if (g.nodes.get(user)?.op === 'apply') continue
                count++
                break
            }
        }
        return count
    }

    // finds values that never differ across applications and moves them to a pred
    function hoistInvariants(target: GraphBlock) {
        currentMem()
        if (!preds.get(target.id)?.has(target.id)) return
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = g.nodes.get(t)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const filtered = inbound.filter(x => {
            if (x[0] === target.id) return false
            return true
        })
        if (filtered.length !== 1) return
        const pred = filtered[0]
        const self = inbound.filter(x => x[0] === target.id)
        if (!self.length) return

        const inboundArgs = target.params.map((p, i) => {
            const arr: [blockId: number, val: number, isConst: boolean][] = []
            for (const [otherId, app] of inbound) {
                const n = g.nodes.get(app)!
                const v = getRef(n, i+1)
                if (!v) {
                    arr.push([otherId, getLiteral(n, i+1), true])
                } else {
                    arr.push([otherId, v, false])
                }
            }
            return arr
        })

        const obvious = inboundArgs.map((arr, i) => {
            const entry = arr.find(el => el[0] !== target.id)
            for (const el of arr) {
                if (el[0] === target.id) {
                    if (el[2] ? !entry?.[2] || entry[1] !== el[1] : target.params[i] !== el[1]) return false
                } else if (!el[2]) {
                    const b = getBlock(g, el[0])!
                    if (!b.params.includes(el[1])) return false
                }
            }
            return true
        }).map((x, i) => x ? i : -1).filter(x => x !== -1)

        if (!obvious.length) return

        const work = obvious.map(x => target.params[x])
        const invariants = new Set<number>(obvious.map(x => target.params[x]))
        const seen = new Set<number>(target.params)
        const iterating = new Set<number>()
        function markIterating(id: number): void {
            if (!id || iterating.has(id)) return
            const n = g.nodes.get(id)
            if (!n || n.op === 'block') return
            iterating.add(id)
            for (const x of getArgIds(n)) markIterating(x)
        }
        for (const path of applicationPaths(target, target.id)) {
            for (const id of path) {
                const n = g.nodes.get(id)!
                if (n.op === 'select') markIterating(getRef(n, 0))
                else if (n.op === 'after') for (let i = 0; i < countIds(n) - 1; i++) markIterating(getRef(n, i))
                else markIterating(id)
            }
        }
        const calls = (findValues(target.id, 'call') ?? []).filter(x => iterating.has(x) && callEffect(g.nodes.get(x)!) > 1)
        const stores = (findValues(target.id, 'store') ?? []).filter(x => iterating.has(x))
        const relaxed = new Set<number>()
        function isInvariant(id: number): boolean {
            if (isNilOrVoid(id)) return true
            if (invariants.has(id)) return true
            if (seen.has(id)) return false
            seen.add(id)
            const n = g.nodes.get(id)!
            if (n.op === 'apply') return false
            if (n.op === 'ret') return false
            if (n.op === 'select') return false
            if (n.op === 'after' || n.op === 'store' || n.op === 'call' || n.op === 'pstack') return false
            if (TargetingValues.has(n.op)) return false
            if (n.op === 'load') {
                if (calls.some(x => mem!.clobbers(x, n))) return false
                if (stores.some(x => !mem!.disjoint(n, g.nodes.get(x)!))) return false
                if (!isNilOrVoid(getRef(n, 0))) {
                    if (!quietAnchor(id, n)) return false
                    relaxed.add(id)
                }
            }
            for (let i = n.op === 'load' ? 1 : 0; i < countIds(n); i++) {
                if (!isInvariant(getRef(n, i))) return false
            }
            work.push(id)
            invariants.add(id)
            return true
        }

        const covered = new Set<number>()
        while (work.length) {
            const next = work.pop()!
            const s = dependents.get(next)
            if (!s) continue
            let fullyCovered = true
            for (const u of s) {
                if (!isInvariant(u)) {
                    if (fullyCovered && !!inbound.find(x => x[1] === u)) continue
                    fullyCovered = false
                }
            }
            if (fullyCovered) {
                covered.add(next)
            }
        }
        const headroom = Math.max(0, maxLoopParams - workingParams(target))
        if (!headroom) {
            const dropping = obvious.map(i => target.params[i]).filter(p => !covered.has(p))
            while (dropping.length) {
                const stack = [dropping.pop()!]
                while (stack.length) {
                    const x = stack.pop()!
                    if (!invariants.delete(x)) continue
                    for (const u of dependents.get(x) ?? []) stack.push(u)
                }
                for (const p of covered) {
                    for (const u of dependents.get(p) ?? []) {
                        if (invariants.has(u) || inbound.some(x => x[1] === u)) continue
                        covered.delete(p)
                        dropping.push(p)
                        break
                    }
                }
            }
        }
        const roots = new Map<number, [dependent: number, pos: number][]>()
        function addRoot(from: number, to: number, pos: number) {
            let arr = roots.get(from)
            if (!arr) roots.set(from, arr = [])
            arr.push([to, pos])
        }
        for (const x of invariants) {
            if (target.params.includes(x)) continue
            for (const y of dependents.get(x) ?? []) {
                if (invariants.has(y) || !usesForResult(y, x)) continue
                const u = g.nodes.get(y)!
                for (let i = 0; i < countIds(u); i++) {
                    if (getRef(u, i) === x) {
                        addRoot(x, y, i)
                    }
                }
            }
        }
        const coveredParams = target.params.filter(x => covered.has(x))
        const extra = roots.size - coveredParams.length
        if (extra > 0 && [...roots.keys()].some(x => !iterating.has(x))) return
        if (extra > headroom) {
            // console.log('ROOTS', roots)
            // console.log('too many roots vs params:', coveredParams)
            return
        }
        if (!roots.size) return

        const replacements = new Map<number, number>()
        const newParams = target.params.filter(x => !coveredParams.includes(x))
        const paramToRoot = new Map<number, number>()
        for (const r of roots) {
            const p = paramLike(r[0])
            replacements.set(r[0], p)
            paramToRoot.set(p, r[0])
            newParams.push(p)
        }

        const oldParams = [...target.params]

        {
            const replacements = new Map<number, number>()
            const forwardedParams = oldParams.map(x => {
                const p = paramLike(x)
                replacements.set(x, p)
                return p
            })
            for (const x of roots.keys()) seedReanchored(x, relaxed, replacements)
            const hoisted = [...roots.keys()].map(x => {
                return replaceAll(x, replacements)
            })
            const o = oldParams.filter(x => !coveredParams.includes(x))
            const argIds = new Array(1+newParams.length)
            for (let i = 0; i < o.length; i++) {
                argIds[i+1] = replacements.get(newParams[i])
            }
            for (let i = 0; i < hoisted.length; i++) {
                argIds[i+1+o.length] = hoisted[i]
            }
            argIds[0] = target.id
            const forward = addNode('apply', argIds)
            const blk = addBlock(forwardedParams, forward)
            const callerReplacements = new Map<number, number>()
            callerReplacements.set(target.id, blk)
            const caller = getGraphBlock(filtered[0][0])
            caller.bodyId = replaceAll(caller.bodyId, callerReplacements)
            revisitBlock(caller)
            revisitBlock(getBlock(g, blk)!)
        }

        {
            for (const x of self) {
                const app = x[1]
                const u = g.nodes.get(app)!
                const o = oldParams.filter(x => !coveredParams.includes(x))
                const operands: Operand[] = new Array(1+newParams.length)
                let j = 0
                for (let i = 0; i < o.length; i++) {
                    if (coveredParams.includes(target.params[j])) {
                        j += 1
                        i -= 1
                        continue
                    }
                    operands[i+1] = replaceAll(getRef(u, j+1), replacements) || { literal: getLiteral(u, j+1) }
                    j += 1
                }
                for (let i = 0; i < roots.size; i++) {
                    operands[i+1+o.length] = newParams[i+o.length]
                }
                operands[0] = x[0]
                const newApp = addNode('apply', operands)
                replacements.set(app, newApp)
            }
        }  
        target.params = newParams
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function loopMembers(header: GraphBlock): Set<number> {
        const reached = new Set<number>([header.id])
        const work = [header.id]
        while (work.length) {
            for (const s of successors.get(work.pop()!) ?? []) {
                if (reached.has(s)) continue
                reached.add(s)
                work.push(s)
            }
        }
        const members = new Set<number>([header.id])
        work.push(header.id)
        while (work.length) {
            for (const p of preds.get(work.pop()!) ?? []) {
                if (members.has(p) || !reached.has(p)) continue
                members.add(p)
                work.push(p)
            }
        }
        return members
    }

    function leavesLoop(id: number, members: Set<number>): boolean {
        for (let at = id; at;) {
            const n = g.nodes.get(at)
            if (!n) return false
            if (n.op === 'ret' || n.op === 'unreachable' || n.op === 'panic') return true
            if (n.op === 'apply') return !members.has(getRef(n, 0))
            if (n.op !== 'after') return false
            at = getRef(n, countIds(n) - 1)
        }
        return false
    }

    function scanUnswitchCandidates(): void {
        for (const header of reachableBlocks) {
            if (header === g.blocks[0]) continue
            const members = loopMembers(header)
            if (![...(preds.get(header.id) ?? [])].some(p => members.has(p))) continue
            const invariant = new Map<number, number>()
            for (let i = 0; i < header.params.length; i++) {
                const chain = relayChain(header, i, members)
                if (!chain) continue
                for (const [id, at] of chain) invariant.set(getGraphBlock(id).params[at], i)
            }
            let nodes = 0
            let selects = 0
            const conditions = new Set<number>()
            const exits = new Set<number>()
            for (const id of members) {
                for (const ids of byOp.get(id)?.values() ?? []) nodes += ids.length
                for (const sel of findValues(id, 'select') ?? []) {
                    const c = getRef(g.nodes.get(sel)!, 0)
                    const cn = g.nodes.get(c)
                    const refs = cn ? getArgIds(cn).filter(x => x) : []
                    const root = invariant.has(c) ? invariant.get(c)!
                        : cn && cn.op !== 'param' && refs.length && refs.every(x => invariant.has(x)) ? invariant.get(refs[0])! : -1
                    if (root < 0) continue
                    selects++
                    conditions.add(root)
                    const sn = g.nodes.get(sel)!
                    for (let arm = 1; arm < countIds(sn); arm++) {
                        if (leavesLoop(getRef(sn, arm), members)) exits.add(root)
                    }
                }
            }
            if (selects) console.log(`UNSWITCH ${g.name} B${header.id} blocks=${members.size} nodes=${nodes} invariants=${new Set(invariant.values()).size} conditions=${conditions.size} selects=${selects} exiting=${exits.size}`)
        }
    }

    function relayChain(header: GraphBlock, slot: number, members: Set<number>): Map<number, number> | undefined {
        const chain = new Map<number, number>([[header.id, slot]])
        const work = [header]
        while (work.length) {
            const b = work.pop()!
            const p = b.params[chain.get(b.id)!]
            for (const u of dependents.get(p) ?? []) {
                const n = g.nodes.get(u)!
                if (n.op !== 'apply' || !members.has(getRef(n, 0))) continue
                const into = getGraphBlock(getRef(n, 0))
                for (let k = 1; k < countIds(n); k++) {
                    if (getRef(n, k) !== p || chain.has(into.id)) continue
                    chain.set(into.id, k - 1)
                    work.push(into)
                }
            }
        }
        for (const [id, at] of chain) {
            for (const [from, app] of findInboundApplies(getGraphBlock(id))) {
                if (id === header.id && !members.has(from)) continue
                const fromAt = chain.get(from)
                if (fromAt === undefined) return
                if (getRef(g.nodes.get(app)!, at + 1) !== getGraphBlock(from).params[fromAt]) return
            }
        }
        return chain
    }

    function hoistLoopInvariants(target: GraphBlock) {
        currentMem()
        if (target === g.blocks[0]) return false
        const members = loopMembers(target)
        if (members.size < 2) return false
        const entries = findInboundApplies(target).filter(x => !members.has(x[0]))
        if (entries.length !== 1) return false
        const [entryBlock, entryApp] = entries[0]
        const entry = g.nodes.get(entryApp)!

        let carrier: Map<number, number> | undefined
        const invariant = new Map<number, number>()
        for (let i = 0; i < target.params.length; i++) {
            if (!getRef(entry, i + 1)) continue
            const chain = relayChain(target, i, members)
            if (!chain) continue
            carrier ??= chain
            for (const [id, at] of chain) invariant.set(getGraphBlock(id).params[at], getRef(entry, i + 1))
        }
        if (!carrier) return false

        function dependsOn(roots: number[], target: number, stopAtLoads: boolean): boolean {
            const seen = new Set<number>()
            const stack = roots.slice()
            while (stack.length) {
                const id = stack.pop()!
                if (!id || seen.has(id)) continue
                if (id === target) return true
                seen.add(id)
                const n = g.nodes.get(id)
                if (!n || n.op === 'param' || n.op === 'block') continue
                if (stopAtLoads && n.op === 'load') return true
                for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
            }
            return false
        }
        function argOf(app: GraphNode, value: number): number {
            for (let i = 1; i < countIds(app); i++) if (tailOf(g, getRef(app, i)) === value) return i - 1
            return -1
        }
        function continuing(exit: TailPosition): boolean {
            const n = g.nodes.get(exit.at)!
            return n.op === 'apply' && members.has(getRef(n, 0))
        }
        function clean(exit: TailPosition, call: number): boolean {
            const n = g.nodes.get(exit.at)!
            return (n.op === 'ret' || n.op === 'apply' || n.op === 'unreachable') && !getArgIds(n).some(x => x && x !== call && dependsOn([x], call, true))
        }
        function backEdgeOutcome(call: number, blockId: number): number | 'exits' | undefined {
            let wanted: number | undefined
            function agree(k: number | undefined): boolean {
                if (k === undefined || (wanted !== undefined && wanted !== k)) return false
                wanted = k
                return true
            }
            for (const exit of tailPositions(g, getGraphBlock(blockId).bodyId)) {
                if (!dependsOn(tailRoots(g, exit), call, false)) continue
                if (!continuing(exit)) {
                    if (!clean(exit, call)) return
                    continue
                }
                const app = g.nodes.get(exit.at)!
                const next = getGraphBlock(getRef(app, 0))
                const own = valueFacts(g, exit.path, call).is
                if (own !== undefined || next === target) {
                    if (!agree(own)) return
                    continue
                }
                const at = argOf(app, call)
                if (at < 0) return
                for (const inner of tailPositions(g, next.bodyId)) {
                    if (!continuing(inner)) {
                        if (!clean(inner, next.params[at])) return
                        continue
                    }
                    if (!agree(valueFacts(g, inner.path, next.params[at]).is)) return
                }
            }
            return wanted ?? 'exits'
        }
        const calls: [call: number, returned: number | undefined][] = []
        const stores: number[] = []
        for (const id of members) {
            for (const x of findValues(id, 'call') ?? []) {
                const n = g.nodes.get(x)!
                if (callEffect(n) <= 1) continue
                const returned = backEdgeOutcome(x, id)
                if (returned === 'exits' || (returned !== undefined && callEffect(n, returned) <= 1)) continue
                calls.push([x, returned])
            }
            stores.push(...(findValues(id, 'store') ?? []))
        }
        const hoistable = new Map<number, boolean>()
        const relaxed = new Set<number>()
        function canHoist(id: number): boolean {
            if (!id || invariant.has(id)) return true
            const known = hoistable.get(id)
            if (known !== undefined) return known
            const n = g.nodes.get(id)!
            let ok = n.op === 'literal' || n.op === 'convert' || BinaryOps.has(n.op)
                || (n.op === 'load' && !calls.some(([x, returned]) => mem!.clobbers(x, n, returned))
                    && !stores.some(x => !mem!.disjoint(n, g.nodes.get(x)!))
                    && (isNilOrVoid(getRef(n, 0)) || (quietAnchor(id, n) && !!relaxed.add(id))))
            for (let i = n.op === 'load' ? 1 : 0; ok && i < countIds(n); i++) ok = canHoist(getRef(n, i))
            hoistable.set(id, ok)
            return ok
        }
        function worthHoisting(id: number): boolean {
            const n = g.nodes.get(id)!
            if (n.op === 'load') return true
            for (let i = 0; i < countIds(n); i++) {
                const op = g.nodes.get(getRef(n, i))?.op
                if (op && op !== 'param' && op !== 'literal') return true
            }
            return false
        }
        const roots: number[] = []
        const rootBlock = new Map<number, number>()
        for (const blockId of carrier.keys()) {
            const seen = new Set<number>()
            const work = [getGraphBlock(blockId).bodyId]
            while (work.length) {
                const id = work.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const n = g.nodes.get(id)!
                for (let i = 0; i < countIds(n); i++) {
                    const x = getRef(n, i)
                    const op = g.nodes.get(x)?.op
                    if (!x || op === 'param' || op === 'literal' || op === 'nil-effect' || op === 'block') continue
                    if (!canHoist(x)) work.push(x)
                    else if (worthHoisting(x) && !rootBlock.has(x)) {
                        roots.push(x)
                        rootBlock.set(x, blockId)
                    }
                }
            }
        }
        let fullest = 0
        for (const id of carrier.keys()) fullest = Math.max(fullest, workingParams(getGraphBlock(id)))
        roots.splice(Math.max(0, maxLoopParams - fullest))
        if (!roots.length) return false

        const entryFrom = getGraphBlock(entryBlock)
        const state = stateAt(entryFrom, entryApp)
        if (state === undefined) return false
        const outside = new Map(invariant)
        for (const r of roots) seedReanchored(r, relaxed, outside)
        const epoch = nextEpoch(g)
        const entryValues = new Set(invariant.values())
        const anchored = new Map<number, number>()
        function anchor(id: number): number {
            if (entryValues.has(id)) return id
            const n = id ? g.nodes.get(id) : undefined
            if (!n || n.op === 'param' || n.op === 'block') return id
            const known = anchored.get(id)
            if (known !== undefined) return known
            const operands = getOperands(n)
            let changed = false
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const next = n.op === 'load' && i === 0 && isNilOrVoid(ref) && !quietSince(state, n) ? state : anchor(ref)
                if (next === ref) continue
                operands[i] = next
                changed = true
            }
            const result = changed ? addNode(n.op, operands, n) : id
            anchored.set(id, result)
            return result
        }
        const hoisted = roots.map(r => anchor(replaceAll(r, outside, epoch)))
        entryFrom.bodyId = replaceAll(entryFrom.bodyId,
            new Map([[entryApp, addNode('apply', [...getOperands(entry), ...hoisted], entry)]]))

        const added = new Map<number, number[]>()
        for (const id of carrier.keys()) added.set(id, roots.map(r => paramLike(r)))
        for (const [id, extra] of added) {
            const b = getGraphBlock(id)
            const replacements = new Map<number, number>()
            roots.forEach((r, k) => {
                if (rootBlock.get(r) === id) replacements.set(r, extra[k])
            })
            const inner = nextEpoch(g)
            for (const app of findValues(id, 'apply') ?? []) {
                const n = g.nodes.get(app)!
                if (!carrier.has(getRef(n, 0))) continue
                const ids = cloneRefs(n).map((x, i) => i && x ? replaceAll(x, replacements, inner) : x)
                replacements.set(app, addNode('apply', [...withRefs(n, ids), ...extra], n))
            }
            b.params.push(...extra)
            b.bodyId = replaceAll(b.bodyId, replacements, inner)
        }
        revisitBlock(entryFrom)
        for (const id of carrier.keys()) revisitBlock(getGraphBlock(id))
        return true
    }

    function sinkReloadedStores(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        const members = loopMembers(target)
        const inbound = findInboundApplies(target)
        const entries = inbound.filter(x => !members.has(x[0]))
        const backs = inbound.filter(x => members.has(x[0]))
        if (entries.length !== 1 || !backs.length) return false
        const bodyId = backs[0][0]
        if (backs.some(x => x[0] !== bodyId)) return false
        const body = getGraphBlock(bodyId)
        let relay: number[] | undefined
        if (body !== target) {
            if (findValues(target.id, 'store')?.length || findValues(target.id, 'call')?.length) return false
            const into = findInboundApplies(body)
            if (into.length !== 1 || into[0][0] !== target.id) return false
            relay = cloneRefs(g.nodes.get(into[0][1])!).slice(1)
        }
        const [entryBlock, entryApp] = entries[0]
        const entry = g.nodes.get(entryApp)!

        function headerSlot(ref: number): number {
            const i = body.params.indexOf(ref)
            if (i < 0) return -1
            return relay ? target.params.indexOf(relay[i]) : i
        }
        function entryPointer(ref: number): number | undefined {
            const i = body.params.indexOf(ref)
            if (i < 0) return
            const outer = relay ? relay[i] : ref
            const at = target.params.indexOf(outer)
            if (at < 0) {
                const op = g.nodes.get(outer)?.op
                return op === 'alloca' || op === 'frame-address' ? outer : undefined
            }
            if (!relayChain(target, at, members) || !getRef(entry, at + 1)) return
            return getRef(entry, at + 1)
        }
        function wrapper(block: number, app: number): number | undefined {
            for (const u of dependents.get(app) ?? []) {
                const n = g.nodes.get(u)!
                if (n.op === 'after' && countIds(n) === 2 && getRef(n, 1) === app) return u
            }
        }
        function reloads(store: GraphNode, slot: number): boolean {
            for (const [block, app] of backs) {
                const loaded = g.nodes.get(skipAfter(getRef(g.nodes.get(app)!, slot + 1)) ?? 0)
                if (!loaded || loaded.op !== 'load') return false
                if (getRef(loaded, 1) !== getRef(store, 1) || getRef(loaded, 2)) return false
                if (getLiteral(loaded, 2) !== getLiteral(store, 2) || typeOf(loaded) !== typeOf(store)) return false
                if (applyWriter(block, app) !== lastWriter(getRef(loaded, 0))) return false
            }
            return true
        }
        function applyWriter(block: number, app: number): number | undefined {
            const after = wrapper(block, app)
            if (after !== undefined) return lastWriter(getRef(g.nodes.get(after)!, 0))
            let writer: number | undefined
            const n = g.nodes.get(app)!
            for (let i = 1; i < countIds(n); i++) {
                const arg = g.nodes.get(getRef(n, i))
                if (!arg || (arg.op !== 'after' && !OrderedValues.has(arg.op))) continue
                const w = lastWriter(getRef(n, i))
                if (writer !== undefined && writer !== w) return
                writer = w
            }
            return writer
        }
        function lastWriter(token: number): number {
            for (;;) {
                const n = g.nodes.get(token)
                if (!n || (n.op !== 'load' && n.op !== 'after')) return token
                token = getRef(n, 0)
            }
        }
        function firstWrite(store: GraphNode): boolean {
            const bytes = intrinsics.intrinsicBitWidth(typeOf(store)) / 8
            for (let t = getRef(store, 0); t;) {
                const n = g.nodes.get(t)!
                if (n.op === 'nil-effect') return true
                if (n.op === 'load') {
                    t = getRef(n, 0)
                    continue
                }
                if (n.op !== 'store' || getRef(n, 1) !== getRef(store, 1) || getRef(n, 2)) return false
                const at = getLiteral(n, 2)
                const width = intrinsics.intrinsicBitWidth(typeOf(n)) / 8
                if (at < getLiteral(store, 2) + bytes && getLiteral(store, 2) < at + width) return false
                t = getRef(n, 0)
            }
            return true
        }

        for (const id of findValues(body.id, 'store') ?? []) {
            const store = g.nodes.get(id)!
            if (!getRef(store, 1) || getRef(store, 2)) continue
            const slot = headerSlot(getRef(store, 3))
            if (slot < 0 || !getRef(entry, slot + 1) && getLiteral(entry, slot + 1) === undefined) continue
            const ptr = entryPointer(getRef(store, 1))
            if (ptr === undefined || !firstWrite(store) || !reloads(store, slot)) continue

            const from = getGraphBlock(entryBlock)
            const outer = wrapper(entryBlock, entryApp)
            const ordering = outer !== undefined ? [getRef(g.nodes.get(outer)!, 0)] : []
            for (let i = 1; i < countIds(entry); i++) {
                const arg = g.nodes.get(getRef(entry, i))
                if (arg && (arg.op === 'after' || OrderedValues.has(arg.op))) ordering.push(getRef(entry, i))
            }
            const token = ordering.length > 1 ? addNode('after', ordering) : ordering[0] ?? 0
            const value = getRef(entry, slot + 1)
            const sunk = addNode('store', [token, ptr, { literal: getLiteral(store, 2) }, value || { literal: getLiteral(entry, slot + 1) }], store)
            const sequenced = addNode('after', [sunk, entryApp])
            from.bodyId = replaceAll(from.bodyId, new Map([[outer ?? entryApp, sequenced]]))
            const removed = getRef(store, 0) || addNode('nil-effect', [])
            body.bodyId = replaceAll(body.bodyId, new Map([[id, removed]]))
            revisitBlock(from)
            revisitBlock(body)
            return true
        }
        return false
    }

    function rootsOf(sg: Set<number>) {
        const res = new Set<number>(sg)
        for (const x of sg) {
            const n = g.nodes.get(x)
            for (let i = 0; n && i < countIds(n); i++) res.delete(operandEdge(n, i))
        }
        return res
    }

    function isOrdered(vid: number): boolean {
        if (!vid) return false
        const u = g.nodes.get(vid)
        if (!u) return false
        if (!PureOps.has(u.op)) return true
        if (u.op === 'after' || u.op === 'param') {
            return true
        }
        for (let i = 0; i < countIds(u); i++) {
            if (isOrdered(getRef(u, i))) return true
        }
        return false
    }

    let liveParams: Set<number> | undefined
    function liveParameters(): Set<number> {
        if (liveParams) return liveParams
        const live = new Set<number>()
        const forwarded = new Map<number, number[]>()
        const pending: number[] = []
        function mark(p: number) {
            if (live.has(p)) return
            live.add(p)
            pending.push(p)
        }
        for (const b of reachableBlocks) {
            for (const p of b.params) {
                if (b.bodyId === p) mark(p)
                for (const id of dependents.get(p) ?? []) {
                    const n = g.nodes.get(id)!
                    if (n.op !== 'apply') { mark(p); break }
                }
            }
            for (const id of findValues(b.id, 'apply') ?? []) {
                const n = g.nodes.get(id)!
                const target = getGraphBlock(getRef(n, 0))
                for (let i = 1; i < countIds(n); i++) {
                    const p = getRef(n, i)
                    if (!p || g.nodes.get(p)!.op !== 'param') continue
                    const to = target.params[i - 1]
                    let from = forwarded.get(to)
                    if (!from) forwarded.set(to, from = [])
                    from.push(p)
                }
            }
        }
        while (pending.length) {
            for (const from of forwarded.get(pending.pop()!) ?? []) mark(from)
        }
        return liveParams = live
    }

    function shiftedArg(app: number, i: number): GraphNode | undefined {
        const arg = g.nodes.get(getRef(g.nodes.get(app)!, i + 1))
        return arg?.op === 'shl' && !getRef(arg, 1) && getRef(arg, 0) ? arg : undefined
    }

    function shiftAt(inbound: [number, number][], i: number): number {
        let shift = -1
        for (const [, app] of inbound) {
            const arg = shiftedArg(app, i)
            if (!arg || (shift >= 0 && getLiteral(arg, 1) !== shift)) return -1
            shift = getLiteral(arg, 1)
        }
        return shift
    }

    function unshiftedAt(inbound: [number, number][], target: GraphBlock, i: number): number {
        let at = -1
        for (const [, app] of inbound) {
            const unshifted = getRef(shiftedArg(app, i)!, 0)
            const n = g.nodes.get(app)!
            let j = target.params.length - 1
            while (j >= 0 && (j === i || getRef(n, j + 1) !== unshifted)) j--
            if (j < 0 || (at >= 0 && j !== at)) return -1
            at = j
        }
        return at
    }

    function scaledAccess(u: number, p: number, shift: number): boolean {
        const n = g.nodes.get(u)
        return costs.scaledIndex && (n?.op === 'load' || n?.op === 'store') && getRef(n, 2) === p && getRef(n, 1) !== p
            && intrinsics.intrinsicBitWidth(typeOf(n)) === 8 << shift
    }

    function rematerializeOffsets(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        let params: number[] | undefined
        let local: Map<number, number> | undefined
        for (let i = 0; i < target.params.length; i++) {
            const p = target.params[i]
            const users = dependents.get(p)
            if (!users?.size) continue
            const shift = shiftAt(inbound, i)
            if (shift < 0) continue
            const sample = shiftedArg(inbound[0][1], i)!
            const j = unshiftedAt(inbound, target, i)
            let source = j >= 0 ? target.params[j] : 0
            if (j >= 0 && shiftAt(inbound, j) >= 0) continue
            if (j < 0) {
                let scaled = true
                for (const u of users) if (!scaledAccess(u, p, shift)) { scaled = false; break }
                if (!scaled) continue
                params ??= target.params.slice()
                source = params[i] = paramLike(getRef(sample, 0))
            }
            local ??= new Map()
            local.set(p, addNode('shl', [source, { literal: shift }], sample))
        }
        if (!local) return false
        target.bodyId = replaceAll(target.bodyId, local)
        if (params) {
            const edits = new Map<GraphBlock, Map<number, number>>()
            for (const [fromId, appId] of inbound) {
                const from = getGraphBlock(fromId)
                const id = from === target ? local.get(appId) ?? appId : appId
                const app = g.nodes.get(id)!
                const operands = getOperands(app)
                for (let i = 0; i < params.length; i++) {
                    if (params[i] !== target.params[i]) operands[i + 1] = getRef(shiftedArg(id, i)!, 0)
                }
                let r = edits.get(from)
                if (!r) edits.set(from, r = new Map())
                r.set(id, addNode('apply', operands, app))
            }
            target.params = params
            for (const [from, r] of edits) {
                from.bodyId = replaceAll(from.bodyId, r)
                if (from !== target) revisitBlock(from)
            }
        }
        liveParams = undefined
        revisitBlock(target)
        return true
    }

    function pruneUnusedParams(b: GraphBlock) {
        if (b === g.blocks[0]) return false
        const live = liveParameters()
        const safe = new Set(b.params.filter(p => live.has(p)))
        if (safe.size === b.params.length) return false
        const inbound = findInboundApplies(b)
        const newParams = [...safe]
        const safeIndices = newParams.map(x => b.params.indexOf(x) + 1)
        b.params = newParams
        const replacements = new Map<number, number>()
        const changedBlocks = new Set<number>()
        for (const x of inbound) {
            changedBlocks.add(x[0])
            const u = g.nodes.get(x[1])!
            const o = [getRef(u, 0)] as (number | GraphNode)[]
            const rem: number[] = []
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (safeIndices.includes(i)) {
                    if (a) o.push(a)
                    else o.push(literal(getLiteral(u, i)))
                } else if (a && !isParam(g.nodes, a)) {
                    const q = simplifyOrdering(a, orderingSink)
                    if (q && !isNilOrVoid(q) && !rem.includes(q)) rem.push(q)
                }
            }
            let app = createNode(g, 'apply', o, u)
            if (rem.length) app = createNode(g, 'after', [...rem, app])
            replacements.set(x[1], app)
        }
        for (const bid of changedBlocks) {
            const b = getGraphBlock(bid)
            b.bodyId = replaceAll(b.bodyId, replacements)
        }
        for (const bid of changedBlocks) {
            revisitBlock(getGraphBlock(bid))
        }
        return true
    }

    function getApplyInputs(val: number, params: number[]) {
        const n = g.nodes.get(val)
        assert(n && n.op === 'apply')
        const b = getBlock(g, getRef(n, 0))
        assert(b)
        return params.map(x => {
            const idx = b.params.indexOf(x)
            assert(idx !== -1)
            if (!getRef(n, idx)) {
                return { val: getLiteral(n, 1+idx), const: true }
            }
            return { val: getRef(n, 1+idx), const: false }
        })
    }

    function findLoopCriticalSubgraph(target: GraphBlock) {
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = g.nodes.get(t)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const filtered = inbound.filter(x => x[0] === target.id)
        if (!filtered.length) return
        if (!getArgIds(tail).includes(filtered[0][1])) return

        const cond = getRef(tail, 0)
        const dependentParams = findValuesFrom(target.id, 'param', cond)
        if (!dependentParams?.length) return

        const criticalValues = filtered
            .map(x => getApplyInputs(x[1], dependentParams)).flat()
            .filter(x => !x.const).map(x => x.val)
            .filter(x => !dependentParams.includes(x))

        if (!criticalValues.length) return

        const sg = collectSubgraphOf(criticalValues)

        return { 
            sg,
            tail,
            inbound,
            criticalValues,
            dependentParams,
        }
    }

    const orderedCache = new Map<number, boolean>()
    function isUnordered(id: number): boolean {
        if (!id) return true
        const known = orderedCache.get(id)
        if (known !== undefined) return known
        orderedCache.set(id, true)
        const n = g.nodes.get(id)!
        let ok = PureOps.has(n.op)
        if (ok) for (const a of gn.enumerateRefs(n)) if (!isUnordered(a)) { ok = false; break }
        orderedCache.set(id, ok)
        return ok
    }

    const guaranteedEffects = new Map<number, Set<number>>()
    guaranteedEffects.set(0, new Set())
    function guaranteed(id: number): Set<number> {
        const known = guaranteedEffects.get(id)
        if (known) return known
        const n = g.nodes.get(id)!
        const out = new Set<number>()
        guaranteedEffects.set(id, out)
        if (n.op === 'select') {
            for (const effect of guaranteed(getRef(n, 0))) out.add(effect)
            const yes = guaranteed(getRef(n, 1))
            const no = guaranteed(getRef(n, 2))
            for (const effect of yes) if (no.has(effect)) out.add(effect)
        } else if (n) {
            const end = n.op === 'after' ? countIds(n) - 1 : countIds(n)
            for (let i = 0; i < end; i++) {
                for (const effect of guaranteed(getRef(n, i))) out.add(effect)
            }
            if (OrderedValues.has(n.op)) out.add(id)
        }
        return out
    }

    function liftCommonEffects(target: GraphBlock) {
        const selects = findValues(target.id, 'select')
        if (!selects) return
        const lifts = new Map<number, number>()
        for (const id of selects) {
            const n = g.nodes.get(id)
            if (!n || n.op !== 'select') continue
            const before = guaranteed(getRef(n, 0))
            const yes = guaranteed(getRef(n, 1))
            const no = guaranteed(getRef(n, 2))
            const common: number[] = []
            for (const effect of yes) {
                if (no.has(effect) && !before.has(effect)) common.push(effect)
            }
            const latest = common.filter(effect => {
                for (const other of common) {
                    if (other !== effect && guaranteed(other).has(effect)) return false
                }
                return true
            })
            if (latest.length === 1) lifts.set(id, latest[0])
        }
        if (!lifts.size) return
        for (const [id, effect] of lifts) {
            const select = g.nodes.get(id)!
            const inner = addNode(select.op, getOperands(select), select)
            g.nodes.set(id, makeNode('after', [effect, inner]))
        }
        revisitBlock(target)
        return true
    }

    function liftCommonApplication(id: number) {
        const n = g.nodes.get(id)
        if (!n || n.op !== 'select') return false
        let yes = g.nodes.get(getRef(n, 1))
        let no = g.nodes.get(getRef(n, 2))
        const orderings: Operand[] = []
        if (yes?.op === 'after' && no?.op === 'after') {
            const end = countIds(yes) - 1
            if (countIds(no) - 1 !== end) return false
            for (let i = 0; i < end; i++) {
                if (!getRef(yes, i) || getRef(yes, i) !== getRef(no, i)) return false
                orderings.push(getRef(yes, i))
            }
            yes = g.nodes.get(getRef(yes, end))
            no = g.nodes.get(getRef(no, end))
        }
        if (!yes || yes.op !== 'apply' || !no || no.op !== 'apply') return false
        if (getRef(yes, 0) !== getRef(no, 0) || countIds(yes) !== countIds(no)) return false

        const block = getGraphBlock(getRef(yes, 0))
        const differ: number[] = []
        for (let i = 1; i < countIds(yes); i++) {
            if (getRef(yes, i) === getRef(no, i)
                && (getRef(yes, i) || getLiteral(yes, i) === getLiteral(no, i))) continue
            if (!isUnordered(getRef(yes, i)) || !isUnordered(getRef(no, i))) return false
            differ.push(i)
        }
        if (!differ.length && !isUnordered(getRef(n, 0))) return false

        const operands = getOperands(yes)
        for (const at of differ) operands[at] = addNode('select', [getOperand(n, 0), getOperand(yes, at), getOperand(no, at)], n)
        if (!orderings.length) {
            g.nodes.set(id, copyNode(yes, operands))
            return true
        }
        g.nodes.set(id, makeNode('after', [...orderings, addNode('apply', operands, yes)]))
        return true
    }

    function liftCommonApplications(target: GraphBlock) {
        const selects = findValues(target.id, 'select')
        if (!selects) return
        let changed = false
        for (let i = selects.length - 1; i >= 0; i--) {
            if (liftCommonApplication(selects[i])) changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    function isCountedIncrement(n: GraphNode | undefined, param: number) {
        if (!n || n.op !== 'add') return false
        return (getRef(n, 0) === param && !getRef(n, 1) && getLiteral(n, 1) === 1)
            || (getRef(n, 1) === param && !getRef(n, 0) && getLiteral(n, 0) === 1)
    }

    function closeCountedLoop(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (self.length !== 1 || !entries.length) return
        if (getRef(tail, 1) !== self[0][1]) return
        const exit = g.nodes.get(getRef(tail, 2))
        if (!exit || exit.op !== 'apply') return
        const cond = g.nodes.get(getRef(tail, 0))
        if (!cond || cond.op !== 'lt') return
        if (lowering.isSignedType(operandType(g, cond, 0)) || lowering.isSignedType(operandType(g, cond, 1))) return

        const back = g.nodes.get(self[0][1])!
        const params = target.params
        const invariants = new Set<number>()
        for (let i = 0; i < params.length; i++) {
            if (getRef(back, i+1) === params[i]) invariants.add(params[i])
        }
        function invariantOperand(id: number, value: number) {
            if (!id) return { id: 0, value }
            if (invariants.has(id)) return { id, value: 0 }
        }

        const ivAt = params.indexOf(getRef(cond, 0))
        if (ivAt < 0) return
        if (!isCountedIncrement(g.nodes.get(getRef(back, ivAt+1)), params[ivAt])) return
        const bound = invariantOperand(getRef(cond, 1), getLiteral(cond, 1))
        if (!bound) return

        const accumulators: [at: number, step: { id: number, value: number }, of: GraphNode][] = []
        for (let i = 0; i < params.length; i++) {
            if (i === ivAt || invariants.has(params[i])) continue
            const update = g.nodes.get(getRef(back, i+1))
            if (!update || update.op !== 'add') return
            const at = getRef(update, 0) === params[i] ? 1
                : getRef(update, 1) === params[i] ? 0 : -1
            if (at < 0) return
            const step = invariantOperand(getRef(update, at), getLiteral(update, at))
            if (!step) return
            accumulators.push([i, step, update])
        }

        const paramSet = new Set<number>(params)

        for (let i = 1; i < countIds(exit); i++) {
            const id = getRef(exit, i)
            if (!paramSet.has(id) && reachesAnyOf(id, paramSet)) return
        }

        const touched: number[] = []
        for (const [blockId, appId] of entries) {
            const app = g.nodes.get(appId)!
            if (getRef(app, ivAt+1) || getLiteral(app, ivAt+1) !== 0) continue
            function argOf(at: number) {
                return { id: getRef(app, at+1), value: getLiteral(app, at+1) }
            }
            function outside(operand: { id: number, value: number }) {
                return operand.id ? argOf(params.indexOf(operand.id)) : operand
            }

            const trip = outside(bound)
            const finals = new Map<number, { id: number, value: number }>()
            for (let i = 0; i < params.length; i++) finals.set(params[i], argOf(i))
            finals.set(params[ivAt], trip)
            for (const [at, step, of] of accumulators) {
                const s = outside(step)
                const total = addNode('mul', [trip.id || { literal: trip.value }, s.id || { literal: s.value }], of)
                const initial = argOf(at)
                const final = initial.id || initial.value
                    ? addNode('add', [initial.id || { literal: initial.value }, total], of)
                    : total
                finals.set(params[at], { id: final, value: 0 })
            }

            const operands = getOperands(exit)
            for (let i = 1; i < operands.length; i++) {
                const final = finals.get(getRef(exit, i))
                if (!final) continue
                operands[i] = final.id || { literal: final.value }
            }
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addNode('apply', operands, exit)]]))
            touched.push(blockId)
        }
        if (!touched.length) return
        for (const blockId of touched) revisitBlock(getGraphBlock(blockId))
        return true
    }

    function hoistSharedSelectValues(target: GraphBlock) {
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select' || countIds(tail) < 3) return false
        const condition = collectSubgraph(getRef(tail, 0))
        if (condition.size > 3) return false // ideally, you would compare against how much baggage the shared roots would drop
        for (const id of condition) if (g.nodes.get(id)?.op === 'call') return false

        let shared: Set<number> | undefined
        for (let i = 1; i < countIds(tail); i++) {
            const arm = collectSubgraph(getRef(tail, i))
            if (!shared) shared = arm
            else for (const id of shared) if (!arm.has(id)) shared.delete(id)
        }
        if (!shared?.size) return false
        for (const id of condition) shared.delete(id)
        for (const param of target.params) shared.delete(param)

        const roots = [...rootsOf(shared)].filter(id => {
            const n = g.nodes.get(id)
            if (!n) return false
            if (TargetingValues.has(n.op)) return false
            if (OrderedValues.has(n.op)) {
                return isNilOrVoid(getRef(n, 0))
            }
            if (isOrdered(id)) return false
            return n.op !== 'block' && n.op !== 'literal'
                && n.op !== 'nil-effect' && n.op !== 'void' && n.op !== 'apply'
                && n.op !== 'select' && n.op !== 'ret' && n.op !== 'panic'
                && n.op !== 'unreachable'
        })
        if (!roots.length) return false

        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const oldParams = [...target.params]
        const sharedParams = roots.map(r => paramLike(r))
        const inside = new Map<number, number>()
        for (let i = 0; i < roots.length; i++) inside.set(roots[i], sharedParams[i])
        target.params.push(...sharedParams)
        target.bodyId = replaceAll(target.bodyId, inside)

        const forwardedParams = oldParams.map(p => paramLike(p))
        const outside = new Map<number, number>()
        for (let i = 0; i < oldParams.length; i++) outside.set(oldParams[i], forwardedParams[i])
        const hoisted = roots.map(root => replaceAll(root, outside))
        const args = [target.id, ...forwardedParams, ...hoisted]
        const forward = addNode('apply', args)
        const forwardingId = addBlock(forwardedParams, forward)

        const callers = new Set<GraphBlock>()
        for (const [blockId] of inbound) callers.add(getGraphBlock(blockId))
        for (const caller of callers) {
            caller.bodyId = replaceAll(caller.bodyId, new Map([[target.id, forwardingId]]))
        }
        for (const caller of callers) revisitBlock(caller)
        revisitBlock(target)
        revisitBlock(getGraphBlock(forwardingId))
        return true
    }

    function deriveIncrementor(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return
        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (!self.length || !entries.length) return
        const selfIds = new Set(self.map(x => x[1]))
        const backs = self.map(x => g.nodes.get(x[1])!)
        const params = target.params
        const invariants = new Set<number>()
        for (let i = 0; i < params.length; i++) {
            if (backs.every(back => getRef(back, i + 1) === params[i])) invariants.add(params[i])
        }
        function invariant(n: GraphNode, i: number) {
            return !getRef(n, i) || invariants.has(getRef(n, i))
        }
        function derivation(n: GraphNode, from: number) {
            if (countIds(n) !== 2) return -1
            const at = getRef(n, 0) === from ? 0 : getRef(n, 1) === from ? 1 : -1
            if (at < 0) return -1
            if (n.op === 'add') return invariant(n, at ^ 1) ? at : -1
            if (n.op === 'mul') return !getRef(n, at ^ 1) && getLiteral(n, at ^ 1) > 0 ? at : -1
            if (n.op === 'shl') return at === 0 && !getRef(n, 1) ? at : -1
            return -1
        }

        for (let at = 0; at < params.length; at++) {
            const p = params[at]
            if (invariants.has(p)) continue
            function strideOf(back: GraphNode) {
                const step = g.nodes.get(getRef(back, at + 1))
                if (!step || step.op !== 'add') return
                const strideAt = derivation(step, p) ^ 1
                if (strideAt < 0 || strideAt > 1 || getRef(step, strideAt)) return
                for (const u of dependents.get(getRef(back, at + 1)) ?? []) {
                    if (!selfIds.has(u)) return
                }
                return getLiteral(step, strideAt)
            }
            const strides = backs.map(strideOf)
            if (strides.some(x => x === undefined)) continue
            const steps = new Set(backs.map(back => getRef(back, at + 1)))
            if (backs.some(back => getArgIds(back).some((id, i) => i !== at + 1 && steps.has(id)))) continue

            const chain: [id: number, from: number][] = []
            const compares: number[] = []
            let valid = true
            for (const u of dependents.get(p) ?? []) {
                if (steps.has(u)) continue
                const n = g.nodes.get(u)!
                if (CompareOps.has(n.op) && invariant(n, getRef(n, 0) === p ? 1 : 0)) {
                    if (lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))) valid = false
                    compares.push(u)
                    continue
                }
                const from = derivation(n, p)
                if (from < 0 || chain.length) valid = false
                chain.push([u, from])
            }
            if (!valid || !chain.length) continue
            for (;;) {
                const uses = dependents.get(chain[chain.length - 1][0])
                if (!uses || uses.size !== 1) break
                let next = 0
                for (const u of uses) next = u
                const from = derivation(g.nodes.get(next)!, chain[chain.length - 1][0])
                if (from < 0) break
                chain.push([next, from])
            }

            let scale = 1
            for (const [id, from] of chain) {
                const n = g.nodes.get(id)!
                if (n.op === 'mul') scale *= getLiteral(n, from ^ 1)
                if (n.op === 'shl') scale *= 2 ** getLiteral(n, 1)
            }
            if (strides.some(x => !Number.isSafeInteger(x! * scale))) continue

            function replay(value: [number, number], operand: (id: number, value: number) => [number, number]) {
                for (const [id, from] of chain) {
                    const n = g.nodes.get(id)!
                    const ids = [0, 0]
                    const consts = [0, 0]
                    ids[from] = value[0]
                    consts[from] = value[1]
                    const x = operand(getRef(n, from ^ 1), getLiteral(n, from ^ 1))
                    ids[from ^ 1] = x[0]
                    consts[from ^ 1] = x[1]
                    if (ids[0] || ids[1]) {
                        value = [addNode(n.op, ids.map((id, i) => id || { literal: consts[i] }), n), 0]
                    } else if (n.op === 'add') {
                        value = [0, consts[0] + consts[1]]
                    } else if (n.op === 'mul') {
                        value = [0, consts[0] * consts[1]]
                    } else {
                        value = [0, consts[0] * 2 ** consts[1]]
                    }
                }
                return value
            }
            const closed = chain.every(([id, from]) => !getRef(g.nodes.get(id)!, from ^ 1))

            function moved<T>(a: T[]): T[] {
                return [...a.slice(0, at + 1), ...a.slice(at + 2, params.length + 1), a[at + 1], ...a.slice(params.length + 1)]
            }
            const derived = chain[chain.length - 1][0]
            let addr = 0
            const memory: [id: number, offset: number][] = []
            function locate(id: number, offset: number): boolean {
                for (const u of dependents.get(id) ?? []) {
                    const n = g.nodes.get(u)!
                    if (n.op === 'add' && countIds(n) === 2) {
                        const at = getRef(n, 0) === id ? 1 : 0
                        if (getRef(n, at) || !locate(u, offset + getLiteral(n, at))) return false
                        continue
                    }
                    if (n.op !== 'load' && n.op !== 'store') return false
                    if (getRef(n, 2) !== id || getRef(n, 3) === id || !invariants.has(getRef(n, 1))) return false
                    if (addr && addr !== getRef(n, 1)) return false
                    addr = getRef(n, 1)
                    memory.push([u, offset])
                }
                return true
            }
            if (!closed || !locate(derived, 0)) addr = 0
            const bias = addr ? replay([0, 0], (id, value) => [id, value])[1] : 0
            function address(value: [number, number], outside: (id: number, value: number) => [number, number]): [number, number] {
                const base = outside(addr, 0)
                if (!value[0] && !value[1]) return base
                const offset = value[0] ? addNode('mul', [value[0], { literal: scale }]) : 0
                return [addNode('add', [base[0] || { literal: base[1] }, offset || { literal: value[1] * scale }]), 0]
            }

            const replacements = new Map<number, number>()
            if (!addr) replacements.set(derived, p)
            const limits: [param: number, bound: [number, number]][] = []
            for (const id of compares) {
                const n = g.nodes.get(id)!
                const boundAt = getRef(n, 0) === p ? 1 : 0
                const operands = getOperands(n)
                if (closed && !addr && !getRef(n, boundAt)) {
                    operands[boundAt] = { literal: replay([0, getLiteral(n, boundAt)], (id, value) => [id, value])[1] }
                } else {
                    const limit = paramLike(getRef(n, boundAt))
                    limits.push([limit, [getRef(n, boundAt), getLiteral(n, boundAt)]])
                    operands[boundAt] = limit
                }
                replacements.set(id, addNode(n.op, operands, n))
            }
            for (const [id, offset] of addr ? memory : []) {
                const n = g.nodes.get(id)!
                const copy = copyNode(n)
                setRef(copy, 1, p)
                setLiteral(copy, 2, bias + offset)
                g.nodes.set(id, copy)
            }

            for (let k = 0; k < backs.length; k++) {
                const back = backs[k]
                const backOperands: Operand[] = [target.id]
                for (let i = 1; i < countIds(back); i++) {
                    backOperands.push(i === at + 1 ? 0 : replaceAll(getRef(back, i), replacements) || { literal: getLiteral(back, i) })
                }
                const step = g.nodes.get(getRef(back, at + 1))!
                backOperands[at + 1] = addNode('add', [p, { literal: strides[k]! * scale }], step)
                for (const [limit] of limits) backOperands.push(limit)
                replacements.set(self[k][1], addNode('apply', moved(backOperands), back))
            }

            for (const [blockId, appId] of entries) {
                const app = g.nodes.get(appId)!
                function outside(id: number, value: number): [number, number] {
                    if (!id) return [0, value]
                    const i = params.indexOf(id) + 1
                    return [getRef(app, i), getLiteral(app, i)]
                }
                const operands = getOperands(app)
                const derive = addr ? address : replay
                const n = derive([getRef(app, at + 1), getLiteral(app, at + 1)], outside)
                operands[at + 1] = n[0] || { literal: n[1] }
                for (const [, bound] of limits) {
                    const [id, value] = derive(outside(...bound), outside)
                    operands.push(id || { literal: value })
                }
                const caller = getGraphBlock(blockId)
                caller.bodyId = replaceAll(caller.bodyId,
                    new Map([[appId, addNode('apply', moved(operands), app)]]))
                revisitBlock(caller)
            }

            target.params = moved([target.id, ...params, ...limits.map(x => x[0])]).slice(1)
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
    }

    interface CounterCarrier {
        block: GraphBlock
        at: number
        bound: number
        stepped: boolean
    }

   function reverseLoop(target: GraphBlock) {
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return
        const condId = getRef(tail, 0)
        const cond = g.nodes.get(condId)!
        if (!cond || (cond.op !== 'lt' && cond.op !== 'le')) return
        if (lowering.isSignedType(operandType(g, cond, 0)) || lowering.isSignedType(operandType(g, cond, 1))) return
        const params = target.params
        const at = params.indexOf(getRef(cond, 0))
        const boundAt = params.indexOf(getRef(cond, 1))
        if (at < 0 || boundAt < 0 || at === boundAt) return
        const p = params[at]
        const bound = params[boundAt]
        const exit = getRef(tail, 2)
        if (reaches(exit, p)) return

        const carriers = new Map<number, CounterCarrier>()
        const chain = new Set<number>()
        const steps: [block: GraphBlock, id: number][] = []
        const memory: number[] = []
        const work: number[] = []
        let stride = 0
        carriers.set(p, { block: target, at, bound, stepped: false })
        work.push(p)

        function feed(carrier: CounterCarrier, value: number, appId: number, stepped: boolean) {
            const app = g.nodes.get(appId)
            if (!app || app.op !== 'apply') return false
            const b = getGraphBlock(getRef(app, 0))
            if (countIds(app) !== b.params.length + 1) return false
            let nat = -1
            for (let i = 0; i < b.params.length; i++) {
                if (getRef(app, i + 1) !== value) continue
                if (nat >= 0) return false
                nat = i
            }
            if (nat < 0) return false
            chain.add(appId)
            if (b === target) {
                return nat === at && stepped && getRef(app, boundAt + 1) === carrier.bound
            }
            let nbound = -1
            for (let i = 0; i < b.params.length; i++) {
                if (getRef(app, i + 1) === carrier.bound) { nbound = i; break }
            }
            if (nbound < 0) return false
            const q = b.params[nat]
            const known = carriers.get(q)
            if (known) return known.bound === b.params[nbound] && known.stepped === stepped
            carriers.set(q, { block: b, at: nat, bound: b.params[nbound], stepped })
            work.push(q)
            return true
        }

        while (const q = work.pop()) {
            const carrier = carriers.get(q)!
            for (const u of dependents.get(q) ?? []) {
                if (q === p && u === condId) continue
                const n = g.nodes.get(u)!
                if (q === p && (n.op === 'load' || n.op === 'store')
                    && getRef(n, 1) === q && !getRef(n, 2) && getRef(n, 3) !== q) {
                    memory.push(u)
                    continue
                }
                if (n.op === 'add' && getRef(n, 0) === q && !getRef(n, 1)) {
                    if (carrier.stepped) return
                    const s = getLiteral(n, 1)
                    if (!Number.isSafeInteger(s) || s <= 0 || (stride && stride !== s)) return
                    const uses = dependents.get(u)
                    if (uses?.size !== 1) return
                    stride = s
                    steps.push([carrier.block, u])
                    if (!feed(carrier, u, [...uses!][0], true)) return
                    continue
                }
                if (!feed(carrier, q, u, carrier.stepped)) return
            }
        }
        if (!steps.length) return
        for (const carrier of carriers.values()) {
            if (carrier.block === target) continue
            for (const [, appId] of findInboundApplies(carrier.block)) {
                if (!chain.has(appId)) return
            }
        }

        const entries = findInboundApplies(target).filter(x => !chain.has(x[1]))
        if (!entries.length) return

        function arg(app: GraphNode, i: number): [number, number] {
            return [getRef(app, i + 1), getLiteral(app, i + 1)]
        }
        function multiple(id: number, value: number) {
            if (stride === 1) return true
            if (!id) return value % stride === 0
            const n = g.nodes.get(id)
            if (!n || getRef(n, 1)) return false
            if (n.op === 'mul') return getLiteral(n, 1) % stride === 0
            if (n.op === 'shl') return 2 ** getLiteral(n, 1) % stride === 0
            return false
        }
        function aligned(app: GraphNode) {
            const start = arg(app, at)
            const limit = arg(app, boundAt)
            if (!start[0] && !start[1]) return multiple(limit[0], limit[1])
            if (!start[0] || !limit[0]) return false
            const n = g.nodes.get(limit[0])
            if (!n || n.op !== 'add') return false
            const other = getRef(n, 0) === start[0] ? 1 : getRef(n, 1) === start[0] ? 0 : -1
            return other >= 0 && multiple(getRef(n, other), getLiteral(n, other))
        }
        if (!entries.every(x => aligned(g.nodes.get(x[1])!))) return

        const zero = entries.every(x => {
            const start = arg(g.nodes.get(x[1])!, at)
            return !start[0] && !start[1]
        })

        if (memory.length) return reverseMemoryWalk()

        if (!zero) return
        if (cond.op === 'le' && stride !== 1) return
        const template = g.nodes.get(steps[0][1])!
        const edits = new Map<GraphBlock, Map<number, number>>()
        function edit(b: GraphBlock, from: number, to: number) {
            let m = edits.get(b)
            if (!m) edits.set(b, m = new Map())
            m.set(from, to)
        }
        edit(target, condId, addNode('ne', [p, 0], cond))
        for (const [b, id] of steps) {
            const n = g.nodes.get(id)!
            edit(b, id, addNode('sub', [getRef(n, 0), { literal: getLiteral(n, 1) }], n))
        }
        for (const [b, m] of edits) b.bodyId = replaceAll(b.bodyId, m)
        for (const [blockId, appId] of entries) {
            const app = g.nodes.get(appId)!
            const operands = getOperands(app)
            const limit = arg(app, boundAt)
            const start: [number, number] = cond.op === 'lt' ? limit
                : limit[0] ? [addNode('add', [limit[0], { literal: 1 }], template), 0]
                : [0, limit[1] + 1]
            operands[at + 1] = start[0] || { literal: start[1] }
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addNode('apply', operands, app)]]))
            edits.set(caller, edits.get(caller) ?? new Map())
        }
        for (const b of edits.keys()) revisitBlock(b)
        if (!edits.has(target)) revisitBlock(target)
        return true

        function reverseMemoryWalk() {
            if (cond.op !== 'lt' || chain.size !== 1 || steps.length !== 1 || carriers.size !== 1) return
            const backId = [...chain][0]
            if (getRef(tail!, 1) !== backId) return
            if (findValues(target.id, 'select')?.length !== 1) return
            if (findValues(target.id, 'store')?.length) return
            if (findValues(target.id, 'call')?.length) return
            const back = g.nodes.get(backId)!
            for (const u of dependents.get(bound) ?? []) {
                if (u !== condId && u !== backId) return
            }
            const stepId = steps[0][1]

            const accumulating = new Set<string>(['add', 'mul', 'and', 'or', 'xor'])
            const accumulators = new Map<number, number>()
            for (let i = 0; i < params.length; i++) {
                if (i === at || getRef(back, i + 1) === params[i]) continue
                const uses = dependents.get(params[i])
                if (!uses?.size) continue
                const updateId = getRef(back, i + 1)
                const update = g.nodes.get(updateId)
                if (!update || !accumulating.has(update.op)) return
                const x = getRef(update, 0) === params[i] ? 1 : getRef(update, 1) === params[i] ? 0 : -1
                if (x < 0) return
                for (const u of uses) {
                    if (u !== updateId && u !== exit) return
                }
                if (dependents.get(updateId)?.size !== 1) return
                accumulators.set(params[i], getRef(update, x))
            }
            const accumulated = new Set<number>(accumulators.keys())
            for (const x of accumulators.values()) {
                if (x && (accumulated.has(x) || reachesAnyOf(x, accumulated))) return
            }

            const bias = zero ? 0 : Math.min(...memory.map(u => getLiteral(g.nodes.get(u)!, 2)))
            for (const u of bias ? memory : []) {
                const n = g.nodes.get(u)!
                const copy = copyNode(n)
                setLiteral(copy, 2, getLiteral(n, 2) - bias)
                g.nodes.set(u, copy)
            }
            const next = addNode('sub', [p, { literal: stride }], g.nodes.get(stepId)!)
            const test = addNode('ne', [p, zero ? 0 : bound], cond)
            target.bodyId = replaceAll(target.bodyId, new Map([[condId, test], [stepId, next], [p, next]]))

            function shifted(value: [number, number]): [number, number] {
                if (!bias) return value
                if (!value[0]) return [0, value[1] + bias]
                return [addNode('add', [value[0], { literal: bias }]), 0]
            }
            function rebased(app: GraphNode, stop: [number, number]): [number, number] {
                const limit = g.nodes.get(getRef(app, boundAt + 1))!
                const other = getRef(limit, 0) === getRef(app, at + 1) ? 1 : 0
                return [addNode('add', [stop[0] || { literal: stop[1] }, getOperand(limit, other)]), 0]
            }
            for (const [blockId, appId] of entries) {
                const app = g.nodes.get(appId)!
                const operands = getOperands(app)
                const stop = shifted(arg(app, at))
                const start = bias ? rebased(app, stop) : arg(app, boundAt)
                operands[at + 1] = start[0] || { literal: start[1] }
                operands[boundAt + 1] = stop[0] || { literal: stop[1] }
                const caller = getGraphBlock(blockId)
                caller.bodyId = replaceAll(caller.bodyId,
                    new Map([[appId, addNode('apply', operands, app)]]))
                revisitBlock(caller)
            }
            revisitBlock(target)
            return true
        }
    }

    function rotateLoop(target: GraphBlock) {
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return
        const back = g.nodes.get(getRef(tail, 1))
        if (!back || back.op !== 'apply' || getRef(back, 0) !== target.id) return

        function gather(id: number, out: Set<number>): Set<number> {
            if (!id || out.has(id)) return out
            const n = g.nodes.get(id)
            if (!n || n.op === 'block') return out
            out.add(id)
            for (let i = n.op === 'apply' ? 1 : 0; i < countIds(n); i++) gather(getRef(n, i), out)
            return out
        }
        const inCond = gather(getRef(tail, 0), new Set())
        const inBack = new Set<number>()
        for (let i = 1; i < countIds(back); i++) gather(getRef(back, i), inBack)
        const inExit = gather(getRef(tail, 2), new Set())

        let shared = false
        for (let i = 1; i < countIds(back); i++) {
            const arg = getRef(back, i)
            if (arg && g.nodes.has(arg) && !isParam(g.nodes, arg) && inCond.has(arg)) { shared = true; break }
        }
        if (!shared) return

        const unconditional = new Set(inCond)
        for (const id of inBack) if (inExit.has(id)) unconditional.add(id)
        function speculatable(id: number): boolean {
            if (!id || unconditional.has(id)) return true
            const n = g.nodes.get(id)!
            if (n.op === 'param') return true
            if (n.op !== 'after' && !PureOps.has(n.op)) return false
            for (const arg of getArgIds(n)) if (!speculatable(arg)) return false
            return true
        }
        for (let i = 1; i < countIds(back); i++) {
            if (!speculatable(getRef(back, i))) return
        }

        const params: number[] = []
        const args: number[] = []
        const lowered = new Map<number, [id: number, konst: number]>()
        function drag(id: number, konst: number): [id: number, konst: number] {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const p = paramLike(id)
            const out: [id: number, konst: number] = [p, 0]
            lowered.set(id, out)
            params.push(p)
            args.push(id)
            return out
        }
        function lower(id: number, konst: number): [id: number, konst: number] | undefined {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const n = g.nodes.get(id)
            if (!n || isParam(g.nodes, id) || inBack.has(id)) return drag(id, konst)
            if (n.op !== 'after' && !PureOps.has(n.op)) return
            const operands: Operand[] = []
            for (let i = 0; i < countIds(n); i++) {
                const arg = lower(getRef(n, i), getLiteral(n, i))
                if (!arg) return
                operands.push(arg[0] || { literal: arg[1] })
            }
            const out: [id: number, konst: number] = [addNode(n.op, operands, n), 0]
            lowered.set(id, out)
            return out
        }

        const backOperands: Operand[] = [target.id]
        for (let i = 1; i < countIds(back); i++) {
            const [id, konst] = drag(getRef(back, i), getLiteral(back, i))
            backOperands.push(id || { literal: konst })
        }

        const cond = lower(getRef(tail, 0), getLiteral(tail, 0))
        if (!cond) return

        let exit: [id: number, konst: number] | undefined
        const exitNode = g.nodes.get(getRef(tail, 2))
        if (exitNode?.op === 'apply') {
            const operands: Operand[] = [getRef(exitNode, 0)]
            for (let i = 1; i < countIds(exitNode); i++) {
                const arg = lower(getRef(exitNode, i), getLiteral(exitNode, i))
                if (!arg) return
                operands.push(arg[0] || { literal: arg[1] })
            }
            exit = [addNode('apply', operands, exitNode), 0]
        } else {
            exit = lower(getRef(tail, 2), getLiteral(tail, 2))
        }
        if (!exit) return

        const backApply = addNode('apply', backOperands, back)
        const body = addNode('select', [cond[0] || { literal: cond[1] }, backApply, exit[0] || { literal: exit[1] }], tail)
        const blockId = addBlock(params, body)
        const entryIds = [blockId, ...args]
        target.bodyId = addNode('apply', entryIds, back)
        revisitBlock(target)
        return true
    }

    function advanceLoopLoads(target: GraphBlock): boolean {
        if ((findValues(target.id, 'store')?.length ?? 0) || (findValues(target.id, 'call')?.length ?? 0)) return false
        const self = findInboundApplies(target).filter(x => x[0] === target.id)
        if (self.length !== 1) return false
        const back = g.nodes.get(self[0][1])!

        for (let at = 0; at < target.params.length; at++) {
            const param = target.params[at]
            const stepId = getRef(back, at + 1)
            const step = g.nodes.get(stepId)
            if (!step || step.op !== 'add') continue
            const paramAt = getRef(step, 0) === param && !getRef(step, 1) ? 0
                : getRef(step, 1) === param && !getRef(step, 0) ? 1 : -1
            if (paramAt < 0) continue
            const stride = getLiteral(step, paramAt ^ 1)
            if (!Number.isSafeInteger(stride) || stride <= 0 || stride > costs.writebackStride) continue

            const compares = [...dependents.get(param) ?? []].filter(id => {
                const n = g.nodes.get(id)!
                return n.op === 'lt' && getRef(n, 0) === param
                    && !lowering.isSignedType(operandType(g, n, 0)) && !lowering.isSignedType(operandType(g, n, 1))
            })
            if (compares.length !== 1) continue
            const compareId = compares[0]
            const loads = [...dependents.get(param) ?? []].filter(id => {
                const n = g.nodes.get(id)!
                return n.op === 'load' && getRef(n, 1) === param && !getRef(n, 2)
            })
            const advancing = loads.find(id => getLiteral(g.nodes.get(id)!, 2) === stride
                && [...dependents.get(id) ?? []].some(user => CompareOps.has(g.nodes.get(user)?.op ?? '')))
            if (advancing === undefined) continue
            const allowed = new Set<number>([stepId, compareId, ...loads])
            if ([...dependents.get(param) ?? []].some(id => !allowed.has(id))) continue

            const combine = [...dependents.get(compareId) ?? []].find(id => {
                const n = g.nodes.get(id)!
                if (n.op !== 'and') return false
                const other = getRef(n, 0) === compareId ? getRef(n, 1)
                    : getRef(n, 1) === compareId ? getRef(n, 0) : 0
                return !!other && reaches(other, advancing)
            })
            if (combine === undefined) continue

            const compare = g.nodes.get(compareId)!
            const nextCompare = addNode('le', [stepId, getOperand(compare, 1)], compare)
            const and = g.nodes.get(combine)!
            const other = getRef(and, 0) === compareId ? getRef(and, 1) : getRef(and, 0)
            const replacements = new Map<number, number>([
                [compareId, nextCompare],
                [combine, addNode('and', [other, nextCompare], and)],
            ])
            for (const id of loads) {
                if (id === advancing) continue
                const load = g.nodes.get(id)!
                const offset = getLiteral(load, 2)
                if (offset < stride) { replacements.clear(); break }
                const operands = getOperands(load)
                operands[1] = stepId
                operands[2] = { literal: offset - stride }
                replacements.set(id, addNode('load', operands, load))
            }
            if (!replacements.size) continue
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
        return false
    }

    function eliminatePassthru(b: GraphBlock) {
        let bodyId = b.bodyId
        let body = g.nodes.get(bodyId)
        assert(body)
        if (body.op === 'apply' && getRef(body, 0) !== b.id && b.id !== 0) {
            const forwarded: number[] = []
            for (let i = 1; i < countLiterals(body); i++) {
                const arg = getRef(body, i)
                const at = arg ? b.params.indexOf(arg) : -1
                if (at < 0) return false
                forwarded.push(at + 1)
            }
            const applies = findInboundApplies(b)
            for (const [, id] of applies) {
                if (countIds(g.nodes.get(id)!) !== b.params.length + 1) return false
            }
            const byBlock = new Map<number, Map<number, number>>()
            for (const [blockId, id] of applies) {
                const app = g.nodes.get(id)!
                const operands = [getRef(body, 0), ...forwarded.map(i => getOperand(app, i))]
                let replacements = byBlock.get(blockId)
                if (!replacements) byBlock.set(blockId, replacements = new Map())
                replacements.set(id, addNode('apply', operands, app))
            }
            for (const [blockId, replacements] of byBlock) {
                const from = getGraphBlock(blockId)
                from.bodyId = replaceAll(from.bodyId, replacements)
                revisitBlock(from)
            }
            removeBlock(b)
            return true
        }
        if (b.params.length > 1) return false
        if (body.op === 'ret') {
            return false
        }
        const isVoid = body.op === 'void'
        const isUnreachable = body.op === 'unreachable'
        if (!isVoid && !isUnreachable && !b.params.includes(bodyId)) return false

        const applies = findInboundApplies(b)
        const byBlock = new Map<number, number[]>()
        for (const x of applies) {
            let arr = byBlock.get(x[0])
            if (!arr) byBlock.set(x[0], arr = [])
            arr.push(x[1])
        }
        for (const [k, v] of byBlock) {
            const r = new Map<number, number>()
            for (const x of v) {
                const a = g.nodes.get(x)!
                if (isUnreachable || (isVoid && !b.params.length)) {
                    r.set(x, b.bodyId)
                    continue
                }
                const arg = getRef(a, 1)
                if (arg) {
                    if (isVoid) {
                        r.set(x, addNode('after', [arg, b.bodyId]))
                    } else {
                        r.set(x, arg)
                    }
                    continue
                }
                const c = getLiteral(a, 1)
                const literal = addNode('literal', [{ literal: c }])
                if (isVoid) {
                    r.set(x, addNode('after', [literal, b.bodyId]))
                } else {
                    r.set(x, literal)
                }
            }
            const t = getBlock(g, k)!
            t.bodyId = replaceAll(t.bodyId, r)
            revisitBlock(t)
        }
        removeBlock(b)
        return true
    }

    function mergeBlocks(target: GraphBlock): boolean {
        const next = successors.get(target.id)
        if (!next || next.size !== 1) return false
        const b = getGraphBlock([...next][0])
        if (b.id === target.id || b.id === g.blocks[0].id || preds.get(b.id)?.size !== 1) return false
        const tail = g.nodes.get(b.bodyId)
        if (!tail || tail.op === 'ret' || tail.op === 'panic') return false
        if ((findValues(b.id, 'apply')?.length ?? 0) > 1) return false

        const paths = applicationPaths(target, b.id)
        if (paths.length !== 1) return false
        const path = paths[0]
        const site = path[path.length - 1]
        const app = g.nodes.get(site)!
        if (countIds(app) !== b.params.length + 1) return false
        if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false

        const merged = inlineApplication(path, b, b.bodyId)
        if (merged === undefined) return false

        removeBlock(b)
        target.bodyId = replaceAll(target.bodyId, new Map([[site, merged]]))
        revisitBlock(target)
        return true
    }

    function foldKnownConditions(target: GraphBlock): boolean {
        if ((findValues(target.id, 'select')?.length ?? 0) < 2) return false
        function keyOf(id: number): string | undefined {
            const n = g.nodes.get(id)
            if (!n) return
            return n.op === 'param' || n.op === 'block' ? `#${id}` : nodeKey(n)
        }
        function assume(known: Map<string, number>, cond: number, value: number): Map<string, number> {
            const next = new Map(known)
            const key = keyOf(cond)
            if (key === undefined) return next
            next.set(key, value)
            const n = g.nodes.get(cond)!
            if (CompareOps.has(n.op) && !comparesFloats(g, n)) next.set(nodeKey(copyNode(n, getOperands(n), InverseCompare[n.op])), value ? 0 : 1)
            return next
        }
        function lookup(known: Map<string, number>, cond: number): number | undefined {
            if (!cond || !known.size) return
            const key = keyOf(cond)
            return key === undefined ? undefined : known.get(key)
        }
        function rewrite(id: number, known: Map<string, number>): number {
            if (!known.size) return id
            const r = new Map<number, number>()
            const walked = new Set<number>()
            function visit(x: number): void {
                if (!x || walked.has(x)) return
                walked.add(x)
                const n = g.nodes.get(x)
                if (!n || n.op === 'param' || n.op === 'block') return
                for (const a of getArgIds(n)) visit(a)
                if (n.op !== 'select' || countIds(n) !== 3) return
                const k = lookup(known, getRef(n, 0))
                if (k === undefined) return
                const arm = k ? 1 : 2
                r.set(x, getRef(n, arm)
                    ? replaceAll(getRef(n, arm), r)
                    : addNode('literal', [{ literal: getLiteral(n, arm) }]))
            }
            visit(id)
            return r.size ? replaceAll(id, r) : id
        }
        function tails(id: number, known: Map<string, number>): number {
            const n = g.nodes.get(id)
            if (!n) return id
            if (n.op === 'select' && countIds(n) === 3) {
                const k = lookup(known, getRef(n, 0))
                if (k !== undefined) return getRef(n, k ? 1 : 2) ? tails(getRef(n, k ? 1 : 2), known) : rewrite(id, known)
                const a = tails(getRef(n, 1), assume(known, getRef(n, 0), 1))
                const b = tails(getRef(n, 2), assume(known, getRef(n, 0), 0))
                const c = rewrite(getRef(n, 0), known)
                if (a === getRef(n, 1) && b === getRef(n, 2) && c === getRef(n, 0)) return id
                return addNode('select', withRefs(n, [c, a, b]), n)
            }
            if (n.op === 'after') {
                const last = countIds(n) - 1
                const argIds = getArgIds(n).map((x, i) => i === last ? tails(x, known) : rewrite(x, known))
                if (argIds.every((x, i) => x === getRef(n, i))) return id
                return addNode('after', withRefs(n, argIds), n)
            }
            return rewrite(id, known)
        }
        const body = tails(target.bodyId, new Map())
        if (body === target.bodyId) return false
        target.bodyId = body
        revisitBlock(target)
        return true
    }

    function reduceSelects(b: GraphBlock) {
        const selects = findValues(b.id, 'select')
        if (!selects?.length) return false

        function sameOperand(a: GraphNode, ai: number, c: GraphNode, ci: number) {
            const aId = getRef(a, ai)
            const cId = getRef(c, ci)
            return aId === cId && (aId || getLiteral(a, ai) === getLiteral(c, ci))
        }

        const nested = new Map<number, number>()
        for (const id of selects) {
            const outer = g.nodes.get(id)!
            if (countIds(outer) !== 3) continue
            for (const innerAt of [1, 2]) {
                const inner = g.nodes.get(getRef(outer, innerAt))
                if (!inner || inner.op !== 'select' || countIds(inner) !== 3
                    || !sameOperand(outer, 0, inner, 0)) continue
                const operands = [getOperand(outer, 0),
                    innerAt === 1 ? getOperand(inner, 1) : getOperand(outer, 1),
                    innerAt === 1 ? getOperand(outer, 2) : getOperand(inner, 2)]
                nested.set(id, addNode('select', operands, outer))
                break
            }
        }
        if (nested.size) {
            b.bodyId = replaceAll(b.bodyId, nested)
            revisitBlock(b)
            return true
        }

        const filtered = selects.filter(x => {
            const n = g.nodes.get(x)!
            const arm1 = getLiteral(n, 1)
            if (arm1 !== 0) return false
            if (getRef(n, 1) !== 0) return false
            const arm2 = getLiteral(n, 2)
            if (arm2 !== 1) return false
            return true
        })
        if (filtered.length === 0) return false
        const r = new Map<number, number>()
        for (const x of filtered) {
            const usages = dependents.get(x) ?? []
            for (const d of usages) {
                const u = g.nodes.get(d)!
                if (!CompareOps.has(u.op)) continue
                const selectAt = getRef(u, 0) === x ? 0 : getRef(u, 1) === x ? 1 : -1
                if (selectAt !== 0) continue
                if (getRef(u, 1) !== 0) continue
                const rhs = getLiteral(u, 1)
                if ((rhs === 1 || rhs === 0) && (u.op === 'eq' || u.op === 'ne')) {
                    const q = copyNode(u, undefined, u.op === 'eq' ? 'ne' : 'eq')
                    setRef(q, 0, getRef(g.nodes.get(x)!, 0))
                    setLiteral(q, 1, 0)
                    const qId = g.maxId++
                    g.nodes.set(qId, q)
                    r.set(d, qId)
                    continue
                }
            }
        }

        if (!r.size) return false
        b.bodyId = replaceAll(b.bodyId, r)
        revisitBlock(b)
        return true
    }

    function applicationPaths(from: GraphBlock, to: number): number[][] {
        const paths: number[][] = []
        function tails(id: number, path: number[]): void {
            const n = g.nodes.get(id)
            if (!n) return
            path.push(id)
            if (n.op === 'apply' && getRef(n, 0) === to) paths.push(path.slice())
            else if (n.op === 'after') tails(getRef(n, countIds(n) - 1), path)
            else if (n.op === 'select') for (let i = 1; i < countIds(n); i++) tails(getRef(n, i), path)
            path.pop()
        }
        tails(from.bodyId, [])
        return paths
    }

    function inlineApplication(path: number[], b: GraphBlock, bodyId: number): number | undefined {
        const app = g.nodes.get(path[path.length - 1])!
        let conditional = false
        function frontier(id: number, into: Set<number>): void {
            if (conditional) return
            if (!id || into.has(id) || isUnordered(id)) return
            const n = g.nodes.get(id)!
            if (OrderedValues.has(n.op)) {
                into.add(id)
            } else if (n.op === 'select') {
                frontier(getRef(n, 0), into)
                if (cloneRefs(n, 1).some(x => !isUnordered(x))) conditional = true
            } else {
                for (const x of getArgIds(n)) frontier(x, into)
            }
        }
        const order = new Set<number>()
        for (const id of path.slice(0, -1)) {
            const n = g.nodes.get(id)!
            const end = n.op === 'after' ? countIds(n) - 1 : 1
            for (let i = 0; i < end; i++) frontier(getRef(n, i), order)
            if (conditional) return
        }
        const context = new Set(order)
        for (let i = 1; i < countIds(app); i++) frontier(getRef(app, i), order)
        if (conditional) return
        const implied = new Set<number>()
        for (const id of order) {
            for (const x of getArgIds(g.nodes.get(id)!)) frontier(x, implied)
        }
        const kept = [...order].filter(id => !implied.has(id))
        const join = kept.length > 1
            ? addNode('after', [...kept, addNode('void', [])])
            : kept[0] ?? 0

        const r = new Map<number, number>()
        for (let i = 0; i < b.params.length; i++) {
            r.set(b.params[i], getRef(app, i + 1) || addNode('literal', [{ literal: getLiteral(app, i + 1) }]))
        }
        if (join) {
            const epoch = nextEpoch(g)
            function nils(id: number): void {
                if (!id) return
                const n = g.nodes.get(id)
                if (!n || !markVisited(n, epoch)) return
                if (n?.op === 'nil-effect') r.set(id, join)
                else for (const x of getArgIds(n)) nils(x)
            }
            nils(bodyId)
        }
        let merged = replaceAll(bodyId, r)
        const dropped = kept.filter(id => !context.has(id))
        if (dropped.length) merged = addNode('after', [...dropped, merged])
        return merged
    }

    function constantOf(n: GraphNode, i: number): number | undefined {
        let id = getRef(n, i)
        let konst = getLiteral(n, i)
        for (;;) {
            if (!id) return konst
            const u = g.nodes.get(id)
            if (!u) return
            if (u.op === 'literal') return literalValue(u)
            if (u.op !== 'after') return
            const last = countIds(u) - 1
            for (let j = 0; j < last; j++) {
                const op = g.nodes.get(getRef(u, j))?.op
                if (getRef(u, j) && op !== 'nil-effect' && op !== 'void') return
            }
            id = getRef(u, last)
            konst = getLiteral(u, last)
        }
    }

    function threadConstantBranches(target: GraphBlock): boolean {
        if (target.id === g.blocks[0].id) return false
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select' || countIds(tail) !== 3) return false
        const at = target.params.indexOf(getRef(tail, 0))
        if (at < 0) return false
        const froms = preds.get(target.id)
        if (!froms || froms.has(target.id)) return false

        const sites: [from: GraphBlock, path: number[], arm: number][] = []
        const seen = new Set<number>()
        const chosen = new Set<number>()
        for (const k of froms) {
            const from = getGraphBlock(k)
            for (const path of applicationPaths(from, target.id)) {
                const site = path[path.length - 1]
                if (seen.has(site)) return false
                seen.add(site)
                const app = g.nodes.get(site)!
                if (countIds(app) !== target.params.length + 1) return false
                if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false
                const value = constantOf(app, at + 1)
                if (value === undefined) return false
                const arm = value ? 1 : 2
                if (!getRef(tail, arm) || chosen.has(arm)) return false
                chosen.add(arm)
                sites.push([from, path, getRef(tail, arm)])
            }
        }
        if (sites.length !== findInboundApplies(target).length) return false

        const merged: number[] = []
        for (const [, path, arm] of sites) {
            const m = inlineApplication(path, target, arm)
            if (m === undefined) return false
            merged.push(m)
        }
        const edits = new Map<GraphBlock, Map<number, number>>()
        for (let i = 0; i < sites.length; i++) {
            const [from, path] = sites[i]
            let r = edits.get(from)
            if (!r) edits.set(from, r = new Map())
            r.set(path[path.length - 1], merged[i])
        }
        removeBlock(target)
        for (const [from, r] of edits) {
            from.bodyId = replaceAll(from.bodyId, r)
            revisitBlock(from)
        }
        return true
    }

    function threadDecidedArrivals(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select' || countIds(tail) !== 3) return false
        for (const arm of [1, 2]) {
            const n = g.nodes.get(getRef(tail, arm))
            if (!n || (n.op !== 'apply' && n.op !== 'ret')) return false
        }
        const cond = g.nodes.get(getRef(tail, 0))
        if (!cond || !CompareOps.has(cond.op) || comparesFloats(g, cond)) return false
        const sides = [0, 1].map(i => getRef(cond, i) ? target.params.indexOf(getRef(cond, i)) : -2)
        if (sides.some(at => at === -1)) return false
        const argsOf = (app: GraphNode) => sides.map((at, i) => at === -2 ? [0, getLiteral(cond, i)] : [getRef(app, at + 1), getLiteral(app, at + 1)])
        const compare = (args: number[][], facts: Facts) => decideCompare(cond, args[0], args[1], facts)
        const candidate = (app: GraphNode) => !argsOf(app).some(([r]) => r && !ArrivalShapes.has(g.nodes.get(r)!.op))
        const decided: [from: GraphBlock, path: number[], arm: number][] = []
        let survives = false
        for (const [fromId, appId] of findInboundApplies(target)) {
            if (fromId === target.id || !candidate(g.nodes.get(appId)!)) {
                survives = true
                continue
            }
            const from = getGraphBlock(fromId)
            const paths = applicationPaths(from, target.id).filter(p => p[p.length - 1] === appId)
            if (paths.length !== 1) {
                survives = true
                continue
            }
            const path = paths[0]
            const selects: SelectPath = []
            for (let i = 0; i + 1 < path.length; i++) {
                const n = g.nodes.get(path[i])!
                if (n.op !== 'select') continue
                for (let j = 1; j < countIds(n); j++) if (getRef(n, j) === path[i + 1]) { selects.push([path[i], j]); break }
            }
            const outcome = compare(argsOf(g.nodes.get(appId)!), pathFacts(g, selects))
            if (outcome === undefined) survives = true
            else decided.push([from, path, outcome ? 1 : 2])
        }
        if (!decided.length || compare(sides.map((at, i) => at === -2 ? [0, getLiteral(cond, i)] : [getRef(cond, i), 0]), []) !== undefined) return false
        const takers = [0, 0, 0]
        for (const [, , arm] of decided) takers[arm]++
        const movable = [1, 2].map(arm => {
            const t = g.nodes.get(getRef(tail, arm))!
            let coded = false
            for (let i = t.op === 'apply' ? 1 : 0; i < countIds(t); i++) {
                const r = getRef(t, i)
                if (r && !target.params.includes(r) && g.nodes.get(r)?.op !== 'literal') coded = true
            }
            return !coded || (takers[arm] === 1 && !survives)
        })
        const edits = new Map<GraphBlock, Map<number, number>>()
        for (const [from, path, arm] of decided) {
            if (!movable[arm - 1]) continue
            const merged = inlineApplication(path, target, getRef(tail, arm))
            if (merged === undefined) continue
            let r = edits.get(from)
            if (!r) edits.set(from, r = new Map())
            r.set(path[path.length - 1], merged)
        }
        if (!edits.size) return false
        for (const [from, r] of edits) {
            from.bodyId = replaceAll(from.bodyId, r)
            revisitBlock(from)
        }
        return true
    }

    function decideCompare(cond: GraphNode, [a, ak]: number[], [b, bk]: number[], facts: Facts): boolean | undefined {
        const ranges = currentRanges()
        const signed = lowering.isSignedType(operandType(g, cond, 0)) || lowering.isSignedType(operandType(g, cond, 1))
        if (signed && (ranges.range(a, ak, facts)[1] === Infinity || ranges.range(b, bk, facts)[1] === Infinity)) return
        const le = (x: number, xk: number, y: number, yk: number) => ranges.le(x, xk, y, yk, facts)
        const lt = (x: number, xk: number, y: number, yk: number) => ranges.lt(x, xk, y, yk, facts)
        const op = cond.op
        if (op === 'gt') return lt(b, bk, a, ak) ? true : le(a, ak, b, bk) ? false : undefined
        if (op === 'ge') return le(b, bk, a, ak) ? true : lt(a, ak, b, bk) ? false : undefined
        if (op === 'lt') return lt(a, ak, b, bk) ? true : le(b, bk, a, ak) ? false : undefined
        if (op === 'le') return le(a, ak, b, bk) ? true : lt(b, bk, a, ak) ? false : undefined
        if (op === 'eq') return lt(a, ak, b, bk) || lt(b, bk, a, ak) ? false : undefined
        if (op === 'ne') return lt(a, ak, b, bk) || lt(b, bk, a, ak) ? true : undefined
        return
    }

    function absorbConditions(target: GraphBlock): boolean {
        if (target.id === g.blocks[0].id) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const apps = inbound.map(([, id]) => g.nodes.get(id)!)
        if (apps.some(app => countIds(app) !== target.params.length + 1)) return false
        const sites = new Set(inbound.map(([, id]) => id))
        for (const select of findValues(target.id, 'select') ?? []) {
            const at = target.params.indexOf(getRef(g.nodes.get(select)!, 0))
            if (at < 0) continue
            const conds = apps.map(app => g.nodes.get(getRef(app, at + 1)))
            const shape = conds.find(n => n && CompareOps.has(n.op))
            if (!shape) continue
            const op = shape.op
            const fixed = [0, 1].map(j => {
                const k = scalarOperand(g.nodes, shape, j)
                if (k === undefined) return undefined
                return conds.some(n => n && CompareOps.has(n.op) && scalarOperand(g.nodes, n, j) !== k) ? undefined : k
            })
            const varying = [0, 1].filter(j => fixed[j] === undefined)
            if (!varying.length || fixed.some(k => k !== undefined && k < 0)) continue
            const candidates = [0, 1, ...fixed.flatMap(k => k === undefined ? [] : [k, k + 1])]
            function solve(want: number, chosen: number[]): number[] | undefined {
                if (chosen.length === varying.length) {
                    const [a, b] = [0, 1].map(j => fixed[j] ?? chosen[varying.indexOf(j)])
                    return +CompareEval[op](a, b) === want ? chosen : undefined
                }
                for (const c of candidates) {
                    const found = solve(want, [...chosen, c])
                    if (found) return found
                }
                return undefined
            }

            const operands: { id: number, konst: number }[][] = []
            for (let i = 0; i < apps.length; i++) {
                const cond = conds[i]
                if (cond && CompareOps.has(cond.op)) {
                    if (cond.op !== op || typeOf(cond) !== typeOf(shape)) break
                    if (varying.some(j => lowering.isSignedType(operandType(g, cond, j)) !== lowering.isSignedType(operandType(g, shape, j)))) break
                    if ([...dependents.get(getRef(apps[i], at + 1)) ?? []].some(user => !sites.has(user))) break
                    operands.push(varying.map(j => ({ id: getRef(cond, j), konst: getLiteral(cond, j) })))
                    continue
                }
                const k = scalarOperand(g.nodes, apps[i], at + 1)
                const solved = k === 0 || k === 1 ? solve(k, []) : undefined
                if (!solved) break
                operands.push(solved.map(konst => ({ id: 0, konst })))
            }
            if (operands.length !== apps.length) continue

            const wanted = varying.map(j => operandType(g, shape, j))
            const reuse = varying.map((_, v) => target.params.findIndex((param, p) => p !== at && typeOf(g.nodes.get(param)!) === wanted[v] && operands.every((o, i) => {
                const id = getRef(apps[i], p + 1)
                return id ? id === o[v].id : !o[v].id && getLiteral(apps[i], p + 1) === o[v].konst
            })))
            const extra = varying.map((_, v) => v).filter(v => reuse[v] < 0)
            if (extra.length > 1) continue
            const slots = varying.map((_, v) => reuse[v] < 0 ? addParam(wanted[v]) : target.params[reuse[v]])
            const compare = addNode(op, [0, 1].map(j => fixed[j] === undefined ? slots[varying.indexOf(j)] : { literal: fixed[j] }), shape)
            const replaced = target.params[at]
            const edits = new Map<number, Map<number, number>>()
            for (let i = 0; i < apps.length; i++) {
                const next = getOperands(apps[i])
                next[at + 1] = extra.length ? operands[i][extra[0]].id || { literal: operands[i][extra[0]].konst } : 0
                for (const v of extra.slice(1)) next.push(operands[i][v].id || { literal: operands[i][v].konst })
                const [from, id] = inbound[i]
                let r = edits.get(from)
                if (!r) edits.set(from, r = new Map())
                r.set(id, addNode('apply', next, apps[i]))
            }
            for (const [from, r] of edits) {
                const b = getGraphBlock(from)
                b.bodyId = replaceAll(b.bodyId, r)
                if (b !== target) revisitBlock(b)
            }
            const params = target.params.slice()
            params[at] = extra.length ? slots[extra[0]] : paramLike(target.params[at])
            params.push(...extra.slice(1).map(v => slots[v]))
            target.params = params
            target.bodyId = replaceAll(target.bodyId, new Map([[replaced, compare]]))
            revisitBlock(target)
            absorbConditions(target)
            return true
        }
        return false
    }

    let ranges: RangeFacts | undefined
    let rangesEpoch = -1
    function currentRanges(): RangeFacts {
        if (!ranges || rangesEpoch !== graphEpoch) {
            const tails = new Map<number, TailPosition[]>()
            const tailsOf = (block: number) => {
                let list = tails.get(block)
                if (!list) tails.set(block, list = tailPositions(g, getGraphBlock(block).bodyId))
                return list
            }
            ranges = rangeFacts(g, id => findInboundApplies(getGraphBlock(id)).map(([from, app]) => tailsOf(from).find(p => p.at === app)!))
            rangesEpoch = graphEpoch
        }
        return ranges
    }

    let mem: MemAnalysis | undefined
    let memEpoch = -1
    function currentMem(): MemAnalysis {
        if (!mem || memEpoch !== graphEpoch) {
            mem = memAnalysis(g, b => findInboundApplies(b).map(x => x[1]), id => dependents.get(id) ?? [])
            memEpoch = graphEpoch
        }
        return mem
    }
    function stateAt(block: GraphBlock, app: number): number | undefined {
        let found: number[] | undefined
        let agree = true
        function walk(id: number, path: number[]): void {
            const n = g.nodes.get(id)
            if (!n) return
            if (id === app) {
                const tokens = [...new Set(path)].sort((a, b) => a - b)
                if (!found) found = tokens
                else if (found.length !== tokens.length || found.some((t, i) => t !== tokens[i])) agree = false
                return
            }
            if (n.op === 'after') {
                const last = countIds(n) - 1
                const next = path.slice()
                for (let i = 0; i < last; i++) if (getRef(n, i)) next.push(getRef(n, i))
                walk(getRef(n, last), next)
            } else if (n.op === 'select') {
                walk(getRef(n, 1), path)
                walk(getRef(n, 2), path)
            }
        }
        walk(block.bodyId, [])
        if (!found || !agree) return
        const tokens = new Set(found)
        for (const t of [...tokens]) if (isNilOrVoid(t)) tokens.delete(t)
        if (!tokens.size) return addNode('nil-effect', [])
        if (tokens.size === 1) return [...tokens][0]
        return addNode('after', [...tokens])
    }
    function quietAnchor(id: number, load: GraphNode): boolean {
        for (const u of dependents.get(id) ?? []) if (!usesForResult(u, id)) return false
        return quietSince(getRef(load, 0), load)
    }
    function quietSince(token: number, load: GraphNode): boolean {
        return writerOf(token, load) === 'quiet'
    }
    function seedReanchored(id: number, relaxed: Set<number>, replacements: Map<number, number>, seen = new Set<number>()): void {
        if (!id || seen.has(id) || replacements.has(id)) return
        seen.add(id)
        const n = g.nodes.get(id)
        if (!n || n.op === 'param') return
        for (let i = n.op === 'load' ? 1 : 0; i < countIds(n); i++) seedReanchored(getRef(n, i), relaxed, replacements, seen)
        if (!relaxed.has(id)) return
        const operands = getOperands(n)
        operands[0] = addNode('nil-effect', [])
        replacements.set(id, replaceAll(insert(copyNode(n, operands)), replacements))
    }
    function sameOperand(a: GraphNode, b: GraphNode, i: number): boolean {
        if (getRef(a, i) && getRef(a, i) === getRef(b, i)) return true
        const x = scalarOperand(g.nodes, a, i)
        return x !== undefined && x === scalarOperand(g.nodes, b, i)
    }
    const sameLocation = (a: GraphNode, b: GraphNode) => sameOperand(a, b, 1) && sameOperand(a, b, 2)
    const bits = (n: GraphNode) => intrinsics.intrinsicBitWidth(typeOf(n))
    type Writer = number | 'quiet' | undefined
    function writerOf(token: number, access: GraphNode, stop?: Set<number>): Writer {
        const memo = new Map<number, Writer>()
        function walk(t: number): Writer {
            if (isNilOrVoid(t) || stop?.has(t)) return 'quiet'
            if (memo.has(t)) return memo.get(t)
            memo.set(t, undefined)
            const m = g.nodes.get(t)
            let result: Writer
            if (!m || m.op === 'param' || m.op === 'block' || m.op === 'select') result = undefined
            else if (m.op === 'load' || m.op === 'pstack') result = walk(getRef(m, 0))
            else if (m.op === 'call') result = mem!.clobbers(t, access) ? undefined : walk(getRef(m, 0))
            else if (m.op === 'store') {
                result = sameLocation(m, access) && bits(m) === bits(access) ? t
                    : mem!.disjoint(access, m) ? walk(getRef(m, 0)) : undefined
            } else if (OrderedValues.has(m.op)) result = undefined
            else {
                result = 'quiet'
                for (let i = 0; i < countIds(m) && result !== undefined; i++) {
                    const part = walk(getRef(m, i))
                    if (part === undefined) result = undefined
                    else if (part === 'quiet' || part === result) continue
                    else if (result === 'quiet' || precedes(result, part)) result = part
                    else if (!precedes(part, result)) result = undefined
                }
            }
            memo.set(t, result)
            return result
        }
        return walk(token)
    }
    function arrivingLoad(from: GraphBlock, app: number, load: GraphNode, base: number): number | undefined {
        if (!base) return
        const positions = tailPositions(g, from.bodyId).filter(p => p.at === app)
        for (const id of findValues(from.id, 'load') ?? []) {
            const m = g.nodes.get(id)!
            if (!isNilOrVoid(getRef(m, 0)) || getRef(m, 1) !== base || getRef(m, 2) || getLiteral(m, 2) !== getLiteral(load, 2) || typeOf(m) !== typeOf(load)) continue
            const stop = new Set(from.params)
            for (const p of positions) for (const root of tailRoots(g, p)) for (const effect of guaranteed(root)) if (writerOf(effect, m, stop) !== 'quiet') return
            return positions.length ? id : undefined
        }
    }
    function writesBefore(root: number, stop: Set<number>): boolean {
        const seen = new Set<number>()
        const stack = [root]
        while (stack.length) {
            const t = stack.pop()!
            if (!t || seen.has(t) || stop.has(t)) continue
            seen.add(t)
            const m = g.nodes.get(t)
            if (!m || m.op === 'param' || m.op === 'block' || m.op === 'nil-effect' || m.op === 'void') continue
            if (m.op === 'store' || m.op === 'pstack' || m.op === 'rt' || m.op === 'alloca') return true
            if (m.op === 'call' && callEffect(m) > 1) return true
            for (let i = 0; i < countIds(m); i++) stack.push(getRef(m, i))
        }
        return false
    }
    function dependsOn(root: number, id: number, from: GraphBlock): boolean {
        const params = new Set(from.params)
        const seen = new Set<number>()
        const stack = [root]
        while (stack.length) {
            const x = stack.pop()!
            if (x === id) return true
            if (!x || seen.has(x) || params.has(x)) continue
            seen.add(x)
            const n = g.nodes.get(x)
            if (n && n.op !== 'block') for (let k = 0; k < countIds(n); k++) stack.push(getRef(n, k))
        }
        return false
    }
    function arrivingCall(from: GraphBlock, app: GraphNode, appId: number, call: GraphNode, target: GraphBlock): number | undefined {
        const expected: Operand[] = []
        for (let k = 2; k < countIds(call); k++) {
            const ref = getRef(call, k)
            expected.push(ref ? getOperand(app, target.params.indexOf(ref) + 1) : { literal: getLiteral(call, k) })
        }
        let positions: TailPosition[] | undefined
        for (const id of findValues(from.id, 'call') ?? []) {
            const m = g.nodes.get(id)!
            if (getRef(m, 1) !== getRef(call, 1) || countIds(m) !== countIds(call)) continue
            let same = true
            for (let k = 2; k < countIds(m) && same; k++) {
                const want = expected[k - 2]
                same = typeof want === 'number' ? getRef(m, k) === want : !getRef(m, k) && getLiteral(m, k) === want.literal
            }
            if (!same) continue
            positions ??= tailPositions(g, from.bodyId).filter(p => p.at === appId)
            if (!positions.length) return
            const stop = new Set<number>(from.params)
            const pending = [id]
            while (pending.length) {
                const x = pending.pop()!
                if (!x || stop.has(x)) continue
                stop.add(x)
                const n = g.nodes.get(x)
                if (n && n.op !== 'block') for (let k = 0; k < countIds(n); k++) pending.push(getRef(n, k))
            }
            let quiet = true
            for (const p of positions) {
                if (!tailRoots(g, p).some(root => dependsOn(root, id, from))) quiet = false
                for (const root of tailRoots(g, p)) if (quiet && writesBefore(root, stop)) quiet = false
            }
            if (quiet) return id
        }
    }
    function forwardArrivalCalls(target: GraphBlock): boolean {
        const calls = findValues(target.id, 'call')
        if (!calls || target === g.blocks[0] || workingParams(target) >= maxLoopParams) return false
        const inbound = findInboundApplies(target)
        if (inbound.length < 1 || inbound.some(([from]) => from === target.id)) return false
        for (const id of calls) {
            const call = g.nodes.get(id)!
            if (callEffect(call) > 1) continue
            let local = true
            for (let k = 2; k < countIds(call) && local; k++) local = !getRef(call, k) || target.params.includes(getRef(call, k))
            if (!local || writesBefore(getRef(call, 0), new Set(target.params))) continue
            const values: number[] = []
            for (const [from, app] of inbound) {
                const value = arrivingCall(getGraphBlock(from), g.nodes.get(app)!, app, call, target)
                if (value === undefined) break
                values.push(value)
            }
            if (values.length < inbound.length) continue
            const edits = new Map<number, Map<number, number>>()
            inbound.forEach(([from, app], i) => {
                const n = g.nodes.get(app)!
                if (!edits.has(from)) edits.set(from, new Map())
                edits.get(from)!.set(app, addNode('apply', [...getOperands(n), values[i]!], n))
            })
            for (const [from, r] of edits) {
                const b = getGraphBlock(from)
                b.bodyId = replaceAll(b.bodyId, r)
                revisitBlock(b)
            }
            const param = addParam(resultType(g, call))
            target.params.push(param)
            liveParams = undefined
            target.bodyId = replaceAll(target.bodyId, new Map([[id, param]]))
            revisitBlock(target)
            return true
        }
        return false
    }
    function forwardArrivalLoads(target: GraphBlock): boolean {
        if (target === g.blocks[0] || workingParams(target) >= maxLoopParams) return false
        const inbound = findInboundApplies(target)
        if (inbound.length < 2 || inbound.some(([from]) => from === target.id)) return false
        currentMem()
        for (const id of findValues(target.id, 'load') ?? []) {
            const load = g.nodes.get(id)!
            const at = target.params.indexOf(getRef(load, 1))
            if (!isNilOrVoid(getRef(load, 0)) || at < 0 || getRef(load, 2)) continue
            const values = inbound.map(([from, app]) => arrivingLoad(getGraphBlock(from), app, load, tailOf(g, getRef(g.nodes.get(app)!, at + 1))))
            if (values.some(v => v === undefined)) continue
            const edits = new Map<number, Map<number, number>>()
            inbound.forEach(([from, app], i) => {
                const n = g.nodes.get(app)!
                if (!edits.has(from)) edits.set(from, new Map())
                edits.get(from)!.set(app, addNode('apply', [...getOperands(n), values[i]!], n))
            })
            for (const [from, r] of edits) {
                const b = getGraphBlock(from)
                b.bodyId = replaceAll(b.bodyId, r)
                revisitBlock(b)
            }
            const param = addParam(typeOf(load))
            target.params.push(param)
            target.bodyId = replaceAll(target.bodyId, new Map([[id, param]]))
            revisitBlock(target)
            return true
        }
        return false
    }
    function forwardMemory(target: GraphBlock): boolean {
        currentMem()

        function stored(store: GraphNode, load: GraphNode): number {
            const value = getRef(store, 3)
            const constant = scalarOperand(g.nodes, store, 3)
            const width = bits(load)
            if (constant !== undefined && typeOf(load) === Types.f64) return insert(makeNode('literal', [{ literal: constant }], Types.f64))
            if (constant !== undefined && (width === 64 || !lowering.isSignedType(typeOf(load)))) {
                return addNode('literal', [{ literal: width === 64 ? constant : constant % 2 ** width }])
            }
            const source = g.nodes.get(value)
            if (value && (width === 64 || (source?.op === 'load' && typeOf(source) === typeOf(load)))) return value
            return insert(makeNode('convert', [value || { literal: constant ?? 0 }], typeOf(load)))
        }
        
        const arrivals = new Map<number, GraphNode | undefined>()
        function soleArrival(block: GraphBlock): GraphNode | undefined {
            if (block === g.blocks[0]) return
            if (!arrivals.has(block.id)) {
                const inbound = findInboundApplies(block)
                arrivals.set(block.id, inbound.length === 1 ? g.nodes.get(inbound[0][1]) : undefined)
            }
            return arrivals.get(block.id)
        }
        const r = new Map<number, number>()
        const forwarded = new Map<number, number>()
        for (const id of findValues(target.id, 'load') ?? []) {
            const load = g.nodes.get(id)!
            const writer = writerOf(getRef(load, 0), load)
            if (typeof writer !== 'number') continue
            r.set(id, getRef(load, 0) || nil())
            forwarded.set(id, stored(g.nodes.get(writer)!, load))
        }
        function removedStore(store: GraphNode): number {
            return getRef(store, 0) || addNode('nil-effect', [])
        }
        function redundant(store: GraphNode): boolean {
            const writer = writerOf(getRef(store, 0), store)
            const w = typeof writer === 'number' ? g.nodes.get(writer)! : undefined
            if (w && bits(w) === bits(store) && sameOperand(w, store, 3)) return true
            let value = getRef(store, 3)
            for (let m = g.nodes.get(value); m?.op === 'after'; m = g.nodes.get(value)) value = getRef(m, countIds(m) - 1)
            const loaded = g.nodes.get(value)
            if (loaded?.op !== 'load' || !sameLocation(loaded, store) || typeOf(loaded) !== typeOf(store)) return false
            return (writer !== undefined && writerOf(getRef(loaded, 0), loaded) === writer) || writerOf(getRef(store, 0), store, new Set([value, getRef(loaded, 0)])) === 'quiet'
        }
        if (!r.size) {
            for (const id of findValues(target.id, 'store') ?? []) {
                const store = g.nodes.get(id)!
                if (redundant(store)) {
                    r.set(id, removedStore(store))
                    break
                }
            }
        }
        function overwritten(id: number, store: GraphNode): boolean {
            const kills = new Set<number>()
            let budget = 512
            const seen = new Set<number>([id])
            const pending: [node: number, from: number][] = []
            function reach(node: number, from: number): void {
                if (seen.has(node)) return
                seen.add(node)
                pending.push([node, from])
            }
            function afterKill(node: number): boolean {
                if (!kills.size) return false
                const stack = [node]
                const visited = new Set<number>()
                let steps = 128
                while (stack.length) {
                    const at = stack.pop()!
                    if (kills.has(at)) return true
                    if (at === id || visited.has(at) || --steps < 0) continue
                    visited.add(at)
                    const n = g.nodes.get(at)
                    if (n && n.op !== 'select') for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) stack.push(getRef(n, i))
                }
                return false
            }
            function users(node: number): void {
                for (const user of dependents.get(node) ?? []) reach(user, node)
            }
            function enter(apply: GraphNode): boolean {
                const block = getBlock(g, getRef(apply, 0))
                if (!block || soleArrival(block) !== apply) return false
                for (let i = 1; i < countIds(apply); i++) if (seen.has(getRef(apply, i))) reach(block.params[i - 1], 0)
                for (const op of ['load', 'store', 'call', 'pstack', 'alloca', 'after']) {
                    for (const entry of findValues(block.id, op) ?? []) {
                        if (g.nodes.get(getRef(g.nodes.get(entry)!, 0))?.op === 'nil-effect') reach(entry, 0)
                    }
                }
                return true
            }
            users(id)
            while (pending.length) {
                let next = 0
                for (let i = 1; i < pending.length; i++) if (pending[i][0] < pending[next][0]) next = i
                const [node, from] = pending[next]
                pending[next] = pending[pending.length - 1]
                pending.pop()
                if (--budget < 0) return false
                const n = g.nodes.get(node)
                if (!n || afterKill(node)) continue
                if (n.op === 'store') {
                    if (mem!.covers(n, store)) {
                        kills.add(node)
                        continue
                    }
                    users(node)
                    continue
                }
                if (n.op === 'load') {
                    if (!mem!.disjoint(n, store)) return false
                    users(node)
                    continue
                }
                if (n.op === 'after') {
                    let sequenced = getRef(n, countIds(n) - 1)
                    for (let m = g.nodes.get(sequenced); m?.op === 'after'; m = g.nodes.get(sequenced)) sequenced = getRef(m, countIds(m) - 1)
                    const value = g.nodes.get(sequenced)
                    if (sequenced !== from && value && !isUnordered(sequenced)) {
                        if (value.op === 'load') {
                            if (!mem!.disjoint(value, store)) return false
                        } else if (value.op === 'apply') {
                            if (!enter(value)) return false
                        } else if (value.op === 'select') {
                            for (const p of tailPositions(g, sequenced)) {
                                const tail = g.nodes.get(p.at)!
                                if (tail.op === 'apply' ? !enter(tail) : tail.op !== 'unreachable') return false
                            }
                        } else if (value.op !== 'pstack' && value.op !== 'alloca' && !PureOps.has(value.op)) {
                            return false
                        }
                    }
                    users(node)
                    continue
                }
                if (n.op === 'apply') {
                    if (!enter(n)) return false
                    continue
                }
                if (n.op === 'select') {
                    if (getRef(n, 0) === from) return false
                    continue
                }
                if (n.op === 'param' || n.op === 'pstack' || n.op === 'alloca' || PureOps.has(n.op)) {
                    users(node)
                    continue
                }
                return false
            }
            return kills.size > 0
        }
        if (!r.size) {
            for (const id of findValues(target.id, 'store') ?? []) {
                const store = g.nodes.get(id)!
                if (overwritten(id, store)) r.set(id, removedStore(store))
            }
        }
        if (!r.size) return false
        function resolve(id: number, value: boolean): number {
            let at = id
            for (let next = value ? forwarded.get(at) ?? r.get(at) : r.get(at); next !== undefined; next = value ? forwarded.get(at) ?? r.get(at) : r.get(at)) at = next
            return at
        }
        for (const id of r.keys()) {
            for (const u of [...(dependents.get(id) ?? [])]) {
                const n = g.nodes.get(u)
                if (!n || r.has(u)) continue
                const operands = getOperands(n)
                let edited = false
                for (let i = 0; i < countIds(n); i++) {
                    if (!r.has(getRef(n, i))) continue
                    const ordering = i < firstNonOrderingSlot(n)
                    operands[i] = resolve(getRef(n, i), !ordering)
                    edited = true
                }
                if (edited) g.nodes.set(u, copyNode(n, operands))
            }
        }
        revisitBlock(target)
        forwardMemory(target)
        return true
    }

    const unpromotable = new Set<string>()
    function allocations(block: number): number[] {
        return [...(findValues(block, 'alloca') ?? []), ...(findValues(block, 'pstack') ?? [])]
    }

    function promoteAllocas(target: GraphBlock): boolean {
        const found = allocations(target.id)
        if (!found.length) return false
        const keys = new Map<number, string | undefined>()
        function keyOf(id: number): string | undefined {
            if (keys.has(id)) return keys.get(id)
            const n = g.nodes.get(id)
            let key: string | undefined
            if (n?.op === 'pstack' && !getRef(n, 2) && !getLiteral(n, 2)) key = `pstack:${id}`
            if (n?.op === 'alloca' && !getRef(n, 1) && !getRef(n, 2)) key = `alloca:${id}`
            keys.set(id, key)
            return key
        }
        let changed = false
        for (const id of found) {
            const key = keyOf(id)
            if (key === undefined || unpromotable.has(key)) continue
            if (promoteAlloca(key, keyOf)) changed = true
            else unpromotable.add(key)
        }
        return changed
    }

    function promoteAlloca(key: string, keyOf: (id: number) => string | undefined): boolean {
        const ids = new Set<number>()
        const touched = new Set<GraphBlock>()
        for (const b of reachableBlocks) {
            for (const a of allocations(b.id)) {
                if (keyOf(a) !== key) continue
                ids.add(a)
                touched.add(b)
            }
        }
        function tokenUse(n: GraphNode, a: number): boolean {
            if (g.nodes.get(a)!.op !== 'pstack') return false
            if (n.op === 'after') return getRef(n, countIds(n) - 1) !== a
            if (!OrderedValues.has(n.op) || getRef(n, 0) !== a) return false
            for (let i = 1; i < countIds(n); i++) {
                if (getRef(n, i) === a && !(i === 1 && (n.op === 'load' || n.op === 'store'))) return false
            }
            return true
        }
        const slotTypes = new Map<number, (typeof Types)[keyof typeof Types]>()
        const mem = currentMem()
        const aliases = new Map<number, number>()
        const pointerSlots = new Map<number, Set<number>>()
        const pending: number[] = []
        function alias(id: number): boolean {
            if (aliases.has(id)) return true
            const m = mem.of(id)
            if (!ids.has(m.base) || m.pos === undefined) return false
            aliases.set(id, m.pos)
            pending.push(id)
            return true
        }
        for (const a of ids) if (!alias(a)) return false
        while (pending.length) {
            const a = pending.pop()!
            const base = aliases.get(a)!
            for (const u of dependents.get(a) ?? []) {
                const n = g.nodes.get(u)!
                if (n.op === 'alloca' && getRef(n, 0) === a) continue
                const pointer = (n.op === 'load' || n.op === 'store') && getRef(n, 1) === a
                if (!pointer && tokenUse(n, a)) continue
                if (n.op === 'add') {
                    if (!alias(u)) return false
                    continue
                }
                if (n.op === 'apply') {
                    const target = getBlock(g, getRef(n, 0))
                    if (!target || target === g.blocks[0]) return false
                    for (let i = 1; i < countIds(n); i++) {
                        if (getRef(n, i) !== a) continue
                        if (!alias(target.params[i - 1])) return false
                        const slots = pointerSlots.get(target.id)
                        if (slots) slots.add(i - 1)
                        else pointerSlots.set(target.id, new Set([i - 1]))
                    }
                    continue
                }
                if (!pointer || getRef(n, 2)) return false
                if (n.op === 'store' && getRef(n, 3) === a) return false
                const offset = base + getLiteral(n, 2)
                const known = slotTypes.get(offset)
                if (known !== undefined && known !== typeOf(n)) return false
                slotTypes.set(offset, typeOf(n))
            }
        }
        for (const block of pointerSlots.keys()) {
            for (const from of preds.get(block) ?? []) touched.add(getGraphBlock(from))
        }
        const slots = [...slotTypes].sort((x, y) => x[0] - y[0])
        for (let i = 1; i < slots.length; i++) {
            if (slots[i - 1][0] + intrinsics.intrinsicBitWidth(slots[i - 1][1]) / 8 > slots[i][0]) return false
        }
        const loads: [GraphBlock, number][] = []
        const stores = new Set<number>()
        for (const b of reachableBlocks) {
            for (const id of findValues(b.id, 'load') ?? []) {
                if (!aliases.has(getRef(g.nodes.get(id)!, 1))) continue
                loads.push([b, id])
                touched.add(b)
            }
            for (const id of findValues(b.id, 'store') ?? []) {
                if (!aliases.has(getRef(g.nodes.get(id)!, 1))) continue
                stores.add(id)
                touched.add(b)
            }
        }

        function tailTokens(n: GraphNode, tokens: number[]): number[] {
            const next = tokens.slice()
            for (let i = 0; i < countIds(n) - 1; i++) if (getRef(n, i)) next.push(getRef(n, i))
            return next
        }
        function tailApplies(b: GraphBlock, visit: (app: number, tokens: number[]) => boolean): boolean {
            function walk(id: number, tokens: number[]): boolean {
                const n = g.nodes.get(id)
                if (!n) return true
                if (n.op === 'after') return walk(getRef(n, countIds(n) - 1), tailTokens(n, tokens))
                if (n.op === 'select') return walk(getRef(n, 1), tokens) && walk(getRef(n, 2), tokens)
                if (n.op === 'apply') return visit(id, tokens)
                return true
            }
            return walk(b.bodyId, [])
        }

        const entries = new Map<string, number>()
        const added = new Map<number, number[]>()
        function entryValue(b: GraphBlock, offset: number): [number, number] | undefined {
            if (b === g.blocks[0]) return
            const at = `${b.id}:${offset}`
            const known = entries.get(at)
            if (known !== undefined) return [known, 0]
            const param = addParam()
            entries.set(at, param)
            const list = added.get(b.id)
            if (list) list.push(offset)
            else added.set(b.id, [offset])
            for (const from of preds.get(b.id) ?? []) {
                const pred = getGraphBlock(from)
                const seen = new Set<number>()
                const ok = tailApplies(pred, (app, tokens) => {
                    const n = g.nodes.get(app)!
                    if (getRef(n, 0) !== b.id) return true
                    seen.add(app)
                    for (let i = 1; i < countIds(n); i++) if (carriesStore(getRef(n, i))) return false
                    return !!valueAfter(pred, [...tokens, app], offset)
                })
                if (!ok) return
                for (const app of findValues(pred.id, 'apply') ?? []) {
                    if (getRef(g.nodes.get(app)!, 0) === b.id && !seen.has(app)) return
                }
            }
            return [param, 0]
        }

        function carriesStore(id: number): boolean {
            const n = g.nodes.get(id)
            if (!n) return false
            if (n.op === 'store') return aliases.has(getRef(n, 1))
            if (n.op !== 'after') return false
            for (let i = 0; i < countIds(n); i++) if (carriesStore(getRef(n, i))) return true
            return false
        }

        const storedValues = new Map<number, [number, number]>()
        function storedValue(id: number, store: GraphNode): [number, number] {
            const known = storedValues.get(id)
            if (known) return known
            const T = typeOf(store)
            const ref = getRef(store, 3)
            const literal = ref ? 0 : getLiteral(store, 3)
            const value: [number, number] = intrinsics.intrinsicBitWidth(T) === 64 ? [ref, literal]
                : [insert(makeNode('convert', [ref || { literal }], T)), 0]
            storedValues.set(id, value)
            return value
        }

        type Found = [number, number] | 'entry' | undefined
        const memo = new Map<string, Found>()
        function search(b: GraphBlock, token: number, offset: number): Found {
            const at = `${b.id}:${token}:${offset}`
            if (memo.has(at)) return memo.get(at)
            const result = findStore(b, token, offset)
            memo.set(at, result)
            return result
        }
        function findStore(b: GraphBlock, token: number, offset: number): Found {
            for (;;) {
                if (!token || isUnordered(token)) return 'entry'
                const n = g.nodes.get(token)
                if (!n) return
                if (n.op === 'nil-effect' || n.op === 'param' || n.op === 'block') return 'entry'
                if (n.op === 'store' && aliases.get(getRef(n, 1)) === offset - getLiteral(n, 2)) {
                    return storedValue(token, n)
                }
                let chain = OrderedValues.has(n.op)
                for (let i = 1; chain && i < countIds(n); i++) chain = isUnordered(getRef(n, i))
                if (chain) {
                    token = getRef(n, 0)
                    continue
                }
                const refs: number[] = []
                for (let i = 0; i < countIds(n); i++) refs.push(getRef(n, i))
                return join(b, refs, offset)
            }
        }
        function join(b: GraphBlock, tokens: number[], offset: number): Found {
            let result: Found = 'entry'
            for (const token of tokens) {
                if (!token || isUnordered(token)) continue
                const found = search(b, token, offset)
                if (found === undefined) return
                if (found === 'entry') continue
                if (result !== 'entry' && (result[0] !== found[0] || result[1] !== found[1])) return
                result = found
            }
            return result
        }
        function valueAfter(b: GraphBlock, tokens: number[], offset: number): [number, number] | undefined {
            const found = join(b, tokens, offset)
            return found === 'entry' ? entryValue(b, offset) : found
        }
        function valueFrom(b: GraphBlock, token: number, offset: number): [number, number] | undefined {
            return valueAfter(b, [token], offset)
        }

        const values = new Map<number, [number, number]>()
        for (const [b, id] of loads) {
            const load = g.nodes.get(id)!
            const value = valueFrom(b, getRef(load, 0), aliases.get(getRef(load, 1))! + getLiteral(load, 2))
            if (!value) return false
            values.set(id, value)
        }

        for (const [block, offsets] of added) {
            const b = getGraphBlock(block)
            for (const offset of offsets) b.params.push(entries.get(`${block}:${offset}`)!)
            touched.add(b)
            for (const from of preds.get(block) ?? []) touched.add(getGraphBlock(from))
        }
        const replaced = new Map<number, number>()
        function replacement(id: number): number {
            const known = replaced.get(id)
            if (known !== undefined) return known
            const n = g.nodes.get(id)
            if (!n) return id
            let result = id
            if (stores.has(id) || (ids.has(id) && n.op === 'pstack')) {
                result = getRef(n, 0) ? replacement(getRef(n, 0)) : addNode('nil-effect', [])
            } else if (values.has(id)) {
                const [ref, literal] = values.get(id)!
                result = addNode('after', [replacement(getRef(n, 0)), ref ? replacement(ref) : { literal }])
            }
            if (result !== id) replaced.set(id, result)
            return result
        }
        for (const id of stores) replacement(id)
        for (const id of values.keys()) replacement(id)
        for (const id of ids) replacement(id)

        function rewriteTail(b: GraphBlock): number {
            function walk(id: number, tokens: number[]): number {
                const n = g.nodes.get(id)
                if (!n) return id
                if (n.op === 'after') {
                    const last = countIds(n) - 1
                    const inner = walk(getRef(n, last), tailTokens(n, tokens))
                    if (inner === getRef(n, last)) return id
                    const argIds = cloneRefs(n)
                    argIds[last] = inner
                    return addNode('after', withRefs(n, argIds), n)
                }
                if (n.op === 'select') {
                    const yes = walk(getRef(n, 1), tokens)
                    const no = walk(getRef(n, 2), tokens)
                    if (yes === getRef(n, 1) && no === getRef(n, 2)) return id
                    const argIds = cloneRefs(n)
                    argIds[1] = yes
                    argIds[2] = no
                    return addNode('select', withRefs(n, argIds), n)
                }
                if (n.op !== 'apply') return id
                const offsets = added.get(getRef(n, 0))
                const pointers = pointerSlots.get(getRef(n, 0))
                if (!offsets && !pointers) return id
                const operands = getOperands(n)
                for (const i of pointers ?? []) operands[i + 1] = { literal: 0 }
                for (const offset of offsets ?? []) {
                    const [ref, literal] = valueAfter(b, [...tokens, id], offset)!
                    operands.push(ref || { literal })
                }
                return addNode('apply', operands, n)
            }
            return walk(b.bodyId, [])
        }
        const rewritten = new Map<number, number>()
        for (const b of touched) b.bodyId = replaceTransitive(rewriteTail(b), replaced, rewritten)
        for (const b of touched) revisitBlock(b)
        return true
    }

    function splitConstant(term: number): [term: number, offset: number] {
        const t = g.nodes.get(term)
        if (!t) return [term, 0]
        if (typeOf(t) === Types.f64) return [term, 0]
        if (t.op === 'add' || t.op === 'sub') {
            const right = scalarOperand(g.nodes, t, 1)
            const left = t.op === 'add' ? scalarOperand(g.nodes, t, 0) : undefined
            if (right !== undefined && left === undefined) {
                const [rest, offset] = splitConstant(getRef(t, 0))
                return [rest, offset + (t.op === 'add' ? right : -right)]
            }
            if (left !== undefined && right === undefined) {
                const [rest, offset] = splitConstant(getRef(t, 1))
                return [rest, offset + left]
            }
            return [term, 0]
        }
        const scaleAt = t.op === 'shl' ? 1
            : t.op === 'mul' ? (scalarOperand(g.nodes, t, 1) !== undefined ? 1 : 0) : -1
        if (scaleAt < 0 || operandType(g, t, 0) > Types.i64 || operandType(g, t, 1) > Types.i64) return [term, 0]
        const amount = scalarOperand(g.nodes, t, scaleAt)
        if (amount === undefined || scalarOperand(g.nodes, t, scaleAt ^ 1) !== undefined) return [term, 0]
        const [rest, offset] = splitConstant(getRef(t, scaleAt ^ 1))
        if (!offset) return [term, 0]
        const operands: Operand[] = [0, 0]
        operands[scaleAt ^ 1] = rest
        operands[scaleAt] = { literal: amount }
        return [addNode(t.op, operands, t), t.op === 'shl' ? offset * 2 ** amount : offset * amount]
    }

    function addConstant(value: [number, number], k: number): [number, number] {
        if (!value[0]) return [0, value[1] + k]
        const [rest, offset] = splitConstant(value[0])
        const shift = offset + k
        if (!shift) return [rest, 0]
        return [addNode(shift > 0 ? 'add' : 'sub', [rest, { literal: Math.abs(shift) }]), 0]
    }

    function applyArg(app: number, i: number): [number, number] {
        const n = g.nodes.get(app)!
        return [getRef(n, i + 1), getLiteral(n, i + 1)]
    }

    function withArg(app: number, i: number, value: [number, number]): number {
        const n = g.nodes.get(app)!
        const operands = getOperands(n)
        operands[i + 1] = value[0] || { literal: value[1] }
        return addNode('apply', operands, n)
    }

    function simplifyBitOperations(target: GraphBlock) {
        let changed = false
        const forwarded = new Map<number, number>()
        function foldOffset(id: number) {
            const n = g.nodes.get(id)!
            const scalar = scalarOperand(g.nodes, n, 2)
            const [term, split] = splitConstant(scalar === undefined ? getRef(n, 2) : 0)
            const offset = (scalar ?? 0) + split
            if (term === getRef(n, 2) || !Number.isSafeInteger(offset)) return
            for (const u of dependents.get(getRef(n, 2)) ?? []) {
                const op = g.nodes.get(u)?.op
                if (op !== 'load' && op !== 'store' && !foldSharedOffsets) return
            }
            const operands = getOperands(n)
            if (term && offset) {
                operands[1] = addNode('add', [getOperand(n, 1), term])
                operands[2] = { literal: offset }
            } else {
                operands[2] = term || { literal: offset }
            }
            g.nodes.set(id, copyNode(n, operands))
            changed = true
        }
        function foldTest(id: number) {
            const n = g.nodes.get(id)
            if (!n || countIds(n) < 2) return
            const valueAt = !getRef(n, 0) && getLiteral(n, 0) === 0 ? 1
                : !getRef(n, 1) && getLiteral(n, 1) === 0 ? 0 : -1
            if (valueAt < 0) return
            foldTest(getRef(n, valueAt))
            const inner = g.nodes.get(getRef(n, valueAt))
            if (!inner || !CompareOps.has(inner.op)) return
            if (n.op === 'eq' && comparesFloats(g, inner)) return
            const op = n.op === 'eq' ? InverseCompare[inner.op] : inner.op
            g.nodes.set(id, copyNode(inner, getOperands(inner), op))
            changed = true
        }
        for (const id of findValues(target.id, 'mul') ?? []) {
            const n = g.nodes.get(id)!
            if (typeOf(n) === Types.f64) continue
            const valueAt = getRef(n, 0) && !getRef(n, 1) ? 0
                : getRef(n, 1) && !getRef(n, 0) ? 1 : -1
            if (valueAt < 0) continue
            const shift = Math.log2(getLiteral(n, valueAt ^ 1))
            if (!Number.isSafeInteger(shift) || shift <= 0) continue
            changed = true
            g.nodes.set(id, copyNode(n, [getRef(n, valueAt), { literal: shift }], 'shl'))
        }
        for (const op of ['div', 'rem']) {
            for (const id of findValues(target.id, op) ?? []) {
                const n = g.nodes.get(id)!
                if (typeOf(n) === Types.f64 || !getRef(n, 0) || getRef(n, 1)) continue
                if (lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))) continue
                const divisor = getLiteral(n, 1)
                const shift = Math.log2(divisor)
                if (!Number.isSafeInteger(shift) || shift <= 0) continue
                changed = true
                g.nodes.set(id, op === 'div'
                    ? copyNode(n, [getRef(n, 0), { literal: shift }], 'ushr')
                    : copyNode(n, [getRef(n, 0), { literal: divisor - 1 }], 'and'))
            }
        }
        for (const id of findValues(target.id, 'load') ?? []) foldOffset(id)
        for (const id of findValues(target.id, 'store') ?? []) foldOffset(id)
        for (const id of findValues(target.id, 'eq') ?? []) foldTest(id)
        for (const id of findValues(target.id, 'ne') ?? []) foldTest(id)
        const sameOperand = (a: GraphNode, i: number, b: GraphNode, j: number) => getRef(a, i)
            ? getRef(a, i) === getRef(b, j)
            : !getRef(b, j) && getLiteral(a, i) === getLiteral(b, j)
        const wordOp = (n: GraphNode) => operandType(g, n, 0) <= Types.i64 && operandType(g, n, 1) <= Types.i64
        for (const id of findValues(target.id, 'add') ?? []) {
            const n = g.nodes.get(id)!
            if (!wordOp(n)) continue
            for (let i = 0; i < 2; i++) {
                const inner = g.nodes.get(getRef(n, i))
                if (!inner || inner.op !== 'sub' || !wordOp(inner)) continue
                if (!sameOperand(n, i ^ 1, inner, 1)) continue
                if (getRef(inner, 0)) forwarded.set(id, getRef(inner, 0))
                else g.nodes.set(id, copyNode(n, [{ literal: getLiteral(inner, 0) }, 0], 'add'))
                changed = true
                break
            }
        }
        for (const id of findValues(target.id, 'sub') ?? []) {
            const n = g.nodes.get(id)!
            const inner = g.nodes.get(getRef(n, 0))
            if (!wordOp(n) || !inner || inner.op !== 'add' || !wordOp(inner)) continue
            for (let j = 0; j < 2; j++) {
                if (!sameOperand(n, 1, inner, j)) continue
                if (getRef(inner, j ^ 1)) forwarded.set(id, getRef(inner, j ^ 1))
                else g.nodes.set(id, copyNode(n, [{ literal: getLiteral(inner, j ^ 1) }, 0], 'add'))
                changed = true
                break
            }
        }
        for (const id of findValues(target.id, 'and') ?? []) {
            const n = g.nodes.get(id)!
            const shiftAt = getRef(n, 0) ? 0 : getRef(n, 1) ? 1 : -1
            if (shiftAt < 0) continue
            const maskAt = shiftAt ^ 1
            if (getRef(n, maskAt)) continue
            const shiftId = getRef(n, shiftAt)
            const shift = g.nodes.get(shiftId)
            if (!shift || shift.op !== 'ushr' || getRef(shift, 1)) continue
            const width = Math.log2(getLiteral(n, maskAt) + 1)
            const U = width === 8 ? Types.u8 : width === 16 ? Types.u16 : width === 32 ? Types.u32 : undefined
            if (U === undefined) continue
            changed = true
            g.nodes.set(id, makeNode('convert', [shiftId], U))
        }
        for (const id of findValues(target.id, 'decode') ?? []) {
            const n = g.nodes.get(id)!
            const inner = g.nodes.get(getRef(n, 0))
            if (inner?.op !== 'encode' || getLiteral(inner, 1) !== getLiteral(n, 1)) continue
            forwarded.set(id, getRef(inner, 0))
            changed = true
        }
        const soleUser = (id: number, user: number) => {
            const users = dependents.get(id)
            return users?.size === 1 && users.has(user)
        }
        for (const id of findValues(target.id, 'convert') ?? []) {
            const n = g.nodes.get(id)!
            const U = typeOf(n)
            if (U !== Types.u8 && U !== Types.u16 && U !== Types.u32) continue
            let source = getRef(n, 0)
            let user = id
            let shift = 0
            const inner = g.nodes.get(source)
            if (inner?.op === 'ushr' && !getRef(inner, 1) && soleUser(source, id)) {
                user = source
                shift = getLiteral(inner, 1)
                source = getRef(inner, 0)
            }
            const load = g.nodes.get(source)
            if (load?.op !== 'load' || getRef(load, 2) || !soleUser(source, user)) continue
            const W = typeOf(load)
            if (W !== Types.u32 && W !== Types.u64) continue
            const bits = intrinsics.intrinsicBitWidth(U)
            if (shift % bits || shift + bits > intrinsics.intrinsicBitWidth(W)) continue
            const operands = getOperands(load)
            operands[2] = { literal: getLiteral(load, 2) + shift / 8 }
            g.nodes.set(id, makeNode('load', operands, U))
            changed = true
        }
        if (forwarded.size) target.bodyId = replaceAll(target.bodyId, forwarded)
        if (changed) revisitBlock(target)
        return changed
    }

    function reassociateAdds(target: GraphBlock): boolean {
        const adds = findValues(target.id, 'add')
        if (!adds || adds.length < 2) return false
        const depthOf = latencyDepth(g, costs)
        const leaves: number[] = []
        let constant = 0
        let T = Types.i64
        function chained(id: number): boolean {
            const n = g.nodes.get(id)
            return n?.op === 'add' && countIds(n) === 2 && typeOf(n) === T
        }
        function interior(id: number): boolean {
            const users = dependents.get(id)
            return chained(id) && users?.size === 1 && chained([...users][0])
        }
        function flatten(id: number): number {
            const n = g.nodes.get(id)!
            let d = 0
            for (let i = 0; i < 2; i++) {
                const k = scalarOperand(g.nodes, n, i)
                const ref = getRef(n, i)
                if (k !== undefined) constant += k
                else if (interior(ref)) d = Math.max(d, flatten(ref))
                else {
                    leaves.push(ref)
                    d = Math.max(d, depthOf(ref))
                }
            }
            return d + 1
        }
        let changed = false
        for (const root of adds) {
            const n = g.nodes.get(root)!
            T = typeOf(n)
            if (T > Types.i64 || !chained(root) || interior(root)) continue
            leaves.length = 0
            constant = 0
            const before = flatten(root)
            if (leaves.length < 2 || !Number.isSafeInteger(constant)) continue
            leaves.sort((a, b) => depthOf(a) - depthOf(b))
            let after = depthOf(leaves[0]) + (constant ? 1 : 0)
            for (let i = 1; i < leaves.length; i++) after = Math.max(after, depthOf(leaves[i])) + 1
            if (after >= before) continue
            let acc: Operand = constant ? addNode('add', [leaves[0], { literal: constant }], n) : leaves[0]
            for (let i = 1; i < leaves.length - 1; i++) acc = addNode('add', [acc, leaves[i]], n)
            g.nodes.set(root, copyNode(n, [acc, leaves[leaves.length - 1]]))
            changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    function hoistLoopStep(target: GraphBlock) {
        if (target === g.blocks[0] || !preds.get(target.id)?.has(target.id)) return false
        const inbound = findInboundApplies(target)
        const entries = inbound.filter(x => x[0] !== target.id)
        const backs = inbound.filter(x => x[0] === target.id).map(x => g.nodes.get(x[1])!)
        if (entries.length !== 1 || !backs.length) return false
        for (const [from, app] of inbound) {
            if (from !== target.id) continue
            for (const u of dependents.get(app) ?? []) if (g.nodes.get(u)?.op !== 'select') return false
        }
        const [entryBlock, entryApp] = entries[0]
        const params = target.params

        const stepOf = (back: GraphNode, i: number) => {
            const step = g.nodes.get(getRef(back, i + 1))
            if (!step || step.op !== 'add' || getRef(step, 0) !== params[i] || getRef(step, 1)) return
            for (const u of dependents.get(getRef(back, i + 1)) ?? []) {
                if (g.nodes.get(u)?.op !== 'apply' || getRef(g.nodes.get(u)!, 0) !== target.id) return
            }
            return getLiteral(step, 1)
        }
        for (let i = 0; i < params.length; i++) {
            const step = stepOf(backs[0], i)
            if (!step || step < 0) continue
            if (backs.some(back => stepOf(back, i) !== step)) continue
            if (backs.some(back => params.some((p, k) => k !== i && getRef(back, k + 1) !== p))) continue
            const start = applyArg(entryApp, i)
            if (!start[0] && start[1] < step) continue

            const previous = paramLike(params[i])
            const current = addNode('add', [previous, { literal: step }], g.nodes.get(getRef(backs[0], i + 1)))
            const replacements = new Map<number, number>([[params[i], current]])
            for (const [from, app] of inbound) {
                if (from === target.id) replacements.set(app, withArg(app, i, [current, 0]))
            }
            params[i] = previous
            target.bodyId = replaceAll(target.bodyId, replacements)

            const from = getGraphBlock(entryBlock)
            from.bodyId = replaceAll(from.bodyId, new Map([[entryApp, withArg(entryApp, i, addConstant(start, -step))]]))
            revisitBlock(from)
            revisitBlock(target)
            return true
        }
        return false
    }

    function rebaseShape(block: GraphBlock, base: number, offset: number) {
        if (block === g.blocks[0]) return
        const word = (n: GraphNode) => operandType(g, n, 0) <= Types.i64 && operandType(g, n, 1) <= Types.i64
        const addressed = (m: GraphNode | undefined, at: number) => !!m
            && (m.op === 'load' || m.op === 'store') && getRef(m, 1) === base && getRef(m, 2) === at
            && getRef(m, 0) !== at && (countIds(m) < 4 || getRef(m, 3) !== at)
        const shape = { pairs: [] as number[], offsets: [] as number[], direct: [] as number[], outbound: [] as number[] }
        for (const u of dependents.get(offset) ?? []) {
            const n = g.nodes.get(u)
            if (!n) return
            if (n.op === 'apply') {
                if (getRef(n, 0) === offset) return
                shape.outbound.push(u)
                continue
            }
            if (addressed(n, offset)) {
                shape.direct.push(u)
                continue
            }
            if (n.op !== 'add' || countIds(n) !== 2 || !word(n)) return
            const other = getRef(n, 0) === offset ? 1 : getRef(n, 1) === offset ? 0 : -1
            if (other < 0 || getRef(n, other) === offset) return
            if (getRef(n, other) === base) {
                shape.pairs.push(u)
                continue
            }
            for (const w of dependents.get(u) ?? []) {
                if (!addressed(g.nodes.get(w), u)) return
            }
            shape.offsets.push(u)
        }
        return shape
    }

    function rebaseAddresses(target: GraphBlock) {
        if (target === g.blocks[0]) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const params = target.params
        function cancels(base: [number, number], offset: [number, number]) {
            const t = g.nodes.get(offset[0])
            return !!base[0] && t?.op === 'sub' && getRef(t, 1) === base[0]
        }
        function combine(base: [number, number], offset: [number, number]): [number, number] {
            const t = g.nodes.get(offset[0])
            if (cancels(base, offset)) return [getRef(t!, 0), getLiteral(t!, 0)]
            if (!offset[0]) return addConstant(base, offset[1])
            const [rest, constant] = splitConstant(offset[0])
            return addConstant([addNode('add', [base[0] || { literal: base[1] }, rest]), 0], constant)
        }

        const candidates = new Map<string, [base: number, offset: number]>()
        const consider = (base: number, offset: number) => {
            const j = params.indexOf(base)
            const i = params.indexOf(offset)
            if (i >= 0 && j >= 0 && i !== j) candidates.set(`${j}:${i}`, [j, i])
        }
        for (const u of findValues(target.id, 'add') ?? []) {
            const n = g.nodes.get(u)!
            const a = getRef(n, 0)
            const b = getRef(n, 1)
            consider(a, b)
            consider(b, a)
            for (const w of dependents.get(u) ?? []) {
                const m = g.nodes.get(w)
                if ((m?.op === 'load' || m?.op === 'store') && getRef(m, 2) === u) {
                    consider(getRef(m, 1), a)
                    consider(getRef(m, 1), b)
                }
            }
        }
        for (const [j, i] of candidates.values()) {
            const pa = params[j]
            const pt = params[i]
            const shape = rebaseShape(target, pa, pt)
            if (!shape) continue
            const gain = shape.pairs.length + shape.offsets.length
            if (!gain) continue
            let cost = 0
            for (const u of shape.outbound) {
                const n = g.nodes.get(u)!
                const into = getRef(n, 0)
                const b = into === target.id ? target : getBlock(g, into)
                for (let k = 1; k < countIds(n); k++) {
                    if (getRef(n, k) !== pt) continue
                    if (b === target) {
                        if (k !== i + 1 || getRef(n, j + 1) !== pa) cost += 2
                        continue
                    }
                    let l = 1
                    while (l < countIds(n) && getRef(n, l) !== pa) l++
                    if (!b || l === countIds(n) || !rebaseShape(b, b.params[l - 1], b.params[k - 1])) cost++
                }
            }
            for (const [from, app] of inbound) {
                if (from === target.id) continue
                const base = applyArg(app, j)
                const offset = applyArg(app, i)
                if (cancels(base, offset)) continue
                const p = getGraphBlock(from)
                if (base[0] && offset[0] && p.params.includes(base[0]) && p.params.includes(offset[0])
                    && rebaseShape(p, base[0], offset[0])) continue
                cost++
            }
            if (cost > gain) continue

            const np = paramLike(pa)
            const back = addNode('sub', [np, pa])
            const byBlock = new Map<number, Map<number, number>>()
            for (const [from, app] of inbound) {
                if (from === target.id) continue
                let replacements = byBlock.get(from)
                if (!replacements) byBlock.set(from, replacements = new Map())
                replacements.set(app, withArg(app, i, combine(applyArg(app, j), applyArg(app, i))))
            }
            for (const [from, replacements] of byBlock) {
                const p = getGraphBlock(from)
                p.bodyId = replaceAll(p.bodyId, replacements)
                revisitBlock(p)
            }
            function readdress(id: number, offset: [number, number]) {
                const m = g.nodes.get(id)!
                const operands = getOperands(m)
                operands[1] = np
                operands[2] = offset[0] || { literal: offset[1] }
                g.nodes.set(id, copyNode(m, operands))
            }
            for (const u of shape.offsets) {
                const n = g.nodes.get(u)!
                const at = getRef(n, 0) === pt ? 1 : 0
                for (const w of dependents.get(u)!) readdress(w, [getRef(n, at), getLiteral(n, at)])
            }
            for (const u of shape.direct) readdress(u, [0, 0])
            for (const [from, app] of inbound) {
                if (from !== target.id) continue
                const n = g.nodes.get(app)!
                const operands = getOperands(n)
                const sum = getRef(n, i + 1) === pt && getRef(n, j + 1) === pa ? [np, 0]
                    : combine(applyArg(app, j), applyArg(app, i))
                operands[i + 1] = sum[0] || { literal: sum[1] }
                g.nodes.set(app, copyNode(n, operands))
            }
            const replacements = new Map<number, number>([[pt, back]])
            for (const u of shape.pairs) replacements.set(u, np)
            params[i] = np
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
        return false
    }

    function foldValues(target: GraphBlock) {
        type Value = { id: number, value: number }
        const folded = new Map<number, Value>()
        const epoch = nextEpoch(g)

        function operand(n: GraphNode, i: number): Value {
            const ref = getRef(n, i)
            if (!ref) return { id: 0, value: getLiteral(n, i) }
            const m = g.nodes.get(ref)
            if (m && FoldableOps.has(m.op)) return fold(ref, m)
            if (m?.op === 'literal' && inlineableLiteral(costs, literalValue(m))) return { id: 0, value: literalValue(m) }
            return { id: ref, value: 0 }
        }

        function fold(id: number, n: GraphNode): Value {
            const known = folded.get(id)
            if (known) return known
            if (!markVisited(n, epoch)) return { id, value: 0 }

            const args: Value[] = []
            for (let i = 0; i < countIds(n); i++) args.push(operand(n, i))

            let result: Value | undefined
            if (args.length === 2 && args.every(arg => !arg.id)
                && args[0].value >= 0 && args[1].value >= 0) {
                const a = args[0].value, b = args[1].value
                let folded: number | undefined
                if (n.op === 'add') folded = a + b
                else if (n.op === 'sub' && a >= b) folded = a - b
                else if (n.op === 'mul') folded = a * b
                else if (n.op === 'pow' && Number.isSafeInteger(a ** b)) folded = a ** b
                else if (n.op === 'lt') folded = a < b ? 1 : 0
                else if (n.op === 'le') folded = a <= b ? 1 : 0
                else if (n.op === 'gt') folded = a > b ? 1 : 0
                else if (n.op === 'ge') folded = a >= b ? 1 : 0
                else if (n.op === 'eq') folded = a === b ? 1 : 0
                else if (n.op === 'ne') folded = a !== b ? 1 : 0
                const small = a <= 0x7FFFFFFF && b <= 0x7FFFFFFF
                if (small && n.op === 'and') folded = a & b
                else if (small && n.op === 'or') folded = a | b
                else if (small && n.op === 'xor') folded = a ^ b
                else if (n.op === 'shl' && b < 32 && a * 2 ** b <= Number.MAX_SAFE_INTEGER) folded = a * 2 ** b
                else if ((n.op === 'shr' || n.op === 'ushr') && b < 64) folded = Math.floor(a / 2 ** b)
                const T = operandType(g, n, 0)
                if (folded !== undefined
                    && (T === Types.u64 || T === Types.u32) && operandType(g, n, 1) === T
                    && (T !== Types.u32 || (a <= 0xFFFFFFFF && b <= 0xFFFFFFFF && folded <= 0xFFFFFFFF))) {
                    result = { id: 0, value: folded }
                }
            }
            const floating = typeOf(n) === Types.f64 || comparesFloats(g, n)
            if (!result && !floating && args.length === 2 && args[0].id && args[0].id === args[1].id) {
                if (n.op === 'sub' || n.op === 'xor') result = { id: 0, value: 0 }
                else if (n.op === 'and' || n.op === 'or') result = args[0]
                else if (n.op === 'eq' || n.op === 'le' || n.op === 'ge') result = { id: 0, value: 1 }
                else if (n.op === 'ne' || n.op === 'lt' || n.op === 'gt') result = { id: 0, value: 0 }
            }
            if (!result && !floating && args.length === 2 && (n.op === 'add' || n.op === 'sub') && (chained(args[0]) || chained(args[1]))) result = linear(n, args)
            if (!result && !floating && args.length === 2 && CompareOps.has(n.op)
                && (!args[0].id || !args[1].id)) {
                const known = decideCompare(n, [args[0].id, args[0].id ? 0 : args[0].value], [args[1].id, args[1].id ? 0 : args[1].value], [])
                if (known !== undefined) result = { id: 0, value: known ? 1 : 0 }
            }
            if (!result && args.length === 2 && operandType(g, n, 0) <= Types.i64 && operandType(g, n, 1) <= Types.i64) {
                const left = (value: number) => !args[0].id && args[0].value === value
                const right = (value: number) => !args[1].id && args[1].value === value
                if (n.op === 'add' || n.op === 'or' || n.op === 'xor') {
                    if (right(0)) result = args[0]
                    else if (left(0)) result = args[1]
                } else if (n.op === 'sub' || n.op === 'shl' || n.op === 'shr' || n.op === 'ushr') {
                    if (right(0)) result = args[0]
                } else if (n.op === 'mul') {
                    if (right(1)) result = args[0]
                    else if (left(1)) result = args[1]
                } else if (n.op === 'div' && right(1)) result = args[0]
            }
            if (!result) {
                let unchanged = args.length === countIds(n)
                for (let i = 0; unchanged && i < args.length; i++) {
                    const prior = getRef(n, i)
                    if (args[i].id !== prior || (!prior && args[i].value !== getLiteral(n, i))) {
                        unchanged = false
                    }
                }
                result = unchanged ? { id, value: 0 }
                    : { id: addNode(n.op, args.map(arg => arg.id || { literal: arg.value }), n), value: 0 }
            }
            if (result.id !== id) folded.set(id, result)
            return result
        }

        function chained(v: Value): boolean {
            const m = v.id ? g.nodes.get(v.id) : undefined
            return !!m && (m.op === 'add' || m.op === 'sub') && countIds(m) === 2
        }

        function linear(n: GraphNode, args: Value[]): Value | undefined {
            const terms = new Map<number, number>()
            let constant = 0
            let owned = 0
            let count = 0
            function collect(v: Value, sign: number, depth: number): boolean {
                if (!v.id) {
                    constant += sign * v.value
                    return true
                }
                const m = g.nodes.get(v.id)
                if (m?.op === 'literal' && inlineableLiteral(costs, literalValue(m))) {
                    constant += sign * literalValue(m)
                    return true
                }
                if (depth < 4 && m && (m.op === 'add' || m.op === 'sub') && countIds(m) === 2) {
                    if ((dependents.get(v.id)?.size ?? 0) === 1) owned++
                    return collect({ id: getRef(m, 0), value: getLiteral(m, 0) }, sign, depth + 1)
                        && collect({ id: getRef(m, 1), value: getLiteral(m, 1) }, m.op === 'sub' ? -sign : sign, depth + 1)
                }
                terms.set(v.id, (terms.get(v.id) ?? 0) + sign)
                return ++count <= 8
            }
            if (!collect(args[0], 1, 0) || !collect(args[1], n.op === 'sub' ? -1 : 1, 0)) return
            if (!Number.isSafeInteger(constant)) return
            const survivors = [...terms].filter(([, c]) => c !== 0)
            if (survivors.some(([, c]) => c !== 1 && c !== -1)) return
            const pos = survivors.filter(([, c]) => c === 1).map(([id]) => id)
            const neg = survivors.filter(([, c]) => c === -1).map(([id]) => id)
            const ops = survivors.length === 0 ? 0 : survivors.length - (pos.length ? 1 : 0) + (constant !== 0 && pos.length ? 1 : 0)
            if (ops >= 1 + owned) return
            if (!survivors.length) return { id: 0, value: constant }
            const combine = (op: string, a: Value, b: Value): Value =>
                ({ id: addNode(op, [a.id || { literal: a.value }, b.id || { literal: b.value }], n), value: 0 })
            let acc: Value = pos.length ? { id: pos[0], value: 0 } : { id: 0, value: constant }
            for (const id of pos.slice(1)) acc = combine('add', acc, { id, value: 0 })
            for (const id of neg) acc = combine('sub', acc, { id, value: 0 })
            if (pos.length && constant > 0) acc = combine('add', acc, { id: 0, value: constant })
            if (pos.length && constant < 0) acc = combine('sub', acc, { id: 0, value: -constant })
            return acc
        }

        const replacements = new Map<number, number>()
        for (const op of FoldableOps) {
            for (const id of findValues(target.id, op) ?? []) {
                const result = fold(id, g.nodes.get(id)!)
                if (result.id === id) continue
                replacements.set(id, result.id || insert(literal(result.value)))
            }
        }
        if (!replacements.size) return false
        target.bodyId = replaceTransitive(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function reduceArg(id: number, subst: Map<number, [number, number]>): [number, number] | undefined {
        const n = g.nodes.get(id)
        if (!n) return
        if (n.op === 'param') return subst.get(id)
        if (!countIds(n)) return [id, 0]
        const compare = CompareOps.has(n.op)
        if ((!BinaryOps.has(n.op) && !compare) || operandType(g, n, 0) > Types.i64 || operandType(g, n, 1) > Types.i64) return
        const a = getRef(n, 0) ? reduceArg(getRef(n, 0), subst) : [0, getLiteral(n, 0)] as [number, number]
        const b = getRef(n, 1) ? reduceArg(getRef(n, 1), subst) : [0, getLiteral(n, 1)] as [number, number]
        if (!a || !b) return
        const is = (v: [number, number], k: number) => !v[0] && v[1] === k
        if (compare) {
            if (a[0] || b[0]) return
            return [0, CompareEval[n.op](a[1], b[1]) ? 1 : 0]
        }
        if (n.op === 'add' || n.op === 'or' || n.op === 'xor') {
            if (is(a, 0)) return b
            if (is(b, 0)) return a
        }
        if (n.op === 'sub' || n.op === 'shl' || n.op === 'shr' || n.op === 'ushr') {
            if (is(b, 0)) return a
        }
        if (n.op === 'mul' && is(a, 1)) return b
        if ((n.op === 'mul' || n.op === 'div') && is(b, 1)) return a
        return
    }

    function reduceBody(id: number, subst: Map<number, [number, number]>): GraphNode | undefined {
        const n = g.nodes.get(id)
        if (!n) return
        if (n.op === 'select') {
            const c = getRef(n, 0)
                ? reduceArg(getRef(n, 0), subst)
                : [0, getLiteral(n, 0)] as [number, number]
            if (!c || c[0]) return
            return reduceBody(getRef(n, c[1] ? 1 : 2), subst)
        }
        return n.op === 'apply' ? n : undefined
    }

    function substituteEqualArguments(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const slotOf = new Map<number, number>()
        for (let i = 0; i < target.params.length; i++) slotOf.set(target.params[i], i + 1)
        function closed(n: GraphNode): boolean {
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref || slotOf.has(ref)) continue
                const operand = g.nodes.get(ref)!
                for (let j = 0; j < countIds(operand); j++) if (getRef(operand, j)) return false
            }
            return true
        }
        const candidates = new Set<number>()
        for (const [op, ids] of byOp.get(target.id) ?? []) {
            for (const id of ids) {
                const n = g.nodes.get(id)
                if (!n || isArgless(n) || op === 'param') continue
                if (!isUnordered(op === 'load' ? getRef(n, 0) : id)) continue
                if (closed(n)) candidates.add(id)
            }
        }
        if (!candidates.size) return false
        const sites = findInboundApplies(target).map(([, app]) => g.nodes.get(app)!)
        if (!sites.length) return false
        function imageOf(n: GraphNode, site: GraphNode, arg: GraphNode): boolean {
            if (arg.op !== n.op || arg.flags !== n.flags || countIds(arg) !== countIds(n)) return false
            if (typeSlots(n.op) && (typeOf(arg) !== typeOf(n) || typeRefOf(arg) !== typeRefOf(n))) return false
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                const slot = ref ? slotOf.get(ref) : undefined
                const expected = slot === undefined ? ref : getRef(site, slot)
                if (getRef(arg, i) !== expected) return false
                if (!expected && getLiteral(arg, i) !== (slot === undefined ? getLiteral(n, i) : getLiteral(site, slot))) return false
            }
            return true
        }
        const replacements = new Map<number, number>()
        for (const id of candidates) {
            const n = g.nodes.get(id)!
            let options: number[] | undefined
            for (const site of sites) {
                const fits: number[] = []
                for (const slot of options ?? target.params.map((_, i) => i + 1)) {
                    const arg = getRef(site, slot)
                    if (arg && imageOf(n, site, g.nodes.get(arg)!)) fits.push(slot)
                }
                options = fits
                if (!fits.length) break
            }
            if (options?.length) replacements.set(id, target.params[options[0] - 1])
        }
        if (!replacements.size) return false
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function specializeApplySite(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const tail = g.nodes.get(target.bodyId)
        if (!tail || (tail.op !== 'apply' && tail.op !== 'select')) return false
        const inbound = findInboundApplies(target)
        if (inbound.length < 2) return false
        const byBlock = new Map<number, Map<number, number>>()
        for (const [blockId, appId] of inbound) {
            const app = g.nodes.get(appId)!
            if (countIds(app) !== target.params.length + 1) continue
            const subst = new Map<number, [number, number]>()
            let literal = false
            for (let i = 0; i < target.params.length; i++) {
                if (!getRef(app, i + 1)) literal = true
                subst.set(target.params[i], [getRef(app, i + 1), getLiteral(app, i + 1)])
            }
            if (!literal) continue
            const body = reduceBody(target.bodyId, subst)
            if (!body || getRef(body, 0) === target.id) continue
            const operands: Operand[] = [getRef(body, 0)]
            let ok = true
            for (let i = 1; i < countIds(body); i++) {
                const arg = getRef(body, i)
                if (!arg) {
                    operands.push({ literal: getLiteral(body, i) })
                    continue
                }
                const r = reduceArg(arg, subst)
                if (!r) { ok = false; break }
                operands.push(r[0] || { literal: r[1] })
            }
            if (!ok) continue
            let replacements = byBlock.get(blockId)
            if (!replacements) byBlock.set(blockId, replacements = new Map())
            replacements.set(appId, addNode('apply', operands, app))
        }
        if (!byBlock.size) return false
        for (const [blockId, replacements] of byBlock) {
            const from = getGraphBlock(blockId)
            from.bodyId = replaceAll(from.bodyId, replacements)
            revisitBlock(from)
        }
        return true
    }

    function specializeBlockParameters(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const specialized = new Map<number, number>()
        const literals = new Map<number, number>()

        function literalFor(value: number) {
            const known = literals.get(value)
            if (known !== undefined) return known
            const id = addNode('literal', [{ literal: value }])
            literals.set(value, id)
            return id
        }

        for (let i = 0; i < target.params.length; i++) {
            const values: ({ id: number, value: number, constant: boolean })[] = []
            let valid = true
            for (const [, appId] of inbound) {
                const app = g.nodes.get(appId)!
                if (countIds(app) !== target.params.length + 1) {
                    valid = false
                    break
                }
                if (getRef(app, i + 1) === target.params[i]) continue
                const constant = constantOf(app, i + 1)
                if (constant !== undefined) values.push({ id: 0, value: constant, constant: true })
                else if (rematerializable(getRef(app, i + 1))) values.push({ id: getRef(app, i + 1), value: 0, constant: true })
                else values.push({ id: getRef(app, i + 1), value: getLiteral(app, i + 1), constant: false })
            }
            if (!valid || !values.length) continue
            const first = values[0]
            if (first.constant) {
                if (first.id) {
                    const key = nodeKey(g.nodes.get(first.id)!)
                    if (!values.every(value => value.constant && value.id && nodeKey(g.nodes.get(value.id)!) === key)) continue
                    specialized.set(target.params[i], insert(copyNode(g.nodes.get(first.id)!)))
                } else {
                    if (!values.every(value => value.constant && !value.id && value.value === first.value)) continue
                    specialized.set(target.params[i], literalFor(first.value))
                }
                continue
            }
            // if (!first.id || !values.every(value => !value.constant && value.id === first.id)
            //     || target.params.includes(first.id) || !isUnordered(first.id)) continue
            // specialized.set(target.params[i], first.id)
        }
        if (!specialized.size) return false

        const removed = new Set(specialized.keys())
        for (const [param, replacement] of specialized) {
            if (removed.has(replacement)) specialized.delete(param)
        }
        if (!specialized.size) return false

        const edits = new Map<GraphBlock, Map<number, number>>()
        const newParams = target.params.filter(param => !specialized.has(param))
        for (const [blockId, appId] of inbound) {
            const app = g.nodes.get(appId)!
            const operands: Operand[] = [getRef(app, 0)]
            for (let i = 0; i < target.params.length; i++) {
                if (!specialized.has(target.params[i])) operands.push(getOperand(app, i + 1))
            }
            let replacements = edits.get(getGraphBlock(blockId))
            if (!replacements) edits.set(getGraphBlock(blockId), replacements = new Map())
            replacements.set(appId, addNode('apply', operands, app))
        }

        const changed = new Set<GraphBlock>()
        for (const [block, replacements] of edits) {
            block.bodyId = replaceAll(block.bodyId, replacements)
            changed.add(block)
        }
        target.params = newParams
        target.bodyId = replaceAll(target.bodyId, specialized)
        changed.add(target)
        for (const block of changed) revisitBlock(block)
        return true
    }

    function liftBlockSelect(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select' || countIds(tail) !== 3) return false
        const at = target.params.indexOf(getRef(tail, 0))
        if (at < 0) return false

        const inbound = findInboundApplies(target)
        if (inbound.length !== 2 || inbound[0][1] === inbound[1][1]) return false

        let free = -1
        let arm = 0
        let literal = 0
        for (let i = 0; i < 2; i++) {
            const app = g.nodes.get(inbound[i][1])!
            if (countIds(app) !== target.params.length + 1) return false
            const c = constantOf(app, at + 1)
            if (c === undefined) {
                if (free >= 0) return false
                free = i
                continue
            }
            if (arm) return false
            literal = c
            arm = c ? 1 : 2
        }
        if (free < 0 || !arm) return false
        if (!getRef(tail, arm)) return false

        const exclusiveId = getRef(tail, arm === 1 ? 2 : 1)
        const ex = exclusiveId ? g.nodes.get(exclusiveId) : undefined
        if (!ex || ex.op === 'param' || ex.op === 'block' || ex.op === 'literal') return false
        if (dependents.get(exclusiveId)?.size !== 1) return false

        const [callerId, freeId] = inbound[free]
        const freeApp = g.nodes.get(freeId)!
        const liftedOperands = getOperands(ex)
        let coded = false
        for (let i = 0; i < liftedOperands.length; i++) {
            const r = getRef(ex, i)
            if (!r) continue
            const op = g.nodes.get(r)?.op
            if (op === 'block' || op === 'nil-effect' || op === 'void') continue
            const slot = target.params.indexOf(r)
            if (slot < 0) {
                coded = true
                break
            }
            liftedOperands[i] = getOperand(freeApp, slot + 1)
        }
        let lifted: number
        if (coded) {
            const path = applicationPaths(getGraphBlock(callerId), target.id).find(p => p[p.length - 1] === freeId)
            const merged = path ? inlineApplication(path, target, exclusiveId) : undefined
            if (merged === undefined) return false
            lifted = merged
        } else {
            lifted = addNode(ex.op, liftedOperands, ex)
        }
        const takenOperands = getOperands(freeApp)
        takenOperands[at + 1] = { literal }
        const taken = addNode('apply', takenOperands, freeApp)
        const cond = getRef(freeApp, at + 1)
        const pick = addNode('select', arm === 1 ? [cond, taken, lifted] : [cond, lifted, taken], tail)

        target.bodyId = getRef(tail, arm)
        target.bodyConst = getLiteral(tail, arm)
        const caller = getGraphBlock(callerId)
        caller.bodyId = replaceAll(caller.bodyId, new Map([[freeId, pick]]))
        if (caller !== target) revisitBlock(caller)
        revisitBlock(target)
        return true
    }

    function normalizeCommutative(b: GraphBlock) {
        let changed = false
        for (const op of Commutative) {
            const ids = findValues(b.id, op)
            if (!ids) continue
            for (const id of ids) {
                const n = g.nodes.get(id)
                if (!n || n.op !== op || countIds(n) !== 2) continue
                if (getRef(n, 0) || !getRef(n, 1)) continue
                gn.swapBinaryOperands(n)
                changed = true
            }
        }
        if (changed) revisitBlock(b)
    }

    function foldLiterals(b: GraphBlock) {
        const literals = findValues(b.id, 'literal')
        if (!literals) return
        let changed = false
        for (const id of literals) {
            const u = g.nodes.get(id)!
            const value = literalValue(u)
            const wide = !inlineableLiteral(costs, value)
            const uses = dependents.get(id) ?? []
            for (const x of uses) {
                const n = g.nodes.get(x)!
                const ids = getArgIds(n)
                for (let slot = 0; slot < ids.length; slot++) {
                    if (ids[slot] !== id) continue
                    if (wide && liftableSlot(n.op, slot)) continue
                    setLiteral(n, slot, value)
                    changed = true
                }
            }
        }
        if (changed) revisitBlock(b)
    }

    function liftLiterals(b: GraphBlock) {
        const ops = byOp.get(b.id)
        if (!ops) return false
        const counts = new Map<number, number>()
        const visit = (fn: (n: GraphNode, op: string, slot: number, value: f64) => void) => {
            for (const [op, ids] of ops) {
                if (op === 'literal') continue
                for (const id of ids) {
                    const n = g.nodes.get(id)!
                    const arity = countIds(n)
                    for (let slot = 0; slot < arity; slot++) {
                        if (getRef(n, slot)) continue
                        const value = getLiteral(n, slot)
                        if (inlineableLiteral(costs, value) || !liftableSlot(op, slot)) continue
                        fn(n, op, slot, value)
                    }
                }
            }
        }
        visit((n, op, slot, value) => counts.set(value, (counts.get(value) ?? 0) + 1))
        const made = new Map<number, number>()
        visit((n, op, slot, value) => {
            if ((counts.get(value) ?? 0) < 2) return
            let lifted = made.get(value)
            if (lifted === undefined) {
                made.set(value, lifted = addNode('literal', [{ literal: value }]))
            }
            setRef(n, slot, lifted)
        })
        if (made.size === 0) return false
        revisitBlock(b)
        return true
    }

    interface ClosureTerm {
        param?: number
        node?: GraphNode
        args: number[]
        head: string
    }
    const closureTerms = new Map<number, ClosureTerm>()
    const closureTermIds = new Map<string, number>()
    let nextClosureTerm = 1
    function internClosureTerm(key: string, term: ClosureTerm): number {
        const known = closureTermIds.get(key)
        if (known !== undefined) return known
        const id = nextClosureTerm++
        closureTermIds.set(key, id)
        closureTerms.set(id, term)
        return id
    }
    function paramClosureTerm(param: number): number {
        return internClosureTerm(`p${param}`, { param, args: [], head: `p${param}` })
    }
    function constantClosureTerm(value: number): number {
        const key = `c${value}`
        return internClosureTerm(key, { args: [], head: key })
    }
    function opaqueClosureTerm(value: number): number {
        return internClosureTerm(`o${value}`, { args: [], head: `o${value}` })
    }
    function nodeClosureTerm(n: GraphNode, args: number[]): number {
        const key = `n${nodeKey(n, args, getArgConsts(n), true)}`
        const headArgs = args.map(x => x ? 1 : 0)
        const head = nodeKey(n, headArgs, getArgConsts(n), true)
        return internClosureTerm(key, { node: n, args, head })
    }

    function closuresOf(b: GraphBlock): BlockClosureInfo {
        if (const known = blockClosureInfo.get(b.id)) return known
        const values = new Set<number>(b.params)
        for (const ids of byOp.get(b.id)?.values() ?? []) {
            for (const id of ids) if (isUnordered(id)) values.add(id)
        }
        const supportOf = new Map<number, number[]>()
        for (const p of b.params) {
            supportOf.set(p, [p])
        }
        function support(id: number): number[] {
            const n = g.nodes.get(id)!
            if (n.op === 'param') return supportOf.get(id)!
            if (!isUnordered(id)) return []
            const argIds = getArgIds(n).filter(x => x > 0)
            if (!argIds.length) return []
            if (argIds.length === 1) return support(argIds[0])
            if (const known = supportOf.get(id)) return known
            const result: number[] = []
            supportOf.set(id, result)
            const seen = new Set<number>()
            for (const arg of argIds) for (const p of support(arg)) seen.add(p)
            for (const p of seen) result.push(p)
            return result
        }
        const termOf = new Map<number, number>()
        function term(id: number): number {
            const known = termOf.get(id)
            if (known !== undefined) return known
            const n = g.nodes.get(id)
            assert(n)
            let result: number
            if (n.op === 'param') result = paramClosureTerm(id)
            else if (n.op === 'literal') result = constantClosureTerm(literalValue(n))
            else if (!isUnordered(id)) result = opaqueClosureTerm(id)
            else result = nodeClosureTerm(n, getArgIds(n).map(arg => arg ? term(arg) : 0))
            termOf.set(id, result)
            return result
        }
        for (const id of values) { support(id); term(id) }

        const groups = new Map<string, number[]>()
        for (const id of values) {
            const key = support(id).join(',')
            let group = groups.get(key)
            if (!group) groups.set(key, group = [])
            group.push(id)
        }
        const closures: ArityClosure[] = []
        for (const group of groups.values()) {
            const members = new Set(group)
            const parent = new Map<number, number>()
            function root(id: number): number {
                if (const p = parent.get(id)) {
                    const r = root(p)
                    parent.set(id, r)
                    return r
                }
                return id
            }
            function join(a: number, c: number): void {
                const x = root(a)
                const y = root(c)
                if (x !== y) parent.set(y, x)
            }
            for (const id of group) {
                if (!id) continue
                const n = g.nodes.get(id)!
                for (const arg of getArgIds(n)) {
                    if (!arg) continue
                    if (members.has(arg)) join(id, arg)
                }
            }
            const byRoot = new Map<number, number[]>()
            for (const id of group) {
                const r = root(id)
                let component = byRoot.get(r)
                if (!component) byRoot.set(r, component = [])
                component.push(id)
            }
            for (const component of byRoot.values()) {
                closures.push({ id: -1, support: support(component[0]), values: component, inputs: [] })
            }
        }
        closures.sort((a, c) => a.support.length - c.support.length
            || a.support.map(x => b.params.indexOf(x)).join(',').localeCompare(c.support.map(x => b.params.indexOf(x)).join(','))
            || a.values[0] - c.values[0])
        const closureOf = new Map<number, number>()
        const byParam = new Map<number, number[]>()
        const bySupport = new Map<string, number[]>()
        for (let i = 0; i < closures.length; i++) {
            const closure = closures[i]
            closure.id = i
            for (const value of closure.values) closureOf.set(value, i)
            for (const param of closure.support) {
                let arr = byParam.get(param)
                if (!arr) byParam.set(param, arr = [])
                arr.push(i)
            }
            const key = closure.support.join(',')
            let arr = bySupport.get(key)
            if (!arr) bySupport.set(key, arr = [])
            arr.push(i)
        }
        for (const closure of closures) {
            const inputs = new Set<number>()
            for (const id of closure.values) {
                const n = g.nodes.get(id)!
                for (const arg of getArgIds(n)) {
                    if (!arg) continue
                    const input = closureOf.get(arg)
                    if (input !== undefined && input !== closure.id) inputs.add(input)
                }
            }
            closure.inputs = [...inputs].sort((a, c) => a - c)
        }
        const info = { block: b, termOf, term, closures, closureOf, byParam, bySupport }
        blockClosureInfo.set(b.id, info)
        return info
    }

    function dumpArityClosures(): string {
        const lines = [`--- arity closures for ${g.name ?? '<graph>'} ---`]
        for (const b of reachableBlocks) {
            const info = closuresOf(b)
            lines.push(`B${b.id}(${b.params.map(x => `%${x}`).join(', ')})`)
            for (const closure of info.closures) {
                const params = closure.support.map(x => `%${x}`).join(', ')
                const from = closure.inputs.map(x => `C${x}`).join(', ')
                const body = closure.values.map(id => `%${id}=${g.nodes.get(id)!.op}`).join(' ')
                lines.push(`  C${closure.id}/${closure.support.length} {${params}}${from ? ` <- ${from}` : ''}: ${body}`)
            }
            const roots = new Set<number>()
            const seen = new Set<number>()
            function collect(id: number): void {
                if (!id || seen.has(id)) return
                seen.add(id)
                const closure = info.closureOf.get(id)
                if (closure !== undefined) { roots.add(closure); return }
                const n = g.nodes.get(id)
                if (n) for (const arg of getArgIds(n)) collect(arg)
            }
            collect(b.bodyId)
            const from = [...roots].sort((a, c) => a - c).map(x => `C${x}`).join(', ')
            lines.push(`  block/${b.params.length} {${b.params.map(x => `%${x}`).join(', ')}}${from ? ` <- ${from}` : ''}`)
        }
        return lines.join('\n')
    }

    function composeClosureTerm(id: number, substitutions: Map<number, number>, memo = new Map<number, number>()): number {
        if (const known = memo.get(id)) return known
        const term = closureTerms.get(id)!
        if (const param = term.param) {
            const result = substitutions.get(param) ?? id
            memo.set(id, result)
            return result
        }
        if (!term.node) return id
        let changed = false
        const args = term.args.map(arg => {
            if (!arg) return 0
            const next = composeClosureTerm(arg, substitutions, memo)
            if (next !== arg) changed = true
            return next
        })
        const result = changed ? nodeClosureTerm(term.node, args) : id
        memo.set(id, result)
        return result
    }

    function forwardEquivalentClosure(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        function substitution(target: GraphBlock, from: GraphBlock, app: GraphNode): Map<number, number> | undefined {
            const info = closuresOf(from)
            const result = new Map<number, number>()
            for (let i = 0; i < target.params.length; i++) {
                const arg = getRef(app, i + 1)
                if (arg && !isUnordered(arg)) return
                result.set(target.params[i], arg ? info.term(arg) : constantClosureTerm(getLiteral(app, i + 1)))
            }
            return result
        }
        const active = new Set<string>()
        const activeBlocks = new Set<number>()
        function equivalent(block: GraphBlock, a: number, c: number): boolean {
            if (a === c) return true
            const x = closureTerms.get(a)!
            const y = closureTerms.get(c)!
            if (x.param === undefined && y.param === undefined) {
                if (!x.node || !y.node || x.head !== y.head || x.args.length !== y.args.length) return false
                for (let i = 0; i < x.args.length; i++) {
                    if (x.args[i] === y.args[i]) continue
                    if (!x.args[i] || !y.args[i] || !equivalent(block, x.args[i], y.args[i])) {
                        return false
                    }
                }
                return true
            }
            if (block.id === 0) return false

            const lo = Math.min(a, c)
            const hi = Math.max(a, c)
            const key = `${block.id}:${lo}:${hi}`
            if (active.has(key)) return true
            if (activeBlocks.has(block.id)) return false
            active.add(key)
            activeBlocks.add(block.id)
            const applies = findInboundApplies(block)
            for (const [blockId, appId] of applies) {
                const from = getGraphBlock(blockId)
                const subst = substitution(block, from, g.nodes.get(appId)!)
                if (!subst || !equivalent(from,
                    composeClosureTerm(a, subst), composeClosureTerm(c, subst))) {
                    active.delete(key)
                    activeBlocks.delete(block.id)
                    return false
                }
            }
            active.delete(key)
            activeBlocks.delete(block.id)
            return true
        }

        const applies = findInboundApplies(target)
        if (!applies.length) return false
        if (applies.every(x => x[0] === target.id)) return false
        const info = closuresOf(target)
        for (let at = info.closures.length - 1; at >= 0; at--) {
            const closure = info.closures[at]
            if (!closure.support.length) continue
            for (let j = closure.values.length - 1; j >= 0; j--) {
                const id = closure.values[j]
                const n = g.nodes.get(id)!
                if (n.op === 'param' || !countIds(n)) continue
                const candidate = info.term(id)
                const local = target.params.find(p => equivalent(target, info.term(p), candidate))
                if (local !== undefined) {
                    target.bodyId = replaceAll(target.bodyId, new Map([[id, local]]))
                    revisitBlock(target)
                    return true
                }

                const incoming: [blockId: number, appId: number, value: number][] = []
                for (const [blockId, appId] of applies) {
                    const from = getGraphBlock(blockId)
                    const app = g.nodes.get(appId)!
                    const subst = substitution(target, from, app)
                    if (!subst) break
                    const composed = composeClosureTerm(candidate, subst)
                    const fromInfo = closuresOf(from)
                    const value = from.params.find(p => equivalent(from, fromInfo.term(p), composed))
                    if (value === undefined) break
                    incoming.push([blockId, appId, value])
                }
                if (!incoming.length) continue

                const replacement = paramLike(id)
                target.params.push(replacement)
                const edits = new Map<GraphBlock, Map<number, number>>()
                for (const [blockId, appId, value] of incoming) {
                    const app = g.nodes.get(appId)!
                    const from = getGraphBlock(blockId)
                    let replacements = edits.get(from)
                    if (!replacements) edits.set(from, replacements = new Map())
                    replacements.set(appId, addNode('apply', [...getOperands(app), value], app))
                }
                let replacements = edits.get(target)
                if (!replacements) edits.set(target, replacements = new Map())
                replacements.set(id, replacement)
                for (const [block, blockEdits] of edits) {
                    block.bodyId = replaceAll(block.bodyId, blockEdits)
                    revisitBlock(block)
                }
                return true
            }
        }
        return false
    }

    function forwardEquivalentValue(): boolean {
        const parent = new Map<number, number>()
        const sizes = new Map<number, number>()
        function root(id: number): number {
            const p = parent.get(id)
            if (p === undefined) {
                parent.set(id, id)
                sizes.set(id, 1)
                return id
            }
            if (p === id) return id
            const r = root(p)
            parent.set(id, r)
            return r
        }
        const users = new Map<number, Set<number>>()
        const work: number[] = []
        const queued = new Set<number>()
        function enqueue(id: number): void {
            if (queued.has(id)) return
            queued.add(id)
            work.push(id)
        }
        function addUser(value: number, user: number): void {
            const r = root(value)
            let set = users.get(r)
            if (!set) users.set(r, set = new Set())
            set.add(user)
        }
        function join(a: number, b: number): boolean {
            let x = root(a), y = root(b)
            if (x === y) return false
            if (sizes.get(x)! < sizes.get(y)!) {
                const swap = x
                x = y
                y = swap
            }
            parent.set(y, x)
            sizes.set(x, sizes.get(x)! + sizes.get(y)!)
            sizes.delete(y)
            let into = users.get(x)
            const from = users.get(y)
            if (from) {
                for (const id of from) enqueue(id)
                if (!into) users.set(x, into = new Set())
                for (const id of from) into.add(id)
                users.delete(y)
            }
            return true
        }

        const inbound = new Map<number, [blockId: number, valId: number][]>()
        for (const b of reachableBlocks) inbound.set(b.id, findInboundApplies(b))

        const values = new Set<number>()
        for (const id of visited.keys()) {
            const n = g.nodes.get(id)
            if (!n || n.op === 'param' || n.op === 'block' || !isUnordered(id)) continue
            values.add(id)
            enqueue(id)
            for (const arg of getArgIds(n)) if (arg) addUser(arg, id)
        }
        const literals = new Map<number, number>()
        const literalValues: number[] = []
        function literalOf(value: number): number {
            let id = literals.get(value)
            if (id === undefined) {
                literals.set(value, id = -1 - literalValues.length)
                literalValues.push(value)
            }
            return id
        }
        const equations = new Map<number, number[]>()
        for (const b of reachableBlocks) {
            if (b === g.blocks[0]) continue
            const applies = inbound.get(b.id)!
            if (!applies.length) continue
            for (let i = 0; i < b.params.length; i++) {
                const args: number[] = []
                for (const [, appId] of applies) {
                    const app = g.nodes.get(appId)!
                    const arg = getRef(app, i + 1) || literalOf(getLiteral(app, i + 1))
                    if (arg > 0 && !isUnordered(arg)) { args.length = 0; break }
                    args.push(arg)
                }
                if (!args.length) continue
                const p = b.params[i]
                equations.set(p, args)
                enqueue(p)
                for (const arg of args) addUser(arg, p)
            }
        }

        const keys = new Map<number, string>()
        const buckets = new Map<string, Set<number>>()
        function valueKey(id: number): string {
            const n = g.nodes.get(id)!
            return nodeKey(n, getArgIds(n).map(root), getArgConsts(n), true)
        }
        function processValue(id: number): void {
            const old = keys.get(id)
            if (old !== undefined) buckets.get(old)?.delete(id)
            const key = valueKey(id)
            keys.set(id, key)
            let bucket = buckets.get(key)
            if (!bucket) buckets.set(key, bucket = new Set())
            let equivalent = 0
            for (const other of bucket) {
                if (valueKey(other) !== key) {
                    bucket.delete(other)
                    keys.delete(other)
                    enqueue(other)
                    continue
                }
                if (root(other) !== root(id)) { equivalent = other; break }
            }
            bucket.add(id)
            if (equivalent) join(id, equivalent)
        }
        function processEquation(p: number, args: number[]): void {
            let common = 0
            for (const arg of args) {
                const r = root(arg)
                if (r === root(p)) continue
                if (!common) common = r
                else if (root(common) !== r) return
            }
            if (common) join(p, common)
        }
        while (work.length) {
            const id = work.pop()!
            queued.delete(id)
            const args = equations.get(id)
            if (args) processEquation(id, args)
            else if (values.has(id)) processValue(id)
        }

        const constants = new Map<number, number>()
        for (const id of values) if (rematerializable(id)) constants.set(root(id), id)
        for (const id of literals.values()) constants.set(root(id), id)
        let specialized = false
        for (const target of reachableBlocks) {
            if (target === g.blocks[0]) continue
            const replacements = new Map<number, number>()
            for (const p of target.params) {
                const constant = constants.get(root(p))
                if (constant === undefined) continue
                replacements.set(p, constant < 0
                    ? addNode('literal', [{ literal: literalValues[-1 - constant] }])
                    : insert(copyNode(g.nodes.get(constant)!)))
            }
            if (!replacements.size) continue
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            specialized = true
        }
        if (specialized) return true

        for (const target of reachableBlocks) {
            if (target === g.blocks[0]) continue
            const applies = inbound.get(target.id)!
            if (!applies.length) continue
            const params = new Set(target.params)
            const values = byOp.get(target.id)
            if (!values) continue
            for (const ids of values.values()) for (const id of ids) {
                const n = g.nodes.get(id)
                if (!n || n.op === 'param' || !countIds(n) || !isUnordered(id)) continue
                if (!reachesAnyOf(id, params)) continue
                const equivalent = target.params.find(p => root(p) === root(id))
                if (equivalent !== undefined) {
                    target.bodyId = replaceAll(target.bodyId, new Map([[id, equivalent]]))
                    revisitBlock(target)
                    return true
                }

                const incoming: [blockId: number, appId: number, value: number][] = []
                let valid = true
                for (const [blockId, appId] of applies) {
                    const from = getGraphBlock(blockId)
                    const value = from.params.find(p => root(p) === root(id))
                    if (value === undefined) { valid = false; break }
                    incoming.push([blockId, appId, value])
                }
                if (!valid) continue

                const replacement = paramLike(id)
                target.params.push(replacement)
                const edits = new Map<GraphBlock, Map<number, number>>()
                for (const [blockId, appId, value] of incoming) {
                    const app = g.nodes.get(appId)!
                    const from = getGraphBlock(blockId)
                    let replacements = edits.get(from)
                    if (!replacements) edits.set(from, replacements = new Map())
                    replacements.set(appId, addNode('apply', [...getOperands(app), value], app))
                }
                let replacements = edits.get(target)
                if (!replacements) edits.set(target, replacements = new Map())
                replacements.set(id, replacement)
                for (const [block, blockEdits] of edits) {
                    block.bodyId = replaceAll(block.bodyId, blockEdits)
                    revisitBlock(block)
                }
                return true
            }
        }
        return false
    }

    function deduplicateParams(): boolean {
        const canonicalParams = new Map<number, number>()
        const applies = new Map<GraphBlock, number[]>()
        let candidates = false
        for (const b of reachableBlocks) {
            if (b === g.blocks[0] || b.params.length < 2) continue
            const inbound = findInboundApplies(b)
            if (!inbound.length) continue
            const representatives = new Map<string, number>()
            let duplicated = false
            for (const p of b.params) {
                const key = nodeKey(g.nodes.get(p)!)
                const rep = representatives.get(key)
                if (rep === undefined) representatives.set(key, p)
                else duplicated = true
                canonicalParams.set(p, rep ?? p)
            }
            if (!duplicated) continue
            applies.set(b, inbound.map(x => x[1]))
            candidates = true
        }
        if (!candidates) return false

        while (true) {
            let changed = false
            const sizes = new Map<number, number>()
            for (const rep of canonicalParams.values()) sizes.set(rep, (sizes.get(rep) ?? 0) + 1)
            for (const [b, ids] of applies) {
                if (b.params.every(p => sizes.get(canonicalParams.get(p)!) === 1)) {
                    applies.delete(b)
                    continue
                }
                const representatives = new Map<string, number>()
                const canonical = new Map<number, number>()
                function visit(id: number): number {
                    if (!id) return 0
                    const known = canonical.get(id)
                    if (known !== undefined) return known
                    const n = g.nodes.get(id)
                    let rep = canonicalParams.get(id) ?? id
                    if (n && n.op !== 'param' && n.op !== 'block') {
                        const key = nodeKey(n, getArgIds(n).map(visit))
                        rep = representatives.get(key) ?? id
                        representatives.set(key, rep)
                    }
                    canonical.set(id, rep)
                    return rep
                }
                const next = new Map<number, number>()
                for (let i = 0; i < b.params.length; i++) {
                    const p = b.params[i]
                    if (sizes.get(canonicalParams.get(p)!) === 1) {
                        next.set(p, p)
                        continue
                    }
                    const argIds = [canonicalParams.get(p)!]
                    const argConsts = new Float64Array(ids.length + 1)
                    for (let j = 0; j < ids.length; j++) {
                        const u = g.nodes.get(ids[j])!
                        argIds.push(visit(getRef(u, i + 1)))
                        argConsts[j + 1] = getLiteral(u, i + 1)
                    }
                    const key = nodeKey(g.nodes.get(p)!, argIds, argConsts)
                    const rep = representatives.get(key) ?? p
                    representatives.set(key, rep)
                    if (rep !== canonicalParams.get(p)) changed = true
                    next.set(p, rep)
                }
                for (const [p, rep] of next) canonicalParams.set(p, rep)
            }
            if (!changed) break
        }

        const replacements = new Map<number, number>()
        for (const [p, rep] of canonicalParams) {
            if (p !== rep) replacements.set(p, rep)
        }
        if (!replacements.size) return false
        const changedBlocks: GraphBlock[] = []
        for (const b of reachableBlocks) {
            const bodyId = replaceAll(b.bodyId, replacements)
            if (bodyId === b.bodyId) continue
            b.bodyId = bodyId
            changedBlocks.push(b)
        }
        for (const b of changedBlocks) {
            revisitBlock(b)
        }
        return true
    }

    function optimize() {
        for (const b of reachableBlocks) {
            step(eliminateUnusedPureValues, b)
        }
        for (const b of reachableBlocks) {
            step(mergeBlocks, b)
            step(absorbConditions, b)
            step(threadConstantBranches, b)
            step(threadDecidedArrivals, b)
            step(foldKnownConditions, b)
            step(reduceSelects, b)
            step(forwardMemory, b)
            step(forwardArrivalLoads, b)
            step(forwardArrivalCalls, b)
            step(liftCommonEffects, b)
            step(liftCommonApplications, b)
            step(liftBlockSelect, b)
        }
        for (const b of reachableBlocks) {
            step(deriveIncrementor, b)
            if (step(closeCountedLoop, b)) continue
            step(reverseLoop, b)
            step(hoistInvariants, b)
            step(hoistLoopInvariants, b)
            step(sinkReloadedStores, b)
            step(hoistSharedSelectValues, b)
            if (step(eliminatePassthru, b)) continue
        }
        for (const b of reachableBlocks) {
            step(rotateLoop, b)
            step(advanceLoopLoads, b)
            step(simplifySelect, b)
            step(reduceBlockOrdering, b)
            step(liftAfters, b)
            step(interchangeSelects, b)
        }
        const forwardingStart = performance.now()
        if (intrinsics.argv().includes('closure-forward')) {
            for (const b of reachableBlocks) forwardEquivalentClosure(b)
        } else if (!disabledPasses.has('forwardEquivalentValue')) {
            forwardEquivalentValue()
        }
        if (optimizeTimers) time(intrinsics.argv().includes('closure-forward')
            ? 'forwardEquivalentClosure' : 'forwardEquivalentValue', performance.now() - forwardingStart)
        const dedupeStart = performance.now()
        if (!disabledPasses.has('deduplicateParams')) deduplicateParams()
        if (optimizeTimers) time('deduplicateParams', performance.now() - dedupeStart)
        liveParams = undefined
        for (const b of reachableBlocks) {
            step(rematerializeOffsets, b)
            step(pruneUnusedParams, b)
        }
        for (const b of reachableBlocks) {
            step(foldValues, b)
            step(foldLiterals, b)
            step(liftLiterals, b)
            step(normalizeCommutative, b)
            step(specializeBlockParameters, b)
            step(substituteEqualArguments, b)
            step(specializeApplySite, b)
            step(simplifyBitOperations, b)
            step(reassociateAdds, b)
            step(rebaseAddresses, b)
            step(hoistLoopStep, b)
            step(promoteAllocas, b)
            step(deduplicateValues, b)
        }
        for (const b of reachableBlocks) {
            step(mergeBlocks, b)
            step(liftCommonEffects, b)
            step(simplifySelect, b)
            step(reduceBlockOrdering, b)
        }
        if (intrinsics.argv().includes('closure-debug')
            || intrinsics.argv().includes(`closure-debug:${g.name}`)) {
            console.log(dumpArityClosures())
        }
    }

    const usesFindInboundApplies = new Set<Function>()
    const captures = intrinsics.getComputation(optimize)[1]
    for (const x of captures) {
        if (typeof x !== 'function') continue
        // shallow search
        const stepCaptures = intrinsics.getComputation(x)[1]
        if (stepCaptures.includes(findInboundApplies)) {
            usesFindInboundApplies.add(x)
        }
    }

    function reduceConstantMultiplies() {
        for (const b of reachableBlocks) {
            for (const id of findValues(b.id, 'mul') ?? []) {
                const n = g.nodes.get(id)!
                const valueAt = getRef(n, 0) && !getRef(n, 1) ? 0
                    : getRef(n, 1) && !getRef(n, 0) ? 1 : -1
                if (valueAt < 0) continue
                const carried = Math.log2(getLiteral(n, valueAt ^ 1) - 1)
                if (!Number.isSafeInteger(carried) || carried <= 0 || carried >= 32) continue
                const value = getRef(n, valueAt)
                const shifted = addNode('shl', [value, { literal: carried }], n)
                g.nodes.set(id, copyNode(n, [value, shifted], 'add'))
            }
        }
    }

    const maxRounds = optimizeRounds || (g.nodes.size < 50 ? 3 : 2)
    if (optimizeTimers) time('(setup)', performance.now() - optimizeStart)
    for (let round = 0; round < maxRounds; round++) {
        const roundStart = performance.now()
        didAnyChange = false
        optimize()
        if (optimizeTimers) time(`(round ${round})`, performance.now() - roundStart)
        if (!didAnyChange) break
    }
    if (unswitchScan) scanUnswitchCandidates()
    reduceConstantMultiplies()
    if (!reachableBlocks.size) {
        reachableBlocks.add(g.blocks[0])
        g.blocks[0].bodyId = unreachable()
    }
    setGraphBlocks(g, [...reachableBlocks])
    sweepBlocks(g)
    if (optimizeTimers) time('(total)', performance.now() - optimizeStart)
    return g
}

export interface SignatureHomes {
    volatiles: number[]
    preserved: number[]
    safeFor: (v: number) => number[]
    rank: (safe: number[]) => number[]
    arrival: number[]
    argHome: (call: number, index: number) => number
    ret: number
    overflow: () => number
}

export function assignBlockSignatures(
    g: Graph,
    crossing: Map<number, number>,
    inArgPos: Map<number, [parent: number, idx: number][]>,
    inStatePos: Map<number, [parent: number, idx: number][]>,
    applyOwner: Map<number, number>,
    homes: SignatureHomes,
): Map<number, number[]> {
    const owner = new Map<number, number>()
    const parent = new Map<number, number>()
    const occupies = new Map<number, Set<number>>()
    const wants = new Map<number, number[]>()
    for (const b of g.blocks) {
        for (const p of b.params) {
            owner.set(p, b.id)
            parent.set(p, p)
            occupies.set(p, new Set([b.id]))
        }
    }
    function find(x: number): number {
        let r = x
        while (parent.get(r) !== r) r = parent.get(r)!
        let at = x
        while (parent.get(at) !== r) {
            const next = parent.get(at)!
            parent.set(at, r)
            at = next
        }
        return r
    }
    function prefer(p: number, home: number): void {
        if (home < 0 || !owner.has(p)) return
        const list = wants.get(p)
        if (!list) wants.set(p, [home])
        else if (!list.includes(home)) list.push(home)
    }
    g.blocks[0].params.forEach((p, i) => prefer(p, homes.arrival[i]))
    for (const [p, positions] of inStatePos) {
        for (const at of positions) if (at[1] === -1) prefer(p, homes.ret)
    }
    for (const [v, positions] of inArgPos) {
        for (const at of positions) if (g.nodes.get(at[0])?.op === 'call') prefer(v, homes.argHome(at[0], at[1]))
    }
    const edges: [from: number, to: number, weight: number][] = []
    const edgeAt = new Map<string, number>()
    const arrivals = new Map<number, number[]>()
    const settled = new Map<number, boolean>()
    for (const [app, from] of applyOwner) {
        const n = g.nodes.get(app)
        const into = n ? getBlock(g, getRef(n, 0)) : undefined
        if (!n || !into) continue
        for (let i = 0; i < into.params.length; i++) {
            const q = into.params[i]
            const a = getRef(n, i + 1)
            settled.set(q, (settled.get(q) ?? true) && crossing.has(a))
            if (!a) continue
            if (owner.has(a)) {
                if (a === q) continue
                const key = `${a}:${q}`
                const weight = getRef(n, 0) === from ? 2 : 1
                const at = edgeAt.get(key)
                if (at === undefined) {
                    edgeAt.set(key, edges.length)
                    edges.push([a, q, weight])
                } else edges[at][2] += weight
            } else if (crossing.has(a)) {
                arrivals.set(q, [...arrivals.get(q) ?? [], a])
            } else if (g.nodes.get(a)?.op === 'call') {
                prefer(q, homes.ret)
            }
        }
    }
    edges.sort((a, b) => b[2] - a[2])
    for (const [from, to] of edges) {
        const a = find(from)
        const b = find(to)
        if (sigStats) sigStats.edges++
        if (a === b) continue
        const left = occupies.get(a)!
        const right = occupies.get(b)!
        let clash = false
        for (const id of right) if (left.has(id)) { clash = true; break }
        if (clash) { if (sigStats) sigStats.edgesBlocked++; continue }
        parent.set(b, a)
        for (const id of right) left.add(id)
        occupies.delete(b)
        wants.set(a, [...wants.get(a) ?? [], ...wants.get(b) ?? []])
    }
    const members = new Map<number, number[]>()
    for (const p of owner.keys()) members.set(find(p), [...members.get(find(p)) ?? [], p])
    const uses = new Map<number, number>()
    for (const n of g.nodes.values()) {
        if (n.op === 'apply') continue
        for (let i = 0; i < countIds(n); i++) {
            const r = getRef(n, i)
            if (owner.has(r)) uses.set(find(r), (uses.get(find(r)) ?? 0) + 1)
        }
    }
    const entry = g.blocks[0].id
    const candidates = new Map<number, number[]>()
    for (const [root, group] of members) {
        const crosses = group.some(p => crossing.has(p) || (settled.get(p) && !wants.get(root)?.length))
        let list = crosses
            ? [...new Set([...homes.rank(homes.volatiles.filter(r => [...group, ...group.flatMap(p => arrivals.get(p) ?? [])].every(v => homes.safeFor(v).includes(r)))), ...homes.preserved])]
            : [...homes.volatiles, ...homes.preserved]
        if (occupies.get(root)!.has(entry)) {
            const own = g.blocks[0].params.map((p, i) => group.includes(p) ? -1 : homes.arrival[i])
            list = list.filter(r => !own.includes(r))
        }
        candidates.set(root, list)
        wants.set(root, (wants.get(root) ?? []).filter(r => list.includes(r)))
    }
    const arrives = (x: number) => g.blocks[0].params.some((p, i) => find(p) === x && candidates.get(x)!.includes(homes.arrival[i]))
    const rank = (x: number) => (arrives(x) ? 2 : 0) + (wants.get(x)!.length ? 1 : 0)
    const density = (x: number) => (uses.get(x) ?? 0) / occupies.get(x)!.size
    const groups = [...occupies.keys()].sort((a, b) => rank(b) - rank(a) || density(b) - density(a))
    const taken = new Map<number, Set<number>>()
    for (const b of g.blocks) taken.set(b.id, new Set())
    const homeOf = new Map<number, number>()
    const spills: number[] = []
    for (const root of groups) {
        const where = occupies.get(root)!
        const free = (r: number) => [...where].every(id => !taken.get(id)!.has(r))
        let home = wants.get(root)!.find(free) ?? candidates.get(root)!.find(free) ?? spills.find(free)
        if (home === undefined) spills.push(home = homes.overflow())
        for (const id of where) taken.get(id)!.add(home)
        homeOf.set(root, home)
    }
    const out = new Map<number, number[]>()
    for (const b of g.blocks) out.set(b.id, b.params.map(p => homeOf.get(find(p))!))
    return out
}

export function substitute(g: Graph, by: Map<number, Operand>): void {
    function resolve(id: number): Operand {
        let at: Operand = id
        while (typeof at === 'number' && by.has(at)) at = by.get(at)!
        return at
    }
    for (const [id, n] of [...g.nodes]) {
        if (by.has(id)) continue
        let operands: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (!by.has(getRef(n, i))) continue
            operands ??= getOperands(n)
            operands[i] = resolve(getRef(n, i))
        }
        if (operands) g.nodes.set(id, copyNode(n, operands))
    }
    for (const b of g.blocks) {
        if (!by.has(b.bodyId)) continue
        const body = resolve(b.bodyId)
        assert(typeof body === 'number', 'substitute: a block body must stay a value')
        b.bodyId = body
    }
    for (const id of by.keys()) g.nodes.delete(id)
}

function rebuildable(g: Graph, id: number): boolean {
    const n = g.nodes.get(id)
    if (!n) return false
    return n.op === 'literal' || n.op === 'frame-address'
}

function islandLoad(g: Graph, n: GraphNode): boolean {
    if (n.op !== 'load' || getRef(n, 0) || getRef(n, 2)) return false
    const base = g.nodes.get(getRef(n, 1))
    return base?.op === 'pc' && getLiteral(base, 0) === 0
}

export function wideLiteral(v: number): boolean {
    return Number.isSafeInteger(v) && (v >= 2 ** 32 || v < -(2 ** 31))
}

function islandLoads(g: Graph, costs: lowering.TargetCosts, poolSlot: (value: number) => number, poolValue?: (slot: number) => number | undefined): number[] {
    const island: number[] = []
    const entries = new Map<number, number>()
    const entryOf = (slot: number) => {
        let at = entries.get(slot)
        if (at === undefined) {
            entries.set(slot, at = island.length)
            island.push(slot)
        }
        return at
    }
    const floats = floatValues(g)
    const loads: [id: number, entry: number, type: Types][] = []
    for (const [id, n] of [...g.nodes]) {
        if (n.op === 'pool-entry' && !getRef(n, 0)) {
            const value = poolValue?.(getLiteral(n, 0))
            if (value !== undefined && inlineableLiteral(costs, value)) g.nodes.set(id, makeNode('literal', [{ literal: value }]))
            else loads.push([id, entryOf(getLiteral(n, 0)), Types.u64])
            continue
        }
        if (n.op === 'literal') {
            if (!floats.has(id) && typeOf(n) !== Types.f64 && wideLiteral(getLiteral(n, 0))) loads.push([id, entryOf(poolSlot(getLiteral(n, 0))), typeOf(n)])
            continue
        }
        if (floats.has(id)) continue
        let copy: GraphNode | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (getRef(n, i) || !liftableSlot(n.op, i) || !wideLiteral(getLiteral(n, i))) continue
            const lifted = g.maxId++
            loads.push([lifted, entryOf(poolSlot(getLiteral(n, i))), Types.u64])
            copy ??= copyNode(n)
            setRef(copy, i, lifted)
        }
        if (copy) g.nodes.set(id, copy)
    }
    for (const [id, entry, type] of loads) {
        const pc = g.maxId++
        g.nodes.set(pc, makeNode('pc', [{ literal: 0 }, { literal: (entry - island.length) * 8 }]))
        g.nodes.set(id, makeNode('load', [{ literal: 0 }, pc, { literal: 0 }], type))
    }
    return island
}

function stripMem(g: Graph): boolean {
    const pointers = new Map<number, Operand>()
    for (const [id, n] of g.nodes) if (n.op === 'mem') pointers.set(id, getOperand(n, 0))
    if (!pointers.size) return false
    substitute(g, pointers)
    return true
}

function expandPstacks(g: Graph): boolean {
    let found = false
    for (const [id, n] of [...g.nodes]) {
        if (n.op !== 'pstack') continue
        found = true
        if (getRef(n, 1)) throw `lowering: pstack %${id} names its stack dynamically`
        const token = getRef(n, 0)
        const cell = getLiteral(n, 1)
        let base: Operand = getRef(n, 2) || getLiteral(n, 2) ? getOperand(n, 2) : 0
        if (!base) {
            base = g.maxId++
            g.nodes.set(base, makeNode('load', [token, { literal: cell }, 0], Types.u64))
            if (!getRef(n, 3) && !getLiteral(n, 3)) {
                g.nodes.set(id, copyNode(n, [base, base], 'after'))
                continue
            }
        }
        let top: Operand = base
        if (getRef(n, 3) || getLiteral(n, 3)) {
            top = g.maxId++
            g.nodes.set(top, makeNode('add', [base, getOperand(n, 3)]))
        }
        const store = g.maxId++
        g.nodes.set(store, makeNode('store', [token, { literal: cell }, 0, top], Types.u64))
        g.nodes.set(id, copyNode(n, [store, base], 'after'))
    }
    return found
}

function bindCallContext(g: Graph, register: number): void {
    let context = 0
    const merged = new Map<number, number>()
    function explicitContext(ref: number, args: number): [target: number, context: Operand] | undefined {
        const n = g.nodes.get(ref)
        if (n?.op === 'after') {
            const inner = explicitContext(getRef(n, countIds(n) - 1), args)
            if (!inner) return
            const ordered = g.maxId++
            g.nodes.set(ordered, copyNode(n, [...getOperands(n, 0, countIds(n) - 1), inner[0]]))
            return [ordered, inner[1]]
        }
        if (n?.op !== 'indirect-target' || countIds(n) !== 2) return
        const fnType = g.nodes.get(typeRefOf(n))
        const signature = g.maxId++
        g.nodes.set(signature, gn.createFnType(fnType?.op === 'fn-type' ? gn.fnReturn(fnType) : typeOf(n), [...new Array<number>(args).fill(-1), register]))
        const target = g.maxId++
        g.nodes.set(target, makeNode('indirect-target', [getOperand(n, 0)], { ref: signature }))
        return [target, getOperand(n, 1)]
    }
    for (const [id, n] of [...g.nodes]) {
        const explicit = n.op === 'call' ? explicitContext(getRef(n, 1), countIds(n) - 3) : undefined
        if (explicit) g.nodes.set(id, copyNode(n, [getOperand(n, 0), explicit[0], ...getOperands(n, 2), explicit[1]]))
        if (n.op !== 'call-context') continue
        if (!context) context = id
        else merged.set(id, context)
    }
    if (!context) return
    g.nodes.set(context, gn.createLocatedParam(register))
    if (merged.size) for (const b of g.blocks) b.bodyId = replaceAll(g, b.bodyId, merged)
    g.blocks[0].params.push(context)
}

function expandCodecs(g: Graph): boolean {
    let found = false
    function node(op: string, ref: number, literal: number): number {
        const id = g.maxId++
        g.nodes.set(id, makeNode(op, [ref, { literal: literal }]))
        return id
    }
    const derefs = new Map<number, number[]>()
    const others = new Set<number>()
    for (const [id, n] of g.nodes) {
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref || g.nodes.get(ref)?.op !== 'decode') continue
            if (i !== 1 || (n.op !== 'load' && n.op !== 'store')) {
                others.add(ref)
                continue
            }
            const users = derefs.get(ref)
            if (users) users.push(id)
            else derefs.set(ref, [id])
        }
    }
    for (const [id, n] of [...g.nodes]) {
        if (n.op === 'box') {
            g.nodes.set(id, makeNode('shl', [getOperand(n, 0), { literal: 1 }], Types.i64))
            found = true
            continue
        }
        if (n.op === 'unbox') {
            const word = g.maxId++
            g.nodes.set(word, makeNode('convert', [getOperand(n, 0)], Types.i32))
            g.nodes.set(id, makeNode('shr', [word, { literal: 1 }], Types.i64))
            found = true
            continue
        }
        if (n.op !== 'encode' && n.op !== 'decode') continue
        const value = getRef(n, 0)
        const base = getLiteral(n, 1)
        assert(!getRef(n, 1) && base >= 0, `lowering: ${n.op} %${id} needs a constant heap base`)
        const coded = n.op === 'decode'
            ? node('add', node('ushr', value, 1), base)
            : node('add', node('shl', value, 1), 1 - 2 * base)
        // TODO: in debug panic on a null handle instead of UB
        for (const user of others.has(id) ? [] : derefs.get(id) ?? []) {
            const u = g.nodes.get(user)!
            const operands = getOperands(u)
            operands[1] = coded
            g.nodes.set(user, copyNode(u, operands))
        }
        g.nodes.set(id, nonZero(g, value, 0, []) ? copyNode(g.nodes.get(coded)!) : makeNode('select', [value, coded, 0]))
        found = true
    }
    return found
}

function shareLiterals(g: Graph, costs: lowering.TargetCosts): void {
    const members = g.blocks.map(b => {
        const seen = new Set<number>()
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? g.nodes.get(id) : undefined
            if (!n || seen.has(id) || n.op === 'block' || n.op === 'param') continue
            seen.add(id)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return seen
    })
    const shared = new Map<number, number>()
    for (const seen of members) for (const id of seen) shared.set(id, (shared.get(id) ?? 0) + 1)
    for (const seen of members) {
        const counts = new Map<number, number>()
        const sites: [id: number, slot: number][] = []
        for (const id of seen) {
            if (shared.get(id)! > 1) continue
            const n = g.nodes.get(id)!
            for (let slot = 0; slot < countIds(n); slot++) {
                if (getRef(n, slot) || !liftableSlot(n.op, slot)) continue
                const value = getLiteral(n, slot)
                if (inlineableLiteral(costs, value)) continue
                counts.set(value, (counts.get(value) ?? 0) + 1)
                sites.push([id, slot])
            }
        }
        const made = new Map<number, number>()
        for (const [id, slot] of sites) {
            const n = g.nodes.get(id)!
            const value = getLiteral(n, slot)
            if (counts.get(value)! < 2) continue
            let lifted = made.get(value)
            if (lifted === undefined) {
                lifted = g.maxId++
                g.nodes.set(lifted, makeNode('literal', [{ literal: value }]))
                made.set(value, lifted)
            }
            setRef(n, slot, lifted)
        }
    }
}

export function analyzeValueGraph(g: Graph, opts?: LowerGraphOptions) {
    const usedBy = new Map<number, number[]>()
    const demands = new Map<number, Set<number>>()
    const dependencies = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) {
            let arr = usedBy.get(to)
            if (!arr) usedBy.set(to, arr = [])
            arr.push(from)
            let d = demands.get(from)
            if (!d) demands.set(from, d = new Set())
            d.add(to)
        }
        let set = dependencies.get(from)
        if (!set) dependencies.set(from, set = new Set())
        set.add(to)
    }

    const inArgPos = new Map<number, [parent: number, idx: number][]>()
    const inStatePos = new Map<number, [parent: number, idx: number][]>()
    const returnsAt = new Map<number, number>()

    const blockBodyValues = new Map<number, number[]>()
    const hasCallEffects = new Set<number>()

    function getGraphBlock(id: number) {
        const b = getBlock(g, id)
        assert(b)
        return b
    }

    const { tailTargets, loopsOf, loopMembers, loopDepth } = graphLoops(g)
    const frameAllocas = layoutAllocas()

    function layoutAllocas(): number {
        const allocas: number[] = []
        for (const [id, n] of g.nodes) if (n.op === 'alloca') allocas.push(id)
        if (!allocas.length) return framed()
        const paramAt = new Map<number, [block: number, index: number]>()
        for (const b of g.blocks) b.params.forEach((p, i) => paramAt.set(p, [b.id, i]))
        function loopCarried(id: number): boolean {
            for (;;) {
                const n = g.nodes.get(id)
                if (!n) return false
                if (n.op === 'param') return !!loopDepth.get(paramAt.get(id)?.[0] ?? -1)
                if (n.op !== 'alloca') return false
                id = getRef(n, 0)
            }
        }
        for (const b of g.blocks) {
            if (!loopDepth.get(b.id)) continue
            const seen = new Set<number>()
            const pending = [b.bodyId]
            while (pending.length) {
                const id = pending.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const n = g.nodes.get(id)
                if (!n || n.op === 'block' || n.op === 'param') continue
                if (n.op === 'alloca' && loopCarried(getRef(n, 0))) throw `lowering: alloca %${id} is evaluated inside the loop at B${b.id}`
                for (let i = 0; i < countIds(n); i++) pending.push(getRef(n, i))
            }
        }
        for (const [id, n] of g.nodes) {
            if (n.op !== 'ret') continue
            let value = getRef(n, 0)
            let m = g.nodes.get(value)
            while (m?.op === 'after') {
                value = getRef(m, countIds(m) - 1)
                m = g.nodes.get(value)
            }
            if (g.nodes.get(value)?.op === 'alloca') throw `lowering: alloca %${value} escapes through ret %${id}`
        }
        const offsets = new Map<number, number>()
        let reserved = 0
        for (const id of allocas) {
            const n = g.nodes.get(id)!
            assert(getRef(n, 0), `lowering: alloca %${id} has no ordering`)
            const align = getLiteral(n, 2)
            const at = (reserved + align - 1) & ~(align - 1)
            offsets.set(id, at)
            reserved = at + getLiteral(n, 1)
        }
        for (const id of allocas) {
            const size = getLiteral(g.nodes.get(id)!, 1)
            g.nodes.set(id, makeNode('frame-address', [{ literal: offsets.get(id)! }, { literal: size }]))
        }
        return framed()
    }

    function framed(): number {
        let bytes = 0
        for (const n of g.nodes.values()) {
            if (n.op === 'frame-address') bytes = Math.max(bytes, getLiteral(n, 0) + getLiteral(n, 1))
        }
        return (bytes + 15) & ~15
    }
    
    const callProjections = new Map<number, number[]>()
    function addCallProj(target: number, consumer: number) {
        let arr = callProjections.get(target)
        if (!arr) callProjections.set(target, arr = [])
        arr.push(consumer)
    }

    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reverseOrder = new Map<number, number>()
    const incoming = new Map<number, number[]>()
    const cycleChildren = new Map<number, Set<number>>()
    const applyOwner = new Map<number, number>()
    function enterBlock(b: GraphBlock): void {
        visited.set(b.id, visited.size)
        {
            blockStack.push(b)
            defer blockStack.pop()
            assert(!blockBodyValues.has(b.id))
            blockBodyValues.set(b.id, [])
            for (const x of b.params) {
                visit(x, false, true)
            }
            visit(b.bodyId, false)
        }
    }
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        const n = g.nodes.get(id)!
        if (n.op === 'nil-effect') return
        if (n.op === 'void') return
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (visited.has(id)) return
        visited.set(id, visited.size)
        stack.push(id)
        defer stack.pop()

        const valId = id
        defer {
            reverseOrder.set(valId, reverseOrder.size)
            if (blockStack.length) {
                const blockId = blockStack[blockStack.length-1].id
                if (n && n.op !== 'param') {
                    blockBodyValues.get(blockId)!.push(valId)
                }
            }
        }

        if (!countIds(n)) return

        if (n.op === 'after') {
            const result = countIds(n) - 1
            for (let i = 0; i < result; i++) visit(getRef(n, i), false)
            visit(getRef(n, result), true)
            return
        }
        if (n.op === 'call' || n.op === 'store' || n.op === 'load') {
            visit(getRef(n, 0), false)
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            if (n.op === 'call') {
                hasCallEffects.add(id)
                if (blockStack.length) {
                    hasCallEffects.add(blockStack[blockStack.length-1].id)
                }
                const target = g.nodes.get(getRef(n, 1))
                if (target?.op === 'indirect-target') {
                    for (let i = 0; i < countIds(target); i++) if (getRef(target, i)) recordEdge(id, getRef(target, i), true)
                }
            }
            return
        }
        if (n.op === 'apply') {
            const b = getGraphBlock(getRef(n, 0))
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            let into = incoming.get(b.id)
            if (!into) incoming.set(b.id, into = [])
            into.push(id)
            applyOwner.set(id, blockStack[blockStack.length-1].id)
            if (!blockStack.includes(b) && tailTargets.get(b.id)!.length) {
                for (const x of blockStack) {
                    if (!loopMembers.has(x.id)) continue
                    let s = cycleChildren.get(x.id)
                    if (!s) cycleChildren.set(x.id, s = new Set())
                    s.add(b.id)
                }
            }
            if (visited.has(b.id)) return
            enterBlock(b)
            return
        }
        if (n.op === 'get') {
            const t = getRef(n, 0)
            if (t !== 0 && g.nodes.get(t)!.op === 'call') {
                addCallProj(t, id)
            }
        }
        for (const x of getArgIds(n)) {
            if (!x) continue
            visit(x, true)
        }
    }
    visited.set(0, 0)
    blockStack.push(g.blocks[0])
    blockBodyValues.set(g.blocks[0].id, [])
    const bodyId = g.blocks[0].bodyId
    if (bodyId) visit(bodyId, false)

    const releaseAt = new Map<number, Map<number, Set<number>>>()
    const narrowsAt = new Map<number, Set<number>>()

    // BAGGAGE CLAIM
    const shouldSpillUntil = new Map<number, number>()
    const crossedCalls = new Map<number, Set<number>>()
    const visitOrder = new Map<number, number>()
    const operandOrder = new Map<number, number[]>()
    {
        const tmp = new Set<number>()
        interface ClaimState {
            live: Set<number>
            seen: Set<number>
            done: Set<number>
            excluded: Set<number>
            crosses: Map<number, Set<number>>
            region: number
        }
        function initState(save?: ClaimState): ClaimState {
            return {
                live: new Set(save?.live),
                seen: new Set(save?.seen),
                done: new Set(save?.done),
                excluded: new Set(save?.excluded),
                crosses: new Map(save?.crosses),
                region: save?.region ?? 0,
            }
        }
        let state = initState()
        function addCross(spilled: number, crossed: number, targetState = state) {
            let s = targetState.crosses.get(spilled)
            if (!s) targetState.crosses.set(spilled, s = new Set())
            s.add(crossed)
        }
        function getNewBaggage(root: number, clearTmp = true): number {
            if (clearTmp) tmp.clear()
            const allUses: number[][] = []
            function visit(id: number) {
                if (!id) return 0
                if (state.seen.has(id) || tmp.has(id) || state.excluded.has(id)) return 0
                tmp.add(id)
                const uses = usedBy.get(id)?.filter(x => !state.seen.has(x) && !state.excluded.has(x))
                if (uses?.length) allUses.push(uses)
                const n = g.nodes.get(id)
                if (!n) return
                for (let i = 0; i < countIds(n); i++) {
                    visit(getRef(n, i))
                }
            }
            visit(root)
            let c = 0
            for (const arr of allUses) {
                if (arr.some(x => !tmp.has(x))) c += 1
            }
            return c
        }
        function selectBaggage(selectId: number, u: GraphNode, isTail = true) {
            assert(u.op === 'select')

            tmp.clear()
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (!a) continue
                getNewBaggage(a, false)
            }
            if (!tmp.size) return

            const newlySeen = new Set(tmp)
            newlySeen.add(selectId)
            const joinState = initState()
            const joinDead = new Set<number>()

            {
                const saveState = state
                defer state = saveState

                for (let i = 1; i < countIds(u); i++) {
                    const a = getRef(u, i)
                    if (!a || saveState.seen.has(a)) continue
                    let excl: Set<number>
                    {
                        state = saveState
                        getNewBaggage(a)
                        assert(tmp.size)
                        const excluded = new Set(newlySeen)
                        for (const x of tmp) {
                            excluded.delete(x)
                        }
                        for (const x of saveState.excluded) {
                            excluded.add(x)
                        }
                        excl = excluded
                    }
                    const unused = new Set<number>()
                    state = initState(saveState)
                    state.excluded = excl
                    state.region = a
                    for (const x of state.live) {
                        if (allUsesDone(usedBy.get(x))) {
                            state.live.delete(x)
                            unused.add(x)
                        }
                    }
                    if (unused.size) narrowsAt.set(a, unused)
                    scheduleFrom(a, true)
                    for (const [k, s] of state.crosses) {
                        for (const v of s) addCross(k, v, joinState)
                    }
                    if (!isTail) {
                        for (const x of state.live) joinState.live.add(x)
                        for (const x of state.done) joinState.done.add(x)
                        for (const x of saveState.live) {
                            if (!state.live.has(x)) joinDead.add(x)
                        }
                    }
                }
            }

            if (!isTail) {
                for (const id of newlySeen) state.seen.add(id)
                for (const id of joinState.done) state.done.add(id)
                for (const id of joinState.live) state.live.add(id)
                for (const id of joinDead) state.live.delete(id)
            }
            for (const [k, s] of joinState.crosses) {
                for (const v of s) addCross(k, v)
            }
        }

        function findSchedule(n: GraphNode) {
            const args = getArgIds(n)
            const pinned = n.op === 'after' ? args.length - 1 : -1
            const calls = new Array(countIds(n)) as boolean[]
            for (let i = 0; i < countIds(n); i++) calls[i] = false
            const baggage = args.map((x, i) => {
                if (i === pinned) return 0
                const b = getNewBaggage(x)
                for (const id of tmp) {
                    if (!hasCallEffects.has(id)) continue
                    calls[i] = true
                    break
                }
                return b
            })
            const order = args.map((_, i) => i).filter(i => i !== pinned).sort((a, b) => {
                if (calls[a] === calls[b]) {
                    return baggage[a] - baggage[b]
                }
                return calls[a] ? -1 : 1
            })
            if (pinned >= 0) order.push(pinned)
            return order
        }
        function updateLiveAfter(id: number, partial?: number) {
            if (const d = demands.get(id)) {
                for (const x of d) {
                    if (!state.live.has(x)) continue
                    if (partial && x !== partial) continue
                    const uses = usedBy.get(x)!
                    if (partial && uses.indexOf(id) !== uses.lastIndexOf(id)) continue
                    if (!allUsesDone(uses, id)) continue
                    releaseFrom(id, x)
                }
            }
        }
        function releaseFrom(user: number, target: number) {
            if (!state.excluded.has(target)) {
                let sites = releaseAt.get(state.region)
                if (!sites) releaseAt.set(state.region, sites = new Map())
                let s = sites.get(user)
                if (!s) sites.set(user, s = new Set())
                s.add(target)
            }
            state.live.delete(target)
        }
        function materialize(id: number, partial?: number) {
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            state.done.add(id)
            updateLiveAfter(id, partial)
        }
        function allUsesDone(uses: number[] | undefined, from?: number) {
            if (!uses) return true
            const len = uses.length
            for (let i = 0; i < len; i++) {
                const v = uses[i]
                if (!v) continue
                if (v === from) continue
                if (!state.done.has(v) && !state.excluded.has(v)) {
                    return false
                }
            }
            return true
        }
        function scheduleFrom(id: number, tail = false) {
            if (!id) return
            if (state.seen.has(id)) {
                if (state.live.has(id)) {
                    if (allUsesDone(usedBy.get(id))) {
                        state.live.delete(id)
                    }
                }
                return
            }
            state.seen.add(id)
            const u = g.nodes.get(id)
            assert(u)
            if (u.op === 'select' && tail) {
                operandOrder.set(id, [0, 1, 2])
                scheduleFrom(getRef(u, 0))
                materialize(id, getRef(u, 0))
                selectBaggage(id, u)
                return
            }
            const order = findSchedule(u)
            operandOrder.set(id, order)
            for (const idx of order) {
                const t = tail && ((u.op === 'after' && idx === countIds(u)-1) || (u.op === 'ret' && idx === 0))
                scheduleFrom(getRef(u, idx), t)
            }
            if (const q = visitOrder.get(id)) {
                visitOrder.set(id, Math.min(q, state.done.size))
            } else {
                visitOrder.set(id, state.done.size)
            }
            if (u.op === 'apply' || u.op === 'ret') {
                materialize(id)
                for (const x of [...state.live]) releaseFrom(id, x)
                return
            }
            if (!hasCallEffects.has(id)) return materialize(id)
            updateLiveAfter(id)
            for (const x of state.live) {
                if (rebuildable(g, x)) continue
                // if (const p = dominatingParent(x, id)) {
                //     addCross(p, id)
                //     continue
                // }
                addCross(x, id)
            }
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            state.done.add(id)
        }
        // function dominatingParent(id: number, cur: number) {
        //     if (state.crosses.has(id)) return
        //     let found: number | undefined
        //     for (const x of usedBy.get(id) ?? []) {
        //         if (x === cur) continue
        //         if (state.excluded.has(x)) continue
        //         if (!state.live.has(x)) continue
        //         if (found) return
        //         found = x
        //     }
        //     return found
        // }
        function scheduleFromBlock(b: GraphBlock) {
            assert(b.bodyId)
            for (const p of b.params) {
                state.live.add(p)
                state.seen.add(p)
            }
            scheduleFrom(b.bodyId, true)
            state.live.clear()
        }
        for (const b of g.blocks) state.seen.add(b.id)
        for (const b of g.blocks) {
            if (!b.bodyId) continue
            scheduleFromBlock(b)
        }
        const seenForSpill = new Set<number>()
        function visitForSpill(id: number, crossed: Set<number>) {
            if (seenForSpill.has(id)) return
            seenForSpill.add(id)
            const uses = usedBy.get(id)
            if (!uses) return
            let last = 0
            let best = -1
            for (const call of crossed) {
                const rank = visitOrder.get(call) ?? -1
                if (rank > best) { best = rank; last = call }
            }
            if (!last) return
            shouldSpillUntil.set(id, last)
        }
        for (const res of state.crosses) {
            visitForSpill(res[0], res[1])
            crossedCalls.set(res[0], res[1])
        }
        if (opts?.debug) {
            const claimed = [...visitOrder]
            claimed.sort((a, b) => a[1] - b[1])
            console.log('claim order', claimed.map(x => x[0]).join(' '))
        }
    }

    const rotated = new Map<number, number>()
    const pure = pureValues(g)
    for (const [header, members] of loopMembers) {
        const select = getGraphBlock(header).bodyId
        const n = g.nodes.get(select)
        if (n?.op !== 'select') continue
        const stays = g.nodes.get(tailOf(g, getRef(n!, 1)))
        if (stays?.op !== 'apply' || !members.has(getRef(stays!, 0))) continue
        if (!rotateAnyLoop && (getRef(stays!, 0) !== header || cycleChildren.has(header))) continue
        const exits = tailPositions(g, getRef(n!, 2)).map(p => g.nodes.get(p.at)!).filter(t => t.op === 'apply')
        if (exits.some(t => members.has(getRef(t, 0)))) continue
        rotated.set(select, header)
    }
    const rotatedHeaders = new Set(rotated.values())
    const reached = [...blockBodyValues.keys()]
    const blockOrder: number[] = []
    const succ = new Map<number, number[]>()
    const post: number[] = []
    {
        const open = new Set<number>()
        const done = new Set<number>()
        function search(id: number): void {
            open.add(id)
            const out: number[] = []
            succ.set(id, out)
            for (const t of tailTargets.get(id)!) {
                if (open.has(t)) continue
                if (!out.includes(t)) out.push(t)
                if (!done.has(t)) search(t)
            }
            open.delete(id)
            done.add(id)
            post.push(id)
        }
        search(g.blocks[0].id)
    }
    const rpo = new Map<number, number>()
    for (let i = 0; i < post.length; i++) rpo.set(post[i], post.length - 1 - i)
    const chainOf = new Map<number, number[]>()
    const chains: number[][] = []
    for (const id of post) {
        const chain = [id]
        chains.push(chain)
        chainOf.set(id, chain)
    }
    const odds = hotCold(g, { tailTargets, loopsOf, loopMembers, loopDepth })
    const hotArm = odds.hotArm
    function prefer(from: number, a: number, b: number): number {
        const ca = odds.targets.get(from)?.get(a) ?? Infinity
        const cb = odds.targets.get(from)?.get(b) ?? Infinity
        if (ca !== cb) return ca < cb ? 1 : -1
        return (loopDepth.get(a) ?? 0) - (loopDepth.get(b) ?? 0) || rpo.get(b)! - rpo.get(a)!
    }
    for (const single of [true, false]) {
        for (const id of post) {
            if ((new Set(tailTargets.get(id)).size === 1) !== single) continue
            const mine = chainOf.get(id)!
            let next: number[] | undefined
            for (const t of succ.get(id)!) {
                const chain = chainOf.get(t)!
                if (chain[0] !== t || chain === mine || rotatedHeaders.has(t)) continue
                if (!next || prefer(id, t, next[0]) > 0) next = chain
            }
            if (!next) continue
            for (const x of next) {
                mine.push(x)
                chainOf.set(x, mine)
            }
            chains.splice(chains.indexOf(next), 1)
        }
    }
    const entry = chainOf.get(g.blocks[0].id)!
    const returns = (c: number[]) => !tailTargets.get(c[c.length - 1])!.length
    chains.sort((a, b) => {
        if (a === entry || b === entry) return a === entry ? -1 : 1
        if (returns(a) !== returns(b)) return returns(a) ? 1 : -1
        if (returns(a) && a.length !== b.length) return b.length - a.length
        return rpo.get(a[0])! - rpo.get(b[0])!
    })
    for (const c of chains) for (const id of c) blockOrder.push(id)
    for (const id of reached) if (!chainOf.has(id)) blockOrder.push(id)
    const fallsIn = new Set<number>()
    for (let i = 1; i < blockOrder.length; i++) {
        if (tailTargets.get(blockOrder[i - 1])?.includes(blockOrder[i])) fallsIn.add(blockOrder[i])
    }
    const position = new Map<number, number>()
    for (let i = 0; i < blockOrder.length; i++) position.set(blockOrder[i], i)
    const forwardOf = (from: number, to: number) => (position.get(to) ?? -1) > (position.get(from) ?? -1)
    const coldArm = new Map<number, number>()
    const firstArm = new Map<number, number>()
    const emitIndex = new Map<number, number>()
    const tailUses = new Map<number, number>()
    {
        function forward(arm: number, owner: number): boolean {
            const t = g.nodes.get(tailOf(g, arm))
            if (!t) return true
            if (t.op === 'apply') return forwardOf(owner, getRef(t, 0))
            if (t.op !== 'select') return true
            const inner = hotArm.get(tailOf(g, arm))
            if (inner) return forward(getRef(t, inner), owner)
            for (let i = 1; i < countIds(t); i++) if (!forward(getRef(t, i), owner)) return false
            return true
        }
        function into(arm: number, next: number | undefined): boolean {
            return tailPositions(g, arm).some(p => g.nodes.get(p.at)!.op === 'apply' && getRef(g.nodes.get(p.at)!, 0) === next)
        }
        function visit(id: number, owner: number, next: number | undefined): void {
            const at = tailOf(g, id)
            const n = g.nodes.get(at)
            if (n?.op === 'apply') {
                emitIndex.set(at, emitIndex.size)
                tailUses.set(at, (tailUses.get(at) ?? 0) + 1)
            }
            if (n?.op !== 'select') return
            let first = 1
            if (!rotated.has(at)) {
                const hot = hotArm.get(at)
                if (hot && g.nodes.get(getRef(n, 3 - hot))?.op === 'apply' && forward(getRef(n, hot), owner)) {
                    coldArm.set(at, 3 - hot)
                    first = hot
                } else if (into(getRef(n, 1), next) && !into(getRef(n, 2), next)) first = 2
                firstArm.set(at, first)
            }
            visit(getRef(n, first), owner, next)
            for (let i = 1; i < countIds(n); i++) if (i !== first) visit(getRef(n, i), owner, next)
        }
        for (let i = 0; i < blockOrder.length; i++) visit(getGraphBlock(blockOrder[i]).bodyId, blockOrder[i], blockOrder[i + 1])
    }
    function carriesCode(app: number): boolean {
        const n = g.nodes.get(app)!
        const own = getGraphBlock(applyOwner.get(app)!).params
        for (let i = 1; i < countIds(n); i++) if (!own.includes(getRef(n, i))) return true
        return false
    }
    const sinks = new Set<number>()
    for (const [target, arrivals] of incoming) {
        if (rotatedHeaders.has(target) || (arrivals.length !== 1 && fallsIn.has(target))) continue
        const candidates = arrivals.filter(app => tailUses.get(app) === 1 && (usedBy.get(app)?.length ?? 0) <= 1 && forwardOf(applyOwner.get(app)!, target))
        let pick = 0
        if (arrivals.length === 1) pick = candidates[0] ?? 0
        else for (const app of candidates) {
            if (!carriesCode(app)) continue
            // FIXME: change hot/cold to use integers, not floats?
            const c = odds.arrivals.get(app) ?? Infinity
            const best = pick ? odds.arrivals.get(pick) ?? Infinity : Infinity
            if (!pick || c < best || (c === best && emitIndex.get(app)! < emitIndex.get(pick)!)) pick = app
        }
        if (pick) sinks.add(pick)
        if (intrinsics.argv().includes(`odds-debug:${g.name}`)) console.log('ODDS sink', `B${target}`, arrivals.map(a => `%${a}@B${applyOwner.get(a)}=${odds.arrivals.get(a) ?? Infinity}`).join(' '), '->', pick ? `%${pick}` : 'none')
    }
    if (placementProbe || intrinsics.argv().includes(`block-placement:${g.name}`)) {
        sweepBlocks(g)
        const epoch = nextEpoch(g)
        let selects = 0
        function countSelects(x: number): void {
            const n = g.nodes.get(x)
            if (!n || !markVisited(n, epoch)) return
            if (n.op === 'after') return countSelects(getRef(n, countIds(n) - 1))
            if (n.op !== 'select') return
            selects++
            for (let i = 1; i < countIds(n); i++) countSelects(getRef(n, i))
        }
        for (const id of blockOrder) countSelects(getGraphBlock(id).bodyId)
        const stranded: string[] = []
        let falls = 0
        for (let i = 1; i < blockOrder.length; i++) {
            const id = blockOrder[i]
            const prev = blockOrder[i - 1]
            if (tailTargets.get(prev)?.includes(id)) { falls++; continue }
            const from = new Set((incoming.get(id) ?? []).map(app => applyOwner.get(app)!))
            const adjacent = [...from].some(x => blockOrder.indexOf(x) < i)
            stranded.push(`B${id} preds=${from.size} prev=B${prev}${adjacent ? '' : ' (no earlier pred)'}`)
        }
        const backEdges = new Set<string>()
        {
            const onStack = new Set<number>()
            const done = new Set<number>()
            function walk(id: number): void {
                onStack.add(id)
                for (const t of tailTargets.get(id) ?? []) {
                    if (onStack.has(t)) { backEdges.add(`B${id}->B${t}`); continue }
                    if (!done.has(t)) walk(t)
                }
                onStack.delete(id)
                done.add(id)
            }
            walk(g.blocks[0].id)
        }
        const target = blockOrder.length - selects - 1
        for (const x of stranded) console.log('PLACEMENT', g.name ?? '<anonymous>', x)
        console.log('PLACEMENT', g.name ?? '<anonymous>', 'chains',
            chains.map(c => `[${c.join(',')}]`).join(' '))
        console.log('PLACEMENT', g.name ?? '<anonymous>',
            `totals blocks=${blockOrder.length} selects=${selects} fallthrough=${falls}`,
            `target=${target} gap=${target - falls}`,
            `backEdges=${backEdges.size}${backEdges.size ? ` [${[...backEdges].join(' ')}]` : ''}`)
    }
    function notePos(into: Map<number, [parent: number, idx: number][]>, id: number, parent: number, idx: number): void {
        if (!id) return
        const at = into.get(id)
        if (at) at.push([parent, idx])
        else into.set(id, [[parent, idx]])
    }
    for (const [id, n] of g.nodes) {
        if (!visited.has(id)) continue
        if (n.op === 'call') {
            for (let k = 3; k < countIds(n); k++) notePos(inArgPos, getRef(n, k), id, k - 3)
        } else if (n.op === 'apply') {
            for (let k = 1; k < countIds(n); k++) notePos(inArgPos, getRef(n, k), id, k - 1)
        }
    }
    for (const b of g.blocks) {
        function tails(at: number): void {
            if (!at) return
            if (isParam(g.nodes, at)) { notePos(inStatePos, at, b.id, -1); return }
            const t = g.nodes.get(at)!
            if (t.op === 'select') {
                for (let i = 1; i < countIds(t); i++) tails(getRef(t, i))
                return 
            }
            if (t.op === 'after') { tails(getRef(t, countIds(t)-1)); return }
            if (t.op === 'ret') { tails(getRef(t, 0)); return }
            if (t.op === 'record') {
                for (let i = 1; i < countIds(t); i += 2) tails(getRef(t, i))
                return
            }
            if (t.op === 'apply') return
            notePos(inStatePos, at, b.id, -1)
        }
        tails(b.bodyId)
    }

    const callsUnderCache = new Map<number, Set<number>>()
    function callsUnder(id: number): Set<number> {
        const cached = callsUnderCache.get(id)
        if (cached) return cached
        const out = new Set<number>()
        callsUnderCache.set(id, out)
        if (hasCallEffects.has(id)) out.add(id)
        const deps = dependencies.get(id)
        if (deps) {
            for (const d of deps) {
                if (d === id) continue
                for (const c of callsUnder(d)) out.add(c)
            }
        }
        return out
    }

    function precedingValues(id: number, use: number): number[] {
        const n = g.nodes.get(use)
        if (n && n.op === 'select') {
            return precedingValues(id, getRef(n, 0))
        }
        const deps = dependencies.get(use)
        return deps ? [...deps] : []
    }

    for (const uses of usedBy.values()) {
        uses.sort((a, b) => (reverseOrder.get(a) ?? -1) - (reverseOrder.get(b) ?? -1))
    }
    for (const [id, uses] of usedBy) {
        const available = callsUnder(id)
        const crossed = new Set<number>()
        for (const use of uses) {
            for (const p of precedingValues(id, use)) {
                for (const c of callsUnder(p)) {
                    if (c === use || available.has(c)) continue
                    crossed.add(c)
                }
            }
        }
    }
    const effectivelyLinearBlocks = new Set<number>()
    for (const [k, v] of incoming) {
        if (v.length === 1) {
            effectivelyLinearBlocks.add(k)
            continue
        }
        const noback = v.filter(x => {
            const target = gn.getRef(g.nodes.get(x)!, 0)
            return target !== k
        })
        if (noback.length !== 1) continue
        for (const bid of rotated.values()) {
            if (k === bid) {
                effectivelyLinearBlocks.add(k)
                break
            }
        }
    }
    return {
        inArgPos,
        inStatePos,
        returnsAt,
        pure,
        shouldSpillUntil,
        crossedCalls,
        blockOrder,
        fallsIn,
        sinks,
        coldArm,
        firstArm,
        releaseAt,
        narrowsAt,
        applyOwner,
        usedBy,
        operandOrder,
        reverseOrder,
        callsUnderValue: callsUnderCache,
        rotated,
        callProjections,
        effectivelyLinearBlocks,
        frameAllocas,
    }
}

export function describeHeapHandle(n: GraphNode): string {
    if (n.op !== 'heap-handle' || countIds(n) !== 2 || getRef(n, 1)) return ''
    const target = getLiteral(n, 1) as intrinsics.Handle
    if (!target || !heap.isOrdinaryObject(target)) return ''
    const fields: string[] = []
    for (let i: u32 = 0; i < heap.ownPropertyCount(target); i++) {
        const key = heap.ownPropertyKeyAt(target, i)
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key)))
        const slot = d.slot0 as intrinsics.Handle
        let text = heap.isIndirect(slot) ? `*${slot}` : `@${slot}`
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) {
            text = '<accessor>'
        } else if (heap.isBoxedF64(slot)) {
            const value = heap.unboxF64(slot)
            const ref = intrinsics.getNanId(value)
            text = ref ? `%${ref}` : `#${value}`
        }
        fields.push(`${heap.isString(key) ? heap.stringToJs(key) : `@${key}`}: ${text}`)
    }
    return ` { ${fields.join(', ')} }`
}

function typeName(T: number): string {
    for (const key of Object.keys(Types)) if ((Types as any)[key] === T) return key
    return `T${T}`
}

function describeType(g: Graph, T: TypeOperand): string {
    if (typeof T === 'number') return typeName(T)
    const t = g.nodes.get(T.ref)
    if (t?.op === 'fn-type') return `fn -> ${describeType(g, gn.fnReturn(t))}`
    if (t?.op === 'record-type') {
        const fields = recordFields(t).map(f => `${heap.isString(f.key as u32) ? heap.stringToJs(f.key as u32) : f.key}: ${describeType(g, f.type)}`)
        return `{ ${fields.join(', ')} }`
    }
    return `%${T.ref}`
}

export function dumpGraph(g: Graph): string {
    const out: string[] = []
    const showTypes = intrinsics.argv().includes('graph-types')
    if (g.name) {
        out.push(`--- vgraph for ${g.name} ---`)
    }
    for (const b of g.blocks) {
        const params = b.params.map(p => {
            const at = g.nodes.get(p) ? gn.paramLocation(g.nodes.get(p)!) : -1
            return at < 0 ? `${p}` : `${p}@r${at}`
        })
        out.push(`B${b.id}(${params.join(', ')}) -> ${b.bodyId || b.bodyConst}`)
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'param' || n.op === 'block') return // noisy
            for (const a of getArgIds(n)) walk(a)
            const parts: string[] = []
            for (let i = 0; i < countIds(n); i++) {
                const cid = getRef(n, i)
                let missing = false
                if (cid) {
                    if (const c = g.nodes.get(cid)) {
                        if (c.op === 'block') {
                            parts.push(`B${cid}`)
                            continue
                        }
                    } else {
                        missing = true
                    }
                }
                parts.push(cid ? `%${cid}${missing ? '?' : ''}` : `#${getLiteral(n, i)}`)
            }
            if (n.op === 'get' && !getLiteral(n, 2)) {
                const key = getLiteral(n, 1)
                if (heap.isString(key as u32)) {
                    parts.pop()
                    parts.push(`"${heap.stringToJs(key as u32)}"`)
                }
            }
            const label = getDebugLabel(g, id)
            const shown = n.op === 'rt' ? [parts[0], ...parts.slice(2)] : parts
            const typed = showTypes && typeSlots(n.op) ? ` : ${describeType(g, typeRefOf(n) ? { ref: typeRefOf(n) } : typeOf(n))}` : ''
            out.push(`  %${id} = ${n.op === 'rt' ? `rt.${rt.opName(getLiteral(n, 1))}` : n.op} ${shown.join(' ')}${typed}${describeHeapHandle(n)}${label ? '    ; ' + label : ''}`)
        }
        walk(b.bodyId)
    }
    return out.join('\n')
}

export function dumpBlockGraph(g: Graph): string {
    const successors = new Map<number, number[]>()
    const blockIds = new Set<number>(g.blocks.map(b => b.id))
    for (const b of g.blocks) {
        const found = new Set<number>()
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'block') {
                if (blockIds.has(id)) found.add(id)
                return
            }
            for (const arg of getArgIds(n)) walk(arg)
        }
        walk(b.bodyId)
        successors.set(b.id, [...found])
    }

    const out: string[] = []
    if (g.name) out.push(`--- blocks for ${g.name} ---`)
    const expanded = new Set<number>()
    const active = new Set<number>()
    function render(id: number, prefix = '', branch = ''): void {
        if (active.has(id)) {
            out.push(`${prefix}${branch}B${id} (cycle)`)
            return
        }
        if (expanded.has(id)) {
            out.push(`${prefix}${branch}B${id} (seen)`)
            return
        }
        out.push(`${prefix}${branch}B${id}`)
        expanded.add(id)
        active.add(id)
        const next = successors.get(id) ?? []
        for (let i = 0; i < next.length; i++) {
            const last = i === next.length - 1
            render(next[i], prefix + (branch ? branch === '`-- ' ? '    ' : '|   ' : ''), last ? '`-- ' : '|-- ')
        }
        active.delete(id)
    }

    if (g.blocks.length) render(g.blocks[0].id)
    for (const b of g.blocks) {
        if (expanded.has(b.id)) continue
        if (out.length) out.push('')
        render(b.id)
    }
    return out.join('\n')
}

interface MiniBlock {
    key: number
    inputs: number[]
}

interface OutlineBlock {
    block: GraphBlock
    uses: Map<number, number>
    tails: number[]
    cut: Map<string, MiniBlock>
    closed: Map<string, MiniBlock>
    below: Map<number, Set<number>>
}

// XXX: need to refactor graph nodes, zzz...
function smuggledOperands(n: GraphNode): string {
    return typeSlots(n.op) ? `:${typeOf(n)}` : ''
}

function isArgless(n: GraphNode): boolean {
    if (n.op === 'param') return false
    for (const x of getArgIds(n)) if (x) return false
    return true
}

function outlineBlocks(g: Graph): Graph {
    const interned = new Map<string, number>()
    function intern(s: string): number {
        let k = interned.get(s)
        if (k === undefined) interned.set(s, k = interned.size + 1)
        return k
    }

    const infos = new Map<number, OutlineBlock>()
    const postOrder: OutlineBlock[] = []
    const appliesTo = new Map<number, number[]>()
    function enter(b: GraphBlock): void {
        if (infos.has(b.id)) return
        const info: OutlineBlock = { block: b, uses: new Map(), tails: [b.bodyId], cut: new Map(), closed: new Map(), below: new Map() }
        infos.set(b.id, info)
        const successors: number[] = []
        const epoch = nextEpoch(g)
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id) continue
            const n = g.nodes.get(id)
            if (!n || !markVisited(n, epoch)) continue
            if (n.op === 'apply') {
                successors.push(getRef(n, 0))
                let arr = appliesTo.get(getRef(n, 0))
                if (!arr) appliesTo.set(getRef(n, 0), arr = [])
                arr.push(id)
            }
            for (const x of getArgIds(n)) {
                if (!x) continue
                info.uses.set(x, (info.uses.get(x) ?? 0) + 1)
                stack.push(x)
            }
        }
        for (const id of info.tails) {
            const n = g.nodes.get(id)
            const next = n?.op === 'select' ? cloneRefs(n, 1) : n?.op === 'after' ? cloneRefs(n, -1) : []
            for (const x of next) if (x && info.uses.get(x) === 1) info.tails.push(x)
        }
        for (const s of successors) enter(getBlock(g, s)!)
        postOrder.push(info)
    }

    const classOf = new Map<number, number>()
    function isInput(info: OutlineBlock, id: number, cut: boolean): boolean {
        const n = g.nodes.get(id)!
        return n.op === 'param' || (cut && !isArgless(n) && !hasStructuredTail(g, id) && info.uses.get(id)! > 1)
    }
    function truncated(id: number, depth: number): boolean {
        return depth <= 1 && !isArgless(g.nodes.get(id)!) && !hasStructuredTail(g, id)
    }
    function indexIn(inputs: number[], x: number): number {
        let i = inputs.indexOf(x)
        if (i < 0) inputs.push(x), i = inputs.length - 1
        return i
    }
    function mini(info: OutlineBlock, id: number, cut: boolean, depth = Infinity, conditional = false): MiniBlock {
        const memo = cut ? info.cut : info.closed
        const memoKey = `${id}:${depth}:${conditional}`
        const known = memo.get(memoKey)
        if (known) return known
        const n = g.nodes.get(id)!
        const orders = Commutative.has(n.op) && countIds(n) === 2 ? [[0, 1], [1, 0]]
            : n.op === 'apply' ? [applyOrder(n)] : [getArgIds(n).map((_, i) => i)]
        let best: { text: string, inputs: number[] } | undefined
        for (const order of orders) {
            const inputs: number[] = []
            const parts: string[] = []
            for (const i of order) {
                const x = getRef(n, i)
                const u = x ? g.nodes.get(x) : undefined
                const arm = conditional || (n.op === 'select' && i > 0)
                if (!u) parts.push(`#${getLiteral(n, i)}`)
                else if (u.op === 'param' || (!arm && (isInput(info, x, cut) || truncated(x, depth)))) parts.push(`$${indexIn(inputs, x)}`)
                else if (isArgless(u)) parts.push(u.op === 'block' ? `B${classOf.get(x) ?? `#${x}`}` : `${u.op}:${getArgConsts(u).join()}`)
                else if (cut && arm && info.uses.get(x)! > 1) parts.push(`!${x}`)
                else {
                    const m = mini(info, x, cut, arm ? Infinity : depth - 1, cut && arm)
                    const mapped: number[] = []
                    for (const y of m.inputs) mapped.push(indexIn(inputs, y))
                    parts.push(`${m.key}[${mapped.join()}]`)
                }
            }
            const text = `${n.op}${smuggledOperands(n)}(${parts.join(' ')})`
            if (!best || text < best.text) best = { text, inputs }
        }
        const out = { key: intern(best!.text), inputs: best!.inputs }
        memo.set(memoKey, out)
        return out
    }
    const applyOrders = new Map<number, number[]>()
    function applyOrder(n: GraphNode): number[] {
        const target = infos.get(getRef(n, 0))
        if (!target || !classOf.has(target.block.id)) return getArgIds(n).map((_, i) => i)
        const known = applyOrders.get(target.block.id)
        if (known) return known
        const params = target.block.params
        const inputs = mini(target, target.block.bodyId, false).inputs.map(p => params.indexOf(p) + 1)
        const rest = params.map((_, i) => i + 1).filter(i => !inputs.includes(i))
        const order = [0, ...inputs, ...rest]
        applyOrders.set(target.block.id, order)
        return order
    }
    function below(info: OutlineBlock, id: number): Set<number> {
        const known = info.below.get(id)
        if (known) return known
        const out = new Set<number>()
        info.below.set(id, out)
        for (const x of getArgIds(g.nodes.get(id)!)) {
            const u = x ? g.nodes.get(x) : undefined
            if (!u || u.op === 'param' || isArgless(u)) continue
            out.add(x)
            for (const y of below(info, x)) out.add(y)
        }
        return out
    }
    function nested(info: OutlineBlock, inputs: number[]): boolean {
        for (const a of inputs) for (const b of inputs) if (a !== b && below(info, a).has(b)) return true
        return false
    }
    function tree(info: OutlineBlock, id: number, depth = Infinity, conditional = false, out = new Set<number>()): Set<number> {
        if (out.has(id)) return out
        out.add(id)
        const n = g.nodes.get(id)!
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            const u = x ? g.nodes.get(x) : undefined
            const arm = conditional || (n.op === 'select' && i > 0)
            if (!u || u.op === 'param' || isArgless(u)) continue
            if (!arm && (isInput(info, x, true) || truncated(x, depth))) continue
            tree(info, x, arm ? Infinity : depth - 1, arm, out)
        }
        return out
    }

    enter(g.blocks[0])

    const representative = new Map<number, OutlineBlock>()
    const merged = new Map<number, OutlineBlock>()
    for (const info of postOrder) {
        const b = info.block
        const body = g.nodes.get(b.bodyId)
        if (!body || body.op === 'param') continue
        const key = mini(info, b.bodyId, false).key
        classOf.set(b.id, key)
        if (b === g.blocks[0]) continue
        const prior = representative.get(key)
        if (prior) merged.set(b.id, prior)
        else representative.set(key, info)
    }

    const groups = new Map<number, [OutlineBlock, number, number][]>()
    for (const info of postOrder) {
        if (merged.has(info.block.id)) continue
        for (const id of info.tails) {
            const n = g.nodes.get(id)
            if (!n || n.op === 'param' || isArgless(n) || info.uses.get(id)! > 1) continue
            for (let depth = 1, size = 0; ; depth++) {
                const grown = tree(info, id, depth).size
                if (grown === size) break
                size = grown
                const key = mini(info, id, true, depth).key
                let arr = groups.get(key)
                if (!arr) groups.set(key, arr = [])
                arr.push([info, id, depth])
            }
        }
    }

    const claimed = new Map<OutlineBlock, Set<number>>()
    const chosen: [OutlineBlock, number, number][][] = []
    const candidates = [...groups.values()]
        .filter(sites => sites.length > 1)
        .map(sites => sites.filter(([info, id, depth]) => !nested(info, mini(info, id, true, depth).inputs)))
        .filter(sites => sites.length > 1)
        .map(sites => ({ sites, size: tree(sites[0][0], sites[0][1], sites[0][2]).size }))
        .sort((a, b) => ((b.sites.length - 1) * b.size - b.sites.length) - ((a.sites.length - 1) * a.size - a.sites.length))
    for (const { sites, size } of candidates) {
        const local = new Map<OutlineBlock, Set<number>>()
        const accepted = sites.filter(([info, id, depth]) => {
            let mine = local.get(info)
            if (!mine) local.set(info, mine = new Set())
            const taken = claimed.get(info)
            const nodes = tree(info, id, depth)
            for (const x of nodes) if (mine.has(x) || taken?.has(x)) return false
            for (const x of nodes) mine.add(x)
            return true
        })
        if (accepted.length < 2 || (accepted.length - 1) * size - accepted.length <= 0) continue
        for (const [info, nodes] of local) {
            let taken = claimed.get(info)
            if (!taken) claimed.set(info, taken = new Set())
            for (const x of nodes) taken.add(x)
        }
        chosen.push(accepted)
    }

    for (const [dup, rep] of merged) {
        const d = getBlock(g, dup)!
        const r = rep.block
        const dInputs = mini(infos.get(dup)!, d.bodyId, false).inputs
        const rInputs = mini(rep, r.bodyId, false).inputs
        for (const id of appliesTo.get(dup) ?? []) {
            const a = g.nodes.get(id)!
            const operands: (number | GraphNode)[] = [r.id]
            for (const p of r.params) {
                const at = rInputs.indexOf(p)
                const k = at < 0 ? -1 : d.params.indexOf(dInputs[at])
                operands.push(k < 0 ? literal(0) : getRef(a, k + 1) || literal(getLiteral(a, k + 1)))
            }
            g.nodes.set(id, g.nodes.get(createNode(g, 'apply', operands, a))!)
        }
    }

    const replacements = new Map<OutlineBlock, Map<number, number>>()
    for (const sites of chosen) {
        const [first, root, depth] = sites[0]
        const inside = tree(first, root, depth)
        const cloned = new Map<number, number>()
        const params = mini(first, root, true, depth).inputs.map(x => {
            const p = createNode(g, 'param', [])
            cloned.set(x, p)
            return p
        })
        function clone(id: number): number {
            if (!inside.has(id)) return cloned.get(id) ?? id
            const known = cloned.get(id)
            if (known) return known
            const n = g.nodes.get(id)!
            const argIds = getArgIds(n).map(x => x && clone(x))
            const copy = g.maxId++
            g.nodes.set(copy, copyNode(n, withRefs(n, argIds)))
            cloned.set(id, copy)
            return copy
        }
        const blockId = createNode(g, 'block', [])
        addGraphBlock(g, { id: blockId, params, bodyId: clone(root), bodyConst: 0 })
        for (const [info, id, d] of sites) {
            let m = replacements.get(info)
            if (!m) replacements.set(info, m = new Map())
            m.set(id, createNode(g, 'apply', [blockId, ...mini(info, id, true, d).inputs]))
        }
    }
    for (const [info, m] of replacements) info.block.bodyId = replaceAll(g, info.block.bodyId, m)
    return g
}

function countUses(g: Graph, root: number): Map<number, number> {
    const uses = new Map<number, number>()
    const epoch = nextEpoch(g)
    const stack = [root]
    while (stack.length) {
        const id = stack.pop()!
        if (!id) continue
        const n = g.nodes.get(id)
        if (!n || !markVisited(n, epoch)) continue
        for (const x of getArgIds(n)) {
            if (!x) continue
            uses.set(x, (uses.get(x) ?? 0) + 1)
            stack.push(x)
        }
    }
    return uses
}

function retFor(g: Graph, exits: Map<number, number>, n: GraphNode, operand: (id: number) => number): GraphNode {
    const at = exits.get(getRef(n, 0))!
    const ret = g.nodes.get(g.blocks.find(x => x.id === getRef(n, 0))!.bodyId)!
    return copyNode(ret, [at < 0 ? { literal: getLiteral(ret, 0) } : operand(getRef(n, at + 1)) || { literal: getLiteral(n, at + 1) }])
}

function coveredRegion(g: Graph, uses: Map<number, number>, arm: number, params?: Set<number>, passed?: Set<number>): boolean{
    const refs = new Map<number, number>()
    const epoch = nextEpoch(g)
    const stack = [arm]
    refs.set(arm, 1)
    while (const next = stack.pop()) {
        for (const x of getArgIds(g.nodes.get(next)!)) {
            if (!x) continue
            const u = g.nodes.get(x)!
            if (u.op === 'param' || passed?.has(x)) {
                params?.add(x)
                continue
            }
            if (u.op === 'block' || (isArgless(u) && u.op !== 'literal')) continue
            refs.set(x, (refs.get(x) ?? 0) + 1)
            if (!markVisited(u, epoch)) continue
            stack.push(x)
        }
    }
    for (const [k, v] of refs) {
        if (v !== uses.get(k)) return false
    }
    return true
}

// TODO: factor out baggage claim and use it here, it would be more accurate.
function sharedArmValues(g: Graph, select: GraphNode, memo: Map<GraphNode, { every: Set<number>, arms: Set<number>[] }>): Set<number> {
    const none = new Set<number>()
    const control = (n: GraphNode) => n.op === 'apply' || n.op === 'ret' || n.op === 'select' || n.op === 'after'
    const shareable = (id: number) => {
        const n = g.nodes.get(id)
        return !!n && !isArgless(n) && n.op !== 'param' && !control(n)
    }
    for (let i = 1; i < countIds(select); i++) {
        const arm = g.nodes.get(getRef(select, i))
        if (!arm || ((arm.op === 'apply' || arm.op === 'ret') && !getArgIds(arm).some(x => x && shareable(x)))) return none
    }
    function certain(id: number, into: Set<number>): Set<number> {
        const stack = [id]
        while (stack.length) {
            const x = stack.pop()!
            if (!x || into.has(x)) continue
            into.add(x)
            const n = g.nodes.get(x)
            if (!n || n.op === 'block') continue
            if (n.op === 'select') {
                stack.push(getRef(n, 0))
                for (const y of armsShare(n).every) into.add(y)
                continue
            }
            for (const y of getArgIds(n)) if (y) stack.push(y)
        }
        return into
    }
    function armsShare(n: GraphNode): { every: Set<number>, arms: Set<number>[] } {
        const known = memo.get(n)
        if (known) return known
        const arms: Set<number>[] = []
        let every: Set<number> | undefined
        for (let i = 1; i < countIds(n) && (!every || every.size); i++) {
            const arm = getRef(n, i) ? certain(getRef(n, i), new Set()) : new Set<number>()
            arms.push(arm)
            every = every ? new Set([...every].filter(x => arm.has(x))) : arm
        }
        const out = { every: every ?? none, arms }
        memo.set(n, out)
        return out
    }
    const { every: shared, arms } = armsShare(select)
    if (![...shared].some(shareable)) return none
    const condition = certain(getRef(select, 0), new Set())
    const out = new Set<number>()
    for (const arm of arms) {
        for (const m of arm) {
            const n = g.nodes.get(m)
            if (!n || shared.has(m) || control(n)) continue
            for (const x of getArgIds(n)) if (x && shared.has(x) && !condition.has(x) && shareable(x)) out.add(x)
        }
    }
    return out
}

function shareArmValues(g: Graph): boolean {
    let changed = false
    const memo = new Map<GraphNode, { every: Set<number>, arms: Set<number>[] }>()
    function sorted(b: GraphBlock, params: Set<number>, passed: Set<number>): number[] {
        const order = [...b.params, ...passed]
        return [...params].sort((x, y) => order.indexOf(x) - order.indexOf(y))
    }
    for (let i = 0; i < g.blocks.length; i++) {
        const b = g.blocks[i]
        const root = g.nodes.get(b.bodyId)
        const passed = root?.op === 'select' ? sharedArmValues(g, root, memo) : new Set<number>()
        if (passed.size) {
            const params = new Set<number>()
            coveredRegion(g, countUses(g, b.bodyId), b.bodyId, params, passed)
            b.bodyId = moveRegion(g, sorted(b, params, passed), b.bodyId)
            changed = true
            continue
        }
        const uses = countUses(g, b.bodyId)
        function visit(id: number): void {
            const n = g.nodes.get(id)
            if (n?.op === 'after') return visit(getRef(n, countIds(n) - 1))
            if (n?.op !== 'select') return
            for (let k = 1; k < countIds(n); k++) {
                const arm = getRef(n, k)
                const u = arm ? g.nodes.get(tailOf(g, arm)) : undefined
                if (u?.op !== 'select') continue
                const inner = sharedArmValues(g, u, memo)
                const params = new Set<number>()
                if (!inner.size || !coveredRegion(g, uses, arm, params, inner)) {
                    visit(arm)
                    continue
                }
                setRef(n, k, moveRegion(g, sorted(b, params, inner), arm))
                changed = true
            }
        }
        visit(b.bodyId)
    }
    return changed
}

function moveRegion(g: Graph, params: number[], arm: number): number {
    const r = new Map<number, number>()
    const newParams: number[] = []
    for (const p of params) {
        const id = g.maxId++
        const n = g.nodes.get(p)!
        g.nodes.set(id, n.op === 'param' ? paramNode() : makeNode('param', [], typeRefOf(n) ? { ref: typeRefOf(n) } : resultType(g, n)))
        r.set(p, id)
        newParams.push(id)
    }
    const blockId = createNode(g, 'block', [])
    const bodyId = replaceAll(g, arm, r)
    addGraphBlock(g, { id: blockId, params: newParams, bodyId, bodyConst: 0 })
    return createNode(g, 'apply', [blockId, ...params])
}

function outlineArm(g: Graph, uses: Map<number, number>, arm: number, exits = new Map<number, number>()): number {
    const inside = new Set<number>()
    const refs = new Map<number, number>()
    function take(id: number): void {
        inside.add(id)
        for (const x of getArgIds(g.nodes.get(id)!)) {
            if (!x || inside.has(x)) continue
            const k = (refs.get(x) ?? 0) + 1
            refs.set(x, k)
            const u = g.nodes.get(x)!
            if (u.op === 'param' || u.op === 'block' || u.op === 'call') continue
            if (k === uses.get(x) || hasStructuredTail(g, x)) take(x)
        }
    }
    take(arm)
    for (const id of inside) {
        const n = g.nodes.get(id)!
        const effects = n.op === 'after' ? cloneRefs(n, 0, -1)
            : OrderedValues.has(n.op) ? cloneRefs(n, 0, 1) : []
        if (effects.some(x => x && !inside.has(x) && !isArgless(g.nodes.get(x)!))) return 0
    }
    const params: number[] = []
    const inputs: number[] = []
    const cloned = new Map<number, number>()
    function clone(id: number): number {
        if (!id) return id
        const known = cloned.get(id)
        if (known) return known
        const n = g.nodes.get(id)!
        if (!inside.has(id) && isArgless(n)) return id
        const copy = g.maxId++
        if (!inside.has(id)) {
            g.nodes.set(copy, makeNode('param', []))
            params.push(copy)
            inputs.push(id)
        } else if (n.op === 'apply' && exits.has(getRef(n, 0))) {
            g.nodes.set(copy, retFor(g, exits, n, clone))
        } else {
            g.nodes.set(copy, copyNode(n, withRefs(n, getArgIds(n).map(clone))))
        }
        cloned.set(id, copy)
        return copy
    }
    const blockId = createNode(g, 'block', [])
    addGraphBlock(g, { id: blockId, params, bodyId: clone(arm), bodyConst: 0 })
    return createNode(g, 'apply', [blockId, ...inputs])
}

function hoistSharedArms(g: Graph, costs: lowering.TargetCosts): Graph {
    if (intrinsics.argv().includes('no-hoist-arms')) return g
    const only = intrinsics.argv().find(a => a.startsWith('hoist-only:'))?.slice('hoist-only:'.length)
    const maxArg = intrinsics.argv().find(a => a.startsWith('hoist-max-params:'))
    const maxForwardParams = maxArg ? Number(maxArg.slice('hoist-max-params:'.length)) : 6
    const limitArg = intrinsics.argv().find(a => a.startsWith('hoist-limit:'))
    const limit = limitArg ? Number(limitArg.slice('hoist-limit:'.length)) : undefined
    let performed = 0
    if (only && g.name !== only) return g
    const hoistable = (n: GraphNode) => n.op === 'load' || n.op === 'convert' || n.op === 'bitconvert'
        || BinaryOps.has(n.op) || UnaryOps.has(n.op) || CompareOps.has(n.op)
    const outer = (n: GraphNode | undefined) => !n || n.op === 'block' || isArgless(n)
    function reach(root: number, into: Set<number>, stop?: Set<number>): void {
        const stack = [root]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? g.nodes.get(id) : undefined
            if (outer(n) || n!.op === 'param' || into.has(id) || stop?.has(id)) continue
            into.add(id)
            for (let i = n!.op === 'apply' ? 1 : 0; i < countIds(n!); i++) stack.push(getRef(n!, i))
        }
    }
    function process(tail: number, before: Set<number>, loop: number): number {
        const n = tail ? g.nodes.get(tail) : undefined
        if (n?.op === 'after') {
            const lead = new Set(before)
            for (let i = 0; i < countIds(n) - 1; i++) reach(getRef(n, i), lead)
            const last = getRef(n, countIds(n) - 1)
            const next = process(last, lead, loop)
            if (next === last) return tail
            const ids = getArgIds(n)
            ids[ids.length - 1] = next
            return createNode(g, 'after', ids.map((id, i) => id || literal(getLiteral(n, i))), n)
        }
        if (!n || n.op !== 'select' || countIds(n) !== 3) return tail
        const here = new Set(before)
        reach(getRef(n, 0), here)
        const interiors = [1, 2].map(i => {
            const inner = new Set<number>()
            reach(getRef(n, i), inner, here)
            return inner
        })
        const shared = new Set<number>([...interiors[0]].filter(x => interiors[1].has(x)))
        const hoisted = new Set<number>()
        const settled = new Map<number, boolean>()
        function liftable(x: number): boolean {
            const known = settled.get(x)
            if (known !== undefined) return known
            settled.set(x, false)
            const m = g.nodes.get(x)!
            let ok = shared.has(x) && hoistable(m)
            for (let i = 0; ok && i < countIds(m); i++) {
                const r = getRef(m, i)
                const u = r ? g.nodes.get(r) : undefined
                if (!r || outer(u) || u!.op === 'param' || here.has(r)) continue
                ok = liftable(r)
            }
            settled.set(x, ok)
            return ok
        }
        function worth(x: number): boolean {
            const m = g.nodes.get(x)!
            if (latency(costs, m.op) > 1) return true
            for (const inner of interiors) {
                for (const y of inner) {
                    const u = g.nodes.get(y)!
                    if (u.op === 'apply' && getRef(u, 0) === loop && getArgIds(u).slice(1).includes(x)) return true
                }
            }
            for (const r of getArgIds(m)) {
                const u = r ? g.nodes.get(r) : undefined
                if (!r || outer(u) || here.has(r)) continue
                let other = false
                for (const inner of interiors) {
                    for (const y of inner) {
                        if (y === x || hoisted.has(y)) continue
                        if (getArgIds(g.nodes.get(y)!).includes(r)) other = true
                    }
                }
                if (!other) return true
            }
            return false
        }
        function hoist(x: number): void {
            if (hoisted.has(x)) return
            hoisted.add(x)
            for (const r of getArgIds(g.nodes.get(x)!)) if (r && shared.has(r)) hoist(r)
        }
        for (const x of shared) if (liftable(x) && worth(x)) hoist(x)
        if (hoisted.size && limit !== undefined && ++performed > limit) hoisted.clear()
        if (!hoisted.size) {
            let arms: number[] | undefined
            for (let i = 1; i < 3; i++) {
                const arm = getRef(n, i)
                const next = process(arm, here, loop)
                if (next === arm) continue
                arms ??= getArgIds(n)
                arms[i] = next
            }
            return arms ? createNode(g, 'select', arms.map((id, i) => id || literal(getLiteral(n, i))), n) : tail
        }
        const condition = new Set<number>()
        function fusable(id: number): boolean {
            const m = id ? g.nodes.get(id) : undefined
            if (!m) return false
            const ok = CompareOps.has(m.op)
                || ((m.op === 'and' || m.op === 'or') && fusable(getRef(m, 0)) && fusable(getRef(m, 1)))
            if (ok) condition.add(id)
            return ok
        }
        fusable(getRef(n, 0))
        const inside = new Set<number>([tail])
        const cut: number[] = []
        const cutSet = new Set<number>()
        const stack = [tail]
        while (stack.length) {
            const m = g.nodes.get(stack.pop()!)!
            for (let i = m.op === 'apply' ? 1 : 0; i < countIds(m); i++) {
                const r = getRef(m, i)
                const u = r ? g.nodes.get(r) : undefined
                if (!r || outer(u)) continue
                if (u!.op === 'param' || (here.has(r) && !condition.has(r)) || hoisted.has(r)) {
                    if (!cutSet.has(r)) {
                        cutSet.add(r)
                        cut.push(r)
                    }
                    continue
                }
                if (inside.has(r)) continue
                inside.add(r)
                stack.push(r)
            }
        }
        if (cut.length > maxForwardParams) {
            let arms: number[] | undefined
            for (let i = 1; i < 3; i++) {
                const arm = getRef(n, i)
                const next = process(arm, here, loop)
                if (next === arm) continue
                arms ??= getArgIds(n)
                arms[i] = next
            }
            return arms ? createNode(g, 'select', arms.map((id, i) => id || literal(getLiteral(n, i))), n) : tail
        }
        const params = new Map<number, number>()
        for (const r of cut) {
            const p = g.maxId++
            g.nodes.set(p, paramNode())
            params.set(r, p)
        }
        const copies = new Map<number, number>()
        function copy(id: number): number {
            if (!id) return id
            const param = params.get(id)
            if (param !== undefined) return param
            const known = copies.get(id)
            if (known !== undefined) return known
            if (!inside.has(id)) return id
            const m = g.nodes.get(id)!
            const ids = getArgIds(m)
            for (let i = m.op === 'apply' ? 1 : 0; i < ids.length; i++) ids[i] = copy(ids[i])
            const c = g.maxId++
            g.nodes.set(c, copyNode(m, withRefs(m, ids)))
            copies.set(id, c)
            return c
        }
        const body = copy(tail)
        const blockId = createNode(g, 'block', [])
        const block = { id: blockId, params: cut.map(r => params.get(r)!), bodyId: body, bodyConst: 0 }
        addGraphBlock(g, block)
        block.bodyId = process(body, new Set(), loop)
        return createNode(g, 'apply', [blockId, ...cut])
    }
    for (const b of g.blocks.slice()) b.bodyId = process(b.bodyId, new Set(), b.id)
    return g
}

function isolateSelectArms(g: Graph): Graph {
    const selects = new Set<number>()
    function walk(id: number, shared: Set<number>, tail = true): void {
        if (!id) return
        const n = g.nodes.get(id)!
        if (!tail) {
            if (shared.has(id)) return
            shared.add(id)
            for (let i = 0; i < countIds(n); i++) {
                walk(getRef(n, i), shared, false)
            }
            return
        }
        // if (n.op === 'after') {
        //     for (let i = 0; i < countIds(n) - 1; i++) {
        //         walk(getRef(n, i), shared, false)
        //     }
        //     return walk(getRef(n, countIds(n) - 1), shared, tail)
        // }
        if (n.op !== 'select') return
        walk(getRef(n, 0), shared, false)
        selects.add(id)
    }
    function cloneInterior(arm: number, shared: Set<number>) {
        if (shared.has(arm)) return arm
        const epoch = nextEpoch(g)
        const order: number[] = [arm]
        const stack: number[] = [arm]
        const targets: number[] = []
        markVisited(g.nodes.get(arm)!, epoch)
        while (const next = stack.pop()) {
            const u = g.nodes.get(next)!
            for (const r of gn.enumerateRefs(u)) {
                const t = g.nodes.get(r)!
                if (t.op === 'block' || t.op === 'param' || t.op === 'nil-effect') continue
                if (TargetingValues.has(t.op)) {
                    targets.push(r)
                    continue
                }
                if (!markVisited(t, epoch)) continue
                if (shared.has(r)) continue
                order.push(r)
                stack.push(r)
            }
        }
        function share(id: number): void {
            if (shared.has(id)) return
            shared.add(id)
            for (const r of gn.enumerateRefs(g.nodes.get(id)!)) share(r)
        }
        for (const t of targets) share(t)
        const r = new Map<number, number>()
        function visit(vid: number) {
            if (!vid) return vid
            if (const replacement = r.get(vid)) return replacement
            if (shared.has(vid)) return vid
            const u = g.nodes.get(vid)!
            if (u.epoch !== epoch) return vid
            const slots = u.slots.slice()
            for (let i = 0; i < gn.countIds(u); i++) {
                const s = gn.getRef(u, i)
                if (!s) continue
                slots[i] = gn.encodeSlot(visit(s), 0) as u32
            }
            const id = g.maxId++
            g.nodes.set(id, gn.makeNodeFromSlots(u.op, slots))
            r.set(vid, id)
            return id
        }
        return visit(arm)
    }
    function visitRegion(vid: number, shared?: Set<number>) {
        selects.clear()
        const active = new Set(shared)
        walk(vid, active)
        const rem: number[] = []
        for (const s of selects) {
            const u = g.nodes.get(s)!
            for (let i = 1; i < countIds(u); i++) {
                const arm = getRef(u, i)
                if (!arm) continue
                const newArm = cloneInterior(arm, active)
                setRef(u, i, newArm)
                rem.push(newArm)
            }
        }
        for (const x of rem) visitRegion(x, active)
    }
    for (let i = 0; i < g.blocks.length; i++) {
        visitRegion(g.blocks[i].bodyId)
    }
    return g
}

function splitTailSelects(g: Graph): Graph {
    let currentBlock: GraphBlock
    function walk(id: number, uses: Map<number, number>): void {
        if (!id) return
        const n = g.nodes.get(id)!
        if (n.op === 'after') return walk(getRef(n, countIds(n) - 1), uses)
        if (n.op !== 'select') return
        if (uses.get(id) !== 1) return
        for (let k = 1; k < countIds(n); k++) {
            const arm = getRef(n, k)
            if (!arm) continue
            const u = g.nodes.get(tailOf(g, arm))!
            const armOp = u.op
            if (armOp === 'ret') return
            if (armOp !== 'select') continue
            const params = new Set<number>()
            const covered = coveredRegion(g, uses, arm, params)
            if (!covered) {
                walk(arm, uses)
                continue
            }
            const moved = moveRegion(g, [...params].sort((a, b) => currentBlock.params.indexOf(a) - currentBlock.params.indexOf(b)), arm)
            setRef(n, k, moved)
        }
    }
    for (let i = 0; i < g.blocks.length; i++) {
        const b = g.blocks[i]
        currentBlock = b
        const uses = countUses(g, b.bodyId)
        walk(b.bodyId, uses)
    }
    return g
}

export function cloneExits(g: Graph): Graph {
    const exits = new Map<number, number>()
    for (const b of g.blocks) {
        const ret = g.nodes.get(b.bodyId)
        if (ret?.op !== 'ret') continue
        const at = b.params.indexOf(getRef(ret!, 0))
        if (at >= 0 || !getRef(ret!, 0)) exits.set(b.id, at)
    }
    if (!exits.size) return g
    for (const b of g.blocks.slice()) {
        if (exits.has(b.id)) continue
        const uses = countUses(g, b.bodyId)
        function walk(id: number): void {
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'after') return walk(getRef(n, countIds(n) - 1))
            if (n.op === 'apply' && exits.has(getRef(n, 0))) {
                g.nodes.set(id, retFor(g, exits, n, x => x))
                return
            }
            if (n.op !== 'select') return
            for (let i = 1; i < countIds(n); i++) {
                const arm = getRef(n, i)
                const t = g.nodes.get(tailOf(g, arm))
                const at = t?.op === 'apply' ? exits.get(getRef(t, 0)) : undefined
                const returned = at !== undefined && at >= 0 ? g.nodes.get(getRef(t!, at + 1)) : undefined
                const outlined = at !== undefined && returned?.op !== 'call' && uses.get(arm) === 1 ? outlineArm(g, uses, arm, exits) : 0
                if (outlined) setRef(n, i, outlined)
                else walk(arm)
            }
        }
        walk(b.bodyId)
    }
    return g
}

function checkCreationOrder(g: Graph, stage: string, known: Set<string>) {
    const epoch = nextEpoch(g)
    const stack: number[] = []
    const found: string[] = []
    for (const b of g.blocks) stack.push(b.bodyId)
    while (stack.length) {
        const id = stack.pop()!
        if (!id) continue
        const n = g.nodes.get(id)
        if (!n || !markVisited(n, epoch)) continue
        for (const a of getArgIds(n)) {
            if (!a) continue
            stack.push(a)
            if (a < id) continue
            const u = g.nodes.get(a)
            if (!u || getArgIds(u).every(x => !x)) continue
            const key = `${id}:${a}`
            if (known.has(key)) continue
            known.add(key)
            found.push(`%${id} = ${n.op} uses %${a} = ${u.op}`)
        }
    }
    if (!found.length) return
    console.log(`creation order: ${g.name || '<anonymous>'} after ${stage}: ${found.length} new\n  ${found.slice(0, 8).join('\n  ')}`)
}

function errorDump(g: Graph): string {
    return dumpGraph(g)
}

function checkCaptures(g: Graph) {
    if (!intrinsics.argv().includes('check-captures')) return
    const owners = new Map<number, number>()
    for (const b of g.blocks) for (const p of b.params) owners.set(p, b.id)

    const succs = new Map<number, Set<number>>()
    const used = new Map<number, Set<number>>()
    let targets = new Set<number>()
    let params = new Set<number>()
    let epoch = 0
    function scan(n: GraphNode, id: number) {
        if (!markVisited(n, epoch)) return
        if (n.op === 'block') {
            targets.add(id)
            return
        }
        if (n.op === 'param') {
            params.add(id)
            return
        }
        forEachOperand(g, id, scan)
    }
    for (const b of g.blocks) {
        targets = new Set<number>()
        params = new Set<number>()
        epoch = nextEpoch(g)
        succs.set(b.id, targets)
        used.set(b.id, params)
        if (const body = g.nodes.get(b.bodyId)) scan(body, b.bodyId)
    }

    const entry = g.blocks[0].id
    const order: number[] = []
    const seen = new Set<number>([entry])
    const pending = [entry]
    while (pending.length) {
        const id = pending.pop()!
        order.push(id)
        for (const s of succs.get(id) ?? []) {
            if (seen.has(s)) continue
            seen.add(s)
            pending.push(s)
        }
    }
    const preds = new Map<number, number[]>()
    for (const id of order) preds.set(id, [])
    for (const id of order) {
        for (const s of succs.get(id) ?? []) {
            if (seen.has(s)) preds.get(s)!.push(id)
        }
    }
    const dominators = new Map<number, Set<number>>()
    for (const id of order) dominators.set(id, new Set<number>(id === entry ? [entry] : order))
    let changed = true
    while (changed) {
        changed = false
        for (const id of order) {
            if (id === entry) continue
            const incoming = preds.get(id)!
            if (!incoming.length) continue
            const next = new Set<number>()
            for (const x of dominators.get(incoming[0])!) {
                let all = true
                for (let i = 1; i < incoming.length; i++) {
                    if (dominators.get(incoming[i])!.has(x)) continue
                    all = false
                    break
                }
                if (all) next.add(x)
            }
            next.add(id)
            if (next.size === dominators.get(id)!.size) continue
            dominators.set(id, next)
            changed = true
        }
    }

    for (const id of order) {
        for (const p of used.get(id) ?? []) {
            const owner = owners.get(p)
            if (owner === undefined || owner === id) continue
            if (dominators.get(id)!.has(owner)) continue
            console.log(errorDump(g))
            throw `lowering2: ${g.name || '<anonymous>'} impossible capture of %${p} owned by B${owner} used in B${id}`
        }
    }
}

function resolveNumberTypes(g: Graph) {
    const floats = floatValues(g)
    const entry = new Set(g.blocks[0]?.params ?? [])
    const arrivals = new Map<number, Operand[]>()
    for (const n of g.nodes.values()) {
        if (n.op !== 'apply') continue
        getBlock(g, getRef(n, 0))?.params.forEach((p, i) => {
            const list = arrivals.get(p)
            if (list) list.push(getOperand(n, i + 1))
            else arrivals.set(p, [getOperand(n, i + 1)])
        })
    }
    const resolved = new Map<number, Types>()
    function signed(x: Operand): boolean {
        if (typeof x !== 'number') return x.literal < 0
        const n = g.nodes.get(x)
        return !!n && typeSlots(n.op) > 0 && lowering.isSignedType(resolve(x, n))
    }
    function resolve(id: number, n: GraphNode): Types {
        const known = resolved.get(id)
        if (known !== undefined) return known
        resolved.set(id, typeOf(n) === Types.unknown_number ? Types.u64 : typeOf(n))
        let T = typeOf(n)
        if (floats.has(id)) T = Types.f64
        else if (T === Types.unknown_number) T = n.op === 'sub' || getOperands(n).some(signed) ? Types.i64 : Types.u64
        else if (n.op === 'param' && T === Types.u64 && !entry.has(id) && (arrivals.get(id) ?? []).some(signed)) T = Types.i64
        resolved.set(id, T)
        return T
    }
    for (const [id, n] of g.nodes) {
        if (!typeSlots(n.op)) continue
        const T = resolve(id, n)
        if (typeOf(n) === T) continue
        const copy = copyNode(n)
        setType(copy, T)
        g.nodes.set(id, copy)
    }
    function asFloat(x: Operand): Operand {
        if (typeof x !== 'number') {
            if (!x.literal || !Number.isInteger(x.literal)) return x
            const id = g.maxId++
            g.nodes.set(id, makeNode('literal', [x], Types.f64))
            return id
        }
        if (floats.has(x)) return x
        const n = g.nodes.get(x)!
        const id = g.maxId++
        if (n.op === 'after') {
            const operands = getOperands(n)
            operands[operands.length - 1] = asFloat(operands[operands.length - 1])
            g.nodes.set(id, copyNode(n, operands))
        } else {
            g.nodes.set(id, makeNode('convert', [x], Types.f64))
        }
        return id
    }
    function consumeFloats(id: number, n: GraphNode, slots: number[]): void {
        const operands = getOperands(n)
        let changed = false
        for (const i of slots) {
            const x = asFloat(operands[i])
            if (x === operands[i]) continue
            operands[i] = x
            changed = true
        }
        if (changed) g.nodes.set(id, copyNode(n, operands))
    }
    let returnsFloat = false
    for (const n of g.nodes.values()) {
        if (n.op === 'ret' && (getRef(n, 0) ? floats.has(getRef(n, 0)) : !Number.isInteger(getLiteral(n, 0)))) returnsFloat = true
    }
    for (const [id, n] of [...g.nodes]) {
        if (n.op === 'apply') {
            const params = getBlock(g, getRef(n, 0))?.params ?? []
            consumeFloats(id, n, params.flatMap((p, i) => floats.has(p) ? [i + 1] : []))
        } else if (n.op === 'select' && floats.has(id)) {
            consumeFloats(id, n, Array.from({ length: countIds(n) - 1 }, (_, i) => i + 1))
        } else if (n.op === 'store' && typeOf(n) === Types.f64) {
            consumeFloats(id, n, [3])
        } else if (n.op === 'ret' && returnsFloat) {
            consumeFloats(id, n, [0])
        }
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== 'typeof') continue
        g.nodes.set(id, makeNode('literal', [{ literal: operandType(g, n, 0) }]))
    }
    return g
}

type GraphPass = (g: Graph, costs: lowering.TargetCosts) => Graph | boolean | void

function runPipeline(stage: string, g: Graph, costs: lowering.TargetCosts, passes: GraphPass[]): { graph: Graph, changed: boolean } {
    const dumpBefore = debugsGraph('graph-debug', g)
    const dumpChanged = debugsGraph('pass-debug', g)
    const cost = intrinsics.argv().includes('graph-transform-cost')
    const costThreshold = Number(intrinsics.argv().find(x => x.startsWith('perf-thresh:'))?.slice(12) ?? 1)
    const violations = intrinsics.argv().includes('check-creation-order') ? new Set<string>() : undefined
    const start = performance.now()
    let changed = false
    for (const pass of passes) {
        if (disabledPasses.has(pass.name)) continue
        const key = `${stage}:${pass.name}`
        if (dumpBefore) console.log(`before transform: ${key}\n`, dumpGraph(g))
        const nodesBefore = g.nodes.size
        const passStart = performance.now()
        let result: Graph | boolean | void
        try {
            result = pass(g, costs)
        } catch (err) {
            console.log(errorDump(g))
            throw err
        }
        const elapsed = performance.now() - passStart
        if (result && result !== true) g = result
        const reported = result === true
        changed ||= reported
        recordPass(key, elapsed, reported)
        if (cost && elapsed >= costThreshold) console.log('graph transform cost', g.name || '<anonymous>', key, `${elapsed.toFixed(3)}ms`, `${nodesBefore}->${g.nodes.size}`)
        if (dumpChanged && reported) console.log(`--- ${key} changed ---\n${dumpGraph(g)}`)
        if (violations) checkCreationOrder(g, key, violations)
        checkCaptures(g)
    }
    recordPass(`${stage}:(total)`, performance.now() - start, changed)
    return { graph: g, changed }
}

function expectForm(g: Graph, stage: string, ...forms: (GraphForm | undefined)[]): void {
    assert(forms.includes(g.form), `lowering: ${stage} cannot run on a ${g.form ?? 'traced'} graph`)
}

export function optimizePackaged(g: Graph, target: lowering.Target): Graph {
    expectForm(g, 'optimize', 'packaged', 'optimized')
    g = runPipeline('optimize', g, target.costs, [optimizeValueGraph]).graph
    g.form = 'optimized'
    return g
}

export function normalizeValueGraph(g: Graph, opts: { firstPass?: boolean, target?: lowering.Target } = {}): Graph {
    const target = opts.target ?? lowering.hostTarget
    expectForm(g, 'package', undefined)
    checkCaptures(g)
    if (intrinsics.argv().includes('check-creation-order')) checkCreationOrder(g, 'trace', new Set())
    const _bindCallContext: GraphPass = g => bindCallContext(g, target.indirectContextReg)
    g = runPipeline('package', g, target.costs, [_bindCallContext, inlineBlocks, resolveNumberTypes, detachRecordOrdering, flattenRecords, packageBlocksFINAL]).graph
    g.form = 'packaged'
    if (opts.firstPass && isJumbo(g)) return g
    return optimizePackaged(g, target)
}

function demotePstacks(g: Graph): boolean {
    const mem = memAnalysis(g)
    const { loopDepth, loopsOf } = graphLoops(g)
    const owner = new Map<number, number>()
    const bodies = new Set<number>()
    for (const b of g.blocks) {
        bodies.add(b.bodyId)
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || owner.has(id)) continue
            const n = g.nodes.get(id)
            if (!n || n.op === 'param') continue
            owner.set(id, b.id)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    const loadsFrom = new Map<number, number[]>()
    for (const [id, n] of g.nodes) {
        if (n.op !== 'load' || !getRef(n, 1)) continue
        const base = mem.of(getRef(n, 1)).base
        const list = loadsFrom.get(base)
        if (list) list.push(id)
        else loadsFrom.set(base, [id])
    }
    const container = (id: number) => {
        const n = g.nodes.get(id)
        return n?.op === 'pstack' && !getRef(n, 2) && !getLiteral(n, 2)
    }
    const verdicts = new Map<number, boolean>()
    function escapes(root: number, headers?: Set<number>): boolean {
        const known = headers ? undefined : verdicts.get(root)
        if (known !== undefined) return known
        if (!headers) verdicts.set(root, true)
        const seen = new Set<number>([root])
        const work = [root]
        const follow = (x: number) => {
            if (seen.has(x)) return
            seen.add(x)
            work.push(x)
        }
        let escaped = false
        while (work.length && !escaped) {
            const x = work.pop()!
            for (const u of mem.users(x)) {
                const n = g.nodes.get(u)!
                const ordering = n.op === 'after' ? countIds(n) - 1 : OrderedValues.has(n.op) ? 1 : 0
                for (let i = ordering; i < countIds(n) && !escaped; i++) {
                    if (getRef(n, i) !== x) continue
                    if (n.op === 'load') continue
                    if (n.op === 'store') {
                        if (i !== 3) continue
                        if (headers) { escaped = true; break }
                        const into = mem.of(getRef(n, 1)).base
                        if (into === root || !container(into) || escapes(into)) { escaped = true; break }
                        if (mem.flows(into, true).calls.some(([call, k]) => targetCaptures(g, call, k, DeepCaptureSlot))) { escaped = true; break }
                        for (const l of loadsFrom.get(into) ?? []) follow(l)
                    } else if (n.op === 'call') {
                        if (i < 3 || targetCaptures(g, u, i - 3)) escaped = true
                    } else if (n.op === 'apply') {
                        const param = getBlock(g, getRef(n, 0))?.params[i - 1]
                        if (param === undefined || headers?.has(getRef(n, 0))) escaped = true
                        else follow(param)
                    } else if (n.op === 'after' || n.op === 'select' || (PureOps.has(n.op) && !TargetingValues.has(n.op))) {
                        follow(u)
                    } else if (!CompareOps.has(n.op)) {
                        escaped = true
                    }
                }
                if (escaped) break
            }
        }
        if (!headers) verdicts.set(root, escaped)
        return escaped
    }
    const candidates = new Set<number>()
    const iterationLocal = new Set<number>()
    for (const [id, n] of g.nodes) {
        if (n.op !== 'pstack' || getRef(n, 2) || getLiteral(n, 2) || getRef(n, 3) || !getLiteral(n, 3)) continue
        if (bodies.has(id)) continue
        if (!loopDepth.get(owner.get(id) ?? -1)) {
            if (!escapes(id)) candidates.add(id)
            continue
        }
        if (escapes(id, new Set(loopsOf.get(owner.get(id)!) ?? []))) continue
        candidates.add(id)
        iterationLocal.add(id)
    }
    if (!candidates.size) return false
    const tokenOf = (id: number): Operand => {
        let operand = getOperand(g.nodes.get(id)!, 0)
        while (typeof operand === 'number' && candidates.has(operand)) operand = getOperand(g.nodes.get(operand)!, 0)
        return operand
    }
    const demoted = new Map<number, number>()
    for (const id of candidates) {
        let token = tokenOf(id)
        if (iterationLocal.has(id)) g.nodes.set(token = g.maxId++, makeNode('nil-effect', []))
        const alloca = g.maxId++
        g.nodes.set(alloca, makeNode('alloca', [token, { literal: getLiteral(g.nodes.get(id)!, 3) }, { literal: 8 }]))
        demoted.set(id, alloca)
    }
    for (const [id, n] of [...g.nodes]) {
        let copy: GraphNode | undefined
        const ordering = n.op === 'after' ? countIds(n) - 1 : OrderedValues.has(n.op) ? 1 : 0
        for (let i = 0; i < countIds(n); i++) {
            const alloca = demoted.get(getRef(n, i))
            if (alloca === undefined) continue
            copy ??= copyNode(n)
            if (i < ordering) setOperand(copy, i, tokenOf(getRef(n, i)))
            else setRef(copy, i, alloca)
        }
        if (copy) g.nodes.set(id, copy)
    }
    for (const id of candidates) g.nodes.delete(id)
    return true
}

export function expandValueGraph(g: Graph, target: lowering.Target): Graph {
    expectForm(g, 'expand', 'packaged', 'optimized')
    const expanded = runPipeline('expand', g, target.costs, [demotePstacks, expandCodecs, expandPstacks])
    g = expanded.graph
    if (expanded.changed || g.form === 'packaged') g = optimizePackaged(g, target)
    return g
}

export function prepareValueGraph(g: Graph, target: lowering.Target): Graph {
    g = expandValueGraph(g, target)
    g = runPipeline('shape', g, target.costs, [stripMem, outlineBlocks, cloneExits, shareArmValues, splitTailSelects, hoistSharedArms, isolateSelectArms, sweepBlocks, narrowTypes, shareLiterals]).graph
    g.form = 'lowerable'
    if (intrinsics.argv().includes('check-heap-handles')) checkHeapHandles(g)
    return g
}

function checkHeapHandles(g: Graph): void {
    const epoch = nextEpoch(g)
    function visit(n: GraphNode, id: number) {
        if (n.op === 'block') {
            if (!markVisited(n, epoch)) return
            forEachOperand(g, getBlock(g, id)!.bodyId, visit)
            return
        }
        if (n.op === 'heap-handle') {
            const handle = !getRef(n, 0) ? getLiteral(n, 0) : '?'
            console.log(errorDump(g))
            throw `lowering: unresolved heap handle ${handle} at %${id}`
        }
        forEachOperand(g, id, visit)
    }
    forEachOperand(g, g.blocks[0].bodyId, visit)
}

const placementProbe = intrinsics.argv().includes('block-placement')

const NarrowableOps = new Set(['add', 'sub', 'mul', 'and', 'or', 'xor', 'shl', 'ushr'])
const TruncatingOps = new Set(['add', 'sub', 'mul', 'and', 'or', 'xor'])

function zeroExtendedBits(T: Types): number {
    if (T === Types.bool) return 1
    if (T === Types.u8 || T === Types.u16 || T === Types.u32 || (T >= Types.u1 && T <= Types.u31)) return intrinsics.intrinsicBitWidth(T)
    return 64
}

function narrowTypes(g: Graph, costs: lowering.TargetCosts): void {
    if (!costs.narrowOps) return
    const floats = floatValues(g)
    const uses = new Map<number, [user: number, slot: number][]>()
    for (const [id, n] of g.nodes) {
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            const list = uses.get(ref)
            if (list) list.push([id, i])
            else uses.set(ref, [[id, i]])
        }
    }
    const bodies = new Set<number>()
    for (const b of g.blocks) bodies.add(b.bodyId)
    const arrivals = new Map<number, [number, number][]>()
    for (const n of g.nodes.values()) {
        if (n.op !== 'apply') continue
        const block = getBlock(g, getRef(n, 0))
        if (!block) continue
        block.params.forEach((p, i) => {
            const list = arrivals.get(p)
            const arrival: [number, number] = [getRef(n, i + 1), getLiteral(n, i + 1)]
            if (list) list.push(arrival)
            else arrivals.set(p, [arrival])
        })
    }
    const fitsMemo = new Map<number, boolean>()
    function fits(id: number, k: number): boolean {
        if (!id) return Number.isInteger(k) && k >= 0 && k <= 0xFFFFFFFF
        const known = fitsMemo.get(id)
        if (known !== undefined) return known
        fitsMemo.set(id, false)
        const n = g.nodes.get(id)
        let r = false
        if (n?.op === 'literal') r = fits(0, literalValue(n))
        else if (n?.op === 'load' || n?.op === 'convert') r = zeroExtendedBits(typeOf(n)) <= 32
        else if (n && CompareOps.has(n.op)) r = true
        else if (n?.op === 'and') r = fits(getRef(n, 0), getLiteral(n, 0)) || fits(getRef(n, 1), getLiteral(n, 1))
        else if (n?.op === 'or' || n?.op === 'xor') r = fits(getRef(n, 0), getLiteral(n, 0)) && fits(getRef(n, 1), getLiteral(n, 1))
        else if (n?.op === 'ushr') r = fits(getRef(n, 0), getLiteral(n, 0))
        else if (n?.op === 'param') {
            const list = arrivals.get(id) ?? []
            r = list.length > 0 && list.every(([ref, k]) => fits(ref, k))
        }
        fitsMemo.set(id, r)
        return r
    }
    const demandMemo = new Map<number, boolean>()
    function lowDemand(id: number): boolean {
        const known = demandMemo.get(id)
        if (known !== undefined) return known
        demandMemo.set(id, false)
        let r = !bodies.has(id)
        for (const [user, slot] of uses.get(id) ?? []) {
            if (!r) break
            const u = g.nodes.get(user)!
            if (u.op === 'store' && slot === 3 && intrinsics.intrinsicBitWidth(typeOf(u)) <= 32) continue
            if (u.op === 'and' && fits(getRef(u, 1 - slot), getLiteral(u, 1 - slot))) continue
            if ((TruncatingOps.has(u.op) || (u.op === 'shl' && slot === 0)) && narrowed(user)) continue
            r = false
        }
        demandMemo.set(id, r)
        return r
    }
    function removableMask(u: GraphNode, slot: number): boolean {
        if (u.op !== 'and') return false
        const other = 1 - slot
        const m = getRef(u, other) ? g.nodes.get(getRef(u, other)) : undefined
        const mask = getRef(u, other) ? (m?.op === 'literal' ? literalValue(m) : undefined) : getLiteral(u, other)
        return mask !== undefined && Number.isSafeInteger(mask) && mask >= 0xFFFFFFFF
            && Number(BigInt.asUintN(32, BigInt(mask))) === 0xFFFFFFFF
    }
    function wantsZeroExtension(id: number): boolean {
        return (uses.get(id) ?? []).some(([user, slot]) => removableMask(g.nodes.get(user)!, slot))
    }
    const narrowMemo = new Map<number, boolean>()
    function narrowed(id: number): boolean {
        const known = narrowMemo.get(id)
        if (known !== undefined) return known
        narrowMemo.set(id, false)
        const n = g.nodes.get(id)
        let r = false
        if (n && NarrowableOps.has(n.op)) {
            const shift = n.op === 'shl' || n.op === 'ushr'
            const amount = !getRef(n, 1) && getLiteral(n, 1) >= 0 && getLiteral(n, 1) < 32
            const users = uses.get(id) ?? []
            if (shift) {
                const legal = n.op === 'ushr' ? fits(getRef(n, 0), getLiteral(n, 0)) : fits(id, 0) || lowDemand(id)
                r = amount && legal && users.length > 0
                    && users.every(([user]) => TruncatingOps.has(g.nodes.get(user)!.op) && narrowed(user))
            } else {
                r = (fits(id, 0) || lowDemand(id)) && wantsZeroExtension(id)
            }
        }
        narrowMemo.set(id, r)
        return r
    }
    const typed = new Map<number, Types>()
    for (const [id, n] of g.nodes) {
        if (floats.has(id)) continue
        if (n.op === 'literal') {
            if (fits(id, 0) || lowDemand(id)) typed.set(id, Types.u32)
            continue
        }
        if (n.op === 'param') {
            if (fits(id, 0)) typed.set(id, Types.u32)
            continue
        }
        if (NarrowableOps.has(n.op) && narrowed(id)) typed.set(id, Types.u32)
    }
    const redundant = new Map<number, number>()
    for (const [id, n] of g.nodes) {
        if (n.op !== 'and') continue
        for (let i = 0; i < 2; i++) {
            const x = getRef(n, i)
            if (!x || !removableMask(n, i)) continue
            if (typed.get(x) !== Types.u32 && !fits(x, 0)) continue
            redundant.set(id, x)
            break
        }
    }
    for (const [id, T] of typed) {
        const n = g.nodes.get(id)!
        if (typeOf(n) === T) continue
        const copy = copyNode(n)
        setType(copy, T)
        g.nodes.set(id, copy)
    }
    if (!redundant.size) return
    const target = (id: number) => {
        while (redundant.has(id)) id = redundant.get(id)!
        return id
    }
    for (const [id, n] of g.nodes) {
        let ids: number[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (!redundant.has(getRef(n, i))) continue
            ids ??= getArgIds(n)
            ids[i] = target(ids[i])
        }
        if (ids) g.nodes.set(id, copyNode(n, withRefs(n, ids)))
    }
    for (const b of g.blocks) b.bodyId = target(b.bodyId)
}

export interface PreparedLowering {
    g: Graph
    island?: number[]
    analysis: ReturnType<typeof analyzeValueGraph>
}

export function prepareLowering(_g: Graph, opts: LowerGraphOptions = {}): PreparedLowering {
    const target = opts.target ?? lowering.hostTarget
    const g = prepareValueGraph(_g.form ? _g : normalizeValueGraph(_g, { target }), target)
    const island = opts.poolSlot ? islandLoads(g, target.costs, opts.poolSlot, opts.poolValue) : undefined
    return { g, island, analysis: analyzeValueGraph(g, opts) }
}

export function lowerValueGraph(_g: Graph, opts: LowerGraphOptions = {}): LowerGraphResult {
    return lowerPrepared(prepareLowering(_g, opts), opts)
}

export function lowerPrepared(prepared: PreparedLowering, opts: LowerGraphOptions = {}): LowerGraphResult {
    const target = opts.target ?? lowering.hostTarget
    const { g, island, analysis } = prepared
    const floats = floatValues(g)

    const rootBlock = g.blocks[0]
    if (rootBlock.bodyId && g.nodes.get(rootBlock.bodyId)!.op === 'unreachable') {
        return {
            bytes: [],
            listing: '',
            relocations: [],
            target,
            words: [],
        }
    }

    const asm = target.createAssembler()
    if (opts?.debug) {
        console.log(dumpGraph(g))
        const sets = (m: Map<number, Set<number>>) => [...m]
            .map(([at, values]) => `${at}:${[...values].join(',')}`).join(' ')
        console.log('release at', [...analysis.releaseAt]
            .map(([region, sites]) => `${region}{${sets(sites)}}`).join(' '))
        console.log('narrow at', sets(analysis.narrowsAt))
        console.log('spill until', [...analysis.shouldSpillUntil]
            .map(([value, at]) => `${value}:${at}`).join(' '))
    }

    const acrossCall = analysis.shouldSpillUntil
    const inArgPos = analysis.inArgPos
    const pure = analysis.pure
    const order = analysis.blockOrder
    const releaseAt = analysis.releaseAt
    const narrowsAt = analysis.narrowsAt
    const budget = opts.regBudget === undefined ? Infinity : Math.max(2, opts.regBudget)
    const allocatable: number[] = []
    for (const r of target.allocatable) {
        if (target.scratch.indexOf(r) >= 0) continue
        allocatable.push(r)
    }
    const volatiles: number[] = allocatable.slice(0, budget === Infinity ? allocatable.length : budget)
    // caller saved non-args first
    const spread: number[] = []
    for (const r of volatiles) if (target.argRegs.indexOf(r) < 0) spread.push(r)
    for (const r of volatiles) if (target.argRegs.indexOf(r) >= 0) spread.push(r)
    const preserved: number[] = []
    for (const r of target.calleeSaved) {
        if (preserved.length >= budget) continue
        preserved.push(r)
    }
    const OPEN = 1 << 30
    const OUTGOING_ARGS = 1 << 29
    const INCOMING_ARGS = 1 << 28
    const SLOTS = target.regCount
    function isSlot(h: number): boolean { return h >= SLOTS && h < OPEN }
    function isOutgoingArg(h: number): boolean { return h >= OUTGOING_ARGS && h < OPEN }
    function locate(locations: number[], count: number, regs: number[], stack: number): number[] {
        const homes: number[] = []
        let positional = 0
        for (let i = 0; i < count; i++) {
            const at = locations[i] ?? -1
            if (at >= 0) homes.push(at)
            else homes.push(positional < regs.length ? regs[positional++] : stack + positional++ - regs.length)
        }
        return homes
    }
    function argLocations(call: number): number[] {
        const t = g.nodes.get(getRef(g.nodes.get(call)!, 1))
        const fnType = t ? g.nodes.get(typeRefOf(t)) : undefined
        return fnType?.op === 'fn-type' ? gn.fnLocations(fnType) : []
    }
    const callHomes = new Map<number, number[]>()
    function argHomes(call: number): number[] {
        let homes = callHomes.get(call)
        if (homes) return homes
        const n = g.nodes.get(call)!
        const regs = g.nodes.get(getRef(n, 1))?.op === 'syscall-target' ? target.syscall.argRegs : target.argRegs
        homes = locate(argLocations(call), countIds(n) - 3, regs, OUTGOING_ARGS)
        callHomes.set(call, homes)
        return homes
    }
    const entryParams = g.blocks[0].params
    const entryHomes = locate(entryParams.map(p => gn.paramLocation(g.nodes.get(p)!)), entryParams.length, target.argRegs, INCOMING_ARGS)
    const clobberAll = new Set<number>(target.volatiles)
    const callClobbers = new Map<number, Set<number>>()
    function clobberOfCall(call: number): Set<number> {
        let s = callClobbers.get(call)
        if (s) return s
        const n = g.nodes.get(call)
        const t = n?.op === 'call' ? g.nodes.get(getRef(n, 1)) : undefined
        s = t?.op === 'local-target' && !getRef(t, 0) ? opts.clobbersOf?.(getLiteral(t, 0)) ?? clobberAll : clobberAll
        const handed = n?.op === 'call' ? argHomes(call).filter(h => h < SLOTS && !s!.has(h)) : []
        if (handed.length) s = new Set([...s, ...handed])
        callClobbers.set(call, s)
        return s
    }
    const safeCache = new Map<number, number[]>()
    function safeVolatiles(v: number): number[] {
        let s = safeCache.get(v)
        if (s) return s
        const crossed = analysis.crossedCalls.get(v)
        s = target.callerSaved.filter(r => volatiles.includes(r) && (!crossed || [...crossed].every(c => !clobberOfCall(c).has(r))))
        safeCache.set(v, s)
        return s
    }
    const inherited = new Set<number>()
    for (const [id, n] of g.nodes) if (n.op === 'call') for (const r of clobberOfCall(id)) inherited.add(r)
    const needAt = new Map<number, number>()
    for (const [v, calls] of analysis.crossedCalls) {
        if (safeVolatiles(v).length) continue
        for (const c of calls) needAt.set(c, (needAt.get(c) ?? 0) + 1)
    }
    let needed = 0
    for (const k of needAt.values()) needed = Math.max(needed, k)
    const pairSlot = analysis.crossedCalls.size && needed % 2 === 0 && needed < preserved.length ? preserved[needed] : -1
    function rankHomes(safe: number[]): number[] {
        if (pairSlot < 0) return safe
        return [...safe.filter(r => inherited.has(r)), pairSlot, ...safe.filter(r => !inherited.has(r))]
    }
    let slotCount = 0
    const reusableSlots = new Set<number>()
    const signatures = assignBlockSignatures(g, acrossCall, analysis.inArgPos, analysis.inStatePos, analysis.applyOwner, {
        volatiles, preserved, safeFor: safeVolatiles, rank: rankHomes,
        arrival: entryHomes, argHome: (call, i) => argHomes(call)[i], ret: target.retRegs[0], overflow: () => takeSlot(),
    })
    const CALLEE = target.scratch[1]
    const SWAP = target.scratch[0]
    const SP = target.stackReg
    const LR = target.linkReg
    const RET = target.retRegs[0]
    const usedPreserved = new Set<number>()
    let callsOut = false
    const tails = new Set<number>()
    let tailCalls = false
    let reachesExit = false
    function isPreserved(r: number): boolean { return target.calleeSaved.indexOf(r) >= 0 }

    const spillStats = intrinsics.argv().includes('spill-stats') ? { total: 0, again: 0 } : undefined
    const spilledOnce = new Set<number>()
    const evictedOps = new Map<string, number>()
    const handoverKinds = new Map<string, number>()
    let outgoingArgWords = 0
    let frame: lowering.FrameLayout | undefined
    function slotOffset(h: number): number {
        if (h >= OUTGOING_ARGS) return frame!.outgoingArg(h - OUTGOING_ARGS)
        if (h >= INCOMING_ARGS) return frame!.incomingArg(h - INCOMING_ARGS)
        return frame!.slot(h - SLOTS)
    }
    function takeSlot(): number {
        const reused = reusableSlots.values().next()
        if (!reused.done) {
            reusableSlots.delete(reused.value)
            return reused.value
        }
        return SLOTS + slotCount++
    }

    interface EmitRegion {
        parent?: EmitRegion
        children: EmitRegion[]
        writes: Set<number>
        owned: number[]
        exitLabel: number
        group: number
    }
    const rootRegion: EmitRegion = {
        children: [], writes: new Set(), owned: [], exitLabel: -1, group: -1,
    }
    let currentRegion = rootRegion
    let currentBlock = 0
    let armStart = -1
    let nextRegionGroup = 0
    interface ReleaseEvent { released: { value: number, home: number }[] }
    interface TransferEvent {
        dst: number
        src: number
        consumed?: { value: number, home: number }
    }
    const code: ((() => void) | ReleaseEvent | TransferEvent)[] = []
    function put(fn: () => void): void { code.push(fn) }
    function transfer(dst: number, src: number, consumed?: { value: number, home: number }): void {
        if (!Number.isInteger(dst) || dst === OPEN || (dst >= SLOTS && !isSlot(dst))) {
            console.log(errorDump(g))
            throw `lowering3: invalid transfer destination ${dst} while queuing %${materializing} in B${currentBlock} (src: ${src})`
        }
        if (!Number.isInteger(src) || src === OPEN || (src >= SLOTS && !isSlot(src))) {
            console.log(errorDump(g))
            throw `lowering3: invalid transfer source ${src} while queuing %${materializing} in B${currentBlock} (dst: ${dst})`
        }
        noteWrite(dst)
        code.push({ dst, src, consumed })
    }
    function noteWrite(dst: number): void {
        if (dst < SLOTS) written.add(dst)
        if (isPreserved(dst)) {
            usedPreserved.add(dst)
            currentRegion.writes.add(dst)
        }
    }

    const homeOf = new Map<number, number>()
    const copyOf = new Map<number, number>()
    const heldBy = new Map<number, number>()
    const done = new Set<number>()
    const temporariesAt = new Map<number, number[]>()
    const freedAt = new Map<number, number>()
    let materializing = 0
    let synth = 0


    const NOTHING = new Set<number>()
    const written = new Set<number>()
    const localCalls = new Set<number>()
    function bind(id: number, reg: number): number {
        if (opts.debug) console.log('home +', id, reg, 'at', materializing, 'over', heldBy.get(reg) ?? '-')
        written.add(reg)
        homeOf.set(id, reg)
        heldBy.set(reg, id)
        if (isPreserved(reg)) {
            usedPreserved.add(reg)
            currentRegion.writes.add(reg)
        }
        return reg
    }
    function place(id: number, home: number): void {
        if (isSlot(home)) reusableSlots.delete(home)
        homeOf.set(id, home)
        if (isSlot(home)) return
        heldBy.set(home, id)
        if (isPreserved(home)) {
            usedPreserved.add(home)
            currentRegion.writes.add(home)
        }
    }
    function freeValue(v: number, site = materializing, announce = true): void {
        const home = homeOf.get(v)
        if (home === undefined) return
        if (opts.debug) console.log('home -', v, home, 'at', site)
        homeOf.delete(v)
        const copy = copyOf.get(v)
        if (copy !== undefined) {
            copyOf.delete(v)
            reusableSlots.add(copy)
        }
        freedAt.set(v, site)
        if (!isSlot(home) && heldBy.get(home) === v) heldBy.delete(home)
        if (announce) code.push({ released: [{ value: v, home }] })
    }
    function finish(id = materializing, handedOver?: Set<number>): void {
        done.add(id)
        for (const arm of armStack) for (const v of releaseAt.get(arm)?.get(id) ?? []) freeValue(v, id, !handedOver?.has(v))
        for (const v of temporariesAt.get(id) ?? []) freeValue(v, id, !handedOver?.has(v))
        temporariesAt.delete(id)
    }

    const armStack = [0]
    function narrowTo(root: number): void {
        armStack.push(root)
        for (const v of narrowsAt.get(root) ?? []) freeValue(v, root)
    }
    function widen(): void {
        armStack.pop()
    }
    function releases(site: number, v: number): boolean {
        for (const arm of armStack) if (releaseAt.get(arm)?.get(site)?.has(v)) return true
        return false
    }
    function freeReg(pool: number[], avoid: Set<number>): number {
        return freeRegIn([pool], avoid)
    }
    function freeRegIn(pools: number[][], avoid: Set<number>): number {
        for (const pool of pools) for (const r of pool) if (!heldBy.has(r) && !avoid.has(r)) return r
        for (const pool of pools) for (const r of pool) {
            const v = heldBy.get(r)
            const copy = v === undefined ? undefined : copyOf.get(v)
            if (copy === undefined || avoid.has(r)) continue
            homeOf.set(v!, copy)
            copyOf.delete(v!)
            heldBy.delete(r)
            return r
        }
        for (const pool of pools) for (const r of pool) {
            const v = heldBy.get(r)
            if (v === undefined || avoid.has(r)) continue
            const slot = takeSlot()
            transfer(slot, r)
            if (spillStats) { spillStats.total++; if (spilledOnce.has(v)) spillStats.again++; spilledOnce.add(v); const op = g.nodes.get(v)?.op ?? '?'; evictedOps.set(op, (evictedOps.get(op) ?? 0) + 1) }
            homeOf.set(v, slot)
            heldBy.delete(r)
            return r
        }
        return -1
    }
    let transient = 0
    const avoidsArgRegs = new Set<number>()
    for (const [id, uses] of analysis.usedBy) {
        if (uses.length < 2 || acrossCall.has(id)) continue
        if (inArgPos.has(id) || analysis.inStatePos.has(id)) continue
        avoidsArgRegs.add(id)
    }
    let pendingHomes: Set<number> = NOTHING
    function regFor(id: number, want: number): number {
        let steering = false
        if (want < 0) {
            want = handedTo.get(id) ?? -1
            steering = want >= 0
            if (steering && sigStats) sigStats.steered++
        }
        const first = acrossCall.has(id) ? preserved
            : transient || avoidsArgRegs.has(id) ? spread : volatiles
        const second = first === preserved ? volatiles : preserved
        if (want >= 0) {
            const willRelease = releases(id, heldBy.get(want) ?? 0)
            if (!heldBy.has(want) && (first.indexOf(want) >= 0 || first !== preserved)) {
                return bind(id, want)
            }
            if (willRelease && (first.indexOf(want) >= 0 || first !== preserved)) {
                return bind(id, want)
            }
        }
        if (steering && sigStats) sigStats.steerFailed++
        if (first === preserved) {
            if (want >= 0 && !heldBy.has(want) && safeVolatiles(id).includes(want)) return bind(id, want)
            const homes = currentRegion === rootRegion ? rankHomes(safeVolatiles(id)) : safeVolatiles(id)
            for (const r of homes) if (!heldBy.has(r) && !pendingHomes.has(r)) return bind(id, r)
        }
        let r = pendingHomes.size ? freeReg(first, pendingHomes) : -1
        if (r < 0) r = freeReg(first, NOTHING)
        if (r < 0) r = freeReg(second, NOTHING)
        if (r < 0) throw 'lowering: out of registers'
        return bind(id, r)
    }
    function at(v: number, avoid: Set<number>): number {
        const home = homeOf.get(v)
        if (home === undefined) {
            console.log(errorDump(g), materializing)
            throw `lowering: value ${v} is not live`
        }
        if (!isSlot(home)) return home
        if (acrossCall.has(v)) {
            for (const safe of safeVolatiles(v)) {
                if (heldBy.has(safe) || avoid.has(safe)) continue
                transfer(safe, home)
                copyOf.set(v, home)
                return bind(v, safe)
            }
        }
        const first = acrossCall.has(v) && !stashed.has(v) ? preserved : volatiles
        const second = first === preserved ? volatiles : preserved
        const r = freeRegIn([first, second], avoid)
        if (r < 0) throw 'lowering: out of registers'
        transfer(r, home)
        copyOf.set(v, home)
        return bind(v, r)
    }
    interface Snapshot { homes: number[][], copies: number[][], held: number[][], ran: number[] }
    function snapshot(): Snapshot {
        const homes: number[][] = []
        for (const [k, v] of homeOf) homes.push([k, v])
        const copies: number[][] = []
        for (const [k, v] of copyOf) copies.push([k, v])
        const held: number[][] = []
        for (const [k, v] of heldBy) held.push([k, v])
        return { homes, copies, held, ran: [...done] }
    }
    function restore(s: Snapshot): void {
        homeOf.clear()
        for (const e of s.homes) homeOf.set(e[0], e[1])
        copyOf.clear()
        for (const e of s.copies) copyOf.set(e[0], e[1])
        heldBy.clear()
        for (const e of s.held) heldBy.set(e[0], e[1])
        reusableSlots.clear()
        const occupied = new Set<number>()
        for (const h of homeOf.values()) if (isSlot(h)) occupied.add(h)
        for (const h of copyOf.values()) occupied.add(h)
        for (let i = 0; i < slotCount; i++) if (!occupied.has(SLOTS + i)) reusableSlots.add(SLOTS + i)
        done.clear()
        for (const v of s.ran) done.add(v)
    }

    interface Move { dst: number, src: number }
    function shuffle(moves: Move[], expired?: Map<number, number>): void {
        const scratch = moves.some(m => isSlot(m.dst)) ? CALLEE : SWAP
        const pending: Move[] = []
        for (const m of moves) if (m.dst !== m.src) pending.push(m)
        while (pending.length) {
            let ready = -1
            for (let i = 0; i < pending.length && ready < 0; i++) {
                let blocked = false
                for (let j = 0; j < pending.length; j++) {
                    if (i !== j && pending[j].src === pending[i].dst) { blocked = true; break }
                }
                if (!blocked) ready = i
            }
            if (ready < 0) {
                const stuck = pending[0].src
                transfer(scratch, stuck)
                for (const m of pending) if (m.src === stuck) m.src = scratch
                continue
            }
            const m = pending.splice(ready, 1)[0]
            const value = expired?.get(m.src)
            const last = value !== undefined && !pending.some(x => x.src === m.src)
            transfer(m.dst, m.src, last ? { value, home: m.src } : undefined)
        }
    }

    let nextLabel = 0
    for (const b of g.blocks) if (b.id >= nextLabel) nextLabel = b.id + 1
    const exitLabel = nextLabel++
    rootRegion.exitLabel = exitLabel
    const entryLabels = new Map<number, number>()
    for (const [k, v] of analysis.rotated) {
        entryLabels.set(v, nextLabel++)
    }
    const savedIndex = new Map<number, number>()

    function regionExit(region: EmitRegion | undefined): number {
        while (region && region !== rootRegion && !region.owned.length) region = region.parent
        return region && region !== rootRegion ? region.exitLabel : exitLabel
    }

    function jumpToExit(tail = 0): void {
        const region = currentRegion
        put(() => {
            if (tailCalls && tails.has(tail)) return
            reachesExit = true
            asm.jump(regionExit(region))
        })
    }

    const sig = new Map<number, number[]>()
    const entryCode = new Map<number, { label: number, code: ((() => void) | ReleaseEvent | TransferEvent)[] }>()
    const inbound = new Map<number, GraphNode[]>()
    {
        const epoch = nextEpoch(g)
        const stack = order.map(id => getBlock(g, id)!.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            if (!id) continue
            const n = g.nodes.get(id)
            if (!n || !markVisited(n, epoch)) continue
            if (n.op === 'apply') {
                let arr = inbound.get(getRef(n, 0))
                if (!arr) inbound.set(getRef(n, 0), arr = [])
                arr.push(n)
            }
            for (const x of getArgIds(n)) stack.push(x)
        }
    }
    const stashed = stashedArgs()
    function stashedArgs(): Set<number> {
        const out = new Set<number>()
        const entry = g.blocks[0]
        const homes = signatures.get(entry.id) ?? []
        const shared = new Set<number>()
        for (const b of g.blocks) if (b !== entry) for (const h of signatures.get(b.id) ?? []) shared.add(h)
        const pressure = new Map<number, number>()
        for (const calls of analysis.crossedCalls.values()) for (const c of calls) pressure.set(c, (pressure.get(c) ?? 0) + 1)
        let peak = 0
        for (const n of pressure.values()) peak = Math.max(peak, n)
        for (let i = 0; i < entry.params.length; i++) {
            const p = entry.params[i]
            if (entryHomes[i] >= SLOTS) continue
            const uses = analysis.usedBy.get(p) ?? []
            if (!acrossCall.has(p) || !isPreserved(homes[i]) || shared.has(homes[i])) continue
            if (uses.length !== 1 || g.nodes.get(uses[0])?.op === 'apply') continue
            const crossed = analysis.crossedCalls.get(p)!
            let atPeak = true
            for (const [c, n] of pressure) if (n === peak && !crossed.has(c)) atPeak = false
            if (atPeak) out.add(p)
        }
        return out
    }
    for (const b of g.blocks) {
        const homes = (signatures.get(b.id) ?? []).map((home, i) => stashed.has(b.params[i]) ? takeSlot() : home)
        for (const home of homes) {
            if (!isPreserved(home)) continue
            usedPreserved.add(home)
            rootRegion.writes.add(home)
        }
        sig.set(b.id, homes)
    }
    const paramAt = new Map<number, [block: number, idx: number]>()
    for (const b of g.blocks) {
        for (let i = 0; i < b.params.length; i++) paramAt.set(b.params[i], [b.id, i])
    }
    const handedTo = new Map<number, number>()
    for (const [v, positions] of inArgPos) {
        for (const at of positions) {
            const n = g.nodes.get(at[0])
            if (!n || handedTo.has(v)) continue
            const home = n.op === 'apply' ? sig.get(getRef(n, 0))?.[at[1]]
                : n.op === 'call' ? argHomes(at[0])[at[1]] : undefined
            if (home !== undefined && !isSlot(home)) handedTo.set(v, home)
        }
    }
    for (const n of g.nodes.values()) {
        if (n.op !== 'ret') continue
        const value = g.nodes.get(getRef(n, 0))
        if (value?.op !== 'record') {
            if (getRef(n, 0) && !handedTo.has(getRef(n, 0))) handedTo.set(getRef(n, 0), RET)
            continue
        }
        for (let i = 0; i < countIds(value); i += 2) {
            const field = getRef(value, i + 1)
            const reg = target.retRegs[getLiteral(value, i)]
            if (field && reg !== undefined && !handedTo.has(field)) handedTo.set(field, reg)
        }
    }
    for (const [v, home] of [...handedTo]) {
        for (let n = g.nodes.get(v); n?.op === 'after';) {
            const value = getRef(n, countIds(n) - 1)
            if (!value || handedTo.has(value)) break
            handedTo.set(value, home)
            n = g.nodes.get(value)
        }
    }


    function floatOperand(n: GraphNode, i: number): boolean {
        return getRef(n, i) ? floats.has(getRef(n, i)) : !Number.isInteger(getLiteral(n, i))
    }

    function floatSource(n: GraphNode, i: number): Types {
        return !getRef(n, i) || floats.has(getRef(n, i)) ? Types.f64 : operandType(g, n, i)
    }

    function demand(id: number, konst: number, want = -1, narrow = false, float = false): number {
        if (!id) {
            const k = --synth
            let temps = temporariesAt.get(materializing)
            if (!temps) temporariesAt.set(materializing, temps = [])
            temps.push(k)
            let r = freeReg(volatiles, NOTHING)
            if (r < 0) r = freeReg(preserved, NOTHING)
            if (r < 0) throw 'lowering3: out of registers'
            bind(k, r)
            put(() => float ? asm.movF64(r, konst) : asm.movImm(r, konst, narrow))
            return k
        }
        const n = g.nodes.get(id)
        if (n?.op === 'void') return 0
        if (!homeOf.has(id)) {
            if (isParam(g.nodes, id)) {
                throw `lowering: parameter ${id} was released at ${freedAt.get(id)} before rematerializing ${materializing} (freed at ${freedAt.get(materializing)})\n${errorDump(g)}`
            }
            if (done.has(id) && voidValued(id)) return 0
            if (done.has(id)) {
                console.log(errorDump(g), id, g.nodes.get(id))
            }
            assert(!done.has(id), `value %${id} is already done`)
            build(id, want)
            if ((n?.op === 'after' || n?.op === 'store') && !homeOf.has(id)) return 0
        }
        return id
    }

    function orderedOperands(site: number, wanted: number[]): number[] {
        const out: number[] = []
        const remaining = new Set<number>(wanted)
        for (const i of analysis.operandOrder.get(site) ?? []) {
            if (!remaining.delete(i)) continue
            out.push(i)
        }
        for (const i of wanted) if (remaining.has(i)) out.push(i)
        return out
    }

    function voidValued(id: number) {
        const n = g.nodes.get(id)
        if (n?.op === 'after') return voidValued(getRef(n, countIds(n) - 1))
        return n?.op === 'void' || n?.op === 'store'
    }

    function orderingOperands(site: number, n: GraphNode): number[] {
        return orderedOperands(site, cloneRefs(n, 0, -1).map((_, i) => i))
    }

    function build(id: number, want = -1): void {
        const outer = materializing
        if (opts.debug) console.log('build', id, 'from', outer)
        materializing = id
        defer materializing = outer
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id)) throw `lowering3: no definition for value ${id} while materializing ${materializing}`
        const signed = lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))

        if (n.op === 'call') { buildCall(id, n); return }
        if (n.op === 'after') { buildAfter(id, n, want); return }
        if (n.op === 'select') { buildSelect(id, n, want); return }
        if (n.op === 'nil-effect') return
        if (n.op === 'void') { finish(); return }
        if (n.op === 'store') {
            buildStore(id, n)
            finish()
            return 
        }
        if (n.op === 'pool-entry') {
            const slot = getLiteral(n, 0)
            assert(!getRef(n, 0) && Number.isSafeInteger(slot) && slot >= 0)
            finish()
            const dst = regFor(id, want)
            const name = getDebugLabel(g, id)
            put(() => asm.loadPool(dst, slot, name))
            return
        }
        if (n.op === 'frame-address') {
            const offset = getLiteral(n, 0)
            finish()
            const dst = regFor(id, want)
            put(() => asm.spRead(dst, frame!.allocas + offset))
            return
        }
        if (BinaryOps.has(n.op) || CompareOps.has(n.op)) { buildArith(id, n, signed, want); return }
        if (UnaryOps.has(n.op)) {
            const op = n.op
            const float = floatOperand(n, 0)
            const a = demand(getRef(n, 0), getLiteral(n, 0), -1, false, float)
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => float ? asm.floatNeg(dst, ra) : asm.unary(op, dst, ra))
            return
        }
        if (n.op === 'convert' || n.op === 'bitconvert') {
            const T = floatOperand(n, 0) ? Types.f64 : operandType(g, n, 0)
            const U = typeOf(n)
            const converts = n.op === 'convert'
            const a = demand(getRef(n, 0), getLiteral(n, 0))
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            const reinterprets = !converts && (T === Types.f64 || U === Types.f64)
            put(() => reinterprets ? asm.mov(dst, ra) : asm.convert(dst, ra, T, U))
            return
        }
        if (n.op === 'load') {
            return buildLoad(id, n, want)
        }
        if (n.op === 'literal') {
            finish()
            const dst = regFor(id, want)
            const k = literalValue(n)
            const narrow = typeOf(n) === Types.u32
            const float = typeOf(n) === Types.f64
            put(() => float ? asm.movF64(dst, k) : asm.movImm(dst, k, narrow))
            return
        }
        if (n.op === 'heap-handle' && !getRef(n, 0) && getLiteral(n, 0) === 0) {
            // undefined/null
            finish()
            const dst = regFor(id, want)
            put(() => asm.movImm(dst, 0))
            return
        }
        if (n.op === 'get' && g.nodes.get(getRef(n, 0))?.op === 'call') {
            effect(getRef(n, 0))
            return
        }
        throw `lowering: cannot produce '${n.op}' @ %${id} [unit: ${g.name ?? '<anonymous'}]\n${errorDump(g)}`
    }

    function buildFloatArith(id: number, n: GraphNode, want: number): void {
        const cmp = CompareOps.has(n.op)
        let a = 0
        let b = 0
        for (const i of orderedOperands(id, [0, 1])) {
            const v = demand(getRef(n, i), getLiteral(n, i), -1, false, true)
            if (i === 0) a = v
            else b = v
        }
        const guard = new Set<number>()
        const ra = at(a, guard)
        guard.add(ra)
        const rb = at(b, guard)
        finish(id)
        const dst = regFor(id, want)
        const from: [Types, Types] = [floatSource(n, 0), floatSource(n, 1)]
        put(() => cmp ? asm.floatCompare(n.op, dst, ra, rb, from) : asm.floatBinary(n.op, dst, ra, rb, from))
    }

    function buildArith(id: number, n: GraphNode, signed: boolean, want: number): void {
        if (floatOperand(n, 0) || floatOperand(n, 1)) return buildFloatArith(id, n, want)
        const swap = !getRef(n, 0) && getRef(n, 1) !== 0
            && (Commutative.has(n.op) || SwappedCmp[n.op] !== undefined)
        const op = swap ? SwappedCmp[n.op] ?? n.op : n.op
        const cmp = CompareOps.has(op)
        const li = swap ? 1 : 0
        const ri = swap ? 0 : 1
        const imm = getLiteral(n, ri)
        const narrow = !cmp && NarrowableOps.has(op) && typeOf(n) === Types.u32
        const narrowCompare = cmp && (op === 'eq' || op === 'ne' || !signed) && imm > 0x7FFF_FFFF && imm <= 0xFFFF_FFFF
            && zeroExtendedBits(operandType(g, n, li)) <= 32
        const operandImm = narrowCompare ? imm - 0x1_0000_0000 : imm
        if (!getRef(n, ri) && target.takesImmediate(op, operandImm)) {
            const a = demand(getRef(n, li), getLiteral(n, li))
            const ra = at(a, NOTHING)
            finish(id)
            const dst = regFor(id, want)
            if (cmp) put(() => asm.compareImm(op, dst, ra, operandImm, signed, undefined, narrowCompare))
            else if (op === 'add') put(() => asm.addImm(dst, ra, imm, narrow))
            else if (op === 'sub') put(() => asm.subImm(dst, ra, imm, narrow))
            else put(() => asm.binaryImm(op, dst, ra, imm, signed, narrow))
            return
        }
        let a = 0
        let b = 0
        for (const i of orderedOperands(id, [li, ri])) {
            const v = demand(getRef(n, i), getLiteral(n, i), undefined, narrow)
            if (i === li) a = v
            else b = v
        }
        const guard = new Set<number>()
        const ra = at(a, guard)
        guard.add(ra)
        const rb = at(b, guard)
        finish(id)
        const dst = regFor(id, want)
        put(() => cmp ? asm.compare(op, dst, ra, rb, signed) : asm.binary(op, dst, ra, rb, signed, narrow))
    }

    function buildAfter(id: number, n: GraphNode, want: number): void {
        const result = countIds(n) - 1
        assert(result >= 0)
        for (const i of orderingOperands(id, n)) effect(getRef(n, i))
        const value = demand(getRef(n, result), getLiteral(n, result), want)
        if (!value) { finish(id); return }
        const src = at(value, NOTHING)
        finish(id)
        const dst = regFor(id, want >= 0 ? want : src)
        transfer(dst, src)
    }

    interface Handover { dst: number, id: number, konst: number, rank?: number, settle?: (reg: number) => void }
    function handOver(site: number, slots: Handover[], sequence: [number, () => void], elide = OPEN): number {
        const args: Move[] = []
        const consts: Move[] = []
        const feeds = new Map<Handover, number>()
        let sequenced = false
        const landing = new Set<number>()
        for (const s of slots) if (s.dst !== OPEN && !isSlot(s.dst)) landing.add(s.dst)
        const outerPending = pendingHomes
        defer pendingHomes = outerPending
        for (let i = 0; i < slots.length; i++) {
            const s = slots[i]
            if (sequence[0] === i) {
                assert(!sequenced)
                sequence[1]()
                sequenced = true
            }
            if (!s.id) continue
            if (spillStats && paramAt.has(s.id) && s.dst !== OPEN) {
                const at = paramAt.get(s.id)!
                const own = sig.get(at[0])?.[at[1]]
                const now = homeOf.get(s.id)
                const kind = own !== s.dst ? 'other-ordinal' : now === s.dst ? 'kept' : now === undefined ? 'not-live' : isSlot(now) ? 'evicted-to-slot' : 'moved-to-reg'
                const key = `${kind}${isSlot(s.dst) ? ' (dst slot)' : ''}`
                handoverKinds.set(key, (handoverKinds.get(key) ?? 0) + 1)
            }
            const want = s.dst === OPEN || isSlot(s.dst) ? -1 : s.dst
            pendingHomes = new Set(landing)
            if (want >= 0) pendingHomes.delete(want)
            const value = demand(s.id, s.konst, want)
            if (value) feeds.set(s, value)
        }
        pendingHomes = outerPending
        if (!sequenced) sequence[1]()
        slots = slots.filter(s => !s.id || feeds.has(s))
        const call = g.nodes.get(site)?.op === 'call'
        for (const dst of landing) {
            const held = call && isPreserved(dst) ? heldBy.get(dst) : undefined
            if (held === undefined || slots.some(s => s.dst === dst && feeds.get(s) === held)) continue
            const slot = takeSlot()
            transfer(slot, dst)
            homeOf.set(held, slot)
            heldBy.delete(dst)
        }
        const settled = new Map<number, number>()
        const copied = new Map<number, number>()
        for (const v of feeds.values()) {
            settled.set(v, homeOf.get(v)!)
            const copy = copyOf.get(v)
            if (copy !== undefined) copied.set(v, copy)
        }
        const claimed = new Set<number>()
        for (const s of slots) if (s.dst !== OPEN) claimed.add(s.dst)
        const open = slots.filter(s => s.dst === OPEN)
        open.sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0))
        for (const s of open) {
            if (s.dst !== OPEN) continue
            const v = feeds.get(s)
            const here = v === undefined ? undefined : settled.get(v)
            if (here === undefined || claimed.has(here)) continue
            claimed.add(here)
            if (isPreserved(here)) {
                usedPreserved.add(here)
                currentRegion.writes.add(here)
            }
            s.dst = here
            s.settle!(here)
        }
        for (const s of open) {
            if (s.dst !== OPEN) continue
            let r = -1
            for (const c of volatiles) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of preserved) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of volatiles) if (!claimed.has(c)) { r = c; break }
            if (r < 0) for (const c of preserved) if (!claimed.has(c)) { r = c; break }
            if (r < 0) r = takeSlot()
            claimed.add(r)
            if (isPreserved(r)) {
                usedPreserved.add(r)
                currentRegion.writes.add(r)
            }
            s.dst = r
            s.settle!(r)
        }
        for (const s of slots) {
            if (!s.id) { consts.push({ dst: s.dst, src: s.konst }); continue }
            args.push({ dst: s.dst, src: feeds.get(s)! })
        }
        if (opts.debug) {
            console.log('handover', site, slots.map(s => [s.dst, s.id, s.konst]),
                [...settled], 'elide', elide)
        }
        finish(site, new Set(feeds.values()))
        const dsts = new Set<number>()
        for (const a of args) if (a.dst !== elide) dsts.add(a.dst)
        for (const c of consts) dsts.add(c.dst)
        let landed = elide
        const moves: Move[] = []
        for (const a of args) {
            if (copied.get(a.src) === a.dst) continue
            const src = settled.get(a.src)
            if (src === undefined) {
                const t = slots.find(x => x.dst === a.dst)?.id
                throw `Missing handover source: %${t}, freed at %${t ? freedAt.get(t) : 'unknown'}`
            }
            if (a.dst === elide && !isSlot(src) && !dsts.has(src)) { landed = src; continue }
            moves.push({ dst: a.dst, src })
        }
        if (sigStats) {
            const n = g.nodes.get(site)
            if (n && n.op === 'apply') {
                const homes = new Set(moves.map(m => m.src))
                for (const m of moves) {
                    if (m.dst === m.src) continue
                    sigStats.applyMoves++
                    if (homes.has(m.dst)) sigStats.swaps++
                    const s = slots.find(x => x.dst === m.dst)
                    const v = s?.id ?? 0
                    if (!v) continue
                    if (isParam(g.nodes, v)) {
                        sigStats.fromParam++
                        const home = paramAt.get(v)
                        const declared = home ? sig.get(home[0])?.[home[1]] : undefined
                        if (declared !== undefined && declared !== m.src) {
                            sigStats.displaced++
                            if (isSlot(m.src)) sigStats.displacedToSlot++
                            if (isSlot(m.dst)) sigStats.dstIsSlot++
                        }
                        else if (declared !== m.dst) sigStats.mismatch++
                    }
                    else sigStats.fromValue++
                }
            }
        }
        const expired = new Map<number, number>()
        for (const [v, home] of settled) {
            if (!homeOf.has(v) && !isSlot(home) && !dsts.has(home)) expired.set(home, v)
        }
        const stores = moves.filter(m => isOutgoingArg(m.dst))
        const shuffled = moves.filter(m => !isOutgoingArg(m.dst))
        for (let i = 0; i < stores.length; i++) {
            const m = stores[i]
            const value = expired.get(m.src)
            const last = value !== undefined && !shuffled.some(x => x.src === m.src)
                && !stores.some((x, j) => j > i && x.src === m.src)
            transfer(m.dst, m.src, last ? { value, home: m.src } : undefined)
        }
        shuffle(shuffled, expired)
        for (const c of consts) {
            noteWrite(c.dst)
            if (isSlot(c.dst) && c.src === 0 && target.zeroReg !== undefined) put(() => asm.store(SP, slotOffset(c.dst), target.zeroReg!, Types.u64))
            else if (isSlot(c.dst)) put(() => {
                asm.movImm(SWAP, c.src)
                asm.store(SP, slotOffset(c.dst), SWAP, Types.u64)
            })
            else put(() => asm.movImm(c.dst, c.src))
        }
        return landed
    }

    function isZeroValue(ref: number, literal: number): boolean {
        while (ref) {
            const m = g.nodes.get(ref)!
            if (m.op === 'literal') return literalValue(m) === 0
            if (m.op !== 'after') return false
            const last = countIds(m) - 1
            literal = getLiteral(m, last)
            ref = getRef(m, last)
        }
        return literal === 0
    }

    function buildCall(id: number, n: GraphNode): void {
        const callee = g.nodes.get(getRef(n, 1))
        const syscall = callee?.op === 'syscall-target' ? callee : undefined
        const indirect = callee?.op === 'indirect-target' ? callee : undefined
        const local = callee?.op === 'local-target' ? callee : undefined
        assert(!indirect || countIds(indirect) === 1, `lowering: call %${id} still carries its context in the target`)
        const code = indirect ? [getRef(indirect, 0), getLiteral(indirect, 0)] : [getRef(n, 1), getLiteral(n, 1)]
        if (isZeroValue(code[0], code[1])) throw `lowering: ${g.name ?? 'graph'} calls undefined at %${id}`
        const homes = argHomes(id)
        const stacked = homes.some(isOutgoingArg)
        if (syscall) assert(!stacked, `lowering: syscall at %${id} takes more than ${target.syscall.argRegs.length} args`)
        if (syscall || stacked || homes.some(isPreserved)) tails.delete(id)
        if (!syscall) callsOut ||= !tails.has(id)
        for (const h of homes) if (isOutgoingArg(h)) outgoingArgWords = Math.max(outgoingArgWords, h - OUTGOING_ARGS + 1)
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const i of analysis.operandOrder.get(id) ?? []) {
            if (i === 0) sequenceIdx = slots.length
            if (i === 1 && indirect) {
                slots.push({ dst: CALLEE, id: getRef(indirect, 0), konst: getLiteral(indirect, 0) })
                continue
            }
            if (i < 3 && (i !== 1 || syscall || local)) continue
            slots.push({
                dst: i === 1 ? CALLEE : homes[i - 3],
                id: getRef(n, i), konst: getLiteral(n, i),
            })
        }
        done.add(id)
        const linkReg = handOver(id, slots, [sequenceIdx, () => effect(getRef(n, 0))], CALLEE)
        for (const x of volatiles) {
            const v = heldBy.get(x)
            if (v === undefined) continue
            if (rebuildable(g, v)) {
                if (!clobberOfCall(id).has(x)) continue
                freeValue(v, id)
                done.delete(v)
                continue
            }
            if (acrossCall.has(v) && !clobberOfCall(id).has(x)) continue
            const copy = copyOf.get(v)
            if (copy === undefined || !acrossCall.has(v)) {
                freeValue(v, id)
                continue
            }
            homeOf.set(v, copy)
            copyOf.delete(v)
            heldBy.delete(x)
        }
        if (syscall) {
            const number = getLiteral(syscall, 0)
            assert(!getRef(syscall, 0) && Number.isSafeInteger(number))
            for (const r of target.volatiles) written.add(r)
            put(() => asm.syscall(number))
        } else if (local) {
            const target = getLiteral(local, 0)
            const name = getDebugLabel(g, getRef(n, 1))
            assert(!getRef(local, 0) && Number.isSafeInteger(target) && target >= 0)
            localCalls.add(target)
            const region = currentRegion
            put(() => {
                if (!tailCalls || !tails.has(id)) return asm.callLocal(target, name)
                popFrame(region)
                asm.jumpLocal(target, name)
            })
        } else {
            for (const r of target.volatiles) written.add(r)
            const region = currentRegion
            put(() => {
                if (!tailCalls || !tails.has(id)) return asm.blr(linkReg)
                const reg = isPreserved(linkReg) ? CALLEE : linkReg
                if (reg !== linkReg) asm.mov(reg, linkReg)
                popFrame(region)
                asm.br(reg)
            })
        }
        const retRegs = syscall ? [target.syscall.retReg] : target.retRegs
        if (const projections = analysis.callProjections.get(id)) {
            for (const p of projections) {
                buildCallProjection(p, retRegs)
            }
            return
        }
        transfer(regFor(id, retRegs[0]), retRegs[0])
    }

    function buildCallProjection(id: number, retRegs: number[]) {
        const outer = materializing
        materializing = id
        defer materializing = outer
        defer finish()
        assert(!done.has(id), `Value is already done: ${id}`)
        const n = g.nodes.get(id)!
        assert(n.op === 'get', `Invalid proj op: ${n.op}`)
        const key = getLiteral(n, 1)
        const reg = retRegs[key]
        assert(reg !== undefined, `Unhandled proj key: ${key}`)
        transfer(regFor(id, reg), reg)
    }

    function effect(id: number): void {
        if (!id) return
        const n = g.nodes.get(id)
        if (!n) return
        const outer = transient
        transient = outer + 1
        defer transient = outer
        if (n.op === 'call') {
            if (!done.has(id) && !homeOf.has(id)) build(id)
        } else if (n.op === 'after') {
            if (!done.has(id)) build(id)
        } else if (n.op === 'store') {
            if (!done.has(id)) buildStore(id, n)
        } else if (n.op === 'load') {
            if (!done.has(id) && !homeOf.has(id)) build(id)
        } else if (n.op === 'select') {
            const taken = g.nodes.get(getRef(n, 1))?.op === 'panic' ? 2
                : g.nodes.get(getRef(n, 2))?.op === 'panic' ? 1 : 0
            if (!taken && preferBranchless(n)) {
                for (let i = 0; i < countIds(n); i++) {
                    effect(getRef(n, i))
                }
            } else {
                if (!taken) throw `lowering: effect ${id} branches before the tail\n${errorDump(g)}`
                effect(getRef(n, taken))
            }
        } else if (n.op === 'nil-effect' || n.op === 'void') return
        if (!analysis.usedBy.has(id)) {
            freeValue(id)
        }
    }

    function zeroOperand(n: GraphNode, i: number): boolean {
        return target.zeroReg !== undefined && !getRef(n, i) && getLiteral(n, i) === 0
    }

    function buildStore(id: number, n: GraphNode): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        const T = typeOf(n)
        const zero = zeroOperand(n, 3)
        const wanted = [0, 1]
        if (getRef(n, 2)) wanted.push(2)
        if (!zero) wanted.push(3)
        let b = 0
        let o = 0
        let v = 0
        for (const i of orderedOperands(id, wanted)) {
            if (i === 0) {
                effect(getRef(n, 0))
                continue
            }
            if (i === 3 && T === Types.f64 && getRef(n, 3) && !floats.has(getRef(n, 3))) {
                throw `lowering: f64 store of the non-f64 value %${getRef(n, 3)} [unit: ${g.name ?? '<anonymous>'}]`
            }
            const d = demand(getRef(n, i), getLiteral(n, i), -1, i === 3 && intrinsics.intrinsicBitWidth(T) <= 32, i === 3 && T === Types.f64)
            if (i === 1) b = d
            else if (i === 2) o = d
            else v = d
        }
        const guard = new Set<number>()
        const base = at(b, guard)
        guard.add(base)
        const ro = o ? at(o, guard) : -1
        if (o) guard.add(ro)
        const rv = zero ? target.zeroReg! : at(v, guard)
        guard.add(rv)
        finish()
        if (ro < 0) {
            const offset = getLiteral(n, 2)
            put(() => asm.store(base, offset, rv, T))
            return
        }
        put(() => asm.storeIndexed(base, ro, rv, T))
    }

    function buildLoad(id: number, n: GraphNode, want: number) {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        const T = typeOf(n)
        if (islandLoad(g, n)) {
            const pc = g.nodes.get(getRef(n, 1))!
            finish()
            const dst = regFor(id, want)
            const name = getDebugLabel(g, id)
            put(() => asm.loadLiteral(dst, getLiteral(pc, 1) + getLiteral(n, 2), name))
            return
        }
        if (!getRef(n, 2)) {
            let b0 = 0
            for (const i of orderedOperands(id, [0, 1])) {
                if (i === 0) effect(getRef(n, 0))
                else b0 = demand(getRef(n, 1), getLiteral(n, 1))
            }
            const base0 = at(b0, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => asm.load(dst, base0, getLiteral(n, 2), T))
            return
        }
        let b = 0, o = 0
        for (const i of orderedOperands(id, [0, 1, 2])) {
            if (i === 0) {
                effect(getRef(n, 0))
                continue
            }
            const v = demand(getRef(n, i), getLiteral(n, i))
            if (i === 1) b = v
            else o = v
        }
        const guard = new Set<number>()
        const rb = at(b, guard)
        guard.add(rb)
        const ro = at(o, guard)
        finish()
        const dst = regFor(id, want)
        put(() => asm.loadIndexed(dst, rb, ro, T))
    }

    function condition(site: number, id: number, konst: number, target: number, whenTrue = false): void {
        const outer = materializing
        materializing = id || site
        defer materializing = outer
        if (opts.debug) console.log('condition', id, '@', site)
        const v = demand(id, konst)
        const r = at(v, NOTHING)
        finish(id)
        finish(site)
        put(() => whenTrue ? asm.jumpIfNonZero(r, target) : asm.jumpIfZero(r, target))
    }

    function preferBranchless(n: GraphNode) {
        if (countIds(n) !== 3) return false
        for (let i = 1; i < 3; i++) {
            const u = getRef(n, i)
            if (!u || u) continue
            if (homeOf.has(u) || done.has(u)) continue
            if (!pure.has(u) && g.nodes.get(u)?.op !== 'param') return false
            const p = g.nodes.get(u)
            if (!p) continue
            for (let j = 0; j < countIds(p); j++) {
                const q = getRef(p, j)
                if (!q) continue
                //if (!homeOf.has(q) && !done.has(q) && g.nodes.get(q)) return false
            }
        }
        return true
    }

    function buildSelect(id: number, n: GraphNode, want: number): void {
        if (preferBranchless(n)) {
            const zero = (i: number) => zeroOperand(n, i)
            const slots: number[] = []
            for (const i of orderedOperands(id, [0, 1, 2])) {
                if (i > 0 && zero(i)) continue
                const v = demand(getRef(n, i), getLiteral(n, i))
                slots[i] = v
            }
            const guard = new Set<number>()
            const rc = at(slots[0], guard)
            guard.add(rc)
            const rx = zero(1) ? target.zeroReg! : at(slots[1], guard)
            guard.add(rx)
            const ry = zero(2) ? target.zeroReg! : at(slots[2], guard)
            finish(id)
            const dst = regFor(id, want)
            put(() => asm.select(dst, rc, rx, ry))
            return
        }
        console.log(errorDump(g))
        throw `lowering3: select ${id} branches in value position`
    }

    function returnRecord(site: number, n: GraphNode): void {
        const outer = materializing
        materializing = site
        defer materializing = outer
        const slots: Handover[] = []
        for (let i = 0; i < countIds(n); i += 2) {
            const reg = target.retRegs[getLiteral(n, i)]
            assert(reg !== undefined, `Unhandled return slot: ${getLiteral(n, i)}`)
            slots.push({ dst: reg, id: getRef(n, i + 1), konst: getLiteral(n, i + 1) })
        }
        handOver(site, slots, [-1, () => {}])
        jumpToExit()
    }

    function returnValue(site: number, id: number, konst: number): void {
        if (!id) put(() => asm.movImm(RET, konst))
        else {
            const k = g.nodes.get(id)?.op === 'literal' ? literalValue(g.nodes.get(id)!) : undefined
            if (k !== undefined) {
                put(() => asm.movImm(RET, k))
                return jumpToExit()
            }
            if (g.nodes.get(id)?.op === 'call' && !done.has(id)) tails.add(id)
            const v = demand(id, konst, RET)
            const src = v ? homeOf.get(v)! : undefined
            finish(site)
            if (v) {
                transfer(RET, src!, { value: v, home: src! })
            }
        }
        jumpToExit(id)
    }

    const coldStubs: { label: number, code: ((() => void) | ReleaseEvent | TransferEvent)[] }[] = []

    function emitApply(id: number, n: GraphNode, jump = true, branchedTo?: number): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        const b = getBlock(g, getRef(n, 0))
        if (!b) throw 'lowering3: apply of something that is not a block'
        const homes = sig.get(b.id)!
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const at of analysis.operandOrder.get(id) ?? []) {
            if (at < 1 || at > b.params.length) continue
            const i = at - 1
            slots.push({
                dst: homes[i], id: getRef(n, i + 1), konst: getLiteral(n, i + 1), rank: i,
                settle: (r: number) => { homes[i] = r },
            })
        }
        const mark = code.length
        handOver(id, slots, [sequenceIdx, () => {}])
        let from = armStart >= 0 ? armStart : mark
        while (from < code.length && 'released' in code[from]) from++
        if (branchedTo !== undefined) {
            if (analysis.sinks.has(id)) {
                entryCode.set(b.id, { label: branchedTo, code: code.splice(from, code.length - from) })
                return
            }
            const label = entryLabels.get(b.id) ?? b.id
            put(() => asm.jump(label))
            coldStubs.push({ label: branchedTo, code: code.splice(from, code.length - from) })
            return
        }
        if (jump && from < code.length && analysis.sinks.has(id)) {
            const label = nextLabel++
            entryCode.set(b.id, { label, code: code.splice(from, code.length - from) })
            put(() => {
                asm.jump(label)
                asm.releaseLabel(label)
            })
        }
        else if (jump) {
            const label = entryLabels.get(b.id) ?? b.id
            const isLastBranch = analysis.effectivelyLinearBlocks.has(b.id)
            put(() => {
                asm.jump(label)
                if (isLastBranch) asm.releaseLabel(label)
            })
        }
        else {
            for (let i = 0; i < b.params.length; i++) {
                if (!getRef(n, i + 1)) continue
                place(getRef(n, i + 1), homes[i])
            }
        }
    }

    function exitsFunction(id: number): boolean {
        if (!id) return true
        const n = g.nodes.get(id)!
        if (n.op === 'after') return exitsFunction(getRef(n, countIds(n)-1))
        if (n.op === 'select') {
            return exitsFunction(getRef(n, 1))
                && exitsFunction(getRef(n, 2))
        }
        if (n.op === 'apply') return false
        return true
    }

    function emitTailRegion(id: number, konst: number, group: number): void {
        if (currentBlock !== g.blocks[0].id || !exitsFunction(id)) {
            emitTail(id, konst)
            return
        }
        const parent = currentRegion
        const region: EmitRegion = {
            parent, children: [], writes: new Set(), owned: [], exitLabel: nextLabel++, group,
        }
        parent.children.push(region)
        currentRegion = region
        put(() => {
            for (const r of region.owned) asm.store(SP, frame!.saved(savedIndex.get(r)!), r, Types.u64)
        })
        emitTail(id, konst)
        currentRegion = parent
    }

    function emitTail(id: number, konst: number): void {
        const n = id ? g.nodes.get(id) : undefined
        if (!n) { returnValue(id, id, konst); return }
        if (n.op === 'after') {
            if (homeOf.has(id)) {
                return returnValue(id, id, konst)
            }
            const result = countIds(n) - 1
            const ordering = orderingOperands(id, n)
            const last = ordering.length ? getRef(n, ordering[ordering.length - 1]) : 0
            const value = g.nodes.get(getRef(n, result))
            const returned = value?.op === 'ret' && getRef(value, 0) === last
            const tail = (value?.op === 'void' || returned) && g.nodes.get(last)?.op === 'call' && !done.has(last)
            if (tail) tails.add(last)
            for (const i of ordering) if (!returned || !tail || getRef(n, i) !== last) effect(getRef(n, i))
            if (tail && !returned) return jumpToExit(last)
            emitTail(getRef(n, result), getLiteral(n, result))
            return
        }
        if (n.op === 'select') {
            if (homeOf.has(id)) {
                return returnValue(id, id, konst) // for non-tail
            }
            if (const target = analysis.rotated.get(id)) {
                const codeLen = code.length
                const entry = entryLabels.get(target)!
                put(() => asm.bindLabel(entry))
                condition(id, getRef(n, 0), getLiteral(n, 0), currentBlock, true)
                const header = code.splice(codeLen, code.length-codeLen)
                armStart = -1
                const before = snapshot()
                const group = nextRegionGroup++
                narrowTo(getRef(n, 1))
                emitTailRegion(getRef(n, 1), getLiteral(n, 1), group)
                widen()
                restore(before)
                code.push(...header)
                narrowTo(getRef(n, 2))
                emitTailRegion(getRef(n, 2), getLiteral(n, 2), group)
                widen()
                return
            }
            const cold = analysis.coldArm.get(id)
            if (cold) {
                const hot = 3 - cold
                const otherwise = nextLabel++
                condition(id, getRef(n, 0), getLiteral(n, 0), otherwise, hot === 2)
                const before = snapshot()
                const group = nextRegionGroup++
                narrowTo(getRef(n, hot))
                armStart = code.length
                emitTailRegion(getRef(n, hot), getLiteral(n, hot), group)
                widen()
                restore(before)
                narrowTo(getRef(n, cold))
                armStart = code.length
                emitApply(getRef(n, cold), g.nodes.get(getRef(n, cold))!, true, otherwise)
                widen()
                return
            }
            const first = analysis.firstArm.get(id) ?? 1
            const otherwise = nextLabel++
            condition(id, getRef(n, 0), getLiteral(n, 0), otherwise, first === 2)
            const before = snapshot()
            const group = nextRegionGroup++
            narrowTo(getRef(n, first))
            armStart = code.length
            emitTailRegion(getRef(n, first), getLiteral(n, first), group)
            widen()
            restore(before)
            put(() => { asm.bindLabel(otherwise); asm.releaseLabel(otherwise) })
            narrowTo(getRef(n, 3 - first))
            armStart = code.length
            emitTailRegion(getRef(n, 3 - first), getLiteral(n, 3 - first), group)
            widen()
            return
        }
        if (n.op === 'apply') { emitApply(id, n); return }
        if (n.op === 'panic') { jumpToExit(); return }
        if (n.op === 'trap') {
            const code = getLiteral(n, 1)
            effect(getRef(n, 0))
            finish(id)
            put(() => asm.trap(code))
            return
        }
        if (n.op === 'unreachable') {
            finish(id)
            put(() => asm.trap(0))
            return
        }
        if (n.op === 'ret') {
            return emitTail(getRef(n!, 0), getLiteral(n!, 0))
        }
        if (n.op === 'record') { returnRecord(id, n); return }
        returnValue(id, id, konst)
    }

    for (const id of order) {
        const b = getBlock(g, id)!
        if (sigStats) {
            sigStats.blocks++
            if (homeOf.size) {
                sigStats.leakedBlocks++
                sigStats.leaked += homeOf.size
                for (const [v] of homeOf) {
                    const op = isParam(g.nodes, v) ? 'param' : (g.nodes.get(v)?.op ?? 'synth')
                    sigStats.leakKinds.set(op, (sigStats.leakKinds.get(op) ?? 0) + 1)
                }
            }
        }
        for (const v of [...homeOf.keys()]) freeValue(v, id)
        currentBlock = id
        currentRegion = rootRegion
        armStart = -1
        homeOf.clear()
        copyOf.clear()
        heldBy.clear()
        done.clear()
        reusableSlots.clear()
        for (let i = 0; i < slotCount; i++) reusableSlots.add(SLOTS + i)
        const piece = entryCode.get(id)
        if (piece) {
            put(() => asm.bindLabel(piece.label))
            for (const f of piece.code) code.push(f)
        }
        put(() => asm.bindLabel(b.id))
        if (id === g.blocks[0].id) {
            const entry = sig.get(id)!
            for (let i = 0; i < b.params.length; i++) place(b.params[i], entry[i])
            for (let i = 0; i < b.params.length; i++) {
                if (entry[i] === entryHomes[i]) continue
                assert(isSlot(entryHomes[i]) || isSlot(entry[i]) || !entryHomes.includes(entry[i]), 'lowering: entry param overlaps an argument register')
                transfer(entry[i], entryHomes[i])
            }
            emitTail(b.bodyId, b.bodyConst)
            continue
        }
        const homes = sig.get(id)!
        for (let i = 0; i < b.params.length; i++) place(b.params[i], homes[i])
        emitTail(b.bodyId, b.bodyConst)
    }
    for (const stub of coldStubs) {
        put(() => asm.bindLabel(stub.label))
        for (const f of stub.code) code.push(f)
    }

    function promoteCommonRegionWrites(region: EmitRegion): Set<number> {
        const subtree: Set<number>[] = []
        const groups = new Map<number, number[]>()
        for (let i = 0; i < region.children.length; i++) {
            const child = region.children[i]
            subtree.push(promoteCommonRegionWrites(child))
            const siblings = groups.get(child.group)
            if (siblings) siblings.push(i)
            else groups.set(child.group, [i])
        }
        for (const siblings of groups.values()) {
            if (siblings.length < 2) continue
            const common = new Set(subtree[siblings[0]])
            for (let i = 1; i < siblings.length; i++) {
                const writes = subtree[siblings[i]]
                for (const r of common) if (!writes.has(r)) common.delete(r)
            }
            for (const r of common) region.writes.add(r)
        }
        const all = new Set(region.writes)
        for (const writes of subtree) for (const r of writes) all.add(r)
        return all
    }

    function assignRegionRegisters(region: EmitRegion, inherited: Set<number>): void {
        region.owned = target.calleeSaved.filter(r => region.writes.has(r) && written.has(r) && !inherited.has(r))
        const watermark = new Set(inherited)
        for (const r of region.owned) watermark.add(r)
        for (const child of region.children) assignRegionRegisters(child, watermark)
    }
    promoteCommonRegionWrites(rootRegion)
    assignRegionRegisters(rootRegion, new Set())

    tailCalls = !analysis.frameAllocas && (framedTailCalls || (!usedPreserved.size && !slotCount && !callsOut))
    if (!tailCalls && tails.size) callsOut = true
    const saved = target.calleeSaved.filter(r => usedPreserved.has(r) && written.has(r))
    for (let i = 0; i < saved.length; i++) savedIndex.set(saved[i], i)
    const savesLink = callsOut && LR !== undefined
    const layout = target.layoutFrame({
        saved: saved.length, link: savesLink, slots: slotCount, outgoingArgs: outgoingArgWords, allocas: analysis.frameAllocas,
    })
    frame = layout
    if (layout.bytes) asm.spAdjust(layout.bytes)
    for (const r of rootRegion.owned) asm.store(SP, layout.saved(savedIndex.get(r)!), r, Types.u64)
    if (savesLink) asm.store(SP, layout.link, LR!, Types.u64)
    let released: { value: number, home: number }[] = []
    for (const item of code) {
        if (typeof item !== 'function') {
            if ('released' in item) {
                released.push(...item.released)
                continue
            }
            const { dst, src, consumed } = item
            if (isSlot(src) && isSlot(dst)) {
                asm.load(SWAP, SP, slotOffset(src), Types.u64)
                asm.store(SP, slotOffset(dst), SWAP, Types.u64)
            } else if (isSlot(src)) asm.load(dst, SP, slotOffset(src), Types.u64)
            else if (isSlot(dst)) asm.store(SP, slotOffset(dst), src, Types.u64)
            else asm.mov(dst, src)
            if (consumed) released.push(consumed)
            released = released.filter(value => value.home !== dst)
            if (released.length) {
                asm.released(released.filter(value => !isSlot(value.home)))
                released = []
            }
            continue
        }
        item()
        if (released.length) {
            asm.released(released.filter(value => !isSlot(value.home)))
            released = []
        }
    }

    function popFrame(region: EmitRegion): void {
        for (let r: EmitRegion | undefined = region; r; r = r.parent) {
            for (const reg of r.owned) asm.load(reg, SP, layout.saved(savedIndex.get(reg)!), Types.u64)
        }
        if (savesLink) asm.load(LR!, SP, layout.link, Types.u64)
        if (layout.bytes) asm.spAdjust(-layout.bytes)
    }

    const epilogues: EmitRegion[] = []
    function collectEpilogues(region: EmitRegion): void {
        for (const child of region.children) collectEpilogues(child)
        if (region !== rootRegion && region.owned.length) epilogues.push(region)
    }
    collectEpilogues(rootRegion)
    for (let i = 0; i < epilogues.length; i++) {
        const region = epilogues[i]
        asm.bindLabel(region.exitLabel)
        for (const r of region.owned) asm.load(r, SP, layout.saved(savedIndex.get(r)!), Types.u64)
        const target = regionExit(region.parent)
        const next = i + 1 < epilogues.length ? epilogues[i + 1].exitLabel : exitLabel
        if (target !== next) asm.jump(target)
    }
    asm.bindLabel(exitLabel)
    for (const r of rootRegion.owned) asm.load(r, SP, layout.saved(savedIndex.get(r)!), Types.u64)
    if (savesLink) asm.load(LR!, SP, layout.link, Types.u64)
    if (layout.bytes) asm.spAdjust(-layout.bytes)
    if (reachesExit || !tailCalls) asm.ret()

    if (spillStats && spillStats.total) console.log(`SPILLS ${g.name} total=${spillStats.total} again=${spillStats.again}`)
    if (spillStats && evictedOps.size) console.log(`EVICTED ${g.name} ${[...evictedOps].map(([op, n]) => `${op}=${n}`).join(' ')}`)
    if (spillStats && handoverKinds.size) console.log(`HANDOVER ${g.name} ${[...handoverKinds].map(([k, n]) => `${k}=${n}`).join(', ')}`)
    if (branchWasteProbe || intrinsics.argv().includes(`branch-waste:${g.name}`)) {
        reportBranchWaste(g.name ?? '<anonymous>', asm.listing())
    }
    let listing: string | undefined
    for (const r of target.calleeSaved) written.delete(r)
    return {
        target, words: asm.words(), bytes: asm.bytes(), relocations: asm.relocations(),
        get listing() { return listing ??= asm.listing() },
        clobbers: written, localCalls, island,
    }
}

const foldSharedOffsets = intrinsics.argv().includes('fold-shared-offsets')
const rotateAnyLoop = intrinsics.argv().includes('rotate-any-loop')
const branchWasteProbe = intrinsics.argv().includes('branch-waste')

function reportBranchWaste(name: string, listing: string): void {
    const before = new Map<string, string>()
    const jumps: [at: string, to: string][] = []
    let last = ''
    let lastAt = ''
    for (const raw of listing.split('\n')) {
        const line = raw.trim()
        if (!line) continue
        if (line.endsWith(':')) { before.set(line.slice(0, -1), last); continue }
        const at = line.slice(0, line.indexOf(':'))
        const text = line.slice(line.indexOf(':') + 1).trim()
        const body = text.slice(text.indexOf(' ') + 1).trim()
        const op = body.slice(0, body.indexOf(' ') < 0 ? body.length : body.indexOf(' '))
        if (op === 'b') jumps.push([at, body.slice(2).trim()])
        last = op
        lastAt = at
    }
    let waste = 0
    for (const [at, to] of jumps) {
        const prior = before.get(to)
        if (prior !== 'b' && prior !== 'ret') continue
        waste++
        console.log('WASTE', name, `${at}: b ${to} (preceded by ${prior})`)
    }
    console.log('WASTE', name, `totals jumps=${jumps.length} wasted=${waste}`)
}
