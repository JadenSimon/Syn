"use wrapped";

import * as intrinsics from './intrinsics'
import * as lowering from './lowering'
import { packageBlocks2 } from './packaging'

const Types = intrinsics.Types
const assert = intrinsics.assert

export interface GraphNode {
    op: string
    argIds: number[]
    argConsts: Float64Array
    label?: string
    T: intrinsics.Types
    U: intrinsics.Types
    types?: intrinsics.Types[]
}

export interface GraphBlock {
    id: number
    params: number[]
    inputs?: number[]
    slots?: number[]
    effectSlot?: number
    bodyId: number
    bodyConst: number
    consumesEffectToken?: boolean
}

export interface Graph {
    maxId: number
    nodes: Map<number, GraphNode>
    params: number[]
    blocks: GraphBlock[]
    name?: string
}

export function isParam(nodes: Map<number, GraphNode>, id: number): boolean {
    return !!nodes.get(id) && nodes.get(id)!.op === 'param'
}

function paramNode(label?: string): GraphNode {
    return {
        op: 'param', argIds: [], argConsts: new Float64Array(0),
        label, T: Types.u64, U: Types.u64,
    }
}

const BinaryOps = new Set<string>([
    'add', 'sub', 'mul', 'div', 'rem', 'or', 'and', 'xor', 'shl', 'shr', 'ushr', 'subsat',
])
const CompareOps = new Set<string>(['lt', 'le', 'gt', 'ge', 'eq', 'ne'])
const UnaryOps = new Set<string>(['neg', 'not'])
const MaterializedPureOps = new Set<string>([
    ...BinaryOps, ...CompareOps, ...UnaryOps, 'convert', 'bitconvert', 'pool-entry', 'void',
])
const PureOps = new Set<string>([
    'add', 'sub', 'mul', 'div', 'rem', 'or', 'and', 'xor', 'shl', 'shr', 'ushr', 'subsat',
    'lt', 'le', 'gt', 'ge', 'eq', 'ne', 'neg', 'not', 'select', 'convert', 'bitconvert',
    'syscall-target', 'local-target', 'indirect-target', 'call-context', 'pool-entry', 'void',
    'param', 'heap-handle', 'nil-effect'
])
const Commutative = new Set<string>(['add', 'mul', 'and', 'or', 'xor'])
const SwappedCmp: Record<string, string> = {
    lt: 'gt', gt: 'lt', le: 'ge', ge: 'le', eq: 'eq', ne: 'ne',
}

// TODO: move these to assembler
const SP = 31
const LR = 30

export interface LowerGraphOptions {
    target?: lowering.Target
    regBudget?: number
    debug?: boolean
}

export interface LowerGraphResult {
    target: lowering.Target
    words: number[]
    bytes: number[]
    relocations: lowering.Relocation[]
    listing: string
}

// TODO:
// V1: (call, nil, p2, 0)
// = (select, p0, V1, (select, p1, (call, (call, nil, p3, 0), p2, 0), V1))
//
// can be turned into (select, (and, p0, (not, p1)), (call, nil, p2, 0), (call, (call, nil, p3, 0), p2, 0))

export function reduceEffectDependencies(g: Graph): Graph {
    const nodes = new Map<number, GraphNode>(g.nodes)
    let nextId = g.maxId
    let changed = false
    let nil = 0
    for (const [id, n] of nodes) if (n.op === 'nil-effect') { nil = id; break }
    function nilEffect(): number {
        if (!nil) {
            nil = nextId++
            nodes.set(nil, {
                op: 'nil-effect', argIds: [], argConsts: new Float64Array(0),
                T: Types.u64, U: Types.u64,
            })
        }
        return nil
    }

    const tokenParams = new Set<number>()
    const blockOf = new Map<number, GraphBlock>()
    for (const b of g.blocks) {
        blockOf.set(b.id, b)
        if (b.consumesEffectToken && b.params.length) tokenParams.add(b.params[b.params.length - 1])
    }

    const divergesMemo = new Map<number, boolean>()
    function diverges(id: number): boolean {
        if (!id) return false
        const known = divergesMemo.get(id)
        if (known !== undefined) return known
        const n = nodes.get(id)
        let out = false
        if (n) {
            if (n.op === 'panic') out = true
            else if (n.op === 'after') out = diverges(n.argIds[0]) || diverges(n.argIds[1])
            else if (n.op === 'select') out = diverges(n.argIds[1]) && diverges(n.argIds[2])
            else if (n.op === 'apply') {
                for (let i = 1; !out && i < n.argIds.length; i++) out = diverges(n.argIds[i])
            }
        }
        divergesMemo.set(id, out)
        return out
    }

    for (const [id, n] of nodes) {
        if (n.op !== 'select') continue
        let survivor = -1
        for (let i = 1; i < n.argIds.length; i++) {
            if (diverges(n.argIds[i])) continue
            if (survivor >= 0) { survivor = -2; break }
            survivor = i
        }
        if (survivor < 0) continue
        const args = new Float64Array(2)
        args[0] = n.argConsts[0]
        args[1] = n.argConsts[survivor]
        nodes.set(id, {
            ...n, op: 'after',
            argIds: [n.argIds[0], n.argIds[survivor]],
            argConsts: args,
        })
        changed = true
    }

    const siblingOf = new Map<number, number>()
    const ambiguous = new Set<number>()
    for (const n of nodes.values()) {
        if (n.op !== 'select') continue
        const a = n.argIds[1]
        const b = n.argIds[2]
        if (!a || !b || a === b) {
            if (a) ambiguous.add(a)
            if (b) ambiguous.add(b)
            continue
        }
        const prevA = siblingOf.get(a)
        if (prevA !== undefined && prevA !== b) ambiguous.add(a)
        else siblingOf.set(a, b)
        const prevB = siblingOf.get(b)
        if (prevB !== undefined && prevB !== a) ambiguous.add(b)
        else siblingOf.set(b, a)
    }

    const evalArms = new Map<number, Set<number>>()
    const dataArms = new Map<number, Set<number>>()
    const demanded = new Set<number>()
    {
        const queue: [id: number, arms: Set<number>, used: boolean][] = []
        function send(id: number, arms: Set<number>, mark: number, used: boolean): void {
            if (!id) return
            const next = new Set<number>(arms)
            if (mark) next.add(mark)
            queue.push([id, next, used])
        }
        function narrow(map: Map<number, Set<number>>, id: number, arms: Set<number>): boolean {
            const prev = map.get(id)
            if (!prev) { map.set(id, new Set<number>(arms)); return true }
            const drop: number[] = []
            for (const a of prev) if (!arms.has(a)) drop.push(a)
            for (const a of drop) prev.delete(a)
            return drop.length > 0
        }
        for (const b of g.blocks) {
            send(b.bodyId, new Set<number>(), 0, false)
            send(b.bodyId, new Set<number>(), 0, true)
        }
        while (queue.length) {
            const [id, arms, used] = queue.pop()!
            if (used) demanded.add(id)
            if (!narrow(used ? dataArms : evalArms, id, arms)) continue
            const n = nodes.get(id)
            if (!n) continue
            const evalCtx = evalArms.get(id) ?? arms
            const dataCtx = dataArms.get(id) ?? evalCtx
            const isUsed = demanded.has(id)
            if (n.op === 'select') {
                send(n.argIds[0], evalCtx, 0, false)
                if (isUsed) send(n.argIds[0], dataCtx, 0, true)
                for (let i = 1; i < n.argIds.length; i++) {
                    const arm = n.argIds[i]
                    if (!arm) continue
                    const mark = ambiguous.has(arm) ? 0 : arm
                    send(arm, evalCtx, mark, false)
                    if (isUsed) send(arm, dataCtx, mark, true)
                }
            } else if (n.op === 'after') {
                send(n.argIds[0], evalCtx, 0, false)
                send(n.argIds[1], evalCtx, 0, false)
                if (isUsed) send(n.argIds[1], dataCtx, 0, true)
            } else if (n.op === 'call' || n.op === 'store' || n.op === 'load') {
                send(n.argIds[0], evalCtx, 0, false)
                for (let i = 1; i < n.argIds.length; i++) {
                    send(n.argIds[i], evalCtx, 0, false)
                    send(n.argIds[i], evalCtx, 0, true)
                }
            } else if (n.op === 'apply') {
                const b = blockOf.get(n.argIds[0])
                for (let i = 1; i < n.argIds.length; i++) {
                    send(n.argIds[i], evalCtx, 0, false)
                    if (!b?.consumesEffectToken || i !== n.argIds.length - 1) {
                        send(n.argIds[i], evalCtx, 0, true)
                    }
                }
            } else {
                for (const a of n.argIds) {
                    send(a, evalCtx, 0, false)
                    if (isUsed) send(a, dataCtx, 0, true)
                }
            }
        }
    }

    function released(load: number, at: number): boolean {
        const reads = dataArms.get(load)
        const runs = evalArms.get(at)
        if (!reads || !runs) return false
        for (const arm of reads) {
            const other = siblingOf.get(arm)
            if (other !== undefined && runs.has(other)) return true
        }
        return false
    }

    const memos = [new Map<number, number>(), new Map<number, number>()]
    const active = new Set<number>()
    function sequence(a: number, b: number, source: GraphNode): number {
        if (!a) return b
        if (!b || a === b) return a
        const id = nextId++
        nodes.set(id, {
            ...source, op: 'after', argIds: [a, b], argConsts: new Float64Array(2),
        })
        return id
    }
    // `ordered` reductions are for writers
    function effects(id: number, ordered: boolean): number {
        if (!id) return 0
        const memo = memos[ordered ? 1 : 0]
        const known = memo.get(id)
        if (known !== undefined) return known
        if (active.has(id)) return id
        active.add(id)
        const n = isParam(nodes, id) ? undefined : nodes.get(id)
        let out = id
        if (!n) out = tokenParams.has(id) ? id : 0
        else if (n.op === 'nil-effect') out = 0
        else if (n.op === 'after') {
            const a = effects(n.argIds[0], ordered)
            const b = effects(n.argIds[1], ordered)
            out = a === n.argIds[0] && b === n.argIds[1] ? id : sequence(a, b, n)
        } else if (n.op === 'load' && ordered && demanded.has(id)) {
            out = id
        } else if (n.op === 'load' || n.op === 'is-state' || PureOps.has(n.op)) {
            out = 0
            for (const arg of n.argIds) out = sequence(out, effects(arg, ordered), n)
        }
        active.delete(id)
        memo.set(id, out)
        return out
    }

    function isOperand(n: GraphNode, id: number): boolean {
        for (let i = 1; i < n.argIds.length; i++) if (n.argIds[i] === id) return true
        return false
    }

    function flatten(id: number, out: number[]): void {
        const n = nodes.get(id)
        if (n?.op === 'after') {
            flatten(n.argIds[0], out)
            flatten(n.argIds[1], out)
            return
        }
        if (id) out.push(id)
    }

    function dropReleased(effect: number, at: number, source: GraphNode): number {
        const parts: number[] = []
        flatten(effect, parts)
        let drops = 0
        for (const p of parts) if (nodes.get(p)?.op === 'load' && released(p, at)) drops++
        if (!drops) return effect
        let out = 0
        for (const p of parts) {
            if (nodes.get(p)?.op === 'load' && released(p, at)) continue
            out = sequence(out, p, source)
        }
        return out
    }

    const reduced: [id: number, n: GraphNode, effect: number][] = []
    for (const [id, n] of [...nodes]) {
        if (n.op !== 'after' && n.op !== 'call' && n.op !== 'store' && n.op !== 'load') continue
        let effect = effects(n.argIds[0], n.op !== 'after' && n.op !== 'load')
        if (n.op !== 'after') effect = dropReleased(effect, id, n)
        for (;;) {
            const e = nodes.get(effect)
            if (!e) break
            if (e.op === 'load' && isOperand(n, effect)) { effect = 0; break }
            if (e.op !== 'after') break
            const tail = e.argIds[1]
            if (nodes.get(tail)?.op !== 'load' || !isOperand(n, tail)) break
            effect = e.argIds[0]
        }
        if (effect === n.argIds[0]) continue
        reduced.push([id, n, effect])
    }
    for (const [id, n, effect] of reduced) {
        const argIds = n.argIds.slice()
        argIds[0] = effect || nilEffect()
        if (argIds[0] === n.argIds[0]) continue
        nodes.set(id, { ...n, argIds })
        changed = true
    }
    if (!changed) return g
    return { ...g, maxId: nextId, nodes, params: g.params, blocks: g.blocks }
}

export function pureValues(g: Graph): Set<number> {
    const pure = new Set<number>()
    const checked = new Set<number>()
    pure.add(0)
    checked.add(0)
    function walk(id: number): boolean {
        if (checked.has(id)) return pure.has(id)
        checked.add(id)
        pure.add(id)
        const n = g.nodes.get(id)
        let ok = true
        if (n) {
            ok = PureOps.has(n.op)
            if (ok) for (const a of n.argIds) if (!walk(a)) { ok = false; break }
        }
        if (!ok) pure.delete(id)
        return ok
    }
    for (const [id, n] of g.nodes) {
        walk(id)
        for (const a of n.argIds) walk(a)
    }
    for (const b of g.blocks) {
        for (const p of b.params) walk(p)
        walk(b.bodyId)
    }
    return pure
}

export function pruneBlockParams(g: Graph): Graph {
    const applied = new Map<number, GraphNode[]>()
    const escaped = new Set<number>()
    const sequenced = new Set<number>()
    for (const n of g.nodes.values()) {
        for (let i = 0; i < n.argIds.length; i++) {
            if (n.op === 'apply' && i === 0) continue
            if (n.argIds[i]) escaped.add(n.argIds[i])
        }
        if (n.op === 'after' || n.op === 'call' || n.op === 'store' || n.op === 'load') {
            sequenced.add(n.argIds[0])
        }
        if (n.op !== 'apply') continue
        const list = applied.get(n.argIds[0]) ?? []
        list.push(n)
        applied.set(n.argIds[0], list)
    }

    const params = new Set<number>()
    const blockById = new Map<number, GraphBlock>()
    const flows = new Map<number, number[]>()
    for (const b of g.blocks) {
        blockById.set(b.id, b)
        for (const param of b.params) params.add(param)
    }
    for (const [blockId, calls] of applied) {
        const block = blockById.get(blockId)
        if (!block?.consumesEffectToken) continue
        for (const call of calls) sequenced.add(call.argIds[call.argIds.length - 1])
    }

    const inert = new Set<number>([0])
    {
        const checked = new Set<number>([0])
        function walk(id: number): boolean {
            if (checked.has(id)) return inert.has(id)
            checked.add(id)
            inert.add(id)
            const n = g.nodes.get(id)
            let ok = true
            if (n) {
                ok = PureOps.has(n.op) || (n.op === 'load' && !sequenced.has(id))
                if (ok) for (const a of n.argIds) if (!walk(a)) { ok = false; break }
            }
            if (!ok) inert.delete(id)
            return ok
        }
        for (const [id, n] of g.nodes) {
            walk(id)
            for (const a of n.argIds) walk(a)
        }
        for (const b of g.blocks) {
            for (const p of b.params) walk(p)
            walk(b.bodyId)
        }
    }
    for (const [blockId, calls] of applied) {
        const block = blockById.get(blockId)
        if (!block) continue
        for (let i = 0; i < block.params.length; i++) {
            const args: number[] = []
            for (const call of calls) args.push(call.argIds[i + 1])
            flows.set(block.params[i], args)
        }
    }

    const live = new Set<number>()
    const walked = new Set<number>()
    function mark(id: number): void {
        if (!id) return
        if (params.has(id)) {
            if (live.has(id)) return
            live.add(id)
            for (const arg of flows.get(id) ?? []) mark(arg)
            return
        }
        if (walked.has(id)) return
        walked.add(id)
        const n = g.nodes.get(id)
        if (!n) return
        if (n.op === 'apply') return
        for (const arg of n.argIds) mark(arg)
    }
    for (const b of g.blocks) {
        mark(b.bodyId)
        if (b.consumesEffectToken) mark(b.params[b.params.length - 1])
    }

    const rename = new Map<number, number>()
    const dropped = new Map<number, Set<number>>()
    for (const b of g.blocks) {
        const calls = applied.get(b.id)
        if (!calls || escaped.has(b.id)) continue
        const pinned = b.consumesEffectToken ? b.params.length - 1 : -1
        const keep: number[] = []
        const drop = new Set<number>()
        for (let j = 0; j < b.params.length; j++) {
            if (j !== pinned && !live.has(b.params[j])) {
                let inertEverywhere = true
                for (const c of calls) if (!inert.has(c.argIds[j + 1])) { inertEverywhere = false; break }
                if (inertEverywhere) { drop.add(j); continue }
            }
            let dup = -1
            for (const i of j === pinned ? [] : keep) {
                let every = true
                for (const c of calls) {
                    if (c.argIds[i + 1] !== c.argIds[j + 1]) { every = false; break }
                    if (!c.argIds[j + 1] && !Object.is(c.argConsts[i + 1], c.argConsts[j + 1])) { every = false; break }
                }
                if (every) { dup = i; break }
            }
            if (dup < 0) { keep.push(j); continue }
            rename.set(b.params[j], b.params[dup])
            drop.add(j)
        }
        if (drop.size) dropped.set(b.id, drop)
    }
    if (!rename.size && !dropped.size) return g

    const nodes = new Map<number, GraphNode>()
    for (const [id, n] of g.nodes) {
        const argIds = n.argIds.slice()
        for (let i = 0; i < argIds.length; i++) {
            const to = rename.get(argIds[i])
            if (to !== undefined) argIds[i] = to
        }
        const drop = n.op === 'apply' ? dropped.get(n.argIds[0]) : undefined
        if (!drop) { nodes.set(id, { ...n, argIds, argConsts: n.argConsts.slice() }); continue }
        const ids = [argIds[0]]
        const consts = [n.argConsts[0]]
        for (let i = 1; i < argIds.length; i++) {
            if (drop.has(i - 1)) continue
            ids.push(argIds[i])
            consts.push(n.argConsts[i])
        }
        nodes.set(id, { ...n, argIds: ids, argConsts: new Float64Array(consts) })
    }

    const blocks: GraphBlock[] = []
    for (const b of g.blocks) {
        const drop = dropped.get(b.id)
        if (!drop) { blocks.push(b); continue }
        const params: number[] = []
        const inputs: number[] = []
        for (let i = 0; i < b.params.length; i++) {
            if (drop.has(i)) continue
            params.push(b.params[i])
            if (b.inputs) inputs.push(b.inputs[i])
        }
        blocks.push({ ...b, params, inputs: b.inputs ? inputs : undefined })
    }
    return { ...g, nodes, params: g.params, blocks }
}

function optimizeValueGraph(g: Graph) {
    const usedBy = new Map<number, number[]>()
    const demands = new Map<number, Set<number>>()
    const dependents = new Map<number, Set<number>>()
    const dependencies = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) {
            let arr = usedBy.get(to)
            if (!arr) usedBy.set(to, arr = [])
            arr.push(from)
            let d = demands.get(from)
            if (!d) demands.set(from, d = new Set())
            d.add(to)
        }
        let set = dependencies.get(from)
        if (!set) dependencies.set(from, set = new Set())
        set.add(to)
        let d = dependents.get(to)
        if (!d) dependents.set(to, d = new Set())
        d.add(from)
    }

    const blocks = new Map<number, GraphBlock>()
    const blockIndices = new Map<number, number>()
    for (let i = 0; i < g.blocks.length; i++) {
        const b = g.blocks[i]
        blockIndices.set(b.id, i)
        blocks.set(b.id, b)
    }

    function getGraphBlock(id: number) {
        const idx = blockIndices.get(id)
        assert(idx !== undefined)
        const b = g.blocks[idx]
        assert(b)
        return b
    }

    const byOp = new Map<number, Map<string, number[]>>()
    function indexValue(id: number, op: string, blockId: number) {
        let m = byOp.get(blockId)
        if (!m) byOp.set(blockId, m = new Map())
        let arr = m.get(op)
        if (!arr) m.set(op, arr = [])
        arr.push(id)
    }

    function findValues(blockId: number, op: string) {
        if (const m = byOp.get(blockId)) {
            return m.get(op)
        }
    }

    function findValuesFrom(blockId: number, op: string, target: number) {
        if (const arr = findValues(blockId, op)) {
            return arr.filter(x => reaches(target, x))
        }
    }

    function reaches(from: number, to: number) {
        const deps = dependencies.get(from)
        if (!deps) return false
        for (const u of deps) {
            if (u === to) return true
            if (reaches(u, to)) return true
        }
        return false
    }

    function reachesAnyOf(from: number, to: Set<number>) {
        const deps = dependencies.get(from)
        if (!deps) return false
        for (const u of deps) {
            if (to.has(u)) return true
            if (reachesAnyOf(u, to)) return true
        }
        return false
    }

    function collectSubgraph(from: number, dst: Set<number> = new Set()) {
        const deps = dependencies.get(from)
        dst.add(from)
        if (!deps) return dst
        for (const u of deps) {
            if (dst.has(u)) continue
            collectSubgraph(u, dst)
        }
        return dst
    }

    function collectSubgraphOf(iter: Iterable<number>) {
        const dst = new Set<number>()
        for (const x of iter) collectSubgraph(x, dst)
        return dst
    }

    function visitBlock(b: GraphBlock) {
        if (visited.has(b.id)) return
        visited.set(b.id, visited.size)
        blockStack.push(b)
        defer blockStack.pop()
        visit(b.bodyId, false)
    }

    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        if (g.nodes.get(id)?.op === 'nil-effect') return
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (visited.has(id)) return
        visited.set(id, visited.size)
        stack.push(id)
        defer stack.pop()

        if (isParam(g.nodes, id)) {
            indexValue(id, 'param', blockStack[blockStack.length-1].id)
            return
        }
        const n = g.nodes.get(id)!

        indexValue(id, n.op, blockStack[blockStack.length-1].id)

        if (n.op === 'after' || n.op === 'call' || n.op === 'store' || n.op === 'load') {
            visit(n.argIds[0], false)
            for (let i = 1; i < n.argIds.length; i++) {
                if (n.op === 'call' && i === 1) {
                    const target = g.nodes.get(n.argIds[i])
                    if (target?.op === 'indirect-target') {
                        visit(n.argIds[i], false)
                        for (const arg of target.argIds) visit(arg, true)
                        continue
                    }
                }
                visit(n.argIds[i], true)
            }
            return
        }
        if (n.op === 'apply') {
            const b = getGraphBlock(n.argIds[0])
            for (let i = 1; i < n.argIds.length; i++) {
                visit(n.argIds[i], !b.consumesEffectToken || i !== n.argIds.length-1)
            }
            visitBlock(b)
            return
        }
        for (const x of n.argIds) {
            if (!x) continue
            visit(x, true)
        }
    }

    visited.set(0, 0)
    blockStack.push(g.blocks[0])
    const bodyId = g.blocks[0].bodyId
    if (bodyId) visit(bodyId, false)

    let nextId = g.maxId

    function addNode(op: string, argIds: number[], argConsts: Float64Array, from?: GraphNode): number {
        const id = nextId++
        g.nodes.set(id, {
            op, argIds, argConsts,
            label: from?.label,
            T: from?.T ?? Types.u64,
            U: from?.U ?? Types.u64,
            types: from?.types,
        })
        return id
    }

    function addParam(label?: string): number {
        const id = nextId++
        g.nodes.set(id, paramNode(label))
        return id
    }

    function addBlock(params: number[], body: number, consumesEffectToken?: boolean): number {
        const id = addNode('block', [], new Float64Array())
        const idx = g.blocks.length
        g.blocks.push({ id, bodyConst: 0, bodyId: body, params, consumesEffectToken })
        blockIndices.set(id, idx)
        blocks.set(id, g.blocks[idx])
        return id
    }

    function cleanBlockData(b: GraphBlock) {
        if (const m = byOp.get(b.id)) {
            for (const arr of m.values()) {
                for (const id of arr) cleanEdges(id)
            }
            function cleanEdges(id: number) {
                dependencies.delete(id)
                demands.delete(id)
                usedBy.delete(id)
                dependents.delete(id)
                visited.delete(id)
            }
        }
    }

    function revisitBlock(b: GraphBlock) {
        cleanBlockData(b)
        visited.delete(b.id)
        visitBlock(b)
    }

    function replaceAll(id: number, replacements: Map<number, number>, cloneAll = false): number {
        if (!id) return id
        if (const replacement = replacements.get(id)) {
            return replacement
        }
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id)) return id
        const ids = n.argIds
        const idReplacements: [idx: number, id: number][] = []
        for (let i = 0; i < ids.length; i++) {
            const next = replaceAll(ids[i], replacements)
            if (next !== ids[i]) { 
                idReplacements.push([i, next])
            }
        }
        if (!idReplacements.length && !cloneAll) return id
        const newIds = new Array(ids.length)
        for (let i = 0; i < ids.length; i++) {
            if (idReplacements[0]?.[0] === i) {
                newIds[i] = idReplacements.shift()![1]
            } else {
                newIds[i] = ids[i]
            }
        }
        const copy = addNode(n.op, newIds, n.argConsts.slice(), n)
        replacements.set(id, copy)
        return copy
    }

    function findInboundApplies(target: GraphBlock) {
        const res: [blockId: number, valId: number][] = []
        function visit(b: GraphBlock) {
            const applies = findValues(b.id, 'apply') ?? []
            for (const u of applies) {
                const n = g.nodes.get(u)!
                const t = n.argIds[0]
                if (t !== target.id) continue
                res.push([b.id, u])
            }
        }
        for (const [k, v] of blocks) {
            visit(v)
        }
        return res
    }

    function skipAfter(id: number) {
        while (id) {
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'after') {
                id = n.argIds[1]
                continue
            }
            return id
        }
        return
    }

    // finds values that never differ across applications and moves them to a pred
    function hoistInvariants(target: GraphBlock) {
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = g.nodes.get(t)
        if (!tail || tail.op !== 'select') return

        const tokenParam = target.consumesEffectToken ? target.params[target.params.length-1] : undefined
        if (target.consumesEffectToken) return // TODO

        const inbound = findInboundApplies(target)
        const filtered = inbound.filter(x => {
            if (x[0] === target.id) return false
            return true
        })
        if (filtered.length !== 1) return
        const pred = filtered[0]
        const self = inbound.filter(x => x[0] === target.id)
        if (!self.length) return

        const inboundArgs = target.params.map((p, i) => {
            const arr: [blockId: number, val: number, isConst: boolean][] = []
            for (const [otherId, app] of inbound) {
                const n = g.nodes.get(app)!
                const v = n.argIds[i+1]
                if (!v) {
                    arr.push([otherId, n.argConsts[i+1], true])
                } else {
                    arr.push([otherId, v, false])
                }
            }
            return arr
        })

        const obvious = inboundArgs.map((arr, i) => {
            for (const el of arr) {
                if (el[2]) continue

                if (el[0] === target.id) {
                    if (target.params[i] !== el[1]) return false
                } else {
                    const b = blocks.get(el[0])!
                    if (!b.params.includes(el[1])) return false
                }
            }
            return true
        }).map((x, i) => x ? i : -1).filter(x => x !== -1)

        if (!obvious.length) return

        const work = obvious.map(x => target.params[x])
        const invariants = new Set<number>(obvious.map(x => target.params[x]))
        const seen = new Set<number>(target.params)
        function isInvariant(id: number): boolean {
            if (!id) return true
            if (invariants.has(id)) return true
            if (seen.has(id)) return false
            seen.add(id)
            const n = g.nodes.get(id)!
            if (n.op === 'apply') return false
            if (n.op === 'after' || n.op === 'store' || n.op === 'call' || n.op === 'load') return false
            for (let i = 0; i < n.argIds.length; i++) {
                if (!isInvariant(n.argIds[i])) return false
            }
            work.push(id)
            invariants.add(id)
            return true
        }

        const covered = new Set<number>()
        while (work.length) {
            const next = work.pop()!
            const s = dependents.get(next)
            if (!s) continue
            let fullyCovered = true
            for (const u of s) {
                if (!isInvariant(u)) {
                    if (fullyCovered && !!inbound.find(x => x[1] === u)) continue
                    fullyCovered = false
                }
            }
            if (fullyCovered) {
                covered.add(next)
            }
        }
        for (const idx of obvious) {
            const p = target.params[idx]
            if (!covered.has(p)) {
                invariants.delete(p)
                const s = dependents.get(p)
                if (!s) continue
                for (const u of s) invariants.delete(u)
            }
        }
        const roots = new Map<number, [dependent: number, pos: number][]>()
        function addRoot(from: number, to: number, pos: number) {
            let arr = roots.get(from)
            if (!arr) roots.set(from, arr = [])
            arr.push([to, pos])
        }
        for (const x of invariants) {
            if (target.params.includes(x)) continue
            const uses = usedBy.get(x)!
            for (const y of uses) {
                if (invariants.has(y)) continue
                const u = g.nodes.get(y)!
                for (let i = 0; i < u.argIds.length; i++) {
                    if (u.argIds[i] === x) {
                        addRoot(x, y, i)
                    }
                }
            }
        }
        const coveredParams = target.params.filter(x => covered.has(x))
        if (roots.size >= coveredParams.length) {
            // console.log('ROOTS', roots)
            // console.log('too many roots vs params:', coveredParams)
            return
        }
        if (!roots.size) return

        const replacements = new Map<number, number>()
        const newParams = target.params.filter(x => !coveredParams.includes(x) || x === tokenParam)
        const paramToRoot = new Map<number, number>()
        for (const r of roots) {
            const p = addParam()
            replacements.set(r[0], p)
            paramToRoot.set(p, r[0])
            newParams.push(p)
        }
        if (tokenParam && !coveredParams.includes(tokenParam)) {
            const p = addParam()
            replacements.set(tokenParam, p)
            newParams.push(p)
        }

        const oldParams = [...target.params]

        {
            const replacements = new Map<number, number>()
            const forwardedParams = oldParams.map(x => {
                const p = addParam()
                replacements.set(x, p)
                return p
            })
            const hoisted = [...roots.keys()].map(x => {
                return replaceAll(x, replacements)
            })
            const o = oldParams.filter(x => !coveredParams.includes(x))
            const argIds = new Array(1+newParams.length)
            const argConsts = new Float64Array(1+newParams.length)
            for (let i = 0; i < o.length; i++) {
                argIds[i+1] = replacements.get(newParams[i])
            }
            for (let i = 0; i < hoisted.length; i++) {
                argIds[i+1+o.length] = hoisted[i]
            }
            argIds[0] = target.id
            const forward = addNode('apply', argIds, argConsts)
            const blk = addBlock(forwardedParams, forward)
            const callerReplacements = new Map<number, number>()
            callerReplacements.set(target.id, blk)
            const caller = getGraphBlock(filtered[0][0])
            caller.bodyId = replaceAll(caller.bodyId, callerReplacements)
        }

        {
            for (const x of self) {
                const app = x[1]
                const u = g.nodes.get(app)!
                const o = oldParams.filter(x => !coveredParams.includes(x) || x === tokenParam)
                const argIds = new Array(1+newParams.length)
                const argConsts = new Float64Array(1+newParams.length)
                let j = 0
                for (let i = 0; i < o.length; i++) {
                    if (target.params[j] === tokenParam) break
                    if (coveredParams.includes(target.params[j])) {
                        j += 1
                        i -= 1
                        continue
                    }
                    argIds[i+1] = replaceAll(u.argIds[j+1], replacements)
                    argConsts[i+1] = u.argConsts[j+1]
                    j += 1
                }
                for (let i = 0; i < roots.size; i++) {
                    argIds[i+1+o.length] = newParams[i+o.length]
                }
                if (tokenParam && !coveredParams.includes(tokenParam)) {
                    argIds[newParams.length] = replaceAll(u.argIds[u.argIds.length-1], replacements)
                    argConsts[newParams.length] = u.argConsts[u.argIds.length-1]
                }
                argIds[0] = x[0]
                const newApp = addNode('apply', argIds, argConsts)
                replacements.set(app, newApp)
            }
        }  
        target.params = newParams
        target.bodyId = replaceAll(target.bodyId, replacements)
        return true
    }

    function rootsOf(sg: Set<number>) {
        const res = new Set<number>(sg)
        for (const x of sg) {
            const deps = dependencies.get(x)
            if (!deps) continue
            for (const y of deps) res.delete(y)
        }
        return res
    }

    function pruneDeadParams(b: GraphBlock) {
        const params = findValues(b.id, 'param') ?? []
        const np = b.params.filter(x => params.includes(x))
        if (np.length === b.params.length) return

        const inbound = findInboundApplies(b)
    }

    function getApplyInputs(val: number, params: number[]) {
        const n = g.nodes.get(val)
        assert(n && n.op === 'apply')
        const b = blocks.get(n.argIds[0])
        assert(b)
        return params.map(x => {
            const idx = b.params.indexOf(x)
            assert(idx !== -1)
            if (!n.argIds[idx]) {
                return { val: n.argConsts[1+idx], const: true }
            }
            return { val: n.argIds[1+idx], const: false }
        })
    }

    function findLoopCriticalSubgraph(target: GraphBlock) {
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = g.nodes.get(t)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const filtered = inbound.filter(x => x[0] === target.id)
        if (!filtered.length) return
        if (!tail.argIds.includes(filtered[0][1])) return

        const cond = tail.argIds[0]
        const dependentParams = findValuesFrom(target.id, 'param', cond)
        if (!dependentParams?.length) return

        const criticalValues = filtered
            .map(x => getApplyInputs(x[1], dependentParams)).flat()
            .filter(x => !x.const).map(x => x.val)
            .filter(x => !dependentParams.includes(x))

        if (!criticalValues.length) return

        const sg = collectSubgraphOf(criticalValues)

        return { 
            sg,
            tail,
            inbound,
            criticalValues,
            dependentParams,
        }
    }

    const purity = new Map<number, boolean>()
    function isPure(id: number): boolean {
        if (!id) return true
        const known = purity.get(id)
        if (known !== undefined) return known
        purity.set(id, true)
        const n = g.nodes.get(id)
        if (!n) return true
        let ok = PureOps.has(n.op)
        if (ok) for (const a of n.argIds) if (!isPure(a)) { ok = false; break }
        purity.set(id, ok)
        return ok
    }

    const guaranteedEffects = new Map<number, Set<number>>()
    const guaranteeing = new Set<number>()
    function guaranteed(id: number): Set<number> {
        const known = guaranteedEffects.get(id)
        if (known) return known
        const out = new Set<number>()
        if (!id || guaranteeing.has(id)) return out
        guaranteeing.add(id)
        const n = g.nodes.get(id)
        if (n?.op === 'select') {
            for (const effect of guaranteed(n.argIds[0])) out.add(effect)
            const yes = guaranteed(n.argIds[1])
            const no = guaranteed(n.argIds[2])
            for (const effect of yes) if (no.has(effect)) out.add(effect)
        } else if (n) {
            for (const arg of n.argIds) {
                for (const effect of guaranteed(arg)) out.add(effect)
            }
            if (n.op === 'call' || n.op === 'store' || n.op === 'load') out.add(id)
        }
        guaranteeing.delete(id)
        guaranteedEffects.set(id, out)
        return out
    }

    function liftCommonEffects(target: GraphBlock) {
        const selects = findValues(target.id, 'select')
        if (!selects) return
        guaranteedEffects.clear()
        const lifts = new Map<number, number>()
        for (const id of selects) {
            const n = g.nodes.get(id)
            if (!n || n.op !== 'select') continue
            const before = guaranteed(n.argIds[0])
            const yes = guaranteed(n.argIds[1])
            const no = guaranteed(n.argIds[2])
            const common: number[] = []
            for (const effect of yes) {
                if (no.has(effect) && !before.has(effect)) common.push(effect)
            }
            const latest = common.filter(effect => {
                for (const other of common) {
                    if (other !== effect && guaranteed(other).has(effect)) return false
                }
                return true
            })
            if (latest.length === 1) lifts.set(id, latest[0])
        }
        if (!lifts.size) return
        for (const [id, effect] of lifts) {
            const select = g.nodes.get(id)!
            const inner = addNode(select.op, select.argIds, select.argConsts, select)
            g.nodes.set(id, {
                op: 'after', argIds: [effect, inner], argConsts: new Float64Array(2),
                T: select.T, U: select.U,
            })
        }
        return true
    }

    function liftCommonApplication(id: number) {
        const n = g.nodes.get(id)
        if (!n || n.op !== 'select') return false
        const yes = g.nodes.get(n.argIds[1])
        const no = g.nodes.get(n.argIds[2])
        if (!yes || yes.op !== 'apply' || !no || no.op !== 'apply') return false
        if (yes.argIds[0] !== no.argIds[0] || yes.argIds.length !== no.argIds.length) return false

        const block = getGraphBlock(yes.argIds[0])
        const tokenAt = block.consumesEffectToken ? block.params.length : -1
        const differ: number[] = []
        for (let i = 1; i < yes.argIds.length; i++) {
            if (yes.argIds[i] === no.argIds[i]
                && (yes.argIds[i] || Object.is(yes.argConsts[i], no.argConsts[i]))) continue
            if (i === tokenAt) return false
            if (!isPure(yes.argIds[i]) || !isPure(no.argIds[i])) return false
            differ.push(i)
        }
        if (!differ.length && !isPure(n.argIds[0])) return false

        const argIds = yes.argIds.slice()
        const argConsts = yes.argConsts.slice()
        for (const at of differ) {
            argIds[at] = addNode('select', [n.argIds[0], yes.argIds[at], no.argIds[at]],
                new Float64Array([n.argConsts[0], yes.argConsts[at], no.argConsts[at]]), n)
            argConsts[at] = 0
        }
        g.nodes.set(id, { ...yes, argIds, argConsts })
        return true
    }

    function liftCommonApplications(target: GraphBlock) {
        const selects = findValues(target.id, 'select')
        if (!selects) return
        let changed = false
        for (let i = selects.length - 1; i >= 0; i--) {
            if (liftCommonApplication(selects[i])) changed = true
        }
        return changed
    }

    function isCountedIncrement(n: GraphNode | undefined, param: number) {
        if (!n || n.op !== 'add') return false
        return (n.argIds[0] === param && !n.argIds[1] && n.argConsts[1] === 1)
            || (n.argIds[1] === param && !n.argIds[0] && n.argConsts[0] === 1)
    }

    function closeCountedLoop(target: GraphBlock) {
        if (target.consumesEffectToken) return
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return

        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (self.length !== 1 || !entries.length) return
        if (tail.argIds[1] !== self[0][1]) return
        const exit = g.nodes.get(tail.argIds[2])
        if (!exit || exit.op !== 'apply') return
        const cond = g.nodes.get(tail.argIds[0])
        if (!cond || cond.op !== 'lt') return
        if (lowering.isSignedType(cond.T) || lowering.isSignedType(cond.U)) return

        const back = g.nodes.get(self[0][1])!
        const params = target.params
        const invariants = new Set<number>()
        for (let i = 0; i < params.length; i++) {
            if (back.argIds[i+1] === params[i]) invariants.add(params[i])
        }
        function invariantOperand(id: number, value: number) {
            if (!id) return { id: 0, value }
            if (invariants.has(id)) return { id, value: 0 }
        }

        const ivAt = params.indexOf(cond.argIds[0])
        if (ivAt < 0) return
        if (!isCountedIncrement(g.nodes.get(back.argIds[ivAt+1]), params[ivAt])) return
        const bound = invariantOperand(cond.argIds[1], cond.argConsts[1])
        if (!bound) return

        const accumulators: [at: number, step: { id: number, value: number }, of: GraphNode][] = []
        for (let i = 0; i < params.length; i++) {
            if (i === ivAt || invariants.has(params[i])) continue
            const update = g.nodes.get(back.argIds[i+1])
            if (!update || update.op !== 'add') return
            const at = update.argIds[0] === params[i] ? 1
                : update.argIds[1] === params[i] ? 0 : -1
            if (at < 0) return
            const step = invariantOperand(update.argIds[at], update.argConsts[at])
            if (!step) return
            accumulators.push([i, step, update])
        }

        const paramSet = new Set<number>(params)

        for (let i = 1; i < exit.argIds.length; i++) {
            const id = exit.argIds[i]
            if (!paramSet.has(id) && reachesAnyOf(id, paramSet)) return
        }

        const touched: number[] = []
        for (const [blockId, appId] of entries) {
            const app = g.nodes.get(appId)!
            if (app.argIds[ivAt+1] || app.argConsts[ivAt+1] !== 0) continue
            function argOf(at: number) {
                return { id: app.argIds[at+1], value: app.argConsts[at+1] }
            }
            function outside(operand: { id: number, value: number }) {
                return operand.id ? argOf(params.indexOf(operand.id)) : operand
            }

            const trip = outside(bound)
            const finals = new Map<number, { id: number, value: number }>()
            for (let i = 0; i < params.length; i++) finals.set(params[i], argOf(i))
            finals.set(params[ivAt], trip)
            for (const [at, step, of] of accumulators) {
                const s = outside(step)
                const total = addNode('mul', [trip.id, s.id],
                    new Float64Array([trip.value, s.value]), of)
                const initial = argOf(at)
                const final = initial.id || initial.value
                    ? addNode('add', [initial.id, total], new Float64Array([initial.value, 0]), of)
                    : total
                finals.set(params[at], { id: final, value: 0 })
            }

            const argIds = exit.argIds.slice()
            const argConsts = exit.argConsts.slice()
            for (let i = 1; i < argIds.length; i++) {
                const final = finals.get(argIds[i])
                if (!final) continue
                argIds[i] = final.id
                argConsts[i] = final.value as f64
            }
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addNode('apply', argIds, argConsts, exit)]]))
            touched.push(blockId)
        }
        if (!touched.length) return
        for (const blockId of touched) revisitBlock(getGraphBlock(blockId))
        return true
    }

    function strengthReduceAddresses(target: GraphBlock) {
        const inbound = findInboundApplies(target)
        const self = inbound.filter(x => x[0] === target.id)
        const entries = inbound.filter(x => x[0] !== target.id)
        if (self.length !== 1 || !entries.length) return
        const back = g.nodes.get(self[0][1])!
        const params = target.params
        const invariants = new Set<number>()
        for (let i = 0; i < params.length; i++) {
            if (back.argIds[i + 1] === params[i]) invariants.add(params[i])
        }

        for (let ivAt = 0; ivAt < params.length; ivAt++) {
            const iv = params[ivAt]
            if (invariants.has(iv)) continue
            const stepId = back.argIds[ivAt + 1]
            const step = g.nodes.get(stepId)
            if (!step || step.op !== 'add') continue
            const strideAt = step.argIds[0] === iv ? 1 : step.argIds[1] === iv ? 0 : -1
            if (strideAt < 0 || step.argIds[strideAt]) continue
            const stride = step.argConsts[strideAt]
            if (!Number.isSafeInteger(stride) || stride <= 0) continue

            const uses = dependents.get(iv)
            if (!uses || uses.size !== 2) continue
            let scaledId = 0
            for (const u of uses) if (u !== stepId) scaledId = u
            const scaled = g.nodes.get(scaledId)
            if (!scaled) continue
            let scale = 0
            if (scaled.op === 'mul') {
                const constAt = scaled.argIds[0] === iv ? 1 : 0
                if (scaled.argIds[constAt]) continue
                scale = scaled.argConsts[constAt]
            } else if (scaled.op === 'shl' && scaled.argIds[0] === iv && !scaled.argIds[1]) {
                scale = 2 ** scaled.argConsts[1]
            } else continue
            if (!Number.isSafeInteger(scale * stride) || scale <= 0) continue

            const scaledUses = dependents.get(scaledId)
            if (!scaledUses || scaledUses.size !== 1) continue
            let addressId = 0
            for (const u of scaledUses) addressId = u
            const address = g.nodes.get(addressId)
            if (!address || address.op !== 'add') continue
            const baseAt = address.argIds[0] === scaledId ? 1 : 0
            const baseId = address.argIds[baseAt]
            const baseParamAt = baseId ? params.indexOf(baseId) : -1
            if (baseId && (baseParamAt < 0 || !invariants.has(baseId))) continue

            for (const [blockId, appId] of entries) {
                const app = g.nodes.get(appId)!
                const initId = app.argIds[ivAt + 1]
                let offsetId = 0
                let offsetConst = 0
                if (initId) {
                    offsetId = addNode('mul', [initId, 0], new Float64Array([0, scale]), scaled)
                } else {
                    offsetConst = app.argConsts[ivAt + 1] * scale
                }
                const fromId = baseId ? app.argIds[baseParamAt + 1] : 0
                const fromConst = baseId ? app.argConsts[baseParamAt + 1] : address.argConsts[baseAt]
                let startId = fromId
                let startConst = fromConst
                if (offsetId || offsetConst) {
                    if (!fromId && !offsetId) {
                        startConst = fromConst + offsetConst
                    } else {
                        startId = addNode('add', [fromId, offsetId],
                            new Float64Array([fromConst, offsetConst]), address)
                        startConst = 0
                    }
                }
                const argIds = app.argIds.slice()
                const argConsts = app.argConsts.slice()
                argIds[ivAt + 1] = startId
                argConsts[ivAt + 1] = startConst as f64
                const caller = getGraphBlock(blockId)
                caller.bodyId = replaceAll(caller.bodyId,
                    new Map([[appId, addNode('apply', argIds, argConsts, app)]]))
                revisitBlock(caller)
            }

            const advance = addNode('add', [iv, 0], new Float64Array([0, stride * scale]), address)
            target.bodyId = replaceAll(target.bodyId,
                new Map([[addressId, iv], [stepId, advance]]))
            revisitBlock(target)
            return true
        }
    }

    function rotateLoop(target: GraphBlock) {
        const tail = g.nodes.get(target.bodyId)
        if (!tail || tail.op !== 'select') return
        const back = g.nodes.get(tail.argIds[1])
        if (!back || back.op !== 'apply' || back.argIds[0] !== target.id) return

        const tokenAt = target.consumesEffectToken ? back.argIds.length - 1 : -1
        const backToken = tokenAt > 0 ? back.argIds[tokenAt] : 0
        if (tokenAt > 0 && !backToken) return

        function gather(id: number, out: Set<number>): Set<number> {
            if (!id || out.has(id)) return out
            const n = g.nodes.get(id)
            if (!n || n.op === 'block') return out
            out.add(id)
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) gather(n.argIds[i], out)
            return out
        }
        const inCond = gather(tail.argIds[0], new Set())
        const inBack = new Set<number>()
        for (let i = 1; i < back.argIds.length; i++) gather(back.argIds[i], inBack)
        const inExit = gather(tail.argIds[2], new Set())

        let shared = false
        for (let i = 1; i < back.argIds.length; i++) {
            const arg = back.argIds[i]
            if (arg && g.nodes.has(arg) && !isParam(g.nodes, arg) && inCond.has(arg)) { shared = true; break }
        }
        if (!shared) return

        const unconditional = new Set(inCond)
        for (const id of inBack) if (inExit.has(id)) unconditional.add(id)
        function speculatable(id: number): boolean {
            if (!id || unconditional.has(id)) return true
            const n = g.nodes.get(id)
            if (!n || isParam(g.nodes, id)) return true
            if (n.op !== 'after' && !PureOps.has(n.op)) return false
            for (const arg of n.argIds) if (!speculatable(arg)) return false
            return true
        }
        for (let i = 1; i < back.argIds.length; i++) {
            if (!speculatable(back.argIds[i])) return
        }

        const params: number[] = []
        const args: number[] = []
        const lowered = new Map<number, [id: number, konst: number]>()
        let token = 0
        if (tokenAt > 0) {
            token = addParam()
            lowered.set(backToken, [token, 0])
        }
        function drag(id: number, konst: number): [id: number, konst: number] {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const p = addParam()
            const out: [id: number, konst: number] = [p, 0]
            lowered.set(id, out)
            params.push(p)
            args.push(id)
            return out
        }
        function lower(id: number, konst: number): [id: number, konst: number] | undefined {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const n = g.nodes.get(id)
            if (!n || isParam(g.nodes, id) || inBack.has(id)) return drag(id, konst)
            if (n.op !== 'after' && !PureOps.has(n.op)) return
            const ids = n.argIds.slice()
            const consts = n.argConsts.slice()
            for (let i = 0; i < ids.length; i++) {
                const arg = lower(ids[i], consts[i])
                if (!arg) return
                ids[i] = arg[0]
                consts[i] = arg[1] as f64
            }
            const out: [id: number, konst: number] = [addNode(n.op, ids, consts, n), 0]
            lowered.set(id, out)
            return out
        }

        const backIds = [target.id]
        const backConsts = [0]
        for (let i = 1; i < back.argIds.length; i++) {
            if (i === tokenAt) { backIds.push(token); backConsts.push(0); continue }
            const [id, konst] = drag(back.argIds[i], back.argConsts[i])
            backIds.push(id)
            backConsts.push(konst)
        }

        const cond = lower(tail.argIds[0], tail.argConsts[0])
        if (!cond) return

        let exit: [id: number, konst: number] | undefined
        const exitNode = g.nodes.get(tail.argIds[2])
        if (exitNode?.op === 'apply') {
            const ids = [exitNode.argIds[0]]
            const consts = [0]
            for (let i = 1; i < exitNode.argIds.length; i++) {
                const arg = lower(exitNode.argIds[i], exitNode.argConsts[i])
                if (!arg) return
                ids.push(arg[0])
                consts.push(arg[1])
            }
            exit = [addNode('apply', ids, Float64Array.from(consts), exitNode), 0]
        } else {
            exit = lower(tail.argIds[2], tail.argConsts[2])
        }
        if (!exit) return

        const backApply = addNode('apply', backIds, Float64Array.from(backConsts), back)
        const body = addNode('select', [cond[0], backApply, exit[0]],
            Float64Array.from([cond[1], 0, exit[1]]), tail)
        if (token) params.push(token)
        const blockId = addBlock(params, body, target.consumesEffectToken)
        const entryIds = [blockId, ...args]
        if (token) entryIds.push(backToken)
        target.bodyId = addNode('apply', entryIds, new Float64Array(entryIds.length), back)
        revisitBlock(target)
        return true
    }

    function reachableBlocks() {
        const live = new Set<number>()
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'apply') reach(n.argIds[0])
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) walk(n.argIds[i])
        }
        function reach(id: number): void {
            if (live.has(id)) return
            live.add(id)
            walk(getGraphBlock(id).bodyId)
        }
        reach(g.blocks[0].id)
        return g.blocks.filter(b => live.has(b.id))
    }

    function eliminatePassthru(b: GraphBlock) {
        if (b.params.length > 1) return false
        const isVoid = b.params.length === 0 && g.nodes.get(b.bodyId)?.op === 'void'
        if (!isVoid && !b.params.includes(b.bodyId)) return false

        const applies = findInboundApplies(b)
        const byBlock = new Map<number, number[]>()
        for (const x of applies) {
            let arr = byBlock.get(x[0])
            if (!arr) byBlock.set(x[0], arr = [])
            arr.push(x[1])
        }
        for (const [k, v] of byBlock) {
            const r = new Map<number, number>()
            for (const x of v) {
                const a = g.nodes.get(x)!
                if (isVoid) {
                    r.set(x, b.bodyId)
                    continue
                }
                const arg = a.argIds[1]
                if (arg) {
                    r.set(x, arg)
                    continue
                }
                const c = a.argConsts[1]
                r.set(x, addNode('literal', [0], new Float64Array([c])))
            }
            const t = blocks.get(k)!
            t.bodyId = replaceAll(t.bodyId, r)
            revisitBlock(t)
        }
        return true
    }

    function canonicalizeBlocks() {
        const shapes = new Map<string, number>()
        function intern(key: string): number {
            let id = shapes.get(key)
            if (id === undefined) shapes.set(key, id = shapes.size + 1)
            return id
        }

        const classOf = new Map<number, number>()
        const appliedBy = new Map<number, Set<number>>()
        for (const b of g.blocks) {
            classOf.set(b.id, intern(`${b.params.length}/${b.consumesEffectToken ? 1 : 0}`))
            for (const id of findValues(b.id, 'apply') ?? []) {
                const target = g.nodes.get(id)!.argIds[0]
                let users = appliedBy.get(target)
                if (!users) appliedBy.set(target, users = new Set())
                users.add(b.id)
            }
        }

        function shapeOf(b: GraphBlock): number {
            const at = new Map<number, number>()
            for (let i = 0; i < b.params.length; i++) at.set(b.params[i], i)
            const memo = new Map<number, number>()
            function walk(id: number, value: number): number {
                if (!id) return intern(`c${Object.is(value, -0) ? '-0' : value}`)
                const seen = memo.get(id)
                if (seen !== undefined) return seen
                const index = at.get(id)
                if (index !== undefined) return intern(`p${index}`)
                const n = g.nodes.get(id)
                if (!n || n.op === 'param') return intern(`free${id}`)
                const parts: number[] = []
                for (let i = 0; i < n.argIds.length; i++) {
                    parts.push(n.op === 'apply' && i === 0
                        ? classOf.get(n.argIds[i]) ?? 0
                        : walk(n.argIds[i], n.argConsts[i]))
                }
                const out = intern(`${n.op}|${n.label ?? ''}|${n.T}|${n.U}`
                    + `|${(n.types ?? []).join('.')}|${parts.join(',')}`)
                memo.set(id, out)
                return out
            }
            return intern(`${classOf.get(b.id)}#${walk(b.bodyId, b.bodyConst)}`)
        }

        const groups = () => new Set(classOf.values()).size
        let dirty = new Set<number>(g.blocks.map(b => b.id))
        for (let count = groups(); dirty.size;) {
            const moved: number[] = []
            for (const id of dirty) {
                const shape = shapeOf(getGraphBlock(id))
                if (shape === classOf.get(id)) continue
                classOf.set(id, shape)
                moved.push(id)
            }
            const grown = groups()
            if (grown === count) break
            count = grown
            dirty = new Set<number>()
            for (const id of moved) for (const user of appliedBy.get(id) ?? []) dirty.add(user)
        }

        const representative = new Map<number, number>()
        const merged = new Map<number, number>()
        for (const b of g.blocks) {
            if (b.id === g.blocks[0].id) continue
            const cls = classOf.get(b.id)!
            const prior = representative.get(cls)
            if (prior === undefined) representative.set(cls, b.id)
            else merged.set(b.id, prior)
        }
        if (!merged.size) return

        const touched = new Set<number>()
        for (const b of g.blocks) {
            for (const id of findValues(b.id, 'apply') ?? []) {
                const n = g.nodes.get(id)
                if (!n || n.op !== 'apply') continue
                const to = merged.get(n.argIds[0])
                if (to === undefined) continue
                g.nodes.set(id, { ...n, argIds: [to, ...n.argIds.slice(1)] })
                touched.add(b.id)
            }
        }
        if (!touched.size) return
        for (const id of touched) revisitBlock(getGraphBlock(id))
        return true
    }

    canonicalizeBlocks()

    for (let i = 0; i < g.blocks.length; i++) {
        visitBlock(g.blocks[i])
        if (liftCommonEffects(g.blocks[i])) revisitBlock(g.blocks[i])
        if (liftCommonApplications(g.blocks[i])) revisitBlock(g.blocks[i])
    }
    for (let i = 1; i < g.blocks.length; i++) {
        visitBlock(g.blocks[i])
        if (closeCountedLoop(g.blocks[i])) continue
        if (hoistInvariants(g.blocks[i])) {
            revisitBlock(g.blocks[i])
        }
        strengthReduceAddresses(g.blocks[i])
    }
    for (let i = 0; i < g.blocks.length; i++) {
        rotateLoop(g.blocks[i])
        eliminatePassthru(g.blocks[i])
    }
    const result = reachableBlocks()
    for (const b of result) {
        if (const literals = findValues(b.id, 'literal')) {
            for (const id of literals) {
                const uses = dependents.get(id) ?? []
                for (const x of uses) {
                    const n = g.nodes.get(x)!
                    let slot = n.argIds.indexOf(id)
                    assert(slot !== -1)
                    do {
                        n.argIds[slot] = 0
                        n.argConsts[slot] = g.nodes.get(id)!.argConsts[0]
                        slot = n.argIds.indexOf(id)
                    } while (slot !== -1)
                }
            }
        }
    }
    return { ...g, maxId: nextId, blocks: result }
}

export function simplifyBitOperations(g: Graph): Graph | undefined {
    let nodes: Map<number, GraphNode> | undefined
    function writable() {
        if (!nodes) nodes = new Map(g.nodes)
        return nodes
    }
    const inverse: Record<string, string> = {
        eq: 'ne', ne: 'eq', lt: 'ge', ge: 'lt', le: 'gt', gt: 'le',
    }
    for (const [id, n] of g.nodes) {
        if (n.op === 'mul') {
            const valueAt = n.argIds[0] && !n.argIds[1] ? 0
                : n.argIds[1] && !n.argIds[0] ? 1 : -1
            const factor = valueAt < 0 ? 0 : n.argConsts[valueAt ^ 1]
            const shift = Math.log2(factor)
            if (valueAt >= 0 && Number.isSafeInteger(shift) && shift > 0) {
                writable().set(id, {
                    ...n, op: 'shl',
                    argIds: [n.argIds[valueAt], 0],
                    argConsts: new Float64Array([0, shift]),
                })
                continue
            }
        }

        if ((n.op === 'eq' || n.op === 'ne') && (!n.argIds[0] || !n.argIds[1])) {
            const valueAt = !n.argIds[0] && n.argConsts[0] === 0 ? 1
                : !n.argIds[1] && n.argConsts[1] === 0 ? 0 : -1
            const inner = valueAt < 0 ? undefined : g.nodes.get(n.argIds[valueAt])
            if (inner && CompareOps.has(inner.op)) {
                const op = n.op === 'eq' ? inverse[inner.op] : inner.op
                writable().set(id, { ...inner, op, argIds: inner.argIds.slice(), argConsts: inner.argConsts.slice() })
            }
        }

        if (n.op !== 'and') continue
        const shiftAt = n.argIds[0] ? 0 : n.argIds[1] ? 1 : -1
        if (shiftAt < 0) continue
        const maskAt = shiftAt ^ 1
        if (n.argIds[maskAt]) continue
        const shiftId = n.argIds[shiftAt]
        const shift = g.nodes.get(shiftId)
        if (!shift || shift.op !== 'ushr' || shift.argIds[1]) continue
        const width = Math.log2(n.argConsts[maskAt] + 1)
        const U = width === 8 ? Types.u8 : width === 16 ? Types.u16 : width === 32 ? Types.u32 : undefined
        if (U === undefined) continue
        writable().set(id, {
            ...n, op: 'convert', T: shift.T, U,
            argIds: [shiftId], argConsts: new Float64Array(1),
        })
    }
    return nodes ? { ...g, nodes, params: g.params, blocks: g.blocks } : undefined
}

export function strengthReduceLoops(g: Graph): Graph | undefined {
    let nodes: Map<number, GraphNode> | undefined
    let blocks: GraphBlock[] | undefined
    let nextId = g.maxId

    function writableNodes() {
        if (!nodes) nodes = new Map(g.nodes)
        return nodes
    }
    function writableBlocks() {
        if (!blocks) blocks = g.blocks.slice()
        return blocks
    }
    function addNode(op: string, argIds: number[], argConsts: number[], from: GraphNode): number {
        const id = nextId++
        writableNodes().set(id, {
            ...from, op, argIds, argConsts: new Float64Array(argConsts),
        })
        return id
    }
    function insert<T>(a: T[], at: number, ...values: T[]): T[] {
        return [...a.slice(0, at), ...values, ...a.slice(at)]
    }
    function omit<T>(a: T[], at: number): T[] {
        return [...a.slice(0, at), ...a.slice(at + 1)]
    }

    const applicationsByTarget = new Map<number, [number, GraphNode][]>()
    const users = new Map<number, number[]>()
    for (const [id, n] of g.nodes) {
        if (n.op === 'apply') {
            const list = applicationsByTarget.get(n.argIds[0]) ?? []
            list.push([id, n])
            applicationsByTarget.set(n.argIds[0], list)
        }
        for (const arg of n.argIds) {
            if (!arg) continue
            const list = users.get(arg) ?? []
            list.push(id)
            users.set(arg, list)
        }
    }

    for (let bi = 1; bi < g.blocks.length; bi++) {
        const block = (blocks ?? g.blocks)[bi]
        const body = (nodes ?? g.nodes).get(block.bodyId)
        if (!body || body.op !== 'select') continue
        const cond = (nodes ?? g.nodes).get(body.argIds[0])
        if (!cond || cond.op !== 'lt') continue
        if (lowering.isSignedType(cond.T) || lowering.isSignedType(cond.U)) continue

        const ivAt = block.params.indexOf(cond.argIds[0])
        const boundAt = block.params.indexOf(cond.argIds[1])
        if (ivAt < 0 || boundAt < 0 || ivAt === boundAt) continue

        const inside = new Set<number>()
        function walk(id: number): void {
            if (!id || inside.has(id)) return
            inside.add(id)
            const n = (nodes ?? g.nodes).get(id)
            if (!n) return
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) walk(n.argIds[i])
        }
        walk(block.bodyId)

        let addressId = 0
        let multiplyId = 0
        let baseAt = -1
        let stride = 0
        let memoryUses: Map<number, number> | undefined
        for (const id of inside) {
            const n = (nodes ?? g.nodes).get(id)
            if (!n || n.op !== 'add') continue
            for (let mulAt = 0; mulAt < 2; mulAt++) {
                const mul = (nodes ?? g.nodes).get(n.argIds[mulAt])
                if (!mul || mul.op !== 'mul') continue
                const ivOperand = mul.argIds[0] === block.params[ivAt] ? 0
                    : mul.argIds[1] === block.params[ivAt] ? 1 : -1
                if (ivOperand < 0 || mul.argIds[ivOperand ^ 1]) continue
                const base = block.params.indexOf(n.argIds[mulAt ^ 1])
                const scale = mul.argConsts[ivOperand ^ 1]
                if (base < 0 || base === ivAt || !Number.isSafeInteger(scale) || scale <= 0) continue
                addressId = id
                multiplyId = n.argIds[mulAt]
                baseAt = base
                stride = scale
                break
            }
            if (addressId) break
        }
        if (!addressId) {
            for (const id of inside) {
                const scaled = (nodes ?? g.nodes).get(id)
                if (!scaled) continue
                let scale = 0
                if (scaled.op === 'mul') {
                    const valueAt = scaled.argIds[0] === block.params[ivAt] ? 0
                        : scaled.argIds[1] === block.params[ivAt] ? 1 : -1
                    if (valueAt < 0 || scaled.argIds[valueAt ^ 1]) continue
                    scale = scaled.argConsts[valueAt ^ 1]
                } else if (scaled.op === 'shl' && scaled.argIds[0] === block.params[ivAt]
                    && !scaled.argIds[1]) {
                    scale = 2 ** scaled.argConsts[1]
                } else continue
                if (!Number.isSafeInteger(scale) || scale <= 0) continue

                const found = new Map<number, number>()
                let foundBase = -1
                const walked = new Map<number, number>()
                function walkOffset(offsetId: number, delta: number): boolean {
                    const previous = walked.get(offsetId)
                    if (previous !== undefined) return previous === delta
                    walked.set(offsetId, delta)
                    for (const userId of users.get(offsetId) ?? []) {
                        const user = (nodes ?? g.nodes).get(userId)
                        if (!user || !inside.has(userId)) return false
                        const offsetAt = user.op === 'load' || user.op === 'store' ? 2 : -1
                        const baseArg = user.op === 'load' || user.op === 'store' ? 1 : -1
                        if (offsetAt >= 0 && user.argIds[offsetAt] === offsetId) {
                            const base = block.params.indexOf(user.argIds[baseArg])
                            if (base < 0 || base === ivAt || base === boundAt) return false
                            if (foundBase >= 0 && foundBase !== base) return false
                            foundBase = base
                            found.set(userId, delta)
                            continue
                        }
                        if (user.op !== 'add') return false
                        const at = user.argIds[0] === offsetId && !user.argIds[1] ? 0
                            : user.argIds[1] === offsetId && !user.argIds[0] ? 1 : -1
                        if (at < 0 || !Number.isSafeInteger(user.argConsts[at ^ 1])) return false
                        if (!walkOffset(userId, delta + user.argConsts[at ^ 1])) return false
                    }
                    return true
                }
                if (!walkOffset(id, 0) || foundBase < 0 || !found.size) continue
                multiplyId = id
                baseAt = foundBase
                stride = scale
                memoryUses = found
                break
            }
        }
        if (!addressId && !memoryUses) continue

        const applications = applicationsByTarget.get(block.id) ?? []
        const entries = applications.filter(([id]) => !inside.has(id))
        const backs = applications.filter(([id]) => inside.has(id))
        if (entries.length !== 1 || !backs.length) continue
        const entry = entries[0][1]
        if (entry.argIds[1 + ivAt] || entry.argConsts[1 + ivAt] !== 0) continue

        let valid = true
        const increments = new Set<number>()
        for (const [, app] of backs) {
            if (app.argIds[1 + baseAt] !== block.params[baseAt]
                || app.argIds[1 + boundAt] !== block.params[boundAt]) { valid = false; break }
            const increment = (nodes ?? g.nodes).get(app.argIds[1 + ivAt])
            if (!increment || increment.op !== 'add') { valid = false; break }
            increments.add(app.argIds[1 + ivAt])
            const lhs = increment.argIds[0] === block.params[ivAt]
                && !increment.argIds[1] && increment.argConsts[1] === 1
            const rhs = increment.argIds[1] === block.params[ivAt]
                && !increment.argIds[0] && increment.argConsts[0] === 1
            if (!lhs && !rhs) { valid = false; break }
        }
        if (!valid) continue

        if (addressId && users.get(addressId)?.some(id => !inside.has(id))) continue
        if (users.get(body.argIds[0])?.some(id => !inside.has(id))) continue
        const ivUsers = users.get(block.params[ivAt]) ?? []
        if (ivUsers.some(id => id !== body.argIds[0] && id !== multiplyId && !increments.has(id))) continue
        if (addressId && users.get(multiplyId)?.some(id => id !== addressId)) continue
        const backIds = new Set(backs.map(([id]) => id))
        for (const increment of increments) {
            if (users.get(increment)?.some(id => !backIds.has(id))) {
                valid = false
                break
            }
        }
        if (!valid) continue

        const tokenAt = block.consumesEffectToken ? block.params.length - 1 : block.params.length
        const current = nextId++
        const end = nextId++
        writableNodes().set(current, paramNode())
        writableNodes().set(end, paramNode())
        const updatedBlock: GraphBlock = {
            ...block,
            params: omit(insert(block.params, tokenAt, current, end), ivAt),
            inputs: block.inputs ? omit(insert(block.inputs, tokenAt, 0, 0), ivAt) : undefined,
        }
        writableBlocks()[bi] = updatedBlock

        const address = (nodes ?? g.nodes).get(addressId || multiplyId)!
        const scaledBound = addNode('mul', [
            entry.argIds[1 + boundAt], 0,
        ], [entry.argConsts[1 + boundAt], stride], address)
        const endValue = addNode('add', [
            entry.argIds[1 + baseAt], scaledBound,
        ], [entry.argConsts[1 + baseAt], 0], address)
        const nextAddress = addNode('add', [current, 0], [0, stride], address)
        const nextCond = addNode('lt', [current, end], [0, 0], cond)

        for (const [id, app] of applications) {
            const at = 1 + tokenAt
            const isBack = inside.has(id)
            const ids = insert(app.argIds, at,
                isBack ? nextAddress : entry.argIds[1 + baseAt],
                isBack ? end : endValue)
            const constants = insert([...app.argConsts], at,
                isBack ? 0 : entry.argConsts[1 + baseAt], 0)
            writableNodes().set(id, {
                ...app,
                argIds: omit(ids, 1 + ivAt),
                argConsts: new Float64Array(omit(constants, 1 + ivAt)),
            })
        }
        for (const [id, n] of writableNodes()) {
            if (!inside.has(id)) continue
            let changed = false
            const ids = n.argIds.slice()
            const constants = n.argConsts.slice()
            for (let i = n.op === 'apply' ? 1 : 0; i < ids.length; i++) {
                if (addressId && ids[i] === addressId) { ids[i] = current; changed = true }
                if (ids[i] === body.argIds[0]) { ids[i] = nextCond; changed = true }
            }
            const delta = memoryUses?.get(id)
            if (delta !== undefined) {
                const baseArg = 1
                const offsetAt = 2
                ids[baseArg] = current
                ids[offsetAt] = 0
                constants[offsetAt] = delta
                changed = true
            }
            if (changed) writableNodes().set(id, { ...n, argIds: ids, argConsts: constants })
        }
    }

    if (!nodes && !blocks) return
    return { ...g, maxId: nextId, nodes: nodes ?? g.nodes, blocks: blocks ?? g.blocks }
}

export function analyzeValueGraph(g: Graph, opts?: LowerGraphOptions) {
    const implicitParams: number[] = []
    for (const [id, n] of g.nodes) if (n.op === 'call-context') implicitParams.push(id)
    const usedBy = new Map<number, number[]>()
    const demands = new Map<number, Set<number>>()
    const dependencies = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) {
            let arr = usedBy.get(to)
            if (!arr) usedBy.set(to, arr = [])
            arr.push(from)
            let d = demands.get(from)
            if (!d) demands.set(from, d = new Set())
            d.add(to)
        }
        let set = dependencies.get(from)
        if (!set) dependencies.set(from, set = new Set())
        set.add(to)
    }

    const inArgPos = new Map<number, [parent: number, idx: number][]>()
    const inStatePos = new Map<number, [parent: number, idx: number][]>()
    const returnsAt = new Map<number, number>()

    const blockBodyValues = new Map<number, number[]>()
    const blockIndices = new Map<number, number>()
    const blockByLabel = new Map<string, number>()
    const hasCallEffects = new Set<number>()
    for (let i = 0; i < g.blocks.length; i++) {
        const b = g.blocks[i]
        blockIndices.set(b.id, i)
        // XXX: the tracer should not be emitting indirection like this...
        const n = g.nodes.get(b.id)
        const label = n?.label ?? `B${i}`
        blockByLabel.set(label, b.id)
    }

    let entryBody = g.nodes.get(g.blocks[0].bodyId)
    while (entryBody?.op === 'after') entryBody = g.nodes.get(entryBody.argIds[1])
    let resultTerminal = ''
    let resultSlot = -1
    if (entryBody?.op === 'proj') {
        const label = entryBody.label ?? ''
        resultTerminal = label.slice(0, label.lastIndexOf('.'))
        resultSlot = entryBody.argConsts[1]
    }

    function getGraphBlock(id: number) {
        const idx = blockIndices.get(id)
        assert(idx !== undefined)
        const b = g.blocks[idx]
        assert(b)
        return b
    }

    function getBlockByLabel(label: string) {
        const blockId = blockByLabel.get(label)
        if (blockId === undefined) {
            // XXX: just assume it's the top of the stack :/
            assert(blockStack.length)
            return blockStack[blockStack.length-1]
        }
        return getGraphBlock(blockId)
    }

    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reverseOrder = new Map<number, number>()
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        if (g.nodes.get(id)?.op === 'nil-effect') return
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (visited.has(id)) return
        visited.set(id, visited.size)
        stack.push(id)
        defer stack.pop()

        const n = g.nodes.get(id)
        const valId = id
        defer {
            reverseOrder.set(valId, reverseOrder.size)
            if (blockStack.length) {
                const blockId = blockStack[blockStack.length-1].id
                if (n && n.op !== 'param') {
                    blockBodyValues.get(blockId)!.push(valId)
                }
            }
        }

        if (!n || n.op === 'param') return

        if (n.op === 'after' || n.op === 'call' || n.op === 'store' || n.op === 'load') {
            visit(n.argIds[0], false)
            for (let i = 1; i < n.argIds.length; i++) {
                visit(n.argIds[i], true)
            }
            if (n.op === 'call') {
                hasCallEffects.add(id)
                if (blockStack.length) {
                    hasCallEffects.add(blockStack[blockStack.length-1].id)
                }
            }
            return
        }
        if (n.op === 'apply') {
            const b = getGraphBlock(n.argIds[0])
            for (let i = 1; i < n.argIds.length; i++) {
                visit(n.argIds[i], !b.consumesEffectToken || i !== n.argIds.length-1)
            }
            if (visited.has(b.id)) return
            visited.set(b.id, visited.size)
            {
                blockStack.push(b)
                defer blockStack.pop()
                assert(!blockBodyValues.has(b.id))
                blockBodyValues.set(b.id, [])
                for (const x of b.params) {
                    visit(x, false, true)
                }
                visit(b.bodyId, false)
            }
            // if (hasCallEffects.has(b.id)) {
            //     if (blockStack.length) {
            //         hasCallEffects.add(blockStack[blockStack.length-1].id)
            //     }
            //     hasCallEffects.add(id)
            // }
            return
        }
        if (n.op === 'state') {
            const isReturn = n.label === 'return'
            if (isReturn) {
                returnsAt.set(id, n.argIds.length-1)
                return visit(n.argIds[n.argIds.length-1], true)
            }
            const b = getBlockByLabel(n.label ?? '')
            for (let i = 1; i < n.argIds.length; i++) {
                visit(n.argIds[i], !b.consumesEffectToken || i !== n.argIds.length-1)
            }
            return
        }
        if (n.op === 'proj') {
            visit(n.argIds[0], true)
            return
        }
        for (const x of n.argIds) {
            if (!x) continue
            visit(x, true)
        }
    }
    visited.set(0, 0)
    blockStack.push(g.blocks[0])
    blockBodyValues.set(g.blocks[0].id, [])
    const bodyId = g.blocks[0].bodyId
    if (bodyId) visit(bodyId, false)

    // BAGGAGE CLAIM
    const shouldSpillUntil2 = new Map<number, number>()
    const visitOrder = new Map<number, number>()
    const operandOrder = new Map<number, number[]>()
    const rotatedSelects = new Set<number>()
    for (const b of g.blocks) {
        const tail = g.nodes.get(b.bodyId)
        if (!tail || tail.op !== 'select') continue
        const back = g.nodes.get(tail.argIds[1])
        if (!back || back.op !== 'apply' || back.argIds[0] !== b.id) continue
        if (b.consumesEffectToken) {
            const token = back.argIds[back.argIds.length - 1]
            const seen = new Set<number>()
            function contains(id: number): boolean {
                if (!id || seen.has(id)) return false
                if (id === token) return true
                seen.add(id)
                const n = g.nodes.get(id)
                if (!n) return false
                for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) {
                    if (contains(n.argIds[i])) return true
                }
                return false
            }
            if (!token || !contains(tail.argIds[2])) continue
        }
        const underCondition = new Set<number>()
        function collect(id: number): void {
            if (!id || underCondition.has(id)) return
            underCondition.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            for (const a of n.argIds) collect(a)
        }
        collect(tail.argIds[0])
        for (let i = 1; i < back.argIds.length; i++) {
            const arg = back.argIds[i]
            if (arg && g.nodes.has(arg) && !isParam(g.nodes, arg) && underCondition.has(arg)) {
                //rotatedSelects.add(b.bodyId)
                break
            }
        }
    }
    {
        const tmp = new Set<number>()
        interface ClaimState {
            live: Set<number>
            seen: Set<number>
            done: Set<number>
            excluded: Set<number>
            crosses: Map<number, Set<number>>
        }
        function initState(save?: ClaimState): ClaimState {
            return {
                live: new Set(save?.live),
                seen: new Set(save?.seen),
                done: new Set(save?.done),
                excluded: new Set(save?.excluded),
                crosses: new Map(save?.crosses),
            }
        }
        let state = initState()
        function addCross(spilled: number, crossed: number, targetState = state) {
            let s = targetState.crosses.get(spilled)
            if (!s) targetState.crosses.set(spilled, s = new Set())
            s.add(crossed)
        }
        function getBaggage(root: number, clearTmp = true): number {
            if (clearTmp) tmp.clear()
            const allUses: number[][] = []
            function visit(id: number) {
                if (!id) return 0
                if (state.seen.has(id) || tmp.has(id) || state.excluded.has(id)) return 0
                tmp.add(id)
                const uses = usedBy.get(id)?.filter(x => !state.seen.has(x) && !state.excluded.has(x))
                if (uses?.length) allUses.push(uses)
                const n = g.nodes.get(id)
                if (!n) return
                for (let i = 0; i < n.argIds.length; i++) {
                    visit(n.argIds[i])
                }
            }
            visit(root)
            let c = 0
            for (const arr of allUses) {
                if (arr.some(x => !tmp.has(x))) c += 1
            }
            return c
        }
        function selectBaggage(selectId: number, u: GraphNode, isTail = true) {
            assert(u.op === 'select')

            tmp.clear()
            for (let i = 1; i < u.argIds.length; i++) {
                const a = u.argIds[i]
                if (!a) continue
                getBaggage(a, false)
            }
            if (!tmp.size) return

            const newlySeen = new Set(tmp)
            newlySeen.add(selectId)
            const joinState = initState()
            const joinDead = new Set<number>()

            {
                const saveState = state
                defer state = saveState

                for (let i = 1; i < u.argIds.length; i++) {
                    const a = u.argIds[i]
                    if (!a || saveState.seen.has(a)) continue
                    let excl: Set<number>
                    {
                        state = saveState
                        getBaggage(a)
                        assert(tmp.size)
                        const excluded = new Set(newlySeen)
                        for (const x of tmp) {
                            excluded.delete(x)
                        }
                        for (const x of saveState.excluded) {
                            excluded.add(x)
                        }
                        excl = excluded
                    }
                    state = initState(saveState)
                    state.excluded = excl
                    for (const x of state.live) {
                        if (allUsesDone(usedBy.get(x))) {
                            state.live.delete(x)
                        }
                    }
                    scheduleFrom(a)
                    for (const [k, s] of state.crosses) {
                        for (const v of s) addCross(k, v, joinState)
                    }
                    if (!isTail) {
                        for (const x of state.live) joinState.live.add(x)
                        for (const x of state.done) joinState.done.add(x)
                        for (const x of saveState.live) {
                            if (!state.live.has(x)) joinDead.add(x)
                        }
                    }
                }
            }

            if (!isTail) {
                for (const id of newlySeen) state.seen.add(id)
                for (const id of joinState.done) state.done.add(id)
                for (const id of joinState.live) state.live.add(id)
                for (const id of joinDead) state.live.delete(id)
            }
            for (const [k, s] of joinState.crosses) {
                for (const v of s) addCross(k, v)
            }
        }

        function findSchedule(n: GraphNode) {
            const args = n.argIds
            if (n.op === 'after') {
                return [0, 1]
            }
            if (n.op === 'store') {
                return [0, 1, 2, 3]
            }
            const calls = new Array(n.argIds.length) as boolean[]
            for (let i = 0; i < n.argIds.length; i++) calls[i] = false
            const baggage = args.map((x, i) => {
                const b = getBaggage(x)
                for (const id of tmp) {
                    if (!hasCallEffects.has(id)) continue
                    calls[i] = true
                    break
                }
                return b
            })
            return args.map((_, i) => i).sort((a, b) => {
                if (calls[a] === calls[b]) {
                    return baggage[a] - baggage[b]
                }
                return calls[a] ? -1 : 1
            })
        }
        function updateLiveAfter(id: number, partial?: number) {
            if (const d = demands.get(id)) {
                for (const x of d) {
                    if (!state.live.has(x)) continue
                    if (partial && x !== partial) continue
                    if (allUsesDone(usedBy.get(x), id)) {
                        state.live.delete(x)
                        continue
                    }
                }
            }
        }
        function materialize(id: number, partial?: number) {
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            state.done.add(id)
            updateLiveAfter(id, partial)
        }
        function allUsesDone(uses: number[] | undefined, from?: number) {
            if (!uses) return true
            const len = uses.length
            for (let i = 0; i < len; i++) {
                const v = uses[i]
                if (!v) continue
                if (v === from) continue
                if (!state.done.has(v) && !state.excluded.has(v)) {
                    return false
                }
            }
            return true
        }
        function scheduleFrom(id: number) {
            if (!id) return
            if (state.seen.has(id)) {
                if (state.live.has(id)) {
                    if (allUsesDone(usedBy.get(id))) {
                        state.live.delete(id)
                    }
                }
                return
            }
            state.seen.add(id)
            const u = g.nodes.get(id)
            assert(u)
            if (u.op === 'select') {
                const rotated = rotatedSelects.has(id)
                operandOrder.set(id, rotated ? [1, 0, 2] : [0, 1, 2])
                if (rotated) scheduleFrom(u.argIds[1])
                scheduleFrom(u.argIds[0])
                materialize(id, u.argIds[0])
                selectBaggage(id, u)
                materialize(id)
                return
            }
            const order = findSchedule(u)
            operandOrder.set(id, order)
            for (const idx of order) {
                scheduleFrom(u.argIds[idx])
            }
            if (const q = visitOrder.get(id)) {
                visitOrder.set(id, Math.min(q, state.done.size))
            } else {
                visitOrder.set(id, state.done.size)
            }
            if (!hasCallEffects.has(id)) return materialize(id)
            updateLiveAfter(id)
            for (const x of state.live) {
                // if (const p = dominatingParent(x, id)) {
                //     addCross(p, id)
                //     continue
                // }
                addCross(x, id)
            }
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            state.done.add(id)
        }
        // function dominatingParent(id: number, cur: number) {
        //     if (state.crosses.has(id)) return
        //     let found: number | undefined
        //     for (const x of usedBy.get(id) ?? []) {
        //         if (x === cur) continue
        //         if (state.excluded.has(x)) continue
        //         if (!state.live.has(x)) continue
        //         if (found) return
        //         found = x
        //     }
        //     return found
        // }
        function scheduleFromBlock(b: GraphBlock) {
            assert(b.bodyId)
            for (const p of b.params) {
                state.live.add(p)
                state.seen.add(p)
            }
            if (b === g.blocks[0]) {
                for (const p of implicitParams) {
                    state.live.add(p)
                    state.seen.add(p)
                }
            }
            scheduleFrom(b.bodyId)
            state.live.clear()
        }
        for (const b of g.blocks) state.seen.add(b.id)
        for (const b of g.blocks) {
            if (!b.bodyId) continue
            scheduleFromBlock(b)
        }
        function order(a: number, b: number) {
            const o1 = visitOrder.get(a) ?? -1
            const o2 = visitOrder.get(b) ?? -1
            return o1 - o2
        }
        const seenForSpill = new Set<number>()
        function materializedValue(id: number): number {
            while (id) {
                const n = g.nodes.get(id)
                if (n?.op !== 'after') break
                id = n!.argIds[1]
            }
            return id
        }
        function visitForSpill(id: number, crossed: Set<number>) {
            id = materializedValue(id)
            if (seenForSpill.has(id)) return
            seenForSpill.add(id)
            const uses = usedBy.get(id)
            if (!uses) return
            let last = 0
            let best = -1
            for (const call of crossed) {
                const rank = visitOrder.get(call) ?? -1
                if (rank > best) { best = rank; last = call }
            }
            if (!last) return
            shouldSpillUntil2.set(id, last)
            return
            // if (uses.length !== 1 || hasCallEffects.has(id)) {
            //     shouldSpillUntil2.set(id, last)
            //     return
            // }
            // for (const p of uses) {
            //     if (const x = state.crosses.get(p)) {
            //         visitForSpill(p, x)
            //     }
            // }
            // const p = uses[0]
            // if (const alt = shouldSpillUntil2.get(p)) {
            //     if (order(last, alt) > 0) {
            //         shouldSpillUntil2.set(p, last)
            //     }
            // } else {
            //     shouldSpillUntil2.set(p, last)
            // }     
        }
        for (const res of state.crosses) {
            visitForSpill(res[0], res[1])
        }
        if (opts?.debug) {
            const claimed = [...visitOrder]
            claimed.sort((a, b) => a[1] - b[1])
            console.log('claim order', claimed.map(x => x[0]).join(' '))
        }
    }

    // for (const [id, uses] of usedBy) {
    //     const n = g.nodes.get(id)
    //     if (!n) continue
    //     if (n.op !== 'after' && n.op !== 'call' && n.op !== 'store') continue

    //     const inner = n.argIds[0]
    //     if (!inner || usedBy.has(inner)) continue
    //     const u = g.nodes.get(inner)
    //     if (!u || u.op === 'nil-effect') continue

    //     if (u.op === 'call' || u.op === 'after' || u.op === 'store') {
    //         for (const use of uses) {
    //             for (let i = 0; i < u.argIds.length; i++) {
    //                 const a = u.argIds[i]
    //                 if (!a) continue
    //                 recordEdge(use, a, i > 0)
    //             }
    //         }
    //     }
    //     // if (u.op === 'select') {
    //     //     for (const use of uses) {
    //     //         recordEdge(use, u.argIds[0], true)
    //     //     }     
    //     // }
    // }

    const blockOrder = [...blockBodyValues.keys()]

    function notePos(into: Map<number, [parent: number, idx: number][]>, id: number, parent: number, idx: number): void {
        if (!id) return
        const at = into.get(id)
        if (at) at.push([parent, idx])
        else into.set(id, [[parent, idx]])
    }
    // an `after` passes its value through, so whatever sits under one occupies the same position
    function notePosThrough(into: Map<number, [parent: number, idx: number][]>,
        id: number, parent: number, idx: number): void {
        let v = id
        for (let hops = 0; v && hops < 64; hops++) {
            notePos(into, v, parent, idx)
            const u = g.nodes.get(v)
            if (!u || u.op !== 'after') return
            v = u.argIds[1]
        }
    }
    for (const [id, n] of g.nodes) {
        if (n.op === 'call') {
            for (let k = 3; k < n.argIds.length; k++) notePosThrough(inArgPos, n.argIds[k], id, k - 3)
        } else if (n.op === 'apply') {
            for (let k = 1; k < n.argIds.length; k++) notePosThrough(inArgPos, n.argIds[k], id, k - 1)
        }
    }
    for (const b of g.blocks) {
        const slots = b.slots ?? []
        function tails(at: number): void {
            if (!at) return
            if (isParam(g.nodes, at)) { notePos(inStatePos, at, b.id, -1); return }
            const t = g.nodes.get(at)!
            if (t.op === 'select') { tails(t.argIds[1]); tails(t.argIds[2]); return }
            if (t.op === 'after') { tails(t.argIds[1]); return }
            if (t.op === 'state') {
                for (let i = 0; i < slots.length && i < t.argIds.length; i++) {
                    const returns = t.label === resultTerminal && slots[i] === resultSlot
                    if (returns) returnsAt.set(at, i)
                    notePos(inStatePos, t.argIds[i], at, returns ? -1 : i)
                }
                return
            }
            if (t.op === 'apply' || t.op === 'proj') return
            notePos(inStatePos, at, b.id, -1)
        }
        tails(b.bodyId)
    }

    const shouldSpillUntil = shouldSpillUntil2//= new Map<number, number>()

    const callsUnderCache = new Map<number, Set<number>>()
    function callsUnder(id: number): Set<number> {
        const cached = callsUnderCache.get(id)
        if (cached) return cached
        const out = new Set<number>()
        callsUnderCache.set(id, out)
        if (hasCallEffects.has(id)) out.add(id)
        const deps = dependencies.get(id)
        if (deps) {
            for (const d of deps) {
                if (d === id) continue
                for (const c of callsUnder(d)) out.add(c)
            }
        }
        return out
    }

    function precedingValues(id: number, use: number): number[] {
        const n = g.nodes.get(use)
        if (n && n.op === 'select') {
            // const out = [n.argIds[0]]
            // for (let i = 1; i < n.argIds.length; i++) {
            //     if (n.argIds[i] === id) {
            //         out.push(id)
            //         break
            //     }
            // }
            return precedingValues(id, n.argIds[0])
        }
        const deps = dependencies.get(use)
        return deps ? [...deps] : []
    }

    for (const uses of usedBy.values()) {
        uses.sort((a, b) => (reverseOrder.get(a) ?? -1) - (reverseOrder.get(b) ?? -1))
    }
    for (const [id, uses] of usedBy) {
        const available = callsUnder(id)
        const crossed = new Set<number>()
        for (const use of uses) {
            for (const p of precedingValues(id, use)) {
                for (const c of callsUnder(p)) {
                    if (c === use || available.has(c)) continue
                    crossed.add(c)
                }
            }
        }
        if (crossed.size) {
            let last = 0
            let best = -1
            for (const call of crossed) {
                const rank = reverseOrder.get(call) ?? -1
                if (rank > best) { best = rank; last = call }
            }
            if (shouldSpillUntil !== shouldSpillUntil2) {
                if (last) shouldSpillUntil.set(id, last)
            }
        }
    }
    const materializeBefore = new Map<number, number[]>()
    for (const [value, boundary] of shouldSpillUntil) {
        const valueNode = g.nodes.get(value)
        if (!valueNode || !MaterializedPureOps.has(valueNode.op)) continue
        const values = materializeBefore.get(boundary)
        if (values) values.push(value)
        else materializeBefore.set(boundary, [value])
    }
    const releaseAt = new Map<number, Set<number>>()
    const reachCache = new Map<number, Set<number>>()
    function reachable(id: number): Set<number> {
        const known = reachCache.get(id)
        if (known) return known
        const out = new Set<number>()
        reachCache.set(id, out)
        const n = g.nodes.get(id)
        if (n) {
            for (const a of n.argIds) {
                if (!a) continue
                out.add(a)
                for (const x of reachable(a)) out.add(x)
            }
        }
        return out
    }
    const narrowsAt = new Map<number, Set<number>>()
    for (const b of g.blocks) {
        function forkPath(at: number, live: Set<number>): void {
            const n = g.nodes.get(at)
            if (!n) return
            if (n.op === 'after') { forkPath(n.argIds[1], live); return }
            if (n.op !== 'select') return
            const asking = new Set<number>(live)
            for (const x of reachable(n.argIds[0])) asking.add(x)
            if (n.argIds[0]) asking.add(n.argIds[0])
            for (const k of [1, 2]) {
                const arm = n.argIds[k]
                if (!arm) continue
                const wanted = reachable(arm)
                const dead = new Set<number>()
                for (const v of asking) {
                    if (v !== arm && !wanted.has(v) && usedBy.has(v)) dead.add(v)
                }
                if (dead.size) narrowsAt.set(arm, dead)
                const carried = new Set<number>()
                for (const v of asking) if (!dead.has(v)) carried.add(v)
                for (const x of wanted) carried.add(x)
                forkPath(arm, carried)
            }
        }
        forkPath(b.bodyId, new Set<number>(b.params))
    }

    const through = new Map<number, number>()
    const lastOn = new Map<number, Map<number, number>>()
    for (const b of g.blocks) {
        interface PathStep { value: number, fork?: number }
        function walkPath(at: number, steps: PathStep[]): void {
            const n = g.nodes.get(at)
            if (n && n.op === 'after') {
                walkPath(n.argIds[1], [...steps, { value: n.argIds[0] }])
                return
            }
            if (n && n.op === 'select') {
                const next = [...steps, { value: n.argIds[0], fork: at }]
                walkPath(n.argIds[1], next)
                walkPath(n.argIds[2], next)
                return
            }
            const scheduled = new Set<number>()
            const order: number[] = []
            function schedule(id: number): void {
                if (!id || scheduled.has(id)) return
                scheduled.add(id)
                for (const value of materializeBefore.get(id) ?? []) schedule(value)
                const n = g.nodes.get(id)
                if (!n || isParam(g.nodes, id)) return
                for (const i of operandOrder.get(id) ?? []) schedule(n.argIds[i])
                order.push(id)
            }
            for (const step of steps) {
                schedule(step.value)
                const fork = step.fork
                if (fork && !scheduled.has(fork)) { scheduled.add(fork); order.push(fork) }
            }
            schedule(at)
            if (opts?.debug) console.log('path order', order.join(' '))
            const predicated = new Set<number>()
            for (const step of steps) if (step.fork) predicated.add(step.fork)
            const last = new Map<number, number>()
            for (const site of order) {
                through.set(site, (through.get(site) ?? 0) + 1)
                const n = g.nodes.get(site)
                if (n?.op === 'select' && predicated.has(site)) {
                    if (n.argIds[0]) last.set(n.argIds[0], site)
                    continue
                }
                for (const v of demands.get(site) ?? []) last.set(v, site)
            }
            for (const [v, site] of last) {
                if (v === at) continue
                let tally = lastOn.get(site)
                if (!tally) lastOn.set(site, tally = new Map<number, number>())
                tally.set(v, (tally.get(v) ?? 0) + 1)
            }
        }
        walkPath(b.bodyId, [])
    }
    for (const [site, tally] of lastOn) {
        const every = through.get(site) ?? 0
        for (const [v, seen] of tally) {
            if (seen < every) continue
            const here = releaseAt.get(site)
            if (here) here.add(v)
            else releaseAt.set(site, new Set<number>([v]))
        }
    }

    return {
        inArgPos,
        inStatePos,
        returnsAt,
        pure: pureValues(g),
        shouldSpillUntil,
        materializeBefore,
        blockOrder,
        releaseAt,
        narrowsAt,
        usedBy,
        operandOrder,
        reverseOrder,
        callsUnderValue: callsUnderCache,
    }
}

export function rematerializeValues(g: Graph, analysis = analyzeValueGraph(g)): Graph | undefined {
    const MAX_COST = 1
    const costs = new Map<number, number>()
    function cost(id: number): number {
        if (!id) return 0
        const known = costs.get(id)
        if (known !== undefined) return known
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id) || !analysis.pure.has(id) || n.op === 'select') return MAX_COST + 1
        if ((n.op === 'convert' || n.op === 'bitconvert') && n.argIds[0]) {
            const inner = g.nodes.get(n.argIds[0])
            if (inner && (inner.op === 'shl' || inner.op === 'shr' || inner.op === 'ushr')
                && !inner.argIds[1]) {
                costs.set(id, 1)
                costs.set(n.argIds[0], 1)
                return 1
            }
        }
        let c = 1
        const immediate = n.op === 'add' || n.op === 'sub' || n.op === 'shl'
            || n.op === 'shr' || n.op === 'ushr' || CompareOps.has(n.op)
        if (!immediate) {
            for (let i = 0; i < n.argIds.length; i++) if (!n.argIds[i]) c++
        }
        costs.set(id, c)
        for (const a of n.argIds) {
            if (!a || !g.nodes.has(a) || isParam(g.nodes, a)) continue
            c += cost(a)
            if (c > MAX_COST) break
        }
        costs.set(id, c)
        return c
    }

    let nextId = g.maxId

    let nodes: Map<number, GraphNode> | undefined
    function writable(): Map<number, GraphNode> {
        if (nodes) return nodes
        nodes = new Map<number, GraphNode>()
        for (const [id, n] of g.nodes) {
            nodes.set(id, { ...n, argIds: n.argIds.slice(), argConsts: n.argConsts.slice() })
        }
        return nodes
    }
    function cloneValue(id: number, boundary: number, into: Map<number, GraphNode>, memo: Map<number, number>): number {
        const known = memo.get(id)
        if (known !== undefined) return known
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id) || !analysis.pure.has(id) || n.op === 'select' || cost(id) > MAX_COST) {
            const ordered = nextId++
            memo.set(id, ordered)
            into.set(ordered, {
                op: 'after', argIds: [boundary, id], argConsts: new Float64Array(2),
                T: n?.T ?? Types.u64, U: n?.U ?? Types.u64,
            })
            return ordered
        }
        const clone = nextId++
        memo.set(id, clone)
        const args = n.argIds.slice()
        for (let i = 0; i < args.length; i++) {
            if (args[i]) args[i] = cloneValue(args[i], boundary, into, memo)
        }
        into.set(clone, { ...n, argIds: args, argConsts: n.argConsts.slice() })
        return clone
    }
    function cloneModifier(id: number, into: Map<number, GraphNode>, memo: Map<number, number>): number {
        const known = memo.get(id)
        if (known !== undefined) return known
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id) || cost(id) > MAX_COST) return id
        const clone = nextId++
        memo.set(id, clone)
        const args = n.argIds.slice()
        for (let i = 0; i < args.length; i++) {
            if (args[i] && g.nodes.has(args[i]) && cost(args[i]) <= MAX_COST) {
                args[i] = cloneModifier(args[i], into, memo)
            }
        }
        into.set(clone, { ...n, argIds: args, argConsts: n.argConsts.slice() })
        return clone
    }

    for (const [id, boundary] of analysis.shouldSpillUntil) {
        const n = g.nodes.get(id)
        const call = g.nodes.get(boundary)
        const uses = analysis.usedBy.get(id) ?? []
        const callRank = analysis.reverseOrder.get(boundary) ?? -1
        if (!n || isParam(g.nodes, id) || call?.op !== 'call' || uses.length < 2 || cost(id) > MAX_COST || callRank < 0) continue
        let hasEarlyUse = false
        for (const use of uses) {
            if ((analysis.reverseOrder.get(use) ?? -1) <= callRank) { hasEarlyUse = true; break }
        }
        if (!hasEarlyUse) continue
        const lateUses: number[] = []
        for (const use of new Set<number>(uses)) {
            if ((analysis.reverseOrder.get(use) ?? -1) <= callRank) continue
            if (!analysis.callsUnderValue.get(use)?.has(boundary)) continue
            lateUses.push(use)
        }
        if (!lateUses.length) continue
        const into = writable()
        const clone = cloneValue(id, boundary, into, new Map<number, number>())
        for (const use of lateUses) {
            const consumer = into.get(use)
            if (!consumer) continue
            for (let i = 0; i < consumer.argIds.length; i++) {
                if (consumer.argIds[i] === id) consumer.argIds[i] = clone
            }
        }
    }

    const selectConditions = new Set<number>()
    for (const n of g.nodes.values()) if (n.op === 'select' && n.argIds[0]) selectConditions.add(n.argIds[0])
    for (const [id] of analysis.shouldSpillUntil) {
        if (cost(id) > MAX_COST) continue
        for (const use of new Set(analysis.usedBy.get(id) ?? [])) {
            if (!selectConditions.has(use)) continue
            const consumer = g.nodes.get(use)
            if (!consumer || !CompareOps.has(consumer.op)) continue
            const useRank = analysis.reverseOrder.get(use) ?? -1
            if (useRank < 0 || (analysis.usedBy.get(id) ?? []).some(other =>
                other !== use && (analysis.reverseOrder.get(other) ?? -1) < useRank)) continue
            const into = writable()
            const clone = cloneModifier(id, into, new Map<number, number>())
            const updated = into.get(use)!
            for (let i = 0; i < updated.argIds.length; i++) {
                if (updated.argIds[i] === id) updated.argIds[i] = clone
            }
        }
    }
    return nodes ? { ...g, maxId: nextId, nodes, params: g.params, blocks: g.blocks } : undefined
}

export function dumpGraph(g: Graph): string {
    const out: string[] = []
    if (g.name) {
        out.push(`--- vgraph for ${g.name} ---`)
    }
    for (const b of g.blocks) {
        out.push(`B${b.id}(${b.params.join(', ')})${b.consumesEffectToken ? ' [tok]' : ''} -> ${b.bodyId || b.bodyConst}`)
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return
            if (n.op === 'param' || n.op === 'block') return // noisy
            for (const a of n.argIds) walk(a)
            const parts: string[] = []
            for (let i = 0; i < n.argIds.length; i++) {
                const cid = n.argIds[i]
                if (cid) {
                    if (const c = g.nodes.get(cid)) {
                        if (c.op === 'block') {
                            parts.push(`B${cid}`)
                            continue
                        }
                    }
                }
                parts.push(cid ? `%${cid}` : `#${n.argConsts[i]}`)
            }
            out.push(`  %${id} = ${n.op} ${parts.join(' ')}${n.label ? ' ' + n.label : ''}`)
        }
        walk(b.bodyId)
    }
    return out.join('\n')
}

export function normalizeValueGraph(g: Graph): Graph {
    const profile = intrinsics.argv().includes('graph-transform-cost')
    function run(transform: (g: Graph) => Graph | undefined, name = transform.name): void {
        if (!profile) {
            g = transform(g) ?? g
            return
        }
        const beforeNodes = g.nodes.size
        const start = (performance as any).now()
        g = transform(g) ?? g
        const elapsed = (performance as any).now() - start
        console.log('graph transform cost', g.name || '<anonymous>', name,
            `${elapsed.toFixed(3)}ms`, `${beforeNodes}->${g.nodes.size}`)
    }
    run(intrinsics.argv().includes('package2') ? packageBlocks2 : packageBlocks)
    run(pruneBlockParams)
    run(reduceEffectDependencies)
    run(specializeBlockApplications)
    run(strengthReduceLoops)
    run(pruneBlockParams)
    run(optimizeValueGraph)
    run(pruneBlockParams)
    run(simplifyBitOperations)

        // if (n.op === 'heap-handle') {
        //     const handle = !n.argIds[0] ? n.argConsts[0] : '?'
        //     console.log(dumpGraph(g))
        //     throw `lowering2: unresolved heap handle ${handle} at %${id}`
        // }

    return g
}

export function lowerValueGraph(g: Graph, opts: LowerGraphOptions = {}): LowerGraphResult {
    g = normalizeValueGraph(g)
    const target = opts.target ?? lowering.aarch64
    const asm = target.createAssembler()
    let analysis = analyzeValueGraph(g, opts)
    const rematerialized = rematerializeValues(g, analysis)
    if (rematerialized) {
        g = rematerialized
        analysis = analyzeValueGraph(g, opts)
    }
    if (opts?.debug) {
        console.log(dumpGraph(g))
        const sets = (m: Map<number, Set<number>>) => [...m]
            .map(([at, values]) => `${at}:${[...values].join(',')}`).join(' ')
        console.log('release at', sets(analysis.releaseAt))
        console.log('narrow at', sets(analysis.narrowsAt))
        console.log('spill until', [...analysis.shouldSpillUntil]
            .map(([value, at]) => `${value}:${at}`).join(' '))
    }

    const acrossCall = analysis.shouldSpillUntil
    const materializeBefore = analysis.materializeBefore
    const inArgPos = analysis.inArgPos
    const inStatePos = analysis.inStatePos
    const pure = analysis.pure
    const order = analysis.blockOrder
    const releaseAt = analysis.releaseAt
    const narrowsAt = analysis.narrowsAt
    const callContexts: number[] = []
    for (const [id, n] of g.nodes) if (n.op === 'call-context') callContexts.push(id)

    const blockOf = new Map<number, GraphBlock>()
    for (const b of g.blocks) blockOf.set(b.id, b)

    const budget = opts.regBudget === undefined ? Infinity : Math.max(2, opts.regBudget)
    const allocatable: number[] = []
    const readsIndirectContext = [...g.nodes.values()].some(n => n.op === 'call-context')
    for (const r of target.allocatable) {
        if (target.scratch.indexOf(r) >= 0) continue
        if (readsIndirectContext && r === target.indirectContextReg) continue
        allocatable.push(r)
    }
    const volatiles: number[] = allocatable.slice(0, budget === Infinity ? allocatable.length : budget)
    // caller saved non-args first
    const spread: number[] = []
    for (const r of volatiles) if (target.argRegs.indexOf(r) < 0) spread.push(r)
    for (const r of volatiles) if (target.argRegs.indexOf(r) >= 0) spread.push(r)
    const preserved: number[] = []
    for (const r of target.calleeSaved) {
        if (preserved.length >= budget) continue
        preserved.push(r)
    }
    const CALLEE = target.scratch[1]
    const SWAP = target.scratch[0]
    const usedPreserved = new Set<number>()
    let callsOut = false
    let tailCall = g.nodes.get(g.blocks[0].bodyId)?.op === 'call' && !acrossCall.size ? g.blocks[0].bodyId : 0
    function isPreserved(r: number): boolean { return target.calleeSaved.indexOf(r) >= 0 }

    const OPEN = 1 << 30
    function isSlot(h: number): boolean { return h < 0 }
    let slotCount = 0
    const reusableSlots = new Set<number>()
    let frameBase = 0
    function slotOffset(h: number): number { return frameBase + (-h - 1) * 8 }
    function takeSlot(): number {
        const reused = reusableSlots.values().next()
        if (!reused.done) {
            reusableSlots.delete(reused.value)
            return reused.value
        }
        slotCount++
        return -slotCount
    }

    interface EmitRegion {
        parent?: EmitRegion
        children: EmitRegion[]
        writes: Set<number>
        owned: number[]
        exitLabel: number
        group: number
    }
    const rootRegion: EmitRegion = {
        children: [], writes: new Set(), owned: [], exitLabel: -1, group: -1,
    }
    let currentRegion = rootRegion
    let currentBlock = 0
    let nextRegionGroup = 0
    interface ReleaseEvent { released: { value: number, home: number }[] }
    interface TransferEvent {
        dst: number
        src: number
        consumed?: { value: number, home: number }
    }
    const code: ((() => void) | ReleaseEvent | TransferEvent)[] = []
    function put(fn: () => void): void { code.push(fn) }
    function transfer(dst: number, src: number, consumed?: { value: number, home: number }): void {
        if (dst === src) return
        code.push({ dst, src, consumed })
    }

    const homeOf = new Map<number, number>()
    const heldBy = new Map<number, number>()
    const done = new Set<number>()
    const temporariesAt = new Map<number, number[]>()
    const freedAt = new Map<number, number>()
    let materializing = 0
    let synth = 0


    const NOTHING = new Set<number>()
    function bind(id: number, reg: number): number {
        if (opts.debug) console.log('home +', id, reg, 'at', materializing, 'over', heldBy.get(reg) ?? '-')
        homeOf.set(id, reg)
        heldBy.set(reg, id)
        if (isPreserved(reg)) {
            usedPreserved.add(reg)
            currentRegion.writes.add(reg)
        }
        return reg
    }
    function place(id: number, home: number): void {
        if (isSlot(home)) {
            reusableSlots.delete(home)
            homeOf.set(id, home)
        }
        else bind(id, home)
    }
    function freeValue(v: number, site = materializing): void {
        const home = homeOf.get(v)
        if (home === undefined) return
        if (opts.debug) console.log('home -', v, home, 'at', site)
        homeOf.delete(v)
        freedAt.set(v, site)
        if (!isSlot(home) && heldBy.get(home) === v) heldBy.delete(home)
    }
    function finish(id = materializing): void {
        done.add(id)
        const released: { value: number, home: number }[] = []
        function release(v: number): void {
            const home = homeOf.get(v)
            if (home !== undefined) released.push({ value: v, home })
            freeValue(v, id)
        }
        for (const v of releaseAt.get(id) ?? []) release(v)
        for (const v of temporariesAt.get(id) ?? []) release(v)
        temporariesAt.delete(id)
        if (released.length) code.push({ released })
    }

    function narrowTo(root: number): void {
        for (const v of narrowsAt.get(root) ?? []) freeValue(v, root)
    }
    function freeReg(pool: number[], avoid: Set<number>): number {
        for (const r of pool) if (!heldBy.has(r) && !avoid.has(r)) return r
        for (const r of pool) {
            const v = heldBy.get(r)
            if (v === undefined || avoid.has(r)) continue
            const slot = takeSlot()
            transfer(slot, r)
            homeOf.set(v, slot)
            heldBy.delete(r)
            return r
        }
        return -1
    }
    const avoidsArgRegs = new Set<number>()
    for (const [id, uses] of analysis.usedBy) {
        if (uses.length < 2 || acrossCall.has(id)) continue
        if (inArgPos.has(id) || analysis.inStatePos.has(id)) continue
        avoidsArgRegs.add(id)
    }
    function regFor(id: number, want: number): number {
        const first = acrossCall.has(id) ? preserved
            : avoidsArgRegs.has(id) ? spread : volatiles
        const second = first === preserved ? volatiles : preserved
        if (want >= 0) {
            const willRelease = releaseAt.get(id)?.has(heldBy.get(want) ?? 0)
            if (!heldBy.has(want) && (first.indexOf(want) >= 0 || first !== preserved)) {
                return bind(id, want)
            }
            if (willRelease) {
                return bind(id, want)
            }
        }
        let r = freeReg(first, NOTHING)
        if (r < 0) r = freeReg(second, NOTHING)
        if (r < 0) throw 'lowering3: out of registers'
        return bind(id, r)
    }
    function at(v: number, avoid: Set<number>): number {
        const home = homeOf.get(v)
        if (home === undefined) throw `lowering3: value ${v} is not live`
        if (!isSlot(home)) return home
        const first = acrossCall.has(v) ? preserved : volatiles
        const second = first === preserved ? volatiles : preserved
        let r = freeReg(first, avoid)
        if (r < 0) r = freeReg(second, avoid)
        if (r < 0) throw 'lowering3: out of registers'
        transfer(r, home)
        reusableSlots.add(home)
        return bind(v, r)
    }
    interface Snapshot { homes: number[][], held: number[][], ran: number[] }
    function snapshot(): Snapshot {
        const homes: number[][] = []
        for (const [k, v] of homeOf) homes.push([k, v])
        const held: number[][] = []
        for (const [k, v] of heldBy) held.push([k, v])
        return { homes, held, ran: [...done] }
    }
    function restore(s: Snapshot): void {
        homeOf.clear()
        for (const e of s.homes) homeOf.set(e[0], e[1])
        heldBy.clear()
        for (const e of s.held) heldBy.set(e[0], e[1])
        reusableSlots.clear()
        const occupied = new Set<number>()
        for (const h of homeOf.values()) if (isSlot(h)) occupied.add(h)
        for (let i = 1; i <= slotCount; i++) if (!occupied.has(-i)) reusableSlots.add(-i)
        done.clear()
        for (const v of s.ran) done.add(v)
    }

    interface Move { dst: number, src: number }
    function shuffle(moves: Move[]): void {
        const pending: Move[] = []
        for (const m of moves) if (m.dst !== m.src) pending.push(m)
        while (pending.length) {
            let ready = -1
            for (let i = 0; i < pending.length && ready < 0; i++) {
                let blocked = false
                for (let j = 0; j < pending.length; j++) {
                    if (i !== j && pending[j].src === pending[i].dst) { blocked = true; break }
                }
                if (!blocked) ready = i
            }
            if (ready < 0) {
                const stuck = pending[0].src
                transfer(SWAP, stuck)
                for (const m of pending) if (m.src === stuck) m.src = SWAP
                continue
            }
            const m = pending.splice(ready, 1)[0]
            transfer(m.dst, m.src)
        }
    }

    let nextLabel = 0
    for (const b of g.blocks) if (b.id >= nextLabel) nextLabel = b.id + 1
    const exitLabel = nextLabel++
    rootRegion.exitLabel = exitLabel
    const savedIndex = new Map<number, number>()

    function regionExit(region: EmitRegion | undefined): number {
        while (region && region !== rootRegion && !region.owned.length) region = region.parent
        return region && region !== rootRegion ? region.exitLabel : exitLabel
    }

    function jumpToExit(): void {
        const region = currentRegion
        put(() => asm.jump(regionExit(region)))
    }

    const sig = new Map<number, number[]>()
    const forwards = (b: GraphBlock) => g.nodes.get(b.bodyId)?.op === 'apply'
    const assignOrder: number[] = []
    for (const id of order.slice().reverse()) if (!forwards(blockOf.get(id)!)) assignOrder.push(id)
    for (const id of order.slice().reverse()) if (forwards(blockOf.get(id)!)) assignOrder.push(id)
    for (const id of assignOrder) {
        const b = blockOf.get(id)!
        const taken = new Set<number>()
        const inherits = new Set<number>()
        for (const n of g.nodes.values()) {
            if (n.op !== 'apply' || n.argIds[0] !== id) continue
            for (let i = 0; i < b.params.length; i++) {
                if (acrossCall.has(n.argIds[i + 1])) inherits.add(i)
            }
        }
        const fixed = new Map<number, number>()
        for (let i = 0; i < b.params.length; i++) {
            const p = b.params[i]
            if (id === g.blocks[0].id && i < g.params.length && p === g.params[i]) {
                fixed.set(i, target.argRegs[i])
                continue
            }
            for (const at of inStatePos.get(p) ?? []) {
                if (at[1] === -1) { fixed.set(i, target.retReg); break }
            }
            if (fixed.has(i)) continue
            for (const at of inArgPos.get(p) ?? []) {
                const n = g.nodes.get(at[0])!
                if (n.op === 'call') {
                    const callee = g.nodes.get(n.argIds[1])
                    const regs = callee?.op === 'syscall-target' ? target.syscall.argRegs : target.argRegs
                    fixed.set(i, regs[at[1]])
                    break
                }
                const home = sig.get(n.argIds[0])?.[at[1]]
                if (home !== undefined && !isSlot(home) && home !== OPEN) { fixed.set(i, home); break }
            }
        }
        const homes: number[] = []
        const tokenAt = b.consumesEffectToken ? b.params.length - 1 : -1
        for (let i = 0; i < b.params.length; i++) {
            const p = b.params[i]
            if (i === tokenAt) { homes.push(0); continue }
            const safe = acrossCall.has(p)
            let r = -1
            const wanted = fixed.get(i) ?? -1
            if (wanted >= 0 && !safe && !taken.has(wanted)) r = wanted
            if (r < 0 && !safe && !inherits.has(i)) { homes.push(OPEN); continue }
            if (r < 0) {
                const pool = safe || inherits.has(i) ? preserved : volatiles
                for (const c of pool) if (!taken.has(c)) { r = c; break }
            }
            if (r < 0) for (const c of preserved) if (!taken.has(c)) { r = c; break }
            if (r < 0 && !safe) for (const c of volatiles) if (!taken.has(c)) { r = c; break }
            if (r < 0) { homes.push(takeSlot()); continue }
            taken.add(r)
            homes.push(r)
            if (isPreserved(r)) {
                usedPreserved.add(r)
                rootRegion.writes.add(r)
            }
        }
        sig.set(id, homes)
    }

    function demand(id: number, konst: number, want = -1): number {
        if (!id) {
            const k = --synth
            let temps = temporariesAt.get(materializing)
            if (!temps) temporariesAt.set(materializing, temps = [])
            temps.push(k)
            let r = freeReg(volatiles, NOTHING)
            if (r < 0) r = freeReg(preserved, NOTHING)
            if (r < 0) throw 'lowering3: out of registers'
            bind(k, r)
            put(() => asm.movImm(r, konst))
            return k
        }
        const n = g.nodes.get(id)
        if (n && n.op === 'after') {
            done.add(id)
            effect(n.argIds[0])
            return demand(n.argIds[1], n.argConsts[1], want)
        }
        if (!homeOf.has(id)) {
            if (!g.nodes.has(id) || isParam(g.nodes, id)) {
                throw `lowering3: parameter ${id} was released at ${freedAt.get(id)} before rematerializing ${materializing} (freed at ${freedAt.get(materializing)})\n${dumpGraph(g)}`
            }
            assert(!done.has(id))
            build(id, want)
        }
        return id
    }

    function orderedOperands(site: number, wanted: number[]): number[] {
        const out: number[] = []
        const remaining = new Set<number>(wanted)
        for (const i of analysis.operandOrder.get(site) ?? []) {
            if (!remaining.delete(i)) continue
            out.push(i)
        }
        for (const i of wanted) if (remaining.has(i)) out.push(i)
        return out
    }

    function forceMaterializeBefore(id: number) {
        for (const value of materializeBefore.get(id) ?? []) {
            const valueNode = g.nodes.get(value)
            if (!valueNode || !MaterializedPureOps.has(valueNode.op)) continue
            if (!homeOf.has(value) && !done.has(value)) build(value)
        }
    }

    function build(id: number, want = -1): void {
        const outer = materializing
        if (opts.debug) console.log('build', id, 'from', outer)
        materializing = id
        defer materializing = outer
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id)) throw `lowering3: no definition for value ${id} while materializing ${materializing}`
        const signed = lowering.isSignedType(n.T) || lowering.isSignedType(n.U)

        forceMaterializeBefore(id)

        if (n.op === 'call') { buildCall(id, n); return }
        if (n.op === 'select') { buildSelect(id, n, want); return }
        if (n.op === 'nil-effect') return
        if (n.op === 'void') {
            finish()
            const dst = regFor(id, want)
            put(() => asm.movImm(dst, 0))
            return
        }
        if (n.op === 'pool-entry') {
            const slot = n.argConsts[0]
            assert(!n.argIds[0] && Number.isSafeInteger(slot) && slot >= 0)
            finish()
            const dst = regFor(id, want)
            put(() => asm.loadPool(dst, slot))
            return
        }
        if (n.op === 'call-context') {
            throw `lowering3: indirect call context ${id} was not bound at entry`
        }
        if (BinaryOps.has(n.op) || CompareOps.has(n.op)) { buildArith(id, n, signed, want); return }
        if (UnaryOps.has(n.op)) {
            const op = n.op
            const a = demand(n.argIds[0], n.argConsts[0])
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => asm.unary(op, dst, ra))
            return
        }
        if (n.op === 'convert' || n.op === 'bitconvert') {
            const T = n.T
            const U = n.U
            const converts = n.op === 'convert'
            const a = demand(n.argIds[0], n.argConsts[0])
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => converts ? asm.convert(dst, ra, T, U) : asm.mov(dst, ra))
            return
        }
        if (n.op === 'load') {
            return buildLoad(id, n, want)
        }
        throw `lowering3: cannot produce '${n.op}'\n${dumpGraph(g)}`
    }

    function buildArith(id: number, n: GraphNode, signed: boolean, want: number): void {
        const swap = !n.argIds[0] && n.argIds[1] !== 0
            && (Commutative.has(n.op) || SwappedCmp[n.op] !== undefined)
        const op = swap ? SwappedCmp[n.op] ?? n.op : n.op
        const cmp = CompareOps.has(op)
        const li = swap ? 1 : 0
        const ri = swap ? 0 : 1
        const imm = n.argConsts[ri]
        if (!n.argIds[ri] && (op === 'and' || op === 'or' || op === 'xor'
            || op === 'shl' || op === 'shr' || op === 'ushr')) {
            const a = demand(n.argIds[li], n.argConsts[li])
            const ra = at(a, NOTHING)
            finish(id)
            const dst = regFor(id, want)
            put(() => asm.binaryImm(op, dst, ra, imm, signed))
            return
        }
        if (!n.argIds[ri] && imm >= 0 && imm <= 0xFFF && (cmp || op === 'add' || op === 'sub')) {
            const a = demand(n.argIds[li], n.argConsts[li])
            const ra = at(a, NOTHING)
            finish(id)
            const dst = regFor(id, want)
            put(() => cmp ? asm.compareImm(op, dst, ra, imm, signed)
                : op === 'add' ? asm.addImm(dst, ra, imm) : asm.subImm(dst, ra, imm))
            return
        }
        let a = 0, b = 0
        for (const i of orderedOperands(id, [li, ri])) {
            const v = demand(n.argIds[i], n.argConsts[i])
            if (i === li) a = v
            else b = v
        }
        const guard = new Set<number>()
        const ra = at(a, guard)
        guard.add(ra)
        const rb = at(b, guard)
        finish(id)
        const dst = regFor(id, want)
        put(() => cmp ? asm.compare(op, dst, ra, rb, signed) : asm.binary(op, dst, ra, rb, signed))
    }

    interface Handover { dst: number, id: number, konst: number, rank?: number, settle?: (reg: number) => void }
    function handOver(site: number, slots: Handover[], sequence: [number, () => void], elide = OPEN): number {
        const args: Move[] = []
        const consts: Move[] = []
        const feeds = new Map<Handover, number>()
        let sequenced = false
        for (let i = 0; i < slots.length; i++) {
            const s = slots[i]
            if (sequence[0] === i) {
                assert(!sequenced)
                sequence[1]()
                sequenced = true
            }
            if (!s.id) continue
            const want = s.dst === OPEN || isSlot(s.dst) ? -1 : s.dst
            feeds.set(s, demand(s.id, s.konst, want))
        }
        if (!sequenced) sequence[1]()
        const settled = new Map<number, number>()
        for (const v of feeds.values()) settled.set(v, homeOf.get(v)!)
        const claimed = new Set<number>()
        for (const s of slots) if (s.dst !== OPEN) claimed.add(s.dst)
        const open = slots.filter(s => s.dst === OPEN)
        open.sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0))
        for (const s of open) {
            if (s.dst !== OPEN) continue
            const v = feeds.get(s)
            const here = v === undefined ? undefined : settled.get(v)
            if (here === undefined || claimed.has(here)) continue
            claimed.add(here)
            if (isPreserved(here)) {
                usedPreserved.add(here)
                currentRegion.writes.add(here)
            }
            s.dst = here
            s.settle!(here)
        }
        for (const s of open) {
            if (s.dst !== OPEN) continue
            let r = -1
            for (const c of volatiles) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of preserved) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of volatiles) if (!claimed.has(c)) { r = c; break }
            if (r < 0) for (const c of preserved) if (!claimed.has(c)) { r = c; break }
            if (r < 0) r = takeSlot()
            claimed.add(r)
            if (isPreserved(r)) {
                usedPreserved.add(r)
                currentRegion.writes.add(r)
            }
            s.dst = r
            s.settle!(r)
        }
        for (const s of slots) {
            if (!s.id) { consts.push({ dst: s.dst, src: s.konst }); continue }
            args.push({ dst: s.dst, src: feeds.get(s)! })
        }
        if (opts.debug) {
            console.log('handover', site, slots.map(s => [s.dst, s.id, s.konst]),
                [...settled], 'elide', elide)
        }
        finish(site)
        const dsts = new Set<number>()
        for (const a of args) if (a.dst !== elide) dsts.add(a.dst)
        for (const c of consts) dsts.add(c.dst)
        let landed = elide
        const moves: Move[] = []
        for (const a of args) {
            const src = settled.get(a.src)!
            if (a.dst === elide && !isSlot(src) && !dsts.has(src)) { landed = src; continue }
            moves.push({ dst: a.dst, src })
        }
        shuffle(moves)
        for (const c of consts) {
            if (isSlot(c.dst)) put(() => {
                asm.movImm(SWAP, c.src)
                asm.store(SP, slotOffset(c.dst), SWAP, Types.u64)
            })
            else put(() => asm.movImm(c.dst, c.src))
        }
        return landed
    }

    function buildCall(id: number, n: GraphNode): void {
        const callee = g.nodes.get(n.argIds[1])
        const syscall = callee?.op === 'syscall-target' ? callee : undefined
        const local = callee?.op === 'local-target' ? callee : undefined
        const indirect = callee?.op === 'indirect-target' ? callee : undefined
        const fixedTarget = syscall ?? local
        if (!syscall && (usedPreserved.size || slotCount)) tailCall = 0
        if (!syscall) callsOut ||= tailCall !== id
        else tailCall = 0
        const argRegs = syscall ? target.syscall.argRegs : target.argRegs
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const i of analysis.operandOrder.get(id) ?? []) {
            if (i === 0) sequenceIdx = slots.length
            if (i === 1 && indirect) {
                for (const j of analysis.operandOrder.get(n.argIds[1]) ?? [0, 1]) {
                    slots.push({
                        dst: j === 0 ? CALLEE : target.indirectContextReg,
                        id: indirect.argIds[j], konst: indirect.argConsts[j],
                    })
                }
                continue
            }
            if (i < 3 && (i !== 1 || fixedTarget)) continue
            slots.push({
                dst: i === 1 ? CALLEE : argRegs[i - 3],
                id: n.argIds[i], konst: n.argConsts[i],
            })
        }
        done.add(id)
        const linkReg = handOver(id, slots, [sequenceIdx, () => effect(n.argIds[0])], CALLEE)
        if (syscall) {
            const number = syscall.argConsts[0]
            assert(!syscall.argIds[0] && Number.isSafeInteger(number))
            put(() => asm.syscall(number))
        } else if (local) {
            const target = local.argConsts[0]
            assert(!local.argIds[0] && Number.isSafeInteger(target) && target >= 0)
            put(() => tailCall === id ? asm.jumpLocal(target, local.label) : asm.callLocal(target, local.label))
        } else {
            put(() => tailCall === id ? asm.br(linkReg) : asm.blr(linkReg))
        }
        for (const x of volatiles) {
            if (const v = heldBy.get(x)) {
                freedAt.set(v, id)
                heldBy.delete(x)
            }
        }
        const retReg = syscall ? target.syscall.retReg : target.retReg
        transfer(regFor(id, retReg), retReg)
    }

    function effect(id: number): void {
        if (!id) return
        const n = g.nodes.get(id)
        if (!n || isParam(g.nodes, id)) return
        if (n.op === 'call') {
            if (!done.has(id) && !homeOf.has(id)) build(id)
        } else if (n.op === 'after') {
            effect(n.argIds[0])
            effect(n.argIds[1])
        } else if (n.op === 'store') {
            if (!done.has(id)) buildStore(id, n)
        } else if (n.op === 'load') {
            if (!done.has(id) && !homeOf.has(id)) build(id)
        } else if (n.op === 'select') {
            const taken = g.nodes.get(n.argIds[1])?.op === 'panic' ? 2
                : g.nodes.get(n.argIds[2])?.op === 'panic' ? 1 : 0
            if (!taken) throw `lowering3: effect ${id} branches before the tail\n${dumpGraph(g)}`
            effect(n.argIds[taken])
        }
        if (!analysis.usedBy.has(id)) freeValue(id)
    }

    function buildStore(id: number, n: GraphNode): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        effect(n.argIds[0])
        const T = n.T
        const b = demand(n.argIds[1], n.argConsts[1])
        let o = 0
        if (n.argIds[2]) o = demand(n.argIds[2], n.argConsts[2])
        const v = demand(n.argIds[3], n.argConsts[3])
        const guard = new Set<number>()
        const base = at(b, guard)
        guard.add(base)
        const ro = o ? at(o, guard) : -1
        if (o) guard.add(ro)
        const rv = at(v, guard)
        guard.add(rv)
        finish()
        if (ro < 0) {
            const offset = n.argConsts[2]
            put(() => asm.store(base, offset, rv, T))
            return
        }
        const addr = freeReg(volatiles, guard)
        if (addr < 0) throw 'lowering3: out of registers'
        const sum = ro
        put(() => {
            asm.binary('add', addr, base, sum, false)
            asm.store(addr, 0, rv, T)
        })
    }

    function buildLoad(id: number, n: GraphNode, want: number) {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        effect(n.argIds[0])
        const T = n.T
        if (!n.argIds[2]) {
            const b0 = demand(n.argIds[1], n.argConsts[1])
            const base0 = at(b0, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => asm.load(dst, base0, n.argConsts[2], T))
            return
        }
        let b = 0, o = 0
        for (const i of orderedOperands(id, [1, 2])) {
            const v = demand(n.argIds[i], n.argConsts[i])
            if (i === 1) b = v
            else o = v
        }
        const guard = new Set<number>()
        const rb = at(b, guard)
        guard.add(rb)
        const ro = at(o, guard)
        finish()
        const dst = regFor(id, want)
        put(() => {
            asm.binary('add', dst, rb, ro, false)
            asm.load(dst, dst, 0, T)
        })
    }

    function condition(site: number, id: number, konst: number, otherwise: number): void {
        const outer = materializing
        materializing = id || site
        defer materializing = outer
        const n = id ? g.nodes.get(id) : undefined
        if (n && CompareOps.has(n.op) && !homeOf.has(id) && releaseAt.get(site)?.has(id)) {
            const signed = lowering.isSignedType(n.T) || lowering.isSignedType(n.U)
            const flip = !n.argIds[0] && n.argIds[1] !== 0 && SwappedCmp[n.op] !== undefined
            const op = flip ? SwappedCmp[n.op] : n.op
            const li = flip ? 1 : 0
            const ri = flip ? 0 : 1
            const imm = n.argConsts[ri]
            const a = demand(n.argIds[li], n.argConsts[li])
            const guard = new Set<number>()
            if (!n.argIds[ri] && imm >= 0 && imm <= 0xFFF) {
                const ra = at(a, guard)
                finish(id)
                const flag = freeReg(volatiles, NOTHING)
                if (flag < 0) throw 'lowering3: out of registers'
                put(() => {
                    asm.compareImm(op, flag, ra, imm, signed)
                    asm.jumpIfZero(flag, otherwise)
                    asm.released([{ value: id, home: flag }])
                })
                return
            }
            const b = demand(n.argIds[ri], n.argConsts[ri])
            const ra = at(a, guard)
            guard.add(ra)
            const rb = at(b, guard)
            guard.add(rb)
            finish(id)
            const flag = freeReg(volatiles, NOTHING)
            if (flag < 0) throw 'lowering3: out of registers'
            put(() => {
                asm.compare(op, flag, ra, rb, signed)
                asm.jumpIfZero(flag, otherwise)
                asm.released([{ value: id, home: flag }])
            })
            return
        }
        const v = demand(id, konst)
        const r = at(v, NOTHING)
        finish(site)
        put(() => asm.jumpIfZero(r, otherwise))
    }

    function preferBranchless(n: GraphNode) {
        if (n.argIds.length !== 3) return false
        for (let i = 1; i < 3; i++) {
            const u = n.argIds[i]
            if (!u) continue
            if (homeOf.has(u) || done.has(u)) continue
            if (!pure.has(u)) return false
            const p = g.nodes.get(u)
            if (!p) continue
            for (let j = 0; j < p.argIds.length; j++) {
                const q = p.argIds[j]
                if (!q) continue
                //if (!homeOf.has(q) && !done.has(q) && g.nodes.get(q)) return false
            }
        }
        return true
    }

    function buildSelect(id: number, n: GraphNode, want: number): void {
        if (preferBranchless(n)) {
            const slots: number[] = []
            for (const i of orderedOperands(id, [0, 1, 2])) {
                const v = demand(n.argIds[i], n.argConsts[i])
                slots[i] = v
            }
            const guard = new Set<number>()
            const rc = at(slots[0], guard)
            guard.add(rc)
            const rx = at(slots[1], guard)
            guard.add(rx)
            const ry = at(slots[2], guard)
            finish(id)
            const dst = regFor(id, want)
            put(() => asm.select(dst, rc, rx, ry))
            return
        }
        console.log(dumpGraph(g))
        throw `lowering3: select ${id} branches in value position`
    }

    const allExitsVoid = (() => {
        let sawVoid = false
        function isVoid(id: number): boolean {
            if (!id || g.nodes.get(id)?.op !== 'void') return false
            sawVoid = true
            return true
        }
        for (const [site, at] of analysis.returnsAt) {
            const n = g.nodes.get(site)
            if (n && !isVoid(n.argIds[at])) return false
        }
        const seen = new Set<number>()
        function tails(id: number): boolean {
            if (!id || seen.has(id)) return !!id
            seen.add(id)
            const n = g.nodes.get(id)
            if (!n) return false
            if (n.op === 'after') return tails(n.argIds[1])
            if (n.op === 'select') return tails(n.argIds[1]) && tails(n.argIds[2])
            if (n.op === 'apply' || n.op === 'proj' || n.op === 'state' || n.op === 'panic') return true
            return isVoid(id)
        }
        for (const b of g.blocks) if (!tails(b.bodyId)) return false
        return sawVoid
    })()

    function returnValue(site: number, id: number, konst: number): void {
        if (allExitsVoid && g.nodes.get(id)?.op === 'void') { jumpToExit(); return }
        if (!id) put(() => asm.movImm(target.retReg, konst))
        else {
            const v = demand(id, konst, target.retReg)
            const src = homeOf.get(v)!
            finish(site)
            transfer(target.retReg, src, { value: v, home: src })
        }
        jumpToExit()
    }

    function emitApply(id: number, n: GraphNode, jump = true): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        const b = blockOf.get(n.argIds[0])
        if (!b) throw 'lowering3: apply of something that is not a block'
        const homes = sig.get(b.id)!
        const tokenAt = b.consumesEffectToken ? b.params.length - 1 : -1
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const at of analysis.operandOrder.get(id) ?? []) {
            if (at < 1 || at > b.params.length) continue
            const i = at - 1
            if (i === tokenAt) {
                sequenceIdx = slots.length
                continue
            }
            slots.push({
                dst: homes[i], id: n.argIds[i + 1], konst: n.argConsts[i + 1], rank: i,
                settle: (r: number) => { homes[i] = r },
            })
        }
        handOver(id, slots, [sequenceIdx, () => { if (tokenAt >= 0) effect(n.argIds[tokenAt + 1]) }])
        if (jump) put(() => asm.jump(b.id))
        else {
            for (let i = 0; i < b.params.length; i++) {
                if (i === tokenAt || !n.argIds[i + 1]) continue
                place(n.argIds[i + 1], homes[i])
            }
        }
    }

    function emitState(id: number, n: GraphNode): void {
        const at = analysis.returnsAt.get(id)
        if (at === undefined) { jumpToExit(); return }
        returnValue(id, n.argIds[at], n.argConsts[at])
    }

    function exitsFunction(id: number, seen = new Set<number>()): boolean {
        if (!id || seen.has(id)) return true
        seen.add(id)
        const n = g.nodes.get(id)
        if (!n) return true
        if (n.op === 'after') return exitsFunction(n.argIds[1], seen)
        if (n.op === 'select') {
            return exitsFunction(n.argIds[1], new Set(seen))
                && exitsFunction(n.argIds[2], new Set(seen))
        }
        if (n.op === 'apply' || n.op === 'proj') return false
        return true
    }

    function emitTailRegion(id: number, konst: number, group: number): void {
        if (currentBlock !== g.blocks[0].id || !exitsFunction(id)) {
            emitTail(id, konst)
            return
        }
        const parent = currentRegion
        const region: EmitRegion = {
            parent, children: [], writes: new Set(), owned: [], exitLabel: nextLabel++, group,
        }
        parent.children.push(region)
        currentRegion = region
        put(() => {
            for (const r of region.owned) asm.store(SP, savedIndex.get(r)! * 8, r, Types.u64)
        })
        emitTail(id, konst)
        currentRegion = parent
    }

    function emitTail(id: number, konst: number): void {
        const n = id ? g.nodes.get(id) : undefined
        if (!n) { returnValue(id, id, konst); return }
        if (n.op === 'after') {
            effect(n.argIds[0])
            emitTail(n.argIds[1], n.argConsts[1])
            return
        }
        if (n.op === 'select') {
            if (analysis.operandOrder.get(id)?.[0] === 1) {
                const back = g.nodes.get(n.argIds[1])
                if (!back || back.op !== 'apply') throw `lowering3: rotated select ${id} has no backedge`
                emitApply(n.argIds[1], back, false)
                const exit = nextLabel++
                condition(id, n.argIds[0], n.argConsts[0], exit)
                put(() => asm.jump(back.argIds[0]))
                put(() => asm.bindLabel(exit))
                narrowTo(n.argIds[2])
                emitTail(n.argIds[2], n.argConsts[2])
                return
            }
            const otherwise = nextLabel++
            condition(id, n.argIds[0], n.argConsts[0], otherwise)
            const before = snapshot()
            const group = nextRegionGroup++
            narrowTo(n.argIds[1])
            emitTailRegion(n.argIds[1], n.argConsts[1], group)
            restore(before)
            put(() => asm.bindLabel(otherwise))
            narrowTo(n.argIds[2])
            emitTailRegion(n.argIds[2], n.argConsts[2], group)
            return
        }
        if (n.op === 'apply') { emitApply(id, n); return }
        if (n.op === 'state') { emitState(id, n); return }
        if (n.op === 'panic') { jumpToExit(); return }
        if (n.op === 'proj') {
            const app = g.nodes.get(n.argIds[0])
            if (!app || app.op !== 'apply') throw 'lowering3: projection of a non-application'
            emitApply(n.argIds[0], app)
            return
        }
        returnValue(id, id, konst)
    }

    for (const id of order) {
        const b = blockOf.get(id)!
        currentBlock = id
        currentRegion = rootRegion
        homeOf.clear()
        heldBy.clear()
        done.clear()
        reusableSlots.clear()
        for (let i = 1; i <= slotCount; i++) reusableSlots.add(-i)
        put(() => asm.bindLabel(b.id))
        if (id === g.blocks[0].id) {
            for (const context of callContexts) {
                if (acrossCall.has(context)) {
                    const r = freeReg(preserved, NOTHING)
                    if (r < 0) throw 'lowering3: no register for indirect call context'
                    bind(context, r)
                    transfer(r, target.indirectContextReg)
                } else {
                    bind(context, target.indirectContextReg)
                }
            }
            for (let i = 0; i < g.params.length; i++) {
                const p = g.params[i]
                const arrives = target.argRegs[i]
                if (acrossCall.has(p)) {
                    const r = freeReg(preserved, new Set<number>())
                    if (r >= 0) { bind(p, r); transfer(r, arrives); continue }
                }
                bind(p, arrives)
            }
            emitTail(b.bodyId, b.bodyConst)
            continue
        }
        const homes = sig.get(id)!
        const tokenAt = b.consumesEffectToken ? b.params.length - 1 : -1
        for (let i = 0; i < b.params.length; i++) {
            if (i === tokenAt) continue
            if (homes[i] === OPEN) homes[i] = freeReg(volatiles, NOTHING)
            place(b.params[i], homes[i])
        }
        emitTail(b.bodyId, b.bodyConst)
    }

    function promoteCommonRegionWrites(region: EmitRegion): Set<number> {
        const subtree: Set<number>[] = []
        const groups = new Map<number, number[]>()
        for (let i = 0; i < region.children.length; i++) {
            const child = region.children[i]
            subtree.push(promoteCommonRegionWrites(child))
            const siblings = groups.get(child.group)
            if (siblings) siblings.push(i)
            else groups.set(child.group, [i])
        }
        for (const siblings of groups.values()) {
            if (siblings.length < 2) continue
            const common = new Set(subtree[siblings[0]])
            for (let i = 1; i < siblings.length; i++) {
                const writes = subtree[siblings[i]]
                for (const r of common) if (!writes.has(r)) common.delete(r)
            }
            for (const r of common) region.writes.add(r)
        }
        const all = new Set(region.writes)
        for (const writes of subtree) for (const r of writes) all.add(r)
        return all
    }

    function assignRegionRegisters(region: EmitRegion, inherited: Set<number>): void {
        region.owned = [...region.writes].filter(r => !inherited.has(r))
        const watermark = new Set(inherited)
        for (const r of region.owned) watermark.add(r)
        for (const child of region.children) assignRegionRegisters(child, watermark)
    }
    promoteCommonRegionWrites(rootRegion)
    assignRegionRegisters(rootRegion, new Set())

    const saved = target.calleeSaved.filter(r => usedPreserved.has(r))
    for (let i = 0; i < saved.length; i++) savedIndex.set(saved[i], i)
    frameBase = (saved.length + (callsOut ? 1 : 0)) * 8
    const frameBytes = (frameBase + slotCount * 8 + 15) & ~15
    if (frameBytes) asm.spAdjust(frameBytes)
    for (const r of rootRegion.owned) asm.store(SP, savedIndex.get(r)! * 8, r, Types.u64)
    if (callsOut) asm.store(SP, saved.length * 8, LR, Types.u64)
    let released: { value: number, home: number }[] = []
    for (const item of code) {
        if (typeof item !== 'function') {
            if ('released' in item) {
                released.push(...item.released)
                continue
            }
            const { dst, src, consumed } = item
            if (isSlot(src) && isSlot(dst)) {
                asm.load(SWAP, SP, slotOffset(src), Types.u64)
                asm.store(SP, slotOffset(dst), SWAP, Types.u64)
            } else if (isSlot(src)) asm.load(dst, SP, slotOffset(src), Types.u64)
            else if (isSlot(dst)) asm.store(SP, slotOffset(dst), src, Types.u64)
            else asm.mov(dst, src)
            if (consumed) released.push(consumed)
            if (released.length) {
                asm.released(released)
                released = []
            }
            continue
        }
        item()
        if (released.length) {
            asm.released(released)
            released = []
        }
    }

    const epilogues: EmitRegion[] = []
    function collectEpilogues(region: EmitRegion): void {
        for (const child of region.children) collectEpilogues(child)
        if (region !== rootRegion && region.owned.length) epilogues.push(region)
    }
    collectEpilogues(rootRegion)
    for (let i = 0; i < epilogues.length; i++) {
        const region = epilogues[i]
        asm.bindLabel(region.exitLabel)
        for (const r of region.owned) asm.load(r, SP, savedIndex.get(r)! * 8, Types.u64)
        const target = regionExit(region.parent)
        const next = i + 1 < epilogues.length ? epilogues[i + 1].exitLabel : exitLabel
        if (target !== next) asm.jump(target)
    }
    asm.bindLabel(exitLabel)
    for (const r of rootRegion.owned) asm.load(r, SP, savedIndex.get(r)! * 8, Types.u64)
    if (callsOut) asm.load(LR, SP, saved.length * 8, Types.u64)
    if (frameBytes) asm.spAdjust(-frameBytes)
    if (!tailCall) asm.ret()

    return {
        target, words: asm.words(), bytes: asm.bytes(), relocations: asm.relocations(),
        listing: asm.listing(),
    }
}

export function packageBlocks(g: Graph): Graph {
    const nodes = new Map<number, GraphNode>(g.nodes)
    const blocks = g.blocks.map(b => ({ ...b, params: b.params.slice() }))
    const blockOf = new Map<number, GraphBlock>()
    for (const b of blocks) blockOf.set(b.id, b)

    let nextId = g.maxId

    function fresh(): number { return nextId++ }
    function addParam(label?: string): number {
        const id = fresh()
        nodes.set(id, paramNode(label))
        return id
    }
    function addNode(op: string, argIds: number[], argConsts: Float64Array, from?: GraphNode): number {
        const id = fresh()
        nodes.set(id, {
            op, argIds, argConsts,
            label: from?.label,
            T: from?.T ?? Types.u64,
            U: from?.U ?? Types.u64,
            types: from?.types,
        })
        return id
    }

    const aliases = normalizeAliases()
    const localOf = new Map<number, Map<number, number>>()

    for (let next = 0; next < blocks.length; next++) {
        packageBlock(blocks[next])
    }

    for (const block of blocks) {
        const outside = new Map<number, number>()
        for (const [param, source] of aliases) {
            if (!block.params.includes(param)) outside.set(param, source)
        }
        if (outside.size) block.bodyId = replaceAll(block.bodyId, outside)
    }
    // for (const block of blocks) {
    //     prunePassthru(block)
    // }

    const resultBlocks = reachableBlocks()
    assert(resultBlocks[0].id === 0)
    resultBlocks[0].params = g.params.slice()
    validate(resultBlocks)
    return { ...g, maxId: nextId, nodes, params: resultBlocks[0].params, blocks: resultBlocks }

    function packageBlock(owner: GraphBlock): void {
        const sites = packagingSites(owner.bodyId)
        if (!sites.length) return
        const replacements = new Map<number, number>()
        for (const site of sites) {
            replacements.set(site.container, bind(owner, site.container, site.apply))
        }
        owner.bodyId = replaceAll(owner.bodyId, replacements)
    }

    function validate(result: GraphBlock[]): void {
        const seen = new Set<number>()
        for (const b of result) {
            const available = new Set<number>(b.params)
            function walk(id: number, owner: number): void {
                if (!id || seen.has(id) || available.has(id)) return
                seen.add(id)
                if (isParam(nodes, id)) {
                    console.log(dumpGraph({ ...g, nodes, blocks: result }))
                    console.log('---- original ----')
                    console.log(dumpGraph(g))
                    throw `lowering2: block ${b.id} node ${owner} refers to unbound value ${id}`
                }
                const n = nodes.get(id)!
                for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) walk(n.argIds[i], id)
            }
            walk(b.bodyId, b.bodyId)
        }
    }

    function packagingSites(root: number): { container: number, apply: number }[] {
        const sites: { container: number, apply: number }[] = []
        const lanes = new Set<number>()
        function lane(id: number): void {
            if (!id || lanes.has(id)) return
            lanes.add(id)
            scan(id, true, id, new Map<number, boolean>())
        }
        function scan(id: number, tail: boolean, container: number,
            memo: Map<number, boolean>): boolean {
            if (!id) return false
            if (!tail) {
                const known = memo.get(id)
                if (known !== undefined) return known
                memo.set(id, false)
            }
            const n = nodes.get(id)
            if (!n) return false
            let found = false
            if (n.op === 'apply') {
                for (let i = 1; i < n.argIds.length; i++) {
                    if (scan(n.argIds[i], false, container, memo)) { found = true; break }
                }
                if (!found && !tail) {
                    sites.push({ container, apply: id })
                    found = true
                }
            } else if (n.op === 'after') {
                found = scan(n.argIds[0], false, container, memo)
                if (!found && tail) {
                    lane(n.argIds[1])
                } else if (!found) {
                    found = scan(n.argIds[1], false, container, memo)
                }
            } else if (n.op === 'select') {
                found = scan(n.argIds[0], false, container, memo)
                if (!found && tail) {
                    lane(n.argIds[1])
                    lane(n.argIds[2])
                } else if (!found) {
                    found = scan(n.argIds[1], false, container, memo)
                    if (!found) found = scan(n.argIds[2], false, container, memo)
                }
            } else {
                for (const arg of n.argIds) {
                    if (scan(arg, false, container, memo)) { found = true; break }
                }
            }
            if (!tail) memo.set(id, found)
            return found
        }
        lane(root)
        return sites
    }

    function isSimpleApply(v: GraphNode) {
        if (v.op !== 'apply') return false
        for (let i = 1; i < v.argIds.length; i++) {
            const a = v.argIds[i]
            if (!a) continue
            const u = nodes.get(a)
            if (u) return false // param
        }
        return true
    }

    function prunePassthru(b: GraphBlock) {
        const replacements = new Map<number, number>()
        const visited = new Set<number>()
        function visit(id: number): void {
            if (!id || visited.has(id)) return
            visited.add(id)
            const n = nodes.get(id)
            if (!n) return
            if (n.op !== 'apply') {
                for (let i = 0; i < n.argIds.length; i++) visit(n.argIds[i])
                return
            }

            const targetBlock = blockOf.get(n.argIds[0])
            assert(targetBlock)
            if (targetBlock.bodyId) {
                const body = nodes.get(targetBlock.bodyId)
                if (body && isSimpleApply(body)) {
                    const newAppId = addNode(body.op, body.argIds.slice(), body.argConsts.slice(), body)
                    const app = nodes.get(newAppId)!
                    for (let i = 1; i < app.argIds.length; i++) {
                        const v = app.argIds[i]
                        if (!v) continue
                        if (!nodes.get(v)) {
                            // param
                            const ind = targetBlock.params.indexOf(v)
                            assert(ind !== -1)
                            app.argIds[i] = n.argIds[ind+1]
                            app.argConsts[i] = n.argConsts[ind+1]
                        }
                    }
                    replacements.set(id, newAppId)
                }
            }
            for (let i = 1; i < n.argIds.length; i++) {
                visit(n.argIds[i])
            }
        }
        visit(b.bodyId)
        if (!replacements.size) return
        b.bodyId = replaceAll(b.bodyId, replacements)
    }

    function extractCalls(b: GraphBlock) {
        const visited = new Set<number>()
        const seenFrom = new Map<number, Map<number, Set<number>>>()
        function addSeenFrom(select: number, arm: number, call: number) {
            let m = seenFrom.get(select)
            if (!m) seenFrom.set(select, m = new Map())
            let s = m.get(arm)
            if (!s) m.set(arm, s = new Set())
            s.add(call)
        }
        let parent = 0
        const parents = new Map<number, number[]>()
        function visit(id: number, fromSelect: number, arm: number): void {
            if (!id) return
            let arr = parents.get(id)
            if (!arr) parents.set(id, arr = [])
            arr.push(parent)
            if (visited.has(id)) return
            const saveParent = parent
            defer parent = saveParent
            parent = id
            visited.add(id)
            const n = nodes.get(id)
            if (!n) return
            if (n.op === 'select') {
                visit(n.argIds[0], 0, 0)
                for (let i = 1; i < n.argIds.length; i++) {
                    visit(n.argIds[i], id, n.argIds[i])
                }
                return
            }
            if (n.op !== 'call' || !fromSelect) {
                for (let i = 0; i < n.argIds.length; i++) visit(n.argIds[i], fromSelect, arm)
                return
            }
            addSeenFrom(fromSelect, arm, id)
        }
        visit(b.bodyId, 0, 0)
        const replacements = new Map<number, number>()
        for (const [k, v] of seenFrom) {
            outer: for (const [arm, s] of v) {
                if (parents.get(arm)?.length !== 1) continue
                
                for (const c of s) {
                    if (parents.get(c)?.length !== 1) continue outer
                }
            }

        }

        if (!replacements.size) return
        b.bodyId = replaceAll(b.bodyId, replacements)
    }

    function replaceAll(id: number, replacements: Map<number, number>): number {
        if (!id) return id
        if (const replacement = replacements.get(id)) {
            return replacement
        }
        const n = nodes.get(id)
        if (!n) return id
        const ids = n.argIds
        const idReplacements: [idx: number, id: number][] = []
        for (let i = n.op === 'apply' ? 1 : 0; i < ids.length; i++) {
            const next = replaceAll(ids[i], replacements)
            if (next !== ids[i]) { 
                idReplacements.push([i, next])
            }
        }
        if (!idReplacements.length) return id
        const newIds = new Array(ids.length)
        for (let i = 0; i < ids.length; i++) {
            if (idReplacements[0]?.[0] === i) {
                newIds[i] = idReplacements.shift()![1]
            } else {
                newIds[i] = ids[i]
            }
        }
        const copy = addNode(n.op, newIds, n.argConsts.slice(), n)
        replacements.set(id, copy)
        return copy
    }

    function normalizeAliases(): Map<number, number> {
        const applications = new Map<number, GraphNode[]>()
        const aliases = new Map<number, number>()
        const seen = new Set<number>()
        function scan(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = nodes.get(id)
            if (!n) return
            if (n.op === 'apply') {
                let calls = applications.get(n.argIds[0])
                if (!calls) applications.set(n.argIds[0], calls = [])
                calls.push(n)
            }
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) scan(n.argIds[i])
        }
        for (const block of blocks) scan(block.bodyId)

        for (const block of blocks) {
            const calls = applications.get(block.id)
            if (!calls?.length) continue
            const replacements = new Map<number, number>()
            for (let i = 0; i < block.params.length; i++) {
                if (block.consumesEffectToken && i === block.params.length - 1) continue
                const param = block.params[i]
                let source = 0
                let same = true
                for (const call of calls) {
                    const arg = call.argIds[i + 1]
                    if (arg === param) continue
                    if (!arg || (source && arg !== source)) { same = false; break }
                    source = arg
                }
                if (!same || !source) continue
                aliases.set(param, source)
                replacements.set(source, param)
            }
            if (replacements.size) {
                block.bodyId = replaceAll(block.bodyId, replacements)
            }
        }
        return aliases
    }

    function bind(owner: GraphBlock, root: number, appId: number): number {
        const call = nodes.get(appId)!
        const target = call.argIds[0]
        const targetBlock = blockOf.get(target)
        if (!targetBlock) throw `lowering2: apply of something that is not a block`

        function addEnvironment(ids: number[], constants: Float64Array, env: number[], tokenLast: boolean) {
            const at = tokenLast ? ids.length - 1 : ids.length
            const nextIds = [...ids.slice(0, at), ...env, ...ids.slice(at)]
            const nextConstants = new Float64Array(nextIds.length)
            nextConstants.set(constants.slice(0, at))
            nextConstants.set(constants.slice(at), at + env.length)
            return [nextIds, nextConstants] as [number[], Float64Array]
        }

        const region = new Set<number>()
        const terminals = new Map<string, number>()
        const terminalTokens = new Map<string, number>()
        function discover(blockId: number): void {
            if (region.has(blockId)) return
            const block = blockOf.get(blockId)
            if (!block) return
            region.add(blockId)
            function walk(id: number): void {
                if (!id) return
                const n = nodes.get(id)
                if (!n) return
                if (n.op === 'state') {
                    const arity = terminals.get(n.label!)
                    if (arity !== undefined && arity !== n.argIds.length) {
                        throw `lowering2: inconsistent state '${n.label}'`
                    }
                    terminals.set(n.label!, n.argIds.length)
                    const tokenSlot = block.effectSlot
                        ?? (block.consumesEffectToken ? block.inputs![block.params.length - 1] : undefined)
                    if (tokenSlot !== undefined) {
                        const tokenAt = block.slots!.indexOf(tokenSlot)
                        if (tokenAt < 0) throw `lowering2: state '${n.label}' is missing its effect token`
                        terminalTokens.set(n.label!, tokenAt)
                    }
                    return
                }
                if (n.op === 'apply') { discover(n.argIds[0]); return }
                if (n.op === 'after') { walk(n.argIds[1]); return }
                if (n.op === 'select') { walk(n.argIds[1]); walk(n.argIds[2]) }
            }
            walk(block.bodyId)
        }
        discover(target)
        if (!terminals.size) {
            throw `lowering2: applied region ${target} has no terminal states (owner ${owner.id}, app ${appId})`
        }

        const invariantParams = new Map<number, number>()
        for (let i = 0; i < targetBlock.params.length; i++) {
            const param = targetBlock.params[i]
            let invariant = true
            const seen = new Set<number>()
            function check(id: number): void {
                if (!id || seen.has(id) || !invariant) return
                seen.add(id)
                const n = nodes.get(id)
                if (!n) return
                if (n.op === 'apply' && n.argIds[0] === target
                    && n.argIds[i + 1] !== param) {
                    invariant = false
                    return
                }
                for (let j = n.op === 'apply' ? 1 : 0; j < n.argIds.length; j++) check(n.argIds[j])
            }
            for (const blockId of region) check(blockOf.get(blockId)!.bodyId)
            if (invariant) invariantParams.set(param, i + 1)
        }

        const slots = targetBlock.slots ?? []
        const captures: number[] = []
        const captureParams: number[] = []
        const captureOf = new Map<number, number>()
        function capture(id: number): number {
            const prev = captureOf.get(id)
            if (prev !== undefined) return prev
            const param = addParam()
            captureOf.set(id, param)
            const local = localOf.get(owner.id)?.get(id)
            captures.push(local !== undefined ? local : (aliases.get(id) ?? id))
            captureParams.push(param)
            return param
        }

        const regionParams = new Set<number>()
        for (const blockId of region) {
            for (const param of blockOf.get(blockId)!.params) regionParams.add(param)
        }
        function entryArgument(id: number): number {
            const invariant = invariantParams.get(id)
            return invariant === undefined ? 0 : call.argIds[invariant]
        }
        function surveyFree(id: number, own: Set<number>, surveyed: Set<number>): void {
            if (!id || surveyed.has(id)) return
            surveyed.add(id)
            if (regionParams.has(id)) {
                if (own.has(id)) return
                const arg = entryArgument(id)
                if (arg) capture(arg)
                return
            }
            if (isParam(nodes, id)) { capture(id); return }
            const n = nodes.get(id)!
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) {
                surveyFree(n.argIds[i], own, surveyed)
            }
        }
        for (const blockId of region) {
            const b = blockOf.get(blockId)!
            surveyFree(b.bodyId, new Set<number>(b.params), new Set<number>())
        }

        const dependency = new Map<number, boolean>()
        function depends(id: number): boolean {
            if (!id) return false
            if (id === appId) return true
            const prev = dependency.get(id)
            if (prev !== undefined) return prev
            dependency.set(id, false)
            const n = nodes.get(id)
            if (!n) return false
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) {
                if (depends(n.argIds[i])) { dependency.set(id, true); return true }
            }
            return false
        }

        const internalDependency = new Map<number, boolean>()
        function usesRegionParam(id: number): boolean {
            if (!id) return false
            if (regionParams.has(id)) return true
            const prev = internalDependency.get(id)
            if (prev !== undefined) return prev
            internalDependency.set(id, false)
            const n = nodes.get(id)
            if (!n) return false
            for (let i = n.op === 'apply' ? 1 : 0; i < n.argIds.length; i++) {
                if (usesRegionParam(n.argIds[i])) { internalDependency.set(id, true); return true }
            }
            return false
        }

        const continuationOf = new Map<string, number>()
        const fieldsOf = new Map<string, number[]>()
        for (const e of terminals) {
            const id = fresh()
            continuationOf.set(e[0], id)
            nodes.set(id, {
                op: 'block', argIds: [], argConsts: new Float64Array(0),
                T: Types.u64, U: Types.u64,
            })
            const fields: number[] = []
            for (let i = 0; i < e[1]; i++) fields.push(addParam())
            fieldsOf.set(e[0], fields)
        }

        function specialize(id: number, literal: number, terminal: string, memo: Map<number, number>): number[] {
            if (!id) return [0, literal]
            const invariant = invariantParams.get(id)
            if (invariant !== undefined) {
                const arg = call.argIds[invariant]
                return arg ? [capture(arg), 0] : [0, call.argConsts[invariant]]
            }
            if (isParam(nodes, id)) return [capture(id), 0]
            const n = nodes.get(id)!
            if (n.op === 'syscall-target' || n.op === 'local-target'
                || n.op === 'pool-entry' || n.op === 'nil-effect' || n.op === 'panic' || n.op === 'heap-handle') return [id, 0]
            if (!depends(id) && !usesRegionParam(id)
                && n.op !== 'state' && n.op !== 'apply'
                && n.op !== 'select' && n.op !== 'after') return [capture(id), 0]
            if ((n.op === 'proj' || n.op === 'is-state') && n.argIds[0] === appId) {
                if (n.op === 'is-state') return [0, n.label === terminal ? 1 : 0]
                if (!n.label?.startsWith(terminal + '.')) return [0, 0]
                const suffix = n.label.slice(terminal.length + 1)
                const field = suffix === 'return' ? slots.length : slots.indexOf(n.argConsts[1])
                if (field < 0 || field >= fieldsOf.get(terminal)!.length) {
                    throw `lowering2: state '${terminal}' has no projection '${suffix}'`
                }
                return [fieldsOf.get(terminal)![field], 0]
            }
            const prev = memo.get(id)
            if (prev !== undefined) return [prev, 0]
            const ids: number[] = []
            const constants = new Float64Array(n.argIds.length)
            for (let i = 0; i < n.argIds.length; i++) {
                if (n.op === 'apply' && i === 0) {
                    ids.push(n.argIds[0])
                    constants[0] = n.argConsts[0]
                    continue
                }
                const v = specialize(n.argIds[i], n.argConsts[i], terminal, memo)
                ids.push(v[0])
                constants[i] = v[1] as f64
            }
            if (n.op === 'select' && !ids[0]) return ids[constants[0] ? 1 : 2]
                ? [ids[constants[0] ? 1 : 2], 0]
                : [0, constants[constants[0] ? 1 : 2]]
            const copy = addNode(n.op, ids, constants, n)
            memo.set(id, copy)
            return [copy, 0]
        }

        const continuationResults = new Map<string, number[]>()
        for (const e of terminals) {
            const result = specialize(root, 0, e[0], new Map<number, number>())
            continuationResults.set(e[0], result)
        }

        const captureIndex = new Map<number, number>()
        for (let i = 0; i < captureParams.length; i++) captureIndex.set(captureParams[i], i)
        function environment(): number[] {
            const out: number[] = []
            for (let i = 0; i < captures.length; i++) out.push(addParam())
            return out
        }
        function remapCaptures(id: number, env: number[], memo = new Map<number, number>()): number {
            if (!id) return 0
            const ci = captureIndex.get(id)
            if (ci !== undefined) return env[ci]
            const prev = memo.get(id)
            if (prev !== undefined) return prev
            const n = nodes.get(id)
            if (!n) return id
            const ids = n.argIds.slice()
            let changed = false
            for (let i = n.op === 'apply' ? 1 : 0; i < ids.length; i++) {
                const next = remapCaptures(ids[i], env, memo)
                if (next !== ids[i]) { ids[i] = next; changed = true }
            }
            if (!changed) return id
            const copy = addNode(n.op, ids, n.argConsts.slice(), n)
            memo.set(id, copy)
            return copy
        }

        const continuations: GraphBlock[] = []
        for (const e of terminals) {
            const env = environment()
            const result = continuationResults.get(e[0])!
            const params = fieldsOf.get(e[0])!
            const tokenAt = terminalTokens.get(e[0])
            const continuation: GraphBlock = {
                id: continuationOf.get(e[0])!,
                params: tokenAt !== undefined
                    ? [...params.slice(0, tokenAt), ...params.slice(tokenAt + 1), ...env, params[tokenAt]]
                    : [...params, ...env],
                bodyId: remapCaptures(result[0], env), bodyConst: result[1],
                consumesEffectToken: tokenAt !== undefined,
            }
            const localMap = new Map<number, number>()
            let captureAt = 0
            for (const originalId of captureOf.keys()) localMap.set(originalId, env[captureAt++])
            localOf.set(continuation.id, localMap)
            continuations.push(continuation)
        }

        const clonedBlocks = new Map<number, number>()
        const clonedParams = new Map<number, number>()
        const clonedEnv = new Map<number, number[]>()
        for (const blockId of region) {
            const source = blockOf.get(blockId)!
            const id = fresh()
            clonedBlocks.set(blockId, id)
            nodes.set(id, {
                op: 'block', argIds: [], argConsts: new Float64Array(0),
                T: Types.u64, U: Types.u64,
            })
            const localMap = new Map<number, number>()
            for (const param of source.params) {
                const local = addParam()
                clonedParams.set(param, local)
                localMap.set(param, local)
            }
            const env = environment()
            clonedEnv.set(blockId, env)
            let captureAt = 0
            for (const originalId of captureOf.keys()) localMap.set(originalId, env[captureAt++])
            localOf.set(id, localMap)
        }

        let cloneOwn = new Set<number>()
        function cloneValue(id: number, memo: Map<number, number>, env: number[]): number {
            if (!id) return 0
            if (regionParams.has(id) && !cloneOwn.has(id)) {
                const arg = entryArgument(id)
                if (arg) {
                    const captured = capture(arg)
                    const index = captureIndex.get(captured)
                    return index === undefined ? captured : env[index]
                }
            }
            const param = clonedParams.get(id)
            if (param !== undefined) return param
            const ci = captureIndex.get(id)
            if (ci !== undefined) return env[ci]
            const prev = memo.get(id)
            if (prev !== undefined) return prev
            if (isParam(nodes, id)) {
                const captured = capture(id)
                const index = captureIndex.get(captured)
                return index === undefined ? captured : env[index]
            }
            const n = nodes.get(id)!
            if (n.op === 'state') {
                const ids: number[] = [continuationOf.get(n.label!)!]
                const constants = new Float64Array(n.argIds.length + 1)
                for (let i = 0; i < n.argIds.length; i++) {
                    ids.push(cloneValue(n.argIds[i], memo, env))
                    constants[i + 1] = n.argConsts[i]
                }
                const tokenAt = terminalTokens.get(n.label!)
                if (tokenAt !== undefined && tokenAt !== n.argIds.length - 1) {
                    const id = ids.splice(tokenAt + 1, 1)[0]
                    ids.push(id)
                    const reordered = new Float64Array(constants.length)
                    let out = 0
                    for (let i = 0; i < constants.length; i++) {
                        if (i === tokenAt + 1) continue
                        reordered[out++] = constants[i]
                    }
                    reordered[out] = constants[tokenAt + 1]
                    constants.set(reordered)
                }
                const args = addEnvironment(ids, constants, env, tokenAt !== undefined)
                return addNode('apply', args[0], args[1])
            }
            const ids = n.argIds.slice()
            let constants = n.argConsts.slice()
            if (n.op === 'apply') {
                const internal = region.has(ids[0])
                const target = blockOf.get(ids[0])
                ids[0] = clonedBlocks.get(ids[0]) ?? ids[0]
                for (let i = 1; i < n.argIds.length; i++) ids[i] = cloneValue(ids[i], memo, env)
                if (internal) {
                    const args = addEnvironment(ids, constants, env, target?.consumesEffectToken ?? false)
                    ids.splice(0, ids.length, ...args[0])
                    constants = args[1]
                }
            } else {
                for (let i = 0; i < ids.length; i++) ids[i] = cloneValue(ids[i], memo, env)
            }
            const copy = addNode(n.op, ids, constants, n)
            memo.set(id, copy)
            return copy
        }

        for (const blockId of region) {
            const source = blockOf.get(blockId)!
            const env = clonedEnv.get(blockId)!
            const params = source.params.map(p => clonedParams.get(p)!)
            cloneOwn = new Set<number>(source.params)
            const cloned: GraphBlock = {
                id: clonedBlocks.get(blockId)!,
                params: source.consumesEffectToken
                    ? [...params.slice(0, -1), ...env, params[params.length - 1]]
                    : [...params, ...env],
                inputs: source.inputs?.slice(),
                slots: source.slots?.slice(),
                bodyId: cloneValue(source.bodyId, new Map<number, number>(), env),
                bodyConst: source.bodyConst,
                consumesEffectToken: source.consumesEffectToken,
            }
            blocks.push(cloned)
            blockOf.set(cloned.id, cloned)
        }
        for (const continuation of continuations) {
            blocks.push(continuation)
            blockOf.set(continuation.id, continuation)
        }

        const args = [clonedBlocks.get(target)!, ...call.argIds.slice(1)]
        const constants = call.argConsts.slice()
        const applied = addEnvironment(args, constants, captures, targetBlock.consumesEffectToken ?? false)
        return addNode('apply', applied[0], applied[1])
    }

    function reachableBlocks(): GraphBlock[] {
        const reachable = new Set<number>()
        const seenValues = new Set<number>()
        const pending: number[] = [blocks[0].id]
        while (pending.length) {
            const id = pending.pop()!
            if (reachable.has(id)) continue
            const block = blockOf.get(id)
            if (!block) continue
            reachable.add(id)
            const values = [block.bodyId]
            while (values.length) {
                const value = values.pop()!
                if (!value || seenValues.has(value)) continue
                seenValues.add(value)
                const n = nodes.get(value)
                if (!n) continue
                if (n.op === 'apply') {
                    pending.push(n.argIds[0])
                    for (let i = 1; i < n.argIds.length; i++) values.push(n.argIds[i])
                    continue
                }
                for (const arg of n.argIds) values.push(arg)
            }
        }
        return blocks.filter(b => reachable.has(b.id))
    }
}

function specializeBlockApplications(g: Graph): Graph {
    const applications = new Map<number, number>()
    for (const n of g.nodes.values()) {
        if (n.op === 'apply') applications.set(n.argIds[0], (applications.get(n.argIds[0]) ?? 0) + 1)
    }
    const candidates = new Map<number, GraphBlock>()
    for (const b of g.blocks) {
        if (g.nodes.get(b.bodyId)?.op === 'apply') candidates.set(b.id, b)
    }
    const pure = pureValues(g)
    const nodes = new Map(g.nodes)
    let nextId = g.maxId
    type Value = { id: number, value: number }
    const interned = new Map<string, number>()
    function key(n: GraphNode): string {
        return [n.op, n.label ?? '', n.T, n.U, ...(n.types ?? []),
            ...n.argIds.map((id, i) => id ? `v${id}` : `c${Object.is(n.argConsts[i], -0) ? '-0' : n.argConsts[i]}`)].join(',')
    }
    for (const [id, n] of nodes) if (n.op !== 'param' && n.op !== 'block') interned.set(key(n), id)
    function intern(n: GraphNode): Value {
        const k = key(n)
        let id = interned.get(k)
        if (id === undefined) {
            id = nextId++
            nodes.set(id, n)
            interned.set(k, id)
        }
        return { id, value: 0 }
    }
    const active = new Set<number>()
    function rewrite(id: number, value: number, env: Map<number, Value>, memo: Map<number, Value>): Value {
        if (!id) return { id, value }
        const replacement = env.get(id) ?? memo.get(id)
        if (replacement) return replacement
        const n = nodes.get(id)
        if (!n || n.op === 'param' || n.op === 'block') return { id, value: 0 }
        const args = n.argIds.map((a, i) => rewrite(a, n.argConsts[i], env, memo))
        let result: Value | undefined
        const block = n.op === 'apply' ? candidates.get(n.argIds[0]) : undefined
        if (block && !active.has(block.id) && (nodes.get(block.bodyId)?.op === 'apply'
            || applications.get(block.id) === 1 || args.slice(1).some(arg => !arg.id))) {
            const bindings = new Map(env)
            for (let i = 0; i < block.params.length; i++) bindings.set(block.params[i], args[i + 1])
            active.add(block.id)
            result = rewrite(block.bodyId, block.bodyConst, bindings, new Map())
            active.delete(block.id)
        } else if (n.op === 'select') {
            if (!args[0].id) result = args[0].value ? args[1] : args[2]
            else if (args[1].id === args[2].id && (args[1].id || Object.is(args[1].value, args[2].value))) {
                result = pure.has(args[0].id) ? args[1] : intern({ ...n, op: 'after', label: undefined,
                    argIds: [args[0].id, args[1].id], argConsts: new Float64Array([0, args[1].value]) })
            }
        } else if (n.op === 'after') {
            if (!args[0].id || nodes.get(args[0].id)?.op === 'nil-effect' || args[0].id === args[1].id) result = args[1]
        } else if (args.length === 2 && args.every(arg => !arg.id)
            && Number.isSafeInteger(args[0].value) && Number.isSafeInteger(args[1].value)
            && args[0].value >= 0 && args[1].value >= 0) {
            const a = args[0].value, b = args[1].value
            let folded: number | undefined
            if (n.op === 'add') folded = a + b
            else if (n.op === 'sub' && a >= b) folded = a - b
            else if (n.op === 'mul') folded = a * b
            else if (n.op === 'lt') folded = a < b ? 1 : 0
            else if (n.op === 'le') folded = a <= b ? 1 : 0
            else if (n.op === 'gt') folded = a > b ? 1 : 0
            else if (n.op === 'ge') folded = a >= b ? 1 : 0
            else if (n.op === 'eq') folded = a === b ? 1 : 0
            else if (n.op === 'ne') folded = a !== b ? 1 : 0
            if (folded !== undefined && Number.isSafeInteger(folded)
                && (n.T === Types.u64 || n.T === Types.u32) && n.U === n.T
                && (n.T !== Types.u32 || (a <= 0xFFFFFFFF && b <= 0xFFFFFFFF && folded <= 0xFFFFFFFF))) {
                result = { id: 0, value: folded }
            }
        }
        if (!result && args.length === 2 && n.T <= Types.i64 && n.U <= Types.i64) {
            const left = (value: number) => !args[0].id && args[0].value === value
            const right = (value: number) => !args[1].id && args[1].value === value
            if (n.op === 'add' || n.op === 'or' || n.op === 'xor') {
                if (right(0)) result = args[0]
                else if (left(0)) result = args[1]
            } else if (n.op === 'sub' || n.op === 'shl' || n.op === 'shr' || n.op === 'ushr') {
                if (right(0)) result = args[0]
            } else if (n.op === 'mul') {
                if (right(1)) result = args[0]
                else if (left(1)) result = args[1]
            } else if (n.op === 'div' && right(1)) result = args[0]
        }
        if (!result) {
            result = intern({ ...n, argIds: args.map(a => a.id), argConsts: new Float64Array(args.map(a => a.value)) })
        }
        memo.set(id, result)
        return result
    }
    const memo = new Map<number, Value>()
    const env = new Map<number, Value>()
    const blocks = g.blocks.map(b => {
        active.add(b.id)
        const body = rewrite(b.bodyId, b.bodyConst, env, memo)
        active.delete(b.id)
        return { ...b, bodyId: body.id, bodyConst: body.value }
    })
    const blockOf = new Map(blocks.map(b => [b.id, b]))
    const reachable = new Set<number>()
    const liveNodes = new Map<number, GraphNode>()
    function visit(id: number): void {
        if (!id || liveNodes.has(id)) return
        const n = nodes.get(id)
        if (!n) return
        liveNodes.set(id, n)
        if (n.op === 'apply') visitBlock(n.argIds[0])
        for (const arg of n.argIds) visit(arg)
    }
    function visitBlock(id: number): void {
        if (reachable.has(id)) return
        reachable.add(id)
        const b = blockOf.get(id)!
        for (const param of b.params) visit(param)
        visit(b.bodyId)
    }
    visitBlock(0)
    return { ...g, maxId: nextId, nodes: liveNodes, blocks: blocks.filter(b => reachable.has(b.id)) }
}
