/// @synth
"use wrapped";

import * as gn from './graph-node'
import * as heap from './heap'
import * as intrinsics from './intrinsics'
import * as lowering from './lowering'
import { solvePlacements } from './placement-flow'
import { flattenRecords } from './records'
import * as rt from './rt'
import { verifyGraph, verifyMemoryOrder, verifyOrderingSlots, verifyTailEffects, verifyTokenSelects } from './verify'
import {
    addGraphBlock, blockOrder, clearOperands, cloneRefs, copyNode, countIds, countLiterals,
    createRecordType, getArgConsts, getArgIds, getBlock, getDebugLabel, getLiteral,
    getOperand, getOperands, getRef, makeNode, type Operand, operandType, pushRefs, setDebugLabel, setGraphBlocks, setLiteral,
    recordFields, resultType, setOperand, setRef, setType, typeOf, typeRefOf, typeSlots, withRefs,
    insertNode, newId,
    NodeOp,
    opName,
    getNode, hasNode, deleteNode, setNode,
    addCopy, addNode, putNode, putCopy,
    withOperand,
    retypeNode, type TypeOperand, isNullishValue, sameSlotBits, nodeUsers,
    type NodeSpace,
    armOrBodySlot, orderRegions, childRegion, type RegionTree,
} from './graph-node'

const Types = intrinsics.Types
const assert = intrinsics.assert
type Types = (typeof Types)[keyof typeof Types]

export interface GraphNode {
    op: gn.NodeOp
    slots: Uint32Array
    flags: u8
    scratchFlags: u8
    epoch: number
}

export interface GraphBlock {
    id: number
    params: number[]
    bodyId: number
    bodyConst: number
}

export type GraphForm = 'packaged' | 'optimized' | 'lowerable'

export interface Graph {
    form?: GraphForm
    ids: intrinsics.IdSpace
    nodes: Map<number, GraphNode>
    literals: gn.LiteralPool
    blocks: GraphBlock[]
    root: number
    blockIndex: Map<number, GraphBlock>
    epoch: number
    debugLabels: Map<number, string>
    name?: string
    level?: number
    unswitch?: number
    facts?: Map<number, GraphNode>
}

const FactOps = new Set([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.convert, NodeOp.load, NodeOp.literal])

export function captureFact(g: Graph, id: number, depth = 0): number {
    if (!id || g.facts?.has(id)) return id
    const n = getNode(g, id)
    if (!n || depth > 6 || !FactOps.has(n.op)) return id
    const ops: Operand[] = []
    for (let i = 0; i < countIds(n); i++) {
        if (n.op === NodeOp.load && i === 0) { ops.push({ literal: 0 }); continue }
        const r = getRef(n, i)
        ops.push(r ? captureFact(g, r, depth + 1) : { literal: getLiteral(g, n, i) })
    }
    const fid = newId(g)
    g.facts ??= new Map()
    g.facts.set(fid, makeNode(g, n.op, ops, typeOf(n)))
    return fid
}

export function substituteFact(g: Graph, id: number, leaf: (x: number) => number | undefined): number {
    const f = g.facts?.get(id)
    if (!f) return leaf(id) ?? id
    let changed = false
    const ops = getOperands(g, f).map(o => {
        if (typeof o !== 'number' || !o) return o
        const next = substituteFact(g, o, leaf)
        if (next !== o) changed = true
        return next
    })
    if (!changed) return id
    const fid = newId(g)
    g.facts!.set(fid, makeNode(g, f.op, ops, typeOf(f)))
    return fid
}

export function importFact(dst: Graph, src: Graph, id: number, leaf: (x: number) => number): number {
    const f = src.facts?.get(id)
    if (!f) return hasNode(src, id) ? leaf(id) : 0
    const ops = getOperands(dst, f).map(o => typeof o === 'number' && o ? importFact(dst, src, o, leaf) : o)
    if (ops.some(o => o === 0)) return 0
    const fid = newId(dst)
    dst.facts ??= new Map()
    dst.facts.set(fid, makeNode(dst, f.op, ops, typeOf(f)))
    return fid
}

export function rewriteFactNodes(g: Graph, replace: (f: GraphNode) => number | undefined): void {
    if (!g.facts?.size) return
    const memo = new Map<number, number>()
    function walk(id: number): number {
        const f = g.facts!.get(id)
        if (!f) return id
        const known = memo.get(id)
        if (known !== undefined) return known
        memo.set(id, id)
        const direct = replace(f)
        if (direct !== undefined) { memo.set(id, direct); return direct }
        let changed = false
        const ops = getOperands(g, f).map(o => {
            if (typeof o !== 'number' || !o) return o
            const next = walk(o)
            if (next !== o) changed = true
            return next
        })
        if (!changed) return id
        const fid = newId(g)
        g.facts!.set(fid, makeNode(g, f.op, ops, typeOf(f)))
        memo.set(id, fid)
        return fid
    }
    for (const n of g.nodes.values()) {
        const fact = gn.factOf(n)
        if (!fact || !g.facts.has(fact)) continue
        const next = walk(fact)
        if (next !== fact) gn.setFact(n, next)
    }
}

function factMentions(g: Graph, id: number, target: number): boolean {
    if (id === target) return true
    const f = g.facts?.get(id)
    if (!f) return false
    for (const x of getArgIds(f)) if (x && factMentions(g, x, target)) return true
    return false
}

export function isParam(nodes: Map<number, GraphNode>, id: number): boolean {
    return !!nodes.get(id) && nodes.get(id)!.op === NodeOp.param
}

function nextEpoch(g: Graph): number {
    return ++g.epoch
}

function markVisited(n: GraphNode, epoch: number): boolean {
    if (n.epoch === epoch) return false
    assert(n.epoch < epoch, 'markVisited: epoch went backwards')
    n.epoch = epoch
    return true
}

function hasStructuredTail(g: Graph, id: number): boolean {
    while (id) {
        const n = getNode(g, id)
        if (!n) return false
        if (n.op !== NodeOp.after) {
            return n.op === NodeOp.select || n.op === NodeOp.apply || n.op === NodeOp.panic
                || n.op === NodeOp.trap || n.op === NodeOp.ret || n.op === NodeOp.unreachable
        }
        id = getRef(n, countIds(n) - 1)
    }
    return false
}

export function tailOf(g: Graph, id: number): number {
    let n = getNode(g, id)
    while (n?.op === NodeOp.after) {
        id = getRef(n, countIds(n) - 1)
        n = getNode(g, id)
    }
    return id
}

export function tailScalar(g: Graph, n: GraphNode, at: number): number | undefined {
    for (let m = getNode(g, getRef(n, at)); m?.op === NodeOp.after; m = getNode(g, getRef(n, at))) {
        n = m
        at = countIds(m) - 1
    }
    return scalarOperand(g, g.nodes, n, at)
}

export type SelectPath = [select: number, arm: number][]
export interface TailPosition { at: number, tokens: number[], path: SelectPath }

export function tailPositions(g: Graph, bodyId: number): TailPosition[] {
    const out: TailPosition[] = []
    mapTailPositions(g, bodyId, p => {
        out.push(p)
        return p.at
    })
    return out
}

export function mapTailPositions(g: Graph, bodyId: number, leaf: (p: TailPosition) => number): number {
    function walk(id: number, tokens: number[], path: SelectPath): number {
        const n = getNode(g, id)
        if (!n) return id
        let ids: number[] | undefined
        if (n.op === NodeOp.after) {
            const last = countIds(n) - 1
            const next = tokens.slice()
            for (let i = 0; i < last; i++) {
                const op = getNode(g, getRef(n, i))?.op
                if (op && op !== NodeOp.nilEffect && op !== NodeOp.void) next.push(getRef(n, i))
            }
            const inner = walk(getRef(n, last), next, path)
            if (inner === getRef(n, last)) return id
            ids = cloneRefs(n)
            ids[last] = inner
        } else if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) {
                const arm = walk(getRef(n, i), tokens, [...path, [id, i]])
                if (arm === getRef(n, i)) continue
                ids ??= cloneRefs(n)
                ids[i] = arm
            }
            if (!ids) return id
        } else return leaf({ at: id, tokens, path })
        return addCopy(g, n, withRefs(g, n, ids))
    }
    return walk(bodyId, [], [])
}

export function tailRoots(g: Graph, p: TailPosition): number[] {
    const roots = p.tokens.slice()
    for (const [select] of p.path) roots.push(getRef(getNode(g, select)!, 0))
    roots.push(...getArgIds(getNode(g, p.at)!))
    return roots
}

type Facts = [cond: number, truth: boolean][]

function pathFacts(g: Graph, path: SelectPath): Facts {
    const facts: Facts = []
    for (const [select, arm] of path) {
        const n = getNode(g, select)!
        if (countIds(n) === 3 && getRef(n, 0)) facts.push([getRef(n, 0), arm === 1])
    }
    return facts
}

interface Relation {
    a: number
    b: number
    bk: number
    mask: number
    signed: boolean
}

const RelationMasks: Record<number, number> = {
    [NodeOp.lt]: 1, [NodeOp.eq]: 2, [NodeOp.le]: 3, [NodeOp.gt]: 4, [NodeOp.ne]: 5, [NodeOp.ge]: 6,
}

function swappedMask(mask: number): number {
    return (mask & 2) | ((mask & 1) << 2) | ((mask & 4) >> 2)
}

function ordering(mask: number): boolean {
    return mask !== 2 && mask !== 5
}

function relationOf(g: Graph, cond: number, truth: boolean): Relation | undefined {
    const n = getNode(g, cond)
    if (!n) return
    if (!CompareOps.has(n.op)) {
        if (n.op === NodeOp.literal || typeOf(n) === Types.f64) return
        return { a: cond, b: 0, bk: 0, mask: truth ? 5 : 2, signed: false }
    }
    return comparisonRelation(g, n, truth)
}

function comparisonRelation(g: Graph, n: GraphNode, truth: boolean): Relation | undefined {
    if (countIds(n) !== 2 || comparesFloats(g, n)) return
    let a = getRef(n, 0)
    let b = getRef(n, 1)
    let ak = a ? 0 : getLiteral(g, n, 0)
    let bk = b ? 0 : getLiteral(g, n, 1)
    if (a && getNode(g, a)?.op === NodeOp.literal) {
        ak = literalValue(g, getNode(g, a)!)
        a = 0
    }
    if (b && getNode(g, b)?.op === NodeOp.literal) {
        bk = literalValue(g, getNode(g, b)!)
        b = 0
    }
    let mask = RelationMasks[n.op]
    if (!truth) mask = 7 & ~mask
    const signed = lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))
    if (!a && !b) return
    if (!a || (b && b < a)) {
        const t = a
        a = b
        b = t
        bk = ak
        mask = swappedMask(mask)
    }
    if (!Number.isSafeInteger(bk)) return
    return { a, b, bk, mask, signed }
}

function successor(g: Graph, id: number): number {
    const n = getNode(g, id)
    if (n?.op !== NodeOp.add || countIds(n) !== 2) return 0
    for (let i = 0; i < 2; i++) {
        if (!getRef(n, i) && getLiteral(g, n, i) === 1 && getRef(n, 1 - i)) return getRef(n, 1 - i)
        const m = getRef(n, i) ? getNode(g, getRef(n, i)) : undefined
        if (m?.op === NodeOp.literal && literalValue(g, m) === 1 && getRef(n, 1 - i)) return getRef(n, 1 - i)
    }
    return 0
}

function below(r: Relation, x: number, y: number): boolean {
    if (r.a === x && r.b === y) return r.mask === 1
    if (r.a === y && r.b === x) return r.mask === 4
    return false
}

function decideByFacts(g: Graph, facts: Facts, cond: number): boolean | undefined {
    for (const [f, truth] of facts) if (f === cond) return truth
    const c = relationOf(g, cond, true)
    if (!c) return
    return decideRelation(g, facts, c)
}

function decideRelation(g: Graph, facts: Facts, c: Relation): boolean | undefined {
    let mask = 7
    let lo = c.signed ? -Infinity : 0
    let hi = Infinity
    const left = c.b ? successor(g, c.a) : 0
    const right = c.b ? successor(g, c.b) : 0
    for (const [f, truth] of facts) {
        const r = relationOf(g, f, truth)
        if (!r) continue
        if (r.b && r.signed === c.signed && (left || right)) {
            if (left && below(r, left, c.b)) {
                mask &= 3
                continue
            }
            if (right && below(r, right, c.a)) {
                mask &= 6
                continue
            }
        }
        if (r.a !== c.a || r.b !== c.b) continue
        if ((ordering(r.mask) || ordering(c.mask)) && r.signed !== c.signed) continue
        if (c.b || r.bk === c.bk) {
            mask &= r.mask
            continue
        }
        if (r.signed !== c.signed || (!c.signed && r.bk < 0)) continue
        const k = r.bk
        if (r.mask === 1) hi = Math.min(hi, k - 1)
        else if (r.mask === 3) hi = Math.min(hi, k)
        else if (r.mask === 4) lo = Math.max(lo, k + 1)
        else if (r.mask === 6) lo = Math.max(lo, k)
        else if (r.mask === 2) {
            lo = Math.max(lo, k)
            hi = Math.min(hi, k)
        } else if (r.mask === 5 && k === 0 && !c.signed) lo = Math.max(lo, 1)
    }
    if (!c.b && (c.signed || c.bk >= 0)) {
        const k = c.bk
        let range = 0
        if (lo < k) range |= 1
        if (lo <= k && hi >= k) range |= 2
        if (hi > k) range |= 4
        mask &= range
    }
    if (mask === 7) return
    if ((mask & c.mask) === mask) return true
    if (!(mask & c.mask)) return false
    return
}

function nodeFacts(g: Graph, bodyId: number): Map<number, Facts> {
    const order: number[] = []
    const seen = new Set<number>([bodyId])
    const stack: number[] = [bodyId]
    const next: number[] = [0]
    while (stack.length) {
        const id = stack[stack.length - 1]
        const n = getNode(g, id)
        const at = next[next.length - 1]
        if (n && at < countIds(n)) {
            next[next.length - 1] = at + 1
            const ref = getRef(n, at)
            const m = ref ? getNode(g, ref) : undefined
            if (!m || m.op === NodeOp.block || seen.has(ref)) continue
            seen.add(ref)
            stack.push(ref)
            next.push(0)
            continue
        }
        stack.pop()
        next.pop()
        order.push(id)
    }
    const out = new Map<number, Facts>()
    out.set(bodyId, [])
    for (let k = order.length - 1; k >= 0; k--) {
        const id = order[k]
        const n = getNode(g, id)!
        const facts = out.get(id)
        if (!facts) continue
        const arms = n.op === NodeOp.select && countIds(n) === 3 && getRef(n, 0)
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref || !seen.has(ref)) continue
            const given = arms && i > 0 ? [...facts, [getRef(n, 0), i === 1] as [number, boolean]] : facts
            const known = out.get(ref)
            if (!known) {
                out.set(ref, given)
                continue
            }
            if (known === given || !known.length) continue
            const common = known.filter(([c, t]) => given.some(([d, u]) => d === c && u === t))
            if (common.length !== known.length) out.set(ref, common)
        }
    }
    return out
}

function comparisons(g: Graph, facts: Facts, ref: number): [k: number, equal: boolean][] {
    const out: [number, boolean][] = []
    for (const [cond, truth] of facts) {
        if (cond === ref) {
            out.push([0, !truth])
            continue
        }
        const c = getNode(g, cond)
        if (!c || (c.op !== NodeOp.eq && c.op !== NodeOp.ne)) continue
        const k = getRef(c, 0) === ref ? scalarOperand(g, g.nodes, c, 1) : getRef(c, 1) === ref ? scalarOperand(g, g.nodes, c, 0) : undefined
        if (k !== undefined) out.push([k, (c.op === NodeOp.eq) === truth])
    }
    return out
}

function unsignedBits(T: Types): number | undefined {
    if (T === Types.bool) return 1
    if (lowering.isSignedType(T) || T === Types.f16 || T === Types.f32 || T === Types.f64) return
    const bits = intrinsics.intrinsicBitWidth(T)
    return bits && bits < 64 ? bits : undefined
}

function lowZeros(g: Graph, ref: number, literal: number, param?: (p: number) => number): number {
    if (!ref) {
        if (!Number.isSafeInteger(literal)) return 0
        if (literal === 0) return 64
        let zeros = 0
        for (let v = Math.abs(literal); v % 2 === 0; v /= 2) zeros++
        return zeros
    }
    const n = getNode(g, ref)
    if (!n) return 0
    const a = () => lowZeros(g, getRef(n, 0), getLiteral(g, n, 0), param)
    const b = () => lowZeros(g, getRef(n, 1), getLiteral(g, n, 1), param)
    if (n.op === NodeOp.literal) return lowZeros(g, 0, getLiteral(g, n, 0))
    if (n.op === NodeOp.param) return param ? param(ref) : 0
    if (n.op === NodeOp.convert) return a()
    if (n.op === NodeOp.after) return lowZeros(g, getRef(n, countIds(n) - 1), getLiteral(g, n, countIds(n) - 1), param)
    if (n.op === NodeOp.select) {
        let zeros = 64
        for (let i = 1; i < countIds(n); i++) zeros = Math.min(zeros, lowZeros(g, getRef(n, i), getLiteral(g, n, i), param))
        return zeros
    }
    if (n.op === NodeOp.shl && !getRef(n, 1)) return Math.min(64, a() + getLiteral(g, n, 1))
    if (n.op === NodeOp.mul) return Math.min(64, a() + b())
    if (n.op === NodeOp.and) return Math.max(a(), b())
    if (n.op === NodeOp.add || n.op === NodeOp.sub || n.op === NodeOp.or || n.op === NodeOp.xor) return Math.min(a(), b())
    return 0
}

function highBits(g: Graph, ref: number, literal: number): number | undefined {
    if (!ref) return Number.isSafeInteger(literal) && literal >= 0 ? Math.ceil(Math.log2(literal + 1)) : undefined
    const n = getNode(g, ref)
    if (!n) return
    if (n.op === NodeOp.literal) return highBits(g, 0, getLiteral(g, n, 0))
    if (n.op === NodeOp.load || n.op === NodeOp.convert) return unsignedBits(typeOf(n))
    if (n.op === NodeOp.and) {
        const a = highBits(g, getRef(n, 0), getLiteral(g, n, 0))
        const b = highBits(g, getRef(n, 1), getLiteral(g, n, 1))
        return a === undefined ? b : b === undefined ? a : Math.min(a, b)
    }
    if (n.op === NodeOp.ushr && !getRef(n, 1)) {
        const a = highBits(g, getRef(n, 0), getLiteral(g, n, 0))
        return a === undefined ? undefined : Math.max(0, a - getLiteral(g, n, 1))
    }
}

function nonZero(g: Graph, ref: number, literal: number, facts: Facts): boolean {
    if (!ref) return literal !== 0
    const n = getNode(g, ref)
    if (!n) return false
    if (n.op === NodeOp.literal) return getLiteral(g, n, 0) !== 0
    if (n.op === NodeOp.pstack || n.op === NodeOp.alloca || n.op === NodeOp.frameAddress) return true
    if (n.op === NodeOp.call && callSummary(g, n)?.fresh) return true
    if (n.op === NodeOp.after) return nonZero(g, getRef(n, countIds(n) - 1), getLiteral(g, n, countIds(n) - 1), facts)
    if (comparisons(g, facts, ref).some(([k, equal]) => k === 0 && !equal)) return true
    if (n.op === NodeOp.or) return nonZero(g, getRef(n, 0), getLiteral(g, n, 0), facts) || nonZero(g, getRef(n, 1), getLiteral(g, n, 1), facts)
    if (n.op === NodeOp.add) {
        for (const [x, y] of [[0, 1], [1, 0]]) {
            const bits = highBits(g, getRef(n, y), getLiteral(g, n, y))
            if (bits !== undefined && lowZeros(g, getRef(n, x), getLiteral(g, n, x)) >= bits && nonZero(g, getRef(n, y), getLiteral(g, n, y), facts)) return true
        }
    }
    return false
}

function definedWord(g: Graph, ref: number, literal: number): boolean {
    if (!ref) return literal !== heap.undefinedWord
    const n = getNode(g, ref)
    if (!n) return false
    if (n.op === NodeOp.literal) return getLiteral(g, n, 0) !== heap.undefinedWord
    if (n.op === NodeOp.call && callSummary(g, n)?.fresh) return true
    if (n.op === NodeOp.after) return definedWord(g, getRef(n, countIds(n) - 1), getLiteral(g, n, countIds(n) - 1))
    if (n.op === NodeOp.encode) return nonZero(g, getRef(n, 0), getLiteral(g, n, 0), [])
    if (n.op !== NodeOp.or) return false
    for (const at of [0, 1]) {
        if (!getRef(n, at) && (getLiteral(g, n, at) & ~heap.undefinedWord) !== 0) return true
    }
    return false
}

export function stronglyConnected(roots: Iterable<number>, edges: (v: number) => number[]): number[][] {
    const index = new Map<number, number>()
    const low = new Map<number, number>()
    const stack: number[] = []
    const onStack = new Set<number>()
    const frames: { v: number, next: number[], at: number }[] = []
    const out: number[][] = []
    function enter(v: number): void {
        index.set(v, index.size)
        low.set(v, index.get(v)!)
        stack.push(v)
        onStack.add(v)
        frames.push({ v, next: edges(v), at: 0 })
    }
    for (const root of roots) {
        if (index.has(root)) continue
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.next.length) {
                const w = frame.next[frame.at++]
                if (!index.has(w)) enter(w)
                else if (onStack.has(w)) low.set(frame.v, Math.min(low.get(frame.v)!, index.get(w)!))
                continue
            }
            frames.pop()
            if (frames.length) {
                const parent = frames[frames.length - 1].v
                low.set(parent, Math.min(low.get(parent)!, low.get(frame.v)!))
            }
            if (low.get(frame.v) !== index.get(frame.v)) continue
            const scc: number[] = []
            for (;;) {
                const w = stack.pop()!
                onStack.delete(w)
                scc.push(w)
                if (w === frame.v) break
            }
            out.push(scc)
        }
    }
    return out
}

export interface GraphLoops {
    tailTargets: Map<number, number[]>
    preds: Map<number, number[]>
    loopsOf: Map<number, number[]>
    loopMembers: Map<number, Set<number>>
    loopDepth: Map<number, number>
}

export function graphLoops(g: Graph): GraphLoops {
    const tailTargets = new Map<number, number[]>()
    function collectTargets(id: number, into: number[]): void {
        const n = getNode(g, tailOf(g, id))
        if (n?.op === NodeOp.apply) into.push(getRef(n, 0))
        else if (n?.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) collectTargets(getRef(n, i), into)
    }
    const preds = new Map<number, number[]>()
    for (const b of g.blocks) {
        const into: number[] = []
        collectTargets(b.bodyId, into)
        tailTargets.set(b.id, into)
        preds.set(b.id, [])
    }
    for (const [id, targets] of tailTargets) for (const t of new Set(targets)) preds.get(t)!.push(id)
    const loopsOf = new Map<number, number[]>()
    const loopMembers = new Map<number, Set<number>>()
    for (const b of g.blocks) loopsOf.set(b.id, [])
    function findLoops(root: number, within?: Set<number>, header = 0): void {
        const index = new Map<number, number>()
        const low = new Map<number, number>()
        const open: number[] = []
        function connect(v: number): void {
            index.set(v, index.size)
            low.set(v, index.get(v)!)
            open.push(v)
            for (const w of tailTargets.get(v)!) {
                if (w === header || (within && !within.has(w))) continue
                if (!index.has(w)) {
                    connect(w)
                    low.set(v, Math.min(low.get(v)!, low.get(w)!))
                } else if (open.includes(w)) {
                    low.set(v, Math.min(low.get(v)!, index.get(w)!))
                }
            }
            if (low.get(v) !== index.get(v)) return
            const members = new Set(open.splice(open.lastIndexOf(v)))
            if (members.size === 1 && (v === header || !tailTargets.get(v)!.includes(v))) return
            for (const m of members) loopsOf.get(m)!.push(v)
            loopMembers.set(v, members)
            findLoops(v, members, v)
        }
        connect(root)
    }
    findLoops(g.root)
    const loopDepth = new Map<number, number>()
    for (const [k, v] of loopsOf) loopDepth.set(k, v.length)
    return { tailTargets, preds, loopsOf, loopMembers, loopDepth }
}

export interface HotCold {
    targets: Map<number, Map<number, number>>
    arrivals: Map<number, number>
    hotArm: Map<number, number>
}

type End = 'doomed' | 'zero' | number | undefined

function joinEnds(a: End | null, b: End | null): End | null {
    if (a === null || a === 'doomed') return b ?? a
    if (b === null || b === 'doomed') return a
    return a === b ? a : undefined
}

export function hotCold(g: Graph, loops: GraphLoops): HotCold {
    const out: HotCold = { targets: new Map(), arrivals: new Map(), hotArm: new Map() }
    const positions = new Map<number, TailPosition[]>()
    for (const b of g.blocks) positions.set(b.id, tailPositions(g, b.bodyId))
    function targetOf(p: TailPosition): number | undefined {
        const n = getNode(g, p.at)!
        return n.op === NodeOp.apply ? getRef(n, 0) : undefined
    }
    const ends = new Map<number, End>()
    function returned(n: GraphNode, at: number, params: number[]): End {
        if (tailScalar(g, n, at) === 0) return 'zero'
        const k = params.indexOf(tailOf(g, getRef(n, at)))
        return k >= 0 ? k : undefined
    }
    function endOf(p: TailPosition, params: number[], internal?: Set<number>): End | null {
        const n = getNode(g, p.at)!
        if (n.op === NodeOp.unreachable || n.op === NodeOp.panic) return 'doomed'
        if (n.op === NodeOp.ret) return returned(n, 0, params)
        if (n.op !== NodeOp.apply) return undefined
        if (internal?.has(getRef(n, 0))) return null
        const end = ends.get(getRef(n, 0))
        return typeof end === 'number' ? returned(n, end + 1, params) : end
    }
    for (const scc of stronglyConnected(g.blocks.map(b => b.id), id => positions.get(id)!.flatMap(p => targetOf(p) ?? []))) {
        const members = new Set(scc)
        const cyclic = scc.length > 1 || positions.get(scc[0])!.some(p => targetOf(p) === scc[0])
        let end: End | null = null
        for (const id of scc) {
            const params = cyclic ? [] : getBlock(g, id)!.params
            for (const p of positions.get(id)!) end = joinEnds(end, endOf(p, params, members))
        }
        for (const id of scc) ends.set(id, end ?? undefined)
    }
    function coldCompare(cond: number): number {
        const c = getNode(g, cond)
        if (!c || !CompareOps.has(c.op) || comparesFloats(g, c)) return 0
        for (const [x, k] of [[0, 1], [1, 0]]) {
            const value = scalarOperand(g, g.nodes, c, k)
            if (value === undefined || !getRef(c, x)) continue
            const op = k === 1 ? c.op : SwappedCmp[c.op]
            if (value === 0 || value === -1 || value === 0xffffffff) {
                if (op === NodeOp.eq) return 1
                if (op === NodeOp.ne) return 2
            }
            if (value === 0 && lowering.isSignedType(operandType(g, c, x))) {
                if (op === NodeOp.lt || op === NodeOp.le) return 1
                if (op === NodeOp.gt || op === NodeOp.ge) return 2
            }
        }
        return 0
    }
    for (const b of g.blocks) {
        const headers = loops.loopsOf.get(b.id) ?? []
        const loop = headers.length ? loops.loopMembers.get(headers[headers.length - 1]) : undefined
        const once = g.level === 0 && !headers.length
        const targets = new Map<number, number>()
        function walk(id: number, cold: number): void {
            const at = tailOf(g, id)
            const n = getNode(g, at)
            if (!n) return
            if (n.op === NodeOp.apply) {
                targets.set(getRef(n, 0), Math.min(targets.get(getRef(n, 0)) ?? Infinity, cold))
                out.arrivals.set(at, Math.min(out.arrivals.get(at) ?? Infinity, cold))
                return
            }
            if (n.op !== NodeOp.select) return
            const arms: { end: End | null, stays: boolean }[] = []
            for (let i = 1; i < countIds(n); i++) {
                let end: End | null = null
                let stays = false
                for (const p of tailPositions(g, getRef(n, i))) {
                    end = joinEnds(end, endOf(p, b.params))
                    if (loop?.has(targetOf(p) ?? -1)) stays = true
                }
                arms.push({ end, stays })
            }
            const staying = arms.some(arm => arm.stays)
            const zeroes = arms.filter(arm => arm.end === 'zero').length
            const coldness = arms.map(arm => arm.end === 'doomed' ? Infinity
                : (staying && !arm.stays ? 1 : 0) + (arm.end === 'zero' && zeroes < arms.length ? 1 : 0))
            const compared = arms.length === 2 ? coldCompare(getRef(n, 0)) : 0
            if (compared) coldness[compared - 1]++
            if (once) coldness.fill(0)
            if (arms.length === 2 && coldness[0] !== coldness[1]) out.hotArm.set(at, coldness[0] < coldness[1] ? 1 : 2)
            for (let i = 1; i < countIds(n); i++) walk(getRef(n, i), cold + coldness[i - 1])
        }
        walk(b.bodyId, 0)
        out.targets.set(b.id, targets)
    }
    return out
}

export interface ValueFacts { is?: number, not?: number }

export function valueFacts(g: Graph, path: SelectPath, ref: number): ValueFacts {
    const facts = pathFacts(g, path)
    const known = comparisons(g, facts, ref)
    return {
        is: known.find(([, equal]) => equal)?.[0],
        not: nonZero(g, ref, 0, facts) ? 0 : known.find(([, equal]) => !equal)?.[0],
    }
}

function recordKeys(g: Graph, id: number): number[] | undefined {
    const n = getNode(g, tailOf(g, id))
    if (!n) return
    if (n.op === NodeOp.record) {
        const keys: number[] = []
        for (let i = 0; i < countLiterals(n); i += 2) keys.push(getLiteral(g, n, i))
        return keys
    }
    const type = n.op === NodeOp.param ? getNode(g, typeRefOf(n)) : undefined
    if (type?.op === NodeOp.recordType) return recordFields(g, type).map(field => field.key)
    if (n.op === NodeOp.select) return recordKeys(g, getRef(n, 1))
}

function detachRecordOrdering(g: Graph): Graph {
    const owners = new Map<number, number>()
    for (const b of g.blocks) {
        for (const p of b.params) {
            const u = getNode(g, p)
            if (u && recordKeys(g, p)) owners.set(p, b.id)
        }
    }
    const projections = new Map<number, number>()
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.get || getNode(g, getRef(n, 0))?.op !== NodeOp.call) continue
        if (!projections.has(getRef(n, 0)) || getLiteral(g, n, 1) === 0) projections.set(getRef(n, 0), id)
    }
    if (!owners.size && !projections.size) return g
    const nils = new Map<number, number>()
    function detach(n: GraphNode, i: number) {
        const projection = projections.get(getRef(n, i))
        if (projection !== undefined) {
            setRef(n, i, projection)
            return
        }
        const owner = owners.get(getRef(n, i))
        if (owner === undefined) return
        let nil = nils.get(owner)
        if (!nil) nils.set(owner, nil = createNode(g, NodeOp.nilEffect, [owner]))
        setRef(n, i, nil)
    }
    for (const n of [...g.nodes.values()]) {
        if (n.op === NodeOp.after) {
            for (let i = 0; i < countIds(n) - 1; i++) detach(n, i)
        } else if (OrderedValues.has(n.op)) {
            detach(n, 0)
        }
    }
    return g
}

const BinaryOps = new Set<NodeOp>([
    NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.subsat,
])
const CompareOps = new Set<NodeOp>([NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne])
const InverseCompare = new Map<NodeOp, NodeOp>([
    [NodeOp.eq, NodeOp.ne], [NodeOp.ne, NodeOp.eq], [NodeOp.lt, NodeOp.ge], [NodeOp.ge, NodeOp.lt], [NodeOp.le, NodeOp.gt], [NodeOp.gt, NodeOp.le],
])
const UnaryOps = new Set<NodeOp>([NodeOp.neg, NodeOp.not, NodeOp.clz])
export const NumericOps = new Set<NodeOp>([...BinaryOps, ...CompareOps, ...UnaryOps])

type Range = [lo: number, hi: number]
const RangeLimit = 2 ** 53
const ArrivalShapes = new Set<NodeOp>([NodeOp.param, NodeOp.literal, NodeOp.after, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.ushr, NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.convert, NodeOp.select])

const RangedTypes = new Set<Types>([Types.u8, Types.u16, Types.u32, Types.u64, Types.ptr, Types.i8, Types.i16, Types.i32, Types.i64, Types.bool])

function rangeMax(T: Types): number {
    if (!RangedTypes.has(T)) return Infinity
    if (T === Types.bool) return 1
    const bits = intrinsics.intrinsicBitWidth(T) - (lowering.isSignedType(T) ? 1 : 0)
    return bits < 53 ? 2 ** bits - 1 : Infinity
}

function truncated(T: Types): Range {
    return RangedTypes.has(T) && !lowering.isSignedType(T) ? [0, rangeMax(T)] : [0, Infinity]
}

function rangeOf(T: Types, lo: number, hi: number): Range {
    return hi <= rangeMax(T) && hi < RangeLimit ? [lo, hi] : [0, Infinity]
}

export interface RangeFacts {
    range(ref: number, literal: number, facts: Facts): Range
    le(a: number, ak: number, b: number, bk: number, facts: Facts): boolean
    lt(a: number, ak: number, b: number, bk: number, facts: Facts): boolean
    below(a: number, b: number, bk: number, facts: Facts): boolean
    zeros(ref: number, literal: number): number
}

export function rangeFacts(g: Graph, arrivalsOf: (block: number) => TailPosition[]): RangeFacts {
    let owners: Map<number, [block: GraphBlock, index: number]> | undefined
    function ownerOf(param: number): [block: GraphBlock, index: number] | undefined {
        if (!owners) {
            owners = new Map()
            for (const b of g.blocks) for (let i = 0; i < b.params.length; i++) owners.set(b.params[i], [b, i])
        }
        return owners.get(param)
    }
    const inbound = new Map<number, TailPosition[]>()
    function arrivals(block: number): TailPosition[] {
        let list = inbound.get(block)
        if (!list) inbound.set(block, list = arrivalsOf(block))
        return list
    }

    const params = new Map<number, Range>()
    const pending = new Set<number>()
    function paramRange(p: number): Range {
        const memo = params.get(p)
        if (memo) return memo
        const T = typeOf(getNode(g, p)!)
        const full = rangeOf(T, 0, Infinity)
        if (pending.has(p)) return full
        const closure = [p]
        const seen = new Set<number>([p])
        const inputs: [ref: number, literal: number, facts: Facts][] = []
        for (let i = 0; i < closure.length; i++) {
            const [b, k] = ownerOf(closure[i])!
            if (b === g.blocks[0]) return full
            for (const pos of arrivals(b.id)) {
                const app = getNode(g, pos.at)!
                if (countIds(app) !== b.params.length + 1) return full
                const ref = getRef(app, k + 1)
                const facts = pathFacts(g, pos.path)
                if (ref && getNode(g, ref)?.op === NodeOp.param && ownerOf(ref) && !comparisons(g, facts, ref).length) {
                    if (!seen.has(ref)) {
                        seen.add(ref)
                        closure.push(ref)
                    }
                    continue
                }
                inputs.push([ref, getLiteral(g, app, k + 1), facts])
            }
        }
        for (const q of closure) pending.add(q)
        let lo = Infinity
        let hi = 0
        for (const [ref, literal, facts] of inputs) {
            const [l, h] = range(ref, literal, facts)
            lo = Math.min(lo, l)
            hi = Math.max(hi, h)
        }
        for (const q of closure) pending.delete(q)
        const out = inputs.length ? rangeOf(T, lo, hi) : full
        params.set(p, out)
        return out
    }

    function shape(n: GraphNode, facts: Facts): Range {
        const T = typeOf(n)
        const operand = (i: number) => range(getRef(n, i), getLiteral(g, n, i), facts)
        const fits = (lo: number, hi: number): Range => rangeOf(T, lo, hi)
        const full = fits(0, Infinity)
        if (CompareOps.has(n.op)) return [0, 1]
        if (n.op === NodeOp.literal) return range(0, getLiteral(g, n, 0), facts)
        if (n.op === NodeOp.after) return operand(countIds(n) - 1)
        if (n.op === NodeOp.load) return truncated(T)
        if (n.op === NodeOp.convert) {
            const [lo, hi] = operand(0)
            return hi <= rangeMax(T) && hi < RangeLimit ? [lo, hi] : truncated(T)
        }
        if (n.op === NodeOp.and) return fits(0, Math.min(operand(0)[1], operand(1)[1]))
        if (n.op === NodeOp.or || n.op === NodeOp.xor) {
            const h = Math.max(operand(0)[1], operand(1)[1])
            return h === Infinity ? full : fits(0, 2 ** Math.ceil(Math.log2(h + 1)) - 1)
        }
        if ((n.op === NodeOp.ushr || n.op === NodeOp.shl) && !getRef(n, 1)) {
            const a = operand(0)
            const m = 2 ** getLiteral(g, n, 1)
            if (n.op === NodeOp.shl) return fits(a[0] * m, a[1] * m)
            const hi = a[1] !== Infinity ? Math.floor(a[1] / m) : 64 - getLiteral(g, n, 1) < 53 ? 2 ** (64 - getLiteral(g, n, 1)) - 1 : Infinity
            return fits(Math.floor(a[0] / m), hi)
        }
        if (n.op === NodeOp.add) {
            const a = operand(0)
            const b = operand(1)
            return fits(a[0] + b[0], a[1] + b[1])
        }
        if (n.op === NodeOp.mul) {
            const a = operand(0)
            const b = operand(1)
            return fits(a[0] * b[0], a[1] * b[1])
        }
        if (n.op === NodeOp.sub) {
            const a = operand(0)
            const b = operand(1)
            return a[0] >= b[1] ? fits(a[0] - b[1], a[1] - b[0]) : full
        }
        if (n.op === NodeOp.select) {
            let lo = Infinity
            let hi = 0
            for (let i = 1; i < countIds(n); i++) {
                const [l, h] = operand(i)
                lo = Math.min(lo, l)
                hi = Math.max(hi, h)
            }
            return fits(lo, hi)
        }
        return full
    }

    const plain = new Map<number, Range>()
    function range(ref: number, literal: number, facts: Facts): Range {
        if (!ref) return Number.isSafeInteger(literal) && literal >= 0 ? [literal, literal] : [0, Infinity]
        const n = getNode(g, ref)
        if (!n) return [0, Infinity]
        if (n.op === NodeOp.param && ownerOf(ref)) return refine(ref, paramRange(ref), facts)
        if (facts.length) return refine(ref, shape(n, facts), facts)
        const memo = plain.get(ref)
        if (memo) return memo
        const r = shape(n, facts)
        plain.set(ref, r)
        return r
    }

    function refine(ref: number, r: Range, facts: Facts): Range {
        for (const [k, equal] of comparisons(g, facts, ref)) {
            if (!Number.isSafeInteger(k) || k < 0) continue
            if (equal) return [k, k]
            if (k === r[0] && r[0] < r[1]) r = [r[0] + 1, r[1]]
            else if (k === r[1] && r[0] < r[1]) r = [r[0], r[1] - 1]
        }
        return r
    }

    const pairs = new Map<string, boolean>()
    function related(a: number, b: number, kind: string, test: (x: number, xk: number, y: number, yk: number, facts: Facts) => boolean): boolean {
        const pa = a && getNode(g, a)?.op === NodeOp.param ? ownerOf(a) : undefined
        const pb = b && getNode(g, b)?.op === NodeOp.param ? ownerOf(b) : undefined
        if (!pa || !pb || pa[0] !== pb[0] || pa[0] === g.blocks[0]) return false
        const key = `${kind}${a}:${b}`
        const memo = pairs.get(key)
        if (memo !== undefined) return memo
        pairs.set(key, false)
        const block = pa[0]
        const list = arrivals(block.id)
        let holds = list.length > 0
        for (const pos of list) {
            const app = getNode(g, pos.at)!
            if (countIds(app) !== block.params.length + 1
                || !test(getRef(app, pa[1] + 1), getLiteral(g, app, pa[1] + 1), getRef(app, pb[1] + 1), getLiteral(g, app, pb[1] + 1), pathFacts(g, pos.path))) {
                holds = false
                break
            }
        }
        pairs.set(key, holds)
        return holds
    }

    function below(a: number, b: number, bk: number, facts: Facts): boolean {
        const n = a ? getNode(g, a) : undefined
        if (n?.op !== NodeOp.sub || !b || getRef(n, 0) !== b || getRef(n, 1)) return false
        const k = getLiteral(g, n, 1)
        return k >= 1 && !lowering.isSignedType(resultType(g, getNode(g, b)!)) && range(b, bk, facts)[0] >= k
    }

    function stated(a: number, b: number, facts: Facts): number {
        if (!a || !b || a === b) return 7
        let mask = 7
        for (const [f, truth] of facts) {
            const r = relationOf(g, f, truth)
            if (!r || r.signed || !r.b) continue
            if (r.a === a && r.b === b) mask &= r.mask
            else if (r.a === b && r.b === a) mask &= swappedMask(r.mask)
        }
        return mask
    }

    function le(a: number, ak: number, b: number, bk: number, facts: Facts, depth = 0): boolean {
        if (a === b && (a || ak === bk)) return true
        if ((stated(a, b, facts) & ~3) === 0) return true
        if (!a && ak === 0) return true
        if (below(a, b, bk, facts)) return true
        if (range(a, ak, facts)[1] <= range(b, bk, facts)[0]) return true
        if (depth > 4) return false
        const n = a ? getNode(g, a) : undefined
        if (n?.op === NodeOp.and) {
            for (const i of [0, 1]) if (le(getRef(n, i), getLiteral(g, n, i), b, bk, facts, depth + 1)) return true
        }
        const prior = a && b ? successor(g, a) : 0
        if (prior && lt(prior, 0, b, bk, facts, depth + 1)) return true
        return related(a, b, 'le', (x, xk, y, yk, f) => le(x, xk, y, yk, f, depth + 1))
    }

    function lt(a: number, ak: number, b: number, bk: number, facts: Facts, depth = 0): boolean {
        if ((stated(a, b, facts) & ~1) === 0) return true
        if (range(a, ak, facts)[1] < range(b, bk, facts)[0]) return true
        if (below(a, b, bk, facts)) return true
        if (depth > 4) return false
        const m = b ? getNode(g, b) : undefined
        if (m?.op === NodeOp.add) {
            for (const i of [0, 1]) {
                if (getRef(m, i ^ 1) || getLiteral(g, m, i ^ 1) < 1) continue
                const c = range(getRef(m, i), getLiteral(g, m, i), facts)
                const top = c[1] + getLiteral(g, m, i ^ 1)
                if (top <= rangeMax(typeOf(m)) && top < RangeLimit && le(a, ak, getRef(m, i), getLiteral(g, m, i), facts, depth + 1)) return true
            }
        }
        return related(a, b, 'lt', (x, xk, y, yk, f) => lt(x, xk, y, yk, f, depth + 1))
    }

    const paramZeros = new Map<number, number>()
    function zerosOf(p: number): number {
        const memo = paramZeros.get(p)
        if (memo !== undefined) return memo
        const owner = ownerOf(p)
        if (!owner || owner[0] === g.blocks[0]) return 0
        const [b, k] = owner
        paramZeros.set(p, 0)
        let z = 64
        for (const pos of arrivals(b.id)) {
            const app = getNode(g, pos.at)!
            if (countIds(app) !== b.params.length + 1) return 0
            if (getRef(app, k + 1) === p) continue
            z = Math.min(z, zeros(getRef(app, k + 1), getLiteral(g, app, k + 1)))
            if (!z) break
        }
        paramZeros.set(p, z)
        return z
    }
    function zeros(ref: number, literal: number): number {
        return lowZeros(g, ref, literal, zerosOf)
    }

    return { range, le, lt, below, zeros }
}

export function isNumeric(g: Graph, id: number, entry: (param: number) => boolean, visiting = new Set<number>()): boolean {
    if (!id) return true
    const n = getNode(g, id)
    if (!n) return false
    if (n.op === NodeOp.literal || NumericOps.has(n.op)) return true
    if (n.op === NodeOp.select) return isNumeric(g, getRef(n, 1), entry, visiting) && isNumeric(g, getRef(n, 2), entry, visiting)
    if (n.op !== NodeOp.param) return false
    if (visiting.has(id)) return true
    const block = g.blocks.find(b => b.params.includes(id))
    if (!block) return false
    if (block.id === g.root) return entry(id)
    visiting.add(id)
    const at = block.params.indexOf(id) + 1
    let arrived = false
    for (const m of g.nodes.values()) {
        if (m.op !== NodeOp.apply || getRef(m, 0) !== block.id) continue
        if (!isNumeric(g, getRef(m, at), entry, visiting)) return false
        arrived = true
    }
    return arrived
}
const FloatArith = new Set([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.neg])
export const BitwiseOps = new Set([NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.not])

export function floatValues(g: Graph): Set<number> {
    const floats = new Set<number>()
    const flows = new Map<number, number[]>()
    const pending: number[] = []
    function mark(id: number): void {
        if (!id || floats.has(id)) return
        floats.add(id)
        pending.push(id)
    }
    function flow(from: number, to: number, literal: number): void {
        if (!from) {
            if (!Number.isInteger(literal)) mark(to)
            return
        }
        const list = flows.get(from)
        if (list) list.push(to)
        else flows.set(from, [to])
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.store && typeSlots(n.op) && typeOf(n) === Types.f64) mark(id)
        if (n.op === NodeOp.literal && !Number.isInteger(literalValue(g, n))) mark(id)
        if ((n.op === NodeOp.call || n.op === NodeOp.get) && resultType(g, n) === Types.f64) mark(id)
        if (FloatArith.has(n.op)) {
            for (let i = 0; i < countIds(n); i++) flow(getRef(n, i), id, getLiteral(g, n, i))
        } else if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) flow(getRef(n, i), id, getLiteral(g, n, i))
        } else if (n.op === NodeOp.after) {
            flow(getRef(n, countIds(n) - 1), id, getLiteral(g, n, countIds(n) - 1))
        } else if (n.op === NodeOp.apply) {
            const block = getBlock(g, getRef(n, 0))
            if (!block) continue
            block.params.forEach((p, i) => flow(getRef(n, i + 1), p, getLiteral(g, n, i + 1)))
        }
    }
    while (pending.length) for (const to of flows.get(pending.pop()!) ?? []) mark(to)
    return floats
}

const ClasslessFloats = new Set([Types.f16, Types.f32, Types.unknown_number])

export function returnRegisters(target: lowering.Target, types: intrinsics.Types[]): number[] | undefined {
    const regs: number[] = []
    let integer = 0
    let float = 0
    for (const T of types) {
        if (ClasslessFloats.has(T)) return
        const reg = T === Types.f64 ? target.floatRetRegs?.[float++] : target.retRegs[integer++]
        if (reg === undefined) return
        regs.push(reg)
    }
    return regs
}

export function recordTypes(g: Graph, t: GraphNode): intrinsics.Types[] {
    return recordFields(g, t).map(field => typeof field.type === 'number' ? field.type : Types.u64)
}

function comparesFloats(g: Graph, c: GraphNode): boolean {
    for (let i = 0; i < 2; i++) {
        if (getRef(c, i) ? operandType(g, c, i) === Types.f64 : !Number.isInteger(getLiteral(g, c, i))) return true
    }
    return false
}

const TargetingValues = new Set([
    NodeOp.syscallTarget, NodeOp.localTarget, NodeOp.indirectTarget
])
export const OrderedValues = new Set([
    NodeOp.load, NodeOp.store, NodeOp.call, NodeOp.pstack, NodeOp.rt, NodeOp.alloca, NodeOp.trap, NodeOp.getProp, NodeOp.setProp
])
export function firstNonOrderingSlot(n: GraphNode): number {
    return n.op === NodeOp.after ? countIds(n) - 1 : OrderedValues.has(n.op) ? 1 : 0
}
const PureOps = new Set<NodeOp>([
    NodeOp.mem,
    NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.subsat,
    NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.neg, NodeOp.not, NodeOp.clz, NodeOp.crc32, NodeOp.select, NodeOp.convert, NodeOp.bitconvert,
    NodeOp.poolEntry, NodeOp.void, NodeOp.param, NodeOp.heapHandle, NodeOp.nilEffect, NodeOp.block, 
    NodeOp.literal, NodeOp.get, NodeOp.record, NodeOp.unreachable, NodeOp.alloca, NodeOp.frameAddress, NodeOp.pc, NodeOp.encode, NodeOp.decode, NodeOp.box, NodeOp.unbox,
    ...TargetingValues
])
const Commutative = new Set<NodeOp>([NodeOp.add, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.ne, NodeOp.eq])
const UnsignedResults = new Set<Types>([Types.u8, Types.u16, Types.u32, Types.u64, Types.ptr])
const OrderingOps = new Set<NodeOp>([NodeOp.after, NodeOp.nilEffect])
const AddressOps = new Set<NodeOp>([NodeOp.pstack, NodeOp.alloca, NodeOp.frameAddress])
function latency(costs: lowering.TargetCosts, op: NodeOp): number {
    if (OrderingOps.has(op)) return 0
    return costs.latency.get(opName(op)) ?? 1
}

const LiftableSlots: Record<number, number[]> = {
    [NodeOp.load]: [1, 2],
    [NodeOp.store]: [1, 2, 3],
    [NodeOp.select]: [1, 2],
    [NodeOp.ret]: [0],
}

function inlineableLiteral(costs: lowering.TargetCosts, v: f64): boolean {
    const bound = costs.inlineLiteral
    return !Number.isSafeInteger(v) || (v > -bound && v < bound)
}

export function liftableSlot(op: NodeOp, slot: number): boolean {
    if (op === NodeOp.call) return slot >= 3
    if (BinaryOps.has(op) || CompareOps.has(op)) return slot < 2
    if (UnaryOps.has(op) || op === NodeOp.convert || op === NodeOp.bitconvert) return slot === 0
    return LiftableSlots[op]?.includes(slot) ?? false
}
const SwappedCmp: Record<number, NodeOp> = {
    [NodeOp.lt]: NodeOp.gt, [NodeOp.gt]: NodeOp.lt, [NodeOp.le]: NodeOp.ge, [NodeOp.ge]: NodeOp.le, [NodeOp.eq]: NodeOp.eq, [NodeOp.ne]: NodeOp.ne,
}

export interface LowerGraphOptions {
    target?: lowering.Target
    regBudget?: number
    returnLocation?: number
    returnRecord?: intrinsics.Types[]
    debug?: boolean
    clobbersOf?: (symbol: number) => Set<number> | undefined
    continues?: (symbol: number) => boolean
    endless?: (symbol: number) => boolean
    nameOf?: (symbol: number) => string | undefined
    poolSlot?: (value: number) => number
    poolValue?: (slot: number) => number | undefined
    floatSlot?: (value: number) => number
    staticData?: (bytes: Uint8Array) => number
}

export interface LowerGraphResult {
    target: lowering.Target
    words: number[]
    bytes: number[]
    relocations: lowering.Relocation[]
    listing: string
    clobbers: Set<number>
    localCalls: Set<number>
    island?: number[]
    continued?: Map<number, number[]>
}

// TODO:
// V1: (call, nil, p2, 0)
// = (select, p0, V1, (select, p1, (call, (call, nil, p3, 0), p2, 0), V1))
//
// can be turned into (select, (and, p0, (not, p1)), (call, nil, p2, 0), (call, (call, nil, p3, 0), p2, 0))

export function impureValues(g: Graph): Set<number> {
    const impure = new Set<number>()
    const epoch = nextEpoch(g)
    function walk(id: number): boolean {
        if (!id) return true
        const n = getNode(g, id)!
        if (!markVisited(n, epoch)) return !impure.has(id)
        let ok = leavesArm(g, n)
        if (ok) for (const a of gn.enumerateRefs(n)) if (!walk(a)) { ok = false; break }
        if (!ok) impure.add(id)
        return ok
    }
    for (const b of g.blocks) {
        for (const p of b.params) walk(p)
        walk(b.bodyId)
    }
    return impure
}

function literalValue(g: NodeSpace, u: GraphNode) {
    return getLiteral(g, u, 0)
}

const CompareEval: Record<number, (a: number, b: number) => boolean> = {
    [NodeOp.lt]: (a, b) => a < b, [NodeOp.le]: (a, b) => a <= b, [NodeOp.gt]: (a, b) => a > b,
    [NodeOp.ge]: (a, b) => a >= b, [NodeOp.eq]: (a, b) => a === b, [NodeOp.ne]: (a, b) => a !== b,
}

function latencyDepth(g: Graph, costs: lowering.TargetCosts): (id: number) => number {
    const depths = new Map<number, number>()
    function depthOf(id: number): number {
        const known = depths.get(id)
        if (known !== undefined) return known
        depths.set(id, 0)
        const n = getNode(g, id)
        let d = 0
        if (n && n.op !== NodeOp.param && n.op !== NodeOp.block && n.op !== NodeOp.literal) {
            for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) d = Math.max(d, depthOf(getRef(n, i)))
            d += latency(costs, n.op)
        }
        depths.set(id, d)
        return d
    }
    return depthOf
}

function scalarOperand(g: NodeSpace, nodes: Map<number, GraphNode>, n: GraphNode, i: number): number | undefined {
    const id = getRef(n, i)
    if (!id) return getLiteral(g, n, i)
    const u = nodes.get(id)
    return u?.op === NodeOp.literal ? literalValue(g, u) : undefined
}

function nodeKey(g: NodeSpace, n: GraphNode, argIds?: number[], ignoreWordWidth = false): string {
    const flags = n.flags & ~gn.NodeFlags.guarded
    let key = flags ? `${n.op}!${flags}` : `${n.op}`
    const arity = argIds ? argIds.length : countIds(n)
    for (let i = 0; i < arity; i++) {
        const ref = argIds ? argIds[i] : getRef(n, i)
        key += ref ? `,v${ref}` : `,c${getLiteral(g, n, i)}`
    }
    const slots = typeSlots(n.op)
    // XXX: graph arithmetic can carry u32/u64 decoration that lowering treats identically.
    const word = (type: number) => type === Types.u32 || type === Types.u64 || type === Types.ptr
    const eraseWidth = ignoreWordWidth && BinaryOps.has(n.op) && word(typeOf(n))
    if (slots) key += eraseWidth ? ',tuword' : typeRefOf(n) ? `,t%${typeRefOf(n)}` : `,t${typeOf(n)}`
    return key
}

function valueType(g: Graph, n: GraphNode): TypeOperand {
    const ref = typeRefOf(n)
    return ref ? { ref } : resultType(g, n)
}

function deduplicate(g: Graph, roots: number[], mergeable: (n: GraphNode) => boolean = () => true): number[] | undefined {
    const representatives = new Map<string, number>()
    const canonical = new Map<number, number>()
    let changed = false
    function visit(id: number): number {
        if (!id) return 0
        const n = getNode(g, id)!
        if (n.op === NodeOp.block || n.op === NodeOp.param) {
            return id
        }
        const known = canonical.get(id)
        if (known !== undefined) return known
        const argIds = getArgIds(n).map(a => visit(a))
        if (n.op === NodeOp.select && argIds[1] && argIds[1] === argIds[2]) {
            canonical.set(id, argIds[1])
            changed = true
            return argIds[1]
        }
        const merge = !allocates(g, n) && mergeable(n)
        const key = merge ? nodeKey(g, n, argIds) : ''
        let rep = merge ? representatives.get(key) : undefined
        if (rep === undefined) {
            rep = argIds.every((a, i) => a === getRef(n, i)) ? id : addCopy(g, n, withRefs(g, n, argIds), n.op)
            if (merge) representatives.set(key, rep)
        }
        if (rep !== id) changed = true
        canonical.set(id, rep)
        return rep
    }
    const out = roots.map(visit)
    return changed ? out : undefined
}

function createNode(g: Graph, op: NodeOp, operands: (number | GraphNode)[], original?: GraphNode): number {
    const converted = operands.map((o): Operand => {
        if (typeof o === 'number') return o
        assert(o.op === NodeOp.literal)
        return { literal: literalValue(g, o) }
    })
    return original ? addCopy(g, original, converted, op) : addNode(g, op, converted)
}

function literal(g: NodeSpace, v: number): GraphNode {
    return makeNode(g, NodeOp.literal, [{ literal: v }])
}


const sigStats = intrinsics.argv().includes('sig-stats') ? {
    applyMoves: 0, fromParam: 0, fromValue: 0, swaps: 0,
    steered: 0, steerFailed: 0, edges: 0, edgesBlocked: 0,
    displaced: 0, mismatch: 0, displacedToSlot: 0, dstIsSlot: 0,
    leaked: 0, leakedBlocks: 0, blocks: 0, leakKinds: new Map<string, number>(),
} : undefined
if (sigStats) process.on('beforeExit', () => {
    console.log('SIGSTATS', JSON.stringify({
        applyMoves: sigStats.applyMoves, fromParam: sigStats.fromParam,
        fromValue: sigStats.fromValue, swaps: sigStats.swaps,
        steered: sigStats.steered, steerFailed: sigStats.steerFailed,
        displaced: sigStats.displaced, mismatch: sigStats.mismatch,
        displacedToSlot: sigStats.displacedToSlot, dstIsSlot: sigStats.dstIsSlot,
        blocksEmitted: sigStats.blocks, blocksLeakingHomes: sigStats.leakedBlocks,
        homesLeakedAtBlockEnd: sigStats.leaked,
        affinityEdges: sigStats.edges, affinityBlocked: sigStats.edgesBlocked,
    }))
    console.log('  leak kinds', [...sigStats.leakKinds].sort((a, b) => b[1] - a[1])
        .map(([k, v]) => `${k}:${v}`).join(' '))
})

function forEachOperand(g: Graph, vid: number, fn: (n: GraphNode, id: number, idx: number) => number | undefined | void) {
    if (!vid) return vid
    const n = getNode(g, vid)!
    const vals: [number, number][] = []
    for (let i = 0; i < countIds(n); i++) {
        const id = getRef(n, i)
        if (!id) continue
        if (const u = getNode(g, id)) {
            const r = fn(u, id, i)
            if (r && r !== id) {
                vals.push([i, r])
            }
        }
    }
    if (!vals.length) return vid
    const operands = new Array(countIds(n))
    for (let i = 0; i < countIds(n); i++) {
        if (vals.length && vals[0][0] === i) {
            const x = vals.shift()!
            operands[i] = x[1]
            continue
        }
        const id = getRef(n, i)
        if (!id) {
            operands[i] = literal(g, getLiteral(g, n, i))
        } else {
            operands[i] = id
        }
    }
    return createNode(g, n.op, operands, n)
}

export function sweepBlocks(g: Graph) {
    const epoch = nextEpoch(g)
    let seenCount = 0
    function see(n: GraphNode) {
        if (!markVisited(n, epoch)) return false
        seenCount += 1
        return true
    }
    function visit(n: GraphNode, id: number) {
        if (!see(n)) return
        const type = gn.typeRefOf(n)
        if (type) visit(getNode(g, type)!, type)
        if (n.op === NodeOp.block) {
            const b = getBlock(g, id)
            if (!b) return
            for (const p of b.params) {
                visit(getNode(g, p)!, p)
            }
            if (!b.bodyId) return
            visit(getNode(g, b.bodyId)!, b.bodyId)
            return
        }
        const refSlots = gn.countIds(n)
        for (let i = 0; i < refSlots; i++) {
            const x = gn.getRef(n, i)
            if (!x) continue
            visit(getNode(g, x)!, x)
        }
    }
    const rootBlock = g.blocks[0]
    see(getNode(g, g.root)!)
    for (const p of rootBlock.params) {
        see(getNode(g, p)!)
    }
    if (rootBlock.bodyId) {
        const n = getNode(g, rootBlock.bodyId)!
        visit(n, rootBlock.bodyId)
    }
    if (seenCount === g.nodes.size) {
        return g
    }
    const unseen: number[] = []
    for (const [k, v] of g.nodes) {
        if (v.epoch !== epoch) unseen.push(k)
    }
    for (const k of unseen) deleteNode(g, k)
    if (g.facts?.size) {
        const kept = new Set<number>()
        const keep = (id: number) => {
            const f = g.facts!.get(id)
            if (!f || kept.has(id)) return
            kept.add(id)
            for (const x of getArgIds(f)) if (x) keep(x)
        }
        for (const n of g.nodes.values()) if (gn.factOf(n)) keep(gn.factOf(n))
        for (const k of [...g.facts.keys()]) if (!kept.has(k)) g.facts.delete(k)
    }
    const result = g.blocks.filter(x => hasNode(g, x.id))
    assert(result[0].id === g.root)
    setGraphBlocks(g, result)
    return g
}

function operand(g: NodeSpace, n: GraphNode, idx: number) {
    const id = getRef(n, idx)
    return id || literal(g, getLiteral(g, n, idx))
}

function transformVoids(g: Graph) {
    function producesVoid(id: number): boolean {
        if (!id) return false
        const n = getNode(g, id)
        if (!n) return false
        if (n.op === NodeOp.void) return true
        if (n.op === NodeOp.ret) return producesVoid(getRef(n, 0))
        if (n.op === NodeOp.after) return producesVoid(getRef(n, countIds(n)-1))
        if (n.op === NodeOp.select) return producesVoid(getRef(n, 1)) && producesVoid(getRef(n, 2))
        return false
    }
    function voidOperand(id: number): number | GraphNode {
        if (getNode(g, id)!.op === NodeOp.void) return literal(g, 0)
        return replaceVoids(id)
    }
    function replaceVoids(id: number): number {
        const n = getNode(g, id)!
        if (n.op !== NodeOp.ret && n.op !== NodeOp.after && n.op !== NodeOp.select) return id
        const vals: [number, number | GraphNode][] = []
        const start = n.op === NodeOp.select ? 1 : n.op === NodeOp.after ? countIds(n)-1 : 0
        for (let i = start; i < countIds(n); i++) {
            const arg = getRef(n, i)
            if (!arg) continue
            const r = voidOperand(arg)
            if (r !== arg) vals.push([i, r])
        }
        if (!vals.length) return id
        const operands: (number | GraphNode)[] = getArgIds(n).map((arg, i) => arg || literal(g, getLiteral(g, n, i)))
        for (const [i, r] of vals) operands[i] = r
        return createNode(g, n.op, operands, n)
    }
    let epoch = nextEpoch(g)
    const replacements = new Map<number, number>()
    const rets = new Map<number, number[]>()
    let currentInline = 0
    function visit(n: GraphNode, id: number): number | undefined {
        if (const r = replacements.get(id)) {
            const value = visit(getNode(g, r)!, r) ?? r
            replacements.set(id, value)
            return value
        }
        if (!markVisited(n, epoch)) return
        if (n.op === NodeOp.block) {
            const b = getBlock(g, id)
            if (b) b.bodyId = visit(getNode(g, b.bodyId)!, b.bodyId) ?? b.bodyId
            return
        }
        if (n.op === NodeOp.inlined) {
            const saveInlined = currentInline
            defer currentInline = saveInlined
            currentInline = id
            const r = forEachOperand(g, id, visit)
            if (r && r !== id) replacements.set(id, r)
            return r
        }
        if (n.op === NodeOp.ret) {
            let arr = rets.get(currentInline)
            if (!arr) rets.set(currentInline, arr = [])
            arr.push(id)
        }
        const r = forEachOperand(g, id, visit)
        if (r && r !== id) replacements.set(id, r)
        return r
    }
    const root = g.blocks[0].bodyId
    visit(getNode(g, root)!, root)
    for (const returns of rets.values()) {
        if (returns.every(producesVoid)) continue
        for (const id of returns) {
            const r = replaceVoids(id)
            if (r !== id) replacements.set(id, r)
        }
    }
    epoch = nextEpoch(g)
    g.blocks[0].bodyId = visit(getNode(g, root)!, root) ?? root
    return g
}

function makeTailsUnique(g: Graph) {
    function cloneTail(id: number) {
        if (!id) return id
        const n = getNode(g, id)
        assert(n)
        const next = newId(g)
        const operands = getOperands(g, n)
        if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) {
                const uid = getRef(n, i)
                if (!uid) continue
                assert(getNode(g, uid))
                operands[i] = cloneTail(uid)
            }
        } else if (n.op === NodeOp.after && getRef(n, countIds(n) - 1)) {
            operands[countIds(n) - 1] = cloneTail(getRef(n, countIds(n) - 1))
        }
        putCopy(g, next, n, operands)
        return next
    }
    for (const b of g.blocks) {
        b.bodyId = cloneTail(b.bodyId)
    }
}

function replaceAll(g: Graph, id: number, replacements: Map<number, number>, cloneAll = false, epoch = nextEpoch(g)): number {
    if (!id) return id
    if (const replacement = replacements.get(id)) {
        return replacement
    }
    const n = getNode(g, id)
    if (!n || isParam(g.nodes, id)) return id
    if (!markVisited(n, epoch)) return id
    const ids = getArgIds(n)
    const idReplacements: [idx: number, id: number][] = []
    for (let i = 0; i < ids.length; i++) {
        const next = replaceAll(g, ids[i], replacements, false, epoch)
        if (next !== ids[i]) { 
            idReplacements.push([i, next])
        }
    }
    if (!idReplacements.length && !cloneAll) return id
    const newIds = new Array(ids.length)
    for (let i = 0; i < ids.length; i++) {
        if (idReplacements[0]?.[0] === i) {
            newIds[i] = idReplacements.shift()![1]
        } else {
            newIds[i] = ids[i] || literal(g, getLiteral(g, n, i))
        }
    }
    const copy = createNode(g, n.op, newIds, n)
    replacements.set(id, copy)
    return copy
}

function replaceLiterals(g: Graph) {
    for (const [id, n] of g.nodes) {
        if (n.op === NodeOp.literal) continue
        for (let i = 0; i < countIds(n); i++) {
            const uid = getRef(n, i)
            if (!uid) continue
            const u = getNode(g, uid)!
            if (u.op !== NodeOp.literal) continue
            setLiteral(g, n, i, literalValue(g, u))
        }
    }
}

function returnedRecord(g: Graph, ret: GraphNode): GraphNode | undefined {
    const n = getNode(g, getRef(ret, 0))
    return n?.op === NodeOp.record ? n : undefined
}

function outlineReturns(g: Graph): Graph {
    let returns = 0
    let only: GraphNode | undefined
    let hasLiterals = false
    let fields = 0
    for (const n of g.nodes.values()) {
        if (n.op !== NodeOp.ret) continue
        const record = returnedRecord(g, n)
        const width = record ? countIds(record) / 2 : 0
        assert(!returns || fields === width, 'lowering: returns disagree on shape')
        returns++
        only = n
        fields = width
    }
    if (!returns) return g
    const scalar = returns === 1 && countIds(only!) === 1
    if (scalar && g.blocks.length === 1 && !returnedRecord(g, only!)) return g
    if (scalar && g.blocks.some(b => getNode(g, b.bodyId) === only && b.params.includes(getRef(only!, 0)))) return g
    const blockId = createNode(g, NodeOp.block, [])
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.ret) continue
        const operands: (number | GraphNode)[] = [blockId]
        const record = returnedRecord(g, n)
        if (record) {
            for (let i = 0; i < fields; i++) {
                assert(getLiteral(g, record, i * 2) === i, 'lowering: returned record is not in slot order')
                operands.push(operand(g, record, i * 2 + 1))
            }
        } else {
            operands.push(operand(g, n, 0))
            if (!getRef(n, 0)) hasLiterals = true
        }
        setNode(g, id, getNode(g, createNode(g, NodeOp.apply, operands, n))!)
    }
    const params: number[] = []
    for (let i = 0; i < Math.max(fields, 1); i++) params.push(createNode(g, NodeOp.param, []))
    const values: (number | GraphNode)[] = []
    for (let i = 0; i < fields; i++) values.push(literal(g, i), params[i])
    const bodyId = createNode(g, NodeOp.ret, [fields ? createNode(g, NodeOp.record, values) : params[0]])
    addGraphBlock(g, { id: blockId, params, bodyId, bodyConst: 0 })
    if (hasLiterals) replaceLiterals(g)
    return g
}

export function panicOrdering(g: Graph, thrown: number): number[] {
    const n = thrown ? getNode(g, thrown) : undefined
    if (!n) return []
    const walk = n.op === NodeOp.after ? cloneRefs(n, 0, countIds(n) - 1) : OrderedValues.has(n.op) ? [getRef(n, 0)] : []
    const observed: number[] = []
    const seen = new Set<number>()
    while (walk.length) {
        const id = walk.pop()!
        if (!id || seen.has(id)) continue
        seen.add(id)
        const u = getNode(g, id)
        if (!u) continue
        if (u.op === NodeOp.call) {
            const s = callSummary(g, u) ?? unknownCall
            if (s.effect === EffectWrite && (s.writes & WritesUnknown) !== 0) {
                observed.push(id)
                continue
            }
        }
        if (u.op === NodeOp.after) for (let i = 0; i < countIds(u); i++) walk.push(getRef(u, i))
        else if (OrderedValues.has(u.op)) walk.push(getRef(u, 0))
    }
    return observed
}

function panicNullishCalls(g: Graph): void {
    const nullish: number[] = []
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.call) continue
        if (isNullishValue(g, getRef(n, 1))) nullish.push(id)
    }
    if (!nullish.length) return
    const users = nodeUsers(g, g.nodes.keys(), true)
    function spread(from: number[], marks: Map<number, number>): void {
        const work = from.map(call => [call, call])
        while (work.length) {
            const [id, call] = work.pop()!
            for (const [user, slot] of users.get(id) ?? []) {
                if (marks.has(user) || (slot > 0 && getNode(g, user)!.op === NodeOp.select)) continue
                marks.set(user, call)
                work.push([user, call])
            }
        }
    }
    const later = new Map<number, number>()
    spread(nullish, later)
    const doomedBy = new Map<number, number>()
    const first = nullish.filter(call => !later.has(call))
    for (const call of first) doomedBy.set(call, call)
    spread(first, doomedBy)
    for (const b of g.blocks) {
        b.bodyId = mapTailPositions(g, b.bodyId, p => {
            for (const root of tailRoots(g, p)) {
                const call = doomedBy.get(root)
                if (call !== undefined) return createNode(g, NodeOp.panic, [call])
            }
            return p.at
        })
    }
}

function replacePanics(g: Graph): boolean {
    let inlined = false
    for (const [id, n] of g.nodes) {
        if (n.op === NodeOp.inlined) inlined = true
        if (n.op !== NodeOp.panic) continue
        const unreachable = createNode(g, NodeOp.unreachable, [], n)
        const tokens = panicOrdering(g, getRef(n, 0))
        if (!tokens.length) {
            setNode(g, id, getNode(g, unreachable)!)
            continue
        }
        const a = createNode(g, NodeOp.after, [...tokens, unreachable])
        setNode(g, id, getNode(g, a)!)
    }
    return inlined
}

function outlinePanics(g: Graph): Graph {
    const blockId = createNode(g, NodeOp.block, [])
    let replaced = false
    let hasLiterals = false
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.panic) continue
        replaced = true
        const v = operand(g, n, 0)
        if (!getRef(n, 0)) hasLiterals = true
        setNode(g, id, getNode(g, createNode(g, NodeOp.apply, [blockId, v], n))!)
    }
    if (!replaced) {
        deleteNode(g, blockId)
        return g
    }
    const parameter = createNode(g, NodeOp.param, [])
    const bodyId = createNode(g, NodeOp.panic, [parameter])
    addGraphBlock(g, { id: blockId, params: [parameter], bodyId, bodyConst: 0 })
    if (hasLiterals) replaceLiterals(g)
    return g
}

const Unspeculatable = new Set<NodeOp>([NodeOp.call, NodeOp.store, NodeOp.rt, NodeOp.inlined])

interface BranchingSelect {
    select: number
    owner: number
    slot: number
    users: [user: number, slot: number][]
}

function tailEdge(n: GraphNode, i: number): boolean {
    if (n.op === NodeOp.after) return i === countIds(n) - 1
    if (n.op === NodeOp.select) return i > 0
    return n.op === NodeOp.inlined && i === 0
}

interface TailEffects {
    order: number[]
    tail: Map<number, boolean>
    regions: RegionTree
    effectful: Set<number>
}

function tailEffects(g: Graph, b: GraphBlock, guarded?: Set<number>): TailEffects | undefined {
    const order = blockOrder(g, b)
    const tail = new Map<number, boolean>()
    tail.set(b.bodyId, true)
    let offTail = false
    let effects = false
    for (let k = order.length - 1; k >= 0; k--) {
        const id = order[k]
        const n = getNode(g, id)
        if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
        if (guarded ? guarded.has(id) : Unspeculatable.has(n.op)) effects = true
        const on = tail.get(id) === true || n.op === NodeOp.inlined
        if (n.op === NodeOp.select && !tail.get(id)) offTail = true
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            if (!x) continue
            tail.set(x, (tail.get(x) ?? true) && on && tailEdge(n, i))
        }
    }
    if (!offTail || !effects) return

    const regions = orderRegions(g, order, armOrBodySlot)
    const { parent, origin } = regions

    const marked = new Uint8Array(parent.length)
    const effectful = new Set<number>()
    for (const id of order) {
        const n = getNode(g, id)
        if (!n || n.op === NodeOp.param || !(guarded ? guarded.has(id) : Unspeculatable.has(n.op))) continue
        if (guarded) effectful.add(id)
        let c = regions.of.get(id)!
        while (c > 0 && !marked[c]) {
            marked[c] = 1
            if (getNode(g, origin[c])!.op === NodeOp.select) effectful.add(origin[c])
            c = parent[c]
        }
    }
    if (!effectful.size) return
    return { order, tail, regions, effectful }
}

function branchingSelects(g: Graph, b: GraphBlock, guarded?: Set<number>): BranchingSelect[] {
    const effects = tailEffects(g, b, guarded)
    if (!effects) return []
    const { order, tail, effectful } = effects
    const { origin, slot } = effects.regions
    const chosen = new Map<number, BranchingSelect>()
    const bySelect = new Map<number, BranchingSelect>()
    for (const id of order) {
        if (!effectful.has(id) || tail.get(id)) continue
        const c = effects.regions.of.get(id)!
        if (chosen.has(c)) continue
        const home = c ? getNode(g, origin[c])! : undefined
        if (home?.op === NodeOp.select && !tail.get(origin[c])) continue
        const found: BranchingSelect = { select: id, owner: c ? origin[c] : 0, slot: c ? slot[c] : 0, users: [] }
        chosen.set(c, found)
        bySelect.set(id, found)
    }
    for (const id of order) {
        const n = getNode(g, id)
        if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
        for (let i = 0; i < countIds(n); i++) {
            const found = bySelect.get(getRef(n, i))
            if (found) found.users.push([id, i])
        }
    }
    return [...chosen].sort((x, y) => effects.regions.depth[x[0]] - effects.regions.depth[y[0]]).map(([, found]) => found)
}

function effectfulSelects(g: Graph): [effectful: Set<number>, offTail: number[]] {
    const all = new Set<number>()
    const offTail: number[] = []
    for (const b of g.blocks) {
        const effects = tailEffects(g, b)
        if (!effects) continue
        for (const id of effects.effectful) {
            all.add(id)
            if (!effects.tail.get(id)) offTail.push(id)
        }
    }
    return [all, offTail]
}

function splitAtSelect(g: Graph, b: GraphBlock, c: BranchingSelect): GraphBlock {
    const s = getNode(g, c.select)!
    const operands = getOperands(g, s)
    const type = valueType(g, s)
    const blockId = addNode(g, NodeOp.block, [])
    const token = addNode(g, NodeOp.nilEffect, [blockId])
    for (const [u, i] of c.users) {
        const n = getNode(g, u)!
        if (i >= firstNonOrderingSlot(n)) continue
        putCopy(g, u, n, withOperand(g, n, i, token))
    }
    const arms: Operand[] = [operands[0]]
    for (let i = 1; i < operands.length; i++) {
        const arm = operands[i]
        if (typeof arm !== 'number') {
            arms.push(addNode(g, NodeOp.apply, [blockId, arm]))
            continue
        }
        const op = getNode(g, arm)!.op
        if (op === NodeOp.nilEffect || op === NodeOp.void) {
            arms.push(addNode(g, NodeOp.apply, [blockId, { literal: 0 }]))
            continue
        }
        arms.push(addNode(g, NodeOp.after, [arm, addNode(g, NodeOp.apply, [blockId, arm])]))
    }
    putNode(g, c.select, NodeOp.param, [], type)
    const split = addNode(g, NodeOp.select, arms)
    let bodyId = b.bodyId
    if (c.owner) {
        const o = getNode(g, c.owner)!
        bodyId = getRef(o, c.slot)
        putCopy(g, c.owner, o, withOperand(g, o, c.slot, split))
    } else {
        b.bodyId = split
    }
    const k: GraphBlock = { id: blockId, params: [c.select], bodyId, bodyConst: 0 }
    addGraphBlock(g, k)
    return k
}

function dominatorsFirst(g: Graph): GraphBlock[] {
    const order: GraphBlock[] = []
    const seen = new Set<number>()
    const stack = [g.root]
    function collect(id: number, into: number[]): void {
        const n = getNode(g, tailOf(g, id))
        if (n?.op === NodeOp.apply) into.push(getRef(n, 0))
        else if (n?.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) collect(getRef(n, i), into)
    }
    while (stack.length) {
        const id = stack.pop()!
        if (seen.has(id)) continue
        seen.add(id)
        const b = getBlock(g, id)
        if (!b) continue
        order.push(b)
        const targets: number[] = []
        collect(b.bodyId, targets)
        for (let i = targets.length - 1; i >= 0; i--) {
            if (!seen.has(targets[i])) stack.push(targets[i])
        }
    }
    for (const b of g.blocks) {
        if (!seen.has(b.id)) order.push(b)
    }
    return order
}

export function splitGuardedSelects(g: Graph, guarded: Set<number>): void {
    if (guarded.size) splitSelects(g, guarded)
}

function splitBranchingSelects(g: Graph): boolean {
    return splitSelects(g)
}

function splitSelects(g: Graph, guarded?: Set<number>): boolean {
    const work = dominatorsFirst(g).reverse()
    let changed = false
    while (work.length) {
        const b = work.pop()!
        const found = branchingSelects(g, b, guarded)
        if (!found.length) continue
        const made: GraphBlock[] = []
        for (const c of found) made.push(splitAtSelect(g, b, c))
        for (let i = made.length - 1; i >= 0; i--) work.push(made[i])
        work.push(b)
        changed = true
    }
    return changed
}

export function inlineBlocks(g: Graph) {
    makeTailsUnique(g)
    transformVoids(g)
    function reduceInlined() {
        const refs: number[] = []
        const jumped = new Set<number>()
        const jumpedBy = new Map<number, number>()
        function logInlinedBlocks() {
            const sites = new Map<number, Set<number>>()
            for (const b of g.blocks) {
                const epoch = nextEpoch(g)
                function walk(id: number): void {
                    if (!id) return
                    const n = getNode(g, id)
                    if (!n || !markVisited(n, epoch)) return
                    if (n.op === NodeOp.block) return
                    if (n.op === NodeOp.inlined) {
                        let s = sites.get(id)
                        if (!s) sites.set(id, s = new Set())
                        s.add(b.id)
                    }
                    for (let i = 0; i < countIds(n); i++) walk(getRef(n, i))
                }
                walk(b.bodyId)
            }
            const succ = new Map<number, Set<number>>()
            for (const b of g.blocks) {
                const epoch = nextEpoch(g)
                const out = new Set<number>()
                succ.set(b.id, out)
                function edges(id: number): void {
                    if (!id) return
                    const n = getNode(g, id)
                    if (!n || !markVisited(n, epoch)) return
                    if (n.op === NodeOp.block) { out.add(id); return }
                    for (let i = 0; i < countIds(n); i++) edges(getRef(n, i))
                }
                edges(b.bodyId)
            }
            function reaches(from: number, to: number): boolean {
                const seen = new Set<number>([from])
                const queue = [from]
                while (const cur = queue.pop()) {
                    if (cur === to) return true
                    for (const nx of succ.get(cur) ?? []) {
                        if (seen.has(nx)) continue
                        seen.add(nx)
                        queue.push(nx)
                    }
                }
                return false
            }
            for (const [id, blocks] of sites) {
                if (blocks.size < 2) continue
                const arr = [...blocks]
                const head = arr.filter(a => arr.every(b => a === b || reaches(a, b)))
                const pairs: string[] = []
                for (let i = 0; i < arr.length; i++) {
                    for (let j = i + 1; j < arr.length; j++) {
                        if (!reaches(arr[i], arr[j]) && !reaches(arr[j], arr[i])) pairs.push(`B${arr[i]}/B${arr[j]}`)
                    }
                }
                console.log(`inlined ${id} in ${arr.map(x => `B${x}`).join(', ')}`)
                console.log(`    reaches-all: ${head.length ? head.map(x => `B${x}`).join(', ') : 'NONE'}`
                    + (pairs.length ? `   divergent: ${pairs.join(' ')}` : '   (total order)'))
            }
            return sites
        }
        const siteBlocks = intrinsics.argv().includes('inline-debug') ? logInlinedBlocks() : undefined
        function findSite(root: number): number | undefined {
            refs.length = 0
            const epoch = nextEpoch(g)
            function find(id: number): number | undefined {
                if (!id) return
                const n = getNode(g, id)
                if (!n || !markVisited(n, epoch)) return
                if (n.op === NodeOp.block) {
                    refs.push(id)
                    return
                }
                if (n.op === NodeOp.inlined) return id
                for (let i = countIds(n) - 1; i >= 0; i--) {
                    const found = find(getRef(n, i))
                    if (found) return found
                }
                return
            }
            return find(root)
        }

        function convert(block: GraphBlock, site: number) {
            const source = getNode(g, site)!
            if (siteBlocks) {
                const seen = siteBlocks.get(site)
                const where = seen ? [...seen].map(x => `B${x}`).join(', ') : '<none>'
                const picked = seen?.has(block.id) ? '' : ' NOT-IN-SET'
                console.log(`convert site=${site} at B${block.id} of ${seen?.size ?? 0}: ${where}${picked}`)
            }
            const memo = new Map<number, boolean>()
            function reaches(id: number): boolean {
                if (id === site) return true
                if (!id) return false
                const known = memo.get(id)
                if (known !== undefined) return known
                const n = getNode(g, id)
                const out = !!n && n.op !== NodeOp.block && getArgIds(n).some(arg => reaches(arg))
                memo.set(id, out)
                return out
            }

            function armed(from: number): boolean {
                const order: number[] = []
                const visited = new Set<number>()
                let selects = false
                function visit(id: number): void {
                    if (visited.has(id) || !reaches(id)) return
                    visited.add(id)
                    const n = getNode(g, id)!
                    if (n.op === NodeOp.select) selects = true
                    if (id !== site) for (const arg of getArgIds(n)) visit(arg)
                    order.push(id)
                }
                visit(from)
                if (!selects) return false
                const regions = orderRegions(g, order, armOrBodySlot)
                for (let c = regions.of.get(site) ?? 0; c > 0; c = regions.parent[c]) {
                    if (getNode(g, regions.origin[c])!.op === NodeOp.select) return true
                }
                return false
            }

            let parent = 0
            let slot = 0
            let at = block.bodyId
            let body = at
            let bodyParent = parent
            let bodySlot = slot
            while (at !== site) {
                const n = getNode(g, at)!
                if (n.op === NodeOp.ret || jumped.has(at)) {
                    body = at
                    bodyParent = parent
                    bodySlot = slot
                    break
                }
                let next = -1
                if (n.op === NodeOp.select) {
                    if (reaches(getRef(n, 0))) break
                    let arms = 0
                    for (let i = 1; i < countIds(n); i++) {
                        if (!reaches(getRef(n, i))) continue
                        arms++
                        next = i
                    }
                    if (arms > 1) {
                        body = at
                        bodyParent = parent
                        bodySlot = slot
                        break
                    }
                } else if (n.op === NodeOp.after) {
                    const last = countIds(n) - 1
                    let leading = false
                    for (let i = 0; i < last; i++) if (reaches(getRef(n, i))) leading = true
                    if (leading) break
                    next = last
                }
                if (next < 0) break
                parent = at
                slot = next
                at = getRef(n, next)
                if (n.op === NodeOp.select) {
                    body = at
                    bodyParent = parent
                    bodySlot = slot
                }
            }
            assert(at === site || !armed(at), `inlined ${site}: the site sits in a select arm outside the tail of B${block.id}`)

            const jumps: number[] = []
            const regionBodies: number[] = []
            const epoch = nextEpoch(g)
            function collect(id: number): void {
                if (!id) return
                const n = getNode(g, id)
                if (!n || !markVisited(n, epoch)) return
                if (n.op === NodeOp.ret) {
                    assert(!jumped.has(id), `inlined ${site}: ret ${id} already exits another inlined value`)
                    jumps.push(id)
                }
                else if (n.op === NodeOp.after) collect(getRef(n, countIds(n) - 1))
                else if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) collect(getRef(n, i))
                else if (n.op === NodeOp.apply) {
                    const regionBody = getBlock(g, getRef(n, 0))?.bodyId ?? 0
                    regionBodies.push(regionBody)
                    collect(regionBody)
                }
            }
            collect(getRef(source, 0))
            const shape = jumps.length ? recordKeys(g, getRef(getNode(g, jumps[0])!, 0)) : undefined
            const blockId = addNode(g, NodeOp.block, [])
            for (const id of jumps) {
                const n = getNode(g, id)!
                jumped.add(id)
                jumpedBy.set(id, site)
                putNode(g, id, NodeOp.apply, [blockId, getOperand(g, n, 0)])
            }
            if (bodyParent) {
                const p = getNode(g, bodyParent)!
                putCopy(g, bodyParent, p, withOperand(g, p, bodySlot, getOperand(g, source, 0)))
            } else {
                block.bodyId = getRef(source, 0)
                block.bodyConst = getLiteral(g, source, 0)
            }
            const paramType: TypeOperand = shape ? { ref: insertNode(g, createRecordType(g, shape.map(key => ({ key, type: Types.u64 })))) } : Types.u64
            let entry = 0
            const kept = new Set<number>()
            {
                const stack = [block.bodyId, ...regionBodies]
                while (stack.length) {
                    const id = stack.pop()!
                    const n = id ? getNode(g, id) : undefined
                    if (!n || kept.has(id) || n.op === NodeOp.block) continue
                    kept.add(id)
                    for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
                }
            }
            const restarted = new Set<number>()
            function restart(id: number): void {
                if (!id || id === site || kept.has(id) || restarted.has(id)) return
                restarted.add(id)
                const n = getNode(g, id)!
                if (n.op === NodeOp.block || n.op === NodeOp.param) return
                let ops: Operand[] | undefined
                const ordering = firstNonOrderingSlot(n)
                for (let i = 0; i < countIds(n); i++) {
                    const ref = getRef(n, i)
                    const m = ref ? getNode(g, ref) : undefined
                    const root = ref === site || (m?.op === NodeOp.nilEffect ? countLiterals(m) > 0 && getRef(m, 0) === block.id : block.params.includes(ref) || (kept.has(ref) && reaches(id)))
                    if (!ref || i >= ordering || !root) {
                        restart(ref)
                        continue
                    }
                    ops ??= getOperands(g, n)
                    ops[i] = entry ||= addNil(blockId)
                }
                if (ops) putCopy(g, id, n, ops)
            }
            function addNil(label: number): number {
                return addNode(g, NodeOp.nilEffect, [label])
            }
            restart(body)
            putNode(g, site, NodeOp.param, [], paramType)
            setDebugLabel(g, site, `inline${site}`)
            addGraphBlock(g, { id: blockId, params: [site], bodyId: body, bodyConst: 0 })
        }

        const queue: GraphBlock[] = [g.blocks[0]]
        const queued = new Set<number>([g.root])
        for (let i = 0; i < queue.length; i++) {
            const block = queue[i]
            while (const site = findSite(block.bodyId)) convert(block, site)
            for (const ref of refs) {
                if (queued.has(ref) || !getBlock(g, ref)) continue
                queued.add(ref)
                queue.push(getBlock(g, ref)!)
            }
        }
    }
    panicNullishCalls(g)
    if (replacePanics(g)) reduceInlined()
    return g
}

function copyCallTargets(g: Graph) {
    const targeted = new Set<number>()
    for (const [id, n] of g.nodes) {
        const target = n.op === NodeOp.call ? getNode(g, getRef(n, 1)) : undefined
        if (!target || !TargetingValues.has(target.op) || !countIds(target)) continue
        if (!targeted.has(getRef(n, 1))) {
            targeted.add(getRef(n, 1))
            continue
        }
        const copy = addCopy(g, target)
        putCopy(g, id, n, withRefs(g, n, cloneRefs(n).map((ref, i) => i === 1 ? copy : ref)))
    }
    return g
}

const placementRegions = intrinsics.argv().includes('optimize-stats') ? new Map<string, number>() : undefined

function blockRegions(g: Graph, entries: Set<number>): GraphBlock[][] {
    const groups: GraphBlock[][] = []
    const order = new Map(g.blocks.map((b, i) => [b.id, i]))
    const seen = new Set<number>()
    for (const entry of entries) {
        const members: GraphBlock[] = []
        const work = [entry]
        while (work.length) {
            const id = work.pop()!
            const b = getBlock(g, id)
            if (!b || seen.has(id)) continue
            seen.add(id)
            members.push(b)
            for (const p of tailPositions(g, b.bodyId)) {
                const n = getNode(g, p.at)!
                const to = n.op === NodeOp.apply ? getRef(n, 0) : 0
                if (to && !entries.has(to)) work.push(to)
            }
        }
        if (members.length) groups.push(members.sort((a, b) => order.get(a.id)! - order.get(b.id)!))
    }
    return groups
}

export function packageBlocksFINAL(g: Graph, entries?: Set<number>) {
    g = outlineReturns(g)
    g = outlinePanics(g)
    const groups = entries ? blockRegions(g, entries) : [g.blocks]
    if (entries) setGraphBlocks(g, groups.flat())
    for (const members of groups) {
        const roots = deduplicate(g, members.map(b => b.bodyId), n => PureOps.has(n.op))
        if (roots) members.forEach((b, i) => { b.bodyId = roots[i] })
    }
    g = copyCallTargets(g)
    const successors = new Map<number, Set<number>>()
    const preds = new Map<number, Set<number>>()
    const savedPreds = new Map<number, Set<number>>()
    const seenInBlock = new Map<number, Set<number>>()
    const depth = new Map<number, number>()
    function addTo(m: Map<number, Set<number>>, key: number, val: number) {
        let s = m.get(key)
        if (!s) m.set(key, s = new Set())
        s.add(val)
    }

    const ancestors = new Map<number, Set<number>>()
    function ancestorsOf(bid: number) {
        if (const m = ancestors.get(bid)) return m
        const r = new Set<number>()
        ancestors.set(bid, r)
        if (bid === g.root) return r
        for (const pred of preds.get(bid)!) {
            r.add(pred)
            for (const q of ancestorsOf(pred)) {
                r.add(q)
            }
        }
        return r
    }

    function uniqueLca(s: Set<number>): number {
        assert(s.size)
        if (s.has(g.root)) return g.root
        if (s.size === 1) return s.values().next().value!
        const arr = [...s]
        const c = new Set<number>(ancestorsOf(arr[0]))
        c.add(arr[0])
        for (let i = 1; i < arr.length; i++) {
            const b = arr[i]
            const c2 = ancestorsOf(b)
            for (const x of c) {
                if (!c2.has(x) && x !== b) {
                    c.delete(x)
                }
            }
        }
        for (const x of c) {
            if (!c.has(x)) continue
            for (const a of ancestorsOf(x)) {
                c.delete(a)
            }
        }
        const r = uniqueLca(c)
        return r
    }
    function addAndCheck(m: Map<number, Set<number>>, key: number, val: number) {
        let s = m.get(key)
        if (!s) {
            m.set(key, s = new Set())
            s.add(val)
            return true
        }
        const q = s.size
        s.add(val)
        return s.size !== q
    }
    const pinned = new Map<number, number>()
    function isPlaceholder(n: GraphNode) {
        return n.op === NodeOp.param || (n.op === NodeOp.nilEffect && countLiterals(n) === 1)
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.param && isPlaceholder(n)) pinned.set(id, getRef(n, 0))
        else if (n.op === NodeOp.nilEffect && countLiterals(n) === 0) pinned.set(id, g.root)
    }
    function chainBlock(id: number): number | undefined {
        const n = getNode(g, id)
        if (!n || (n.op === NodeOp.nilEffect && !countLiterals(n))) return
        if (pinned.has(id) || n.op === NodeOp.after || !firstNonOrderingSlot(n)) return pinned.get(id)
        const home = chainBlock(getRef(n, 0))
        if (home !== undefined) pinned.set(id, home)
        return home
    }
    function visitBlock(b: GraphBlock, blocksSeen: Set<number>) {
        for (const x of b.params) {
            pinned.set(x, b.id)
        }
        if (getNode(g, b.bodyId)?.op !== NodeOp.unreachable) pinned.set(b.bodyId, b.id)
        function visit(id: number) {
            if (!id) return
            const n = getNode(g, id)
            if (!n) return
            if (n.op === NodeOp.block) {
                addTo(successors, b.id, id)
                addTo(preds, id, b.id)
                if (!blocksSeen.has(id)) {
                    blocksSeen.add(id)
                    visitBlock(getBlock(g, id)!, blocksSeen)
                }
                return
            }
            if (!countIds(n) && !isPlaceholder(n)) return
            const didAdd = addAndCheck(seenInBlock, id, b.id)
            if (!didAdd) return
            const home = chainBlock(id)
            if ((home !== undefined && home !== b.id) || n.op === NodeOp.nilEffect) return
            for (let i = 0; i < countIds(n); i++) {
                visit(getRef(n, i))
            }
        }
        visit(b.bodyId)
    }
    visitBlock(g.blocks[0], new Set())
    function finish(): Graph {
        for (const n of g.nodes.values()) {
            if (n.op !== NodeOp.nilEffect || !countIds(n)) continue
            clearOperands(n)
        }
        return g
    }
    let captured = false
    for (const [k, v] of seenInBlock) {
        const n = getNode(g, k)!
        if (!isPlaceholder(n) && (!countIds(n) || TargetingValues.has(n.op))) continue
        const home = pinned.get(k)
        if (v.size > 1 || (home !== undefined && !v.has(home))) {
            captured = true
            break
        }
    }
    if (!captured) return finish()

    for (const [k, v] of preds) {
        savedPreds.set(k, new Set(v))
    }

    const seen = new Set<number>()
    const active = new Set<number>()
    const backEdges: [from: number, header: number][] = []
    function visit(bid: number) {
        if (seen.has(bid)) return
        seen.add(bid)
        active.add(bid)
        for (const to of successors.get(bid) ?? []) {
            if (active.has(to)) {
                preds.get(to)?.delete(bid)
                backEdges.push([bid, to])
                continue
            }
            visit(to)
        }
        active.delete(bid)
    }
    visit(g.root)
    for (const [k, v] of preds) {
        visit(k)
    }
    const loopHeaders = new Map<number, Set<number>>()
    for (const [from, header] of backEdges) {
        addTo(loopHeaders, header, header)
        const stack = [from]
        while (stack.length) {
            const bid = stack.pop()!
            if (loopHeaders.get(bid)?.has(header)) continue
            addTo(loopHeaders, bid, header)
            for (const pred of savedPreds.get(bid) ?? []) stack.push(pred)
        }
    }
    function withinLoopsOf(bid: number, outer: number): boolean {
        for (const header of loopHeaders.get(bid) ?? []) {
            if (!loopHeaders.get(outer)?.has(header)) return false
        }
        return true
    }
    function leavesLoops(arm: number, outer: number): boolean {
        for (const p of tailPositions(g, arm)) {
            const t = getNode(g, p.at)!
            if (t.op === NodeOp.apply) {
                if (!withinLoopsOf(getRef(t, 0), outer)) return false
                continue
            }
            if (t.op !== NodeOp.ret && t.op !== NodeOp.panic && t.op !== NodeOp.unreachable) return false
        }
        return true
    }
    function evaluatedPerIteration(bid: number, vid: number, outer: number): boolean {
        const seen = new Set<number>()
        const stack = [getBlock(g, bid)!.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (id === vid) return true
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.block) continue
            for (let i = 0; i < countIds(n); i++) {
                if (n.op === NodeOp.select && i > 0 && leavesLoops(getRef(n, i), outer)) continue
                stack.push(getRef(n, i))
            }
        }
        return false
    }
    function depthOf(b: number) {
        if (const d = depth.get(b)) return d
        if (b === g.root) return 0
        const p = preds.get(b)
        assert(p)
        let r = 0
        for (const x of p) {
            r = Math.max(depthOf(x), r)
        }
        r += 1
        depth.set(b, r)
        return r
    }
    const firstPossibleUseCache = new Map<number, number>()
    function firstPossibleUse(vid: number) {
        if (!vid) return -1
        if (const x = pinned.get(vid)) return x
        const n = getNode(g, vid)
        if (!n || countIds(n) === 0) return -1
        if (n.op === NodeOp.block) return -1
        if (const x = firstPossibleUseCache.get(vid)) return x
        let c = -1
        for (let i = 0; i < countIds(n); i++) {
            const q = firstPossibleUse(getRef(n, i))
            if (c === q || q === -1) continue
            if (c === -1 || !ancestorsOf(c).has(q)) {
                c = q
            }
        }
        firstPossibleUseCache.set(vid, c)
        return c
    }
    function isCapture(from: number, vid: number) {
        if (!vid) return false
        if (const x = pinned.get(vid)) return x !== from
        const n = getNode(g, vid)
        if (!n || n.op === NodeOp.block) return false
        for (let i = 0; i < countIds(n); i++) {
            if (isCapture(from, getRef(n, i))) return true
        }
        return false
    }
    const blocksForPlacement = new Map<number, number[]>()
    function placeBlock(bid: number) {
        if (!blocksForPlacement.has(bid)) {
            blocksForPlacement.set(bid, [])
        }
        return bid
    }
    const placements = new Map<number, number[]>()
    function addPlacements(vid: number, s: Set<number>) {
        if (const b = pinned.get(vid)) {
            placements.set(vid, [placeBlock(b)])
            return
        }

        const m = firstPossibleUse(vid)
        if (m === -1) return
        const l = uniqueLca(s)
        if (m === l) {
            placements.set(vid, [placeBlock(m)])
            return
        }
        const c = new Set(ancestorsOf(l))
        c.add(l)
        for (const x of ancestorsOf(m)) {
            c.delete(x)
        }
        const res = [...c]
        res.sort((a, b) => depthOf(a) - depthOf(b))
        let nested = 1
        while (nested < res.length && ancestorsOf(res[nested]).has(res[nested - 1])) nested++
        res.length = nested
        assert(res.includes(m), `package: ${g.name ?? '<anonymous>'} placement for %${vid} misses B${m} (uses B${[...s].join(',B')}, lca B${l})`)
        const kept = res.filter(b => withinLoopsOf(b, m))
        if (!kept.includes(l) && s.size === 1 && s.has(l) && !evaluatedPerIteration(l, vid, m)) kept.push(l)
        placements.set(vid, kept.map(placeBlock))
    }
    function pinBlock(bid: number) {
        function pinTail(vid: number, tail = true) {
            if (!vid) return
            if (const u = getNode(g, vid)) {
                if (u.op === NodeOp.param) return

                if (u.op === NodeOp.apply) {
                    pinned.set(vid, bid)
                    for (let i = 1; i < countIds(u); i++) {
                        pinTail(getRef(u, i), false)
                    }
                } else if (u.op === NodeOp.select) {
                    if (!tail) return
                    pinned.set(vid, bid)
                    for (let i = 1; i < countIds(u); i++) {
                        pinTail(getRef(u, i), true)
                    }
                } else if (u.op === NodeOp.ret) {
                    pinned.set(vid, bid)
                } else if (u.op === NodeOp.after) {
                    if (!tail) return
                    pinned.set(vid, bid)
                    pinTail(getRef(u, countIds(u) - 1), true)
                }
            }
        }
        pinTail(getBlock(g, bid)!.bodyId)
    }
    for (const b of g.blocks) {
        pinBlock(b.id)
    }
    for (const [k, v] of seenInBlock) {
        const n = getNode(g, k)!
        if (isPlaceholder(n)) {
            addPlacements(k, v)
            continue
        }
        if (!countIds(n)) continue
        if (TargetingValues.has(n.op)) continue
        addPlacements(k, v)
    }

    for (const [k] of blocksForPlacement) {
        const s = successors.get(k)
        if (!s) continue
        blocksForPlacement.set(k, [...s].filter(x => blocksForPlacement.has(x)))
    }
    // console.log(blocksForPlacement)
    // for (const [k, v] of placements) {
    //     console.log(k, v)
    // }
    // console.log(dumpGraph(g))
    const solved = solvePlacements(g, placements, blocksForPlacement, placementRegions && {
        onRegion: (name, ms) => placementRegions.set(name, (placementRegions.get(name) ?? 0) + ms),
    })
    function computedAt(u: number, bid: number): boolean {
        const n = getNode(g, u)
        if (n?.op === NodeOp.get && getNode(g, getRef(n, 0))?.op === NodeOp.call) return computedAt(getRef(n, 0), bid)
        const pin = pinned.get(u)
        if (pin !== undefined) return pin === bid
        const placed = solved.placements.get(u)
        return placed === undefined || placed === bid || firstPossibleUse(u) === bid
    }
    const threaded = new Map<number, number[]>()
    const needed = new Map<number, Set<number>>()
    const work: [block: number, value: number][] = []
    for (const b of g.blocks) work.push([b.id, b.bodyId])
    while (work.length) {
        const [bid, vid] = work.pop()!
        const n = vid ? getNode(g, vid) : undefined
        if (!n || n.op === NodeOp.block || (!countIds(n) && !isPlaceholder(n))) continue
        let have = needed.get(bid)
        if (!have) needed.set(bid, have = new Set())
        if (have.has(vid)) continue
        have.add(vid)
        if (computedAt(vid, bid)) {
            for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) work.push([bid, getRef(n, i)])
            continue
        }
        if (bid === g.root) {
            console.log(dumpBlockGraph(g))
            console.log(errorDump(g))
            throw `found the root block capturing a value: ${vid}`
        }
        const list = threaded.get(bid)
        if (list) list.push(vid)
        else threaded.set(bid, [vid])
        for (const pred of savedPreds.get(bid) ?? []) work.push([pred, vid])
    }
    const rank = new Map<number, number>()
    for (const vid of solved.placements.keys()) rank.set(vid, rank.size)
    const params = new Map<number, Map<number, number>>()
    for (const [bid, vals] of threaded) {
        const b = getBlock(g, bid)!
        const mapping = new Map<number, number>()
        for (const vid of vals) assert(rank.has(vid), `package: threaded %${vid} has no placement`)
        vals.sort((a, b) => rank.get(a)! - rank.get(b)!)
        for (const vid of vals) {
            const id = newId(g)
            mapping.set(vid, id)
            b.params.push(id)
            putNode(g, id, NodeOp.param, [], valueType(g, getNode(g, vid)!))
        }
        params.set(bid, mapping)
    }
    for (const b of g.blocks) {
        const mapping = params.get(b.id)
        const memo = new Map<number, number>()
        function rewrite(id: number): number {
            if (!id) return id
            const mapped = mapping?.get(id) ?? memo.get(id)
            if (mapped !== undefined) return mapped
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.block || n.op === NodeOp.param) return id
            memo.set(id, id)
            let ops: Operand[] | undefined
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const next = rewrite(ref)
                if (next === ref) continue
                ops ??= getOperands(g, n)
                ops[i] = next
            }
            const extra = n.op === NodeOp.apply ? threaded.get(getRef(n, 0)) : undefined
            if (!ops && !extra) return id
            const fresh = addCopy(g, n, [...ops ?? getOperands(g, n), ...extra?.map(rewrite) ?? []])
            memo.set(id, fresh)
            return fresh
        }
        b.bodyId = rewrite(b.bodyId)
    }
    return finish()
}

const optimizeTimers = intrinsics.argv().includes('optimize-stats') ? new Map<string, number>() : undefined
const optimizeChanges = new Map<string, [calls: number, changes: number]>()
const optimizeIdle = new Map<string, number>()

export function isJumbo(g: Graph): boolean {
    return g.nodes.size > 1_000
}

const optimizeRounds = Number(intrinsics.argv().find(a => a.startsWith('optimize-rounds:'))?.slice(16) ?? 0)
const disabledPasses = new Set(intrinsics.argv().filter(a => a.startsWith('no-pass:')).map(a => a.slice(8)))
const unswitchScan = intrinsics.argv().includes('unswitch-scan')
const verifySweeps = intrinsics.argv().includes('verify-sweeps')
const UnswitchableOps = new Set([NodeOp.eq, NodeOp.ne, NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.add, NodeOp.sub, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.not, NodeOp.neg])

function debugsGraph(flag: string, g: Graph): boolean {
    return intrinsics.argv().includes(flag) || (g.name !== undefined && intrinsics.argv().includes(`${flag}:${g.name}`))
}

function recordPass(key: string, elapsed: number, changed: boolean | undefined): void {
    if (!optimizeTimers) return
    optimizeTimers.set(key, (optimizeTimers.get(key) ?? 0) + elapsed)
    if (!changed) optimizeIdle.set(key, (optimizeIdle.get(key) ?? 0) + elapsed)
    const counts = optimizeChanges.get(key) ?? [0, 0]
    counts[0]++
    if (changed) counts[1]++
    optimizeChanges.set(key, counts)
}

export function printOptimizeStats(): void {
    if (!optimizeTimers) return
    lowering.printEmitterStats()
    for (const [name, ms] of [...optimizeTimers].sort((a, b) => b[1] - a[1])) {
        const counts = optimizeChanges.get(name)
        const idle = optimizeIdle.get(name)
        console.log('optimize step', ms.toFixed(3), name, counts ? `${counts[1]}/${counts[0]}` : '', idle !== undefined ? `idle ${idle.toFixed(3)}` : '')
    }
    for (const [name, ms] of [...placementRegions!].sort((a, b) => b[1] - a[1])) console.log('placement region', ms.toFixed(1), name)
    placementRegions!.clear()
    optimizeTimers.clear()
    optimizeChanges.clear()
    optimizeIdle.clear()
}

const ResultUsedFlag = 1
const FoldableOps = new Set([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.pow, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.convert])

export const MemFresh = 0, MemPre = 1, MemUnknown = 2, MemInt = 3

export function zeroWhenZero(g: Graph, arrivalsOf: (block: GraphBlock) => number[]): (value: number, valueLiteral: number, tag: number, tagLiteral: number) => boolean {
    let owners: Map<number, [block: GraphBlock, index: number]> | undefined
    function ownerOf(param: number): [block: GraphBlock, index: number] | undefined {
        if (!owners) {
            owners = new Map()
            for (const b of g.blocks) for (let i = 0; i < b.params.length; i++) owners.set(b.params[i], [b, i])
        }
        return owners.get(param)
    }
    const assumed = new Set<string>()
    let budget = 0
    function resolve(id: number, literal: number): [ref: number, literal: number] {
        while (id) {
            const n = getNode(g, id)!
            if (n.op === NodeOp.literal) return [0, literalValue(g, n)]
            if (n.op !== NodeOp.after) return [id, 0]
            const last = countIds(n) - 1
            literal = getLiteral(g, n, last)
            id = getRef(n, last)
        }
        return [0, literal]
    }
    function arms(value: GraphNode, tag: number): boolean {
        for (let i = 1; i < countIds(value); i++) {
            if (!holds(getRef(value, i), getLiteral(g, value, i), tag, 0)) return false
        }
        return true
    }
    function holds(value: number, valueLiteral: number, tag: number, tagLiteral: number): boolean {
        if (++budget > 64) return false
        const [y, yk] = resolve(value, valueLiteral)
        const [t, tk] = resolve(tag, tagLiteral)
        if (!y && yk === 0) return true
        if (!t) return tk !== 0
        if (y === t) return true
        if (!y) return false
        const ny = getNode(g, y)!
        const nt = getNode(g, t)!
        if (nt.op === NodeOp.ne && countIds(nt) === 2 && !comparesFloats(g, nt)) {
            if (getRef(nt, 0) === y && !getRef(nt, 1) && getLiteral(g, nt, 1) === 0) return true
            if (getRef(nt, 1) === y && !getRef(nt, 0) && getLiteral(g, nt, 0) === 0) return true
        }
        if (ny.op === NodeOp.convert) return holds(getRef(ny, 0), getLiteral(g, ny, 0), t, 0)
        if (ny.op === NodeOp.select && nt.op === NodeOp.select && getRef(ny, 0) && getRef(ny, 0) === getRef(nt, 0) && countIds(ny) === countIds(nt)) {
            for (let i = 1; i < countIds(ny); i++) {
                if (!holds(getRef(ny, i), getLiteral(g, ny, i), getRef(nt, i), getLiteral(g, nt, i))) return false
            }
            return true
        }
        if (ny.op === NodeOp.select) return arms(ny, t)
        if (nt.op === NodeOp.select) {
            for (let i = 1; i < countIds(nt); i++) {
                if (!holds(y, 0, getRef(nt, i), getLiteral(g, nt, i))) return false
            }
            return true
        }
        if (ny.op === NodeOp.get && nt.op === NodeOp.get) {
            if (getRef(ny, 0) !== getRef(nt, 0) || getRef(ny, 1) || getRef(nt, 1)) return false
            if (getLiteral(g, ny, 1) !== 0 || getLiteral(g, nt, 1) !== 1) return false
            const call = getNode(g, getRef(ny, 0))
            return call?.op === NodeOp.call && !!callSummary(g, call)?.tagged
        }
        if (ny.op !== NodeOp.param || nt.op !== NodeOp.param) return false
        const a = ownerOf(y)
        const b = ownerOf(t)
        if (!a || !b || a[0] !== b[0] || a[0] === g.blocks[0]) return false
        const key = `${y}:${t}`
        if (assumed.has(key)) return true
        assumed.add(key)
        const arrivals = arrivalsOf(a[0])
        if (!arrivals.length) return false
        for (const id of arrivals) {
            const app = getNode(g, id)!
            if (countIds(app) !== a[0].params.length + 1) return false
            if (!holds(getRef(app, a[1] + 1), getLiteral(g, app, a[1] + 1), getRef(app, b[1] + 1), getLiteral(g, app, b[1] + 1))) return false
        }
        return true
    }
    return (value, valueLiteral, tag, tagLiteral) => {
        assumed.clear()
        budget = 0
        return holds(value, valueLiteral, tag, tagLiteral)
    }
}

const IntegerOps = new Set([NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.xor, NodeOp.neg, NodeOp.not, NodeOp.clz, NodeOp.crc32, NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne])
const MemAbsolute = 0
export interface Mem { base: number, pos: number | undefined, kind: number, pending?: boolean }
export interface MemAnalysis {
    of(id: number): Mem
    access(n: GraphNode): Mem | undefined
    disjoint(a: GraphNode, b: GraphNode): boolean
    covers(outer: GraphNode, inner: GraphNode): boolean
    clobbers(call: number, load: GraphNode, returned?: number): boolean
    flows(root: number, viaReturn: boolean): MemFlow
    users(id: number): Iterable<number>
}
export interface MemFlow { own: boolean, calls: [call: number, arg: number][], reached: Set<number> }
export interface CallOutcomes {
    literals: Map<number, [effect: number, mask: number]>
    excluding: Map<number, [effect: number, mask: number]>
    other: [effect: number, mask: number] | undefined
}

export const EffectNone = 0
export const EffectRead = 1
export const EffectWrite = 2
const ArgBits = 28
export const WritesUnknown = 1 << 30
export const WritesStack = 1 << 29
export const CapturesAll = (1 << ArgBits) - 1

export function argBit(k: number): number {
    return k >= 0 && k < ArgBits ? 1 << k : 0
}

export function hasArg(mask: number, k: number): boolean {
    return k >= ArgBits || (mask & (1 << k)) !== 0
}

export function maskArgs(mask: number): number[] {
    const args: number[] = []
    for (let k = 0; k < ArgBits; k++) {
        if (mask & (1 << k)) args.push(k)
    }
    return args
}

export interface CallSummary {
    effect: number
    writes: number
    fresh: boolean
    tagged: boolean
    captures: number
    deepCaptures: number
    outcomes: CallOutcomes | undefined
}

export const unknownCall: CallSummary = { effect: EffectWrite, writes: WritesUnknown, fresh: false, tagged: false, captures: CapturesAll, deepCaptures: CapturesAll, outcomes: undefined }

const SummarySlots = 7

export function encodeCallSummary(symbol: number, s: CallSummary): number[] {
    const slots = [symbol, s.effect, s.writes, s.fresh ? 1 : 0, s.tagged ? 1 : 0, s.captures, s.deepCaptures]
    const outcomes = s.outcomes
    if (!outcomes) return slots
    slots.push(outcomes.literals.size, outcomes.excluding.size, outcomes.other?.[0] ?? -1, outcomes.other?.[1] ?? 0)
    for (const table of [outcomes.literals, outcomes.excluding]) {
        for (const [value, [effect, mask]] of table) slots.push(value, effect, mask)
    }
    return slots
}

export function callSummary(g: NodeSpace, call: GraphNode): CallSummary | undefined {
    const target = getNode(g, getRef(call, 1))
    if (gn.localSymbol(g, target) === undefined) return undefined
    const count = countIds(target!)
    if (count === 1) return unknownCall
    assert(count === SummarySlots || (count > SummarySlots + 3 && count === SummarySlots + 4 + 3 * (getLiteral(g, target!, SummarySlots) + getLiteral(g, target!, SummarySlots + 1))), `lowering: local-target %${getRef(call, 1)} carries ${count} operands, which is no call summary layout`)
    return {
        effect: getLiteral(g, target!, 1),
        writes: getLiteral(g, target!, 2),
        fresh: getLiteral(g, target!, 3) !== 0,
        tagged: getLiteral(g, target!, 4) !== 0,
        captures: getLiteral(g, target!, 5),
        deepCaptures: getLiteral(g, target!, 6),
        outcomes: countIds(target!) > SummarySlots ? decodeCallOutcomes(g, target!) : undefined,
    }
}

function decodeCallOutcomes(g: NodeSpace, target: GraphNode): CallOutcomes {
    const literals = getLiteral(g, target, SummarySlots)
    const excluding = getLiteral(g, target, SummarySlots + 1)
    const other = getLiteral(g, target, SummarySlots + 2)
    const out: CallOutcomes = { literals: new Map(), excluding: new Map(), other: other < 0 ? undefined : [other, getLiteral(g, target, SummarySlots + 3)] }
    for (let i = 0; i < literals + excluding; i++) {
        const at = SummarySlots + 4 + i * 3
        const table = i < literals ? out.literals : out.excluding
        table.set(getLiteral(g, target, at), [getLiteral(g, target, at + 1), getLiteral(g, target, at + 2)])
    }
    return out
}

export function summaryEffect(s: CallSummary, returned?: number): [effect: number, writes: number] {
    if (returned === undefined || !s.outcomes) return [s.effect, s.writes]
    let joined = s.outcomes.other?.[0] ?? -1
    let writes = s.outcomes.other?.[1] ?? 0
    for (const [value, [effect, mask]] of s.outcomes.literals) {
        if (value !== returned) continue
        joined = Math.max(joined, effect)
        writes |= mask
    }
    for (const [value, [effect, mask]] of s.outcomes.excluding) {
        if (value === returned) continue
        joined = Math.max(joined, effect)
        writes |= mask
    }
    return joined < 0 ? [EffectNone, 0] : [joined, writes]
}

function usedPastToken(n: GraphNode, x: number): boolean {
    for (let i = 1; i < countIds(n); i++) if (getRef(n, i) === x) return true
    return false
}

export function memAnalysis(g: Graph, inbound?: (block: GraphBlock) => number[], dependents?: (id: number) => Iterable<number>): MemAnalysis {
    const cache = new Map<number, Mem>()
    const arrivals = new Map<number, [ref: number, literal: number][]>()
    const inFlight = new Set<number>()
    let owners: Map<number, GraphBlock> | undefined
    let applies: Map<number, number[]> | undefined
    let pending = 0
    let solving: Set<number> | undefined
    function ownerOf(param: number): GraphBlock | undefined {
        if (!owners) {
            owners = new Map()
            for (const b of g.blocks) for (const p of b.params) owners.set(p, b)
        }
        return owners.get(param)
    }
    function appliesInto(block: GraphBlock): number[] {
        if (inbound) return inbound(block)
        if (!applies) {
            applies = new Map()
            for (const [id, n] of g.nodes) {
                if (n.op !== NodeOp.apply) continue
                const list = applies.get(getRef(n, 0))
                if (list) list.push(id)
                else applies.set(getRef(n, 0), [id])
            }
        }
        return applies.get(block.id) ?? []
    }
    function arrivalsOf(param: number): [ref: number, literal: number][] {
        const known = arrivals.get(param)
        if (known) return known
        const owner = ownerOf(param)!
        const at = owner.params.indexOf(param) + 1
        const list = appliesInto(owner).map((app): [number, number] => {
            const apply = getNode(g, app)!
            return [getRef(apply, at), getLiteral(g, apply, at)]
        })
        arrivals.set(param, list)
        return list
    }
    function inner(param: number): boolean {
        const owner = ownerOf(param)
        return !!owner && owner !== g.blocks[0]
    }
    function of(id: number): Mem {
        const cached = cache.get(id)
        if (cached) return cached
        const before = pending
        const m = compute(id)
        if (!m.pending && pending === before) cache.set(id, m)
        return m
    }
    function compute(id: number): Mem {
        const n = getNode(g, id)
        const own = (kind: number): Mem => ({ base: id, pos: 0, kind })
        if (!n) return own(MemUnknown)
        if (n.op === NodeOp.after) return of(getRef(n, countIds(n) - 1))
        if (n.op === NodeOp.encode && getRef(n, 0)) return of(getRef(n, 0))
        if (n.op === NodeOp.pstack) return own(pstackAllocates(g, n) ? MemFresh : MemUnknown)
        if (n.op === NodeOp.alloca || n.op === NodeOp.mem) return own(MemFresh)
        if (n.op === NodeOp.call) {
            return own(callSummary(g, n)?.fresh ? MemFresh : MemUnknown)
        }
        if (n.op === NodeOp.literal) return { base: MemAbsolute, pos: getLiteral(g, n, 0), kind: MemPre }
        if (n.op === NodeOp.poolEntry) return own(MemPre)
        if (IntegerOps.has(n.op)) return own(MemInt)
        if (n.op === NodeOp.add || n.op === NodeOp.sub) return shifted(id, n)
        if (n.op === NodeOp.select) return settle(id, gather(id, [[getRef(n, 1), getLiteral(g, n, 1)], [getRef(n, 2), getLiteral(g, n, 2)]]))
        if (n.op !== NodeOp.param) return own(MemUnknown)
        if (!ownerOf(id)) return own(MemUnknown)
        if (!inner(id)) return own(MemPre)
        if (solving?.has(id)) {
            pending++
            return { base: id, pos: 0, kind: MemUnknown, pending: true }
        }
        assert(!inFlight.has(id), 'memAnalysis: param queried outside its component')
        solve(id)
        return cache.get(id) ?? own(MemUnknown)
    }
    function shifted(id: number, n: GraphNode): Mem {
        if (n.op === NodeOp.sub && getRef(n, 0) && getRef(n, 1)) {
            const left = of(getRef(n, 0))
            const right = of(getRef(n, 1))
            if (!left.pending && !right.pending && left.kind !== MemInt && left.base === right.base) return { base: id, pos: 0, kind: MemInt }
        }
        const sides: (Mem | undefined)[] = []
        for (let i = 0; i < 2; i++) {
            const m = getRef(n, i) && (i === 0 || n.op === NodeOp.add) ? of(getRef(n, i)) : undefined
            sides.push(m && !m.pending && m.kind === MemInt ? undefined : m)
        }
        if (!sides[0] && !sides[1] && (getRef(n, 0) || getRef(n, 1))) {
            const ints = [0, 1].every(i => !getRef(n, i) || (i === 1 && n.op === NodeOp.sub) || of(getRef(n, i)).kind === MemInt)
            if (ints) return { base: id, pos: 0, kind: MemInt }
        }
        const leads = sides.map(m => !!m && (m.pending || m.kind === MemFresh))
        if (leads[0] && leads[1]) return { base: id, pos: 0, kind: MemUnknown }
        let at = leads[0] ? 0 : leads[1] ? 1 : -1
        if (at < 0) {
            const refs = [0, 1].filter(i => sides[i] !== undefined)
            if (refs.length !== 1) {
                const pre = refs.length > 0 && refs.every(i => sides[i]!.kind === MemPre)
                return { base: id, pos: 0, kind: pre ? MemPre : MemUnknown }
            }
            at = refs[0]
        }
        const base = sides[at]!
        const other = at === 0 ? 1 : 0
        const step = getRef(n, other) ? undefined : getLiteral(g, n, other) * (n.op === NodeOp.sub ? -1 : 1)
        return { base: base.base, pos: base.pos === undefined || step === undefined ? undefined : base.pos + step, kind: base.kind, pending: base.pending }
    }
    interface Gathered { joined: Mem | null, mixed: boolean, pre: boolean, cyclic: boolean, relayed: boolean, ints: number, literals: number, others: number }
    function gathered(): Gathered {
        return { joined: null, mixed: false, pre: true, cyclic: false, relayed: false, ints: 0, literals: 0, others: 0 }
    }
    function gather(self: number, operands: [ref: number, literal: number][]): Gathered {
        const r = gathered()
        for (const [ref, literal] of operands) {
            if (ref === self) continue
            const m = ref ? of(ref) : { base: MemAbsolute, pos: literal, kind: MemPre }
            if (m.pending) {
                r.relayed = true
                if (m.pos !== 0) r.cyclic = true
                continue
            }
            if (m.kind === MemInt) r.ints++
            else if (m.base === MemAbsolute) r.literals++
            else r.others++
            if (m.kind !== MemPre) r.pre = false
            if (r.joined === null) r.joined = m
            else if (r.joined.base !== m.base) r.mixed = true
            else if (r.joined.pos !== m.pos) r.joined = { base: r.joined.base, pos: undefined, kind: r.joined.kind }
        }
        return r
    }
    function integral(r: Gathered): boolean {
        return r.others === 0 && (r.ints > 0 || (r.literals > 0 && r.cyclic))
    }
    function settle(self: number, r: Gathered): Mem {
        if (integral(r)) return { base: self, pos: 0, kind: MemInt }
        if (r.mixed) return { base: self, pos: 0, kind: r.pre ? MemPre : MemUnknown }
        if (r.joined === null) return { base: self, pos: r.cyclic ? undefined : 0, kind: MemUnknown, pending: r.relayed }
        if (!r.cyclic) return r.joined
        return { base: r.joined.base, pos: undefined, kind: r.joined.kind }
    }
    function paramDeps(param: number): number[] {
        const deps: number[] = []
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id) || cache.has(id)) return
            seen.add(id)
            const n = getNode(g, id)
            if (!n) return
            if (n.op === NodeOp.param) {
                if (inner(id)) deps.push(id)
            } else if (n.op === NodeOp.after) walk(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.add || n.op === NodeOp.sub) {
                walk(getRef(n, 0))
                walk(getRef(n, 1))
            } else if (n.op === NodeOp.select) {
                walk(getRef(n, 1))
                walk(getRef(n, 2))
            }
        }
        for (const [ref] of arrivalsOf(param)) walk(ref)
        return deps
    }
    function solve(root: number): void {
        const index = new Map<number, number>()
        const low = new Map<number, number>()
        const stack: number[] = []
        const frames: { v: number, deps: number[], at: number }[] = []
        function enter(v: number): void {
            index.set(v, index.size)
            low.set(v, index.get(v)!)
            stack.push(v)
            inFlight.add(v)
            frames.push({ v, deps: paramDeps(v), at: 0 })
        }
        enter(root)
        while (frames.length) {
            const frame = frames[frames.length - 1]
            if (frame.at < frame.deps.length) {
                const w = frame.deps[frame.at++]
                if (cache.has(w)) continue
                if (!index.has(w)) {
                    if (!inFlight.has(w)) enter(w)
                } else if (inFlight.has(w)) low.set(frame.v, Math.min(low.get(frame.v)!, index.get(w)!))
                continue
            }
            frames.pop()
            if (frames.length) {
                const parent = frames[frames.length - 1].v
                low.set(parent, Math.min(low.get(parent)!, low.get(frame.v)!))
            }
            if (low.get(frame.v) !== index.get(frame.v)) continue
            const scc: number[] = []
            for (;;) {
                const w = stack.pop()!
                scc.push(w)
                if (w === frame.v) break
            }
            solveComponent(scc)
            for (const w of scc) inFlight.delete(w)
        }
    }
    function solveComponent(scc: number[]): void {
        const outerSolving = solving
        solving = new Set(scc)
        const shared = gathered()
        for (const p of scc) {
            const part = gather(p, arrivalsOf(p))
            if (part.cyclic) shared.cyclic = true
            if (part.mixed) shared.mixed = true
            if (!part.pre) shared.pre = false
            shared.ints += part.ints
            shared.literals += part.literals
            shared.others += part.others
            if (part.joined === null) continue
            if (shared.joined === null) shared.joined = part.joined
            else if (shared.joined.base !== part.joined.base) shared.mixed = true
            else if (shared.joined.pos !== part.joined.pos) shared.joined = { base: shared.joined.base, pos: undefined, kind: shared.joined.kind }
        }
        solving = outerSolving
        if (!shared.mixed && !integral(shared)) {
            const value = shared.joined === null ? undefined
                : shared.cyclic ? { base: shared.joined.base, pos: undefined, kind: shared.joined.kind } : shared.joined
            for (const p of scc) cache.set(p, value ?? { base: p, pos: 0, kind: MemUnknown })
            return
        }
        const kind = integral(shared) ? MemInt : shared.pre ? MemPre : MemUnknown
        for (const p of scc) cache.set(p, { base: p, pos: 0, kind })
    }
    function access(n: GraphNode): Mem | undefined {
        const m = getRef(n, 1) ? of(getRef(n, 1)) : { base: MemAbsolute, pos: getLiteral(g, n, 1), kind: MemPre }
        if (m.pending) return
        const kind = m.kind === MemInt ? MemUnknown : m.kind
        return { base: m.base, pos: getRef(n, 2) || m.pos === undefined ? undefined : m.pos + getLiteral(g, n, 2), kind }
    }
    const bytes = (n: GraphNode) => intrinsics.intrinsicBitWidth(typeOf(n)) / 8
    function disjoint(a: GraphNode, b: GraphNode): boolean {
        const x = access(a)
        const y = access(b)
        if (!x || !y) return false
        if (x.base === y.base) {
            if (x.pos === undefined || y.pos === undefined) return false
            return x.pos + bytes(a) <= y.pos || y.pos + bytes(b) <= x.pos
        }
        return (x.kind === MemFresh && y.kind !== MemUnknown) || (y.kind === MemFresh && x.kind !== MemUnknown)
    }
    function covers(outer: GraphNode, inner: GraphNode): boolean {
        const x = access(outer)
        const y = access(inner)
        if (!x || !y || x.base !== y.base || x.pos === undefined || y.pos === undefined) return false
        return x.pos <= y.pos && y.pos + bytes(inner) <= x.pos + bytes(outer)
    }
    let users: Map<number, number[]> | undefined
    function usersOf(id: number): Iterable<number> {
        if (dependents) return dependents(id)
        users ??= nodeUsers(g, g.nodes.keys())
        return users.get(id) ?? []
    }
    const flowCache = new Map<number, MemFlow>()
    function flows(root: number, viaReturn: boolean): MemFlow {
        const key = viaReturn ? -root : root
        const known = flowCache.get(key)
        if (known) return known
        const seen = new Set<number>([root])
        const flow: MemFlow = { own: false, calls: [], reached: seen }
        const work = [root]
        const visit = (id: number) => {
            if (seen.has(id)) return
            seen.add(id)
            work.push(id)
        }
        while (work.length && !flow.own) {
            const x = work.pop()!
            for (const u of usersOf(x)) {
                const n = getNode(g, u)
                if (!n || n.op === NodeOp.load) continue
                if (n.op === NodeOp.store || n.op === NodeOp.ret) {
                    if ((n.op === NodeOp.store ? getRef(n, 3) : viaReturn ? getRef(n, 0) : 0) === x) flow.own = true
                } else if (n.op === NodeOp.call) {
                    for (let i = 1; i < countIds(n); i++) {
                        if (getRef(n, i) !== x) continue
                        if (i < 3) flow.own = true
                        else flow.calls.push([u, i - 3])
                    }
                } else if (n.op === NodeOp.apply) {
                    const block = getBlock(g, getRef(n, 0))
                    for (let i = 1; i < countIds(n); i++) {
                        if (getRef(n, i) !== x) continue
                        if (block) visit(block.params[i - 1])
                        else flow.own = true
                    }
                } else if (n.op === NodeOp.after) {
                    if (getRef(n, countIds(n) - 1) === x) visit(u)
                } else if (n.op === NodeOp.select) {
                    if (getRef(n, 1) === x || getRef(n, 2) === x) visit(u)
                } else if (OrderedValues.has(n.op) && !usedPastToken(n, x)) {
                    continue
                } else if (!CompareOps.has(n.op)) {
                    if (PureOps.has(n.op)) visit(u)
                    else flow.own = true
                }
                if (flow.own) break
            }
        }
        flowCache.set(key, flow)
        return flow
    }
    function escaped(root: number): boolean {
        const flow = flows(root, false)
        return flow.own || flow.calls.some(([call, k]) => hasArg((callSummary(g, getNode(g, call)!) ?? unknownCall).captures, k))
    }
    function clobbers(call: number, load: GraphNode, returned?: number): boolean {
        const n = getNode(g, call)!
        const summary = callSummary(g, n)
        if (!summary) return true
        const [effect, writes] = summaryEffect(summary, returned)
        if (effect !== EffectWrite) return false
        const x = access(load)
        if (!x) return true
        if ((writes & WritesStack) !== 0 && x.base === MemAbsolute) return true
        if (writes & WritesUnknown) {
            if (x.kind !== MemFresh || escaped(x.base)) return true
            return flows(x.base, false).calls.some(([c]) => c === call)
        }
        for (const k of maskArgs(writes)) {
            const arg = getRef(n, 3 + k)
            const y = arg ? of(arg) : { base: MemAbsolute, pos: getLiteral(g, n, 3 + k), kind: MemPre }
            if (y.pending || y.base === x.base) return true
            if (!((x.kind === MemFresh && y.kind !== MemUnknown) || (y.kind === MemFresh && x.kind !== MemUnknown))) return true
        }
        return false
    }
    return { of, access, disjoint, covers, clobbers, flows, users: usersOf }
}

interface CoverBase {
    widest: number
    at: Map<number, number>
}
type Cover = Map<number, CoverBase>[]
function emptyCover(): Cover {
    return [new Map(), new Map(), new Map(), new Map()]
}
const CoverInert = new Set<NodeOp>([NodeOp.after, NodeOp.apply, NodeOp.ret, NodeOp.panic, NodeOp.unreachable, NodeOp.param, NodeOp.pstack, NodeOp.alloca])

interface Promotion {
    ids: Set<number>
    stores: Set<number>
    values: Map<number, [number, number]>
    touched: Set<GraphBlock>
}

function optimizeValueGraph(g: Graph, costs: lowering.TargetCosts) {
    const optimizeStart = performance.now()
    const dependents = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) getNode(g, to)!.scratchFlags |= ResultUsedFlag
        let d = dependents.get(to)
        if (!d) dependents.set(to, d = new Set())
        d.add(from)
    }

    function isResultUsed(id: number): boolean {
        return (getNode(g, id)!.scratchFlags & ResultUsedFlag) !== 0
    }

    function usesForResult(user: number, id: number): boolean {
        const u = getNode(g, user)!
        for (let i = firstNonOrderingSlot(u); i < countIds(u); i++) if (getRef(u, i) === id) return true
        return false
    }

    function usedForResult(id: number): boolean {
        for (const u of dependents.get(id) ?? []) if (usesForResult(u, id)) return true
        return false
    }

    function getGraphBlock(id: number) {
        const b = getBlock(g, id)
        assert(b)
        return b
    }

    const byOp = new Map<number, Map<NodeOp, number[]>>()
    function indexValue(id: number, op: NodeOp, blockId: number) {
        let m = byOp.get(blockId)
        if (!m) byOp.set(blockId, m = new Map())
        let arr = m.get(op)
        if (!arr) m.set(op, arr = [])
        arr.push(id)
    }

    function findValues(blockId: number, op: NodeOp) {
        if (const m = byOp.get(blockId)) {
            return m.get(op)
        }
    }

    interface ArityClosure {
        id: number
        support: number[]
        values: number[]
        inputs: number[]
    }
    interface BlockClosureInfo {
        block: GraphBlock
        termOf: Map<number, number>
        term: (id: number) => number
        closures: ArityClosure[]
        closureOf: Map<number, number>
        byParam: Map<number, number[]>
        bySupport: Map<string, number[]>
    }
    const blockClosureInfo = new Map<number, BlockClosureInfo>()

    function operandEdge(n: GraphNode, i: number): number {
        if (i === 0 && n.op === NodeOp.apply) return 0
        const ref = getRef(n, i)
        return isNilOrVoid(ref) ? 0 : ref
    }

    function reaches(from: number, to: number) {
        const n = getNode(g, from)
        if (!n) return false
        for (let i = 0; i < countIds(n); i++) {
            const u = operandEdge(n, i)
            if (!u) continue
            if (u === to) return true
            if (reaches(u, to)) return true
        }
        return false
    }

    function reachesAnyOf(from: number, to: Set<number>) {
        const n = getNode(g, from)
        if (!n) return false
        for (let i = 0; i < countIds(n); i++) {
            const u = operandEdge(n, i)
            if (!u) continue
            if (to.has(u)) return true
            if (reachesAnyOf(u, to)) return true
        }
        return false
    }

    function collectSubgraph(from: number, dst: Set<number> = new Set(), limit?: number) {
        dst.add(from)
        if (limit !== undefined && dst.size > limit) return dst
        const n = getNode(g, from)
        if (!n) return dst
        for (let i = 0; i < countIds(n); i++) {
            const u = operandEdge(n, i)
            if (!u || dst.has(u)) continue
            collectSubgraph(u, dst, limit)
            if (limit !== undefined && dst.size > limit) return dst
        }
        return dst
    }

    function demandOf(root: number, into: Set<number> = new Set()): Set<number> {
        return demanded(g, root, into, new Map())
    }

    function visitBlock(b: GraphBlock) {
        if (visited.has(b.id)) return
        reachableBlocks.add(b)
        visited.set(b.id, visited.size)
        blockStack.push(b)
        defer blockStack.pop()
        visit(b.bodyId, false)
    }

    const successors = new Map<number, Set<number>>()
    const preds = new Map<number, Set<number>>()
    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reachableBlocks = new Set<GraphBlock>()
    const versions = new Map<number, number>()
    const inboundVersions = new Map<number, number>()
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        const n = getNode(g, id)!
        if (n.op === NodeOp.nilEffect || n.op === NodeOp.void) return
        const seen = visited.has(id)
        if (!seen) n.scratchFlags &= ~ResultUsedFlag
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (seen) return
        visited.set(id, visited.size)

        const currentBlockId = blockStack[blockStack.length-1].id
        if (n.op === NodeOp.param) {
            indexValue(id, NodeOp.param, currentBlockId)
            return
        }

        indexValue(id, n.op, currentBlockId)
        if (!countIds(n)) return

        stack.push(id)
        defer stack.pop()

        if (n.op === NodeOp.after) {
            const last = countIds(n) - 1
            for (let i = 0; i < last; i++) visit(getRef(n, i), false)
            visit(getRef(n, last), true)
            return
        }
        if (n.op === NodeOp.apply) {
            let s = successors.get(currentBlockId)
            if (!s) successors.set(currentBlockId, s = new Set())
            s.add(getRef(n, 0))
            s = preds.get(getRef(n, 0))
            if (!s) preds.set(getRef(n, 0), s = new Set())
            if (!s.has(currentBlockId)) inboundVersions.set(getRef(n, 0), (inboundVersions.get(getRef(n, 0)) ?? 0) + 1)
            s.add(currentBlockId)
            const b = getGraphBlock(getRef(n, 0))
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            const outer = stack.splice(0)
            visitBlock(b)
            stack.push(...outer)
            return
        }
        if (OrderedValues.has(n.op)) {
            visit(getRef(n, 0), false)
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            return
        }
        for (let i = 0; i < countIds(n); i++) {
            visit(getRef(n, i), true)
        }
    }

    function indexGraph() {
        dependents.clear()
        byOp.clear()
        successors.clear()
        preds.clear()
        visited.clear()
        blockStack.length = 0
        reachableBlocks.clear()
        visited.set(0, 0)
        blockStack.push(g.blocks[0])
        reachableBlocks.add(g.blocks[0])
        const bodyId = g.blocks[0].bodyId
        if (bodyId) visit(bodyId, false)
    }
    indexGraph()

    function paramLike(value: number): number {
        const n = value ? getNode(g, value) : undefined
        if (!n) return addParam()
        return addParam(valueType(g, n))
    }

    function addParam(T?: TypeOperand): number {
        return addNode(g, NodeOp.param, [], T)
    }

    function addBlock(params: number[], body: number): number {
        const id = addNode(g, NodeOp.block, [])
        addGraphBlock(g, { id, bodyConst: 0, bodyId: body, params })
        return id
    }

    function removeBlock(b: GraphBlock) {
        cleanBlockData(b)
        reachableBlocks.delete(b)
    }

    function cleanBlockData(b: GraphBlock) {
        blockClosureInfo.delete(b.id)

        if (const s = successors.get(b.id)) {
            successors.delete(b.id)
            for (const x of s) {
                if (const p = preds.get(x)) {
                    p.delete(b.id)
                }
            }
        }

        if (const m = byOp.get(b.id)) {
            byOp.delete(b.id)
            for (const arr of m.values()) {
                for (const id of arr) cleanEdges(id)
            }
            function cleanEdges(id: number) {
                dependents.delete(id)
                visited.delete(id)
            }
        }
    }

    const passVersions = new Map<(b: GraphBlock) => unknown, Map<number, number>>()
    const inboundPassVersions = new Map<(b: GraphBlock) => unknown, Map<number, number>>()
    let graphEpoch = 0
    function touch(b: GraphBlock) {
        graphEpoch++
        versions.set(b.id, (versions.get(b.id) ?? 0) + 1)
        inboundVersions.set(b.id, (inboundVersions.get(b.id) ?? 0) + 1)
        if (const p = successors.get(b.id)) {
            for (const x of p) {
                inboundVersions.set(x, (inboundVersions.get(x) ?? 0) + 1)
            }
        }
    }
    function time(name: string, dur: number) {
        optimizeTimers!.set(name, (optimizeTimers!.get(name) ?? 0) + dur)
    }
    const inboundPasses = new Set<Function>([
        absorbConditions,
        threadConstantBranches,
        threadConstantArrivals,
        threadDecidedArrivals,
        forwardMemory,
        forwardArrivalLoads,
        forwardArrivalCalls,
        liftBlockSelect,
        deriveIncrementor,
        widenCountedStores,
        closeCountedLoop,
        unrollSmallLoop,
        reverseLoop,
        unswitchLoop,
        hoistInvariants,
        hoistLoopInvariants,
        sinkReloadedStores,
        hoistSharedSelectValues,
        eliminatePassthru,
        advanceLoopLoads,
        simplifySelect,
        forwardCongruentValues,
        rematerializeOffsets,
        pruneUnusedParams,
        specializeBlockParameters,
        conditionParams,
        decodeParams,
        substituteEqualArguments,
        specializeApplySite,
        hoistLoopStep,
        rebaseAddresses,
    ])
    const passDebug = debugsGraph('pass-debug', g)
    function step(pass: (b: GraphBlock) => unknown, b: GraphBlock): boolean {
        if (disabledPasses.has(pass.name) || !reachableBlocks.has(b)) return false
        if (!optimizeTimers && !passDebug) return runStep(pass, b)
        const s = performance.now()
        const changed = runStep(pass, b)
        recordPass(pass.name, performance.now() - s, changed)
        if (passDebug && changed) console.log(`--- ${pass.name} changed B${b.id} ---\n${dumpGraph(g)}`)
        return changed
    }
    function runStep(pass: (b: GraphBlock) => unknown, b: GraphBlock): boolean {
        const bid = b.id
        let seen = passVersions.get(pass)
        if (!seen) passVersions.set(pass, seen = new Map())
        const version = versions.get(bid) ?? 0
        const inbound = inboundPasses.has(pass) ? inboundVersions.get(bid) ?? 0 : -1
        let seenInbound = inboundPassVersions.get(pass)
        if (!seenInbound) inboundPassVersions.set(pass, seenInbound = new Map())
        if (seen.get(bid) === version && (inbound < 0 || seenInbound.get(bid) === inbound)) return false
        const changed = !!pass(b)
        if (changed && verifySweeps) sweepChanges.add(pass.name)
        seen.set(bid, version)
        if (inbound >= 0) seenInbound.set(bid, inbound)
        return changed
    }

    const sweepChanges = new Set<string>()
    function verifySweep(): void {
        if (!sweepChanges.size) return
        const stage = `optimize(${[...sweepChanges].join(',')})`
        verifyGraph(g, stage, true)
        verifyTokenSelects(g, stage)
        sweepChanges.clear()
    }

    let didAnyChange = false
    function revisitBlock(b: GraphBlock, incremental = false) {
        touch(b)
        didAnyChange = true
        if (!incremental) {
            cleanBlockData(b)
            visited.delete(b.id)
            visitBlock(b)
            return
        }
        blockClosureInfo.delete(b.id)
        if (const s = successors.get(b.id)) {
            successors.delete(b.id)
            for (const x of s) preds.get(x)?.delete(b.id)
        }
        visited.delete(b.id)
        visitBlock(b)
        const ops = byOp.get(b.id)
        if (!ops) return
        const members = new Set<number>()
        for (const ids of ops.values()) for (const id of ids) members.add(id)
        const dropped = new Set<number>()
        function drop(id: number): void {
            if (dropped.has(id) || id === b.bodyId || !members.has(id) || dependents.get(id)?.size) return
            if (getNode(g, id)?.op === NodeOp.param) return
            dropped.add(id)
            dependents.delete(id)
            visited.delete(id)
            const n = getNode(g, id)
            for (let i = 0; n && i < countIds(n); i++) {
                const d = operandEdge(n, i)
                if (!d) continue
                const users = dependents.get(d)
                if (users) {
                    users.delete(id)
                    if (!users.size) dependents.delete(d)
                }
                const node = getNode(g, d)
                if (node && node.scratchFlags & ResultUsedFlag && !usedForResult(d)) node.scratchFlags &= ~ResultUsedFlag
                drop(d)
            }
        }
        for (const id of members) drop(id)
        if (dropped.size) {
            for (const [op, ids] of [...ops]) {
                const kept = ids.filter(id => !dropped.has(id))
                if (kept.length) ops.set(op, kept)
                else ops.delete(op)
            }
        }
        for (const id of ops.get(NodeOp.apply) ?? []) {
            const to = getRef(getNode(g, id)!, 0)
            let s = successors.get(b.id)
            if (!s) successors.set(b.id, s = new Set())
            s.add(to)
            let p = preds.get(to)
            if (!p) preds.set(to, p = new Set())
            if (!p.has(b.id)) inboundVersions.set(to, (inboundVersions.get(to) ?? 0) + 1)
            p.add(b.id)
        }
    }

    let factsPending: number[] | undefined
    function replaceAll(id: number, replacements: Map<number, number>, given?: number): number {
        const top = given === undefined && !factsPending
        if (top) factsPending = []
        const result = replaceWalk(id, replacements, given ?? nextEpoch(g))
        if (top) {
            const pending = factsPending!
            factsPending = undefined
            if (pending.length) remapFacts(pending, replacements)
        }
        return result
    }

    function remapFacts(pending: number[], replacements: Map<number, number>): void {
        for (const id of pending) {
            const n = getNode(g, id)
            const fact = n ? gn.factOf(n) : 0
            if (!fact || !g.facts?.has(fact)) continue
            const next = substituteFact(g, fact, x => {
                const r = replacements.get(x)
                return r ? captureFact(g, r) : undefined
            })
            if (next !== fact) gn.setFact(n!, next)
        }
    }

    function replaceWalk(id: number, replacements: Map<number, number>, epoch: number): number {
        if (!id) return id
        if (const replacement = replacements.get(id)) {
            return replacement
        }
        const n = getNode(g, id)!
        if (n.op === NodeOp.param) return id
        if (!markVisited(n, epoch)) return id
        const refSlots = countIds(n)
        const idReplacements: [idx: number, id: number][] = []
        for (let i = 0; i < refSlots; i++) {
            const r = gn.getRef(n, i)
            const next = replaceWalk(r, replacements, epoch)
            if (next !== r) { 
                idReplacements.push([i, next])
            }
        }
        if (!idReplacements.length) {
            if (gn.factOf(n)) factsPending?.push(id)
            return id
        }
        const slots = n.slots.slice()
        for (let i = 0; i < slots.length && idReplacements.length; i++) {
            if (idReplacements[0]![0] === i) {
                slots[i] = gn.encodeSlot(g, idReplacements.shift()![1], 0) as u32
            }
        }
        const copy = insertNode(g, gn.makeNodeFromSlots(n.op, slots, n.flags))
        replacements.set(id, copy)
        if (gn.factOf(n)) factsPending?.push(copy)
        return copy
    }

    function replaceTransitive(id: number, replacements: Map<number, number>, memo = new Map<number, number>(), epoch = nextEpoch(g)): number {
        if (!id) return id
        const known = memo.get(id)
        if (known !== undefined) return known
        const replacement = replacements.get(id)
        if (replacement !== undefined && replacement !== id) {
            memo.set(id, id)
            const result = replaceTransitive(replacement, replacements, memo, epoch)
            memo.set(id, result)
            return result
        }
        const n = getNode(g, id)!
        if (n.op === NodeOp.param || !markVisited(n, epoch)) return id
        let slots: u32[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            const r = gn.getRef(n, i)
            const next = replaceTransitive(r, replacements, memo, epoch)
            if (next === r) continue
            slots ??= n.slots.slice()
            slots[i] = gn.encodeSlot(g, next, 0) as u32
        }
        if (!slots) return id
        const copy = insertNode(g, gn.makeNodeFromSlots(n.op, slots, n.flags))
        memo.set(id, copy)
        return copy
    }

    function findInboundApplies(target: GraphBlock) {
        if (target.id === g.root) return []
        const res: [blockId: number, valId: number][] = []
        function visit(b: GraphBlock) {
            const applies = findValues(b.id, NodeOp.apply)!
            for (const u of applies) {
                const n = getNode(g, u)!
                const t = getRef(n, 0)
                if (t !== target.id) continue
                res.push([b.id, u])
            }
        }
        const x = preds.get(target.id)
        if (!x) return res
        for (const k of x) {
            visit(getGraphBlock(k))
        }
        return res
    }

    function skipAfter(id: number) {
        while (id) {
            const n = getNode(g, id)
            if (!n) return
            if (n.op === NodeOp.after) {
                id = getRef(n, countIds(n)-1)
                continue
            }
            return id
        }
        return
    }

    function onlyTested(decoded: number): boolean {
        for (const u of dependents.get(decoded) ?? []) {
            const n = getNode(g, u)!
            if (n.op === NodeOp.select && getRef(n, 0) === decoded && getRef(n, 1) !== decoded && getRef(n, 2) !== decoded) continue
            if ((n.op === NodeOp.load || n.op === NodeOp.store) && getArgIds(n).every((x, i) => x !== decoded || i === 1)) continue
            if (n.op === NodeOp.after && getRef(n, countIds(n) - 1) !== decoded) continue
            return false
        }
        return true
    }

    function foldBooleanSelects(target: GraphBlock): boolean {
        const selects = findValues(target.id, NodeOp.select)
        if (!selects?.length) return false
        const known = new Map<number, boolean>()
        function booleanOperand(n: GraphNode, slot: number, depth: number): boolean {
            const ref = getRef(n, slot)
            if (ref) return booleanValue(ref, depth)
            const k = getLiteral(g, n, slot)
            return k === 0 || k === 1
        }
        function booleanValue(id: number, depth: number): boolean {
            const n = getNode(g, id)!
            if (CompareOps.has(n.op)) return true
            if (n.op === NodeOp.literal) return literalValue(g, n) === 0 || literalValue(g, n) === 1
            const prior = known.get(id)
            if (prior !== undefined) return prior
            if (depth >= 16) return false
            const select = n.op === NodeOp.select && countIds(n) === 3
            const bits = (n.op === NodeOp.and || n.op === NodeOp.or || n.op === NodeOp.xor) && countIds(n) === 2
            if (!select && !bits) return false
            const first = select ? 1 : 0
            const result = booleanOperand(n, first, depth + 1) && booleanOperand(n, first + 1, depth + 1)
            known.set(id, result)
            return result
        }
        function scalarCompare(id: number, condition: number): boolean {
            const n = getNode(g, id)!
            if (!CompareOps.has(n.op)) return false
            let guarded: Set<number> | undefined
            for (let i = 0; i < countIds(n); i++) {
                const operand = getNode(g, getRef(n, i))
                if (!operand || operand.op === NodeOp.param || operand.op === NodeOp.literal) continue
                guarded ??= cone(condition, new Set())
                if (!guarded.has(getRef(n, i))) return false
            }
            return true
        }
        const replacements = new Map<number, number>()
        for (const id of selects) {
            const n = getNode(g, id)!
            if (countIds(n) !== 3 || !getRef(n, 0)) continue
            const condition = getRef(n, 0)
            const truthy = getRef(n, 1) === condition || (!getRef(n, 1) && getLiteral(g, n, 1) === 1)
            const falsy = getRef(n, 2) === condition || (!getRef(n, 2) && getLiteral(g, n, 2) === 0)
            if (!truthy && !falsy) continue
            const either = truthy
            const slot = either ? 2 : 1
            const arm = getRef(n, slot) === condition ? 0 : getRef(n, slot)
            if (!arm && !(either ? falsy : truthy)) continue
            if (arm && !scalarCompare(arm, condition)) continue
            if (!booleanValue(condition, 0)) continue
            replacements.set(id, arm ? addNode(g, either ? NodeOp.or : NodeOp.and, [condition, arm], Types.u64) : condition)
        }
        if (!replacements.size) return false
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function foldMembershipTests(target: GraphBlock): boolean {
        const replacements = new Map<number, number>()
        for (const op of [NodeOp.or, NodeOp.and]) {
            const roots = findValues(target.id, op)
            if (!roots?.length) continue
            for (const root of roots) {
                const folded = membershipTest(root, op === NodeOp.or ? NodeOp.eq : NodeOp.ne)
                if (folded) replacements.set(root, folded)
            }
        }
        if (!replacements.size) return false
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function chainLink(id: number, op: NodeOp, T: Types): boolean {
        const n = getNode(g, id)
        return n?.op === op && countIds(n) === 2 && typeOf(n) === T
    }

    function collectChain(n: GraphNode, leaves: Operand[]): void {
        for (let i = 0; i < 2; i++) {
            const ref = getRef(n, i)
            if (ref && chainLink(ref, n.op, typeOf(n)) && dependents.get(ref)?.size === 1) collectChain(getNode(g, ref)!, leaves)
            else leaves.push(getOperand(g, n, i))
        }
    }

    function memberRange(leaf: Operand, test: NodeOp): [subject: number, lo: number, count: number, cost: number] | undefined {
        if (typeof leaf !== 'number') return
        const c = getNode(g, leaf)!
        if (countIds(c) !== 2 || comparesFloats(g, c)) return
        const integral = (T: Types) => T <= Types.i64 || T === Types.bool
        if (c.op === test) {
            const left = scalarOperand(g, g.nodes, c, 0)
            const right = scalarOperand(g, g.nodes, c, 1)
            const side = left === undefined && right !== undefined ? 0 : right === undefined && left !== undefined ? 1 : -1
            if (side < 0) return
            const k = side === 0 ? right! : left!
            if (!Number.isSafeInteger(k) || !integral(operandType(g, c, side))) return
            return [getRef(c, side), k, 1, 1]
        }
        const below = test === NodeOp.eq ? c.op === NodeOp.lt || c.op === NodeOp.le : c.op === NodeOp.ge || c.op === NodeOp.gt
        if (!below || !getRef(c, 0) || getRef(c, 1)) return
        const T = operandType(g, c, 0)
        if (!integral(T) || lowering.isSignedType(T)) return
        const bound = getLiteral(g, c, 1)
        const count = c.op === NodeOp.lt || c.op === NodeOp.ge ? bound : bound + 1
        if (!Number.isSafeInteger(count) || count < 1) return
        const index = getRef(c, 0)
        const m = getNode(g, index)!
        if (typeOf(m) === Types.u64 && countIds(m) === 2 && getRef(m, 0) && integral(operandType(g, m, 0))) {
            const k = scalarOperand(g, g.nodes, m, 1)
            if (k !== undefined && Number.isSafeInteger(k) && m.op === NodeOp.sub) return [getRef(m, 0), k, count, 2]
            if (k !== undefined && Number.isSafeInteger(k) && m.op === NodeOp.add) return [getRef(m, 0), -k, count, 2]
        }
        if (m.op === NodeOp.convert && typeOf(m) === Types.u64 && getRef(m, 0) && integral(operandType(g, m, 0))) return [getRef(m, 0), 0, count, 1]
        return [index, 0, count, 1]
    }

    function membershipTest(root: number, test: NodeOp): number {
        const n = getNode(g, root)!
        if (countIds(n) !== 2) return 0
        const users = dependents.get(root)
        if (users?.size === 1 && chainLink([...users][0], n.op, typeOf(n))) return 0
        const leaves: Operand[] = []
        collectChain(n, leaves)
        if (leaves.length < 2) return 0
        const members = leaves.map(leaf => memberRange(leaf, test))
        const bySubject = new Map<number, number[]>()
        for (let i = 0; i < members.length; i++) {
            const member = members[i]
            if (!member) continue
            const indices = bySubject.get(member[0])
            if (indices) indices.push(i)
            else bySubject.set(member[0], [i])
        }
        const tests = new Map<number, number>()
        for (const [subject, indices] of bySubject) {
            if (indices.length < 2) continue
            indices.sort((i, j) => members[i]![1] - members[j]![1])
            let start = 0
            while (start < indices.length) {
                const lo = members[indices[start]]![1]
                let hi = lo + members[indices[start]]![2]
                let cost = members[indices[start]]![3]
                let end = start + 1
                while (end < indices.length && members[indices[end]]![1] <= hi) {
                    hi = Math.max(hi, members[indices[end]]![1] + members[indices[end]]![2])
                    cost += members[indices[end]]![3]
                    end++
                }
                if (cost > (lo === 0 ? 1 : 2) && Number.isSafeInteger(hi)) {
                    const tested = rangeTest(subject, lo, hi - lo, test)
                    for (let k = start; k < end; k++) tests.set(indices[k], tested)
                }
                start = end
            }
        }
        if (!tests.size) return 0
        const kept: Operand[] = []
        const placed = new Set<number>()
        for (let i = 0; i < leaves.length; i++) {
            const tested = tests.get(i)
            if (tested === undefined) {
                kept.push(leaves[i])
                continue
            }
            if (placed.has(tested)) continue
            placed.add(tested)
            kept.push(tested)
        }
        let folded = kept[0]
        for (let i = 1; i < kept.length; i++) folded = addCopy(g, n, [folded, kept[i]])
        return typeof folded === 'number' ? folded : 0
    }

    function rangeTest(subject: number, lo: number, count: number, test: NodeOp): number {
        let index = subject
        if (lo > 0) index = addNode(g, NodeOp.sub, [subject, { literal: lo }], Types.u64)
        else if (lo < 0) index = addNode(g, NodeOp.add, [subject, { literal: -lo }], Types.u64)
        else if (lowering.isSignedType(resultType(g, getNode(g, subject)!))) index = addNode(g, NodeOp.convert, [subject], Types.u64)
        return addNode(g, test === NodeOp.eq ? NodeOp.lt : NodeOp.ge, [index, { literal: count }], Types.bool)
    }

    function simplifySelect(target: GraphBlock) {
        const loops = (id: number) => {
            const n = getNode(g, skipAfter(id) ?? 0)
            return n?.op === NodeOp.apply && getRef(n, 0) === target.id
        }
        const diverges = (n: GraphNode, arm: number) => {
            if (!isUnreachable(skipAfter(getRef(n, arm)) ?? 0)) return false
            const others: number[] = []
            for (let i = 0; i < countIds(n); i++) if (i !== arm && getRef(n, i)) others.push(getRef(n, i))
            return panicOrdering(g, getRef(n, arm)).every(t => others.some(o => o === t || precedes(t, o)))
        }
        function sameArms(n: GraphNode): boolean {
            if (countIds(n) !== 3 || !getRef(n, 1) || !getRef(n, 2)) return false
            const a = tailPositions(g, getRef(n, 1))
            const b = tailPositions(g, getRef(n, 2))
            return a.length > 0 && a.length === b.length && a.every((p, i) => {
                const q = b[i]
                const left = new Set<number>()
                const right = new Set<number>()
                for (const t of p.tokens) orderingParts(t, left)
                for (const t of q.tokens) orderingParts(t, right)
                return p.at === q.at && left.size === right.size && [...left].every(t => right.has(t))
                    && p.path.length === q.path.length && p.path.every(([select, arm], j) => q.path[j][0] === select && q.path[j][1] === arm)
            })
        }
        let vanishes: ((value: number, valueLiteral: number, tag: number, tagLiteral: number) => boolean) | undefined
        function agree(x: number, xk: number, y: number, yk: number, tag: number, held: number, depth: number): boolean {
            if (x && getNode(g, x)!.op === NodeOp.literal) {
                xk = literalValue(g, getNode(g, x)!)
                x = 0
            }
            if (y && getNode(g, y)!.op === NodeOp.literal) {
                yk = literalValue(g, getNode(g, y)!)
                y = 0
            }
            if (x === y && (x || xk === yk)) return true
            if (!x && xk === 0 && held === 0) {
                vanishes ??= zeroWhenZero(g, b => findInboundApplies(b).map(([, app]) => app))
                return vanishes(y, yk, tag, 0)
            }
            if (!x && xk === held && y === tag) return true
            if (!y && yk === held && x === tag) return true
            if (!x || !y || depth > 3) return false
            const a = getNode(g, x)!
            const b = getNode(g, y)!
            if (a.op !== b.op || a.op === NodeOp.param || a.op === NodeOp.block || countIds(a) !== countIds(b)) return false
            if (typeOf(a) !== typeOf(b) || typeRefOf(a) !== typeRefOf(b) || a.flags !== b.flags) return false
            const ordering = firstNonOrderingSlot(a)
            for (let i = 0; i < countIds(a); i++) {
                if (i < ordering) {
                    if (getRef(a, i) !== getRef(b, i) || getLiteral(g, a, i) !== getLiteral(g, b, i)) return false
                    continue
                }
                if (!agree(getRef(a, i), getLiteral(g, a, i), getRef(b, i), getLiteral(g, b, i), tag, held, depth + 1)) return false
            }
            return true
        }
        function agreedUnder(n: GraphNode, tag: number, held: number, heldArm: number): number {
            if (!tag || getNode(g, tag)!.op === NodeOp.after) return 0
            return agree(getRef(n, heldArm), getLiteral(g, n, heldArm), getRef(n, 3 - heldArm), getLiteral(g, n, 3 - heldArm), tag, held, 0) ? 3 - heldArm : 0
        }
        function agreedArm(n: GraphNode): number {
            if (countIds(n) !== 3 || !getRef(n, 0)) return 0
            const c = getNode(g, getRef(n, 0))!
            const compared = (c.op === NodeOp.eq || c.op === NodeOp.ne) && countIds(c) === 2
            if (compared && comparesFloats(g, c)) return 0
            const left = compared ? scalarOperand(g, g.nodes, c, 0) : undefined
            const right = compared ? scalarOperand(g, g.nodes, c, 1) : undefined
            const side = left === undefined && right !== undefined ? 0 : right === undefined && left !== undefined ? 1 : -1
            if (side < 0) return agreedUnder(n, getRef(n, 0), 0, 2)
            const held = side === 0 ? right! : left!
            if (held !== 0) {
                const kept = agreedUnder(n, getRef(n, 0), 0, 2)
                if (kept) return kept
            }
            return agreedUnder(n, getRef(c, side), held, c.op === NodeOp.eq ? 1 : 2)
        }
        const r = new Map<number, number>()
        const selects = findValues(target.id, NodeOp.select) ?? []
        const prefixes = selects.length > 1 ? nodeFacts(g, target.bodyId) : undefined
        for (const id of selects) {
            const n = getNode(g, id)!
            const facts = prefixes?.get(id)
            const decided = facts?.length && countIds(n) === 3 && getRef(n, 0) ? decideByFacts(g, facts, getRef(n, 0)) : undefined
            if (decided !== undefined) {
                const arm = decided ? 1 : 2
                const chosen = getRef(n, arm) || addNode(g, NodeOp.literal, [{ literal: getLiteral(g, n, arm) }])
                const test = getNode(g, getRef(n, 0))!
                r.set(id, test.op === NodeOp.after || OrderedValues.has(test.op) ? createNode(g, NodeOp.after, [getRef(n, 0), chosen]) : chosen)
                continue
            }
            if (sameArms(n)) {
                r.set(id, getRef(n, 2))
                continue
            }
            const kept = agreedArm(n)
            if (kept) {
                r.set(id, getRef(n, kept) || addNode(g, NodeOp.literal, [{ literal: getLiteral(g, n, kept) }]))
                continue
            }
            const test = getNode(g, skipAfter(getRef(n, 0)) ?? 0)
            const nullish = isNullishValue(g, getRef(n, 0))
            const constant = test?.op === NodeOp.literal
            if (countIds(n) === 3 && (!getRef(n, 0) || nullish || constant)) {
                const arm = !nullish && (constant ? getLiteral(g, test, 0) : getLiteral(g, n, 0)) ? 1 : 2
                const chosen = getRef(n, arm) || addNode(g, NodeOp.literal, [{ literal: getLiteral(g, n, arm) }])
                r.set(id, (constant || nullish) && test !== getNode(g, getRef(n, 0)) ? createNode(g, NodeOp.after, [getRef(n, 0), chosen]) : chosen)
                continue
            }
            const decoded = getNode(g, getRef(n, 0))
            if (decoded?.op === NodeOp.decode && onlyTested(getRef(n, 0))) {
                const defined = addNode(g, NodeOp.ne, [getOperand(g, decoded, 0), { literal: heap.undefinedWord }], Types.bool)
                r.set(id, addCopy(g, n, withOperand(g, n, 0, defined), NodeOp.select))
                continue
            }
            const tested = decoded?.op === NodeOp.select && countIds(decoded) === 3 && getRef(decoded, 0) && !getRef(decoded, 1) && !getRef(decoded, 2)
            if (countIds(n) === 3 && tested && !getLiteral(g, decoded, 1) !== !getLiteral(g, decoded, 2)) {
                const whenTrue = getLiteral(g, decoded, 1) ? 1 : 2
                r.set(id, addCopy(g, n, [getRef(decoded, 0), getOperand(g, n, whenTrue), getOperand(g, n, 3 - whenTrue)], NodeOp.select))
                continue
            }
            if (diverges(n, 2)) {
                const x = createNode(g, NodeOp.after, [getRef(n, 0), operand(g, n, 1)])
                r.set(id, x)
                continue
            }
            if (diverges(n, 1)) {
                const x = createNode(g, NodeOp.after, [getRef(n, 0), operand(g, n, 2)])
                r.set(id, x)
                continue
            }
            if (countIds(n) !== 3 || loops(getRef(n, 1)) || !loops(getRef(n, 2))) continue
            const cond = getNode(g, getRef(n, 0))
            if (!cond || !CompareOps.has(cond.op)) continue
            if (comparesFloats(g, cond)) continue
            const inverted = addCopy(g, cond, getOperands(g, cond), InverseCompare.get(cond.op)!)
            r.set(id, addCopy(g, n, [inverted, getOperand(g, n, 2), getOperand(g, n, 1)], NodeOp.select))
        }
        if (!r.size) return false
        target.bodyId = replaceAll(target.bodyId, r)
        revisitBlock(target)
        simplifySelect(target)
        return true
    }

    function deduplicateValues(target: GraphBlock) {
        const roots = deduplicate(g, [target.bodyId])
        if (!roots) return false
        target.bodyId = roots[0]
        revisitBlock(target, true)
        return true
    }

    function cone(id: number, into: Set<number>): Set<number> {
        const n = id ? getNode(g, id) : undefined
        if (!n || into.has(id) || n.op === NodeOp.param || isArgless(n)) return into
        into.add(id)
        for (const x of getArgIds(n)) cone(x, into)
        return into
    }

    function speculates(test: number, guard: number): boolean {
        const guarded = cone(guard, new Set())
        let extra = 0
        for (const id of cone(test, new Set())) {
            if (guarded.has(id)) continue
            const n = getNode(g, id)!
            if (++extra > 3) return false
            if (!leavesArm(g, n)) return false
        }
        return true
    }

    function interchangeSelects(target: GraphBlock) {
        if (!preds.get(target.id)?.has(target.id)) return false
        if ((findValues(target.id, NodeOp.select)?.length ?? 0) < 2) return false
        const loops = (id: number) => {
            const n = getNode(g, skipAfter(id) ?? 0)
            return n?.op === NodeOp.apply && getRef(n, 0) === target.id
        }
        const outer = getNode(g, target.bodyId)
        if (!outer || outer.op !== NodeOp.select || countIds(outer) !== 3) return false
        for (const a of [1, 2]) {
            const inner = getNode(g, getRef(outer, a))
            if (!inner || inner.op !== NodeOp.select || countIds(inner) !== 3) continue
            const b = loops(getRef(inner, 1)) ? 1 : loops(getRef(inner, 2)) ? 2 : 0
            if (!b || loops(getRef(inner, 3 - b)) || loops(getRef(outer, 3 - a))) continue
            const c1 = getNode(g, getRef(outer, 0))
            const c2 = getNode(g, getRef(inner, 0))
            if (!c1 || !c2 || !CompareOps.has(c1.op) || !CompareOps.has(c2.op)) continue
            if (comparesFloats(g, c1) || comparesFloats(g, c2)) continue
            if (!speculates(getRef(inner, 0), getRef(outer, 0))) continue
            const guard = a === 1 ? getRef(outer, 0) : addCopy(g, c1, getOperands(g, c1), InverseCompare.get(c1.op)!)
            const test = b === 1 ? getRef(inner, 0) : addCopy(g, c2, getOperands(g, c2), InverseCompare.get(c2.op)!)
            const both = addCopy(g, c2, [guard, test], NodeOp.and)
            const rest = addCopy(g, inner, [guard, getRef(inner, 3 - b), getRef(outer, 3 - a)], NodeOp.select)
            target.bodyId = addCopy(g, outer, [both, getRef(inner, b), rest], NodeOp.select)
            revisitBlock(target)
            return true
        }
        return false
    }

    const debug = intrinsics.argv().includes('debug') // TODO: intrinsics.assert could have this (but it needs to be derived/configurable)
    const keyBits = 25
    const maxValId = 2**keyBits
    function keyOfPair(a: number, b: number, skipsort?: boolean) {
        if (debug) {
            assert(a >= 0 && a < maxValId)
            assert(b >= 0 && b < maxValId)
        }
        if (!skipsort && a > b) {
            let tmp = a
            a = b
            b = tmp
        }
        return a * maxValId + b
    }

    const precedesCache = new Map<number, boolean>()
    function precedes(a: number, b: number, checkedFirst?: boolean): boolean {
        if (a >= b) return false
        const nb = getNode(g, b)!
        const lb = countIds(nb)
        if (!lb) return false

        if (!checkedFirst) {
            const na = getNode(g, a)!
            if (!countIds(na)) return true
        }

        const k = keyOfPair(a, b, true)
        if (const v = precedesCache.get(k)) return v

        let result = false
        for (let i = 0; i < lb; i++) {
            const q = getRef(nb, i)
            if (q === a || precedes(a, q, true)) {
                result = true
                break
            }
        }

        precedesCache.set(k, result)
        return result
    }

    function isRead(n: GraphNode | undefined) {
        return n?.op === NodeOp.load || (n?.op === NodeOp.call && callEffect(n) <= 1)
    }

    function isUnreachable(vid: number) {
        return vid === _unreachable || getNode(g, vid)?.op === NodeOp.unreachable
    }

    let _unreachable: number | undefined
    function unreachable(original?: GraphNode) {
        // TODO: use `original` but reserve id space for primitives. or some other strategy...
        //if (original) return createNode(g, 'unreachable', [], original)
        initPrimitives()
        return _unreachable!
    }

    let _nil: number | undefined
    function nil(original?: GraphNode) {
        //if (original) return createNode(g, 'nil-effect', [], original)
        initPrimitives()
        return _nil!
    }

    let _void: number | undefined
    function Void(original?: GraphNode) {
        //if (original) return createNode(g, 'void', [], original)
        initPrimitives()
        return _void!
    }

    function initPrimitives() {
        if (_nil !== undefined) return
        for (const [k, v] of g.nodes) {
            switch (v.op) {
                case NodeOp.void:
                    _void = k
                case NodeOp.nilEffect:
                    _nil = k
                case NodeOp.unreachable:
                    _unreachable = k
            }
        }
        _nil ??= createNode(g, NodeOp.nilEffect, [])
        _void ??= createNode(g, NodeOp.void, [])
        _unreachable ??= createNode(g, NodeOp.unreachable, [])
    }

    function effectsJoin(values: number[], into?: number) {
        if (const u = values.find(x => isUnreachable(x))) {
            return u
        }
        const sink = into && !isNilOrVoid(into) ? into : undefined
        const collected = new Set<number>()
        const expanded = new Set<number>()
        for (const x of values) orderingParts(x, collected, expanded)
        const parts = [...collected]
        if (!parts.length) return into ?? nil()
        if (parts.length === 1) {
            const v = parts[0]
            if (!sink) return v
            return v === sink ? sink : createNode(g, NodeOp.after, [v, sink])
        }
        if (!sink) {
            parts.push(Void())
            return createNode(g, NodeOp.after, parts)
        }
        const rem = parts.filter(x => x !== sink)
        if (!rem.length) return sink
        rem.push(sink)
        return createNode(g, NodeOp.after, rem)
    }

    function callEffect(n: GraphNode, returned?: number): number {
        return summaryEffect(callSummary(g, n) ?? unknownCall, returned)[0]
    }

    const simplifiedOrdering = new Map<number, number>()
    function simplifyOrdering(vid: number, from?: GraphNode): number | undefined {
        simplifiedOrdering.clear()
        return simplifyOrderingIn(vid, from)
    }

    function simplifyOrderingIn(vid: number, from: GraphNode | undefined): number | undefined {
        if (!vid) return
        const u = getNode(g, vid)
        if (!u) return
        if (u.op === NodeOp.param) return
        if (u.op === NodeOp.nilEffect) return vid
        if (u.op === NodeOp.unreachable) return vid
        if (u.op === NodeOp.ret || u.op === NodeOp.panic) {
            return unreachable(u)
        }
        if (u.op === NodeOp.apply) {
            // `apply` is assumed to already be in tail position by this point
            return unreachable(u)
        }
        if (OrderedValues.has(u.op)) {
            const clobbers = u.op === NodeOp.store || u.op === NodeOp.rt || (u.op === NodeOp.call && callEffect(u) > 1)
            const pure = u.op === NodeOp.load || (u.op === NodeOp.call && !clobbers)
            const skips = (pure && (from?.op === NodeOp.apply || from?.op === NodeOp.ret)) || (!clobbers && isRead(from))
            if (!skips) return vid
        }
        const known = simplifiedOrdering.get(vid)
        if (known !== undefined) return known || undefined
        const r = simplifyOrderingStep(vid, u, from)
        simplifiedOrdering.set(vid, r ?? 0)
        return r
    }

    function simplifyOrderingStep(vid: number, u: GraphNode, from: GraphNode | undefined): number | undefined {
        if (OrderedValues.has(u.op)) return simplifyOrderingIn(getRef(u, 0), from)
        if (u.op === NodeOp.select) {
            let changed = false
            const arr: number[] = []
            for (let i = 1; i < countIds(u); i++) {
                const q = simplifyOrderingIn(getRef(u, i), from)
                if (q !== getRef(u, i)) changed = true
                arr.push(q ?? nil())
            }
            if (!changed) return vid
            if (!arr.every(x => x === arr[0])) return vid
            const tested = simplifyOrderingIn(getRef(u, 0), from)
            if (tested) return effectsJoin([tested, arr[0]])
            return getNode(g, arr[0])?.op === NodeOp.nilEffect ? undefined : arr[0]
        }
        if (u.op === NodeOp.after) {
            const end = countIds(u)-1
            const r = simplifyOrderingIn(getRef(u, end), from)
            // if (r && (!isUnordered(r) || isParam(g.nodes, r))) {
            //     return vid
            // }
            assert(countIds(u) > 1)
            let changed = r !== getRef(u, end) && !(r === undefined && isNilOrVoid(getRef(u, end)))
            const arr: number[] = []
            for (let i = 0; i < end; i++) {
                const q = simplifyOrderingIn(getRef(u, i), from)
                if (q !== getRef(u, i)) changed = true
                if (!q) continue
                if (isUnreachable(q)) return q
                arr.push(q)
            }
            if (r) arr.push(r)
            if (r && isUnreachable(r) && arr.length > 1) return changed ? createNode(g, NodeOp.after, arr) : vid
            if (changed) return effectsJoin(arr)
            const fresh = g.ids.next
            const joined = effectsJoin(arr)
            if (joined < fresh || countIds(getNode(g, joined)!) - 1 < arr.length || !isNilOrVoid(getRef(u, end))) return joined
            deleteNode(g, joined)
            return vid
        }
        if (isUnordered(vid)) return
        if (!OrderedValues.has(u.op) && u.op !== NodeOp.param) {
            const arr: number[] = []
            for (let i = 0; i < countIds(u); i++) {
                const q = simplifyOrderingIn(getRef(u, i), from)
                if (!q) continue
                if (isUnreachable(q)) return q
                arr.push(q)
            }
            return effectsJoin(arr)
        }
        return vid
    }

    function rematerializable(id: number): boolean {
        const n = id ? getNode(g, id) : undefined
        return !!n && n.op !== NodeOp.nilEffect && isArgless(n)
    }

    function isNilOrVoid(vid?: number) {
        if (!vid) return true
        if (vid === _void || vid === _nil) return true
        const op = getNode(g, vid)?.op
        return op === NodeOp.nilEffect || op === NodeOp.void
    }

    function orderingParts(x: number, into: Set<number>, expanded = new Set<number>()): void {
        if (isNilOrVoid(x) || into.has(x) || expanded.has(x)) return
        const m = getNode(g, x)!
        const last = countIds(m) - 1
        if (m.op === NodeOp.after && isNilOrVoid(getRef(m, last))) {
            expanded.add(x)
            for (let i = 0; i < last; i++) orderingParts(getRef(m, i), into, expanded)
            return
        }
        into.add(x)
    }

    function slotParts(id: number): Set<number> {
        const parts = new Set<number>()
        const n = getNode(g, id)
        if (!n) return parts
        if (n.op === NodeOp.after) {
            const expanded = new Set<number>()
            for (let i = 0; i < countIds(n) - 1; i++) orderingParts(getRef(n, i), parts, expanded)
            return parts
        }
        if (!OrderedValues.has(n.op)) return parts
        orderingParts(getRef(n, 0), parts)
        return parts
    }

    function writes(n: GraphNode | undefined): boolean {
        return !!n && (n.op === NodeOp.store || n.op === NodeOp.pstack || n.op === NodeOp.rt || (n.op === NodeOp.call && callEffect(n) > 1))
    }
    function orderedUse(id: number, seen = new Set<number>()): boolean {
        if (seen.has(id)) return false
        seen.add(id)
        for (const u of dependents.get(id) ?? []) {
            const n = getNode(g, u)
            if (!n) continue
            if (OrderedValues.has(n.op) && getRef(n, 0) === id) return true
            if (n.op !== NodeOp.after) continue
            const last = countIds(n) - 1
            for (let i = 0; i < last; i++) if (getRef(n, i) === id) return true
            if (getRef(n, last) === id && orderedUse(u, seen)) return true
        }
        return false
    }

    function hasOrdering(target: GraphBlock): boolean {
        if (findValues(target.id, NodeOp.after)?.length) return true
        for (const [op, ids] of byOp.get(target.id) ?? []) {
            if (!OrderedValues.has(op) || op === NodeOp.alloca) continue
            for (const id of ids) {
                const token = getRef(getNode(g, id)!, 0)
                if (token && getNode(g, token)?.op !== NodeOp.nilEffect) return true
            }
        }
        return false
    }

    function reduceBlockOrdering(target: GraphBlock): boolean {
        if (!hasOrdering(target)) return false
        let changed = false
        const epoch = nextEpoch(g)
        const replacements = new Map<number, number>()
        const relaxedTo = new Map<number, number>()
        function visit(id: number): void {
            if (!id) return
            let n = getNode(g, id)
            if (!n || !markVisited(n, epoch)) return
            for (let i = 0; i < countIds(n); i++) visit(getRef(n, i))

            let resolved: number[] | undefined
            for (let i = 0; i < countIds(n); i++) {
                let r = replacements.get(getRef(n, i))
                const ordering = i < firstNonOrderingSlot(n)
                if (!ordering) r = relaxedTo.get(r ?? getRef(n, i)) ?? r
                if (r === undefined) continue
                if (!resolved) resolved = cloneRefs(n)
                resolved[i] = r
            }
            if (resolved) {
                putCopy(g, id, n, withRefs(g, n, resolved))
                n = getNode(g, id)!
                markVisited(n, epoch)
                changed = true
            }

            if (n.op !== NodeOp.after && (!OrderedValues.has(n.op) || n.op === NodeOp.alloca)) return
            const end = n.op === NodeOp.after ? countIds(n) - 1 : 1
            const tail = n.op === NodeOp.after ? getNode(g, replacements.get(getRef(n, end)) ?? getRef(n, end)) : undefined
            const from = tail?.op === NodeOp.apply || tail?.op === NodeOp.ret ? tail : n
            let argIds: number[] | undefined
            for (let i = 0; i < end; i++) {
                const q = replacements.get(getRef(n, i)) ?? getRef(n, i)
                if (getNode(g, q)?.op === NodeOp.void) {
                    if (!argIds) argIds = cloneRefs(n)
                    argIds[i] = nil()
                    continue
                }
                const ordering = n.op === NodeOp.call && callEffect(n) === 0 && !writesBefore(q, new Set()) ? undefined : simplifyOrdering(q, from)
                if (ordering === q || (isNilOrVoid(ordering) && isNilOrVoid(q))) {
                    continue
                }
                if (!argIds) argIds = cloneRefs(n)
                argIds[i] = ordering ?? nil()
            }
            const orderings = (argIds ?? getArgIds(n)).slice(0, end)
            const isPointlessAfter = n.op === NodeOp.after && orderings.every(isNilOrVoid)
            if (isPointlessAfter) {
                if (getRef(n, end)) {
                    replacements.set(id, replacements.get(getRef(n, end)) ?? getRef(n, end))
                } else {
                    const nextId = insertNode(g, literal(g, getLiteral(g, n, end)))
                    replacements.set(id, nextId)
                }
                return
            }
            if (n.op === NodeOp.after && !isNilOrVoid(getRef(n, end))) {
                const fresh = g.ids.next
                const sink = replacements.get(getRef(n, end)) ?? getRef(n, end)
                const covered = slotParts(sink)
                const unordered = !orderedUse(id) && !writes(getNode(g, sink))
                const kept: number[] = []
                for (let p of orderings) {
                    while (unordered && isRead(getNode(g, p))) p = getRef(getNode(g, p)!, 0)
                    if (!covered.has(p) && !isNilOrVoid(p)) kept.push(p)
                }
                const joined = effectsJoin(kept, sink)
                if (joined < fresh) {
                    replacements.set(id, joined)
                    return
                }
                const j = getNode(g, joined)!
                if (countIds(j) !== countIds(n) || getArgIds(j).some((x, i) => x !== getRef(n, i))) {
                    setNode(g, id, j)
                    changed = true
                }
                deleteNode(g, joined)
                return
            }
            if (!argIds) return
            for (let i = end; i < argIds.length; i++) {
                const q = argIds[i]
                if (q) argIds[i] = replacements.get(q) ?? q
            }
            changed = true
            if (isRead(n) && argIds[0] !== getRef(n, 0) && !isNilOrVoid(getRef(n, 0))) {
                const relaxed = addCopy(g, n, withRefs(g, n, argIds))
                markVisited(getNode(g, relaxed)!, epoch)
                putNode(g, id, NodeOp.after, [getRef(n, 0), relaxed, Void()])
                markVisited(getNode(g, id)!, epoch)
                relaxedTo.set(id, relaxed)
                precedesCache.clear()
                return
            }
            putCopy(g, id, n, withRefs(g, n, argIds))
        }
        visit(target.bodyId)
        if (!changed && !replacements.size) return false
        target.bodyId = replaceTransitive(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function liftAfters(target: GraphBlock): boolean {
        const members = new Set<number>()
        const users = new Set<number>()
        for (const a of findValues(target.id, NodeOp.after) ?? []) {
            const n = getNode(g, a)
            const v = n ? getRef(n, countIds(n) - 1) : 0
            if (!n || (v && isNilOrVoid(v))) continue
            for (const u of dependents.get(a) ?? []) if (usesForResult(u, a)) users.add(u)
        }
        if (!users.size) return false
        for (const ids of byOp.get(target.id)!.values()) for (const id of ids) members.add(id)
        let changed = false
        const work = [...users]
        for (let k = 0; k < work.length; k++) {
            const id = work[k]
            let n = getNode(g, id)
            if (!n || !members.has(id)) continue
            const first = OrderedValues.has(n.op) || n.op === NodeOp.apply ? 1 : n.op === NodeOp.ret || PureOps.has(n.op) ? 0 : countIds(n)
            const end = n.op === NodeOp.select ? 1 : countIds(n)
            let lifted: Operand[] | undefined
            const parts: number[] = []
            for (let i = first; i < end; i++) {
                const a = getNode(g, getRef(n, i))
                if (a?.op !== NodeOp.after) continue
                const last = countIds(a) - 1
                const v = getRef(a, last)
                if (v ? isNilOrVoid(v) : n.op === NodeOp.ret) continue
                if (v) {
                    const value = getNode(g, v)!
                    if (OrderedValues.has(value.op) && cloneRefs(a, 0, last).every(p => {
                        const q = simplifyOrdering(p, n)
                        return isNilOrVoid(q) || q === v
                    })) {
                        lifted ??= getOperands(g, n)
                        lifted[i] = v
                        continue
                    }
                    if (!OrderedValues.has(n.op) && !isUnordered(v)) continue
                }
                lifted ??= getOperands(g, n)
                lifted[i] = getOperand(g, a, last)
                for (let j = 0; j < last; j++) parts.push(getRef(a, j))
            }
            if (!lifted) continue
            if (OrderedValues.has(n.op)) {
                lifted[0] = effectsJoin([getRef(n, 0), ...parts])
                putCopy(g, id, n, lifted)
            } else {
                const inner = addCopy(g, n, lifted)
                putCopy(g, id, n, [...parts, inner], NodeOp.after)
                for (const u of dependents.get(id) ?? []) if (usesForResult(u, id)) work.push(u)
            }
            changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    function eliminateUnusedPureValues(target: GraphBlock): boolean {
        const replacements = new Map<number, number>()
        for (const id of findValues(target.id, NodeOp.load) ?? []) {
            if (isResultUsed(id)) continue
            replacements.set(id, getRef(getNode(g, id)!, 0))
        }
        for (const id of findValues(target.id, NodeOp.call) ?? []) {
            if (isResultUsed(id)) continue
            const n = getNode(g, id)!
            const [effect, writes] = summaryEffect(callSummary(g, n) ?? unknownCall)
            if (effect > EffectRead && (writes & ~WritesStack) !== 0) continue
            replacements.set(id, getRef(n, 0))
        }
        if (!replacements.size) return false
        target.bodyId = replaceTransitive(target.bodyId, replacements)
        revisitBlock(target, true)
        return true
    }

    const maxLoopParams = 8
    function workingParams(block: GraphBlock): number {
        let count = 0
        for (const p of block.params) {
            for (const user of dependents.get(p) ?? []) {
                if (getNode(g, user)?.op === NodeOp.apply) continue
                count++
                break
            }
        }
        return count
    }

    function dereferencedBases(root: number, outside: (id: number) => number, into: Set<number>): Set<number> {
        for (const id of demandOf(root)) {
            const n = getNode(g, id)
            if (n?.op === NodeOp.load && getRef(n, 1) && !getRef(n, 2)) into.add(outside(getRef(n, 1)))
        }
        return into
    }

    function fieldOfDereferenced(n: GraphNode, bases: Set<number>, outside: (id: number) => number): boolean {
        if (n.op !== NodeOp.load || !getRef(n, 1) || getRef(n, 2)) return false
        const base = outside(getRef(n, 1))
        return dereferenceable(g, base) || bases.has(base)
    }

    // finds values that never differ across applications and moves them to a pred
    function hoistInvariants(target: GraphBlock) {
        currentMem()
        const loop = countedLoop(target)
        if (!loop || loop.entries.length !== 1) return
        const t = skipAfter(target.bodyId)
        if (!t) return
        const tail = getNode(g, t)
        if (!tail || tail.op !== NodeOp.select) return

        const [entryBlock, entryApp] = loop.entries[0]
        const entry = getNode(g, entryApp)!
        const backs = loop.selfApps.map(id => getNode(g, id)!)
        const obvious: number[] = []
        for (let i = 0; i < target.params.length; i++) {
            const v = getRef(entry, i + 1)
            if (v && !getGraphBlock(entryBlock).params.includes(v)) continue
            let same = true
            for (const back of backs) {
                const r = getRef(back, i + 1)
                if (r ? r !== target.params[i] : v || getLiteral(g, back, i + 1) !== getLiteral(g, entry, i + 1)) same = false
            }
            if (same) obvious.push(i)
        }
        if (!obvious.length) return

        const work = obvious.map(x => target.params[x])
        const invariants = new Set<number>(obvious.map(x => target.params[x]))
        const seen = new Set<number>(target.params)
        const iterating = new Set<number>()
        function markIterating(id: number): void {
            if (!id || iterating.has(id)) return
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.block) return
            iterating.add(id)
            for (const x of getArgIds(n)) markIterating(x)
        }
        for (const path of applicationPaths(target, target.id)) {
            for (const id of path) {
                const n = getNode(g, id)!
                if (n.op === NodeOp.select) markIterating(getRef(n, 0))
                else if (n.op === NodeOp.after) for (let i = 0; i < countIds(n) - 1; i++) markIterating(getRef(n, i))
                else markIterating(id)
            }
        }
        const calls = (findValues(target.id, NodeOp.call) ?? []).filter(x => iterating.has(x) && callEffect(getNode(g, x)!) > 1)
        const stores = (findValues(target.id, NodeOp.store) ?? []).filter(x => iterating.has(x))
        const relaxed = new Set<number>()
        let required: Set<number> | undefined
        const entering = (x: number) => {
            const at = target.params.indexOf(x)
            return at >= 0 && getRef(entry, at + 1) ? getRef(entry, at + 1) : x
        }
        let bases: Set<number> | undefined
        const dereferenced = () => bases ??= dereferencedBases(target.bodyId, entering, dereferencedBases(getGraphBlock(entryBlock).bodyId, x => x, new Set()))
        function isInvariant(id: number): boolean {
            if (isNilOrVoid(id)) return true
            if (invariants.has(id)) return true
            if (seen.has(id)) return false
            seen.add(id)
            const n = getNode(g, id)!
            if (n.op === NodeOp.apply) return false
            if (n.op === NodeOp.ret) return false
            if (n.op === NodeOp.select) return false
            if (n.op === NodeOp.after || n.op === NodeOp.store || n.op === NodeOp.call || n.op === NodeOp.pstack) return false
            if (TargetingValues.has(n.op)) return false
            required ??= demandOf(target.bodyId)
            if (!leavesArm(g, n) && !required.has(id) && !fieldOfDereferenced(n, dereferenced(), entering)) return false
            if (n.op === NodeOp.load) {
                if (calls.some(x => mem!.clobbers(x, n))) return false
                if (stores.some(x => !mem!.disjoint(n, getNode(g, x)!))) return false
                if (!isNilOrVoid(getRef(n, 0))) {
                    if (!quietAnchor(id, n)) return false
                    relaxed.add(id)
                }
            }
            for (let i = n.op === NodeOp.load ? 1 : 0; i < countIds(n); i++) {
                if (!isInvariant(getRef(n, i))) return false
            }
            work.push(id)
            invariants.add(id)
            return true
        }

        const covered = new Set<number>()
        while (work.length) {
            const next = work.pop()!
            const s = dependents.get(next)
            if (!s) continue
            let fullyCovered = true
            for (const u of s) {
                if (!isInvariant(u)) {
                    if (fullyCovered && loop.selfApps.includes(u)) continue
                    fullyCovered = false
                }
            }
            if (fullyCovered) {
                covered.add(next)
            }
        }
        const headroom = Math.max(0, maxLoopParams - workingParams(target))
        if (!headroom) {
            const dropping = obvious.map(i => target.params[i]).filter(p => !covered.has(p))
            while (dropping.length) {
                const stack = [dropping.pop()!]
                while (stack.length) {
                    const x = stack.pop()!
                    if (!invariants.delete(x)) continue
                    for (const u of dependents.get(x) ?? []) stack.push(u)
                }
                for (const p of covered) {
                    for (const u of dependents.get(p) ?? []) {
                        if (invariants.has(u) || loop.selfApps.includes(u)) continue
                        covered.delete(p)
                        dropping.push(p)
                        break
                    }
                }
            }
        }
        const roots = new Map<number, [dependent: number, pos: number][]>()
        function addRoot(from: number, to: number, pos: number) {
            let arr = roots.get(from)
            if (!arr) roots.set(from, arr = [])
            arr.push([to, pos])
        }
        for (const x of invariants) {
            if (target.params.includes(x)) continue
            for (const y of dependents.get(x) ?? []) {
                if (invariants.has(y) || !usesForResult(y, x)) continue
                const u = getNode(g, y)!
                for (let i = 0; i < countIds(u); i++) {
                    if (getRef(u, i) === x) {
                        addRoot(x, y, i)
                    }
                }
            }
        }
        const coveredParams = target.params.filter(x => covered.has(x))
        const extra = roots.size - coveredParams.length
        if (extra > 0 && [...roots.keys()].some(x => !iterating.has(x))) return
        if (extra > headroom) {
            // console.log('ROOTS', roots)
            // console.log('too many roots vs params:', coveredParams)
            return
        }
        if (!roots.size) return

        const replacements = new Map<number, number>()
        const newParams = target.params.filter(x => !coveredParams.includes(x))
        const paramToRoot = new Map<number, number>()
        for (const r of roots) {
            const p = paramLike(r[0])
            replacements.set(r[0], p)
            paramToRoot.set(p, r[0])
            newParams.push(p)
        }

        const oldParams = [...target.params]

        {
            const replacements = new Map<number, number>()
            const forwardedParams = oldParams.map(x => {
                const p = paramLike(x)
                replacements.set(x, p)
                return p
            })
            for (const x of roots.keys()) seedReanchored(x, relaxed, replacements)
            const hoisted = [...roots.keys()].map(x => {
                return replaceAll(x, replacements)
            })
            const o = oldParams.filter(x => !coveredParams.includes(x))
            const argIds = new Array(1+newParams.length)
            for (let i = 0; i < o.length; i++) {
                argIds[i+1] = replacements.get(newParams[i])
            }
            for (let i = 0; i < hoisted.length; i++) {
                argIds[i+1+o.length] = hoisted[i]
            }
            argIds[0] = target.id
            const forward = addNode(g, NodeOp.apply, argIds)
            const blk = addBlock(forwardedParams, forward)
            const callerReplacements = new Map<number, number>()
            callerReplacements.set(target.id, blk)
            const caller = getGraphBlock(entryBlock)
            caller.bodyId = replaceAll(caller.bodyId, callerReplacements)
            revisitBlock(caller)
            revisitBlock(getBlock(g, blk)!)
        }

        {
            for (const app of loop.selfApps) {
                const u = getNode(g, app)!
                const o = oldParams.filter(x => !coveredParams.includes(x))
                const operands: Operand[] = new Array(1+newParams.length)
                let j = 0
                for (let i = 0; i < o.length; i++) {
                    if (coveredParams.includes(target.params[j])) {
                        j += 1
                        i -= 1
                        continue
                    }
                    operands[i+1] = replaceAll(getRef(u, j+1), replacements) || { literal: getLiteral(g, u, j+1) }
                    j += 1
                }
                for (let i = 0; i < roots.size; i++) {
                    operands[i+1+o.length] = newParams[i+o.length]
                }
                operands[0] = target.id
                const newApp = addNode(g, NodeOp.apply, operands)
                replacements.set(app, newApp)
            }
        }  
        target.params = newParams
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function loopMembers(header: GraphBlock): Set<number> {
        const reached = new Set<number>([header.id])
        const work = [header.id]
        while (work.length) {
            for (const s of successors.get(work.pop()!) ?? []) {
                if (reached.has(s)) continue
                reached.add(s)
                work.push(s)
            }
        }
        const members = new Set<number>([header.id])
        work.push(header.id)
        while (work.length) {
            for (const p of preds.get(work.pop()!) ?? []) {
                if (members.has(p) || !reached.has(p)) continue
                members.add(p)
                work.push(p)
            }
        }
        return members
    }

    function leavesLoop(id: number, members: Set<number>): boolean {
        for (let at = id; at;) {
            const n = getNode(g, at)
            if (!n) return false
            if (n.op === NodeOp.ret || n.op === NodeOp.unreachable || n.op === NodeOp.panic) return true
            if (n.op === NodeOp.apply) return !members.has(getRef(n, 0))
            if (n.op !== NodeOp.after) return false
            at = getRef(n, countIds(n) - 1)
        }
        return false
    }

    function scanUnswitchCandidates(): void {
        for (const header of reachableBlocks) {
            if (header === g.blocks[0]) continue
            const members = loopMembers(header)
            if (![...(preds.get(header.id) ?? [])].some(p => members.has(p))) continue
            const invariant = new Map<number, number>()
            for (let i = 0; i < header.params.length; i++) {
                const chain = relayChain(header, i, members)
                if (!chain) continue
                for (const [id, at] of chain) invariant.set(getGraphBlock(id).params[at], i)
            }
            let nodes = 0
            let selects = 0
            const conditions = new Set<number>()
            const exits = new Set<number>()
            for (const id of members) {
                for (const ids of byOp.get(id)?.values() ?? []) nodes += ids.length
                for (const sel of findValues(id, NodeOp.select) ?? []) {
                    const c = getRef(getNode(g, sel)!, 0)
                    const cn = getNode(g, c)
                    const refs = cn ? getArgIds(cn).filter(x => x) : []
                    const root = invariant.has(c) ? invariant.get(c)!
                        : cn && cn.op !== NodeOp.param && refs.length && refs.every(x => invariant.has(x)) ? invariant.get(refs[0])! : -1
                    if (root < 0) continue
                    selects++
                    conditions.add(root)
                    const sn = getNode(g, sel)!
                    for (let arm = 1; arm < countIds(sn); arm++) {
                        if (leavesLoop(getRef(sn, arm), members)) exits.add(root)
                    }
                }
            }
            if (selects) console.log(`UNSWITCH ${g.name} B${header.id} blocks=${members.size} nodes=${nodes} invariants=${new Set(invariant.values()).size} conditions=${conditions.size} selects=${selects} exiting=${exits.size}`)
        }
    }

    let unswitched = false
    function unswitchLoop(header: GraphBlock) {
        if (!g.unswitch || unswitched || header === g.blocks[0]) return
        if (preds.get(header.id)!.size === 1) return
        const members = loopMembers(header)
        if (![...(preds.get(header.id) ?? [])].some(p => members.has(p))) return
        const entries = findInboundApplies(header).filter(([from]) => !members.has(from))
        if (entries.length !== 1) return
        for (const m of members) if (m !== header.id && [...(preds.get(m) ?? [])].some(p => !members.has(p))) return
        const owned = new Map<number, number[]>()
        let size = 0
        for (const m of members) {
            const ids: number[] = []
            for (const list of byOp.get(m)?.values() ?? []) ids.push(...list)
            owned.set(m, ids)
            size += ids.length
        }
        if (size > g.unswitch) return
        const slotOf = new Map<number, number>()
        for (let slot = 0; slot < header.params.length; slot++) {
            const chain = relayChain(header, slot, members)
            if (chain) for (const [b, k] of chain) slotOf.set(getGraphBlock(b).params[k], slot)
        }
        if (!slotOf.size) return
        const keyOf = (id: number): string | undefined => {
            if (slotOf.has(id)) return `p${slotOf.get(id)}`
            const n = getNode(g, id)
            if (!n || !UnswitchableOps.has(n.op) || !countIds(n)) return
            const parts: string[] = [`${n.op}`]
            for (let i = 0; i < countIds(n); i++) {
                const r = getRef(n, i)
                if (r && !slotOf.has(r)) return
                parts.push(r ? `p${slotOf.get(r)}` : `#${getLiteral(g, n, i)}`)
            }
            return parts.join(' ')
        }
        const stays = (id: number) => tailPositions(g, id).every(p => {
            const t = getNode(g, p.at)
            return t?.op !== NodeOp.ret && !(t?.op === NodeOp.apply && !members.has(getRef(t, 0)))
        })
        const control = (id: number) => [NodeOp.apply, NodeOp.select, NodeOp.after, NodeOp.ret].includes(getNode(g, id)?.op ?? NodeOp.none)
        const votes = new Map<string, [condition: number, selects: number]>()
        for (const m of members) for (const id of findValues(m, NodeOp.select) ?? []) {
            const n = getNode(g, id)!
            let inside = true
            let tail = false
            for (let i = 1; i < countIds(n); i++) {
                if (!getRef(n, i)) continue
                if (control(getRef(n, i))) tail = true
                if (!stays(getRef(n, i))) inside = false
            }
            if (!inside) continue
            if (!tail && ![...(dependents.get(id) ?? [])].some(u => getNode(g, u)?.op !== NodeOp.apply || members.has(getRef(getNode(g, u)!, 0)))) continue
            const k = keyOf(getRef(n, 0))
            if (k === undefined) continue
            const known = votes.get(k)
            votes.set(k, [known?.[0] ?? getRef(n, 0), (known?.[1] ?? 0) + 1])
        }
        let chosen: number | undefined
        let key: string | undefined
        let best = 0
        for (const [k, [c, count]] of votes) if (count > best) { best = count; key = k; chosen = c }
        if (chosen === undefined) return
        const fixed = new Set<number>()
        for (const p of slotOf.keys()) if (keyOf(p) === key) fixed.add(p)
        for (const ids of owned.values()) for (const id of ids) if (keyOf(id) === key) fixed.add(id)
        const [entryBlock, entry] = entries[0]
        const e = getNode(g, entry)!
        let condition: Operand
        if (slotOf.has(chosen)) condition = getOperand(g, e, slotOf.get(chosen)! + 1)
        else {
            const c = getNode(g, chosen)!
            const operands = getOperands(g, c)
            for (let i = 0; i < countIds(c); i++) if (getRef(c, i)) operands[i] = getOperand(g, e, slotOf.get(getRef(c, i))! + 1)
            condition = addCopy(g, c, operands)
        }
        function clone(value: number): number {
            const blocks = new Map<number, number>()
            for (const m of members) blocks.set(m, addNode(g, NodeOp.block, []))
            for (const m of members) {
                const b = getGraphBlock(m)
                const copies = new Map<number, number>()
                const literal = addNode(g, NodeOp.literal, [{ literal: value }])
                const exact = new Set<number>()
                for (const id of fixed) {
                    const f = getNode(g, id)!
                    if (value && !CompareOps.has(f.op) && resultType(g, f) !== Types.bool) continue
                    exact.add(id)
                    copies.set(id, literal)
                }
                function copy(id: number): number {
                    if (!id) return id
                    const known = copies.get(id) ?? blocks.get(id)
                    if (known !== undefined) return known
                    const n = getNode(g, id)!
                    if (n.op === NodeOp.block) return id
                    const fresh = newId(g)
                    copies.set(id, fresh)
                    const ops = getOperands(g, n).map(x => typeof x === 'number' ? copy(x) : x)
                    if (n.op === NodeOp.select && fixed.has(getRef(n, 0))) ops[0] = literal
                    const copied = copyNode(g, n, ops)
                    if (typeRefOf(n)) setType(copied, { ref: copy(typeRefOf(n)) })
                    setNode(g, fresh, copied)
                    return fresh
                }
                const params = b.params.map(p => exact.has(p) ? addCopy(g, getNode(g, p)!) : copy(p))
                addGraphBlock(g, { ...b, id: blocks.get(m)!, params, bodyId: copy(b.bodyId) })
            }
            const operands = getOperands(g, e)
            operands[0] = blocks.get(header.id)!
            const known = typeof condition === 'number' ? getNode(g, condition) : undefined
            if (known && (known.op === NodeOp.eq || known.op === NodeOp.ne) && (known.op === NodeOp.eq) === (value === 1)) {
                const side = getRef(known, 0) && !getRef(known, 1) ? 0 : !getRef(known, 0) && getRef(known, 1) ? 1 : -1
                if (side >= 0) {
                    const x = getRef(known, side)
                    const k = getLiteral(g, known, 1 - side)
                    const pinned = new Map<number, number>()
                    function pin(id: number, depth: number): Operand {
                        if (id === x) return { literal: k }
                        const n = getNode(g, id)
                        if (!n || depth > 2 || !(BinaryOps.has(n.op) || CompareOps.has(n.op) || UnaryOps.has(n.op))) return id
                        const known = pinned.get(id)
                        if (known !== undefined) return known
                        const ops = getOperands(g, n)
                        let changed = false
                        for (let i = 0; i < countIds(n); i++) {
                            const r = pin(getRef(n, i), depth + 1)
                            if (r !== getRef(n, i)) { ops[i] = r; changed = true }
                        }
                        const out = changed ? addCopy(g, n, ops) : id
                        pinned.set(id, out)
                        return out
                    }
                    for (let i = 1; i < operands.length; i++) if (getRef(e, i)) operands[i] = pin(getRef(e, i), 0)
                }
            }
            return addCopy(g, e, operands)
        }
        const arms = [clone(1), clone(0)]
        const from = getGraphBlock(entryBlock)
        from.bodyId = replaceAll(from.bodyId, new Map([[entry, addNode(g, NodeOp.select, [condition, arms[0], arms[1]])]]))
        for (const m of members) removeBlock(getGraphBlock(m))
        g.unswitch -= size
        unswitched = true
        revisitBlock(from)
        return true
    }

    interface RelayIndex {
        passes: Map<number, [into: number, slot: number][]>
        inbound: Map<number, [from: number, app: number][]>
    }
    let relayCache: { members: Set<number>, epoch: number, index: RelayIndex } | undefined
    function relayIndex(members: Set<number>): RelayIndex {
        if (relayCache?.members === members && relayCache.epoch === graphEpoch) return relayCache.index
        const index: RelayIndex = { passes: new Map(), inbound: new Map() }
        for (const id of members) {
            const own = new Set(getGraphBlock(id).params)
            for (const app of findValues(id, NodeOp.apply) ?? []) {
                const n = getNode(g, app)!
                const into = getRef(n, 0)
                if (!members.has(into)) continue
                let inbound = index.inbound.get(into)
                if (!inbound) index.inbound.set(into, inbound = [])
                inbound.push([id, app])
                for (let k = 1; k < countIds(n); k++) {
                    const ref = getRef(n, k)
                    if (!own.has(ref)) continue
                    let passes = index.passes.get(ref)
                    if (!passes) index.passes.set(ref, passes = [])
                    passes.push([into, k - 1])
                }
            }
        }
        relayCache = { members, epoch: graphEpoch, index }
        return index
    }
    function relayedChain(start: GraphBlock, slot: number, members: Set<number>): Map<number, number> | undefined {
        const index = relayIndex(members)
        const chain = new Map<number, number>([[start.id, slot]])
        const work = [start]
        while (work.length) {
            const b = work.pop()!
            for (const [into, at] of index.passes.get(b.params[chain.get(b.id)!]) ?? []) {
                if (chain.has(into)) continue
                chain.set(into, at)
                work.push(getGraphBlock(into))
            }
        }
        for (const [id, at] of chain) {
            for (const [from, app] of index.inbound.get(id) ?? []) {
                const fromAt = chain.get(from)
                if (fromAt === undefined) return
                if (getRef(getNode(g, app)!, at + 1) !== getGraphBlock(from).params[fromAt]) return
            }
        }
        return chain
    }
    function relayChain(header: GraphBlock, slot: number, members: Set<number>): Map<number, number> | undefined {
        const chain = relayedChain(header, slot, members)
        if (!chain) return
        for (const id of chain.keys()) if (id !== header.id) for (const from of preds.get(id)!) if (!members.has(from)) return
        return chain
    }

    function hoistLoopInvariants(target: GraphBlock) {
        if (target === g.blocks[0] || (preds.get(target.id)?.size ?? 0) < 2) return false
        currentMem()
        const members = loopMembers(target)
        if (!members || members.size < 2) return false
        const entries = findInboundApplies(target).filter(x => !members.has(x[0]))
        if (entries.length !== 1) return false
        const [entryBlock, entryApp] = entries[0]
        const entry = getNode(g, entryApp)!

        let carrier: Map<number, number> | undefined
        const invariant = new Map<number, number>()
        const chainOf = new Map<number, Map<number, number>>()
        for (let i = 0; i < target.params.length; i++) {
            if (!getRef(entry, i + 1)) continue
            const chain = relayChain(target, i, members)
            if (!chain) continue
            carrier ??= chain
            for (const [id, at] of chain) {
                const param = getGraphBlock(id).params[at]
                invariant.set(param, getRef(entry, i + 1))
                chainOf.set(param, chain)
            }
        }
        if (!carrier) return false
        let fullest = 0
        for (const id of carrier.keys()) fullest = Math.max(fullest, workingParams(getGraphBlock(id)))
        if (fullest >= maxLoopParams) return false

        function dependsOn(roots: number[], target: number, stopAtLoads: boolean): boolean {
            const seen = new Set<number>()
            const stack = roots.slice()
            while (stack.length) {
                const id = stack.pop()!
                if (!id || seen.has(id)) continue
                if (id === target) return true
                seen.add(id)
                const n = getNode(g, id)
                if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
                if (stopAtLoads && n.op === NodeOp.load) return true
                for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
            }
            return false
        }
        function argOf(app: GraphNode, value: number): number {
            for (let i = 1; i < countIds(app); i++) if (tailOf(g, getRef(app, i)) === value) return i - 1
            return -1
        }
        function continuing(exit: TailPosition): boolean {
            const n = getNode(g, exit.at)!
            return n.op === NodeOp.apply && members.has(getRef(n, 0))
        }
        function clean(exit: TailPosition, call: number): boolean {
            const n = getNode(g, exit.at)!
            return (n.op === NodeOp.ret || n.op === NodeOp.apply || n.op === NodeOp.unreachable) && !getArgIds(n).some(x => x && x !== call && dependsOn([x], call, true))
        }
        function backEdgeOutcome(call: number, blockId: number): number | 'exits' | undefined {
            let wanted: number | undefined
            function agree(k: number | undefined): boolean {
                if (k === undefined || (wanted !== undefined && wanted !== k)) return false
                wanted = k
                return true
            }
            for (const exit of tailPositions(g, getGraphBlock(blockId).bodyId)) {
                if (!dependsOn(tailRoots(g, exit), call, false)) continue
                if (!continuing(exit)) {
                    if (!clean(exit, call)) return
                    continue
                }
                const app = getNode(g, exit.at)!
                const next = getGraphBlock(getRef(app, 0))
                const own = valueFacts(g, exit.path, call).is
                if (own !== undefined || next === target) {
                    if (!agree(own)) return
                    continue
                }
                const at = argOf(app, call)
                if (at < 0) return
                for (const inner of tailPositions(g, next.bodyId)) {
                    if (!continuing(inner)) {
                        if (!clean(inner, next.params[at])) return
                        continue
                    }
                    if (!agree(valueFacts(g, inner.path, next.params[at]).is)) return
                }
            }
            return wanted ?? 'exits'
        }
        function exitsOnly(store: number, blockId: number): boolean {
            for (const exit of tailPositions(g, getGraphBlock(blockId).bodyId)) {
                if (!dependsOn(tailRoots(g, exit), store, false)) continue
                if (continuing(exit) || !clean(exit, store)) return false
            }
            return true
        }
        const calls: [call: number, returned: number | undefined][] = []
        const callBlock = new Map<number, number>()
        const stores: number[] = []
        for (const id of members) {
            for (const x of findValues(id, NodeOp.call) ?? []) {
                const n = getNode(g, x)!
                if (callEffect(n) <= 1) continue
                const returned = backEdgeOutcome(x, id)
                if (returned === 'exits' || (returned !== undefined && callEffect(n, returned) <= 1)) continue
                calls.push([x, returned])
                callBlock.set(x, id)
            }
            for (const x of findValues(id, NodeOp.store) ?? []) if (!exitsOnly(x, id)) stores.push(x)
        }
        const reloads = new Map<number, number[]>()
        function reloadable(n: GraphNode, hits: number[]): boolean {
            if (!isNilOrVoid(getRef(n, 0))) return false
            for (const x of hits) {
                const at = callBlock.get(x)!
                if (!carrier!.has(at)) return false
                const bypass = tailPositions(g, getGraphBlock(at).bodyId).some(p => {
                    const t = getNode(g, p.at)!
                    return t.op === NodeOp.apply && carrier!.has(getRef(t, 0)) && !dependsOn(tailRoots(g, p), x, false)
                })
                if (!bypass) return false
                for (let i = 1; i < countIds(n); i++) {
                    const r = getRef(n, i)
                    if (r && chainOf.get(r)?.get(at) === undefined) return false
                }
            }
            return true
        }
        function reloadIn(block: GraphBlock, root: number, token: number): number {
            const n = getNode(g, root)!
            const operands = getOperands(g, n)
            operands[0] = token
            for (let i = 1; i < countIds(n); i++) {
                const r = getRef(n, i)
                if (r) operands[i] = block.params[chainOf.get(r)!.get(block.id)!]
            }
            return addCopy(g, n, operands, NodeOp.load)
        }
        const hoistable = new Map<number, boolean>()
        const relaxed = new Set<number>()
        let required: Set<number> | undefined
        const entering = (x: number) => {
            const at = target.params.indexOf(x)
            if (at >= 0 && getRef(entry, at + 1)) return getRef(entry, at + 1)
            return invariant.get(x) ?? x
        }
        let bases: Set<number> | undefined
        const dereferenced = () => bases ??= dereferencedBases(target.bodyId, entering, dereferencedBases(getGraphBlock(entryBlock).bodyId, x => x, new Set()))
        function canHoist(id: number): boolean {
            if (!id || invariant.has(id)) return true
            const known = hoistable.get(id)
            if (known !== undefined) return known
            const n = getNode(g, id)!
            const load = n.op === NodeOp.load
            required ??= demandOf(target.bodyId)
            let ok = (load || n.op === NodeOp.literal || n.op === NodeOp.convert || BinaryOps.has(n.op)) && (leavesArm(g, n) || required.has(id) || fieldOfDereferenced(n, dereferenced(), entering))
            for (let i = load ? 1 : 0; ok && i < countIds(n); i++) {
                ok = canHoist(getRef(n, i))
                if (reloads.has(getRef(n, i))) ok = false
            }
            let hits: number[] = []
            if (ok && load) {
                hits = calls.filter(([x, returned]) => mem!.clobbers(x, n, returned)).map(([x]) => x)
                ok = (!hits.length || reloadable(n, hits))
                    && !stores.some(x => !mem!.disjoint(n, getNode(g, x)!))
                    && (isNilOrVoid(getRef(n, 0)) || (quietAnchor(id, n) && !!relaxed.add(id)))
            }
            if (ok && hits.length) reloads.set(id, hits)
            hoistable.set(id, ok)
            return ok
        }
        function worthHoisting(id: number): boolean {
            const n = getNode(g, id)!
            if (n.op === NodeOp.load) return true
            for (let i = 0; i < countIds(n); i++) {
                const op = getNode(g, getRef(n, i))?.op
                if (op && op !== NodeOp.param && op !== NodeOp.literal) return true
            }
            return false
        }
        const roots: number[] = []
        const rootBlock = new Map<number, number>()
        for (const blockId of carrier.keys()) {
            const seen = new Set<number>()
            const work = [getGraphBlock(blockId).bodyId]
            while (work.length) {
                const id = work.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const n = getNode(g, id)!
                for (let i = 0; i < countIds(n); i++) {
                    const x = getRef(n, i)
                    const op = getNode(g, x)?.op
                    if (!x || op === NodeOp.param || op === NodeOp.literal || op === NodeOp.nilEffect || op === NodeOp.block) continue
                    if (!canHoist(x)) work.push(x)
                    else if (worthHoisting(x) && !rootBlock.has(x)) {
                        roots.push(x)
                        rootBlock.set(x, blockId)
                    }
                }
            }
        }
        roots.splice(Math.max(0, maxLoopParams - fullest))
        if (!roots.length) return false

        const entryFrom = getGraphBlock(entryBlock)
        const state = stateAt(entryFrom, entryApp)
        if (state === undefined) return false
        const outside = new Map(invariant)
        for (const r of roots) seedReanchored(r, relaxed, outside)
        const epoch = nextEpoch(g)
        const entryValues = new Set(invariant.values())
        const anchored = new Map<number, number>()
        function anchor(id: number): number {
            if (entryValues.has(id)) return id
            const n = id ? getNode(g, id) : undefined
            if (!n || n.op === NodeOp.param || n.op === NodeOp.block) return id
            const known = anchored.get(id)
            if (known !== undefined) return known
            const operands = getOperands(g, n)
            let changed = false
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const next = n.op === NodeOp.load && i === 0 && isNilOrVoid(ref) && !quietSince(state, n) ? state : anchor(ref)
                if (next === ref) continue
                operands[i] = next
                changed = true
            }
            const result = changed ? addCopy(g, n, operands, n.op) : id
            anchored.set(id, result)
            return result
        }
        const hoisted = roots.map(r => anchor(replaceAll(r, outside, epoch)))
        entryFrom.bodyId = replaceAll(entryFrom.bodyId,
            new Map([[entryApp, addCopy(g, entry, [...getOperands(g, entry), ...hoisted], NodeOp.apply)]]))

        const added = new Map<number, number[]>()
        for (const id of carrier.keys()) added.set(id, roots.map(r => paramLike(r)))
        function carry(b: GraphBlock, extra: number[]): number {
            const plain = new Map<number, number>()
            return mapTailPositions(g, b.bodyId, p => {
                const n = getNode(g, p.at)!
                if (n.op !== NodeOp.apply || !carrier!.has(getRef(n, 0))) return p.at
                const reach = tailRoots(g, p)
                let reloaded = false
                const values = extra.map((x, k) => {
                    const hit = (reloads.get(roots[k]) ?? []).filter(c => callBlock.get(c) === b.id && dependsOn(reach, c, false))
                    if (!hit.length) return x
                    reloaded = true
                    return reloadIn(b, roots[k], joinEffects(g, [...new Set([...p.tokens, ...hit])]))
                })
                if (reloaded) return addCopy(g, n, [...getOperands(g, n), ...values], NodeOp.apply)
                if (!plain.has(p.at)) plain.set(p.at, addCopy(g, n, [...getOperands(g, n), ...extra], NodeOp.apply))
                return plain.get(p.at)!
            })
        }
        for (const [id, extra] of added) {
            const b = getGraphBlock(id)
            const replacements = new Map<number, number>()
            roots.forEach((r, k) => {
                if (rootBlock.get(r) === id) replacements.set(r, extra[k])
            })
            const body = carry(b, extra)
            b.params.push(...extra)
            b.bodyId = replaceAll(body, replacements, nextEpoch(g))
        }
        revisitBlock(entryFrom)
        for (const id of carrier.keys()) revisitBlock(getGraphBlock(id))
        return true
    }

    function sinkReloadedStores(target: GraphBlock): boolean {
        if (target === g.blocks[0] || (preds.get(target.id)?.size ?? 0) < 2) return false
        const members = loopMembers(target)
        const inbound = findInboundApplies(target)
        const entries = inbound.filter(x => !members.has(x[0]))
        const backs = inbound.filter(x => members.has(x[0]))
        if (entries.length !== 1 || !backs.length) return false
        const bodyId = backs[0][0]
        if (backs.some(x => x[0] !== bodyId)) return false
        const body = getGraphBlock(bodyId)
        let relay: number[] | undefined
        if (body !== target) {
            if (findValues(target.id, NodeOp.store)?.length || findValues(target.id, NodeOp.call)?.length) return false
            const into = findInboundApplies(body)
            if (into.length !== 1 || into[0][0] !== target.id) return false
            relay = cloneRefs(getNode(g, into[0][1])!).slice(1)
        }
        const [entryBlock, entryApp] = entries[0]
        const entry = getNode(g, entryApp)!

        function headerSlot(ref: number): number {
            const i = body.params.indexOf(ref)
            if (i < 0) return -1
            return relay ? target.params.indexOf(relay[i]) : i
        }
        function entryPointer(ref: number): number | undefined {
            const i = body.params.indexOf(ref)
            if (i < 0) return
            const outer = relay ? relay[i] : ref
            const at = target.params.indexOf(outer)
            if (at < 0) {
                const op = getNode(g, outer)?.op
                return op === NodeOp.alloca || op === NodeOp.frameAddress ? outer : undefined
            }
            if (!relayChain(target, at, members) || !getRef(entry, at + 1)) return
            return getRef(entry, at + 1)
        }
        function wrapper(block: number, app: number): number | undefined {
            for (const u of dependents.get(app) ?? []) {
                const n = getNode(g, u)!
                if (n.op === NodeOp.after && countIds(n) === 2 && getRef(n, 1) === app) return u
            }
        }
        function reloads(store: GraphNode, slot: number): boolean {
            for (const [block, app] of backs) {
                const loaded = getNode(g, skipAfter(getRef(getNode(g, app)!, slot + 1)) ?? 0)
                if (!loaded || loaded.op !== NodeOp.load) return false
                if (getRef(loaded, 1) !== getRef(store, 1) || getRef(loaded, 2)) return false
                if (getLiteral(g, loaded, 2) !== getLiteral(g, store, 2) || !sameSlotBits(typeOf(loaded), typeOf(store))) return false
                if (applyWriter(block, app) !== lastWriter(getRef(loaded, 0))) return false
            }
            return true
        }
        function applyWriter(block: number, app: number): number | undefined {
            const after = wrapper(block, app)
            if (after !== undefined) return lastWriter(getRef(getNode(g, after)!, 0))
            let writer: number | undefined
            const n = getNode(g, app)!
            for (let i = 1; i < countIds(n); i++) {
                const arg = getNode(g, getRef(n, i))
                if (!arg || (arg.op !== NodeOp.after && !OrderedValues.has(arg.op))) continue
                const w = lastWriter(getRef(n, i))
                if (writer !== undefined && writer !== w) return
                writer = w
            }
            return writer
        }
        function lastWriter(token: number): number {
            for (;;) {
                const n = getNode(g, token)
                if (!n || (n.op !== NodeOp.load && n.op !== NodeOp.after)) return token
                token = getRef(n, 0)
            }
        }
        function firstWrite(store: GraphNode): boolean {
            const bytes = intrinsics.intrinsicBitWidth(typeOf(store)) / 8
            for (let t = getRef(store, 0); t;) {
                const n = getNode(g, t)!
                if (n.op === NodeOp.nilEffect) return true
                if (n.op === NodeOp.load) {
                    if (!currentMem().disjoint(n, store)) return false
                    t = getRef(n, 0)
                    continue
                }
                if (n.op !== NodeOp.store || getRef(n, 1) !== getRef(store, 1) || getRef(n, 2)) return false
                const at = getLiteral(g, n, 2)
                const width = intrinsics.intrinsicBitWidth(typeOf(n)) / 8
                if (at < getLiteral(g, store, 2) + bytes && getLiteral(g, store, 2) < at + width) return false
                t = getRef(n, 0)
            }
            return true
        }

        for (const id of findValues(body.id, NodeOp.store) ?? []) {
            const store = getNode(g, id)!
            if (!getRef(store, 1) || getRef(store, 2)) continue
            const slot = headerSlot(getRef(store, 3))
            if (slot < 0 || !getRef(entry, slot + 1) && getLiteral(g, entry, slot + 1) === undefined) continue
            const ptr = entryPointer(getRef(store, 1))
            if (ptr === undefined || !firstWrite(store) || !reloads(store, slot)) continue

            const from = getGraphBlock(entryBlock)
            const outer = wrapper(entryBlock, entryApp)
            const ordering = outer !== undefined ? [getRef(getNode(g, outer)!, 0)] : []
            for (let i = 1; i < countIds(entry); i++) {
                const arg = getNode(g, getRef(entry, i))
                if (arg && (arg.op === NodeOp.after || OrderedValues.has(arg.op))) ordering.push(getRef(entry, i))
            }
            const token = ordering.length > 1 ? addNode(g, NodeOp.after, ordering) : ordering[0] ?? 0
            const value = getRef(entry, slot + 1)
            const sunk = addCopy(g, store, [token, ptr, { literal: getLiteral(g, store, 2) }, value || { literal: getLiteral(g, entry, slot + 1) }], NodeOp.store)
            const sequenced = addNode(g, NodeOp.after, [sunk, entryApp])
            from.bodyId = replaceAll(from.bodyId, new Map([[outer ?? entryApp, sequenced]]))
            const removed = getRef(store, 0) || addNode(g, NodeOp.nilEffect, [])
            body.bodyId = replaceAll(body.bodyId, new Map([[id, removed]]))
            revisitBlock(from)
            revisitBlock(body)
            return true
        }
        return false
    }

    function rootsOf(sg: Set<number>) {
        const res = new Set<number>(sg)
        for (const x of sg) {
            const n = getNode(g, x)
            for (let i = 0; n && i < countIds(n); i++) res.delete(operandEdge(n, i))
        }
        return res
    }

    function isOrdered(vid: number): boolean {
        if (!vid) return false
        const u = getNode(g, vid)
        if (!u) return false
        if (!leavesArm(g, u)) return true
        if (u.op === NodeOp.param) {
            return true
        }
        for (let i = 0; i < countIds(u); i++) {
            if (isOrdered(getRef(u, i))) return true
        }
        return false
    }

    let liveParams: Set<number> | undefined
    function liveParameters(): Set<number> {
        if (liveParams) return liveParams
        const live = new Set<number>()
        const forwarded = new Map<number, number[]>()
        const pending: number[] = []
        function mark(p: number) {
            if (live.has(p)) return
            live.add(p)
            pending.push(p)
        }
        for (const b of reachableBlocks) {
            for (const p of b.params) {
                if (b.bodyId === p) mark(p)
                for (const id of dependents.get(p) ?? []) {
                    const n = getNode(g, id)!
                    if (n.op !== NodeOp.apply) { mark(p); break }
                }
            }
            for (const id of findValues(b.id, NodeOp.apply) ?? []) {
                const n = getNode(g, id)!
                const target = getGraphBlock(getRef(n, 0))
                for (let i = 1; i < countIds(n); i++) {
                    const p = getRef(n, i)
                    if (!p || getNode(g, p)!.op !== NodeOp.param) continue
                    const to = target.params[i - 1]
                    let from = forwarded.get(to)
                    if (!from) forwarded.set(to, from = [])
                    from.push(p)
                }
            }
        }
        while (pending.length) {
            for (const from of forwarded.get(pending.pop()!) ?? []) mark(from)
        }
        return liveParams = live
    }

    function shiftedArg(app: number, i: number): GraphNode | undefined {
        const arg = getNode(g, getRef(getNode(g, app)!, i + 1))
        return arg?.op === NodeOp.shl && !getRef(arg, 1) && getRef(arg, 0) ? arg : undefined
    }

    function shiftAt(inbound: [number, number][], i: number): number {
        let shift = -1
        for (const [, app] of inbound) {
            const arg = shiftedArg(app, i)
            if (!arg || (shift >= 0 && getLiteral(g, arg, 1) !== shift)) return -1
            shift = getLiteral(g, arg, 1)
        }
        return shift
    }

    function unshiftedAt(inbound: [number, number][], target: GraphBlock, i: number): number {
        let at = -1
        for (const [, app] of inbound) {
            const unshifted = getRef(shiftedArg(app, i)!, 0)
            const n = getNode(g, app)!
            let j = target.params.length - 1
            while (j >= 0 && (j === i || getRef(n, j + 1) !== unshifted)) j--
            if (j < 0 || (at >= 0 && j !== at)) return -1
            at = j
        }
        return at
    }

    function scaledAccess(u: number, p: number, shift: number): boolean {
        const n = getNode(g, u)
        return costs.scaledIndex && (n?.op === NodeOp.load || n?.op === NodeOp.store) && getRef(n, 2) === p && getRef(n, 1) !== p
            && intrinsics.intrinsicBitWidth(typeOf(n)) === 8 << shift
    }

    function rematerializeOffsets(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        let params: number[] | undefined
        let local: Map<number, number> | undefined
        for (let i = 0; i < target.params.length; i++) {
            const p = target.params[i]
            const users = dependents.get(p)
            if (!users?.size) continue
            const shift = shiftAt(inbound, i)
            if (shift < 0) continue
            const sample = shiftedArg(inbound[0][1], i)!
            const j = unshiftedAt(inbound, target, i)
            let source = j >= 0 ? target.params[j] : 0
            if (j >= 0 && shiftAt(inbound, j) >= 0) continue
            if (j < 0) {
                let scaled = true
                for (const u of users) if (!scaledAccess(u, p, shift)) { scaled = false; break }
                if (!scaled) continue
                params ??= target.params.slice()
                source = params[i] = paramLike(getRef(sample, 0))
            }
            local ??= new Map()
            local.set(p, addCopy(g, sample, [source, { literal: shift }], NodeOp.shl))
        }
        if (!local) return false
        target.bodyId = replaceAll(target.bodyId, local)
        if (params) {
            const edits = new Map<GraphBlock, Map<number, number>>()
            for (const [fromId, appId] of inbound) {
                const from = getGraphBlock(fromId)
                const id = from === target ? local.get(appId) ?? appId : appId
                const app = getNode(g, id)!
                const operands = getOperands(g, app)
                for (let i = 0; i < params.length; i++) {
                    if (params[i] !== target.params[i]) operands[i + 1] = getRef(shiftedArg(id, i)!, 0)
                }
                let r = edits.get(from)
                if (!r) edits.set(from, r = new Map())
                r.set(id, addCopy(g, app, operands, NodeOp.apply))
            }
            target.params = params
            for (const [from, r] of edits) {
                from.bodyId = replaceAll(from.bodyId, r)
                if (from !== target) revisitBlock(from)
            }
        }
        liveParams = undefined
        revisitBlock(target)
        return true
    }

    function carryFacts(b: GraphBlock, pruned: number[], inbound: [number, number][]): void {
        if (!pruned.length || !g.facts?.size) return
        const facted: GraphNode[] = []
        for (const n of g.nodes.values()) if (n.op === NodeOp.load && gn.factOf(n)) facted.push(n)
        if (!facted.length) return
        const values = new Map<number, number>()
        for (const p of pruned) values.set(p, enteringValue(b, p, inbound))
        for (const n of facted) {
            const fact = gn.factOf(n)
            if (!g.facts.has(fact)) continue
            if ([...values].some(([p, v]) => !v && factMentions(g, fact, p))) {
                gn.setFact(n, 0)
                continue
            }
            const next = substituteFact(g, fact, x => values.get(x) ? captureFact(g, values.get(x)!) : undefined)
            if (next !== fact) gn.setFact(n, next)
        }
    }

    function enteringValue(b: GraphBlock, p: number, inbound: [number, number][]): number {
        const at = b.params.indexOf(p) + 1
        let value = 0
        for (const [from, app] of inbound) {
            const u = getNode(g, app)!
            const arg = getRef(u, at)
            if (arg && relays(from, arg, b.id, p, new Set())) continue
            const v = arg || addNode(g, NodeOp.literal, [{ literal: getLiteral(g, u, at) }])
            if (value && value !== v && !(arg === 0 && getNode(g, value)?.op === NodeOp.literal && literalValue(g, getNode(g, value)!) === getLiteral(g, u, at))) return 0
            value = value || v
        }
        return value
    }

    function relays(blockId: number, value: number, target: number, p: number, seen: Set<number>): boolean {
        if (value === p) return true
        const block = getBlock(g, blockId)
        if (!block || seen.has(blockId)) return false
        const at = block.params.indexOf(value)
        if (at < 0) return false
        seen.add(blockId)
        const arrivals = findInboundApplies(block)
        if (!arrivals.length) return false
        for (const [from, app] of arrivals) {
            const arg = getRef(getNode(g, app)!, at + 1)
            if (!arg || !relays(from, arg, target, p, seen)) return false
        }
        return true
    }

    function pruneUnusedParams(b: GraphBlock) {
        if (b === g.blocks[0]) return false
        const live = liveParameters()
        const safe = new Set(b.params.filter(p => live.has(p)))
        if (safe.size === b.params.length) return false
        const inbound = findInboundApplies(b)
        const dead = b.params.filter(p => !safe.has(p))
        carryFacts(b, dead, inbound)
        const newParams = [...safe]
        const safeIndices = newParams.map(x => b.params.indexOf(x) + 1)
        b.params = newParams
        const replacements = new Map<number, number>()
        const changedBlocks = new Set<number>()
        for (const x of inbound) {
            changedBlocks.add(x[0])
            const u = getNode(g, x[1])!
            const o = [getRef(u, 0)] as (number | GraphNode)[]
            const rem: number[] = []
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (safeIndices.includes(i)) {
                    if (a) o.push(a)
                    else o.push(literal(g, getLiteral(g, u, i)))
                } else if (a && !isParam(g.nodes, a)) {
                    const q = simplifyOrdering(a, u)
                    if (q && !isNilOrVoid(q) && !rem.includes(q)) rem.push(q)
                }
            }
            let app = createNode(g, NodeOp.apply, o, u)
            if (rem.length) app = createNode(g, NodeOp.after, [...rem, app])
            replacements.set(x[1], app)
        }
        for (const bid of changedBlocks) {
            const b = getGraphBlock(bid)
            b.bodyId = replaceAll(b.bodyId, replacements)
        }
        const forwarded = new Map<number, number>()
        for (const p of dead) if (dependents.get(p)?.size) forwarded.set(p, addNode(g, NodeOp.literal, [{ literal: 0 }]))
        const bodyId = forwarded.size ? replaceAll(b.bodyId, forwarded) : b.bodyId
        if (bodyId !== b.bodyId) {
            b.bodyId = bodyId
            changedBlocks.add(b.id)
        }
        for (const bid of changedBlocks) {
            revisitBlock(getGraphBlock(bid))
        }
        return true
    }

    const orderedCache = new Map<number, boolean>()
    function isUnordered(id: number): boolean {
        return unorderedValue(g, id, orderedCache)
    }

    const guaranteedEffects = new Map<number, [version: number, effects: Map<number, Set<number>>]>()
    function guaranteedIn(b: GraphBlock): Map<number, Set<number>> {
        const version = versions.get(b.id) ?? 0
        const known = guaranteedEffects.get(b.id)
        if (known && known[0] === version) return known[1]
        const effects = new Map<number, Set<number>>([[0, new Set()]])
        guaranteedEffects.set(b.id, [version, effects])
        return effects
    }
    function guaranteed(b: GraphBlock, id: number): Set<number> {
        return guaranteedFrom(guaranteedIn(b), id)
    }
    function guaranteedFrom(effects: Map<number, Set<number>>, id: number): Set<number> {
        const known = effects.get(id)
        if (known) return known
        const n = getNode(g, id)!
        const out = new Set<number>()
        effects.set(id, out)
        if (n.op === NodeOp.select) {
            for (const effect of guaranteedFrom(effects, getRef(n, 0))) out.add(effect)
            const yes = guaranteedFrom(effects, getRef(n, 1))
            const no = guaranteedFrom(effects, getRef(n, 2))
            for (const effect of yes) if (no.has(effect)) out.add(effect)
        } else if (n) {
            const end = n.op === NodeOp.after ? countIds(n) - 1 : countIds(n)
            for (let i = 0; i < end; i++) {
                for (const effect of guaranteedFrom(effects, getRef(n, i))) out.add(effect)
            }
            if (OrderedValues.has(n.op)) out.add(id)
        }
        return out
    }

    function liftCommonEffects(target: GraphBlock) {
        const selects = findValues(target.id, NodeOp.select)
        if (!selects) return
        const lifts = new Map<number, number>()
        for (const id of selects) {
            const n = getNode(g, id)
            if (!n || n.op !== NodeOp.select) continue
            const yes = guaranteed(target, getRef(n, 1))
            if (!yes.size) continue
            const no = guaranteed(target, getRef(n, 2))
            if (!no.size) continue
            const before = guaranteed(target, getRef(n, 0))
            const unordered = !orderedUse(id)
            const users = [...dependents.get(id) ?? []].map(u => getNode(g, u))
            const orderedBefore = (effect: number) => !!users.length && users.every(m => {
                if (!m || m.op !== NodeOp.after || getRef(m, countIds(m) - 1) !== id) return false
                for (let i = 0; i < countIds(m) - 1; i++) if (guaranteed(target, getRef(m, i)).has(effect)) return true
                return false
            })
            const common: number[] = []
            for (const effect of yes) {
                if (no.has(effect) && !before.has(effect) && !(unordered && isRead(getNode(g, effect))) && !orderedBefore(effect)) common.push(effect)
            }
            const latest = common.filter(effect => {
                for (const other of common) {
                    if (other !== effect && guaranteed(target, other).has(effect)) return false
                }
                return true
            })
            if (latest.length === 1) lifts.set(id, latest[0])
        }
        if (!lifts.size) return
        for (const [id, effect] of lifts) {
            const select = getNode(g, id)!
            const inner = addCopy(g, select, getOperands(g, select), select.op)
            putNode(g, id, NodeOp.after, [effect, inner])
        }
        revisitBlock(target)
        return true
    }

    function liftCommonApplication(id: number) {
        const n = getNode(g, id)
        if (!n || n.op !== NodeOp.select) return false
        let yes = getNode(g, getRef(n, 1))
        let no = getNode(g, getRef(n, 2))
        const orderings: Operand[] = []
        if (yes?.op === NodeOp.after && no?.op === NodeOp.after) {
            const end = countIds(yes) - 1
            if (countIds(no) - 1 !== end) return false
            for (let i = 0; i < end; i++) {
                if (!getRef(yes, i) || getRef(yes, i) !== getRef(no, i)) return false
                orderings.push(getRef(yes, i))
            }
            yes = getNode(g, getRef(yes, end))
            no = getNode(g, getRef(no, end))
        }
        if (!yes || yes.op !== NodeOp.apply || !no || no.op !== NodeOp.apply) return false
        if (getRef(yes, 0) !== getRef(no, 0) || countIds(yes) !== countIds(no)) return false

        const block = getGraphBlock(getRef(yes, 0))
        const differ: number[] = []
        for (let i = 1; i < countIds(yes); i++) {
            if (getRef(yes, i) === getRef(no, i)
                && (getRef(yes, i) || getLiteral(g, yes, i) === getLiteral(g, no, i))) continue
            if (!isUnordered(getRef(yes, i)) || !isUnordered(getRef(no, i))) return false
            differ.push(i)
        }
        if (!differ.length && !isUnordered(getRef(n, 0))) return false

        const operands = getOperands(g, yes)
        for (const at of differ) operands[at] = addCopy(g, n, [getOperand(g, n, 0), getOperand(g, yes, at), getOperand(g, no, at)], NodeOp.select)
        if (!orderings.length) {
            putCopy(g, id, yes, operands)
            return true
        }
        putNode(g, id, NodeOp.after, [...orderings, addCopy(g, yes, operands, NodeOp.apply)])
        return true
    }

    function liftCommonApplications(target: GraphBlock) {
        const selects = findValues(target.id, NodeOp.select)
        if (!selects) return
        let changed = false
        for (let i = selects.length - 1; i >= 0; i--) {
            if (liftCommonApplication(selects[i])) changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    interface CountedLoop {
        selfApps: number[]
        entries: [blockId: number, appId: number][]
        invariant: Set<number>
        steps: (number | undefined)[]
        compare: GraphNode | undefined
        counter: number
        bound: [id: number, value: number]
    }

    const countedLoops = new Map<number, [version: number, inbound: number, loop: CountedLoop | undefined]>()
    function countedLoop(target: GraphBlock): CountedLoop | undefined {
        if (!preds.get(target.id)?.has(target.id)) return
        const version = versions.get(target.id) ?? 0
        const inbound = inboundVersions.get(target.id) ?? 0
        const known = countedLoops.get(target.id)
        if (known && known[0] === version && known[1] === inbound) return known[2]
        const selfApps: number[] = []
        const entries: [blockId: number, appId: number][] = []
        for (const x of findInboundApplies(target)) {
            if (x[0] === target.id) selfApps.push(x[1])
            else entries.push(x)
        }
        const loop: CountedLoop | undefined = !selfApps.length || !entries.length ? undefined
            : { selfApps, entries, invariant: new Set(), steps: [], compare: undefined, counter: -1, bound: [0, 0] }
        countedLoops.set(target.id, [version, inbound, loop])
        if (!loop) return
        const params = target.params
        const backs = selfApps.map(id => getNode(g, id)!)
        function stepOf(back: GraphNode, i: number): number | undefined {
            const n = getNode(g, getRef(back, i + 1))
            if (!n || countIds(n) !== 2) return
            const at = n.op === NodeOp.sub ? (getRef(n, 0) === params[i] ? 1 : -1)
                : n.op !== NodeOp.add ? -1
                : getRef(n, 0) === params[i] ? 1 : getRef(n, 1) === params[i] ? 0 : -1
            if (at < 0 || getRef(n, at) || !Number.isSafeInteger(getLiteral(g, n, at))) return
            return n.op === NodeOp.sub ? -getLiteral(g, n, at) : getLiteral(g, n, at)
        }
        for (let i = 0; i < params.length; i++) {
            let passed = true
            let step = stepOf(backs[0], i)
            for (const back of backs) {
                if (getRef(back, i + 1) !== params[i]) passed = false
                if (stepOf(back, i) !== step) step = undefined
            }
            if (passed) loop.invariant.add(params[i])
            loop.steps.push(step)
        }
        const tail = getNode(g, target.bodyId)
        if (backs.length !== 1 || tail?.op !== NodeOp.select || countIds(tail) !== 3 || tailOf(g, getRef(tail, 1)) !== selfApps[0]) return loop
        const cond = getNode(g, getRef(tail, 0))
        if (!cond || !CompareOps.has(cond.op) || comparesFloats(g, cond)) return loop
        const symmetric = cond.op === NodeOp.ne || cond.op === NodeOp.eq
        for (let at = 0; at < 2 && loop.counter < 0; at++) {
            const i = params.indexOf(getRef(cond, at))
            if (i < 0 || loop.steps[i] === undefined || (at && !symmetric) || !loopInvariant(loop, getRef(cond, at ^ 1))) continue
            loop.compare = cond
            loop.counter = i
            loop.bound = [getRef(cond, at ^ 1), getLiteral(g, cond, at ^ 1)]
        }
        return loop
    }

    function loopInvariant(loop: CountedLoop, id: number): boolean {
        if (!id || loop.invariant.has(id)) return true
        const n = getNode(g, id)!
        if (n.op === NodeOp.literal) return true
        if (!BinaryOps.has(n.op) && !UnaryOps.has(n.op) && n.op !== NodeOp.convert) return false
        for (let i = 0; i < countIds(n); i++) if (!loopInvariant(loop, getRef(n, i))) return false
        return true
    }

    function privateStep(loop: CountedLoop, i: number): boolean {
        for (const app of loop.selfApps) {
            for (const u of dependents.get(getRef(getNode(g, app)!, i + 1)) ?? []) {
                if (!loop.selfApps.includes(u)) return false
            }
        }
        return true
    }

    interface Trip {
        span: [id: number, value: number] | undefined
        shift: number
        zeros: number
    }

    function tripCount(cond: GraphNode, start: [number, number], bound: [number, number], stride: number): Trip | undefined {
        const k = Math.abs(stride)
        if (!k || !Number.isSafeInteger(k)) return
        const from = stride > 0 ? start : bound
        const to = stride > 0 ? bound : start
        if (stride > 0 ? cond.op !== NodeOp.lt && cond.op !== NodeOp.le && cond.op !== NodeOp.ne : cond.op !== NodeOp.ne) return
        if (!from[0] && !to[0]) {
            if (!Number.isSafeInteger(from[1]) || !Number.isSafeInteger(to[1]) || from[1] < 0 || to[1] < 0) return
            const span = to[1] - from[1]
            if (cond.op === NodeOp.ne && (span < 0 || span % k !== 0)) return
            const count = Math.max(0, cond.op === NodeOp.le ? Math.floor(span / k) + 1 : Math.ceil(span / k))
            return { span: [0, count], shift: 0, zeros: lowZeros(g, 0, count) }
        }
        const shift = Math.log2(k)
        if (!Number.isInteger(shift) || cond.op === NodeOp.le) return
        const ranges = currentRanges()
        let zeros = Math.min(ranges.zeros(from[0], from[1]), ranges.zeros(to[0], to[1]))
        const sum = to[0] ? getNode(g, to[0]) : undefined
        if (from[0] && sum?.op === NodeOp.add) {
            for (const i of [0, 1]) if (getRef(sum, i) === from[0]) zeros = ranges.zeros(getRef(sum, i ^ 1), getLiteral(g, sum, i ^ 1))
        }
        if (zeros < shift) return
        const exact = !from[0] && !from[1] && !lowering.isSignedType(operandType(g, cond, 0)) && !lowering.isSignedType(operandType(g, cond, 1))
        return { span: exact ? to : undefined, shift, zeros: zeros - shift }
    }

    function loopTrip(target: GraphBlock, loop: CountedLoop, app: GraphNode): Trip | undefined {
        return tripCount(loop.compare!, outsideOf(target, app, [target.params[loop.counter], 0]), outsideOf(target, app, loop.bound), loop.steps[loop.counter]!)
    }

    function outsideOf(target: GraphBlock, app: GraphNode, value: [number, number]): [number, number] {
        const at = target.params.indexOf(value[0])
        return at < 0 ? value : [getRef(app, at + 1), getLiteral(g, app, at + 1)]
    }

    function widenCountedStores(target: GraphBlock) {
        const stores = findValues(target.id, NodeOp.store)
        if (!stores?.length) return
        const loop = countedLoop(target)
        if (!loop || !loop.compare) return
        const tail = getNode(g, target.bodyId)!
        const ivAt = loop.counter
        const iv = target.params[ivAt]
        const back = getNode(g, loop.selfApps[0])!
        const step = loop.steps[ivAt]!
        if (step <= 0) return
        const increment = getNode(g, getRef(back, ivAt + 1))!
        let width = 0
        for (const id of stores) {
            const n = getNode(g, id)!
            const T = typeOf(n)
            if (T === Types.f64 || T === Types.f32 || T === Types.f16) return
            const bytes = intrinsics.intrinsicBitWidth(T) / 8
            if (getRef(n, 2) !== iv || getRef(n, 3) || !loopInvariant(loop, getRef(n, 1)) || bytes !== step || (width && bytes !== width)) return
            width = bytes
        }
        for (let i = 0; i < target.params.length; i++) {
            if (i !== ivAt && !loop.invariant.has(target.params[i])) return
        }
        const looping = new Set<number>()
        const work = [getRef(tail, 0), ...stores]
        for (let i = 1; i < countIds(back); i++) work.push(getRef(back, i))
        while (work.length) {
            const id = work.pop()!
            if (!id || looping.has(id)) continue
            const n = getNode(g, id)!
            if (n.op === NodeOp.param || n.op === NodeOp.block) continue
            if (n.op === NodeOp.load || n.op === NodeOp.call) return
            looping.add(id)
            for (let i = 0; i < countIds(n); i++) work.push(getRef(n, i))
        }
        const allowed = new Set<number>([getRef(tail, 0), getRef(back, ivAt + 1), ...stores])
        for (const u of dependents.get(iv) ?? []) {
            const n = getNode(g, u)
            if (allowed.has(u) || (n?.op === NodeOp.apply && u !== loop.selfApps[0])) continue
            return
        }
        let zeros = 64
        for (const [, app] of loop.entries) {
            const trip = loopTrip(target, loop, getNode(g, app)!)
            if (!trip) return
            zeros = Math.min(zeros, trip.zeros)
        }
        let factor = 1
        while (zeros > 0 && factor * 2 * width <= 8) {
            factor = factor * 2
            zeros--
        }
        if (factor === 1) return
        const wide = factor * width === 8 ? Types.u64 : factor * width === 4 ? Types.u32 : Types.u16
        const m = 2 ** (width * 8)
        const widened: number[] = []
        for (const id of stores) {
            const value = ((getLiteral(g, getNode(g, id)!, 3) % m) + m) % m
            let replicated = 0
            for (let k = 0; k < factor; k++) replicated += value * 2 ** (width * 8 * k)
            if (!Number.isSafeInteger(replicated)) return
            widened.push(replicated)
        }
        for (let i = 0; i < stores.length; i++) {
            const id = stores[i]
            const n = getNode(g, id)!
            const copy = copyNode(g, n, [getOperand(g, n, 0), getOperand(g, n, 1), getOperand(g, n, 2), { literal: widened[i] }])
            setType(copy, wide)
            setNode(g, id, copy)
        }
        const operands = getOperands(g, back)
        operands[ivAt + 1] = addCopy(g, increment, [iv, { literal: step * factor }], NodeOp.add)
        putCopy(g, loop.selfApps[0], back, operands)
        revisitBlock(target)
        return true
    }

    function mergeConstantStores(target: GraphBlock) {
        const stores = findValues(target.id, NodeOp.store)
        if (!stores || stores.length < 2) return
        const integer = new Map<number, Types>([[1, Types.u8], [2, Types.u16], [4, Types.u32], [8, Types.u64]])
        function piece(n: GraphNode): [offset: number, bytes: number, value: number] | undefined {
            const T = typeOf(n)
            if (T === Types.f64 || T === Types.f32 || getRef(n, 2) || getRef(n, 3)) return
            const bytes = intrinsics.intrinsicBitWidth(T) / 8
            const value = getLiteral(g, n, 3)
            if (!integer.has(bytes) || !Number.isSafeInteger(value)) return
            const range = 2 ** (bytes * 8)
            const wrapped = value % range
            const unsigned = wrapped < 0 ? wrapped + range : wrapped
            if (!Number.isSafeInteger(unsigned)) return
            return [getLiteral(g, n, 2), bytes, unsigned]
        }
        let pieces = 0
        for (const id of stores) if (piece(getNode(g, id)!)) pieces++
        if (pieces < 2) return
        function continues(id: number, prior: number): boolean {
            const n = getNode(g, id)!
            const p = getNode(g, prior)
            return p?.op === NodeOp.store && getRef(p, 1) === getRef(n, 1) && !!piece(p) && !!piece(n)
        }
        function retires(chain: number[]): number[] | undefined {
            const stores = new Set(chain.slice(0, -1))
            const dying = new Set(stores)
            for (const x of chain.slice(1)) dying.add(getRef(getNode(g, x)!, 0))
            const last = chain[chain.length - 1]
            const held: number[] = []
            for (const x of dying) for (const u of dependents.get(x) ?? []) {
                if (u === last || dying.has(u)) continue
                const n = getNode(g, u)
                if (n?.op !== NodeOp.after || stores.has(getRef(n, countIds(n) - 1)) || !slotParts(u).has(last)) return
                held.push(u)
            }
            return held
        }
        function priorOf(id: number): number {
            const token = getRef(getNode(g, id)!, 0)
            if (continues(id, token)) return token
            const t = getNode(g, token)
            if (t?.op !== NodeOp.after || !isNilOrVoid(getRef(t, countIds(t) - 1)) || dependents.get(token)?.size !== 1) return 0
            const parts = cloneRefs(t, 0, countIds(t) - 1)
            for (const prior of parts) {
                if (!continues(id, prior)) continue
                const covered = slotParts(prior)
                if (parts.every(x => x === prior || covered.has(x))) return prior
            }
            return 0
        }
        const next = new Map<number, number>()
        for (const id of stores) {
            const prior = priorOf(id)
            if (prior) next.set(prior, id)
        }
        const continued = new Set(next.values())
        let changed = false
        for (const id of stores) {
            if (continued.has(id) || !next.has(id)) continue
            const chain = [id]
            while (next.has(chain[chain.length - 1])) chain.push(next.get(chain[chain.length - 1])!)
            let held = retires(chain)
            while (chain.length > 1 && !held) {
                chain.pop()
                held = retires(chain)
            }
            if (chain.length < 2 || !held) continue
            const bytes = new Map<number, number>()
            let overlap = false
            for (const x of chain) {
                const [offset, size, value] = piece(getNode(g, x)!)!
                for (let k = 0; k < size; k++) {
                    if (bytes.has(offset + k)) overlap = true
                    bytes.set(offset + k, Math.floor(value / 2 ** (8 * k)) % 256)
                }
            }
            if (overlap) continue
            const offsets = [...bytes.keys()].sort((a, b) => a - b)
            const emitted: [offset: number, size: number, value: number][] = []
            for (let i = 0; i < offsets.length;) {
                const at = offsets[i]
                let size = 8
                for (; size > 1; size = size / 2) {
                    if (at % size !== 0) continue
                    let whole = true
                    let value = 0
                    for (let k = 0; k < size && whole; k++) {
                        if (!bytes.has(at + k)) whole = false
                        else value += bytes.get(at + k)! * 2 ** (8 * k)
                    }
                    if (whole && Number.isSafeInteger(value)) break
                }
                let value = 0
                for (let k = 0; k < size; k++) value += bytes.get(at + k)! * 2 ** (8 * k)
                emitted.push([at, size, value])
                i += size
                while (i < offsets.length && offsets[i] < at + size) i++
            }
            if (emitted.length >= chain.length) continue
            const last = getNode(g, chain[chain.length - 1])!
            let token = getOperand(g, getNode(g, chain[0])!, 0)
            emitted.forEach(([offset, size, value], i) => {
                const operands = [token, getOperand(g, last, 1), { literal: offset }, { literal: value }]
                const node = copyNode(g, last, operands)
                setType(node, integer.get(size)!)
                if (i === emitted.length - 1) setNode(g, chain[chain.length - 1], node)
                else token = insertNode(g, node)
            })
            const merged = new Set(chain.slice(0, -1))
            for (const u of new Set(held)) {
                const n = getNode(g, u)!
                const operands = getOperands(g, n)
                for (let i = 0; i < countIds(n) - 1; i++) if (merged.has(getRef(n, i))) operands[i] = chain[chain.length - 1]
                putCopy(g, u, n, operands)
            }
            changed = true
        }
        if (!changed) return
        revisitBlock(target)
        return true
    }


    function unrollSmallLoop(target: GraphBlock): boolean {
        const tail = getNode(g, target.bodyId)
        if (tail?.op !== NodeOp.select || countIds(tail) !== 3) return false
        const stay = getRef(tail, 1)
        const leave = getRef(tail, 2)
        const cond = getNode(g, getRef(tail, 0))
        if (!cond || (cond.op !== NodeOp.lt && cond.op !== NodeOp.le && cond.op !== NodeOp.ne) || comparesFloats(g, cond)) return false
        const counter = getRef(cond, 0)
        if (!target.params.includes(counter)) return false
        const chain: GraphBlock[] = [target]
        let next = getNode(g, tailOf(g, stay))
        while (next?.op === NodeOp.apply && getRef(next, 0) !== target.id) {
            const block = getGraphBlock(getRef(next, 0))
            if (chain.includes(block) || chain.length >= 4) return false
            chain.push(block)
            next = getNode(g, tailOf(g, block.bodyId))
        }
        if (next?.op !== NodeOp.apply) return false
        const effects = new Set<NodeOp>()
        for (const block of chain) {
            for (const op of [NodeOp.call, NodeOp.store, NodeOp.pstack, NodeOp.alloca, NodeOp.rt]) {
                if (findValues(block.id, op)?.length) effects.add(op)
            }
            for (const p of block.params) {
                const T = typeOf(getNode(g, p)!)
                if (typeof T === 'number' && RangedTypes.has(T) && intrinsics.intrinsicBitWidth(T) < 64) return false
            }
        }
        const members = new Set(chain.map(b => b.id))
        const exit = getNode(g, tailOf(g, leave))
        if (exit?.op === NodeOp.apply && members.has(getRef(exit, 0))) return false
        for (const block of chain.slice(1)) {
            if (findInboundApplies(block).some(([from]) => !members.has(from))) return false
        }
        interface Linear {
            param: number
            offset: number
        }
        function linear(id: number, literal: number, env: Map<number, Linear>, open = false): Linear | undefined {
            if (!id) return Number.isSafeInteger(literal) ? { param: 0, offset: literal } : undefined
            if (env.has(id)) return env.get(id)
            const n = getNode(g, id)!
            if (n.op === NodeOp.literal) return linear(0, getLiteral(g, n, 0), env)
            if (n.op === NodeOp.after) return linear(getRef(n, countIds(n) - 1), getLiteral(g, n, countIds(n) - 1), env, open)
            if (n.op !== NodeOp.add && n.op !== NodeOp.sub) return open ? { param: id, offset: 0 } : undefined
            const a = linear(getRef(n, 0), getLiteral(g, n, 0), env, open)
            const b = linear(getRef(n, 1), getLiteral(g, n, 1), env, open)
            if (!a || !b || b.param) return
            if (a.param && n.op === NodeOp.sub && a.offset < b.offset) return
            return { param: a.param, offset: n.op === NodeOp.add ? a.offset + b.offset : a.offset - b.offset }
        }
        let env = new Map<number, Linear>()
        for (const p of target.params) env.set(p, { param: p, offset: 0 })
        for (let i = 0; i < chain.length; i++) {
            const app = getNode(g, tailOf(g, i === 0 ? stay : chain[i].bodyId))!
            const into = chain[(i + 1) % chain.length]
            const mapped = new Map<number, Linear>()
            for (let k = 0; k < into.params.length; k++) {
                const value = linear(getRef(app, k + 1), getLiteral(g, app, k + 1), env)
                if (value) mapped.set(into.params[k], value)
            }
            env = mapped
        }
        const update = env.get(counter)
        if (!update || update.param !== counter || update.offset <= 0) return false
        const stride = update.offset
        const entries = findInboundApplies(target).filter(([from]) => !members.has(from))
        if (!entries.length) return false
        function incoming(index: number): Linear | undefined {
            const values = entries.map(([, id]) => {
                const app = getNode(g, id)!
                const value = constantOf(app, index + 1)
                if (value !== undefined) return linear(0, value, env)
                return linear(getRef(app, index + 1), getLiteral(g, app, index + 1), new Map(), true)
            })
            if (!values.every(v => v && v.param === values[0]!.param && v.offset === values[0]!.offset)) return
            return values[0]
        }
        const from = incoming(target.params.indexOf(counter))
        const limit = getRef(cond, 1)
        const limitAt = target.params.indexOf(limit)
        let to: Linear | undefined
        if (!limit) to = { param: 0, offset: getLiteral(g, cond, 1) }
        else if (limitAt >= 0 && env.get(limit)?.param === limit && env.get(limit)!.offset === 0) to = incoming(limitAt)
        if (!from || !to || from.param !== to.param) return false
        const base = from.param
        const start = from.offset
        const bound = to.offset
        if (base && !AddressOps.has(getNode(g, base)!.op)) return false
        const trip = tripCount(cond, [0, start], [0, bound], stride)
        if (!trip?.span) return false
        const count = trip.span[1]
        const T = typeOf(getNode(g, counter)!)
        if (count > 4 || start + count * stride > Math.min(Number.MAX_SAFE_INTEGER, rangeMax(T))) return false
        if (count > 1) {
            for (const op of [NodeOp.call, NodeOp.pstack, NodeOp.alloca, NodeOp.rt]) {
                if (effects.has(op)) return false
            }
            let size = 0
            for (const block of chain) size += blockSize(block, 49)
            if (size * count > 48) return false
        }
        const initial = new Map<number, number>()
        if (!base) initial.set(counter, addNode(g, NodeOp.literal, [{ literal: start }], T))
        if (!base && limitAt >= 0) initial.set(limit, addNode(g, NodeOp.literal, [{ literal: bound }]))
        function enter(path: number[], into: GraphBlock, original: number): number | undefined {
            if (effects.size) return inlineApplication(path, into, original, true)
            const app = getNode(g, path[path.length - 1])!
            const args = new Map<number, number>()
            for (let k = 0; k < into.params.length; k++) {
                const T = typeOf(getNode(g, into.params[k])!)
                args.set(into.params[k], getRef(app, k + 1) || addNode(g, NodeOp.literal, [{ literal: getLiteral(g, app, k + 1) }], T))
            }
            const copied: number[] = []
            const body = freshCopy(original, args, copied)
            if (copied.length) remapFacts(copied, args)
            return addNode(g, NodeOp.after, [...getOperands(g, app).slice(1), body])
        }
        function expand(block: GraphBlock, iteration: number, body: number, prefix: number[]): number | undefined {
            if (block === target && iteration === count) return body
            const path = prefix.slice()
            let at = body
            let n = getNode(g, at)!
            while (n.op === NodeOp.after) {
                path.push(at)
                at = getRef(n, countIds(n) - 1)
                n = getNode(g, at)!
            }
            path.push(at)
            const into = getGraphBlock(getRef(n, 0))
            const next = into === target ? iteration + 1 : iteration
            let original = into.bodyId
            if (into === target) original = next === count ? leave : stay
            const merged = enter(path, into, original)
            if (merged === undefined) return
            const rest = expand(into, next, merged, path.slice(0, -1))
            if (rest === undefined) return
            return replaceAll(body, new Map([[at, rest]]))
        }
        const copied: number[] = []
        const first = freshCopy(count ? stay : leave, initial, copied)
        if (copied.length) remapFacts(copied, initial)
        const unrolled = expand(target, 0, first, [])
        if (unrolled === undefined) return false
        target.bodyId = unrolled
        for (const block of chain.slice(1)) removeBlock(block)
        revisitBlock(target)
        return true
    }

    function closeCountedLoop(target: GraphBlock) {
        const loop = countedLoop(target)
        if (!loop || !loop.compare) return
        const tail = getNode(g, target.bodyId)!
        let stay = getRef(tail, 1)
        for (let n = getNode(g, stay); n?.op === NodeOp.after; n = getNode(g, stay)) {
            for (let i = 0; i < countIds(n) - 1; i++) if (!isUnordered(getRef(n, i))) return
            stay = getRef(n, countIds(n) - 1)
        }
        if (stay !== loop.selfApps[0]) return
        const exit = getNode(g, getRef(tail, 2))
        if (!exit || exit.op !== NodeOp.apply) return
        const bound = loop.bound
        if (bound[0] && !loop.invariant.has(bound[0])) return

        const back = getNode(g, loop.selfApps[0])!
        const params = target.params
        const ivAt = loop.counter
        const stride = loop.steps[ivAt]!
        const accumulators: [at: number, step: [number, number], of: GraphNode][] = []
        for (let i = 0; i < params.length; i++) {
            if (i === ivAt || loop.invariant.has(params[i])) continue
            const update = getNode(g, getRef(back, i+1))
            if (!update || update.op !== NodeOp.add) return
            const at = getRef(update, 0) === params[i] ? 1
                : getRef(update, 1) === params[i] ? 0 : -1
            if (at < 0 || (getRef(update, at) && !loop.invariant.has(getRef(update, at)))) return
            accumulators.push([i, [getRef(update, at), getLiteral(g, update, at)], update])
        }

        const paramSet = new Set<number>(params)
        function pureFrom(id: number): boolean {
            if (paramSet.has(id)) return true
            const n = getNode(g, id)
            if (!n || !leavesArm(g, n)) return false
            for (let i = 0; i < countIds(n); i++) if (getRef(n, i) && !pureFrom(getRef(n, i))) return false
            return true
        }
        for (let i = 1; i < countIds(exit); i++) if (!pureFrom(getRef(exit, i))) return
        const reached = new Set<number>()
        const work: number[] = []
        for (let i = 1; i < countIds(exit); i++) work.push(getRef(exit, i))
        let invariantExit = true
        while (work.length && invariantExit) {
            const id = work.pop()!
            if (!id || reached.has(id)) continue
            reached.add(id)
            if (paramSet.has(id)) {
                if (!loop.invariant.has(id)) invariantExit = false
                continue
            }
            const n = getNode(g, id)!
            for (let i = 0; i < countIds(n); i++) work.push(getRef(n, i))
        }

        const touched: number[] = []
        for (const [blockId, appId] of loop.entries) {
            const app = getNode(g, appId)!
            const trip = loopTrip(target, loop, app)
            if (!trip || (!trip.span && !invariantExit)) continue
            const finals = new Map<number, [number, number]>()
            for (let i = 0; i < params.length; i++) finals.set(params[i], applyArg(appId, i))
            const span = trip.span ?? [0, 0]
            const count: [number, number] = !trip.shift ? span
                : [addCopy(g, getNode(g, getRef(back, ivAt + 1))!, [span[0], { literal: trip.shift }], NodeOp.ushr), 0]
            if (trip.span) finals.set(params[ivAt], span[0] ? outsideOf(target, app, bound) : [0, applyArg(appId, ivAt)[1] + span[1] * stride])
            for (const [at, step, of] of trip.span ? accumulators : []) {
                const s = outsideOf(target, app, step)
                const total = !s[0] && s[1] === 1 ? count[0] || addNode(g, NodeOp.literal, [{ literal: count[1] }])
                    : addCopy(g, of, [count[0] || { literal: count[1] }, s[0] || { literal: s[1] }], NodeOp.mul)
                const initial = applyArg(appId, at)
                const final = initial[0] || initial[1]
                    ? addCopy(g, of, [initial[0] || { literal: initial[1] }, total], NodeOp.add)
                    : total
                finals.set(params[at], [final, 0])
            }

            const rebuilt = new Map<number, Operand>()
            function rebuild(id: number): Operand {
                const final = finals.get(id)
                if (final) return final[0] || { literal: final[1] }
                if (isArgless(getNode(g, id)!)) return id
                const known = rebuilt.get(id)
                if (known !== undefined) return known
                const n = getNode(g, id)!
                const ops = getOperands(g, n)
                for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) ops[i] = rebuild(getRef(n, i))
                const out = addCopy(g, n, ops)
                rebuilt.set(id, out)
                return out
            }
            const operands = getOperands(g, exit)
            for (let i = 1; i < operands.length; i++) {
                if (getRef(exit, i)) operands[i] = rebuild(getRef(exit, i))
            }
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addCopy(g, exit, operands, NodeOp.apply)]]))
            touched.push(blockId)
        }
        if (!touched.length) return
        for (const blockId of touched) revisitBlock(getGraphBlock(blockId))
        return true
    }

    function hoistSharedSelectValues(target: GraphBlock) {
        const tail = getNode(g, target.bodyId)
        if (!tail || tail.op !== NodeOp.select || countIds(tail) < 3) return false
        const condition = collectSubgraph(getRef(tail, 0), new Set(), 3)
        if (condition.size > 3) return false // ideally, you would compare against how much baggage the shared roots would drop
        for (const id of condition) if (getNode(g, id)?.op === NodeOp.call) return false

        let shared: Set<number> | undefined
        for (let i = 1; i < countIds(tail); i++) {
            const arm = collectSubgraph(getRef(tail, i))
            if (!shared) shared = arm
            else for (const id of shared) if (!arm.has(id)) shared.delete(id)
        }
        if (!shared?.size) return false
        const demandedByArms = armDemand(g, target.bodyId, new Map()).every
        for (const id of condition) shared.delete(id)
        for (const param of target.params) shared.delete(param)

        const roots = [...rootsOf(shared)].filter(id => {
            const n = getNode(g, id)
            if (!n) return false
            if (TargetingValues.has(n.op)) return false
            if (!leavesArm(g, n) && !demandedByArms.has(id)) return false
            if (OrderedValues.has(n.op)) return isNilOrVoid(getRef(n, 0))
            if (isOrdered(id)) return false
            return n.op !== NodeOp.block && n.op !== NodeOp.literal
                && n.op !== NodeOp.nilEffect && n.op !== NodeOp.void && n.op !== NodeOp.apply
                && n.op !== NodeOp.select && n.op !== NodeOp.ret && n.op !== NodeOp.panic
                && n.op !== NodeOp.unreachable
        })
        if (!roots.length) return false

        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const oldParams = [...target.params]
        const sharedParams = roots.map(r => paramLike(r))
        const inside = new Map<number, number>()
        for (let i = 0; i < roots.length; i++) inside.set(roots[i], sharedParams[i])
        target.params.push(...sharedParams)
        target.bodyId = replaceAll(target.bodyId, inside)

        const forwardedParams = oldParams.map(p => paramLike(p))
        const outside = new Map<number, number>()
        for (let i = 0; i < oldParams.length; i++) outside.set(oldParams[i], forwardedParams[i])
        const hoisted = roots.map(root => replaceAll(root, outside))
        const args = [target.id, ...forwardedParams, ...hoisted]
        const forward = addNode(g, NodeOp.apply, args)
        const forwardingId = addBlock(forwardedParams, forward)

        const callers = new Set<GraphBlock>()
        for (const [blockId] of inbound) callers.add(getGraphBlock(blockId))
        for (const caller of callers) {
            caller.bodyId = replaceAll(caller.bodyId, new Map([[target.id, forwardingId]]))
        }
        for (const caller of callers) revisitBlock(caller)
        revisitBlock(target)
        revisitBlock(getGraphBlock(forwardingId))
        return true
    }

    function deriveIncrementor(target: GraphBlock) {
        const loop = countedLoop(target)
        if (!loop) return
        const backs = loop.selfApps.map(id => getNode(g, id)!)
        const params = target.params
        const invariants = loop.invariant
        function invariant(n: GraphNode, i: number) {
            return !getRef(n, i) || invariants.has(getRef(n, i))
        }
        function derivation(n: GraphNode, from: number) {
            if (countIds(n) !== 2) return -1
            const at = getRef(n, 0) === from ? 0 : getRef(n, 1) === from ? 1 : -1
            if (at < 0) return -1
            if (n.op === NodeOp.add) return invariant(n, at ^ 1) ? at : -1
            if (n.op === NodeOp.mul) return !getRef(n, at ^ 1) && getLiteral(g, n, at ^ 1) > 0 ? at : -1
            if (n.op === NodeOp.shl) return at === 0 && !getRef(n, 1) ? at : -1
            return -1
        }

        for (let at = 0; at < params.length; at++) {
            const p = params[at]
            const stride = loop.steps[at]
            if (invariants.has(p) || stride === undefined || !privateStep(loop, at)) continue
            const steps = new Set(backs.map(back => getRef(back, at + 1)))
            if (backs.some(back => getArgIds(back).some((id, i) => i !== at + 1 && steps.has(id)))) continue

            const chain: [id: number, from: number][] = []
            const compares: number[] = []
            let valid = true
            for (const u of dependents.get(p) ?? []) {
                if (steps.has(u)) continue
                const n = getNode(g, u)!
                if (CompareOps.has(n.op) && invariant(n, getRef(n, 0) === p ? 1 : 0)) {
                    if (lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))) valid = false
                    compares.push(u)
                    continue
                }
                const from = derivation(n, p)
                if (from < 0 || chain.length) valid = false
                chain.push([u, from])
            }
            if (!valid || !chain.length) continue
            for (;;) {
                const uses = dependents.get(chain[chain.length - 1][0])
                if (!uses || uses.size !== 1) break
                let next = 0
                for (const u of uses) next = u
                const from = derivation(getNode(g, next)!, chain[chain.length - 1][0])
                if (from < 0) break
                chain.push([next, from])
            }

            let scale = 1
            for (const [id, from] of chain) {
                const n = getNode(g, id)!
                if (n.op === NodeOp.mul) scale *= getLiteral(g, n, from ^ 1)
                if (n.op === NodeOp.shl) scale *= 2 ** getLiteral(g, n, 1)
            }
            if (!Number.isSafeInteger(stride * scale)) continue

            function replay(value: [number, number], operand: (id: number, value: number) => [number, number]) {
                for (const [id, from] of chain) {
                    const n = getNode(g, id)!
                    const ids = [0, 0]
                    const consts = [0, 0]
                    ids[from] = value[0]
                    consts[from] = value[1]
                    const x = operand(getRef(n, from ^ 1), getLiteral(g, n, from ^ 1))
                    ids[from ^ 1] = x[0]
                    consts[from ^ 1] = x[1]
                    if (ids[0] || ids[1]) {
                        value = [addCopy(g, n, ids.map((id, i) => id || { literal: consts[i] }), n.op), 0]
                    } else if (n.op === NodeOp.add) {
                        value = [0, consts[0] + consts[1]]
                    } else if (n.op === NodeOp.mul) {
                        value = [0, consts[0] * consts[1]]
                    } else {
                        value = [0, consts[0] * 2 ** consts[1]]
                    }
                }
                return value
            }
            const closed = chain.every(([id, from]) => !getRef(getNode(g, id)!, from ^ 1))

            function moved<T>(a: T[]): T[] {
                return [...a.slice(0, at + 1), ...a.slice(at + 2, params.length + 1), a[at + 1], ...a.slice(params.length + 1)]
            }
            const derived = chain[chain.length - 1][0]
            let addr = 0
            const memory: [id: number, offset: number][] = []
            function locate(id: number, offset: number): boolean {
                for (const u of dependents.get(id) ?? []) {
                    const n = getNode(g, u)!
                    if (n.op === NodeOp.add && countIds(n) === 2) {
                        const at = getRef(n, 0) === id ? 1 : 0
                        if (getRef(n, at) || !locate(u, offset + getLiteral(g, n, at))) return false
                        continue
                    }
                    if (n.op !== NodeOp.load && n.op !== NodeOp.store) return false
                    if (getRef(n, 2) !== id || getRef(n, 3) === id || !invariants.has(getRef(n, 1))) return false
                    if (addr && addr !== getRef(n, 1)) return false
                    addr = getRef(n, 1)
                    memory.push([u, offset])
                }
                return true
            }
            if (!closed || !locate(derived, 0)) addr = 0
            const shift = Math.log2(scale)
            const folded = !addr && Number.isInteger(shift) && [...dependents.get(derived) ?? []].every(u => scaledAccess(u, derived, shift))
            if (folded) continue
            const bias = addr ? replay([0, 0], (id, value) => [id, value])[1] : 0
            function address(value: [number, number], outside: (id: number, value: number) => [number, number]): [number, number] {
                const base = outside(addr, 0)
                if (!value[0] && !value[1]) return base
                const offset = value[0] ? addNode(g, NodeOp.mul, [value[0], { literal: scale }]) : 0
                return [addNode(g, NodeOp.add, [base[0] || { literal: base[1] }, offset || { literal: value[1] * scale }]), 0]
            }

            const replacements = new Map<number, number>()
            if (!addr) replacements.set(derived, p)
            const limits: [param: number, bound: [number, number]][] = []
            for (const id of compares) {
                const n = getNode(g, id)!
                const boundAt = getRef(n, 0) === p ? 1 : 0
                const operands = getOperands(g, n)
                if (closed && !addr && !getRef(n, boundAt)) {
                    operands[boundAt] = { literal: replay([0, getLiteral(g, n, boundAt)], (id, value) => [id, value])[1] }
                } else {
                    const limit = paramLike(getRef(n, boundAt))
                    limits.push([limit, [getRef(n, boundAt), getLiteral(g, n, boundAt)]])
                    operands[boundAt] = limit
                }
                replacements.set(id, addCopy(g, n, operands, n.op))
            }
            for (const [id, offset] of addr ? memory : []) {
                const n = getNode(g, id)!
                const operands = getOperands(g, n)
                operands[1] = p
                operands[2] = { literal: bias + offset }
                putCopy(g, id, n, operands)
            }

            for (let k = 0; k < backs.length; k++) {
                const back = backs[k]
                const backOperands: Operand[] = [target.id]
                for (let i = 1; i < countIds(back); i++) {
                    backOperands.push(i === at + 1 ? 0 : replaceAll(getRef(back, i), replacements) || { literal: getLiteral(g, back, i) })
                }
                const step = getNode(g, getRef(back, at + 1))!
                backOperands[at + 1] = addCopy(g, step, [p, { literal: stride * scale }], NodeOp.add)
                for (const [limit] of limits) backOperands.push(limit)
                replacements.set(loop.selfApps[k], addCopy(g, back, moved(backOperands), NodeOp.apply))
            }

            for (const [blockId, appId] of loop.entries) {
                const app = getNode(g, appId)!
                function outside(id: number, value: number): [number, number] {
                    if (!id) return [0, value]
                    const i = params.indexOf(id) + 1
                    return [getRef(app, i), getLiteral(g, app, i)]
                }
                const operands = getOperands(g, app)
                const derive = addr ? address : replay
                const n = derive([getRef(app, at + 1), getLiteral(g, app, at + 1)], outside)
                operands[at + 1] = n[0] || { literal: n[1] }
                for (const [, bound] of limits) {
                    const [id, value] = derive(outside(...bound), outside)
                    operands.push(id || { literal: value })
                }
                const caller = getGraphBlock(blockId)
                caller.bodyId = replaceAll(caller.bodyId,
                    new Map([[appId, addCopy(g, app, moved(operands), NodeOp.apply)]]))
                revisitBlock(caller)
            }

            target.params = moved([target.id, ...params, ...limits.map(x => x[0])]).slice(1)
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
    }

    interface CounterCarrier {
        block: GraphBlock
        at: number
        bound: number
        stepped: boolean
    }

   function reverseLoop(target: GraphBlock) {
        const tail = getNode(g, target.bodyId)
        if (!tail || tail.op !== NodeOp.select) return
        const condId = getRef(tail, 0)
        const cond = getNode(g, condId)!
        if (!cond || (cond.op !== NodeOp.lt && cond.op !== NodeOp.le)) return
        if (lowering.isSignedType(operandType(g, cond, 0)) || lowering.isSignedType(operandType(g, cond, 1))) return
        const params = target.params
        const at = params.indexOf(getRef(cond, 0))
        const boundAt = params.indexOf(getRef(cond, 1))
        if (at < 0 || boundAt < 0 || at === boundAt) return
        const p = params[at]
        const bound = params[boundAt]
        const exit = getRef(tail, 2)
        if (reaches(exit, p)) return

        const carriers = new Map<number, CounterCarrier>()
        const chain = new Set<number>()
        const steps: [block: GraphBlock, id: number][] = []
        const memory: number[] = []
        const work: number[] = []
        let stride = 0
        carriers.set(p, { block: target, at, bound, stepped: false })
        work.push(p)

        function feed(carrier: CounterCarrier, value: number, appId: number, stepped: boolean) {
            const app = getNode(g, appId)
            if (!app || app.op !== NodeOp.apply) return false
            const b = getGraphBlock(getRef(app, 0))
            if (countIds(app) !== b.params.length + 1) return false
            let nat = -1
            for (let i = 0; i < b.params.length; i++) {
                if (getRef(app, i + 1) !== value) continue
                if (nat >= 0) return false
                nat = i
            }
            if (nat < 0) return false
            chain.add(appId)
            if (b === target) {
                return nat === at && stepped && getRef(app, boundAt + 1) === carrier.bound
            }
            let nbound = -1
            for (let i = 0; i < b.params.length; i++) {
                if (getRef(app, i + 1) === carrier.bound) { nbound = i; break }
            }
            if (nbound < 0) return false
            const q = b.params[nat]
            const known = carriers.get(q)
            if (known) return known.bound === b.params[nbound] && known.stepped === stepped
            carriers.set(q, { block: b, at: nat, bound: b.params[nbound], stepped })
            work.push(q)
            return true
        }

        while (const q = work.pop()) {
            const carrier = carriers.get(q)!
            for (const u of dependents.get(q) ?? []) {
                if (q === p && u === condId) continue
                const n = getNode(g, u)!
                if (q === p && (n.op === NodeOp.load || n.op === NodeOp.store)
                    && getRef(n, 1) === q && !getRef(n, 2) && getRef(n, 3) !== q) {
                    memory.push(u)
                    continue
                }
                if (n.op === NodeOp.add && getRef(n, 0) === q && !getRef(n, 1)) {
                    if (carrier.stepped) return
                    const s = getLiteral(g, n, 1)
                    if (!Number.isSafeInteger(s) || s <= 0 || (stride && stride !== s)) return
                    const uses = dependents.get(u)
                    if (uses?.size !== 1) return
                    stride = s
                    steps.push([carrier.block, u])
                    if (!feed(carrier, u, [...uses!][0], true)) return
                    continue
                }
                if (!feed(carrier, q, u, carrier.stepped)) return
            }
        }
        if (!steps.length) return
        for (const carrier of carriers.values()) {
            if (carrier.block === target) continue
            for (const [, appId] of findInboundApplies(carrier.block)) {
                if (!chain.has(appId)) return
            }
        }

        const entries = findInboundApplies(target).filter(x => !chain.has(x[1]))
        if (!entries.length) return

        function arg(app: GraphNode, i: number): [number, number] {
            return [getRef(app, i + 1), getLiteral(g, app, i + 1)]
        }
        function multiple(id: number, value: number) {
            if (stride === 1) return true
            if (!id) return value % stride === 0
            const n = getNode(g, id)
            if (!n || getRef(n, 1)) return false
            if (n.op === NodeOp.mul) return getLiteral(g, n, 1) % stride === 0
            if (n.op === NodeOp.shl) return 2 ** getLiteral(g, n, 1) % stride === 0
            return false
        }
        function aligned(app: GraphNode) {
            const start = arg(app, at)
            const limit = arg(app, boundAt)
            if (!start[0] && !start[1]) return multiple(limit[0], limit[1])
            if (!start[0] || !limit[0]) return false
            const n = getNode(g, limit[0])
            if (!n || n.op !== NodeOp.add) return false
            const other = getRef(n, 0) === start[0] ? 1 : getRef(n, 1) === start[0] ? 0 : -1
            return other >= 0 && multiple(getRef(n, other), getLiteral(g, n, other))
        }
        if (!entries.every(x => aligned(getNode(g, x[1])!))) return

        const zero = entries.every(x => {
            const start = arg(getNode(g, x[1])!, at)
            return !start[0] && !start[1]
        })

        if (memory.length) return reverseMemoryWalk()

        if (!zero) return
        if (cond.op === NodeOp.le && stride !== 1) return
        const template = getNode(g, steps[0][1])!
        const edits = new Map<GraphBlock, Map<number, number>>()
        function edit(b: GraphBlock, from: number, to: number) {
            let m = edits.get(b)
            if (!m) edits.set(b, m = new Map())
            m.set(from, to)
        }
        edit(target, condId, addCopy(g, cond, [p, 0], NodeOp.ne))
        for (const [b, id] of steps) {
            const n = getNode(g, id)!
            edit(b, id, addCopy(g, n, [getRef(n, 0), { literal: getLiteral(g, n, 1) }], NodeOp.sub))
        }
        for (const [b, m] of edits) b.bodyId = replaceAll(b.bodyId, m)
        for (const [blockId, appId] of entries) {
            const app = getNode(g, appId)!
            const operands = getOperands(g, app)
            const limit = arg(app, boundAt)
            const start: [number, number] = cond.op === NodeOp.lt ? limit
                : limit[0] ? [addCopy(g, template, [limit[0], { literal: 1 }], NodeOp.add), 0]
                : [0, limit[1] + 1]
            operands[at + 1] = start[0] || { literal: start[1] }
            const caller = getGraphBlock(blockId)
            caller.bodyId = replaceAll(caller.bodyId,
                new Map([[appId, addCopy(g, app, operands, NodeOp.apply)]]))
            edits.set(caller, edits.get(caller) ?? new Map())
        }
        for (const b of edits.keys()) revisitBlock(b)
        if (!edits.has(target)) revisitBlock(target)
        return true

        function reverseMemoryWalk() {
            if (cond.op !== NodeOp.lt || chain.size !== 1 || steps.length !== 1 || carriers.size !== 1) return
            const backId = [...chain][0]
            if (getRef(tail!, 1) !== backId) return
            if (findValues(target.id, NodeOp.select)?.length !== 1) return
            if (findValues(target.id, NodeOp.store)?.length) return
            if (findValues(target.id, NodeOp.call)?.length) return
            const back = getNode(g, backId)!
            for (const u of dependents.get(bound) ?? []) {
                if (u !== condId && u !== backId) return
            }
            const stepId = steps[0][1]

            const accumulating = new Set<NodeOp>([NodeOp.add, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor])
            const accumulators = new Map<number, number>()
            for (let i = 0; i < params.length; i++) {
                if (i === at || getRef(back, i + 1) === params[i]) continue
                const uses = dependents.get(params[i])
                if (!uses?.size) continue
                const updateId = getRef(back, i + 1)
                const update = getNode(g, updateId)
                if (!update || !accumulating.has(update.op) || typeOf(update) === Types.f64) return
                const x = getRef(update, 0) === params[i] ? 1 : getRef(update, 1) === params[i] ? 0 : -1
                if (x < 0) return
                for (const u of uses) {
                    if (u !== updateId && u !== exit) return
                }
                if (dependents.get(updateId)?.size !== 1) return
                accumulators.set(params[i], getRef(update, x))
            }
            const accumulated = new Set<number>(accumulators.keys())
            for (const x of accumulators.values()) {
                if (x && (accumulated.has(x) || reachesAnyOf(x, accumulated))) return
            }

            const bias = zero ? 0 : Math.min(...memory.map(u => getLiteral(g, getNode(g, u)!, 2)))
            for (const u of bias ? memory : []) {
                const n = getNode(g, u)!
                putCopy(g, u, n, withOperand(g, n, 2, { literal: getLiteral(g, n, 2) - bias }))
            }
            const next = addCopy(g, getNode(g, stepId)!, [p, { literal: stride }], NodeOp.sub)
            const test = addCopy(g, cond, [p, zero ? 0 : bound], NodeOp.ne)
            target.bodyId = replaceAll(target.bodyId, new Map([[condId, test], [stepId, next], [p, next]]))

            function shifted(value: [number, number]): [number, number] {
                if (!bias) return value
                if (!value[0]) return [0, value[1] + bias]
                return [addNode(g, NodeOp.add, [value[0], { literal: bias }]), 0]
            }
            function rebased(app: GraphNode, stop: [number, number]): [number, number] {
                const limit = getNode(g, getRef(app, boundAt + 1))!
                const other = getRef(limit, 0) === getRef(app, at + 1) ? 1 : 0
                return [addNode(g, NodeOp.add, [stop[0] || { literal: stop[1] }, getOperand(g, limit, other)]), 0]
            }
            for (const [blockId, appId] of entries) {
                const app = getNode(g, appId)!
                const operands = getOperands(g, app)
                const stop = shifted(arg(app, at))
                const start = bias ? rebased(app, stop) : arg(app, boundAt)
                operands[at + 1] = start[0] || { literal: start[1] }
                operands[boundAt + 1] = stop[0] || { literal: stop[1] }
                const caller = getGraphBlock(blockId)
                caller.bodyId = replaceAll(caller.bodyId,
                    new Map([[appId, addCopy(g, app, operands, NodeOp.apply)]]))
                revisitBlock(caller)
            }
            revisitBlock(target)
            return true
        }
    }

    function rotateLoop(target: GraphBlock) {
        const tail = getNode(g, target.bodyId)
        if (!tail || tail.op !== NodeOp.select) return
        const back = getNode(g, getRef(tail, 1))
        if (!back || back.op !== NodeOp.apply || getRef(back, 0) !== target.id) return

        function gather(id: number, out: Set<number>): Set<number> {
            if (!id || out.has(id)) return out
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.block) return out
            out.add(id)
            for (let i = n.op === NodeOp.apply ? 1 : 0; i < countIds(n); i++) gather(getRef(n, i), out)
            return out
        }
        const inCond = gather(getRef(tail, 0), new Set())
        const inBack = new Set<number>()
        for (let i = 1; i < countIds(back); i++) gather(getRef(back, i), inBack)
        const inExit = gather(getRef(tail, 2), new Set())

        let shared = false
        for (let i = 1; i < countIds(back); i++) {
            const arg = getRef(back, i)
            if (arg && hasNode(g, arg) && !isParam(g.nodes, arg) && inCond.has(arg)) { shared = true; break }
        }
        if (!shared) return

        const unconditional = new Set(inCond)
        for (const id of inBack) if (inExit.has(id)) unconditional.add(id)
        function speculatable(id: number): boolean {
            if (!id || unconditional.has(id)) return true
            const n = getNode(g, id)!
            if (!leavesArm(g, n)) return false
            for (const arg of getArgIds(n)) if (!speculatable(arg)) return false
            return true
        }
        for (let i = 1; i < countIds(back); i++) {
            if (!speculatable(getRef(back, i))) return
        }

        const params: number[] = []
        const args: number[] = []
        const lowered = new Map<number, [id: number, konst: number]>()
        function drag(id: number, konst: number): [id: number, konst: number] {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const p = paramLike(id)
            const out: [id: number, konst: number] = [p, 0]
            lowered.set(id, out)
            params.push(p)
            args.push(id)
            return out
        }
        function lower(id: number, konst: number): [id: number, konst: number] | undefined {
            if (!id) return [0, konst]
            const known = lowered.get(id)
            if (known) return known
            const n = getNode(g, id)
            if (!n || isParam(g.nodes, id) || inBack.has(id)) return drag(id, konst)
            if (n.op !== NodeOp.after && !PureOps.has(n.op)) return
            const operands: Operand[] = []
            for (let i = 0; i < countIds(n); i++) {
                const arg = lower(getRef(n, i), getLiteral(g, n, i))
                if (!arg) return
                operands.push(arg[0] || { literal: arg[1] })
            }
            const out: [id: number, konst: number] = [addCopy(g, n, operands, n.op), 0]
            lowered.set(id, out)
            return out
        }

        const backOperands: Operand[] = [target.id]
        for (let i = 1; i < countIds(back); i++) {
            const [id, konst] = drag(getRef(back, i), getLiteral(g, back, i))
            backOperands.push(id || { literal: konst })
        }

        const cond = lower(getRef(tail, 0), getLiteral(g, tail, 0))
        if (!cond) return

        let exit: [id: number, konst: number] | undefined
        const exitNode = getNode(g, getRef(tail, 2))
        if (exitNode?.op === NodeOp.apply) {
            const operands: Operand[] = [getRef(exitNode, 0)]
            for (let i = 1; i < countIds(exitNode); i++) {
                const arg = lower(getRef(exitNode, i), getLiteral(g, exitNode, i))
                if (!arg) return
                operands.push(arg[0] || { literal: arg[1] })
            }
            exit = [addCopy(g, exitNode, operands, NodeOp.apply), 0]
        } else {
            exit = lower(getRef(tail, 2), getLiteral(g, tail, 2))
        }
        if (!exit) return

        const backApply = addCopy(g, back, backOperands, NodeOp.apply)
        const body = addCopy(g, tail, [cond[0] || { literal: cond[1] }, backApply, exit[0] || { literal: exit[1] }], NodeOp.select)
        const blockId = addBlock(params, body)
        const entryIds = [blockId, ...args]
        target.bodyId = addCopy(g, back, entryIds, NodeOp.apply)
        revisitBlock(target)
        return true
    }

    function advanceLoopLoads(target: GraphBlock): boolean {
        if ((findValues(target.id, NodeOp.store)?.length ?? 0) || (findValues(target.id, NodeOp.call)?.length ?? 0)) return false
        const loop = countedLoop(target)
        if (!loop || loop.selfApps.length !== 1) return false
        const back = getNode(g, loop.selfApps[0])!

        for (let at = 0; at < target.params.length; at++) {
            const param = target.params[at]
            const stepId = getRef(back, at + 1)
            const stride = loop.steps[at]
            if (!stride || stride <= 0 || stride > costs.writebackStride) continue

            const compares = [...dependents.get(param) ?? []].filter(id => {
                const n = getNode(g, id)!
                return n.op === NodeOp.lt && getRef(n, 0) === param
                    && !lowering.isSignedType(operandType(g, n, 0)) && !lowering.isSignedType(operandType(g, n, 1))
            })
            if (compares.length !== 1) continue
            const compareId = compares[0]
            const loads = [...dependents.get(param) ?? []].filter(id => {
                const n = getNode(g, id)!
                return n.op === NodeOp.load && getRef(n, 1) === param && !getRef(n, 2)
            })
            const advancing = loads.find(id => getLiteral(g, getNode(g, id)!, 2) === stride
                && [...dependents.get(id) ?? []].some(user => CompareOps.has(getNode(g, user)?.op)))
            if (advancing === undefined) continue
            const allowed = new Set<number>([stepId, compareId, ...loads])
            if ([...dependents.get(param) ?? []].some(id => !allowed.has(id))) continue

            const combine = [...dependents.get(compareId) ?? []].find(id => {
                const n = getNode(g, id)!
                if (n.op !== NodeOp.and) return false
                const other = getRef(n, 0) === compareId ? getRef(n, 1)
                    : getRef(n, 1) === compareId ? getRef(n, 0) : 0
                return !!other && reaches(other, advancing)
            })
            if (combine === undefined) continue

            const compare = getNode(g, compareId)!
            const nextCompare = addCopy(g, compare, [stepId, getOperand(g, compare, 1)], NodeOp.le)
            const and = getNode(g, combine)!
            const other = getRef(and, 0) === compareId ? getRef(and, 1) : getRef(and, 0)
            const replacements = new Map<number, number>([
                [compareId, nextCompare],
                [combine, addCopy(g, and, [other, nextCompare], NodeOp.and)],
            ])
            for (const id of loads) {
                if (id === advancing) continue
                const load = getNode(g, id)!
                const offset = getLiteral(g, load, 2)
                if (offset < stride) { replacements.clear(); break }
                const operands = getOperands(g, load)
                operands[1] = stepId
                operands[2] = { literal: offset - stride }
                replacements.set(id, addCopy(g, load, operands, NodeOp.load))
            }
            if (!replacements.size) continue
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
        return false
    }

    function eliminatePassthru(b: GraphBlock) {
        let bodyId = b.bodyId
        let body = getNode(g, bodyId)
        assert(body)
        if (body.op === NodeOp.apply && getRef(body, 0) !== b.id && b.id !== g.root) {
            const forwarded: number[] = []
            for (let i = 1; i < countLiterals(body); i++) {
                const arg = getRef(body, i)
                const at = arg ? b.params.indexOf(arg) : -1
                if (at < 0) return false
                forwarded.push(at + 1)
            }
            const applies = findInboundApplies(b)
            for (const [, id] of applies) {
                if (countIds(getNode(g, id)!) !== b.params.length + 1) return false
            }
            const byBlock = new Map<number, Map<number, number>>()
            for (const [blockId, id] of applies) {
                const app = getNode(g, id)!
                const operands = [getRef(body, 0), ...forwarded.map(i => getOperand(g, app, i))]
                let replacements = byBlock.get(blockId)
                if (!replacements) byBlock.set(blockId, replacements = new Map())
                replacements.set(id, addCopy(g, app, operands, NodeOp.apply))
            }
            for (const [blockId, replacements] of byBlock) {
                const from = getGraphBlock(blockId)
                from.bodyId = replaceAll(from.bodyId, replacements)
                revisitBlock(from)
            }
            removeBlock(b)
            return true
        }
        if (b.params.length > 1) return false
        if (body.op === NodeOp.ret) {
            return false
        }
        const isVoid = body.op === NodeOp.void
        const isUnreachable = body.op === NodeOp.unreachable
        if (!isVoid && !isUnreachable && !b.params.includes(bodyId)) return false

        const applies = findInboundApplies(b)
        const byBlock = new Map<number, number[]>()
        for (const x of applies) {
            let arr = byBlock.get(x[0])
            if (!arr) byBlock.set(x[0], arr = [])
            arr.push(x[1])
        }
        for (const [k, v] of byBlock) {
            const r = new Map<number, number>()
            for (const x of v) {
                const a = getNode(g, x)!
                if (isUnreachable || (isVoid && !b.params.length)) {
                    r.set(x, b.bodyId)
                    continue
                }
                const arg = getRef(a, 1)
                if (arg) {
                    if (isVoid) {
                        r.set(x, addNode(g, NodeOp.after, [arg, b.bodyId]))
                    } else {
                        r.set(x, arg)
                    }
                    continue
                }
                const c = getLiteral(g, a, 1)
                const literal = addNode(g, NodeOp.literal, [{ literal: c }])
                if (isVoid) {
                    r.set(x, addNode(g, NodeOp.after, [literal, b.bodyId]))
                } else {
                    r.set(x, literal)
                }
            }
            const t = getBlock(g, k)!
            t.bodyId = replaceAll(t.bodyId, r)
            revisitBlock(t)
        }
        removeBlock(b)
        return true
    }

    function mergeBlocks(target: GraphBlock): boolean {
        const next = successors.get(target.id)
        return !!next && next.size === 1 && mergeSuccessor(target, getGraphBlock([...next][0]))
    }

    function mergeSuccessor(target: GraphBlock, b: GraphBlock): boolean {
        if (b.id === target.id || b.id === g.root || preds.get(b.id)?.size !== 1) return false
        const tail = getNode(g, b.bodyId)
        if (!tail || tail.op === NodeOp.panic) return false
        if ((findValues(b.id, NodeOp.apply)?.length ?? 0) > 1) return false

        const paths = applicationPaths(target, b.id)
        if (paths.length !== 1) return false
        const path = paths[0]
        const site = path[path.length - 1]
        const app = getNode(g, site)!
        if (countIds(app) !== b.params.length + 1) return false
        if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false

        const merged = inlineApplication(path, b, b.bodyId)
        if (merged === undefined) return false

        removeBlock(b)
        target.bodyId = replaceAll(target.bodyId, new Map([[site, merged]]))
        revisitBlock(target)
        const into = preds.get(target.id)
        if (into?.size === 1 && !into.has(target.id)) mergeBlocks(getGraphBlock([...into][0]))
        return true
    }

    function foldKnownConditions(target: GraphBlock): boolean {
        const selects = findValues(target.id, NodeOp.select) ?? []
        if (selects.length < 2) return false
        interface Known { keys: Map<string, number>, facts: Facts }
        function keyOf(id: number): string | undefined {
            const n = getNode(g, id)
            if (!n) return
            return n.op === NodeOp.param || n.op === NodeOp.block ? `#${id}` : nodeKey(g, n)
        }
        const conditions = new Set<string>()
        let repeated = false
        for (const s of selects) {
            const cond = getRef(getNode(g, s)!, 0)
            const key = cond ? keyOf(cond) : undefined
            if (key === undefined) continue
            if (conditions.has(key)) {
                repeated = true
                break
            }
            conditions.add(key)
            const n = getNode(g, cond)!
            if (CompareOps.has(n.op) && !comparesFloats(g, n)) conditions.add(nodeKey(g, copyNode(g, n, getOperands(g, n), InverseCompare.get(n.op)!)))
        }
        const offsetBy = (n: GraphNode, a: number, b: number) => {
            const m = getRef(n, a) ? getNode(g, getRef(n, a)) : undefined
            return m?.op === NodeOp.sub && !!getRef(n, b) && getRef(m, 0) === getRef(n, b)
        }
        let offsetCompare = false
        for (const op of CompareOps) {
            for (const id of findValues(target.id, op) ?? []) {
                const n = getNode(g, id)!
                if (offsetBy(n, 0, 1) || offsetBy(n, 1, 0)) offsetCompare = true
            }
        }
        if (!repeated && !offsetCompare) return false
        function assume(known: Known, cond: number, value: number): Known {
            const keys = new Map(known.keys)
            const facts: Facts = [...known.facts, [cond, value === 1]]
            const key = keyOf(cond)
            if (key === undefined) return { keys, facts }
            keys.set(key, value)
            const n = getNode(g, cond)!
            if (CompareOps.has(n.op) && !comparesFloats(g, n)) keys.set(nodeKey(g, copyNode(g, n, getOperands(g, n), InverseCompare.get(n.op)!)), value ? 0 : 1)
            return { keys, facts }
        }
        function compared(n: GraphNode, facts: Facts): number | undefined {
            if (!facts.length || !CompareOps.has(n.op) || !getRef(n, 0) || !getRef(n, 1) || comparesFloats(g, n)) return
            const ranges = currentRanges()
            if (ranges.below(getRef(n, 0), getRef(n, 1), 0, facts)) return n.op === NodeOp.lt || n.op === NodeOp.le || n.op === NodeOp.ne ? 1 : 0
            if (ranges.below(getRef(n, 1), getRef(n, 0), 0, facts)) return n.op === NodeOp.gt || n.op === NodeOp.ge || n.op === NodeOp.ne ? 1 : 0
        }
        function lookup(known: Known, cond: number): number | undefined {
            if (!cond || !known.keys.size) return
            const key = keyOf(cond)
            const exact = key === undefined ? undefined : known.keys.get(key)
            return exact ?? compared(getNode(g, cond)!, known.facts)
        }
        const uses = countUses(g, target.bodyId)
        function exclusive(root: number): Set<number> {
            const inside = new Set<number>()
            if ((uses.get(root) ?? 0) > 1) return inside
            const refs = new Map<number, number>()
            const stack = [root]
            inside.add(root)
            while (stack.length) {
                for (const x of getArgIds(getNode(g, stack.pop()!)!)) {
                    if (!x || inside.has(x)) continue
                    const k = (refs.get(x) ?? 0) + 1
                    refs.set(x, k)
                    if (k !== uses.get(x)) continue
                    inside.add(x)
                    stack.push(x)
                }
            }
            return inside
        }
        function rewrite(id: number, known: Known): number {
            if (!id || !known.keys.size) return id
            const r = new Map<number, number>()
            const walked = new Set<number>()
            const rebuilt = new Map<number, number>()
            const own = exclusive(id)
            const fixed = (n: GraphNode, x: number) => n.op === NodeOp.param || n.op === NodeOp.block || (OrderedValues.has(n.op) && !own.has(x))
            function rebuild(x: number): number {
                const replaced = r.get(x) ?? rebuilt.get(x)
                if (replaced !== undefined) return replaced
                const n = getNode(g, x)
                if (!n || fixed(n, x)) return x
                rebuilt.set(x, x)
                let ops: Operand[] | undefined
                for (let i = 0; i < countIds(n); i++) {
                    const ref = getRef(n, i)
                    if (!ref) continue
                    const next = rebuild(ref)
                    if (next === ref) continue
                    ops ??= getOperands(g, n)
                    ops[i] = next
                }
                const out = ops ? addCopy(g, n, ops) : x
                rebuilt.set(x, out)
                return out
            }
            function visit(x: number): void {
                if (!x || walked.has(x)) return
                walked.add(x)
                const n = getNode(g, x)
                if (!n || fixed(n, x)) return
                for (const a of getArgIds(n)) visit(a)
                const value = compared(n, known.facts)
                if (value !== undefined) {
                    r.set(x, addNode(g, NodeOp.literal, [{ literal: value }]))
                    return
                }
                if (n.op !== NodeOp.select || countIds(n) !== 3) return
                const k = lookup(known, getRef(n, 0))
                if (k === undefined) return
                const arm = k ? 1 : 2
                r.set(x, getRef(n, arm)
                    ? rebuild(getRef(n, arm))
                    : addNode(g, NodeOp.literal, [{ literal: getLiteral(g, n, arm) }]))
            }
            visit(id)
            return r.size ? rebuild(id) : id
        }
        function tails(id: number, known: Known): number {
            const n = getNode(g, id)
            if (!n) return id
            if (n.op === NodeOp.select && countIds(n) === 3) {
                const k = lookup(known, getRef(n, 0))
                if (k !== undefined) return getRef(n, k ? 1 : 2) ? tails(getRef(n, k ? 1 : 2), known) : rewrite(id, known)
                const a = tails(getRef(n, 1), assume(known, getRef(n, 0), 1))
                const b = tails(getRef(n, 2), assume(known, getRef(n, 0), 0))
                const c = rewrite(getRef(n, 0), known)
                if (a === getRef(n, 1) && b === getRef(n, 2) && c === getRef(n, 0)) return id
                return addCopy(g, n, withRefs(g, n, [c, a, b]), NodeOp.select)
            }
            if (n.op === NodeOp.after) {
                const last = countIds(n) - 1
                const argIds = getArgIds(n).map((x, i) => i === last ? tails(x, known) : rewrite(x, known))
                if (argIds.every((x, i) => x === getRef(n, i))) return id
                return addCopy(g, n, withRefs(g, n, argIds), NodeOp.after)
            }
            return rewrite(id, known)
        }
        const body = tails(target.bodyId, { keys: new Map(), facts: [] })
        if (body === target.bodyId) return false
        target.bodyId = body
        revisitBlock(target)
        return true
    }

    function reduceSelects(b: GraphBlock) {
        const selects = findValues(b.id, NodeOp.select)
        if (!selects?.length) return false

        function sameOperand(a: GraphNode, ai: number, c: GraphNode, ci: number) {
            const aId = getRef(a, ai)
            const cId = getRef(c, ci)
            return aId === cId && (aId || getLiteral(g, a, ai) === getLiteral(g, c, ci))
        }

        const nested = new Map<number, number>()
        for (const id of selects) {
            const outer = getNode(g, id)!
            if (countIds(outer) !== 3) continue
            for (const innerAt of [1, 2]) {
                const inner = getNode(g, getRef(outer, innerAt))
                if (!inner || inner.op !== NodeOp.select || countIds(inner) !== 3
                    || !sameOperand(outer, 0, inner, 0)) continue
                const operands = [getOperand(g, outer, 0),
                    innerAt === 1 ? getOperand(g, inner, 1) : getOperand(g, outer, 1),
                    innerAt === 1 ? getOperand(g, outer, 2) : getOperand(g, inner, 2)]
                nested.set(id, addCopy(g, outer, operands, NodeOp.select))
                break
            }
        }
        if (nested.size) {
            b.bodyId = replaceAll(b.bodyId, nested)
            revisitBlock(b)
            return true
        }

        const conjunctions = new Map<number, number>()
        for (const id of selects) {
            const n = getNode(g, id)!
            if (countIds(n) !== 3 || getRef(n, 2) || getLiteral(g, n, 2) !== 0) continue
            const c1 = getNode(g, getRef(n, 0))
            const c2 = getNode(g, getRef(n, 1))
            if (!c1 || !c2 || !CompareOps.has(c1.op) || !CompareOps.has(c2.op)) continue
            if (comparesFloats(g, c1) || comparesFloats(g, c2)) continue
            if (!speculates(getRef(n, 1), getRef(n, 0))) continue
            conjunctions.set(id, addCopy(g, c2, [getRef(n, 0), getRef(n, 1)], NodeOp.and))
        }
        if (conjunctions.size) {
            b.bodyId = replaceAll(b.bodyId, conjunctions)
            revisitBlock(b)
            return true
        }

        const filtered = selects.filter(x => {
            const n = getNode(g, x)!
            if (countIds(n) !== 3 || getRef(n, 1) || getRef(n, 2)) return false
            const arm1 = getLiteral(g, n, 1)
            const arm2 = getLiteral(g, n, 2)
            return (arm1 === 0 && arm2 === 1) || (arm1 === 1 && arm2 === 0)
        })
        if (filtered.length === 0) return false
        const r = new Map<number, number>()
        for (const x of filtered) {
            const usages = dependents.get(x) ?? []
            for (const d of usages) {
                const u = getNode(g, d)!
                if (!CompareOps.has(u.op)) continue
                const selectAt = getRef(u, 0) === x ? 0 : getRef(u, 1) === x ? 1 : -1
                if (selectAt !== 0) continue
                if (getRef(u, 1) !== 0) continue
                const rhs = getLiteral(g, u, 1)
                if ((rhs === 1 || rhs === 0) && (u.op === NodeOp.eq || u.op === NodeOp.ne)) {
                    const qId = addCopy(g, u, [getRef(getNode(g, x)!, 0), { literal: 0 }], (u.op === NodeOp.eq) === (getLiteral(g, getNode(g, x)!, 1) === rhs) ? NodeOp.ne : NodeOp.eq)
                    r.set(d, qId)
                    continue
                }
            }
        }

        if (!r.size) return false
        b.bodyId = replaceAll(b.bodyId, r)
        revisitBlock(b)
        return true
    }

    function applicationPaths(from: GraphBlock, to: number): number[][] {
        const paths: number[][] = []
        function tails(id: number, path: number[]): void {
            const n = getNode(g, id)
            if (!n) return
            path.push(id)
            if (n.op === NodeOp.apply && getRef(n, 0) === to) paths.push(path.slice())
            else if (n.op === NodeOp.after) tails(getRef(n, countIds(n) - 1), path)
            else if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) tails(getRef(n, i), path)
            path.pop()
        }
        tails(from.bodyId, [])
        return paths
    }

    function freshCopy(id: number, r: Map<number, number>, copied: number[]): number {
        if (!id) return id
        const known = r.get(id)
        if (known !== undefined) return known
        const n = getNode(g, id)!
        if (n.op === NodeOp.param || n.op === NodeOp.block || isArgless(n)) return id
        const ids = cloneRefs(n).map(x => freshCopy(x, r, copied))
        const out = addCopy(g, n, withRefs(g, n, ids))
        r.set(id, out)
        if (gn.factOf(n)) copied.push(out)
        return out
    }

    function inlineApplication(path: number[], b: GraphBlock, bodyId: number, fresh = false): number | undefined {
        const app = getNode(g, path[path.length - 1])!
        let conditional = false
        const visited = new Map<Set<number>, Set<number>>()
        function frontier(id: number, into: Set<number>): void {
            if (conditional) return
            if (!id || into.has(id) || isUnordered(id)) return
            let seen = visited.get(into)
            if (!seen) visited.set(into, seen = new Set())
            if (seen.has(id)) return
            seen.add(id)
            const n = getNode(g, id)!
            if (OrderedValues.has(n.op)) {
                into.add(id)
            } else if (n.op === NodeOp.select) {
                frontier(getRef(n, 0), into)
                if (cloneRefs(n, 1).some(x => !isUnordered(x))) conditional = true
            } else {
                for (const x of getArgIds(n)) frontier(x, into)
            }
        }
        const order = new Set<number>()
        for (const id of path.slice(0, -1)) {
            const n = getNode(g, id)!
            const end = n.op === NodeOp.after ? countIds(n) - 1 : 1
            for (let i = 0; i < end; i++) frontier(getRef(n, i), order)
            if (conditional) return
        }
        const context = new Set(order)
        for (let i = 1; i < countIds(app); i++) frontier(getRef(app, i), order)
        if (conditional) return
        const implied = new Set<number>()
        for (const id of order) {
            for (const x of getArgIds(getNode(g, id)!)) frontier(x, implied)
        }
        const kept = [...order].filter(id => !implied.has(id))
        const join = kept.length > 1
            ? addNode(g, NodeOp.after, [...kept, addNode(g, NodeOp.void, [])])
            : kept[0] ?? 0

        const r = new Map<number, number>()
        for (let i = 0; i < b.params.length; i++) {
            r.set(b.params[i], getRef(app, i + 1) || addNode(g, NodeOp.literal, [{ literal: getLiteral(g, app, i + 1) }]))
        }
        if (join) {
            const epoch = nextEpoch(g)
            function nils(id: number): void {
                if (!id) return
                const n = getNode(g, id)
                if (!n || !markVisited(n, epoch)) return
                if (n?.op === NodeOp.nilEffect) r.set(id, join)
                else for (const x of getArgIds(n)) nils(x)
            }
            nils(bodyId)
        }
        let merged: number
        if (fresh) {
            const copied: number[] = []
            merged = freshCopy(bodyId, r, copied)
            if (copied.length) remapFacts(copied, r)
        } else {
            merged = replaceAll(bodyId, r)
        }
        const covered = new Set<number>()
        const inlined = collectSubgraph(bodyId)
        for (let i = 1; i < countIds(app); i++) if (inlined.has(b.params[i - 1])) frontier(getRef(app, i), covered)
        const dropped = kept.filter(id => !context.has(id) && !covered.has(id))
        if (dropped.length) merged = addNode(g, NodeOp.after, [...dropped, merged])
        return merged
    }

    function constantOf(n: GraphNode, i: number): number | undefined {
        let id = getRef(n, i)
        let konst = getLiteral(g, n, i)
        for (;;) {
            if (!id) return konst
            const u = getNode(g, id)
            if (!u) return
            if (u.op === NodeOp.literal) return literalValue(g, u)
            if (u.op !== NodeOp.after) return
            const last = countIds(u) - 1
            for (let j = 0; j < last; j++) {
                const op = getNode(g, getRef(u, j))?.op
                if (getRef(u, j) && op !== NodeOp.nilEffect && op !== NodeOp.void) return
            }
            id = getRef(u, last)
            konst = getLiteral(g, u, last)
        }
    }

    function stripNilAfters(target: GraphBlock): boolean {
        let changed = false
        for (const id of findValues(target.id, NodeOp.after) ?? []) {
            const n = getNode(g, id)!
            const last = countIds(n) - 1
            const value = getRef(n, last)
            if (!value || getNode(g, value)?.op !== NodeOp.param) continue
            let ordered = false
            for (let j = 0; j < last; j++) {
                const op = getRef(n, j) ? getNode(g, getRef(n, j))?.op : undefined
                if (getRef(n, j) && op !== NodeOp.nilEffect && op !== NodeOp.void) ordered = true
            }
            if (ordered) continue
            for (const u of [...dependents.get(id) ?? []]) {
                const m = getNode(g, u)!
                if (m.op === NodeOp.block || m.op === NodeOp.apply) continue
                let operands: Operand[] | undefined
                for (let j = 0; j < countIds(m); j++) {
                    if (getRef(m, j) !== id) continue
                    const token = m.op === NodeOp.after ? j < countIds(m) - 1 : j === 0 && OrderedValues.has(m.op)
                    if (token) continue
                    operands ??= getOperands(g, m)
                    operands[j] = value
                }
                if (!operands) continue
                putCopy(g, u, m, operands)
                changed = true
            }
        }
        if (changed) revisitBlock(target)
        return changed
    }
    function orderedConstant(n: GraphNode, i: number): number | undefined {
        let id = getRef(n, i)
        if (!id) return getLiteral(g, n, i)
        for (;;) {
            const u = getNode(g, id)
            if (!u) return
            if (u.op === NodeOp.literal) return literalValue(g, u)
            if (u.op !== NodeOp.after) return
            const last = countIds(u) - 1
            if (!getRef(u, last)) return getLiteral(g, u, last)
            id = getRef(u, last)
        }
    }
    function blockSize(b: GraphBlock, limit: number): number {
        const seen = new Set<number>()
        const stack = [b.bodyId]
        while (stack.length && seen.size <= limit) {
            const id = stack.pop()!
            const n = id ? getNode(g, id) : undefined
            if (!n || seen.has(id) || n.op === NodeOp.block || n.op === NodeOp.param) continue
            seen.add(id)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return seen.size
    }
    function threadConstantArrivals(target: GraphBlock): boolean {
        if (target.id === g.root) return false
        const froms = preds.get(target.id)
        if (!froms || froms.has(target.id)) return false
        if (findValues(target.id, NodeOp.call)?.length) return false
        if (!target.params.length || !findValues(target.id, NodeOp.select)?.length) return false
        if (blockSize(target, 12) > 12) return false
        const tests = (p: number) => {
            for (const u of dependents.get(p) ?? []) {
                const n = getNode(g, u)!
                if (n.op === NodeOp.select && getRef(n, 0) === p) return true
            }
            return false
        }
        const decides = (p: number) => {
            if (tests(p)) return true
            for (const u of dependents.get(p) ?? []) {
                const n = getNode(g, u)!
                if (!CompareOps.has(n.op) || comparesFloats(g, n)) continue
                if (getRef(n, 0) && getRef(n, 1)) continue
                if (tests(u)) return true
            }
            return false
        }
        const deciding = target.params.filter(decides)
        if (!deciding.length) return false
        const sites: [from: GraphBlock, path: number[]][] = []
        const seen = new Set<number>()
        for (const k of froms) {
            const from = getGraphBlock(k)
            for (const path of applicationPaths(from, target.id)) {
                const site = path[path.length - 1]
                if (seen.has(site)) return false
                seen.add(site)
                const app = getNode(g, site)!
                if (countIds(app) !== target.params.length + 1) return false
                if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false
                sites.push([from, path])
            }
        }
        if (sites.length < 2 || sites.length !== findInboundApplies(target).length) return false
        const literal = (p: number) => {
            const at = target.params.indexOf(p) + 1
            for (const [, path] of sites) {
                if (orderedConstant(getNode(g, path[path.length - 1])!, at) === undefined) return false
            }
            return true
        }
        if (!deciding.some(literal)) return false
        const merged: number[] = []
        for (const [, path] of sites) {
            const m = inlineApplication(path, target, target.bodyId, merged.length > 0)
            if (m === undefined) return false
            merged.push(m)
        }
        removeBlock(target)
        const edits = new Map<GraphBlock, Map<number, number>>()
        sites.forEach(([from, path], i) => {
            let r = edits.get(from)
            if (!r) edits.set(from, r = new Map())
            r.set(path[path.length - 1], merged[i])
        })
        for (const [from, r] of edits) {
            from.bodyId = replaceAll(from.bodyId, r)
            revisitBlock(from)
        }
        return true
    }

    function threadConstantBranches(target: GraphBlock): boolean {
        if (target.id === g.root) return false
        const tail = getNode(g, target.bodyId)
        if (!tail || tail.op !== NodeOp.select || countIds(tail) !== 3) return false
        const at = target.params.indexOf(getRef(tail, 0))
        if (at < 0) return false
        const froms = preds.get(target.id)
        if (!froms || froms.has(target.id)) return false

        const sites: [from: GraphBlock, path: number[], arm: number][] = []
        const seen = new Set<number>()
        const chosen = new Set<number>()
        for (const k of froms) {
            const from = getGraphBlock(k)
            for (const path of applicationPaths(from, target.id)) {
                const site = path[path.length - 1]
                if (seen.has(site)) return false
                seen.add(site)
                const app = getNode(g, site)!
                if (countIds(app) !== target.params.length + 1) return false
                if ((dependents.get(site)?.size ?? 0) !== Math.min(path.length - 1, 1)) return false
                const value = constantOf(app, at + 1)
                if (value === undefined) return false
                const arm = value ? 1 : 2
                if (!getRef(tail, arm) || chosen.has(arm)) return false
                chosen.add(arm)
                sites.push([from, path, getRef(tail, arm)])
            }
        }
        if (sites.length !== findInboundApplies(target).length) return false

        const merged: number[] = []
        for (const [, path, arm] of sites) {
            const m = inlineApplication(path, target, arm)
            if (m === undefined) return false
            merged.push(m)
        }
        const edits = new Map<GraphBlock, Map<number, number>>()
        for (let i = 0; i < sites.length; i++) {
            const [from, path] = sites[i]
            let r = edits.get(from)
            if (!r) edits.set(from, r = new Map())
            r.set(path[path.length - 1], merged[i])
        }
        removeBlock(target)
        for (const [from, r] of edits) {
            from.bodyId = replaceAll(from.bodyId, r)
            revisitBlock(from)
        }
        return true
    }

    function threadDecidedArrivals(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        const tail = getNode(g, target.bodyId)
        if (!tail || tail.op !== NodeOp.select || countIds(tail) !== 3) return false
        for (const arm of [1, 2]) {
            const exit = skipAfter(getRef(tail, arm)) ?? 0
            const n = getNode(g, exit)
            if (!n || (n.op !== NodeOp.apply && n.op !== NodeOp.ret && n.op !== NodeOp.unreachable)) return false
            if (exit !== getRef(tail, arm) && findValues(target.id, NodeOp.call)?.length) return false
        }
        const cond = getNode(g, getRef(tail, 0))
        if (!cond || !CompareOps.has(cond.op) || comparesFloats(g, cond)) return false
        const loads = [0, 1].map(i => entryLoad(target, getRef(cond, i)))
        const sides = [0, 1].map(i => !getRef(cond, i) ? -2 : loads[i] ? -3 : target.params.indexOf(getRef(cond, i)))
        if (sides.some(at => at === -1)) return false
        if (loads.some(n => n)) currentMem()
        const argsOf = (from: GraphBlock, appId: number) => {
            const app = getNode(g, appId)!
            const args: number[][] = []
            for (let i = 0; i < 2; i++) {
                const at = sides[i]
                const arg = at === -2 ? [0, getLiteral(g, cond, i)] : at === -3 ? arrivingLoad(target, from, appId, loads[i]!) : [getRef(app, at + 1), getLiteral(g, app, at + 1)]
                if (!arg || (arg[0] && !ArrivalShapes.has(getNode(g, arg[0])!.op))) return
                args.push(arg)
            }
            return args
        }
        const compare = (args: number[][], facts: Facts) => decideCompare(cond, args[0], args[1], facts)
        const decided: [from: GraphBlock, path: number[], arm: number][] = []
        let survives = false
        for (const [fromId, appId] of findInboundApplies(target)) {
            if (fromId === target.id) {
                survives = true
                continue
            }
            const from = getGraphBlock(fromId)
            const paths = applicationPaths(from, target.id).filter(p => p[p.length - 1] === appId)
            const args = paths.length === 1 ? argsOf(from, appId) : undefined
            if (!args) {
                survives = true
                continue
            }
            const path = paths[0]
            const selects: SelectPath = []
            for (let i = 0; i + 1 < path.length; i++) {
                const n = getNode(g, path[i])!
                if (n.op !== NodeOp.select) continue
                for (let j = 1; j < countIds(n); j++) if (getRef(n, j) === path[i + 1]) { selects.push([path[i], j]); break }
            }
            const outcome = compare(args, pathFacts(g, selects))
            if (outcome === undefined) survives = true
            else decided.push([from, path, outcome ? 1 : 2])
        }
        if (!decided.length || compare(sides.map((at, i) => at === -2 ? [0, getLiteral(g, cond, i)] : [getRef(cond, i), 0]), []) !== undefined) return false
        const takers = [0, 0, 0]
        for (const [, , arm] of decided) takers[arm]++
        const movable = [1, 2].map(arm => armCode(target, getRef(tail, arm)) <= 1 || (takers[arm] === 1 && !survives))
        const edits = new Map<GraphBlock, Map<number, number>>()
        for (const [from, path, arm] of decided) {
            if (!movable[arm - 1]) continue
            const merged = inlineApplication(path, target, getRef(tail, arm), true)
            if (merged === undefined) continue
            let r = edits.get(from)
            if (!r) edits.set(from, r = new Map())
            r.set(path[path.length - 1], merged)
        }
        if (!edits.size) return false
        for (const [from, r] of edits) {
            from.bodyId = replaceAll(from.bodyId, r)
            revisitBlock(from)
        }
        return true
    }

    function entryLoad(target: GraphBlock, id: number): GraphNode | undefined {
        const n = id ? getNode(g, id) : undefined
        if (n?.op !== NodeOp.load || !isNilOrVoid(getRef(n, 0)) || typeOf(n) === Types.f64) return
        for (let k = 1; k < countIds(n); k++) if (getRef(n, k) && !target.params.includes(getRef(n, k))) return
        return n
    }

    function arrivingLoad(target: GraphBlock, from: GraphBlock, appId: number, load: GraphNode): number[] | undefined {
        const app = getNode(g, appId)!
        const operands = getOperands(g, load)
        for (let k = 1; k < countIds(load); k++) if (getRef(load, k)) operands[k] = getOperand(g, app, target.params.indexOf(getRef(load, k)) + 1)
        const positions = tailPositions(g, from.bodyId).filter(p => p.at === appId)
        if (positions.length !== 1) return
        const access = copyNode(g, load, operands)
        const store = arrivingStore(from, positions[0], access)
        if (!store || typeOf(store) === Types.f64) return
        if (bits(store) !== bits(access) || !sameLocation(store, access)) return [0, constantSlice(store, access)!]
        const width = bits(load)
        const constant = scalarOperand(g, g.nodes, store, 3)
        if (constant !== undefined) {
            if (width === 64) return [0, constant]
            if (lowering.isSignedType(typeOf(load))) return
            const m = 2 ** width
            return [0, ((constant % m) + m) % m]
        }
        return width === 64 ? [getRef(store, 3), 0] : undefined
    }

    function armCode(target: GraphBlock, arm: number): number {
        let code = 0
        const seen = new Set<number>()
        const stack = [...getArgIds(getNode(g, arm)!)]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id) || target.params.includes(id)) continue
            seen.add(id)
            const n = getNode(g, id)!
            if (n.op === NodeOp.block) continue
            if (OrderedValues.has(n.op)) return Infinity
            if (!isArgless(n) && latency(costs, n.op) > 0) code++
            for (const x of getArgIds(n)) stack.push(x)
        }
        return code
    }

    function unsignedValue(id: number): boolean {
        const n = getNode(g, tailOf(g, id))
        return !!n && UnsignedResults.has(resultType(g, n))
    }
    function decideCompare(cond: GraphNode, [a, ak]: number[], [b, bk]: number[], facts: Facts): boolean | undefined {
        if (a === b && ak === bk) return cond.op === NodeOp.eq || cond.op === NodeOp.le || cond.op === NodeOp.ge
        if (facts.length) {
            const relation = comparisonRelation(g, copyNode(g, cond, [a || { literal: ak }, b || { literal: bk }]), true)
            if (relation) {
                relation.signed = lowering.isSignedType(operandType(g, cond, 0)) || lowering.isSignedType(operandType(g, cond, 1))
                const decided = decideRelation(g, facts, relation)
                if (decided !== undefined) return decided
            }
        }
        const ranges = currentRanges()
        const op = cond.op
        if (ranges.below(a, b, bk, facts)) return op === NodeOp.lt || op === NodeOp.le || op === NodeOp.ne
        if (ranges.below(b, a, ak, facts)) return op === NodeOp.gt || op === NodeOp.ge || op === NodeOp.ne
        const signed = lowering.isSignedType(operandType(g, cond, 0)) || lowering.isSignedType(operandType(g, cond, 1))
        if (op !== NodeOp.eq && op !== NodeOp.ne) {
            if (a && !ak && !b && bk < 0 && unsignedValue(a)) return op === NodeOp.gt || op === NodeOp.ge
            if (b && !bk && !a && ak < 0 && unsignedValue(b)) return op === NodeOp.lt || op === NodeOp.le
        }
        if (signed && (ranges.range(a, ak, facts)[1] === Infinity || ranges.range(b, bk, facts)[1] === Infinity)) return
        const le = (x: number, xk: number, y: number, yk: number) => ranges.le(x, xk, y, yk, facts)
        const lt = (x: number, xk: number, y: number, yk: number) => ranges.lt(x, xk, y, yk, facts)
        if (op === NodeOp.gt) return lt(b, bk, a, ak) ? true : le(a, ak, b, bk) ? false : undefined
        if (op === NodeOp.ge) return le(b, bk, a, ak) ? true : lt(a, ak, b, bk) ? false : undefined
        if (op === NodeOp.lt) return lt(a, ak, b, bk) ? true : le(b, bk, a, ak) ? false : undefined
        if (op === NodeOp.le) return le(a, ak, b, bk) ? true : lt(b, bk, a, ak) ? false : undefined
        if (op === NodeOp.eq) return lt(a, ak, b, bk) || lt(b, bk, a, ak) ? false : undefined
        if (op === NodeOp.ne) return lt(a, ak, b, bk) || lt(b, bk, a, ak) ? true : undefined
        return
    }

    function absorbConditions(target: GraphBlock): boolean {
        if (target.id === g.root) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const apps = inbound.map(([, id]) => getNode(g, id)!)
        if (apps.some(app => countIds(app) !== target.params.length + 1)) return false
        for (const select of findValues(target.id, NodeOp.select) ?? []) {
            const at = target.params.indexOf(getRef(getNode(g, select)!, 0))
            if (at < 0) continue
            const conds = apps.map(app => getNode(g, getRef(app, at + 1)))
            const shape = conds.find(n => n && CompareOps.has(n.op))
            if (!shape) continue
            const op = shape.op
            const fixed = [0, 1].map(j => {
                const k = scalarOperand(g, g.nodes, shape, j)
                if (k === undefined) return undefined
                return conds.some(n => n && CompareOps.has(n.op) && scalarOperand(g, g.nodes, n, j) !== k) ? undefined : k
            })
            const varying = [0, 1].filter(j => fixed[j] === undefined)
            if (!varying.length || fixed.some(k => k !== undefined && k < 0)) continue
            const candidates = [0, 1, ...fixed.flatMap(k => k === undefined ? [] : [k, k + 1])]
            function solve(want: number, chosen: number[]): number[] | undefined {
                if (chosen.length === varying.length) {
                    const [a, b] = [0, 1].map(j => fixed[j] ?? chosen[varying.indexOf(j)])
                    return +CompareEval[op](a, b) === want ? chosen : undefined
                }
                for (const c of candidates) {
                    const found = solve(want, [...chosen, c])
                    if (found) return found
                }
                return undefined
            }

            const operands: { id: number, konst: number }[][] = []
            for (let i = 0; i < apps.length; i++) {
                const cond = conds[i]
                if (cond && CompareOps.has(cond.op)) {
                    if (cond.op !== op || typeOf(cond) !== typeOf(shape)) break
                    if (varying.some(j => lowering.isSignedType(operandType(g, cond, j)) !== lowering.isSignedType(operandType(g, shape, j)))) break
                    operands.push(varying.map(j => ({ id: getRef(cond, j), konst: getLiteral(g, cond, j) })))
                    continue
                }
                const k = scalarOperand(g, g.nodes, apps[i], at + 1)
                const solved = k === 0 || k === 1 ? solve(k, []) : undefined
                if (!solved) break
                operands.push(solved.map(konst => ({ id: 0, konst })))
            }
            if (operands.length !== apps.length) continue

            const wanted = varying.map(j => operandType(g, shape, j))
            const reuse = varying.map((_, v) => target.params.findIndex((param, p) => p !== at && typeOf(getNode(g, param)!) === wanted[v] && operands.every((o, i) => {
                const id = getRef(apps[i], p + 1)
                return id ? id === o[v].id : !o[v].id && getLiteral(g, apps[i], p + 1) === o[v].konst
            })))
            const extra = varying.map((_, v) => v).filter(v => reuse[v] < 0)
            if (extra.length > 1) continue
            const slots = varying.map((_, v) => reuse[v] < 0 ? addParam(wanted[v]) : target.params[reuse[v]])
            const compare = addCopy(g, shape, [0, 1].map(j => fixed[j] === undefined ? slots[varying.indexOf(j)] : { literal: fixed[j] }), op)
            const replaced = target.params[at]
            const edits = new Map<number, Map<number, number>>()
            for (let i = 0; i < apps.length; i++) {
                const next = getOperands(g, apps[i])
                next[at + 1] = extra.length ? operands[i][extra[0]].id || { literal: operands[i][extra[0]].konst } : 0
                for (const v of extra.slice(1)) next.push(operands[i][v].id || { literal: operands[i][v].konst })
                const [from, id] = inbound[i]
                let r = edits.get(from)
                if (!r) edits.set(from, r = new Map())
                r.set(id, addCopy(g, apps[i], next, NodeOp.apply))
            }
            for (const [from, r] of edits) {
                const b = getGraphBlock(from)
                b.bodyId = replaceAll(b.bodyId, r)
                if (b !== target) revisitBlock(b)
            }
            const params = target.params.slice()
            params[at] = extra.length ? slots[extra[0]] : paramLike(target.params[at])
            params.push(...extra.slice(1).map(v => slots[v]))
            target.params = params
            target.bodyId = replaceAll(target.bodyId, new Map([[replaced, compare]]))
            revisitBlock(target)
            absorbConditions(target)
            return true
        }
        return false
    }

    let ranges: RangeFacts | undefined
    let rangesEpoch = -1
    function currentRanges(): RangeFacts {
        if (!ranges || rangesEpoch !== graphEpoch) {
            const tails = new Map<number, TailPosition[]>()
            const tailsOf = (block: number) => {
                let list = tails.get(block)
                if (!list) tails.set(block, list = tailPositions(g, getGraphBlock(block).bodyId))
                return list
            }
            const arrival = (from: number, app: number): TailPosition => {
                const found = tailsOf(from).filter(p => p.at === app)
                if (found.length === 1) return found[0]
                const path = found[0].path.filter(([select, arm]) => found.every(p => p.path.some(([s, a]) => s === select && a === arm)))
                return { at: app, tokens: found[0].tokens, path }
            }
            ranges = rangeFacts(g, id => findInboundApplies(getGraphBlock(id)).map(([from, app]) => arrival(from, app)))
            rangesEpoch = graphEpoch
        }
        return ranges
    }

    let mem: MemAnalysis | undefined
    let memEpoch = -1
    function currentMem(): MemAnalysis {
        if (!mem || memEpoch !== graphEpoch) {
            mem = memAnalysis(g, b => findInboundApplies(b).map(x => x[1]), id => dependents.get(id) ?? [])
            memEpoch = graphEpoch
        }
        return mem
    }
    function stateAt(block: GraphBlock, app: number): number | undefined {
        let found: number[] | undefined
        let agree = true
        function walk(id: number, path: number[]): void {
            const n = getNode(g, id)
            if (!n) return
            if (id === app) {
                const tokens = [...new Set(path)].sort((a, b) => a - b)
                if (!found) found = tokens
                else if (found.length !== tokens.length || found.some((t, i) => t !== tokens[i])) agree = false
                return
            }
            if (n.op === NodeOp.after) {
                const last = countIds(n) - 1
                const next = path.slice()
                for (let i = 0; i < last; i++) if (getRef(n, i)) next.push(getRef(n, i))
                walk(getRef(n, last), next)
            } else if (n.op === NodeOp.select) {
                walk(getRef(n, 1), path)
                walk(getRef(n, 2), path)
            }
        }
        walk(block.bodyId, [])
        if (!found || !agree) return
        const tokens = new Set(found)
        for (const t of [...tokens]) if (isNilOrVoid(t)) tokens.delete(t)
        if (!tokens.size) return addNode(g, NodeOp.nilEffect, [])
        if (tokens.size === 1) return [...tokens][0]
        return addNode(g, NodeOp.after, [...tokens])
    }
    function quietAnchor(id: number, load: GraphNode): boolean {
        for (const u of dependents.get(id) ?? []) if (!usesForResult(u, id)) return false
        return quietSince(getRef(load, 0), load)
    }
    function quietSince(token: number, load: GraphNode): boolean {
        return writerOf(token, load) === 'quiet'
    }
    function seedReanchored(id: number, relaxed: Set<number>, replacements: Map<number, number>, seen = new Set<number>()): void {
        if (!id || seen.has(id) || replacements.has(id)) return
        seen.add(id)
        const n = getNode(g, id)
        if (!n || n.op === NodeOp.param) return
        for (let i = n.op === NodeOp.load ? 1 : 0; i < countIds(n); i++) seedReanchored(getRef(n, i), relaxed, replacements, seen)
        if (!relaxed.has(id)) return
        const operands = getOperands(g, n)
        operands[0] = addNode(g, NodeOp.nilEffect, [])
        replacements.set(id, replaceAll(addCopy(g, n, operands), replacements))
    }
    function sameOperand(a: GraphNode, b: GraphNode, i: number, j = i): boolean {
        if (getRef(a, i) && getRef(a, i) === getRef(b, j)) return true
        const x = scalarOperand(g, g.nodes, a, i)
        return x !== undefined && x === scalarOperand(g, g.nodes, b, j)
    }
    function sameLocation(a: GraphNode, b: GraphNode): boolean {
        return sameOperand(a, b, 2) && sameBase(a, b)
    }
    function sameBase(a: GraphNode, b: GraphNode): boolean {
        if (sameOperand(a, b, 1)) return true
        const x = tailOf(g, getRef(a, 1))
        return !!x && x === tailOf(g, getRef(b, 1))
    }
    const bits = (n: GraphNode) => intrinsics.intrinsicBitWidth(typeOf(n))
    function constantSlice(store: GraphNode, access: GraphNode): number | undefined {
        const constant = scalarOperand(g, g.nodes, store, 3)
        if (constant === undefined || constant < 0 || !Number.isSafeInteger(constant) || typeOf(store) === Types.f64 || typeOf(access) === Types.f64 || lowering.isSignedType(typeOf(access))) return
        if (getRef(store, 2) || getRef(access, 2) || !sameBase(store, access)) return
        const delta = getLiteral(g, access, 2) - getLiteral(g, store, 2)
        if (delta < 0 || delta * 8 + bits(access) > bits(store)) return
        return Math.floor(constant / 2 ** (8 * delta)) % 2 ** bits(access)
    }
    type Writer = number | 'quiet' | undefined
    function writerOf(token: number, access: GraphNode, stop?: Set<number>): Writer {
        const memo = new Map<number, Writer>()
        function walk(t: number): Writer {
            if (isNilOrVoid(t) || stop?.has(t)) return 'quiet'
            if (memo.has(t)) return memo.get(t)
            memo.set(t, undefined)
            const m = getNode(g, t)
            let result: Writer
            if (!m || m.op === NodeOp.param || m.op === NodeOp.block || m.op === NodeOp.select) result = undefined
            else if (m.op === NodeOp.load || m.op === NodeOp.pstack) result = walk(getRef(m, 0))
            else if (m.op === NodeOp.call) result = mem!.clobbers(t, access) ? undefined : walk(getRef(m, 0))
            else if (m.op === NodeOp.store) {
                result = sameLocation(m, access) && bits(m) === bits(access) ? t
                    : constantSlice(m, access) !== undefined ? t
                    : mem!.disjoint(access, m) ? walk(getRef(m, 0)) : undefined
            } else if (OrderedValues.has(m.op)) result = undefined
            else {
                result = 'quiet'
                const unknown: number[] = []
                for (let i = 0; i < countIds(m) && result !== undefined; i++) {
                    const part = walk(getRef(m, i))
                    if (part === undefined) unknown.push(getRef(m, i))
                    else if (part === 'quiet' || part === result) continue
                    else if (result === 'quiet' || precedes(result, part)) result = part
                    else if (!precedes(part, result)) result = undefined
                }
                const writer = result
                if (unknown.length && (typeof writer !== 'number' || unknown.some(t => !precedes(t, writer)))) result = undefined
            }
            memo.set(t, result)
            return result
        }
        return walk(token)
    }
    function arrivalEffects(from: GraphBlock, p: TailPosition): number[] {
        const out = new Set<number>(p.tokens)
        for (const root of tailRoots(g, p)) for (const e of guaranteed(from, root)) out.add(e)
        return [...out]
    }
    function arrivingStore(from: GraphBlock, p: TailPosition, access: GraphNode): GraphNode | undefined {
        const stop = new Set(from.params)
        let writer: Writer = 'quiet'
        for (const e of arrivalEffects(from, p)) {
            const w = writerOf(e, access, stop)
            if (w === undefined) return
            if (w === 'quiet' || w === writer) continue
            if (writer === 'quiet' || precedes(writer, w)) writer = w
            else if (!precedes(w, writer)) return
        }
        return typeof writer === 'number' ? getNode(g, writer) : undefined
    }
    function writesBefore(root: number, stop: Set<number>): boolean {
        const seen = new Set<number>()
        const stack = [root]
        while (stack.length) {
            const t = stack.pop()!
            if (!t || seen.has(t) || stop.has(t)) continue
            seen.add(t)
            const m = getNode(g, t)
            if (!m || m.op === NodeOp.param || m.op === NodeOp.block || m.op === NodeOp.nilEffect || m.op === NodeOp.void) continue
            if (m.op === NodeOp.store || m.op === NodeOp.pstack || m.op === NodeOp.rt || m.op === NodeOp.alloca) return true
            if (m.op === NodeOp.call && callEffect(m) > 1) return true
            for (let i = 0; i < countIds(m); i++) stack.push(getRef(m, i))
        }
        return false
    }
    function dependsOn(root: number, id: number, from: GraphBlock): boolean {
        const params = new Set(from.params)
        const seen = new Set<number>()
        const stack = [root]
        while (stack.length) {
            const x = stack.pop()!
            if (x === id) return true
            if (!x || seen.has(x) || params.has(x)) continue
            seen.add(x)
            const n = getNode(g, x)
            if (n && n.op !== NodeOp.block) for (let k = 0; k < countIds(n); k++) stack.push(getRef(n, k))
        }
        return false
    }
    function arrivingCall(from: GraphBlock, app: GraphNode, appId: number, call: GraphNode, target: GraphBlock): number | undefined {
        const expected: Operand[] = []
        for (let k = 2; k < countIds(call); k++) {
            const ref = getRef(call, k)
            expected.push(ref ? getOperand(g, app, target.params.indexOf(ref) + 1) : { literal: getLiteral(g, call, k) })
        }
        let positions: TailPosition[] | undefined
        const callee = nodeKey(g, getNode(g, getRef(call, 1))!)
        for (const id of findValues(from.id, NodeOp.call) ?? []) {
            const m = getNode(g, id)!
            if (countIds(m) !== countIds(call) || (getRef(m, 1) !== getRef(call, 1) && nodeKey(g, getNode(g, getRef(m, 1))!) !== callee)) continue
            let same = true
            for (let k = 2; k < countIds(m) && same; k++) {
                const want = expected[k - 2]
                same = typeof want === 'number' ? getRef(m, k) === want : !getRef(m, k) && getLiteral(g, m, k) === want.literal
            }
            if (!same) continue
            positions ??= tailPositions(g, from.bodyId).filter(p => p.at === appId)
            if (!positions.length) return
            const stop = new Set<number>(from.params)
            const pending = [id]
            while (pending.length) {
                const x = pending.pop()!
                if (!x || stop.has(x)) continue
                stop.add(x)
                const n = getNode(g, x)
                if (n && n.op !== NodeOp.block) for (let k = 0; k < countIds(n); k++) pending.push(getRef(n, k))
            }
            let quiet = true
            for (const p of positions) {
                if (!tailRoots(g, p).some(root => dependsOn(root, id, from))) quiet = false
                for (const root of tailRoots(g, p)) if (quiet && writesBefore(root, stop)) quiet = false
            }
            if (quiet) return id
        }
    }
    function forwardArrivalCalls(target: GraphBlock): boolean {
        const calls = findValues(target.id, NodeOp.call)
        if (!calls || target === g.blocks[0] || workingParams(target) >= maxLoopParams) return false
        const inbound = findInboundApplies(target)
        if (inbound.length < 1 || inbound.some(([from]) => from === target.id)) return false
        const projected = new Set((findValues(target.id, NodeOp.get) ?? []).map(x => getRef(getNode(g, x)!, 0)))
        for (const id of calls) {
            const call = getNode(g, id)!
            if (callEffect(call) > 1) continue
            if (projected.has(id)) continue
            let local = true
            for (let k = 2; k < countIds(call) && local; k++) local = !getRef(call, k) || target.params.includes(getRef(call, k))
            if (!local || writesBefore(getRef(call, 0), new Set(target.params))) continue
            const values: number[] = []
            for (const [from, app] of inbound) {
                const value = arrivingCall(getGraphBlock(from), getNode(g, app)!, app, call, target)
                if (value === undefined) break
                values.push(value)
            }
            if (values.length < inbound.length) continue
            const edits = new Map<number, Map<number, number>>()
            inbound.forEach(([from, app], i) => {
                const n = getNode(g, app)!
                if (!edits.has(from)) edits.set(from, new Map())
                edits.get(from)!.set(app, addCopy(g, n, [...getOperands(g, n), values[i]!], NodeOp.apply))
            })
            for (const [from, r] of edits) {
                const b = getGraphBlock(from)
                b.bodyId = replaceAll(b.bodyId, r)
                revisitBlock(b)
            }
            const param = addParam(resultType(g, call))
            target.params.push(param)
            liveParams = undefined
            target.bodyId = replaceAll(target.bodyId, new Map([[id, param]]))
            revisitBlock(target)
            return true
        }
        return false
    }
    function forwardArrivalLoads(target: GraphBlock): boolean {
        if (target === g.blocks[0]) return false
        if (!findValues(target.id, NodeOp.load)?.some(id => isNilOrVoid(getRef(getNode(g, id)!, 0)))) return false
        if (workingParams(target) >= maxLoopParams) return false
        const inbound = findInboundApplies(target)
        if (inbound.length < 2 || inbound.some(([from]) => from === target.id)) return false
        const into = (p: TailPosition) => {
            const n = getNode(g, p.at)!
            return n.op === NodeOp.apply && getRef(n, 0) === target.id
        }
        const arrivals = new Map<GraphBlock, TailPosition[]>()
        let count = 0
        for (const id of new Set(inbound.map(([from]) => from))) {
            const from = getGraphBlock(id)
            arrivals.set(from, tailPositions(g, from.bodyId).filter(into))
            count += arrivals.get(from)!.length
        }
        currentMem()
        type Env = (param: number) => [app: GraphNode, at: number] | undefined
        function envOf(b: GraphBlock, app: GraphNode): Env {
            return param => {
                const at = b.params.indexOf(param)
                return at < 0 ? undefined : [app, at + 1]
            }
        }
        const translatable = (n: GraphNode) => BinaryOps.has(n.op) || n.op === NodeOp.convert
        function matches(t: GraphNode, i: number, f: GraphNode, j: number, env: Env, depth = 0): boolean {
            const x = getRef(t, i)
            const tn = x ? getNode(g, x)! : undefined
            if (!tn || tn.op === NodeOp.literal) return sameOperand(t, f, i, j)
            if (tn.op === NodeOp.param) {
                const slot = env(x)
                return !!slot && sameOperand(slot[0], f, slot[1], j)
            }
            const fn = getRef(f, j) ? getNode(g, getRef(f, j)) : undefined
            if (!fn || depth > 4 || !translatable(tn) || fn.op !== tn.op || typeOf(fn) !== typeOf(tn) || countIds(fn) !== countIds(tn)) return false
            for (let k = 0; k < countIds(tn); k++) if (!matches(tn, k, fn, k, env, depth + 1)) return false
            return true
        }
        function candidate(b: GraphBlock, load: GraphNode, env: Env, required?: Set<number>): number | undefined {
            for (const id of findValues(b.id, NodeOp.load) ?? []) {
                const m = getNode(g, id)!
                if (!isNilOrVoid(getRef(m, 0)) || typeOf(m) !== typeOf(load)) continue
                if (required && !required.has(id)) continue
                if (matches(load, 1, m, 1, env) && matches(load, 2, m, 2, env)) return id
            }
        }
        function quiet(b: GraphBlock, p: TailPosition, access: GraphNode): boolean {
            const stop = new Set(b.params)
            return arrivalEffects(b, p).every(e => writerOf(e, access, stop) === 'quiet')
        }
        const arrivalDemands = new Map<TailPosition, Set<number>>()
        function arrivalDemand(b: GraphBlock, p: TailPosition): Set<number> {
            const known = arrivalDemands.get(p)
            if (known) return known
            const required = demandOf(b.bodyId)
            for (const root of tailRoots(g, p)) if (root) demandOf(root, required)
            arrivalDemands.set(p, required)
            return required
        }
        function available(b: GraphBlock, p: TailPosition, load: GraphNode, env: Env): number | undefined {
            const found = candidate(b, load, env, arrivalDemand(b, p))
            if (found !== undefined) return quiet(b, p, getNode(g, found)!) ? found : undefined
            if (!movable(load, env)) return
            const into = findInboundApplies(b)
            if (into.length !== 1 || into[0][0] === b.id) return
            const [fromId, appId] = into[0]
            const from = getGraphBlock(fromId)
            const positions = tailPositions(g, from.bodyId).filter(q => q.at === appId)
            const app = getNode(g, appId)!
            const outer = envOf(b, app)
            const env2: Env = param => {
                const slot = env(param)
                const x = slot ? getRef(slot[0], slot[1]) : 0
                const n = x ? getNode(g, x)! : undefined
                return !n || n.op === NodeOp.literal ? slot : n.op === NodeOp.param ? outer(x) : undefined
            }
            const u = candidate(from, load, env2)
            if (u === undefined || !positions.length || !positions.every(q => quiet(from, q, getNode(g, u)!))) return
            const k = getArgIds(app).indexOf(u, 1)
            if (k < 0) return
            if (!quiet(b, p, getNode(g, relocated(load, env, nil()))!)) return
            return b.params[k - 1]
        }
        function translate(id: number, env: Env, memo: Map<number, number>): Operand {
            const n = getNode(g, id)!
            if (n.op === NodeOp.param) {
                const [app, at] = env(id)!
                return getOperand(g, app, at)
            }
            if (n.op === NodeOp.literal) return id
            const known = memo.get(id)
            if (known !== undefined) return known
            const operands = getOperands(g, n)
            for (let k = 0; k < countIds(n); k++) if (getRef(n, k)) operands[k] = translate(getRef(n, k), env, memo)
            const out = addCopy(g, n, operands, n.op)
            memo.set(id, out)
            return out
        }
        function expressible(id: number, env: Env, depth = 0): boolean {
            const n = getNode(g, id)!
            if (n.op === NodeOp.param) return env(id) !== undefined
            if (n.op === NodeOp.literal) return true
            if (depth > 4 || !translatable(n)) return false
            for (let k = 0; k < countIds(n); k++) if (getRef(n, k) && !expressible(getRef(n, k), env, depth + 1)) return false
            return true
        }
        function movable(load: GraphNode, env: Env): boolean {
            return (!getRef(load, 1) || expressible(getRef(load, 1), env)) && (!getRef(load, 2) || expressible(getRef(load, 2), env))
        }
        function relocated(load: GraphNode, env: Env, token: number): number {
            const memo = new Map<number, number>()
            const operands = getOperands(g, load)
            for (let k = 1; k < countIds(load); k++) if (getRef(load, k)) operands[k] = translate(getRef(load, k), env, memo)
            operands[0] = token
            return addCopy(g, load, operands, NodeOp.load)
        }
        function reload(from: GraphBlock, p: TailPosition, load: GraphNode, env: Env): number {
            const order = arrivalEffects(from, p).filter(e => getNode(g, e)!.op !== NodeOp.load)
            return relocated(load, env, order.length ? joinEffects(g, order) : nil())
        }
        let required: Set<number> | undefined
        for (const id of findValues(target.id, NodeOp.load) ?? []) {
            const load = getNode(g, id)!
            if (!isNilOrVoid(getRef(load, 0))) continue
            let found = 0
            let missing = 0
            const values = new Map<GraphBlock, (number | undefined)[]>()
            for (const [from, positions] of arrivals) values.set(from, positions.map(p => {
                const env = envOf(target, getNode(g, p.at)!)
                const value = available(from, p, load, env)
                if (value !== undefined) found++
                else if (movable(load, env)) missing++
                else missing = Infinity
                return value
            }))
            if (!found || missing > 1) continue
            required ??= demandOf(target.bodyId)
            if (missing && !required.has(id)) continue
            for (const [from, positions] of arrivals) {
                const known = values.get(from)!
                let i = 0
                from.bodyId = mapTailPositions(g, from.bodyId, p => {
                    if (!into(p)) return p.at
                    const n = getNode(g, p.at)!
                    const value = known[i] ?? reload(from, positions[i], load, envOf(target, n))
                    i++
                    return addCopy(g, n, [...getOperands(g, n), value], NodeOp.apply)
                })
                revisitBlock(from)
            }
            const param = addParam(typeOf(load))
            target.params.push(param)
            liveParams = undefined
            target.bodyId = replaceAll(target.bodyId, new Map([[id, param]]))
            revisitBlock(target)
            return true
        }
        return false
    }
    function forwardMemory(target: GraphBlock): boolean {
        const ordered = findValues(target.id, NodeOp.load)?.some(id => !isNilOrVoid(getRef(getNode(g, id)!, 0)))
        if (!ordered && !findValues(target.id, NodeOp.store)?.length) return false
        currentMem()

        function stored(store: GraphNode, load: GraphNode): number {
            if (bits(store) !== bits(load) || !sameLocation(store, load)) return addNode(g, NodeOp.literal, [{ literal: constantSlice(store, load)! }])
            const value = getRef(store, 3)
            const constant = scalarOperand(g, g.nodes, store, 3)
            const width = bits(load)
            const S = typeOf(store)
            if ((S === Types.f64) !== (typeOf(load) === Types.f64)) {
                return addNode(g, NodeOp.bitconvert, [value || addNode(g, NodeOp.literal, [{ literal: constant ?? 0 }], S)], typeOf(load))
            }
            if (constant !== undefined && typeOf(load) === Types.f64) return addNode(g, NodeOp.literal, [{ literal: constant }], Types.f64)
            if (constant !== undefined && (width === 64 || !lowering.isSignedType(typeOf(load)))) {
                const m = 2 ** width
                return addNode(g, NodeOp.literal, [{ literal: width === 64 ? constant : ((constant % m) + m) % m }])
            }
            const source = getNode(g, value)
            if (value && (width === 64 || (source?.op === NodeOp.load && typeOf(source) === typeOf(load)))) return value
            return addNode(g, NodeOp.convert, [value || { literal: constant ?? 0 }], typeOf(load))
        }
        
        const arrivals = new Map<number, number>()
        function soleArrival(block: GraphBlock): number {
            if (block === g.blocks[0]) return 0
            if (!arrivals.has(block.id)) {
                const inbound = findInboundApplies(block)
                arrivals.set(block.id, inbound.length === 1 ? inbound[0][1] : 0)
            }
            return arrivals.get(block.id)!
        }
        const r = new Map<number, number>()
        const forwarded = new Map<number, number>()
        for (const id of findValues(target.id, NodeOp.load) ?? []) {
            const load = getNode(g, id)!
            const writer = writerOf(getRef(load, 0), load)
            if (writer === 'quiet' && !isNilOrVoid(getRef(load, 0)) && quietAnchor(id, load)) {
                const operands = getOperands(g, load)
                operands[0] = nil()
                const anchored = addCopy(g, load, operands)
                if (anchored === id) continue
                r.set(id, getRef(load, 0))
                forwarded.set(id, anchored)
                continue
            }
            if (typeof writer !== 'number') continue
            r.set(id, getRef(load, 0) || nil())
            forwarded.set(id, stored(getNode(g, writer)!, load))
        }
        function removedStore(store: GraphNode): number {
            return getRef(store, 0) || addNode(g, NodeOp.nilEffect, [])
        }
        function operandKey(n: GraphNode, i: number): string {
            const constant = scalarOperand(g, g.nodes, n, i)
            if (constant !== undefined) return `#${constant}`
            return `%${i === 1 ? tailOf(g, getRef(n, i)) : getRef(n, i)}`
        }
        function storeKey(store: GraphNode): string {
            return `${operandKey(store, 1)} ${operandKey(store, 2)} ${operandKey(store, 3)}`
        }
        function redundant(store: GraphNode, repeated: Set<string>): boolean {
            let value = getRef(store, 3)
            for (let m = getNode(g, value); m?.op === NodeOp.after; m = getNode(g, value)) value = getRef(m, countIds(m) - 1)
            const loaded = getNode(g, value)
            const reloaded = loaded?.op === NodeOp.load && sameLocation(loaded, store) && sameSlotBits(typeOf(loaded), typeOf(store))
            if (!reloaded && !repeated.has(storeKey(store))) return false
            const writer = writerOf(getRef(store, 0), store)
            const w = typeof writer === 'number' ? getNode(g, writer)! : undefined
            if (w && bits(w) === bits(store) && sameOperand(w, store, 3)) return true
            if (!reloaded) return false
            return (writer !== undefined && writerOf(getRef(loaded!, 0), loaded!) === writer) || writerOf(getRef(store, 0), store, new Set([value, getRef(loaded!, 0)])) === 'quiet'
        }
        if (!r.size) {
            const seen = new Set<string>()
            const repeated = new Set<string>()
            for (const id of findValues(target.id, NodeOp.store) ?? []) {
                const key = storeKey(getNode(g, id)!)
                if (seen.has(key)) repeated.add(key)
                seen.add(key)
            }
            for (const id of findValues(target.id, NodeOp.store) ?? []) {
                const store = getNode(g, id)!
                if (redundant(store, repeated)) r.set(id, removedStore(store))
            }
        }
        function coverAt(cover: Cover, m: Mem, bytes: number): void {
            const kinds = cover[m.kind]
            let entry = kinds.get(m.base)
            if (!entry) kinds.set(m.base, entry = { widest: 0, at: new Map() })
            if ((entry.at.get(m.pos!) ?? 0) < bytes) entry.at.set(m.pos!, bytes)
            if (bytes > entry.widest) entry.widest = bytes
        }
        function coverStore(cover: Cover, store: GraphNode): void {
            const m = mem!.access(store)
            if (m && m.pos !== undefined) coverAt(cover, m, bits(store) / 8)
        }
        function coveredAt(cover: Cover, m: Mem, bytes: number): boolean {
            const entry = cover[m.kind].get(m.base)
            if (!entry) return false
            for (let at = m.pos! + bytes - entry.widest; at <= m.pos!; at++) {
                const width = entry.at.get(at)
                if (width !== undefined && m.pos! + bytes <= at + width) return true
            }
            return false
        }
        function covered(cover: Cover, store: GraphNode): boolean {
            const m = mem!.access(store)
            return !!m && m.pos !== undefined && coveredAt(cover, m, bits(store) / 8)
        }
        function clearExcept(kinds: Map<number, CoverBase>, base: number): void {
            const kept = kinds.get(base)
            kinds.clear()
            if (kept) kinds.set(base, kept)
        }
        function observe(cover: Cover, load: GraphNode): void {
            const m = mem!.access(load)
            if (!m) {
                for (const kinds of cover) kinds.clear()
                return
            }
            if (m.kind !== MemFresh) clearExcept(cover[MemUnknown], m.base)
            if (m.kind !== MemFresh) clearExcept(cover[MemPre], m.base)
            if (m.kind === MemUnknown) clearExcept(cover[MemFresh], m.base)
            if (m.kind === MemFresh) clearExcept(cover[MemUnknown], m.base)
            const entry = cover[m.kind].get(m.base)
            if (!entry) return
            if (m.pos === undefined) {
                cover[m.kind].delete(m.base)
                return
            }
            const bytes = bits(load) / 8
            for (let at = m.pos - entry.widest + 1; at < m.pos + bytes; at++) {
                const width = entry.at.get(at)
                if (width !== undefined && at + width > m.pos) entry.at.delete(at)
            }
        }
        function copyCover(cover: Cover): Cover {
            const out = emptyCover()
            for (let kind = 0; kind < cover.length; kind++) {
                for (const [base, entry] of cover[kind]) out[kind].set(base, { widest: entry.widest, at: new Map(entry.at) })
            }
            return out
        }
        function meetCover(a: Cover, b: Cover): Cover {
            const out = emptyCover()
            for (const [x, y] of [[a, b], [b, a]]) {
                for (let kind = 0; kind < x.length; kind++) {
                    for (const [base, entry] of x[kind]) {
                        for (const [pos, width] of entry.at) {
                            const m: Mem = { base, pos, kind }
                            if (coveredAt(y, m, width)) coverAt(out, m, width)
                        }
                    }
                }
            }
            return out
        }
        const entryCovers = new Map<number, Cover | undefined>()
        function entryCover(app: number): Cover | undefined {
            const block = getBlock(g, getRef(getNode(g, app)!, 0))
            if (!block || block === target || soleArrival(block) !== app) return emptyCover()
            if (entryCovers.has(block.id)) return entryCovers.get(block.id)
            const cover = scanCover(block, false)
            entryCovers.set(block.id, cover)
            return cover
        }
        function meetCovers(a: Cover | undefined, b: Cover | undefined): Cover | undefined {
            if (!a) return b
            if (!b) return a
            return meetCover(a, b)
        }
        function scanCover(b: GraphBlock, deep: boolean, onStore?: (id: number, store: GraphNode, cover: Cover) => void): Cover | undefined {
            const order = blockOrder(g, b)
            const branches = !!findValues(b.id, NodeOp.select)?.length
            const regions = orderRegions(g, branches ? order : [])
            const placed = new Map<number, number[]>()
            let k = order.length - 1
            while (k >= 0) {
                const id = order[k]
                k--
                const region = branches ? regions.of.get(id) : 0
                if (region === undefined) continue
                const list = placed.get(region)
                if (list) list.push(id)
                else placed.set(region, [id])
            }
            function armOf(select: number, arm: number): number {
                return childRegion(regions, regions.of.get(select) ?? 0, select, arm)
            }
            function leafOf(id: number): number {
                for (let n = getNode(g, id); n?.op === NodeOp.after; n = getNode(g, id)) id = getRef(n, countIds(n) - 1)
                return id
            }
            function structuredArms(n: GraphNode): boolean {
                for (let i = 1; i < countIds(n); i++) if (!hasStructuredTail(g, getRef(n, i))) return false
                return true
            }
            function meetArms(select: number, n: GraphNode, continuation: Cover | undefined): Cover | undefined {
                let out: Cover | undefined
                let first = true
                for (let i = 1; i < countIds(n); i++) {
                    const arm = scanRegion(armOf(select, i), getRef(n, i), continuation)
                    out = first ? arm : meetCovers(out, arm)
                    first = false
                }
                return out
            }
            function scanRegion(region: number, value: number, continuation: Cover | undefined): Cover | undefined {
                const leaf = leafOf(value)
                const tail = getNode(g, leaf)
                let terminal = 0
                let cover: Cover | undefined
                if (tail?.op === NodeOp.unreachable) {
                    terminal = leaf
                } else if (tail?.op === NodeOp.apply) {
                    terminal = leaf
                    cover = deep ? entryCover(leaf) : emptyCover()
                    if (cover) cover = copyCover(cover)
                } else if (tail && (tail.op === NodeOp.ret || tail.op === NodeOp.panic || tail.op === NodeOp.trap)) {
                    terminal = leaf
                    cover = emptyCover()
                } else if (tail?.op === NodeOp.select && structuredArms(tail)) {
                    terminal = leaf
                    cover = meetArms(leaf, tail, continuation)
                } else {
                    cover = continuation && copyCover(continuation)
                }
                for (const id of placed.get(region) ?? []) {
                    if (id === terminal) continue
                    const n = getNode(g, id)!
                    if (n.op === NodeOp.select) {
                        cover = meetArms(id, n, cover)
                        continue
                    }
                    if (PureOps.has(n.op) || CoverInert.has(n.op)) continue
                    cover ??= emptyCover()
                    if (n.op === NodeOp.store) {
                        if (onStore) onStore(id, n, cover)
                        else coverStore(cover, n)
                        continue
                    }
                    if (n.op === NodeOp.load) {
                        observe(cover, n)
                        continue
                    }
                    for (const kinds of cover) kinds.clear()
                }
                return cover
            }
            return scanRegion(0, b.bodyId, emptyCover())
        }
        function liveHalf(store: GraphNode, cover: Cover): GraphNode {
            let piece = store
            for (;;) {
                const width = bits(piece)
                const constant = scalarOperand(g, g.nodes, piece, 3)
                if (width < 16 || getRef(piece, 2) || constant === undefined || constant < 0 || !Number.isSafeInteger(constant) || typeOf(piece) === Types.f64 || typeOf(piece) === Types.f32) return piece
                const half = width / 2
                const from = piece
                const halves = [0, 1].map(k => {
                    const operands = getOperands(g, from)
                    operands[2] = { literal: getLiteral(g, from, 2) + k * half / 8 }
                    operands[3] = { literal: Math.floor(constant / 2 ** (k * half)) % 2 ** half }
                    const next = copyNode(g, from, operands)
                    setType(next, half === 32 ? Types.u32 : half === 16 ? Types.u16 : Types.u8)
                    return next
                })
                const dead = halves.map(h => covered(cover, h))
                if (dead[0] === dead[1]) return piece
                piece = halves[dead[0] ? 1 : 0]
            }
        }
        function killable(): boolean {
            const stores = findValues(target.id, NodeOp.store)?.length ?? 0
            let following = 0
            for (const next of successors.get(target.id) ?? []) following += findValues(next, NodeOp.store)?.length ?? 0
            if (!stores || (stores === 1 && !following)) return false
            const spans = new Map<string, Map<number, number[]>>()
            const own: [number, string, number, number][] = []
            let widest = 1
            function add(id: number, mine: boolean): void {
                const store = getNode(g, id)!
                const m = mem!.access(store)
                if (!m || m.pos === undefined) return
                const key = `${m.kind}:${m.base}`
                let at = spans.get(key)
                if (!at) spans.set(key, at = new Map())
                const bytes = bits(store) / 8
                if (bytes > widest) widest = bytes
                let list = at.get(m.pos)
                if (!list) at.set(m.pos, list = [])
                list.push(id, bytes)
                if (mine) own.push([id, key, m.pos, bytes])
            }
            for (const id of findValues(target.id, NodeOp.store) ?? []) add(id, true)
            for (const next of successors.get(target.id) ?? []) {
                for (const id of findValues(next, NodeOp.store) ?? []) add(id, false)
            }
            for (const [id, key, pos, bytes] of own) {
                const at = spans.get(key)!
                for (let p = pos - widest + 1; p < pos + bytes; p++) {
                    const list = at.get(p)
                    if (!list) continue
                    for (let i = 0; i < list.length; i += 2) {
                        if (list[i] !== id && p + list[i + 1] > pos) return true
                    }
                }
            }
            return false
        }
        function inside(cover: Cover, store: GraphNode): boolean {
            const m = mem!.access(store)
            const entry = m && m.pos !== undefined ? cover[m.kind].get(m.base) : undefined
            if (!entry) return false
            const end = m!.pos! + bits(store) / 8
            for (let at = m!.pos!; at < end; at++) {
                const width = entry.at.get(at)
                if (width !== undefined && at + width <= end) return true
            }
            return false
        }
        if (!r.size && killable()) {
            const pieces = new Map<number, GraphNode>()
            scanCover(target, true, (id, store, cover) => {
                if (covered(cover, store)) {
                    r.set(id, removedStore(store))
                    return
                }
                const kept = inside(cover, store) ? liveHalf(store, cover) : store
                if (kept === store) {
                    coverStore(cover, store)
                    return
                }
                pieces.set(id, kept)
                coverStore(cover, kept)
            })
            for (const [id, piece] of pieces) r.set(id, insertNode(g, piece))
        }
        if (!r.size) return false
        const resolvedValues = new Map<number, number>()
        const resolvedTokens = new Map<number, number>()
        function resolve(id: number, value: boolean): number {
            const memo = value ? resolvedValues : resolvedTokens
            const path: number[] = []
            let at = id
            for (;;) {
                const known = memo.get(at)
                if (known !== undefined) {
                    at = known
                    break
                }
                const next = value ? forwarded.get(at) ?? r.get(at) : r.get(at)
                if (next === undefined) break
                path.push(at)
                at = next
            }
            for (const x of path) memo.set(x, at)
            return at
        }
        for (const id of r.keys()) {
            for (const u of [...(dependents.get(id) ?? [])]) {
                const n = getNode(g, u)
                if (!n || r.has(u)) continue
                const operands = getOperands(g, n)
                let edited = false
                for (let i = 0; i < countIds(n); i++) {
                    if (!r.has(getRef(n, i))) continue
                    const token = resolve(getRef(n, i), false)
                    if (i < firstNonOrderingSlot(n)) operands[i] = token
                    else {
                        const value = resolve(getRef(n, i), true)
                        operands[i] = value === token || isNilOrVoid(token) ? value : addNode(g, NodeOp.after, [token, value])
                    }
                    edited = true
                }
                if (edited) putCopy(g, u, n, operands)
            }
        }
        revisitBlock(target)
        forwardMemory(target)
        return true
    }

    const unreadRoots = new Map<number, [epoch: number, unread: boolean]>()
    function unreadRoot(root: number, mem: MemAnalysis): boolean {
        const known = unreadRoots.get(root)
        if (known && (known[1] || known[0] === graphEpoch)) return known[1]
        const op = getNode(g, root)?.op
        let unread = op === NodeOp.alloca || op === NodeOp.pstack || op === NodeOp.mem
        const flow = unread ? mem.flows(root, true) : undefined
        if (flow && (flow.own || flow.calls.length)) unread = false
        for (const x of unread ? flow!.reached : []) {
            for (const u of dependents.get(x) ?? []) {
                const n = getNode(g, u)!
                if (n.op === NodeOp.load && (getRef(n, 1) === x || getRef(n, 2) === x)) unread = false
                if (n.op === NodeOp.store && getRef(n, 1) === x && mem.access(n)?.base !== root) unread = false
                if (!unread) break
            }
            if (!unread) break
        }
        unreadRoots.set(root, [graphEpoch, unread])
        return unread
    }
    function dropUnreadStores(target: GraphBlock): boolean {
        const stores = findValues(target.id, NodeOp.store)
        if (!stores?.length) return false
        const mem = currentMem()
        const r = new Map<number, number>()
        for (const id of stores) {
            const n = getNode(g, id)!
            const at = mem.access(n)
            if (!at || at.kind !== MemFresh || !unreadRoot(at.base, mem)) continue
            r.set(id, getRef(n, 0) || addNode(g, NodeOp.nilEffect, []))
        }
        if (!r.size) return false
        function resolve(id: number): number {
            let at = id
            while (r.has(at)) at = r.get(at)!
            return at
        }
        for (const id of r.keys()) {
            for (const u of [...(dependents.get(id) ?? [])]) {
                const n = getNode(g, u)
                if (!n || r.has(u)) continue
                const operands = getOperands(g, n)
                let edited = false
                for (let i = 0; i < countIds(n); i++) {
                    if (!r.has(getRef(n, i))) continue
                    operands[i] = resolve(getRef(n, i))
                    edited = true
                }
                if (edited) putCopy(g, u, n, operands)
            }
        }
        revisitBlock(target)
        return true
    }

    const unpromotable = new Set<string>()
    function allocations(block: number): number[] {
        return [...(findValues(block, NodeOp.alloca) ?? []), ...(findValues(block, NodeOp.pstack) ?? [])]
    }

    function promoteAllocas(target: GraphBlock): boolean {
        if (!allocations(target.id).length) return false
        const keys = new Map<number, string | undefined>()
        function keyOf(id: number): string | undefined {
            if (keys.has(id)) return keys.get(id)
            const n = getNode(g, id)
            let key: string | undefined
            if (n?.op === NodeOp.pstack && !pstackRebases(g, n)) key = `pstack:${id}`
            if (n?.op === NodeOp.alloca && !getRef(n, 1) && !getRef(n, 2)) key = `alloca:${id}`
            keys.set(id, key)
            return key
        }
        let changed = false
        const batch: Promotion = { ids: new Set(), stores: new Set(), values: new Map(), touched: new Set() }
        let queue = allocations(target.id)
        let at = 0
        let stored: number[] = []
        let progress = false
        function renamed(ids: number[], rewritten: Map<number, number>): number[] {
            const out: number[] = []
            for (const id of ids) out.push(rewritten.get(id) ?? id)
            return out
        }
        function rename(rewritten: Map<number, number>): void {
            queue = renamed(queue.slice(at), rewritten)
            at = 0
            stored = renamed(stored, rewritten)
        }
        function settle(): void {
            const rewritten = settlePromotions(batch)
            if (rewritten) rename(rewritten)
        }
        while (at < queue.length) {
            const id = queue[at]
            const key = keyOf(id)
            if (key === undefined || unpromotable.has(key)) {
                at++
                continue
            }
            let inside = false
            const result = promoteAlloca(key, keyOf, () => inside = true, batch)
            if (result === 'settle') {
                settle()
                continue
            }
            at++
            if (!result) {
                unpromotable.add(key)
                if (inside) stored.push(id)
            } else {
                changed = true
                progress = true
                if (result !== true) rename(result)
            }
            if (at < queue.length || !stored.length || !progress) continue
            settle()
            for (const k of stored) unpromotable.delete(keyOf(k)!)
            queue = stored
            at = 0
            stored = []
            progress = false
        }
        settle()
        return changed
    }

    function promotedReplacements(p: Promotion): Map<number, number> {
        const replaced = new Map<number, number>()
        function replacement(id: number): number {
            const known = replaced.get(id)
            if (known !== undefined) return known
            const n = getNode(g, id)
            if (!n) return id
            let result = id
            if (p.stores.has(id) || (p.ids.has(id) && n.op === NodeOp.pstack)) {
                result = getRef(n, 0) ? replacement(getRef(n, 0)) : addNode(g, NodeOp.nilEffect, [])
            } else if (p.values.has(id)) {
                const [ref, literal] = p.values.get(id)!
                result = addNode(g, NodeOp.after, [replacement(getRef(n, 0)), ref ? replacement(ref) : { literal }])
            }
            if (result !== id) replaced.set(id, result)
            return result
        }
        for (const id of p.stores) replacement(id)
        for (const id of p.values.keys()) replacement(id)
        for (const id of p.ids) replacement(id)
        return replaced
    }

    function settlePromotions(batch: Promotion): Map<number, number> | undefined {
        if (!batch.ids.size) return
        const replaced = promotedReplacements(batch)
        const rewritten = new Map<number, number>()
        for (const b of batch.touched) b.bodyId = replaceTransitive(b.bodyId, replaced, rewritten)
        for (const b of batch.touched) revisitBlock(b)
        batch.ids.clear()
        batch.stores.clear()
        batch.values.clear()
        batch.touched.clear()
        return rewritten
    }

    function promoteAlloca(key: string, keyOf: (id: number) => string | undefined, storedInside: () => void, batch: Promotion): boolean | 'settle' | Map<number, number> {
        const ids = new Set<number>()
        const touched = new Set<GraphBlock>()
        const homes = new Map<number, number>()
        for (const b of reachableBlocks) {
            for (const a of allocations(b.id)) {
                if (keyOf(a) !== key) continue
                ids.add(a)
                touched.add(b)
                homes.set(a, b.id)
            }
        }
        function tokenUse(n: GraphNode, a: number): boolean {
            if (getNode(g, a)!.op !== NodeOp.pstack) return false
            if (n.op === NodeOp.after) return getRef(n, countIds(n) - 1) !== a
            if (!OrderedValues.has(n.op) || getRef(n, 0) !== a) return false
            for (let i = 1; i < countIds(n); i++) {
                if (getRef(n, i) === a && !(i === 1 && (n.op === NodeOp.load || n.op === NodeOp.store))) return false
            }
            return true
        }
        if (!ids.size) return false
        const slotTypes = new Map<number, (typeof Types)[keyof typeof Types]>()
        const mem = currentMem()
        const aliases = new Map<number, number>()
        const bases = new Map<number, number>()
        const roots = new Set<number>()
        const selectors = new Set<number>()
        const mergedInto = new Map<number, number>()
        const pointerSlots = new Map<number, Set<number>>()
        const pending: number[] = []
        const slotIds = new Map<number, Map<number, number>>()
        const slotBases: number[] = []
        const slotOffsets: number[] = []
        function slotOf(ptr: number, offset: number): number {
            const base = bases.get(ptr)!
            const at = aliases.get(ptr)! + offset
            let byOffset = slotIds.get(base)
            if (!byOffset) slotIds.set(base, byOffset = new Map())
            let slot = byOffset.get(at)
            if (slot === undefined) {
                byOffset.set(at, slot = slotBases.length)
                slotBases.push(base)
                slotOffsets.push(at)
            }
            return slot
        }
        const blockOf = new Map<number, number>()
        function alias(id: number, block: number): boolean {
            if (aliases.has(id)) return true
            const m = mem.of(id)
            if (m.pos === undefined || (!ids.has(m.base) && !roots.has(m.base))) return false
            aliases.set(id, m.pos)
            bases.set(id, m.base)
            blockOf.set(id, block)
            pending.push(id)
            return true
        }
        function extend(base: number): boolean {
            if (ids.has(base)) return true
            const n = getNode(g, base)
            if (!n || (n.op !== NodeOp.pstack && n.op !== NodeOp.alloca)) return false
            const k = keyOf(base)
            if (k === undefined || unpromotable.has(k)) return false
            for (const b of reachableBlocks) {
                for (const a of allocations(b.id)) {
                    if (keyOf(a) !== k) continue
                    ids.add(a)
                    touched.add(b)
                    homes.set(a, b.id)
                    if (!alias(a, b.id)) return false
                }
            }
            return ids.has(base)
        }
        function unwrap(id: number): number {
            for (;;) {
                const n = getNode(g, id)
                if (n?.op !== NodeOp.after) return id
                id = getRef(n, countIds(n) - 1)
            }
        }
        function arrival(ref: number, root: number, block: number): boolean {
            if (!ref) return false
            const inner = unwrap(ref)
            const n = getNode(g, inner)
            if (n?.op === NodeOp.select && !aliases.has(ref)) {
                selectors.add(inner)
                return arrival(getRef(n, 1), root, block) && arrival(getRef(n, 2), root, block)
            }
            const m = mem.of(ref)
            if (m.pos === undefined) return false
            if (m.base !== root) {
                if (!roots.has(m.base) && !extend(m.base)) return false
                if ((mergedInto.get(m.base) ?? root) !== root) return false
                mergedInto.set(m.base, root)
            }
            return alias(ref, block)
        }
        function passTo(target: GraphBlock, index: number): void {
            const slots = pointerSlots.get(target.id)
            if (slots) slots.add(index)
            else pointerSlots.set(target.id, new Set([index]))
        }
        function mergeRoot(param: number): boolean {
            if (roots.has(param)) return true
            const m = mem.of(param)
            if (m.base !== param || m.pending) return false
            const owner = g.blocks.find(b => b.params.includes(param))
            if (!owner || owner === g.blocks[0]) return false
            roots.add(param)
            aliases.set(param, 0)
            bases.set(param, param)
            blockOf.set(param, owner.id)
            pending.push(param)
            const at = owner.params.indexOf(param) + 1
            for (const from of preds.get(owner.id) ?? []) {
                for (const app of findValues(from, NodeOp.apply) ?? []) {
                    const n = getNode(g, app)!
                    if (getRef(n, 0) !== owner.id) continue
                    if (!arrival(getRef(n, at), param, from)) return false
                }
            }
            return true
        }
        function selectRoot(id: number, block: number): boolean {
            if (roots.has(id)) return true
            const m = mem.of(id)
            if (m.base !== id || m.pending) return false
            const n = getNode(g, id)!
            roots.add(id)
            selectors.add(id)
            aliases.set(id, 0)
            bases.set(id, id)
            blockOf.set(id, block)
            pending.push(id)
            return arrival(getRef(n, 1), id, block) && arrival(getRef(n, 2), id, block)
        }
        for (const a of [...ids]) if (!alias(a, homes.get(a)!)) return false
        while (pending.length) {
            const a = pending.pop()!
            for (const u of dependents.get(a) ?? []) {
                const n = getNode(g, u)!
                if (n.op === NodeOp.alloca && getRef(n, 0) === a) continue
                const pointer = (n.op === NodeOp.load || n.op === NodeOp.store) && getRef(n, 1) === a
                if (!pointer && tokenUse(n, a)) continue
                if (n.op === NodeOp.add || (n.op === NodeOp.after && getRef(n, countIds(n) - 1) === a)) {
                    if (!alias(u, blockOf.get(a)!)) return false
                    continue
                }
                if (n.op === NodeOp.select && getRef(n, 0) !== a) {
                    if (!selectRoot(u, blockOf.get(a)!)) return false
                    continue
                }
                if (n.op === NodeOp.apply) {
                    const target = getBlock(g, getRef(n, 0))
                    if (!target || target === g.blocks[0]) return false
                    for (let i = 1; i < countIds(n); i++) {
                        if (getRef(n, i) !== a) continue
                        if (!alias(target.params[i - 1], target.id) && !mergeRoot(target.params[i - 1])) return false
                        passTo(target, i - 1)
                    }
                    continue
                }
                if (n.op === NodeOp.store && getRef(n, 3) === a && getRef(n, 1) !== a) {
                    const into = getNode(g, mem.of(getRef(n, 1)).base)
                    if (into?.op === NodeOp.pstack || into?.op === NodeOp.alloca) storedInside()
                }
                if (!pointer || getRef(n, 2)) return false
                if (n.op === NodeOp.store && getRef(n, 3) === a) return false
                const offset = slotOf(a, getLiteral(g, n, 2))
                const known = slotTypes.get(offset)
                const T = gn.machineType(typeOf(n))
                if (known !== undefined && !sameSlotBits(known, T)) return false
                slotTypes.set(offset, known !== undefined && lowering.isSignedType(known) ? known : T)
            }
        }
        for (const s of selectors) {
            const n = getNode(g, s)!
            const home = roots.has(s) ? [...reachableBlocks].find(b => findValues(b.id, NodeOp.select)?.includes(s)) : undefined
            for (const id of home ? findValues(home.id, NodeOp.store) ?? [] : []) {
                if (bases.get(getRef(getNode(g, id)!, 1)) === s) return false
            }
            if (!aliases.has(getRef(n, 1)) || !aliases.has(getRef(n, 2))) return false
        }
        const present = new Map<number, Set<number>>()
        for (const [id, base] of bases) {
            const block = blockOf.get(id)!
            const set = present.get(block)
            if (set) set.add(base)
            else present.set(block, new Set([base]))
        }
        for (const [block, set] of present) {
            for (const base of set) {
                for (let root = mergedInto.get(base); root !== undefined; root = mergedInto.get(root)) {
                    if (set.has(root) && !(selectors.has(root) && blockOf.get(root) === block)) return false
                }
            }
        }
        for (const block of pointerSlots.keys()) {
            for (const from of preds.get(block) ?? []) touched.add(getGraphBlock(from))
        }
        const slots = [...slotTypes].sort((x, y) => slotBases[x[0]] - slotBases[y[0]] || slotOffsets[x[0]] - slotOffsets[y[0]])
        for (let i = 1; i < slots.length; i++) {
            const [prev, T] = slots[i - 1]
            const next = slots[i][0]
            if (slotBases[prev] === slotBases[next] && slotOffsets[prev] + intrinsics.intrinsicBitWidth(T) / 8 > slotOffsets[next]) return false
        }
        const loads: [GraphBlock, number][] = []
        const stores = new Set<number>()
        for (const b of reachableBlocks) {
            for (const id of findValues(b.id, NodeOp.load) ?? []) {
                if (!aliases.has(getRef(getNode(g, id)!, 1))) continue
                loads.push([b, id])
                touched.add(b)
            }
            for (const id of findValues(b.id, NodeOp.store) ?? []) {
                if (!aliases.has(getRef(getNode(g, id)!, 1))) continue
                stores.add(id)
                touched.add(b)
            }
        }

        function tailTokens(n: GraphNode, tokens: number[]): number[] {
            const next = tokens.slice()
            for (let i = 0; i < countIds(n) - 1; i++) if (getRef(n, i)) next.push(getRef(n, i))
            return next
        }
        function tailApplies(b: GraphBlock, visit: (app: number, tokens: number[]) => boolean): boolean {
            function walk(id: number, tokens: number[]): boolean {
                const n = getNode(g, id)
                if (!n) return true
                if (n.op === NodeOp.after) return walk(getRef(n, countIds(n) - 1), tailTokens(n, tokens))
                if (n.op === NodeOp.select) return walk(getRef(n, 1), tokens) && walk(getRef(n, 2), tokens)
                if (n.op === NodeOp.apply) return visit(id, tokens)
                return true
            }
            return walk(b.bodyId, [])
        }

        const entries = new Map<string, number>()
        const added = new Map<number, number[]>()
        function entryValue(b: GraphBlock, offset: number): [number, number] | undefined {
            if (b === g.blocks[0]) return
            const at = `${b.id}:${offset}`
            const known = entries.get(at)
            if (known !== undefined) return [known, 0]
            const param = addParam(slotTypes.get(offset)!)
            entries.set(at, param)
            const list = added.get(b.id)
            if (list) list.push(offset)
            else added.set(b.id, [offset])
            for (const from of preds.get(b.id) ?? []) {
                const pred = getGraphBlock(from)
                const seen = new Set<number>()
                const ok = tailApplies(pred, (app, tokens) => {
                    const n = getNode(g, app)!
                    if (getRef(n, 0) !== b.id) return true
                    seen.add(app)
                    return !!arrivalValue(pred, tokens, app, b, offset)
                })
                if (!ok) return
                for (const app of findValues(pred.id, NodeOp.apply) ?? []) {
                    if (getRef(getNode(g, app)!, 0) === b.id && !seen.has(app)) return
                }
            }
            return [param, 0]
        }

        const storedValues = new Map<number, [number, number]>()
        function storedValue(id: number, store: GraphNode): [number, number] {
            const known = storedValues.get(id)
            if (known) return known
            const T = typeOf(store)
            const ref = getRef(store, 3)
            const literal = ref ? 0 : getLiteral(g, store, 3)
            const value: [number, number] = intrinsics.intrinsicBitWidth(T) === 64 ? [ref, literal]
                : [addNode(g, NodeOp.convert, [ref || { literal }], T), 0]
            storedValues.set(id, value)
            return value
        }

        type Found = [number, number, number] | 'entry' | undefined
        const memo = new Map<string, Found>()
        function search(b: GraphBlock, token: number, offset: number): Found {
            const at = `${b.id}:${token}:${offset}`
            if (memo.has(at)) return memo.get(at)
            const result = findStore(b, token, offset)
            memo.set(at, result)
            return result
        }
        function findStore(b: GraphBlock, token: number, offset: number): Found {
            for (;;) {
                if (!token || isUnordered(token)) return 'entry'
                const n = getNode(g, token)
                if (!n) return
                if (n.op === NodeOp.nilEffect || n.op === NodeOp.param || n.op === NodeOp.block) return 'entry'
                if (n.op === NodeOp.store && aliases.has(getRef(n, 1)) && slotOf(getRef(n, 1), getLiteral(g, n, 2)) === offset) {
                    const [ref, literal] = storedValue(token, n)
                    return [ref, literal, token]
                }
                let chain = OrderedValues.has(n.op)
                for (let i = 1; chain && i < countIds(n); i++) chain = isUnordered(getRef(n, i))
                if (chain) {
                    token = getRef(n, 0)
                    continue
                }
                const refs: number[] = []
                for (let i = 0; i < countIds(n); i++) refs.push(getRef(n, i))
                return join(b, refs, offset)
            }
        }
        function orderedBefore(a: number, b: number): boolean {
            if (precedes(a, b)) return true
            const seen = new Set<number>([b])
            const work = [b]
            while (work.length) {
                const n = getNode(g, work.pop()!)
                if (!n) continue
                for (let i = 0; i < countIds(n); i++) {
                    const ref = operandEdge(n, i)
                    if (!ref || seen.has(ref)) continue
                    if (ref === a) return true
                    seen.add(ref)
                    work.push(ref)
                }
            }
            return false
        }
        function join(b: GraphBlock, tokens: number[], offset: number): Found {
            let result: Found = 'entry'
            const live = tokens.filter(token => token && !isUnordered(token))
            for (const token of live) {
                if (live.some(other => other !== token && precedes(token, other))) continue
                const found = search(b, token, offset)
                if (found === undefined) return
                if (found === 'entry') continue
                if (result !== 'entry' && (result[0] !== found[0] || result[1] !== found[1])) {
                    if (orderedBefore(found[2], result[2])) continue
                    if (!orderedBefore(result[2], found[2])) return
                }
                result = found
            }
            return result
        }
        function valueAfter(b: GraphBlock, tokens: number[], offset: number): [number, number] | undefined {
            const found = join(b, tokens, offset)
            return found === 'entry' ? entryValue(b, offset) : found && [found[0], found[1]]
        }
        function valueFrom(b: GraphBlock, token: number, offset: number): [number, number] | undefined {
            return valueAfter(b, [token], offset)
        }
        function arrivalValue(pred: GraphBlock, tokens: number[], app: number, target: GraphBlock, slot: number): [number, number] | undefined {
            const base = slotBases[slot]
            const n = getNode(g, app)!
            if (roots.has(base) && target.params.includes(base)) return operandValue(pred, [...tokens, app], getRef(n, target.params.indexOf(base) + 1), slotOffsets[slot])
            if (selectors.has(base)) {
                for (let i = 1; i < countIds(n); i++) {
                    if (unwrap(getRef(n, i)) === base && bases.get(target.params[i - 1]) === base) return operandValue(pred, [...tokens, app], getRef(n, i), slotOffsets[slot])
                }
            }
            return valueAfter(pred, [...tokens, app], slot)
        }
        function operandValue(pred: GraphBlock, tokens: number[], ref: number, offset: number): [number, number] | undefined {
            const inner = unwrap(ref)
            if (selectors.has(inner)) {
                const n = getNode(g, inner)!
                const yes = operandValue(pred, tokens, getRef(n, 1), offset)
                const no = operandValue(pred, tokens, getRef(n, 2), offset)
                if (!yes || !no) return
                if (yes[0] === no[0] && yes[1] === no[1]) return yes
                return [addNode(g, NodeOp.select, [getRef(n, 0) || { literal: getLiteral(g, n, 0) }, yes[0] || { literal: yes[1] }, no[0] || { literal: no[1] }]), 0]
            }
            return valueAfter(pred, tokens, slotOf(ref, offset))
        }

        const values = new Map<number, [number, number]>()
        for (const [b, id] of loads) {
            const load = getNode(g, id)!
            const ptr = getRef(load, 1)
            const base = bases.get(ptr)!
            const value = selectors.has(base) && roots.has(base) && blockOf.get(base) === b.id
                ? operandValue(b, [getRef(load, 0)], base, aliases.get(ptr)! + getLiteral(g, load, 2))
                : valueFrom(b, getRef(load, 0), slotOf(ptr, getLiteral(g, load, 2)))
            if (!value) return false
            values.set(id, value)
        }

        if (!added.size && !pointerSlots.size) {
            for (const id of ids) if (batch.ids.has(id)) return 'settle'
            for (const id of stores) if (batch.stores.has(id)) return 'settle'
            for (const id of ids) batch.ids.add(id)
            for (const id of stores) batch.stores.add(id)
            for (const [id, value] of values) batch.values.set(id, value)
            for (const b of touched) batch.touched.add(b)
            return true
        }
        if (batch.ids.size) return 'settle'
        for (const [block, offsets] of added) {
            const b = getGraphBlock(block)
            for (const offset of offsets) b.params.push(entries.get(`${block}:${offset}`)!)
            touched.add(b)
            for (const from of preds.get(block) ?? []) touched.add(getGraphBlock(from))
        }
        const replaced = promotedReplacements({ ids, stores, values, touched })

        function rewriteTail(b: GraphBlock): number {
            function walk(id: number, tokens: number[]): number {
                const n = getNode(g, id)
                if (!n) return id
                if (n.op === NodeOp.after) {
                    const last = countIds(n) - 1
                    const inner = walk(getRef(n, last), tailTokens(n, tokens))
                    if (inner === getRef(n, last)) return id
                    const argIds = cloneRefs(n)
                    argIds[last] = inner
                    return addCopy(g, n, withRefs(g, n, argIds), NodeOp.after)
                }
                if (n.op === NodeOp.select) {
                    const yes = walk(getRef(n, 1), tokens)
                    const no = walk(getRef(n, 2), tokens)
                    if (yes === getRef(n, 1) && no === getRef(n, 2)) return id
                    const argIds = cloneRefs(n)
                    argIds[1] = yes
                    argIds[2] = no
                    return addCopy(g, n, withRefs(g, n, argIds), NodeOp.select)
                }
                if (n.op !== NodeOp.apply) return id
                const offsets = added.get(getRef(n, 0))
                const pointers = pointerSlots.get(getRef(n, 0))
                if (!offsets && !pointers) return id
                const operands = getOperands(g, n)
                const kept: number[] = []
                for (const i of pointers ?? []) {
                    for (let m = getNode(g, getRef(n, i + 1)); m?.op === NodeOp.after; m = getNode(g, getRef(m, countIds(m) - 1))) {
                        for (let k = 0; k < countIds(m) - 1; k++) if (getRef(m, k)) kept.push(getRef(m, k))
                    }
                    operands[i + 1] = { literal: 0 }
                }
                const target = getGraphBlock(getRef(n, 0))
                for (const offset of offsets ?? []) {
                    const [ref, literal] = arrivalValue(b, tokens, id, target, offset)!
                    operands.push(ref || { literal })
                }
                const app = addCopy(g, n, operands, NodeOp.apply)
                return kept.length ? addNode(g, NodeOp.after, [...kept, app]) : app
            }
            return walk(b.bodyId, [])
        }
        const rewritten = new Map<number, number>()
        for (const b of touched) b.bodyId = replaceTransitive(rewriteTail(b), replaced, rewritten)
        for (const b of touched) revisitBlock(b)
        return rewritten
    }

    function splitConstant(term: number): [term: number, offset: number] {
        const t = getNode(g, term)
        if (!t) return [term, 0]
        if (typeOf(t) === Types.f64) return [term, 0]
        if (t.op === NodeOp.add || t.op === NodeOp.sub) {
            const right = scalarOperand(g, g.nodes, t, 1)
            const left = t.op === NodeOp.add ? scalarOperand(g, g.nodes, t, 0) : undefined
            if (right !== undefined && left === undefined) {
                const [rest, offset] = splitConstant(getRef(t, 0))
                return [rest, offset + (t.op === NodeOp.add ? right : -right)]
            }
            if (left !== undefined && right === undefined) {
                const [rest, offset] = splitConstant(getRef(t, 1))
                return [rest, offset + left]
            }
            return [term, 0]
        }
        const scaleAt = t.op === NodeOp.shl ? 1
            : t.op === NodeOp.mul ? (scalarOperand(g, g.nodes, t, 1) !== undefined ? 1 : 0) : -1
        if (scaleAt < 0 || operandType(g, t, 0) > Types.i64 || operandType(g, t, 1) > Types.i64) return [term, 0]
        const amount = scalarOperand(g, g.nodes, t, scaleAt)
        if (amount === undefined || scalarOperand(g, g.nodes, t, scaleAt ^ 1) !== undefined) return [term, 0]
        const [rest, offset] = splitConstant(getRef(t, scaleAt ^ 1))
        if (!offset) return [term, 0]
        const operands: Operand[] = [0, 0]
        operands[scaleAt ^ 1] = rest
        operands[scaleAt] = { literal: amount }
        return [addCopy(g, t, operands, t.op), t.op === NodeOp.shl ? offset * 2 ** amount : offset * amount]
    }

    function addConstant(value: [number, number], k: number): [number, number] {
        if (!value[0]) {
            if (value[1] + k >= 0) return [0, value[1] + k]
            return [addNode(g, NodeOp.sub, [{ literal: value[1] }, { literal: -k }]), 0]
        }
        const [rest, offset] = splitConstant(value[0])
        const shift = offset + k
        if (!shift) return [rest, 0]
        return [addNode(g, shift > 0 ? NodeOp.add : NodeOp.sub, [rest, { literal: Math.abs(shift) }]), 0]
    }

    function applyArg(app: number, i: number): [number, number] {
        const n = getNode(g, app)!
        return [getRef(n, i + 1), getLiteral(g, n, i + 1)]
    }

    function withArg(app: number, i: number, value: [number, number]): number {
        const n = getNode(g, app)!
        const operands = getOperands(g, n)
        operands[i + 1] = value[0] || { literal: value[1] }
        return addCopy(g, n, operands, NodeOp.apply)
    }

    function conditionParams(target: GraphBlock) {
        if (target.id === g.root || !target.params.length || !findValues(target.id, NodeOp.select)?.length) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const byBlock = new Map<number, Map<number, number>>()
        target.params.forEach((p, i) => {
            const uses = dependents.get(p)
            if (!uses?.size) return
            for (const u of uses) {
                const n = getNode(g, u)!
                if (n.op !== NodeOp.select || getRef(n, 0) !== p || getRef(n, 1) === p || getRef(n, 2) === p) return
            }
            const conditions = inbound.map(([, app]) => {
                const [ref, literal] = applyArg(app, i)
                if (!ref) return literal === 0 || literal === 1 ? 0 : undefined
                const m = getNode(g, ref)
                if (m?.op !== NodeOp.select || !getRef(m, 0) || getRef(m, 1) || getRef(m, 2) || getLiteral(g, m, 1) !== 1 || getLiteral(g, m, 2) !== 0) return undefined
                return getRef(m, 0)
            })
            if (conditions.some(c => c === undefined) || !conditions.some(c => c)) return
            inbound.forEach(([from, app], k) => {
                const condition = conditions[k]!
                if (!condition) return
                let replacements = byBlock.get(from)
                if (!replacements) byBlock.set(from, replacements = new Map())
                const current = replacements.get(app) ?? app
                replacements.set(app, withArg(current, i, [condition, 0]))
            })
        })
        if (!byBlock.size) return false
        for (const [from, replacements] of byBlock) {
            const b = getGraphBlock(from)
            b.bodyId = replaceAll(b.bodyId, replacements)
            revisitBlock(b)
        }
        revisitBlock(target)
        return true
    }

    function foldAddresses(target: GraphBlock) {
        return simplifyBits(target, true)
    }

    function simplifyBitOperations(target: GraphBlock) {
        return simplifyBits(target, false)
    }

    function simplifyBits(target: GraphBlock, addresses: boolean) {
        let changed = false
        const forwarded = new Map<number, number>()
        function addressesOnly(ref: number, asBase: boolean): boolean {
            for (const u of dependents.get(ref) ?? []) {
                const m = getNode(g, u)
                if (m?.op !== NodeOp.load && m?.op !== NodeOp.store) return false
                if (asBase && getRef(m, 1) !== ref) return false
            }
            return true
        }
        function foldAddress(id: number) {
            const n = getNode(g, id)!
            const scalar = scalarOperand(g, g.nodes, n, 2)
            const index = scalar === undefined ? getRef(n, 2) : 0
            const [term, termOffset] = splitConstant(index)
            const splitsIndex = term !== index && addressesOnly(index, false)
            const rest = splitsIndex ? term : index
            let offset = (scalar ?? 0) + (splitsIndex ? termOffset : 0)
            const [base, baseOffset] = splitConstant(getRef(n, 1))
            const splitsBase = !rest && !!base && !!baseOffset && addressesOnly(getRef(n, 1), true)
            if (splitsBase) offset += baseOffset
            if ((!splitsIndex && !splitsBase) || !Number.isSafeInteger(offset) || !inlineableLiteral(costs, offset)) return
            const operands = getOperands(g, n)
            if (splitsBase) operands[1] = base
            if (rest && offset) {
                operands[1] = addNode(g, NodeOp.add, [operands[1], rest])
                operands[2] = { literal: offset }
            } else {
                operands[2] = rest || { literal: offset }
            }
            putCopy(g, id, n, operands)
            changed = true
        }
        function foldTest(id: number) {
            const n = getNode(g, id)
            if (!n || (n.op !== NodeOp.eq && n.op !== NodeOp.ne) || countIds(n) < 2) return
            const valueAt = !getRef(n, 0) && getLiteral(g, n, 0) === 0 ? 1
                : !getRef(n, 1) && getLiteral(g, n, 1) === 0 ? 0 : -1
            if (valueAt < 0) return
            foldTest(getRef(n, valueAt))
            const inner = getNode(g, getRef(n, valueAt))
            if (!inner || !CompareOps.has(inner.op)) return
            if (n.op === NodeOp.eq && comparesFloats(g, inner)) return
            const op = n.op === NodeOp.eq ? InverseCompare.get(inner.op)! : inner.op
            putCopy(g, id, inner, getOperands(g, inner), op)
            changed = true
        }
        for (const id of addresses ? [] : findValues(target.id, NodeOp.mul) ?? []) {
            const n = getNode(g, id)!
            if (typeOf(n) === Types.f64) continue
            const negated = scalarOperand(g, g.nodes, n, 0) === -1 ? getRef(n, 1)
                : scalarOperand(g, g.nodes, n, 1) === -1 ? getRef(n, 0) : 0
            if (negated) {
                putCopy(g, id, n, [negated], NodeOp.neg)
                changed = true
                continue
            }
            const valueAt = getRef(n, 0) && !getRef(n, 1) ? 0
                : getRef(n, 1) && !getRef(n, 0) ? 1 : -1
            if (valueAt < 0) continue
            const shift = Math.log2(getLiteral(g, n, valueAt ^ 1))
            if (!Number.isSafeInteger(shift) || shift <= 0) continue
            changed = true
            putCopy(g, id, n, [getRef(n, valueAt), { literal: shift }], NodeOp.shl)
        }
        for (const op of addresses ? [] : [NodeOp.div, NodeOp.rem]) {
            for (const id of findValues(target.id, op) ?? []) {
                const n = getNode(g, id)!
                if (typeOf(n) === Types.f64 || !getRef(n, 0) || getRef(n, 1)) continue
                if (lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))) continue
                const divisor = getLiteral(g, n, 1)
                const shift = Math.log2(divisor)
                if (!Number.isSafeInteger(shift) || shift <= 0) continue
                changed = true
                if (op === NodeOp.div) putCopy(g, id, n, [getRef(n, 0), { literal: shift }], NodeOp.ushr)
                else putCopy(g, id, n, [getRef(n, 0), { literal: divisor - 1 }], NodeOp.and)
            }
        }
        for (const id of findValues(target.id, NodeOp.load) ?? []) foldAddress(id)
        for (const id of findValues(target.id, NodeOp.store) ?? []) foldAddress(id)
        if (addresses) {
            if (changed) revisitBlock(target)
            return changed
        }
        for (const id of findValues(target.id, NodeOp.eq) ?? []) foldTest(id)
        for (const id of findValues(target.id, NodeOp.ne) ?? []) foldTest(id)
        const sameOperand = (a: GraphNode, i: number, b: GraphNode, j: number) => getRef(a, i)
            ? getRef(a, i) === getRef(b, j)
            : !getRef(b, j) && getLiteral(g, a, i) === getLiteral(g, b, j)
        const wordOp = (n: GraphNode) => operandType(g, n, 0) <= Types.i64 && operandType(g, n, 1) <= Types.i64
        for (const id of findValues(target.id, NodeOp.add) ?? []) {
            const n = getNode(g, id)!
            if (!wordOp(n)) continue
            for (let i = 0; i < 2; i++) {
                const inner = getNode(g, getRef(n, i))
                if (!inner || inner.op !== NodeOp.sub || !wordOp(inner)) continue
                if (!sameOperand(n, i ^ 1, inner, 1)) continue
                if (getRef(inner, 0)) forwarded.set(id, getRef(inner, 0))
                else putCopy(g, id, n, [{ literal: getLiteral(g, inner, 0) }, 0], NodeOp.add)
                changed = true
                break
            }
        }
        for (const id of findValues(target.id, NodeOp.sub) ?? []) {
            const n = getNode(g, id)!
            const inner = getNode(g, getRef(n, 0))
            if (!wordOp(n) || !inner || inner.op !== NodeOp.add || !wordOp(inner)) continue
            for (let j = 0; j < 2; j++) {
                if (!sameOperand(n, 1, inner, j)) continue
                if (getRef(inner, j ^ 1)) forwarded.set(id, getRef(inner, j ^ 1))
                else putCopy(g, id, n, [{ literal: getLiteral(g, inner, j ^ 1) }, 0], NodeOp.add)
                changed = true
                break
            }
        }
        for (const id of findValues(target.id, NodeOp.and) ?? []) {
            const n = getNode(g, id)!
            const shiftAt = getRef(n, 0) ? 0 : getRef(n, 1) ? 1 : -1
            if (shiftAt < 0) continue
            const maskAt = shiftAt ^ 1
            if (getRef(n, maskAt)) continue
            const shiftId = getRef(n, shiftAt)
            const shift = getNode(g, shiftId)
            if (!shift || shift.op !== NodeOp.ushr || getRef(shift, 1)) continue
            const width = Math.log2(getLiteral(g, n, maskAt) + 1)
            const U = width === 8 ? Types.u8 : width === 16 ? Types.u16 : width === 32 ? Types.u32 : undefined
            if (U === undefined) continue
            changed = true
            putNode(g, id, NodeOp.convert, [shiftId], U)
        }
        const soleUser = (id: number, user: number) => {
            const users = dependents.get(id)
            return users?.size === 1 && users.has(user)
        }
        for (const id of findValues(target.id, NodeOp.convert) ?? []) {
            const n = getNode(g, id)!
            const U = typeOf(n)
            if (U !== Types.u8 && U !== Types.u16 && U !== Types.u32) continue
            let source = getRef(n, 0)
            let user = id
            let shift = 0
            const inner = getNode(g, source)
            if (inner?.op === NodeOp.ushr && !getRef(inner, 1) && soleUser(source, id)) {
                user = source
                shift = getLiteral(g, inner, 1)
                source = getRef(inner, 0)
            }
            const load = getNode(g, source)
            if (load?.op !== NodeOp.load || getRef(load, 2) || !soleUser(source, user)) continue
            const W = typeOf(load)
            if (W !== Types.u32 && W !== Types.u64) continue
            const bits = intrinsics.intrinsicBitWidth(U)
            if (shift % bits || shift + bits > intrinsics.intrinsicBitWidth(W)) continue
            const operands = getOperands(g, load)
            operands[2] = { literal: getLiteral(g, load, 2) + shift / 8 }
            putNode(g, id, NodeOp.load, operands, U)
            changed = true
        }
        if (forwarded.size) target.bodyId = replaceAll(target.bodyId, forwarded)
        if (changed) revisitBlock(target)
        return changed
    }

    function reassociateAdds(target: GraphBlock): boolean {
        const adds = findValues(target.id, NodeOp.add)
        if (!adds || adds.length < 2) return false
        const depthOf = latencyDepth(g, costs)
        const leaves: number[] = []
        let constant = 0
        let T = Types.i64
        function chained(id: number): boolean {
            const n = getNode(g, id)
            return n?.op === NodeOp.add && countIds(n) === 2 && typeOf(n) === T
        }
        function interior(id: number): boolean {
            const users = dependents.get(id)
            return chained(id) && users?.size === 1 && chained([...users][0])
        }
        function flatten(id: number): number {
            const n = getNode(g, id)!
            let d = 0
            for (let i = 0; i < 2; i++) {
                const k = scalarOperand(g, g.nodes, n, i)
                const ref = getRef(n, i)
                if (k !== undefined) constant += k
                else if (interior(ref)) d = Math.max(d, flatten(ref))
                else {
                    leaves.push(ref)
                    d = Math.max(d, depthOf(ref))
                }
            }
            return d + 1
        }
        let changed = false
        for (const root of adds) {
            const n = getNode(g, root)!
            T = typeOf(n)
            if (T > Types.i64 || !chained(root) || interior(root)) continue
            leaves.length = 0
            constant = 0
            const before = flatten(root)
            if (leaves.length < 2 || !Number.isSafeInteger(constant)) continue
            leaves.sort((a, b) => depthOf(a) - depthOf(b))
            let after = depthOf(leaves[0]) + (constant ? 1 : 0)
            for (let i = 1; i < leaves.length; i++) after = Math.max(after, depthOf(leaves[i])) + 1
            if (after >= before) continue
            let acc: Operand = constant ? addCopy(g, n, [leaves[0], { literal: constant }], NodeOp.add) : leaves[0]
            for (let i = 1; i < leaves.length - 1; i++) acc = addCopy(g, n, [acc, leaves[i]], NodeOp.add)
            putCopy(g, root, n, [acc, leaves[leaves.length - 1]])
            changed = true
        }
        if (changed) revisitBlock(target)
        return changed
    }

    function hoistLoopStep(target: GraphBlock) {
        if (target === g.blocks[0]) return false
        const loop = countedLoop(target)
        if (!loop || loop.entries.length !== 1) return false
        for (const app of loop.selfApps) {
            for (const u of dependents.get(app) ?? []) if (getNode(g, u)?.op !== NodeOp.select) return false
        }
        const [entryBlock, entryApp] = loop.entries[0]
        const params = target.params

        for (let i = 0; i < params.length; i++) {
            const step = loop.steps[i]
            if (!step || step < 0 || !privateStep(loop, i)) continue
            if (params.some((p, k) => k !== i && !loop.invariant.has(p))) continue
            const start = applyArg(entryApp, i)
            const entry = addConstant(start, -step)
            const previous = paramLike(entry[0] || params[i])
            const back = getNode(g, getRef(getNode(g, loop.selfApps[0])!, i + 1))
            const current = back ? addCopy(g, back, [previous, { literal: step }], NodeOp.add) : addNode(g, NodeOp.add, [previous, { literal: step }])
            const replacements = new Map<number, number>([[params[i], current]])
            for (const app of loop.selfApps) replacements.set(app, withArg(app, i, [current, 0]))
            params[i] = previous
            target.bodyId = replaceAll(target.bodyId, replacements)

            const from = getGraphBlock(entryBlock)
            from.bodyId = replaceAll(from.bodyId, new Map([[entryApp, withArg(entryApp, i, entry)]]))
            revisitBlock(from)
            revisitBlock(target)
            return true
        }
        return false
    }

    function rebaseShape(block: GraphBlock, base: number, offset: number) {
        if (block === g.blocks[0]) return
        const word = (n: GraphNode) => operandType(g, n, 0) <= Types.i64 && operandType(g, n, 1) <= Types.i64
        const addressed = (m: GraphNode | undefined, at: number) => !!m
            && (m.op === NodeOp.load || m.op === NodeOp.store) && getRef(m, 1) === base && getRef(m, 2) === at
            && getRef(m, 0) !== at && (countIds(m) < 4 || getRef(m, 3) !== at)
        const shape = { pairs: [] as number[], offsets: [] as number[], direct: [] as number[], outbound: [] as number[] }
        for (const u of dependents.get(offset) ?? []) {
            const n = getNode(g, u)
            if (!n) return
            if (n.op === NodeOp.apply) {
                if (getRef(n, 0) === offset) return
                shape.outbound.push(u)
                continue
            }
            if (addressed(n, offset)) {
                shape.direct.push(u)
                continue
            }
            if (n.op !== NodeOp.add || countIds(n) !== 2 || !word(n)) return
            const other = getRef(n, 0) === offset ? 1 : getRef(n, 1) === offset ? 0 : -1
            if (other < 0 || getRef(n, other) === offset) return
            if (getRef(n, other) === base) {
                shape.pairs.push(u)
                continue
            }
            for (const w of dependents.get(u) ?? []) {
                if (!addressed(getNode(g, w), u)) return
            }
            shape.offsets.push(u)
        }
        return shape
    }

    function rebaseAddresses(target: GraphBlock) {
        if (target === g.blocks[0] || target.params.length < 2 || !findValues(target.id, NodeOp.add)?.length) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const params = target.params
        function cancels(base: [number, number], offset: [number, number]) {
            const t = getNode(g, offset[0])
            return !!base[0] && t?.op === NodeOp.sub && getRef(t, 1) === base[0]
        }
        function combine(base: [number, number], offset: [number, number]): [number, number] {
            const t = getNode(g, offset[0])
            if (cancels(base, offset)) return [getRef(t!, 0), getLiteral(g, t!, 0)]
            if (!offset[0]) return addConstant(base, offset[1])
            const [rest, constant] = splitConstant(offset[0])
            return addConstant([addNode(g, NodeOp.add, [base[0] || { literal: base[1] }, rest]), 0], constant)
        }

        const candidates = new Map<string, [base: number, offset: number]>()
        const consider = (base: number, offset: number) => {
            const j = params.indexOf(base)
            const i = params.indexOf(offset)
            if (i >= 0 && j >= 0 && i !== j) candidates.set(`${j}:${i}`, [j, i])
        }
        for (const u of findValues(target.id, NodeOp.add) ?? []) {
            const n = getNode(g, u)!
            const a = getRef(n, 0)
            const b = getRef(n, 1)
            consider(a, b)
            consider(b, a)
            for (const w of dependents.get(u) ?? []) {
                const m = getNode(g, w)
                if ((m?.op === NodeOp.load || m?.op === NodeOp.store) && getRef(m, 2) === u) {
                    consider(getRef(m, 1), a)
                    consider(getRef(m, 1), b)
                }
            }
        }
        const members = candidates.size ? loopMembers(target) : undefined
        const loop = members && members.size > 1 ? members : undefined
        for (const [j, i] of candidates.values()) {
            if (loop && relayedChain(target, i, loop) && !relayedChain(target, j, loop)) continue
            const pa = params[j]
            const pt = params[i]
            const shape = rebaseShape(target, pa, pt)
            if (!shape) continue
            const gain = shape.pairs.length + shape.offsets.length
            if (!gain) continue
            let cost = 0
            for (const u of shape.outbound) {
                const n = getNode(g, u)!
                const into = getRef(n, 0)
                const b = into === target.id ? target : getBlock(g, into)
                for (let k = 1; k < countIds(n); k++) {
                    if (getRef(n, k) !== pt) continue
                    if (b === target) {
                        if (k !== i + 1 || getRef(n, j + 1) !== pa) cost += 2
                        continue
                    }
                    let l = 1
                    while (l < countIds(n) && getRef(n, l) !== pa) l++
                    if (!b || l === countIds(n) || !rebaseShape(b, b.params[l - 1], b.params[k - 1])) cost++
                }
            }
            for (const [from, app] of inbound) {
                if (from === target.id) continue
                const base = applyArg(app, j)
                const offset = applyArg(app, i)
                if (cancels(base, offset)) continue
                const p = getGraphBlock(from)
                if (base[0] && offset[0] && p.params.includes(base[0]) && p.params.includes(offset[0])
                    && rebaseShape(p, base[0], offset[0])) continue
                cost++
            }
            if (cost > gain) continue

            const np = paramLike(pa)
            const back = addNode(g, NodeOp.sub, [np, pa])
            const byBlock = new Map<number, Map<number, number>>()
            for (const [from, app] of inbound) {
                if (from === target.id) continue
                let replacements = byBlock.get(from)
                if (!replacements) byBlock.set(from, replacements = new Map())
                replacements.set(app, withArg(app, i, combine(applyArg(app, j), applyArg(app, i))))
            }
            for (const [from, replacements] of byBlock) {
                const p = getGraphBlock(from)
                p.bodyId = replaceAll(p.bodyId, replacements)
                revisitBlock(p)
            }
            function readdress(id: number, offset: [number, number]) {
                const m = getNode(g, id)!
                const operands = getOperands(g, m)
                operands[1] = np
                operands[2] = offset[0] || { literal: offset[1] }
                putCopy(g, id, m, operands)
            }
            for (const u of shape.offsets) {
                const n = getNode(g, u)!
                const at = getRef(n, 0) === pt ? 1 : 0
                for (const w of dependents.get(u)!) readdress(w, [getRef(n, at), getLiteral(g, n, at)])
            }
            for (const u of shape.direct) readdress(u, [0, 0])
            for (const [from, app] of inbound) {
                if (from !== target.id) continue
                const n = getNode(g, app)!
                const operands = getOperands(g, n)
                const sum = getRef(n, i + 1) === pt && getRef(n, j + 1) === pa ? [np, 0]
                    : combine(applyArg(app, j), applyArg(app, i))
                operands[i + 1] = sum[0] || { literal: sum[1] }
                putCopy(g, app, n, operands)
            }
            const replacements = new Map<number, number>([[pt, back]])
            for (const u of shape.pairs) replacements.set(u, np)
            params[i] = np
            target.bodyId = replaceAll(target.bodyId, replacements)
            revisitBlock(target)
            return true
        }
        return false
    }

    function foldValues(target: GraphBlock) {
        type Value = { id: number, value: number }
        const folded = new Map<number, Value>()
        const epoch = nextEpoch(g)
        let lifted: number[] = []

        function operand(n: GraphNode, i: number, compare = CompareOps.has(n.op)): Value {
            const ref = getRef(n, i)
            if (!ref) return { id: 0, value: getLiteral(g, n, i) }
            const m = getNode(g, ref)
            if (m && FoldableOps.has(m.op)) return fold(ref, m)
            if (m?.op === NodeOp.literal && (compare || n.op === NodeOp.convert || inlineableLiteral(costs, literalValue(g, m)))) return { id: 0, value: literalValue(g, m) }
            if (compare && m?.op === NodeOp.after) {
                for (let j = 0; j < countIds(m) - 1; j++) if (!isNilOrVoid(getRef(m, j))) lifted.push(getRef(m, j))
                return operand(m, countIds(m) - 1, true)
            }
            if (compare && isNullishValue(g, ref)) return { id: 0, value: 0 }
            return { id: ref, value: 0 }
        }

        function literalArg(arg: Value): Value {
            const m = arg.id ? getNode(g, arg.id) : undefined
            if (m?.op !== NodeOp.literal) return arg
            return { id: 0, value: literalValue(g, m) }
        }

        function slotTypes(n: GraphNode): [Types, Types] {
            const a = operandType(g, n, 0)
            const b = operandType(g, n, 1)
            if (!getRef(n, 0)) return [b, b]
            if (!getRef(n, 1)) return [a, a]
            return [a, b]
        }

        function constantNumber(n: GraphNode, i: number): number | undefined {
            if (!getRef(n, i)) return getLiteral(g, n, i)
            const m = getNode(g, tailOf(g, getRef(n, i)))
            return m?.op === NodeOp.literal ? literalValue(g, m) : undefined
        }
        function sameConstants(n: GraphNode): boolean | undefined {
            const x = getNode(g, tailOf(g, getRef(n, 0)))
            const y = getNode(g, tailOf(g, getRef(n, 1)))
            if (x?.op === NodeOp.heapHandle && y?.op === NodeOp.heapHandle) return getLiteral(g, x, 0) === getLiteral(g, y, 0)
            const a = constantNumber(n, 0)
            const b = constantNumber(n, 1)
            if (a === undefined || b === undefined || !Number.isSafeInteger(a) || !Number.isSafeInteger(b) || a < 0 || b < 0) return
            return a === b
        }
        function handleOf(v: Value): number | undefined {
            const m = v.id ? getNode(g, v.id) : undefined
            if (m?.op !== NodeOp.heapHandle || countIds(m) !== 1 || getRef(m, 0)) return
            return getLiteral(g, m, 0)
        }
        function compareConstants(n: GraphNode, a: Value, b: Value): Value | undefined {
            if (a.id || b.id) {
                const x = handleOf(a)
                const y = handleOf(b)
                if (x === undefined || y === undefined) return
                if (n.op !== NodeOp.eq && n.op !== NodeOp.ne) return
                return { id: 0, value: (x === y) === (n.op === NodeOp.eq) ? 1 : 0 }
            }
            if (!Number.isSafeInteger(a.value) || !Number.isSafeInteger(b.value)) return
            const signed = lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))
            if (!signed && (a.value < 0 || b.value < 0)) return
            return { id: 0, value: CompareEval[n.op](a.value, b.value) ? 1 : 0 }
        }
        function armValue(s: GraphNode, i: number): Value {
            const ref = getRef(s, i)
            if (!ref) return { id: 0, value: getLiteral(g, s, i) }
            const m = getNode(g, ref)!
            if (m.op === NodeOp.literal) return { id: 0, value: literalValue(g, m) }
            if (isNullishValue(g, ref)) return { id: 0, value: 0 }
            return { id: ref, value: 0 }
        }
        function dissolves(id: number, parent: number): boolean {
            for (const u of dependents.get(id) ?? []) {
                if (u === parent) continue
                const c = getNode(g, u)!
                if (!CompareOps.has(c.op) || countIds(c) !== 2) return false
                const ref = getRef(c, getRef(c, 0) === id ? 1 : 0)
                if (ref === id) return false
                const k = ref ? getNode(g, ref)! : undefined
                if (k && k.op !== NodeOp.literal && k.op !== NodeOp.heapHandle) return false
            }
            return true
        }
        function compareArms(n: GraphNode, side: number, id: number, parent: number, other: Value, tokens: number[], dissolving: boolean, depth: number): Value | undefined {
            const s = getNode(g, id)!
            if (s.op !== NodeOp.select || countIds(s) !== 3 || !getRef(s, 0) || depth > 3) return
            const dissolved = dissolving && dissolves(id, parent)
            const results: Value[] = []
            for (let i = 1; i < 3; i++) {
                const arm = armValue(s, i)
                const nested = arm.id ? getNode(g, arm.id)! : undefined
                const r = nested?.op === NodeOp.select
                    ? compareArms(n, side, arm.id, id, other, tokens, dissolved, depth + 1)
                    : compareConstants(n, side === 0 ? arm : other, side === 0 ? other : arm)
                if (!r) return
                results.push(r)
            }
            const [whenTrue, whenFalse] = results
            const condition = getRef(s, 0)
            if (whenTrue.id === whenFalse.id && whenTrue.value === whenFalse.value) {
                const test = getNode(g, condition)!
                if (test.op === NodeOp.after || OrderedValues.has(test.op)) tokens.push(condition)
                return whenTrue
            }
            if (!whenTrue.id && !whenFalse.id) {
                return { id: addNode(g, whenTrue.value ? NodeOp.ne : NodeOp.eq, [condition, { literal: 0 }], Types.bool), value: 0 }
            }
            if (!dissolved) return
            return { id: addCopy(g, s, [condition, whenTrue.id || { literal: whenTrue.value }, whenFalse.id || { literal: whenFalse.value }]), value: 0 }
        }
        function nonNullAddress(id: number): boolean {
            const m = currentMem().of(id)
            return !m.pending && nonZero(g, m.base, 0, [])
        }
        function signedFold(n: GraphNode, a: number, b: number): Value | undefined {
            const wide = (i: number) => operandType(g, n, i) === Types.i64 || operandType(g, n, i) === Types.u64
            if (!wide(0) || !wide(1) || !Number.isSafeInteger(a) || !Number.isSafeInteger(b)) return
            let folded: number | undefined
            if (n.op === NodeOp.add) folded = a + b
            else if (n.op === NodeOp.sub) folded = a - b
            else if (n.op === NodeOp.mul) folded = a * b
            else if (n.op === NodeOp.lt) folded = a < b ? 1 : 0
            else if (n.op === NodeOp.le) folded = a <= b ? 1 : 0
            else if (n.op === NodeOp.gt) folded = a > b ? 1 : 0
            else if (n.op === NodeOp.ge) folded = a >= b ? 1 : 0
            else if (n.op === NodeOp.eq) folded = a === b ? 1 : 0
            else if (n.op === NodeOp.ne) folded = a !== b ? 1 : 0
            if (folded === undefined || !Number.isSafeInteger(folded)) return
            if (folded < 0 && typeOf(n) !== Types.i64) return
            return { id: 0, value: folded }
        }
        function fold(id: number, n: GraphNode): Value {
            const known = folded.get(id)
            if (known) return known
            if (n.op === NodeOp.convert) {
                if (typeOf(n) > Types.u32 || operandType(g, n, 0) > Types.i64) {
                    return { id, value: 0 }
                }
            }
            if (!markVisited(n, epoch)) {
                return { id, value: 0 }
            }

            const outer = lifted
            lifted = []
            const args: Value[] = []
            for (let i = 0; i < countIds(n); i++) args.push(operand(n, i))
            const tokens = lifted
            lifted = outer
            const constants = args.map(literalArg)

            let result: Value | undefined
            if (n.op === NodeOp.convert && constants.length === 1 && !constants[0].id
                && Number.isSafeInteger(constants[0].value)) {
                const bits = intrinsics.intrinsicBitWidth(typeOf(n))
                result = { id: 0, value: Number(BigInt.asUintN(bits, BigInt(constants[0].value))) }
            }
            if (constants.length === 2 && constants.every(arg => !arg.id)
                && constants[0].value >= 0 && constants[1].value >= 0) {
                const a = constants[0].value, b = constants[1].value
                let folded: number | undefined
                if (n.op === NodeOp.add) folded = a + b
                else if (n.op === NodeOp.sub && a >= b) folded = a - b
                else if (n.op === NodeOp.mul) folded = a * b
                else if (n.op === NodeOp.pow && Number.isSafeInteger(a ** b)) folded = a ** b
                else if (n.op === NodeOp.lt) folded = a < b ? 1 : 0
                else if (n.op === NodeOp.le) folded = a <= b ? 1 : 0
                else if (n.op === NodeOp.gt) folded = a > b ? 1 : 0
                else if (n.op === NodeOp.ge) folded = a >= b ? 1 : 0
                else if (n.op === NodeOp.eq) folded = a === b ? 1 : 0
                else if (n.op === NodeOp.ne) folded = a !== b ? 1 : 0
                if (n.op === NodeOp.shl && b < 32 && a * 2 ** b <= Number.MAX_SAFE_INTEGER) folded = a * 2 ** b
                else if ((n.op === NodeOp.shr || n.op === NodeOp.ushr) && b < 64) folded = Math.floor(a / 2 ** b)
                const [T, U] = slotTypes(n)
                if (folded !== undefined && Number.isSafeInteger(folded)
                    && (T === Types.u64 || T === Types.u32) && U === T
                    && (T !== Types.u32 || (a <= 0xFFFFFFFF && b <= 0xFFFFFFFF && folded <= 0xFFFFFFFF))) {
                    result = { id: 0, value: folded }
                }
            }
            if (!result && constants.length === 2 && constants.every(arg => !arg.id) && (constants[0].value < 0 || constants[1].value < 0)) result = signedFold(n, constants[0].value, constants[1].value)
            if (!result && constants.length === 2 && constants.every(arg => !arg.id)
                && (n.op === NodeOp.and || n.op === NodeOp.or || n.op === NodeOp.xor)) {
                const [T, U] = slotTypes(n)
                const wide = (T === Types.u64 || T === Types.i64) && (U === Types.u64 || U === Types.i64)
                const narrow = T === Types.u32 && U === T && constants.every(arg => arg.value >= 0 && arg.value <= 0xFFFFFFFF)
                const a = BigInt(constants[0].value), b = BigInt(constants[1].value)
                const bits = BigInt.asIntN(64, n.op === NodeOp.and ? a & b : n.op === NodeOp.or ? a | b : a ^ b)
                const value = Number(bits)
                if ((wide || narrow) && Number.isSafeInteger(value) && BigInt(value) === bits) result = { id: 0, value }
            }
            const floating = typeOf(n) === Types.f64 || comparesFloats(g, n)
            if (!result && !floating && (n.op === NodeOp.eq || n.op === NodeOp.ne) && args.length === 2 && (args[0].id ? !args[1].id && !args[1].value && nonNullAddress(args[0].id) : !args[0].value && nonNullAddress(args[1].id))) {
                result = { id: 0, value: n.op === NodeOp.ne ? 1 : 0 }
            }
            if (!result && !floating && (n.op === NodeOp.eq || n.op === NodeOp.ne)) {
                const same = sameConstants(n)
                if (same !== undefined) result = { id: 0, value: same === (n.op === NodeOp.eq) ? 1 : 0 }
            }
            if (!result && !floating && args.length === 2 && CompareOps.has(n.op)) {
                const side = args[0].id && getNode(g, args[0].id)!.op === NodeOp.select ? 0 : 1
                const other = args[1 - side]
                const conditions: number[] = []
                if (args[side].id && (!other.id || handleOf(other) !== undefined)) result = compareArms(n, side, args[side].id, 0, other, conditions, true, 0)
                if (result) tokens.push(...conditions)
            }
            if (!result && !floating && args.length === 2 && args[0].id && args[0].id === args[1].id) {
                if (n.op === NodeOp.sub || n.op === NodeOp.xor) result = { id: 0, value: 0 }
                else if (n.op === NodeOp.and || n.op === NodeOp.or) result = args[0]
                else if (n.op === NodeOp.eq || n.op === NodeOp.le || n.op === NodeOp.ge) result = { id: 0, value: 1 }
                else if (n.op === NodeOp.ne || n.op === NodeOp.lt || n.op === NodeOp.gt) result = { id: 0, value: 0 }
            }
            if (!result && !floating && args.length === 2 && (n.op === NodeOp.add || n.op === NodeOp.sub) && args[0].id && !args[1].id) result = throughAfter(n, args)
            if (!result && !floating && args.length === 2 && (n.op === NodeOp.add || n.op === NodeOp.sub) && (chained(args[0]) || chained(args[1]))) result = linear(n, args)
            if (!result && !floating && args.length === 2 && CompareOps.has(n.op) && args[0].id && args[1].id) {
                const ranges = currentRanges()
                if (ranges.below(args[0].id, args[1].id, 0, [])) result = { id: 0, value: n.op === NodeOp.lt || n.op === NodeOp.le || n.op === NodeOp.ne ? 1 : 0 }
                else if (ranges.below(args[1].id, args[0].id, 0, [])) result = { id: 0, value: n.op === NodeOp.gt || n.op === NodeOp.ge || n.op === NodeOp.ne ? 1 : 0 }
            }
            if (!result && !floating && args.length === 2 && CompareOps.has(n.op)) {
                const known = decideCompare(n, [args[0].id, args[0].id ? 0 : args[0].value], [args[1].id, args[1].id ? 0 : args[1].value], [])
                if (known !== undefined) result = { id: 0, value: known ? 1 : 0 }
            }
            const integral = (i: number) => operandType(g, n, i) <= Types.i64 || operandType(g, n, i) === Types.bool
            if (!result && args.length === 2 && integral(0) && integral(1)) {
                const left = (value: number) => !args[0].id && args[0].value === value
                const right = (value: number) => !args[1].id && args[1].value === value
                if (n.op === NodeOp.add || n.op === NodeOp.or || n.op === NodeOp.xor) {
                    if (right(0)) result = args[0]
                    else if (left(0)) result = args[1]
                } else if (n.op === NodeOp.sub || n.op === NodeOp.shl || n.op === NodeOp.shr || n.op === NodeOp.ushr) {
                    if (right(0)) result = args[0]
                } else if (n.op === NodeOp.and && (left(0) || right(0))) {
                    const discarded = left(0) ? args[1] : args[0]
                    if (unorderedValue(g, discarded.id, new Map())) result = { id: 0, value: 0 }
                } else if (n.op === NodeOp.mul) {
                    if (right(1)) result = args[0]
                    else if (left(1)) result = args[1]
                } else if (n.op === NodeOp.div && right(1)) result = args[0]
            }
            if (!result) {
                let unchanged = args.length === countIds(n)
                for (let i = 0; unchanged && i < args.length; i++) {
                    const prior = getRef(n, i)
                    if (args[i].id !== prior || (!prior && args[i].value !== getLiteral(g, n, i))) {
                        unchanged = false
                    }
                }
                result = unchanged ? { id, value: 0 }
                    : { id: addCopy(g, n, args.map(arg => arg.id || { literal: arg.value }), n.op), value: 0 }
            }
            if (tokens.length) result = { id: addNode(g, NodeOp.after, [...tokens, result.id || { literal: result.value }]), value: 0 }
            if (result.id !== id) folded.set(id, result)
            return result
        }

        function throughAfter(n: GraphNode, args: Value[]): Value | undefined {
            const a = getNode(g, args[0].id)!
            if (a.op !== NodeOp.after || dependents.get(args[0].id)?.size !== 1) return
            const last = countIds(a) - 1
            const inner = getRef(a, last)
            const m = inner ? getNode(g, inner) : undefined
            if (!m || (m.op !== NodeOp.add && m.op !== NodeOp.sub) || !getRef(m, 0) || getRef(m, 1) || typeOf(m) !== typeOf(n)) return
            if (dependents.get(inner)?.size !== 1) return
            const c = (m.op === NodeOp.add ? 1 : -1) * getLiteral(g, m, 1) + (n.op === NodeOp.add ? 1 : -1) * args[1].value
            if (!Number.isSafeInteger(c)) return
            const sum = c === 0 ? getRef(m, 0) : addCopy(g, n, [getRef(m, 0), { literal: Math.abs(c) }], c > 0 ? NodeOp.add : NodeOp.sub)
            const parts: Operand[] = []
            for (let j = 0; j < last; j++) parts.push(getOperand(g, a, j))
            return { id: addCopy(g, a, [...parts, sum], NodeOp.after), value: 0 }
        }

        function chained(v: Value): boolean {
            const m = v.id ? getNode(g, v.id) : undefined
            return !!m && (m.op === NodeOp.add || m.op === NodeOp.sub) && countIds(m) === 2
        }

        function linear(n: GraphNode, args: Value[]): Value | undefined {
            const terms = new Map<number, number>()
            let constant = 0
            let owned = 0
            let count = 0
            function collect(v: Value, sign: number, depth: number): boolean {
                if (!v.id) {
                    constant += sign * v.value
                    return true
                }
                const m = getNode(g, v.id)
                if (m?.op === NodeOp.literal && inlineableLiteral(costs, literalValue(g, m))) {
                    constant += sign * literalValue(g, m)
                    return true
                }
                if (depth < 4 && m && (m.op === NodeOp.add || m.op === NodeOp.sub) && countIds(m) === 2) {
                    if ((dependents.get(v.id)?.size ?? 0) === 1) owned++
                    return collect({ id: getRef(m, 0), value: getLiteral(g, m, 0) }, sign, depth + 1)
                        && collect({ id: getRef(m, 1), value: getLiteral(g, m, 1) }, m.op === NodeOp.sub ? -sign : sign, depth + 1)
                }
                terms.set(v.id, (terms.get(v.id) ?? 0) + sign)
                return ++count <= 8
            }
            if (!collect(args[0], 1, 0) || !collect(args[1], n.op === NodeOp.sub ? -1 : 1, 0)) return
            if (!Number.isSafeInteger(constant)) return
            const survivors = [...terms].filter(([, c]) => c !== 0)
            if (survivors.some(([, c]) => c !== 1 && c !== -1)) return
            const pos = survivors.filter(([, c]) => c === 1).map(([id]) => id)
            const neg = survivors.filter(([, c]) => c === -1).map(([id]) => id)
            const ops = survivors.length === 0 ? 0 : survivors.length - (pos.length ? 1 : 0) + (constant !== 0 && pos.length ? 1 : 0)
            if (ops >= 1 + owned) return
            if (!survivors.length) return { id: 0, value: constant }
            const combine = (op: NodeOp, a: Value, b: Value): Value =>
                ({ id: addCopy(g, n, [a.id || { literal: a.value }, b.id || { literal: b.value }], op), value: 0 })
            let acc: Value = pos.length ? { id: pos[0], value: 0 } : { id: 0, value: constant }
            for (const id of pos.slice(1)) acc = combine(NodeOp.add, acc, { id, value: 0 })
            for (const id of neg) acc = combine(NodeOp.sub, acc, { id, value: 0 })
            if (pos.length && constant > 0) acc = combine(NodeOp.add, acc, { id: 0, value: constant })
            if (pos.length && constant < 0) acc = combine(NodeOp.sub, acc, { id: 0, value: -constant })
            return acc
        }

        const replacements = new Map<number, number>()
        for (const op of FoldableOps) {
            for (const id of findValues(target.id, op) ?? []) {
                const result = fold(id, getNode(g, id)!)
                if (result.id === id) continue
                replacements.set(id, result.id || insertNode(g, literal(g, result.value)))
            }
        }
        for (const op of [NodeOp.encode, NodeOp.decode]) {
            const inverse = op === NodeOp.encode ? NodeOp.decode : NodeOp.encode
            for (const id of findValues(target.id, op) ?? []) {
                const n = getNode(g, id)!
                const inner = getNode(g, getRef(n, 0))
                if (inner?.op !== inverse || getLiteral(g, inner, 1) !== getLiteral(g, n, 1)) continue
                replacements.set(id, getRef(inner, 0) || insertNode(g, literal(g, getLiteral(g, inner, 0))))
            }
        }
        if (!replacements.size) return false
        target.bodyId = replaceTransitive(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function reduceArg(id: number, subst: Map<number, [number, number]>): [number, number] | undefined {
        const n = getNode(g, id)
        if (!n) return
        if (n.op === NodeOp.param) return subst.get(id)
        if (!countIds(n)) return [id, 0]
        const compare = CompareOps.has(n.op)
        if ((!BinaryOps.has(n.op) && !compare) || operandType(g, n, 0) > Types.i64 || operandType(g, n, 1) > Types.i64) return
        const a = getRef(n, 0) ? reduceArg(getRef(n, 0), subst) : [0, getLiteral(g, n, 0)] as [number, number]
        const b = getRef(n, 1) ? reduceArg(getRef(n, 1), subst) : [0, getLiteral(g, n, 1)] as [number, number]
        if (!a || !b) return
        const is = (v: [number, number], k: number) => !v[0] && v[1] === k
        if (compare) {
            if (a[0] || b[0]) return
            return [0, CompareEval[n.op](a[1], b[1]) ? 1 : 0]
        }
        if (n.op === NodeOp.add || n.op === NodeOp.or || n.op === NodeOp.xor) {
            if (is(a, 0)) return b
            if (is(b, 0)) return a
        }
        if (n.op === NodeOp.sub || n.op === NodeOp.shl || n.op === NodeOp.shr || n.op === NodeOp.ushr) {
            if (is(b, 0)) return a
        }
        if (n.op === NodeOp.mul && is(a, 1)) return b
        if ((n.op === NodeOp.mul || n.op === NodeOp.div) && is(b, 1)) return a
        return
    }

    function reduceBody(id: number, subst: Map<number, [number, number]>): GraphNode | undefined {
        const n = getNode(g, id)
        if (!n) return
        if (n.op === NodeOp.select) {
            const c = getRef(n, 0)
                ? reduceArg(getRef(n, 0), subst)
                : [0, getLiteral(g, n, 0)] as [number, number]
            if (!c || c[0]) return
            return reduceBody(getRef(n, c[1] ? 1 : 2), subst)
        }
        return n.op === NodeOp.apply ? n : undefined
    }

    function substituteEqualArguments(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const sites = findInboundApplies(target).map(([, app]) => getNode(g, app)!)
        if (!sites.length) return false
        const slotsByOp = new Map<NodeOp, number[]>()
        for (let slot = 1; slot <= target.params.length; slot++) {
            const arg = getRef(sites[0], slot)
            const u = arg ? getNode(g, arg) : undefined
            if (!u || u.op === NodeOp.param || isArgless(u)) continue
            const list = slotsByOp.get(u.op)
            if (list) list.push(slot)
            else slotsByOp.set(u.op, [slot])
        }
        if (!slotsByOp.size) return false
        const slotOf = new Map<number, number>()
        for (let i = 0; i < target.params.length; i++) slotOf.set(target.params[i], i + 1)
        function closed(n: GraphNode): boolean {
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref || slotOf.has(ref)) continue
                const operand = getNode(g, ref)!
                for (let j = 0; j < countIds(operand); j++) if (getRef(operand, j)) return false
            }
            return true
        }
        const candidates = new Set<number>()
        for (const [op, ids] of byOp.get(target.id) ?? []) {
            if (!slotsByOp.has(op)) continue
            for (const id of ids) {
                const n = getNode(g, id)
                if (!n || isArgless(n) || !closed(n)) continue
                if (isUnordered(op === NodeOp.load ? getRef(n, 0) : id)) candidates.add(id)
            }
        }
        if (!candidates.size) return false
        function imageOf(n: GraphNode, site: GraphNode, arg: GraphNode): boolean {
            if (arg.op !== n.op || (arg.flags & ~gn.NodeFlags.guarded) !== (n.flags & ~gn.NodeFlags.guarded) || countIds(arg) !== countIds(n)) return false
            if (typeSlots(n.op) && (typeOf(arg) !== typeOf(n) || typeRefOf(arg) !== typeRefOf(n))) return false
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                const slot = ref ? slotOf.get(ref) : undefined
                const expected = slot === undefined ? ref : getRef(site, slot)
                if (getRef(arg, i) !== expected) return false
                if (!expected && getLiteral(g, arg, i) !== (slot === undefined ? getLiteral(g, n, i) : getLiteral(g, site, slot))) return false
            }
            return true
        }
        const replacements = new Map<number, number>()
        for (const id of candidates) {
            const n = getNode(g, id)!
            let options: number[] | undefined = slotsByOp.get(n.op)
            if (!options) continue
            for (const site of sites) {
                const fits: number[] = []
                for (const slot of options) {
                    const arg = getRef(site, slot)
                    if (arg && imageOf(n, site, getNode(g, arg)!)) fits.push(slot)
                }
                options = fits
                if (!fits.length) break
            }
            if (options?.length) replacements.set(id, target.params[options[0] - 1])
        }
        if (!replacements.size) return false
        target.bodyId = replaceAll(target.bodyId, replacements)
        revisitBlock(target)
        return true
    }

    function specializeApplySite(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const tail = getNode(g, target.bodyId)
        if (!tail || (tail.op !== NodeOp.apply && tail.op !== NodeOp.select)) return false
        const inbound = findInboundApplies(target)
        if (inbound.length < 2) return false
        const byBlock = new Map<number, Map<number, number>>()
        for (const [blockId, appId] of inbound) {
            const app = getNode(g, appId)!
            if (countIds(app) !== target.params.length + 1) continue
            const subst = new Map<number, [number, number]>()
            let literal = false
            for (let i = 0; i < target.params.length; i++) {
                if (!getRef(app, i + 1)) literal = true
                subst.set(target.params[i], [getRef(app, i + 1), getLiteral(g, app, i + 1)])
            }
            if (!literal) continue
            const body = reduceBody(target.bodyId, subst)
            if (!body || getRef(body, 0) === target.id) continue
            const operands: Operand[] = [getRef(body, 0)]
            let ok = true
            for (let i = 1; i < countIds(body); i++) {
                const arg = getRef(body, i)
                if (!arg) {
                    operands.push({ literal: getLiteral(g, body, i) })
                    continue
                }
                const r = reduceArg(arg, subst)
                if (!r) { ok = false; break }
                operands.push(r[0] || { literal: r[1] })
            }
            if (!ok) continue
            let replacements = byBlock.get(blockId)
            if (!replacements) byBlock.set(blockId, replacements = new Map())
            replacements.set(appId, addCopy(g, app, operands, NodeOp.apply))
        }
        if (!byBlock.size) return false
        for (const [blockId, replacements] of byBlock) {
            const from = getGraphBlock(blockId)
            from.bodyId = replaceAll(from.bodyId, replacements)
            revisitBlock(from)
        }
        return true
    }

    function specializeBlockParameters(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const specialized = new Map<number, number>()
        const literals = new Map<number, number>()

        function literalFor(value: number) {
            const known = literals.get(value)
            if (known !== undefined) return known
            const id = addNode(g, NodeOp.literal, [{ literal: value }])
            literals.set(value, id)
            return id
        }

        for (let i = 0; i < target.params.length; i++) {
            const values: ({ id: number, value: number, constant: boolean })[] = []
            let valid = true
            for (const [, appId] of inbound) {
                const app = getNode(g, appId)!
                if (countIds(app) !== target.params.length + 1) {
                    valid = false
                    break
                }
                if (getRef(app, i + 1) === target.params[i]) continue
                const constant = constantOf(app, i + 1)
                if (constant !== undefined) values.push({ id: 0, value: constant, constant: true })
                else if (rematerializable(getRef(app, i + 1))) values.push({ id: getRef(app, i + 1), value: 0, constant: true })
                else values.push({ id: getRef(app, i + 1), value: getLiteral(g, app, i + 1), constant: false })
            }
            if (!valid || !values.length) continue
            const first = values[0]
            if (first.constant) {
                if (first.id) {
                    const key = nodeKey(g, getNode(g, first.id)!)
                    if (!values.every(value => value.constant && value.id && nodeKey(g, getNode(g, value.id)!) === key)) continue
                    specialized.set(target.params[i], addCopy(g, getNode(g, first.id)!))
                } else {
                    if (!values.every(value => value.constant && !value.id && value.value === first.value)) continue
                    specialized.set(target.params[i], literalFor(first.value))
                }
                continue
            }
            // if (!first.id || !values.every(value => !value.constant && value.id === first.id)
            //     || target.params.includes(first.id) || !isUnordered(first.id)) continue
            // specialized.set(target.params[i], first.id)
        }
        if (!specialized.size) return false

        const removed = new Set(specialized.keys())
        for (const [param, replacement] of specialized) {
            if (removed.has(replacement)) specialized.delete(param)
        }
        if (!specialized.size) return false

        const edits = new Map<GraphBlock, Map<number, number>>()
        const newParams = target.params.filter(param => !specialized.has(param))
        for (const [blockId, appId] of inbound) {
            const app = getNode(g, appId)!
            const operands: Operand[] = [getRef(app, 0)]
            for (let i = 0; i < target.params.length; i++) {
                if (!specialized.has(target.params[i])) operands.push(getOperand(g, app, i + 1))
            }
            let replacements = edits.get(getGraphBlock(blockId))
            if (!replacements) edits.set(getGraphBlock(blockId), replacements = new Map())
            replacements.set(appId, addCopy(g, app, operands, NodeOp.apply))
        }

        const changed = new Set<GraphBlock>()
        for (const [block, replacements] of edits) {
            block.bodyId = replaceAll(block.bodyId, replacements)
            changed.add(block)
        }
        target.params = newParams
        target.bodyId = replaceAll(target.bodyId, specialized)
        changed.add(target)
        for (const block of changed) revisitBlock(block)
        return true
    }

    function decodeParams(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        if (!findValues(target.id, NodeOp.decode)?.some(id => getNode(g, getRef(getNode(g, id)!, 0))?.op === NodeOp.param)) return false
        const inbound = findInboundApplies(target)
        if (!inbound.length) return false
        const decoded = new Map<number, number>()
        const bases = new Map<number, number>()
        for (let i = 0; i < target.params.length; i++) {
            const param = target.params[i]
            let base: number | undefined
            let first = 0
            let valid = true
            for (const [, appId] of inbound) {
                const app = getNode(g, appId)!
                if (countIds(app) !== target.params.length + 1) {
                    valid = false
                    break
                }
                const arg = getRef(app, i + 1)
                if (arg === param) continue
                if (!arg) {
                    if (getLiteral(g, app, i + 1) !== 0) valid = false
                    continue
                }
                const n = getNode(g, arg)
                if (n?.op !== NodeOp.encode || getRef(n, 1) || (base !== undefined && getLiteral(g, n, 1) !== base)) {
                    valid = false
                    break
                }
                base = getLiteral(g, n, 1)
                first ||= getRef(n, 0)
            }
            if (!valid || !first) continue
            const decodes = [...dependents.get(param) ?? []].some(u => {
                const n = getNode(g, u)
                return n?.op === NodeOp.decode && getRef(n, 0) === param && getLiteral(g, n, 1) === base
            })
            if (!decodes) continue
            decoded.set(param, paramLike(first))
            bases.set(param, base!)
        }
        if (!decoded.size) return false
        const edits = new Map<GraphBlock, Map<number, number>>()
        for (const [blockId, appId] of inbound) {
            const app = getNode(g, appId)!
            const operands = getOperands(g, app)
            for (let i = 0; i < target.params.length; i++) {
                const pointer = decoded.get(target.params[i])
                if (pointer === undefined) continue
                const arg = getRef(app, i + 1)
                operands.push(arg === target.params[i] ? pointer : arg ? getOperand(g, getNode(g, arg)!, 0) : { literal: 0 })
            }
            let replacements = edits.get(getGraphBlock(blockId))
            if (!replacements) edits.set(getGraphBlock(blockId), replacements = new Map())
            replacements.set(appId, addCopy(g, app, operands, NodeOp.apply))
        }
        target.params.push(...decoded.values())
        let own = edits.get(target)
        if (!own) edits.set(target, own = new Map())
        for (const [param, pointer] of decoded) {
            for (const u of dependents.get(param) ?? []) {
                const n = getNode(g, u)
                if (n?.op === NodeOp.decode && getRef(n, 0) === param && getLiteral(g, n, 1) === bases.get(param)) own.set(u, pointer)
            }
            own.set(param, addNode(g, NodeOp.encode, [pointer, { literal: bases.get(param)! }]))
        }
        for (const [block, replacements] of edits) {
            block.bodyId = replaceAll(block.bodyId, replacements)
            revisitBlock(block)
        }
        return true
    }

    function liftBlockSelect(target: GraphBlock) {
        if (target === g.blocks[0] || !target.params.length) return false
        const tail = getNode(g, target.bodyId)
        if (!tail || tail.op !== NodeOp.select || countIds(tail) !== 3) return false
        const at = target.params.indexOf(getRef(tail, 0))
        if (at < 0) return false

        const inbound = findInboundApplies(target)
        if (inbound.length !== 2 || inbound[0][1] === inbound[1][1]) return false

        let free = -1
        let arm = 0
        let literal = 0
        for (let i = 0; i < 2; i++) {
            const app = getNode(g, inbound[i][1])!
            if (countIds(app) !== target.params.length + 1) return false
            const c = constantOf(app, at + 1)
            if (c === undefined) {
                if (free >= 0) return false
                free = i
                continue
            }
            if (arm) return false
            literal = c
            arm = c ? 1 : 2
        }
        if (free < 0 || !arm) return false
        if (!getRef(tail, arm)) return false

        const exclusiveId = getRef(tail, arm === 1 ? 2 : 1)
        const ex = exclusiveId ? getNode(g, exclusiveId) : undefined
        if (!ex || ex.op === NodeOp.param || ex.op === NodeOp.block || ex.op === NodeOp.literal) return false
        if (dependents.get(exclusiveId)?.size !== 1) return false

        const [callerId, freeId] = inbound[free]
        const freeApp = getNode(g, freeId)!
        const liftedOperands = getOperands(g, ex)
        let coded = false
        for (let i = 0; i < liftedOperands.length; i++) {
            const r = getRef(ex, i)
            if (!r) continue
            const op = getNode(g, r)?.op
            if (op === NodeOp.block || op === NodeOp.nilEffect || op === NodeOp.void) continue
            const slot = target.params.indexOf(r)
            if (slot < 0) {
                coded = true
                break
            }
            liftedOperands[i] = getOperand(g, freeApp, slot + 1)
        }
        let lifted: number
        if (coded) {
            const path = applicationPaths(getGraphBlock(callerId), target.id).find(p => p[p.length - 1] === freeId)
            const merged = path ? inlineApplication(path, target, exclusiveId) : undefined
            if (merged === undefined) return false
            lifted = merged
        } else {
            lifted = addCopy(g, ex, liftedOperands, ex.op)
        }
        const takenOperands = getOperands(g, freeApp)
        const tested = target.params[at]
        if ([...dependents.get(tested) ?? []].every(u => u === target.bodyId)) takenOperands[at + 1] = { literal }
        const taken = addCopy(g, freeApp, takenOperands, NodeOp.apply)
        const cond = getRef(freeApp, at + 1)
        const pick = addCopy(g, tail, arm === 1 ? [cond, taken, lifted] : [cond, lifted, taken], NodeOp.select)

        target.bodyId = getRef(tail, arm)
        target.bodyConst = getLiteral(g, tail, arm)
        const caller = getGraphBlock(callerId)
        caller.bodyId = replaceAll(caller.bodyId, new Map([[freeId, pick]]))
        revisitBlock(target)
        if (caller !== target) revisitBlock(caller)
        return true
    }

    function shifted(id: number): boolean {
        const n = id ? getNode(g, id) : undefined
        return (n?.op === NodeOp.shl || n?.op === NodeOp.shr || n?.op === NodeOp.ushr) && !getRef(n, 1)
    }
    function normalizeCommutative(b: GraphBlock) {
        let changed = false
        for (const op of Commutative) {
            const ids = findValues(b.id, op)
            if (!ids) continue
            for (const id of ids) {
                const n = getNode(g, id)
                if (!n || n.op !== op || countIds(n) !== 2) continue
                const literalLeft = !getRef(n, 0) && !!getRef(n, 1)
                const shiftLeft = shifted(getRef(n, 0)) && !shifted(getRef(n, 1)) && !!getRef(n, 1)
                if (!literalLeft && !shiftLeft) continue
                gn.swapBinaryOperands(n)
                changed = true
            }
        }
        if (changed) revisitBlock(b)
        return changed
    }

    function foldLiterals(b: GraphBlock) {
        const literals = findValues(b.id, NodeOp.literal)
        if (!literals) return
        let changed = false
        for (const id of literals) {
            const u = getNode(g, id)!
            const value = literalValue(g, u)
            const wide = !inlineableLiteral(costs, value)
            const uses = dependents.get(id) ?? []
            for (const x of uses) {
                const n = getNode(g, x)!
                const ids = getArgIds(n)
                for (let slot = 0; slot < ids.length; slot++) {
                    if (ids[slot] !== id) continue
                    if (wide && liftableSlot(n.op, slot)) continue
                    setLiteral(g, n, slot, value)
                    changed = true
                }
            }
        }
        if (changed) revisitBlock(b)
        return changed
    }

    function liftLiterals(b: GraphBlock) {
        const ops = byOp.get(b.id)
        if (!ops) return false
        const counts = new Map<number, number>()
        const visit = (fn: (n: GraphNode, op: NodeOp, slot: number, value: f64) => void) => {
            for (const [op, ids] of ops) {
                if (op === NodeOp.literal) continue
                for (const id of ids) {
                    const n = getNode(g, id)!
                    const arity = countIds(n)
                    for (let slot = 0; slot < arity; slot++) {
                        if (getRef(n, slot)) continue
                        const value = getLiteral(g, n, slot)
                        if (inlineableLiteral(costs, value) || !liftableSlot(op, slot)) continue
                        fn(n, op, slot, value)
                    }
                }
            }
        }
        visit((n, op, slot, value) => counts.set(value, (counts.get(value) ?? 0) + 1))
        if (![...counts.values()].some(c => c >= 2)) return false
        const made = new Map<number, number>()
        visit((n, op, slot, value) => {
            if ((counts.get(value) ?? 0) < 2) return
            let lifted = made.get(value)
            if (lifted === undefined) {
                made.set(value, lifted = addNode(g, NodeOp.literal, [{ literal: value }]))
            }
            setRef(n, slot, lifted)
        })
        if (made.size === 0) return false
        revisitBlock(b)
        return true
    }

    interface ClosureTerm {
        param?: number
        node?: GraphNode
        args: number[]
        head: string
    }
    const closureTerms = new Map<number, ClosureTerm>()
    const closureTermIds = new Map<string, number>()
    let nextClosureTerm = 1
    function internClosureTerm(key: string, term: ClosureTerm): number {
        const known = closureTermIds.get(key)
        if (known !== undefined) return known
        const id = nextClosureTerm++
        closureTermIds.set(key, id)
        closureTerms.set(id, term)
        return id
    }
    function paramClosureTerm(param: number): number {
        return internClosureTerm(`p${param}`, { param, args: [], head: `p${param}` })
    }
    function constantClosureTerm(value: number): number {
        const key = `c${value}`
        return internClosureTerm(key, { args: [], head: key })
    }
    function opaqueClosureTerm(value: number): number {
        return internClosureTerm(`o${value}`, { args: [], head: `o${value}` })
    }
    function nodeClosureTerm(n: GraphNode, args: number[]): number {
        const key = `n${nodeKey(g, n, args, true)}`
        const headArgs = args.map(x => x ? 1 : 0)
        const head = nodeKey(g, n, headArgs, true)
        return internClosureTerm(key, { node: n, args, head })
    }

    function closuresOf(b: GraphBlock): BlockClosureInfo {
        if (const known = blockClosureInfo.get(b.id)) return known
        const values = new Set<number>(b.params)
        for (const ids of byOp.get(b.id)?.values() ?? []) {
            for (const id of ids) if (isUnordered(id)) values.add(id)
        }
        const supportOf = new Map<number, number[]>()
        for (const p of b.params) {
            supportOf.set(p, [p])
        }
        function support(id: number): number[] {
            const n = getNode(g, id)!
            if (n.op === NodeOp.param) return supportOf.get(id)!
            if (!isUnordered(id)) return []
            const argIds = getArgIds(n).filter(x => x > 0)
            if (!argIds.length) return []
            if (argIds.length === 1) return support(argIds[0])
            if (const known = supportOf.get(id)) return known
            const result: number[] = []
            supportOf.set(id, result)
            const seen = new Set<number>()
            for (const arg of argIds) for (const p of support(arg)) seen.add(p)
            for (const p of seen) result.push(p)
            return result
        }
        const termOf = new Map<number, number>()
        function term(id: number): number {
            const known = termOf.get(id)
            if (known !== undefined) return known
            const n = getNode(g, id)
            assert(n)
            let result: number
            if (n.op === NodeOp.param) result = paramClosureTerm(id)
            else if (n.op === NodeOp.literal) result = constantClosureTerm(literalValue(g, n))
            else if (!isUnordered(id)) result = opaqueClosureTerm(id)
            else result = nodeClosureTerm(n, getArgIds(n).map(arg => arg ? term(arg) : 0))
            termOf.set(id, result)
            return result
        }
        for (const id of values) { support(id); term(id) }

        const groups = new Map<string, number[]>()
        for (const id of values) {
            const key = support(id).join(',')
            let group = groups.get(key)
            if (!group) groups.set(key, group = [])
            group.push(id)
        }
        const closures: ArityClosure[] = []
        for (const group of groups.values()) {
            const members = new Set(group)
            const parent = new Map<number, number>()
            function root(id: number): number {
                if (const p = parent.get(id)) {
                    const r = root(p)
                    parent.set(id, r)
                    return r
                }
                return id
            }
            function join(a: number, c: number): void {
                const x = root(a)
                const y = root(c)
                if (x !== y) parent.set(y, x)
            }
            for (const id of group) {
                if (!id) continue
                const n = getNode(g, id)!
                for (const arg of getArgIds(n)) {
                    if (!arg) continue
                    if (members.has(arg)) join(id, arg)
                }
            }
            const byRoot = new Map<number, number[]>()
            for (const id of group) {
                const r = root(id)
                let component = byRoot.get(r)
                if (!component) byRoot.set(r, component = [])
                component.push(id)
            }
            for (const component of byRoot.values()) {
                closures.push({ id: -1, support: support(component[0]), values: component, inputs: [] })
            }
        }
        closures.sort((a, c) => a.support.length - c.support.length
            || a.support.map(x => b.params.indexOf(x)).join(',').localeCompare(c.support.map(x => b.params.indexOf(x)).join(','))
            || a.values[0] - c.values[0])
        const closureOf = new Map<number, number>()
        const byParam = new Map<number, number[]>()
        const bySupport = new Map<string, number[]>()
        for (let i = 0; i < closures.length; i++) {
            const closure = closures[i]
            closure.id = i
            for (const value of closure.values) closureOf.set(value, i)
            for (const param of closure.support) {
                let arr = byParam.get(param)
                if (!arr) byParam.set(param, arr = [])
                arr.push(i)
            }
            const key = closure.support.join(',')
            let arr = bySupport.get(key)
            if (!arr) bySupport.set(key, arr = [])
            arr.push(i)
        }
        for (const closure of closures) {
            const inputs = new Set<number>()
            for (const id of closure.values) {
                const n = getNode(g, id)!
                for (const arg of getArgIds(n)) {
                    if (!arg) continue
                    const input = closureOf.get(arg)
                    if (input !== undefined && input !== closure.id) inputs.add(input)
                }
            }
            closure.inputs = [...inputs].sort((a, c) => a - c)
        }
        const info = { block: b, termOf, term, closures, closureOf, byParam, bySupport }
        blockClosureInfo.set(b.id, info)
        return info
    }

    function dumpArityClosures(): string {
        const lines = [`--- arity closures for ${g.name ?? '<graph>'} ---`]
        for (const b of reachableBlocks) {
            const info = closuresOf(b)
            lines.push(`B${b.id}(${b.params.map(x => `%${x}`).join(', ')})`)
            for (const closure of info.closures) {
                const params = closure.support.map(x => `%${x}`).join(', ')
                const from = closure.inputs.map(x => `C${x}`).join(', ')
                const body = closure.values.map(id => `%${id}=${opName(getNode(g, id)!.op)}`).join(' ')
                lines.push(`  C${closure.id}/${closure.support.length} {${params}}${from ? ` <- ${from}` : ''}: ${body}`)
            }
            const roots = new Set<number>()
            const seen = new Set<number>()
            function collect(id: number): void {
                if (!id || seen.has(id)) return
                seen.add(id)
                const closure = info.closureOf.get(id)
                if (closure !== undefined) { roots.add(closure); return }
                const n = getNode(g, id)
                if (n) for (const arg of getArgIds(n)) collect(arg)
            }
            collect(b.bodyId)
            const from = [...roots].sort((a, c) => a - c).map(x => `C${x}`).join(', ')
            lines.push(`  block/${b.params.length} {${b.params.map(x => `%${x}`).join(', ')}}${from ? ` <- ${from}` : ''}`)
        }
        return lines.join('\n')
    }



    function forwardCongruentValues(): boolean {
        const entry = g.blocks[0]
        let candidates = false
        for (const b of reachableBlocks) {
            if (b !== entry && b.params.length) { candidates = true; break }
        }
        if (!candidates) return false

        const order: GraphBlock[] = []
        const position = new Map<number, number>()
        function place(b: GraphBlock): void {
            position.set(b.id, -1)
            for (const s of successors.get(b.id) ?? []) {
                if (!position.has(s)) place(getGraphBlock(s))
            }
            order.push(b)
        }
        place(entry)
        order.reverse()
        for (let i = 0; i < order.length; i++) position.set(order[i].id, i)

        const inbound = new Map<number, [blockId: number, valId: number][]>()
        const forwardable = new Set<number>()
        for (const b of order) {
            if (b === entry || !b.params.length) continue
            const applies = findInboundApplies(b)
            if (!applies.length) continue
            inbound.set(b.id, applies)
            for (let i = 0; i < b.params.length; i++) {
                let unordered = true
                for (const [, id] of applies) {
                    const arg = getRef(getNode(g, id)!, i + 1)
                    if (arg && !isUnordered(arg)) { unordered = false; break }
                }
                if (unordered) forwardable.add(b.params[i])
            }
        }
        if (!inbound.size) return false

        const unsigned = (T: number) => T <= Types.u64 || T === Types.bool || T === Types.ptr || (T >= Types.u1 && T <= Types.u31)
        function interpretation(b: GraphBlock, i: number): string {
            const p = getNode(g, b.params[i])!
            if (typeRefOf(p)) return `t%${typeRefOf(p)}`
            const T = typeOf(p)
            if (!unsigned(T)) return `t${T}`
            const bits = intrinsics.intrinsicBitWidth(T)
            for (const [, id] of inbound.get(b.id)!) {
                const app = getNode(g, id)!
                const arg = getRef(app, i + 1)
                if (arg === b.params[i]) continue
                const value = getLiteral(g, app, i + 1)
                if (!arg && (value < 0 || value >= 2 ** bits)) return `t${T}`
                if (!arg) continue
                const A = resultType(g, getNode(g, arg)!)
                if (!unsigned(A) || intrinsics.intrinsicBitWidth(A) > bits) return `t${T}`
            }
            return 'uint'
        }
        const interpretations = new Map<number, string>()
        function interpretationOf(b: GraphBlock, i: number): string {
            let known = interpretations.get(b.params[i])
            if (known === undefined) interpretations.set(b.params[i], known = interpretation(b, i))
            return known
        }

        const literals = new Map<number, number>()
        const literalValues: number[] = []
        const classes = new Map<number, number>()
        const table = new Map<string, number>()
        const numbered = new Set<number>()
        const insertedKeys: string[] = []
        const numberedIds: number[] = []
        function intern(key: string, id: number): number {
            const rep = table.get(key)
            if (rep !== undefined) return rep
            table.set(key, id)
            insertedKeys.push(key)
            return id
        }
        function number(id: number, b: GraphBlock): number {
            if (!id) return 0
            const n = getNode(g, id)!
            if (n.op === NodeOp.param) return classes.get(id) ?? id
            if (n.op === NodeOp.block) return id
            if (numbered.has(id)) return classes.get(id)!
            numbered.add(id)
            numberedIds.push(id)
            const args = getArgIds(n)
            for (let i = 0; i < args.length; i++) args[i] = number(args[i], b)
            const key = nodeKey(g, n, args)
            const rep = intern(allocates(g, n) ? `allocation:${id}` : isUnordered(id) ? key : `${b.id}|${key}`, id)
            classes.set(id, rep)
            return rep
        }

        const backReads: number[] = []
        const forwarded = new Set<number>()
        function classifyBlock(b: GraphBlock): void {
            const applies = inbound.get(b.id)
            const at = position.get(b.id)!
            for (let i = 0; applies && i < b.params.length; i++) {
                const p = b.params[i]
                const own = classes.get(p) ?? 0
                const arrivals: number[] = []
                let forward = forwardable.has(p)
                let common = 0
                let usedOwn = false
                for (const [from, appId] of applies) {
                    const app = getNode(g, appId)!
                    const arg = getRef(app, i + 1)
                    let c = 0
                    let back = false
                    if (!arg) {
                        const value = getLiteral(g, app, i + 1)
                        c = literals.get(value) ?? 0
                        if (!c) {
                            literals.set(value, c = -1 - literalValues.length)
                            literalValues.push(value)
                        }
                    } else if ((position.get(from) ?? at) < at || isArgless(getNode(g, arg)!)) {
                        c = number(arg, getGraphBlock(from))
                    } else {
                        c = classes.get(arg) ?? 0
                        if (position.has(from)) backReads.push(arg, c, p)
                        back = true
                    }
                    arrivals.push(c)
                    if (!forward || !c) continue
                    if (back && c === own) { usedOwn = true; continue }
                    if (!common) common = c
                    else if (common !== c) forward = false
                }
                if (forward && (common || usedOwn)) {
                    forwarded.add(p)
                    classes.set(p, common || own)
                    continue
                }
                classes.set(p, intern(`${b.id}:${interpretationOf(b, i)}|${arrivals.join(',')}`, p))
            }
            for (const appId of findValues(b.id, NodeOp.apply) ?? []) {
                const app = getNode(g, appId)!
                for (let i = 1; i < countIds(app); i++) number(getRef(app, i), b)
            }
        }

        const spanEnd: number[] = []
        for (let i = 0; i < order.length; i++) spanEnd.push(-1)
        for (let i = 0; i < order.length; i++) {
            for (const s of successors.get(order[i].id) ?? []) {
                const t = position.get(s)!
                if (t <= i && spanEnd[t] < i) spanEnd[t] = i
            }
        }
        let start = 0
        while (start < order.length) {
            let end = spanEnd[start]
            if (end < 0) {
                classifyBlock(order[start++])
                continue
            }
            for (let i = start + 1; i <= end; i++) if (spanEnd[i] > end) end = spanEnd[i]
            const keyMark = insertedKeys.length
            const idMark = numberedIds.length
            let rounds = 0
            while (true) {
                backReads.length = 0
                forwarded.clear()
                for (let i = start; i <= end; i++) classifyBlock(order[i])
                let settled = true
                for (let i = 0; settled && i < backReads.length; i += 3) {
                    const actual = classes.get(backReads[i]) ?? 0
                    const p = backReads[i + 2]
                    settled = forwarded.has(p) ? !actual || actual === classes.get(p) : actual === backReads[i + 1]
                }
                if (settled) break
                rounds++
                assert(rounds <= backReads.length / 3 + 1, `forwardCongruentValues: span B${order[start].id}..B${order[end].id} did not settle after ${rounds} rounds`)
                while (insertedKeys.length > keyMark) table.delete(insertedKeys.pop()!)
                while (numberedIds.length > idMark) numbered.delete(numberedIds.pop()!)
            }
            start = end + 1
        }

        function valueClass(c: number): boolean {
            return c > 0 && getNode(g, c)!.op !== NodeOp.param && !rematerializable(c)
        }
        const edits = new Map<GraphBlock, Map<number, number>>()
        function editsOf(b: GraphBlock): Map<number, number> {
            let m = edits.get(b)
            if (!m) edits.set(b, m = new Map())
            return m
        }
        const survivors = new Map<number, Map<number, number>>()
        for (const b of order) {
            if (!inbound.has(b.id)) continue
            const first = new Map<number, number>()
            let grouped: Map<string, number> | undefined
            for (let i = 0; i < b.params.length; i++) {
                const p = b.params[i]
                const c = classes.get(p)!
                if (c < 0) {
                    editsOf(b).set(p, addNode(g, NodeOp.literal, [{ literal: literalValues[-1 - c] }]))
                    continue
                }
                if (getNode(g, c)!.op !== NodeOp.param && rematerializable(c)) {
                    editsOf(b).set(p, addCopy(g, getNode(g, c)!))
                    continue
                }
                const earlier = first.get(c)
                if (earlier === undefined) {
                    first.set(c, p)
                    continue
                }
                grouped ??= new Map()
                const seed = `${c}|${interpretationOf(b, b.params.indexOf(earlier))}`
                if (!grouped.has(seed)) grouped.set(seed, earlier)
                const key = `${c}|${interpretationOf(b, i)}`
                const rep = grouped.get(key)
                if (rep === undefined) grouped.set(key, p)
                else editsOf(b).set(p, rep)
            }
            survivors.set(b.id, first)
        }

        const dependent = new Map<number, boolean>()
        function dependsOnParam(id: number): boolean {
            const known = dependent.get(id)
            if (known !== undefined) return known
            const n = getNode(g, id)!
            let result = n.op === NodeOp.param
            for (let i = 0; !result && i < countIds(n); i++) {
                const u = operandEdge(n, i)
                if (u && dependsOnParam(u)) result = true
            }
            dependent.set(id, result)
            return result
        }
        const appended = new Map<number, [from: GraphBlock, args: number[]]>()
        for (const target of order) {
            const applies = inbound.get(target.id)
            if (!applies) continue
            const own = survivors.get(target.id)!
            const ops = new Set<NodeOp>()
            for (const c of own.keys()) if (valueClass(c)) ops.add(getNode(g, c)!.op)
            let shared = new Set<number>()
            for (let k = 0; k < applies.length; k++) {
                const passed = survivors.get(applies[k][0])
                const next = new Set<number>()
                for (const c of passed?.keys() ?? []) {
                    if ((k ? shared.has(c) : valueClass(c) && !own.has(c))) next.add(c)
                }
                shared = next
                if (!shared.size) break
            }
            for (const c of shared) ops.add(getNode(g, c)!.op)
            const fresh = new Map<number, number>()
            for (const op of ops) {
                for (const id of findValues(target.id, op) ?? []) {
                    const n = getNode(g, id)
                    if (!n || !countIds(n) || !isUnordered(id) || !dependsOnParam(id)) continue
                    const c = number(id, target)
                    const p = own.get(c)
                    if (p !== undefined) {
                        editsOf(target).set(id, p)
                        continue
                    }
                    if (!shared.has(c)) continue
                    let replacement = fresh.get(c)
                    if (replacement === undefined) {
                        fresh.set(c, replacement = paramLike(id))
                        target.params.push(replacement)
                        for (const [blockId, appId] of applies) {
                            let extra = appended.get(appId)
                            if (!extra) appended.set(appId, extra = [getGraphBlock(blockId), []])
                            extra[1].push(survivors.get(blockId)!.get(c)!)
                        }
                    }
                    editsOf(target).set(id, replacement)
                }
            }
        }
        for (const [appId, [from, extra]] of appended) {
            const app = getNode(g, appId)!
            const replacements = editsOf(from)
            const extended = addCopy(g, app, [...getOperands(g, app), ...extra], NodeOp.apply)
            replacements.set(appId, replaceAll(extended, replacements))
        }

        let changed = false
        for (const [b, replacements] of edits) {
            const bodyId = replaceAll(b.bodyId, replacements)
            if (bodyId === b.bodyId) continue
            b.bodyId = bodyId
            revisitBlock(b)
            changed = true
        }
        return changed
    }

    let congruenceEpoch = -1
    function optimize() {
        for (const b of reachableBlocks) {
            step(eliminateUnusedPureValues, b)
        }
        verifySweep()
        for (const b of reachableBlocks) {
            step(stripNilAfters, b)
            step(mergeBlocks, b)
            step(absorbConditions, b)
            step(threadConstantBranches, b)
            step(threadConstantArrivals, b)
            step(threadDecidedArrivals, b)
            step(foldKnownConditions, b)
            step(reduceSelects, b)
            step(forwardMemory, b)
            step(dropUnreadStores, b)
            step(mergeConstantStores, b)
            step(forwardArrivalLoads, b)
            step(forwardArrivalCalls, b)
            step(liftCommonEffects, b)
            step(liftCommonApplications, b)
            step(liftBlockSelect, b)
        }
        verifySweep()
        for (const b of reachableBlocks) {
            step(foldAddresses, b)
            step(deriveIncrementor, b)
            step(widenCountedStores, b)
            if (step(closeCountedLoop, b)) continue
            if (step(unrollSmallLoop, b)) continue
            step(reverseLoop, b)
            if (step(unswitchLoop, b)) continue
            step(hoistInvariants, b)
            step(hoistLoopInvariants, b)
            step(sinkReloadedStores, b)
            step(hoistSharedSelectValues, b)
            if (step(eliminatePassthru, b)) continue
        }
        verifySweep()
        for (const b of reachableBlocks) {
            step(rotateLoop, b)
            step(advanceLoopLoads, b)
            step(foldBooleanSelects, b)
            step(simplifySelect, b)
            step(reduceBlockOrdering, b)
            step(liftAfters, b)
            step(interchangeSelects, b)
        }
        verifySweep()
        const congruenceStart = performance.now()
        const beforeCongruence = graphEpoch
        const congruent = !disabledPasses.has('forwardCongruentValues') && congruenceEpoch !== beforeCongruence && forwardCongruentValues()
        congruenceEpoch = beforeCongruence
        recordPass('forwardCongruentValues', performance.now() - congruenceStart, congruent)
        if (congruent && verifySweeps) sweepChanges.add('forwardCongruentValues')
        verifySweep()
        liveParams = undefined
        for (const b of reachableBlocks) {
            step(rematerializeOffsets, b)
            step(pruneUnusedParams, b)
        }
        verifySweep()
        for (const b of reachableBlocks) {
            step(foldValues, b)
            step(foldLiterals, b)
            step(liftLiterals, b)
            step(normalizeCommutative, b)
            step(specializeBlockParameters, b)
            step(conditionParams, b)
            step(decodeParams, b)
            step(substituteEqualArguments, b)
            step(specializeApplySite, b)
            step(simplifyBitOperations, b)
            step(foldMembershipTests, b)
            step(hoistLoopStep, b)
            step(promoteAllocas, b)
            step(deduplicateValues, b)
        }
        verifySweep()
        for (const b of [...reachableBlocks].reverse()) {
            step(rebaseAddresses, b)
        }
        verifySweep()
        for (const b of reachableBlocks) {
            step(mergeBlocks, b)
            step(liftCommonEffects, b)
            step(foldBooleanSelects, b)
            step(simplifySelect, b)
            step(foldValues, b)
            step(reduceBlockOrdering, b)
            step(reassociateAdds, b)
            step(closeCountedLoop, b)
        }
        verifySweep()
        if (intrinsics.argv().includes('closure-debug')
            || intrinsics.argv().includes(`closure-debug:${g.name}`)) {
            console.log(dumpArityClosures())
        }
    }

    const maxRounds = optimizeRounds || (g.nodes.size < 50 ? 3 : 2)
    if (optimizeTimers) time('(setup)', performance.now() - optimizeStart)
    for (let round = 0; round < maxRounds; round++) {
        const roundStart = performance.now()
        didAnyChange = false
        unswitched = false
        unpromotable.clear()
        optimize()
        if (optimizeTimers) time(`(round ${round})`, performance.now() - roundStart)
        if (!didAnyChange) break
    }
    liveParams = undefined
    for (const b of reachableBlocks) step(pruneUnusedParams, b)
    if (unswitchScan) scanUnswitchCandidates()
    if (!reachableBlocks.size) {
        reachableBlocks.add(g.blocks[0])
        g.blocks[0].bodyId = unreachable()
    }
    setGraphBlocks(g, [...reachableBlocks])
    sweepBlocks(g)
    if (optimizeTimers) time('(total)', performance.now() - optimizeStart)
    return g
}

export interface SignatureHomes {
    volatiles: number[]
    preserved: number[]
    safeFor: (v: number) => number[]
    rank: (safe: number[]) => number[]
    arrival: number[]
    argHome: (call: number, index: number) => number
    ret: (field: number) => number
    project: (call: number, field: number) => number
    overflow: () => number
    accepts: (value: number, register: number) => boolean
}

function projectsCall(g: Graph, id: number): boolean {
    const n = getNode(g, id)
    return n?.op === NodeOp.get && !getRef(n, 1) && getNode(g, getRef(n, 0))?.op === NodeOp.call
}

export function assignBlockSignatures(
    g: Graph,
    crossing: Map<number, number>,
    inArgPos: Map<number, [parent: number, idx: number][]>,
    inStatePos: Map<number, [parent: number, idx: number][]>,
    applyOwner: Map<number, number>,
    homes: SignatureHomes,
): Map<number, number[]> {
    const owner = new Map<number, number>()
    const parent = new Map<number, number>()
    const occupies = new Map<number, Set<number>>()
    const wants = new Map<number, number[]>()
    for (const b of g.blocks) {
        for (const p of b.params) {
            owner.set(p, b.id)
            parent.set(p, p)
            occupies.set(p, new Set([b.id]))
        }
    }
    function find(x: number): number {
        let r = x
        while (parent.get(r) !== r) r = parent.get(r)!
        let at = x
        while (parent.get(at) !== r) {
            const next = parent.get(at)!
            parent.set(at, r)
            at = next
        }
        return r
    }
    function prefer(p: number, home: number): void {
        if (home < 0 || !owner.has(p)) return
        const list = wants.get(p)
        if (!list) wants.set(p, [home])
        else if (!list.includes(home)) list.push(home)
    }
    g.blocks[0].params.forEach((p, i) => prefer(p, homes.arrival[i]))
    for (const [p, positions] of inStatePos) {
        for (const at of positions) if (at[1] < 0) prefer(p, homes.ret(-1 - at[1]))
    }
    for (const [v, positions] of inArgPos) {
        for (const at of positions) if (getNode(g, at[0])?.op === NodeOp.call) prefer(v, homes.argHome(at[0], at[1]))
    }
    const edges: [from: number, to: number, weight: number][] = []
    const edgeAt = new Map<string, number>()
    const arrivals = new Map<number, number[]>()
    const settled = new Map<number, boolean>()
    for (const [app, from] of applyOwner) {
        const n = getNode(g, app)
        const into = n ? getBlock(g, getRef(n, 0)) : undefined
        if (!n || !into) continue
        for (let i = 0; i < into.params.length; i++) {
            const q = into.params[i]
            const a = getRef(n, i + 1)
            settled.set(q, (settled.get(q) ?? true) && crossing.has(a))
            if (!a) continue
            if (owner.has(a)) {
                if (a === q) continue
                const key = `${a}:${q}`
                const weight = getRef(n, 0) === from ? 2 : 1
                const at = edgeAt.get(key)
                if (at === undefined) {
                    edgeAt.set(key, edges.length)
                    edges.push([a, q, weight])
                } else edges[at][2] += weight
            } else if (crossing.has(a)) {
                arrivals.set(q, [...arrivals.get(q) ?? [], a])
            } else if (getNode(g, a)?.op === NodeOp.call) {
                prefer(q, homes.ret(0))
            } else if (projectsCall(g, a)) {
                prefer(q, homes.project(getRef(getNode(g, a)!, 0), getLiteral(g, getNode(g, a)!, 1)))
            }
        }
    }
    edges.sort((a, b) => b[2] - a[2])
    for (const [from, to] of edges) {
        const a = find(from)
        const b = find(to)
        if (sigStats) sigStats.edges++
        if (a === b) continue
        const left = occupies.get(a)!
        const right = occupies.get(b)!
        let clash = false
        for (const id of right) if (left.has(id)) { clash = true; break }
        if (clash) { if (sigStats) sigStats.edgesBlocked++; continue }
        parent.set(b, a)
        for (const id of right) left.add(id)
        occupies.delete(b)
        wants.set(a, [...wants.get(a) ?? [], ...wants.get(b) ?? []])
    }
    const members = new Map<number, number[]>()
    for (const p of owner.keys()) {
        const root = find(p)
        const list = members.get(root)
        if (list) list.push(p)
        else members.set(root, [p])
    }
    const uses = new Map<number, number>()
    for (const n of g.nodes.values()) {
        if (n.op === NodeOp.apply) continue
        for (let i = 0; i < countIds(n); i++) {
            const r = getRef(n, i)
            if (owner.has(r)) uses.set(find(r), (uses.get(find(r)) ?? 0) + 1)
        }
    }
    const entry = g.root
    const candidates = new Map<number, number[]>()
    for (const [root, group] of members) {
        const crosses = group.some(p => crossing.has(p) || (settled.get(p) && !wants.get(root)?.length))
        let list: number[]
        if (crosses) {
            const values = [...group, ...group.flatMap(p => arrivals.get(p) ?? [])]
            list = [...new Set([...homes.rank(homes.volatiles.filter(r => values.every(v => homes.safeFor(v).includes(r)))), ...homes.preserved])]
        } else list = [...homes.volatiles, ...homes.preserved]
        list = list.filter(r => group.every(p => homes.accepts(p, r)))
        if (occupies.get(root)!.has(entry)) {
            const own = g.blocks[0].params.map((p, i) => group.includes(p) ? -1 : homes.arrival[i])
            list = list.filter(r => !own.includes(r))
        }
        candidates.set(root, list)
        wants.set(root, (wants.get(root) ?? []).filter(r => list.includes(r)))
    }
    const arrives = (x: number) => g.blocks[0].params.some((p, i) => find(p) === x && candidates.get(x)!.includes(homes.arrival[i]))
    const rank = (x: number) => (arrives(x) ? 2 : 0) + (wants.get(x)!.length ? 1 : 0)
    const density = (x: number) => (uses.get(x) ?? 0) / occupies.get(x)!.size
    const groups = [...occupies.keys()].sort((a, b) => rank(b) - rank(a) || density(b) - density(a))
    const taken = new Map<number, Set<number>>()
    for (const b of g.blocks) taken.set(b.id, new Set())
    const homeOf = new Map<number, number>()
    const spills: number[] = []
    for (const root of groups) {
        const where = occupies.get(root)!
        const free = (r: number) => {
            for (const id of where) if (taken.get(id)!.has(r)) return false
            return true
        }
        const arrived = g.blocks[0].params.map((p, i) => find(p) === root ? homes.arrival[i] : -1)
            .find(h => h >= 0 && !homes.volatiles.includes(h) && !homes.preserved.includes(h) && free(h))
        let home = wants.get(root)!.find(free) ?? candidates.get(root)!.find(free) ?? arrived ?? spills.find(free)
        if (home === undefined) spills.push(home = homes.overflow())
        for (const id of where) taken.get(id)!.add(home)
        homeOf.set(root, home)
    }
    const out = new Map<number, number[]>()
    for (const b of g.blocks) out.set(b.id, b.params.map(p => homeOf.get(find(p))!))
    return out
}

export function substitute(g: Graph, by: Map<number, Operand>): void {
    function resolve(id: number): Operand {
        let at: Operand = id
        while (typeof at === 'number' && by.has(at)) at = by.get(at)!
        return at
    }
    for (const [id, n] of [...g.nodes]) {
        if (by.has(id)) continue
        let operands: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (!by.has(getRef(n, i))) continue
            operands ??= getOperands(g, n)
            operands[i] = resolve(getRef(n, i))
        }
        if (operands) putCopy(g, id, n, operands)
    }
    for (const b of g.blocks) {
        if (!by.has(b.bodyId)) continue
        const body = resolve(b.bodyId)
        assert(typeof body === 'number', 'substitute: a block body must stay a value')
        b.bodyId = body
    }
    for (const id of by.keys()) deleteNode(g, id)
}

function rebuildable(g: Graph, id: number): boolean {
    const n = getNode(g, id)
    if (!n) return false
    return n.op === NodeOp.literal || n.op === NodeOp.frameAddress || gn.localSymbol(g, n) !== undefined
}

type ArmDemand = Map<number, { every: Set<number>, arms: Set<number>[] }>

function demanded(g: Graph, root: number, into: Set<number>, memo: ArmDemand, stop?: Set<number>): Set<number> {
    const stack = [root]
    while (stack.length) {
        const x = stack.pop()!
        if (!x || into.has(x) || stop?.has(x)) continue
        into.add(x)
        const n = getNode(g, x)
        if (!n || n.op === NodeOp.block) continue
        if (n.op === NodeOp.select) {
            stack.push(getRef(n, 0))
            for (const y of armDemand(g, x, memo, stop).every) into.add(y)
            continue
        }
        for (const y of getArgIds(n)) if (y) stack.push(y)
    }
    return into
}

function armDemand(g: Graph, id: number, memo: ArmDemand, stop?: Set<number>): { every: Set<number>, arms: Set<number>[] } {
    const known = memo.get(id)
    if (known) return known
    const n = getNode(g, id)!
    const arms: Set<number>[] = []
    let every: Set<number> | undefined
    for (let i = 1; i < countIds(n) && (!every || every.size); i++) {
        const arm = getRef(n, i) ? demanded(g, getRef(n, i), new Set(), memo, stop) : new Set<number>()
        arms.push(arm)
        every = every ? new Set([...every].filter(x => arm.has(x))) : arm
    }
    const out = { every: every ?? new Set<number>(), arms }
    memo.set(id, out)
    return out
}

function leavesArm(g: Graph, n: GraphNode): boolean {
    return PureOps.has(n.op) || islandLoad(g, n)
}

function dereferenceable(g: Graph, id: number): boolean {
    const n = getNode(g, id)
    return !!n && (n.op === NodeOp.load || n.op === NodeOp.param) && typeOf(n) === Types.ptr
}

function machineTypes(g: Graph): boolean {
    let changed = false
    for (const [id, n] of g.nodes) {
        if (!typeSlots(n.op) || typeRefOf(n) || typeOf(n) !== Types.ptr) continue
        retypeNode(g, id, Types.u64)
        changed = true
    }
    return changed
}

function unorderedValue(g: Graph, id: number, cache: Map<number, boolean>): boolean {
    if (!id) return true
    const known = cache.get(id)
    if (known !== undefined) return known
    cache.set(id, true)
    const n = getNode(g, id)!
    let ok = leavesArm(g, n)
    for (let i = 0; ok && i < countIds(n); i++) {
        const a = getRef(n, i)
        if (a && !unorderedValue(g, a, cache)) ok = false
    }
    cache.set(id, ok)
    return ok
}

function effectNode(g: Graph, id: number, cache: Map<number, boolean>): boolean {
    const n = getNode(g, id)!
    if (n.op === NodeOp.select) return !unorderedValue(g, id, cache)
    return !leavesArm(g, n)
}

function hollowOrdering(g: Graph, id: number, cache: Map<number, boolean>, hollow: Map<number, boolean>): boolean {
    const known = hollow.get(id)
    if (known !== undefined) return known
    const n = getNode(g, id)!
    let out = false
    if (n.op === NodeOp.after) {
        const result = getRef(n, countIds(n) - 1)
        out = !!result && hollowOrdering(g, result, cache, hollow)
    } else if (n.op !== NodeOp.nilEffect && n.op !== NodeOp.void && n.op !== NodeOp.param) {
        out = !effectNode(g, id, cache)
    }
    hollow.set(id, out)
    return out
}

function foldPureOrdering(g: Graph): void {
    const cache = new Map<number, boolean>()
    const hollow = new Map<number, boolean>()
    const parts = new Map<number, number[]>()
    let nil = 0
    function orderingOf(id: number): number[] {
        const known = parts.get(id)
        if (known) return known
        const out: number[] = []
        parts.set(id, out)
        if (unorderedValue(g, id, cache)) return out
        const n = getNode(g, id)!
        if (n.op !== NodeOp.after && effectNode(g, id, cache)) {
            out.push(id)
            return out
        }
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            for (const x of orderingOf(ref)) {
                if (!out.includes(x)) out.push(x)
            }
        }
        return out
    }
    for (const [id, n] of g.nodes) {
        const end = firstNonOrderingSlot(n)
        let dirty = false
        for (let i = 0; i < end; i++) {
            if (getRef(n, i) && hollowOrdering(g, getRef(n, i), cache, hollow)) dirty = true
        }
        if (!dirty) continue
        const tokens: number[] = []
        for (let i = 0; i < end; i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            const xs = hollowOrdering(g, ref, cache, hollow) ? orderingOf(ref) : [ref]
            for (const x of xs) {
                if (!tokens.includes(x)) tokens.push(x)
            }
        }
        if (!tokens.length) {
            if (!nil) nil = addNode(g, NodeOp.nilEffect, [])
            tokens.push(nil)
        }
        const operands = getOperands(g, n)
        if (n.op === NodeOp.after) {
            putCopy(g, id, n, [...tokens, ...operands.slice(end)])
            continue
        }
        operands[0] = tokens.length === 1 ? tokens[0] : joinEffects(g, tokens)
        putCopy(g, id, n, operands)
    }
}

function islandLoad(g: Graph, n: GraphNode): boolean {
    if (n.op !== NodeOp.load || getRef(n, 0) || getRef(n, 2)) return false
    const base = getNode(g, getRef(n, 1))
    return base?.op === NodeOp.pc && getLiteral(g, base, 0) === 0
}

export function wideLiteral(v: number): boolean {
    return Number.isSafeInteger(v) && (v >= 2 ** 32 || v < -(2 ** 31))
}

function reuseSteppedIndex(g: Graph, costs: lowering.TargetCosts): boolean {
    if (!costs.scaledIndex) return false
    const stepped = new Map<string, number>()
    for (const [id, n] of g.nodes) {
        if (typeOf(n) === Types.u32 || !getRef(n, 0) || getRef(n, 1)) continue
        const k = n.op === NodeOp.sub ? getLiteral(g, n, 1) : n.op === NodeOp.add ? -getLiteral(g, n, 1) : 0
        if (k) stepped.set(`${getRef(n, 0)}:${k}`, id)
    }
    if (!stepped.size) return false
    let changed = false
    for (const m of [...g.nodes.values()]) {
        if ((m.op !== NodeOp.load && m.op !== NodeOp.store) || !getRef(m, 1) || getRef(m, 2) || !getLiteral(g, m, 2)) continue
        const add = getNode(g, getRef(m, 1))!
        if (add.op !== NodeOp.add || !getRef(add, 0) || !getRef(add, 1)) continue
        const width = intrinsics.intrinsicBitWidth(typeOf(m)) / 8
        const offset = getLiteral(g, m, 2)
        if (offset % width) continue
        for (const [bi, si] of [[0, 1], [1, 0]]) {
            const shl = getNode(g, getRef(add, si))!
            if (shl.op !== NodeOp.shl || !getRef(shl, 0) || getRef(shl, 1) || typeOf(shl) === Types.u32 || width !== 1 << getLiteral(g, shl, 1)) continue
            const previous = stepped.get(`${getRef(shl, 0)}:${-offset / width}`)
            if (previous === undefined) continue
            setRef(m, 1, getRef(add, bi))
            setRef(m, 2, addNode(g, NodeOp.shl, [previous, { literal: getLiteral(g, shl, 1) }], typeOf(shl)))
            changed = true
            break
        }
    }
    return changed
}

function reduceConstantMultiplies(g: Graph): void {
    for (const [id, n] of [...g.nodes]) {
        if (n.op !== NodeOp.mul || typeOf(n) === Types.f64) continue
        const valueAt = getRef(n, 0) && !getRef(n, 1) ? 0
            : getRef(n, 1) && !getRef(n, 0) ? 1 : -1
        if (valueAt < 0) continue
        const carried = Math.log2(getLiteral(g, n, valueAt ^ 1) - 1)
        if (!Number.isSafeInteger(carried) || carried <= 0 || carried >= 32) continue
        const value = getRef(n, valueAt)
        const shifted = addCopy(g, n, [value, { literal: carried }], NodeOp.shl)
        putCopy(g, id, n, [value, shifted], NodeOp.add)
    }
}

function splitScaledShifts(g: Graph, costs: lowering.TargetCosts): boolean {
    if (!costs.scaledIndex) return false
    const users = nodeUsers(g, g.nodes.keys())
    let changed = false
    for (const [id, n] of [...g.nodes]) {
        if (n.op !== NodeOp.shl || !getRef(n, 0) || getRef(n, 1) || typeOf(n) === Types.u32) continue
        const list = users.get(id) ?? []
        if (list.length < 2) continue
        const shift = getLiteral(g, n, 1)
        const scaled = list.every(u => {
            const m = getNode(g, u)!
            return (m.op === NodeOp.load || m.op === NodeOp.store) && getArgIds(m).every((x, i) => x !== id || i === 2)
                && intrinsics.intrinsicBitWidth(typeOf(m)) === 8 << shift
        })
        if (!scaled) continue
        for (const u of list.slice(1)) setRef(getNode(g, u)!, 2, addCopy(g, n, getOperands(g, n), n.op))
        changed = true
    }
    return changed
}

function splitSharedLiterals(g: Graph, wanted: (id: number) => boolean): void {
    const users = new Map<number, Map<number, number[]>>()
    for (const b of g.blocks) {
        const seen = new Set<number>()
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.block) continue
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                stack.push(ref)
                if (!wanted(ref)) continue
                let byBlock = users.get(ref)
                if (!byBlock) users.set(ref, byBlock = new Map())
                const list = byBlock.get(b.id)
                if (list) list.push(id)
                else byBlock.set(b.id, [id])
            }
        }
    }
    for (const [literal, byBlock] of users) {
        if (byBlock.size < 2) continue
        const original = getNode(g, literal)!
        for (const list of byBlock.values()) {
            const copy = addCopy(g, original)
            for (const user of new Set(list)) {
                const n = getNode(g, user)!
                const operands = getOperands(g, n)
                for (let i = 0; i < countIds(n); i++) if (getRef(n, i) === literal) operands[i] = copy
                putCopy(g, user, n, operands)
            }
        }
    }
}

function wideFloat(v: number): boolean {
    const bits = new BigUint64Array(new Float64Array([v]).buffer)[0]
    let parts = 0
    for (let i = 0; i < 4; i++) if ((bits >> BigInt(i * 16)) & BigInt(0xFFFF)) parts++
    return parts >= 3
}

function materializedSlot(n: GraphNode, slot: number): boolean {
    if (n.op === NodeOp.call) return slot === 1 || slot >= 3
    if (n.op === NodeOp.apply) return slot > 0
    if (n.op === NodeOp.record) return slot % 2 === 1
    if (n.op === NodeOp.indirectTarget) return slot === 0
    if (n.op === NodeOp.after) return slot === countIds(n) - 1
    return liftableSlot(n.op, slot)
}

function islandLoads(g: Graph, costs: lowering.TargetCosts, poolSlot: (value: number) => number, poolValue?: (slot: number) => number | undefined, floatSlot?: (value: number) => number): number[] {
    const island: number[] = []
    const entries = new Map<number, number>()
    const entryOf = (slot: number) => {
        let at = entries.get(slot)
        if (at === undefined) {
            entries.set(slot, at = island.length)
            island.push(slot)
        }
        return at
    }
    const floats = floatValues(g)
    const words = [new Map<number, number>(), new Map<number, number>()]
    function worthPooling(value: number | undefined, narrow: boolean): value is number {
        if (value === undefined) return false
        const known = words[narrow ? 1 : 0]
        let k = known.get(value)
        if (k === undefined) known.set(value, k = costs.literalWords(value, narrow))
        if (k > 2) return true
        return k > 1 && wideLiteral(value)
    }
    function nodeValue(id: number): number | undefined {
        const n = getNode(g, id)
        if (n?.op !== NodeOp.literal || floats.has(id) || typeOf(n) === Types.f64) return
        const value = getLiteral(g, n, 0)
        if (!Number.isSafeInteger(value)) return
        return typeOf(n) === Types.u32 ? Number(BigInt.asUintN(32, BigInt(value))) : value
    }
    function pooledNode(id: number): boolean {
        return worthPooling(nodeValue(id), typeOf(getNode(g, id)!) === Types.u32)
    }
    function floatOperand(id: number, n: GraphNode, i: number): boolean {
        if (n.op === NodeOp.apply) return floats.has(getBlock(g, getRef(n, 0))?.params[i - 1] ?? 0)
        return (liftableSlot(n.op, i) || n.op === NodeOp.after) && floats.has(id)
    }
    splitSharedLiterals(g, pooledNode)
    const loads: [id: number, entry: number, type: Types][] = []
    for (const [id, n] of [...g.nodes]) {
        if (n.op === NodeOp.poolEntry && !getRef(n, 0)) {
            const value = poolValue?.(getLiteral(g, n, 0))
            if (value !== undefined && inlineableLiteral(costs, value)) putNode(g, id, NodeOp.literal, [{ literal: value }])
            else loads.push([id, entryOf(getLiteral(g, n, 0)), Types.u64])
            continue
        }
        if (n.op === NodeOp.literal) {
            const value = getLiteral(g, n, 0)
            if (pooledNode(id)) loads.push([id, entryOf(poolSlot(nodeValue(id)!)), typeOf(n)])
            else if (floatSlot && floats.has(id) && !Number.isInteger(value) && wideFloat(value)) loads.push([id, entryOf(floatSlot(value)), Types.f64])
            continue
        }
        let ops: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (getRef(n, i) || !materializedSlot(n, i)) continue
            const value = getLiteral(g, n, i)
            const pooled = floatOperand(id, n, i) || !Number.isSafeInteger(value) ? undefined : value
            const integer = worthPooling(pooled, false)
            if (!integer && !(floatSlot && !Number.isInteger(value) && wideFloat(value))) continue
            const lifted = newId(g)
            loads.push([lifted, entryOf(integer ? poolSlot(pooled) : floatSlot!(value)), integer ? Types.u64 : Types.f64])
            ops ??= getOperands(g, n)
            ops[i] = lifted
        }
        if (ops) putCopy(g, id, n, ops)
    }
    for (const [id, entry, type] of loads) {
        const pc = addNode(g, NodeOp.pc, [{ literal: 0 }, { literal: (entry - island.length) * 8 }])
        putNode(g, id, NodeOp.load, [{ literal: 0 }, pc, { literal: 0 }], type)
    }
    return island
}

function stripMem(g: Graph): boolean {
    const pointers = new Map<number, Operand>()
    for (const [id, n] of g.nodes) if (n.op === NodeOp.mem) pointers.set(id, getOperand(g, n, 0))
    if (!pointers.size) return false
    substitute(g, pointers)
    return true
}

export function pstackRebases(g: NodeSpace, n: GraphNode): boolean {
    return !!getRef(n, 2) || !!getLiteral(g, n, 2)
}

export function pstackAllocates(g: NodeSpace, n: GraphNode | undefined): boolean {
    return n?.op === NodeOp.pstack && !pstackRebases(g, n) && (!!getRef(n, 3) || getLiteral(g, n, 3) > 0)
}

function allocates(g: NodeSpace, n: GraphNode): boolean {
    return n.op === NodeOp.alloca || pstackAllocates(g, n)
}

function pstackFixedSize(g: Graph, n: GraphNode): number {
    return pstackAllocates(g, n) && !getRef(n, 3) ? getLiteral(g, n, 3) : 0
}

function expandPstacks(g: Graph): boolean {
    let found = false
    for (const [id, n] of [...g.nodes]) {
        if (n.op !== NodeOp.pstack) continue
        found = true
        if (getRef(n, 1)) throw `lowering: pstack %${id} names its stack dynamically`
        const token = getRef(n, 0)
        const cell = getLiteral(g, n, 1)
        const rebases = pstackRebases(g, n)
        const sized = !!getRef(n, 3) || !!getLiteral(g, n, 3)
        const base: Operand = rebases ? getOperand(g, n, 2) : addNode(g, NodeOp.load, [token, { literal: cell }, 0], Types.u64)
        if (!rebases && !sized) {
            putCopy(g, id, n, [base, base], NodeOp.after)
            continue
        }
        const top: Operand = sized ? addNode(g, NodeOp.add, [base, getOperand(g, n, 3)]) : base
        const store = addNode(g, NodeOp.store, [token, { literal: cell }, 0, top], Types.u64)
        const fresh = rebases ? base : addNode(g, NodeOp.mem, [base, getOperand(g, n, 3)], Types.u64)
        putCopy(g, id, n, [store, fresh], NodeOp.after)
    }
    return found
}

function bindCallContext(g: Graph, register: number): void {
    let context = 0
    const merged = new Map<number, number>()
    function explicitContext(ref: number, args: number): [target: number, context: Operand] | undefined {
        const n = getNode(g, ref)
        if (n?.op === NodeOp.after) {
            const inner = explicitContext(getRef(n, countIds(n) - 1), args)
            if (!inner) return
            const ordered = addCopy(g, n, [...getOperands(g, n, 0, countIds(n) - 1), inner[0]])
            return [ordered, inner[1]]
        }
        if (n?.op !== NodeOp.indirectTarget || countIds(n) !== 2) return
        const fnType = getNode(g, typeRefOf(n))
        const signature = insertNode(g, gn.createFnType(g, fnType?.op === NodeOp.fnType ? gn.fnReturn(fnType) : typeOf(n), [...new Array<number>(args).fill(-1), register]))
        const local = getNode(g, getRef(n, 0))
        const target = local?.op === NodeOp.localTarget ? addNode(g, NodeOp.localTarget, getOperands(g, local), { ref: signature }) : addNode(g, NodeOp.indirectTarget, [getOperand(g, n, 0)], { ref: signature })
        return [target, getOperand(g, n, 1)]
    }
    for (const [id, n] of [...g.nodes]) {
        const explicit = n.op === NodeOp.call ? explicitContext(getRef(n, 1), countIds(n) - 3) : undefined
        if (explicit) putCopy(g, id, n, [getOperand(g, n, 0), explicit[0], ...getOperands(g, n, 2), explicit[1]])
        if (n.op !== NodeOp.callContext) continue
        if (!context) context = id
        else merged.set(id, context)
    }
    if (!context) return
    setNode(g, context, gn.createLocatedParam(g, register))
    if (merged.size) for (const b of g.blocks) b.bodyId = replaceAll(g, b.bodyId, merged)
    g.blocks[0].params.push(context)
}

function expandCodecs(g: Graph): boolean {
    let found = false
    function node(op: NodeOp, ref: Operand, literal: number): number {
        return addNode(g, op, [ref, { literal: literal }])
    }
    function pstackOffset(ref: number): number {
        return addNode(g, NodeOp.convert, [ref], Types.u28)
    }
    const derefs = new Map<number, number[]>()
    const others = new Set<number>()
    for (const [id, n] of g.nodes) {
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref || getNode(g, ref)?.op !== NodeOp.decode) continue
            if (i !== 1 || (n.op !== NodeOp.load && n.op !== NodeOp.store)) {
                others.add(ref)
                continue
            }
            const users = derefs.get(ref)
            if (users) users.push(id)
            else derefs.set(ref, [id])
        }
    }
    for (const [id, n] of [...g.nodes]) {
        if (n.op === NodeOp.box) {
            putNode(g, id, NodeOp.shl, [getOperand(g, n, 0), { literal: 1 }], Types.i64)
            found = true
            continue
        }
        if (n.op === NodeOp.unbox && typeOf(n) === Types.bool) {
            putNode(g, id, NodeOp.eq, [getOperand(g, n, 0), { literal: heap.trueWord }], Types.bool)
            found = true
            continue
        }
        if (n.op === NodeOp.unbox && typeOf(n) === Types.u32) {
            putNode(g, id, NodeOp.ushr, [getOperand(g, n, 0), { literal: 1 }], Types.u32)
            found = true
            continue
        }
        if (n.op === NodeOp.unbox) {
            const word = addNode(g, NodeOp.convert, [getOperand(g, n, 0)], Types.i32)
            putNode(g, id, NodeOp.shr, [word, { literal: 1 }], Types.i64)
            found = true
            continue
        }
        if (n.op !== NodeOp.encode && n.op !== NodeOp.decode) continue
        const value = getOperand(g, n, 0)
        const base = getLiteral(g, n, 1)
        assert(!getRef(n, 1) && base >= 0, `lowering: ${opName(n.op)} %${id} needs a constant heap base`)
        const coded = n.op === NodeOp.decode
            ? node(NodeOp.add, pstackOffset(node(NodeOp.ushr, value, 1)), base)
            : node(NodeOp.add, node(NodeOp.shl, value, 1), heap.pstackWordTag + 1 - 2 * base)
        // TODO: in debug panic on a null handle instead of UB
        for (const user of others.has(id) ? [] : derefs.get(id) ?? []) {
            const u = getNode(g, user)!
            const operands = getOperands(g, u)
            operands[1] = coded
            putCopy(g, user, u, operands)
        }
        const decoding = n.op === NodeOp.decode
        if (decoding ? definedWord(g, getRef(n, 0), getLiteral(g, n, 0)) : nonZero(g, getRef(n, 0), getLiteral(g, n, 0), [])) putCopy(g, id, getNode(g, coded)!)
        else if (decoding) putNode(g, id, NodeOp.select, [addNode(g, NodeOp.ne, [value, { literal: heap.undefinedWord }], Types.bool), coded, 0])
        else putNode(g, id, NodeOp.select, [value, coded, { literal: heap.undefinedWord }])
        found = true
    }
    return found
}

interface ArithForm { 
    op: NodeOp
    li: number
    ri: number
    imm: number
    operandImm: number
    signed: boolean
    narrow: boolean
    narrowCompare: boolean
    immediate: boolean 
}

function arithForm(g: Graph, target: lowering.Target, n: GraphNode): ArithForm {
    const signed = lowering.isSignedType(operandType(g, n, 0)) || lowering.isSignedType(operandType(g, n, 1))
    const swap = !getRef(n, 0) && getRef(n, 1) !== 0
        && (Commutative.has(n.op) || SwappedCmp[n.op] !== undefined)
    const op = swap ? SwappedCmp[n.op] ?? n.op : n.op
    const cmp = CompareOps.has(op)
    const li = swap ? 1 : 0
    const ri = swap ? 0 : 1
    const imm = getLiteral(g, n, ri)
    const narrow = !cmp && NarrowableOps.has(op) && typeOf(n) === Types.u32
    const narrowCompare = cmp && (op === NodeOp.eq || op === NodeOp.ne || !signed) && imm > 0x7FFF_FFFF && imm <= 0xFFFF_FFFF
        && zeroExtendedBits(operandType(g, n, li)) <= 32
    const operandImm = narrowCompare ? imm - 0x1_0000_0000 : imm
    const immediate = !getRef(n, ri) && target.takesImmediate(opName(op), operandImm)
    return { op, li, ri, imm, operandImm, signed, narrow, narrowCompare, immediate }
}

function zeroOperand(g: Graph, target: lowering.Target, n: GraphNode, i: number): boolean {
    return target.zeroReg !== undefined && !getRef(n, i) && getLiteral(g, n, i) === 0
}

function registerLiterals(g: Graph, target: lowering.Target): void {
    const floats = floatValues(g)
    function plain(k: number): Types {
        return !Number.isInteger(k) ? Types.f64 : k < 0 ? Types.i64 : Types.u64
    }
    function narrowed(k: number): Types {
        return k >= 0 && k <= 0xFFFF_FFFF ? Types.u32 : plain(k)
    }
    function inRegister(id: number, n: GraphNode, i: number, value: boolean): Types | undefined {
        const k = getLiteral(g, n, i)
        if (BinaryOps.has(n.op) || CompareOps.has(n.op)) {
            if (i > 1) return
            for (let j = 0; j < 2; j++) if (getRef(n, j) ? floats.has(getRef(n, j)) : !Number.isInteger(getLiteral(g, n, j))) return Types.f64
            const form = arithForm(g, target, n)
            if (form.immediate) return i === form.ri ? undefined : plain(k)
            return form.narrow ? narrowed(k) : plain(k)
        }
        if (UnaryOps.has(n.op) || n.op === NodeOp.convert || n.op === NodeOp.bitconvert) return i === 0 ? plain(k) : undefined
        if (n.op === NodeOp.load) return i === 1 ? plain(k) : undefined
        if (n.op === NodeOp.crc32) {
            if (i > 1 || zeroOperand(g, target, n, i)) return
            return i === 1 && intrinsics.intrinsicBitWidth(getLiteral(g, n, 2)) === 64 ? plain(k) : narrowed(k)
        }
        if (n.op === NodeOp.store) {
            if (i === 1) return plain(k)
            if (i !== 3 || zeroOperand(g, target, n, 3)) return
            const T = typeOf(n)
            return T === Types.f64 ? Types.f64 : intrinsics.intrinsicBitWidth(T) <= 32 ? narrowed(k) : plain(k)
        }
        if (n.op === NodeOp.select) {
            if (i === 0) return plain(k)
            if (!value || zeroOperand(g, target, n, i)) return
            return floats.has(id) ? Types.f64 : plain(k)
        }
        if (n.op === NodeOp.after) {
            if (i !== countIds(n) - 1 || !value) return
            return floats.has(id) ? Types.f64 : plain(k)
        }
    }
    for (const b of g.blocks) {
        const tails = new Set<number>()
        const values = new Set<number>()
        const stack: [id: number, tail: boolean][] = [[b.bodyId, true]]
        while (stack.length) {
            const [id, tail] = stack.pop()!
            const n = getNode(g, id)
            const into = tail ? tails : values
            if (!n || n.op === NodeOp.block || into.has(id)) continue
            into.add(id)
            const last = countIds(n) - 1
            for (let i = 0; i < countIds(n); i++) {
                if (!getRef(n, i)) continue
                stack.push([getRef(n, i), tail && (n.op === NodeOp.after ? i === last : n.op === NodeOp.select && i > 0)])
            }
        }
        const sites = new Map<string, [id: number, slot: number][]>()
        const lifts = new Map<number, number>()
        for (const id of new Set([...tails, ...values])) {
            const n = getNode(g, id)!
            for (let i = 0; i < countIds(n); i++) {
                if (getRef(n, i)) continue
                const T = inRegister(id, n, i, values.has(id))
                if (T === undefined) continue
                const key = `${T}:${getLiteral(g, n, i)}`
                let list = sites.get(key)
                if (!list) sites.set(key, list = [])
                list.push([id, i])
                lifts.set(id, (lifts.get(id) ?? 0) + 1)
            }
        }
        const rewrites = new Map<number, Operand[]>()
        for (const [key, list] of sites) {
            const T = Number(key.slice(0, key.indexOf(':'))) as Types
            const [first, slot] = list[0]
            const k = getLiteral(g, getNode(g, first)!, slot)
            const scratch = T !== Types.f64 && list.length === 1 && lifts.get(first) === 1
            const lifted = insertNode(g, makeNode(g, NodeOp.literal, [{ literal: k }], T, scratch ? gn.NodeFlags.scratch : gn.NodeFlags.none))
            for (const [id, i] of list) {
                let ops = rewrites.get(id)
                if (!ops) rewrites.set(id, ops = getOperands(g, getNode(g, id)!))
                ops[i] = lifted
            }
        }
        for (const [id, ops] of rewrites) putCopy(g, id, getNode(g, id)!, ops)
    }
}

function shareLiterals(g: Graph, costs: lowering.TargetCosts): void {
    const members = g.blocks.map(b => {
        const seen = new Set<number>()
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(g, id) : undefined
            if (!n || seen.has(id) || n.op === NodeOp.block || n.op === NodeOp.param) continue
            seen.add(id)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return seen
    })
    const shared = new Map<number, number>()
    for (const seen of members) for (const id of seen) shared.set(id, (shared.get(id) ?? 0) + 1)
    for (const seen of members) {
        const counts = new Map<number, number>()
        const sites: [id: number, slot: number][] = []
        for (const id of seen) {
            if (shared.get(id)! > 1) continue
            const n = getNode(g, id)!
            for (let slot = 0; slot < countIds(n); slot++) {
                if (getRef(n, slot) || !liftableSlot(n.op, slot)) continue
                const value = getLiteral(g, n, slot)
                if (inlineableLiteral(costs, value)) continue
                counts.set(value, (counts.get(value) ?? 0) + 1)
                sites.push([id, slot])
            }
        }
        const made = new Map<number, number>()
        for (const [id, slot] of sites) {
            const n = getNode(g, id)!
            const value = getLiteral(g, n, slot)
            if (counts.get(value)! < 2) continue
            let lifted = made.get(value)
            if (lifted === undefined) {
                lifted = addNode(g, NodeOp.literal, [{ literal: value }])
                made.set(value, lifted)
            }
            setRef(n, slot, lifted)
        }
    }
}

export function analyzeValueGraph(g: Graph, opts?: LowerGraphOptions) {
    const usedBy = new Map<number, number[]>()
    const demands = new Map<number, Set<number>>()
    const dependencies = new Map<number, Set<number>>()
    function recordEdge(from: number, to: number, used: boolean) {
        if (used) {
            let arr = usedBy.get(to)
            if (!arr) usedBy.set(to, arr = [])
            arr.push(from)
            let d = demands.get(from)
            if (!d) demands.set(from, d = new Set())
            d.add(to)
        }
        let set = dependencies.get(from)
        if (!set) dependencies.set(from, set = new Set())
        set.add(to)
    }

    const inArgPos = new Map<number, [parent: number, idx: number][]>()
    const inStatePos = new Map<number, [parent: number, idx: number][]>()
    const returnsAt = new Map<number, number>()

    const blockBodyValues = new Map<number, number[]>()
    const hasCallEffects = new Set<number>()

    function getGraphBlock(id: number) {
        const b = getBlock(g, id)
        assert(b)
        return b
    }

    const loops = graphLoops(g)
    const { tailTargets, loopsOf, loopMembers, loopDepth } = loops
    const frameAllocas = layoutAllocas()

    function layoutAllocas(): number {
        const allocas: number[] = []
        for (const [id, n] of g.nodes) if (n.op === NodeOp.alloca) allocas.push(id)
        if (!allocas.length) return framed()
        const paramAt = new Map<number, [block: number, index: number]>()
        for (const b of g.blocks) b.params.forEach((p, i) => paramAt.set(p, [b.id, i]))
        function loopCarried(id: number): boolean {
            for (;;) {
                const n = getNode(g, id)
                if (!n) return false
                if (n.op === NodeOp.param) return !!loopDepth.get(paramAt.get(id)?.[0] ?? -1)
                if (n.op !== NodeOp.alloca) return false
                id = getRef(n, 0)
            }
        }
        for (const b of g.blocks) {
            if (!loopDepth.get(b.id)) continue
            const seen = new Set<number>()
            const pending = [b.bodyId]
            while (pending.length) {
                const id = pending.pop()!
                if (!id || seen.has(id)) continue
                seen.add(id)
                const n = getNode(g, id)
                if (!n || n.op === NodeOp.block || n.op === NodeOp.param) continue
                if (n.op === NodeOp.alloca && loopCarried(getRef(n, 0))) throw `lowering: alloca %${id} is evaluated inside the loop at B${b.id}`
                for (let i = 0; i < countIds(n); i++) pending.push(getRef(n, i))
            }
        }
        for (const [id, n] of g.nodes) {
            if (n.op !== NodeOp.ret) continue
            let value = getRef(n, 0)
            let m = getNode(g, value)
            while (m?.op === NodeOp.after) {
                value = getRef(m, countIds(m) - 1)
                m = getNode(g, value)
            }
            if (getNode(g, value)?.op === NodeOp.alloca) throw `lowering: alloca %${value} escapes through ret %${id}`
        }
        const offsets = new Map<number, number>()
        let reserved = 0
        for (const id of allocas) {
            const n = getNode(g, id)!
            assert(getRef(n, 0), `lowering: alloca %${id} has no ordering`)
            const align = getLiteral(g, n, 2)
            const at = (reserved + align - 1) & ~(align - 1)
            offsets.set(id, at)
            reserved = at + getLiteral(g, n, 1)
        }
        for (const id of allocas) {
            const size = getLiteral(g, getNode(g, id)!, 1)
            putNode(g, id, NodeOp.frameAddress, [{ literal: offsets.get(id)! }, { literal: size }])
        }
        return framed()
    }

    function framed(): number {
        let bytes = 0
        for (const n of g.nodes.values()) {
            if (n.op === NodeOp.frameAddress) bytes = Math.max(bytes, getLiteral(g, n, 0) + getLiteral(g, n, 1))
        }
        return (bytes + 15) & ~15
    }
    
    const callProjections = new Map<number, number[]>()
    function addCallProj(target: number, consumer: number) {
        let arr = callProjections.get(target)
        if (!arr) callProjections.set(target, arr = [])
        arr.push(consumer)
    }

    const stack: number[] = []
    const blockStack: GraphBlock[] = []
    const visited = new Map<number, number>()
    const reverseOrder = new Map<number, number>()
    const incoming = new Map<number, number[]>()
    const applyOwner = new Map<number, number>()
    function enterBlock(b: GraphBlock): void {
        visited.set(b.id, visited.size)
        {
            blockStack.push(b)
            defer blockStack.pop()
            assert(!blockBodyValues.has(b.id))
            blockBodyValues.set(b.id, [])
            for (const x of b.params) {
                visit(x, false, true)
            }
            visit(b.bodyId, false)
        }
    }
    function visit(id: number, used: boolean, param?: boolean): void {
        if (!id) return
        const n = getNode(g, id)!
        if (n.op === NodeOp.nilEffect) return
        if (n.op === NodeOp.void) return
        if (stack.length && !param) {
            recordEdge(stack[stack.length-1], id, used)
        }
        if (visited.has(id)) return
        visited.set(id, visited.size)
        stack.push(id)
        defer stack.pop()

        const valId = id
        defer {
            reverseOrder.set(valId, reverseOrder.size)
            if (blockStack.length) {
                const blockId = blockStack[blockStack.length-1].id
                if (n && n.op !== NodeOp.param) {
                    blockBodyValues.get(blockId)!.push(valId)
                }
            }
        }

        if (!countIds(n)) return

        if (n.op === NodeOp.after) {
            const result = countIds(n) - 1
            for (let i = 0; i < result; i++) visit(getRef(n, i), false)
            visit(getRef(n, result), true)
            return
        }
        if (n.op === NodeOp.call || n.op === NodeOp.store || n.op === NodeOp.load) {
            visit(getRef(n, 0), false)
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            if (n.op === NodeOp.call) {
                hasCallEffects.add(id)
                if (blockStack.length) {
                    hasCallEffects.add(blockStack[blockStack.length-1].id)
                }
                const target = getNode(g, getRef(n, 1))
                if (target?.op === NodeOp.indirectTarget) {
                    for (let i = 0; i < countIds(target); i++) if (getRef(target, i)) recordEdge(id, getRef(target, i), true)
                }
            }
            return
        }
        if (n.op === NodeOp.apply) {
            const b = getGraphBlock(getRef(n, 0))
            for (let i = 1; i < countIds(n); i++) {
                visit(getRef(n, i), true)
            }
            let into = incoming.get(b.id)
            if (!into) incoming.set(b.id, into = [])
            into.push(id)
            applyOwner.set(id, blockStack[blockStack.length-1].id)
            if (visited.has(b.id)) return
            enterBlock(b)
            return
        }
        if (n.op === NodeOp.get) {
            const t = getRef(n, 0)
            if (t !== 0 && getNode(g, t)!.op === NodeOp.call) {
                addCallProj(t, id)
            }
        }
        for (const x of getArgIds(n)) {
            if (!x) continue
            visit(x, true)
        }
    }
    visited.set(0, 0)
    blockStack.push(g.blocks[0])
    blockBodyValues.set(g.root, [])
    const bodyId = g.blocks[0].bodyId
    if (bodyId) visit(bodyId, false)

    const releaseAt = new Map<number, Map<number, Set<number>>>()
    const narrowsAt = new Map<number, Set<number>>()

    // BAGGAGE CLAIM
    const shouldSpillUntil = new Map<number, number>()
    const crossedCalls = new Map<number, Set<number>>()
    const visitOrder = new Map<number, number>()
    const operandOrder = new Map<number, number[]>()
    {
        const tmp = new Set<number>()
        interface ClaimState {
            live: Set<number>
            seen: Set<number>
            done: Set<number>
            excluded: Set<number>
            crosses: Map<number, Set<number>>
            region: number
        }
        function initState(save?: ClaimState): ClaimState {
            return {
                live: new Set(save?.live),
                seen: new Set(save?.seen),
                done: new Set(save?.done),
                excluded: new Set(save?.excluded),
                crosses: new Map(save?.crosses),
                region: save?.region ?? 0,
            }
        }
        let state = initState()
        function addCross(spilled: number, crossed: number, targetState = state) {
            let s = targetState.crosses.get(spilled)
            if (!s) targetState.crosses.set(spilled, s = new Set())
            s.add(crossed)
        }
        const baggageUses: number[][] = []
        function baggageVisit(id: number): void {
            if (!id) return
            if (state.seen.has(id) || tmp.has(id) || state.excluded.has(id)) return
            tmp.add(id)
            const uses = usedBy.get(id)
            if (uses) baggageUses.push(uses)
            const n = getNode(g, id)
            if (!n) return
            for (let i = 0; i < countIds(n); i++) {
                baggageVisit(getRef(n, i))
            }
        }
        function getNewBaggage(root: number, clearTmp = true): number {
            if (clearTmp) tmp.clear()
            baggageUses.length = 0
            baggageVisit(root)
            let c = 0
            for (const arr of baggageUses) {
                for (let i = 0; i < arr.length; i++) {
                    const x = arr[i]
                    if (state.seen.has(x) || state.excluded.has(x) || tmp.has(x)) continue
                    c += 1
                    break
                }
            }
            return c
        }
        let trail: number[] | undefined
        function addSeen(id: number) {
            if (state.seen.has(id)) return
            state.seen.add(id)
            trail?.push(id)
        }
        function addDone(id: number) {
            if (state.done.has(id)) return
            state.done.add(id)
            trail?.push(-id)
        }
        function selectBaggage(selectId: number, u: GraphNode) {
            assert(u.op === NodeOp.select)

            tmp.clear()
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (!a) continue
                getNewBaggage(a, false)
            }
            if (!tmp.size) return

            const newlySeen = new Set(tmp)
            newlySeen.add(selectId)
            const saveState = state
            const outerTrail = trail
            defer {
                state = saveState
                trail = outerTrail
            }
            for (let i = 1; i < countIds(u); i++) {
                const a = getRef(u, i)
                if (!a || saveState.seen.has(a)) continue
                state = saveState
                getNewBaggage(a)
                assert(tmp.size)
                const excluded = new Set(newlySeen)
                for (const x of tmp) excluded.delete(x)
                for (const x of saveState.excluded) excluded.add(x)
                const unused = new Set<number>()
                state = { live: new Set(saveState.live), seen: saveState.seen, done: saveState.done, excluded, crosses: saveState.crosses, region: a }
                const armTrail: number[] = []
                trail = armTrail
                for (const x of state.live) {
                    if (allUsesDone(usedBy.get(x))) {
                        state.live.delete(x)
                        unused.add(x)
                    }
                }
                if (unused.size) narrowsAt.set(a, unused)
                scheduleFrom(a, true)
                for (let j = armTrail.length - 1; j >= 0; j--) {
                    const x = armTrail[j]
                    if (x > 0) saveState.seen.delete(x)
                    else saveState.done.delete(-x)
                }
            }
        }

        function findSchedule(n: GraphNode): number[] {
            const arity = countIds(n)
            const pinned = n.op === NodeOp.after ? arity - 1 : -1
            if (arity - (pinned >= 0 ? 1 : 0) <= 1) {
                const order: number[] = []
                for (let i = 0; i < arity; i++) order.push(i)
                return order
            }
            const calls: boolean[] = []
            const baggage: number[] = []
            const order: number[] = []
            for (let i = 0; i < arity; i++) {
                calls.push(false)
                if (i === pinned) {
                    baggage.push(0)
                    continue
                }
                baggage.push(getNewBaggage(getRef(n, i)))
                for (const id of tmp) {
                    if (!hasCallEffects.has(id)) continue
                    calls[i] = true
                    break
                }
                let at = order.length
                while (at > 0) {
                    const prev = order[at - 1]
                    if (calls[prev] === calls[i] ? baggage[prev] <= baggage[i] : calls[prev]) break
                    order[at] = prev
                    at--
                }
                order[at] = i
            }
            if (pinned >= 0) order.push(pinned)
            return order
        }
        function updateLiveAfter(id: number, partial?: number) {
            if (const d = demands.get(id)) {
                for (const x of d) {
                    if (!state.live.has(x)) continue
                    if (partial && x !== partial) continue
                    const uses = usedBy.get(x)!
                    if (partial && uses.indexOf(id) !== uses.lastIndexOf(id)) continue
                    if (!allUsesDone(uses, id)) continue
                    releaseFrom(id, x)
                }
            }
        }
        function releaseFrom(user: number, target: number) {
            if (!state.excluded.has(target)) {
                let sites = releaseAt.get(state.region)
                if (!sites) releaseAt.set(state.region, sites = new Map())
                let s = sites.get(user)
                if (!s) sites.set(user, s = new Set())
                s.add(target)
            }
            state.live.delete(target)
        }
        function materialize(id: number, partial?: number) {
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            addDone(id)
            updateLiveAfter(id, partial)
        }
        function allUsesDone(uses: number[] | undefined, from?: number) {
            if (!uses) return true
            const len = uses.length
            for (let i = 0; i < len; i++) {
                const v = uses[i]
                if (!v) continue
                if (v === from) continue
                if (!state.done.has(v) && !state.excluded.has(v)) {
                    return false
                }
            }
            return true
        }
        function scheduleFrom(id: number, tail = false) {
            if (!id) return
            if (state.seen.has(id)) {
                if (state.live.has(id)) {
                    if (allUsesDone(usedBy.get(id))) {
                        state.live.delete(id)
                    }
                }
                return
            }
            addSeen(id)
            const u = getNode(g, id)
            assert(u)
            if (u.op === NodeOp.select && tail) {
                operandOrder.set(id, [0, 1, 2])
                scheduleFrom(getRef(u, 0))
                materialize(id, getRef(u, 0))
                selectBaggage(id, u)
                return
            }
            const order = operandOrder.get(id) ?? findSchedule(u)
            operandOrder.set(id, order)
            for (const idx of order) {
                const t = tail && ((u.op === NodeOp.after && idx === countIds(u)-1) || (u.op === NodeOp.ret && idx === 0))
                scheduleFrom(getRef(u, idx), t)
            }
            if (const q = visitOrder.get(id)) {
                visitOrder.set(id, Math.min(q, state.done.size))
            } else {
                visitOrder.set(id, state.done.size)
            }
            if (u.op === NodeOp.apply || u.op === NodeOp.ret) {
                materialize(id)
                for (const x of [...state.live]) releaseFrom(id, x)
                return
            }
            if (!hasCallEffects.has(id)) return materialize(id)
            updateLiveAfter(id)
            for (const x of state.live) {
                if (rebuildable(g, x)) continue
                addCross(x, id)
            }
            if (!allUsesDone(usedBy.get(id))) state.live.add(id)
            addDone(id)
            if (const projections = callProjections.get(id)) {
                for (const p of projections) {
                    addSeen(p)
                    materialize(p)
                }
            }
        }
        function scheduleFromBlock(b: GraphBlock) {
            assert(b.bodyId)
            for (const p of b.params) {
                state.live.add(p)
                state.seen.add(p)
            }
            scheduleFrom(b.bodyId, true)
            state.live.clear()
        }
        for (const b of g.blocks) state.seen.add(b.id)
        for (const b of g.blocks) {
            if (!b.bodyId) continue
            scheduleFromBlock(b)
        }
        const seenForSpill = new Set<number>()
        function visitForSpill(id: number, crossed: Set<number>) {
            if (seenForSpill.has(id)) return
            seenForSpill.add(id)
            const uses = usedBy.get(id)
            if (!uses) return
            let last = 0
            let best = -1
            for (const call of crossed) {
                const rank = visitOrder.get(call) ?? -1
                if (rank > best) { best = rank; last = call }
            }
            if (!last) return
            shouldSpillUntil.set(id, last)
        }
        for (const res of state.crosses) {
            visitForSpill(res[0], res[1])
            crossedCalls.set(res[0], res[1])
        }
        if (opts?.debug) {
            const claimed = [...visitOrder]
            claimed.sort((a, b) => a[1] - b[1])
            console.log('claim order', claimed.map(x => x[0]).join(' '))
        }
    }

    const testLast = new Map<number, number>()
    const firstArm = new Map<number, number>()
    for (const [header, members] of loopMembers) {
        const select = getGraphBlock(header).bodyId
        const n = getNode(g, select)
        const stay = loopStayArm(g, n, members)
        if (!stay) continue
        if (members.size < 2) continue
        if (exitsFromBody(g, header, members)) continue
        if (!bareArm(g, getGraphBlock(header), getRef(n!, stay))) continue
        testLast.set(header, getRef(getNode(g, getRef(n!, stay))!, 0))
        firstArm.set(select, 3 - stay)
    }
    const reached = [...blockBodyValues.keys()]
    const blockOrder: number[] = []
    const succ = new Map<number, number[]>()
    const post: number[] = []
    {
        const open = new Set<number>()
        const done = new Set<number>()
        function search(id: number): void {
            open.add(id)
            const out: number[] = []
            succ.set(id, out)
            for (const t of tailTargets.get(id)!) {
                if (open.has(t)) continue
                if (!out.includes(t)) out.push(t)
                if (!done.has(t)) search(t)
            }
            open.delete(id)
            done.add(id)
            post.push(id)
        }
        search(g.root)
    }
    const rpo = new Map<number, number>()
    for (let i = 0; i < post.length; i++) rpo.set(post[i], post.length - 1 - i)
    const chainOf = new Map<number, number[]>()
    const chains: number[][] = []
    for (const id of post) {
        const chain = [id]
        chains.push(chain)
        chainOf.set(id, chain)
    }
    const odds = hotCold(g, loops)
    const hotArm = odds.hotArm
    function prefer(from: number, a: number, b: number): number {
        const ca = odds.targets.get(from)?.get(a) ?? Infinity
        const cb = odds.targets.get(from)?.get(b) ?? Infinity
        if (ca !== cb) return ca < cb ? 1 : -1
        return (loopDepth.get(a) ?? 0) - (loopDepth.get(b) ?? 0) || rpo.get(b)! - rpo.get(a)!
    }
    for (const single of [true, false]) {
        for (const id of post) {
            if ((new Set(tailTargets.get(id)).size === 1) !== single) continue
            const mine = chainOf.get(id)!
            let next: number[] | undefined
            const candidates = succ.get(id)!.filter(t => !testLast.has(t) && testLast.get(id) !== t)
            for (const t of new Set(tailTargets.get(id))) if (testLast.has(t) && loopMembers.get(t)!.has(id)) candidates.unshift(t)
            for (const t of candidates) {
                const chain = chainOf.get(t)!
                if (chain[0] !== t || chain === mine) continue
                if (testLast.has(t)) {
                    next = chain
                    break
                }
                if (!next || prefer(id, t, next[0]) > 0) next = chain
            }
            if (!next) continue
            for (const x of next) {
                mine.push(x)
                chainOf.set(x, mine)
            }
            chains.splice(chains.indexOf(next), 1)
        }
    }
    const entry = chainOf.get(g.root)!
    const returns = (c: number[]) => !tailTargets.get(c[c.length - 1])!.length
    const first = new Map(chains.map(c => [c, Math.min(...c.map(id => rpo.get(id)!))]))
    chains.sort((a, b) => {
        if (a === entry || b === entry) return a === entry ? -1 : 1
        if (returns(a) !== returns(b)) return returns(a) ? 1 : -1
        if (returns(a) && a.length !== b.length) return b.length - a.length
        return first.get(a)! - first.get(b)!
    })
    for (const c of chains) for (const id of c) blockOrder.push(id)
    for (const id of reached) if (!chainOf.has(id)) blockOrder.push(id)
    const fallsIn = new Set<number>()
    for (let i = 1; i < blockOrder.length; i++) {
        if (tailTargets.get(blockOrder[i - 1])?.includes(blockOrder[i])) fallsIn.add(blockOrder[i])
    }
    const position = new Map<number, number>()
    for (let i = 0; i < blockOrder.length; i++) position.set(blockOrder[i], i)
    const forwardOf = (from: number, to: number) => (position.get(to) ?? -1) > (position.get(from) ?? -1)
    const coldArm = new Map<number, number>()
    const emitIndex = new Map<number, number>()
    const tailUses = new Map<number, number>()
    {
        function forward(arm: number, owner: number): boolean {
            const t = getNode(g, tailOf(g, arm))
            if (!t) return true
            if (t.op === NodeOp.apply) return forwardOf(owner, getRef(t, 0))
            if (t.op !== NodeOp.select) return true
            const inner = hotArm.get(tailOf(g, arm))
            if (inner) return forward(getRef(t, inner), owner)
            for (let i = 1; i < countIds(t); i++) if (!forward(getRef(t, i), owner)) return false
            return true
        }
        function into(arm: number, next: number | undefined): boolean {
            return tailPositions(g, arm).some(p => getNode(g, p.at)!.op === NodeOp.apply && getRef(getNode(g, p.at)!, 0) === next)
        }
        function visit(id: number, owner: number, next: number | undefined): void {
            const at = tailOf(g, id)
            const n = getNode(g, at)
            if (n?.op === NodeOp.apply) {
                emitIndex.set(at, emitIndex.size)
                tailUses.set(at, (tailUses.get(at) ?? 0) + 1)
            }
            if (n?.op !== NodeOp.select) return
            let first = firstArm.get(at) ?? 1
            if (testLast.has(owner) && at === getGraphBlock(owner).bodyId) coldArm.set(at, 3 - first)
            else {
                const hot = hotArm.get(at)
                if (hot && getNode(g, getRef(n, 3 - hot))?.op === NodeOp.apply && forward(getRef(n, hot), owner)) {
                    coldArm.set(at, 3 - hot)
                    first = hot
                } else if (into(getRef(n, 1), next) && !into(getRef(n, 2), next)) first = 2
                firstArm.set(at, first)
            }
            visit(getRef(n, first), owner, next)
            for (let i = 1; i < countIds(n); i++) if (i !== first) visit(getRef(n, i), owner, next)
        }
        for (let i = 0; i < blockOrder.length; i++) visit(getGraphBlock(blockOrder[i]).bodyId, blockOrder[i], blockOrder[i + 1])
    }
    const carriesCode = (app: number) => !bareArm(g, getGraphBlock(applyOwner.get(app)!), app)
    const sinks = new Set<number>()
    for (const [target, arrivals] of incoming) {
        if (arrivals.length !== 1 && fallsIn.has(target)) continue
        const candidates = arrivals.filter(app => tailUses.get(app) === 1 && (usedBy.get(app)?.length ?? 0) <= 1 && forwardOf(applyOwner.get(app)!, target))
        let pick = 0
        if (arrivals.length === 1) pick = candidates[0] ?? 0
        else for (const app of candidates) {
            if (!carriesCode(app)) continue
            // FIXME: change hot/cold to use integers, not floats?
            const c = odds.arrivals.get(app) ?? Infinity
            const best = pick ? odds.arrivals.get(pick) ?? Infinity : Infinity
            if (!pick || c < best || (c === best && emitIndex.get(app)! < emitIndex.get(pick)!)) pick = app
        }
        if (pick) sinks.add(pick)
        if (intrinsics.argv().includes(`odds-debug:${g.name}`)) console.log('ODDS sink', `B${target}`, arrivals.map(a => `%${a}@B${applyOwner.get(a)}=${odds.arrivals.get(a) ?? Infinity}`).join(' '), '->', pick ? `%${pick}` : 'none')
    }
    if (placementProbe || intrinsics.argv().includes(`block-placement:${g.name}`)) {
        sweepBlocks(g)
        const epoch = nextEpoch(g)
        let selects = 0
        function countSelects(x: number): void {
            const n = getNode(g, x)
            if (!n || !markVisited(n, epoch)) return
            if (n.op === NodeOp.after) return countSelects(getRef(n, countIds(n) - 1))
            if (n.op !== NodeOp.select) return
            selects++
            for (let i = 1; i < countIds(n); i++) countSelects(getRef(n, i))
        }
        for (const id of blockOrder) countSelects(getGraphBlock(id).bodyId)
        const stranded: string[] = []
        let falls = 0
        for (let i = 1; i < blockOrder.length; i++) {
            const id = blockOrder[i]
            const prev = blockOrder[i - 1]
            if (tailTargets.get(prev)?.includes(id)) { falls++; continue }
            const from = new Set((incoming.get(id) ?? []).map(app => applyOwner.get(app)!))
            const adjacent = [...from].some(x => blockOrder.indexOf(x) < i)
            stranded.push(`B${id} preds=${from.size} prev=B${prev}${adjacent ? '' : ' (no earlier pred)'}`)
        }
        const backEdges = new Set<string>()
        {
            const onStack = new Set<number>()
            const done = new Set<number>()
            function walk(id: number): void {
                onStack.add(id)
                for (const t of tailTargets.get(id) ?? []) {
                    if (onStack.has(t)) { backEdges.add(`B${id}->B${t}`); continue }
                    if (!done.has(t)) walk(t)
                }
                onStack.delete(id)
                done.add(id)
            }
            walk(g.root)
        }
        const target = blockOrder.length - selects - 1
        for (const x of stranded) console.log('PLACEMENT', g.name ?? '<anonymous>', x)
        console.log('PLACEMENT', g.name ?? '<anonymous>', 'chains',
            chains.map(c => `[${c.join(',')}]`).join(' '))
        console.log('PLACEMENT', g.name ?? '<anonymous>',
            `totals blocks=${blockOrder.length} selects=${selects} fallthrough=${falls}`,
            `target=${target} gap=${target - falls}`,
            `backEdges=${backEdges.size}${backEdges.size ? ` [${[...backEdges].join(' ')}]` : ''}`)
    }
    function notePos(into: Map<number, [parent: number, idx: number][]>, id: number, parent: number, idx: number): void {
        if (!id) return
        const at = into.get(id)
        if (at) at.push([parent, idx])
        else into.set(id, [[parent, idx]])
    }
    for (const [id, n] of g.nodes) {
        if (!visited.has(id)) continue
        if (n.op === NodeOp.call) {
            for (let k = 3; k < countIds(n); k++) notePos(inArgPos, getRef(n, k), id, k - 3)
        } else if (n.op === NodeOp.apply) {
            for (let k = 1; k < countIds(n); k++) notePos(inArgPos, getRef(n, k), id, k - 1)
        }
    }
    for (const b of g.blocks) {
        function tails(at: number, field: number): void {
            if (!at) return
            if (isParam(g.nodes, at)) { notePos(inStatePos, at, b.id, -1 - field); return }
            const t = getNode(g, at)!
            if (t.op === NodeOp.select) {
                for (let i = 1; i < countIds(t); i++) tails(getRef(t, i), field)
                return 
            }
            if (t.op === NodeOp.after) { tails(getRef(t, countIds(t)-1), field); return }
            if (t.op === NodeOp.ret) { tails(getRef(t, 0), field); return }
            if (t.op === NodeOp.record) {
                for (let i = 1; i < countIds(t); i += 2) tails(getRef(t, i), getLiteral(g, t, i - 1))
                return
            }
            if (t.op === NodeOp.apply) return
            notePos(inStatePos, at, b.id, -1 - field)
        }
        tails(b.bodyId, 0)
    }

    const callsUnderCache = new Map<number, Set<number>>()
    function callsUnder(id: number): Set<number> {
        const cached = callsUnderCache.get(id)
        if (cached) return cached
        const out = new Set<number>()
        callsUnderCache.set(id, out)
        if (hasCallEffects.has(id)) out.add(id)
        const deps = dependencies.get(id)
        if (deps) {
            for (const d of deps) {
                if (d === id) continue
                for (const c of callsUnder(d)) out.add(c)
            }
        }
        return out
    }

    function precedingValues(id: number, use: number): number[] {
        const n = getNode(g, use)
        if (n && n.op === NodeOp.select) {
            return precedingValues(id, getRef(n, 0))
        }
        const deps = dependencies.get(use)
        return deps ? [...deps] : []
    }

    for (const uses of usedBy.values()) {
        uses.sort((a, b) => (reverseOrder.get(a) ?? -1) - (reverseOrder.get(b) ?? -1))
    }
    for (const [id, uses] of usedBy) {
        const available = callsUnder(id)
        const crossed = new Set<number>()
        for (const use of uses) {
            for (const p of precedingValues(id, use)) {
                for (const c of callsUnder(p)) {
                    if (c === use || available.has(c)) continue
                    crossed.add(c)
                }
            }
        }
    }
    const effectivelyLinearBlocks = new Set<number>()
    for (const [k, v] of incoming) if (v.length === 1) effectivelyLinearBlocks.add(k)
    return {
        inArgPos,
        inStatePos,
        returnsAt,
        shouldSpillUntil,
        crossedCalls,
        blockOrder,
        fallsIn,
        sinks,
        coldArm,
        firstArm,
        releaseAt,
        narrowsAt,
        applyOwner,
        usedBy,
        operandOrder,
        visitOrder,
        reverseOrder,
        callsUnderValue: callsUnderCache,
        callProjections,
        effectivelyLinearBlocks,
        frameAllocas,
    }
}

export function describeHeapHandle(g: NodeSpace, n: GraphNode): string {
    if (n.op !== NodeOp.heapHandle || countIds(n) !== 2 || getRef(n, 1)) return ''
    const target = getLiteral(g, n, 1) as intrinsics.Handle
    if (!target || !heap.isOrdinaryObject(target)) return ''
    const fields: string[] = []
    for (let i: u32 = 0; i < heap.ownPropertyCount(target); i++) {
        const key = heap.ownPropertyKeyAt(target, i)
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.ownPropertyAt(target, i)))
        const slot = d.slot0 as intrinsics.Handle
        let text = heap.isIndirect(slot) ? `*${slot}` : `@${slot}`
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) {
            text = '<accessor>'
        } else if (heap.isBoxedF64(slot)) {
            const value = heap.unboxF64(slot)
            const ref = intrinsics.getNanId(value)
            text = ref ? `%${ref}` : `#${value}`
        }
        fields.push(`${heap.isString(key) ? heap.stringToJs(key) : `@${key}`}: ${text}`)
    }
    return ` { ${fields.join(', ')} }`
}

export function typeName(T: number): string {
    for (const key of Object.keys(Types)) if ((Types as any)[key] === T) return key
    return `T${T}`
}

function describeType(g: Graph, T: TypeOperand): string {
    if (typeof T === 'number') return typeName(T)
    const t = getNode(g, T.ref)
    if (t?.op === NodeOp.fnType) return `fn -> ${describeType(g, gn.fnReturn(t))}`
    if (t?.op === NodeOp.recordType) {
        const fields = recordFields(g, t).map(f => `${heap.isString(f.key as u32) ? heap.stringToJs(f.key as u32) : f.key}: ${describeType(g, f.type)}`)
        return `{ ${fields.join(', ')} }`
    }
    return `%${T.ref}`
}

export function dumpGraph(g: Graph): string {
    const out: string[] = []
    const showTypes = intrinsics.argv().includes('graph-types')
    if (g.name) {
        out.push(`--- vgraph for ${g.name} ---`)
    }
    for (const b of g.blocks) {
        const params = b.params.map(p => {
            const at = getNode(g, p) ? gn.paramLocation(getNode(g, p)!) : -1
            return at < 0 ? `${p}` : `${p}@r${at}`
        })
        out.push(`B${b.id}(${params.join(', ')}) -> ${b.bodyId || b.bodyConst}`)
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = getNode(g, id)
            if (!n) return
            if (n.op === NodeOp.param || n.op === NodeOp.block) return // noisy
            for (const a of getArgIds(n)) walk(a)
            const parts: string[] = []
            for (let i = 0; i < countIds(n); i++) {
                const cid = getRef(n, i)
                let missing = false
                if (cid) {
                    if (const c = getNode(g, cid)) {
                        if (c.op === NodeOp.block) {
                            parts.push(`B${cid}`)
                            continue
                        }
                    } else {
                        missing = true
                    }
                }
                parts.push(cid ? `%${cid}${missing ? '?' : ''}` : `#${getLiteral(g, n, i)}`)
            }
            if (n.op === NodeOp.get && !getLiteral(g, n, 2)) {
                const key = getLiteral(g, n, 1)
                if (key > 1 && heap.isString(key as u32)) {
                    parts.pop()
                    parts.push(`"${heap.stringToJs(key as u32)}"`)
                }
            }
            const key = (n.op === NodeOp.getProp || n.op === NodeOp.setProp) && !getRef(n, 2) ? heap.describeKey(getLiteral(g, n, 2) as Handle) : undefined
            const label = getDebugLabel(g, id) ?? key
            if (gn.spreadsLast(n)) parts[parts.length - 1] = `...${parts[parts.length - 1]}`
            const shown = n.op === NodeOp.rt ? [parts[0], ...parts.slice(2)] : parts
            const typed = showTypes && typeSlots(n.op) ? ` : ${describeType(g, typeRefOf(n) ? { ref: typeRefOf(n) } : typeOf(n))}` : ''
            out.push(`  %${id} = ${n.op === NodeOp.rt ? `rt.${rt.opName(getLiteral(g, n, 1))}` : opName(n.op)} ${shown.join(' ')}${typed}${describeHeapHandle(g, n)}${label ? '    ; ' + label : ''}`)
        }
        walk(b.bodyId)
    }
    return out.join('\n')
}

export function dumpBlockGraph(g: Graph): string {
    const successors = new Map<number, number[]>()
    const blockIds = new Set<number>(g.blocks.map(b => b.id))
    for (const b of g.blocks) {
        const found = new Set<number>()
        const seen = new Set<number>()
        function walk(id: number): void {
            if (!id || seen.has(id)) return
            seen.add(id)
            const n = getNode(g, id)
            if (!n) return
            if (n.op === NodeOp.block) {
                if (blockIds.has(id)) found.add(id)
                return
            }
            for (const arg of getArgIds(n)) walk(arg)
        }
        walk(b.bodyId)
        successors.set(b.id, [...found])
    }

    const out: string[] = []
    if (g.name) out.push(`--- blocks for ${g.name} ---`)
    const expanded = new Set<number>()
    const active = new Set<number>()
    function render(id: number, prefix = '', branch = ''): void {
        if (active.has(id)) {
            out.push(`${prefix}${branch}B${id} (cycle)`)
            return
        }
        if (expanded.has(id)) {
            out.push(`${prefix}${branch}B${id} (seen)`)
            return
        }
        out.push(`${prefix}${branch}B${id}`)
        expanded.add(id)
        active.add(id)
        const next = successors.get(id) ?? []
        for (let i = 0; i < next.length; i++) {
            const last = i === next.length - 1
            render(next[i], prefix + (branch ? branch === '`-- ' ? '    ' : '|   ' : ''), last ? '`-- ' : '|-- ')
        }
        active.delete(id)
    }

    if (g.blocks.length) render(g.root)
    for (const b of g.blocks) {
        if (expanded.has(b.id)) continue
        if (out.length) out.push('')
        render(b.id)
    }
    return out.join('\n')
}

interface MiniBlock {
    key: number
    inputs: number[]
}

interface OutlineBlock {
    block: GraphBlock
    uses: Map<number, number>
    tails: number[]
    cut: Map<number, Map<number, MiniBlock>>
    closed: Map<number, Map<number, MiniBlock>>
    below: Map<number, Set<number>>
}

// XXX: need to refactor graph nodes, zzz...
function smuggledOperands(n: GraphNode): string {
    return typeSlots(n.op) ? `:${typeOf(n)}` : ''
}

function isArgless(n: GraphNode): boolean {
    if (n.op === NodeOp.param) return false
    for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) return false
    return true
}

function outlineBlocks(g: Graph): Graph {
    const interned = new Map<string, number>()
    function intern(s: string): number {
        let k = interned.get(s)
        if (k === undefined) interned.set(s, k = interned.size + 1)
        return k
    }

    const infos = new Map<number, OutlineBlock>()
    const postOrder: OutlineBlock[] = []
    const appliesTo = new Map<number, number[]>()
    function enter(b: GraphBlock): void {
        if (infos.has(b.id)) return
        const info: OutlineBlock = { block: b, uses: new Map(), tails: [b.bodyId], cut: new Map(), closed: new Map(), below: new Map() }
        infos.set(b.id, info)
        const successors: number[] = []
        const epoch = nextEpoch(g)
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id) continue
            const n = getNode(g, id)
            if (!n || !markVisited(n, epoch)) continue
            if (n.op === NodeOp.apply) {
                successors.push(getRef(n, 0))
                let arr = appliesTo.get(getRef(n, 0))
                if (!arr) appliesTo.set(getRef(n, 0), arr = [])
                arr.push(id)
            }
            for (let i = 0; i < countIds(n); i++) {
                const x = getRef(n, i)
                if (!x) continue
                info.uses.set(x, (info.uses.get(x) ?? 0) + 1)
                stack.push(x)
            }
        }
        for (const id of info.tails) {
            const n = getNode(g, id)
            const next = n?.op === NodeOp.select ? cloneRefs(n, 1) : n?.op === NodeOp.after ? cloneRefs(n, -1) : []
            for (const x of next) if (x && info.uses.get(x) === 1) info.tails.push(x)
        }
        for (const s of successors) enter(getBlock(g, s)!)
        postOrder.push(info)
    }

    const classOf = new Map<number, number>()
    const structuredTails = new Map<number, boolean>()
    function structured(id: number): boolean {
        const known = structuredTails.get(id)
        if (known !== undefined) return known
        const n = getNode(g, id)
        let result = false
        if (n?.op === NodeOp.after) result = structured(getRef(n, countIds(n) - 1))
        else if (n) result = hasStructuredTail(g, id)
        structuredTails.set(id, result)
        return result
    }
    function isInput(info: OutlineBlock, id: number, cut: boolean): boolean {
        const n = getNode(g, id)!
        return n.op === NodeOp.param || (cut && !isArgless(n) && !structured(id) && info.uses.get(id)! > 1)
    }
    function truncated(id: number, depth: number): boolean {
        return depth <= 1 && !isArgless(getNode(g, id)!) && !structured(id)
    }
    function indexIn(inputs: number[], x: number): number {
        let i = inputs.indexOf(x)
        if (i < 0) inputs.push(x), i = inputs.length - 1
        return i
    }
    function mini(info: OutlineBlock, id: number, cut: boolean, depth = Infinity, conditional = false): MiniBlock {
        const memos = cut ? info.cut : info.closed
        assert(!conditional || depth === Infinity, 'outline: a conditional mini is unbounded')
        const variant = conditional ? -Infinity : depth
        let memo = memos.get(variant)
        if (!memo) memos.set(variant, memo = new Map())
        const known = memo.get(id)
        if (known) return known
        const n = getNode(g, id)!
        const arity = countIds(n)
        const swaps = Commutative.has(n.op) && arity === 2
        const applied = n.op === NodeOp.apply ? applyOrder(n) : undefined
        const prefix = `${opName(n.op)}${smuggledOperands(n)}(`
        let bestText = ''
        let bestInputs: number[] | undefined
        for (let pass = 0; pass < (swaps ? 2 : 1); pass++) {
            const inputs: number[] = []
            let text = prefix
            const count = swaps ? 2 : applied ? applied.length : arity
            for (let k = 0; k < count; k++) {
                const i = swaps ? (pass ? 1 - k : k) : applied ? applied[k] : k
                const x = getRef(n, i)
                const u = x ? getNode(g, x) : undefined
                const arm = conditional || (n.op === NodeOp.select && i > 0)
                if (k) text += ' '
                if (!u) text += `#${getLiteral(g, n, i)}`
                else if (u.op === NodeOp.param || (!arm && (isInput(info, x, cut) || truncated(x, depth)))) text += `$${indexIn(inputs, x)}`
                else if (isArgless(u)) text += u.op === NodeOp.block ? `B${classOf.get(x) ?? `#${x}`}` : `${u.op}:${getArgConsts(g, u).join()}`
                else if (cut && arm && info.uses.get(x)! > 1) text += `!${x}`
                else {
                    const m = mini(info, x, cut, arm ? Infinity : depth - 1, cut && arm)
                    text += `${m.key}[`
                    for (let j = 0; j < m.inputs.length; j++) {
                        if (j) text += ','
                        text += indexIn(inputs, m.inputs[j])
                    }
                    text += ']'
                }
            }
            text += ')'
            if (!bestInputs || text < bestText) {
                bestText = text
                bestInputs = inputs
            }
        }
        const out = { key: intern(bestText), inputs: bestInputs! }
        memo.set(id, out)
        return out
    }
    const applyOrders = new Map<number, number[]>()
    function applyOrder(n: GraphNode): number[] {
        const target = infos.get(getRef(n, 0))
        if (!target || !classOf.has(target.block.id)) return getArgIds(n).map((_, i) => i)
        const known = applyOrders.get(target.block.id)
        if (known) return known
        const params = target.block.params
        const inputs = mini(target, target.block.bodyId, false).inputs.map(p => params.indexOf(p) + 1)
        const rest = params.map((_, i) => i + 1).filter(i => !inputs.includes(i))
        const order = [0, ...inputs, ...rest]
        applyOrders.set(target.block.id, order)
        return order
    }
    function below(info: OutlineBlock, id: number): Set<number> {
        const known = info.below.get(id)
        if (known) return known
        const out = new Set<number>()
        info.below.set(id, out)
        for (const x of getArgIds(getNode(g, id)!)) {
            const u = x ? getNode(g, x) : undefined
            if (!u || u.op === NodeOp.param || isArgless(u)) continue
            out.add(x)
            for (const y of below(info, x)) out.add(y)
        }
        return out
    }
    function nested(info: OutlineBlock, inputs: number[]): boolean {
        for (const a of inputs) for (const b of inputs) if (a !== b && below(info, a).has(b)) return true
        return false
    }
    function tree(info: OutlineBlock, id: number, depth = Infinity, conditional = false, out = new Set<number>()): Set<number> {
        if (out.has(id)) return out
        out.add(id)
        const n = getNode(g, id)!
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            const u = x ? getNode(g, x) : undefined
            const arm = conditional || (n.op === NodeOp.select && i > 0)
            if (!u || u.op === NodeOp.param || isArgless(u)) continue
            if (!arm && (isInput(info, x, true) || truncated(x, depth))) continue
            tree(info, x, arm ? Infinity : depth - 1, arm, out)
        }
        return out
    }

    enter(g.blocks[0])

    const rootShapes = new Set<string>()
    let repeats = false
    for (const info of postOrder) {
        const body = getNode(g, info.block.bodyId)
        if (info.block !== g.blocks[0] && body && body.op !== NodeOp.param) {
            const key = `B${body.op}/${countIds(body)}/${smuggledOperands(body)}`
            if (rootShapes.has(key)) repeats = true
            rootShapes.add(key)
        }
        for (const id of info.tails) {
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.param || isArgless(n) || info.uses.get(id)! > 1) continue
            const key = `${n.op}/${countIds(n)}`
            if (rootShapes.has(key)) repeats = true
            rootShapes.add(key)
        }
        if (repeats) break
    }
    if (!repeats) return g

    function typesOf(inputs: number[]): string {
        const types: string[] = []
        for (const x of inputs) {
            const T = valueType(g, getNode(g, x)!)
            types.push(typeof T === 'number' ? `${T}` : `%${T.ref}`)
        }
        return types.join(',')
    }
    const representative = new Map<number, OutlineBlock>()
    const merged = new Map<number, OutlineBlock>()
    for (const info of postOrder) {
        const b = info.block
        const body = getNode(g, b.bodyId)
        if (!body || body.op === NodeOp.param) continue
        const closed = mini(info, b.bodyId, false)
        const key = intern(`${closed.key}|${typesOf(closed.inputs)}`)
        classOf.set(b.id, key)
        if (b === g.blocks[0]) continue
        const prior = representative.get(key)
        if (prior) merged.set(b.id, prior)
        else representative.set(key, info)
    }

    const groups = new Map<number, [OutlineBlock, number, number][]>()
    const ordinal = new Map<string, number>()
    let active: [info: OutlineBlock, id: number, size: number, key: number][] = []
    const spineKeys = new Map<string, number>()
    const spines = new Map<number, number>()
    function spine(id: number): number {
        const known = spines.get(id)
        if (known !== undefined) return known
        const n = getNode(g, id)!
        const last = n.op === NodeOp.after ? getRef(n, countIds(n) - 1) : 0
        const text = `${n.op}/${countIds(n)}/${last && structured(last) ? spine(last) : 0}`
        let key = spineKeys.get(text)
        if (key === undefined) spineKeys.set(text, key = spineKeys.size + 1)
        spines.set(id, key)
        return key
    }
    const roots: [OutlineBlock, number][] = []
    const spineCounts = new Map<number, number>()
    for (const info of postOrder) {
        if (merged.has(info.block.id)) continue
        for (const id of info.tails) {
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.param || isArgless(n) || info.uses.get(id)! > 1) continue
            roots.push([info, id])
            spineCounts.set(spine(id), (spineCounts.get(spine(id)) ?? 0) + 1)
        }
    }
    for (const [info, id] of roots) {
        if (spineCounts.get(spine(id))! < 2) continue
        ordinal.set(`${info.block.id}:${id}`, ordinal.size)
        active.push([info, id, 0, 0])
    }
    for (let depth = 1; active.length; depth++) {
        const next: typeof active = []
        for (const [info, id, size] of active) {
            const grown = tree(info, id, depth).size
            if (grown === size) continue
            const key = mini(info, id, true, depth).key
            let arr = groups.get(key)
            if (!arr) groups.set(key, arr = [])
            arr.push([info, id, depth])
            next.push([info, id, grown, key])
        }
        active = next.filter(([, , , key]) => groups.get(key)!.length > 1)
    }
    const siteOrder = ([info, id, depth]: [OutlineBlock, number, number]) => ordinal.get(`${info.block.id}:${id}`)! * 4096 + depth
    function inputTypes([info, id, depth]: [OutlineBlock, number, number]): string {
        return typesOf(mini(info, id, true, depth).inputs)
    }
    for (const sites of groups.values()) if (sites.length > 1) sites.sort((a, b) => siteOrder(a) - siteOrder(b))

    const claimed = new Map<OutlineBlock, Set<number>>()
    const chosen: [OutlineBlock, number, number][][] = []
    const candidates = [...groups.values()]
        .filter(sites => sites.length > 1)
        .map(sites => sites.filter(([info, id, depth]) => !nested(info, mini(info, id, true, depth).inputs)))
        .map(sites => sites.filter(site => inputTypes(site) === inputTypes(sites[0])))
        .filter(sites => sites.length > 1)
        .map(sites => ({ sites, size: tree(sites[0][0], sites[0][1], sites[0][2]).size }))
        .sort((a, b) => ((b.sites.length - 1) * b.size - b.sites.length) - ((a.sites.length - 1) * a.size - a.sites.length))
    for (const { sites, size } of candidates) {
        const local = new Map<OutlineBlock, Set<number>>()
        const accepted = sites.filter(([info, id, depth]) => {
            let mine = local.get(info)
            if (!mine) local.set(info, mine = new Set())
            const taken = claimed.get(info)
            const nodes = tree(info, id, depth)
            for (const x of nodes) if (mine.has(x) || taken?.has(x)) return false
            for (const x of nodes) mine.add(x)
            return true
        })
        if (accepted.length < 2 || (accepted.length - 1) * size - accepted.length <= 0) continue
        for (const [info, nodes] of local) {
            let taken = claimed.get(info)
            if (!taken) claimed.set(info, taken = new Set())
            for (const x of nodes) taken.add(x)
        }
        chosen.push(accepted)
    }

    for (const [dup, rep] of merged) {
        const d = getBlock(g, dup)!
        const r = rep.block
        const dInputs = mini(infos.get(dup)!, d.bodyId, false).inputs
        const rInputs = mini(rep, r.bodyId, false).inputs
        for (const id of appliesTo.get(dup) ?? []) {
            const a = getNode(g, id)!
            const operands: (number | GraphNode)[] = [r.id]
            for (const p of r.params) {
                const at = rInputs.indexOf(p)
                const k = at < 0 ? -1 : d.params.indexOf(dInputs[at])
                operands.push(k < 0 ? literal(g, 0) : getRef(a, k + 1) || literal(g, getLiteral(g, a, k + 1)))
            }
            setNode(g, id, getNode(g, createNode(g, NodeOp.apply, operands, a))!)
        }
    }

    const replacements = new Map<OutlineBlock, Map<number, number>>()
    for (const sites of chosen) {
        const [first, root, depth] = sites[0]
        const inside = tree(first, root, depth)
        const cloned = new Map<number, number>()
        const params = mini(first, root, true, depth).inputs.map(x => {
            const p = addNode(g, NodeOp.param, [], valueType(g, getNode(g, x)!))
            cloned.set(x, p)
            return p
        })
        function clone(id: number): number {
            if (!inside.has(id)) return cloned.get(id) ?? id
            const known = cloned.get(id)
            if (known) return known
            const n = getNode(g, id)!
            const argIds = getArgIds(n).map(x => x && clone(x))
            const copy = addCopy(g, n, withRefs(g, n, argIds))
            cloned.set(id, copy)
            return copy
        }
        const blockId = createNode(g, NodeOp.block, [])
        addGraphBlock(g, { id: blockId, params, bodyId: clone(root), bodyConst: 0 })
        for (const [info, id, d] of sites) {
            let m = replacements.get(info)
            if (!m) replacements.set(info, m = new Map())
            m.set(id, createNode(g, NodeOp.apply, [blockId, ...mini(info, id, true, d).inputs]))
        }
    }
    for (const [info, m] of replacements) info.block.bodyId = replaceAll(g, info.block.bodyId, m)
    return g
}

function countUses(g: Graph, root: number): Map<number, number> {
    const uses = new Map<number, number>()
    const epoch = nextEpoch(g)
    const stack = [root]
    while (stack.length) {
        const id = stack.pop()!
        if (!id) continue
        const n = getNode(g, id)
        if (!n || !markVisited(n, epoch)) continue
        for (const x of getArgIds(n)) {
            if (!x) continue
            uses.set(x, (uses.get(x) ?? 0) + 1)
            stack.push(x)
        }
    }
    return uses
}

function putRet(g: Graph, id: number, exits: Map<number, number>, n: GraphNode, operand: (id: number) => number): void {
    const at = exits.get(getRef(n, 0))!
    const ret = getNode(g, g.blocks.find(x => x.id === getRef(n, 0))!.bodyId)!
    putCopy(g, id, ret, [at < 0 ? { literal: getLiteral(g, ret, 0) } : operand(getRef(n, at + 1)) || { literal: getLiteral(g, n, at + 1) }])
}

function coveredRegion(g: Graph, uses: Map<number, number>, arm: number, params?: Set<number>, passed?: Set<number>): boolean{
    const refs = new Map<number, number>()
    const epoch = nextEpoch(g)
    const stack = [arm]
    refs.set(arm, 1)
    while (const next = stack.pop()) {
        for (const x of getArgIds(getNode(g, next)!)) {
            if (!x) continue
            const u = getNode(g, x)!
            if (u.op === NodeOp.param || passed?.has(x) || (u.op === NodeOp.get && passed?.has(getRef(u, 0)))) {
                params?.add(x)
                continue
            }
            if (u.op === NodeOp.block || (isArgless(u) && u.op !== NodeOp.literal)) continue
            refs.set(x, (refs.get(x) ?? 0) + 1)
            if (!markVisited(u, epoch)) continue
            stack.push(x)
        }
    }
    for (const [k, v] of refs) {
        if (v !== uses.get(k)) return false
    }
    return true
}

// TODO: factor out baggage claim and use it here, it would be more accurate.
function sharedArmValues(g: Graph, selectId: number, memo: ArmDemand): Set<number> {
    const select = getNode(g, selectId)!
    const none = new Set<number>()
    const control = (n: GraphNode) => n.op === NodeOp.apply || n.op === NodeOp.ret || n.op === NodeOp.select || n.op === NodeOp.after
    const shareable = (id: number) => {
        const n = getNode(g, id)
        return !!n && !isArgless(n) && n.op !== NodeOp.param && !control(n)
    }
    for (let i = 1; i < countIds(select); i++) {
        const arm = getNode(g, getRef(select, i))
        if (!arm || ((arm.op === NodeOp.apply || arm.op === NodeOp.ret) && !getArgIds(arm).some(x => x && shareable(x)))) return none
    }
    const { every: shared, arms } = armDemand(g, selectId, memo)
    if (![...shared].some(shareable)) return none
    const condition = demanded(g, getRef(select, 0), new Set(), memo)
    const out = new Set<number>()
    for (const arm of arms) {
        for (const m of arm) {
            const n = getNode(g, m)
            if (!n || shared.has(m) || control(n)) continue
            for (const x of getArgIds(n)) {
                if (x && shared.has(x) && !condition.has(x) 
                    && (shareable(x) || getNode(g, x)!.op === NodeOp.select)) {
                    out.add(x)
                }
            }
        }
    }
    return out
}

function leafArms(g: Graph, selectId: number): number {
    const n = getNode(g, selectId)!
    let leaves = 0
    for (let i = 1; i < countIds(n); i++) {
        const arm = getRef(n, i)
        leaves += arm && getNode(g, arm)?.op === NodeOp.select ? leafArms(g, arm) : 1
    }
    return leaves
}

function withDependencies(g: Graph, roots: Set<number>): Set<number> {
    const out = new Set<number>()
    const stack = [...roots]
    while (stack.length) {
        const x = stack.pop()!
        if (out.has(x)) continue
        const n = getNode(g, x)
        if (!n || n.op === NodeOp.param || n.op === NodeOp.block || isArgless(n)) continue
        out.add(x)
        for (const y of getArgIds(n)) if (y) stack.push(y)
    }
    return new Set([...roots, ...out])
}

function shareArmValues(g: Graph): boolean {
    let changed = false
    const memo: ArmDemand = new Map()
    function sorted(b: GraphBlock, params: Set<number>, passed: Set<number>): number[] {
        const order = [...b.params, ...passed]
        return [...params].sort((x, y) => order.indexOf(x) - order.indexOf(y))
    }
    for (let i = 0; i < g.blocks.length; i++) {
        const b = g.blocks[i]
        const body = getNode(g, b.bodyId)
        const top = body?.op === NodeOp.ret ? getRef(body, 0) : b.bodyId
        const shared = getNode(g, top)?.op === NodeOp.select ? sharedArmValues(g, top, memo) : new Set<number>()
        const passed = shared.size ? withDependencies(g, shared) : shared
        if (passed.size) {
            const params = new Set<number>()
            coveredRegion(g, countUses(g, b.bodyId), b.bodyId, params, passed)
            b.bodyId = moveRegion(g, sorted(b, params, passed), b.bodyId)
            changed = true
            continue
        }
        const uses = countUses(g, b.bodyId)
        function visit(id: number): void {
            const n = getNode(g, id)
            if (n?.op === NodeOp.after) return visit(getRef(n, countIds(n) - 1))
            if (n?.op !== NodeOp.select) return
            for (let k = 1; k < countIds(n); k++) {
                const arm = getRef(n, k)
                const tail = arm ? tailOf(g, arm) : 0
                if (getNode(g, tail)?.op !== NodeOp.select) continue
                const inner = sharedArmValues(g, tail, memo)
                const passed = inner.size && leafArms(g, tail) > 2 ? withDependencies(g, inner) : inner
                const params = new Set<number>()
                if (!passed.size || !coveredRegion(g, uses, arm, params, passed)) {
                    visit(arm)
                    continue
                }
                setRef(n, k, moveRegion(g, sorted(b, params, passed), arm))
                changed = true
            }
        }
        visit(b.bodyId)
    }
    return changed
}

function moveRegion(g: Graph, params: number[], arm: number): number {
    const r = new Map<number, number>()
    const newParams: number[] = []
    for (const p of params) {
        const id = newId(g)
        const n = getNode(g, p)!
        if (n.op === NodeOp.param) putCopy(g, id, n)
        else putNode(g, id, NodeOp.param, [], valueType(g, n))
        r.set(p, id)
        newParams.push(id)
    }
    const blockId = createNode(g, NodeOp.block, [])
    const bodyId = replaceAll(g, arm, r)
    addGraphBlock(g, { id: blockId, params: newParams, bodyId, bodyConst: 0 })
    return createNode(g, NodeOp.apply, [blockId, ...params])
}

function outlineArm(g: Graph, uses: Map<number, number>, arm: number, exits = new Map<number, number>()): number {
    const inside = new Set<number>()
    const refs = new Map<number, number>()
    function take(id: number): void {
        inside.add(id)
        for (const x of getArgIds(getNode(g, id)!)) {
            if (!x || inside.has(x)) continue
            const k = (refs.get(x) ?? 0) + 1
            refs.set(x, k)
            const u = getNode(g, x)!
            if (u.op === NodeOp.param || u.op === NodeOp.block || u.op === NodeOp.get) continue
            if (k === uses.get(x) || hasStructuredTail(g, x)) take(x)
        }
    }
    take(arm)
    for (const id of inside) {
        const n = getNode(g, id)!
        const effects = n.op === NodeOp.after ? cloneRefs(n, 0, -1)
            : OrderedValues.has(n.op) ? cloneRefs(n, 0, 1) : []
        if (effects.some(x => x && !inside.has(x) && !isArgless(getNode(g, x)!))) return 0
    }
    const params: number[] = []
    const inputs: number[] = []
    const cloned = new Map<number, number>()
    function clone(id: number): number {
        if (!id) return id
        const known = cloned.get(id)
        if (known) return known
        const n = getNode(g, id)!
        if (!inside.has(id) && isArgless(n)) return id
        const copy = newId(g)
        if (!inside.has(id)) {
            putNode(g, copy, NodeOp.param, [], valueType(g, n))
            params.push(copy)
            inputs.push(id)
        } else if (n.op === NodeOp.apply && exits.has(getRef(n, 0))) {
            putRet(g, copy, exits, n, clone)
        } else {
            putCopy(g, copy, n, withRefs(g, n, getArgIds(n).map(clone)))
        }
        cloned.set(id, copy)
        return copy
    }
    const blockId = createNode(g, NodeOp.block, [])
    addGraphBlock(g, { id: blockId, params, bodyId: clone(arm), bodyConst: 0 })
    return createNode(g, NodeOp.apply, [blockId, ...inputs])
}

function hoistSharedArms(g: Graph, costs: lowering.TargetCosts): Graph {
    const maxForwardParams = 6
    const hoistable = (n: GraphNode) => n.op === NodeOp.load || n.op === NodeOp.convert || n.op === NodeOp.bitconvert
        || BinaryOps.has(n.op) || UnaryOps.has(n.op) || CompareOps.has(n.op)
    const outer = (n: GraphNode | undefined) => !n || n.op === NodeOp.block || isArgless(n)
    function reach(root: number, into: Set<number>, stop?: Set<number>): void {
        const stack = [root]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(g, id) : undefined
            if (outer(n) || n!.op === NodeOp.param || into.has(id) || stop?.has(id)) continue
            into.add(id)
            for (let i = n!.op === NodeOp.apply ? 1 : 0; i < countIds(n!); i++) stack.push(getRef(n!, i))
        }
    }
    function process(tail: number, before: Set<number>, loop: number): number {
        const n = tail ? getNode(g, tail) : undefined
        if (n?.op === NodeOp.after) {
            const lead = new Set(before)
            for (let i = 0; i < countIds(n) - 1; i++) reach(getRef(n, i), lead)
            const last = getRef(n, countIds(n) - 1)
            const next = process(last, lead, loop)
            if (next === last) return tail
            const ids = getArgIds(n)
            ids[ids.length - 1] = next
            return createNode(g, NodeOp.after, ids.map((id, i) => id || literal(g, getLiteral(g, n, i))), n)
        }
        if (!n || n.op !== NodeOp.select || countIds(n) !== 3) return tail
        const here = new Set(before)
        reach(getRef(n, 0), here)
        const interiors = [1, 2].map(i => {
            const inner = new Set<number>()
            reach(getRef(n, i), inner, here)
            return inner
        })
        const shared = new Set<number>([...interiors[0]].filter(x => interiors[1].has(x)))
        let demand: Set<number> | undefined
        const demandedByArms = (x: number) => (demand ??= armDemand(g, tail, new Map(), here).every).has(x)
        const hoisted = new Set<number>()
        const settled = new Map<number, boolean>()
        function liftable(x: number): boolean {
            const known = settled.get(x)
            if (known !== undefined) return known
            settled.set(x, false)
            const m = getNode(g, x)!
            let ok = shared.has(x) && hoistable(m) && (leavesArm(g, m) || demandedByArms(x))
            for (let i = 0; ok && i < countIds(m); i++) {
                const r = getRef(m, i)
                const u = r ? getNode(g, r) : undefined
                if (!r || outer(u) || u!.op === NodeOp.param || here.has(r)) continue
                ok = liftable(r)
            }
            settled.set(x, ok)
            return ok
        }
        function worth(x: number): boolean {
            const m = getNode(g, x)!
            if (latency(costs, m.op) > 1) return true
            for (const inner of interiors) {
                for (const y of inner) {
                    const u = getNode(g, y)!
                    if (u.op === NodeOp.apply && getRef(u, 0) === loop && getArgIds(u).slice(1).includes(x)) return true
                }
            }
            for (const r of getArgIds(m)) {
                const u = r ? getNode(g, r) : undefined
                if (!r || outer(u) || here.has(r)) continue
                let other = false
                for (const inner of interiors) {
                    for (const y of inner) {
                        if (y === x || hoisted.has(y)) continue
                        if (getArgIds(getNode(g, y)!).includes(r)) other = true
                    }
                }
                if (!other) return true
            }
            return false
        }
        function hoist(x: number): void {
            if (hoisted.has(x)) return
            hoisted.add(x)
            for (const r of getArgIds(getNode(g, x)!)) if (r && shared.has(r)) hoist(r)
        }
        for (const x of shared) if (liftable(x) && worth(x)) hoist(x)
        if (!hoisted.size) {
            let arms: number[] | undefined
            for (let i = 1; i < 3; i++) {
                const arm = getRef(n, i)
                const next = process(arm, here, loop)
                if (next === arm) continue
                arms ??= getArgIds(n)
                arms[i] = next
            }
            return arms ? createNode(g, NodeOp.select, arms.map((id, i) => id || literal(g, getLiteral(g, n, i))), n) : tail
        }
        const condition = new Set<number>()
        function fusable(id: number): boolean {
            const m = id ? getNode(g, id) : undefined
            if (!m) return false
            const ok = CompareOps.has(m.op)
                || ((m.op === NodeOp.and || m.op === NodeOp.or) && fusable(getRef(m, 0)) && fusable(getRef(m, 1)))
            if (ok) condition.add(id)
            return ok
        }
        fusable(getRef(n, 0))
        const inside = new Set<number>([tail])
        const cut: number[] = []
        const cutSet = new Set<number>()
        const stack = [tail]
        while (stack.length) {
            const m = getNode(g, stack.pop()!)!
            for (let i = m.op === NodeOp.apply ? 1 : 0; i < countIds(m); i++) {
                const r = getRef(m, i)
                const u = r ? getNode(g, r) : undefined
                if (!r || outer(u)) continue
                if (m.op === NodeOp.after && i < countIds(m) - 1 && here.has(r) && !condition.has(r)) continue
                if (u!.op === NodeOp.param || (here.has(r) && !condition.has(r)) || hoisted.has(r) || (u!.op === NodeOp.get && here.has(getRef(u!, 0)))) {
                    if (!cutSet.has(r)) {
                        cutSet.add(r)
                        cut.push(r)
                    }
                    continue
                }
                if (inside.has(r)) continue
                inside.add(r)
                stack.push(r)
            }
        }
        if (cut.length > maxForwardParams) {
            let arms: number[] | undefined
            for (let i = 1; i < 3; i++) {
                const arm = getRef(n, i)
                const next = process(arm, here, loop)
                if (next === arm) continue
                arms ??= getArgIds(n)
                arms[i] = next
            }
            return arms ? createNode(g, NodeOp.select, arms.map((id, i) => id || literal(g, getLiteral(g, n, i))), n) : tail
        }
        const params = new Map<number, number>()
        for (const r of cut) {
            const p = addNode(g, NodeOp.param, [], valueType(g, getNode(g, r)!))
            params.set(r, p)
        }
        const copies = new Map<number, number>()
        function copy(id: number): number {
            if (!id) return id
            const param = params.get(id)
            if (param !== undefined) return param
            const known = copies.get(id)
            if (known !== undefined) return known
            if (!inside.has(id)) return id
            const m = getNode(g, id)!
            if (m.op === NodeOp.after) {
                const last = countIds(m) - 1
                const kept = getArgIds(m).flatMap((r, i) => i === last || !r || params.has(r) || inside.has(r) ? [i] : [])
                if (kept.length === 1 && getRef(m, last)) {
                    const c = copy(getRef(m, last))
                    copies.set(id, c)
                    return c
                }
                if (kept.length <= last) {
                    const c = createNode(g, NodeOp.after, kept.map(i => copy(getRef(m, i)) || literal(g, getLiteral(g, m, i))), m)
                    copies.set(id, c)
                    return c
                }
            }
            const ids = getArgIds(m)
            for (let i = m.op === NodeOp.apply ? 1 : 0; i < ids.length; i++) ids[i] = copy(ids[i])
            const c = addCopy(g, m, withRefs(g, m, ids))
            copies.set(id, c)
            return c
        }
        const body = copy(tail)
        const blockId = createNode(g, NodeOp.block, [])
        const block = { id: blockId, params: cut.map(r => params.get(r)!), bodyId: body, bodyConst: 0 }
        addGraphBlock(g, block)
        block.bodyId = process(body, new Set(), loop)
        return createNode(g, NodeOp.apply, [blockId, ...cut])
    }
    for (const b of g.blocks.slice()) b.bodyId = process(b.bodyId, new Set(), b.id)
    return g
}

function isolateSelectArms(g: Graph): Graph {
    const selects = new Set<number>()
    function walk(id: number, shared: Set<number>, tail = true): void {
        if (!id) return
        const n = getNode(g, id)!
        if (!tail) {
            if (shared.has(id)) return
            shared.add(id)
            for (let i = 0; i < countIds(n); i++) {
                walk(getRef(n, i), shared, false)
            }
            return
        }
        // if (n.op === 'after') {
        //     for (let i = 0; i < countIds(n) - 1; i++) {
        //         walk(getRef(n, i), shared, false)
        //     }
        //     return walk(getRef(n, countIds(n) - 1), shared, tail)
        // }
        if (n.op !== NodeOp.select) return
        walk(getRef(n, 0), shared, false)
        selects.add(id)
    }
    function cloneInterior(arm: number, shared: Set<number>) {
        if (shared.has(arm)) return arm
        const epoch = nextEpoch(g)
        const order: number[] = [arm]
        const stack: number[] = [arm]
        const targets: number[] = []
        markVisited(getNode(g, arm)!, epoch)
        while (const next = stack.pop()) {
            const u = getNode(g, next)!
            for (const r of gn.enumerateRefs(u)) {
                const t = getNode(g, r)!
                if (t.op === NodeOp.block || t.op === NodeOp.param || t.op === NodeOp.nilEffect) continue
                if (TargetingValues.has(t.op)) {
                    targets.push(r)
                    continue
                }
                if (!markVisited(t, epoch)) continue
                if (shared.has(r)) continue
                order.push(r)
                stack.push(r)
            }
        }
        function share(id: number): void {
            if (shared.has(id)) return
            shared.add(id)
            for (const r of gn.enumerateRefs(getNode(g, id)!)) share(r)
        }
        for (const t of targets) share(t)
        const r = new Map<number, number>()
        function visit(vid: number) {
            if (!vid) return vid
            if (const replacement = r.get(vid)) return replacement
            if (shared.has(vid)) return vid
            const u = getNode(g, vid)!
            if (u.epoch !== epoch) return vid
            const slots = u.slots.slice()
            for (let i = 0; i < gn.countIds(u); i++) {
                const s = gn.getRef(u, i)
                if (!s) continue
                slots[i] = gn.encodeSlot(g, visit(s), 0) as u32
            }
            const id = insertNode(g, gn.makeNodeFromSlots(u.op, slots, u.flags))
            r.set(vid, id)
            return id
        }
        return visit(arm)
    }
    function visitRegion(vid: number, shared?: Set<number>) {
        selects.clear()
        const active = new Set(shared)
        walk(vid, active)
        const rem: number[] = []
        for (const s of selects) {
            const u = getNode(g, s)!
            for (let i = 1; i < countIds(u); i++) {
                const arm = getRef(u, i)
                if (!arm) continue
                const newArm = cloneInterior(arm, active)
                setRef(u, i, newArm)
                rem.push(newArm)
            }
        }
        for (const x of rem) visitRegion(x, active)
    }
    for (let i = 0; i < g.blocks.length; i++) {
        visitRegion(g.blocks[i].bodyId)
    }
    return g
}

function splitTailSelects(g: Graph): Graph {
    let currentBlock: GraphBlock
    function walk(id: number, uses: Map<number, number>): void {
        if (!id) return
        const n = getNode(g, id)!
        if (n.op === NodeOp.after) return walk(getRef(n, countIds(n) - 1), uses)
        if (n.op !== NodeOp.select) return
        if (uses.get(id) !== 1) return
        for (let k = 1; k < countIds(n); k++) {
            const arm = getRef(n, k)
            if (!arm) continue
            const u = getNode(g, tailOf(g, arm))!
            const armOp = u.op
            if (armOp === NodeOp.ret) return
            if (armOp !== NodeOp.select) continue
            const params = new Set<number>()
            const covered = coveredRegion(g, uses, arm, params)
            if (!covered) {
                walk(arm, uses)
                continue
            }
            const moved = moveRegion(g, [...params].sort((a, b) => currentBlock.params.indexOf(a) - currentBlock.params.indexOf(b)), arm)
            setRef(n, k, moved)
        }
    }
    for (let i = 0; i < g.blocks.length; i++) {
        const b = g.blocks[i]
        currentBlock = b
        const uses = countUses(g, b.bodyId)
        walk(b.bodyId, uses)
    }
    return g
}

const FreeValues = new Set([NodeOp.apply, NodeOp.select, NodeOp.after, NodeOp.ret, NodeOp.unreachable, NodeOp.panic])
const MaxRotatedCycles = 8
const IssueWidth = 4

function blockValues(g: Graph, bodyId: number): number[] {
    const out: number[] = []
    const seen = new Set<number>()
    const stack = [bodyId]
    while (stack.length) {
        const id = stack.pop()!
        const n = id ? getNode(g, id) : undefined
        if (!n || seen.has(id) || n.op === NodeOp.param || n.op === NodeOp.block) continue
        seen.add(id)
        out.push(id)
        for (const x of getArgIds(n)) stack.push(x)
    }
    return out
}

function cloneValues(g: Graph, id: number, r: Map<number, number>): number {
    const known = r.get(id)
    if (known !== undefined) return known
    const n = getNode(g, id)!
    if (n.op === NodeOp.param || n.op === NodeOp.block || n.op === NodeOp.literal || n.op === NodeOp.void) return id
    const ids = cloneRefs(n).map(x => x && cloneValues(g, x, r))
    const out = addCopy(g, n, withRefs(g, n, ids))
    r.set(id, out)
    return out
}

export function joinEffects(g: Graph, ids: number[]): number {
    return ids.length === 1 ? ids[0] : createNode(g, NodeOp.after, [...ids, createNode(g, NodeOp.void, [])])
}

function loopStayArm(g: Graph, select: GraphNode | undefined, members: Set<number>): number {
    if (select?.op !== NodeOp.select || countIds(select) !== 3) return 0
    const stays = [1, 2].filter(i => tailPositions(g, getRef(select, i)).some(p => {
        const n = getNode(g, p.at)!
        return n.op === NodeOp.apply && members.has(getRef(n, 0))
    }))
    return stays.length === 1 ? stays[0] : 0
}

function bareArm(g: Graph, owner: GraphBlock, arm: number): boolean {
    const n = getNode(g, arm)
    if (n?.op !== NodeOp.apply) return false
    for (let i = 1; i < countIds(n); i++) if (!owner.params.includes(getRef(n, i))) return false
    return true
}

function outlineHeaderArm(g: Graph, h: GraphBlock, tail: GraphNode, at: number): number {
    const arm = outlineArm(g, countUses(g, h.bodyId), getRef(tail, at))
    if (!arm) return 0
    setRef(tail, at, arm)
    return getRef(getNode(g, arm)!, 0)
}

function exitsFromBody(g: Graph, hid: number, members: Set<number>): boolean {
    for (const b of g.blocks) {
        if (b.id === hid || !members.has(b.id)) continue
        for (const p of tailPositions(g, b.bodyId)) {
            const n = getNode(g, p.at)!
            if (n.op !== NodeOp.apply || !members.has(getRef(n, 0))) return true
        }
    }
    return false
}

function iterationCost(g: Graph, costs: lowering.TargetCosts, hid: number, members: Set<number>, nested: Set<number>): [chain: number, size: number] {
    const blocks = new Map<number, GraphBlock>()
    for (const b of g.blocks) if (members.has(b.id)) blocks.set(b.id, b)
    const targets = new Map<number, number[]>()
    for (const [id, b] of blocks) {
        targets.set(id, tailPositions(g, b.bodyId).map(p => p.at).filter(at => {
            const n = getNode(g, at)!
            return n.op === NodeOp.apply && members.has(getRef(n, 0))
        }))
    }
    const open = new Set<number>()
    const closed = new Set<number>()
    const post: number[] = []
    const forward = new Set<number>()
    function visit(id: number): void {
        open.add(id)
        for (const app of targets.get(id)!) {
            const t = getRef(getNode(g, app)!, 0)
            if (!open.has(t)) forward.add(app)
            if (open.has(t) || closed.has(t)) continue
            visit(t)
        }
        open.delete(id)
        closed.add(id)
        post.push(id)
    }
    visit(hid)
    const header = blocks.get(hid)!
    const backs: number[] = []
    for (const id of post) for (const app of targets.get(id)!) if (getRef(getNode(g, app)!, 0) === hid) backs.push(app)
    function recurrence(slot: number): number {
        const paramDepth = new Map<number, number>([[header.params[slot], 0]])
        const depths = new Map<number, number>()
        function depthOf(id: number): number {
            const known = depths.get(id)
            if (known !== undefined) return known
            const n = getNode(g, id)
            let d = -Infinity
            if (n?.op === NodeOp.param) d = paramDepth.get(id) ?? -Infinity
            else if (n?.op === NodeOp.after) d = depthOf(getRef(n, countIds(n) - 1))
            else if (n && n.op !== NodeOp.block && !isArgless(n)) {
                const ids = getArgIds(n)
                for (let i = OrderedValues.has(n.op) ? 1 : 0; i < ids.length; i++) if (ids[i]) d = Math.max(d, depthOf(ids[i]))
                d += latency(costs, n.op)
            }
            depths.set(id, d)
            return d
        }
        for (let i = post.length - 1; i >= 0; i--) {
            for (const app of targets.get(post[i])!) {
                const n = getNode(g, app)!
                const t = getRef(n, 0)
                if (t === hid || !forward.has(app)) continue
                const into = blocks.get(t)!
                getArgIds(n).slice(1).forEach((x, k) => {
                    if (x) paramDepth.set(into.params[k], Math.max(paramDepth.get(into.params[k]) ?? -Infinity, depthOf(x)))
                })
            }
        }
        let out = 0
        for (const app of backs) {
            const x = getRef(getNode(g, app)!, slot + 1)
            if (x) out = Math.max(out, depthOf(x))
        }
        return out
    }
    let chain = 0
    for (let k = 0; k < header.params.length; k++) chain = Math.max(chain, recurrence(k))
    let size = 0
    for (const b of blocks.values()) {
        if (nested.has(b.id)) continue
        for (const id of blockValues(g, b.bodyId)) {
            const n = getNode(g, id)!
            if (!isArgless(n) && !FreeValues.has(n.op) && latency(costs, n.op) > 0) size++
        }
    }
    return [chain, size]
}

function outlineLoopArms(g: Graph): Graph {
    for (const [hid, members] of graphLoops(g).loopMembers) {
        const h = getBlock(g, hid)!
        assert(h !== g.blocks[0])
        if (exitsFromBody(g, hid, members)) continue
        const tail = getNode(g, h.bodyId)
        const stay = loopStayArm(g, tail, members)
        if (!stay || bareArm(g, h, getRef(tail!, stay))) continue
        outlineHeaderArm(g, h, tail!, stay)
    }
    return g
}

function rotateLoops(g: Graph, costs: lowering.TargetCosts): Graph {
    const stats = intrinsics.argv().includes('rot-stats')
    const loops = graphLoops(g)
    for (const [hid, members] of loops.loopMembers) {
        const h = getBlock(g, hid)!
        const stay = loopStayArm(g, getNode(g, h.bodyId), members)
        assert(h !== g.blocks[0])
        if (!stay || members.size === 1) continue
        if (!exitsFromBody(g, hid, members)) continue
        const nested = new Set<number>()
        for (const [other, blocks] of loops.loopMembers) if (other !== hid && members.has(other)) for (const x of blocks) nested.add(x)
        const [chain, size] = iterationCost(g, costs, hid, members, nested)
        if (Math.max(chain, size / IssueWidth) > MaxRotatedCycles) continue
        const rotated = rotateLoop(g, h, stay, members, loops.preds.get(hid)!)
        if (stats && rotated) console.log(`rot-stats ${g.name} h=${hid} chain=${chain} size=${size} members=${members.size}`)
    }
    return g
}

function rotateLoop(g: Graph, h: GraphBlock, stay: number, members: Set<number>, preds: number[]): boolean {
    const hid = h.id
    const tail = getNode(g, h.bodyId)!
    let body = 0
    for (const at of [stay, 3 - stay]) {
        if (bareArm(g, h, getRef(tail, at))) continue
        const block = outlineHeaderArm(g, h, tail, at)
        if (!block) return false
        if (at === stay) body = block
    }
    const latches: [GraphBlock, TailPosition][] = []
    for (const id of new Set([...preds.filter(x => x !== hid), ...(body ? [body] : [])])) {
        const b = getBlock(g, id)!
        for (const p of tailPositions(g, b.bodyId)) {
            const n = getNode(g, p.at)!
            if (n.op !== NodeOp.apply || getRef(n, 0) !== hid) continue
            if (members.has(id) || id === body) latches.push([b, p])
        }
    }
    const values = blockValues(g, h.bodyId)
    if (values.filter(id => !isArgless(getNode(g, id)!)).length > 8) return false
    const nils = values.filter(id => getNode(g, id)!.op === NodeOp.nilEffect)
    if (latches.length > 1) {
        const params = h.params.map(x => {
            return addCopy(g, getNode(g, x)!)
        })
        const join = createNode(g, NodeOp.block, [])
        const bodyId = createNode(g, NodeOp.apply, [hid, ...params])
        const block = { id: join, params, bodyId, bodyConst: 0 }
        addGraphBlock(g, block)
        for (const [b, p] of latches) {
            const app = getNode(g, p.at)!
            const operands = getOperands(g, app)
            operands[0] = join
            const redirected = addCopy(g, app, operands)
            b.bodyId = replaceAll(g, b.bodyId, new Map([[p.at, redirected]]))
        }
        latches.length = 0
        latches.push([block, tailPositions(g, bodyId)[0]])
    }
    if (nils.length) for (const [, p] of latches) {
        const covered = new Set(p.tokens)
        const seen = new Set<number>()
        const stack = tailRoots(g, p).filter(x => !covered.has(x))
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id) || covered.has(id)) continue
            seen.add(id)
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
            if (OrderedValues.has(n.op) && n.op !== NodeOp.load) return false
            for (const x of getArgIds(n)) stack.push(x)
        }
    }
    for (const [b, p] of latches) {
        const app = getNode(g, p.at)!
        const r = new Map<number, number>()
        h.params.forEach((param, i) => r.set(param, getRef(app, i + 1) || createNode(g, NodeOp.literal, [literal(g, getLiteral(g, app, i + 1))])))
        const state = p.tokens.length ? joinEffects(g, p.tokens) : createNode(g, NodeOp.nilEffect, [])
        for (const id of nils) r.set(id, state)
        b.bodyId = replaceAll(g, b.bodyId, new Map([[p.at, cloneValues(g, h.bodyId, r)]]))
    }
    return true
}

export function cloneExits(g: Graph): Graph {
    const exits = new Map<number, number>()
    for (const b of g.blocks) {
        const ret = getNode(g, b.bodyId)
        if (ret?.op !== NodeOp.ret) continue
        const at = b.params.indexOf(getRef(ret!, 0))
        if (at >= 0 || !getRef(ret!, 0)) exits.set(b.id, at)
    }
    if (!exits.size) return g
    for (const b of g.blocks.slice()) {
        if (exits.has(b.id)) continue
        const uses = countUses(g, b.bodyId)
        function walk(id: number): void {
            const n = getNode(g, id)
            if (!n) return
            if (n.op === NodeOp.after) return walk(getRef(n, countIds(n) - 1))
            if (n.op === NodeOp.apply && exits.has(getRef(n, 0))) {
                putRet(g, id, exits, n, x => x)
                return
            }
            if (n.op !== NodeOp.select) return
            for (let i = 1; i < countIds(n); i++) {
                const arm = getRef(n, i)
                const t = getNode(g, tailOf(g, arm))
                const at = t?.op === NodeOp.apply ? exits.get(getRef(t, 0)) : undefined
                const returned = at !== undefined && at >= 0 ? getNode(g, getRef(t!, at + 1)) : undefined
                const outlined = at !== undefined && returned?.op !== NodeOp.call && uses.get(arm) === 1 ? outlineArm(g, uses, arm, exits) : 0
                if (outlined) setRef(n, i, outlined)
                else walk(arm)
            }
        }
        walk(b.bodyId)
    }
    return g
}

function checkCreationOrder(g: Graph, stage: string, known: Set<string>) {
    const epoch = nextEpoch(g)
    const stack: number[] = []
    const found: string[] = []
    for (const b of g.blocks) stack.push(b.bodyId)
    while (stack.length) {
        const id = stack.pop()!
        if (!id) continue
        const n = getNode(g, id)
        if (!n || !markVisited(n, epoch)) continue
        for (const a of getArgIds(n)) {
            if (!a) continue
            stack.push(a)
            if (a < id) continue
            const u = getNode(g, a)
            if (!u || getArgIds(u).every(x => !x)) continue
            const key = `${id}:${a}`
            if (known.has(key)) continue
            known.add(key)
            found.push(`%${id} = ${opName(n.op)} uses %${a} = ${opName(u.op)}`)
        }
    }
    if (!found.length) return
    console.log(`creation order: ${g.name || '<anonymous>'} after ${stage}: ${found.length} new\n  ${found.slice(0, 8).join('\n  ')}`)
}

function errorDump(g: Graph): string {
    return dumpGraph(g)
}

function checkCaptures(g: Graph) {
    if (!intrinsics.argv().includes('check-captures')) return
    const owners = new Map<number, number>()
    for (const b of g.blocks) for (const p of b.params) owners.set(p, b.id)

    const succs = new Map<number, Set<number>>()
    const used = new Map<number, Set<number>>()
    let targets = new Set<number>()
    let params = new Set<number>()
    let epoch = 0
    function scan(n: GraphNode, id: number) {
        if (!markVisited(n, epoch)) return
        if (n.op === NodeOp.block) {
            targets.add(id)
            return
        }
        if (n.op === NodeOp.param) {
            params.add(id)
            return
        }
        forEachOperand(g, id, scan)
    }
    for (const b of g.blocks) {
        targets = new Set<number>()
        params = new Set<number>()
        epoch = nextEpoch(g)
        succs.set(b.id, targets)
        used.set(b.id, params)
        if (const body = getNode(g, b.bodyId)) scan(body, b.bodyId)
    }

    const entry = g.root
    const order: number[] = []
    const seen = new Set<number>([entry])
    const pending = [entry]
    while (pending.length) {
        const id = pending.pop()!
        order.push(id)
        for (const s of succs.get(id) ?? []) {
            if (seen.has(s)) continue
            seen.add(s)
            pending.push(s)
        }
    }
    const preds = new Map<number, number[]>()
    for (const id of order) preds.set(id, [])
    for (const id of order) {
        for (const s of succs.get(id) ?? []) {
            if (seen.has(s)) preds.get(s)!.push(id)
        }
    }
    const dominators = new Map<number, Set<number>>()
    for (const id of order) dominators.set(id, new Set<number>(id === entry ? [entry] : order))
    let changed = true
    while (changed) {
        changed = false
        for (const id of order) {
            if (id === entry) continue
            const incoming = preds.get(id)!
            if (!incoming.length) continue
            const next = new Set<number>()
            for (const x of dominators.get(incoming[0])!) {
                let all = true
                for (let i = 1; i < incoming.length; i++) {
                    if (dominators.get(incoming[i])!.has(x)) continue
                    all = false
                    break
                }
                if (all) next.add(x)
            }
            next.add(id)
            if (next.size === dominators.get(id)!.size) continue
            dominators.set(id, next)
            changed = true
        }
    }

    for (const id of order) {
        for (const p of used.get(id) ?? []) {
            const owner = owners.get(p)
            if (owner === undefined || owner === id) continue
            if (dominators.get(id)!.has(owner)) continue
            console.log(errorDump(g))
            throw `lowering2: ${g.name || '<anonymous>'} impossible capture of %${p} owned by B${owner} used in B${id}`
        }
    }
}

export function resolveNumberTypes(g: Graph) {
    const floats = floatValues(g)
    const entry = new Set(g.blocks[0]?.params ?? [])
    const arrivals = new Map<number, Operand[]>()
    for (const n of g.nodes.values()) {
        if (n.op !== NodeOp.apply) continue
        getBlock(g, getRef(n, 0))?.params.forEach((p, i) => {
            const list = arrivals.get(p)
            if (list) list.push(getOperand(g, n, i + 1))
            else arrivals.set(p, [getOperand(g, n, i + 1)])
        })
    }
    const resolved = new Map<number, Types>()
    function signed(x: Operand): boolean {
        if (typeof x !== 'number') return x.literal < 0
        const n = getNode(g, x)
        if (n?.op === NodeOp.select) return getOperands(g, n).slice(1).some(signed)
        if (n?.op === NodeOp.after) return signed(getOperand(g, n, countIds(n) - 1))
        if (!n) return false
        const T = typeSlots(n.op) ? resolve(x, n) : resultType(g, n)
        return T === Types.f64 || lowering.isSignedType(T)
    }
    function resolve(id: number, n: GraphNode): Types {
        const known = resolved.get(id)
        if (known !== undefined) return known
        resolved.set(id, typeOf(n) === Types.unknown_number ? Types.u64 : typeOf(n))
        let T = typeOf(n)
        if (floats.has(id)) T = Types.f64
        else if (T === Types.unknown_number) T = n.op === NodeOp.sub || getOperands(g, n).some(signed) ? Types.i64 : Types.u64
        else if (n.op === NodeOp.param && T === Types.u64 && !entry.has(id) && (arrivals.get(id) ?? []).some(signed)) T = Types.i64
        resolved.set(id, T)
        return T
    }
    for (const [id, n] of g.nodes) {
        if (!typeSlots(n.op)) continue
        const T = resolve(id, n)
        if (typeOf(n) === T) continue
        retypeNode(g, id, T)
    }
    function asFloat(x: Operand): Operand {
        if (typeof x !== 'number') {
            if (!x.literal || !Number.isInteger(x.literal)) return x
            return addNode(g, NodeOp.literal, [x], Types.f64)
        }
        if (floats.has(x)) return x
        const n = getNode(g, x)!
        const id = newId(g)
        if (n.op === NodeOp.after) {
            const operands = getOperands(g, n)
            operands[operands.length - 1] = asFloat(operands[operands.length - 1])
            putCopy(g, id, n, operands)
        } else {
            putNode(g, id, NodeOp.convert, [x], Types.f64)
        }
        return id
    }
    function asInteger(x: Operand): Operand {
        if (typeof x !== 'number') {
            if (Number.isInteger(x.literal)) return x
            const k = Math.trunc(x.literal) || 0
            if (Number.isSafeInteger(k)) return { literal: k }
            return addNode(g, NodeOp.convert, [addNode(g, NodeOp.literal, [x], Types.f64)], Types.i64)
        }
        if (!floats.has(x)) return x
        return addNode(g, NodeOp.convert, [x], Types.i64)
    }
    function consume(id: number, n: GraphNode, slots: number[], as: (x: Operand) => Operand): void {
        const operands = getOperands(g, n)
        let changed = false
        for (const i of slots) {
            const x = as(operands[i])
            if (x === operands[i]) continue
            operands[i] = x
            changed = true
        }
        if (changed) putCopy(g, id, n, operands)
    }
    let returnsFloat = false
    for (const n of g.nodes.values()) {
        if (n.op === NodeOp.ret && (getRef(n, 0) ? floats.has(getRef(n, 0)) : !Number.isInteger(getLiteral(g, n, 0)))) returnsFloat = true
    }
    for (const [id, n] of [...g.nodes]) {
        if (n.op === NodeOp.apply) {
            const params = getBlock(g, getRef(n, 0))?.params ?? []
            consume(id, n, params.flatMap((p, i) => floats.has(p) ? [i + 1] : []), asFloat)
        } else if (n.op === NodeOp.select && floats.has(id)) {
            consume(id, n, Array.from({ length: countIds(n) - 1 }, (_, i) => i + 1), asFloat)
        } else if (n.op === NodeOp.store) {
            consume(id, n, [2], asInteger)
            if (typeOf(n) === Types.f64) consume(id, getNode(g, id)!, [3], asFloat)
        } else if (n.op === NodeOp.load) {
            consume(id, n, [2], asInteger)
        } else if (n.op === NodeOp.pstack) {
            consume(id, n, [3], asInteger)
        } else if (n.op === NodeOp.ret && returnsFloat) {
            consume(id, n, [0], asFloat)
        } else if (BitwiseOps.has(n.op)) {
            consume(id, n, Array.from({ length: countIds(n) }, (_, i) => i), asInteger)
        } else if (n.op === NodeOp.crc32) {
            consume(id, n, [0, 1], asInteger)
        } else if (n.op === NodeOp.clz) {
            consume(id, n, [0], asInteger)
        } else if (n.op === NodeOp.rt && rt.wordOps.has(getLiteral(g, n, 1))) {
            consume(id, n, [2], asInteger)
        }
    }
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.typeof) continue
        putNode(g, id, NodeOp.literal, [{ literal: operandType(g, n, 0) }])
    }
    return g
}

type GraphPass = (g: Graph, costs: lowering.TargetCosts) => Graph | boolean | void

function runPipeline(stage: string, g: Graph, costs: lowering.TargetCosts, passes: GraphPass[]): { graph: Graph, changed: boolean } {
    const dumpBefore = debugsGraph('graph-debug', g)
    const dumpChanged = debugsGraph('pass-debug', g)
    const cost = intrinsics.argv().includes('graph-transform-cost')
    const costThreshold = Number(intrinsics.argv().find(x => x.startsWith('perf-thresh:'))?.slice(12) ?? 1)
    const violations = intrinsics.argv().includes('check-creation-order') ? new Set<string>() : undefined
    const start = performance.now()
    let changed = false
    let unknown = false
    for (const pass of passes) {
        if (disabledPasses.has(pass.name)) continue
        const key = `${stage}:${pass.name}`
        if (dumpBefore) console.log(`before transform: ${key}\n`, dumpGraph(g))
        const nodesBefore = g.nodes.size
        const passStart = performance.now()
        let result: Graph | boolean | void
        try {
            result = pass(g, costs)
        } catch (err) {
            console.log(errorDump(g))
            throw err
        }
        const elapsed = performance.now() - passStart
        if (result && result !== true) g = result
        const reported = result === true
        changed ||= reported
        unknown ||= typeof result !== 'boolean'
        recordPass(key, elapsed, typeof result === 'boolean' ? result : undefined)
        if (cost && elapsed >= costThreshold) console.log('graph transform cost', g.name || '<anonymous>', key, `${elapsed.toFixed(3)}ms`, `${nodesBefore}->${g.nodes.size}`)
        if (dumpChanged && reported) console.log(`--- ${key} changed ---\n${dumpGraph(g)}`)
        if (violations) checkCreationOrder(g, key, violations)
        checkCaptures(g)
        if (g.form) verifyGraph(g, key, true)
    }
    recordPass(`${stage}:(total)`, performance.now() - start, changed ? true : unknown ? undefined : false)
    return { graph: g, changed }
}

function expectForm(g: Graph, stage: string, ...forms: (GraphForm | undefined)[]): void {
    assert(forms.includes(g.form), `lowering: ${stage} cannot run on a ${g.form ?? 'traced'} graph`)
}

export function optimizePackaged(g: Graph, target: lowering.Target): Graph {
    expectForm(g, 'optimize', 'packaged', 'optimized')
    g = runPipeline('optimize', g, target.costs, [optimizeValueGraph]).graph
    g.form = 'optimized'
    return g
}

export function packageValueGraph(g: Graph, target: lowering.Target, entries?: Set<number>): Graph {
    expectForm(g, 'package', undefined)
    checkCaptures(g)
    if (intrinsics.argv().includes('check-creation-order')) checkCreationOrder(g, 'trace', new Set())
    const _bindCallContext: GraphPass = g => bindCallContext(g, target.indirectContextReg)
    const _packageBlocks: GraphPass = g => packageBlocksFINAL(g, entries)
    g = runPipeline('package', g, target.costs, [_bindCallContext, splitBranchingSelects, inlineBlocks, sweepBlocks, resolveNumberTypes, detachRecordOrdering, flattenRecords, _packageBlocks, pruneDeadParams, sweepBlocks]).graph
    g.form = 'packaged'
    verifyGraph(g, 'package', true)
    return g
}

function pruneDeadParams(g: Graph): boolean {
    const owner = new Map<number, number>()
    for (const b of g.blocks) b.params.forEach(p => owner.set(p, b.id))
    const used = new Set<number>()
    const feeds = new Map<number, number[]>()
    const applies: number[] = []
    const reached = new Set<number>()
    const stack = g.blocks.map(b => b.bodyId)
    while (stack.length) {
        const id = stack.pop()!
        const n = id && !reached.has(id) ? getNode(g, id) : undefined
        if (!n || n.op === NodeOp.block) continue
        reached.add(id)
        const target = n.op === NodeOp.apply ? getBlock(g, getRef(n, 0)) : undefined
        if (target) applies.push(id)
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            stack.push(ref)
            if (!target || !i) used.add(ref)
            else if (owner.has(ref)) {
                const list = feeds.get(target.params[i - 1])
                if (list) list.push(ref)
                else feeds.set(target.params[i - 1], [ref])
            }
        }
    }
    const live = new Set<number>()
    const work: number[] = []
    for (const b of g.blocks) {
        for (const p of b.params) {
            if (b.id !== g.root && !used.has(p)) continue
            live.add(p)
            work.push(p)
        }
    }
    while (work.length) {
        for (const p of feeds.get(work.pop()!) ?? []) {
            if (live.has(p)) continue
            live.add(p)
            work.push(p)
        }
    }
    const cut = new Map<number, Set<number>>()
    for (const b of g.blocks) {
        const dead = new Set<number>()
        b.params.forEach((p, i) => { if (!live.has(p)) dead.add(i + 1) })
        if (dead.size) cut.set(b.id, dead)
    }
    if (!cut.size) return false
    for (const id of applies) {
        const n = getNode(g, id)!
        const dead = cut.get(getRef(n, 0))
        if (!dead) continue
        const kept: Operand[] = []
        const effects = new Set<number>()
        const seen = new Set<number>()
        const frontier: number[] = []
        getOperands(g, n).forEach((x, i) => {
            if (!dead.has(i)) kept.push(x)
            else if (typeof x === 'number') frontier.push(x)
        })
        while (frontier.length) {
            const x = frontier.pop()!
            const m = x && !seen.has(x) ? getNode(g, x) : undefined
            if (!m || m.op === NodeOp.param || m.op === NodeOp.block) continue
            seen.add(x)
            if ((OrderedValues.has(m.op) && m.op !== NodeOp.load) || m.op === NodeOp.panic || m.op === NodeOp.unreachable) effects.add(x)
            else for (let i = 0; i < countIds(m); i++) frontier.push(getRef(m, i))
        }
        if (effects.size) {
            const implied = new Set<number>()
            const walk: number[] = []
            for (const x of kept) if (typeof x === 'number') walk.push(x)
            for (const e of effects) {
                const m = getNode(g, e)!
                for (let i = 0; i < countIds(m); i++) walk.push(getRef(m, i))
            }
            while (walk.length) {
                const x = walk.pop()!
                const m = x && !implied.has(x) ? getNode(g, x) : undefined
                if (!m || m.op === NodeOp.param || m.op === NodeOp.block) continue
                implied.add(x)
                for (let i = 0; i < countIds(m); i++) walk.push(getRef(m, i))
            }
            for (const e of effects) if (implied.has(e)) effects.delete(e)
        }
        if (!effects.size) putCopy(g, id, n, kept)
        else putNode(g, id, NodeOp.after, [...effects, addCopy(g, n, kept)])
    }
    for (const b of g.blocks) if (cut.has(b.id)) b.params = b.params.filter(p => live.has(p))
    return true
}

export function normalizeValueGraph(g: Graph, opts: { firstPass?: boolean, target?: lowering.Target } = {}): Graph {
    const target = opts.target ?? lowering.hostTarget
    g = packageValueGraph(g, target)
    if (opts.firstPass && isJumbo(g)) return g
    return optimizePackaged(g, target)
}

function demotePstacks(g: Graph): boolean {
    const demotable = (n: GraphNode) => pstackFixedSize(g, n) > 0
    let any = false
    for (const n of g.nodes.values()) if (demotable(n)) { any = true; break }
    if (!any) return false
    const mem = memAnalysis(g)
    const { loopDepth, loopsOf } = graphLoops(g)
    const owner = new Map<number, number>()
    const bodies = new Set<number>()
    for (const b of g.blocks) {
        bodies.add(b.bodyId)
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || owner.has(id)) continue
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.param) continue
            owner.set(id, b.id)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    const loadsFrom = new Map<number, number[]>()
    for (const [id, n] of g.nodes) {
        if (n.op !== NodeOp.load || !getRef(n, 1)) continue
        const base = mem.of(getRef(n, 1)).base
        const list = loadsFrom.get(base)
        if (list) list.push(id)
        else loadsFrom.set(base, [id])
    }
    const container = (id: number) => {
        const n = getNode(g, id)
        return n?.op === NodeOp.pstack && !pstackRebases(g, n)
    }
    const verdicts = new Map<number, boolean>()
    function escapes(root: number, headers?: Set<number>): boolean {
        const known = headers ? undefined : verdicts.get(root)
        if (known !== undefined) return known
        if (!headers) verdicts.set(root, true)
        const seen = new Set<number>([root])
        const work = [root]
        const follow = (x: number) => {
            if (seen.has(x)) return
            seen.add(x)
            work.push(x)
        }
        let escaped = false
        while (work.length && !escaped) {
            const x = work.pop()!
            for (const u of mem.users(x)) {
                const n = getNode(g, u)!
                const ordering = firstNonOrderingSlot(n)
                for (let i = ordering; i < countIds(n) && !escaped; i++) {
                    if (getRef(n, i) !== x) continue
                    if (n.op === NodeOp.load) continue
                    if (n.op === NodeOp.store) {
                        if (i !== 3) continue
                        if (headers) { escaped = true; break }
                        const into = mem.of(getRef(n, 1)).base
                        if (into === root || !container(into) || escapes(into)) { escaped = true; break }
                        if (mem.flows(into, true).calls.some(([call, k]) => hasArg((callSummary(g, getNode(g, call)!) ?? unknownCall).deepCaptures, k))) { escaped = true; break }
                        for (const l of loadsFrom.get(into) ?? []) follow(l)
                    } else if (n.op === NodeOp.call) {
                        if (i < 3 || hasArg((callSummary(g, n) ?? unknownCall).captures, i - 3)) escaped = true
                    } else if (n.op === NodeOp.apply) {
                        const param = getBlock(g, getRef(n, 0))?.params[i - 1]
                        if (param === undefined || headers?.has(getRef(n, 0))) escaped = true
                        else follow(param)
                    } else if (n.op === NodeOp.encode) {
                        escaped = true
                    } else if (n.op === NodeOp.after || n.op === NodeOp.select || (PureOps.has(n.op) && !TargetingValues.has(n.op))) {
                        follow(u)
                    } else if (!CompareOps.has(n.op)) {
                        escaped = true
                    }
                }
                if (escaped) break
            }
        }
        if (!headers) verdicts.set(root, escaped)
        return escaped
    }
    const candidates = new Set<number>()
    const iterationLocal = new Set<number>()
    const forever = ![...g.nodes.values()].some(n => n.op === NodeOp.ret)
    for (const [id, n] of g.nodes) {
        if (!demotable(n)) continue
        if (bodies.has(id)) continue
        if (!loopDepth.get(owner.get(id) ?? -1)) {
            if (forever || !escapes(id)) candidates.add(id)
            continue
        }
        if (escapes(id, new Set(loopsOf.get(owner.get(id)!) ?? []))) continue
        candidates.add(id)
        iterationLocal.add(id)
    }
    if (!candidates.size) return false
    const tokenOf = (id: number): Operand => {
        let operand = getOperand(g, getNode(g, id)!, 0)
        while (typeof operand === 'number' && candidates.has(operand)) operand = getOperand(g, getNode(g, operand)!, 0)
        return operand
    }
    const demoted = new Map<number, number>()
    for (const id of candidates) demoted.set(id, newId(g))
    const localTail = new Map<number, number>()
    for (const id of candidates) {
        const n = getNode(g, id)!
        const chained = demoted.get(getRef(n, 0))
        let token = chained ?? getOperand(g, n, 0)
        if (chained === undefined && iterationLocal.has(id)) {
            const previous = localTail.get(owner.get(id)!)
            if (previous !== undefined) token = previous
            else putNode(g, token = newId(g), NodeOp.nilEffect, [])
        }
        if (iterationLocal.has(id)) localTail.set(owner.get(id)!, demoted.get(id)!)
        putNode(g, demoted.get(id)!, NodeOp.alloca, [token, { literal: getLiteral(g, n, 3) }, { literal: 8 }])
    }
    for (const [id, n] of [...g.nodes]) {
        let ops: Operand[] | undefined
        const ordering = firstNonOrderingSlot(n)
        for (let i = 0; i < countIds(n); i++) {
            const alloca = demoted.get(getRef(n, i))
            if (alloca === undefined) continue
            ops ??= getOperands(g, n)
            if (i < ordering) ops[i] = tokenOf(getRef(n, i))
            else ops[i] = alloca
        }
        if (ops) putCopy(g, id, n, ops)
    }
    for (const id of candidates) deleteNode(g, id)
    return true
}

interface BatchLoop {
    header: GraphBlock
    members: Set<number>
    stay: number
    counter: number
    bound: [ref: number, literal: number]
    inclusive: boolean
    unsigned: boolean
    steps: Set<number>
    origin: (ref: number) => number
}

const BatchInertRoots = new Set<NodeOp>([NodeOp.nilEffect, NodeOp.void, NodeOp.param, NodeOp.literal, NodeOp.block])

function doomedTail(g: Graph, id: number): boolean {
    const op = getNode(g, id)!.op
    return op === NodeOp.panic || op === NodeOp.unreachable || op === NodeOp.trap
}

function batchLoop(g: Graph, loops: GraphLoops, headerId: number): BatchLoop | undefined {
    const header = getBlock(g, headerId)!
    const members = loops.loopMembers.get(headerId)!
    const owners = new Map<number, GraphBlock>()
    for (const m of members) {
        if (m === headerId) continue
        for (const p of loops.preds.get(m)!) if (!members.has(p)) return
        const b = getBlock(g, m)!
        for (const p of b.params) owners.set(p, b)
    }
    const inside = (id: number) => {
        const n = getNode(g, id)!
        return n.op === NodeOp.apply && members.has(getRef(n, 0))
    }
    const arrivals = new Map<number, Set<number>>()
    for (const m of members) {
        for (const p of tailPositions(g, getBlock(g, m)!.bodyId)) {
            if (!inside(p.at)) {
                if (m === headerId || doomedTail(g, p.at)) continue
                return
            }
            const into = getRef(getNode(g, p.at)!, 0)
            let set = arrivals.get(into)
            if (!set) arrivals.set(into, set = new Set())
            set.add(p.at)
        }
    }
    const tail = getNode(g, tailOf(g, header.bodyId))
    if (tail?.op !== NodeOp.select || countIds(tail) !== 3) return
    let stay = 0
    for (let arm = 1; arm <= 2; arm++) {
        const positions = tailPositions(g, getRef(tail, arm))
        const staying = positions.filter(p => inside(p.at)).length
        if (!staying) continue
        if (stay || staying + positions.filter(p => doomedTail(g, p.at)).length !== positions.length) return
        stay = arm
    }
    const cond = getNode(g, getRef(tail, 0))
    if (!stay || !cond || !CompareOps.has(cond.op) || comparesFloats(g, cond)) return
    let budget = 64 + 32 * members.size
    const open = new Set<number>()
    function origin(ref: number): number {
        const n = getNode(g, ref)
        if (n?.op === NodeOp.after) return origin(getRef(n, countIds(n) - 1))
        const owner = owners.get(ref)
        if (!owner) return ref
        if (open.has(ref)) return -1
        if (--budget < 0) return 0
        open.add(ref)
        const at = owner.params.indexOf(ref) + 1
        let found = -1
        for (const app of arrivals.get(owner.id) ?? []) {
            const arg = origin(getRef(getNode(g, app)!, at))
            if (arg === -1) continue
            if (found !== -1 && found !== arg) found = 0
            else found = arg
            if (!found) break
        }
        open.delete(ref)
        return found
    }
    for (let at = 0; at < 2; at++) {
        const counter = getRef(cond, at)
        const bound: [number, number] = [getRef(cond, at ^ 1), getLiteral(g, cond, at ^ 1)]
        if (!header.params.includes(counter) || (bound[0] && !header.params.includes(bound[0]))) continue
        let relation = stay === 1 ? cond.op : InverseCompare.get(cond.op)!
        if (at === 1) relation = SwappedCmp[relation]
        if (relation !== NodeOp.lt && relation !== NodeOp.le) continue
        const k = header.params.indexOf(counter) + 1
        const b = header.params.indexOf(bound[0]) + 1
        const steps = new Set<number>()
        const counted = [...arrivals.get(headerId) ?? []].every(app => {
            const n = getNode(g, app)!
            const step = origin(getRef(n, k))
            const next = getNode(g, step)
            const by = next?.op === NodeOp.add && countIds(next) === 2 ? [0, 1].find(i => origin(getRef(next, i)) === counter) : undefined
            steps.add(step)
            return by !== undefined && !getRef(next!, by ^ 1) && getLiteral(g, next!, by ^ 1) === 1 && (!b || origin(getRef(n, b)) === bound[0])
        })
        if (!counted) continue
        const unsigned = !lowering.isSignedType(operandType(g, cond, 0)) && !lowering.isSignedType(operandType(g, cond, 1))
        return { header, members, stay, counter, bound, inclusive: relation === NodeOp.le, unsigned, steps, origin }
    }
}

function batchLoopPstacks(g: Graph): boolean {
    let any = false
    for (const n of g.nodes.values()) {
        if (!pstackFixedSize(g, n)) continue
        any = true
        break
    }
    if (!any) return false
    const loops = graphLoops(g)
    if (!loops.loopMembers.size) return false
    const owners = new Map<number, number[]>()
    const releasing = new Set<number>()
    for (const b of g.blocks) {
        const seen = new Set<number>()
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = getNode(g, id)
            if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
            if (n.op === NodeOp.pstack && pstackRebases(g, n)) releasing.add(b.id)
            if (pstackFixedSize(g, n)) {
                const list = owners.get(id)
                if (list) list.push(b.id)
                else owners.set(id, [b.id])
            }
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    const byHeader = new Map<number, [id: number, block: number][]>()
    for (const [id, blocks] of owners) {
        const nest = blocks.length === 1 ? loops.loopsOf.get(blocks[0])! : []
        if (!nest.length) continue
        const header = nest[nest.length - 1]
        const list = byHeader.get(header)
        if (list) list.push([id, blocks[0]])
        else byHeader.set(header, [[id, blocks[0]]])
    }
    let changed = false
    for (const [headerId, ids] of byHeader) {
        if ([...loops.loopMembers.get(headerId)!].some(m => releasing.has(m))) continue
        const loop = batchLoop(g, loops, headerId)
        if (loop && batchLoopGroup(g, loop, loops, ids)) changed = true
    }
    return changed
}

function batchTrip(g: Graph, loop: BatchLoop, app: GraphNode): Operand | undefined {
    const k = loop.header.params.indexOf(loop.counter) + 1
    const b = loop.header.params.indexOf(loop.bound[0]) + 1
    const bound = b ? getRef(app, b) : 0
    const limit = b ? getLiteral(g, app, b) : loop.bound[1]
    const start = getLiteral(g, app, k)
    if (getRef(app, k)) return
    if (!bound) {
        const count = limit - start + (loop.inclusive ? 1 : 0)
        return start >= 0 && limit >= 0 && Number.isSafeInteger(count) ? { literal: Math.max(0, count) } : undefined
    }
    if (start || loop.inclusive) return
    if (loop.unsigned) return bound
    return addNode(g, NodeOp.select, [addNode(g, NodeOp.gt, [bound, { literal: 0 }], Types.bool), bound, { literal: 0 }])
}

function batchLoopGroup(g: Graph, loop: BatchLoop, loops: GraphLoops, ids: [id: number, block: number][]): boolean {
    const header = loop.header
    const tail = tailOf(g, header.bodyId)
    const staying = demandUntil(g, getRef(getNode(g, tail)!, loop.stay), tail, 0)
    const visiting = demandUntil(g, header.bodyId, tail, 3 - loop.stay)
    const cells = new Map<number, [id: number, owner: number, counter: number, stepped: boolean][]>()
    const exiting = new Set<number>()
    for (const [id, owner] of ids.sort((a, b) => a[0] - b[0])) {
        const cell = getLiteral(g, getNode(g, id)!, 1)
        let counter = owner === header.id ? loop.counter : 0
        let stepped = false
        if (owner !== header.id) {
            for (const p of getBlock(g, owner)!.params) {
                const from = loop.origin(p)
                if (from !== loop.counter && !loop.steps.has(from)) continue
                counter = p
                stepped = from !== loop.counter
                break
            }
        }
        if ((owner === header.id && !staying.has(id)) || !counter) continue
        let list = cells.get(cell)
        if (!list) cells.set(cell, list = [])
        list.push([id, owner, counter, stepped])
        if (owner === header.id && visiting.has(id)) exiting.add(cell)
    }
    let done = false
    for (const [cell, list] of cells) {
        const entries: [block: GraphBlock, app: number][] = []
        for (const p of loops.preds.get(header.id)!) {
            if (loop.members.has(p)) continue
            const from = getBlock(g, p)!
            for (const t of tailPositions(g, from.bodyId)) {
                const n = getNode(g, t.at)!
                if (n.op === NodeOp.apply && getRef(n, 0) === header.id) entries.push([from, t.at])
            }
        }
        const trips = entries.map(([, app]) => batchTrip(g, loop, getNode(g, app)!))
        if (!entries.length || trips.includes(undefined)) continue
        let width = 0
        const offsets: number[] = []
        for (const [id] of list) {
            offsets.push(width)
            width += pstackFixedSize(g, getNode(g, id)!)
        }
        const scale = Math.log2(width)
        const scaled = (x: Operand) => Number.isInteger(scale) ? addNode(g, NodeOp.shl, [x, { literal: scale }]) : addNode(g, NodeOp.mul, [x, { literal: width }])
        const T = typeOf(getNode(g, list[0][0])!)
        const carried = new Map<number, number>()
        for (const m of loop.members) {
            const p = addNode(g, NodeOp.param, [], T)
            getBlock(g, m)!.params.push(p)
            carried.set(m, p)
        }
        for (const m of loop.members) {
            const b = getBlock(g, m)!
            b.bodyId = mapTailPositions(g, b.bodyId, p => {
                const n = getNode(g, p.at)!
                if (n.op !== NodeOp.apply || !loop.members.has(getRef(n, 0))) return p.at
                return addCopy(g, n, [...getOperands(g, n), carried.get(m)!])
            })
        }
        entries.forEach(([from, app], i) => {
            from.bodyId = mapTailPositions(g, from.bodyId, p => {
                if (p.at !== app) return p.at
                const n = getNode(g, p.at)!
                const roots = tailRoots(g, p).filter(r => r && r !== header.id && !BatchInertRoots.has(getNode(g, r)!.op))
                const token = roots.length ? addNode(g, NodeOp.after, roots) : addNode(g, NodeOp.nilEffect, [])
                const trip = trips[i]!
                const extra = exiting.has(cell) ? 1 : 0
                const bytes: Operand = typeof trip !== 'number' ? { literal: (trip.literal + extra) * width }
                    : scaled(extra ? addNode(g, NodeOp.add, [trip, { literal: 1 }]) : trip)
                const batch = addNode(g, NodeOp.pstack, [token, { literal: cell }, { literal: 0 }, bytes], T)
                const start = getLiteral(g, n, header.params.indexOf(loop.counter) + 1) * width
                return addCopy(g, n, [...getOperands(g, n), start ? addNode(g, NodeOp.sub, [batch, { literal: start }]) : batch])
            })
        })
        list.forEach(([id, owner, counter, stepped], i) => {
            const n = getNode(g, id)!
            const index = stepped ? addNode(g, NodeOp.sub, [counter, { literal: 1 }]) : counter
            const slot = addNode(g, NodeOp.add, [carried.get(owner)!, scaled(index)])
            const address = offsets[i] ? addNode(g, NodeOp.add, [slot, { literal: offsets[i] }]) : slot
            putNode(g, id, NodeOp.after, [getOperand(g, n, 0), addNode(g, NodeOp.mem, [address, getOperand(g, n, 3)], Types.u64)])
            done = true
        })
    }
    return done
}

function demandUntil(g: Graph, root: number, tail: number, arm: number): Set<number> {
    const seen = new Set<number>()
    const stack = [root]
    while (stack.length) {
        const id = stack.pop()!
        if (!id || seen.has(id)) continue
        seen.add(id)
        const n = getNode(g, id)
        if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
        if (id === tail) stack.push(getRef(n, 0), arm ? getRef(n, arm) : 0)
        else for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
    }
    return seen
}

export function expandValueGraph(g: Graph, target: lowering.Target): Graph {
    expectForm(g, 'expand', 'packaged', 'optimized')
    const expanded = runPipeline('expand', g, target.costs, [demotePstacks, batchLoopPstacks, expandCodecs, expandPstacks])
    g = expanded.graph
    if (expanded.changed || g.form === 'packaged') g = optimizePackaged(g, target)
    return g
}

export function prepareValueGraph(g: Graph, target: lowering.Target): Graph {
    g = expandValueGraph(g, target)
    g = runPipeline('shape', g, target.costs, [stripMem, detachRecordOrdering, outlineBlocks, rotateLoops, cloneExits, shareArmValues, splitTailSelects, hoistSharedArms, outlineLoopArms, isolateSelectArms, sweepBlocks, resolveNumberTypes, machineTypes, narrowTypes, reuseSteppedIndex, reduceConstantMultiplies, splitScaledShifts, shareLiterals]).graph
    g.form = 'lowerable'
    if (intrinsics.argv().includes('check-heap-handles')) checkHeapHandles(g)
    return g
}

function checkHeapHandles(g: Graph): void {
    const epoch = nextEpoch(g)
    function visit(n: GraphNode, id: number) {
        if (n.op === NodeOp.block) {
            if (!markVisited(n, epoch)) return
            forEachOperand(g, getBlock(g, id)!.bodyId, visit)
            return
        }
        if (n.op === NodeOp.heapHandle) {
            const handle = !getRef(n, 0) ? getLiteral(g, n, 0) : '?'
            console.log(errorDump(g))
            throw `lowering: unresolved heap handle ${handle} at %${id}`
        }
        forEachOperand(g, id, visit)
    }
    forEachOperand(g, g.blocks[0].bodyId, visit)
}

const placementProbe = intrinsics.argv().includes('block-placement')

const NarrowableOps = new Set([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.ushr])
const TruncatingOps = new Set([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor])

function zeroExtendedBits(T: Types): number {
    if (T === Types.bool) return 1
    if (T === Types.u8 || T === Types.u16 || T === Types.u32 || (T >= Types.u1 && T <= Types.u31)) return intrinsics.intrinsicBitWidth(T)
    return 64
}

function narrowTypes(g: Graph, costs: lowering.TargetCosts): void {
    if (!costs.narrowOps) return
    const floats = floatValues(g)
    const uses = nodeUsers(g, g.nodes.keys(), true)
    const bodies = new Set<number>()
    for (const b of g.blocks) bodies.add(b.bodyId)
    const arrivals = new Map<number, [number, number][]>()
    for (const n of g.nodes.values()) {
        if (n.op !== NodeOp.apply) continue
        const block = getBlock(g, getRef(n, 0))
        if (!block) continue
        block.params.forEach((p, i) => {
            const list = arrivals.get(p)
            const arrival: [number, number] = [getRef(n, i + 1), getLiteral(g, n, i + 1)]
            if (list) list.push(arrival)
            else arrivals.set(p, [arrival])
        })
    }
    const fitsMemo = new Map<number, boolean>()
    function fits(id: number, k: number): boolean {
        if (!id) return Number.isInteger(k) && k >= 0 && k <= 0xFFFFFFFF
        const known = fitsMemo.get(id)
        if (known !== undefined) return known
        fitsMemo.set(id, false)
        const n = getNode(g, id)
        let r = false
        if (n?.op === NodeOp.literal) r = fits(0, literalValue(g, n))
        else if (n?.op === NodeOp.load || n?.op === NodeOp.convert) r = zeroExtendedBits(typeOf(n)) <= 32
        else if (n && CompareOps.has(n.op)) r = true
        else if (n?.op === NodeOp.and) r = fits(getRef(n, 0), getLiteral(g, n, 0)) || fits(getRef(n, 1), getLiteral(g, n, 1))
        else if (n?.op === NodeOp.or || n?.op === NodeOp.xor) r = fits(getRef(n, 0), getLiteral(g, n, 0)) && fits(getRef(n, 1), getLiteral(g, n, 1))
        else if (n?.op === NodeOp.ushr) r = fits(getRef(n, 0), getLiteral(g, n, 0))
        else if (n?.op === NodeOp.param) {
            const list = arrivals.get(id) ?? []
            r = list.length > 0 && list.every(([ref, k]) => fits(ref, k))
        }
        fitsMemo.set(id, r)
        return r
    }
    const demandMemo = new Map<number, boolean>()
    function lowDemand(id: number): boolean {
        const known = demandMemo.get(id)
        if (known !== undefined) return known
        demandMemo.set(id, false)
        let r = !bodies.has(id)
        for (const [user, slot] of uses.get(id) ?? []) {
            if (!r) break
            const u = getNode(g, user)!
            if (truncates(u, slot)) continue
            if (u.op === NodeOp.store && slot === 3 && intrinsics.intrinsicBitWidth(typeOf(u)) <= 32) continue
            if (u.op === NodeOp.and && fits(getRef(u, 1 - slot), getLiteral(g, u, 1 - slot))) continue
            if ((TruncatingOps.has(u.op) || (u.op === NodeOp.shl && slot === 0)) && narrowed(user)) continue
            r = false
        }
        demandMemo.set(id, r)
        return r
    }
    function removableMask(u: GraphNode, slot: number): boolean {
        if (u.op !== NodeOp.and) return false
        const other = 1 - slot
        const m = getRef(u, other) ? getNode(g, getRef(u, other)) : undefined
        const mask = getRef(u, other) ? (m?.op === NodeOp.literal ? literalValue(g, m) : undefined) : getLiteral(g, u, other)
        return mask !== undefined && Number.isSafeInteger(mask) && mask >= 0xFFFFFFFF
            && Number(BigInt.asUintN(32, BigInt(mask))) === 0xFFFFFFFF
    }
    function truncates(u: GraphNode, slot: number): boolean {
        return u.op === NodeOp.convert && slot === 0 && typeOf(u) === Types.u32 && operandType(g, u, 0) <= Types.i64
    }
    function wantsZeroExtension(id: number): boolean {
        return (uses.get(id) ?? []).some(([user, slot]) => {
            const u = getNode(g, user)!
            return truncates(u, slot) || removableMask(u, slot)
        })
    }
    const narrowMemo = new Map<number, boolean>()
    function narrowed(id: number): boolean {
        const known = narrowMemo.get(id)
        if (known !== undefined) return known
        narrowMemo.set(id, false)
        const n = getNode(g, id)
        let r = false
        if (n && NarrowableOps.has(n.op)) {
            const shift = n.op === NodeOp.shl || n.op === NodeOp.ushr
            const amount = !getRef(n, 1) && getLiteral(g, n, 1) >= 0 && getLiteral(g, n, 1) < 32
            const users = uses.get(id) ?? []
            if (shift) {
                const legal = n.op === NodeOp.ushr ? fits(getRef(n, 0), getLiteral(g, n, 0)) : fits(id, 0) || lowDemand(id)
                r = amount && legal && users.length > 0
                    && users.every(([user]) => TruncatingOps.has(getNode(g, user)!.op) && narrowed(user))
            } else {
                r = (fits(id, 0) || lowDemand(id)) && wantsZeroExtension(id)
            }
        }
        narrowMemo.set(id, r)
        return r
    }
    const typed = new Map<number, Types>()
    for (const [id, n] of g.nodes) {
        if (floats.has(id)) continue
        if (n.op === NodeOp.literal) {
            if (fits(id, 0) || lowDemand(id)) typed.set(id, Types.u32)
            continue
        }
        if (n.op === NodeOp.param) {
            if (fits(id, 0)) typed.set(id, Types.u32)
            continue
        }
        if (NarrowableOps.has(n.op) && narrowed(id)) typed.set(id, Types.u32)
    }
    const redundant = new Map<number, number>()
    for (const [id, n] of g.nodes) {
        if (truncates(n, 0)) {
            const x = getRef(n, 0)
            if (x && !floats.has(x) && (typed.get(x) === Types.u32 || fits(x, 0))) redundant.set(id, x)
            continue
        }
        if (n.op !== NodeOp.and) continue
        for (let i = 0; i < 2; i++) {
            const x = getRef(n, i)
            if (!x || !removableMask(n, i)) continue
            if (typed.get(x) !== Types.u32 && !fits(x, 0)) continue
            redundant.set(id, x)
            break
        }
    }
    for (const [id, T] of typed) {
        const n = getNode(g, id)!
        if (typeOf(n) === T) continue
        retypeNode(g, id, T)
    }
    if (!redundant.size) return
    const target = (id: number) => {
        while (redundant.has(id)) id = redundant.get(id)!
        return id
    }
    for (const [id, n] of g.nodes) {
        let ids: number[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            if (!redundant.has(getRef(n, i))) continue
            ids ??= getArgIds(n)
            ids[i] = target(ids[i])
        }
        if (ids) putCopy(g, id, n, withRefs(g, n, ids))
    }
    for (const b of g.blocks) b.bodyId = target(b.bodyId)
}

export interface PreparedLowering {
    g: Graph
    island?: number[]
    analysis: ReturnType<typeof analyzeValueGraph>
    effectful: Set<number>
}

function readonlyAllocas(g: Graph, staticData: (bytes: Uint8Array) => number): void {
    const allocas: number[] = []
    for (const [id, n] of g.nodes) if (n.op === NodeOp.alloca) allocas.push(id)
    if (!allocas.length) return
    const mem = memAnalysis(g)
    let floats: Set<number> | undefined
    const accesses = new Map<number, number[]>()
    for (const [id, n] of g.nodes) {
        if ((n.op !== NodeOp.load && n.op !== NodeOp.store) || !getRef(n, 1)) continue
        const base = mem.of(getRef(n, 1)).base
        const list = accesses.get(base)
        if (list) list.push(id)
        else accesses.set(base, [id])
    }
    function addressedOnlyHere(id: number, reached: Set<number>): boolean {
        for (const x of reached) {
            for (const u of mem.users(x)) {
                const n = getNode(g, u)!
                if (n.op !== NodeOp.load && n.op !== NodeOp.store) continue
                if (getRef(n, 2) === x) return false
                if (getRef(n, 1) === x && mem.of(x).base !== id) return false
            }
        }
        return true
    }
    function storedBytes(store: number): Uint8Array | undefined {
        const n = getNode(g, store)!
        const type = typeOf(n)
        const bits = intrinsics.intrinsicBitWidth(type)
        const value = scalarOperand(g, g.nodes, n, 3)
        if (value === undefined || !bits || bits % 8 || bits > 64 || type === Types.f16 || type === Types.f32) return
        const word = new Uint8Array(8)
        if (type === Types.f64) {
            new DataView(word.buffer).setFloat64(0, value, true)
            return word.subarray(0, 8)
        }
        if (!Number.isSafeInteger(value)) return
        floats ??= floatValues(g)
        if (floats.has(store) || floats.has(getRef(n, 3))) return
        new DataView(word.buffer).setBigUint64(0, BigInt.asUintN(64, BigInt(value)), true)
        return word.subarray(0, bits / 8)
    }
    function constantContents(id: number): [bytes: Uint8Array, stores: number[]] | undefined {
        const flow = mem.flows(id, true)
        if (flow.own || flow.calls.length || !addressedOnlyHere(id, flow.reached)) return
        const bytes = new Uint8Array(getLiteral(g, getNode(g, id)!, 1))
        const written = new Uint8Array(bytes.length)
        const stores: number[] = []
        for (const s of accesses.get(id) ?? []) {
            const n = getNode(g, s)!
            if (n.op !== NodeOp.store) continue
            const at = mem.access(n)?.pos
            const word = storedBytes(s)
            if (at === undefined || !word || at < 0 || at + word.length > bytes.length) return
            for (let i = 0; i < word.length; i++) {
                if (written[at + i] && bytes[at + i] !== word[i]) return
                written[at + i] = 1
                bytes[at + i] = word[i]
            }
            stores.push(s)
        }
        if (!stores.length) return
        return [bytes, stores]
    }
    const dropped = new Map<number, Operand>()
    for (const id of allocas) {
        const contents = constantContents(id)
        if (!contents) continue
        const address = addNode(g, NodeOp.literal, [{ literal: staticData(contents[0]) }], Types.u64)
        putNode(g, id, NodeOp.after, [getOperand(g, getNode(g, id)!, 0), address])
        for (const s of contents[1]) dropped.set(s, getOperand(g, getNode(g, s)!, 0))
    }
    if (dropped.size) substitute(g, dropped)
}

export function prepareLowering(_g: Graph, opts: LowerGraphOptions = {}): PreparedLowering {
    const target = opts.target ?? lowering.hostTarget
    const g = prepareValueGraph(_g.form ? _g : normalizeValueGraph(_g, { target }), target)
    if (opts.staticData) readonlyAllocas(g, opts.staticData)
    registerLiterals(g, target)
    const island = opts.poolSlot ? islandLoads(g, target.costs, opts.poolSlot, opts.poolValue, opts.floatSlot) : undefined
    foldPureOrdering(g)
    const unordered = new Map<number, boolean>()
    const hollow = new Map<number, boolean>()
    verifyOrderingSlots(g, 'lowerable', firstNonOrderingSlot, id => hollowOrdering(g, id, unordered, hollow))
    let mem: MemAnalysis | undefined
    verifyMemoryOrder(g, 'lowerable', () => mem ??= memAnalysis(g))
    const [effectful, offTail] = effectfulSelects(g)
    verifyTailEffects(g, 'lowerable', offTail)
    verifyTokenSelects(g, 'lowerable')
    return { g, island, analysis: analyzeValueGraph(g, opts), effectful }
}

export function lowerValueGraph(_g: Graph, opts: LowerGraphOptions = {}): LowerGraphResult {
    return lowerPrepared(prepareLowering(_g, opts), opts)
}

interface RegisterPools {
    active: number[]
    saved: number[]
    scattered: number[]
}

export function lowerPrepared(prepared: PreparedLowering, opts: LowerGraphOptions = {}): LowerGraphResult {
    const target = opts.target ?? lowering.hostTarget
    const { g, island, analysis, effectful } = prepared
    const floats = floatValues(g)

    const rootBlock = g.blocks[0]
    if (rootBlock.bodyId && getNode(g, rootBlock.bodyId)!.op === NodeOp.unreachable) {
        return {
            bytes: [],
            listing: '',
            relocations: [],
            target,
            words: [],
            clobbers: new Set(),
            localCalls: new Set(),
        }
    }

    const asm = target.createAssembler()
    if (opts?.debug) {
        console.log(dumpGraph(g))
        const sets = (m: Map<number, Set<number>>) => [...m]
            .map(([at, values]) => `${at}:${[...values].join(',')}`).join(' ')
        console.log('release at', [...analysis.releaseAt]
            .map(([region, sites]) => `${region}{${sets(sites)}}`).join(' '))
        console.log('narrow at', sets(analysis.narrowsAt))
        console.log('spill until', [...analysis.shouldSpillUntil]
            .map(([value, at]) => `${value}:${at}`).join(' '))
    }

    const acrossCall = analysis.shouldSpillUntil
    const inArgPos = analysis.inArgPos
    const order = analysis.blockOrder
    const releaseAt = analysis.releaseAt
    const narrowsAt = analysis.narrowsAt
    const budget = opts.regBudget === undefined ? Infinity : Math.max(2, opts.regBudget)
    const allocatable: number[] = []
    for (const r of target.allocatable) {
        if (target.scratch.indexOf(r) >= 0) continue
        allocatable.push(r)
    }
    const floatArgRegs = target.floatArgRegs ?? []
    const accepts = (value: number, reg: number) => reg >= target.regCount || lowering.isFloatRegister(target, reg) === floats.has(value)
    function bank(float: boolean): RegisterPools {
        const mine = (r: number) => lowering.isFloatRegister(target, r) === float
        const active = allocatable.filter(mine).slice(0, budget)
        const saved = target.calleeSaved.filter(mine).slice(0, budget)
        const args = float ? floatArgRegs : target.argRegs
        const scattered = [...active.filter(r => args.indexOf(r) < 0), ...active.filter(r => args.indexOf(r) >= 0)]
        return { active, saved, scattered }
    }
    const integerPools = bank(false)
    const floatPools = bank(true)
    function poolsOf(value: number): RegisterPools {
        return floats.has(value) ? floatPools : integerPools
    }
    const volatiles = [...integerPools.active, ...floatPools.active]
    const preserved = [...integerPools.saved, ...floatPools.saved]
    const OPEN = 1 << 30
    const OUTGOING_ARGS = 1 << 29
    const INCOMING_ARGS = 1 << 28
    const SLOTS = target.regCount
    function isSlot(h: number): boolean { return h >= SLOTS && h < OPEN }
    function isOutgoingArg(h: number): boolean { return h >= OUTGOING_ARGS && h < OPEN }
    function locate(locations: number[], count: number, regs: number[], stack: number): number[] {
        const homes: number[] = []
        let integer = 0
        let float = 0
        let stacked = 0
        for (let i = 0; i < count; i++) {
            const at = locations[i] ?? -1
            if (at >= 0) homes.push(at)
            else if (at === gn.floatLocation && float < floatArgRegs.length) homes.push(floatArgRegs[float++])
            else if (at !== gn.floatLocation && integer < regs.length) homes.push(regs[integer++])
            else homes.push(stack + stacked++)
        }
        return homes
    }
    function argLocations(call: number): number[] {
        const t = getNode(g, getRef(getNode(g, call)!, 1))
        const fnType = t ? getNode(g, typeRefOf(t)) : undefined
        return fnType?.op === NodeOp.fnType ? gn.fnLocations(fnType) : []
    }
    function returnHome(location: number): number {
        if (location >= 0) return location
        return location === gn.floatLocation ? target.floatRetRegs![0] : target.retRegs[0]
    }
    function callReturnHome(call: number): number {
        const t = getNode(g, getRef(getNode(g, call)!, 1))
        const fnType = t ? getNode(g, typeRefOf(t)) : undefined
        return returnHome(fnType?.op === NodeOp.fnType ? gn.fnReturnLocation(fnType) : -1)
    }
    const RET = returnHome(opts.returnLocation ?? -1)
    const RECORD = opts.returnRecord ? returnRegisters(target, opts.returnRecord) : undefined
    assert(!opts.returnRecord || RECORD, `lowering: ${g.name ?? 'graph'} returns a record that does not fit the return registers`)
    function fieldHome(field: number): number {
        return RECORD ? RECORD[field] : field ? target.retRegs[field] : RET
    }
    function callReturnRegs(call: number): number[] {
        const n = getNode(g, call)!
        if (getNode(g, getRef(n, 1))?.op === NodeOp.syscallTarget) return [target.syscall.retReg]
        const record = gn.recordTypeAt(g, call)
        if (record) return returnRegisters(target, recordTypes(g, record))!
        const result = callReturnHome(call)
        return result === target.retRegs[0] ? target.retRegs : [result]
    }
    const callHomes = new Map<number, number[]>()
    function argHomes(call: number): number[] {
        let homes = callHomes.get(call)
        if (homes) return homes
        const n = getNode(g, call)!
        const regs = getNode(g, getRef(n, 1))?.op === NodeOp.syscallTarget ? target.syscall.argRegs : target.argRegs
        homes = locate(argLocations(call), countIds(n) - 3, regs, OUTGOING_ARGS)
        callHomes.set(call, homes)
        return homes
    }
    const entryParams = g.blocks[0].params
    const entryHomes = locate(entryParams.map(p => gn.paramLocation(getNode(g, p)!)), entryParams.length, target.argRegs, INCOMING_ARGS)
    const clobberAll = new Set<number>(target.volatiles)
    const callClobbers = new Map<number, Set<number>>()
    function clobberOfCall(call: number): Set<number> {
        let s = callClobbers.get(call)
        if (s) return s
        const n = getNode(g, call)
        const t = n?.op === NodeOp.call ? getNode(g, getRef(n, 1)) : undefined
        const callee = gn.localSymbol(g, t)
        s = callee !== undefined ? opts.clobbersOf?.(callee) ?? clobberAll : clobberAll
        const handed = n?.op === NodeOp.call ? argHomes(call).filter(h => h < SLOTS && !s!.has(h)) : []
        if (handed.length) s = new Set([...s, ...handed])
        callClobbers.set(call, s)
        return s
    }
    const safeCache = new Map<number, number[]>()
    function safeVolatiles(v: number): number[] {
        let s = safeCache.get(v)
        if (s) return s
        const crossed = analysis.crossedCalls.get(v)
        s = target.callerSaved.filter(r => accepts(v, r) && volatiles.includes(r) && (!crossed || [...crossed].every(c => !clobberOfCall(c).has(r))))
        safeCache.set(v, s)
        return s
    }
    const inherited = new Set<number>()
    for (const [id, n] of g.nodes) if (n.op === NodeOp.call) for (const r of clobberOfCall(id)) inherited.add(r)
    const needAt = new Map<number, number>()
    for (const [v, calls] of analysis.crossedCalls) {
        if (floats.has(v) || safeVolatiles(v).length) continue
        for (const c of calls) needAt.set(c, (needAt.get(c) ?? 0) + 1)
    }
    let needed = 0
    for (const k of needAt.values()) needed = Math.max(needed, k)
    const pairSlot = analysis.crossedCalls.size && needed % 2 === 0 && needed < integerPools.saved.length ? integerPools.saved[needed] : -1
    function rankHomes(safe: number[]): number[] {
        if (pairSlot < 0) return safe
        return [...safe.filter(r => inherited.has(r)), pairSlot, ...safe.filter(r => !inherited.has(r))]
    }
    let slotCount = 0
    const reusableSlots = new Set<number>()
    const signatures = assignBlockSignatures(g, acrossCall, analysis.inArgPos, analysis.inStatePos, analysis.applyOwner, {
        volatiles, preserved, safeFor: safeVolatiles, rank: rankHomes,
        arrival: entryHomes, argHome: (call, i) => argHomes(call)[i], ret: fieldHome, project: (call, field) => callReturnRegs(call)[field] ?? -1, overflow: () => takeSlot(), accepts,
    })
    const CALLEE = target.scratch[1]
    const SWAP = target.scratch[0]
    const SP = target.stackReg
    const LR = target.linkReg
    const usedPreserved = new Set<number>()
    let callsOut = false
    const tails = new Set<number>()
    const noreturns = new Set<number>()
    const continued = new Map<number, number[]>()
    let tailCalls = false
    let reachesExit = false
    let returns = false
    function isPreserved(r: number): boolean { return target.calleeSaved.indexOf(r) >= 0 }

    const spillStats = intrinsics.argv().includes('spill-stats') ? { total: 0, again: 0 } : undefined
    const spilledOnce = new Set<number>()
    const evictedOps = new Map<string, number>()
    const handoverKinds = new Map<string, number>()
    let outgoingArgWords = 0
    let frame: lowering.FrameLayout | undefined
    function slotOffset(h: number): number {
        if (h >= OUTGOING_ARGS) return frame!.outgoingArg(h - OUTGOING_ARGS)
        if (h >= INCOMING_ARGS) return frame!.incomingArg(h - INCOMING_ARGS)
        return frame!.slot(h - SLOTS)
    }
    function takeSlot(): number {
        const reused = reusableSlots.values().next()
        if (!reused.done) {
            reusableSlots.delete(reused.value)
            return reused.value
        }
        return SLOTS + slotCount++
    }

    interface EmitRegion {
        parent?: EmitRegion
        children: EmitRegion[]
        writes: Set<number>
        owned: number[]
        exitLabel: number
        group: number
    }
    const rootRegion: EmitRegion = {
        children: [], writes: new Set(), owned: [], exitLabel: -1, group: -1,
    }
    let currentRegion = rootRegion
    let currentBlock = 0
    let armStart = -1
    let nextRegionGroup = 0
    interface ReleaseEvent { released: { value: number, home: number }[] }
    interface TransferEvent {
        dst: number
        src: number
        consumed?: { value: number, home: number }
    }
    const code: ((() => void) | ReleaseEvent | TransferEvent)[] = []
    function put(fn: () => void): void { code.push(fn) }
    function transfer(dst: number, src: number, consumed?: { value: number, home: number }): void {
        if (!Number.isInteger(dst) || dst === OPEN || (dst >= SLOTS && !isSlot(dst))) {
            console.log(errorDump(g))
            throw `lowering3: invalid transfer destination ${dst} while queuing %${materializing} in B${currentBlock} (src: ${src})`
        }
        if (!Number.isInteger(src) || src === OPEN || (src >= SLOTS && !isSlot(src))) {
            console.log(errorDump(g))
            throw `lowering3: invalid transfer source ${src} while queuing %${materializing} in B${currentBlock} (dst: ${dst})`
        }
        noteWrite(dst)
        code.push({ dst, src, consumed })
    }
    function noteWrite(dst: number): void {
        if (dst < SLOTS) written.add(dst)
        if (isPreserved(dst)) {
            usedPreserved.add(dst)
            currentRegion.writes.add(dst)
        }
    }

    const homeOf = new Map<number, number>()
    const copyOf = new Map<number, number>()
    const heldBy = new Map<number, number>()
    const done = new Set<number>()
    const freedAt = new Map<number, number>()
    let materializing = 0


    const NOTHING = new Set<number>()
    const written = new Set<number>()
    const localCalls = new Set<number>()
    function isScratch(r: number): boolean { return target.scratch.indexOf(r) >= 0 }
    function homeable(id: number, home: number): void {
        assert(!isScratch(home), `lowering: %${id} would live in scratch register ${home}, which assembler macros and scratch literals overwrite`)
        assert(accepts(id, home), `lowering: %${id} would live in register ${home}, which belongs to the other register class`)
    }
    function bind(id: number, reg: number): number {
        if (opts.debug) console.log('home +', id, reg, 'at', materializing, 'over', heldBy.get(reg) ?? '-')
        homeable(id, reg)
        written.add(reg)
        homeOf.set(id, reg)
        heldBy.set(reg, id)
        if (isPreserved(reg)) {
            usedPreserved.add(reg)
            currentRegion.writes.add(reg)
        }
        return reg
    }
    function place(id: number, home: number): void {
        homeable(id, home)
        if (isSlot(home)) reusableSlots.delete(home)
        homeOf.set(id, home)
        if (isSlot(home)) return
        heldBy.set(home, id)
        if (isPreserved(home)) {
            usedPreserved.add(home)
            currentRegion.writes.add(home)
        }
    }
    function freeValue(v: number, site = materializing, announce = true): void {
        const home = homeOf.get(v)
        if (home === undefined) return
        if (opts.debug) console.log('home -', v, home, 'at', site)
        homeOf.delete(v)
        const copy = copyOf.get(v)
        if (copy !== undefined) {
            copyOf.delete(v)
            reusableSlots.add(copy)
        }
        freedAt.set(v, site)
        if (!isSlot(home) && heldBy.get(home) === v) heldBy.delete(home)
        if (announce) code.push({ released: [{ value: v, home }] })
    }
    function finish(id = materializing, handedOver?: Set<number>): void {
        done.add(id)
        for (const arm of armStack) for (const v of releaseAt.get(arm)?.get(id) ?? []) freeValue(v, id, !handedOver?.has(v))
    }

    const armStack = [0]
    function narrowTo(root: number): void {
        armStack.push(root)
        for (const v of narrowsAt.get(root) ?? []) freeValue(v, root)
    }
    function widen(): void {
        armStack.pop()
    }
    function releases(site: number, v: number): boolean {
        for (const arm of armStack) if (releaseAt.get(arm)?.get(site)?.has(v)) return true
        return false
    }
    function unheldIn(pools: number[][], avoid: Set<number>): number {
        for (const pool of pools) for (const r of pool) if (!heldBy.has(r) && !avoid.has(r)) return r
        return -1
    }
    const inf = g.ids.next
    function nextUse(v: number): number {
        if (v < 0) return -inf
        let next = inf
        for (const u of analysis.usedBy.get(v) ?? []) {
            if (done.has(u)) continue
            const at = analysis.visitOrder.get(u) ?? -inf
            if (at < next) next = at
        }
        return next
    }
    function spillSlot(v: number): number {
        const own = slotTo.get(v)
        if (own !== undefined && reusableSlots.delete(own)) return own
        return takeSlot()
    }
    function evictionRank(v: number): number {
        const copy = copyOf.get(v)
        const own = slotTo.get(v)
        const lands = copy ?? (own !== undefined && reusableSlots.has(own) ? own : -1)
        return (lands === own ? 2 : 0) + (copy !== undefined ? 1 : 0)
    }
    function freeRegIn(pools: number[][], avoid: Set<number>): number {
        const unheld = unheldIn(pools, avoid)
        if (unheld >= 0) return unheld
        let victim = -1
        let far = -inf
        let rank = -1
        for (const pool of pools) for (const r of pool) {
            const v = heldBy.get(r)
            if (v === undefined || avoid.has(r)) continue
            const next = nextUse(v)
            if (next < far) continue
            const k = evictionRank(v)
            if (next === far && k <= rank) continue
            victim = r
            far = next
            rank = k
        }
        if (victim < 0) return -1
        const v = heldBy.get(victim)!
        const copy = copyOf.get(v)
        heldBy.delete(victim)
        if (copy !== undefined) {
            homeOf.set(v, copy)
            copyOf.delete(v)
            return victim
        }
        const slot = spillSlot(v)
        transfer(slot, victim)
        if (spillStats) {
            spillStats.total++
            if (spilledOnce.has(v)) spillStats.again++
            spilledOnce.add(v)
            const op = opName(getNode(g, v)?.op ?? NodeOp.none) || '?'
            evictedOps.set(op, (evictedOps.get(op) ?? 0) + 1)
        }
        homeOf.set(v, slot)
        return victim
    }
    let transient = 0
    const avoidsArgRegs = new Set<number>()
    for (const [id, uses] of analysis.usedBy) {
        if (uses.length < 2 || acrossCall.has(id)) continue
        if (inArgPos.has(id) || analysis.inStatePos.has(id)) continue
        avoidsArgRegs.add(id)
    }
    let pendingHomes: Set<number> = NOTHING
    function regFor(id: number, want: number): number {
        const { active, saved, scattered } = poolsOf(id)
        let steering = false
        if (want < 0) {
            want = handedTo.get(id) ?? -1
            steering = want >= 0
            if (steering && sigStats) sigStats.steered++
        }
        if (want >= 0 && !accepts(id, want)) want = -1
        const first = acrossCall.has(id) ? saved
            : transient || avoidsArgRegs.has(id) ? scattered : active
        const second = first === saved ? active : saved
        if (want >= 0) {
            const willRelease = releases(id, heldBy.get(want) ?? 0)
            if (!heldBy.has(want) && (first.indexOf(want) >= 0 || first !== saved)) {
                return bind(id, want)
            }
            if (willRelease && (first.indexOf(want) >= 0 || first !== saved)) {
                return bind(id, want)
            }
        }
        if (steering && sigStats) sigStats.steerFailed++
        if (first === saved) {
            if (want >= 0 && !heldBy.has(want) && safeVolatiles(id).includes(want)) {
                return bind(id, want)
            }
            const homes = currentRegion === rootRegion ? rankHomes(safeVolatiles(id)) : safeVolatiles(id)
            for (const r of homes) {
                if (accepts(id, r) && !heldBy.has(r) && !pendingHomes.has(r)) {
                    return bind(id, r)
                }
            }
        }
        const pools = first === saved ? [first] : [first, second]
        let r = unheldIn(pools, pendingHomes)
        if (r < 0) r = freeRegIn(pools, NOTHING)
        if (r < 0) r = freeRegIn([second], NOTHING)
        if (r < 0) throw 'lowering: out of registers'
        return bind(id, r)
    }
    function at(v: number, avoid: Set<number>): number {
        const home = homeOf.get(v)
        if (home === undefined && scratchLiteral(v)) return scratchValue(v)
        if (home === undefined) {
            console.log(errorDump(g), materializing)
            throw `lowering: value ${v} is not live (demanded by %${materializing} = ${opName(getNode(g, materializing)?.op)})`
        }
        if (!isSlot(home)) return home
        if (acrossCall.has(v)) {
            for (const safe of safeVolatiles(v)) {
                if (heldBy.has(safe) || avoid.has(safe)) continue
                transfer(safe, home)
                copyOf.set(v, home)
                return bind(v, safe)
            }
        }
        const { active, saved } = poolsOf(v)
        const first = acrossCall.has(v) && !stashed.has(v) ? saved : active
        const second = first === saved ? active : saved
        const r = freeRegIn([first, second], avoid)
        if (r < 0) throw 'lowering: out of registers'
        transfer(r, home)
        copyOf.set(v, home)
        return bind(v, r)
    }
    interface Snapshot { homes: number[][], copies: number[][], held: number[][], ran: number[] }
    function snapshot(): Snapshot {
        const homes: number[][] = []
        for (const [k, v] of homeOf) homes.push([k, v])
        const copies: number[][] = []
        for (const [k, v] of copyOf) copies.push([k, v])
        const held: number[][] = []
        for (const [k, v] of heldBy) held.push([k, v])
        return { homes, copies, held, ran: [...done] }
    }
    function restore(s: Snapshot): void {
        homeOf.clear()
        for (const e of s.homes) homeOf.set(e[0], e[1])
        copyOf.clear()
        for (const e of s.copies) copyOf.set(e[0], e[1])
        heldBy.clear()
        for (const e of s.held) heldBy.set(e[0], e[1])
        reusableSlots.clear()
        const occupied = new Set<number>()
        for (const h of homeOf.values()) if (isSlot(h)) occupied.add(h)
        for (const h of copyOf.values()) occupied.add(h)
        for (let i = 0; i < slotCount; i++) if (!occupied.has(SLOTS + i)) reusableSlots.add(SLOTS + i)
        done.clear()
        for (const v of s.ran) done.add(v)
    }

    interface Move { dst: number, src: number }
    function shuffle(moves: Move[], expired?: Map<number, number>): void {
        const scratch = moves.some(m => isSlot(m.dst)) ? CALLEE : SWAP
        const pending: Move[] = []
        for (const m of moves) if (m.dst !== m.src) pending.push(m)
        while (pending.length) {
            let ready = -1
            for (let i = 0; i < pending.length && ready < 0; i++) {
                let blocked = false
                for (let j = 0; j < pending.length; j++) {
                    if (i !== j && pending[j].src === pending[i].dst) { blocked = true; break }
                }
                if (!blocked) ready = i
            }
            if (ready < 0) {
                const stuck = pending[0].src
                assert(!pending.some(m => m.dst === scratch || m.src === scratch), `lowering: a parallel move through ${scratch} also moves ${scratch}`)
                transfer(scratch, stuck)
                for (const m of pending) if (m.src === stuck) m.src = scratch
                continue
            }
            const m = pending.splice(ready, 1)[0]
            const value = expired?.get(m.src)
            const last = value !== undefined && !pending.some(x => x.src === m.src)
            transfer(m.dst, m.src, last ? { value, home: m.src } : undefined)
        }
    }

    let nextLabel = 0
    for (const b of g.blocks) if (b.id >= nextLabel) nextLabel = b.id + 1
    const exitLabel = nextLabel++
    rootRegion.exitLabel = exitLabel
    const savedIndex = new Map<number, number>()

    function regionExit(region: EmitRegion | undefined): number {
        while (region && region !== rootRegion && !region.owned.length) region = region.parent
        return region && region !== rootRegion ? region.exitLabel : exitLabel
    }

    function jumpToExit(tail = 0): void {
        returns = true
        const region = currentRegion
        put(() => {
            if (tailCalls && tails.has(tail)) return
            reachesExit = true
            asm.jump(regionExit(region))
        })
    }

    const sig = new Map<number, number[]>()
    const entryCode = new Map<number, { label: number, code: ((() => void) | ReleaseEvent | TransferEvent)[] }>()
    const inbound = new Map<number, GraphNode[]>()
    {
        const epoch = nextEpoch(g)
        const stack = order.map(id => getBlock(g, id)!.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            if (!id) continue
            const n = getNode(g, id)
            if (!n || !markVisited(n, epoch)) continue
            if (n.op === NodeOp.apply) {
                let arr = inbound.get(getRef(n, 0))
                if (!arr) inbound.set(getRef(n, 0), arr = [])
                arr.push(n)
            }
            for (const x of getArgIds(n)) stack.push(x)
        }
    }
    const stashed = stashedArgs()
    function stashedArgs(): Set<number> {
        const out = new Set<number>()
        const entry = g.blocks[0]
        const homes = signatures.get(entry.id) ?? []
        const shared = new Set<number>()
        for (const b of g.blocks) if (b !== entry) for (const h of signatures.get(b.id) ?? []) shared.add(h)
        const pressure = new Map<number, number>()
        for (const calls of analysis.crossedCalls.values()) for (const c of calls) pressure.set(c, (pressure.get(c) ?? 0) + 1)
        let peak = 0
        for (const n of pressure.values()) peak = Math.max(peak, n)
        for (let i = 0; i < entry.params.length; i++) {
            const p = entry.params[i]
            if (entryHomes[i] >= SLOTS) continue
            const uses = analysis.usedBy.get(p) ?? []
            if (!acrossCall.has(p) || !isPreserved(homes[i]) || shared.has(homes[i])) continue
            if (uses.length !== 1 || getNode(g, uses[0])?.op === NodeOp.apply) continue
            const crossed = analysis.crossedCalls.get(p)!
            let atPeak = true
            for (const [c, n] of pressure) if (n === peak && !crossed.has(c)) atPeak = false
            if (atPeak) out.add(p)
        }
        return out
    }
    for (const b of g.blocks) {
        const homes = (signatures.get(b.id) ?? []).map((home, i) => stashed.has(b.params[i]) ? takeSlot() : home)
        for (const home of homes) {
            if (!isPreserved(home)) continue
            usedPreserved.add(home)
            rootRegion.writes.add(home)
        }
        sig.set(b.id, homes)
    }
    const paramAt = new Map<number, [block: number, idx: number]>()
    for (const b of g.blocks) {
        for (let i = 0; i < b.params.length; i++) paramAt.set(b.params[i], [b.id, i])
    }
    const handedTo = new Map<number, number>()
    const slotTo = new Map<number, number>()
    for (const [v, positions] of inArgPos) {
        for (const at of positions) {
            const n = getNode(g, at[0])
            if (!n) continue
            const home = n.op === NodeOp.apply ? sig.get(getRef(n, 0))?.[at[1]]
                : n.op === NodeOp.call ? argHomes(at[0])[at[1]] : undefined
            if (home === undefined) continue
            if (!isSlot(home) && !handedTo.has(v)) handedTo.set(v, home)
            if (isSlot(home) && n.op === NodeOp.apply && !slotTo.has(v)) slotTo.set(v, home)
        }
    }
    for (const n of g.nodes.values()) {
        if (n.op !== NodeOp.ret) continue
        const value = getNode(g, getRef(n, 0))
        if (value?.op !== NodeOp.record) {
            if (getRef(n, 0) && !handedTo.has(getRef(n, 0))) handedTo.set(getRef(n, 0), RET)
            continue
        }
        for (let i = 0; i < countIds(value); i += 2) {
            const field = getRef(value, i + 1)
            const reg = fieldHome(getLiteral(g, value, i))
            if (field && reg !== undefined && !handedTo.has(field)) handedTo.set(field, reg)
        }
    }
    for (const [v, home] of [...handedTo]) {
        for (let n = getNode(g, v); n?.op === NodeOp.after;) {
            const value = getRef(n, countIds(n) - 1)
            if (!value || handedTo.has(value)) break
            handedTo.set(value, home)
            n = getNode(g, value)
        }
    }


    function floatOperand(n: GraphNode, i: number): boolean {
        return getRef(n, i) ? floats.has(getRef(n, i)) : !Number.isInteger(getLiteral(g, n, i))
    }

    function floatSource(n: GraphNode, i: number): Types {
        return !getRef(n, i) || floats.has(getRef(n, i)) ? Types.f64 : operandType(g, n, i)
    }

    let scratchHolder = 0
    function scratchLiteral(id: number): boolean {
        const n = getNode(g, id)
        return !!n && n.op === NodeOp.literal && (n.flags & gn.NodeFlags.scratch) !== 0
    }
    function scratchValue(id: number): number {
        const n = getNode(g, id)!
        const k = literalValue(g, n)
        const narrow = typeOf(n) === Types.u32
        const float = typeOf(n) === Types.f64
        assert(!heldBy.has(CALLEE), `lowering: scratch literal %${id} would overwrite %${heldBy.get(CALLEE)} in ${CALLEE}`)
        assert(!scratchHolder || !homeOf.has(scratchHolder), `lowering: scratch literal %${id} would overwrite scratch literal %${scratchHolder} in ${CALLEE}`)
        scratchHolder = id
        put(() => float ? asm.movF64(CALLEE, k) : asm.movImm(CALLEE, k, narrow))
        homeOf.set(id, CALLEE)
        done.add(id)
        return CALLEE
    }
    function demand(id: number, konst: number, want = -1): number {
        if (!id) throw `lowering: literal ${konst} at %${materializing} needs a register but is not a value [unit: ${g.name ?? '<anonymous>'}]`
        const n = getNode(g, id)
        if (n?.op === NodeOp.void) return 0
        if (scratchLiteral(id)) return id
        if (!homeOf.has(id)) {
            if (isParam(g.nodes, id)) {
                throw `lowering: parameter ${id} was released at ${freedAt.get(id)} before rematerializing ${materializing} (freed at ${freedAt.get(materializing)})\n${errorDump(g)}`
            }
            if (done.has(id) && voidValued(id)) return 0
            if (done.has(id) && islandLoad(g, n!)) done.delete(id)
            if (done.has(id)) {
                console.log(errorDump(g), id, getNode(g, id))
            }
            assert(!done.has(id), `value %${id} is already done`)
            build(id, want)
            if ((n?.op === NodeOp.after || n?.op === NodeOp.store) && !homeOf.has(id)) return 0
        }
        return id
    }

    function orderedOperands(site: number, wanted: number[]): number[] {
        const out: number[] = []
        const remaining = new Set<number>(wanted)
        for (const i of analysis.operandOrder.get(site) ?? []) {
            if (!remaining.delete(i)) continue
            out.push(i)
        }
        for (const i of wanted) if (remaining.has(i)) out.push(i)
        return out
    }

    function voidValued(id: number) {
        const n = getNode(g, id)
        if (n?.op === NodeOp.after) return voidValued(getRef(n, countIds(n) - 1))
        return n?.op === NodeOp.void || n?.op === NodeOp.store
    }

    function orderingOperands(site: number, n: GraphNode): number[] {
        return orderedOperands(site, cloneRefs(n, 0, -1).map((_, i) => i))
    }

    function build(id: number, want = -1): void {
        const outer = materializing
        if (opts.debug) console.log('build', id, 'from', outer)
        materializing = id
        defer materializing = outer
        const n = getNode(g, id)
        if (!n || isParam(g.nodes, id)) throw `lowering3: no definition for value ${id} while materializing ${materializing}`
        if (n.op === NodeOp.call) { buildCall(id, n); return }
        if (n.op === NodeOp.after) { buildAfter(id, n, want); return }
        if (n.op === NodeOp.select) { buildSelect(id, n, want); return }
        if (n.op === NodeOp.nilEffect) return
        if (n.op === NodeOp.void) { finish(); return }
        if (n.op === NodeOp.store) {
            buildStore(id, n)
            finish()
            return 
        }
        if (n.op === NodeOp.poolEntry) {
            const slot = getLiteral(g, n, 0)
            assert(!getRef(n, 0) && Number.isSafeInteger(slot) && slot >= 0)
            finish()
            const dst = regFor(id, want)
            const name = getDebugLabel(g, id)
            put(() => asm.loadPool(dst, slot, name))
            return
        }
        if (n.op === NodeOp.frameAddress) {
            const offset = getLiteral(g, n, 0)
            finish()
            const dst = regFor(id, want)
            put(() => asm.spRead(dst, frame!.allocas + offset))
            return
        }
        if (BinaryOps.has(n.op) || CompareOps.has(n.op)) { buildArith(id, n, want); return }
        if (UnaryOps.has(n.op)) {
            const op = n.op
            const float = floatOperand(n, 0)
            const a = demand(getRef(n, 0), getLiteral(g, n, 0))
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => float ? asm.floatNeg(dst, ra) : asm.unary(opName(op), dst, ra))
            return
        }
        if (n.op === NodeOp.crc32) {
            const zero = (i: number) => zeroOperand(g, target, n, i)
            const slots: number[] = []
            for (const i of orderedOperands(id, [0, 1])) {
                if (zero(i)) continue
                slots[i] = demand(getRef(n, i), getLiteral(g, n, i))
            }
            const guard = new Set<number>()
            const rs = zero(0) ? target.zeroReg! : at(slots[0], guard)
            guard.add(rs)
            const rk = zero(1) ? target.zeroReg! : at(slots[1], guard)
            finish(id)
            const dst = regFor(id, want)
            const width = intrinsics.intrinsicBitWidth(getLiteral(g, n, 2))
            put(() => asm.crc32(dst, rs, rk, width))
            return
        }
        if (n.op === NodeOp.convert || n.op === NodeOp.bitconvert) {
            const T = floatOperand(n, 0) ? Types.f64 : operandType(g, n, 0)
            const U = typeOf(n)
            const converts = n.op === NodeOp.convert
            const a = demand(getRef(n, 0), getLiteral(g, n, 0))
            const ra = at(a, NOTHING)
            finish()
            const dst = regFor(id, want)
            const reinterprets = !converts && (T === Types.f64 || U === Types.f64)
            put(() => reinterprets ? asm.mov(dst, ra) : asm.convert(dst, ra, T, U))
            return
        }
        if (n.op === NodeOp.load) {
            return buildLoad(id, n, want)
        }
        if (n.op === NodeOp.literal) {
            finish()
            const dst = regFor(id, want)
            const k = literalValue(g, n)
            const narrow = typeOf(n) === Types.u32
            const float = typeOf(n) === Types.f64
            put(() => float ? asm.movF64(dst, k) : asm.movImm(dst, k, narrow))
            return
        }
        if (isNullishValue(g, id)) {
            finish()
            const dst = regFor(id, want)
            put(() => asm.movImm(dst, 0))
            return
        }
        if (n.op === NodeOp.get && getNode(g, getRef(n, 0))?.op === NodeOp.call) {
            effect(getRef(n, 0))
            return
        }
        throw `lowering: cannot produce '${opName(n.op)}' @ %${id} [unit: ${g.name ?? '<anonymous'}]\n${errorDump(g)}`
    }

    function buildFloatArith(id: number, n: GraphNode, want: number): void {
        const cmp = CompareOps.has(n.op)
        let a = 0
        let b = 0
        for (const i of orderedOperands(id, [0, 1])) {
            const v = demand(getRef(n, i), getLiteral(g, n, i))
            if (i === 0) a = v
            else b = v
        }
        const guard = new Set<number>()
        const ra = at(a, guard)
        guard.add(ra)
        const rb = at(b, guard)
        finish(id)
        const dst = regFor(id, want)
        const from: [Types, Types] = [floatSource(n, 0), floatSource(n, 1)]
        put(() => cmp ? asm.floatCompare(opName(n.op), dst, ra, rb, from) : asm.floatBinary(opName(n.op), dst, ra, rb, from))
    }

    function buildArith(id: number, n: GraphNode, want: number): void {
        if (floatOperand(n, 0) || floatOperand(n, 1)) return buildFloatArith(id, n, want)
        const { op, li, ri, imm, operandImm, signed, narrow, narrowCompare, immediate } = arithForm(g, target, n)
        const cmp = CompareOps.has(op)
        if (immediate) {
            const a = demand(getRef(n, li), getLiteral(g, n, li))
            const ra = at(a, NOTHING)
            finish(id)
            const dst = regFor(id, want)
            if (cmp) put(() => asm.compareImm(opName(op), dst, ra, operandImm, signed, undefined, narrowCompare))
            else if (op === NodeOp.add) put(() => asm.addImm(dst, ra, imm, narrow))
            else if (op === NodeOp.sub) put(() => asm.subImm(dst, ra, imm, narrow))
            else put(() => asm.binaryImm(opName(op), dst, ra, imm, signed, narrow))
            return
        }
        let a = 0
        let b = 0
        for (const i of orderedOperands(id, [li, ri])) {
            const v = demand(getRef(n, i), getLiteral(g, n, i))
            if (i === li) a = v
            else b = v
        }
        const guard = new Set<number>()
        const ra = at(a, guard)
        guard.add(ra)
        const rb = at(b, guard)
        finish(id)
        const dst = regFor(id, want)
        put(() => cmp ? asm.compare(opName(op), dst, ra, rb, signed) : asm.binary(opName(op), dst, ra, rb, signed, narrow))
    }

    function buildAfter(id: number, n: GraphNode, want: number): void {
        const result = countIds(n) - 1
        assert(result >= 0)
        for (const i of orderingOperands(id, n)) effect(getRef(n, i))
        const value = demand(getRef(n, result), getLiteral(g, n, result), want)
        if (!value) { finish(id); return }
        const src = at(value, NOTHING)
        finish(id)
        const dst = regFor(id, want >= 0 ? want : isScratch(src) ? -1 : src)
        transfer(dst, src)
    }

    interface Handover { dst: number, id: number, konst: number, rank?: number, float?: boolean, settle?: (reg: number) => void }
    function handOver(site: number, slots: Handover[], sequence: [number, () => void], elide = OPEN): number {
        const args: Move[] = []
        const consts: (Move & { float: boolean })[] = []
        const feeds = new Map<Handover, number>()
        let sequenced = false
        const landing = new Set<number>()
        for (const s of slots) if (s.dst !== OPEN && !isSlot(s.dst)) landing.add(s.dst)
        const outerPending = pendingHomes
        defer pendingHomes = outerPending
        const pending = new Set(landing)
        let removed = -1
        for (let i = 0; i < slots.length; i++) {
            const s = slots[i]
            if (sequence[0] === i) {
                assert(!sequenced)
                sequence[1]()
                sequenced = true
            }
            if (!s.id) continue
            if (spillStats && paramAt.has(s.id) && s.dst !== OPEN) {
                const at = paramAt.get(s.id)!
                const own = sig.get(at[0])?.[at[1]]
                const now = homeOf.get(s.id)
                const kind = own !== s.dst ? 'other-ordinal' : now === s.dst ? 'kept' : now === undefined ? 'not-live' : isSlot(now) ? 'evicted-to-slot' : 'moved-to-reg'
                const key = `${kind}${isSlot(s.dst) ? ' (dst slot)' : ''}`
                handoverKinds.set(key, (handoverKinds.get(key) ?? 0) + 1)
            }
            const want = s.dst === OPEN || isSlot(s.dst) || isScratch(s.dst) ? -1 : s.dst
            if (removed >= 0) pending.add(removed)
            removed = want >= 0 && pending.delete(want) ? want : -1
            pendingHomes = pending
            const value = demand(s.id, s.konst, want)
            if (value) feeds.set(s, value)
        }
        pendingHomes = outerPending
        if (!sequenced) sequence[1]()
        slots = slots.filter(s => !s.id || feeds.has(s))
        const call = getNode(g, site)?.op === NodeOp.call
        for (const dst of landing) {
            const held = call && isPreserved(dst) ? heldBy.get(dst) : undefined
            if (held === undefined || slots.some(s => s.dst === dst && feeds.get(s) === held)) continue
            const slot = takeSlot()
            transfer(slot, dst)
            homeOf.set(held, slot)
            heldBy.delete(dst)
        }
        const settled = new Map<number, number>()
        const copied = new Map<number, number>()
        for (const v of feeds.values()) {
            settled.set(v, homeOf.get(v)!)
            const copy = copyOf.get(v)
            if (copy !== undefined) copied.set(v, copy)
        }
        const claimed = new Set<number>()
        for (const s of slots) if (s.dst !== OPEN) claimed.add(s.dst)
        const open = slots.filter(s => s.dst === OPEN)
        open.sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0))
        for (const s of open) {
            if (s.dst !== OPEN) continue
            const v = feeds.get(s)
            const here = v === undefined ? undefined : settled.get(v)
            if (here === undefined || claimed.has(here)) continue
            claimed.add(here)
            if (isPreserved(here)) {
                usedPreserved.add(here)
                currentRegion.writes.add(here)
            }
            s.dst = here
            s.settle!(here)
        }
        for (const s of open) {
            if (s.dst !== OPEN) continue
            const { active, saved } = poolsOf(feeds.get(s) ?? 0)
            let r = -1
            for (const c of active) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of saved) if (!claimed.has(c) && !heldBy.has(c)) { r = c; break }
            if (r < 0) for (const c of active) if (!claimed.has(c)) { r = c; break }
            if (r < 0) for (const c of saved) if (!claimed.has(c)) { r = c; break }
            if (r < 0) r = takeSlot()
            claimed.add(r)
            if (isPreserved(r)) {
                usedPreserved.add(r)
                currentRegion.writes.add(r)
            }
            s.dst = r
            s.settle!(r)
        }
        for (const s of slots) {
            if (!s.id) { consts.push({ dst: s.dst, src: s.konst, float: !!s.float || (!isSlot(s.dst) && lowering.isFloatRegister(target, s.dst)) }); continue }
            args.push({ dst: s.dst, src: feeds.get(s)! })
        }
        if (opts.debug) {
            console.log('handover', site, slots.map(s => [s.dst, s.id, s.konst]),
                [...settled], 'elide', elide)
        }
        finish(site, new Set(feeds.values()))
        const dsts = new Set<number>()
        for (const a of args) if (a.dst !== elide) dsts.add(a.dst)
        for (const c of consts) dsts.add(c.dst)
        let landed = elide
        const moves: Move[] = []
        for (const a of args) {
            if (copied.get(a.src) === a.dst) continue
            const src = settled.get(a.src)
            if (src === undefined) {
                const t = slots.find(x => x.dst === a.dst)?.id
                console.log(dumpGraph(g))
                throw `Missing handover source: %${t}, freed at %${t ? freedAt.get(t) : 'unknown'}`
            }
            if (a.dst === elide && !isSlot(src) && !dsts.has(src)) { landed = src; continue }
            moves.push({ dst: a.dst, src })
        }
        if (sigStats) {
            const n = getNode(g, site)
            if (n && n.op === NodeOp.apply) {
                const homes = new Set(moves.map(m => m.src))
                for (const m of moves) {
                    if (m.dst === m.src) continue
                    sigStats.applyMoves++
                    if (homes.has(m.dst)) sigStats.swaps++
                    const s = slots.find(x => x.dst === m.dst)
                    const v = s?.id ?? 0
                    if (!v) continue
                    if (isParam(g.nodes, v)) {
                        sigStats.fromParam++
                        const home = paramAt.get(v)
                        const declared = home ? sig.get(home[0])?.[home[1]] : undefined
                        if (declared !== undefined && declared !== m.src) {
                            sigStats.displaced++
                            if (isSlot(m.src)) sigStats.displacedToSlot++
                            if (isSlot(m.dst)) sigStats.dstIsSlot++
                        }
                        else if (declared !== m.dst) sigStats.mismatch++
                    }
                    else sigStats.fromValue++
                }
            }
        }
        const expired = new Map<number, number>()
        for (const [v, home] of settled) {
            if (!homeOf.has(v) && !isSlot(home) && !dsts.has(home)) expired.set(home, v)
        }
        const stores = moves.filter(m => isOutgoingArg(m.dst))
        const shuffled = moves.filter(m => !isOutgoingArg(m.dst))
        for (let i = 0; i < stores.length; i++) {
            const m = stores[i]
            const value = expired.get(m.src)
            const last = value !== undefined && !shuffled.some(x => x.src === m.src)
                && !stores.some((x, j) => j > i && x.src === m.src)
            transfer(m.dst, m.src, last ? { value, home: m.src } : undefined)
        }
        shuffle(shuffled, expired)
        for (const c of consts) {
            noteWrite(c.dst)
            if (isSlot(c.dst) && c.src === 0 && target.zeroReg !== undefined) put(() => asm.store(SP, slotOffset(c.dst), target.zeroReg!, Types.u64))
            else if (isSlot(c.dst)) put(() => {
                if (c.float) asm.movF64(SWAP, c.src)
                else asm.movImm(SWAP, c.src)
                asm.store(SP, slotOffset(c.dst), SWAP, Types.u64)
            })
            else put(() => c.float ? asm.movF64(c.dst, c.src) : asm.movImm(c.dst, c.src))
        }
        return landed
    }

    function buildCall(id: number, n: GraphNode): void {
        const callee = getNode(g, getRef(n, 1))
        const syscall = callee?.op === NodeOp.syscallTarget ? callee : undefined
        const indirect = callee?.op === NodeOp.indirectTarget ? callee : undefined
        const local = callee?.op === NodeOp.localTarget ? callee : undefined
        assert(!indirect || countIds(indirect) === 1, `lowering: call %${id} still carries its context in the target`)
        assert(tailScalar(g, indirect ?? n, indirect ? 0 : 1) !== 0, `lowering: ${g.name ?? 'graph'} calls undefined at %${id}, which panicNullishCalls should have turned into a panic`)
        const homes = argHomes(id)
        const stacked = homes.some(isOutgoingArg)
        if (syscall) assert(!stacked, `lowering: syscall at %${id} takes more than ${target.syscall.argRegs.length} args`)
        if (syscall || stacked || homes.some(isPreserved)) tails.delete(id)
        if (syscall) noreturns.delete(id)
        if (!syscall) callsOut ||= !tails.has(id) && !noreturns.has(id)
        const continues = local && noreturns.has(id) && opts.continues?.(getLiteral(g, local, 0)) ? [] as number[] : undefined
        if (continues) continued.set(getLiteral(g, local!, 0), continues)
        else for (const h of homes) if (isOutgoingArg(h)) outgoingArgWords = Math.max(outgoingArgWords, h - OUTGOING_ARGS + 1)
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const i of analysis.operandOrder.get(id) ?? []) {
            if (i === 0) sequenceIdx = slots.length
            if (i === 1 && indirect) {
                slots.push({ dst: CALLEE, id: getRef(indirect, 0), konst: getLiteral(g, indirect, 0) })
                continue
            }
            if (i < 3 && (i !== 1 || syscall || local)) continue
            slots.push({
                dst: i === 1 ? CALLEE : continues ? OPEN : homes[i - 3],
                id: getRef(n, i), konst: getLiteral(g, n, i),
                settle: continues ? (r: number) => { continues[i - 3] = r } : undefined,
            })
        }
        done.add(id)
        const linkReg = handOver(id, slots, [sequenceIdx, () => effect(getRef(n, 0))], CALLEE)
        for (const x of volatiles) {
            const v = heldBy.get(x)
            if (v === undefined) continue
            if (rebuildable(g, v)) {
                if (!clobberOfCall(id).has(x)) continue
                freeValue(v, id)
                done.delete(v)
                continue
            }
            if (acrossCall.has(v) && !clobberOfCall(id).has(x)) continue
            const copy = copyOf.get(v)
            if (copy === undefined || !acrossCall.has(v)) {
                freeValue(v, id)
                continue
            }
            homeOf.set(v, copy)
            copyOf.delete(v)
            heldBy.delete(x)
        }
        if (syscall) {
            const number = getLiteral(g, syscall, 0)
            assert(!getRef(syscall, 0) && Number.isSafeInteger(number))
            for (const r of target.volatiles) written.add(r)
            put(() => asm.syscall(number))
        } else if (local) {
            const target = getLiteral(g, local, 0)
            const name = getDebugLabel(g, getRef(n, 1)) ?? opts.nameOf?.(target)
            assert(!getRef(local, 0) && Number.isSafeInteger(target) && target >= 0)
            localCalls.add(target)
            const region = currentRegion
            put(() => {
                if (noreturns.has(id)) return asm.jumpLocal(target, name)
                if (!tailCalls || !tails.has(id)) return asm.callLocal(target, name)
                popFrame(region)
                asm.jumpLocal(target, name)
            })
        } else {
            for (const r of target.volatiles) written.add(r)
            const region = currentRegion
            put(() => {
                if (noreturns.has(id)) return asm.br(linkReg)
                if (!tailCalls || !tails.has(id)) return asm.blr(linkReg)
                const reg = isPreserved(linkReg) ? CALLEE : linkReg
                if (reg !== linkReg) asm.mov(reg, linkReg)
                popFrame(region)
                asm.br(reg)
            })
        }
        const retRegs = callReturnRegs(id)
        if (const projections = analysis.callProjections.get(id)) {
            for (const p of projections) {
                buildCallProjection(p, retRegs)
            }
            return
        }
        transfer(regFor(id, retRegs[0]), retRegs[0])
    }

    function buildCallProjection(id: number, retRegs: number[]) {
        const outer = materializing
        materializing = id
        defer materializing = outer
        defer finish()
        assert(!done.has(id), `Value is already done: ${id}`)
        const n = getNode(g, id)!
        assert(n.op === NodeOp.get, `Invalid proj op: ${opName(n.op)}`)
        const key = getLiteral(g, n, 1)
        const reg = retRegs[key]
        assert(reg !== undefined, `Unhandled proj key: ${key}`)
        transfer(regFor(id, reg), reg)
    }

    function effect(id: number): void {
        if (!id) return
        const n = getNode(g, id)
        if (!n) return
        const outer = transient
        transient = outer + 1
        defer transient = outer
        if (n.op === NodeOp.call) {
            if (!done.has(id)) build(id)
        } else if (n.op === NodeOp.after) {
            if (!done.has(id)) build(id)
        } else if (n.op === NodeOp.store) {
            if (!done.has(id)) buildStore(id, n)
        } else if (n.op === NodeOp.load) {
            if (!done.has(id)) build(id)
        } else if (n.op === NodeOp.select) {
            const taken = getNode(g, getRef(n, 1))?.op === NodeOp.panic ? 2
                : getNode(g, getRef(n, 2))?.op === NodeOp.panic ? 1 : 0
            if (!taken && preferBranchless(id, n)) {
                if (!done.has(id)) build(id)
            } else {
                if (!taken) throw `lowering: effect ${id} branches before the tail\n${errorDump(g)}`
                effect(getRef(n, taken))
            }
        } else if (n.op === NodeOp.nilEffect || n.op === NodeOp.void) return
        if (!analysis.usedBy.has(id)) {
            freeValue(id)
        }
    }

    function buildStore(id: number, n: GraphNode): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        const T = typeOf(n)
        const zero = zeroOperand(g, target, n, 3)
        const wanted = [0, 1]
        if (getRef(n, 2)) wanted.push(2)
        if (!zero) wanted.push(3)
        let b = 0
        let o = 0
        let v = 0
        for (const i of orderedOperands(id, wanted)) {
            if (i === 0) {
                effect(getRef(n, 0))
                continue
            }
            if (i === 3 && T === Types.f64 && getRef(n, 3) && !floats.has(getRef(n, 3))) {
                throw `lowering: f64 store of the non-f64 value %${getRef(n, 3)} [unit: ${g.name ?? '<anonymous>'}]`
            }
            const d = demand(getRef(n, i), getLiteral(g, n, i))
            if (i === 1) b = d
            else if (i === 2) o = d
            else v = d
        }
        const guard = new Set<number>()
        const base = at(b, guard)
        guard.add(base)
        const ro = o ? at(o, guard) : -1
        if (o) guard.add(ro)
        const rv = zero ? target.zeroReg! : at(v, guard)
        guard.add(rv)
        finish()
        if (ro < 0) {
            const offset = getLiteral(g, n, 2)
            put(() => asm.store(base, offset, rv, T))
            return
        }
        put(() => asm.storeIndexed(base, ro, rv, T))
    }

    function buildLoad(id: number, n: GraphNode, want: number) {
        const outer = materializing
        materializing = id
        defer materializing = outer
        done.add(id)
        const T = typeOf(n)
        if (islandLoad(g, n)) {
            const pc = getNode(g, getRef(n, 1))!
            finish()
            const dst = regFor(id, want)
            const name = getDebugLabel(g, id)
            put(() => asm.loadLiteral(dst, getLiteral(g, pc, 1) + getLiteral(g, n, 2), name))
            return
        }
        if (!getRef(n, 2)) {
            let b0 = 0
            for (const i of orderedOperands(id, [0, 1])) {
                if (i === 0) effect(getRef(n, 0))
                else b0 = demand(getRef(n, 1), getLiteral(g, n, 1))
            }
            const base0 = at(b0, NOTHING)
            finish()
            const dst = regFor(id, want)
            put(() => asm.load(dst, base0, getLiteral(g, n, 2), T))
            return
        }
        let b = 0, o = 0
        for (const i of orderedOperands(id, [0, 1, 2])) {
            if (i === 0) {
                effect(getRef(n, 0))
                continue
            }
            const v = demand(getRef(n, i), getLiteral(g, n, i))
            if (i === 1) b = v
            else o = v
        }
        const guard = new Set<number>()
        const rb = at(b, guard)
        guard.add(rb)
        const ro = at(o, guard)
        finish()
        const dst = regFor(id, want)
        put(() => asm.loadIndexed(dst, rb, ro, T))
    }

    function condition(site: number, id: number, konst: number, target: number, whenTrue = false): void {
        const outer = materializing
        materializing = id || site
        defer materializing = outer
        if (opts.debug) console.log('condition', id, '@', site)
        const v = demand(id, konst)
        const r = at(v, NOTHING)
        finish(id)
        finish(site)
        put(() => whenTrue ? asm.jumpIfNonZero(r, target) : asm.jumpIfZero(r, target))
    }

    function preferBranchless(id: number, n: GraphNode) {
        return countIds(n) === 3 && !effectful.has(id)
    }

    function buildSelect(id: number, n: GraphNode, want: number): void {
        if (preferBranchless(id, n)) {
            const zero = (i: number) => zeroOperand(g, target, n, i)
            const slots: number[] = []
            for (const i of orderedOperands(id, [0, 1, 2])) {
                if (i > 0 && zero(i)) continue
                const v = demand(getRef(n, i), getLiteral(g, n, i))
                slots[i] = v
            }
            const guard = new Set<number>()
            const rc = at(slots[0], guard)
            guard.add(rc)
            const rx = zero(1) ? target.zeroReg! : at(slots[1], guard)
            guard.add(rx)
            const ry = zero(2) ? target.zeroReg! : at(slots[2], guard)
            finish(id)
            const dst = regFor(id, want)
            put(() => asm.select(dst, rc, rx, ry))
            return
        }
        console.log(errorDump(g))
        throw `lowering3: select ${id} branches in value position`
    }

    function returnRecord(site: number, n: GraphNode): void {
        const outer = materializing
        materializing = site
        defer materializing = outer
        const fields: number[] = []
        for (let i = 1; i < countIds(n); i += 2) fields.push(i)
        const slots: Handover[] = []
        for (const i of orderedOperands(site, fields)) {
            const reg = fieldHome(getLiteral(g, n, i - 1))
            assert(reg !== undefined, `Unhandled return slot: ${getLiteral(g, n, i - 1)}`)
            slots.push({ dst: reg, id: getRef(n, i), konst: getLiteral(g, n, i) })
        }
        handOver(site, slots, [-1, () => {}])
        jumpToExit()
    }

    function returnValue(site: number, id: number, konst: number): void {
        if (!id) {
            const float = lowering.isFloatRegister(target, RET)
            noteWrite(RET)
            put(() => float ? asm.movF64(RET, konst) : asm.movImm(RET, konst))
        } else {
            const n = getNode(g, id)
            if (n?.op === NodeOp.literal) {
                const k = literalValue(g, n)
                const float = typeOf(n) === Types.f64
                noteWrite(RET)
                put(() => float ? asm.movF64(RET, k) : asm.movImm(RET, k))
                return jumpToExit()
            }
            if (getNode(g, id)?.op === NodeOp.call && !done.has(id) && callReturnHome(id) === RET) tails.add(id)
            const v = demand(id, konst, RET)
            const src = v ? homeOf.get(v)! : undefined
            finish(site)
            if (v) {
                transfer(RET, src!, { value: v, home: src! })
            }
        }
        jumpToExit(id)
    }

    const coldStubs: { label: number, code: ((() => void) | ReleaseEvent | TransferEvent)[] }[] = []

    function emitApply(id: number, n: GraphNode, jump = true, branchedTo?: number): void {
        const outer = materializing
        materializing = id
        defer materializing = outer
        const b = getBlock(g, getRef(n, 0))
        if (!b) throw 'lowering3: apply of something that is not a block'
        const homes = sig.get(b.id)!
        const slots: Handover[] = []
        let sequenceIdx = -1
        for (const at of analysis.operandOrder.get(id) ?? []) {
            if (at < 1 || at > b.params.length) continue
            const i = at - 1
            slots.push({
                dst: homes[i], id: getRef(n, i + 1), konst: getLiteral(g, n, i + 1), rank: i, float: floats.has(b.params[i]),
                settle: (r: number) => { homes[i] = r },
            })
        }
        const mark = code.length
        handOver(id, slots, [sequenceIdx, () => {}])
        let from = armStart >= 0 ? armStart : mark
        while (from < code.length && 'released' in code[from]) from++
        if (branchedTo !== undefined) {
            if (analysis.sinks.has(id)) {
                entryCode.set(b.id, { label: branchedTo, code: code.splice(from, code.length - from) })
                return
            }
            const label = b.id
            put(() => asm.jump(label))
            coldStubs.push({ label: branchedTo, code: code.splice(from, code.length - from) })
            return
        }
        if (jump && from < code.length && analysis.sinks.has(id)) {
            const label = nextLabel++
            entryCode.set(b.id, { label, code: code.splice(from, code.length - from) })
            put(() => {
                asm.jump(label)
                asm.releaseLabel(label)
            })
        }
        else if (jump) {
            const label = b.id
            const isLastBranch = analysis.effectivelyLinearBlocks.has(b.id)
            put(() => {
                asm.jump(label)
                if (isLastBranch) asm.releaseLabel(label)
            })
        }
        else {
            for (let i = 0; i < b.params.length; i++) {
                if (!getRef(n, i + 1)) continue
                place(getRef(n, i + 1), homes[i])
            }
        }
    }

    function exitsFunction(id: number): boolean {
        if (!id) return true
        const n = getNode(g, id)!
        if (n.op === NodeOp.after) return exitsFunction(getRef(n, countIds(n)-1))
        if (n.op === NodeOp.select) {
            return exitsFunction(getRef(n, 1))
                && exitsFunction(getRef(n, 2))
        }
        if (n.op === NodeOp.apply) return false
        return true
    }

    function emitTailRegion(id: number, konst: number, group: number): void {
        if (currentBlock !== g.root || !exitsFunction(id)) {
            emitTail(id, konst)
            return
        }
        const parent = currentRegion
        const region: EmitRegion = {
            parent, children: [], writes: new Set(), owned: [], exitLabel: nextLabel++, group,
        }
        parent.children.push(region)
        currentRegion = region
        put(() => {
            for (const r of region.owned) asm.store(SP, frame!.saved(savedIndex.get(r)!), r, Types.u64)
        })
        emitTail(id, konst)
        currentRegion = parent
    }

    function emitTail(id: number, konst: number): void {
        const n = id ? getNode(g, id) : undefined
        if (!n) { returnValue(id, id, konst); return }
        if (n.op === NodeOp.after) {
            if (homeOf.has(id)) {
                return returnValue(id, id, konst)
            }
            const result = countIds(n) - 1
            const ordering = orderingOperands(id, n)
            const last = ordering.length ? getRef(n, ordering[ordering.length - 1]) : 0
            const value = getNode(g, getRef(n, result))
            const returned = value?.op === NodeOp.ret && getRef(value, 0) === last
            const tail = getNode(g, last)?.op === NodeOp.call && !done.has(last) && (value?.op === NodeOp.void || (returned && callReturnHome(last) === RET))
            if (tail) tails.add(last)
            const callee = getNode(g, last)?.op === NodeOp.call ? gn.localSymbol(g, getNode(g, getRef(getNode(g, last)!, 1))) : undefined
            if (value?.op === NodeOp.unreachable && ordering.length === 1 && callee !== undefined && opts.endless?.(callee) && !done.has(last)) noreturns.add(last)
            for (const i of ordering) if (!returned || !tail || getRef(n, i) !== last) effect(getRef(n, i))
            if (tail && !returned) return jumpToExit(last)
            if (noreturns.has(last)) return finish(getRef(n, result))
            emitTail(getRef(n, result), getLiteral(g, n, result))
            return
        }
        if (n.op === NodeOp.select) {
            if (homeOf.has(id)) {
                return returnValue(id, id, konst) // for non-tail
            }
            const cold = analysis.coldArm.get(id)
            if (cold) {
                const hot = 3 - cold
                const otherwise = nextLabel++
                condition(id, getRef(n, 0), getLiteral(g, n, 0), otherwise, hot === 2)
                const before = snapshot()
                const group = nextRegionGroup++
                narrowTo(getRef(n, hot))
                armStart = code.length
                emitTailRegion(getRef(n, hot), getLiteral(g, n, hot), group)
                widen()
                restore(before)
                narrowTo(getRef(n, cold))
                armStart = code.length
                emitApply(getRef(n, cold), getNode(g, getRef(n, cold))!, true, otherwise)
                widen()
                return
            }
            const first = analysis.firstArm.get(id) ?? 1
            const otherwise = nextLabel++
            condition(id, getRef(n, 0), getLiteral(g, n, 0), otherwise, first === 2)
            const before = snapshot()
            const group = nextRegionGroup++
            narrowTo(getRef(n, first))
            armStart = code.length
            emitTailRegion(getRef(n, first), getLiteral(g, n, first), group)
            widen()
            restore(before)
            put(() => { asm.bindLabel(otherwise); asm.releaseLabel(otherwise) })
            narrowTo(getRef(n, 3 - first))
            armStart = code.length
            emitTailRegion(getRef(n, 3 - first), getLiteral(g, n, 3 - first), group)
            widen()
            return
        }
        if (n.op === NodeOp.apply) { emitApply(id, n); return }
        if (n.op === NodeOp.panic) { jumpToExit(); return }
        if (n.op === NodeOp.trap) {
            const code = getLiteral(g, n, 1)
            effect(getRef(n, 0))
            finish(id)
            put(() => asm.trap(code))
            return
        }
        if (n.op === NodeOp.unreachable) {
            finish(id)
            put(() => asm.trap(0))
            return
        }
        if (n.op === NodeOp.ret) {
            return emitTail(getRef(n!, 0), getLiteral(g, n!, 0))
        }
        if (n.op === NodeOp.record) { returnRecord(id, n); return }
        returnValue(id, id, konst)
    }

    for (const id of order) {
        const b = getBlock(g, id)!
        if (sigStats) {
            sigStats.blocks++
            if (homeOf.size) {
                sigStats.leakedBlocks++
                sigStats.leaked += homeOf.size
                for (const [v] of homeOf) {
                    const op = isParam(g.nodes, v) ? 'param' : (opName(getNode(g, v)?.op ?? NodeOp.none) || 'synth')
                    sigStats.leakKinds.set(op, (sigStats.leakKinds.get(op) ?? 0) + 1)
                }
            }
        }
        for (const v of [...homeOf.keys()]) freeValue(v, id)
        currentBlock = id
        currentRegion = rootRegion
        armStart = -1
        homeOf.clear()
        copyOf.clear()
        heldBy.clear()
        done.clear()
        reusableSlots.clear()
        for (let i = 0; i < slotCount; i++) reusableSlots.add(SLOTS + i)
        const piece = entryCode.get(id)
        if (piece) {
            put(() => asm.bindLabel(piece.label))
            for (const f of piece.code) code.push(f)
        }
        put(() => asm.bindLabel(b.id))
        if (id === g.root) {
            const entry = sig.get(id)!
            for (let i = 0; i < b.params.length; i++) place(b.params[i], entry[i])
            for (let i = 0; i < b.params.length; i++) {
                if (entry[i] === entryHomes[i]) continue
                assert(isSlot(entryHomes[i]) || isSlot(entry[i]) || !entryHomes.includes(entry[i]), 'lowering: entry param overlaps an argument register')
                transfer(entry[i], entryHomes[i])
            }
            emitTail(b.bodyId, b.bodyConst)
            continue
        }
        const homes = sig.get(id)!
        for (let i = 0; i < b.params.length; i++) place(b.params[i], homes[i])
        emitTail(b.bodyId, b.bodyConst)
    }
    for (const stub of coldStubs) {
        put(() => asm.bindLabel(stub.label))
        for (const f of stub.code) code.push(f)
    }

    function promoteCommonRegionWrites(region: EmitRegion): Set<number> {
        const subtree: Set<number>[] = []
        const groups = new Map<number, number[]>()
        for (let i = 0; i < region.children.length; i++) {
            const child = region.children[i]
            subtree.push(promoteCommonRegionWrites(child))
            const siblings = groups.get(child.group)
            if (siblings) siblings.push(i)
            else groups.set(child.group, [i])
        }
        for (const siblings of groups.values()) {
            if (siblings.length < 2) continue
            const common = new Set(subtree[siblings[0]])
            for (let i = 1; i < siblings.length; i++) {
                const writes = subtree[siblings[i]]
                for (const r of common) if (!writes.has(r)) common.delete(r)
            }
            for (const r of common) region.writes.add(r)
        }
        const all = new Set(region.writes)
        for (const writes of subtree) for (const r of writes) all.add(r)
        return all
    }

    function assignRegionRegisters(region: EmitRegion, inherited: Set<number>): void {
        region.owned = target.calleeSaved.filter(r => region.writes.has(r) && written.has(r) && !inherited.has(r))
        const watermark = new Set(inherited)
        for (const r of region.owned) watermark.add(r)
        for (const child of region.children) assignRegionRegisters(child, watermark)
    }
    promoteCommonRegionWrites(rootRegion)
    if (returns) assignRegionRegisters(rootRegion, new Set())

    tailCalls = !analysis.frameAllocas && !usedPreserved.size && !slotCount && !callsOut
    if (!tailCalls && tails.size) callsOut = true
    const saved = returns ? target.calleeSaved.filter(r => usedPreserved.has(r) && written.has(r)) : []
    for (let i = 0; i < saved.length; i++) savedIndex.set(saved[i], i)
    const savesLink = returns && callsOut && LR !== undefined
    const layout = target.layoutFrame({
        saved: saved.length, link: savesLink, slots: slotCount, outgoingArgs: outgoingArgWords, allocas: analysis.frameAllocas,
    })
    frame = layout
    if (layout.bytes) asm.spAdjust(layout.bytes)
    for (const r of rootRegion.owned) asm.store(SP, layout.saved(savedIndex.get(r)!), r, Types.u64)
    if (savesLink) asm.store(SP, layout.link, LR!, Types.u64)
    let released: { value: number, home: number }[] = []
    const inRegister = (value: { value: number, home: number }) => !isSlot(value.home)
    for (const item of code) {
        if (typeof item !== 'function') {
            if ('released' in item) {
                released.push(...item.released)
                continue
            }
            const { dst, src, consumed } = item
            if (isSlot(src) && isSlot(dst)) {
                asm.load(SWAP, SP, slotOffset(src), Types.u64)
                asm.store(SP, slotOffset(dst), SWAP, Types.u64)
            } else if (isSlot(src)) asm.load(dst, SP, slotOffset(src), Types.u64)
            else if (isSlot(dst)) asm.store(SP, slotOffset(dst), src, Types.u64)
            else asm.mov(dst, src)
            if (consumed) released.push(consumed)
            if (released.length) {
                const kept: { value: number, home: number }[] = []
                let other = false
                for (const value of released) {
                    if (value.home === dst) continue
                    other = true
                    if (!isSlot(value.home)) kept.push(value)
                }
                if (other) asm.released(kept)
                released = []
            }
            continue
        }
        item()
        if (released.length) {
            asm.released(released.filter(inRegister))
            released = []
        }
    }

    function popFrame(region: EmitRegion): void {
        for (let r: EmitRegion | undefined = region; r; r = r.parent) {
            for (const reg of r.owned) asm.load(reg, SP, layout.saved(savedIndex.get(reg)!), Types.u64)
        }
        if (savesLink) asm.load(LR!, SP, layout.link, Types.u64)
        if (layout.bytes) asm.spAdjust(-layout.bytes)
    }

    const epilogues: EmitRegion[] = []
    function collectEpilogues(region: EmitRegion): void {
        for (const child of region.children) collectEpilogues(child)
        if (region !== rootRegion && region.owned.length) epilogues.push(region)
    }
    collectEpilogues(rootRegion)
    for (let i = 0; i < epilogues.length; i++) {
        const region = epilogues[i]
        asm.bindLabel(region.exitLabel)
        for (const r of region.owned) asm.load(r, SP, layout.saved(savedIndex.get(r)!), Types.u64)
        const target = regionExit(region.parent)
        const next = i + 1 < epilogues.length ? epilogues[i + 1].exitLabel : exitLabel
        if (target !== next) asm.jump(target)
    }
    asm.bindLabel(exitLabel)
    for (const r of rootRegion.owned) asm.load(r, SP, layout.saved(savedIndex.get(r)!), Types.u64)
    if (savesLink) asm.load(LR!, SP, layout.link, Types.u64)
    if (layout.bytes) asm.spAdjust(-layout.bytes)
    if (reachesExit || !tailCalls) asm.ret()

    if (spillStats && spillStats.total) console.log(`SPILLS ${g.name} total=${spillStats.total} again=${spillStats.again}`)
    if (spillStats && evictedOps.size) console.log(`EVICTED ${g.name} ${[...evictedOps].map(([op, n]) => `${op}=${n}`).join(' ')}`)
    if (spillStats && handoverKinds.size) console.log(`HANDOVER ${g.name} ${[...handoverKinds].map(([k, n]) => `${k}=${n}`).join(', ')}`)
    if (branchWasteProbe || intrinsics.argv().includes(`branch-waste:${g.name}`)) {
        reportBranchWaste(g.name ?? '<anonymous>', asm.listing())
    }
    let listing: string | undefined
    for (const r of target.calleeSaved) written.delete(r)
    for (const homes of continued.values()) homes.forEach((h, i) => { homes[i] = isSlot(h) ? INCOMING_ARGS + slotOffset(h) / 8 : h })
    return {
        target, words: asm.words(), bytes: asm.bytes(), relocations: asm.relocations(),
        get listing() { return listing ??= asm.listing() },
        clobbers: written, localCalls, island, continued,
    }
}

const branchWasteProbe = intrinsics.argv().includes('branch-waste')

function reportBranchWaste(name: string, listing: string): void {
    const before = new Map<string, string>()
    const jumps: [at: string, to: string][] = []
    let last = ''
    let lastAt = ''
    for (const raw of listing.split('\n')) {
        const line = raw.trim()
        if (!line) continue
        if (line.endsWith(':')) { before.set(line.slice(0, -1), last); continue }
        const at = line.slice(0, line.indexOf(':'))
        const text = line.slice(line.indexOf(':') + 1).trim()
        const body = text.slice(text.indexOf(' ') + 1).trim()
        const op = body.slice(0, body.indexOf(' ') < 0 ? body.length : body.indexOf(' '))
        if (op === 'b') jumps.push([at, body.slice(2).trim()])
        last = op
        lastAt = at
    }
    let waste = 0
    for (const [at, to] of jumps) {
        const prior = before.get(to)
        if (prior !== 'b' && prior !== 'ret') continue
        waste++
        console.log('WASTE', name, `${at}: b ${to} (preceded by ${prior})`)
    }
    console.log('WASTE', name, `totals jumps=${jumps.length} wasted=${waste}`)
}
