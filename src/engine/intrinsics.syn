/// @synth
/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

// for bootstrapping we do not use native sizes
type usize = u32
const nativeWord = 4

// for the test runner
export function argv(): string[] {
    const x = (globalThis as any).__argv 
    if (!x) throw 'Missing argv'
    return x
}

export function getComputation(fn: Function): [source: string, captures: any[]] {
    return (fn as any)[Symbol.for('toComputation')]()
}

export function bitsizeof<T>(t: reify T): u32 {
    // if (t is Type.Tuple) {
    //     let s: u32 = 0
    //     for (const x of t) {
    //         s += bitsizeof(x)
    //     }
    //     return s
    // }
    if (t is Type.Object) {
        let s: u32 = 0
        for (const [k, v] of Object.entries(t)) {
            if (k.startsWith('__')) continue
            // all structural types are allocated independently
            if (v is Type.Object | Type.Tuple) {
                s += bitsizeof(reify usize)
                continue
            }
            s += bitsizeof(v as Type) // BUG: checker whines here due to the narrowing
        }
        return s
    }
    if (t is Type.Union) {
        let s: u32 = 0
        for (const x of t) {
            const v = sizeof(x)
            if (v > s) s = v
        }
        return s
    }
    // arrays are effectively treated kind of like "many element" pointers
    // we do not track the length because we need it to fit in a scalar
    if ((t as any).element) {
        return bitsizeof(reify usize)
    }
    if (t is Type.Machine) {
        // XXX: we are failing to resolve `Type.Machine`, bad namespace merge
        if ((t as any)?.isConcrete) {
            if (!t.isConcrete()) throw `not concrete: ${t}`
            return t.width as u32
        }
    }
    // literals
    if (t === undefined) return 0
    if (t === Type.boolean) return 1
    if (t === true || t === false) return 1
    // for exact literals, we choose the nearest aligned representation
    if (t is u8 || t is i8) return 8
    if (t is u16) return 16
    if (t is u32) return 32
    throw `invalid type: ${t}`
}

export function sizeof<T>(t: reify T): u32 {
    return (bitsizeof(t) + 7) >> 3
}

export function definiteType(T: Type): Type {
    if (T is Type.Union) {
        const arr = [...T].filter(x => x !== undefined && x !== null)
        if (arr.length === 0) return reify never
        if (arr.length === 1) return arr[0]
        return new Type.Union(arr)
    }
    return T
}

export type StructView<T> = WrapInnerStructs<T> & {
    __address: usize
}

type WrapInnerStructs<T> = T extends object ? T extends { __address: usize } ? T : {
    [P in keyof T]: NonNullable<T[P]> extends number ? T[P] 
        : P extends `__${string}` ? T[P] : View<T[P]>
} : T

export type PackedView<T> = T & {
    __id: u32
    __scalar: usize
}

function setIndexDescriptor(
    base: any,
    get: (recv: any, k: any) => any,
    set: (recv: any, k: any, v: any) => void,
) {
    function indexOf(p: string | symbol): number | undefined {
        if (typeof p !== 'string' || p === '') return
        const n = Number(p)
        if (!Number.isSafeInteger(n) || n < 0 || String(n) !== p) return
        return n
    }
    // JS doesn't expose computed indexing so we impl it as a Proxy on the proto
    const p = new Proxy(base, {
        get(target, p, receiver) {
            if (p === '__proxyGet') return get
            if (p === '__proxySet') return set
            const index = indexOf(p)
            return index === undefined ? Reflect.get(target, p, receiver) : get(receiver, index)
        },
        set(target, p, newValue, receiver) {
            const index = indexOf(p)
            if (index === undefined) return Reflect.set(target, p, newValue, receiver)
            set(receiver, index, newValue)
            return true
        },
        has(target, key) {
            if (key === '__proxy') return true
            return indexOf(key) !== undefined || Reflect.has(target, key)
        },
    })
    return p
}

// we precompute this stuff to make it easier to work with
interface StructViewFactory<T> {
    id: u32
    sizeof: u32
    shouldInline: boolean
    (ptr: usize): StructView<T>
}
const structViews = new Map<u32, StructViewFactory<any>>()
const cachedStructViews = new Map<Type, StructViewFactory<any>>()
function getStructView(T: Type) {
    //if (const cached = cachedStructViews.get(T)) return cached
    const cached = cachedStructViews.get(T)
    if (cached) return cached
    return DefineStructView(T)
}

// We treat a "struct" as a view over a memory address
export function DefineStructView<T>(T: reify T): StructViewFactory<T> {
    type Self = { __address: usize }
    if (!(T is Type.Object)) {
        if ((T as any).element) {
            const size = sizeof(T as Type)
            const id = (cachedStructViews.size as u32) + 1
            const f = function(ptr: usize) {
                const o = { __address: ptr }
                return Object.setPrototypeOf(o, properties) as StructView<T>
            }
            f.id = id
            f.sizeof = size
            f.shouldInline = true
            cachedStructViews.set(T, f)
            const elementType = (T as any).element
            const elementSize = sizeof(elementType)
            const load = createArrayLoadFn(elementType)
            const store = createArrayStoreFn(elementType)
            const properties = setIndexDescriptor(
                {},
                tagInline((recv: Self, k: usize) => {
                    return load(recv.__address, k*elementSize)
                }),
                tagInline((recv: Self, k: usize, v) => {
                    store(recv.__address, k*elementSize, v)
                }),
            )
            structViews.set(id, f)
            return f
        }
        console.log(T)
        throw `Unable to create struct for type: ${T}`
    }
    const size = sizeof(T as Type) // FIXME: Type & Type.Object is busted
    const id = (cachedStructViews.size as u32) + 1
    let offset: usize = 0
    const f = function(ptr: usize) {
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as StructView<T>
    }
    f.id = id
    f.sizeof = size
    f.shouldInline = true
    cachedStructViews.set(T, f)
    const descriptors = Object.entries(T).filter(([k]) => !k.startsWith('__')).map(([k, v]) => {
        v = definiteType(v)
        const from = offset
        offset += sizeof(v)
        const load = createLoadFn(v)
        const store = createStoreFn(v)
        return [k, {
            get: tagInline(function(this: Self) {
                return load(this.__address, from)
            }),
            set: tagInline(function(this: Self, val: any) {
                store(this.__address, from, val)
            }),
            enumerable: true,
            configurable: true,
        } satisfies PropertyDescriptor]
    })
    const properties = Object.defineProperties({}, Object.fromEntries(descriptors))
    structViews.set(id, f)
    arrayViews.set(f, createArrayView(T))
    return f
}

function tagInline<T extends Function>(f: T): T {
    return Object.assign(f, { shouldInline: true }) as any
}

const arrayViews = new Map<StructViewFactory<any>, any>()
function createArrayView(T: Type) {
    type Self = { __address: usize }
    const f = function(ptr: usize) {
        const o = { __address: ptr }
        return Object.setPrototypeOf(o, properties) as any
    }
    const elementSize = sizeof(T)
    const load = createArrayLoadFn(T)
    const store = createArrayStoreFn(T)
    const properties = setIndexDescriptor(
        {},
        tagInline((recv: Self, k: usize) => {
            return load(recv.__address, k*elementSize)
        }),
        tagInline((recv: Self, k: usize, v) => {
            store(recv.__address, k*elementSize, v)
        }),
    )
    return f
}

type View<T> = T extends (infer U)[] ? ArrayView<U> : StructView<T>
//type ByteAlignment<T> = T extends u8 ? 1 : T extends u16 ? 2 : T extends u32 ? 4 : number
interface ArrayView<T> {
    __address: usize
    //__align: ByteAlignment<T>
    [idx: usize]: T
}

function fieldOffset(T: Type.Object, name: string) {
    let offset: usize = 0
    for (const [k, v] of Object.entries(T)) {
        if (k === name) return offset
        offset += sizeof(v)
    }
    throw `No field named "${name}" found in type: ${T}`
}

function getRcInfo(T: Type.Object) {
    const field = T['$rc']
    if (!field) return
    return [fieldOffset(T, '$rc'), lowerType(field)] as const
}

// returns true if we freed `addr`
// ref counted structs are never stored on the stack, so this is fine
function adjustRc(addr: usize, offset: usize, T: Types, amt: i8) {
    const cur = Intrinsics.load(addr, offset, T) as u32
    if (-amt >= cur) {
        Intrinsics.free(addr)
        return true
    }
    Intrinsics.store(addr, offset, cur+amt, T)
    return false
}

function createStoreFn(T: Type) {
    if (T is Type.Object) {
        const f = (addr: usize, offset: usize, v: any) => {
            if (!v) {
                Intrinsics.store(addr, offset, 0, Types.u32)
            } else {
                const __address = v.__address
                Intrinsics.store(addr, offset, __address, Types.u32)
            }
        }
        tagInline(f)
        const rcInfo = getRcInfo(T)
        if (!rcInfo) return f
        return (addr: usize, offset: usize, v: any) => {
            const prev = Intrinsics.load(addr, offset, Types.u32)
            const __address = v?.__address
            f(addr, offset, v)
            if (prev === __address) return
            if (prev !== 0) adjustRc(prev, rcInfo[0], rcInfo[1], -1)
            if (__address !== 0) adjustRc(__address, rcInfo[0], rcInfo[1], 1)
        }
    }
    if ((T as any).element) {
        const f = (addr: usize, offset: usize, v: any) => {
            if (!v) {
                Intrinsics.store(addr, offset, 0, Types.u32)
            } else {
                const __address = v.__address
                Intrinsics.store(addr, offset, __address, Types.u32)
            }
        }
        return tagInline(f)
    }
    const U = lowerType(T)
    return tagInline((addr: usize, offset: usize, v: any) => {
        Intrinsics.store(addr, offset, v, U)
    })
}

function createLoadFn(T: Type) {
    if (T is Type.Object) {
        const view = getStructView(T)
        return tagInline((addr: usize, offset: usize) => {
            const ptr = Intrinsics.load(addr, offset, Types.u32)
            //if (!ptr) return
            return view(ptr)
        })
    }
    if ((T as any).element) {
        const view = getStructView(T)
        return tagInline((addr: usize, offset: usize) => {
            const ptr = Intrinsics.load(addr, offset, Types.u32)
            // if (!ptr) throw "Uninitialized array"
            return view(ptr)
        })
    }
    const U = lowerType(T)
    return tagInline((addr: usize, offset: usize) => {
        return Intrinsics.load(addr, offset, U)
    })
}

function createArrayStoreFn(T: Type) {
    if (T is Type.Object) {
        const size = sizeof(T as any)
        const f = (addr: usize, offset: usize, v: any) => {
            const target = addr + offset
            if (!v) {
                memsetByte(target, size, 0)
            } else {
                const __address = v.__address
                memcpy(target, __address, size)
            }
        }
        tagInline(f)
        const rcInfo = getRcInfo(T)
        if (rcInfo) throw "RC not supported"
        return f
    }
    if ((T as any).element) {
        throw "TODO: nested array"
    }
    const U = lowerType(T)
    return tagInline((addr: usize, offset: usize, v: any) => {
        Intrinsics.store(addr, offset, v, U)
    })
}

function createArrayLoadFn(T: Type) {
    if (T is Type.Object) {
        const view = getStructView(T)
        return tagInline((addr: usize, offset: usize) => {
            return view(Intrinsics.add(addr, offset, Types.u32, Types.u32) as usize)
        })
    }
    if ((T as any).element) {
        throw "TODO: nested array"
    }
    const U = lowerType(T)
    return tagInline((addr: usize, offset: usize) => {
        return Intrinsics.load(addr, offset, U)
    })
}

// FIXME: analyzer breaks on expando `sizeof`
export function New<T>(view: StructViewFactory<T>): StructView<T> {
    const ptr = Intrinsics.alloc(view.sizeof)
    const s = view(ptr)
    return s
}

export function StackNew<T>(view: StructViewFactory<T>): StructView<T> {
    const ptr = Intrinsics.stackalloc(view.sizeof)
    const s = view(ptr)
    return s
}

// we don't want to reify directly here
export enum Types {
    u8,
    u16,
    u32,
    u64,
    i8,
    i16,
    i32,
    i64,
    f16,
    f32,
    f64,
    bool,

    usize,
    void,
    ptr, // explicitly a native ptr
    unknown, // used during interpretation
    smi, // encoded i31
    handle, // encoded u31

    // sometimes, it's just easier to keep it simple
    u1, u2, u3, u4, u5, u6, u7,
    u9, u10, u11, u12, u13, u14, u15, u17,
    u19, u20, u21, u22, u23, u24, u25, u26,
    u27, u28, u29, u30, u31,

    i1, i2, i3, i4, i5, i6, i7,
}

const u8Array = DefineStructView(reify u8[])
const u16Array = DefineStructView(reify u16[])
const u32Array = DefineStructView(reify u32[])

export function Alloc(T: Types.u8, count: usize): ArrayView<u8>
export function Alloc(T: Types.u16, count: usize): ArrayView<u16>
export function Alloc(T: Types.u32, count: usize): ArrayView<u32>
export function Alloc<T>(view: StructViewFactory<T>, count: usize): ArrayView<T>
export function Alloc<T>(view: StructViewFactory<T> | Types | number, count: usize): ArrayView<T> {
    const total = (view is number ? intrinsicBitWidth(view)*8 as u32 : (view as any).sizeof as u32)*count
    const ptr = Intrinsics.alloc(total)
    if (view === Types.u8) return u8Array(ptr) as any
    if (view === Types.u16) return u16Array(ptr) as any
    if (view === Types.u32) return u32Array(ptr) as any
    if (view is number) throw `todo: ${view}`
    return arrayViews.get(view)(ptr) as any
}

export function StackAlloc<T>(T: Types.u8, count: usize): ArrayView<u8>
export function StackAlloc<T>(T: Types.u16, count: usize): ArrayView<u16>
export function StackAlloc<T>(T: Types.u32, count: usize): ArrayView<u32>
export function StackAlloc<T>(view: StructViewFactory<T>, count: usize): ArrayView<T>
export function StackAlloc<T>(view: StructViewFactory<T> | Types | number, count: usize): ArrayView<T> {
    const total = (view is number ? intrinsicBitWidth(view)*8 as u32 : (view as any).sizeof as u32)*count
    const ptr = Intrinsics.stackalloc(total)
    if (view === Types.u8) return u8Array(ptr) as any
    if (view === Types.u16) return u16Array(ptr) as any
    if (view === Types.u32) return u32Array(ptr) as any
    if (view is number) throw `todo: ${view}`
    return arrayViews.get(view)(ptr) as any
}

interface MakeByteBitpackResult {
    setters: ((cur: u8, val: any) => u8)[]
    getters: ((cur: u8) => any)[]
    bitsUsed: usize
    rem: Type[]
}

