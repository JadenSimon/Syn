export function assert(x: unknown): asserts x {
    if (!x) throw "Assertion failed"
}

export function alignUp(x: usize, alignment: usize): usize {
    return (x + alignment - 1) & ~(alignment - 1)
}

export function memcpy(dst: usize, src: usize, len: usize): void {
    let i: usize = 0
    while ((len-i) >= 4) {
        const v = Intrinsics.load(src, i, Types.u32)
        Intrinsics.store(dst, i, v, Types.u32)
        i += 4
    }
    while ((len-i) >= 2) {
        const v = Intrinsics.load(src, i, Types.u16)
        Intrinsics.store(dst, i, v, Types.u16)
        i += 2
    }
    if (i !== len) {
        const v = Intrinsics.load(src, i, Types.u8)
        Intrinsics.store(dst, i, v, Types.u8)
    }
}

export function memsetByte(dst: usize, len: usize, fill: u8): void {
    if (!fill) {
        while (len >= 8) {
            len -= 8
            Intrinsics.store(dst, len, fill, Types.u64)
        }
        while (len >= 4) {
            len -= 4
            Intrinsics.store(dst, len, fill, Types.u32)
        }
        while (len >= 2) {
            len -= 2
            Intrinsics.store(dst, len, fill, Types.u16)
        }
    }
    while (len) {
        len -= 1
        Intrinsics.store(dst, len, fill, Types.u8)
    }
}

export function memeql(dst: usize, src: usize, len: usize): boolean {
    let i: usize = 0
    while ((len-i) >= 4) {
        const v = Intrinsics.load(src, i, Types.u32)
        const u = Intrinsics.load(dst, i, Types.u32)
        if (v !== u) return false
        i += 4
    }
    while ((len-i) >= 2) {
        const v = Intrinsics.load(src, i, Types.u16)
        const u = Intrinsics.load(dst, i, Types.u16)
        if (v !== u) return false
        i += 2
    }
    if (i !== len) {
        const v = Intrinsics.load(src, i, Types.u8)
        const u = Intrinsics.load(dst, i, Types.u8)
        if (v !== u) return false
    }
    return true
}

export function maxValExcl(T: Types) {
    const c = getTypeClass(T)
    if (c === TypeClass.float) throw `todo`
    const w = intrinsicBitWidth(T)
    if (c === TypeClass.int) return Math.pow(2, w - 1) - 1
    return Math.pow(2, w)
}

export function minVal(T: Types) {
    const c = getTypeClass(T)
    if (c === TypeClass.float) throw `todo`
    if (c !== TypeClass.int) return 0
    const w = intrinsicBitWidth(T)
    return -Math.pow(2, w - 1)
}

export function inRange(T: Types, v: any) {
    return v >= minVal(T) && v < maxValExcl(T)
}

function intrinsicBitWidth(T: Types) {
    switch (T) {
        case Types.u8: return 8
        case Types.u16: return 16
        case Types.u32: return 32
        case Types.u64: return 64
        case Types.i8: return 8
        case Types.i16: return 16
        case Types.i32: return 32
        case Types.i64: return 64
        case Types.f16: return 16
        case Types.f32: return 32
        case Types.f64: return 64
        case Types.void: return 0
        case Types.bool: return 1
        case Types.unknown: return 1
        case Types.ptr:
        case Types.usize: return nativeWord*8
        // these are the _effective_ bitwidths
        case Types.handle:
        case Types.smi: return 31
        default: throw `Unhandled machine intrinsic: ${T}`
    }
}


type UnaryOp = 'neg' | 'not'

type BitwiseOp = 'or' | 'and' | 'xor' | 'not' | 'ushr' | 'shr' | 'shl'
type CmpOp = 'lt' | 'le' | 'gt' | 'ge' | 'eq' | 'ne'
type ArithmeticOp = 'add' | 'sub' | 'mul' | 'div' | 'neg' | 'rem' | 'pow'
type Op = ArithmeticOp | CmpOp | BitwiseOp

export function isCommutativeOp(op: Op) {
    switch (op) {
        case 'add':
        case 'mul':
            return true
        case 'eq':
        case 'ne':
            return true
        case 'or':
        case 'and':
        case 'xor':
            return true
    }
    return false
}

const bitwiseOps = reify BitwiseOp
function isBitwiseOp(op: Op): op is BitwiseOp {
    return bitwiseOps.has(op)
}

enum TypeClass {
    uint,
    int,
    float,
    bool,
}

function getTypeClass(T: Types): TypeClass {
    if (T <= Types.u64) return TypeClass.uint
    if (T <= Types.i64) return TypeClass.int
    if (T <= Types.f64) return TypeClass.float
    if (T === Types.bool) return TypeClass.bool
    if (T >= Types.u1 && T <= Types.u31) return TypeClass.uint
    if (T >= Types.i1 && T <= Types.i7) return TypeClass.int
    if (T == Types.ptr) return TypeClass.uint
    if (T == Types.handle) return TypeClass.uint
    if (T === Types.smi) return TypeClass.int
    throw `Unknown type class: ${T}`
}

function negateType(T: Types) {
    switch (T) {
        case Types.u8: return Types.i16
        case Types.u16: return Types.i32
        case Types.u32: return Types.i64
        case Types.u64: throw `Cannot negate u64 without losing precision`
    }
    return T
}

function promoteArithType(T: Types, U: Types, tc: TypeClass, uc: TypeClass) {
    if (tc === TypeClass.float) return T 
    if (uc === TypeClass.float) return U
    if (tc === TypeClass.bool || uc === TypeClass.bool) throw `unhandled type class (bool): ${tc} | ${uc}`
    // choose the largest width and make it signed
    if (intrinsicBitWidth(T) > intrinsicBitWidth(U)) return negateType(T)
    return negateType(U)
}

function chooseArithmeticResultType(op: Exclude<ArithmeticOp, UnaryOp>, T: Types, U: Types) {
    if (T === U) return T
    const tc = getTypeClass(T)
    const uc = getTypeClass(U)
    if (tc === uc) {
        if (op === 'div' || op === 'rem') return T
        return intrinsicBitWidth(T) > intrinsicBitWidth(U) ? T : U
    }
    return promoteArithType(T, U, tc, uc)
}

function chooseBitwiseResultType(op: Exclude<BitwiseOp, UnaryOp>, T: Types, U: Types) {
    if (T === U) return T
    const tc = getTypeClass(T)
    if (tc === TypeClass.float || tc === TypeClass.bool) throw `Unhandled type class: ${tc}`
    const uc = getTypeClass(U)
    if (uc === TypeClass.float || uc === TypeClass.bool) throw `Unhandled type class: ${uc}`

    switch (op) {
        case 'and':
        case 'or':
        case 'xor':
            const w = intrinsicBitWidth(T)
            const v = intrinsicBitWidth(U)
            if (w === v) return tc === TypeClass.int ? T : U
            if (op === 'and') {
                // narrows to the smaller operand
                return w > v ? U : T
            }
            return w > v ? T : U // effectively zero extends
        case 'shl':
        case 'shr':
        case 'ushr':
            return T
    }

    throw `unknown bitwise op: ${op}` // `not` is the operand type directly
}

function lowerType(T: Type): Types {
    switch (T) {
        case reify u8: return Types.u8
        case reify u16: return Types.u16
        case reify u32: return Types.u32
        case reify u64: return Types.u64
        case reify i8: return Types.i8
        case reify i16: return Types.i16
        case reify i32: return Types.i32
        case reify i64: return Types.i64
        // case reify f16: return Types.f16
        // case reify f32: return Types.f32
        case reify f64: return Types.f64
        // case reify usize: return Types.usize
        default: throw `Cannot lower type: ${String(T)}`
    }
}

function intrinsicLoad(ptr: usize, offset: usize, T: Types.u8): u8
function intrinsicLoad(ptr: usize, offset: usize, T: Types.u16): u16
function intrinsicLoad(ptr: usize, offset: usize, T: Types.u32): u32
function intrinsicLoad(ptr: usize, offset: usize, T: Types.usize): usize
function intrinsicLoad(ptr: usize, offset: usize, T: Types.i8): i8
function intrinsicLoad(ptr: usize, offset: usize, T: Types.i16): i16
function intrinsicLoad(ptr: usize, offset: usize, T: Types.i32): i32
function intrinsicLoad(ptr: usize, offset: usize, T: Types.f64): f64
function intrinsicLoad(ptr: usize, offset: usize, T: Types): number
function intrinsicLoad(ptr: usize, offset: usize, T: Types) {
    resultType = T
    const p = ptr + offset
    switch (T) {
        case Types.u8: return memView.getUint8(p)
        case Types.i8: return memView.getInt8(p)
        case Types.u16: return memView.getUint16(p, true)
        case Types.i16: return memView.getInt16(p, true)
        case Types.usize: // XXX
        case Types.u32: return memView.getUint32(p, true)
        case Types.i32: return memView.getInt32(p, true)
        case Types.f64: return memView.getFloat64(p, true)
        case Types.u64: {
            const lo = memView.getUint32(p, true)
            const hi = memView.getUint32(p + 4, true)
            return hi * 0x1_0000_0000 + lo
        }
        case Types.i64: {
            const lo = memView.getUint32(p, true)
            const hi = memView.getInt32(p + 4, true)
            return hi * 0x1_0000_0000 + lo
        }
        default:
            throw `load: unsupported type ${T}`
    }
}

function intrinsicStore(ptr: usize, offset: usize, val: i8, T: Types.i8): void
function intrinsicStore(ptr: usize, offset: usize, val: i16, T: Types.i16): void
function intrinsicStore(ptr: usize, offset: usize, val: i32, T: Types.i32): void
function intrinsicStore(ptr: usize, offset: usize, val: i64, T: Types.i64): void
function intrinsicStore(ptr: usize, offset: usize, val: u8, T: Types.u8): void
function intrinsicStore(ptr: usize, offset: usize, val: u16, T: Types.u16): void
function intrinsicStore(ptr: usize, offset: usize, val: u32, T: Types.u32): void
function intrinsicStore(ptr: usize, offset: usize, val: u64, T: Types.u64): void
function intrinsicStore(ptr: usize, offset: usize, val: usize, T: Types.usize): void
function intrinsicStore(ptr: usize, offset: usize, val: f64, T: Types.f64): void
function intrinsicStore(ptr: usize, offset: usize, val: boolean, T: Types.bool): void
function intrinsicStore(ptr: usize, offset: usize, val: any, T: Types): void
function intrinsicStore(ptr: usize, offset: usize, val: f64 | i64 | u64 | boolean, T: Types) {
    if (val is boolean) val = val ? 1 : 0
    resultType = Types.void
    const p = ptr + offset
    switch (T) {
        case Types.u8: memView.setUint8(p, val); return
        case Types.i8: memView.setInt8(p, val); return
        case Types.u16: memView.setUint16(p, val, true); return
        case Types.i16: memView.setInt16(p, val, true); return
        case Types.usize: // XXX
        case Types.u32: memView.setUint32(p, val >>> 0, true); return
        case Types.i32: memView.setInt32(p, val, true); return
        case Types.f64: memView.setFloat64(p, val, true); return
        case Types.u64: memView.setBigUint64(p, BigInt(val), true)
        case Types.i64: {
            const lo = val >>> 0
            const hi = Math.floor(val / 0x1_0000_0000) | 0
            memView.setUint32(p, lo, true)
            memView.setInt32(p + 4, hi, true)
            return
        }
        default:
            throw `store: unsupported type ${T}`
    }
}

const maxMem: usize = 1 << 24

// ambient state

let stackPointer: usize = maxMem 
let overflow: 0 | 1 = 0
let resultType = Types.unknown

export const Intrinsics = {
    addressof: function(v: any): usize {
        resultType = Types.ptr
        const addr = v.__address
        if (addr === undefined) throw `No address found: ${v}`
        return addr
    },
    sp: function(v?: usize) {
        if (v !== undefined) stackPointer = v
        return stackPointer
    },
    stackalloc: function(amt: usize) {
        resultType = Types.ptr
        stackPointer -= amt
        return stackPointer
    },
    stackfree: function(amt: usize) {
        resultType = Types.ptr
        stackPointer += amt
    },
    // heap alloc/free
    alloc: function(amt: usize) {
        resultType = Types.ptr
        return allocBlock(amt)
    },
    free: function(ptr: usize | { __address: usize }) {
        // FIXME: analyzer is busted on excluding usize here 
        freeBlock(typeof ptr === 'number' ? ptr : (ptr as any).__address)
    },
    store: intrinsicStore,
    load: intrinsicLoad,
    // direct reinterpretation
    bitconvert: function(v: any, T: Types, U: Types) {
        resultType = U
        if (v === true) return 1
        if (v === false) return 0
        if (U === Types.bool) return v ? true : false
        if (T >= Types.i1 && T <= Types.i7) {
            const bits = 1 + (T - Types.i1)
            const max = 1 << bits
            return v < 0 ? v + max : v
        }
        if (U >= Types.i1 && U <= Types.i7) {
            const bits = (U - Types.i1)
            const max = 1 << bits
            return v >= max ? v - (max << 1) : v
        }
        return v
    },

    select: function<T, U>(cond: boolean, v1: T, v2: U, R: Types) {
        resultType = R
        return cond ? v1 : v2
    },
    jmp: (pc: usize, off: usize) => {
        assert((pc + off as any) >= 0)
        resultType = Types.usize
        return pc + off
    },
    dispatch: (pc: usize) => {
        return pc
    },
    branch: (cond: boolean, v1: usize, v2: usize) => {
        resultType = Types.usize
        return cond ? v1 : v2
    },
    call: (target: any, thisArg: any, regStart: any, regCount: any, cb: any) => {
        return cb(target, thisArg, regStart, regCount)
    },
    ret: function(v: any, T: Types) {
        resultType = T
        return v
    },
    panic: function(v: any, T?: Types): never {
        resultType = T ?? Types.usize
        throw v
    },
    // converts T -> U
    convert: function(v: any, T: Types, U: Types) {
        resultType = U
        if (T === U) return v
        if (U === Types.f64) return Number(v)
        if (T === Types.f64) return Math.trunc(v)
        if (T === Types.i8 && U <= Types.u32) return (v & 0xFF) - ((v & 0x80) ? 256 : 0)
        if (T === Types.i16 && U <= Types.u32) return (v & 0xFFFF) - ((v & 0x8000) ? 65536 : 0)
        if (T === Types.i32 && U <= Types.u32) return (v & 0xFFFF_FFFF) - ((v & 0x8000_0000) ? 4294967296 : 0)
        return v
    },
    isinteger: function(v: number) {
        resultType = Types.bool
        return Number.isInteger(v)
    },
    canexit: function(acc: any) { // XXX
        return true
    },
    typeofresult: function() {
        return resultType
    },
    checkoverflow: function() {
        return overflow
    },
    // synthetic
    literal: (val: any, T: Types) => {
        return val
    },
    // more specific ops
    subsat: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('sub', T, U)
        overflow = 0
        return Math.max(a - b, minVal(resultType))
    },
    // basic ops
    add: (a: any, b: any, T: Types, U: Types) => {
        resultType = chooseArithmeticResultType('add', T, U)
        return updateOverflow(T, U, a, b, a + b)
    },
    sub: (a: any, b: any, T: Types, U: Types) => {
        resultType = chooseArithmeticResultType('sub', T, U)
        return updateOverflow(T, U, a, b, a - b)
    },
    mul: (a: any, b: any, T: Types, U: Types) => {
        resultType = chooseArithmeticResultType('mul', T, U)
        const r = a * b
        overflow = didOverflow(r, resultType) // technically may be wrong w/ very large numbers
        return r
    },
    div: (a: any, b: any, T: Types, U: Types) => {
        resultType = chooseArithmeticResultType('div', T, U)
        const isFloat = getTypeClass(resultType) === TypeClass.float
        if (!isFloat && b === 0) throw "Got zero operand for idiv"
        let r = a / b
        if (!isFloat) {
            const z = r
            r = Math.trunc(r)
            overflow = r !== z ? 1 : 0
        } else {
            overflow = didOverflow(r, resultType)
        }
        return r
    },
    rem: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('rem', T, U)
        overflow = 0
        return a % b // XXX: not accurate
    },
    pow: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('pow', T, U)
        const r = a ** b
        overflow = didOverflow(r, resultType)
        return r
    }, 
    neg: function(a: any, T: Types) {
        resultType = negateType(T)
        return -a
    },
    not: function(a: any, T: Types) {
        resultType = T
        return ~a
    },
    and: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('and', T, U)
        return a & b
    },
    or: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('or', T, U)
        return a | b
    },
    xor: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('xor', T, U)
        return a ^ b
    },
    shl: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('shl', T, U)
        return a << b
    },
    shr: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('shr', T, U)
        return a >> b
    },
    ushr: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('ushr', T, U)
        return a >>> b
    },
    lt: (a: any, b: any, T: Types, U: Types) => {
        resultType = Types.bool
        return a < b
    },
    gt: (a: any, b: any, T: Types, U: Types) => {
        resultType = Types.bool
        return a > b
    },
    le: (a: any, b: any, T: Types, U: Types) => {
        resultType = Types.bool
        return a <= b
    },
    ge: (a: any, b: any, T: Types, U: Types) => {
        resultType = Types.bool
        return a >= b
    },
    eq: (a: any, b: any, T: Types, U: Types) => {
        resultType = Types.bool
        return a === b
    },
    ne: (a: any, b: any, T: Types, U: Types) => {
        resultType = Types.bool
        return a !== b
    },
}

function didOverflow(r: number, T: Types) {
    if (T === Types.f64) return 0
    return (r >= minVal(T) && r < maxValExcl(T)) ? 0 : 1
}

function updateOverflow(T: Types, U: Types, a: number, b: number, r: number) {
    overflow = (T === U && ((a ^ r) & (b ^ r)) < 0) ? 1 : 0
    return r
}

type MiscOp = Exclude<keyof typeof Intrinsics, Op>
type AllOps = MiscOp | Op

type OpArgs<T extends AllOps> = Parameters<IntrinsicObj[T]>

type HasVoidReturnMap<T> = {
    [P in keyof T]: T[P] extends (...args: any) => infer U 
        ? void extends U ? true : false
        : false 
}

const voidReturnMap = reify HasVoidReturnMap<IntrinsicObj>

type IntrinsicObj = typeof Intrinsics
export type Replacements = {
    readonly [P in keyof IntrinsicObj]?: (
        ...args: Parameters<IntrinsicObj[P]>
    ) => any | undefined
}

type BinaryOp = Exclude<Op, UnaryOp>

interface BaseOpTrace {
    readonly op: AllOps
    readonly args: Float64Array
    readonly result: any
    readonly resultType: Types
    readonly resultId: number
    readonly argIds: number[]
}

// more specific shapes

interface BinaryOpTrace extends BaseOpTrace {
    readonly op: BinaryOp
    readonly a: any
    readonly b: any
    readonly T: Types
    readonly U: Types
}

interface UnaryOpTrace extends BaseOpTrace {
    readonly op: UnaryOp
    readonly a: any
    readonly T: Types
}

interface ConvertOpTrace extends BaseOpTrace {
    readonly op: 'convert' | 'bitconvert'
    readonly a: any
    readonly T: Types
    readonly U: Types
}

interface LoadTrace extends BaseOpTrace {
    readonly op: 'load'
    readonly ptr: any
    readonly offset: any
    readonly T: Types // T is the desired type here
}

interface StoreTrace extends BaseOpTrace {
    readonly op: 'store'
    readonly ptr: any
    readonly offset: any
    readonly val: any
    readonly T: Types // type of val
}

interface StackTrace extends BaseOpTrace {
    readonly op: 'stackalloc' | 'stackfree'
    readonly amt: any
}

interface LiteralTrace extends BaseOpTrace {
    readonly op: 'literal'
    readonly val: any
    readonly T: Types
}

interface MiscTrace extends BaseOpTrace {
    readonly op: 'ret' | 'select' | 'call'
}

export type OpTrace = 
    | BinaryOpTrace
    | UnaryOpTrace
    | ConvertOpTrace
    | LoadTrace
    | StoreTrace
    | StackTrace
    | LiteralTrace
    | MiscTrace

type TypedOpArgs = { [P in AllOps]: [P, OpArgs<P>] }[AllOps]

function buildOpTrace(
    op: AllOps,
    args: Float64Array,
    result: any,
    resultType: Types,
    resultId: number,
    argIds: number[],
): OpTrace {
    const base = { op, args, result, resultType, resultId, argIds }
    const pair = [op, args] as any as TypedOpArgs
    switch (pair[0]) {
        case 'add': case 'sub': case 'mul': case 'div': case 'rem': case 'pow':
        case 'lt': case 'le': case 'gt': case 'ge': case 'eq': case 'ne':
        case 'or': case 'and': case 'xor': case 'ushr': case 'shr': case 'shl':
            const [a, b, T, U] = pair[1]
            return { ...base, op: pair[0], a, b, T, U }
        case 'neg': case 'not':
            const [a, T] = pair[1]
            return { ...base, op: pair[0], a, T }
        case 'convert': case 'bitconvert':
            const [a, T, U] = pair[1]
            return { ...base, op: pair[0], a, T, U }
        case 'load':
            const [ptr, offset, T] = pair[1]
            return { ...base, op: pair[0], ptr, offset, T }
        case 'store':
            const [ptr, offset, val, T] = pair[1]
            return { ...base, op: pair[0], ptr, offset, val, T }
        case 'stackalloc': case 'stackfree':
            const [amt] = pair[1]
            return { ...base, op: pair[0], amt }
        case 'literal':
            return { ...base, op: pair[0], val: pair[1][0], T: pair[1][1] }

        default:
            return base as OpTrace
    }
}

type u48 = Int<48, false>

const nanIdView = new DataView(new ArrayBuffer(8))
nanIdView.setFloat64(0, NaN, true)
export function getNanId(nan: number): u48 {
    if (typeof nan !== 'number') return 0
    if (!isNaN(nan)) return 0
    nanIdView.setFloat64(0, nan, true)
    const low = nanIdView.getUint32(0, true)
    const high = nanIdView.getUint32(4, true) & 0xFFFF // 3 bits unused
    if (!high) return low as u48
    return low + (high * 0x1_0000_0000) as u48
}

export function getNanFromId(id: number): f64 {
    nanIdView.setUint32(0, id, true)
    if (id >= 0x1_0000_0000) {
        const rem = nanIdView.getUint32(4, true) & ~0xFFFF
        nanIdView.setUint32(4, Math.trunc(id / 0x1_0000_0000) | rem, true)
    }
    return nanIdView.getFloat64(0, true) as f64
}

export function createIntrinsicsTracer(
    target: IntrinsicObj,
    replacements: Replacements = {},
) {
    let active = true
    let traceConcreteOps = false
    let opCount = 0
    let totalTime = 0
    let prevTimestamp: number | undefined
    const timerMask = (2**16)-1
    const maxTraceTime = 2_000 // ms
    // unique NaNs are used to represent "unknown" values, leaving other literals untouched
    let nanCounter = 1 // native NaN is 0
    function createUniqueNan(): f64 {
        const id = nanCounter++
        return getNanFromId(id)
    }
    const nanOpCache = new Map<string, Map<any, any>>()
    function getKey(x: any): any {
        if (typeof x !== 'number') return x
        const key = getNanId(x)
        assert(key || !isNaN(x))
        return key ? `nanId: ${key}` : x
    }
    interface CachedNan { id: u48 }
    function searchCache(m: Map<any, any>, args: Float64Array) {
        for (let i = 0; i < args.length; i++) {
            const key = getKey(args[i])
            const x = m.get(key)
            if (i === args.length - 1) {
                if (x !== undefined) {
                    assert(x is CachedNan)
                    return getNanFromId(x.id)
                }
                const id = nanCounter
                const r = createUniqueNan()
                m.set(key, { id })
                return r
            }
            if (x !== undefined) {
                assert(x instanceof Map)
                m = x
            } else {
                const next = new Map()
                m.set(key, next)
                m = next
            }
        }
        throw 'empty nan cache path'
    }
    function getCachedNan(op: string, args: Float64Array) {
        const key = `${op}/${args.length}`
        let m = nanOpCache.get(key)
        if (!m) nanOpCache.set(key, m = new Map())
        if (!args.length) {
            if (const x = m.get(undefined)) return getNanFromId((x as CachedNan).id)
            const id = nanCounter
            const r = createUniqueNan()
            m.set(undefined, { id })
            return r
        }
        if (op === 'add' && args[2] === args[3]) {
            // sort high to low so literals appear last
            if (getNanId(args[0]) < getNanId(args[1])) {
                const tmp = args[0]
                args[0] = args[1]
                args[1] = tmp
            }
        }
        return searchCache(m, args)
    }
    const traces: OpTrace[] = []
    const tracedResultMap = new Map<u48, OpTrace>()
    const nanTypeMap = new Map<u48, Types>()
    function getEffectiveType(v: any): Types | undefined {
        const nanId = getNanId(v)
        if (!nanId) return
        if (const T = nanTypeMap.get(nanId)) return T
    }
    function createTypedUnknown(T: Types) {
        const id = nanCounter 
        const v = createUniqueNan()
        nanTypeMap.set(id as u48, T)
        return v
    }
    function assertIsTaggedNanStill(val: any, ctx: string = '$'): void {
        if (Array.isArray(val) || val instanceof Float64Array) {
            for (let i = 0; i < val.length; i++) {
                assertIsTaggedNanStill(val[i], `${ctx}[${i}]`)
            }
            return
        }
        if (typeof val === 'object' && !!val) {
            return Object.entries(val).forEach(([k, v]) => {
                assertIsTaggedNanStill(v, `${ctx}.${k}`)
            })
        }
        if (typeof val !== 'number') return
        if (!isNaN(val)) return
        if (getNanId(val)) return
        throw `Found invalid nan @ ${ctx}`
    }
    function captureTrace(op: AllOps, args: Float64Array, result: any, resultType: Types) {
        const nanId = getNanId(result)
        const argIds: number[] = []
        for (let i = 0; i < args.length; i++) argIds.push(getNanId(args[i]))
        const trace = buildOpTrace(op, args, result, resultType, nanId, argIds)
        assertIsTaggedNanStill(trace, 'trace')
        traces.push(trace)
        if (nanId && !tracedResultMap.has(nanId)) {
            tracedResultMap.set(nanId, trace)
            nanTypeMap.set(nanId, resultType)
        }
        return trace
    }
    if ((target as any).__traced) {
        throw `createIntrinsicsTracer: Intrinsics is already wrapped by a live tracer`
    }
    const saved = { ...target }
    ;(target as any).__traced = true
    let disposed = false
    function dispose() {
        if (disposed) return
        disposed = true
        Object.assign(target, saved)
        delete (target as any).__traced
    }
    function recordResult(name: AllOps, hasReturn: boolean, args: Float64Array, result: any, hasUnknown: boolean) {
        if ((opCount++ & timerMask) === 0) {
            const now = (performance as any).now()
            if (prevTimestamp !== undefined) {
                const dur = now - prevTimestamp
                totalTime += dur
                if (totalTime >= maxTraceTime) throw `timed out @ # of ops ${opCount} [${Math.floor(totalTime)}ms]`
            }
            prevTimestamp = now
        }
        const wasHandled = handled
        handled = false
        if (!hasReturn) {
            if (traceConcreteOps || (!wasHandled && hasUnknown)) {
                captureTrace(name, args, result, Types.void)
            }
            return result
        }
        const resultType = getEffectiveType(result) ?? saved.typeofresult()
        if (wasHandled || !hasUnknown) {
            if (traceConcreteOps) {
                captureTrace(name, args, result, resultType)
            }
            return result  
        }
        const newResult = getCachedNan(name, args)
        captureTrace(name, args, newResult, resultType)
        return newResult
    }
    function inner0(name: AllOps, hasReturn: boolean, fn: () => any) {
        return () => {
            if (!active) return fn()
            const result = fn()
            return recordResult(name, hasReturn, new Float64Array(0), result, false)
        }
    }
    function inner1(name: AllOps, hasReturn: boolean, fn: (a0: any) => any) {
        return (a0: any) => {
            if (!active) return fn(a0)
            const result = fn(a0)
            const args = new Float64Array(1)
            args[0] = a0
            return recordResult(name, hasReturn, args, result, getNanId(a0) > 0)
        }
    }
    function inner2(name: AllOps, hasReturn: boolean, fn: (a0: any, a1: any) => any) {
        return (a0: any, a1: any) => {
            if (!active) return fn(a0, a1)
            const result = fn(a0, a1)
            const args = new Float64Array(2)
            args[0] = a0
            args[1] = a1
            return recordResult(name, hasReturn, args, result, getNanId(a0) > 0 || getNanId(a1) > 0)
        }
    }
    function inner3(name: AllOps, hasReturn: boolean, fn: (a0: any, a1: any, a2: any) => any) {
        return (a0: any, a1: any, a2: any) => {
            if (!active) return fn(a0, a1, a2)
            const result = fn(a0, a1, a2)
            const args = new Float64Array(3)
            args[0] = a0
            args[1] = a1
            args[2] = a2
            return recordResult(name, hasReturn, args, result, getNanId(a0) > 0 || getNanId(a1) > 0 || getNanId(a2) > 0)
        }
    }
    function simplifyCondition(v: any): [any, boolean] {
        let invert = false
        const seen = new Set<number>()
        while (true) {
            const id = getNanId(v)
            if (!id || seen.has(id)) return [v, invert]
            seen.add(id)
            const t = tracedResultMap.get(id)
            if (!t) return [v, invert]
            if (t.op === 'select' && !t.argIds[1] && !t.argIds[2]) {
                if (t.args[1] === 0 && t.args[2] === 1) invert = !invert
                else if (t.args[1] !== 1 || t.args[2] !== 0) return [v, invert]
                v = t.args[0]
                continue
            }
            if ((t.op === 'eq' || t.op === 'ne') && (!t.argIds[0] || !t.argIds[1])) {
                const k = !t.argIds[0] && t.args[0] === 0 ? 1
                    : !t.argIds[1] && t.args[1] === 0 ? 0 : -1
                if (k < 0) return [v, invert]
                if (t.op === 'eq') invert = !invert
                v = t.args[k]
                continue
            }
            return [v, invert]
        }
    }
    function inner4(name: AllOps, hasReturn: boolean, fn: (a0: any, a1: any, a2: any, a3: any) => any) {
        return (a0: any, a1: any, a2: any, a3: any) => {
            if (!active) return fn(a0, a1, a2, a3)
            if (name === 'select') {
                const condition = simplifyCondition(a0)
                a0 = condition[0]
                if (condition[1]) {
                    const tmp = a1
                    a1 = a2
                    a2 = tmp
                }
                if (getNanId(a0)) {
                    const op = a1 === 0 && a2 === 1 ? 'eq'
                        : a1 === 1 && a2 === 0 ? 'ne' : undefined
                    if (op) {
                        const T = getEffectiveType(a0) ?? Types.u64
                        const args = new Float64Array(4)
                        args[0] = a0
                        args[1] = 0
                        args[2] = T
                        args[3] = T
                        return traceOp(op, args, Types.bool)
                    }
                    if (a1 === a2 && hasEffects(getNanId(a0)) === false) {
                        return a1
                    }
                } else {
                    return a0 ? a1 : a2
                }
            }
            if (name === 'add' && (a0 === 0 || a1 === 0)) {
                return a0 === 0 ? a1 : a0
            }
            if (name === 'sub' && a1 === 0) {
                return a0
            }
            if (name === 'mul' && a1 === 1) {
                return a0
            }
            const result = fn(a0, a1, a2, a3)
            const args = new Float64Array(4)
            args[0] = a0
            args[1] = a1
            args[2] = a2
            args[3] = a3
            return recordResult(name, hasReturn, args, result, getNanId(a0) > 0 || getNanId(a1) > 0 || getNanId(a2) > 0 || getNanId(a3) > 0)
        }
    }
    function inner5(name: AllOps, hasReturn: boolean, fn: (a0: any, a1: any, a2: any, a3: any, a4: any) => any) {
        return (a0: any, a1: any, a2: any, a3: any, a4: any) => {
            if (!active) return fn(a0, a1, a2, a3, a4)
            const result = fn(a0, a1, a2, a3, a4)
            const args = new Float64Array(5)
            args[0] = a0
            args[1] = a1
            args[2] = a2
            args[3] = a3
            args[4] = a4
            return recordResult(name, hasReturn, args, result, getNanId(a0) > 0 || getNanId(a1) > 0 || getNanId(a2) > 0 || getNanId(a3) > 0 || getNanId(a4) > 0)
        }
    }
    function wrap(name: keyof IntrinsicObj, fn: (...args: any[]) => any) {
        const hasReturn = !voidReturnMap[name] || name === 'call'
        const r = replacements?.[name]
        const f = r ?? fn
        if (fn.length === 0) return inner0(name, hasReturn, f)
        if (fn.length === 1) return inner1(name, hasReturn, f)
        if (fn.length === 2) return inner2(name, hasReturn, f)
        if (fn.length === 3) return inner3(name, hasReturn, f)
        if (fn.length === 4) return inner4(name, hasReturn, f)
        if (fn.length === 5) return inner5(name, hasReturn, f)
        return (..._args: any[]) => {
            if (!active) return f(..._args)
            const result = f(..._args)
            const args = new Float64Array(_args.length)
            let hasUnknown = false
            for (let i = 0; i < args.length; i++) {
                args[i] = _args[i]
                hasUnknown ||= getNanId(args[i]) > 0
            }
            return recordResult(name, hasReturn, args, result, hasUnknown)
        }
    }
    for (const [_k, v] of Object.entries(saved)) {
        const k = _k as keyof IntrinsicObj
        target[k] = wrap(k, v)
    }
    function setActive(state: boolean) {
        if (disposed) throw "Tracer already disposed"
        active = state
    }
    function getTraces() {
        return traces
    }
    let handled = false
    function markHandled() {
        handled = true
    }
    function markUnhandled() {
        handled = false
    }
    function getNanCount() {
        return nanCounter
    }
    function getOpCount() {
        return opCount
    }
    function traceOp(op: AllOps, args: Float64Array, resultType: Types) {
        const result = getCachedNan(op, args)
        captureTrace(op, args, result, resultType)
        return result
    }
    function getLiteral(val: any, T: Types = Types.u64) {
        assert(!getNanId(val))
        const args = new Float64Array(2)
        args[0] = val
        args[1] = T
        return getCachedNan('literal', args)
    }
    function getTraceById(id: number) {
        return tracedResultMap.get(id as u48)
    }
    function getTraceFromUnknown(v: number) {
        const id = getNanId(v)
        if (!id) return
        if (const t = tracedResultMap.get(id)) {
            return t
        }
    }
    function hasEffects(id: u48): boolean | undefined {
        if (const t = tracedResultMap.get(id)) {
            if (t.op === 'call' || t.op === 'store') return true
            if (t.op === 'stackalloc' || t.op === 'stackfree') return true
            if (t.op === 'literal') return false
            if ((t.op as any) === 'after') return true
            for (let i = 0; i < t.args.length; i++) {
                const argId = getNanId(t.args[i])
                if (!argId) continue
                const r = hasEffects(argId)
                if (r !== false) return r
            }
            return false
        }
        return undefined
    }
    return {
        saved,
        dispose,
        setActive,
        getTraces,
        getNanId: getNanId,
        createUniqueNan,
        getEffectiveType,
        createTypedUnknown,
        markHandled,
        markUnhandled,
        getNanCount,
        getOpCount,
        getCachedNan,
        getLiteral,
        getTraceById,
        getTraceFromUnknown,
        traceOp,
        assertIsTaggedNanStill,
        hasEffects,
    }
}

// const tracer = createIntrinsicsTracer(Intrinsics)

interface HeapBlock {
    size: usize
    next?: HeapBlock
}

const HeapBlock = DefineStructView(reify HeapBlock)

const minSplit: u16 = 16
const memBuffer = new ArrayBuffer(maxMem)
const memView = new DataView(memBuffer)

let freeListHead = HeapBlock(0)
freeListHead.size = (maxMem >> 1) as usize

export const heapMaxAddress = freeListHead.size

function allocBlock(amt: usize) {
    const aligned = alignUp(amt + HeapBlock.sizeof, 4)
    let block = freeListHead

    while (block.size < aligned || (block.size & (1 << 29))) {
        if (!block.next) throw `Failed to allocate bytes: ${aligned}`
        block = block.next
    }

    if (block.size > HeapBlock.sizeof + aligned + minSplit) {
        const cur = Intrinsics.addressof(block)
        const next = block.next
        const start = cur + HeapBlock.sizeof + aligned
        const rem = block.size - HeapBlock.sizeof - aligned
        block.size = aligned
        const split = HeapBlock(start)
        split.size = rem
        split.next = next
        block.next = split
    }

    block.size |= (1 << 29) // mark
    return Intrinsics.addressof(block) + HeapBlock.sizeof
}

function getBlock(ptr: usize) {
    const addr = ptr - HeapBlock.sizeof
    return HeapBlock(addr)
}

function freeBlock(ptr: usize) {
    const block = getBlock(ptr)
    block.size &= ~(1 << 29)
}

interface InternalSlice<T> {
    ptr: usize
    len: usize // len*alignment to get byteLength
    __view: StructViewFactory<T>
    __address: usize
}

interface SliceMethods<T> {
    at(idx: usize): StructView<T>
}

const InternalSlice = DefineStructView(reify InternalSlice<any>)

export function StructList<T>(T: StructViewFactory<T>, count: usize, alloc: (bytes: usize) => usize) {
    const slice_ptr = alloc(InternalSlice.sizeof)
    const s = InternalSlice(slice_ptr) as StructView<InternalSlice<any>> & SliceMethods<T>
    s.ptr = alloc(count * T.sizeof)
    s.len = count

    function at(this: InternalSlice<any>, idx: usize) {
        if (idx >= this.len) throw `Slice out of bounds: len -> ${this.len}; idx -> ${idx}`
        const addr = this.ptr + idx*(T as any).sizeof
        return T(addr)
    }

    s.at = at
    return s
}

interface ScalarSlice {
    ptr: usize
    len: usize // len*alignment to get byteLength
    __sizeof: u32
    __address: usize
}

interface ScalarSliceMethods<T> {
    at(idx: usize): T
    set(idx: usize, val: T): void
}

type MachineSlice<T> = ScalarSlice & ScalarSliceMethods<T>

export function AllocSlice<T>(T: reify T, count: usize, alloc: (bytes: usize) => usize) {
    assert(T is Type.Machine && T.isConcrete())
    assert(T.width % 8)

    const slice_ptr = alloc(InternalSlice.sizeof)
    const s = InternalSlice(slice_ptr) as any as ScalarSlice & ScalarSliceMethods<T>
    s.__sizeof = (T.width as u32) >> 3
    s.ptr = alloc(count * s.__sizeof)
    s.len = count

    const U = lowerType(T)

    function at(this: ScalarSlice, idx: usize) {
        if (idx >= this.len) throw `Slice out of bounds: len -> ${this.len}; idx -> ${idx}`
        const addr = this.ptr + idx*this.__sizeof
        return Intrinsics.load(addr, 0, U) as T
    }

    function set(this: ScalarSlice, idx: usize, val: T) {
        if (idx >= this.len) throw `Slice out of bounds: len -> ${this.len}; idx -> ${idx}`
        const addr = this.ptr + idx*this.__sizeof
        return Intrinsics.store(addr, 0, val as any, U)
    }

    s.at = at
    s.set = set
    return s
}

interface AllocationArena {
    head: usize
    tail: usize
    remaining: usize
}

interface AllocationArenaMethods {
    free(): void
    steal(): this // copies the frame into a new handle, taking ownership of existing handles
    New<T>(T: StructViewFactory<T>): StructView<T>
}

const InternalArena = DefineStructView(reify AllocationArena)

export type Arena = StructView<AllocationArena> & AllocationArenaMethods

// This does not stack allocate but is itself stack allocated. 
// You cannot free individual allocations.
// 
// ```syn
//  const f = Arena()
//  defer f.free()
//  const b = f.New(Foo)
// ```
export function Arena(): Arena {
    const arena = StackNew(InternalArena) as Arena
    arena.remaining = 0
    arena.head = 0

    function addChunk(a: StructView<AllocationArena>, amt: usize) {
        const aligned = alignUp(amt, 4)
        const chunk = Intrinsics.alloc(aligned+8)
        if (a.head === 0) {
            a.head = chunk
            Intrinsics.store(chunk, 4, 0, Types.u32)
        } else {
            assert(a.tail !== 0)
            Intrinsics.store(a.tail, 4, chunk, Types.u32)
        }
        Intrinsics.store(chunk, 0, aligned, Types.u32)
        a.tail = chunk
        a.remaining = aligned
    }

    arena.free = function() {
        let ptr = this.head
        while (ptr) {
            const next = Intrinsics.load(ptr, 4, Types.u32)
            Intrinsics.free(ptr)
            ptr = next
        }
        // simple debug check for double free, release would skip this code
        if (this.head === 0 && this.remaining !== 0) throw `Arena was double freed`
        this.head = 0
        this.remaining = 1
    }

    arena.steal = function() {
        const ret = StackNew(InternalArena) as Arena
        const this_addr = Intrinsics.addressof(this)
        memcpy(Intrinsics.addressof(ret), this_addr, InternalArena.sizeof)
        memsetByte(this_addr, InternalArena.sizeof, 0)
        return ret
    }

    arena.New = function(T) {
        const amt = T.sizeof
        if (amt > this.remaining) {
            // we can also try searching from `head` for a possible spot
            addChunk(this, (amt << 1) + (amt >> 1))
        }
        const rem = this.remaining
        assert(amt <= rem)
        this.remaining = rem - amt
        const base = this.tail
        const addr = (base+8) + (Intrinsics.load(base, 0, Types.u32) - rem)
        return T(addr)
    }

    return arena
}

type SyscallFn<T extends Function, U extends number> = T & { 
    __syscall: U
    __args: Types[]
    __returns: Types
} 
export function makeSyscallFn<
    T extends Function, 
    const U extends number
>(T: reify T, num: U): SyscallFn<T, U> {
    // FIXME: reify doesn't reify named tuple elements w/ their name yet
    const names = T.params.map((_, i) => `arg${i}`)
    const f = new Function(...names, `throw new Error('Unlinked syscall fn: ${num}')`) as SyscallFn<T, U>
    f.__syscall = num
    f.__args = T.params.map(t => lowerType(t))
    f.__returns = T.returns !== undefined ? lowerType(T.returns) : Types.void
    return f
}

type NativeFn<T extends Function> = T & {
    __native: number
    __args: Types[]
    __returns: Types
}

export function makeNativeFn<T extends Function>(T: reify T, ptr: number | bigint): NativeFn<T> {
    const names = T.params.map((_, i) => `arg${i}`)
    const f = new Function(...names, `throw new Error('Unlinked native fn')`) as NativeFn<T>
    f.__native = Number(ptr)
    f.__args = T.params.map(t => lowerType(t))
    f.__returns = T.returns !== undefined ? lowerType(T.returns) : Types.void
    return f
}

