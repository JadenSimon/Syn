/// <reference lib="machine" />
/// <reference lib="reify" />

"use wrapped";

// for bootstrapping we do not use native sizes
type usize = u32
const nativeWord = 4

export function bitsizeof<T>(t: reify T): u32 {
    // if (t is Type.Object) {
    //     let s: u32 = 0
    //     for (const [k, v] of Object.entries(t)) {
    //         if (k.startsWith('__phantom')) continue
    //         s += bitsizeof(v)
    //     }
    //     return s
    // }
    // if (t is Type.Tuple) {
    //     let s: u32 = 0
    //     for (const x of t) {
    //         s += bitsizeof(x)
    //     }
    //     return s
    // }
    if (t is Type.Tuple | Type.Object) {
        // all structural types are allocated independently
        return bitsizeof(reify usize)
    }
    if (t is Type.Union) {
        let s: u32 = 0
        for (const x of t) {
            const v = sizeof(x)
            if (v > s) s = v
        }
        return s
    }
    if (t is Type.Machine) {
        // XXX: we are failing to resolve `Type.Machine`, bad namespace merge
        if ((t as any)?.isConcrete) {
            if (!t.isConcrete()) throw `not concrete: ${t}`
            return t.width as u32
        }
    }

    // literals
    if (t === undefined) return 0
    if (t === Type.boolean) return 1
    if (t === true || t === false) return 1
    // for exact literals, we choose the nearest aligned representation
    if (t is u8 || t is i8) return 8
    if (t is u16) return 16
    if (t is u32) return 32
    throw `invalid type: ${t}`
}

export function sizeof<T>(t: reify T): u32 {
    return (bitsizeof(t) + 7) >> 3
}

// export type Ptr<T> = {
//     ptr: usize
//     __phantom: T
// }

export type StructView<T> = WrapInnerStructs<T> & {
    __address: usize
}

// type WrapInnerStructs<T> = T extends object ? {
//     [P in keyof T]: T[P] extends number ? T[P] 
//         : T extends Ptr<infer U> ? StructView<U> : StructView<T[P]>
// } : T
type WrapInnerStructs<T> = T extends object ? {
    [P in keyof T]: T[P] extends number ? T[P] 
        : P extends `__${string}` ? T[P] : StructView<T[P]>
} : T

export type PackedView<T> = T & {
    __id: u32
    __scalar: usize
}

// we precompute this stuff to make it easier to work with
interface StructViewFactory<T> {
    id: u32
    sizeof: u32
    (ptr: usize): StructView<T>
}
const structViews = new Map<u32, StructViewFactory<any>>()
const cachedStructViews = new Map<Type, StructViewFactory<any>>()
function getStructView(T: Type) {
    //if (const cached = cachedStructViews.get(T)) return cached
    const cached = cachedStructViews.get(T)
    if (cached) return cached
    return DefineStructView(T)
}

// We treat a "struct" as a view over a memory address
export function DefineStructView<T>(T: reify T): StructViewFactory<T> {
    if (!(T is Type.Object)) throw `Unable to create struct for type: ${T}`
    const size = sizeof(T as Type) // FIXME: Type & Type.Object is busted
    const id = (cachedStructViews.size as u32) + 1
    type Self = { __address: usize }
    let offset: usize = 0
    const f = function(ptr: usize) {
        const o = { __address: ptr }
        return Object.defineProperties(o, Object.fromEntries(descriptors)) as StructView<T>
    }
    f.id = id
    f.sizeof = size
    cachedStructViews.set(T, f)
    const descriptors = Object.entries(T).filter(([k]) => !k.startsWith('__')).map(([k, v]) => {
        const from = offset
        offset += sizeof(v)
        const load = createLoadFn(v)
        const store = createStoreFn(v)
        return [k, {
            get: function(this: Self) {
                return load(this.__address, from)
            },
            set: function(this: Self, val: any) {
                store(this.__address, from, val)
            },
            enumerable: true,
            configurable: true,
        } satisfies PropertyDescriptor]
    })
    structViews.set(id, f)
    return f
}

function fieldOffset(T: Type.Object, name: string) {
    let offset: usize = 0
    for (const [k, v] of Object.entries(T)) {
        if (k === name) return offset
        offset += sizeof(v)
    }
    throw `No field named "${name}" found in type: ${T}`
}

function getRcInfo(T: Type.Object) {
    const field = T['$rc']
    if (!field) return
    return [fieldOffset(T, '$rc'), lowerType(field)] as const
}

// returns true if we freed `addr`
// ref counted structs are never stored on the stack, so this is fine
function adjustRc(addr: usize, offset: usize, T: Types, amt: i8) {
    const cur = Intrinsics.load(addr, offset, T) as u32
    if (-amt >= cur) {
        Intrinsics.free(addr)
        return true
    }
    Intrinsics.store(addr, offset, cur+amt, T)
    return false
}

function createStoreFn(T: Type) {
    if (T is Type.Object) {
        const f = (addr: usize, offset: usize, v: any) => {
            if (!v) {
                Intrinsics.store(addr, offset, 0, Types.u32)
            } else {
                const __address = v.__address
                Intrinsics.store(addr, offset, __address, Types.u32)
            }
        }
        const rcInfo = getRcInfo(T)
        if (!rcInfo) return f
        return (addr: usize, offset: usize, v: any) => {
            const prev = Intrinsics.load(addr, offset, Types.u32)
            const __address = v?.__address
            f(addr, offset, v)
            if (prev === __address) return
            if (prev !== 0) adjustRc(prev, rcInfo[0], rcInfo[1], -1)
            if (__address !== 0) adjustRc(__address, rcInfo[0], rcInfo[1], 1)
        }
    }
    const U = lowerType(T)
    return (addr: usize, offset: usize, v: any) => {
        Intrinsics.store(addr, offset, v, U)
    }
}

function createLoadFn(T: Type) {
    if (T is Type.Object) {
        const view = getStructView(T)
        return (addr: usize, offset: usize) => {
            const ptr = Intrinsics.load(addr, offset, Types.u32)
            if (!ptr) return
            return view(ptr)
        }
    }
    const U = lowerType(T)
    return (addr: usize, offset: usize) => {
        return Intrinsics.load(addr, offset, U)
    }
}

// FIXME: analyzer breaks on expando `sizeof`
export function New<T>(view: StructViewFactory<T>): StructView<T> {
    const ptr = Intrinsics.alloc(view.sizeof)
    const s = view(ptr)
    return s
}

export function StackNew<T>(view: StructViewFactory<T>): StructView<T> {
    const ptr = Intrinsics.stackalloc(view.sizeof)
    const s = view(ptr)
    return s
}

interface MakeByteBitpackResult {
    setters: ((cur: u8, val: any) => u8)[]
    getters: ((cur: u8) => any)[]
    bitsUsed: usize
    rem: Type[]
}

// packs low -> high
function makeBitpack(types: Type[]): MakeByteBitpackResult {
    let bitsUsed: usize = 0
    const limit = bitsizeof(reify u8)
    const getters: MakeByteBitpackResult['getters'] = []
    const setters: MakeByteBitpackResult['setters'] = []
    for (const x of types) {
        const next = bitsizeof(x)
        if (bitsUsed + next > limit) break
        const shift = bitsUsed as u8
        const mask = (((1 << next)-1) & 0xFF) as u8 // FIXME: cast should not be needed
        const invMask = ~(mask << next) as u8
        const isSigned = x is Type.Machine && x.isInt() && x.signed === true
        if (isSigned) {
            const T = (Types.u1 + (x.width as number)) as Types
            const U = (Types.i1 + (x.width as number)) as Types
            getters.push(cur => Intrinsics.bitconvert((cur >> shift) & mask, T, U))
            setters.push((cur, val) => ((cur & invMask) | ((Intrinsics.bitconvert(val, U, T) & mask) << shift)) as u8)
        } else {
            getters.push(cur => (cur >> shift) & mask)
            setters.push((cur, val) => ((cur & invMask) | ((val & mask) << shift)) as u8)
        }
        bitsUsed += next
    }
    const rem = types.slice(getters.length)
    return { getters, setters, bitsUsed, rem }
}

export function assert(x: unknown): asserts x {
    if (!x) throw "Assertion failed"
}

export function alignUp(x: usize, alignment: usize): usize {
    return (x + alignment - 1) & ~(alignment - 1)
}

export function memcpy(dst: usize, src: usize, len: usize): void {
    let i: usize = 0
    while ((len-i) >= 4) {
        const v = Intrinsics.load(src, i, Types.u32)
        Intrinsics.store(dst, i, v, Types.u32)
        i += 4
    }
    while ((len-i) >= 2) {
        const v = Intrinsics.load(src, i, Types.u16)
        Intrinsics.store(dst, i, v, Types.u16)
        i += 2
    }
    if (i !== len) {
        const v = Intrinsics.load(src, i, Types.u8)
        Intrinsics.store(dst, i, v, Types.u8)
    }
}

export function memsetByte(dst: usize, len: usize, fill: u8): void {
    while (len >= 8) {
        len -= 8
        Intrinsics.store(dst, len, fill, Types.u64)
    }
    while (len >= 4) {
        len -= 4
        Intrinsics.store(dst, len, fill, Types.u32)
    }
    while (len >= 2) {
        len -= 2
        Intrinsics.store(dst, len, fill, Types.u16)
    }
    if (len) {
        Intrinsics.store(dst, 1, fill, Types.u8)
    }
}


// we don't want to reify directly here
export enum Types {
    u8,
    u16,
    u32,
    u64,
    i8,
    i16,
    i32,
    i64,
    f16,
    f32,
    f64,
    bool,

    usize,
    void,
    ptr, // explicitly a native ptr
    unknown, // used during interpretation

    // sometimes, it's just easier to keep it simple
    u1, u2, u3, u4, u5, u6, u7,
    u9, u10, u11, u12, u13, u14, u15, u17,
    u19, u20, u21, u22, u23, u24, u25, u26,
    u27, u28, u29, u30, u31,

    i1, i2, i3, i4, i5, i6, i7,
}

function maxValExcl(T: Types) {
    const c = getTypeClass(T)
    if (c === TypeClass.float) throw `todo`
    const w = intrinsicBitWidth(T)
    if (c === TypeClass.int) return Math.pow(2, w - 1) - 1
    return Math.pow(2, w)
}

function minVal(T: Types) {
    const c = getTypeClass(T)
    if (c === TypeClass.float) throw `todo`
    if (c !== TypeClass.int) return 0
    const w = intrinsicBitWidth(T)
    return -Math.pow(2, w - 1)
}

function intrinsicBitWidth(T: Types) {
    switch (T) {
        case Types.u8: return 8
        case Types.u16: return 16
        case Types.u32: return 32
        case Types.u64: return 64
        case Types.i8: return 8
        case Types.i16: return 16
        case Types.i32: return 32
        case Types.i64: return 64
        case Types.f16: return 16
        case Types.f32: return 32
        case Types.f64: return 64
        case Types.void: return 0
        case Types.bool: return 1
        case Types.unknown: return 1
        case Types.ptr:
        case Types.usize: return nativeWord*8
        default: throw `Unhandled machine intrinsic: ${T}`
    }
}


type UnaryOp = 'neg' | 'not'

type BitwiseOp = 'or' | 'and' | 'xor' | 'not' | 'ushr' | 'shr' | 'shl'
type CmpOp = 'lt' | 'le' | 'gt' | 'ge' | 'eq' | 'ne'
type ArithmeticOp = 'add' | 'sub' | 'mul' | 'div' | 'neg' | 'rem'
type Op = ArithmeticOp | CmpOp | BitwiseOp

const bitwiseOps = reify BitwiseOp
function isBitwiseOp(op: Op): op is BitwiseOp {
    return bitwiseOps.has(op)
}

enum TypeClass {
    uint,
    int,
    float,
    bool,
}

function getTypeClass(T: Types): TypeClass {
    if (T <= Types.u64) return TypeClass.uint
    if (T <= Types.i64) return TypeClass.int
    if (T <= Types.f64) return TypeClass.float
    if (T === Types.bool) return TypeClass.bool
    if (T >= Types.u1 && T <= Types.u31) return TypeClass.uint
    if (T >= Types.i1 && T <= Types.i7) return TypeClass.int
    if (T == Types.ptr) return TypeClass.uint
    throw `Unknown type class: ${T}`
}

function negateType(T: Types) {
    switch (T) {
        case Types.u8: return Types.i16
        case Types.u16: return Types.i32
        case Types.u32: return Types.i64
        case Types.u64: throw `Cannot negate u64 without losing precision`
    }
    return T
}

function promoteArithType(T: Types, U: Types, tc: TypeClass, uc: TypeClass) {
    if (tc === TypeClass.float) return T 
    if (uc === TypeClass.float) return U
    if (tc === TypeClass.bool || uc === TypeClass.bool) throw `unhandled type class (bool): ${tc} | ${uc}`
    // choose the largest width and make it signed
    if (intrinsicBitWidth(T) > intrinsicBitWidth(U)) return negateType(T)
    return negateType(U)
}

function chooseArithmeticResultType(op: Exclude<ArithmeticOp, UnaryOp>, T: Types, U: Types) {
    if (T === U) return T
    const tc = getTypeClass(T)
    const uc = getTypeClass(U)
    if (tc === uc) {
        if (op === 'div' || op === 'rem') return T
        return intrinsicBitWidth(T) > intrinsicBitWidth(U) ? T : U
    }
    return promoteArithType(T, U, tc, uc)
}

function chooseBitwiseResultType(op: Exclude<BitwiseOp, UnaryOp>, T: Types, U: Types) {
    if (T === U) return T
    const tc = getTypeClass(T)
    if (tc === TypeClass.float || tc === TypeClass.bool) throw `Unhandled type class: ${tc}`
    const uc = getTypeClass(U)
    if (uc === TypeClass.float || uc === TypeClass.bool) throw `Unhandled type class: ${uc}`

    switch (op) {
        case 'and':
        case 'or':
        case 'xor':
            const w = intrinsicBitWidth(T)
            const v = intrinsicBitWidth(U)
            if (w === v) return tc === TypeClass.int ? T : U
            return w > v ? T : U // effectively zero extends
        case 'shl':
        case 'shr':
        case 'ushr':
            return T
    }

    throw `unknown bitwise op: ${op}` // `not` is the operand type directly
}

function lowerType(T: Type): Types {
    switch (T) {
        case reify u8: return Types.u8
        case reify u16: return Types.u16
        case reify u32: return Types.u32
        case reify u64: return Types.u64
        case reify i8: return Types.i8
        case reify i16: return Types.i16
        case reify i32: return Types.i32
        case reify i64: return Types.i64
        // case reify f16: return Types.f16
        // case reify f32: return Types.f32
        case reify f64: return Types.f64
        // case reify usize: return Types.usize
        default: throw `Cannot lower type: ${String(T)}`
    }
}

function intrinsicLoad(ptr: usize, offset: usize, T: Types.u8): u8
function intrinsicLoad(ptr: usize, offset: usize, T: Types.u16): u16
function intrinsicLoad(ptr: usize, offset: usize, T: Types.u32): u32
function intrinsicLoad(ptr: usize, offset: usize, T: Types.usize): usize
function intrinsicLoad(ptr: usize, offset: usize, T: Types.i8): i8
function intrinsicLoad(ptr: usize, offset: usize, T: Types.i16): i16
function intrinsicLoad(ptr: usize, offset: usize, T: Types.i32): i32
function intrinsicLoad(ptr: usize, offset: usize, T: Types.f64): f64
function intrinsicLoad(ptr: usize, offset: usize, T: Types): number
function intrinsicLoad(ptr: usize, offset: usize, T: Types) {
    const p = ptr + offset
    switch (T) {
        case Types.u8: return memView.getUint8(p)
        case Types.i8: return memView.getInt8(p)
        case Types.u16: return memView.getUint16(p, true)
        case Types.i16: return memView.getInt16(p, true)
        case Types.usize: // XXX
        case Types.u32: return memView.getUint32(p, true)
        case Types.i32: return memView.getInt32(p, true)
        case Types.f64: return memView.getFloat64(p, true)
        case Types.u64: {
            const lo = memView.getUint32(p, true)
            const hi = memView.getUint32(p + 4, true)
            return hi * 0x1_0000_0000 + lo
        }
        case Types.i64: {
            const lo = memView.getUint32(p, true)
            const hi = memView.getInt32(p + 4, true)
            return hi * 0x1_0000_0000 + lo
        }
        default:
            throw `load: unsupported type ${T}`
    }
}

function intrinsicStore(ptr: usize, offset: usize, val: usize, T: Types) {
    const p = ptr + offset
    switch (T) {
        case Types.u8: memView.setUint8(p, val); return
        case Types.i8: memView.setInt8(p, val); return
        case Types.u16: memView.setUint16(p, val, true); return
        case Types.i16: memView.setInt16(p, val, true); return
        case Types.usize: // XXX
        case Types.u32: memView.setUint32(p, val >>> 0, true); return
        case Types.i32: memView.setInt32(p, val, true); return
        case Types.f64: memView.setFloat64(p, val, true); return
        case Types.u64: memView.setBigUint64(p, BigInt(val), true)
        case Types.i64: {
            const lo = val >>> 0
            const hi = Math.floor(val / 0x1_0000_0000) | 0
            memView.setUint32(p, lo, true)
            memView.setInt32(p + 4, hi, true)
            return
        }
        default:
            throw `store: unsupported type ${T}`
    }
}

const maxMem: usize = 1 << 24

// ambient state

let stackPointer: usize = maxMem 
let framePointer: usize = 0
let overflow = 0
let resultType = Types.unknown

export const Intrinsics = {
    addressof: function(v: any): usize {
        const addr = v.__address
        if (addr === undefined) throw `No address found: ${v}`
        return addr
    },
    stackalloc: function(amt: usize) {
        stackPointer -= amt
        return stackPointer
    },
    stackfree: function(amt: usize) {
        stackPointer += amt
    },
    getStackPointer: function() {
        return stackPointer
    },
    setStackPointer: function(v: usize) {
        stackPointer = v
    },
    getFramePointer: function() {
        return framePointer
    },
    setFramePointer: function(v: usize) {
        framePointer = v
    },
    // heap alloc/free
    alloc: function(amt: usize) {
        return allocBlock(amt)
    },
    free: function(ptr: usize | { __address: usize }) {
        // FIXME: analyzer is busted on excluding usize here 
        freeBlock(typeof ptr === 'number' ? ptr : (ptr as any).__address)
    },
    store: intrinsicStore,
    load: intrinsicLoad,
    // direct reinterpretation
    bitconvert: function(v: any, T: Types, U: Types) {
        if (v === true) return 1
        if (v === false) return 0
        if (U === Types.bool) return v ? true : false
        if (T >= Types.i1 && T <= Types.i7) {
            const bits = 1 + (T - Types.i1)
            const max = 1 << bits
            return v < 0 ? v + max : v
        }
        if (U >= Types.i1 && U <= Types.i7) {
            const bits = (U - Types.i1)
            const max = 1 << bits
            return v >= max ? v - (max << 1) : v
        }
        return v
    },

    // the remaining fields are largely used by the interpreter to dispatch machine instructions

    // selects between two values using the cond
    // cond _must_ be a bool! we will not coerce
    select: function<T, U>(cond: boolean, v1: T, v2: U) {
        return cond ? v1 : v2
    },
    // converts T -> U
    convert: function(v: any, T: Types, U: Types) {
        if (T === U) return v
        if (T === Types.unknown || U === Types.unknown) return v
        if (U === Types.f64) return Number(v)
        if (T === Types.f64) return Math.trunc(v)
        return v
    },
    isinteger: function(v: number) {
        return Number.isInteger(v)
    },
    typeofresult: function() {
        return resultType
    },
    checkoverflow: function() {
        return overflow
    },
    add: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('add', T, U)
        return updateOverflow(T, U, a, b, a + b)
    },
    sub: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('sub', T, U)
        return updateOverflow(T, U, a, b, a - b)
    },
    mul: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('mul', T, U)
        const r = a * b
        overflow = didOverflow(r, resultType) // technically may be wrong w/ very large numbers
        return r
    },
    div: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('div', T, U)
        const isFloat = getTypeClass(resultType) === TypeClass.float
        if (!isFloat && b === 0) throw "Got zero operand for idiv"
        let r = a / b
        if (!isFloat) {
            const z = r
            r = Math.trunc(r)
            overflow = r !== z ? 1 : 0
        } else {
            overflow = didOverflow(r, resultType)
        }
        return r
    },
    rem: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseArithmeticResultType('rem', T, U)
        overflow = 0
        return a % b // XXX: not accurate
    },
    neg: function(a: any, T: Types) {
        resultType = negateType(T)
        return -a
    },
    not: function(a: any, T: Types) {
        resultType = T
        return ~a
    },
    and: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('and', T, U)
        return a & b
    },
    or: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('or', T, U)
        return a | b
    },
    xor: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('xor', T, U)
        return a ^ b
    },
    shl: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('shl', T, U)
        return a << b
    },
    shr: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('shr', T, U)
        return a >> b
    },
    ushr: function(a: any, b: any, T: Types, U: Types) {
        resultType = chooseBitwiseResultType('ushr', T, U)
        return a >>> b
    },
    lt: function(a: any, b: any, T: Types, U: Types) {
        resultType = Types.bool
        return a < b
    },
    gt: function(a: any, b: any, T: Types, U: Types) {
        resultType = Types.bool
        return a > b
    },
    le: function(a: any, b: any, T: Types, U: Types) {
        resultType = Types.bool
        return a <= b
    },
    ge: function(a: any, b: any, T: Types, U: Types) {
        resultType = Types.bool
        return a >= b
    },
    eq: function(a: any, b: any, T: Types, U: Types) {
        resultType = Types.bool
        return a === b
    },
    ne: function(a: any, b: any, T: Types, U: Types) {
        resultType = Types.bool
        return a !== b
    },
}

function didOverflow(r: number, T: Types) {
    if (T === Types.f64) return 0
    return (r >= minVal(T) && r < maxValExcl(T)) ? 0 : 1
}

function updateOverflow(T: Types, U: Types, a: number, b: number, r: number) {
    overflow = (T === U && ((a ^ r) & (b ^ r)) < 0) ? 1 : 0
    return r
}

type MiscOp = Exclude<keyof typeof Intrinsics, Op>
type AllOps = MiscOp | Op

type OpArgs<T extends AllOps> = Parameters<IntrinsicObj[T]>

type HasVoidReturnMap<T> = {
    [P in keyof T]: T[P] extends (...args: any) => infer U 
        ? void extends U ? true : false
        : false 
}

const voidReturnMap = reify HasVoidReturnMap<IntrinsicObj>

type IntrinsicObj = typeof Intrinsics
export type Replacements = {
    readonly [P in keyof IntrinsicObj]?: (
        ...args: Parameters<IntrinsicObj[P]>
    ) => any | undefined
}

type BinaryOp = Exclude<Op, UnaryOp>

interface BaseOpTrace {
    readonly op: AllOps
    readonly args: any[]
    readonly result: any
    readonly resultType: Types
}

// more specific shapes

interface BinaryOpTrace extends BaseOpTrace {
    readonly op: BinaryOp
    readonly a: any
    readonly b: any
    readonly T: Types
    readonly U: Types
}

interface UnaryOpTrace extends BaseOpTrace {
    readonly op: UnaryOp
    readonly a: any
    readonly T: Types
}

interface ConvertOpTrace extends BaseOpTrace {
    readonly op: 'convert' | 'bitconvert'
    readonly a: any
    readonly T: Types
    readonly U: Types
}

interface LoadTrace extends BaseOpTrace {
    readonly op: 'load'
    readonly ptr: any
    readonly offset: any
    readonly T: Types // T is the desired type here
}

interface StoreTrace extends BaseOpTrace {
    readonly op: 'store'
    readonly ptr: any
    readonly offset: any
    readonly val: any
    readonly T: Types // type of val
}

interface StackTrace extends BaseOpTrace {
    readonly op: 'stackalloc' | 'stackfree'
    readonly amt: any
    // will do this later
    // readonly prev?: StackTrace
}

export type OpTrace = 
    | BinaryOpTrace
    | UnaryOpTrace
    | ConvertOpTrace
    | LoadTrace
    | StoreTrace
    | StackTrace

type TypedOpArgs = { [P in AllOps]: [P, OpArgs<P>] }[AllOps]

function buildOpTrace(op: AllOps, args: any[], result: any, resultType: Types): OpTrace {
    const base = { op, args, result, resultType }
    const pair = [op, args] as any as TypedOpArgs
    switch (pair[0]) {
        // binary ops: (a, b, T, U)
        case 'add': case 'sub': case 'mul': case 'div': case 'rem':
        case 'lt': case 'le': case 'gt': case 'ge': case 'eq': case 'ne':
        case 'or': case 'and': case 'xor': case 'ushr': case 'shr': case 'shl': {
            const [a, b, T, U] = pair[1]
            return { ...base, op: pair[0], a, b, T, U }
        }
        // unary ops: (a, T)
        case 'neg': case 'not': {
            const [a, T] = pair[1]
            return { ...base, op: pair[0], a, T }
        }
        // (v, T, U)
        case 'convert': case 'bitconvert': {
            const [a, T, U] = pair[1]
            return { ...base, op: pair[0], a, T, U }
        }
        // (ptr, offset, T)
        case 'load': {
            const [ptr, offset, T] = pair[1]
            return { ...base, op: pair[0], ptr, offset, T }
        }
        // (ptr, offset, val, T)
        case 'store': {
            const [ptr, offset, val, T] = pair[1]
            return { ...base, op: pair[0], ptr, offset, val, T }
        }
        // (amt)
        case 'stackalloc': case 'stackfree': {
            const [amt] = pair[1]
            return { ...base, op: pair[0], amt }
        }
        default:
            return base as OpTrace
    }
}

type u48 = Int<48, false>

export function createIntrinsicsTracer(
    target: IntrinsicObj,
    replacements: Replacements = {}
) {
    let active = true
    // unique NaNs are used to represent "unknown" values, leaving other literals untouched
    let nanCounter = 1 // native NaN is 0
    const nanView = new DataView(new ArrayBuffer(8))
    nanView.setFloat64(0, NaN, true)
    function createUniqueNan() {
        const id = nanCounter++
        nanView.setUint32(0, id, true)
        if (id >= 0x1_0000_0000) {
            const rem = nanView.getUint32(4, true) & ~0xFFFF
            nanView.setUint32(4, Math.trunc(id / 0x1_0000_0000) | rem, true)
        }
        return nanView.getFloat64(0, true)
    }
    function getNanId(nan: number): u48 {
        if (!Number.isNaN(nan)) return 0
        nanView.setFloat64(0, nan, true)
        const low = nanView.getUint32(0, true)
        const high = nanView.getUint32(4, true) & 0xFFFF // 3 bits unused
        if (!high) return low as u48
        return (low + (high*0x1_0000_0000)) as u48
    }
    const traces: OpTrace[] = []
    const tracedResultMap = new Map<u48, OpTrace>()
    const nanTypeMap = new Map<u48, Types>()
    function getEffectiveType(v: any): Types | undefined {
        const nanId = getNanId(v)
        if (!nanId) return
        if (const T = nanTypeMap.get(nanId)) return T
    }
    // function transformArgs(op: AllOps, args: any[]) {
    //     const pair = [op, args] as any as TypedOpArgs
    //     switch (pair[0]) {
    //         case 'add': case 'sub': case 'mul': case 'div': case 'rem':
    //         case 'lt': case 'le': case 'gt': case 'ge': case 'eq': case 'ne':
    //         case 'or': case 'and': case 'xor': case 'ushr': case 'shr': case 'shl': {
    //             const [a, b, T, U] = pair[1]
    //         }
    //         case 'neg': case 'not': {
    //             const [a, T] = pair[1]
    //         }
    //         case 'convert': case 'bitconvert': {
    //             const [a, T, U] = pair[1]
    //         }
    //         // case 'load': {
    //         //     const [ptr, offset, T] = pair[1]
    //         // }
    //         // case 'store': {
    //         //     const [ptr, offset, val, T] = pair[1]
    //         // }
    //         default:
    //             return args
    //     }
    // }
    function captureTrace(op: AllOps, args: any[], result: any, resultType: Types) {
        const nanId = getNanId(result)
        const trace = buildOpTrace(op, args, result, resultType)
        traces.push(trace)
        if (nanId) {
            tracedResultMap.set(nanId, trace)
            nanTypeMap.set(nanId, resultType)
        }
        return trace
    }
    function argsHasUnknown(args: any[]) {
        return args.some(x => !!getNanId(x))
    }
    const saved = { ...target }
    function dispose() {
        Object.assign(target, saved)
    }
    function wrap(name: keyof IntrinsicObj, fn: (...args: any[]) => any) {
        const hasReturn = !voidReturnMap[name]
        const alwaysBool = name === 'select'
        return (...args: any[]) => {
            if (!active) return fn(...args)
            const r = replacements?.[name]
            const result = (r ?? fn)(...args)
            if (!hasReturn) {
                captureTrace(name, args, result, Types.void)
                return result
            }
            // replacement may not set result type
            const resultType = alwaysBool ? Types.bool : saved.typeofresult()
            if (!argsHasUnknown(args)) {
                captureTrace(name, args, result, resultType)
                return result  
            }
            const newResult = createUniqueNan()
            captureTrace(name, args, newResult, resultType)
            return newResult
        }
    }
    for (const [_k, v] of Object.entries(saved)) {
        const k = _k as keyof IntrinsicObj
        target[k] = wrap(k, v)
    }
    function setActive(state: boolean) {
        active = state
    }
    function getTraces() {
        return traces
    }
    return {
        dispose,
        setActive,
        getTraces,
        getNanId,
        createUniqueNan,
    }
}

const tracer = createIntrinsicsTracer(Intrinsics)

interface HeapBlock {
    size: usize
    next?: HeapBlock
}

const HeapBlock = DefineStructView(reify HeapBlock)

const minSplit: u16 = 16
const memBuffer = new ArrayBuffer(maxMem)
const memView = new DataView(memBuffer)

let freeListHead = HeapBlock(0)
freeListHead.size = (1 << 23) as usize

function allocBlock(amt: usize) {
    const aligned = alignUp(amt, 4)
    let block = freeListHead
    while (block.size < aligned || (block.size & (1 << 29))) {
        if (!block.next) throw `Failed to allocated: ${aligned}`
        block = block.next
    }

    if (block.size > HeapBlock.sizeof+aligned+minSplit) {
        const next = block.next
        const start = block.size + aligned
        const rem = block.size - HeapBlock.sizeof+aligned
        block.size = aligned
        const split = HeapBlock(start)
        split.size = rem
        split.next = next
        block.next = split
    }

    block.size |= (1 << 29) // mark
    return Intrinsics.addressof(block) + HeapBlock.sizeof
}

function getBlock(ptr: usize) {
    const addr = ptr - HeapBlock.sizeof
    return HeapBlock(addr)
}

function freeBlock(ptr: usize) {
    const block = getBlock(ptr)
    block.size &= ~(1 << 29)
}

interface InternalSlice<T> {
    ptr: usize
    len: usize // len*alignment to get byteLength
    __view: StructViewFactory<T>
    __address: usize
}


interface SliceMethods<T> {
    at(idx: usize): StructView<T>
}

const InternalSlice = DefineStructView(reify InternalSlice<any>)

export function StructList<T>(T: StructViewFactory<T>, count: usize, alloc: (bytes: usize) => usize) {
    const slice_ptr = alloc(InternalSlice.sizeof)
    const s = InternalSlice(slice_ptr) as StructView<InternalSlice<any>> & SliceMethods<T>
    s.__view = T
    s.ptr = alloc(count * T.sizeof)
    s.len = count

    function at(this: InternalSlice<any>, idx: usize) {
        if (idx >= this.len) throw `Slice out of bounds: len -> ${this.len}; idx -> ${idx}`
        const view = this.__view
        const addr = this.ptr + idx*view.sizeof
        return view(addr)
    }

    s.at = at
    return s
}

interface ScalarSlice {
    ptr: usize
    len: usize // len*alignment to get byteLength
    __sizeof: u32
    __address: usize
}

interface ScalarSliceMethods<T> {
    at(idx: usize): T
    set(idx: usize, val: T): void
}

export function Slice<T>(T: reify T, count: usize, alloc: (bytes: usize) => usize) {
    assert(T is Type.Machine && T.isConcrete())
    assert(T.width % 8)

    const slice_ptr = alloc(InternalSlice.sizeof)
    const s = InternalSlice(slice_ptr) as any as ScalarSlice & ScalarSliceMethods<T>
    s.__sizeof = (T.width as u32) >> 3
    s.ptr = alloc(count * s.__sizeof)
    s.len = count

    const U = lowerType(T)

    function at(this: ScalarSlice, idx: usize) {
        if (idx >= this.len) throw `Slice out of bounds: len -> ${this.len}; idx -> ${idx}`
        const addr = this.ptr + idx*this.__sizeof
        return Intrinsics.load(addr, 0, U) as T
    }

    function set(this: ScalarSlice, idx: usize, val: T) {
        if (idx >= this.len) throw `Slice out of bounds: len -> ${this.len}; idx -> ${idx}`
        const addr = this.ptr + idx*this.__sizeof
        return Intrinsics.store(addr, 0, val as any, U)
    }

    s.at = at
    s.set = set
    return s
}

interface AllocationArena {
    head: usize
    tail: usize
    remaining: usize
}

interface AllocationArenaMethods {
    free(): void
    steal(): this // copies the frame into a new handle, taking ownership of existing handles
    New<T>(T: StructViewFactory<T>): StructView<T>
}

const InternalArena = DefineStructView(reify AllocationArena)

export type Arena = StructView<AllocationArena> & AllocationArenaMethods

// This does not stack allocate but is itself stack allocated. 
// You cannot free individual allocations.
// 
// ```syn
//  const f = Arena()
//  defer f.free()
//  const b = f.New(Foo)
// ```
export function Arena(): Arena {
    const arena = StackNew(InternalArena) as Arena
    arena.remaining = 0
    arena.head = 0

    function addChunk(a: StructView<AllocationArena>, amt: usize) {
        const aligned = alignUp(amt, 4)
        const chunk = Intrinsics.alloc(aligned+8)
        if (a.head === 0) {
            a.head = chunk
            Intrinsics.store(chunk, 4, 0, Types.u32)
        } else {
            assert(a.tail !== 0)
            Intrinsics.store(a.tail, 4, chunk, Types.u32)
        }
        Intrinsics.store(chunk, 0, aligned, Types.u32)
        a.tail = chunk
        a.remaining = aligned
    }

    arena.free = function() {
        let ptr = this.head
        while (ptr) {
            const next = Intrinsics.load(ptr, 4, Types.u32)
            Intrinsics.free(ptr)
            ptr = next
        }
        // simple debug check for double free, release would skip this code
        if (this.head === 0 && this.remaining !== 0) throw `Arena was double freed`
        this.head = 0
        this.remaining = 1
    }

    arena.steal = function() {
        const ret = StackNew(InternalArena) as Arena
        const this_addr = Intrinsics.addressof(this)
        memcpy(Intrinsics.addressof(ret), this_addr, InternalArena.sizeof)
        memsetByte(this_addr, InternalArena.sizeof, 0)
        return ret
    }

    arena.New = function(T) {
        const amt = T.sizeof
        if (amt > this.remaining) {
            // we can also try searching from `head` for a possible spot
            addChunk(this, (amt << 1) + (amt >> 1))
        }
        const rem = this.remaining
        assert(amt <= rem)
        this.remaining = rem - amt
        const base = this.tail
        const addr = (base+8) + (Intrinsics.load(base, 0, Types.u32) - rem)
        return T(addr)
    }

    return arena
}


const Example = DefineStructView(reify {
    a: u32
    b: u32
    c?: {
        a: u32
    }
})

const allocated = New(Example)
allocated.a = 1
console.log(allocated.a)

console.log(allocated.c)

