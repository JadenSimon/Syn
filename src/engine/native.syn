    }
    function paramShapes(fn: Function, paramCount: number): Map<number, intrinsics.Handle> {
        const shapes = paramShapesOf(fn)
        const reps = new Map(plannedParams(fn).map(({ index, rep }) => [index, rep]))
        for (let i = 0; i < paramCount; i++) {
            if (shapes.has(i)) continue
            const rep = reps.get(i)
            if (isRoot(fn) || rep?.kind === 'number' || rep?.number === 'f64' || rep?.number === 'i64') shapes.set(i, propertyEval.numberShape)
        }
        return shapes
    }
    function withConstantParams(traced: Traced, constants: Map<number, ParamConstant>): Traced {
        if (!constants.size) return traced
        const graph = traced.graph
        const out = withNodes(graph, new Map())
        const params = new Map<number, number>()
        for (const [i, constant] of constants) params.set(graph.blocks[0].params[i], addNode(out, constant.handle !== undefined ? NodeOp.heapHandle : NodeOp.literal, [{ literal: constant.handle ?? constant.literal! }]))
        for (const [id, n] of graph.nodes) {
