    const fixed = new Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>()
    const pointees = new Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>()
    interface FnGraphs {
        fn: Function
        source: CompiledSource
