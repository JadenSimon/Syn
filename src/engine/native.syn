    const constructions = new Map<Function, Map<number, Function>>()
    function constructionFor(caller: Function, fn: Function, site: number): Function {
        let bySite = constructions.get(caller)
        if (!bySite) constructions.set(caller, bySite = new Map())
        const known = bySite.get(site)
        if (known) return known
        const origin = specializedFrom.get(fn) ?? fn
        const constructed = Object.defineProperty(function constructed() {}, 'name', { value: `${origin.name}@${caller.name}:${site}` })
        codes.set(constructed, codeOf(origin)!)
