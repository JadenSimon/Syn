                if (value === undefined) continue
                if (!rets.some(r => JSON.stringify(r) === JSON.stringify(value))) rets.push(value)
            } else if (n.op === NodeOp.call) {
                const callee = calledFunction(graph, n, arrivals)
                if (!callee) continue
                for (const e of summaryOf(callee).effects) {
                    const target = e.target.param === resultParam ? throughResult(id, e.target) : through(n, e.target)
                    const value = isLoc(e.value) && e.value.param === resultParam ? throughResult(id, e.value) : through(n, e.value)
                    if (target !== undefined && isLoc(target)) effects.push({ target, value: value ?? unknownValue, encoded: e.encoded })
