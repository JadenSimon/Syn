        }
        const seen = new Set<number>()
        function visit(id: number): boolean {
            if (seen.has(id)) return true
            seen.add(id)
            const n = graph.nodes.get(id)
            if (!n) return false
            if (n.op === 'after') return visit(getRef(n, countIds(n) - 1))
            if (n.op === 'select') return visit(getRef(n, 1)) && visit(getRef(n, 2))
            if (n.op === 'param') {
