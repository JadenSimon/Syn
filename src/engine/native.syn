type usize = u32

const flags = new Set(intrinsics.argv())
function flagged(flag: string, name?: string): boolean {
    return flags.has(flag) || (name !== undefined && flags.has(`${flag}:${name}`))
}

const Intrinsics = intrinsics.Intrinsics
const Types = intrinsics.Types
const UnboxingOps = new Set([
    NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr,
    NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.neg, NodeOp.convert, NodeOp.bitconvert, NodeOp.crc32,
])

const poolTag = Symbol('native.pool')
interface PoolValue {
    [poolTag]: true
    value: number | bigint
}

export function pool(value: number | bigint): any {
    return { [poolTag]: true, value }
}

function isPoolValue(value: any): value is PoolValue {
    return !!value?.[poolTag]
}

let nativeMapper: any
let nativeCopier: any
let nativeSealer: any
let nativeInvoker: any
let heldArgs: any
const darwinArm64 = process.platform === 'darwin' && process.arch === 'arm64'
function declareNative(ptr: any, args: number[], returns: number): any {
    if (ptr === undefined) return undefined
    const f: any = (..._: any[]) => { throw new Error('unlinked native symbol') }
    f.__native = typeof ptr === 'bigint' ? Number(ptr) : ptr
    f.__args = args
    f.__returns = returns
    return f
}
const sys_icache_invalidate = declareNative(
    darwinArm64 ? (ts as any).lookupNativeSymbol('sys_icache_invalidate') : undefined,
    [Types.u64, Types.u64], Types.u64,
)
const pthread_jit_write_protect_np = darwinArm64
    ? (ts as any).lookupNativeSymbol('pthread_jit_write_protect_np') : undefined

function mapCodePage(len: usize): usize {
    const r = syscalls.mmap(
        0, len,
        // (syscalls.PROT_READ | syscalls.PROT_WRITE | (darwinArm64 ? syscalls.PROT_EXEC : 0)) as any,
        // (syscalls.MAP_PRIVATE | syscalls.MAP_ANON | (darwinArm64 ? syscalls.MAP_JIT : 0)) as any,
        (syscalls.PROT_READ | syscalls.PROT_WRITE) as any,
        (syscalls.MAP_PRIVATE | syscalls.MAP_ANON) as any,
        -1 as any, 0,
    )
    // if (darwinArm64) {
    //     pthread_jit_write_protect_np(0)
    // }
    return r
}

function copyCode(dst: usize, src: usize, len: usize): usize {
    let offset: u32 = 0
    while ((len - offset) >= 8) {
        Intrinsics.store(dst, offset, Intrinsics.load(src, offset, Types.u64), Types.u64)
        offset += 8
    }
    while (offset < len) {
        Intrinsics.store(dst, offset, Intrinsics.load(src, offset, Types.u8), Types.u8)
        offset += 1
    }
    return dst
}

function sealCodePage(ptr: usize, len: usize): u32 {
    // if (darwinArm64) {
    //     pthread_jit_write_protect_np(1)
    //     return sys_icache_invalidate(ptr, len)
    // }
    const status = syscalls.mprotect(ptr, len, syscalls.PROT_READ | syscalls.PROT_EXEC)
    if (status === 0 && darwinArm64) sys_icache_invalidate(ptr, len)
    return status
}

function invokeNative(target: any, args: usize, nargs: usize): usize {
    if (nargs === 0) return target()
    const a0 = Intrinsics.load(args, 0, Types.u64)
    if (nargs === 1) return target(a0)
    const a1 = Intrinsics.load(args, 8, Types.u64)
    if (nargs === 2) return target(a0, a1)
    const a2 = Intrinsics.load(args, 16, Types.u64)
    if (nargs === 3) return target(a0, a1, a2)
    const a3 = Intrinsics.load(args, 24, Types.u64)
    if (nargs === 4) return target(a0, a1, a2, a3)
    const a4 = Intrinsics.load(args, 32, Types.u64)
    if (nargs === 5) return target(a0, a1, a2, a3, a4)
    const a5 = Intrinsics.load(args, 40, Types.u64)
    if (nargs === 6) return target(a0, a1, a2, a3, a4, a5)
    const a6 = Intrinsics.load(args, 48, Types.u64)
    if (nargs === 7) return target(a0, a1, a2, a3, a4, a5, a6)
    const a7 = Intrinsics.load(args, 56, Types.u64)
    if (nargs === 8) return target(a0, a1, a2, a3, a4, a5, a6, a7)
    const a8 = Intrinsics.load(args, 64, Types.u64)
    if (nargs === 9) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8)
    const a9 = Intrinsics.load(args, 72, Types.u64)
    if (nargs === 10) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9)
    const a10 = Intrinsics.load(args, 80, Types.u64)
    if (nargs === 11) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10)
    const a11 = Intrinsics.load(args, 88, Types.u64)
    if (nargs === 12) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11)
    const a12 = Intrinsics.load(args, 96, Types.u64)
    if (nargs === 13) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12)
    const a13 = Intrinsics.load(args, 104, Types.u64)
    if (nargs === 14) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13)
    const a14 = Intrinsics.load(args, 112, Types.u64)
    if (nargs === 15) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14)
    const a15 = Intrinsics.load(args, 120, Types.u64)
    if (nargs === 16) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15)
    return 0
}
const maxRootArgs = 16
let runtimeHeapAddress: number | undefined
function runtimeHeapBase(): number {
    if (runtimeHeapAddress !== undefined) return runtimeHeapAddress
    getNativeBootstraps()
    const base = Number(nativeMapper(heap.boxedCellBit + heap.runtimeCells + (1 << 24)))
    if (!base || base === -1) throw 'native: failed to map the runtime heap'
    runtimeHeapAddress = base
    writeRuntimeHeap(heap.runtimeCells, new Uint8Array(new Uint32Array([heap.runtimeCells + 8]).buffer))
    return base
}
const mirroredCells = new Set<number>()
const mirroredStrings = new Set<number>()
function vmBytes(ptr: number, size: number): Uint8Array {
    const bytes = new Uint8Array(size)
    for (let i = 0; i < size; i++) bytes[i] = Intrinsics.load(ptr, i, Types.u8)
    return bytes
}
function writeRuntimeHeap(at: number, bytes: Uint8Array): void {
    const outer = heldArgs
    heldArgs = bytes
    const src = (ts as any).getArrayBufferPtr(bytes.buffer)
    if (!nativeCopier(runtimeHeapBase() + at, src, bytes.byteLength)) throw 'native: failed to copy into the runtime heap'
    heldArgs = outer
}
function mirrorRaw(ptr: number): void {
    if (!ptr || mirroredCells.has(ptr)) return
    mirroredCells.add(ptr)
    writeRuntimeHeap(ptr, vmBytes(ptr, intrinsics.allocationSize(ptr)))
}
function mirrorTypeDescriptor(td: number): void {
    if (mirroredCells.has(td)) return
    mirrorRaw(td)
    mirrorValue(heap.objectPrototypeOfTD(td as intrinsics.Handle))
}
function mirrorValue(handle: number): void {
    if (heap.isTypeDescriptor(handle as intrinsics.Handle)) mirrorTypeDescriptor(handle)
    else if (heap.isCell(handle as intrinsics.Handle)) mirrorCell(handle)
}
function mirrorProperties(dict: number): void {
    if (!dict || mirroredCells.has(dict)) return
    const { raw, cells } = heap.propertyStorage(dict as intrinsics.Handle)
    for (const at of raw) mirrorRaw(at)
    for (const cell of cells) mirrorValue(cell)
}
function mirrorCell(handle: number): void {
    if (!handle || mirroredCells.has(handle)) return
    mirroredCells.add(handle)
    const view = heap.cellLayout(heap.typeDescriptorOf(handle as intrinsics.Handle))
    if (!view) throw `native: heap cell ${handle} has no view for its type descriptor`
    if (view === heap.HeapString) mirroredStrings.add(handle)
    const bytes = vmBytes(heap.resolveHeapCell(handle as intrinsics.Handle), view.sizeof)
    const data = new DataView(bytes.buffer)
    for (const offset of view.handleOffsets) {
        const child = data.getUint32(offset, true)
        if (!child) continue
        if (offset === 0) mirrorTypeDescriptor(child)
        else if (heap.isTypeDescriptor(child as intrinsics.Handle) || heap.isCell(child as intrinsics.Handle)) mirrorValue(child)
        else mirrorProperties(child)
    }
    for (const offset of view.rawOffsets) {
        const raw = Number(data.getBigUint64(offset, true))
        if (!raw) continue
        mirrorRaw(raw)
        data.setBigUint64(offset, BigInt(runtimeHeapBase() + raw), true)
    }
    writeRuntimeHeap(handle, bytes)
}
const pstackRegionBytes = 1 << 24
const pstackCells = new Map<number, number>()
function pstackCell(stack: number): number {
    const known = pstackCells.get(stack)
    if (known !== undefined) return known
    getNativeBootstraps()
    const cell = Number(nativeMapper(pstackRegionBytes))
    if (!cell || cell === -1) throw `native: failed to map pstack ${stack}`
    const top = new BigUint64Array([BigInt(cell + 8)])
    if (!nativeCopier(cell, (ts as any).getArrayBufferPtr(top.buffer), 8)) throw `native: failed to seed pstack ${stack}`
    pstackCells.set(stack, cell)
    return cell
}

function staticReserve(size: number): number {
    const at = Math.ceil(Number(pstackMark(0)) / 8) * 8
    pstackRelease(0, BigInt(at + size))
    return at
}

function staticWrite(at: number, bytes: Uint8Array): void {
    if (!nativeCopier(at, (ts as any).getArrayBufferPtr(bytes.buffer), bytes.length)) throw 'native: failed to write static memory'
}

function staticData(bytes: Uint8Array): number {
    const at = staticReserve(bytes.length)
    staticWrite(at, bytes)
    return at
}

function staticBox(value: number): number {
    const at = staticReserve(8)
    staticWrite(at, new Uint8Array(new Float64Array([value]).buffer))
    return (staticWord(at) | (heap.pstackBoxWordTag ^ heap.pstackWordTag)) >>> 0
}

function staticWord(at: number): number {
    return ((at - (pstackCell(0) + 8)) * 2 + heap.pstackWordTag + 1) >>> 0
}

interface StaticTail {
    block: number
    args: StaticValue[]
}
interface StaticRecord {
    fields: Map<number, StaticValue>
}
type StaticValue = bigint | number | StaticTail | StaticRecord

interface StaticContext {
    units: Map<number, Graph>
    runtime: Map<number, number>
    address(cell: intrinsics.Handle): number | undefined
    static(handle: intrinsics.Handle): bigint | undefined
    readable(address: number, size: number): boolean
    reserve?: (size: number) => number
    regions: { base: number, bytes: Uint8Array }[]
    steps: number
    budget: number
}

const staticStepBudget = 1_000_000
const callStepBudget = 20_000

function staticWidth(T: intrinsics.Types): number {
    if (T === Types.bool) return 1
    if (T === Types.vm_value) return 32
    if (T === Types.unknown || T === Types.unknown_number) return 64
    const width = intrinsics.intrinsicBitWidth(T)
    intrinsics.assert(width > 0, `static: type ${T} has no width`)
    return width
}

function staticNorm(v: bigint, T: intrinsics.Types): bigint {
    const width = staticWidth(T)
    return isSignedType(T) ? BigInt.asIntN(width, v) : BigInt.asUintN(width, v)
}

function staticInt(v: StaticValue, why: string): bigint {
    if (typeof v !== 'bigint') throw `static: ${why} is not an integer`
    return v
}

function staticFloat(v: StaticValue): number {
    if (typeof v === 'number') return v
    if (typeof v === 'bigint') return Number(v)
    throw 'static: a jump is used as a value'
}

const staticScratch = new DataView(new ArrayBuffer(8))

function staticMemory(ctx: StaticContext, address: number, size: number): { bytes: Uint8Array, at: number, owned: boolean } {
    for (const region of ctx.regions) {
        if (address >= region.base && address + size <= region.base + region.bytes.length) return { bytes: region.bytes, at: address - region.base, owned: true }
    }
    if (!ctx.readable(address, size)) throw `static: reads memory at ${address} that it does not own`
    const bytes = new Uint8Array(size)
    if (!nativeCopier((ts as any).getArrayBufferPtr(bytes.buffer), address, size)) throw 'static: failed to read placed memory'
    return { bytes, at: 0, owned: false }
}

function staticLoad(ctx: StaticContext, address: number, T: intrinsics.Types): StaticValue {
    const size = Math.max(1, staticWidth(T) / 8)
    const { bytes, at } = staticMemory(ctx, address, size)
    let raw = BigInt(0)
    for (let i = size - 1; i >= 0; i--) raw = (raw << BigInt(8)) | BigInt(bytes[at + i])
    if (T !== Types.f64) return staticNorm(raw, T)
    staticScratch.setBigUint64(0, raw, true)
    return staticScratch.getFloat64(0, true)
}

function staticStore(ctx: StaticContext, address: number, value: StaticValue, T: intrinsics.Types): void {
    const size = Math.max(1, staticWidth(T) / 8)
    const { bytes, at, owned } = staticMemory(ctx, address, size)
    if (!owned) throw `static: writes memory at ${address} that it does not own`
    let raw: bigint
    if (typeof value === 'number') {
        staticScratch.setFloat64(0, value, true)
        raw = staticScratch.getBigUint64(0, true)
    } else raw = BigInt.asUintN(64, staticInt(value, 'a stored value'))
    for (let i = 0; i < size; i++) bytes[at + i] = Number((raw >> BigInt(i * 8)) & BigInt(255))
}

function evaluateUnit(ctx: StaticContext, symbol: number, args: StaticValue[]): StaticValue {
    const graph = ctx.units.get(symbol)
    if (!graph) throw `static: calls unit ${symbol}, which has no graph`
    let block = graph.blocks[0]
    let bound = args
    for (;;) {
        const values = new Map<number, StaticValue>()
        for (let i = 0; i < block.params.length; i++) values.set(block.params[i], bound[i] ?? BigInt(0))
        const result = evaluateNode(ctx, graph, block.bodyId, values)
        if (typeof result === 'object' && 'block' in result) {
            const next = getBlock(graph, result.block)
            if (!next) throw `static: jumps to a missing block B${result.block}`
            block = next
            bound = result.args
            continue
        }
        return result
    }
}

function evaluateNode(ctx: StaticContext, graph: Graph, id: number, values: Map<number, StaticValue>): StaticValue {
    const known = values.get(id)
    if (known !== undefined) return known
    if (++ctx.steps > ctx.budget) throw 'static: evaluation takes too long'
    const n = getNode(graph, id)
    if (!n) throw `static: %${id} is missing`
    const operand = (i: number): StaticValue => getRef(n, i) ? evaluateNode(ctx, graph, getRef(n, i), values) : staticLiteral(getLiteral(graph, n, i))
    const int = (i: number): bigint => staticInt(operand(i), `operand ${i} of ${opName(n.op)} %${id}`)
    const T = resultType(graph, n)
    let value: StaticValue
    switch (n.op) {
        case NodeOp.select:
            value = int(0) ? operand(1) : operand(2)
            break
        case NodeOp.apply: {
            const args: StaticValue[] = []
            for (let i = 1; i < countIds(n); i++) args.push(operand(i))
            value = { block: getRef(n, 0), args }
            break
        }
        case NodeOp.after:
            for (let i = 0; i < countIds(n) - 1; i++) operand(i)
            value = operand(countIds(n) - 1)
            break
        case NodeOp.ret:
            value = operand(0)
            break
        case NodeOp.record: {
            const fields = new Map<number, StaticValue>()
            for (let i = 0; i + 1 < countIds(n); i += 2) fields.set(Number(int(i)), operand(i + 1))
            value = { fields }
            break
        }
        case NodeOp.get: {
            const record = operand(0)
            if (typeof record !== 'object' || !('fields' in record)) throw `static: %${id} projects a value that is not a record`
            const field = record.fields.get(Number(int(1)))
            if (field === undefined) throw `static: %${id} projects a missing field`
            value = field
            break
        }
        case NodeOp.nilEffect:
        case NodeOp.void:
            value = BigInt(0)
            break
        case NodeOp.literal:
            value = staticLiteral(getLiteral(graph, n, 0))
            break
        case NodeOp.heapHandle: {
            const cell = getLiteral(graph, n, 0) as intrinsics.Handle
            if (getRef(n, 0)) throw `static: %${id} is a symbolic heap value`
            if (mirroredCells.has(heap.deref(cell))) {
                value = BigInt(heap.deref(cell))
                break
            }
            const at = cell ? ctx.address(cell) : 0
            if (at === undefined) throw `static: %${id} refers to heap value @${cell}, which has no static address`
            value = BigInt(at)
            break
        }
        case NodeOp.static: {
            const target = getNode(graph, getRef(n, 0))
            const word = target?.op === NodeOp.heapHandle ? ctx.static(heap.deref(getLiteral(graph, target, 0) as intrinsics.Handle)) : undefined
            if (word === undefined) throw `static: %${id} depends on a static that does not evaluate`
            value = word
            break
        }
        case NodeOp.pstack: {
            operand(0)
            if (getRef(n, 2) || getLiteral(graph, n, 2)) throw `static: %${id} resets a stack`
            const size = Number(int(3))
            if (!ctx.reserve) throw `static: %${id} allocates`
            const base = ctx.reserve(size)
            ctx.regions.push({ base, bytes: new Uint8Array(size) })
            value = BigInt(base)
            break
        }
        case NodeOp.load: {
            operand(0)
            value = staticLoad(ctx, Number(int(1) + int(2)), typeOf(n))
            break
        }
        case NodeOp.store: {
            operand(0)
            staticStore(ctx, Number(int(1) + int(2)), operand(3), typeOf(n))
            value = BigInt(0)
            break
        }
        case NodeOp.call:
        case NodeOp.rt: {
            operand(0)
            let symbol: number | undefined
            if (n.op === NodeOp.rt) symbol = ctx.runtime.get(getLiteral(graph, n, 1))
            else symbol = calledSymbol(graph, n)
            if (symbol === undefined && n.op === NodeOp.rt && rt.bindingOf(getLiteral(graph, n, 1))?.lower) {
                value = evaluateLowered(ctx, graph, n, values, operand)
                break
            }
            if (symbol === undefined) throw `static: %${id} in ${graph.name ?? "anonymous"} calls something other than a known unit`
            const args: StaticValue[] = []
            for (let i = n.op === NodeOp.rt ? 2 : 3; i < countIds(n); i++) args.push(operand(i))
            value = evaluateUnit(ctx, symbol, args)
            break
        }
        case NodeOp.box:
            value = staticNorm(int(0) << BigInt(1), T)
            break
        case NodeOp.unbox:
            value = BigInt.asIntN(32, int(0)) >> BigInt(1)
            break
        case NodeOp.encode: {
            const ptr = int(0)
            if (!ptr) throw `static: %${id} encodes a null pointer`
            value = BigInt.asUintN(32, (ptr - int(1)) * BigInt(2) + BigInt(heap.pstackWordTag + 1))
            break
        }
        case NodeOp.decode:
            value = ((int(0) >> BigInt(1)) & BigInt((1 << 28) - 1)) + int(1)
            break
        case NodeOp.crc32:
            value = BigInt(intrinsics.crc32Bits(Number(BigInt.asUintN(32, int(0))), int(1), intrinsics.intrinsicBitWidth(getLiteral(graph, n, 2))))
            break
        case NodeOp.convert:
        case NodeOp.bitconvert: {
            const from = operandType(graph, n, 0)
            const v = operand(0)
            if (T === Types.f64 && from === Types.f64) value = v
            else if (T === Types.f64 && n.op === NodeOp.convert) value = staticFloat(v)
            else if (from === Types.f64 && n.op === NodeOp.convert) value = staticNorm(BigInt(Math.trunc(staticFloat(v))), T)
            else if (T === Types.f64 || from === Types.f64) {
                if (T === Types.f64) {
                    staticScratch.setBigUint64(0, BigInt.asUintN(64, staticInt(v, 'a bitconvert operand')), true)
                    value = staticScratch.getFloat64(0, true)
                } else {
                    staticScratch.setFloat64(0, staticFloat(v), true)
                    value = staticNorm(staticScratch.getBigUint64(0, true), T)
                }
            } else value = staticNorm(n.op === NodeOp.bitconvert ? BigInt.asUintN(staticWidth(from), staticInt(v, 'a bitconvert operand')) : staticInt(v, 'a convert operand'), T)
            break
        }
        default:
            value = evaluateArithmetic(graph, n, id, operand, T)
    }
    values.set(id, value)
    return value
}

function evaluateLowered(ctx: StaticContext, graph: Graph, n: GraphNode, values: Map<number, StaticValue>, operand: (i: number) => StaticValue): StaticValue {
    for (let i = 2; i < countIds(n); i++) operand(i)
    const added: number[] = []
    const add = (node: GraphNode): number => {
        const fresh = newId(graph)
        setNode(graph, fresh, node)
        added.push(fresh)
        return fresh
    }
    const lowered = add(rt.lowerNative(graph, n, { runtimeHeapBase, pstackBase: () => pstackCell(0) + 8, add }))
    defer finally {
        for (const id of added) {
            deleteNode(graph, id)
            values.delete(id)
        }
    }
    return evaluateNode(ctx, graph, lowered, values)
}

function staticLiteral(v: number): StaticValue {
    return Number.isInteger(v) ? BigInt(v) : v
}

function evaluateArithmetic(graph: Graph, n: GraphNode, id: number, operand: (i: number) => StaticValue, T: intrinsics.Types): StaticValue {
    const a = operand(0)
    const b = countIds(n) > 1 ? operand(1) : BigInt(0)
    const compare = n.op === NodeOp.eq || n.op === NodeOp.ne || n.op === NodeOp.lt || n.op === NodeOp.le || n.op === NodeOp.gt || n.op === NodeOp.ge
    const floating = T === Types.f64 || typeof a === 'number' || typeof b === 'number'
    if (floating) {
        const x = staticFloat(a), y = staticFloat(b)
        switch (n.op) {
            case NodeOp.add: return x + y
            case NodeOp.sub: return x - y
            case NodeOp.mul: return x * y
            case NodeOp.div: return x / y
            case NodeOp.neg: return -x
            case NodeOp.eq: return BigInt(x === y ? 1 : 0)
            case NodeOp.ne: return BigInt(x !== y ? 1 : 0)
            case NodeOp.lt: return BigInt(x < y ? 1 : 0)
            case NodeOp.le: return BigInt(x <= y ? 1 : 0)
            case NodeOp.gt: return BigInt(x > y ? 1 : 0)
            case NodeOp.ge: return BigInt(x >= y ? 1 : 0)
        }
        throw `static: %${id} is a float ${opName(n.op)}`
    }
    if (typeof a !== 'bigint' || typeof b !== 'bigint') throw `static: %${id} uses a jump as a value`
    if (compare) {
        const signed = isSignedType(operandType(graph, n, 0)) || isSignedType(operandType(graph, n, 1))
        const x = signed ? BigInt.asIntN(64, a) : BigInt.asUintN(64, a)
        const y = signed ? BigInt.asIntN(64, b) : BigInt.asUintN(64, b)
        switch (n.op) {
            case NodeOp.eq: return BigInt(x === y ? 1 : 0)
            case NodeOp.ne: return BigInt(x !== y ? 1 : 0)
            case NodeOp.lt: return BigInt(x < y ? 1 : 0)
            case NodeOp.le: return BigInt(x <= y ? 1 : 0)
            case NodeOp.gt: return BigInt(x > y ? 1 : 0)
            case NodeOp.ge: return BigInt(x >= y ? 1 : 0)
        }
    }
    const width = staticWidth(T)
    const shift = BigInt.asUintN(64, b) % BigInt(width)
    switch (n.op) {
        case NodeOp.add: return staticNorm(a + b, T)
        case NodeOp.sub: return staticNorm(a - b, T)
        case NodeOp.mul: return staticNorm(a * b, T)
        case NodeOp.and: return staticNorm(a & b, T)
        case NodeOp.or: return staticNorm(a | b, T)
        case NodeOp.xor: return staticNorm(a ^ b, T)
        case NodeOp.not: return staticNorm(~a, T)
        case NodeOp.neg: return staticNorm(-a, T)
        case NodeOp.shl: return staticNorm(a << shift, T)
        case NodeOp.shr: return staticNorm(BigInt.asIntN(width, a) >> shift, T)
        case NodeOp.ushr: return staticNorm(BigInt.asUintN(width, a) >> shift, T)
        case NodeOp.div:
        case NodeOp.rem: {
            if (!b) throw `static: %${id} divides by zero`
            const signed = isSignedType(T)
            const x = signed ? BigInt.asIntN(width, a) : BigInt.asUintN(width, a)
            const y = signed ? BigInt.asIntN(width, b) : BigInt.asUintN(width, b)
            return staticNorm(n.op === NodeOp.div ? x / y : x % y, T)
        }
    }
    throw `static: %${id} is ${opName(n.op)}, which does not evaluate`
}

function evaluateStatics(program: ProgramGraph): void {
    const init = program.roots.get(staticInitName)
    if (flags.has('static-debug')) console.log(`statics init ${init} symbols ${program.image.staticSymbols.join(',')}`)
    if (init === undefined) return
    const image = program.image
    const initGraph = program.units.get(init)!
    const words = new Map<number, bigint | null>()
    function evaluateSlot(slot: number): bigint | undefined {
        const known = words.get(slot)
        if (known !== undefined) return known ?? undefined
        words.set(slot, null)
        const ctx: StaticContext = {
            units: program.units,
            runtime: image.runtime,
            address: cell => {
                const slot = image.dataHandles.get(heap.deref(cell))
                return slot === undefined ? undefined : image.knownValue(slot)
            },
            static: handle => {
                const slot = image.statics.get(handle)
                return slot === undefined ? undefined : evaluateSlot(slot)
            },
            readable: (address, size) => address >= pstackCell(0) && address + size <= Number(pstackMark(0)) || inMirroredString(address, size),
            reserve: staticReserve,
            regions: [],
            steps: 0,
            budget: staticStepBudget,
        }
        let word: bigint
        try {
            word = BigInt.asUintN(64, staticInt(evaluateUnit(ctx, image.staticSymbols[slot], []), 'the static result'))
        } catch (e) {
            const message = e instanceof Error ? e.message : String(e)
            if (!message.startsWith('static:')) throw e
            if (flags.has('static-debug')) console.log(`static ${slot} stays in ${staticInitName}: ${e}`)
            return
        }
        for (const region of ctx.regions) {
            staticWrite(region.base, region.bytes)
            image.staticRegions.push([region.base, region.bytes.length])
        }
        const bytes = new BigUint64Array([word])
        staticWrite(image.staticTable.base + slot * 8, new Uint8Array(bytes.buffer))
        words.set(slot, word)
        const address = new BigUint64Array([((word >> BigInt(1)) & BigInt((1 << 28) - 1)) + BigInt(pstackCell(0) + 8)])
        for (const [at, held] of image.staticFields) if (held === slot) staticWrite(at, new Uint8Array(address.buffer))
        if (flags.has('static-debug')) console.log(`static ${slot} evaluates to ${word}`)
        return word
    }
    function literalOperand(n: GraphNode, i: number): number | undefined {
        if (!getRef(n, i)) return getLiteral(initGraph, n, i)
        const value = getNode(initGraph, getRef(n, i))
        if (value?.op === NodeOp.literal) return getLiteral(initGraph, value, 0)
    }
    let remaining = image.staticSymbols.length
    for (let slot = 0; slot < image.staticSymbols.length; slot++) {
        if (evaluateSlot(slot) === undefined) continue
        for (const [id, n] of initGraph.nodes) {
            if (n.op !== NodeOp.store || literalOperand(n, 1) !== image.staticTable.base || literalOperand(n, 2) !== slot * 8) continue
            const stored = getNode(initGraph, getRef(n, 3))
            const value = stored?.op === NodeOp.bitconvert ? getRef(stored, 0) : getRef(n, 3)
            const call = getNode(initGraph, value)
            const called = call?.op === NodeOp.call && getRef(n, 0) === value
            putNode(initGraph, id, NodeOp.after, [getOperand(initGraph, called ? call! : n, 0)])
            remaining--
        }
    }
    for (const [at, held] of image.staticFields) {
        if (!words.get(held)) throw `native: static memory at ${at} holds static ${held}, which only initializes at runtime`
    }
    if (!remaining) program.roots.delete(staticInitName)
    for (const graph of program.units.values()) {
        const known = new Map<number, number>()
        for (const [id, n] of graph.nodes) {
            if (n.op !== NodeOp.static) continue
            const target = getNode(graph, getRef(n, 0))
            const slot = target?.op === NodeOp.heapHandle ? image.statics.get(heap.deref(getLiteral(graph, target, 0) as intrinsics.Handle)) : undefined
            const word = slot === undefined ? undefined : words.get(slot)
            if (word !== undefined && word !== null) known.set(id, Number(word))
        }
        if (!known.size) continue
        for (const [id, n] of graph.nodes) {
            if (n.op !== NodeOp.decode || !known.has(getRef(n, 0)) || getRef(n, 1)) continue
            known.set(id, ((known.get(getRef(n, 0))! >>> 1) & ((1 << 28) - 1)) + getLiteral(graph, n, 1))
        }
        for (const [id, n] of [...graph.nodes]) {
            let ops: Operand[] | undefined
            for (let i = 0; i < countIds(n); i++) {
                const value = known.get(getRef(n, i))
                if (value === undefined) continue
                ops ??= getOperands(graph, n)
                ops[i] = { literal: value }
            }
            if (ops) putCopy(graph, id, n, ops)
        }
    }
}

function inMirroredString(address: number, size: number): boolean {
    if (!mirroredStrings.size) return false
    const at = address - runtimeHeapBase()
    for (const handle of mirroredStrings) if (at >= handle && at + size <= handle + heap.HeapString.sizeof) return true
    return false
}

function constantRegions(program: ProgramGraph): [base: number, size: number][] {
    const image = program.image
    return image.staticRegions.length && !writesStaticMemory(program) ? [...image.readonlyRegions, ...image.staticRegions] : image.readonlyRegions
}

function foldConstantCalls(program: ProgramGraph, clock: PhaseClock): void {
    const image = program.image
    const regions = constantRegions(program)
    const results = new Map<string, StaticValue | null>()
    for (const symbol of reachUnits(program)) {
        const g = program.units.get(symbol)
        if (!g) continue
        const evaluated = new Map<number, StaticValue>()
        for (const [id, n] of g.nodes) {
            if (n.op !== NodeOp.call) continue
            const callee = calledSymbol(g, n)
            if (callee === undefined || !program.units.has(callee)) continue
            let constant = true
            for (let i = 3; i < countIds(n); i++) {
                const arg = getRef(n, i) ? getNode(g, getRef(n, i)) : undefined
                if (getRef(n, i) && arg?.op !== NodeOp.literal && arg?.op !== NodeOp.heapHandle) constant = false
            }
            if (!constant) continue
            const ctx: StaticContext = {
                units: program.units,
                runtime: image.runtime,
                address: cell => {
                    const slot = image.dataHandles.get(heap.deref(cell))
                    return slot === undefined ? undefined : image.knownValue(slot)
                },
                static: () => undefined,
                readable: (address, size) => inStaticRegion(regions, address, size) || inMirroredString(address, size),
                regions: [],
                steps: 0,
                budget: callStepBudget,
            }
            try {
                const values = new Map<number, StaticValue>()
                const args: StaticValue[] = []
                for (let i = 3; i < countIds(n); i++) args.push(getRef(n, i) ? evaluateNode(ctx, g, getRef(n, i), values) : staticLiteral(getLiteral(g, n, i)))
                const key = `${callee}:${args.join(',')}`
                let result = results.get(key)
                if (result === undefined) {
                    results.set(key, null)
                    result = evaluateUnit(ctx, callee, args)
                    results.set(key, result)
                }
                if (result !== null) evaluated.set(id, result)
            } catch (e) {
                const message = e instanceof Error ? e.message : String(e)
                if (!message.startsWith('static:')) throw e
                if (flags.has('static-debug')) console.log(`call %${id} in ${g.name ?? 'anonymous'} stays: ${message}`)
            }
        }
        if (!evaluated.size) continue
        const projections: [id: number, call: number, value: number][] = []
        const kept = new Set<number>()
        for (const [id, n] of g.nodes) {
            for (let i = firstNonOrderingSlot(n); i < countIds(n); i++) {
                const value = evaluated.get(getRef(n, i))
                if (value === undefined || staticScalar(value) !== undefined) continue
                const field = n.op === NodeOp.get && !getRef(n, 1) && typeof value === 'object' && 'fields' in value ? value.fields.get(getLiteral(g, n, 1)) : undefined
                const scalar = field === undefined ? undefined : staticScalar(field)
                if (scalar === undefined) kept.add(getRef(n, i))
                else projections.push([id, getRef(n, i), scalar])
            }
        }
        const folded = new Map<number, number>()
        const tokens = new Map<number, Operand>()
        for (const [id, value] of evaluated) {
            const scalar = staticScalar(value)
            if (scalar === undefined && kept.has(id)) continue
            const n = getNode(g, id)!
            folded.set(id, scalar ?? 0)
            tokens.set(id, getOperand(g, n, 0))
            putNode(g, id, NodeOp.after, [getOperand(g, n, 0), { literal: scalar ?? 0 }])
        }
        for (const [id, call, value] of projections) {
            folded.set(id, value)
            tokens.set(id, tokens.get(call) ?? call)
        }
        if (!folded.size) continue
        replaceFolded(g, folded, tokens)
        program.units.set(symbol, clock.timed('normalize', () => optimizePackaged(g, program.target), g.name))
    }
}

function staticScalar(value: StaticValue): number | undefined {
    if (typeof value !== 'bigint') return
    if (value > BigInt(Number.MAX_SAFE_INTEGER) || value < BigInt(Number.MIN_SAFE_INTEGER)) return
    return Number(value)
}

function replaceFolded(g: Graph, folded: Map<number, number>, tokens: Map<number, Operand>): void {
    for (const [id, n] of [...g.nodes]) {
        let ops: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            const value = folded.get(getRef(n, i))
            if (value === undefined) continue
            ops ??= getOperands(g, n)
            ops[i] = i < firstNonOrderingSlot(n) ? tokens.get(getRef(n, i))! : { literal: value }
        }
        if (ops) putCopy(g, id, n, ops)
    }
}

function inStaticRegion(regions: [base: number, size: number][], address: number, size: number): boolean {
    for (const [base, length] of regions) if (address >= base && address + size <= base + length) return true
    return false
}

function overlapsStaticRegion(regions: [base: number, size: number][], address: number, size: number): boolean {
    for (const [base, length] of regions) if (address < base + length && address + size > base) return true
    return false
}

function writesStaticMemory(program: ProgramGraph): boolean {
    const regions = program.image.staticRegions
    for (const symbol of reachUnits(program)) {
        const g = program.units.get(symbol)
        if (!g) continue
        const mem = memAnalysis(g)
        const aliases = (ref: number, literal: number, offset: number, size: number): boolean => {
            if (!ref) return overlapsStaticRegion(regions, literal + offset, size)
            const m = mem.of(ref)
            if (m.kind === MemFresh) return false
            if (m.kind === MemPre && !m.base && m.pos !== undefined) return overlapsStaticRegion(regions, m.pos + offset, size)
            return true
        }
        for (const n of g.nodes.values()) {
            if (n.op === NodeOp.store) {
                const size = Math.max(1, staticWidth(typeOf(n)) / 8)
                if (getRef(n, 2) ? aliases(getRef(n, 1), getLiteral(g, n, 1), 0, Number.MAX_SAFE_INTEGER) : aliases(getRef(n, 1), getLiteral(g, n, 1), getLiteral(g, n, 2), size)) return true
                continue
            }
            if (n.op !== NodeOp.call) continue
            if (calledSymbol(g, n) !== undefined) continue
            if (getNode(g, getRef(n, 1))?.op !== NodeOp.syscallTarget) return true
            for (let i = 3; i < countIds(n); i++) if (getRef(n, i) && aliases(getRef(n, i), 0, 0, Number.MAX_SAFE_INTEGER)) return true
        }
    }
    return false
}

function foldStaticLoads(program: ProgramGraph, touched: Set<number>): void {
    const image = program.image
    const regions = constantRegions(program)
    const strings = mirroredStrings
    if (!regions.length && !strings.size) return
    const heapBase = strings.size ? runtimeHeapBase() : 0
    for (const symbol of reachUnits(program)) {
        const g = program.units.get(symbol)
        if (!g) continue
        const known = new Map<number, number | null>()
        const operand = (n: GraphNode, i: number): number | undefined => getRef(n, i) ? constant(getRef(n, i)) : getLiteral(g, n, i)
        function constant(id: number): number | undefined {
            if (known.has(id)) return known.get(id) ?? undefined
            known.set(id, null)
            const n = getNode(g, id)
            let value: number | undefined
            if (n?.op === NodeOp.literal) value = getLiteral(g, n, 0)
            else if (n?.op === NodeOp.heapHandle && !getRef(n, 0)) {
                const handle = heap.deref(getLiteral(g, n, 0) as intrinsics.Handle)
                const slot = image.dataHandles.get(handle)
                value = strings.has(handle) ? handle : slot === undefined ? undefined : image.knownValue(slot)
            } else if (n?.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.handleof) value = operand(n, 2)
            else if (n?.op === NodeOp.rt && getLiteral(g, n, 1) === rt.Op.heapaddr) {
                const handle = operand(n, 2)
                if (handle !== undefined && strings.has(handle)) value = heapBase + handle
            } else if (n?.op === NodeOp.after) value = operand(n, countIds(n) - 1)
            else if (n?.op === NodeOp.add) {
                const a = operand(n, 0), b = operand(n, 1)
                if (a !== undefined && b !== undefined) value = a + b
            } else if (n?.op === NodeOp.load && typeOf(n) !== Types.vm_value && typeOf(n) !== Types.f64) {
                const ptr = operand(n, 1), offset = operand(n, 2)
                const size = Math.max(1, staticWidth(typeOf(n)) / 8)
                const cell = ptr === undefined ? false : strings.has(ptr - heapBase) && offset !== undefined && offset + size <= heap.HeapString.sizeof
                if (ptr !== undefined && offset !== undefined && (cell || inStaticRegion(regions, ptr + offset, size))) {
                    const bytes = new Uint8Array(8)
                    if (!nativeCopier((ts as any).getArrayBufferPtr(bytes.buffer), ptr + offset, size)) throw 'native: failed to read static memory'
                    const raw = new DataView(bytes.buffer).getBigUint64(0, true)
                    const read = isSignedType(typeOf(n)) ? BigInt.asIntN(size * 8, raw) : BigInt.asUintN(size * 8, raw)
                    if (read <= BigInt(Number.MAX_SAFE_INTEGER) && read >= BigInt(Number.MIN_SAFE_INTEGER)) value = Number(read)
                }
            }
            known.set(id, value ?? null)
            return value
        }
        const folded = new Map<number, number>()
        const tokens = new Map<number, Operand>()
        for (const [id, n] of [...g.nodes]) {
            if (n.op !== NodeOp.load) continue
            const value = constant(id)
            if (value === undefined) continue
            folded.set(id, value)
            tokens.set(id, getOperand(g, n, 0))
            putNode(g, id, NodeOp.after, [getOperand(g, n, 0), { literal: value }])
        }
        if (!folded.size) continue
        touched.add(symbol)
        replaceFolded(g, folded, tokens)
    }
}

export function pstackMark(stack: number): bigint {
    const cell = pstackCell(stack)
    const top = new BigUint64Array(1)
    if (!nativeCopier((ts as any).getArrayBufferPtr(top.buffer), cell, 8)) throw `native: failed to read pstack ${stack}`
    return top[0]
}

export function pstackRelease(stack: number, mark: bigint): void {
    const cell = pstackCell(stack)
    const top = new BigUint64Array([mark])
    if (!nativeCopier(cell, (ts as any).getArrayBufferPtr(top.buffer), 8)) throw `native: failed to reset pstack ${stack}`
}

export function seedPstacks(graph: Graph): void {
    for (const [id, n] of graph.nodes) {
        if (n.op !== NodeOp.pstack) continue
        if (getRef(n, 1)) throw `native: pstack %${id} names its stack dynamically`
        putCopy(graph, id, n, withOperand(graph, n, 1, { literal: pstackCell(getLiteral(graph, n, 1)) }))
    }
}

function getNativeBootstraps() {
    if (nativeMapper) return
    const mapper = lowerValueGraph(trace2(mapCodePage).graph, { target: hostTarget })
    const copier = lowerValueGraph(trace2(copyCode).graph, { target: hostTarget })
    const sealer = lowerValueGraph(trace2(sealCodePage).graph, { target: hostTarget })
    const invoker = lowerValueGraph(trace2(invokeNative).graph, { target: hostTarget })
    nativeMapper = (ts as any).createNativeFn(new Uint8Array(mapper.bytes))
    nativeCopier = (ts as any).createNativeFn(new Uint8Array(copier.bytes))
    nativeSealer = (ts as any).createNativeFn(new Uint8Array(sealer.bytes))
    nativeInvoker = (ts as any).createNativeFn(new Uint8Array(invoker.bytes))
    if (flags.has('bootstrap-debug')) {
        console.log('--- listing mapper ---')
        console.log(mapper.listing)
        console.log('--- listing copier ---')
        console.log(copier.listing)
        console.log('--- listing sealer ---')
        console.log(sealer.listing)
        console.log('--- listing invoker ---')
        console.log(invoker.listing)
    }
}

interface CodePage {
    ptr: any
    length: number
    used: number
    sealed: boolean
}
let writableCodePage: CodePage | undefined

function addPtr(ptr: any, offset: number): any {
    return typeof ptr === 'bigint' ? ptr + BigInt(offset) : ptr + offset
}

function reserveCode(length: number): { page: CodePage, ptr: any } {
    getNativeBootstraps()
    let page = writableCodePage
    let offset = page ? (page.used + 15) & ~15 : 0
    if (!page || offset + length > page.length) {
        const mappedLength = (Math.max(length, 4096) + 4095) & ~4095
        const ptr = nativeMapper(mappedLength)
        if (!ptr) throw 'failed to map native code page'
        page = { ptr, length: mappedLength, used: 0, sealed: false }
        writableCodePage = page
        offset = 0
    }
    page.used = offset + length
    return { page, ptr: addPtr(page.ptr, offset) }
}

function sealCode(page: CodePage): void {
    if (page.sealed) return
    const status = nativeSealer(page.ptr, page.length)
    if (status !== 0) throw `mprotect failed: ${status}`
    page.sealed = true
    if (writableCodePage === page) writableCodePage = undefined
}

interface NativeUnit {
    name: string
    symbol: number
    code: LowerGraphResult
    returnsFloat: boolean
}

function returnsFloat(graph: Graph, floats = floatValues(graph)): boolean {
    for (const n of graph.nodes.values()) {
        if (n.op !== NodeOp.ret) continue
        if (getRef(n, 0) ? floats.has(getRef(n, 0)) : !Number.isInteger(getLiteral(graph, n, 0))) return true
    }
    return false
}

function floatBits(raw: any): number {
    return new Float64Array(new BigInt64Array([BigInt(raw)]).buffer)[0]
}

function nativeStub(fn: Function, symbol: number, paramCount: number, rest: number): Function {
    const names: string[] = []
    for (let i = 0; i < paramCount; i++) names.push(`arg${i}`)
    const stub: any = new Function(...names, `throw new Error('Unlinked local function')`)
    stub.__localTarget = symbol
    stub.__args = Array.from({ length: paramCount }, () => Types.u64)
    stub.__rest = rest
    stub.__name = fn.name
    return stub
}

function isLocalStub(f: any): boolean {
    return Number.isSafeInteger(f?.__localTarget)
}

const toComputation = Symbol.for('toComputation')
const addressKey = heap.fromJsString('__address')

function inlineComputation(source: string, captures: any[], arity: number): Function {
    const names: string[] = []
    for (let i = 0; i < arity; i++) names.push(`arg${i}`)
    const fn: any = new Function(...names, `throw new Error('Untraced synthetic function')`)
    fn.shouldInline = true
    fn[toComputation] = () => [source, captures]
    return fn
}

function makeHeapWrapper(proto: intrinsics.Handle): Function {
    return inlineComputation(
        'function heapWrapper(value) { return Object.setPrototypeOf({ __address: value }, $0) }',
        [heap.createHeapHandle(proto)],
        1,
    )
}

function wrapCall(stub: Function, wrapper: Function, arity: number): Function {
    const names: string[] = []
    for (let i = 0; i < arity; i++) names.push(`arg${i}`)
    return inlineComputation(
        `function wrappedCall(${names.join(', ')}) { return $0($1(${names.join(', ')})) }`,
        [wrapper, stub],
        arity,
    )
}

function returnedHeapValues(graph: Graph): { prototype: intrinsics.Handle, replacements: Map<number, [number, number]> } | undefined {
    const applications = new Map<number, number>()
    for (const n of graph.nodes.values()) {
        if (n.op === NodeOp.apply) applications.set(getRef(n, 0), (applications.get(getRef(n, 0)) ?? 0) + 1)
    }
    let prototype: intrinsics.Handle | undefined

    function replacement(raw: intrinsics.Handle): [number, number] | undefined {
        const handle = heap.deref(raw as intrinsics.Handle)
        if (heap.ownPropertyCount(handle) !== 1) return
        const descriptor = heap.getOwnProperty(handle, addressKey)
        if (!descriptor) return
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
        const boxed = d.slot0 as intrinsics.Handle
        if (!heap.isBoxedF64(boxed)) return
        const proto = heap.getPrototypeOf(handle)
        if (prototype !== undefined && prototype !== proto) return
        prototype = proto
        const value = heap.unboxF64(boxed)
        const id = intrinsics.getNanId(value)
        return id ? [id, 0] : [0, value]
    }

    const replacements = new Map<number, [number, number]>()
    const walked = new Map<number, boolean>()
    const entered = new Map<number, Set<number>>()
    const incoming = paramArrivals(graph)
    const walking = new Set<number>()
    function visit(id: number): boolean {
        if (!id) return false
        const known = walked.get(id)
        if (known !== undefined) return known
        if (walking.has(id)) return true
        walking.add(id)
        defer walking.delete(id)
        const n = getNode(graph, id)
        if (!n) return false
        if (isParam(graph.nodes, id)) {
            const args = incoming.get(id)
            if (!args || !args.length) return false
            const ok = args.every(arg => visit(arg))
            walked.set(id, ok)
            return ok
        }
        let ok = false
        if (n.op === NodeOp.heapHandle && !getRef(n, 0)) {
            const next = replacement(getLiteral(graph, n, 0) as intrinsics.Handle)
            if (next) { replacements.set(id, next); ok = true }
        } else if (n.op === NodeOp.after) {
            ok = visit(getRef(n, countIds(n)-1))
        } else if (n.op === NodeOp.select) {
            ok = true
            for (let i = 1; i < countIds(n); i++) if (!visit(getRef(n, i))) { ok = false; break }
        } else if (n.op === NodeOp.panic || n.op === NodeOp.unreachable) {
            ok = true
        } else if (n.op === NodeOp.ret || n.op === NodeOp.inlined) {
            ok = visit(getRef(n, 0))
        } else if (n.op === NodeOp.apply) {
            const target = getBlock(graph, getRef(n, 0))
            if (target) {
                let users = entered.get(target.id)
                if (!users) entered.set(target.id, users = new Set())
                users.add(id)
                ok = visit(target.bodyId)
            }
        }
        walked.set(id, ok)
        return ok
    }

    const entry = graph.blocks[0]
    if (!visit(entry.bodyId) || !replacements.size || prototype === undefined) return
    for (const [block, callers] of entered) if ((applications.get(block) ?? 0) !== callers.size) return
    return { prototype, replacements }
}

function liftReturnedHeapValues(graph: Graph): Graph {
    const returned = returnedHeapValues(graph)
    if (!returned) return graph
    const { replacements } = returned
    const out = withNodes(graph, new Map(graph.nodes))
    const rewritten = new Map<number, [number, number]>()
    function replaceAll(id: number): [number, number] {
        if (!id) return [id, 0]
        const replacement = replacements.get(id) ?? rewritten.get(id)
        if (replacement) return replacement
        const n = getNode(out, id)
        if (!n || isParam(out.nodes, id)) return [id, 0]
        const ids = getArgIds(n)
        const edits: [idx: number, id: number, value: number][] = []
        for (let i = 0; i < ids.length; i++) {
            const next = replaceAll(ids[i])
            if (next[0] !== ids[i]) edits.push([i, next[0], next[1]])
        }
        if (!edits.length) return [id, 0]
        const operands = getOperands(out, n)
        for (const edit of edits) operands[edit[0]] = edit[1] || { literal: edit[2] }
        const copy = addCopy(out, n, operands)
        rewritten.set(id, [copy, 0])
        return [copy, 0]
    }

    for (const b of out.blocks) {
        const next = replaceAll(b.bodyId)
        if (next[0] === b.bodyId) continue
        b.bodyId = next[0]
        b.bodyConst = next[1] as f64
    }
    return out
}

const interpreted = new Set([NodeOp.ret, NodeOp.panic, NodeOp.unreachable, NodeOp.record, NodeOp.get, NodeOp.block, NodeOp.void, NodeOp.apply, NodeOp.after, NodeOp.inlined, NodeOp.trap, NodeOp.nilEffect, NodeOp.mem, NodeOp.join])
const targets = new Set([NodeOp.syscallTarget, NodeOp.localTarget, NodeOp.poolEntry, NodeOp.heapHandle])

const folding = new Set([NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.neg, NodeOp.not, NodeOp.convert])

const inlineNodeLimit = 75

function inlineCost(g: Graph, literals = new Set<number>()): number | undefined {
    if (g.nodes.size > inlineNodeLimit) return
    let root = g.blocks[0].bodyId
    const reachable = new Set<number>()
    let code = 0
    function visit(id: number): void {
        if (!id || code > 50) return
        const n = getNode(g, id)
        if (!n || n.op === NodeOp.param) return
        if (n.op === NodeOp.block) {
            const b = getBlock(g, id)
            if (!b || reachable.has(id)) return
            reachable.add(id)
            visit(b.bodyId)
            return
        }
        if (!countIds(n)) return
        if (targets.has(n.op)) return
        if (reachable.has(id)) return
        reachable.add(id)
        if (!interpreted.has(n.op)) code++
        for (const arg of getArgIds(n)) {
            if (!arg) continue
            visit(arg)
        }
    }
    visit(root)
    if (code > 50) return
    let cost = 0
    const cheap = new Set([
        NodeOp.load, NodeOp.store, NodeOp.select, NodeOp.ne, NodeOp.eq, NodeOp.gt, NodeOp.lt, NodeOp.le, NodeOp.ge,
        NodeOp.add, NodeOp.sub, NodeOp.div, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, 
        NodeOp.neg, NodeOp.not, NodeOp.convert, NodeOp.bitconvert, NodeOp.literal, NodeOp.void, NodeOp.encode, NodeOp.decode, NodeOp.box, NodeOp.unbox, NodeOp.clz, NodeOp.crc32
    ])
    const slots = new Map<number, [block: number, index: number]>()
    const inbound = new Map<number, GraphNode[]>()
    if (literals.size) {
        for (const b of g.blocks.slice(1)) b.params.forEach((p, i) => slots.set(p, [b.id, i]))
        for (const id of reachable) {
            const n = getNode(g, id)!
            if (n.op !== NodeOp.apply) continue
            const list = inbound.get(getRef(n, 0))
            if (list) list.push(n)
            else inbound.set(getRef(n, 0), [n])
        }
    }
    const folds = new Map<number, boolean>()
    function constant(id: number): boolean {
        if (!id || literals.has(id)) return true
        const known = folds.get(id)
        if (known !== undefined) return known
        folds.set(id, false)
        const n = getNode(g, id)
        const slot = slots.get(id)
        let result = n?.op === NodeOp.literal || (!!n && folding.has(n.op)) || (!!slot && inbound.has(slot[0]))
        if (slot) for (const app of inbound.get(slot[0]) ?? []) result &&= constant(getRef(app, slot[1] + 1))
        else if (n?.op !== NodeOp.literal) for (let i = 0; result && i < countIds(n!); i++) result = constant(getRef(n!, i))
        folds.set(id, result)
        return result
    }
    for (const id of reachable) {
        const n = getNode(g, id)!
        if (interpreted.has(n.op)) continue
        if (n.op !== NodeOp.literal && constant(id)) continue
        if (n.op === NodeOp.call || n.op === NodeOp.pstack) {
            cost += 3
            continue
        }
        if (n.op === NodeOp.rem || n.op === NodeOp.alloca) {
            cost += 3
            continue
        }
        if (!cheap.has(n.op) && !(n.op === NodeOp.rt && rt.bindingOf(getLiteral(g, n, 1))?.lower)) return
        cost += n.op === NodeOp.mul || n.op === NodeOp.div ? 2 : 1
    }
    return cost
}

export function fieldShape(slot: intrinsics.Handle): intrinsics.Types {
    if (heap.isBoxedF64(slot)) return Types.f64
    if (heap.isString(slot)) return Types.usize
    return Types.handle
}

function snapshotFields(snapshot: intrinsics.Handle): { key: intrinsics.Handle, shape: intrinsics.Types, slot: intrinsics.Handle }[] {
    const fields: { key: intrinsics.Handle, shape: intrinsics.Types, slot: intrinsics.Handle }[] = []
    for (let k: u32 = 0; k < heap.ownPropertyCount(snapshot); k++) {
        const key = heap.ownPropertyKeyAt(snapshot, k)
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.ownPropertyAt(snapshot, k)))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
        const slot = d.slot0 as intrinsics.Handle
        fields.push({ key, shape: fieldShape(slot), slot })
    }
    return fields
}

export function sameSnapshotShape(a: intrinsics.Handle | undefined, b: intrinsics.Handle | undefined, nested?: (key: intrinsics.Handle) => boolean): boolean {
    if (!a || !b) return a === b
    if (heap.typeDescriptorOf(a) !== heap.typeDescriptorOf(b)) return false
    const x = snapshotFields(a)
    const y = snapshotFields(b)
    if (x.length !== y.length) return false
    for (let i = 0; i < x.length; i++) {
        if (x[i].key !== y[i].key || x[i].shape !== y[i].shape) return false
        if (x[i].shape === Types.handle && x[i].slot !== y[i].slot && !nested?.(x[i].key)) return false
    }
    return true
}

export function sameLayout(a: intrinsics.Handle | undefined, b: intrinsics.Handle | undefined, seen: Set<string> = new Set()): boolean {
    if (a === b) return true
    if ((a && heap.isCallable(a)) || (b && heap.isCallable(b))) return false
    const pair = `${a}:${b}`
    if (seen.has(pair)) return true
    seen.add(pair)
    const x = a ? snapshotFields(a) : []
    const y = b ? snapshotFields(b) : []
    return sameSnapshotShape(a, b, key => sameLayout(x.find(f => f.key === key)?.slot, y.find(f => f.key === key)?.slot, seen))
}

export interface CreateNativesOptions {
    globals?: Record<string, any>
}

function reportPanic(err: any): void {
    syscalls.write(2, err.message, 1)
    Intrinsics.trap(0)
}

const EffectNames = ['readnone', 'readonly', 'writes']

interface CallWrites { callee: number, args: number[], node: number }

function writeTarget(graph: Graph, m: Mem | undefined): number {
    if (!m) return WritesUnknown
    if (m.kind === MemFresh) return 0
    const bit = m.kind === MemPre ? argBit(graph.blocks[0].params.indexOf(m.base)) : 0
    return bit || WritesUnknown
}

function calleeWrites(mask: number | undefined, args: number[]): number {
    if (mask === undefined || mask & WritesUnknown) return WritesUnknown
    let out = 0
    for (const j of maskArgs(mask)) out |= args[j] ?? WritesUnknown
    return out
}

interface Flow { own: boolean, calls: [callee: number, arg: number][] }

function symbolFlow(graph: Graph, flow: MemFlow): Flow {
    return {
        own: flow.own,
        calls: flow.calls.map(([call, k]): [number, number] => [calledSymbol(graph, getNode(graph, call)!) ?? -1, k]),
    }
}

function capturedBy(flow: Flow, captures: Map<number, number>): boolean {
    return flow.own || flow.calls.some(([callee, k]) => callee < 0 || hasArg(captures.get(callee) ?? CapturesAll, k))
}

interface RetEffect { value: number | undefined, self: number, writes: number, calls: CallWrites[], through?: number, excludes?: number }

interface GraphEffects { self: number, callees: number[], writes: number, calls: CallWrites[], fresh: boolean, params: Flow[], loaded: Flow[][], returned: Flow[], rets: RetEffect[] }

function throughCall(ret: RetEffect): CallWrites | undefined {
    return ret.through === undefined ? undefined : ret.calls.find(c => c.node === ret.through)
}

function outcomesOf(rets: RetEffect[], classes: Map<number, number>, masks: Map<number, number>, outcomeOf: (callee: number) => CallOutcomes | undefined): CallOutcomes {
    const out: CallOutcomes = { other: undefined, literals: new Map(), excluding: new Map() }
    function joined(known: [number, number] | undefined, effect: number, mask: number): [number, number] {
        return known ? [Math.max(known[0], effect), known[1] | mask] : [effect, mask]
    }
    function add(value: number | undefined, effect: number, mask: number, excludes?: number): void {
        if (effect < EffectWrite) mask = 0
        if (value !== undefined) out.literals.set(value, joined(out.literals.get(value), effect, mask))
        else if (excludes !== undefined) out.excluding.set(excludes, joined(out.excluding.get(excludes), effect, mask))
        else out.other = joined(out.other, effect, mask)
    }
    for (const ret of rets) {
        const through = throughCall(ret)
        const inner = through ? outcomeOf(through.callee) : undefined
        let effect = ret.self
        let mask = ret.writes
        for (const call of ret.calls) {
            if (inner && call === through) continue
            const c = classes.get(call.callee)
            effect = Math.max(effect, c ?? EffectWrite)
            if (c === undefined || c === EffectWrite) mask |= calleeWrites(c === undefined ? undefined : masks.get(call.callee), call.args)
        }
        if (!through || !inner) {
            add(ret.value, effect, mask, ret.excludes)
            continue
        }
        for (const [value, [e, m]] of inner.literals) {
            if (value !== ret.excludes) add(value, Math.max(effect, e), mask | calleeWrites(m, through.args))
        }
        for (const [excluded, [e, m]] of inner.excluding) add(undefined, Math.max(effect, e), mask | calleeWrites(m, through.args), excluded)
        if (inner.other) add(undefined, Math.max(effect, inner.other[0]), mask | calleeWrites(inner.other[1], through.args), ret.excludes)
    }
    return out
}

function noteEffect(graph: Graph, mem: MemAnalysis, id: number, n: GraphNode, out: RetEffect): void {
    if (n.op === NodeOp.store) {
        out.self = EffectWrite
        out.writes |= writeTarget(graph, mem.access(n))
    } else if (n.op === NodeOp.pstack) {
        out.self = EffectWrite
    } else if (n.op === NodeOp.load) {
        if (out.self < EffectRead) out.self = EffectRead
    } else if (n.op === NodeOp.call) {
        const callee = calledSymbol(graph, n)
        if (callee !== undefined) {
            const args: number[] = []
            for (let i = 3; i < countIds(n); i++) args.push(getRef(n, i) ? writeTarget(graph, mem.of(getRef(n, i))) : WritesUnknown)
            out.calls.push({ callee, args, node: id })
        } else {
            out.self = EffectWrite
            out.writes |= WritesUnknown
        }
    } else if (OrderedValues.has(n.op)) {
        const token = getRef(n, 0) ? getNode(graph, getRef(n, 0)) : undefined
        if (!token || token.op === NodeOp.nilEffect || token.op === NodeOp.void) return
        out.self = EffectWrite
        out.writes |= WritesUnknown
    }
}

function captureMask(effects: GraphEffects, captures: Map<number, number>): number {
    let mask = 0
    effects.params.forEach((flow, k) => {
        if (capturedBy(flow, captures)) mask |= argBit(k)
    })
    return mask
}

function deepCaptureMask(effects: GraphEffects, captures: Map<number, number>, deep: Map<number, number>): number {
    const through = (flow: Flow) => flow.calls.some(([callee, k]) => callee < 0 || hasArg(deep.get(callee) ?? CapturesAll, k))
    let mask = 0
    effects.params.forEach((flow, k) => {
        if (through(flow) || effects.loaded[k].some(inner => capturedBy(inner, captures) || through(inner))) mask |= argBit(k)
    })
    return mask
}

function mayHoldPointer(T: number): boolean {
    return T !== Types.u8 && T !== Types.u16 && T !== Types.i8 && T !== Types.i16 && T !== Types.bool && T !== Types.f16 && T !== Types.f32 && T !== Types.f64
}

function returnsFresh(effects: GraphEffects, captures: Map<number, number>): boolean {
    return effects.fresh && effects.returned.every(flow => !capturedBy(flow, captures))
}

function graphEffects(graph: Graph): GraphEffects {
    let fresh = true
    let returns = 0
    const returned: Flow[] = []
    const mem = memAnalysis(graph)
    const whole: RetEffect = { value: undefined, self: EffectNone, writes: 0, calls: [] }
    for (const [id, n] of graph.nodes) {
        noteEffect(graph, mem, id, n, whole)
        if (n.op !== NodeOp.ret) continue
        returns++
        const m = getRef(n, 0) ? mem.of(getRef(n, 0)) : undefined
        if (!m || m.kind !== MemFresh) fresh = false
        else returned.push(symbolFlow(graph, mem.flows(m.base, false)))
    }
    const params = graph.blocks[0].params.map(p => symbolFlow(graph, mem.flows(p, true)))
    const loadsFrom = new Map<number, number[]>()
    for (const [id, n] of graph.nodes) {
        if (n.op !== NodeOp.load || !getRef(n, 1) || !mayHoldPointer(typeOf(n))) continue
        const base = mem.of(getRef(n, 1)).base
        loadsFrom.set(base, [...loadsFrom.get(base) ?? [], id])
    }
    const loaded = graph.blocks[0].params.map(p => {
        const out: Flow[] = []
        const seen = new Set<number>([p])
        const roots = [p]
        while (roots.length) {
            for (const id of loadsFrom.get(roots.pop()!) ?? []) {
                if (seen.has(id)) continue
                seen.add(id)
                out.push(symbolFlow(graph, mem.flows(id, true)))
                roots.push(id)
            }
        }
        return out
    })
    const none: RetEffect = { value: undefined, self: EffectNone, writes: 0, calls: [] }
    function chain(roots: number[]): RetEffect {
        const out: RetEffect = { value: undefined, self: EffectNone, writes: 0, calls: [] }
        const seen = new Set<number>()
        const stack = roots.slice()
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = getNode(graph, id)
            if (!n || n.op === NodeOp.param || n.op === NodeOp.block) continue
            noteEffect(graph, mem, id, n, out)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return out
    }
    function join(a: RetEffect, b: RetEffect): RetEffect {
        const known = new Set(a.calls.map(c => c.node))
        return { value: undefined, self: Math.max(a.self, b.self), writes: a.writes | b.writes, calls: [...a.calls, ...b.calls.filter(c => !known.has(c.node))] }
    }
    function returning(effect: RetEffect, value: RetEffect): RetEffect {
        return { ...effect, value: value.value, excludes: value.excludes, through: value.through }
    }
    const positions = new Map<number, TailPosition[]>()
    for (const b of graph.blocks) positions.set(b.id, tailPositions(graph, b.bodyId))
    interface Arrival { from: number, apply: number, path: SelectPath, roots: number[] }
    const arrivals = new Map<number, Arrival[]>()
    for (const [from, list] of positions) {
        for (const p of list) {
            const n = getNode(graph, p.at)!
            if (n.op !== NodeOp.apply) continue
            const arrival = { from, apply: p.at, path: p.path, roots: tailRoots(graph, p) }
            const known = arrivals.get(getRef(n, 0))
            if (known) known.push(arrival)
            else arrivals.set(getRef(n, 0), [arrival])
        }
    }
    const entries = new Map<number, RetEffect>()
    const cyclic = new Set<number>()
    for (const scc of stronglyConnected(graph.blocks.map(b => b.id), id => (arrivals.get(id) ?? []).map(a => a.from))) {
        const members = new Set(scc)
        let out = none
        for (const id of scc) {
            for (const a of arrivals.get(id) ?? []) {
                out = join(out, chain(a.roots))
                if (members.has(a.from)) cyclic.add(id)
                else out = join(out, entries.get(a.from)!)
            }
        }
        for (const id of scc) entries.set(id, out)
    }
    const passed = new Map<number, RetEffect[][]>()
    function paramValues(block: number, k: number): RetEffect[] {
        let known = passed.get(block)
        if (!known) passed.set(block, known = [])
        if (known[k]) return known[k]
        const merged = new Map<string, RetEffect>()
        for (const a of arrivals.get(block)!) {
            for (const e of valueAt(a.from, a.path, getNode(graph, a.apply)!, k + 1, chain(a.roots))) {
                const key = `${e.value}|${e.excludes}|${e.through}`
                const prior = merged.get(key)
                merged.set(key, prior ? returning(join(prior, e), e) : e)
            }
        }
        return known[k] = [...merged.values()]
    }
    function valueAt(block: number, path: SelectPath, n: GraphNode, at: number, local: RetEffect): RetEffect[] {
        const literal = tailScalar(graph, n, at)
        const ref = literal === undefined ? tailOf(graph, getRef(n, at)) : 0
        const facts: ValueFacts = ref ? valueFacts(graph, path, ref) : {}
        const value = literal ?? facts.is
        const k = value === undefined ? getBlock(graph, block)!.params.indexOf(ref) : -1
        if (k >= 0 && !cyclic.has(block) && arrivals.has(block)) {
            return paramValues(block, k)
                .filter(e => e.value === undefined || e.value !== facts.not)
                .map(e => returning(join(local, e), e.value === undefined && e.excludes === undefined ? { ...e, excludes: facts.not } : e))
        }
        const before = join(local, entries.get(block)!)
        if (value !== undefined) return [returning(before, { ...none, value })]
        const call = getNode(graph, ref)?.op === NodeOp.call && !entries.get(block)!.calls.some(c => c.node === ref)
        return [returning(before, { ...none, excludes: facts.not, through: call ? ref : undefined })]
    }
    const rets: RetEffect[] = []
    for (const [id, list] of positions) {
        for (const p of list) {
            const n = getNode(graph, p.at)!
            if (n.op === NodeOp.ret) rets.push(...valueAt(id, p.path, n, 0, chain(tailRoots(graph, p))))
        }
    }
    return {
        self: whole.self, callees: whole.calls.map(c => c.callee), writes: whole.writes, calls: whole.calls,
        fresh: fresh && returns > 0, params, loaded, returned, rets,
    }
}

function refineCallEffects(graph: Graph, summaries: Map<number, CallSummary>): boolean {
    let refined = false
    for (const [id, n] of graph.nodes) {
        const symbol = localSymbol(graph, n)
        if (symbol === undefined) continue
        const slots = encodeCallSummary(symbol, summaries.get(symbol) ?? unknownCall)
        if (countIds(n) === slots.length && slots.every((x, i) => getLiteral(graph, n, i) === x)) continue
        putCopy(graph, id, n, slots.map(literal => ({ literal })))
        refined = true
    }
    return refined
}

function classifyEffects(units: Map<number, Graph>, tagged: Set<number>): Map<number, CallSummary> {
    const classes = new Map<number, number>()
    const masks = new Map<number, number>()
    const captures = new Map<number, number>()
    const deep = new Map<number, number>()
    const own = new Map<number, number>()
    const calls = new Map<number, CallWrites[]>()
    const callers = new Map<number, Set<number>>()
    const effectsOf = new Map<number, GraphEffects>()
    for (const [symbol, graph] of units) {
        const effects = graphEffects(graph)
        effectsOf.set(symbol, effects)
        classes.set(symbol, effects.self)
        own.set(symbol, effects.writes)
        masks.set(symbol, effects.writes)
        calls.set(symbol, effects.calls)
        captures.set(symbol, 0)
        deep.set(symbol, 0)
    }
    for (const [symbol, out] of calls) {
        for (const call of out) {
            let set = callers.get(call.callee)
            if (!set) callers.set(call.callee, set = new Set())
            set.add(symbol)
        }
    }
    const work = [...classes.keys()]
    while (work.length) {
        const symbol = work.pop()!
        let want = classes.get(symbol)!
        let mask = own.get(symbol)!
        for (const call of calls.get(symbol) ?? []) {
            const c = classes.get(call.callee)
            want = Math.max(want, c === undefined ? EffectWrite : c)
            if (c === undefined || c === EffectWrite) mask |= calleeWrites(c === undefined ? undefined : masks.get(call.callee), call.args)
        }
        const captured = captureMask(effectsOf.get(symbol)!, captures)
        const deepCaptured = deepCaptureMask(effectsOf.get(symbol)!, captures, deep)
        if (want === classes.get(symbol) && mask === masks.get(symbol) && captured === captures.get(symbol) && deepCaptured === deep.get(symbol)) continue
        classes.set(symbol, want)
        masks.set(symbol, mask)
        captures.set(symbol, captured)
        deep.set(symbol, deepCaptured)
        for (const caller of callers.get(symbol) ?? []) work.push(caller)
    }
    const outcomes = new Map<number, CallOutcomes>()
    function reaches(from: number, to: number): boolean {
        const seen = new Set<number>()
        const stack = [from]
        while (stack.length) {
            const symbol = stack.pop()!
            if (symbol === to) return true
            if (seen.has(symbol)) continue
            seen.add(symbol)
            for (const ret of effectsOf.get(symbol)?.rets ?? []) {
                const call = throughCall(ret)
                if (call) stack.push(call.callee)
            }
        }
        return false
    }
    function outcomeOf(symbol: number): CallOutcomes | undefined {
        const known = outcomes.get(symbol)
        if (known) return known
        const effects = effectsOf.get(symbol)
        if (!effects) return
        const result = outcomesOf(effects.rets, classes, masks, callee => reaches(callee, symbol) ? undefined : outcomeOf(callee))
        outcomes.set(symbol, result)
        return result
    }
    const out = new Map<number, CallSummary>()
    for (const [symbol, effects] of effectsOf) {
        const effect = classes.get(symbol)!
        out.set(symbol, {
            effect, writes: effect === EffectWrite ? masks.get(symbol)! : 0,
            fresh: returnsFresh(effects, captures), tagged: tagged.has(symbol),
            captures: captures.get(symbol)!, deepCaptures: deep.get(symbol)!, outcomes: outcomeOf(symbol),
        })
    }
    return out
}

rt.bind(rt.Op.handleof, { lower: (g, n) => makeNode(g, NodeOp.convert, [getOperand(g, n, 2)], Types.u32) })
rt.bind(rt.Op.heapaddr, { lower: (g, n, ctx) => makeNode(g, NodeOp.add, [getOperand(g, n, 2), { literal: ctx.runtimeHeapBase() }], Types.u64) })
rt.bind(rt.Op.pstackaddr, { lower: (g, n, ctx) => makeNode(g, NodeOp.decode, [getOperand(g, n, 2), { literal: ctx.pstackBase() }]) })
const typeofStrings = 1
const typeofObjects = 2

rt.bind(rt.Op.typeof, {
    lower: (g, n, ctx) => {
        const word = getOperand(g, n, 2)
        const tag = ctx.add(makeNode(g, NodeOp.and, [word, { literal: 1 }], Types.u64))
        const kinds = countIds(n) < 4 ? 0 : getLiteral(g, n, 3)
        if (!kinds) return makeNode(g, NodeOp.select, [tag, { literal: heap.typeNames.object }, { literal: heap.typeNames.number }])
        const boxed = ctx.add(makeNode(g, NodeOp.ge, [word, { literal: heap.pstackBoxWordTag }], Types.bool))
        if (kinds === typeofStrings) return makeNode(g, NodeOp.select, [tag, ctx.add(makeNode(g, NodeOp.select, [boxed, { literal: heap.typeNames.number }, { literal: heap.typeNames.string }])), { literal: heap.typeNames.number }])
        const handled = ctx.add(makeNode(g, NodeOp.select, [tag, ctx.add(makeNode(g, NodeOp.lt, [word, { literal: heap.pstackWordTag }], Types.bool)), { literal: 0 }]))
        const shifted = ctx.add(makeNode(g, NodeOp.convert, [ctx.add(makeNode(g, NodeOp.ushr, [word, { literal: 1 }], Types.u32))], Types.u64))
        const handle = ctx.add(makeNode(g, NodeOp.select, [handled, shifted, { literal: 0 }]))
        const cell = ctx.add(makeNode(g, NodeOp.add, [handle, { literal: ctx.runtimeHeapBase() }], Types.u64))
        const td = ctx.add(makeNode(g, NodeOp.load, [getOperand(g, n, 0), cell, { literal: 0 }], Types.u32))
        const [externalTD, internedTD] = heap.stringTypeDescriptors
        const external = ctx.add(makeNode(g, NodeOp.eq, [td, { literal: externalTD }], Types.bool))
        const string = ctx.add(makeNode(g, NodeOp.or, [external, ctx.add(makeNode(g, NodeOp.eq, [td, { literal: internedTD }], Types.bool))], Types.bool))
        const object = ctx.add(makeNode(g, NodeOp.and, [tag, ctx.add(makeNode(g, NodeOp.not, [boxed], Types.bool))], Types.bool))
        const named = ctx.add(makeNode(g, NodeOp.and, [handled, string], Types.bool))
        const kind = ctx.add(makeNode(g, NodeOp.select, [object, { literal: heap.typeNames.object }, { literal: heap.typeNames.number }]))
        return makeNode(g, NodeOp.select, [named, { literal: heap.typeNames.string }, kind])
    },
})

function putRuntimeCall(g: NodeSpace, id: number, target: number, n: GraphNode, symbol: number): void {
    putNode(g, target, NodeOp.localTarget, [{ literal: symbol }], Types.u32)
    setNode(g, id, rt.callOf(g, n, target))
}

function rewriteTargets(
    g: Graph,
    functionHandles: Map<number, number>,
    dataHandles: Map<number, number>,
    runtimeTargets: Map<number, number>,
    statics: Map<number, number>,
    staticBase: number,
): Graph {
    const out = withNodes(g, new Map())
    for (const [id, n] of g.nodes) {
        if (n.op === NodeOp.static) {
            const target = getNode(g, getRef(n, 0))
            const slot = target?.op === NodeOp.heapHandle && !getRef(target, 0) ? statics.get(heap.deref(getLiteral(out, target, 0) as intrinsics.Handle)) : undefined
            if (slot === undefined) throw `native: static %${id} in ${g.name ?? 'anonymous graph'} has no slot`
            const token = addNode(out, NodeOp.nilEffect, [])
            putNode(out, id, NodeOp.load, [token, { literal: staticBase }, { literal: slot * 8 }], Types.u64)
            continue
        }
        if (n.op === NodeOp.call) {
            const target = getNode(g, getRef(n, 1))
            const handle = target?.op === NodeOp.heapHandle ? heap.deref(getLiteral(out, target, 0) as intrinsics.Handle) : 0
            if (handle && !functionHandles.has(handle)) {
                console.log(dumpGraph(g))
                throw `native: ${g.name ?? 'anonymous graph'} calls heap handle ${handle} at %${id}, which has no native target`
            }
        }
        if (n.op === NodeOp.rt && runtimeTargets.has(getLiteral(out, n, 1))) {
            const target = newId(g)
            putRuntimeCall(out, id, target, n, runtimeTargets.get(getLiteral(out, n, 1))!)
            continue
        }
        if (n.op === NodeOp.rt) {
            const add = (node: GraphNode): number => {
                const fresh = newId(g)
                setNode(out, fresh, node)
                return fresh
            }
            const lowered = rt.lowerNative(out, n, { runtimeHeapBase, pstackBase: () => pstackCell(0) + 8, add })
            const token = getNode(g, getRef(n, 0))?.op
            if (token === undefined || token === NodeOp.nilEffect || token === NodeOp.void) {
                setNode(out, id, lowered)
                continue
            }
            putNode(out, id, NodeOp.after, [getRef(n, 0), add(lowered)], typeOf(lowered))
            continue
        }
        if (n.op !== NodeOp.heapHandle) {
            setNode(out, id, n)
            continue
        }
        const handle = heap.deref(getLiteral(out, n, 0) as intrinsics.Handle)
        if (!getRef(n, 0) && mirroredCells.has(handle)) {
            putNode(out, id, NodeOp.literal, [{ literal: handle }], Types.u32)
            continue
        }
        const functionSlot = functionHandles.get(handle)
        const slot = functionSlot ?? dataHandles.get(handle)
        if (getRef(n, 0) || slot === undefined) {
            throw `native: unresolved heap handle ${handle} in ${g.name ?? 'anonymous graph'} at %${id}`
        }
        putNode(out, id, NodeOp.poolEntry, [{ literal: slot }])
    }
    return out
}

function align(value: number, amount: number): number {
    return (value + amount - 1) & -amount
}

function patchImage(
    image: Uint8Array,
    base: number | bigint,
    units: NativeUnit[],
    offsets: number[],
    poolOffset: number,
    localPoolTargets: Map<number, number>,
    stringPoolTargets: Map<number, number>,
    dataOffset: number,
    dataRelocations: [at: number, target: number][],
): void {
    const view = new DataView(image.buffer, image.byteOffset, image.byteLength)
    const imageBase = BigInt(base)
    for (const [slot, symbol] of localPoolTargets) {
        const targetOffset = offsets[symbol]
        if (targetOffset === undefined) throw `native: unknown pooled local function ${symbol}`
        view.setBigUint64(poolOffset + slot * 8, imageBase + BigInt(targetOffset), true)
    }
    for (const [slot, at] of stringPoolTargets) {
        view.setBigUint64(poolOffset + slot * 8, imageBase + BigInt(dataOffset + at), true)
    }
    for (const [at, target] of dataRelocations) {
        view.setBigUint64(dataOffset + at, imageBase + BigInt(dataOffset + target), true)
    }
    for (let i = 0; i < units.length; i++) {
        const unit = units[i]
        for (const relocation of unit.code.relocations) {
            const offset = offsets[unit.symbol] + relocation.offset
            const pc = imageBase + BigInt(offset)
            if (relocation.kind === 'pool') {
                unit.code.target.relocate(view, offset, pc, relocation.kind, imageBase + BigInt(poolOffset + relocation.target * 8))
                continue
            }
            const targetOffset = offsets[relocation.target]
            if (targetOffset === undefined) throw `native: unknown local function ${relocation.target} called from ${unit.name}`
            unit.code.target.relocate(view, offset, pc, relocation.kind, imageBase + BigInt(targetOffset))
        }
    }
}

function installImage(
    units: NativeUnit[],
    values: (number | bigint)[],
    localPoolTargets: Map<number, number>,
    stringPoolTargets: Map<number, number>,
    stringBytes: Uint8Array,
    dataRelocations: [at: number, target: number][],
) {
    const offsets: number[] = []
    let length = 0
    for (const unit of units) {
        length = align(length + (unit.code.island?.length ?? 0) * 8, 16)
        offsets[unit.symbol] = length
        length += unit.code.bytes.length
    }
    const poolOffset = align(length, 8)
    length = poolOffset + values.length * 8
    const dataOffset = align(length, 8)
    length = dataOffset + stringBytes.length
    const image = new Uint8Array(length)
    for (const unit of units) image.set(unit.code.bytes, offsets[unit.symbol])
    image.set(stringBytes, dataOffset)
    const view = new DataView(image.buffer)
    for (let i = 0; i < values.length; i++) {
        view.setBigUint64(poolOffset + i * 8, BigInt.asUintN(64, BigInt(values[i])), true)
    }
    const reserved = reserveCode(image.byteLength)
    if (flags.has('native-map')) for (const unit of units) console.log(`native map 0x${(BigInt(reserved.ptr) + BigInt(offsets[unit.symbol])).toString(16)} +${unit.code.bytes.length} ${unit.name}`)
    patchImage(image, reserved.ptr, units, offsets, poolOffset, localPoolTargets,
        stringPoolTargets, dataOffset, dataRelocations)
    for (const unit of units) {
        const island = unit.code.island ?? []
        for (let i = 0; i < island.length; i++) {
            view.setBigUint64(offsets[unit.symbol] - (island.length - i) * 8, view.getBigUint64(poolOffset + island[i] * 8, true), true)
        }
    }
    if (flags.has('native-image-dump')) {
        let hex = ''
        for (let i = 0; i < image.length; i++) hex += (image[i] < 16 ? '0' : '') + image[i].toString(16)
        console.log(`native image ${hex}`)
        for (const unit of units) console.log(`native image-symbol ${unit.name} ${offsets[unit.symbol]}`)
    }
    const src = (ts as any).getArrayBufferPtr(image.buffer)
    if (!nativeCopier(reserved.ptr, src, image.byteLength)) throw 'failed to copy native image'
    const entries = offsets.map(offset => addPtr(reserved.ptr, offset))
    return {
        entries,
        page: reserved.page,
        image,
        poolOffset,
    }
}

interface PhaseClock {
    start: number
    phases: Record<string, number>
    enterPhase(next: string): string
    timed<T>(next: string, run: () => T, unit?: string): T
    normalize(graph: Graph, opts?: { firstPass?: boolean }): Graph
}

export interface CompileError extends Error {
    stage?: string
    unit?: string
    node?: number
}

function compileError(message: string, node: number): CompileError {
    const error: CompileError = new Error(message)
    error.node = node
    return error
}

function stagedError(e: unknown, stage: string, unit: string | undefined): CompileError {
    const error: CompileError = e instanceof Error ? e : new Error(String(e))
    error.stage ??= stage
    error.unit ??= unit
    return error
}

function createClock(target: Target): PhaseClock {
    const start = performance.now()
    const phases: Record<string, number> = { link: 0, bytecode: 0, typer: 0, trace: 0, analysis: 0, plan: 0, resolve: 0, normalize: 0, inline: 0, effects: 0, records: 0, lower: 0, statics: 0, other: 0 }
    let phase = 'other'
    let last = start
    function enterPhase(next: string): string {
        const now = performance.now()
        phases[phase] += now - last
        last = now
        const outer = phase
        phase = next
        return outer
    }
    function timed<T>(next: string, run: () => T, unit?: string): T {
        const outer = enterPhase(next)
        try {
            const result = run()
            enterPhase(outer)
            return result
        } catch (e) {
            throw stagedError(e, next, unit)
        }
    }
    function normalize(graph: Graph, opts?: { firstPass?: boolean }): Graph {
        if (flags.has('trace-stats')) normalizeStats.push([graph.name ?? '?', graph.nodes.size, !!opts?.firstPass])
        if (flags.has('norm-log')) console.log('NORM', graph.name ?? '?', graph.nodes.size, opts?.firstPass ? 'first' : 'again')
        verifyGraph(graph, 'normalize:input', graph.form !== undefined)
        recordSnapshots(graph)
        return timed('normalize', () => normalizeValueGraph(graph, { ...opts, target }), graph.name)
    }
    return { start, phases, enterPhase, timed, normalize }
}

function createImage() {
    const values: (number | bigint)[] = []
    const labels = new Map<number, string>()
    const bytes: number[] = []
    const byteTargets = new Map<number, number>()
    const functionTargets = new Map<number, number>()
    const relocations: [at: number, target: number][] = []
    const functionHandles = new Map<number, number>()
    const dataHandles = new Map<number, number>()
    const runtime = new Map<number, number>()
    const pooled = new Map<PoolValue, number>()
    const pointers = new Map<number, number>()
    const constants = new Map<number, number>()
    const final = new Map<number, number>()
    const strings = new Map<string, number>()
    const addressSlots = new Map<number, number>()
    const functions = new Map<number, number>()
    const statics = new Map<number, number>()
    const staticSymbols: number[] = []
    const staticBoxes = new Map<number, number>()
    const staticFields: [address: number, slot: number][] = []
    const staticRegions: [base: number, size: number][] = []
    const readonlyRegions: [base: number, size: number][] = []
    const staticTable = { base: 0 }
    const recordBits = new Map<intrinsics.Handle, propertyEval.RecordBits>()
    function valueSlot(value: PoolValue): number {
        const known = pooled.get(value)
        if (known !== undefined) return known
        const slot = values.length
        pooled.set(value, slot)
        values.push(value.value)
        labels.set(slot, `0x${value.value.toString(16)}`)
        return slot
    }
    function constantSlot(value: number): number {
        const known = constants.get(value)
        if (known !== undefined) return known
        const slot = values.length
        values.push(value)
        constants.set(value, slot)
        final.set(slot, value)
        labels.set(slot, `0x${value.toString(16)}`)
        return slot
    }
    const floatBits = new Map<bigint, number>()
    function floatSlot(value: number): number {
        const bits = new BigUint64Array(new Float64Array([value]).buffer)[0]
        const known = floatBits.get(bits)
        if (known !== undefined) return known
        const slot = values.length
        values.push(bits)
        floatBits.set(bits, slot)
        labels.set(slot, `${value}`)
        return slot
    }
    function pointerSlot(ptr: number, label?: string): number {
        const known = pointers.get(ptr)
        if (known !== undefined) return known
        const slot = values.length
        values.push(ptr)
        pointers.set(ptr, slot)
        final.set(slot, ptr)
        if (label) labels.set(slot, label)
        return slot
    }
    function stringSlot(text: string): number {
        const known = strings.get(text)
        if (known !== undefined) return known
        const at = bytes.length
        for (const byte of new TextEncoder().encode(text)) bytes.push(byte)
        bytes.push(0)
        const slot = values.length
        values.push(0)
        labels.set(slot, JSON.stringify(text.length > 24 ? `${text.slice(0, 24)}...` : text))
        strings.set(text, slot)
        byteTargets.set(slot, at)
        return slot
    }
    function addressSlot(handle: number, label: string, place: () => number): number {
        const known = addressSlots.get(handle)
        if (known !== undefined) return known
        const at = place()
        const slot = values.length
        values.push(at)
        final.set(slot, at)
        labels.set(slot, label)
        addressSlots.set(handle, slot)
        return slot
    }
    function constructionSlot(cell: number, graphOf: (cell: number) => Graph | undefined, readonly: (cell: number) => boolean, boxed: (cell: number) => Set<string> | undefined): number {
        return addressSlot(cell, `construction @${cell}`, () => placeConstruction(cell, graphOf, readonly, boxed))
    }
    function staticObjectSlot(handle: intrinsics.Handle): number {
        return addressSlot(handle, `static @${handle}`, () => placeObject(handle, () => undefined, why => { throw `native: static object @${handle} cannot be placed: ${why}` }))
    }
    function functionSlot(symbol: number, name: string): number {
        const known = functions.get(symbol)
        if (known !== undefined) return known
        const slot = values.length
        values.push(0)
        labels.set(slot, `fn ${name}`)
        functions.set(symbol, slot)
        functionTargets.set(slot, symbol)
        return slot
    }
    const placedConstructions = new Map<number, number>()
    const placingConstructions = new Set<number>()
    function placeConstruction(cell: number, graphOf: (cell: number) => Graph | undefined, readonly: (cell: number) => boolean, boxed: (cell: number) => Set<string> | undefined): number {
        const known = placedConstructions.get(cell)
        if (known !== undefined) return known
        const fail = (why: string): never => { throw `native: construction @${cell} cannot be placed in static memory: ${why}` }
        if (placingConstructions.has(cell)) fail('it contains itself')
        placingConstructions.add(cell)
        const graph = graphOf(cell) ?? fail('it has no construction graph')
        if (graph.blocks.length !== 1) fail(`its graph has ${graph.blocks.length} blocks`)
        function allocation(id: number): number {
            let n = getNode(graph, id)
            while (n?.op === NodeOp.after) {
                id = getRef(n, countIds(n) - 1)
                n = getNode(graph, id)
            }
            return n?.op === NodeOp.pstack ? id : 0
        }
        function construction(id: number): number | undefined {
            const n = getNode(graph, id)
            if (n?.op !== NodeOp.heapHandle || getRef(n, 0) || !graphOf(getLiteral(graph, n, 0))) return
            return placeConstruction(getLiteral(graph, n, 0), graphOf, readonly, boxed)
        }
        function constantString(id: number): number | undefined {
            const n = getNode(graph, id)
            if (n?.op !== NodeOp.heapHandle || getRef(n, 0) || !heap.isString(getLiteral(graph, n, 0) as intrinsics.Handle)) return
            mirrorCell(getLiteral(graph, n, 0))
            return getLiteral(graph, n, 0)
        }
        function staticObject(id: number): number | undefined {
            const n = getNode(graph, id)
            if (n?.op !== NodeOp.heapHandle || getRef(n, 0) || countIds(n) !== 1) return
            const handle = getLiteral(graph, n, 0) as intrinsics.Handle
            if (!handle || heap.isString(handle) || !heap.isOrdinaryObject(heap.deref(handle))) return
            return placeObject(handle, () => undefined, fail)
        }
        const boxedKeys = boxed(cell)
        const word = (n: GraphNode, offset: number, width: number) => typeOf(n) === Types.vm_value && !!boxedKeys && (boxedKeys.has(numberKey) || boxedKeys.has(`@${offset / width}`))
        const buffers = new Map<number, Uint8Array>()
        const addresses = new Map<number, number>()
        const stores: number[] = []
        for (const [id, n] of graph.nodes) {
            if (n.op === NodeOp.pstack) {
                if (getRef(n, 2) || getLiteral(graph, n, 2) || getRef(n, 3)) fail(`%${id} is not a fixed-size allocation`)
                buffers.set(id, new Uint8Array(getLiteral(graph, n, 3)))
                addresses.set(id, staticReserve(getLiteral(graph, n, 3)))
            } else if (n.op === NodeOp.store) stores.push(id)
            else if (n.op === NodeOp.call || n.op === NodeOp.load || n.op === NodeOp.setProp || n.op === NodeOp.getProp) fail(`it performs ${opName(n.op)} %${id}`)
        }
        for (const id of stores.sort((a, b) => a - b)) {
            const n = getNode(graph, id)!
            const buffer = allocation(getRef(n, 1))
            if (!buffer || getRef(n, 2)) fail(`store %${id} has no fixed address`)
            const width = intrinsics.intrinsicBitWidth(typeOf(n)) / 8
            const offset = getLiteral(graph, n, 2)
            const view = new DataView(buffers.get(buffer)!.buffer)
            if (getRef(n, 3)) {
                const target = allocation(getRef(n, 3))
                const nested = target ? undefined : construction(getRef(n, 3))
                const text = target || nested !== undefined ? undefined : constantString(getRef(n, 3))
                const object = target || nested !== undefined || text !== undefined ? undefined : staticObject(getRef(n, 3))
                if (target && width === 8) view.setBigUint64(offset, BigInt(addresses.get(target)!), true)
                else if (nested !== undefined && width === 4) view.setUint32(offset, staticWord(nested), true)
                else if (nested !== undefined && width === 8) view.setBigUint64(offset, BigInt(nested), true)
                else if (text !== undefined && width === 8) view.setBigUint64(offset, BigInt(text), true)
                else if (text !== undefined && width === 4) view.setUint32(offset, word(n, offset, width) ? tagVmHandle(text as intrinsics.Handle) : text, true)
                else if (object !== undefined && width === 4) view.setUint32(offset, staticWord(object), true)
                else if (object !== undefined && width === 8) view.setBigUint64(offset, BigInt(object), true)
                else fail(`store %${id} writes a value that is neither an allocation, a construction nor a constant string`)
                continue
            }
            const value = getLiteral(graph, n, 3)
            if (typeOf(n) === Types.f64) view.setFloat64(offset, value, true)
            else if (!Number.isInteger(value) && typeOf(n) === Types.vm_value) view.setUint32(offset, staticBox(value), true)
            else if (!Number.isInteger(value)) fail(`store %${id} writes ${value}, which is not an integer`)
            else if (word(n, offset, width)) view.setUint32(offset, Number(BigInt.asUintN(32, BigInt(value) * BigInt(2))), true)
            else for (let i = 0; i < width; i++) view.setUint8(offset + i, Number(BigInt.asUintN(8, BigInt(value) >> BigInt(i * 8))))
        }
        for (const [id, bytes] of buffers) staticWrite(addresses.get(id)!, bytes)
        const at = placeObject(cell as intrinsics.Handle, id => {
            const allocated = allocation(id)
            return allocated ? addresses.get(allocated) : undefined
        }, fail)
        for (const [id, bytes] of buffers) staticRegions.push([addresses.get(id)!, bytes.length])
        if (readonly(cell)) readonlyRegions.push([at, propertyEval.recordLayout(heap.deref(cell as intrinsics.Handle), undefined, recordBits).size])
        placingConstructions.delete(cell)
        placedConstructions.set(cell, at)
        return at
    }
    const placedObjects = new Map<number, number>()
    function placeObject(handle: intrinsics.Handle, allocated: (id: number) => number | undefined, fail: (why: string) => never): number {
        const target = heap.deref(handle)
        const known = placedObjects.get(target)
        if (known !== undefined) return known
        const fields = propertyEval.recordLayout(target, undefined, recordBits)
        const keys = fields.keys
        const bytes = new Uint8Array(fields.size)
        const at = staticReserve(bytes.length)
        placedObjects.set(target, at)
        const view = new DataView(bytes.buffer)
        function setBit(bit: propertyEval.BitSlot): void {
            const byte = bit.offset + (bit.shared ? bit.bit >> 3 : 0)
            view.setUint8(byte, view.getUint8(byte) | (1 << (bit.shared ? bit.bit & 7 : 0)))
        }
        for (let i = 0; i < keys.length; i++) {
            const slot = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, keys[i]))).slot0 as intrinsics.Handle
            const offset = fields.offsets[i]
            const flag = fields.flags[i]
            const tag = fields.tags[i]
            const held = staticBoxes.get(slot)
            if (held !== undefined) {
                staticFields.push([at + offset, held])
                if (tag) setBit(tag)
            } else if (heap.isBoxedF64(slot)) {
                const raw = heap.unboxF64(slot)
                const id = intrinsics.getNanId(raw)
                if (flag && !id && (raw === 0 || raw === 1)) {
                    if (raw) setBit(flag)
                    continue
                }
                if (id) view.setBigUint64(offset, BigInt(allocated(id) ?? fail(`field ${heap.stringToJs(keys[i])} holds %${id}, which is not an allocation`)), true)
                else if (Number.isInteger(raw)) view.setBigUint64(offset, BigInt.asUintN(64, BigInt(raw)), true)
                else fail(`field ${heap.stringToJs(keys[i])} holds ${raw}, which is not an integer`)
                if (tag) setBit(tag)
            } else if (!slot && tag) {
                continue
            } else if (slot && heap.isOrdinaryObject(heap.deref(slot))) {
                view.setBigUint64(offset, BigInt(placeObject(slot, allocated, fail)), true)
            } else fail(`field ${heap.stringToJs(keys[i])} holds an unsupported value`)
        }
        staticWrite(at, bytes)
        staticRegions.push([at, bytes.length])
        return at
    }
    return {
        values, labels, bytes, byteTargets, functionTargets, relocations, functionHandles, dataHandles, runtime, statics, staticSymbols, staticBoxes, staticFields, staticRegions, readonlyRegions, staticTable, recordBits,
        valueSlot, pointerSlot, stringSlot, constructionSlot, staticObjectSlot, functionSlot, constantSlot, floatSlot,
        knownValue: (slot: number) => final.get(slot),
    }
}

type ProgramImage = ReturnType<typeof createImage>

interface ProgramGraph {
    units: Map<number, Graph>
    roots: Map<string, number>
    noInline: Set<number>
    alwaysInline: Set<number>
    constructors: Set<number>
    unplanned: Set<number>
    tagged: Set<number>
    abi: Map<number, string>
    image: ProgramImage
    target: Target
}

function programCallSites(program: ProgramGraph): Map<number, [caller: number, call: number][]> {
    const sites = new Map<number, [number, number][]>()
    for (const [caller, graph] of program.units) {
        for (const [id, n] of graph.nodes) {
            const symbol = calledSymbol(graph, n)
            if (symbol === undefined) continue
            const list = sites.get(symbol)
            if (list) list.push([caller, id])
            else sites.set(symbol, [[caller, id]])
        }
    }
    return sites
}

function countCallSites(program: ProgramGraph): Map<number, number> {
    const counts = new Map<number, number>()
    for (const [symbol, sites] of programCallSites(program)) counts.set(symbol, sites.length)
    return counts
}

function pinnedSymbols(program: ProgramGraph): Set<number> {
    const pinned = new Set<number>([...program.roots.values(), ...program.image.runtime.values()])
    const referenced: number[] = []
    let invoked = false
    for (const graph of program.units.values()) {
        for (const n of graph.nodes.values()) {
            const target = n.op === NodeOp.call ? getNode(graph, getRef(n, 1))?.op : undefined
            if (n.op === NodeOp.rt || (target !== undefined && target !== NodeOp.localTarget && target !== NodeOp.syscallTarget)) invoked = true
            if ((n.op !== NodeOp.heapHandle && n.op !== NodeOp.poolEntry) || getRef(n, 0)) continue
            const slot = n.op === NodeOp.poolEntry ? getLiteral(graph, n, 0) : program.image.functionHandles.get(heap.deref(getLiteral(graph, n, 0) as intrinsics.Handle))
            const symbol = slot === undefined ? undefined : program.image.functionTargets.get(slot)
            if (symbol !== undefined) referenced.push(symbol)
        }
    }
    if (invoked) for (const symbol of referenced) pinned.add(symbol)
    return pinned
}

function appendParam(program: ProgramGraph, callee: number, type: TypeOperand, sites: [caller: number, call: number][], argOf: (site: number) => Operand): number {
    const graph = program.units.get(callee)!
    const id = addNode(graph, NodeOp.param, [], type)
    graph.blocks[0].params.push(id)
    const location = paramLocation(getNode(graph, id)!)
    sites.forEach(([symbol, call], k) => {
        const caller = program.units.get(symbol)!
        const n = getNode(caller, call)!
        const locations = callLocations(caller, call)
        putCopy(caller, call, n, [...getOperands(caller, n), argOf(k)])
        if (!locations && location < 0) return
        setCallLocations(caller, call, [...locations ?? new Array(countIds(n) - 3).fill(-1), location])
    })
    return id
}

function callLocations(graph: Graph, call: number): number[] | undefined {
    const n = getNode(graph, call)!
    const signature = getNode(graph, typeRefOf(getNode(graph, getRef(n, 1))!))
    if (signature?.op !== NodeOp.fnType) return
    const locations = fnLocations(signature)
    while (locations.length < countIds(n) - 3) locations.push(-1)
    return locations
}

function setCallLocations(graph: Graph, call: number, locations: number[], returnLocation?: number): void {
    const target = getRef(getNode(graph, call)!, 1)
    const n = getNode(graph, target)!
    const signature = getNode(graph, typeRefOf(n))
    const fnType = insertNode(graph, createFnType(graph, signature?.op === NodeOp.fnType ? fnReturn(signature) : typeOf(n), locations, returnLocation ?? (signature?.op === NodeOp.fnType ? fnReturnLocation(signature) : -1)))
    retypeNode(graph, target, { ref: fnType })
}

function freeCallees(program: ProgramGraph, sites: Map<number, [caller: number, call: number][]>): number[] {
    const pinned = pinnedSymbols(program)
    const callees = new Map<number, number[]>()
    for (const [symbol, graph] of program.units) {
        const out: number[] = []
        for (const n of graph.nodes.values()) {
            const called = calledSymbol(graph, n)
            if (called !== undefined) out.push(called)
            for (let i = 0; i < countIds(n); i++) {
                const local = localSymbol(graph, getNode(graph, getRef(n, i)))
                if (local !== undefined && !(n.op === NodeOp.call && i === 1)) pinned.add(local)
            }
        }
        callees.set(symbol, out)
    }
    const free: number[] = []
    for (const [symbol, out] of callees) {
        for (const c of out) {
            // XXX: an opaque callee is left to inline into a caller that knows its shapes; when no caller does, it never gets a unit.
            if (!program.units.has(c)) throw `native: ${program.units.get(symbol)!.name} calls symbol ${c}, which is opaque and was never inlined`
        }
    }
    for (const scc of stronglyConnected(program.units.keys(), symbol => callees.get(symbol)!)) {
        const symbol = scc[0]
        const calls = sites.get(symbol)
        if (scc.length !== 1 || pinned.has(symbol) || !calls || calls.some(([caller]) => caller === symbol)) continue
        const params = program.units.get(symbol)!.blocks[0].params.length
        if (calls.some(([caller, call]) => countIds(getNode(program.units.get(caller)!, call)!) - 3 !== params)) continue
        free.push(symbol)
    }
    return free
}

function valuesFrom(graph: Graph, root: number, conditional: boolean): Set<number> {
    const found = new Set<number>()
    const stack = [root]
    while (stack.length) {
        const id = stack.pop()!
        const n = id ? getNode(graph, id) : undefined
        if (!n || found.has(id) || n.op === NodeOp.block) continue
        found.add(id)
        const refs = n.op === NodeOp.select && !conditional ? 1 : countIds(n)
        for (let i = 0; i < refs; i++) stack.push(getRef(n, i))
    }
    return found
}

function specializeUnit(program: ProgramGraph, symbol: number, calls: [caller: number, call: number][], touched: Set<number>): number {
    const specialized = Math.max(...program.units.keys(), ...program.image.functionTargets.values()) + 1
    program.units.set(specialized, snapshotGraph(program.units.get(symbol)!))
    program.abi.set(specialized, program.abi.get(symbol) ?? '')
    for (const set of [program.noInline, program.alwaysInline, program.constructors, program.unplanned, program.tagged]) {
        if (set.has(symbol)) set.add(specialized)
    }
    for (const [caller, call] of calls) {
        const graph = program.units.get(caller)!
        const site = getNode(graph, call)!
        const target = getNode(graph, getRef(site, 1))!
        const local = addCopy(graph, target, [{ literal: specialized }, ...getOperands(graph, target).slice(1)])
        putCopy(graph, call, site, withOperand(graph, site, 1, local))
        touched.add(caller)
    }
    return specialized
}

function expandParams(program: ProgramGraph, touched: Set<number>): void {
    const sites = programCallSites(program)
    const hoisted: string[] = []
    const mems = new Map<number, MemAnalysis>()
    function memOf(symbol: number): MemAnalysis {
        let mem = mems.get(symbol)
        if (!mem) mems.set(symbol, mem = memAnalysis(program.units.get(symbol)!))
        return mem
    }
    function fresh(symbol: number, arg: number): boolean {
        return !!arg && memOf(symbol).of(arg).kind === MemFresh
    }
    function contextOf(symbol: number): number {
        const graph = program.units.get(symbol)!
        return graph.blocks[0].params.findIndex(p => paramLocation(getNode(graph, p)!) === program.target.indirectContextReg)
    }
    function onlyContext(symbol: number, context: number, caller: number, call: number): boolean {
        const graph = program.units.get(caller)!
        if (countIds(getNode(graph, call)!) - 3 !== program.units.get(symbol)!.blocks[0].params.length) return false
        return privateArgument(graph, memOf(caller), call, symbol, context)
    }
    const free = new Set(freeCallees(program, sites))
    const callees = [...free]
    for (const [symbol, calls] of sites) {
        if (free.has(symbol) || program.noInline.has(symbol) || calls.some(([caller]) => caller === symbol)) continue
        const context = contextOf(symbol)
        if (context >= 0 && calls.every(([caller, call]) => onlyContext(symbol, context, caller, call))) callees.push(symbol)
    }
    for (const candidate of callees) {
        const calls = sites.get(candidate)!
        const graph = program.units.get(candidate)!
        const entry = graph.blocks[0]
        const demanded = valuesFrom(graph, graph.blocks[0].bodyId, false)
        const users = nodeUsers(graph, valuesFrom(graph, graph.blocks[0].bodyId, true))
        function entryToken(id: number): boolean {
            const n = getNode(graph, id)
            return n?.op === NodeOp.nilEffect && (countLiterals(n) === 0 || getRef(n, 0) === entry.id)
        }
        function hoistable(load: GraphNode): boolean {
            for (let i = 2; i < countIds(load); i++) if (getRef(load, i)) return false
            return entryToken(getRef(load, 0))
        }
        function cover(id: number, loads: number[]): boolean {
            for (const user of users.get(id) ?? []) {
                const n = getNode(graph, user)!
                let slots = 0
                for (let i = 0; i < countIds(n); i++) if (getRef(n, i) === id) slots++
                if (slots !== 1) return false
                if (n.op === NodeOp.load && getRef(n, 1) === id && demanded.has(user) && hoistable(n)) {
                    const inner: number[] = []
                    const leaves = users.has(user) && cover(user, inner) ? inner : [user]
                    for (const leaf of leaves) if (!loads.includes(leaf)) loads.push(leaf)
                } else if ((n.op === NodeOp.decode || n.op === NodeOp.add) && getRef(n, 0) === id && !getRef(n, 1)) {
                    if (!cover(user, loads)) return false
                } else return false
            }
            return true
        }
        let headroom = program.target.argRegs.length - entry.params.filter(p => paramLocation(getNode(graph, p)!) < 0).length
        const chosen: number[] = []
        entry.params.forEach((p, i) => {
            if (!calls.every(([symbol, call]) => fresh(symbol, getRef(getNode(program.units.get(symbol)!, call)!, 3 + i)))) return
            const loads: number[] = []
            if (!users.has(p) || !cover(p, loads)) return
            const cost = paramLocation(getNode(graph, p)!) < 0 ? loads.length - 1 : loads.length
            if (cost > headroom) return
            headroom -= cost
            chosen.push(...loads)
        })
        if (!chosen.length) continue
        const callee = free.has(candidate) ? candidate : specializeUnit(program, candidate, calls, touched)
        const unit = program.units.get(callee)!
        const params = entry.params.slice()
        const copies = calls.map(() => new Map<number, Operand>())
        const by = new Map<number, Operand>()
        for (const load of chosen) {
            const param = appendParam(program, callee, resultType(graph, getNode(graph, load)!), calls, k => {
                const [symbol, call] = calls[k]
                const caller = program.units.get(symbol)!
                const site = getNode(caller, call)!
                function copy(id: number): Operand {
                    const known = copies[k].get(id)
                    if (known !== undefined) return known
                    const n = getNode(graph, id)!
                    if (n.op === NodeOp.param) return getOperand(caller, site, 3 + params.indexOf(id))
                    if (n.op === NodeOp.nilEffect) return getOperand(caller, site, 0)
                    const operands = getOperands(caller, n)
                    for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) operands[i] = copy(getRef(n, i))
                    const out = addCopy(caller, n, operands)
                    copies[k].set(id, out)
                    return out
                }
                return copy(load)
            })
            by.set(load, param)
        }
        const hoistedAt = new Map<string, number>()
        for (const load of chosen) {
            const n = getNode(graph, load)!
            const param = by.get(load)
            if (typeof param === 'number' && getRef(n, 1) && !getRef(n, 2)) hoistedAt.set(`${getRef(n, 1)}:${getLiteral(graph, n, 2)}`, param)
        }
        rewriteFactNodes(unit, f => f.op === NodeOp.load && getRef(f, 1) && !getRef(f, 2) ? hoistedAt.get(`${getRef(f, 1)}:${getLiteral(unit, f, 2)}`) : undefined)
        substitute(unit, by)
        hoisted.push(`${unit.name}:${chosen.length}`)
        touched.add(callee)
        for (const [caller] of calls) touched.add(caller)
    }
    if (flags.has('hoist-stats')) console.log('HOISTED', hoisted.join(' '))
}

const StateFieldTypes = new Set([Types.u8, Types.i8, Types.u16, Types.i16, Types.u32, Types.i32, Types.u64, Types.i64, Types.vm_value])

function privateArgument(graph: Graph, mem: MemAnalysis, call: number, callee: number, index: number): boolean {
    const arg = getRef(getNode(graph, call)!, 3 + index)
    if (!arg) return false
    const value = mem.of(arg)
    if (value.kind !== MemFresh || value.pos !== 0 || value.pending) return false
    const flow = mem.flows(value.base, true)
    return !flow.own && flow.calls.every(([site, at]) => at === index && calledSymbol(graph, getNode(graph, site)!) === callee)
}

function stateFields(graph: Graph, mem: MemAnalysis, users: Map<number, [user: number, slot: number][]>, arrivals: Arrivals, param: number): [offset: number, type: intrinsics.Types][] | undefined {
    const fields = new Map<number, intrinsics.Types>()
    const aliases = new Set<number>([param])
    const work = [param]
    while (work.length) {
        const ptr = work.pop()!
        for (const [user, slot] of users.get(ptr) ?? []) {
            const n = getNode(graph, user)!
            if (slot < firstNonOrderingSlot(n)) continue
            if ((n.op === NodeOp.load || n.op === NodeOp.store) && slot === 1 && !getRef(n, 2)) {
                const at = mem.of(ptr).pos
                if (at === undefined) return
                const offset = at + getLiteral(graph, n, 2)
                const T = typeOf(n)
                if (offset < 0 || !StateFieldTypes.has(T)) return
                if (fields.has(offset) && fields.get(offset) !== T) return
                fields.set(offset, T)
                continue
            }
            let alias: number | undefined
            if (n.op === NodeOp.after && slot === countIds(n) - 1) alias = user
            if (n.op === NodeOp.add && !getRef(n, 1 - slot)) alias = user
            if (n.op === NodeOp.apply && slot > 0) alias = getBlock(graph, getRef(n, 0))?.params[slot - 1]
            if (alias === undefined) return
            const m = mem.of(alias)
            if (m.pending || m.base !== param || m.pos === undefined) return
            if (getNode(graph, alias)!.op === NodeOp.param && (arrivals.get(alias) ?? []).some(a => !a || mem.of(a).base !== param)) return
            if (aliases.has(alias)) continue
            aliases.add(alias)
            work.push(alias)
        }
    }
    const layout = [...fields].sort((a, b) => a[0] - b[0])
    for (let i = 1; i < layout.length; i++) {
        if (layout[i - 1][0] + intrinsics.intrinsicBitWidth(layout[i - 1][1]) / 8 > layout[i][0]) return
    }
    return layout
}

function scalarizeMutableState(program: ProgramGraph, touched: Set<number>): Set<number> {
    const sites = programCallSites(program)
    const mems = new Map<number, MemAnalysis>()
    function memOf(symbol: number): MemAnalysis {
        let mem = mems.get(symbol)
        if (!mem) mems.set(symbol, mem = memAnalysis(program.units.get(symbol)!))
        return mem
    }
    const promoted: string[] = []
    const changed = new Set<number>()
    for (const callee of freeCallees(program, sites)) {
        const graph = program.units.get(callee)!
        const entry = graph.blocks[0]
        if (isJumbo(graph) || !entry.params.length) continue
        const stores: GraphNode[] = []
        for (const n of graph.nodes.values()) {
            if (n.op === NodeOp.store && getRef(n, 1)) stores.push(n)
        }
        if (!stores.length) continue
        const mem = memOf(callee)
        const written = new Map<number, Set<number>>()
        for (const n of stores) {
            const at = mem.of(getRef(n, 1))
            if (!entry.params.includes(at.base) || at.pos === undefined) continue
            let offsets = written.get(at.base)
            if (!offsets) written.set(at.base, offsets = new Set())
            offsets.add(at.pos + getLiteral(graph, n, 2))
        }
        if (!written.size) continue
        const returns = ownRets(graph)
        if (!returns.length || returnsFloat(graph)) continue
        const tails = returns.map(id => getNode(graph, tailOf(graph, getRef(getNode(graph, id)!, 0))))
        if (tails.some(n => n && (typeRefOf(n) || n.op === NodeOp.record))) continue
        const hasResult = tails.some(n => n?.op !== NodeOp.void)
        const calls = sites.get(callee)!
        const users = nodeUsers(graph, graph.nodes.keys(), true)
        const arrivals = paramArrivals(graph)
        const ordinary = entry.params.filter(p => paramLocation(getNode(graph, p)!) < 0).length
        let index = -1
        let layout: [offset: number, type: intrinsics.Types][] = []
        for (let i = 0; i < entry.params.length && index < 0; i++) {
            const param = entry.params[i]
            const offsets = written.get(param)
            if (!offsets) continue
            const fields = stateFields(graph, mem, users, arrivals, param)
            if (!fields) continue
            // XXX: three or more fields are not pareto: Array push/reserve/setIndex states save holePushed −14 but cost arrayTwoKinds +8, restSpread +7
            if (fields.length > 2) continue
            const freed = paramLocation(getNode(graph, param)!) < 0 ? 1 : 0
            if (ordinary - freed + fields.length > program.target.argRegs.length) continue
            if (offsets.size + (hasResult ? 1 : 0) > program.target.retRegs.length) continue
            if (!calls.every(([symbol, call]) => privateArgument(program.units.get(symbol)!, memOf(symbol), call, callee, i))) continue
            index = i
            layout = fields
        }
        if (index < 0) continue
        const param = entry.params[index]
        const outputs = layout.filter(([offset]) => written.get(param)!.has(offset))
        const own = new Set(returns)
        const nil = addNode(graph, NodeOp.nilEffect, [entry.id])
        const size = Math.max(...layout.map(([offset, T]) => offset + intrinsics.intrinsicBitWidth(T) / 8))
        const cell = addNode(graph, NodeOp.pstack, [nil, 0, 0, { literal: size }])
        let initialized = cell
        const inputs: number[] = []
        for (const [offset, T] of layout) {
            const p = addNode(graph, NodeOp.param, [], T)
            initialized = addNode(graph, NodeOp.store, [initialized, cell, { literal: offset }, p], T)
            inputs.push(p)
        }
        const state = addNode(graph, NodeOp.after, [initialized, cell])
        substitute(graph, new Map<number, Operand>([[param, state]]))
        entry.params = [...entry.params.filter(p => p !== param), ...inputs]
        for (const b of graph.blocks) {
            b.bodyId = mapTailPositions(graph, b.bodyId, p => {
                if (!own.has(p.at)) return p.at
                const ret = getNode(graph, p.at)!
                const value = getOperand(graph, ret, 0)
                const token = addNode(graph, NodeOp.after, [addNode(graph, NodeOp.nilEffect, [b.id]), ...p.tokens, value])
                const record: Operand[] = hasResult ? [{ literal: 0 }, value] : []
                for (const [offset, T] of outputs) record.push({ literal: record.length / 2 }, addNode(graph, NodeOp.load, [token, state, { literal: offset }], T))
                return addCopy(graph, ret, [addNode(graph, NodeOp.record, record), ...getOperands(graph, ret).slice(1)])
            })
        }
        touched.add(callee)
        changed.add(callee)
        mems.delete(callee)
        for (const [symbol, call] of calls) {
            const caller = program.units.get(symbol)!
            const n = getNode(caller, call)!
            const args = getOperands(caller, n)
            const base = args[3 + index]
            const token = addNode(caller, NodeOp.after, [args[0], ...args.slice(2)])
            const loads = layout.map(([offset, T]) => addNode(caller, NodeOp.load, [token, base, { literal: offset }], T))
            const invoke = addCopy(caller, n, [addNode(caller, NodeOp.after, [token, ...loads]), args[1], args[2], ...args.slice(3).filter((_, i) => i !== index), ...loads])
            const locations = callLocations(caller, call)
            if (locations) setCallLocations(caller, invoke, [...locations.filter((_, i) => i !== index), ...loads.map(() => -1)])
            let updated = invoke
            outputs.forEach(([offset, T], i) => {
                const value = addNode(caller, NodeOp.get, [invoke, { literal: i + (hasResult ? 1 : 0) }])
                updated = addNode(caller, NodeOp.store, [updated, base, { literal: offset }, value], T)
            })
            const result = hasResult ? addNode(caller, NodeOp.get, [invoke, { literal: 0 }]) : addNode(caller, NodeOp.void, [])
            putNode(caller, call, NodeOp.after, [updated, result])
            touched.add(symbol)
            mems.delete(symbol)
        }
        promoted.push(`${graph.name}:${layout.map(([offset]) => offset).join('/')}`)
    }
    if (flags.has('hoist-stats')) console.log('STATE', promoted.join(' '))
    return changed
}

function returnedParam(graph: Graph): number {
    const returns = ownRets(graph)
    if (!returns.length) return -1
    const param = tailOf(graph, getRef(getNode(graph, returns[0])!, 0))
    for (const id of returns) {
        if (tailOf(graph, getRef(getNode(graph, id)!, 0)) !== param) return -1
    }
    return graph.blocks[0].params.indexOf(param)
}

function forwardReturnedArgs(program: ProgramGraph, touched: Set<number>): void {
    const forwarding = new Map<number, number>()
    for (const [symbol, graph] of program.units) {
        const index = returnedParam(graph)
        if (index >= 0) forwarding.set(symbol, index)
    }
    if (!forwarding.size) return
    const sites = programCallSites(program)
    for (const symbol of freeCallees(program, sites)) {
        const index = forwarding.get(symbol)
        if (index === undefined) continue
        for (const [caller, call] of sites.get(symbol)!) {
            const graph = program.units.get(caller)!
            const n = getNode(graph, call)!
            const arg = getOperand(graph, n, 3 + index)
            const token = addNode(graph, NodeOp.after, [getOperand(graph, n, 0), arg])
            const invoke = addCopy(graph, n, withOperand(graph, n, 0, token))
            putCopy(graph, call, n, [invoke, arg], NodeOp.after)
            touched.add(caller)
        }
        const graph = program.units.get(symbol)!
        function discard(id: number): number {
            const n = getNode(graph, id)!
            if (n.op !== NodeOp.after) return addNode(graph, NodeOp.void, [])
            return addCopy(graph, n, [...getOperands(graph, n).slice(0, -1), discard(getRef(n, countIds(n) - 1))])
        }
        for (const id of ownRets(graph)) {
            const n = getNode(graph, id)!
            putCopy(graph, id, n, [discard(getRef(n, 0)), ...getOperands(graph, n).slice(1)])
        }
        touched.add(symbol)
    }
}

const SharedOps = new Set([
    NodeOp.add, NodeOp.sub, NodeOp.mul, NodeOp.div, NodeOp.rem, NodeOp.pow, NodeOp.or, NodeOp.and, NodeOp.xor, NodeOp.shl, NodeOp.shr, NodeOp.ushr, NodeOp.subsat,
    NodeOp.lt, NodeOp.le, NodeOp.gt, NodeOp.ge, NodeOp.eq, NodeOp.ne, NodeOp.neg, NodeOp.not, NodeOp.convert, NodeOp.bitconvert, NodeOp.encode, NodeOp.decode, NodeOp.box, NodeOp.unbox, NodeOp.get, NodeOp.load, NodeOp.call,
])
const SharedLeaves = new Set([NodeOp.literal, NodeOp.localTarget, NodeOp.heapHandle, NodeOp.poolEntry, NodeOp.nilEffect, NodeOp.fnType])
const SymmetricOps = new Set([NodeOp.add, NodeOp.mul, NodeOp.and, NodeOp.or, NodeOp.xor, NodeOp.ne, NodeOp.eq])
const ShareThreshold = 2

function readnoneCall(graph: Graph, n: GraphNode): boolean {
    return callSummary(graph, n)?.effect === EffectNone
}

function structuralKeys(graph: Graph, table: Map<string, number>, leaves: Map<number, string>): (operand: Operand) => string {
    const memo = new Map<number, string>()
    function intern(text: string): string {
        let id = table.get(text)
        if (id === undefined) table.set(text, id = table.size)
        return `v${id}`
    }
    function part(operand: Operand): string {
        if (typeof operand !== 'number') return `#${operand.literal}`
        const leaf = leaves.get(operand)
        if (leaf !== undefined) return leaf
        const known = memo.get(operand)
        if (known !== undefined) return known
        const n = getNode(graph, operand)!
        const structural = SharedLeaves.has(n.op) || (SharedOps.has(n.op) && (n.op !== NodeOp.call || readnoneCall(graph, n)))
        if (!structural) {
            const unique = intern(`!${table.size}`)
            memo.set(operand, unique)
            return unique
        }
        const parts = getOperands(graph, n).map((o, i) => n.op === NodeOp.call && i === 0 ? 'nil' : n.op === NodeOp.nilEffect ? '' : part(o))
        if (SymmetricOps.has(n.op) && parts.length === 2 && parts[0] > parts[1]) parts.reverse()
        const type = !typeSlots(n.op) ? '' : typeRefOf(n) ? `:${part(typeRefOf(n))}` : `:${typeOf(n)}`
        const key = intern(`${opName(n.op)}${n.flags & ~NodeFlags.guarded ? '!' + (n.flags & ~NodeFlags.guarded) : ''}(${parts.join(',')})${type}`)
        memo.set(operand, key)
        return key
    }
    return part
}

function shareCallerValues(program: ProgramGraph, touched: Set<number>): void {
    const sites = programCallSites(program)
    const shared: string[] = []
    const blockSets = new Map<number, { all: Set<number>, unconditional: Set<number> }[]>()
    function blocksOf(symbol: number) {
        let sets = blockSets.get(symbol)
        if (sets) return sets
        const graph = program.units.get(symbol)!
        sets = graph.blocks.map(b => ({ all: valuesFrom(graph, b.bodyId, true), unconditional: valuesFrom(graph, b.bodyId, false) }))
        blockSets.set(symbol, sets)
        return sets
    }
    function sizeOf(symbol: number): number {
        const graph = program.units.get(symbol)
        return graph ? inlineCost(graph) ?? 50 : 50
    }
    for (const callee of freeCallees(program, sites)) {
        const calls = sites.get(callee)!
        const graph = program.units.get(callee)!
        const entry = graph.blocks[0]
        const values = valuesFrom(graph, entry.bodyId, true)
        const table = new Map<string, number>()
        let candidates = [...values].filter(id => {
            const n = getNode(graph, id)!
            return SharedOps.has(n.op) && (n.op !== NodeOp.call || readnoneCall(graph, n))
        })
        const twinsAt: Map<number, number>[] = []
        for (const [symbol, call] of calls) {
            if (!candidates.length) break
            const caller = program.units.get(symbol)!
            const site = getNode(caller, call)!
            const block = blocksOf(symbol).find(b => b.all.has(call))!
            const available = new Set([...block.unconditional, ...valuesFrom(caller, call, true)])
            const callerKey = structuralKeys(caller, table, new Map())
            const byKey = new Map<string, number>()
            for (const id of available) {
                const n = getNode(caller, id)
                if (n && SharedOps.has(n.op)) byKey.set(callerKey(id), id)
            }
            const leaves = new Map<number, string>()
            entry.params.forEach((p, i) => leaves.set(p, callerKey(getOperand(caller, site, 3 + i))))
            for (const id of values) if (getNode(graph, id)!.op === NodeOp.nilEffect) leaves.set(id, callerKey(getOperand(caller, site, 0)))
            const calleeKey = structuralKeys(graph, table, leaves)
            const found = new Map<number, number>()
            candidates = candidates.filter(id => {
                const twin = byKey.get(calleeKey(id))
                if (twin !== undefined) found.set(id, twin)
                return twin !== undefined
            })
            twinsAt.push(found)
        }
        if (!candidates.length) continue
        const users = nodeUsers(graph, values)
        function saving(v: number): { dead: Set<number>, cost: number } {
            const dead = new Set<number>([v])
            const stack = [v]
            let cost = 0
            while (stack.length) {
                const x = stack.pop()!
                const n = getNode(graph, x)!
                cost += n.op === NodeOp.call ? 2 + sizeOf(getLiteral(graph, getNode(graph, getRef(n, 1))!, 0)) : SharedOps.has(n.op) ? 1 : 0
                for (let i = 0; i < countIds(n); i++) {
                    const r = getRef(n, i)
                    if (!r || dead.has(r) || !values.has(r) || !(users.get(r) ?? []).every(u => dead.has(u))) continue
                    dead.add(r)
                    stack.push(r)
                }
            }
            return { dead, cost }
        }
        const scored = candidates.map(v => ({ v, ...saving(v) })).sort((a, b) => b.cost - a.cost)
        let headroom = program.target.argRegs.length - entry.params.filter(p => paramLocation(getNode(graph, p)!) < 0).length
        const taken = new Set<number>()
        const by = new Map<number, Operand>()
        for (const { v, dead, cost } of scored) {
            if (headroom <= 0) break
            if (cost < ShareThreshold || taken.has(v)) continue
            for (const d of dead) taken.add(d)
            headroom--
            const n = getNode(graph, v)!
            const param = appendParam(program, callee, typeRefOf(n) ? { ref: typeRefOf(n) } : resultType(graph, n), calls, k => twinsAt[k].get(v)!)
            by.set(v, param)
            shared.push(`${graph.name}:%${v}=${cost}`)
        }
        if (!by.size) continue
        substitute(graph, by)
        touched.add(callee)
    }
    if (flags.has('hoist-stats')) console.log('SHARED', shared.join(' '))
}

function specializeLiteralArgs(program: ProgramGraph, touched: Set<number>): void {
    const sites = programCallSites(program)
    const limit = program.target.costs.inlineLiteral
    for (const symbol of freeCallees(program, sites)) {
        const graph = program.units.get(symbol)!
        const calls = sites.get(symbol)!
        const by = new Map<number, Operand>()
        graph.blocks[0].params.forEach((param, index) => {
            const values = calls.map(([caller, call]) => {
                const g = program.units.get(caller)!
                const n = getNode(g, call)!
                return 3 + index < countIds(n) ? tailScalar(g, n, 3 + index) : undefined
            })
            const value = values[0]
            if (value === undefined || !values.every(v => Object.is(v, value))) return
            if (!Number.isSafeInteger(value) || value <= -limit || value >= limit) return
            by.set(param, { literal: value })
        })
        if (!by.size) continue
        const params = new Map([...by.keys()].map(id => [id, getNode(graph, id)!]))
        substitute(graph, by)
        for (const [id, node] of params) setNode(graph, id, node)
        touched.add(symbol)
    }
}

function dropArgBits(mask: number, dead: Set<number>): number {
    let out = mask & WritesUnknown
    for (const k of maskArgs(mask)) {
        if (dead.has(k)) continue
        let below = 0
        for (const d of dead) {
            if (d < k) below++
        }
        out |= argBit(k - below)
    }
    return out
}

function dropOutcomeArgs(table: Map<number, [effect: number, mask: number]>, dead: Set<number>): Map<number, [effect: number, mask: number]> {
    const out = new Map<number, [effect: number, mask: number]>()
    for (const [value, [effect, mask]] of table) out.set(value, [effect, dropArgBits(mask, dead)])
    return out
}

function dropSummaryArgs(graph: Graph, call: GraphNode, dead: Set<number>): void {
    const target = getRef(call, 1)
    const n = getNode(graph, target)!
    if (countIds(n) === 1) return
    const s = callSummary(graph, call)!
    let outcomes: CallOutcomes | undefined
    if (s.outcomes) {
        const other = s.outcomes.other
        outcomes = { literals: dropOutcomeArgs(s.outcomes.literals, dead), excluding: dropOutcomeArgs(s.outcomes.excluding, dead), other: other ? [other[0], dropArgBits(other[1], dead)] : undefined }
    }
    const summary: CallSummary = { ...s, writes: dropArgBits(s.writes, dead), captures: dropArgBits(s.captures, dead), deepCaptures: dropArgBits(s.deepCaptures, dead), outcomes }
    const slots = encodeCallSummary(getLiteral(graph, n, 0), summary)
    putCopy(graph, target, n, slots.map(literal => ({ literal })))
}

function pruneDeadArgs(program: ProgramGraph, touched: Set<number>): void {
    const sites = programCallSites(program)
    const pruned: string[] = []
    for (const callee of freeCallees(program, sites)) {
        const calls = sites.get(callee)!
        const graph = program.units.get(callee)!
        const entry = graph.blocks[0]
        const live = valuesFrom(graph, graph.blocks[0].bodyId, true)
        const used = new Set<number>()
        for (const id of live) {
            const n = getNode(graph, id)!
            for (let i = 0; i < countIds(n); i++) used.add(getRef(n, i))
        }
        const preceding = calls.map(([symbol, call]) => {
            const caller = program.units.get(symbol)!
            return valuesFrom(caller, getRef(getNode(caller, call)!, 0), true)
        })
        const dead = new Set<number>()
        entry.params.forEach((p, i) => {
            if (used.has(p)) return
            const lifted = calls.some(([symbol, call], k) => {
                const caller = program.units.get(symbol)!
                const arg = getRef(getNode(caller, call)!, 3 + i)
                return !!arg && OrderedValues.has(getNode(caller, arg)!.op) && !preceding[k].has(arg)
            })
            if (!lifted) dead.add(i)
        })
        if (!dead.size) continue
        entry.params = entry.params.filter((_, i) => !dead.has(i))
        const summarized = new Set<string>()
        for (const [symbol, call] of calls) {
            const caller = program.units.get(symbol)!
            const n = getNode(caller, call)!
            const target = getRef(n, 1)
            if (!summarized.has(`${symbol}:${target}`)) {
                summarized.add(`${symbol}:${target}`)
                dropSummaryArgs(caller, n, dead)
            }
            const locations = callLocations(caller, call)
            putCopy(caller, call, n, getOperands(caller, n).filter((_, i) => i < 3 || !dead.has(i - 3)))
            if (locations) setCallLocations(caller, call, locations.filter((_, i) => !dead.has(i)))
        }
        pruned.push(`${graph.name}:${dead.size}`)
        touched.add(callee)
        for (const [caller] of calls) touched.add(caller)
    }
    if (flags.has('hoist-stats')) console.log('PRUNED', pruned.join(' '))
}

function snapshotGraph(graph: Graph): Graph {
    const out = withNodes(graph, new Map())
    for (const [id, n] of graph.nodes) putCopy(out, id, n)
    return out
}

function reachable(graph: Graph): GraphNode[] {
    const seen = new Set<number>()
    const found: GraphNode[] = []
    for (const b of graph.blocks) {
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(graph, id) : undefined
            if (!n || seen.has(id) || n.op === NodeOp.block) continue
            seen.add(id)
            found.push(n)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    return found
}
function splice(graph: Graph, call: number, callee: Graph): void {
    const n = getNode(graph, call)!
    const args = new Map<number, number>()
    callee.blocks[0].params.forEach((p, i) => {
        let arg = getRef(n, 3 + i)
        if (3 + i >= countIds(n)) {
            arg = addNode(graph, NodeOp.heapHandle, [{ literal: 0 }], Types.unknown_number)
        } else if (!arg) {
            arg = addNode(graph, NodeOp.literal, [{ literal: getLiteral(graph, n, 3 + i) }])
        }
        args.set(p, arg)
    })
    const blocks = new Map<number, number>()
    for (const b of callee.blocks.slice(1)) {
        const id = addNode(graph, NodeOp.block, [])
        blocks.set(b.id, id)
    }
    function copier(entry: boolean): (id: number) => number {
        const copies = new Map<number, number>(entry ? args : [])
        function copy(id: number): number {
            const known = copies.get(id) ?? blocks.get(id)
            if (known !== undefined) return known
            const m = getNode(callee, id)!
            let fresh = entry && m.op === NodeOp.nilEffect && !getRef(m, 0) ? getRef(n, 0) : 0
            if (!fresh) {
                fresh = newId(graph)
                const copied = copyNode(graph, m, getOperands(graph, m).map(x => typeof x === 'number' ? copy(x) : x))
                if (typeRefOf(m)) setType(copied, { ref: copy(typeRefOf(m)) })
                setNode(graph, fresh, factOf(m) && callee.facts?.has(factOf(m)) ? withFact(copied, importFact(graph, callee, factOf(m), copy)) : withFact(copied, 0))
            }
            copies.set(id, fresh)
            return fresh
        }
        return copy
    }
    const traced = callee.form === undefined ? copier(true) : undefined
    for (const b of callee.blocks.slice(1)) {
        const copy = traced ?? copier(false)
        addGraphBlock(graph, { ...b, id: blocks.get(b.id)!, params: b.params.map(copy), bodyId: copy(b.bodyId) })
    }
    let body = (traced ?? copier(true))(callee.blocks[0].bodyId)
    const token = getRef(n, 0)
    if (token) {
        const ordered = addNode(graph, NodeOp.after, [token, body])
        body = ordered
    }
    putNode(graph, call, NodeOp.inlined, [body, { literal: call }])
}
function budgetedLoops(program: ProgramGraph, levels: Map<number, number>, share: number): Set<number> {
    const pieces: { symbol: number, loop: boolean, size: number }[] = []
    let total = 0
    for (const [symbol, graph] of program.units) {
        if (!levels.has(symbol)) continue
        const { loopDepth } = graphLoops(graph)
        let looped = 0
        let rest = 0
        for (const b of graph.blocks) {
            const seen = new Set<number>()
            const stack = [b.bodyId]
            while (stack.length) {
                const id = stack.pop()!
                const n = id ? getNode(graph, id) : undefined
                if (!n || seen.has(id) || n.op === NodeOp.block) continue
                seen.add(id)
                for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
            }
            if (loopDepth.get(b.id)) looped += seen.size
            else rest += seen.size
        }
        total += looped + rest
        if (looped) pieces.push({ symbol, loop: true, size: looped })
        if (rest) pieces.push({ symbol, loop: false, size: rest })
    }
    pieces.sort((a, b) => levels.get(b.symbol)! - levels.get(a.symbol)! || a.size - b.size)
    const hot = new Set<number>()
    let used = 0
    for (const piece of pieces) {
        if (used + piece.size > total * share) continue
        used += piece.size
        if (piece.loop) hot.add(piece.symbol)
    }
    return hot
}

function unswitchHot(program: ProgramGraph, levels: Map<number, number>, clock: PhaseClock): void {
    for (const symbol of budgetedLoops(program, levels, 0.2)) {
        const graph = program.units.get(symbol)!
        graph.unswitch = 400
        program.units.set(symbol, clock.timed('normalize', () => optimizePackaged(graph, program.target), graph.name))
        graph.unswitch = undefined
    }
}

function literalParams(source: Graph, call: GraphNode, callee: Graph): Set<number> {
    const out = new Set<number>()
    callee.blocks[0].params.forEach((p, k) => {
        const ref = getRef(call, 3 + k)
        if (3 + k < countIds(call) && (!ref || getNode(source, ref)?.op === NodeOp.literal)) out.add(p)
    })
    return out
}
function calledSymbol(source: Graph, n: GraphNode): number | undefined {
    if (n.op !== NodeOp.call) return
    return localSymbol(source, getNode(source, getRef(n, 1)))
}
const allocators = new WeakMap<Graph, boolean>()
function returnsAllocation(g: Graph): boolean {
    const known = allocators.get(g)
    if (known !== undefined) return known
    const mem = memAnalysis(g)
    let fresh = false
    for (const n of g.nodes.values()) {
        if (n.op !== NodeOp.ret) continue
        const m = getRef(n, 0) ? mem.of(getRef(n, 0)) : undefined
        fresh = !!m && m.kind === MemFresh && !m.pending
        if (!fresh) break
    }
    allocators.set(g, fresh)
    return fresh
}
function inlineAllocations(program: ProgramGraph, symbol: number, clock: PhaseClock): void {
    const source = program.units.get(symbol)!
    let mem: MemAnalysis | undefined
    const graph = inlineSites(program, symbol, source.nodes.keys(), (id, callee) => {
        const target = program.units.get(callee)!
        if (isJumbo(target) || !returnsAllocation(target)) return false
        const cost = inlineCost(target, literalParams(source, getNode(source, id)!, target))
        if (cost === undefined || cost > 16) return false
        const flow = (mem ??= memAnalysis(source)).flows(id, true)
        return !flow.own && (!flow.calls.length || flags.has("ia-calls"))
    })
    if (graph) program.units.set(symbol, repackage(graph, source, clock, program.target))
}
function inlineSites(program: ProgramGraph, symbol: number, sites: Iterable<number>, accept: (id: number, callee: number) => boolean): Graph | undefined {
    const source = program.units.get(symbol)!
    let graph: Graph | undefined
    for (const id of sites) {
        const callee = calledSymbol(source, getNode(source, id)!)
        if (callee === undefined || !program.units.has(callee) || callee === symbol || program.noInline.has(callee) || !accept(id, callee)) continue
        graph ??= snapshotGraph(source)
        splice(graph, id, program.units.get(callee)!)
    }
    return graph
}
function canInline(graph: Graph): boolean {
    return !isJumbo(graph) && !reachable(graph).some(n => n.op === NodeOp.alloca || n.op === NodeOp.frameAddress)
}

function worthInlining(program: ProgramGraph, callSites: Map<number, number>, caller: Graph, id: number, symbol: number, heat = 0): boolean {
    const callee = program.units.get(symbol)!
    if (program.alwaysInline.has(symbol)) return true
    if (program.constructors.has(symbol)) return true
    const roots = program.roots
    const cost = inlineCost(callee, literalParams(caller, getNode(caller, id)!, callee))
    const neutral = cost !== undefined && cost <= 8
    const sole = callSites.get(symbol) === 1 && ![...roots.values()].includes(symbol)
    const growth = cost !== undefined && cost <= 8 + callee.blocks[0].params.length && heat >= 6
    if (!neutral && !sole && !growth) {
        if (flags.has('inline-debug')) console.log('NO-INLINE', caller.name, '<-', callee.name, `%${id}`, cost === undefined ? 'uncosted' : `cost ${cost}`, `sites ${callSites.get(symbol)}`)
        return false
    }
    if (flags.has('inline-debug')) console.log('INLINE', caller.name, '<-', callee.name, `%${id}`, neutral ? cost : sole ? 'sole' : `growth ${cost} heat ${heat}`)
    return true
}

function siteTarget(program: ProgramGraph, graph: Graph, n: GraphNode): number | undefined {
    if (n.op === NodeOp.call) return calledSymbol(graph, n)
    if (n.op === NodeOp.rt) return program.image.runtime.get(getLiteral(graph, n, 1))
    if (n.op !== NodeOp.heapHandle || getRef(n, 0)) return
    const slot = program.image.functionHandles.get(heap.deref(getLiteral(graph, n, 0) as intrinsics.Handle))
    return slot === undefined ? undefined : program.image.functionTargets.get(slot)
}

function programLevels(program: ProgramGraph): Map<number, number> {
    const incoming = new Map<number, [caller: number, depth: number][]>()
    const callees = new Map<number, number[]>()
    for (const [symbol, graph] of program.units) {
        const out: number[] = []
        callees.set(symbol, out)
        for (const [id, depth] of siteDepths(graph)) {
            const callee = siteTarget(program, graph, getNode(graph, id)!)
            if (callee === undefined || !program.units.has(callee)) continue
            out.push(callee)
            if (!incoming.has(callee)) incoming.set(callee, [])
            incoming.get(callee)!.push([symbol, depth])
        }
    }
    const levels = new Map<number, number>()
    for (const scc of stronglyConnected(program.units.keys(), symbol => callees.get(symbol)!).reverse()) {
        const members = new Set(scc)
        let level = 0
        for (const symbol of scc) {
            if (![...program.units.get(symbol)!.nodes.values()].some(n => n.op === NodeOp.ret)) continue
            for (const [caller, depth] of incoming.get(symbol) ?? []) if (!members.has(caller)) level = Math.max(level, levels.get(caller)! + depth)
        }
        for (const symbol of scc) levels.set(symbol, level)
    }
    if (flags.has('native-levels')) {
        console.log('native levels', [...levels].sort((a, b) => b[1] - a[1]).map(([symbol, level]) => `${program.units.get(symbol)!.name}=${level}`).join(' '))
    }
    return levels
}

type Arrivals = Map<number, number[]>

function ownRets(graph: Graph): number[] {
    const rets: number[] = []
    const entered = new Set<number>([graph.root])
    const work = [graph.root]
    while (work.length) {
        const tails = [getBlock(graph, work.pop()!)!.bodyId]
        while (tails.length) {
            const id = tails.pop()!
            const n = id ? getNode(graph, id) : undefined
            if (!n) continue
            if (n.op === NodeOp.ret) rets.push(id)
            else if (n.op === NodeOp.after) tails.push(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) tails.push(getRef(n, i))
            else if (n.op === NodeOp.apply && !entered.has(getRef(n, 0))) {
                entered.add(getRef(n, 0))
                work.push(getRef(n, 0))
            }
        }
    }
    return rets
}

function paramArrivals(graph: Graph): Arrivals {
    const arrivals: Arrivals = new Map()
    for (const n of graph.nodes.values()) {
        if (n.op !== NodeOp.apply) continue
        const block = getBlock(graph, getRef(n, 0))
        if (!block) continue
        for (let at = 0; at < block.params.length; at++) {
            const list = arrivals.get(block.params[at])
            if (list) list.push(getRef(n, at + 1))
            else arrivals.set(block.params[at], [getRef(n, at + 1)])
        }
    }
    return arrivals
}

function repackage(graph: Graph, original: Graph, clock: PhaseClock, target: Target): Graph {
    return clock.timed('normalize', () => {
        const entries = new Set(original.blocks.map(b => b.id))
        recordSnapshots(graph)
        anchorBlockNils(graph)
        graph.form = undefined
        graph = packageValueGraph(graph, target, entries)
        resolveNumberTypes(graph)
        return isJumbo(graph) ? graph : optimizePackaged(graph, target)
    }, graph.name)
}

function renormalize(graph: Graph, clock: PhaseClock): Graph {
    anchorBlockNils(graph)
    graph.form = undefined
    return clock.normalize(graph)
}

function anchorBlockNils(graph: Graph): void {
    for (const b of graph.blocks.slice(1)) anchorBlockNil(graph, b)
}

function anchorBlockNil(graph: Graph, b: GraphBlock): void {
    const nil = addNode(graph, NodeOp.nilEffect, [b.id])
    const memo = new Map<number, number>()
    function rewrite(id: number): number {
        if (!id) return id
        const known = memo.get(id)
        if (known !== undefined) return known
        const n = getNode(graph, id)
        if (!n || n.op === NodeOp.block || n.op === NodeOp.param) return id
        if (n.op === NodeOp.nilEffect && !countLiterals(n)) return nil
        memo.set(id, id)
        let ops: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            const ref = rewrite(getRef(n, i))
            if (ref === getRef(n, i)) continue
            ops ??= getOperands(graph, n)
            ops[i] = ref
        }
        if (!ops) return id
        const fresh = addCopy(graph, n, ops)
        memo.set(id, fresh)
        return fresh
    }
    b.bodyId = rewrite(b.bodyId)
}

function siteDepths(graph: Graph): Map<number, number> {
    const { loopDepth } = graphLoops(graph)
    const exits = new Map<number, number>()
    function exitDepth(id: number): number {
        const tail = tailOf(graph, id)
        const known = exits.get(tail)
        if (known !== undefined) return known
        const n = getNode(graph, tail)
        let depth = 0
        if (n?.op === NodeOp.apply) depth = loopDepth.get(getRef(n, 0)) ?? 0
        else if (n?.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) depth = Math.max(depth, exitDepth(getRef(n, i)))
        exits.set(tail, depth)
        return depth
    }
    const depths = new Map<number, number>()
    const stack: [id: number, depth: number, tail: boolean][] = []
    for (const b of graph.blocks) stack.push([b.bodyId, loopDepth.get(b.id) ?? 0, true])
    while (stack.length) {
        const [id, depth, tail] = stack.pop()!
        const n = id ? getNode(graph, id) : undefined
        if (!n || n.op === NodeOp.block || (depths.get(id) ?? -1) >= depth) continue
        depths.set(id, depth)
        const last = countIds(n) - 1
        for (let i = 0; i <= last; i++) {
            const ref = getRef(n, i)
            if (tail && n.op === NodeOp.after && i === last) stack.push([ref, depth, true])
            else if (tail && n.op === NodeOp.select && i > 0) stack.push([ref, Math.min(depth, exitDepth(ref)), true])
            else stack.push([ref, depth, false])
        }
    }
    return depths
}

function inlineProgram(program: ProgramGraph, clock: PhaseClock): void {
    for (const graph of program.units.values()) {
        sweepBlocks(graph)
        for (const [id, n] of [...graph.nodes]) {
            const symbol = n.op === NodeOp.rt ? program.image.runtime.get(getLiteral(graph, n, 1)) : undefined
            if (symbol === undefined) continue
            const target = newId(graph)
            putRuntimeCall(graph, id, target, n, symbol)
        }
    }
    const callSites = countCallSites(program)
    const levels = programLevels(program)
    const inlineable = new Map<number, boolean>()
    function visit(symbol: number): void {
        if (inlineable.has(symbol)) return
        inlineable.set(symbol, false)
        const source = program.units.get(symbol)!
        let depths: Map<number, number> | undefined
        const graph = inlineSites(program, symbol, source.nodes.keys(), (id, callee) => {
            visit(callee)
            if (!inlineable.get(callee)) return false
            depths ??= siteDepths(source)
            return worthInlining(program, callSites, source, id, callee, (levels.get(symbol) ?? 0) + (depths.get(id) ?? 0))
        })
        if (graph) program.units.set(symbol, repackage(graph, source, clock, program.target))
        inlineAllocations(program, symbol, clock)
        inlineable.set(symbol, canInline(program.units.get(symbol)!))
    }
    for (const symbol of program.units.keys()) visit(symbol)
}

function inlineSpecialized(program: ProgramGraph, touched: Set<number>, clock: PhaseClock): void {
    const candidates = [...touched].filter(symbol => {
        const graph = program.units.get(symbol)
        if (!graph || program.noInline.has(symbol)) return false
        const cost = inlineCost(graph)
        return cost !== undefined && cost <= 8 + graph.blocks[0].params.length && canInline(graph)
    })
    if (!candidates.length) return
    const sites = programCallSites(program)
    const callSites = new Map([...sites].map(([symbol, list]) => [symbol, list.length]))
    const levels = programLevels(program)
    const byCaller = new Map<number, number[]>()
    for (const symbol of candidates) {
        for (const [caller, call] of sites.get(symbol) ?? []) {
            if (caller === symbol) continue
            const calls = byCaller.get(caller)
            if (calls) calls.push(call)
            else byCaller.set(caller, [call])
        }
    }
    for (const [symbol, calls] of byCaller) {
        const source = program.units.get(symbol)!
        const depths = siteDepths(source)
        const graph = inlineSites(program, symbol, calls, (id, callee) => worthInlining(program, callSites, source, id, callee, (levels.get(symbol) ?? 0) + (depths.get(id) ?? 0)))
        if (graph) program.units.set(symbol, repackage(graph, source, clock, program.target))
    }
}

function prune(program: ProgramGraph): void {
    const reached = reachUnits(program)
    for (const symbol of [...program.units.keys()]) if (!reached.has(symbol)) program.units.delete(symbol)
}

function refineProgramEffects(program: ProgramGraph, refined: Set<number>): void {
    const summaries = classifyEffects(program.units, program.tagged)
    if (flags.has('native-effects')) {
        const counts = [0, 0, 0]
        let argOnly = 0
        for (const [symbol, s] of summaries) {
            counts[s.effect]++
            if (s.effect === EffectWrite && s.writes & WritesUnknown) continue
            if (s.effect === EffectWrite) argOnly++
            const params = maskArgs(s.writes)
            const kept = maskArgs(s.captures)
            const outcomes = s.outcomes
            const cases = outcomes ? [...outcomes.literals].map(([v, [e]]) => ` ${v}:${EffectNames[e]}`).join('')
                + [...outcomes.excluding].map(([v, [e]]) => ` !=${v}:${EffectNames[e]}`).join('')
                + (outcomes.other ? ` other:${EffectNames[outcomes.other[0]]}` : '') : ''
            const what = (s.effect === EffectWrite ? `writes p${params.join(',p') || ' none'}` : EffectNames[s.effect]) + (cases ? ` returns${cases}` : '')
                + (s.fresh ? ' returns fresh' : '')
                + (s.captures === CapturesAll ? '' : ` captures ${kept.length ? 'p' + kept.join(',p') : 'none'}`)
            console.log('native effects', what, program.units.get(symbol)?.name || `symbol ${symbol}`)
        }
        console.log('native effects writes-args-only', argOnly)
        console.log('native effects total', EffectNames.map((n, i) => `${n}=${counts[i]}`).join(' '))
    }
    for (const [symbol, graph] of program.units) {
        if (refineCallEffects(graph, summaries)) refined.add(symbol)
    }
}

function reachUnits(program: ProgramGraph): Set<number> {
    const reached = new Set<number>()
    const reaching = [...program.roots.values()]
    while (reaching.length) {
        const symbol = reaching.pop()!
        if (reached.has(symbol)) continue
        reached.add(symbol)
        const graph = program.units.get(symbol)
        if (!graph) continue
        const seen = new Set<number>()
        const stack = graph.blocks.map(b => b.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(graph, id) : undefined
            if (!n || seen.has(id)) continue
            seen.add(id)
            if (n.op === NodeOp.block) {
                stack.push(getBlock(graph, id)?.bodyId ?? 0)
                continue
            }
            if (n.op === NodeOp.static) continue
            const local = localSymbol(graph, n)
            if (local !== undefined) reaching.push(local)
            if (n.op === NodeOp.rt && program.image.runtime.has(getLiteral(graph, n, 1))) reaching.push(program.image.runtime.get(getLiteral(graph, n, 1))!)
            if (n.op === NodeOp.heapHandle && !getRef(n, 0)) {
                const slot = program.image.functionHandles.get(heap.deref(getLiteral(graph, n, 0) as intrinsics.Handle))
                const target = slot === undefined ? undefined : program.image.functionTargets.get(slot)
                if (target !== undefined) reaching.push(target)
            }
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    return reached
}

function recordReturns(program: ProgramGraph, clock: PhaseClock): void {
    const callSites = countCallSites(program)
    interface Index {
        users: Map<number, [number, number][]>
        owner: Map<number, [block: number, index: number]>
        applies: Map<number, number[]>
        rets: number[]
        calls: Map<number, number[]>
    }
    interface Flow {
        source: Map<number, number>
        reads: Map<number, string>
        inner: Map<number, number>
        accesses: Map<string, intrinsics.Types>
        stores: Map<string, [store: number, value: number][]>
        exits: [user: number, slot: number][]
        accessed: Set<number>
        blocked?: string
    }
    const debug = flags.has('record-returns')
    const live = [...program.units.keys()]
    const pinned = pinnedSymbols(program)
    const ordered = new Set([NodeOp.load, NodeOp.store, NodeOp.call, NodeOp.pstack, NodeOp.alloca, NodeOp.rt])
    const indexes = new Map<number, Index>()
    function indexOf(symbol: number): Index {
        const known = indexes.get(symbol)
        if (known) return known
        const g = program.units.get(symbol)!
        const index: Index = { users: new Map(), owner: new Map(), applies: new Map(), rets: [], calls: new Map() }
        for (const b of g.blocks.slice(1)) b.params.forEach((p, i) => index.owner.set(p, [b.id, i]))
        const seen = new Set<number>()
        const stack = g.blocks.map(b => b.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(g, id) : undefined
            if (!n || seen.has(id) || n.op === NodeOp.block) continue
            seen.add(id)
            for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) stack.push(getRef(n, i))
            if (n.op === NodeOp.ret) index.rets.push(id)
            if (n.op === NodeOp.apply) {
                const list = index.applies.get(getRef(n, 0))
                if (list) list.push(id)
                else index.applies.set(getRef(n, 0), [id])
            }
            const callee = calledSymbol(g, n)
            if (callee !== undefined) {
                const list = index.calls.get(callee)
                if (list) list.push(id)
                else index.calls.set(callee, [id])
            }
        }
        index.users = nodeUsers(g, seen, true)
        indexes.set(symbol, index)
        return index
    }
    function allocation(g: NodeSpace, n: GraphNode | undefined) {
        return n?.op === NodeOp.pstack && !getRef(n, 2) && !getLiteral(g, n, 2) && (!!getRef(n, 3) || getLiteral(g, n, 3) > 0)
    }
    function returnedAllocations(symbol: number): number[] | undefined {
        const g = program.units.get(symbol)!
        const index = indexOf(symbol)
        if (!index.rets.length) return
        const out: number[] = []
        const seen = new Set<number>()
        const work = index.rets.map(ret => getRef(getNode(g, ret)!, 0))
        while (work.length) {
            const id = work.pop()!
            if (!id) return
            if (seen.has(id)) continue
            seen.add(id)
            const n = getNode(g, id)!
            if (allocation(g, n)) out.push(id)
            else if (n.op === NodeOp.after) work.push(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.encode) work.push(getRef(n, 0))
            else if (n.op === NodeOp.param && index.owner.has(id)) {
                const [block, at] = index.owner.get(id)!
                const arrivals = index.applies.get(block) ?? []
                if (!arrivals.length) return
                for (const app of arrivals) work.push(getRef(getNode(g, app)!, at + 1))
            } else return
        }
        return out
    }
    function pointerLoads(g: Graph, index: Index, root: number): [load: number, offset: number][] | undefined {
        const loads: [number, number][] = []
        const aliases = [root]
        const seen = new Set<number>(aliases)
        while (aliases.length) {
            const v = aliases.pop()!
            for (const [u, slot] of index.users.get(v) ?? []) {
                const n = getNode(g, u)!
                if (slot === 0 && ordered.has(n.op)) continue
                const next = (n.op === NodeOp.after && slot === countIds(n) - 1) || (n.op === NodeOp.decode && slot === 0)
                if (next) {
                    if (!seen.has(u)) aliases.push(u)
                    seen.add(u)
                    continue
                }
                if (n.op === NodeOp.load && slot === 1 && !getRef(n, 2)) {
                    loads.push([u, getLiteral(g, n, 2)])
                    continue
                }
                return
            }
        }
        return loads.length ? loads : undefined
    }
    function access(f: Flow, path: string, T: intrinsics.Types): void {
        const known = f.accesses.get(path)
        if (known !== undefined && known !== T) f.blocked = 'field-type'
        f.accesses.set(path, T)
    }
    function flow(symbol: number, roots: number[], callee: boolean, links?: Set<number>): Flow {
        const g = program.units.get(symbol)!
        const index = indexOf(symbol)
        const f: Flow = { source: new Map(), reads: new Map(), inner: new Map(), accesses: new Map(), stores: new Map(), exits: [], accessed: new Set() }
        const work: number[] = []
        function alias(id: number, source: number): void {
            if (f.source.has(id)) return
            f.source.set(id, source)
            work.push(id)
        }
        for (const root of roots) alias(root, root)
        while (work.length && !f.blocked) {
            const v = work.pop()!
            const source = f.source.get(v)!
            for (const [u, slot] of index.users.get(v) ?? []) {
                const n = getNode(g, u)!
                if (slot === 0 && ordered.has(n.op)) continue
                if (n.op === NodeOp.after) {
                    if (slot === countIds(n) - 1) alias(u, source)
                    continue
                }
                if ((n.op === NodeOp.load || (callee && n.op === NodeOp.store)) && slot === 1 && !getRef(n, 2)) {
                    const offset = getLiteral(g, n, 2)
                    f.accessed.add(source)
                    if (n.op === NodeOp.store) {
                        const key = `${source}/${offset}`
                        const list = f.stores.get(key)
                        if (list) list.push([u, getRef(n, 3)])
                        else f.stores.set(key, [[u, getRef(n, 3)]])
                    }
                    const loads = callee ? undefined : pointerLoads(g, index, u)
                    if (!loads) {
                        access(f, String(offset), typeOf(n))
                        if (!callee) f.reads.set(u, String(offset))
                        continue
                    }
                    for (const [load, at] of loads) {
                        access(f, `${offset}.${at}`, typeOf(getNode(g, load)!))
                        f.reads.set(load, `${offset}.${at}`)
                        f.inner.set(load, u)
                    }
                    continue
                }
                if (callee && n.op === NodeOp.store && slot === 3 && links?.has(u)) continue
                if (n.op === (callee ? NodeOp.encode : NodeOp.decode) && slot === 0) {
                    alias(u, source)
                    continue
                }
                if (n.op === NodeOp.apply && slot > 0 && getRef(n, 0) !== g.root) {
                    const param = getBlock(g, getRef(n, 0))!.params[slot - 1]
                    alias(param, param)
                    f.exits.push([u, slot])
                    continue
                }
                if (callee && n.op === NodeOp.ret && slot === 0 && countIds(n) === 1) {
                    f.exits.push([u, slot])
                    continue
                }
                f.blocked = `${opName(n.op)}@${slot}`
                break
            }
        }
        for (const id of f.source.keys()) {
            const owner = index.owner.get(id)
            if (!owner) continue
            for (const app of index.applies.get(owner[0]) ?? []) {
                if (!f.source.has(getRef(getNode(g, app)!, owner[1] + 1))) f.blocked ??= 'join'
            }
        }
        return f
    }
    interface Plan {
        callee: number
        own: Flow
        allocations: number[]
        layout: Map<string, [key: number, T: intrinsics.Types]>
        inner: Map<string, number>
        callers: [number, Flow][]
    }
    function allocationOf(g: Graph, id: number): number | undefined {
        let n = getNode(g, id)
        while (n?.op === NodeOp.after || n?.op === NodeOp.encode) {
            id = getRef(n, n.op === NodeOp.after ? countIds(n) - 1 : 0)
            n = getNode(g, id)
        }
        return allocation(g, n) ? id : undefined
    }
    function overlaps(offsets: [number, intrinsics.Types][]): boolean {
        offsets.sort((a, b) => a[0] - b[0])
        for (let i = 0; i + 1 < offsets.length; i++) {
            if (offsets[i][0] + intrinsics.intrinsicBitWidth(offsets[i][1]) / 8 > offsets[i + 1][0]) return true
        }
        return false
    }
    for (const symbol of live) indexOf(symbol)
    const callersOf = new Map<number, number[]>()
    for (const symbol of live) {
        for (const callee of indexOf(symbol).calls.keys()) {
            const list = callersOf.get(callee)
            if (list) list.push(symbol)
            else callersOf.set(callee, [symbol])
        }
    }
    const floats = new Set([Types.f16, Types.f32, Types.f64, Types.unknown_number])
    const plans: Plan[] = []
    for (const symbol of live) {
        const callers = callersOf.get(symbol)
        if (pinned.has(symbol) || !callers || callers.includes(symbol)) continue
        const p = returnedAllocations(symbol)
        if (!p) continue
        const name = program.units.get(symbol)!.name || `symbol ${symbol}`
        const own = flow(symbol, p, true)
        const g = program.units.get(symbol)!
        if (!own.blocked && indexOf(symbol).rets.some(r => !own.source.has(getRef(getNode(g, r)!, 0)))) own.blocked = 'other-return'
        const theirs = callers.map(c => [c, flow(c, indexOf(c).calls.get(symbol)!, false)] as [number, Flow])
        const blocked = own.blocked ?? theirs.find(([, f]) => f.blocked)?.[1].blocked
        if (blocked) {
            if (debug) console.log(`RECORD-RETURN ${name} blocked ${blocked}`)
            continue
        }
        const types = new Map(own.accesses)
        const read = new Set<string>()
        let conflict: string | undefined
        for (const [, f] of theirs) {
            for (const path of f.reads.values()) read.add(path)
            for (const [path, T] of f.accesses) {
                if (types.has(path) && types.get(path) !== T) conflict = 'field-type'
                types.set(path, T)
            }
        }
        const inner = new Map<string, number>()
        const innerTypes = new Map<string, intrinsics.Types>()
        const candidates = new Set([...read].filter(path => path.includes('.') && !read.has(path.split('.')[0])).map(path => path.split('.')[0]))
        const nestable = new Set<string>()
        for (const prefix of candidates) {
            const found = new Map<string, number>()
            const accessed = new Map<string, intrinsics.Types>()
            let ok = true
            for (const allocated of p) {
                const stored = own.stores.get(`${allocated}/${prefix}`) ?? []
                const target = stored.length === 1 ? allocationOf(g, stored[0][1]) : undefined
                const nested = target === undefined ? undefined : flow(symbol, [target], true, new Set([stored[0][0]]))
                if (!nested || nested.blocked || nested.exits.length) {
                    ok = false
                    break
                }
                for (const [path, T] of nested.accesses) accessed.set(`${prefix}.${path}`, T)
                found.set(`${allocated}/${prefix}`, target!)
            }
            if (!ok) continue
            nestable.add(prefix)
            for (const [k, v] of found) inner.set(k, v)
            for (const [k, T] of accessed) innerTypes.set(k, T)
        }
        for (const [c, f] of theirs) {
            for (const [load, path] of [...f.reads]) {
                const prefix = path.split('.')[0]
                if (prefix === path || nestable.has(prefix)) continue
                const pointer = f.inner.get(load)!
                const T = typeOf(getNode(program.units.get(c)!, pointer)!)
                if (types.has(prefix) && types.get(prefix) !== T) conflict = 'field-type'
                types.set(prefix, T)
                f.reads.delete(load)
                f.reads.set(pointer, prefix)
                f.inner.delete(load)
                read.add(prefix)
            }
        }
        for (const path of [...read]) if (path.includes('.') && !nestable.has(path.split('.')[0])) read.delete(path)
        for (const [path, T] of innerTypes) {
            if (types.has(path) && types.get(path) !== T) conflict = 'field-type'
            types.set(path, T)
        }
        const groups = new Map<string, [number, intrinsics.Types][]>()
        for (const [path, T] of types) {
            const parts = path.split('.')
            const group = parts.length > 1 ? parts[0] : ''
            let list = groups.get(group)
            if (!list) groups.set(group, list = [])
            list.push([Number(parts[parts.length - 1]), T])
        }
        for (const offsets of groups.values()) if (overlaps(offsets)) conflict = 'overlap'
        const order = (path: string) => path.split('.').map(Number)
        const fields = [...read].sort((a, b) => order(a)[0] - order(b)[0] || (order(a)[1] ?? -1) - (order(b)[1] ?? -1))
        if (!fields.length || fields.length > program.target.retRegs.length) conflict = `fields=${fields.length}`
        if (fields.some(o => floats.has(types.get(o)!))) conflict = 'float-field'
        if (conflict) {
            if (debug) console.log(`RECORD-RETURN ${name} blocked ${conflict}`)
            continue
        }
        const layout = new Map<string, [number, intrinsics.Types]>()
        fields.forEach((o, i) => layout.set(o, [i, types.get(o)!]))
        if (debug) console.log(`RECORD-RETURN ${name} fields=${fields.join('/')} callers=${callers.map(c => program.units.get(c)!.name || '?').join(',')}`)
        plans.push({ callee: symbol, own, allocations: p, layout, inner, callers: theirs })
    }
    function recordType(g: Graph, layout: Map<string, [number, intrinsics.Types]>): number {
        const type = insertNode(g, createRecordType(g, [...layout.values()].map(([key, T]) => ({ key, type: T }))))
        return type
    }
    function retype(g: Graph, param: number, type: number): void {
        retypeNode(g, param, { ref: type })
    }
    const changed = new Set<number>()
    for (const plan of plans) {
        const g = program.units.get(plan.callee)!
        const { own, layout } = plan
        const type = recordType(g, layout)
        const relays = new Map<number, boolean>()
        const exitsFrom = new Map<number, [number, number][]>()
        for (const [u, slot] of own.exits) {
            const source = own.source.get(getRef(getNode(g, u)!, slot))!
            const list = exitsFrom.get(source)
            if (list) list.push([u, slot])
            else exitsFrom.set(source, [[u, slot]])
        }
        function into(u: number, slot: number): boolean {
            const n = getNode(g, u)!
            return n.op === NodeOp.ret || relay(getBlock(g, getRef(n, 0))!.params[slot - 1])
        }
        function relay(param: number): boolean {
            const known = relays.get(param)
            if (known !== undefined) return known
            relays.set(param, false)
            let ok = !own.accessed.has(param)
            for (const [u, slot] of exitsFrom.get(param) ?? []) ok &&= into(u, slot)
            relays.set(param, ok)
            return ok
        }
        const rewrites = new Map<number, number[]>()
        for (const [u, slot] of own.exits) {
            const value = getRef(getNode(g, u)!, slot)
            const source = own.source.get(value)!
            if (!plan.allocations.includes(source) && relay(source)) continue
            if (!into(u, slot)) continue
            const slots = rewrites.get(u)
            if (slots) slots.push(slot)
            else rewrites.set(u, [slot])
        }
        for (const b of g.blocks) {
            b.bodyId = mapTailPositions(g, b.bodyId, p => {
                const slots = rewrites.get(p.at)
                if (!slots) return p.at
                const user = getNode(g, p.at)!
                const operands = getOperands(g, user)
                for (const slot of slots) {
                    const value = getRef(user, slot)
                    let token = value
                    while (getNode(g, token)!.op === NodeOp.encode) token = getRef(getNode(g, token)!, 0)
                    if (p.tokens.length) token = addNode(g, NodeOp.after, [...p.tokens, token])
                    const fields: Operand[] = []
                    const root = own.source.get(value)!
                    for (const [path, [key, T]] of layout) {
                        const [offset, at] = path.split('.').map(Number)
                        const base = at === undefined ? root : plan.inner.get(`${root}/${offset}`)!
                        fields.push({ literal: key }, addNode(g, NodeOp.load, [token, base, { literal: at ?? offset }], T))
                    }
                    operands[slot] = addNode(g, NodeOp.record, fields)
                }
                return addCopy(g, user, operands)
            })
        }
        indexes.delete(plan.callee)
        for (const [param, ok] of relays) if (ok) retype(g, param, type)
        changed.add(plan.callee)
        for (const [symbol, f] of plan.callers) {
            const cg = program.units.get(symbol)!
            const index = indexOf(symbol)
            const callerType = recordType(cg, layout)
            for (const id of f.source.keys()) {
                const n = getNode(cg, id)!
                if (n.op === NodeOp.param) retype(cg, id, callerType)
                if (n.op !== NodeOp.decode) continue
                for (const [u, slot] of index.users.get(id) ?? []) {
                    const user = getNode(cg, u)!
                    putCopy(cg, u, user, withOperand(cg, user, slot, getRef(n, 0)))
                }
            }
            const bases = new Map([...f.reads.keys()].map(load => [load, getRef(getNode(cg, f.inner.get(load) ?? load)!, 1)]))
            for (const [load, path] of f.reads) {
                const n = getNode(cg, load)!
                const [key, T] = layout.get(path)!
                let value = addNode(cg, NodeOp.get, [bases.get(load)!, { literal: key }])
                if (intrinsics.intrinsicBitWidth(T) < 64) {
                    const converted = addNode(cg, NodeOp.convert, [value], T)
                    value = converted
                }
                intrinsics.assert(getRef(n, 0), `native: load %${load} has no ordering token`)
                putNode(cg, load, NodeOp.after, [getRef(n, 0), value])
            }
            for (const [load, pointer] of f.inner) {
                const n = getNode(cg, pointer)!
                if (n.op !== NodeOp.load) continue
                putNode(cg, pointer, NodeOp.after, [getRef(n, 0), addNode(cg, NodeOp.get, [bases.get(load)!, { literal: layout.get(f.reads.get(load)!)![0] }])])
            }
            changed.add(symbol)
        }
    }
    if (flags.has('trace-stats')) console.log('record plans', plans.map(plan => `${program.units.get(plan.callee)!.name}<-${plan.callers.length}`).join(' '))
    const transformed = new Set(plans.map(plan => plan.callee))
    const started = new Set<number>()
    const finished = new Set<number>()
    function finish(symbol: number): void {
        if (started.has(symbol)) return
        started.add(symbol)
        const source = program.units.get(symbol)!
        if (debug && flags.has(`record-returns:${source.name}`)) console.log(dumpGraph(source))
        const graph = inlineSites(program, symbol, source.nodes.keys(), (id, callee) => {
            if (!transformed.has(callee)) return false
            finish(callee)
            return finished.has(callee) && canInline(program.units.get(callee)!) && worthInlining(program, callSites, source, id, callee)
        })
        program.units.set(symbol, renormalize(graph ?? source, clock))
        inlineAllocations(program, symbol, clock)
        if (transformed.has(symbol)) sweepBlocks(program.units.get(symbol)!)
        finished.add(symbol)
    }
    for (const symbol of changed) finish(symbol)
}

function unitKey(graph: Graph): string {
    const blocks = new Map<number, number>()
    graph.blocks.forEach((b, i) => blocks.set(b.id, i))
    const index = new Map<number, number>()
    const order: number[] = []
    const stack: number[] = []
    for (const b of graph.blocks) stack.push(b.bodyId, ...[...b.params].reverse())
    while (stack.length) {
        const id = stack.pop()!
        if (!id || index.has(id) || blocks.has(id)) continue
        index.set(id, order.length)
        order.push(id)
        const n = getNode(graph, id)!
        for (let i = n.slots.length - 1; i >= 0; i--) stack.push(getRef(n, i))
    }
    const slot = (n: GraphNode, i: number): string => {
        const ref = getRef(n, i)
        if (!ref) return `#${n.slots[i]}`
        return blocks.has(ref) ? `B${blocks.get(ref)}` : `%${index.get(ref)}`
    }
    const lines = graph.blocks.map(b => `B ${b.params.map(p => index.get(p)).join(' ')} ${index.get(b.bodyId) ?? `#${b.bodyConst}`}`)
    for (const id of order) {
        const n = getNode(graph, id)!
        const fact = factOf(n) ? graph.facts?.get(factOf(n)) : undefined
        const typed = typeSlots(n.op) && !typeRefOf(n)
        lines.push(`${opName(n.op)} ${n.flags} ${Array.from(n.slots, (_, i) => typed && i === countIds(n) ? `:${machineType(typeOf(n))}` : slot(n, i)).join(' ')}${fact ? ` ! ${opName(fact.op)} ${Array.from(fact.slots).join(' ')}` : ''}`)
    }
    return lines.join('\n')
}

function mergeIdenticalUnits(program: ProgramGraph, symbols: number[], callees: Map<number, number[]>): Map<number, number> {
    const kept = new Set([...program.roots.values(), ...program.image.staticSymbols])
    const aliases = new Map<number, number>()
    const byShape = new Map<string, [symbol: number, key: string | undefined][]>()
    for (const scc of stronglyConnected(symbols, symbol => callees.get(symbol)!)) {
        for (const symbol of scc) {
            const graph = program.units.get(symbol)!
            for (const [id, n] of [...graph.nodes]) {
                const local = localSymbol(graph, n)
                const alias = local === undefined ? undefined : aliases.get(local)
                if (alias === undefined) continue
                putCopy(graph, id, n, withOperand(graph, n, 0, { literal: alias }))
            }
        }
        if (scc.length !== 1 || kept.has(scc[0])) continue
        const shape = `${program.abi.get(scc[0]) ?? ''}\n${program.units.get(scc[0])!.blocks.length}`
        const peers = byShape.get(shape)
        if (!peers) {
            byShape.set(shape, [[scc[0], undefined]])
            continue
        }
        const key = unitKey(program.units.get(scc[0])!)
        let canonical: number | undefined
        for (const peer of peers) {
            peer[1] ??= unitKey(program.units.get(peer[0])!)
            if (peer[1] !== key) continue
            canonical = peer[0]
            break
        }
        if (canonical === undefined) peers.push([scc[0], key])
        else {
            if (flags.has('merge-debug')) console.log('MERGE', program.units.get(scc[0])!.name, '->', program.units.get(canonical)!.name, dumpGraph(program.units.get(scc[0])!), dumpGraph(program.units.get(canonical)!))
            aliases.set(scc[0], canonical)
        }
    }
    const image = program.image
    for (const [slot, symbol] of image.functionTargets) if (aliases.has(symbol)) image.functionTargets.set(slot, aliases.get(symbol)!)
    for (const [op, symbol] of image.runtime) if (aliases.has(symbol)) image.runtime.set(op, aliases.get(symbol)!)
    return aliases
}

function programCallees(program: ProgramGraph): Map<number, number[]> {
    const callees = new Map<number, number[]>()
    for (const [symbol, graph] of program.units) {
        const out: number[] = []
        for (const n of graph.nodes.values()) {
            const callee = siteTarget(program, graph, n)
            if (callee !== undefined && callee !== symbol && program.units.has(callee)) out.push(callee)
        }
        callees.set(symbol, out)
    }
    return callees
}

function mergeProgram(program: ProgramGraph): number {
    const aliases = mergeIdenticalUnits(program, [...program.units.keys()], programCallees(program))
    for (const symbol of aliases.keys()) program.units.delete(symbol)
    return aliases.size
}

function optimizeProgram(program: ProgramGraph, clock: PhaseClock): number {
    const { timed } = clock
    timed('statics', () => evaluateStatics(program))
    timed('statics', () => foldConstantCalls(program, clock))
    prune(program)
    timed('inline', () => mergeProgram(program))
    timed('inline', () => inlineProgram(program, clock))
    prune(program)
    const refined = new Set<number>()
    timed('effects', () => refineProgramEffects(program, refined))
    timed('statics', () => foldStaticLoads(program, refined))
    for (const [symbol, graph] of program.units) {
        if (graph.form === 'packaged' || refined.has(symbol)) program.units.set(symbol, timed('normalize', () => optimizePackaged(graph, program.target), graph.name))
    }
    const touched = new Set<number>()
    timed('statics', () => foldStaticLoads(program, touched))
    prune(program)
    timed('records', () => recordReturns(program, clock))
    timed('records', () => {
        expandParams(program, touched)
        forwardReturnedArgs(program, touched)
        shareCallerValues(program, touched)
        specializeLiteralArgs(program, touched)
        pruneDeadArgs(program, touched)
        for (const symbol of touched) program.units.set(symbol, renormalize(program.units.get(symbol)!, clock))
        const specialized = new Set(touched)
        touched.clear()
        const state = scalarizeMutableState(program, touched)
        if (state.size) {
            refineProgramEffects(program, touched)
            for (const symbol of state) {
                program.units.set(symbol, renormalize(program.units.get(symbol)!, clock))
                specialized.add(symbol)
                touched.delete(symbol)
            }
            pruneDeadArgs(program, touched)
            refineProgramEffects(program, touched)
            for (const symbol of touched) {
                program.units.set(symbol, renormalize(program.units.get(symbol)!, clock))
                specialized.add(symbol)
            }
        }
        inlineSpecialized(program, specialized, clock)
    })
    prune(program)
    unswitchHot(program, programLevels(program), clock)
    prune(program)
    for (const [symbol, level] of programLevels(program)) program.units.get(symbol)!.level = level
    return timed('inline', () => mergeProgram(program))
}

function lowerProgram(program: ProgramGraph, clock: PhaseClock): NativeUnit[] {
    for (const graph of program.units.values()) {
        for (const n of graph.nodes.values()) {
            const callee = calledSymbol(graph, n)
            if (callee !== undefined && program.unplanned.has(callee)) throw `native: ${graph.name || 'anonymous'} calls ${program.units.get(callee)!.name || `symbol ${callee}`}, which the plan never entered`
        }
    }
    const roots = new Set(program.roots.values())
    const sites = programCallSites(program)
    const free = new Set(freeCallees(program, sites))
    const returnLocations = assignRegisterClasses(program, sites, free)
    const symbols = [...program.units.keys()]
    const callees = programCallees(program)
    const order = stronglyConnected(symbols, symbol => callees.get(symbol)!)
    const clobbers = new Map<number, Set<number>>()
    const prepared = new Map<number, PreparedUnit>()
    for (const symbol of symbols) prepared.set(symbol, clock.timed('lower', () => prepareUnit(program, symbol, roots.has(symbol), returnLocations.get(symbol)), program.units.get(symbol)!.name))
    const endless = new Set(symbols.filter(symbol => ![...prepared.get(symbol)!.prepared.g.nodes.values()].some(n => n.op === NodeOp.ret)))
    const continuations = new Set(symbols.filter(symbol => endless.has(symbol) && free.has(symbol) && sites.get(symbol)?.length === 1))
    nonvolatileArgs(program, prepared, continuations)
    const lowered = new Map<number, NativeUnit>()
    function lower(symbol: number, continues?: (symbol: number) => boolean): NativeUnit {
        const unit = prepared.get(symbol)!
        return clock.timed('lower', () => lowerUnit(program, symbol, unit, callee => clobbers.get(callee), continues, callee => endless.has(callee)), unit.name)
    }
    function lowerContinuations(unit: NativeUnit): void {
        for (const [callee, homes] of unit.code.continued ?? []) {
            if (!continuations.has(callee) || lowered.has(callee)) continue
            const g = prepared.get(callee)!.prepared.g
            g.blocks[0].params.forEach((p, i) => putCopy(g, p, getNode(g, p)!, [{ literal: homes[i] }]))
            const code = lower(callee, symbol => continuations.has(symbol))
            lowered.set(callee, code)
            clobbers.set(callee, code.code.clobbers)
            lowerContinuations(code)
        }
    }
    for (const scc of order) {
        if (scc.length === 1 && continuations.has(scc[0])) continue
        for (const symbol of scc) {
            lowered.set(symbol, lower(symbol, callee => continuations.has(callee)))
            lowerContinuations(lowered.get(symbol)!)
        }
        const members = new Set(scc)
        const shared = new Set<number>()
        for (const symbol of scc) {
            const code = lowered.get(symbol)!.code
            for (const r of code.clobbers) shared.add(r)
            for (const callee of code.localCalls) {
                if (!members.has(callee)) for (const r of clobbers.get(callee) ?? program.target.volatiles) shared.add(r)
            }
        }
        for (const symbol of scc) clobbers.set(symbol, shared)
    }
    for (const symbol of continuations) if (!lowered.has(symbol)) lowered.set(symbol, lower(symbol))
    return symbols.map(symbol => lowered.get(symbol)!)
}

interface PreparedUnit {
    name: string
    debug: boolean
    prepared: PreparedLowering
    returnsFloat: boolean
    returnLocation?: number
}

function prepareUnit(program: ProgramGraph, symbol: number, isRoot: boolean, returnLocation?: number): PreparedUnit {
    const image = program.image
    const unitGraph = program.units.get(symbol)!
    const name = unitGraph.name ?? ''
    const graph = rewriteTargets(unitGraph, image.functionHandles, image.dataHandles, image.runtime, image.statics, image.staticTable.base)
    for (const [id, n] of graph.nodes) {
        if (n.op !== NodeOp.poolEntry || getDebugLabel(graph, id)) continue
        const label = image.labels.get(getLiteral(unitGraph, n, 0))
        if (label) setDebugLabel(graph, id, label)
    }
    if (isRoot) {
        intrinsics.assert(graph.blocks[0].params.filter(p => paramLocation(getNode(graph, p)!) < 0).length <= maxRootArgs)
    }
    const debug = flagged('lower-debug', name)
    if (debug) console.log('lower native', name)
    seedPstacks(graph)
    const float = returnsFloat(graph)
    const prepared = prepareLowering(graph, { debug, target: program.target, poolSlot: value => image.constantSlot(value), poolValue: slot => image.knownValue(slot), floatSlot: value => image.floatSlot(value), staticData })
    if (flags.has('dump-lowerable')) console.log(`--- lowerable ${name} ---\n${dumpGraph(prepared.g)}`)
    return { name, debug, prepared, returnsFloat: float, returnLocation }
}

function lowerUnit(program: ProgramGraph, symbol: number, unit: PreparedUnit, clobbersOf: (symbol: number) => Set<number> | undefined, continues?: (symbol: number) => boolean, endless?: (symbol: number) => boolean): NativeUnit {
    const image = program.image
    const { name, debug, prepared } = unit
    const code = lowerPrepared(prepared, { debug, target: program.target, returnLocation: unit.returnLocation, clobbersOf, continues, endless, nameOf: callee => program.units.get(callee)?.name })
    if (debug || flags.has('listings')) {
        console.log(`--- ${name} listing ---\n`, code.listing)
        if (code.island?.length) console.log(`--- ${name} island ---\n` + code.island.map((slot, i) => `  ${i}: pool[${slot}] ${image.labels.get(slot) ?? ''} = 0x${BigInt.asUintN(64, BigInt(image.values[slot])).toString(16)}`).join('\n'))
    }
    return { name, symbol, code, returnsFloat: unit.returnsFloat }
}

function assignRegisterClasses(program: ProgramGraph, sites: Map<number, [caller: number, call: number][]>, free: Set<number>): Map<number, number> {
    const returns = new Map<number, number>()
    if (!program.target.floatArgRegs?.length || !program.target.floatRetRegs?.length) return returns
    for (const symbol of free) {
        const graph = program.units.get(symbol)!
        const floats = floatValues(graph)
        const params = graph.blocks[0].params
        const locations = params.map(p => floats.has(p) ? floatLocation : -1)
        const returnLocation = returnsFloat(graph, floats) ? floatLocation : -1
        if (returnLocation === -1 && !locations.includes(floatLocation)) continue
        params.forEach((p, i) => {
            const n = getNode(graph, p)!
            intrinsics.assert(paramLocation(n) === -1, `native: ${graph.name} param %${p} is already located before register classes are assigned`)
            if (locations[i] === floatLocation) putCopy(graph, p, n, [{ literal: floatLocation }])
        })
        if (returnLocation !== -1) returns.set(symbol, returnLocation)
        for (const [caller, call] of sites.get(symbol) ?? []) setCallLocations(program.units.get(caller)!, call, locations, returnLocation)
    }
    return returns
}

function nonvolatileArgs(program: ProgramGraph, prepared: Map<number, PreparedUnit>, continuations: Set<number>): void {
    const sites = new Map<number, [caller: number, call: number][]>()
    for (const [caller, unit] of prepared) {
        const g = unit.prepared.g
        for (const [id, n] of g.nodes) {
            const callee = calledSymbol(g, n)
            if (callee === undefined) continue
            const list = sites.get(callee)
            if (list) list.push([caller, id])
            else sites.set(callee, [[caller, id]])
        }
    }
    const origins = new Map<number, Map<number, number>>()
    function entryIndex(caller: number, value: number): number {
        let known = origins.get(caller)
        if (!known) origins.set(caller, known = new Map())
        const g = prepared.get(caller)!.prepared.g
        const owner = new Map<number, [block: number, index: number]>()
        for (const b of g.blocks) b.params.forEach((p, i) => owner.set(p, [b.id, i]))
        const inbound = new Map<number, GraphNode[]>()
        for (const n of g.nodes.values()) {
            if (n.op !== NodeOp.apply) continue
            const list = inbound.get(getRef(n, 0))
            if (list) list.push(n)
            else inbound.set(getRef(n, 0), [n])
        }
        function resolve(v: number, seen: Set<number>): number {
            if (known!.has(v)) return known!.get(v)!
            const at = owner.get(v)
            if (!at) return -1
            if (at[0] === g.root) return at[1]
            if (seen.has(v)) return -2
            seen.add(v)
            let found = -2
            for (const apply of inbound.get(at[0]) ?? []) {
                const r = resolve(getRef(apply, at[1] + 1), seen)
                if (r === -2) continue
                if (r < 0 || (found >= 0 && found !== r)) return -1
                found = r
            }
            return found
        }
        const r = resolve(value, new Set())
        known.set(value, r)
        return r
    }
    for (const symbol of freeCallees(program, programCallSites(program))) {
        if (continuations.has(symbol)) continue
        const calls = sites.get(symbol)
        const g = prepared.get(symbol)?.prepared.g
        if (!calls?.length || !g) continue
        const params = g.blocks[0].params
        const locations = params.map(p => paramLocation(getNode(g, p)!))
        const floats = floatValues(g)
        let changed = false
        params.forEach((p, i) => {
            const crossing = calls.every(([caller, call]) => {
                const unit = prepared.get(caller)!.prepared
                const value = getRef(getNode(unit.g, call)!, 3 + i)
                return !!value && !!unit.analysis.crossedCalls.get(value)?.has(call) && entryIndex(caller, value) === i
            })
            const saved = program.target.calleeSaved.filter(r => isFloatRegister(program.target, r) === floats.has(p))
            if (!crossing || i >= saved.length) return
            locations[i] = saved[i]
            putCopy(g, p, getNode(g, p)!, [{ literal: locations[i] }])
            changed = true
        })
        if (!changed) continue
        for (const [caller, call] of calls) setCallLocations(prepared.get(caller)!.prepared.g, call, locations)
    }
}

interface Code {
    input: string | EmitResult
    captures: any[]
    ambient?: string[]
    source: CompiledSource
    scope?: EmitResult['scopeBindings']
}

interface Traced {
    graph: Graph
    text: string
    frameProxy: u32 | undefined
    frames: Map<u32, number>
    allocations?: Map<u32, Allocation>
    closures?: Set<number>
    usesSelf?: boolean
}
interface PlannedEmbeddings {
    fields: Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>
    sites: Map<PlannedUnit, Map<number, intrinsics.Handle>>
}

export type Codec =
    | { kind: 'undefined' | 'word' | 'f64' | 'boxed', encoded: boolean }
    | { kind: 'int', encoded: boolean, type?: intrinsics.Types }
    | { kind: 'ref', encoded: boolean, shape: intrinsics.Handle, union: boolean }

interface StaticPlacement {
    placed: Set<number>
    readonly: Set<intrinsics.Handle>
    boxed: Map<intrinsics.Handle, Set<string>>
}

interface ShapePlan {
    units: Map<Function, PlannedUnit[]>
    inst: Instantiations
    shapes: Map<string, intrinsics.Handle>
    fixedFields: Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>
    constants: Map<intrinsics.Handle, intrinsics.Handle>
    embedded: PlannedEmbeddings
    layoutOf: (shape: string, elements: ElementReads) => string
    reducedTarget: (target: string) => boolean
    bits: Map<intrinsics.Handle, propertyEval.RecordBits>
    fixedStatic: (state: intrinsics.Handle, key: intrinsics.Handle) => boolean
    statics: StaticPlacement
}
type Iterated = intrinsics.Handle | 'entries'

interface PairReads {
    fields: intrinsics.Handle[]
    getters: Set<PlannedUnit>[]
    boxed: boolean[]
}

interface UnitPlan {
    unit: PlannedUnit
    nodes: Map<number, Rep>
    calls: Map<number, Set<PlannedUnit>>
    boxedCalls: Set<number>
}

interface Resolution {
    graph: Graph
    shapes: Map<number, intrinsics.Handle>
    encoded: Set<number>
    fieldTags: Map<number, number>
    tagWrites: Map<number, Operand>
    local: UnitPlan | undefined
    callees: Map<number, PlannedUnit>
}

interface Unit {
    fn: Function
    origin?: Function
    symbol?: number
    code?: Code
    source?: CompiledSource
    deps?: Function[]
    scheduled?: boolean
    tracing?: boolean
    traced?: Traced
    trace?: Traced
    probed?: boolean
    wrapper?: Function
    stubbed?: boolean
    staticRefs?: number[]
    cold?: Map<u32, number>
}



const unknownValue = 0xFFFFFFFD as intrinsics.Handle

export function pstack0Base(): number {
    return pstackCell(0) + 8
}

export function describe(shape: intrinsics.Handle | undefined): string {
    if (shape === undefined) return '?'
    if (shape === unknownValue) return 'unknown'
    if (shape === propertyEval.numberShape) return 'number'
    if (shape === propertyEval.stringShape) return 'string'
    const keys: string[] = [`@${shape}`]
    for (let k: u32 = 0; k < heap.ownPropertyCount(shape); k++) {
        const key = heap.ownPropertyKeyAt(shape, k)
        keys.push(heap.isString(key) ? heap.stringToJs(key) : `#${key}`)
    }
    return `{${keys.join(',')}}`
}


interface Arrival {
    rep: Rep
    shaped: boolean
}

function pointerOfShapes(rep: Rep | undefined): boolean {
    return rep?.kind === 'pointer' && rep.targets.length > 0 && rep.targets.every(target => target.startsWith('S'))
}
function rawSlotType(rep: Rep | undefined, element: boolean): intrinsics.Types | undefined {
    if (rep?.kind !== 'number' || numberName(rep) === 'f64') return
    if (element) return numberName(rep) === 'i64' ? Types.i32 : Types.u32
    return numberName(rep) === 'i64' ? Types.i64 : Types.u64
}
function rawSlice(slices: Map<number, Rep> | undefined, id: number): boolean {
    const element = slices?.get(id)
    return !!element && elementWidth(element) > 4
}
function taggedSlice(slices: Map<number, Rep> | undefined, id: number): boolean {
    const element = slices?.get(id)
    return !!element && elementTagged(element)
}
function sliceSlot(element: Rep | undefined, T: intrinsics.Types): [width: number, type: intrinsics.Types] {
    if (T !== Types.vm_value) return [rt.wordBytes(T), T]
    if (!element || elementWidth(element) === 4) return [4, Types.vm_value]
    return [elementWidth(element), element.kind === 'number' && numberName(element) === 'i64' ? Types.i64 : Types.u64]
}
interface SliceTags {
    reads: Map<number, number>
    writes: Map<number, Operand>
}
function realizeSlices(graph: Graph, slices: Map<number, Rep> | undefined): SliceTags {
    const tags: SliceTags = { reads: new Map(), writes: new Map() }
    for (const [id, n] of [...graph.nodes]) {
        const op = rt.sliceOf(graph, n)
        if (op === undefined) continue
        const [width, type] = sliceSlot(slices?.get(id), rt.elementType(graph, n))
        const scaled = (at: number): Operand => getRef(n, at) ? addNode(graph, NodeOp.mul, [getRef(n, at), { literal: width }], Types.unknown_number) : { literal: getLiteral(graph, n, at) * width }
        if (op === rt.Op.slice) {
            putNode(graph, id, NodeOp.pstack, [getOperand(graph, n, 0), { literal: programStack }, { literal: 0 }, scaled(2)])
            continue
        }
        const token = getOperand(graph, n, 0)
        const data = getOperand(graph, n, 2)
        const at = scaled(3)
        if (!taggedSlice(slices, id)) {
            if (op === rt.Op.sliceRead) putNode(graph, id, NodeOp.load, [token, data, at], type)
            else putNode(graph, id, NodeOp.store, [token, data, at, getOperand(graph, n, 4)], type)
            continue
        }
        const tagAt = typeof at === 'number' ? addNode(graph, NodeOp.add, [at, { literal: 8 }], Types.unknown_number) : { literal: at.literal + 8 }
        if (op === rt.Op.sliceRead) {
            putNode(graph, id, NodeOp.load, [token, data, at], type)
            tags.reads.set(id, addNode(graph, NodeOp.load, [token, data, tagAt], Types.u64))
            continue
        }
        const value = getOperand(graph, n, 4)
        const nullish = typeof value === 'number' && isNullishValue(graph, value)
        const payload = addNode(graph, NodeOp.store, [token, data, at, nullish ? { literal: 0 } : value], type)
        putNode(graph, id, NodeOp.store, [payload, data, tagAt, { literal: nullish ? 0 : 1 }], Types.u64)
        if (!nullish) tags.writes.set(id, value)
    }
    return tags
}
function unionWord(rep: Rep): boolean {
    return rep.kind === 'union' && rep.targets.length > 0 && rep.targets.every(target => target.startsWith('S') || target === 'str')
}

export type Facts = Map<intrinsics.Handle, Map<string, Codec>>

function wildcardPath(path: string): string {
    const slash = path.lastIndexOf('/')
    return slash >= 0 && /^\d+$/.test(path.slice(slash + 1)) ? `${path.slice(0, slash)}/*` : path
}

function locationOf(facts: Facts, shape: intrinsics.Handle, path: string): [intrinsics.Handle, string] {
    const segments = path.split('/')
    for (let i = 1; i < segments.length; i++) {
        const inner = facts.get(shape)?.get(segments.slice(0, i).join('/'))
        if (inner?.kind === 'ref') return locationOf(facts, inner.shape, segments.slice(i).join('/'))
    }
    return [shape, path]
}

function aliased(a: string, b: string): boolean {
    return a.includes('/') && wildcardPath(a) === wildcardPath(b) && a.endsWith('*') !== b.endsWith('*')
}

function reencoded(codec: Codec, encoded: boolean): Codec {
    if (codec.kind === 'f64' && !encoded) return { kind: 'int', encoded }
    return { ...codec, encoded }
}

function factAt(facts: Facts, shape: intrinsics.Handle, path: string): Codec | undefined {
    const [at, rest] = locationOf(facts, shape, path)
    const known = facts.get(at)
    let fact = known?.get(rest)
    for (const [other, inner] of known ?? []) {
        if (!aliased(rest, other)) continue
        const arrived = reencoded(inner, fact?.encoded ?? inner.encoded)
        const joined = fact === undefined ? arrived : joinFact(facts, fact, arrived)
        if (joined === undefined) throw `native: [${rest}] of ${describe(at)} holds ${describeFact(fact)} but its alias [${other}] holds ${describeFact(inner)}`
        fact = joined
    }
    return fact
}

function numeric(codec: Codec): boolean {
    return codec.kind === 'int' || codec.kind === 'f64' || (codec.kind === 'ref' && codec.union)
}

function opaque(codec: Codec): boolean {
    return codec.kind === 'word' || codec.kind === 'undefined'
}

function joinFact(facts: Facts, a: Codec, b: Codec): Codec | undefined {
    if (a.encoded !== b.encoded || (a.kind === 'f64') !== (b.kind === 'f64')) return
    const encoded = a.encoded
    if (a.kind === 'ref' && b.kind === 'ref' && !sameLayout(a.shape, b.shape)) return encoded ? { kind: 'word', encoded } : undefined
    if (a.kind === 'ref' && b.kind === 'ref') unify(facts, a.shape, b.shape)
    const number = numeric(a) || numeric(b)
    if (number && (opaque(a) || opaque(b))) return
    const ref = a.kind === 'ref' ? a : b.kind === 'ref' ? b : undefined
    if (number && ref && !encoded) return
    if (opaque(a) || opaque(b)) return encoded ? { kind: 'word', encoded } : ref ? { kind: 'ref', shape: ref.shape, encoded, union: false } : { kind: 'word', encoded }
    if (ref) return { kind: 'ref', shape: ref.shape, encoded, union: number }
    if (a.kind === 'f64') return a
    const x = a.kind === 'int' ? a.type : undefined
    const y = b.kind === 'int' ? b.type : undefined
    return { kind: 'int', encoded, type: x === undefined || y === undefined || x === y ? x ?? y : isSignedType(x) ? x : y }
}

function mergeFact(facts: Facts, at: intrinsics.Handle, rest: string, prior: Codec | undefined, fact: Codec, name: string): Codec {
    if (prior === undefined) return fact
    if (prior.encoded !== fact.encoded) throw `native: ${name} stores an ${fact.encoded ? 'encoded' : 'unencoded'} value into [${rest}] of ${describe(at)}, which holds ${prior.encoded ? 'encoded' : 'unencoded'} values`
    const joined = joinFact(facts, prior, fact)
    if (joined === undefined) throw `native: ${name} stores ${describeFact(fact)} into [${rest}] of ${describe(at)}, which holds ${describeFact(prior)}`
    return joined
}

function describeFact(fact: Codec | undefined): string {
    if (fact === undefined) return 'nothing'
    return `${fact.kind}${fact.kind === 'ref' ? ` ${describe(fact.shape)}${fact.union ? ' union' : ''}` : ''}${fact.encoded ? ' encoded' : ''}`
}

function impliedFact(facts: Facts, prior: Codec, fact: Codec): boolean {
    if (prior.encoded !== fact.encoded || (prior.kind === 'f64') !== (fact.kind === 'f64')) return false
    if (numeric(fact) && !numeric(prior)) return false
    if (fact.kind !== 'ref') return true
    if (prior.kind !== 'ref') return false
    return prior.shape === fact.shape || (facts.get(prior.shape) !== undefined && facts.get(prior.shape) === facts.get(fact.shape))
}

const frozenFacts = new WeakSet<Facts>()
function freezeFacts(facts: Facts): void {
    frozenFacts.add(facts)
}

export function setFact(facts: Facts, name: string, shape: intrinsics.Handle, path: string, fact: Codec): void {
    if (fact.kind === 'ref' && fact.encoded && heap.getOwnProperty(fact.shape, heap.closureCallKey)) fact = fact.union ? { kind: 'int', encoded: true } : { kind: 'word', encoded: true }
    const [at, rest] = locationOf(facts, shape, path)
    if (frozenFacts.has(facts)) {
        const planned = facts.get(at)?.get(rest)
        if (planned === undefined || !impliedFact(facts, planned, fact)) throw `native: ${name} stores ${describeFact(fact)} into [${rest}] of ${describe(at)}, which the plan says holds ${describeFact(planned)}`
        return
    }
    if (!facts.has(at)) facts.set(at, new Map())
    const joined = mergeFact(facts, at, rest, facts.get(at)!.get(rest), fact, name)
    facts.get(at)!.set(rest, joined)
    if (flags.has('call-sites')) console.log('FACT', name, describe(at), `[${rest}]`, '<-', describeFact(joined))
}

function unify(facts: Facts, a: intrinsics.Handle, b: intrinsics.Handle): void {
    const left = facts.get(a)
    const right = facts.get(b)
    if (a === b || (left !== undefined && left === right)) return
    intrinsics.assert(!frozenFacts.has(facts), `native: unifying ${describe(a)} with ${describe(b)} after planning`)
    const merged = new Map(left ?? [])
    for (const shape of [a, b]) facts.set(shape, merged)
    for (const [shape, known] of facts) if (known === left || known === right) facts.set(shape, merged)
    for (const [path, fact] of right ?? []) merged.set(path, mergeFact(facts, a, path, merged.get(path), fact, 'unify'))
}

export function intType(codec: Codec | undefined): intrinsics.Types | undefined {
    return codec?.kind === 'int' ? codec.type : undefined
}

export function locate(facts: Facts, shape: intrinsics.Handle, path: string): Codec | undefined {
    if (!path) return { kind: 'ref', shape, encoded: false, union: false }
    const fact = factAt(facts, shape, path)
    if (fact?.kind !== 'int') return fact
    const wide = factAt(facts, shape, wildcardPath(path))
    return wide?.kind === 'ref' && wide.union ? { kind: 'boxed', encoded: fact.encoded } : fact
}

const genericCache = new WeakMap<Function, Generic | null>()
function createLinker(fns: Record<string, Function>, opts: CreateNativesOptions, image: ProgramImage, clock: PhaseClock) {
    const session = createTraceSession()
    Object.assign(session.globals, opts.globals)
    const unitsByFn = new Map<Function, Unit>()
    function unitOf(fn: Function): Unit {
        let unit = unitsByFn.get(fn)
        if (!unit) unitsByFn.set(fn, unit = { fn })
        return unit
    }
    const functions: Function[] = []
    const roots = new Map<string, number>()
    function constructsOutOfLine(fn: Function): boolean {
        return traceModule.isConstructor(originOf(fn))
    }
    function intern(f: Function): number {
        const unit = unitOf(f)
        if (unit.symbol !== undefined) return unit.symbol
        const id = functions.length
        unit.symbol = id
        functions.push(f)
        return id
    }
    const templateFunctions = new Map<EmitResult, Function>()
    function codeOf(fn: Function): Code | undefined {
        const unit = unitOf(fn)
        if (unit.code) return unit.code
        if (typeof (fn as any)[Symbol.for('toComputation')] !== 'function') return
        unit.code = clock.timed('bytecode', () => ({ ...session.functionCode(fn) }), fn.name)
        return unit.code
    }
    function closureBody(handle: u32, name: string): Function {
        const template = session.templateOf(handle)!
        const known = templateFunctions.get(template.compiled)
        if (known) return known
        const fn = Object.defineProperty(function closureBody() {}, 'name', { value: template.compiled.name || `${name}/closure` })
        templateFunctions.set(template.compiled, fn)
        unitOf(fn).code = {
            input: template.compiled, captures: template.captures,
            source: session.compileTemplate(template.compiled), scope: template.compiled.scopeBindings,
        }
        return fn
    }
    function closureFunction(handle: u32, name: string): Function {
        const fn = closureBody(handle, name)
        intern(fn)
        discover(fn)
        schedule(fn)
        closureSymbols.set(handle, unitOf(fn).symbol!)
        return fn
    }
    function linkedValues(fn: Function): any[] {
        const code = codeOf(fn)!
        if (!code.ambient) return code.captures
        return [...code.captures, ...code.ambient.map(name => session.globals[name])]
    }
    const discovered: Function[] = []
    function discover(fn: Function): void {
        const unit = unitOf(fn)
        if (unit.deps) return
        intern(fn)
        discovered.push(fn)
        const deps: Function[] = []
        unit.deps = deps
        const inlined: any[] = []
        for (const capture of linkedValues(fn)) {
            if (typeof capture !== 'function') continue
            const linked: any = capture
            if (linked.shouldInline) {
                inlined.push(capture)
                continue
            }
            if (Number.isSafeInteger(linked.__syscall)
                || Number.isSafeInteger(linked.__native)) continue
            const original = isLocalStub(linked) ? functions[linked.__localTarget] : capture
            deps.push(original)
            discover(original)
        }
        if (!inlined.length) return
        const seen = new Set<any>(deps)
        while (inlined.length) {
            const f = inlined.pop()
            seen.add(f)
            for (const x of linkedValues(f)) {
                if (typeof x !== 'function') continue
                if (Number.isSafeInteger(x.__syscall)
                    || Number.isSafeInteger(x.__native)) continue
                if (seen.has(x)) continue
                seen.add(x)
                if (x.shouldInline) {
                    inlined.push(x)
                    continue
                }
                const original = isLocalStub(x) ? functions[x.__localTarget] : x
                deps.push(original)
                discover(original)
            }
        }
    }
    const order: Function[] = []
    function schedule(fn: Function): void {
        const unit = unitOf(fn)
        if (unit.scheduled) return
        unit.scheduled = true
        order.push(fn)
    }
    function link(fn: Function): number {
        if (!session.reached(fn)) session.typeRoots([fn], false)
        const symbol = intern(fn)
        discover(fn)
        schedule(fn)
        return symbol
    }
    function linkRuntimeCalls(graph: Graph): void {
        for (const n of graph.nodes.values()) {
            if (n.op !== NodeOp.rt || image.runtime.has(getLiteral(graph, n, 1))) continue
            const binding = rt.bindingOf(getLiteral(graph, n, 1))
            if (binding?.impl && !binding.lower) image.runtime.set(getLiteral(graph, n, 1), link(binding.impl))
        }
    }
    const staticFns: Function[] = []
    function linkStatic(handle: number, fn: Function): number {
        const known = image.statics.get(handle)
        if (known !== undefined) return known
        intrinsics.assert(!roots.has(staticInitName), `native: static ${fn.name || 'anonymous'} was found after ${staticInitName} was built`)
        image.statics.set(handle, staticFns.length)
        staticFns.push(fn)
        image.staticSymbols.push(link(fn))
        return staticFns.length - 1
    }
    function linkHeldStatics(entered: Set<Function>): void {
        for (const [box, rebuild] of session.statics) {
            if (entered.has(rebuild)) image.staticBoxes.set(box, linkStatic(heap.deref(session.linkFunction(rebuild) as intrinsics.Handle), rebuild))
        }
    }
    function linkStatics(owner: Function, graph: Graph): void {
        const refs: number[] = []
        unitOf(owner).staticRefs = refs
        for (const [id, n] of graph.nodes) {
            if (n.op !== NodeOp.static) continue
            const target = getNode(graph, getRef(n, 0))
            if (target?.op !== NodeOp.heapHandle || getRef(target, 0)) throw `native: static %${id} in ${graph.name ?? 'anonymous graph'} needs a known function`
            const handle = heap.deref(getLiteral(graph, target, 0) as intrinsics.Handle)
            const known = image.statics.get(handle)
            if (known !== undefined) {
                refs.push(known)
                continue
            }
            const linked = calleeOf(graph, target)
            const fn = linked && isLocalStub(linked) ? functions[(linked as any).__localTarget] : linked
            if (!fn) throw `native: static %${id} in ${graph.name ?? 'anonymous graph'} calls a function that cannot be compiled`
            refs.push(linkStatic(handle, fn))
        }
    }
    function staticOrder(): number[] {
        const order: number[] = []
        const visiting = new Set<number>()
        const done = new Set<number>()
        function reachable(fn: Function, seen: Set<Function>, out: number[]): number[] {
            if (seen.has(fn)) return out
            seen.add(fn)
            const unit = unitOf(fn)
            out.push(...unit.staticRefs ?? [])
            for (const dep of unit.deps ?? []) reachable(dep, seen, out)
            return out
        }
        function visit(slot: number): void {
            if (done.has(slot)) return
            intrinsics.assert(!visiting.has(slot), `native: static ${slot} depends on itself through its initializer`)
            visiting.add(slot)
            for (const dep of reachable(staticFns[slot], new Set(), [])) visit(dep)
            done.add(slot)
            order.push(slot)
        }
        for (let slot = 0; slot < staticFns.length; slot++) visit(slot)
        return order
    }
    const closureSymbols = new Map<u32, number>()
    function originOf(fn: Function): Function {
        return unitOf(fn).origin ?? fn
    }
    function isRoot(fn: Function): boolean {
        for (const symbol of roots.values()) if (functions[symbol] === fn) return true
        return false
    }
    function sourceOfLinked(fn: Function): CompiledSource | undefined {
        return codeOf(fn)?.source
    }
    function usesReceiver(fn: Function): boolean {
        const source = sourceOfLinked(fn)
        return !!source && source.blocks.liveIn[0].has(source.compiled.registerCount)
    }
    function thisParamOf(graph: Graph): number | undefined {
        return graph.blocks[0].params.find(p => {
            const n = getNode(graph, p)
            return !!n && isThisParam(n)
        })
    }
    function calleeOf(g: NodeSpace, target: GraphNode): Function | undefined {
        const handle = getLiteral(g, target, 0)
        if (target.op === NodeOp.localTarget) {
            const fn = functions[handle]
            return fn && !usesReceiver(fn) ? fn : undefined
        }
        return functionOfCell(handle)
    }
    function functionOfCell(handle: number): Function | undefined {
        const stub = session.stubFunctions.get(handle as u32)
        if (stub) return stub
        if (!session.templateOf(handle as u32)) return
        const fn = closureFunction(handle as u32, 'closure')
        return codeOf(fn)!.scope?.length ? undefined : fn
    }
    function functionSlot(symbol: number): number {
        return image.functionSlot(symbol, functions[symbol]?.name || `${symbol}`)
    }
    function mirrorReferenced(graph: Graph): void {
        const nodes = reachable(graph)
        if (!nodes.some(n => n.op === NodeOp.rt && getLiteral(graph, n, 1) === rt.Op.heapaddr)) return
        for (const n of nodes) {
            if (n.op === NodeOp.heapHandle || n.op === NodeOp.localTarget || NumericOps.has(n.op)) continue
            for (const operand of getOperands(graph, n)) {
                if (typeof operand === 'number' || !Number.isInteger(operand.literal) || operand.literal <= 0 || operand.literal >= 2 ** 32) continue
                mirrorValue(operand.literal)
            }
        }
    }
    function resolveHandles(graph: Graph, statics: StaticPlacement): void {
        const functionHandleSlots = image.functionHandles
        const dataHandleSlots = image.dataHandles
        mirrorReferenced(graph)
        for (const n of reachable(graph)) {
            if (n.op !== NodeOp.heapHandle) continue
            const handle = heap.deref(getLiteral(graph, n, 0) as intrinsics.Handle)
            if (session.constructions.has(getLiteral(graph, n, 0) as u32)) {
                dataHandleSlots.set(handle, image.constructionSlot(getLiteral(graph, n, 0), cell => session.constructions.get(cell as u32)?.graph, cell => statics.readonly.has(heap.deref(cell as intrinsics.Handle)), cell => statics.boxed.get(heap.deref(cell as intrinsics.Handle))))
                continue
            }
            if (statics.placed.has(handle)) {
                dataHandleSlots.set(handle, image.staticObjectSlot(handle))
                continue
            }
            const closure = closureSymbols.get(handle as u32) ?? (session.templateOf(handle as u32) ? unitOf(closureFunction(handle as u32, 'closure')).symbol : undefined)
            if (closure !== undefined) {
                functionHandleSlots.set(handle, functionSlot(closure))
                continue
            }
            if (handle && heap.cellViewOf(heap.typeDescriptorOf(handle as intrinsics.Handle))) {
                mirrorCell(handle)
                continue
            }
            if (!heap.isCallable(handle as intrinsics.Handle)) {
                dataHandleSlots.set(handle, heap.isString(handle as intrinsics.Handle)
                    ? image.stringSlot(heap.stringToJs(handle as intrinsics.Handle))
                    : image.pointerSlot(handle, !handle ? 'nullish' : heap.isOrdinaryObject(handle as intrinsics.Handle) ? describe(handle as intrinsics.Handle) : `@${handle}`))
                continue
            }
            const linked = session.stubFunctions.get(getLiteral(graph, n, 0)) as any
            if (!linked) throw `native: heap handle ${handle} is not a linked function`
            if (isLocalStub(linked)) {
                functionHandleSlots.set(handle, functionSlot(linked.__localTarget))
                continue
            }
            if (Number.isSafeInteger(linked.__native)) {
                functionHandleSlots.set(handle, image.pointerSlot(linked.__native, `native ${linked.name || linked.__native}`))
                continue
            }
            const target = intern(linked)
            if (!unitOf(linked).scheduled) {
                discover(linked)
                schedule(linked)
            }
            functionHandleSlots.set(handle, functionSlot(target))
        }
    }
    for (const [name, fn] of Object.entries(fns)) {
        intrinsics.assert(typeof fn === 'function')
        roots.set(name, intern(fn))
    }
    intrinsics.assert(roots.size > 0)
    for (const fn of Object.values(fns)) discover(fn)
    for (const fn of Object.values(fns)) schedule(fn)
    return { session, functions, roots, order, discovered, staticFns, unitOf, originOf, intern, constructsOutOfLine, codeOf, closureBody, closureFunction, functionOfCell, discover, schedule, link, linkRuntimeCalls, linkStatics, linkHeldStatics, staticOrder, isRoot, sourceOfLinked, usesReceiver, thisParamOf, calleeOf, functionSlot, resolveHandles }
}

type Linker = ReturnType<typeof createLinker>

function createTracer(linker: Linker, image: ProgramImage, facts: Facts, clock: PhaseClock) {
    const { session, functions, discovered, unitOf, originOf, intern, constructsOutOfLine, codeOf, closureFunction, discover, schedule, link, linkStatics, isRoot, usesReceiver, thisParamOf } = linker
    const units: Unit[] = []
    const engineArrays = new Map<intrinsics.Handle, intrinsics.Handle>()
    function engineArrayOf(cell: intrinsics.Handle): intrinsics.Handle {
        const array = heap.isIndirect(cell) ? heap.indirectTarget(cell) : cell
        const known = engineArrays.get(array)
        if (known !== undefined) return known
        const length = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(array, heap.arrayLengthKey))).slot0 as intrinsics.Handle
        // XXX: an array that escaped into an out-of-line call is captured as its trace snapshot, whose length is symbolic
        if (heap.boxedNanId(length)) throw `native: captured array @${cell} has a symbolic length; it escaped into a call during tracing`
        const values: intrinsics.Handle[] = []
        for (let i: u32 = 0; i < heap.arrayLength(array); i++) {
            const element = heap.getProperty(array, heap.indexKey(i))
            values.push(element && heap.isArray(element) ? engineArrayOf(element) : element)
        }
        const engine = session.fold(copyInto(values.map(heap.createHeapHandle)))
        const target = heap.indirectTarget(engine)
        engineElements.set(target, values)
        const fields = propertyEval.recordLayout(target)
        const construction = session.constructions.get(engine)!.graph
        const at = fields.keys.findIndex(key => constructedAllocation(construction, snapshotField(target, key)))
        intrinsics.assert(at >= 0 || !values.length, 'native: engine Array with elements has no buffer field')
        const data = `${fields.offsets[at]}/*`
        for (const value of values) {
            if (heap.isBoxedF64(value)) setFact(facts, 'construction', target, data, { kind: 'int', encoded: true })
            if (value && heap.isIndirect(value)) setFact(facts, 'construction', target, data, { kind: 'ref', shape: heap.indirectTarget(value), encoded: true, union: false })
        }
        engineArrays.set(array, engine)
        return engine
    }
    const engineElements = new Map<intrinsics.Handle, intrinsics.Handle[]>()
    function heapValue(cell: intrinsics.Handle): intrinsics.Handle {
        return cell && heap.isArray(cell) ? engineArrayOf(cell) : cell
    }
    function engineHeapArrays(graph: Graph): void {
        for (const [id, n] of graph.nodes) {
            if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
            const cell = getLiteral(graph, n, 0) as intrinsics.Handle
            if (!cell || !heap.isArray(cell)) continue
            putNode(graph, id, NodeOp.heapHandle, [{ literal: engineArrayOf(cell) }])
        }
    }
    function freshCellOf(traced: FastTraced, ref: number): u32 | undefined {
        const n = getNode(traced.graph, strippedAfter(traced.graph, ref))
        if (n?.op !== NodeOp.heapHandle || getRef(n, 0)) return
        const cell = getLiteral(traced.graph, n, 0) as u32
        return traced.allocations.has(cell) ? cell : undefined
    }
    function freshShapes(traced: FastTraced): Map<u32, Map<number, intrinsics.Handle | undefined>> {
        const graph = traced.graph
        const shapes = new Map<u32, Map<number, intrinsics.Handle | undefined>>()
        for (const [id, n] of graph.nodes) {
            const assign = n.op === NodeOp.rt && getLiteral(graph, n, 1) === rt.Op.assign
            if (n.op !== NodeOp.setProp && !assign) continue
            const cell = freshCellOf(traced, getRef(n, assign ? 2 : 1))
            if (cell === undefined) continue
            let writes = shapes.get(cell)
            if (!writes) shapes.set(cell, writes = new Map())
            writes.set(id, assign || getRef(n, 2) ? undefined : getLiteral(graph, n, 2) as intrinsics.Handle)
        }
        return shapes
    }
    function keysAt(traced: FastTraced, shapes: Map<u32, Map<number, intrinsics.Handle | undefined>>, cell: u32, token: number): intrinsics.Handle[] | undefined {
        const graph = traced.graph
        const keys = heap.enumerableKeys(heap.deref(cell as intrinsics.Handle))
        const allocation = traced.allocations.get(cell)
        if (!allocation) return keys
        const writes = shapes.get(cell)
        const seen = new Set<number>()
        function preceding(id: number): boolean {
            if (!id || id === allocation!.token || seen.has(id)) return true
            seen.add(id)
            const n = getNode(graph, id)
            if (!n) return false
            if (n.op === NodeOp.nilEffect) return true
            if (n.op === NodeOp.after) {
                for (let i = 0; i < countIds(n); i++) {
                    if (!preceding(getRef(n, i))) return false
                }
                return true
            }
            if (n.op === NodeOp.param || n.op === NodeOp.apply || n.op === NodeOp.select || n.op === NodeOp.call) return false
            if (!OrderedValues.has(n.op)) return true
            if (!preceding(getRef(n, 0))) return false
            if (!writes?.has(id)) return true
            const key = writes.get(id)
            if (key !== undefined) {
                if (!keys.includes(key)) keys.push(key)
                return true
            }
            const source = n.op === NodeOp.rt ? getNode(graph, strippedAfter(graph, getRef(n, 3))) : undefined
            if (source?.op !== NodeOp.heapHandle || getRef(source, 0)) return false
            const copied = keysAt(traced, shapes, getLiteral(graph, source, 0) as u32, getRef(n, 0))
            if (!copied) return false
            const excluded = rt.assignExcluded(graph, n)
            for (const key of copied) {
                if (!excluded.includes(key) && !keys.includes(key)) keys.push(key)
            }
            return true
        }
        return preceding(token) ? keys : undefined
    }
    function ownProperties(traced: FastTraced): void {
        const graph = traced.graph
        const shapes = freshShapes(traced)
        for (const [id, n] of [...graph.nodes]) {
            if (n.op !== NodeOp.rt || getLiteral(graph, n, 1) !== rt.Op.ownKeys) continue
            const target = getNode(graph, strippedAfter(graph, getRef(n, 2)))
            if (target?.op !== NodeOp.heapHandle || getRef(target, 0)) continue
            const keys = keysAt(traced, shapes, getLiteral(graph, target, 0) as u32, getRef(n, 0))
            if (keys === undefined) throw `native: ${graph.name} enumerates an allocation whose keys are not statically known`
            const mode = getLiteral(graph, n, 3)
            const array = addNode(graph, NodeOp.rt, [getRef(n, 0), { literal: rt.Op.arrayLiteral }, { literal: keys.length }])
            let token = array
            for (let i = 0; i < keys.length; i++) {
                const key = addNode(graph, NodeOp.heapHandle, [{ literal: keys[i] }])
                let element = key
                if (mode !== 0) {
                    element = addNode(graph, NodeOp.getProp, [token, getRef(n, 2), { literal: keys[i] }])
                    token = element
                }
                if (mode === 2) {
                    const pair = addNode(graph, NodeOp.rt, [token, { literal: rt.Op.arrayLiteral }, { literal: 2 }])
                    token = addNode(graph, NodeOp.rt, [pair, { literal: rt.Op.arrayElement }, pair, { literal: 0 }, key])
                    token = addNode(graph, NodeOp.rt, [token, { literal: rt.Op.arrayElement }, pair, { literal: 1 }, element])
                    element = pair
                }
                token = addNode(graph, NodeOp.rt, [token, { literal: rt.Op.arrayElement }, array, { literal: i }, element])
            }
            putNode(graph, id, NodeOp.after, [token, array])
        }
    }
    interface ColdRegion {
        entry: number
        blocks: Set<number>
        sites: number[]
        from: number[]
    }
    interface ColdPlan {
        select: number
        arm: number
        copied: Set<number>
        liveIns: number[]
        frontier: number[]
    }
    function nodeRefs(graph: Graph, n: GraphNode, out: number[]): void {
        for (let i = n.op === NodeOp.apply ? 1 : 0; i < countIds(n); i++) if (getRef(n, i)) out.push(getRef(n, i))
        if (typeRefOf(n)) out.push(typeRefOf(n))
        if (n.op !== NodeOp.heapHandle || getRef(n, 0) || countIds(n) < 2) return
        const target = getLiteral(graph, n, 1) as intrinsics.Handle
        for (const key of snapshotKeys(target)) {
            const id = intrinsics.getNanId(heap.unboxF64(snapshotField(target, key)!))
            if (id) out.push(id)
        }
    }
    function coldRegions(graph: Graph): ColdRegion[] {
        if (![...graph.nodes.values()].some(n => n.op === NodeOp.panic || n.op === NodeOp.unreachable)) return []
        const succ = new Map<number, number[]>()
        const preds = new Map<number, number[]>()
        const live = new Set<number>()
        const panics = new Set<number>()
        const applies = new Map<number, number[]>()
        for (const b of graph.blocks) {
            const out: number[] = []
            const sites: number[] = []
            for (const p of tailPositions(graph, b.bodyId)) {
                const n = getNode(graph, p.at)
                if (n?.op === NodeOp.apply) {
                    out.push(getRef(n, 0))
                    sites.push(p.at)
                    let list = preds.get(getRef(n, 0))
                    if (!list) preds.set(getRef(n, 0), list = [])
                    list.push(b.id)
                } else if (n?.op !== NodeOp.panic && n?.op !== NodeOp.unreachable) live.add(b.id)
                else panics.add(b.id)
            }
            succ.set(b.id, out)
            applies.set(b.id, sites)
        }
        const work = [...live]
        while (work.length) {
            for (const p of preds.get(work.pop()!) ?? []) {
                if (live.has(p)) continue
                live.add(p)
                work.push(p)
            }
        }
        if (live.size === graph.blocks.length) return []
        const ends = [...panics]
        while (ends.length) {
            for (const p of preds.get(ends.pop()!) ?? []) {
                if (panics.has(p)) continue
                panics.add(p)
                ends.push(p)
            }
        }
        const regions = new Map<number, ColdRegion>()
        for (const b of graph.blocks) {
            if (!live.has(b.id)) continue
            for (const site of applies.get(b.id)!) {
                const entry = getRef(getNode(graph, site)!, 0)
                if (live.has(entry)) continue
                const known = regions.get(entry)
                if (known) {
                    known.sites.push(site)
                    known.from.push(b.id)
                    continue
                }
                const blocks = new Set<number>([entry])
                const walk = [entry]
                while (walk.length) for (const s of succ.get(walk.pop()!) ?? []) if (!blocks.has(s)) { blocks.add(s); walk.push(s) }
                if ([...blocks].some(x => !panics.has(x))) continue
                regions.set(entry, { entry, blocks, sites: [site], from: [b.id] })
            }
        }
        return [...regions.values()]
    }
    function coldPlan(graph: Graph, region: ColdRegion, k: number, identity: (cell: u32, n: GraphNode) => boolean): ColdPlan {
        const position = tailPositions(graph, getBlock(graph, region.from[k])!.bodyId).find(p => p.at === region.sites[k])!
        intrinsics.assert(position.path.length > 0, `native: B${region.from[k]} transfers only into doomed blocks`)
        const [select, arm] = position.path[position.path.length - 1]
        const root = getRef(getNode(graph, select)!, arm)
        const hot = new Set<number>()
        const hotCells = new Set<u32>()
        const reach: number[] = []
        for (const b of graph.blocks) if (!region.blocks.has(b.id)) reach.push(b.bodyId, ...b.params)
        while (reach.length) {
            const id = reach.pop()!
            if (!id || id === root || hot.has(id)) continue
            hot.add(id)
            const n = getNode(graph, id)
            if (!n) continue
            if (n.op === NodeOp.heapHandle && !getRef(n, 0) && identity(getLiteral(graph, n, 0) as u32, n)) hotCells.add(getLiteral(graph, n, 0) as u32)
            nodeRefs(graph, n, reach)
        }
        const owner = new Map<number, number>()
        for (const b of graph.blocks) for (const p of b.params) owner.set(p, b.id)
        const constant = new Map<number, boolean>()
        const constantOf = (root: number): boolean => {
            const stack = [root]
            while (stack.length) {
                const id = stack[stack.length - 1]
                if (constant.has(id)) { stack.pop(); continue }
                const n = getNode(graph, id)
                if (!n || n.op === NodeOp.param || n.op === NodeOp.nilEffect || n.op === NodeOp.callContext || n.op === NodeOp.block
                    || (n.op === NodeOp.heapHandle && !getRef(n, 0) && hotCells.has(getLiteral(graph, n, 0) as u32))) {
                    constant.set(id, !n)
                    stack.pop()
                    continue
                }
                const refs: number[] = []
                nodeRefs(graph, n, refs)
                let pending = false
                let all = true
                for (const r of refs) {
                    const known = constant.get(r)
                    if (known === undefined) { stack.push(r); pending = true }
                    else if (!known) all = false
                }
                if (pending) continue
                constant.set(id, all && !OrderedValues.has(n.op))
                stack.pop()
            }
            return constant.get(root)!
        }
        const copied = new Set<number>()
        const liveIns = new Set<number>()
        const frontier = new Set<number>()
        const walk = [root]
        for (const b of region.blocks) walk.push(getBlock(graph, b)!.bodyId, ...getBlock(graph, b)!.params)
        while (walk.length) {
            const id = walk.pop()!
            if (copied.has(id)) continue
            copied.add(id)
            const n = getNode(graph, id)
            if (!n) continue
            const ordering = firstNonOrderingSlot(n)
            const visit = (r: number, token: boolean) => {
                if (!r || copied.has(r)) return
                if (!hot.has(r) || getNode(graph, r)?.op === NodeOp.record || constantOf(r)) walk.push(r)
                else if (token) frontier.add(r)
                else liveIns.add(r)
            }
            for (let i = n.op === NodeOp.apply ? 1 : 0; i < countIds(n); i++) visit(getRef(n, i), i < ordering)
            const extra: number[] = []
            if (typeRefOf(n)) extra.push(typeRefOf(n))
            if (n.op === NodeOp.heapHandle && !getRef(n, 0) && countIds(n) > 1) {
                nodeRefs(graph, n, extra)
                extra.splice(0, typeRefOf(n) ? 1 : 0)
            }
            for (const r of extra) visit(r, false)
        }
        return { select, arm, copied, liveIns: [...liveIns], frontier: [...frontier] }
    }
    function perInvocation(cell: u32, n: GraphNode, frames: Map<u32, number>): boolean {
        if (frames.has(cell)) return true
        if (!heap.isIndirect(cell as intrinsics.Handle) || !session.templateOf(cell)) return false
        const target = heap.indirectTarget(cell as intrinsics.Handle)
        for (let i: u32 = 0; ; i++) {
            const desc = heap.getOwnProperty(target, heap.closureScopeKey(i))
            if (!desc) return false
            const value = heap.FullPropertyDescriptor(heap.resolveHeapCell(desc)).slot0 as intrinsics.Handle
            if (frames.has(value as u32) || (heap.isBoxedF64(value) && intrinsics.getNanId(heap.unboxF64(value)))) return true
        }
    }
    function reachableNodes(graph: Graph, allocations?: Map<u32, Allocation>): Set<number> {
        const reached = new Set<number>()
        const walk: number[] = []
        for (const b of graph.blocks) walk.push(b.id, b.bodyId, ...b.params)
        while (walk.length) {
            const id = walk.pop()!
            if (!id || reached.has(id)) continue
            reached.add(id)
            const n = getNode(graph, id)
            if (!n) continue
            nodeRefs(graph, n, walk)
            if (allocations && n.op === NodeOp.heapHandle && !getRef(n, 0)) walk.push(allocations.get(getLiteral(graph, n, 0) as u32)?.token ?? 0)
        }
        return reached
    }
    let panicSymbol = 0
    function lowerPanics(graph: Graph): boolean {
        let changed = false
        for (const [id, n] of graph.nodes) {
            if (n.op !== NodeOp.panic) continue
            if (!flags.has('panic-trap')) {
                if (!countIds(n)) continue
                const tokens = panicOrdering(graph, getRef(n, 0))
                const ordering = tokens.length ? [addNode(graph, NodeOp.after, [...tokens, addNode(graph, NodeOp.void, [])])] : []
                putNode(graph, id, NodeOp.panic, ordering)
                changed = true
                continue
            }
            if (!panicSymbol) panicSymbol = link(reportPanic)
            const arg = getRef(n, 0)
            const chained = arg ? getNode(graph, arg) : undefined
            const after = chained?.op === NodeOp.after
            const token = after ? joinEffects(graph, cloneRefs(chained!, 0, countIds(chained!) - 1)) : 0
            const err = after ? getRef(chained!, countIds(chained!) - 1) : arg
            const target = addNode(graph, NodeOp.localTarget, [{ literal: panicSymbol }])
            const call = addNode(graph, NodeOp.call, [token, target, 0, err])
            const dead = addNode(graph, NodeOp.unreachable, [])
            putNode(graph, id, NodeOp.after, [call, dead])
            changed = true
        }
        if (flags.has('panic-trap')) return changed
        const doomed = new Set<number>()
        for (const b of graph.blocks) {
            const body = getNode(graph, b.bodyId)!
            if (b.id !== graph.root && body.op === NodeOp.panic && !countIds(body)) doomed.add(b.id)
        }
        if (!doomed.size) return changed
        const arrives = (id: number) => {
            const n = getNode(graph, id)
            return n?.op === NodeOp.apply && doomed.has(getRef(n, 0))
        }
        const orderedArrivals = new Set<number>()
        for (const [id, n] of graph.nodes) {
            const arrival = getRef(n, countIds(n) - 1)
            if (n.op !== NodeOp.after || !arrives(arrival)) continue
            let ordered = false
            for (let i = 0; i < countIds(n) - 1; i++) if (getNode(graph, getRef(n, i))?.op !== NodeOp.nilEffect) ordered = true
            if (ordered) orderedArrivals.add(arrival)
            else putNode(graph, id, NodeOp.panic, [])
        }
        const entered = new Set<number>()
        for (const [id, n] of graph.nodes) {
            if (!arrives(id)) continue
            if (orderedArrivals.has(id)) entered.add(getRef(n, 0))
            else putNode(graph, id, NodeOp.panic, [])
        }
        setGraphBlocks(graph, graph.blocks.filter(b => !doomed.has(b.id) || entered.has(b.id)))
        return true
    }
    function linkCapture(capture: any): any {
        if (isPoolValue(capture)) return rawValue(session.mk(NodeOp.poolEntry, [traceValue(image.valueSlot(capture))]))
        if (typeof capture !== 'function' || capture === intrinsics.isNative) return capture
        const linked: any = capture
        if (Number.isSafeInteger(linked.__syscall)
            || Number.isSafeInteger(linked.__native)
            || isLocalStub(linked)
            || linked.shouldInline
            || constructsOutOfLine(capture)) return capture
        try {
            intrinsics.getComputation(capture)
        } catch {
            return capture
        }
        const target = intern(capture)
        if (!unitOf(capture).scheduled) {
            discover(capture)
            schedule(capture)
        }
        unitOf(capture).stubbed = true
        const compiled = codeOf(capture)?.source.compiled
        const stub: any = nativeStub(capture, target, compiled?.paramCount ?? capture.length, compiled?.rest ? compiled.paramCount - 1 : -1)
        for (const k of Object.keys(capture)) stub[k] = capture[k]
        const wrapper = unitOf(capture).wrapper
        if (flags.has('trace-debug')) console.log('native linked summary', capture.name, { wrapper: !!wrapper })
        return wrapper ? wrapCall(stub, wrapper, capture.length) : stub
    }
    function traceDependency(fn: Function): void {
        const unit = unitOf(fn)
        if (unit.probed || unit.tracing || !codeOf(fn) || (fn as any).shouldInline) return
        const returned = returnedHeapValues(graphsOf(fn).traced!.graph)
        if (returned) unit.wrapper = makeHeapWrapper(returned.prototype)
        unit.probed = true
        if (flags.has('dep-debug')) console.log('DEP', fn.name, 'wrapper', !!returned)
    }
    function recordTypeOf(graph: Graph, id: number): RecordField[] | undefined {
        const n = getNode(graph, id)
        const type = n?.op === NodeOp.param ? getNode(graph, typeRefOf(n)) : undefined
        return type?.op === NodeOp.recordType ? recordFields(graph, type) : undefined
    }
    function outlinable(graph: Graph, plan: ColdPlan): boolean {
        const why = (reason: string) => { if (flags.has('cold-debug')) console.log('COLD-REJECT', graph.name, reason, [...plan.copied].map(id => opName(getNode(graph, id)?.op ?? 0)).join(' ')) }
        if (![...plan.copied].some(id => getNode(graph, id)?.op === NodeOp.call)) return why('no call'), false
        for (const id of plan.copied) {
            const op = getNode(graph, id)?.op
            if (op === NodeOp.inlined || op === NodeOp.join || op === NodeOp.ret) return why(opName(op)), false
        }
        return !plan.liveIns.some(id => recordTypeOf(graph, id)?.some(f => typeof f.type !== 'number'))
    }
    function nilEffectOf(graph: Graph, block: number): number {
        for (const [id, n] of graph.nodes) if (n.op === NodeOp.nilEffect && getRef(n, 0) === block) return id
        return addNode(graph, NodeOp.nilEffect, [block])
    }
    function outlineSite(fn: Function, code: Code, traced: Traced, region: ColdRegion, k: number, plan: ColdPlan, index: number): void {
        const graph = traced.graph
        const name = `${fn.name}/cold${index}`
        const nodes = new Map<number, GraphNode>()
        const rootId = newId(graph)
        nodes.set(rootId, makeNode(graph, NodeOp.block, []))
        const entryToken = newId(graph)
        nodes.set(entryToken, makeNode(graph, NodeOp.nilEffect, []))
        const frontier = new Set(plan.frontier)
        for (const id of plan.copied) {
            const n = getNode(graph, id)
            if (!n) continue
            const copy = copyNode(graph, n)
            for (let i = 0; i < firstNonOrderingSlot(n); i++) if (frontier.has(getRef(n, i))) setRef(copy, i, entryToken)
            nodes.set(id, copy)
        }
        for (const b of region.blocks) {
            const n = getNode(graph, b)
            if (n) nodes.set(b, copyNode(graph, n))
        }
        const params: number[] = []
        const bound = new Map<u32, number>()
        for (const id of plan.liveIns) {
            const n = getNode(graph, id)!
            const fields = recordTypeOf(graph, id)
            if (fields) {
                const parts: Operand[] = []
                for (const f of fields) {
                    const q = newId(graph)
                    nodes.set(q, makeNode(graph, NodeOp.param, [], f.type as intrinsics.Types))
                    params.push(q)
                    parts.push({ literal: f.key }, q)
                }
                nodes.set(id, makeNode(graph, NodeOp.record, parts))
                continue
            }
            nodes.set(id, n.op === NodeOp.param ? copyNode(graph, n) : makeNode(graph, NodeOp.param, []))
            params.push(id)
            if (n.op === NodeOp.heapHandle && !getRef(n, 0) && !bound.has(getLiteral(graph, n, 0) as u32)) bound.set(getLiteral(graph, n, 0) as u32, id)
        }
        const root = getRef(getNode(graph, plan.select)!, plan.arm)
        const blocks = [{ id: rootId, params, bodyId: root, bodyConst: 0 }, ...graph.blocks.filter(b => region.blocks.has(b.id)).map(b => ({ ...b, params: b.params.slice() }))]
        const cold = createGraph({ ids: graph.ids, literals: graph.literals, root: rootId, nodes, blocks, name })
        const frames = new Map<u32, number>()
        for (const n of nodes.values()) {
            if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
            const cell = getLiteral(graph, n, 0) as u32
            if (traced.frames.has(cell) && !bound.has(cell)) frames.set(cell, traced.frames.get(cell)!)
        }
        const unit = Object.defineProperty(Object.assign(function cold() {}, { shouldNotInline: true }), 'name', { value: name })
        unitOf(unit).cold = bound
        const source = code.source
        const coldSource: CompiledSource = {
            ...source,
            compiled: { ...source.compiled, paramCount: params.length, rest: false, defaults: false },
            blocks: { ...source.blocks, liveIn: [new Set<number>()] },
        }
        const coldUnit = unitOf(unit)
        coldUnit.code = { input: code.input, captures: code.captures, ambient: code.ambient, source: coldSource }
        coldUnit.source = coldSource
        coldUnit.traced = { graph: cold, text: '', frameProxy: undefined, frames }
        units.push(coldUnit)
        const symbol = link(unit)
        let token = plan.frontier[0] ?? nilEffectOf(graph, region.from[k])
        if (plan.frontier.length > 1) token = addNode(graph, NodeOp.after, plan.frontier)
        const args: Operand[] = []
        for (const id of plan.liveIns) {
            const fields = recordTypeOf(graph, id)
            if (!fields) {
                args.push(id)
                continue
            }
            for (const f of fields) args.push(addNode(graph, NodeOp.get, [id, { literal: f.key }]))
        }
        const target = addNode(graph, NodeOp.localTarget, [{ literal: symbol }])
        const call = addNode(graph, NodeOp.call, [token, target, 0, ...args])
        const select = copyNode(graph, getNode(graph, plan.select)!)
        setRef(select, plan.arm, addNode(graph, NodeOp.after, [call, addNode(graph, NodeOp.unreachable, [])]))
        setNode(graph, plan.select, select)
    }
    function outlineCold(fn: Function, code: Code, traced: Traced): void {
        const graph = traced.graph
        const regions = coldRegions(graph)
        if (!regions.length) return
        const identity = (cell: u32, n: GraphNode) => perInvocation(cell, n, traced.frames)
        const removed = new Set<number>()
        let index = 0
        for (const region of regions) {
            const plans = region.sites.map((_, k) => coldPlan(graph, region, k, identity))
            if (!plans.every(plan => outlinable(graph, plan))) continue
            plans.forEach((plan, k) => outlineSite(fn, code, traced, region, k, plan, index++))
            for (const b of region.blocks) removed.add(b)
        }
        if (!removed.size) return
        for (const region of regions) if (![...region.blocks].every(b => removed.has(b))) for (const b of region.blocks) removed.delete(b)
        setGraphBlocks(graph, graph.blocks.filter(b => !removed.has(b.id)))
        const after = reachableNodes(graph, traced.allocations)
        for (const id of [...graph.nodes.keys()]) if (!after.has(id)) deleteNode(graph, id)
    }
    const assumed: [intrinsics.Handle, intrinsics.Handle, string][] = []
    const fastMapped = new Map<any, any>()
    function fastMapCapture(capture: any): any {
        if (typeof capture !== 'function') return linkCapture(capture)
        const known = fastMapped.get(capture)
        if (known !== undefined) return known
        const mapped = linkCapture(capture)
        fastMapped.set(capture, mapped)
        return mapped
    }
    function rawTrace(fn: Function, receiver: boolean, verbose: boolean): FastTraced {
        const code = codeOf(fn)!
        return fastTraceModule.fastTrace(code.source, {
            captures: code.captures, session, mapCapture: fastMapCapture, verbose, name: fn.name,
            self: code.scope ? undefined : fn, env: !!code.scope, receiver,
        })
    }
    function fastTraced(fn: Function, verbose: boolean): FastTraced {
        const traced = rawTrace(fn, constructsOutOfLine(fn) || usesReceiver(fn), verbose)
        resolveReads(traced)
        applyPrototypes(traced)
        sealStaticClosures(traced)
        spliceTagged(fn, traced)
        spliceables.set(fn, { graph: snapshotGraph(traced.graph), allocations: new Map(traced.allocations), frames: traced.frames.size > 0 })
        markAllocations(traced)
        return traced
    }
    function markAllocations(traced: FastTraced): void {
        const graph = traced.graph
        for (const [id, n] of [...graph.nodes]) {
            if (n.op !== NodeOp.heapHandle || getRef(n, 0) || countIds(n) !== 1) continue
            const cell = getLiteral(graph, n, 0) as intrinsics.Handle
            if (!traced.allocations.has(cell as u32)) continue
            putNode(graph, id, NodeOp.heapHandle, [{ literal: cell }, { literal: heap.deref(cell) }], typeOf(n))
        }
    }
    function traceProgramUnits(): void {
        for (const fn of discovered) if (codeOf(fn)) graphsOf(fn)
    }
    function analyzedState(cell: intrinsics.Handle): intrinsics.Handle | undefined {
        if (!heap.isArray(cell)) return heap.deref(cell)
        const engine = engineArrays.get(heap.isIndirect(cell) ? heap.indirectTarget(cell) : cell)
        return engine === undefined ? undefined : heap.deref(engine)
    }
    function checkInlinedReads(fixed: (state: intrinsics.Handle, key: intrinsics.Handle) => boolean): void {
        for (const [cell, key, unit] of assumed) {
            const state = analyzedState(cell)
            if (state !== undefined && !fixed(state, key)) throw `native: ${unit} inlined ${describe(heap.deref(cell))}.${heap.isString(key) ? heap.stringToJs(key) : key}, which compiled code writes`
        }
    }
    function runtimeObjects() {
        return session.runtime!.objects
    }
    function strippedAfter(graph: Graph, id: number): number {
        let n = getNode(graph, id)
        while (n?.op === NodeOp.after) {
            id = getRef(n, countIds(n) - 1)
            n = getNode(graph, id)
        }
        return id
