            for (const id of [call, ...nextProps, ...returnCalls, iterator, ...relay ?? [], made, symbol]) {
                if (!getNode(graph, id) || getNode(graph, id)!.op === NodeOp.after) continue
                const tok = getRef(getNode(graph, id)!, 0)
