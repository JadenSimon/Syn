        returns?: ReturnLayout | null
        closed?: Graph
        closedShapes?: Map<number, intrinsics.Handle>
        unit?: Graph
    }
    interface ReturnLayout {
        shape: intrinsics.Handle
        slot: number
        params: Map<intrinsics.Handle, number>
    }
    function freshId(graph: Graph): number {
        const tracer = session.runtime!.tracer
        const id = Math.max(graph.maxId, tracer.getNanId(tracer.createUniqueNan()))
        graph.maxId = id + 1
        return id
    }
    function returnedObjects(graph: Graph, calls?: number[]): number[] | undefined {
