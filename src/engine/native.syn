            rets: summary.rets.map(r => `${show(r.value)}${r.encoded ? '!' : ''}${r.fresh ? '+' : ''}`).sort(),
            fields: [...summary.fields].map(([k, c]) => `${k}:${show(c.value)}${c.encoded ? '!' : ''}`).sort(),
