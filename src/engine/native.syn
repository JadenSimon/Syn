        const specialized = Object.defineProperty(function specialized() {}, 'name', { value: `${origin.name}#${family.length}` })
        codes.set(specialized, codeOf(origin)!)
        specializedFrom.set(specialized, origin)
        family.push(specialized)
        if (unionPaths) unionSpecialized.set(specialized, unionPaths)
