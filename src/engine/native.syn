    function specializationFor(fn: Function, wanted: Map<number, intrinsics.Handle>, kinds: Map<number, intrinsics.Types>, unionPaths = ''): Function {
        const origin = specializedFrom.get(fn) ?? fn
        if (coldUnits.has(origin)) return origin
        let family = specializations.get(origin)
        if (!family) specializations.set(origin, family = [origin])
        const retrace = [...kinds].some(([index, T]) => T === Types.f64 || (T !== Types.vm_value && dispatchedParams(origin).has(index)))
        for (const candidate of family) {
            const shapes = paramShapes.get(candidate)
            const known = paramKinds.get(candidate)
            if (!shapes?.size && !known?.size && !used.has(candidate)) {
                if (retrace && fnGraphs.has(candidate)) continue
                if (unionPaths) continue
                used.add(candidate)
                return candidate
            }
            let fits = (shapes?.size ?? 0) === wanted.size && kindsCompatible(known, kinds) && (unionSpecialized.get(candidate) ?? '') === unionPaths
            for (const [index, shape] of wanted) {
