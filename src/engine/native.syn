                if (base) effects.push({ target: { param: base.param, path: joinPath(base.path, step(n, 2, base.base)) }, value: value ?? unknownValue, encoded: typeOf(n) === intrinsics.Types.vm_value })
            } else if (n.op === NodeOp.ret) {
                if (!getRef(n, 0)) continue
                const cell = returnedCell(getRef(n, 0))
                if (cell !== undefined) {
                    for (let k: u32 = 0; k < heap.ownPropertyCount(cell); k++) {
                        const key = heap.ownPropertyKeyAt(cell, k)
                        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(cell, key)))
                        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
                        const slot = d.slot0 as intrinsics.Handle
                        const symbol = heap.boxedNanId(slot)
