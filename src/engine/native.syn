/// @synth

"use wrapped";

import ts from 'typescript' // XXX: used for `api.zig`
import * as intrinsics from './intrinsics'
import * as heap from './heap'
import * as syscalls from './syscalls'
import { Op, rawValue, traceValue } from './vm'
import {
    Graph, GraphNode, LowerGraphResult, dumpGraph, floatValues, 
    isNumeric, isParam, lowerValueGraph, normalizeValueGraph, optimizePackaged, sweepBlocks, encodeCallOutcomes, type CallOutcomes,
    printOptimizeStats, memAnalysis, type Mem, type MemAnalysis, type MemFlow, MemFresh, MemPre, WritesUnknown, ReturnsFresh, CapturesAll,
    graphLoops, stronglyConnected, tailOf, tailPositions, tailRoots, tailScalar, valueFacts, type SelectPath, type TailPosition, type ValueFacts,
} from './lowering2'
import {
    addGraphBlock, copyNode, countIds, countLiterals, createRecordType, getArgIds, getBlock, getDebugLabel, getLiteral,
    getOperand, getOperands, getRef, isThisParam, makeNode, type Operand, operandType, resultType, setDebugLabel, setGraphBlocks,
    createFnType, fnLocations, fnReturn, paramLocation,
    setLiteral, setRef, setType, typeOf, typeRefOf,
} from './graph-node'
import { hostTarget, isSignedType, type Target } from './lowering'

import type { CompiledSource } from './trace2'
import type { EmitResult } from './bytecode-emitter'
import * as propertyEval from './property-eval'
import * as rt from './rt'
import * as typer from './typer'
import type { Constructed } from './property-eval'

type usize = u32

const Intrinsics = intrinsics.Intrinsics
const Types = intrinsics.Types
const UnboxingOps = new Set([
    'add', 'sub', 'mul', 'div', 'rem', 'pow', 'and', 'or', 'xor', 'shl', 'shr', 'ushr',
    'lt', 'le', 'gt', 'ge', 'neg', 'convert', 'bitconvert',
])

const poolTag = Symbol('native.pool')
interface PoolValue {
    [poolTag]: true
    value: number | bigint
}

export function pool(value: number | bigint): any {
    return { [poolTag]: true, value }
}

function isPoolValue(value: any): value is PoolValue {
    return !!value?.[poolTag]
}

let nativeMapper: any
let nativeCopier: any
let nativeSealer: any
let nativeInvoker: any
let heldArgs: any
const darwinArm64 = process.platform === 'darwin' && process.arch === 'arm64'
function declareNative(ptr: any, args: number[], returns: number): any {
    if (ptr === undefined) return undefined
    const f: any = (..._: any[]) => { throw new Error('unlinked native symbol') }
    f.__native = typeof ptr === 'bigint' ? Number(ptr) : ptr
    f.__args = args
    f.__returns = returns
    return f
}
const sys_icache_invalidate = declareNative(
    darwinArm64 ? (ts as any).lookupNativeSymbol('sys_icache_invalidate') : undefined,
    [Types.u64, Types.u64], Types.u64,
)
const pthread_jit_write_protect_np = darwinArm64
    ? (ts as any).lookupNativeSymbol('pthread_jit_write_protect_np') : undefined

function mapCodePage(len: usize): usize {
    const r = syscalls.mmap(
        0, len,
        // (syscalls.PROT_READ | syscalls.PROT_WRITE | (darwinArm64 ? syscalls.PROT_EXEC : 0)) as any,
        // (syscalls.MAP_PRIVATE | syscalls.MAP_ANON | (darwinArm64 ? syscalls.MAP_JIT : 0)) as any,
        (syscalls.PROT_READ | syscalls.PROT_WRITE) as any,
        (syscalls.MAP_PRIVATE | syscalls.MAP_ANON) as any,
        -1 as any, 0,
    )
    // if (darwinArm64) {
    //     pthread_jit_write_protect_np(0)
    // }
    return r
}

function copyCode(dst: usize, src: usize, len: usize): usize {
    let offset: u32 = 0
    while ((len - offset) >= 8) {
        Intrinsics.store(dst, offset, Intrinsics.load(src, offset, Types.u64), Types.u64)
        offset += 8
    }
    while (offset < len) {
        Intrinsics.store(dst, offset, Intrinsics.load(src, offset, Types.u8), Types.u8)
        offset += 1
    }
    return dst
}

function sealCodePage(ptr: usize, len: usize): u32 {
    // if (darwinArm64) {
    //     pthread_jit_write_protect_np(1)
    //     return sys_icache_invalidate(ptr, len)
    // }
    const status = syscalls.mprotect(ptr, len, syscalls.PROT_READ | syscalls.PROT_EXEC)
    if (status === 0 && darwinArm64) sys_icache_invalidate(ptr, len)
    return status
}

function invokeNative(target: any, args: usize, nargs: usize): usize {
    if (nargs === 0) return target()
    const a0 = Intrinsics.load(args, 0, Types.u64)
    if (nargs === 1) return target(a0)
    const a1 = Intrinsics.load(args, 8, Types.u64)
    if (nargs === 2) return target(a0, a1)
    const a2 = Intrinsics.load(args, 16, Types.u64)
    if (nargs === 3) return target(a0, a1, a2)
    const a3 = Intrinsics.load(args, 24, Types.u64)
    if (nargs === 4) return target(a0, a1, a2, a3)
    const a4 = Intrinsics.load(args, 32, Types.u64)
    if (nargs === 5) return target(a0, a1, a2, a3, a4)
    const a5 = Intrinsics.load(args, 40, Types.u64)
    if (nargs === 6) return target(a0, a1, a2, a3, a4, a5)
    const a6 = Intrinsics.load(args, 48, Types.u64)
    if (nargs === 7) return target(a0, a1, a2, a3, a4, a5, a6)
    const a7 = Intrinsics.load(args, 56, Types.u64)
    if (nargs === 8) return target(a0, a1, a2, a3, a4, a5, a6, a7)
    const a8 = Intrinsics.load(args, 64, Types.u64)
    if (nargs === 9) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8)
    const a9 = Intrinsics.load(args, 72, Types.u64)
    if (nargs === 10) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9)
    const a10 = Intrinsics.load(args, 80, Types.u64)
    if (nargs === 11) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10)
    const a11 = Intrinsics.load(args, 88, Types.u64)
    if (nargs === 12) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11)
    const a12 = Intrinsics.load(args, 96, Types.u64)
    if (nargs === 13) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12)
    const a13 = Intrinsics.load(args, 104, Types.u64)
    if (nargs === 14) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13)
    const a14 = Intrinsics.load(args, 112, Types.u64)
    if (nargs === 15) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14)
    const a15 = Intrinsics.load(args, 120, Types.u64)
    if (nargs === 16) return target(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15)
    return 0
}
const maxRootArgs = 16
let runtimeHeapAddress: number | undefined
function runtimeHeapBase(): number {
    if (runtimeHeapAddress !== undefined) return runtimeHeapAddress
    getNativeBootstraps()
    const base = Number(nativeMapper(heap.runtimeCells + (1 << 24)))
    if (!base || base === -1) throw 'native: failed to map the runtime heap'
    runtimeHeapAddress = base
    writeRuntimeHeap(heap.runtimeCells, new Uint8Array(new Uint32Array([heap.runtimeCells + 8]).buffer))
    return base
}
const mirroredCells = new Set<number>()
function vmBytes(ptr: number, size: number): Uint8Array {
    const bytes = new Uint8Array(size)
    for (let i = 0; i < size; i++) bytes[i] = Intrinsics.load(ptr, i, Types.u8)
    return bytes
}
function writeRuntimeHeap(at: number, bytes: Uint8Array): void {
    const outer = heldArgs
    heldArgs = bytes
    const src = (ts as any).getArrayBufferPtr(bytes.buffer)
    if (!nativeCopier(runtimeHeapBase() + at, src, bytes.byteLength)) throw 'native: failed to copy into the runtime heap'
    heldArgs = outer
}
function mirrorRaw(ptr: number): void {
    if (!ptr || mirroredCells.has(ptr)) return
    mirroredCells.add(ptr)
    writeRuntimeHeap(ptr, vmBytes(ptr, intrinsics.allocationSize(ptr)))
}
function mirrorCell(handle: number): void {
    if (!handle || mirroredCells.has(handle)) return
    mirroredCells.add(handle)
    const view = heap.cellViewOf(heap.typeDescriptorOf(handle as intrinsics.Handle))
    if (!view) throw `native: heap cell ${handle} has no view for its type descriptor`
    const bytes = vmBytes(heap.resolveHeapCell(handle as intrinsics.Handle), view.sizeof)
    const data = new DataView(bytes.buffer)
    for (const offset of view.handleOffsets) {
        const child = data.getUint32(offset, true)
        if (offset === 0) mirrorRaw(child)
        else mirrorCell(child)
    }
    for (const offset of view.rawOffsets) {
        const raw = Number(data.getBigUint64(offset, true))
        if (!raw) continue
        mirrorRaw(raw)
        data.setBigUint64(offset, BigInt(runtimeHeapBase() + raw), true)
    }
    writeRuntimeHeap(handle, bytes)
}
const pstackRegionBytes = 1 << 24
const pstackCells = new Map<number, number>()
function pstackCell(stack: number): number {
    const known = pstackCells.get(stack)
    if (known !== undefined) return known
    getNativeBootstraps()
    const cell = Number(nativeMapper(pstackRegionBytes))
    if (!cell || cell === -1) throw `native: failed to map pstack ${stack}`
    const top = new BigUint64Array([BigInt(cell + 8)])
    if (!nativeCopier(cell, (ts as any).getArrayBufferPtr(top.buffer), 8)) throw `native: failed to seed pstack ${stack}`
    pstackCells.set(stack, cell)
    return cell
}

export function pstackMark(stack: number): bigint {
    const cell = pstackCell(stack)
    const top = new BigUint64Array(1)
    if (!nativeCopier((ts as any).getArrayBufferPtr(top.buffer), cell, 8)) throw `native: failed to read pstack ${stack}`
    return top[0]
}

export function pstackRelease(stack: number, mark: bigint): void {
    const cell = pstackCell(stack)
    const top = new BigUint64Array([mark])
    if (!nativeCopier(cell, (ts as any).getArrayBufferPtr(top.buffer), 8)) throw `native: failed to reset pstack ${stack}`
}

export function seedPstacks(graph: Graph): void {
    for (const [id, n] of graph.nodes) {
        if (n.op !== 'pstack') continue
        if (getRef(n, 1)) throw `native: pstack %${id} names its stack dynamically`
        const copy = copyNode(n)
        setLiteral(copy, 1, pstackCell(getLiteral(n, 1)))
        graph.nodes.set(id, copy)
    }
}

function getNativeBootstraps() {
    if (nativeMapper) return
    const mapper = lowerValueGraph(trace2(mapCodePage).graph, { target: hostTarget })
    const copier = lowerValueGraph(trace2(copyCode).graph, { target: hostTarget })
    const sealer = lowerValueGraph(trace2(sealCodePage).graph, { target: hostTarget })
    const invoker = lowerValueGraph(trace2(invokeNative).graph, { target: hostTarget })
    nativeMapper = (ts as any).createNativeFn(new Uint8Array(mapper.bytes))
    nativeCopier = (ts as any).createNativeFn(new Uint8Array(copier.bytes))
    nativeSealer = (ts as any).createNativeFn(new Uint8Array(sealer.bytes))
    nativeInvoker = (ts as any).createNativeFn(new Uint8Array(invoker.bytes))
    if (intrinsics.argv().includes('bootstrap-debug')) {
        console.log('--- listing mapper ---')
        console.log(mapper.listing)
        console.log('--- listing copier ---')
        console.log(copier.listing)
        console.log('--- listing sealer ---')
        console.log(sealer.listing)
        console.log('--- listing invoker ---')
        console.log(invoker.listing)
    }
}

interface CodePage {
    ptr: any
    length: number
    used: number
    sealed: boolean
}
let writableCodePage: CodePage | undefined

function addPtr(ptr: any, offset: number): any {
    return typeof ptr === 'bigint' ? ptr + BigInt(offset) : ptr + offset
}

function reserveCode(length: number): { page: CodePage, ptr: any } {
    getNativeBootstraps()
    let page = writableCodePage
    let offset = page ? (page.used + 15) & ~15 : 0
    if (!page || offset + length > page.length) {
        const mappedLength = (Math.max(length, 4096) + 4095) & ~4095
        const ptr = nativeMapper(mappedLength)
        if (!ptr) throw 'failed to map native code page'
        page = { ptr, length: mappedLength, used: 0, sealed: false }
        writableCodePage = page
        offset = 0
    }
    page.used = offset + length
    return { page, ptr: addPtr(page.ptr, offset) }
}

function sealCode(page: CodePage): void {
    if (page.sealed) return
    const status = nativeSealer(page.ptr, page.length)
    if (status !== 0) throw `mprotect failed: ${status}`
    page.sealed = true
    if (writableCodePage === page) writableCodePage = undefined
}

export function installNative(bytes: number[]) {
    const code = new Uint8Array(bytes)
    const outer = heldArgs
    heldArgs = code
    const src = (ts as any).getArrayBufferPtr(code.buffer)
    const { page, ptr } = reserveCode(code.byteLength)
    if (!nativeCopier(ptr, src, code.byteLength)) throw 'failed to copy native code'
    heldArgs = outer
    return Object.assign((...args: any[]) => {
        sealCode(page)
        if (!args.length) return nativeInvoker(ptr, 0, args.length)
        const values = new BigInt64Array(args.length)
        for (let i = 0; i < args.length; i++) values[i] = BigInt(args[i])
        const argsPtr = (ts as any).getArrayBufferPtr(values.buffer)
        const outer = heldArgs
        heldArgs = values
        const raw = nativeInvoker(ptr, argsPtr, args.length)
        heldArgs = outer
        return raw
    }, { ptr, codePage: page })
}

interface NativeUnit {
    name: string
    symbol: number
    code: LowerGraphResult
    returnsFloat: boolean
}

function returnsFloat(graph: Graph): boolean {
    const floats = floatValues(graph)
    for (const n of graph.nodes.values()) {
        if (n.op !== 'ret') continue
        if (getRef(n, 0) ? floats.has(getRef(n, 0)) : !Number.isInteger(getLiteral(n, 0))) return true
    }
    return false
}

function returnsSigned(graph: Graph): boolean {
    for (const n of graph.nodes.values()) {
        if (n.op !== 'ret' || !getRef(n, 0)) continue
        let value = getRef(n, 0)
        for (let m = graph.nodes.get(value); m?.op === 'after'; m = graph.nodes.get(value)) value = getRef(m, countIds(m) - 1)
        const m = graph.nodes.get(value)
        if (m?.op === 'sub' && (typeOf(m) === Types.unknown_number || typeOf(m) === Types.i64)) return true
    }
    return false
}

function returnsValue(graph: Graph): boolean {
    for (const n of graph.nodes.values()) {
        if (n.op !== 'ret' || !getRef(n, 0)) continue
        let value = getRef(n, 0)
        for (let m = graph.nodes.get(value); m?.op === 'after'; m = graph.nodes.get(value)) value = getRef(m, countIds(m) - 1)
        const m = graph.nodes.get(value)
        if (m && resultType(graph, m) === Types.vm_value) return true
    }
    return false
}

function floatBits(raw: any): number {
    return new Float64Array(new BigInt64Array([BigInt(raw)]).buffer)[0]
}

function nativeStub(fn: Function, symbol: number, returns: intrinsics.Types, paramCount: number, rest: number): Function {
    const names: string[] = []
    for (let i = 0; i < paramCount; i++) names.push(`arg${i}`)
    const stub: any = new Function(...names, `throw new Error('Unlinked local function')`)
    stub.__localTarget = symbol
    stub.__args = Array.from({ length: paramCount }, () => Types.u64)
    stub.__returns = returns
    stub.__rest = rest
    stub.__name = fn.name
    return stub
}

function isLocalStub(f: any): boolean {
    return Number.isSafeInteger(f?.__localTarget)
}

const toComputation = Symbol.for('toComputation')
const addressKey = heap.fromJsString('__address')

function inlineComputation(source: string, captures: any[], arity: number): Function {
    const names: string[] = []
    for (let i = 0; i < arity; i++) names.push(`arg${i}`)
    const fn: any = new Function(...names, `throw new Error('Untraced synthetic function')`)
    fn.shouldInline = true
    fn[toComputation] = () => [source, captures]
    return fn
}

function makeHeapWrapper(proto: intrinsics.Handle): Function {
    return inlineComputation(
        'function heapWrapper(value) { return Object.setPrototypeOf({ __address: value }, $0) }',
        [heap.createHeapHandle(proto)],
        1,
    )
}

function wrapCall(stub: Function, wrapper: Function, arity: number): Function {
    const names: string[] = []
    for (let i = 0; i < arity; i++) names.push(`arg${i}`)
    return inlineComputation(
        `function wrappedCall(${names.join(', ')}) { return $0($1(${names.join(', ')})) }`,
        [wrapper, stub],
        arity,
    )
}

function liftReturnedHeapValues(
    graph: Graph,
): { graph: Graph, wrapper?: Function } {
    const nodes = new Map<number, GraphNode>(graph.nodes)
    const blocks = graph.blocks.map(b => ({ ...b }))
    const out = { ...graph, nodes }
    setGraphBlocks(out, blocks)
    const applications = new Map<number, number>()
    for (const n of nodes.values()) {
        if (n.op === 'apply') applications.set(getRef(n, 0), (applications.get(getRef(n, 0)) ?? 0) + 1)
    }
    let prototype: intrinsics.Handle | undefined
    let lifted = false

    function replacement(raw: intrinsics.Handle): [number, number] | undefined {
        const handle = heap.deref(raw as intrinsics.Handle)
        if (heap.ownPropertyCount(handle) !== 1) return
        const descriptor = heap.getOwnProperty(handle, addressKey)
        if (!descriptor) return
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
        const boxed = d.slot0 as intrinsics.Handle
        if (!heap.isBoxedF64(boxed)) return
        const proto = heap.getPrototypeOf(handle)
        if (prototype !== undefined && prototype !== proto) return
        prototype = proto
        const value = heap.unboxF64(boxed)
        const id = intrinsics.getNanId(value)
        lifted = true
        return id ? [id, 0] : [0, value]
    }

    const replacements = new Map<number, [number, number]>()
    const walked = new Map<number, boolean>()
    const entered = new Map<number, Set<number>>()
    const incoming = new Map<number, number[]>()
    for (const b of blocks.slice(1)) {
        for (let i = 0; i < b.params.length; i++) {
            const args: number[] = []
            for (const n of nodes.values()) {
                if (n.op === 'apply' && getRef(n, 0) === b.id) args.push(getRef(n, i + 1))
            }
            incoming.set(b.params[i], args)
        }
    }
    const walking = new Set<number>()
    function visit(id: number): boolean {
        if (!id) return false
        const known = walked.get(id)
        if (known !== undefined) return known
        if (walking.has(id)) return true
        walking.add(id)
        defer walking.delete(id)
        const n = nodes.get(id)
        if (!n) return false
        if (intrinsics.argv().includes(`lift-why:${graph.name}`)) {
            console.log(`  LIFT visit %${id} ${n.op}`)
        }
        if (isParam(nodes, id)) {
            const args = incoming.get(id)
            if (!args || !args.length) return false
            const ok = args.every(arg => visit(arg))
            walked.set(id, ok)
            return ok
        }
        let ok = false
        if (n.op === 'heap-handle' && !getRef(n, 0)) {
            const next = replacement(getLiteral(n, 0) as intrinsics.Handle)
            if (next) { replacements.set(id, next); ok = true }
        } else if (n.op === 'after') {
            ok = visit(getRef(n, countIds(n)-1))
        } else if (n.op === 'select') {
            ok = true
            for (let i = 1; i < countIds(n); i++) if (!visit(getRef(n, i))) { ok = false; break }
        } else if (n.op === 'panic' || n.op === 'unreachable') {
            ok = true
        } else if (n.op === 'ret' || n.op === 'inlined') {
            ok = visit(getRef(n, 0))
        } else if (n.op === 'apply') {
            const target = getBlock(out, getRef(n, 0))
            if (target) {
                let users = entered.get(target.id)
                if (!users) entered.set(target.id, users = new Set())
                users.add(id)
                ok = visit(target.bodyId)
            }
        }
        walked.set(id, ok)
        return ok
    }

    let nextId = graph.maxId
    const rewritten = new Map<number, [number, number]>()
    function replaceAll(id: number): [number, number] {
        if (!id) return [id, 0]
        const replacement = replacements.get(id) ?? rewritten.get(id)
        if (replacement) return replacement
        const n = nodes.get(id)
        if (!n || isParam(nodes, id)) return [id, 0]
        const ids = getArgIds(n)
        const edits: [idx: number, id: number, value: number][] = []
        for (let i = 0; i < ids.length; i++) {
            const next = replaceAll(ids[i])
            if (next[0] !== ids[i]) edits.push([i, next[0], next[1]])
        }
        if (!edits.length) return [id, 0]
        const operands = getOperands(n)
        for (const edit of edits) operands[edit[0]] = edit[1] || { literal: edit[2] }
        const copy = nextId++
        nodes.set(copy, copyNode(n, operands))
        rewritten.set(id, [copy, 0])
        return [copy, 0]
    }

    const entry = blocks[0]
    const probe = intrinsics.argv().includes(`lift-why:${graph.name}`)
    if (!visit(entry.bodyId) || !lifted || prototype === undefined) {
        if (probe) console.log(`LIFT-WHY ${graph.name}: spine visit=${visit(entry.bodyId)} lifted=${lifted} proto=${prototype !== undefined}`)
        return { graph }
    }
    for (const [block, callers] of entered) {
        if ((applications.get(block) ?? 0) !== callers.size) {
            if (probe) console.log(`LIFT-WHY ${graph.name}: block %${block} applied ${applications.get(block) ?? 0}x but spine entered ${callers.size}x`)
            return { graph }
        }
    }
    for (const b of blocks) {
        const next = replaceAll(b.bodyId)
        if (next[0] === b.bodyId) continue
        b.bodyId = next[0]
        b.bodyConst = next[1] as f64
    }
    out.maxId = nextId
    return { graph: out, wrapper: makeHeapWrapper(prototype) }
}

interface ReturnedShape {
    value: number
    consumer: number
    at: number
    keys: intrinsics.Handle[]
    fields: Map<number, [id: number, konst: number]>
}

interface ReturnedRecord extends ReturnedShape {
    fn: Function
    symbol: number
    graph: Graph
}

interface ReturnCaller {
    fn: Function
    symbol: number
    graph: Graph
}

function returnedShape(graph: Graph): ReturnedShape | undefined {
    const probe = intrinsics.argv().includes(`shape-why:${graph.name}`)
    function why(reason: string): undefined {
        if (probe) console.log(`SHAPE-WHY ${graph.name}: ${reason}`)
        return undefined
    }
    const entry = graph.blocks[0]
    const body = graph.nodes.get(entry.bodyId)
    if (!body || body.op !== 'ret') return why(`entry body is ${body?.op ?? 'missing'}, not ret`)
    for (const [id, n] of graph.nodes) {
        if (n.op === 'ret' && id !== entry.bodyId) return why(`extra ret %${id}`)
    }
    let consumer = entry.bodyId
    let at = 0
    let value = getRef(body, 0)
    while (const n = graph.nodes.get(value)) {
        if (n.op !== 'after') break
        consumer = value
        at = countIds(n) - 1
        value = getRef(n, at)
    }
    const n = graph.nodes.get(value)
    if (!n || n.op !== 'heap-handle' || getRef(n, 0)) return why(`returned value %${value} is ${n?.op ?? 'missing'}, not a plain heap-handle`)
    let uses = 0
    for (const u of graph.nodes.values()) {
        for (let i = 0; i < countIds(u); i++) if (getRef(u, i) === value) uses++
    }
    if (uses !== 1) return why(`returned heap-handle %${value} has ${uses} uses`)
    const handle = heap.deref(getLiteral(n, 0) as intrinsics.Handle)
    if (!heap.isOrdinaryObject(handle)) return
    const keys: intrinsics.Handle[] = []
    const fields = new Map<number, [id: number, konst: number]>()
    for (let k: u32 = 0; k < heap.ownPropertyCount(handle); k++) {
        const key = heap.ownPropertyKeyAt(handle, k)
        const descriptor = heap.getOwnProperty(handle, key)
        if (!descriptor) return
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
        const boxed = d.slot0 as intrinsics.Handle
        if (!heap.isBoxedF64(boxed)) return
        const unboxed = heap.unboxF64(boxed)
        const id = intrinsics.getNanId(unboxed)
        if (id && !graph.nodes.has(id)) return
        keys.push(key)
        fields.set(key, id ? [id, 0] : [0, unboxed])
    }
    if (!keys.length) return
    return { value, consumer, at, keys, fields }
}

function installReturnRecord(shape: ReturnedRecord, layout: intrinsics.Handle[]): void {
    const graph = shape.graph
    const operands: Operand[] = []
    for (let i = 0; i < layout.length; i++) {
        const field = shape.fields.get(layout[i])!
        operands.push({ literal: i }, field[0] || { literal: field[1] })
    }
    const id = graph.maxId++
    graph.nodes.set(id, makeNode('record', operands))
    setRef(graph.nodes.get(shape.consumer)!, shape.at, id)
    graph.nodes.delete(shape.value)
}

function calleeSymbol(graph: Graph, call: number): number | undefined {
    const n = graph.nodes.get(call)
    if (!n || n.op !== 'call') return
    const target = graph.nodes.get(getRef(n, 1))
    if (!target || target.op !== 'local-target' || getRef(target, 0)) return
    return getLiteral(target, 0)
}

function readsCallResult(graph: Graph, id: number): boolean {
    const n = graph.nodes.get(id)!
    if (n.op !== 'get-prop' || getRef(n, 2)) return false
    return calleeSymbol(graph, getRef(n, 1)) !== undefined
}

function projectsCallResults(graph: Graph): boolean {
    let found = false
    for (const [id, n] of graph.nodes) {
        if (n.op === 'set-prop') return false
        if (n.op !== 'get-prop') continue
        if (!readsCallResult(graph, id)) return false
        found = true
    }
    return found
}

function callSitesOf(graph: Graph, symbol: number): number[] {
    const out: number[] = []
    for (const [id, n] of graph.nodes) {
        if (n.op === 'call' && calleeSymbol(graph, id) === symbol) out.push(id)
    }
    return out
}

function callResultEscapes(graph: Graph, call: number): boolean {
    for (const n of graph.nodes.values()) {
        for (let i = 0; i < countIds(n); i++) {
            if (getRef(n, i) !== call) continue
            if (i === 0 && n.op === 'get') continue
            if (i === 1 && n.op === 'get-prop') continue
            if (i === 0 && (n.op === 'load' || n.op === 'store' || n.op === 'call' || n.op === 'pstack' || n.op === 'get-prop')) continue
            if (n.op === 'after' && i < countIds(n) - 1) continue
            return true
        }
    }
    return false
}

interface InlineScore {
    cost: number
    pressure: number
}

const interpreted = new Set(['ret', 'panic', 'unreachable', 'record', 'get', 'block', 'void', 'apply', 'after', 'inlined', 'trap', 'nil-effect', 'mem', 'join'])
const targets = new Set(['syscall-target', 'local-target', 'pool-entry', 'heap-handle'])

const folding = new Set(['add', 'sub', 'mul', 'div', 'and', 'or', 'xor', 'shl', 'shr', 'ushr', 'lt', 'le', 'gt', 'ge', 'eq', 'ne', 'neg', 'not', 'convert'])

function obviousInline(g: Graph, literals = new Set<number>()): InlineScore | undefined {
    const cost = inlineCost(g, literals)
    return cost !== undefined && cost <= 8 ? { cost, pressure: 0 } : undefined
}

function inlineCost(g: Graph, literals = new Set<number>()): number | undefined {
    if (g.nodes.size > 75) return
    let root = g.blocks[0].bodyId
    const reachable = new Set<number>()
    let code = 0
    function visit(id: number): void {
        if (!id || code > 50) return
        const n = g.nodes.get(id)
        if (!n || n.op === 'param') return
        if (n.op === 'block') {
            if (reachable.has(id)) return
            reachable.add(id)
            visit(getBlock(g, id)!.bodyId)
            return
        }
        if (!countIds(n)) return
        if (targets.has(n.op)) return
        if (reachable.has(id)) return
        reachable.add(id)
        if (!interpreted.has(n.op)) code++
        for (const arg of getArgIds(n)) {
            if (!arg) continue
            visit(arg)
        }
    }
    visit(root)
    if (code > 50) return
    let cost = 0
    const cheap = new Set([
        'load', 'store', 'select', 'ne', 'eq', 'gt', 'lt', 'le', 'ge',
        'add', 'sub', 'div', 'mul', 'and', 'or', 'xor', 'shl', 'shr', 'ushr', 
        'neg', 'not', 'convert', 'bitconvert', 'literal', 'void', 'encode', 'decode', 'box', 'unbox'
    ])
    const canFold = literals.size
    const slots = new Map<number, [block: number, index: number]>()
    const inbound = new Map<number, GraphNode[]>()
    if (canFold) {
        for (const b of g.blocks.slice(1)) b.params.forEach((p, i) => slots.set(p, [b.id, i]))
        for (const id of reachable) {
            const n = g.nodes.get(id)!
            if (n.op !== 'apply') continue
            const list = inbound.get(getRef(n, 0))
            if (list) list.push(n)
            else inbound.set(getRef(n, 0), [n])
        }
    }
    const folds = new Map<number, boolean>()
    function constant(id: number): boolean {
        if (!id || literals.has(id)) return true
        const known = folds.get(id)
        if (known !== undefined) return known
        folds.set(id, false)
        const n = g.nodes.get(id)
        const slot = slots.get(id)
        let result = n?.op === 'literal' || (!!n && folding.has(n.op)) || (!!slot && inbound.has(slot[0]))
        if (slot) for (const app of inbound.get(slot[0]) ?? []) result &&= constant(getRef(app, slot[1] + 1))
        else if (n?.op !== 'literal') for (let i = 0; result && i < countIds(n!); i++) result = constant(getRef(n!, i))
        folds.set(id, result)
        return result
    }
    for (const id of reachable) {
        const n = g.nodes.get(id)!
        if (interpreted.has(n.op)) continue
        if (canFold && n.op !== 'literal' && constant(id)) continue
        if (n.op === 'call' || n.op === 'pstack') {
            cost += 3
            continue
        }
        if (n.op === 'rem' || n.op === 'alloca') {
            cost += 3
            continue
        }
        if (!cheap.has(n.op)) return
        cost += n.op === 'mul' || n.op === 'div' ? 2 : 1
    }
    return cost
}

interface ShapedCallee {
    fn: Function
    symbol: number
    computation: [source: string, captures: any[]]
    mapCapture: (capture: any) => any
}

function snapshotOf(graph: Graph, argId: number): intrinsics.Handle | undefined {
    const arg = graph.nodes.get(argId)
    if (!arg || arg.op !== 'heap-handle') return
    if (countIds(arg) < 2) return
    return getLiteral(arg, 1) as intrinsics.Handle
}

export function fieldShape(slot: intrinsics.Handle): intrinsics.Types {
    if (heap.isBoxedF64(slot)) return Types.f64
    if (heap.isString(slot)) return Types.usize
    return Types.handle
}

function snapshotFields(snapshot: intrinsics.Handle): { key: intrinsics.Handle, shape: intrinsics.Types, slot: intrinsics.Handle }[] {
    const fields: { key: intrinsics.Handle, shape: intrinsics.Types, slot: intrinsics.Handle }[] = []
    for (let k: u32 = 0; k < heap.ownPropertyCount(snapshot); k++) {
        const key = heap.ownPropertyKeyAt(snapshot, k)
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(snapshot, key)))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
        const slot = d.slot0 as intrinsics.Handle
        fields.push({ key, shape: fieldShape(slot), slot })
    }
    return fields
}

export function sameSnapshotShape(a: intrinsics.Handle | undefined, b: intrinsics.Handle | undefined): boolean {
    if (!a || !b) return a === b
    if (heap.typeDescriptorOf(a) !== heap.typeDescriptorOf(b)) return false
    const x = snapshotFields(a)
    const y = snapshotFields(b)
    if (x.length !== y.length) return false
    for (let i = 0; i < x.length; i++) {
        if (x[i].key !== y[i].key || x[i].shape !== y[i].shape) return false
        if (x[i].shape === Types.handle && x[i].slot !== y[i].slot) return false
    }
    return true
}

export interface CreateNativesOptions {
    globals?: Record<string, any>
}

interface PendingUnit {
    fn: Function
    symbol: number
    graph: Graph
}

const panicTrap = intrinsics.argv().includes('panic-trap')

function reportPanic(err: any): void {
    syscalls.write(2, err.message, 1)
    Intrinsics.trap(0)
}
intrinsics.tagNoInline(reportPanic)

const EffectNone = 0
const EffectRead = 1
const EffectWrite = 2
const EffectNames = ['readnone', 'readonly', 'writes']

interface CallWrites { callee: number, args: number[], node: number }

function writeTarget(graph: Graph, m: Mem | undefined): number {
    if (!m) return WritesUnknown
    if (m.kind === MemFresh) return 0
    const k = graph.blocks[0].params.indexOf(m.base)
    return m.kind === MemPre && k >= 0 && k < 29 ? 1 << k : WritesUnknown
}

function calleeWrites(mask: number | undefined, args: number[]): number {
    if (mask === undefined || mask & WritesUnknown) return WritesUnknown
    let out = 0
    for (let j = 0; j < 29; j++) if (mask & (1 << j)) out |= args[j] ?? WritesUnknown
    return out
}

interface Flow { own: boolean, calls: [callee: number, arg: number][] }

function symbolFlow(graph: Graph, flow: MemFlow): Flow {
    return {
        own: flow.own,
        calls: flow.calls.map(([call, k]): [number, number] => {
            const target = graph.nodes.get(getRef(graph.nodes.get(call)!, 1))
            return [target?.op === 'local-target' && !getRef(target, 0) ? getLiteral(target, 0) : -1, k]
        }),
    }
}

function capturedBy(flow: Flow, captures: Map<number, number>): boolean {
    return flow.own || flow.calls.some(([callee, k]) => callee < 0 || k >= 29 || ((captures.get(callee) ?? CapturesAll) & (1 << k)) !== 0)
}

interface RetEffect { value: number | undefined, self: number, writes: number, calls: CallWrites[], through?: number, excludes?: number }

interface GraphEffects { self: number, callees: number[], writes: number, calls: CallWrites[], fresh: boolean, params: Flow[], returned: Flow[], rets: RetEffect[] }

function throughCall(ret: RetEffect): CallWrites | undefined {
    return ret.through === undefined ? undefined : ret.calls.find(c => c.node === ret.through)
}

function outcomesOf(rets: RetEffect[], classes: Map<number, number>, masks: Map<number, number>, outcomeOf: (callee: number) => CallOutcomes | undefined): CallOutcomes {
    const out: CallOutcomes = { other: undefined, literals: new Map(), excluding: new Map() }
    function joined(known: [number, number] | undefined, effect: number, mask: number): [number, number] {
        return known ? [Math.max(known[0], effect), known[1] | mask] : [effect, mask]
    }
    function add(value: number | undefined, effect: number, mask: number, excludes?: number): void {
        if (effect < EffectWrite) mask = 0
        if (value !== undefined) out.literals.set(value, joined(out.literals.get(value), effect, mask))
        else if (excludes !== undefined) out.excluding.set(excludes, joined(out.excluding.get(excludes), effect, mask))
        else out.other = joined(out.other, effect, mask)
    }
    for (const ret of rets) {
        const through = throughCall(ret)
        const inner = through ? outcomeOf(through.callee) : undefined
        let effect = ret.self
        let mask = ret.writes
        for (const call of ret.calls) {
            if (inner && call === through) continue
            const c = classes.get(call.callee)
            effect = Math.max(effect, c ?? EffectWrite)
            if (c === undefined || c === EffectWrite) mask |= calleeWrites(c === undefined ? undefined : masks.get(call.callee), call.args)
        }
        if (!through || !inner) {
            add(ret.value, effect, mask, ret.excludes)
            continue
        }
        for (const [value, [e, m]] of inner.literals) {
            if (value !== ret.excludes) add(value, Math.max(effect, e), mask | calleeWrites(m, through.args))
        }
        for (const [excluded, [e, m]] of inner.excluding) add(undefined, Math.max(effect, e), mask | calleeWrites(m, through.args), excluded)
        if (inner.other) add(undefined, Math.max(effect, inner.other[0]), mask | calleeWrites(inner.other[1], through.args), ret.excludes)
    }
    return out
}

function noteEffect(graph: Graph, mem: MemAnalysis, id: number, n: GraphNode, out: RetEffect): void {
    if (n.op === 'store') {
        out.self = EffectWrite
        out.writes |= writeTarget(graph, mem.access(n))
    } else if (n.op === 'pstack') {
        out.self = EffectWrite
    } else if (n.op === 'load') {
        if (out.self < EffectRead) out.self = EffectRead
    } else if (n.op === 'call') {
        const target = graph.nodes.get(getRef(n, 1))
        if (target && target.op === 'local-target' && !getRef(target, 0)) {
            const args: number[] = []
            for (let i = 3; i < countIds(n); i++) args.push(getRef(n, i) ? writeTarget(graph, mem.of(getRef(n, i))) : WritesUnknown)
            out.calls.push({ callee: getLiteral(target, 0), args, node: id })
        } else {
            out.self = EffectWrite
            out.writes |= WritesUnknown
        }
    }
}

function captureMask(effects: GraphEffects, captures: Map<number, number>): number {
    let mask = 0
    effects.params.forEach((flow, k) => {
        if (k < 29 && capturedBy(flow, captures)) mask |= 1 << k
    })
    return mask
}

function returnsFresh(effects: GraphEffects, captures: Map<number, number>): boolean {
    return effects.fresh && effects.returned.every(flow => !capturedBy(flow, captures))
}

function graphEffects(graph: Graph): GraphEffects {
    let fresh = true
    let returns = 0
    const returned: Flow[] = []
    const mem = memAnalysis(graph)
    const whole: RetEffect = { value: undefined, self: EffectNone, writes: 0, calls: [] }
    for (const [id, n] of graph.nodes) {
        noteEffect(graph, mem, id, n, whole)
        if (n.op !== 'ret') continue
        returns++
        const m = getRef(n, 0) ? mem.of(getRef(n, 0)) : undefined
        if (!m || m.kind !== MemFresh) fresh = false
        else returned.push(symbolFlow(graph, mem.flows(m.base, false)))
    }
    const params = graph.blocks[0].params.map(p => symbolFlow(graph, mem.flows(p, true)))
    const none: RetEffect = { value: undefined, self: EffectNone, writes: 0, calls: [] }
    function chain(roots: number[]): RetEffect {
        const out: RetEffect = { value: undefined, self: EffectNone, writes: 0, calls: [] }
        const seen = new Set<number>()
        const stack = roots.slice()
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = graph.nodes.get(id)
            if (!n || n.op === 'param' || n.op === 'block') continue
            noteEffect(graph, mem, id, n, out)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return out
    }
    function join(a: RetEffect, b: RetEffect): RetEffect {
        const known = new Set(a.calls.map(c => c.node))
        return { value: undefined, self: Math.max(a.self, b.self), writes: a.writes | b.writes, calls: [...a.calls, ...b.calls.filter(c => !known.has(c.node))] }
    }
    function returning(effect: RetEffect, value: RetEffect): RetEffect {
        return { ...effect, value: value.value, excludes: value.excludes, through: value.through }
    }
    const positions = new Map<number, TailPosition[]>()
    for (const b of graph.blocks) positions.set(b.id, tailPositions(graph, b.bodyId))
    interface Arrival { from: number, apply: number, path: SelectPath, roots: number[] }
    const arrivals = new Map<number, Arrival[]>()
    for (const [from, list] of positions) {
        for (const p of list) {
            const n = graph.nodes.get(p.at)!
            if (n.op !== 'apply') continue
            const arrival = { from, apply: p.at, path: p.path, roots: tailRoots(graph, p) }
            const known = arrivals.get(getRef(n, 0))
            if (known) known.push(arrival)
            else arrivals.set(getRef(n, 0), [arrival])
        }
    }
    const entries = new Map<number, RetEffect>()
    const cyclic = new Set<number>()
    for (const scc of stronglyConnected(graph.blocks.map(b => b.id), id => (arrivals.get(id) ?? []).map(a => a.from))) {
        const members = new Set(scc)
        let out = none
        for (const id of scc) {
            for (const a of arrivals.get(id) ?? []) {
                out = join(out, chain(a.roots))
                if (members.has(a.from)) cyclic.add(id)
                else out = join(out, entries.get(a.from)!)
            }
        }
        for (const id of scc) entries.set(id, out)
    }
    const passed = new Map<number, RetEffect[][]>()
    function paramValues(block: number, k: number): RetEffect[] {
        let known = passed.get(block)
        if (!known) passed.set(block, known = [])
        if (known[k]) return known[k]
        const merged = new Map<string, RetEffect>()
        for (const a of arrivals.get(block)!) {
            for (const e of valueAt(a.from, a.path, graph.nodes.get(a.apply)!, k + 1, chain(a.roots))) {
                const key = `${e.value}|${e.excludes}|${e.through}`
                const prior = merged.get(key)
                merged.set(key, prior ? returning(join(prior, e), e) : e)
            }
        }
        return known[k] = [...merged.values()]
    }
    function valueAt(block: number, path: SelectPath, n: GraphNode, at: number, local: RetEffect): RetEffect[] {
        const literal = tailScalar(graph, n, at)
        const ref = literal === undefined ? tailOf(graph, getRef(n, at)) : 0
        const facts: ValueFacts = ref ? valueFacts(graph, path, ref) : {}
        const value = literal ?? facts.is
        const k = value === undefined ? getBlock(graph, block)!.params.indexOf(ref) : -1
        if (k >= 0 && !cyclic.has(block) && arrivals.has(block)) {
            return paramValues(block, k)
                .filter(e => e.value === undefined || e.value !== facts.not)
                .map(e => returning(join(local, e), e.value === undefined && e.excludes === undefined ? { ...e, excludes: facts.not } : e))
        }
        const before = join(local, entries.get(block)!)
        if (value !== undefined) return [returning(before, { ...none, value })]
        const call = graph.nodes.get(ref)?.op === 'call' && !entries.get(block)!.calls.some(c => c.node === ref)
        return [returning(before, { ...none, excludes: facts.not, through: call ? ref : undefined })]
    }
    const rets: RetEffect[] = []
    for (const [id, list] of positions) {
        for (const p of list) {
            const n = graph.nodes.get(p.at)!
            if (n.op === 'ret') rets.push(...valueAt(id, p.path, n, 0, chain(tailRoots(graph, p))))
        }
    }
    return {
        self: whole.self, callees: whole.calls.map(c => c.callee), writes: whole.writes, calls: whole.calls,
        fresh: fresh && returns > 0, params, returned, rets,
    }
}

function refineCallEffects(graph: Graph, classes: Map<number, number>, masks: Map<number, number>, fresh: Set<number>, captures: Map<number, number>, outcomes: Map<number, CallOutcomes>): boolean {
    let refined = false
    for (const [id, n] of graph.nodes) {
        if (n.op !== 'local-target' || getRef(n, 0) || countIds(n) < 2) continue
        const c = classes.get(getLiteral(n, 0)) ?? EffectWrite
        const mask = (c === EffectWrite ? masks.get(getLiteral(n, 0)) ?? WritesUnknown : 0) | (fresh.has(getLiteral(n, 0)) ? ReturnsFresh : 0)
        const captured = captures.get(getLiteral(n, 0)) ?? CapturesAll
        const operands: Operand[] = [getOperand(n, 0), { literal: c }, { literal: mask }, { literal: captured }, ...encodeCallOutcomes(outcomes.get(getLiteral(n, 0)))]
        if (countIds(n) === operands.length && operands.every((x, i) => !i || getLiteral(n, i) === (x as { literal: number }).literal)) continue
        graph.nodes.set(id, copyNode(n, operands))
        refined = true
    }
    return refined
}

function classifyEffects(units: Map<number, Graph>, fresh: Set<number>, captures: Map<number, number>): { classes: Map<number, number>, masks: Map<number, number>, outcomes: Map<number, CallOutcomes> } {
    const classes = new Map<number, number>()
    const masks = new Map<number, number>()
    const own = new Map<number, number>()
    const calls = new Map<number, CallWrites[]>()
    const callers = new Map<number, Set<number>>()
    const summaries = new Map<number, GraphEffects>()
    for (const [symbol, graph] of units) {
        const effects = graphEffects(graph)
        summaries.set(symbol, effects)
        classes.set(symbol, effects.self)
        own.set(symbol, effects.writes)
        masks.set(symbol, effects.writes)
        calls.set(symbol, effects.calls)
        captures.set(symbol, 0)
    }
    for (const [symbol, out] of calls) {
        for (const call of out) {
            let set = callers.get(call.callee)
            if (!set) callers.set(call.callee, set = new Set())
            set.add(symbol)
        }
    }
    const work = [...classes.keys()]
    while (work.length) {
        const symbol = work.pop()!
        let want = classes.get(symbol)!
        let mask = own.get(symbol)!
        for (const call of calls.get(symbol) ?? []) {
            const c = classes.get(call.callee)
            want = Math.max(want, c === undefined ? EffectWrite : c)
            if (c === undefined || c === EffectWrite) mask |= calleeWrites(c === undefined ? undefined : masks.get(call.callee), call.args)
        }
        const captured = captureMask(summaries.get(symbol)!, captures)
        if (want === classes.get(symbol) && mask === masks.get(symbol) && captured === captures.get(symbol)) continue
        classes.set(symbol, want)
        masks.set(symbol, mask)
        captures.set(symbol, captured)
        for (const caller of callers.get(symbol) ?? []) work.push(caller)
    }
    const outcomes = new Map<number, CallOutcomes>()
    function reaches(from: number, to: number): boolean {
        const seen = new Set<number>()
        const stack = [from]
        while (stack.length) {
            const symbol = stack.pop()!
            if (symbol === to) return true
            if (seen.has(symbol)) continue
            seen.add(symbol)
            for (const ret of summaries.get(symbol)?.rets ?? []) {
                const call = throughCall(ret)
                if (call) stack.push(call.callee)
            }
        }
        return false
    }
    function outcomeOf(symbol: number): CallOutcomes | undefined {
        const known = outcomes.get(symbol)
        if (known) return known
        const effects = summaries.get(symbol)
        if (!effects) return
        const result = outcomesOf(effects.rets, classes, masks, callee => reaches(callee, symbol) ? undefined : outcomeOf(callee))
        outcomes.set(symbol, result)
        return result
    }
    for (const [symbol, effects] of summaries) {
        if (returnsFresh(effects, captures)) fresh.add(symbol)
        else fresh.delete(symbol)
        outcomeOf(symbol)
    }
    return { classes, masks, outcomes }
}

function dumpCallShapes(pending: PendingUnit[], functions: Function[], opaque: Map<number, Graph>): void {
    for (const unit of pending) {
        for (const n of unit.graph.nodes.values()) {
            if (n.op !== 'call') continue
            const target = unit.graph.nodes.get(getRef(n, 1))
            if (!target || target.op !== 'local-target') continue
            const callee = functions[getLiteral(target, 0)]?.name
            for (let i = 3; i < countIds(n); i++) {
                const arg = unit.graph.nodes.get(getRef(n, i))
                if (!arg || arg.op !== 'heap-handle') continue
                if (countIds(arg) < 2) continue
                const snapshot = getLiteral(arg, 1) as intrinsics.Handle
                const fields: string[] = []
                let operand = 2
                for (let k: u32 = 0; k < heap.ownPropertyCount(snapshot); k++) {
                    const key = heap.ownPropertyKeyAt(snapshot, k)
                    const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(snapshot, key)))
                    if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
                    const id = getRef(arg, operand++)
                    const mark = !id ? '' : unit.graph.nodes.has(id) ? '*' : '!'
                    fields.push(`${heap.stringToJs(key)}${mark}`)
                }
                const proto = heap.getPrototypeOf(snapshot)
                console.log('native shape', unit.fn.name, '->', callee, `p${i - 3}`, `proto ${proto}`, `{ ${fields.join(', ')} }`)
            }
        }
    }
    for (const [symbol, graph] of opaque) {
        const reads = new Set<string>()
        const rootBlock = graph.blocks[0]
        for (const n of graph.nodes.values()) {
            if (n.op !== 'get-prop') continue
            reads.add(`p${rootBlock.params.indexOf(getRef(n, 1))}.${heap.stringToJs(getLiteral(n, 2) as intrinsics.Handle)}`)
        }
        console.log('native reads', functions[symbol]?.name, [...reads].join(', '))
    }
}

function rewriteTargets(
    g: Graph,
    functionHandles: Map<number, number>,
    dataHandles: Map<number, number>,
    runtimeTargets: Map<number, number>,
): Graph {
    const nodes = new Map<number, GraphNode>()
    let maxId = g.maxId
    for (const [id, n] of g.nodes) {
        if (n.op === 'call') {
            const target = g.nodes.get(getRef(n, 1))
            if (target?.op === 'heap-handle' && !functionHandles.has(heap.deref(getLiteral(target, 0) as intrinsics.Handle))) {
                console.log(dumpGraph(g))
                throw `native: ${g.name ?? 'anonymous graph'} calls heap handle ${heap.deref(getLiteral(target, 0) as intrinsics.Handle)} at %${id}, which has no native target`
            }
        }
        if (n.op === 'rt' && runtimeTargets.has(getLiteral(n, 1))) {
            const target = maxId++
            nodes.set(target, makeNode('local-target', [{ literal: runtimeTargets.get(getLiteral(n, 1))! }, { literal: EffectWrite }], Types.u32))
            nodes.set(id, makeNode('call', [getOperand(n, 0), target, 0, ...getOperands(n).slice(2)]))
            continue
        }
        if (n.op === 'rt') {
            nodes.set(id, rt.lowerNative(n, {
                runtimeHeapBase,
                add: node => {
                    const fresh = maxId++
                    nodes.set(fresh, node)
                    return fresh
                },
            }))
            continue
        }
        if (n.op !== 'heap-handle') {
            nodes.set(id, n)
            continue
        }
        const handle = heap.deref(getLiteral(n, 0) as intrinsics.Handle)
        if (!getRef(n, 0) && mirroredCells.has(handle)) {
            nodes.set(id, makeNode('literal', [{ literal: handle }], Types.u32))
            continue
        }
        const functionSlot = functionHandles.get(handle)
        const slot = functionSlot ?? dataHandles.get(handle)
        if (getRef(n, 0) || slot === undefined) {
            throw `native: unresolved heap handle ${handle} in ${g.name ?? 'anonymous graph'} at %${id}`
        }
        nodes.set(id, makeNode('pool-entry', [{ literal: slot }]))
    }
    const graph = { ...g, nodes, maxId }
    setGraphBlocks(graph, g.blocks.map(b => ({ ...b, params: b.params.slice() })))
    return graph
}

function align(value: number, amount: number): number {
    return (value + amount - 1) & -amount
}

function patchImage(
    image: Uint8Array,
    base: number | bigint,
    units: NativeUnit[],
    offsets: number[],
    poolOffset: number,
    localPoolTargets: Map<number, number>,
    stringPoolTargets: Map<number, number>,
    dataOffset: number,
    dataRelocations: [at: number, target: number][],
): void {
    const view = new DataView(image.buffer, image.byteOffset, image.byteLength)
    const imageBase = BigInt(base)
    for (const [slot, symbol] of localPoolTargets) {
        const targetOffset = offsets[symbol]
        if (targetOffset === undefined) throw `native: unknown pooled local function ${symbol}`
        view.setBigUint64(poolOffset + slot * 8, imageBase + BigInt(targetOffset), true)
    }
    for (const [slot, at] of stringPoolTargets) {
        view.setBigUint64(poolOffset + slot * 8, imageBase + BigInt(dataOffset + at), true)
    }
    for (const [at, target] of dataRelocations) {
        view.setBigUint64(dataOffset + at, imageBase + BigInt(dataOffset + target), true)
    }
    for (let i = 0; i < units.length; i++) {
        const unit = units[i]
        for (const relocation of unit.code.relocations) {
            const offset = offsets[unit.symbol] + relocation.offset
            const pc = imageBase + BigInt(offset)
            if (relocation.kind === 'pool') {
                unit.code.target.relocate(view, offset, pc, relocation.kind, imageBase + BigInt(poolOffset + relocation.target * 8))
                continue
            }
            const targetOffset = offsets[relocation.target]
            if (targetOffset === undefined) throw `native: unknown local function ${relocation.target} called from ${unit.name}`
            unit.code.target.relocate(view, offset, pc, relocation.kind, imageBase + BigInt(targetOffset))
        }
    }
}

function installImage(
    units: NativeUnit[],
    values: (number | bigint)[],
    localPoolTargets: Map<number, number>,
    stringPoolTargets: Map<number, number>,
    stringBytes: Uint8Array,
    dataRelocations: [at: number, target: number][],
) {
    const offsets: number[] = []
    let length = 0
    for (const unit of units) {
        length = align(length, 16)
        offsets[unit.symbol] = length
        length += unit.code.bytes.length
    }
    const poolOffset = align(length, 8)
    length = poolOffset + values.length * 8
    const dataOffset = align(length, 8)
    length = dataOffset + stringBytes.length
    const image = new Uint8Array(length)
    for (const unit of units) image.set(unit.code.bytes, offsets[unit.symbol])
    image.set(stringBytes, dataOffset)
    const view = new DataView(image.buffer)
    for (let i = 0; i < values.length; i++) {
        view.setBigUint64(poolOffset + i * 8, BigInt.asUintN(64, BigInt(values[i])), true)
    }
    const reserved = reserveCode(image.byteLength)
    if (intrinsics.argv().includes('native-map')) for (const unit of units) console.log(`native map 0x${(BigInt(reserved.ptr) + BigInt(offsets[unit.symbol])).toString(16)} +${unit.code.bytes.length} ${unit.name}`)
    patchImage(image, reserved.ptr, units, offsets, poolOffset, localPoolTargets,
        stringPoolTargets, dataOffset, dataRelocations)
    const src = (ts as any).getArrayBufferPtr(image.buffer)
    if (!nativeCopier(reserved.ptr, src, image.byteLength)) throw 'failed to copy native image'
    const entries = offsets.map(offset => addPtr(reserved.ptr, offset))
    return {
        entries,
        page: reserved.page,
        image,
        poolOffset,
    }
}

interface PhaseClock {
    start: number
    phases: Record<string, number>
    enterPhase(next: string): string
    timed<T>(next: string, run: () => T): T
    normalize(graph: Graph, opts?: { firstPass?: boolean }): Graph
}

function createClock(target: Target): PhaseClock {
    const start = performance.now()
    const phases: Record<string, number> = { trace: 0, close: 0, normalize: 0, reconcile: 0, inline: 0, effects: 0, records: 0, lower: 0, other: 0 }
    let phase = 'other'
    let last = start
    function enterPhase(next: string): string {
        const now = performance.now()
        phases[phase] += now - last
        last = now
        const outer = phase
        phase = next
        return outer
    }
    function timed<T>(next: string, run: () => T): T {
        const outer = enterPhase(next)
        const result = run()
        enterPhase(outer)
        return result
    }
    function normalize(graph: Graph, opts?: { firstPass?: boolean }): Graph {
        return timed('normalize', () => normalizeValueGraph(graph, { ...opts, target }))
    }
    return { start, phases, enterPhase, timed, normalize }
}

function createImage() {
    const values: (number | bigint)[] = []
    const labels = new Map<number, string>()
    const bytes: number[] = []
    const byteTargets = new Map<number, number>()
    const functionTargets = new Map<number, number>()
    const relocations: [at: number, target: number][] = []
    const functionHandles = new Map<number, number>()
    const dataHandles = new Map<number, number>()
    const runtime = new Map<number, number>()
    const pooled = new Map<PoolValue, number>()
    const pointers = new Map<number, number>()
    const strings = new Map<string, number>()
    const constructions = new Map<number, number>()
    const functions = new Map<number, number>()
    function valueSlot(value: PoolValue): number {
        const known = pooled.get(value)
        if (known !== undefined) return known
        const slot = values.length
        pooled.set(value, slot)
        values.push(value.value)
        labels.set(slot, `0x${value.value.toString(16)}`)
        return slot
    }
    function pointerSlot(ptr: number, label?: string): number {
        const known = pointers.get(ptr)
        if (known !== undefined) return known
        const slot = values.length
        values.push(ptr)
        pointers.set(ptr, slot)
        if (label) labels.set(slot, label)
        return slot
    }
    function stringSlot(text: string): number {
        const known = strings.get(text)
        if (known !== undefined) return known
        const at = bytes.length
        for (const byte of new TextEncoder().encode(text)) bytes.push(byte)
        bytes.push(0)
        const slot = values.length
        values.push(0)
        labels.set(slot, JSON.stringify(text.length > 24 ? `${text.slice(0, 24)}...` : text))
        strings.set(text, slot)
        byteTargets.set(slot, at)
        return slot
    }
    function dataBlock(data: Uint8Array): number {
        while (bytes.length % 8) bytes.push(0)
        const at = bytes.length
        for (const byte of data) bytes.push(byte)
        return at
    }
    function constructionSlot(cell: number, graph: Graph): number {
        const known = constructions.get(cell)
        if (known !== undefined) return known
        const at = placeConstruction(cell, graph)
        const slot = values.length
        values.push(0)
        labels.set(slot, `construction @${cell}`)
        byteTargets.set(slot, at)
        constructions.set(cell, slot)
        return slot
    }
    function hasFunctionSlot(symbol: number): boolean {
        return functions.has(symbol)
    }
    function functionSlot(symbol: number, name: string): number {
        const known = functions.get(symbol)
        if (known !== undefined) return known
        const slot = values.length
        values.push(0)
        labels.set(slot, `fn ${name}`)
        functions.set(symbol, slot)
        functionTargets.set(slot, symbol)
        return slot
    }
    function placeConstruction(cell: number, graph: Graph): number {
        const fail = (why: string): never => { throw `native: construction @${cell} cannot be placed in read-only memory: ${why}` }
        if (graph.blocks.length !== 1) fail(`its graph has ${graph.blocks.length} blocks`)
        function allocation(id: number): number {
            let n = graph.nodes.get(id)
            while (n?.op === 'after') {
                id = getRef(n, countIds(n) - 1)
                n = graph.nodes.get(id)
            }
            return n?.op === 'pstack' ? id : 0
        }
        const buffers = new Map<number, Uint8Array>()
        const stores: number[] = []
        for (const [id, n] of graph.nodes) {
            if (n.op === 'pstack') {
                if (getRef(n, 2) || getLiteral(n, 2) || getRef(n, 3)) fail(`%${id} is not a fixed-size allocation`)
                buffers.set(id, new Uint8Array(getLiteral(n, 3)))
            } else if (n.op === 'store') stores.push(id)
            else if (n.op === 'call' || n.op === 'load' || n.op === 'set-prop' || n.op === 'get-prop') fail(`it performs ${n.op} %${id}`)
        }
        const pointers: [buffer: number, offset: number, target: number][] = []
        for (const id of stores.sort((a, b) => a - b)) {
            const n = graph.nodes.get(id)!
            const buffer = allocation(getRef(n, 1))
            if (!buffer || getRef(n, 2)) fail(`store %${id} has no fixed address`)
            const width = intrinsics.intrinsicBitWidth(typeOf(n)) / 8
            const offset = getLiteral(n, 2)
            if (getRef(n, 3)) {
                const target = allocation(getRef(n, 3))
                if (!target || width !== 8) fail(`store %${id} writes a value that is not a 64-bit pointer to an allocation`)
                pointers.push([buffer, offset, target])
                continue
            }
            const view = new DataView(buffers.get(buffer)!.buffer)
            const value = getLiteral(n, 3)
            if (typeOf(n) === Types.f64) view.setFloat64(offset, value, true)
            else if (!Number.isInteger(value)) fail(`store %${id} writes ${value}, which is not an integer`)
            else for (let i = 0; i < width; i++) view.setUint8(offset + i, Number(BigInt.asUintN(8, BigInt(value) >> BigInt(i * 8))))
        }
        const buffersAt = new Map<number, number>()
        for (const [id, bytes] of buffers) buffersAt.set(id, dataBlock(bytes))
        for (const [buffer, offset, target] of pointers) relocations.push([buffersAt.get(buffer)! + offset, buffersAt.get(target)!])
        const placed = new Map<number, number>()
        const placing = new Set<number>()
        function placeObject(handle: intrinsics.Handle): number {
            const known = placed.get(handle)
            if (known !== undefined) return known
            if (placing.has(handle)) fail(`object @${handle} contains itself`)
            placing.add(handle)
            const target = heap.isIndirect(handle) ? heap.indirectTarget(handle) : handle
            const keys = propertyEval.dataKeys(target)
            const bytes = new Uint8Array(keys.length * 8)
            const view = new DataView(bytes.buffer)
            const fields: [offset: number, target: number][] = []
            for (let i = 0; i < keys.length; i++) {
                const slot = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, keys[i]))).slot0 as intrinsics.Handle
                if (heap.isBoxedF64(slot)) {
                    const raw = heap.unboxF64(slot)
                    const id = intrinsics.getNanId(raw)
                    if (id) {
                        const allocated = allocation(id)
                        if (!allocated) fail(`field ${heap.stringToJs(keys[i])} holds %${id}, which is not an allocation`)
                        fields.push([i * 8, buffersAt.get(allocated)!])
                    } else if (Number.isInteger(raw)) view.setBigUint64(i * 8, BigInt.asUintN(64, BigInt(raw)), true)
                    else fail(`field ${heap.stringToJs(keys[i])} holds ${raw}, which is not an integer`)
                } else if (slot && heap.isOrdinaryObject(heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot)) {
                    fields.push([i * 8, placeObject(slot)])
                } else fail(`field ${heap.stringToJs(keys[i])} holds an unsupported value`)
            }
            placing.delete(handle)
            const at = dataBlock(bytes)
            for (const [offset, into] of fields) relocations.push([at + offset, into])
            placed.set(handle, at)
            return at
        }
        return placeObject(cell as intrinsics.Handle)
    }
    return {
        values, labels, bytes, byteTargets, functionTargets, relocations, functionHandles, dataHandles, runtime,
        valueSlot, pointerSlot, stringSlot, constructionSlot, hasFunctionSlot, functionSlot,
    }
}

type ProgramImage = ReturnType<typeof createImage>

interface ProgramGraph {
    units: Map<number, Graph>
    roots: Map<string, number>
    noInline: Set<number>
    image: ProgramImage
    target: Target
}

interface ProgramUnit {
    symbol: number
    graph: Graph
}

function programUnits(program: ProgramGraph): Map<number, ProgramUnit> {
    const units = new Map<number, ProgramUnit>()
    for (const [symbol, graph] of program.units) units.set(symbol, { symbol, graph })
    return units
}

function countCallSites(program: ProgramGraph): Map<number, number> {
    const callSites = new Map<number, number>()
    for (const graph of program.units.values()) {
        for (const n of graph.nodes.values()) {
            const symbol = calledSymbol(graph, n)
            if (symbol !== undefined) callSites.set(symbol, (callSites.get(symbol) ?? 0) + 1)
        }
    }
    return callSites
}

function snapshotGraph(graph: Graph): Graph {
    const nodes = new Map<number, GraphNode>()
    for (const [id, n] of graph.nodes) nodes.set(id, copyNode(n))
    const out = { ...graph, nodes }
    setGraphBlocks(out, graph.blocks.map(b => ({ ...b, params: b.params.slice() })))
    return out
}

const callEffects = !intrinsics.argv().includes('no-call-effects')

function reachable(graph: Graph): GraphNode[] | undefined {
    const seen = new Set<number>()
    const found: GraphNode[] = []
    for (const b of graph.blocks) {
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? graph.nodes.get(id) : undefined
            if (!n || seen.has(id) || n.op === 'block') continue
            if (n.op === 'alloca' || n.op === 'frame-address') return
            seen.add(id)
            found.push(n)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    return found
}
function splice(graph: Graph, call: number, callee: Graph, freshId: (graph: Graph) => number): void {
    const n = graph.nodes.get(call)!
    const args = new Map<number, number>()
    callee.blocks[0].params.forEach((p, i) => {
        let arg = getRef(n, 3 + i)
        if (!arg) {
            arg = freshId(graph)
            graph.nodes.set(arg, makeNode('literal', [{ literal: getLiteral(n, 3 + i) }]))
        }
        args.set(p, arg)
    })
    const blocks = new Map<number, number>()
    for (const b of callee.blocks.slice(1)) {
        const id = freshId(graph)
        graph.nodes.set(id, makeNode('block', []))
        blocks.set(b.id, id)
    }
    function copier(entry: boolean): (id: number) => number {
        const copies = new Map<number, number>(entry ? args : [])
        function copy(id: number): number {
            const known = copies.get(id) ?? blocks.get(id)
            if (known !== undefined) return known
            const m = callee.nodes.get(id)!
            let fresh = entry && m.op === 'nil-effect' && !countLiterals(m) ? getRef(n, 0) : 0
            if (!fresh) {
                fresh = freshId(graph)
                const copied = copyNode(m, getOperands(m).map(x => typeof x === 'number' ? copy(x) : x))
                if (m.op === 'nil-effect' && countLiterals(m)) setLiteral(copied, 0, blocks.get(getLiteral(m, 0)) ?? getLiteral(m, 0))
                if (typeRefOf(m)) setType(copied, { ref: copy(typeRefOf(m)) })
                graph.nodes.set(fresh, copied)
            }
            copies.set(id, fresh)
            return fresh
        }
        return copy
    }
    const traced = callee.form === undefined ? copier(true) : undefined
    for (const b of callee.blocks.slice(1)) {
        const copy = traced ?? copier(false)
        addGraphBlock(graph, { ...b, id: blocks.get(b.id)!, params: b.params.map(copy), bodyId: copy(b.bodyId) })
    }
    let body = (traced ?? copier(true))(callee.blocks[0].bodyId)
    const token = getRef(n, 0)
    if (token) {
        const ordered = freshId(graph)
        graph.nodes.set(ordered, makeNode('after', [token, body]))
        body = ordered
    }
    graph.nodes.set(call, makeNode('inlined', [body, { literal: call }]))
}
function literalParams(source: Graph, call: GraphNode, callee: Graph): Set<number> {
    const out = new Set<number>()
    callee.blocks[0].params.forEach((p, k) => {
        const ref = getRef(call, 3 + k)
        if (3 + k < countIds(call) && (!ref || source.nodes.get(ref)?.op === 'literal')) out.add(p)
    })
    return out
}
function calledSymbol(source: Graph, n: GraphNode): number | undefined {
    if (n.op !== 'call') return
    const target = source.nodes.get(getRef(n, 1))
    if (target?.op !== 'local-target' || getRef(target, 0)) return
    return getLiteral(target, 0)
}
function inlines(callSites: Map<number, number>, roots: Map<string, number>, caller: Graph, source: Graph, id: number, callee: ProgramUnit, heat = 0): boolean {
    if (!reachable(callee.graph)) return false
    const cost = inlineCost(callee.graph, literalParams(source, source.nodes.get(id)!, callee.graph))
    const neutral = cost !== undefined && cost <= 8
    const sole = callSites.get(callee.symbol) === 1 && ![...roots.values()].includes(callee.symbol)
    const growth = cost !== undefined && cost <= 8 + callee.graph.blocks[0].params.length && heat >= 6
    if (!neutral && !sole && !growth) return false
    const only = intrinsics.argv().filter(a => a.startsWith('inline-only:')).map(a => a.slice(12))
    if (only.length && !only.includes(callee.graph.name ?? '')) return false
    if (intrinsics.argv().includes('inline-debug')) console.log('INLINE', caller.name, '<-', callee.graph.name, `%${id}`, neutral ? cost : sole ? 'sole' : `growth ${cost} heat ${heat}`)
    return true
}

function siteTarget(program: ProgramGraph, graph: Graph, n: GraphNode): number | undefined {
    if (n.op === 'call') return calledSymbol(graph, n)
    if (n.op === 'rt') return program.image.runtime.get(getLiteral(n, 1))
    if (n.op !== 'heap-handle' || getRef(n, 0)) return
    const slot = program.image.functionHandles.get(heap.deref(getLiteral(n, 0) as intrinsics.Handle))
    return slot === undefined ? undefined : program.image.functionTargets.get(slot)
}

function programLevels(program: ProgramGraph): Map<number, number> {
    const incoming = new Map<number, [caller: number, depth: number][]>()
    const callees = new Map<number, number[]>()
    for (const [symbol, graph] of program.units) {
        const { loopDepth } = graphLoops(graph)
        const out: number[] = []
        callees.set(symbol, out)
        for (const b of graph.blocks) {
            const depth = loopDepth.get(b.id) ?? 0
            const seen = new Set<number>()
            const stack = [b.bodyId]
            while (stack.length) {
                const id = stack.pop()!
                const n = id ? graph.nodes.get(id) : undefined
                if (!n || seen.has(id) || n.op === 'block') continue
                seen.add(id)
                for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
                const callee = siteTarget(program, graph, n)
                if (callee === undefined || !program.units.has(callee)) continue
                out.push(callee)
                if (!incoming.has(callee)) incoming.set(callee, [])
                incoming.get(callee)!.push([symbol, depth])
            }
        }
    }
    const levels = new Map<number, number>()
    for (const scc of stronglyConnected(program.units.keys(), symbol => callees.get(symbol)!).reverse()) {
        const members = new Set(scc)
        let level = 0
        for (const symbol of scc) {
            for (const [caller, depth] of incoming.get(symbol) ?? []) if (!members.has(caller)) level = Math.max(level, levels.get(caller)! + depth)
        }
        for (const symbol of scc) levels.set(symbol, level)
    }
    if (intrinsics.argv().includes('native-levels')) {
        console.log('native levels', [...levels].sort((a, b) => b[1] - a[1]).map(([symbol, level]) => `${program.units.get(symbol)!.name}=${level}`).join(' '))
    }
    return levels
}

function anchorBlockNils(graph: Graph): void {
    for (const b of graph.blocks.slice(1)) {
        const nil = graph.maxId++
        graph.nodes.set(nil, makeNode('nil-effect', [{ literal: b.id }]))
        const memo = new Map<number, number>()
        function rewrite(id: number): number {
            if (!id) return id
            const known = memo.get(id)
            if (known !== undefined) return known
            const n = graph.nodes.get(id)
            if (!n || n.op === 'block' || n.op === 'param') return id
            if (n.op === 'nil-effect' && !countLiterals(n)) return nil
            memo.set(id, id)
            let copy: GraphNode | undefined
            for (let i = 0; i < countIds(n); i++) {
                const ref = rewrite(getRef(n, i))
                if (ref === getRef(n, i)) continue
                copy ??= copyNode(n)
                setRef(copy, i, ref)
            }
            if (!copy) return id
            const fresh = graph.maxId++
            graph.nodes.set(fresh, copy)
            memo.set(id, fresh)
            return fresh
        }
        b.bodyId = rewrite(b.bodyId)
    }
}

function siteDepths(graph: Graph): Map<number, number> {
    const { loopDepth } = graphLoops(graph)
    const depths = new Map<number, number>()
    for (const b of graph.blocks) {
        const depth = loopDepth.get(b.id) ?? 0
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? graph.nodes.get(id) : undefined
            if (!n || n.op === 'block' || (depths.get(id) ?? -1) >= depth) continue
            depths.set(id, depth)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    return depths
}

function inlineProgram(program: ProgramGraph, clock: PhaseClock): void {
    for (const graph of program.units.values()) sweepBlocks(graph)
    const units = programUnits(program)
    const callSites = countCallSites(program)
    const levels = programLevels(program)
    const inlined = new Map<number, boolean>()
    function visit(unit: ProgramUnit): void {
        if (inlined.has(unit.symbol)) return
        inlined.set(unit.symbol, false)
        const graph = snapshotGraph(unit.graph)
        const depths = siteDepths(graph)
        let changed = false
        for (const [id, n] of [...graph.nodes]) {
            const symbol = calledSymbol(graph, n)
            if (symbol === undefined) continue
            const callee = units.get(symbol)
            if (!callee || callee === unit || program.noInline.has(symbol)) continue
            visit(callee)
            if (!inlined.get(symbol)) continue
            if (!inlines(callSites, program.roots, unit.graph, graph, id, callee, (levels.get(unit.symbol) ?? 0) + (depths.get(id) ?? 0))) continue
            splice(graph, id, callee.graph, g => g.maxId++)
            changed = true
        }
        if (changed) {
            anchorBlockNils(graph)
            graph.form = undefined
            unit.graph = clock.normalize(graph)
        }
        inlined.set(unit.symbol, true)
    }
    for (const unit of units.values()) visit(unit)
    for (const unit of units.values()) program.units.set(unit.symbol, unit.graph)
}

function prune(program: ProgramGraph): void {
    const reached = reachUnits(program)
    for (const symbol of [...program.units.keys()]) if (!reached.has(symbol)) program.units.delete(symbol)
}

function refineProgramEffects(program: ProgramGraph, clock: PhaseClock): void {
    const passFresh = new Set<number>()
    const passCaptures = new Map<number, number>()
    const effectSummary = classifyEffects(program.units, passFresh, passCaptures)
    const effectClasses = effectSummary.classes
    if (intrinsics.argv().includes('native-effects')) {
        const counts = [0, 0, 0]
        let argOnly = 0
        for (const [symbol, c] of effectClasses) {
            counts[c]++
            const mask = effectSummary.masks.get(symbol) ?? WritesUnknown
            if (c === EffectWrite && mask & WritesUnknown) continue
            if (c === EffectWrite) argOnly++
            const params: number[] = []
            for (let k = 0; k < 29; k++) if (mask & (1 << k)) params.push(k)
            const captured = passCaptures.get(symbol) ?? CapturesAll
            const kept: number[] = []
            for (let k = 0; k < 29; k++) if (captured & (1 << k)) kept.push(k)
            const outcomes = effectSummary.outcomes.get(symbol)
            const cases = outcomes ? [...outcomes.literals].map(([v, [e]]) => ` ${v}:${EffectNames[e]}`).join('')
                + [...outcomes.excluding].map(([v, [e]]) => ` !=${v}:${EffectNames[e]}`).join('')
                + (outcomes.other ? ` other:${EffectNames[outcomes.other[0]]}` : '') : ''
            const what = (c === EffectWrite ? `writes p${params.join(',p') || ' none'}` : EffectNames[c]) + (cases ? ` returns${cases}` : '')
                + (passFresh.has(symbol) ? ' returns fresh' : '')
                + (captured === CapturesAll ? '' : ` captures ${kept.length ? 'p' + kept.join(',p') : 'none'}`)
            console.log('native effects', what, program.units.get(symbol)?.name || `symbol ${symbol}`)
        }
        console.log('native effects writes-args-only', argOnly)
        console.log('native effects total', EffectNames.map((n, i) => `${n}=${counts[i]}`).join(' '))
    }
    for (const [symbol, graph] of program.units) {
        if (callEffects && refineCallEffects(graph, effectClasses, effectSummary.masks, passFresh, passCaptures, effectSummary.outcomes)) graph.form = 'packaged'
        if (graph.form === 'packaged') program.units.set(symbol, clock.timed('normalize', () => optimizePackaged(graph, program.target)))
    }
}

function reachUnits(program: ProgramGraph): Set<number> {
    const reached = new Set<number>()
    const reaching = [...program.roots.values()]
    while (reaching.length) {
        const symbol = reaching.pop()!
        if (reached.has(symbol)) continue
        reached.add(symbol)
        const graph = program.units.get(symbol)
        if (!graph) continue
        const seen = new Set<number>()
        const stack = graph.blocks.map(b => b.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? graph.nodes.get(id) : undefined
            if (!n || seen.has(id)) continue
            seen.add(id)
            if (n.op === 'block') {
                stack.push(getBlock(graph, id)?.bodyId ?? 0)
                continue
            }
            if (n.op === 'local-target' && !getRef(n, 0)) reaching.push(getLiteral(n, 0))
            if (n.op === 'rt' && program.image.runtime.has(getLiteral(n, 1))) reaching.push(program.image.runtime.get(getLiteral(n, 1))!)
            if (n.op === 'heap-handle' && !getRef(n, 0)) {
                const slot = program.image.functionHandles.get(heap.deref(getLiteral(n, 0) as intrinsics.Handle))
                const target = slot === undefined ? undefined : program.image.functionTargets.get(slot)
                if (target !== undefined) reaching.push(target)
            }
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    return reached
}

function recordReturns(program: ProgramGraph, reached: Set<number>, clock: PhaseClock): void {
    const units = programUnits(program)
    const callSites = countCallSites(program)
    interface Index {
        users: Map<number, [number, number][]>
        owner: Map<number, [block: number, index: number]>
        applies: Map<number, number[]>
        rets: number[]
        calls: Map<number, number[]>
    }
    interface Flow {
        source: Map<number, number>
        reads: Map<number, number>
        accesses: Map<number, intrinsics.Types>
        exits: [user: number, slot: number][]
        accessed: Set<number>
        blocked?: string
    }
    const debug = intrinsics.argv().includes('record-returns')
    const live = [...units.values()].filter(u => reached.has(u.symbol))
    const pinned = new Set<number>([...program.roots.values(), ...program.image.runtime.values()])
    const ordered = new Set(['load', 'store', 'call', 'pstack', 'alloca', 'rt'])
    const indexes = new Map<number, Index>()
    function indexOf(unit: ProgramUnit): Index {
        const known = indexes.get(unit.symbol)
        if (known) return known
        const g = unit.graph
        const index: Index = { users: new Map(), owner: new Map(), applies: new Map(), rets: [], calls: new Map() }
        for (const b of g.blocks.slice(1)) b.params.forEach((p, i) => index.owner.set(p, [b.id, i]))
        const seen = new Set<number>()
        const stack = g.blocks.map(b => b.bodyId)
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? g.nodes.get(id) : undefined
            if (!n || seen.has(id) || n.op === 'block') continue
            seen.add(id)
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref) continue
                const list = index.users.get(ref)
                if (list) list.push([id, i])
                else index.users.set(ref, [[id, i]])
                stack.push(ref)
            }
            if (n.op === 'ret') index.rets.push(id)
            if (n.op === 'heap-handle' && !getRef(n, 0)) {
                const slot = program.image.functionHandles.get(heap.deref(getLiteral(n, 0) as intrinsics.Handle))
                const target = slot === undefined ? undefined : program.image.functionTargets.get(slot)
                if (target !== undefined) pinned.add(target)
            }
            if (n.op === 'apply') {
                const list = index.applies.get(getRef(n, 0))
                if (list) list.push(id)
                else index.applies.set(getRef(n, 0), [id])
            }
            const target = n.op === 'call' ? g.nodes.get(getRef(n, 1)) : undefined
            if (target?.op === 'local-target' && !getRef(target, 0)) {
                const list = index.calls.get(getLiteral(target, 0))
                if (list) list.push(id)
                else index.calls.set(getLiteral(target, 0), [id])
            }
        }
        indexes.set(unit.symbol, index)
        return index
    }
    function allocation(n: GraphNode | undefined) {
        return n?.op === 'pstack' && !getRef(n, 2) && !getLiteral(n, 2) && (!!getRef(n, 3) || getLiteral(n, 3) > 0)
    }
    function returnedAllocation(unit: ProgramUnit): number | undefined {
        const g = unit.graph
        const index = indexOf(unit)
        if (!index.rets.length) return
        let id = getRef(g.nodes.get(index.rets[0])!, 0)
        const seen = new Set<number>()
        while (id && !seen.has(id)) {
            seen.add(id)
            const n = g.nodes.get(id)!
            if (allocation(n)) return id
            if (n.op === 'after') id = getRef(n, countIds(n) - 1)
            else if (n.op === 'encode') id = getRef(n, 0)
            else if (n.op === 'param' && index.owner.has(id)) {
                const [block, at] = index.owner.get(id)!
                const arrival = index.applies.get(block)?.[0]
                id = arrival ? getRef(g.nodes.get(arrival)!, at + 1) : 0
            } else return
        }
    }
    function flow(unit: ProgramUnit, roots: number[], callee: boolean): Flow {
        const g = unit.graph
        const index = indexOf(unit)
        const f: Flow = { source: new Map(), reads: new Map(), accesses: new Map(), exits: [], accessed: new Set() }
        const work: number[] = []
        function alias(id: number, source: number): void {
            if (f.source.has(id)) return
            f.source.set(id, source)
            work.push(id)
        }
        for (const root of roots) alias(root, root)
        while (work.length && !f.blocked) {
            const v = work.pop()!
            const source = f.source.get(v)!
            for (const [u, slot] of index.users.get(v) ?? []) {
                const n = g.nodes.get(u)!
                if (slot === 0 && ordered.has(n.op)) continue
                if (n.op === 'after') {
                    if (slot === countIds(n) - 1) alias(u, source)
                    continue
                }
                if ((n.op === 'load' || (callee && n.op === 'store')) && slot === 1 && !getRef(n, 2)) {
                    const known = f.accesses.get(getLiteral(n, 2))
                    if (known !== undefined && known !== typeOf(n)) f.blocked = 'field-type'
                    f.accesses.set(getLiteral(n, 2), typeOf(n))
                    f.accessed.add(source)
                    if (!callee) f.reads.set(u, getLiteral(n, 2))
                    continue
                }
                if (n.op === (callee ? 'encode' : 'decode') && slot === 0) {
                    alias(u, source)
                    continue
                }
                if (n.op === 'apply' && slot > 0 && getRef(n, 0) !== g.blocks[0].id) {
                    const param = getBlock(g, getRef(n, 0))!.params[slot - 1]
                    alias(param, param)
                    f.exits.push([u, slot])
                    continue
                }
                if (callee && n.op === 'ret' && slot === 0 && countIds(n) === 1) {
                    f.exits.push([u, slot])
                    continue
                }
                f.blocked = `${n.op}@${slot}`
                break
            }
        }
        for (const id of f.source.keys()) {
            const owner = index.owner.get(id)
            if (!owner) continue
            for (const app of index.applies.get(owner[0]) ?? []) {
                if (!f.source.has(getRef(g.nodes.get(app)!, owner[1] + 1))) f.blocked ??= 'join'
            }
        }
        return f
    }
    interface Plan {
        callee: ProgramUnit
        own: Flow
        allocation: number
        layout: Map<number, [key: number, T: intrinsics.Types]>
        callers: [ProgramUnit, Flow][]
    }
    for (const unit of live) indexOf(unit)
    const callersOf = new Map<number, ProgramUnit[]>()
    for (const unit of live) {
        for (const symbol of indexOf(unit).calls.keys()) {
            const list = callersOf.get(symbol)
            if (list) list.push(unit)
            else callersOf.set(symbol, [unit])
        }
    }
    const floats = new Set([Types.f16, Types.f32, Types.f64, Types.unknown_number])
    const plans: Plan[] = []
    for (const unit of live) {
        const callers = callersOf.get(unit.symbol)
        if (pinned.has(unit.symbol) || !callers || callers.includes(unit)) continue
        const p = returnedAllocation(unit)
        if (!p) continue
        const name = unit.graph.name || `symbol ${unit.symbol}`
        const own = flow(unit, [p], true)
        const g = unit.graph
        if (!own.blocked && indexOf(unit).rets.some(r => !own.source.has(getRef(g.nodes.get(r)!, 0)))) own.blocked = 'other-return'
        const theirs = callers.map(c => [c, flow(c, indexOf(c).calls.get(unit.symbol)!, false)] as [ProgramUnit, Flow])
        const blocked = own.blocked ?? theirs.find(([, f]) => f.blocked)?.[1].blocked
        if (blocked) {
            if (debug) console.log(`RECORD-RETURN ${name} blocked ${blocked}`)
            continue
        }
        const types = new Map(own.accesses)
        const read = new Set<number>()
        let conflict: string | undefined
        for (const [, f] of theirs) {
            for (const offset of f.reads.values()) read.add(offset)
            for (const [offset, T] of f.accesses) {
                if (types.has(offset) && types.get(offset) !== T) conflict = 'field-type'
                types.set(offset, T)
            }
        }
        const offsets = [...types.keys()].sort((a, b) => a - b)
        for (let i = 0; i + 1 < offsets.length; i++) {
            if (offsets[i] + intrinsics.intrinsicBitWidth(types.get(offsets[i])!) / 8 > offsets[i + 1]) conflict = 'overlap'
        }
        const fields = offsets.filter(o => read.has(o))
        if (!fields.length || fields.length > program.target.retRegs.length) conflict = `fields=${fields.length}`
        if (fields.some(o => floats.has(types.get(o)!))) conflict = 'float-field'
        if (conflict) {
            if (debug) console.log(`RECORD-RETURN ${name} blocked ${conflict}`)
            continue
        }
        const layout = new Map<number, [number, intrinsics.Types]>()
        fields.forEach((o, i) => layout.set(o, [i, types.get(o)!]))
        if (debug) console.log(`RECORD-RETURN ${name} fields=${fields.join('/')} callers=${callers.map(c => c.graph.name || '?').join(',')}`)
        plans.push({ callee: unit, own, allocation: p, layout, callers: theirs })
    }
    function recordType(g: Graph, layout: Map<number, [number, intrinsics.Types]>): number {
        const type = g.maxId++
        g.nodes.set(type, createRecordType([...layout.values()].map(([key, T]) => ({ key, type: T }))))
        return type
    }
    function retype(g: Graph, param: number, type: number): void {
        const copy = copyNode(g.nodes.get(param)!)
        setType(copy, { ref: type })
        g.nodes.set(param, copy)
    }
    const changed = new Set<ProgramUnit>()
    for (const plan of plans) {
        const g = plan.callee.graph
        const index = indexOf(plan.callee)
        const { own, layout } = plan
        const type = recordType(g, layout)
        const relays = new Map<number, boolean>()
        const exitsFrom = new Map<number, [number, number][]>()
        for (const [u, slot] of own.exits) {
            const source = own.source.get(getRef(g.nodes.get(u)!, slot))!
            const list = exitsFrom.get(source)
            if (list) list.push([u, slot])
            else exitsFrom.set(source, [[u, slot]])
        }
        function into(u: number, slot: number): boolean {
            const n = g.nodes.get(u)!
            return n.op === 'ret' || relay(getBlock(g, getRef(n, 0))!.params[slot - 1])
        }
        function relay(param: number): boolean {
            const known = relays.get(param)
            if (known !== undefined) return known
            relays.set(param, false)
            let ok = !own.accessed.has(param)
            for (const [u, slot] of exitsFrom.get(param) ?? []) ok &&= into(u, slot)
            relays.set(param, ok)
            return ok
        }
        for (const [u, slot] of own.exits) {
            const value = getRef(g.nodes.get(u)!, slot)
            const source = own.source.get(value)!
            if (source !== plan.allocation && relay(source)) continue
            if (!into(u, slot)) continue
            let token = value
            while (g.nodes.get(token)!.op === 'encode') token = getRef(g.nodes.get(token)!, 0)
            const orderings: Operand[] = []
            const wrapped = [u]
            while (wrapped.length) {
                for (const [w, at] of index.users.get(wrapped.pop()!) ?? []) {
                    const n = g.nodes.get(w)!
                    if (n.op !== 'after' || at !== countIds(n) - 1) continue
                    for (let i = 0; i < at; i++) if (getRef(n, i)) orderings.push(getRef(n, i))
                    wrapped.push(w)
                }
            }
            if (orderings.length) {
                const ordered = g.maxId++
                g.nodes.set(ordered, makeNode('after', [...orderings, token]))
                token = ordered
            }
            const operands: Operand[] = []
            for (const [offset, [key, T]] of layout) {
                const load = g.maxId++
                g.nodes.set(load, makeNode('load', [token, source, { literal: offset }], T))
                operands.push({ literal: key }, load)
            }
            const record = g.maxId++
            g.nodes.set(record, makeNode('record', operands))
            const copy = copyNode(g.nodes.get(u)!)
            setRef(copy, slot, record)
            g.nodes.set(u, copy)
        }
        for (const [param, ok] of relays) if (ok) retype(g, param, type)
        changed.add(plan.callee)
        for (const [unit, f] of plan.callers) {
            const cg = unit.graph
            const index = indexOf(unit)
            const callerType = recordType(cg, layout)
            for (const id of f.source.keys()) {
                const n = cg.nodes.get(id)!
                if (n.op === 'param') retype(cg, id, callerType)
                if (n.op !== 'decode') continue
                for (const [u, slot] of index.users.get(id) ?? []) {
                    const copy = copyNode(cg.nodes.get(u)!)
                    setRef(copy, slot, getRef(n, 0))
                    cg.nodes.set(u, copy)
                }
            }
            for (const [load, offset] of f.reads) {
                const n = cg.nodes.get(load)!
                const [key, T] = layout.get(offset)!
                let value = cg.maxId++
                cg.nodes.set(value, makeNode('get', [getRef(n, 1), { literal: key }]))
                if (intrinsics.intrinsicBitWidth(T) < 64) {
                    const converted = cg.maxId++
                    cg.nodes.set(converted, makeNode('convert', [value], T))
                    value = converted
                }
                intrinsics.assert(getRef(n, 0), `native: load %${load} has no ordering token`)
                cg.nodes.set(load, makeNode('after', [getRef(n, 0), value]))
            }
            changed.add(unit)
        }
    }
    const transformed = new Set(plans.map(plan => plan.callee.symbol))
    const started = new Set<number>()
    const finished = new Set<number>()
    function finish(unit: ProgramUnit): void {
        if (started.has(unit.symbol)) return
        started.add(unit.symbol)
        if (debug && intrinsics.argv().includes(`record-returns:${unit.graph.name}`)) console.log(dumpGraph(unit.graph))
        const graph = snapshotGraph(unit.graph)
        for (const [id, n] of [...graph.nodes]) {
            const symbol = calledSymbol(graph, n)
            if (symbol === undefined || !transformed.has(symbol)) continue
            const callee = units.get(symbol)!
            if (callee === unit || program.noInline.has(callee.symbol)) continue
            finish(callee)
            if (!finished.has(callee.symbol)) continue
            if (!inlines(callSites, program.roots, unit.graph, graph, id, callee)) continue
            splice(graph, id, callee.graph, g => g.maxId++)
        }
        graph.form = undefined
        unit.graph = clock.normalize(graph)
        if (transformed.has(unit.symbol)) sweepBlocks(unit.graph)
        finished.add(unit.symbol)
    }
    for (const unit of changed) finish(unit)
    for (const symbol of started) program.units.set(symbol, units.get(symbol)!.graph)
}

function lowerProgram(program: ProgramGraph, reached: Set<number>): NativeUnit[] {
    const roots = new Set(program.roots.values())
    const symbols = [...program.units.keys()].filter(symbol => reached.has(symbol))
    const callees = new Map<number, number[]>()
    for (const symbol of symbols) {
        const graph = program.units.get(symbol)!
        const out: number[] = []
        for (const n of graph.nodes.values()) {
            const callee = siteTarget(program, graph, n)
            if (callee !== undefined && callee !== symbol && reached.has(callee)) out.push(callee)
        }
        callees.set(symbol, out)
    }
    const order = stronglyConnected(symbols, symbol => callees.get(symbol)!)
    const clobbers = new Map<number, Set<number>>()
    const clobbersOf = (symbol: number) => clobbers.get(symbol)
    const lowered = new Map<number, NativeUnit>()
    for (const scc of order) {
        for (const symbol of scc) lowered.set(symbol, lowerUnit(program, symbol, roots.has(symbol), clobbersOf))
        const members = new Set(scc)
        const shared = new Set<number>()
        for (const symbol of scc) {
            const code = lowered.get(symbol)!.code
            for (const r of code.clobbers) shared.add(r)
            for (const callee of code.localCalls) {
                if (!members.has(callee)) for (const r of clobbers.get(callee) ?? program.target.volatiles) shared.add(r)
            }
        }
        for (const symbol of scc) clobbers.set(symbol, shared)
    }
    return symbols.map(symbol => lowered.get(symbol)!)
}

function lowerUnit(program: ProgramGraph, symbol: number, isRoot: boolean, clobbersOf: (symbol: number) => Set<number> | undefined): NativeUnit {
    const image = program.image
    const unitGraph = program.units.get(symbol)!
    const name = unitGraph.name ?? ''
    const graph = rewriteTargets(unitGraph, image.functionHandles, image.dataHandles, image.runtime)
    for (const [id, n] of graph.nodes) {
        if (n.op !== 'pool-entry' || getDebugLabel(graph, id)) continue
        const label = image.labels.get(getLiteral(n, 0))
        if (label) setDebugLabel(graph, id, label)
    }
    if (isRoot) {
        intrinsics.assert(graph.blocks[0].params.filter(p => paramLocation(graph.nodes.get(p)!) < 0).length <= maxRootArgs)
    }
    const debug = intrinsics.argv().includes('lower-debug')
        || intrinsics.argv().includes(`lower-debug:${name}`)
    if (debug) console.log('lower native', name)
    seedPstacks(graph)
    const code = lowerValueGraph(graph, { debug, target: program.target, clobbersOf })
    if (debug || intrinsics.argv().includes('listings')) console.log(`--- ${name} listing ---\n`, code.listing)
    return { name, symbol, code, returnsFloat: returnsFloat(graph) }
}

function traceProgram(fns: Record<string, Function>, opts: CreateNativesOptions, clock: PhaseClock, target: Target): ProgramGraph {
    const { enterPhase, timed, normalize } = clock
    const image = createImage()
    const symbols = new Map<Function, number>()
    const functions: Function[] = []
    const roots = new Map<string, number>()
    const pending: PendingUnit[] = []
    const opaqueGraphs = new Map<number, Graph>()
    const shapedCallees: ShapedCallee[] = []
    const returnRecords = new Map<number, ReturnedRecord>()
    const returnCallers: ReturnCaller[] = []
    const session = createTraceSession()
    Object.assign(session.globals, opts.globals)
    const inlineScores = new Map<Function, InlineScore | false>()
    const returnWrappers = new Map<Function, Function>()
    const inlineDenylist = new Set(intrinsics.argv()
        .filter(x => x.startsWith('no-inline:'))
        .map(x => x.slice('no-inline:'.length)))
    const noInlineAll = intrinsics.argv().includes('no-inline-all')
    function constructsOutOfLine(fn: Function): boolean {
        return traceModule.isConstructor(specializedFrom.get(fn) ?? fn)
    }
    function shouldInline(fn: Function): boolean {
        if (noInlineAll || inlineDenylist.has(fn.name) || constructsOutOfLine(fn)) return false
        return inlineScores.get(fn) !== false && inlineScores.has(fn)
    }
    function intern(f: Function): number {
        const known = symbols.get(f)
        if (known !== undefined) return known
        const id = functions.length
        symbols.set(f, id)
        functions.push(f)
        return id
    }
