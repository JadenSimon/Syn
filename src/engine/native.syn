            console.log('SUMMARY', fn.name, summary.effects.map(e => `${show(e.target)} <- ${show(e.value)}`).join(', '),
                summary.rets.map(r => `ret ${show(r.value)}${r.encoded ? ' encoded' : ''}`).join(' '),
                [...fields].map(([k, c]) => `.${heap.stringToJs(k)} ${show(c.value)}${c.encoded ? ' encoded' : ''}`).join(' '))
