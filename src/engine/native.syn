            for (let i = 0; i < countIds(n); i++) {
                const constant = params.get(getRef(n, i))
                if (constant === undefined) continue
                ops ??= getOperands(graph, n)
                ops[i] = constant
            }
            ops ? putCopy(out, id, n, ops) : setNode(out, id, n)
        }
        return { ...traced, graph: out }
    }
    function constructed(unit: PlannedUnit | undefined, graph: Graph): Constructed {
        const embedded = new Map<number, { parent: number, key: intrinsics.Handle }>()
        const self = thisParamOf(graph)
        if (self !== undefined) for (const [node, key] of (unit && plan.embedded.sites.get(unit)) ?? []) embedded.set(node, { parent: self, key })
        return { refinements: plan.embedded.fields, embedded, fixed: plan.fixedFields }
    }
    function unionParamBases(fn: Function): Map<number, number> {
        const shaped = new Set(plannedParams(fn).filter(({ rep }) => plannedShape(plan, rep) !== undefined).map(({ index }) => index))
        return new Map(unionParams(fn).filter(i => shaped.has(i)).map(i => [i, pstack0Base()]))
    }
    function verifyTraced(traced: Traced, stage: string): void {
        verifyGraph(traced.graph, stage, false)
        verifyAllocationTokens(traced.graph, stage, traced.allocations)
        verifyKeys(traced.graph, stage)
    }
    function callEdges(resolved: Resolution, params: Map<number, Map<number, Arrival>>): Map<number, CallEdge> {
        const edges = new Map<number, CallEdge>()
        for (const [call, arrivals] of params) {
            const callee = planned.functions.get(resolved.callees.get(call)!)!
            edges.set(call, { raw: abiOf(callee).mode === 'raw', params: new Map([...arrivals].map(([index, { rep, shaped }]) => [index, { word: unionOfShape(rep), pointer: shaped && pointerOfShapes(rep) }])) })
        }
        return edges
    }
    function unionWords(resolved: Resolution, edges: Map<number, CallEdge>): Set<number> {
        const words = new Set<number>()
        for (const [id, rep] of resolved.local?.nodes ?? []) if (unionOfShape(rep) && !edges.get(id)?.raw) words.add(id)
        return words
    }
    function verifyResolved(resolved: Resolution, edges: Map<number, CallEdge>, stage: string, realized: boolean): void {
        const unions = unionWords(resolved, edges)
        const words = new Set([...resolved.encoded, ...unions])
        verifyGraph(resolved.graph, stage, false)
        verifyCodecs(resolved.graph, stage, words, edges)
        if (!realized) return
        verifyArrivals(resolved.graph, stage, words, edges)
        verifyNumericUses(resolved.graph, stage, unions, UnboxingOps, resolved.local?.unit.returns.kind === 'number' ? ownRets(resolved.graph) : [])
    }
    function realizeUnit(fn: Function): Graph {
        const resolved = resolveUnit(fn)
        const params = calleeParams(resolved)
        const edges = callEdges(resolved, params)
        verifyResolved(resolved, edges, 'resolve', false)
        const rawCalls = new Set([...resolved.callees].filter(([, unit]) => abiOf(planned.functions.get(unit)!).mode === 'raw').map(([call]) => call))
        realizeWords(resolved.graph, resolved.shapes, resolved.encoded, resolved.local, abiOf(fn).mode, params, rawCalls)
        verifyResolved(resolved, edges, 'realizeWords', true)
        tagUnit(fn, resolved)
        verifyResolved(resolved, edges, 'tagUnit', true)
        return resolved.graph
    }
    return { abiOf, realizeUnit, paramShapesOf, nullishParams, plannedUnit: (fn: Function) => planned.units.get(fn) }
}

function joinedPlan(types: ValueTypes, host: AccessHost, genericOf: (proto: intrinsics.Handle) => Generic | undefined) {
    const joins: [number, number][] = []
    let inst = instantiate(types, genericOf)
    let plan = planUnits(types, inst, host.graphOf)
    const requested = new Set<string>()
    for (let round = 0; round < 8; round++) {
        const more = pendingJoins(types, inst, plan).filter(([a, b]) => {
            const k = a < b ? `${a}|${b}` : `${b}|${a}`
            if (requested.has(k)) return false
            requested.add(k)
            return true
        })
        if (!more.length) break
        joins.push(...more)
        inst = instantiate(types, genericOf, joins)
        plan = planUnits(types, inst, host.graphOf)
    }
    return { inst, plan }
}
function planShapes(types: ValueTypes, linker: Linker, tracer: Tracer, host: AccessHost, genericOf: (proto: intrinsics.Handle) => Generic | undefined, facts: Facts): ShapePlan {
    const { session } = linker
    const placedStatics = new Set<number>()
    const readonlyConstructions = new Set<intrinsics.Handle>()
    const plannedHandles = new Set<intrinsics.Handle>()
    function fieldKey(name: string): intrinsics.Handle | undefined {
        const index = /^\[(\d+)\]$/.exec(name)
        return index ? heap.indexKey(Number(index[1]) as u32) : types.keyHandles.get(name)
    }
    const fixedStatic = (state: intrinsics.Handle, key: intrinsics.Handle) => fixedField(types, state, key)
    const constructed = new Set([...session.sealed].map(cell => heap.indirectTarget(cell)))
    for (const state of constructed) if (fixedState(types, state)) readonlyConstructions.add(state)
    const owned = new Set(constructed)
    for (const unit of tracer.units) for (const cell of unit.traced!.allocations?.keys() ?? []) owned.add(heap.deref(cell as intrinsics.Handle))
    function folds(site: Site): boolean {
        const traced = tracer.graphsOf(site.unit).traced!
        const n = getNode(traced.graph, site.node)
        return !!n && tracer.fixedSlot(traced, n, fixedStatic) !== undefined
    }
    for (const [state, ids] of types.stateAllocations) {
        if (owned.has(state) || ids.some(id => types.objects[id].native) || !heap.isOrdinaryObject(state) || heap.isArray(state) || heap.isCallable(state)) continue
        if (!fixedState(types, state) || ids.some(id => types.objects[id].readers.some(site => !folds(site)))) placedStatics.add(state)
    }
    const { inst, plan } = joinedPlan(types, host, genericOf)
    const handles = new Map<string, intrinsics.Handle>()
    const fixedFields = new Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>()
    for (const [id, sig] of inst.shapes) {
        const shape = heap.makeObject((sig.proto ?? 0) as intrinsics.Handle)
        for (const [k] of sig.fields) {
            const key = fieldKey(k)
            if (key === undefined) throw `native: planned shape ${id} has no key for ${k}`
            const readonly = sig.members.every(m => {
                const state = types.objects[m].state
                const addr = state !== undefined ? heap.getOwnProperty(state, key) : 0
                return !!addr && !(heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).flags & heap.PropFlags.writable)
            }) || (sig.fields.length === 1 && sig.fields[0][1].kind === 'number' && sig.fields[0][1].number !== 'f64' && !sig.fields[0][1].nullable && !inst.addressed.has(id) && sig.members.every(m => types.objects[m].initialized.has(k)))
            if (readonly) heap.setReadonlyProperty(shape, key, heap.boxF64(0) as intrinsics.Handle)
            else heap.setProperty(shape, key, heap.boxF64(0) as intrinsics.Handle)
        }
        handles.set(id, shape)
        plannedHandles.add(shape)
    }
    function fact(rep: Rep, encoded: boolean): Fact | undefined {
        const target = rep.targets.length === 1 ? rep.targets[0] : undefined
        if (rep.kind === 'never') return
        if (rep.kind === 'undefined') return { shape: undefined, encoded, nullish: true }
        if (rep.kind === 'number' && rep.number === 'f64') return { shape: undefined, encoded, number: true, float: true }
        if (rep.kind === 'number') return { shape: undefined, encoded, number: true, type: rawSlotType(rep, encoded) }
        if (rep.kind === 'pointer' && target === 'str') return { shape: propertyEval.stringShape, encoded: false }
        if (rep.kind === 'pointer' && target === 'fn') return { shape: undefined, encoded }
        if (rep.kind === 'pointer' && target?.startsWith('S') && !(encoded && rep.nullable)) return { shape: handles.get(target), encoded }
        if (rep.kind === 'pointer' && target?.startsWith('clo@') && !rep.nullable) return { shape: Number(target.slice('clo@'.length)) as intrinsics.Handle, encoded }
        if (rep.kind === 'union' && target?.startsWith('S')) return { shape: handles.get(target), encoded: true, number: true }
        return { shape: undefined, encoded: true }
    }
    const embeddings = planEmbeddings(types, inst, plan)
    const sizes = new Map<string, number>()
    function sizeOf(id: string): number {
        const known = sizes.get(id)
        if (known !== undefined) return known
        let size = 0
        for (const [k] of inst.shapes.get(id)!.fields) {
            const inner = embeddings.fields.get(id)?.get(k)
            size += inner !== undefined ? sizeOf(inner) : 8
        }
        sizes.set(id, size)
        return size
    }
    for (const [id, sig] of inst.shapes) {
        const known = new Map<string, Fact>()
        let at = 0
        sig.fields.forEach(([k, rep]) => {
            const offset = String(at)
            const nested = embeddings.fields.get(id)?.get(k)
            at += nested !== undefined ? sizeOf(nested) : 8
            if (nested !== undefined) return
            if (rep.kind !== 'buffer') {
                const f = fact(rep, false)
                if (f) known.set(offset, f)
                return
            }
            known.set(offset, { shape: undefined, encoded: false, number: true })
            const inner = fact(rep.element!, !!rep.element!.encoded)
            if (inner) known.set(`${offset}/*`, inner)
        })
        facts.set(handles.get(id)!, known)
        const constants = new Map<intrinsics.Handle, intrinsics.Handle>()
        for (const [k] of sig.fields) {
            const key = types.keyHandles.get(k)
            if (key === undefined) continue
            let agreed: intrinsics.Handle | undefined
            for (const member of sig.members) {
                const state = types.objects[member].state
                const addr = state !== undefined ? heap.getOwnProperty(state, key) : 0
                const slot = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).slot0 as intrinsics.Handle : undefined
                if (slot === undefined || !heap.isCallable(slot) || (agreed !== undefined && agreed !== slot) || types.objects[member].forms.get(k)?.some(form => form !== 'init')) {
                    agreed = undefined
                    break
                }
                agreed = slot
            }
            if (agreed !== undefined) constants.set(key, agreed)
        }
        if (constants.size) fixedFields.set(handles.get(id)!, constants)
    }
    function factClass(path: string, f: Fact): string {
        const signed = f.type !== undefined && isSignedType(f.type) ? '-' : ''
        if (f.encoded && path.endsWith('/*')) return `e${signed}${f.nullish ? 'u' : ''}`
        const shape = f.shape === undefined ? '' : f.shape === propertyEval.stringShape ? 's' : plannedHandles.has(f.shape) ? 'S' : `h${f.shape}`
        return `${f.encoded ? 'e' : ''}${shape}${f.number ? 'n' : ''}${signed}${f.float ? 'f' : ''}${f.nullish ? 'u' : ''}`
    }
    const layouts = new Map<string, string>()
    const layoutIds = new Map<string, string>()
    function layoutOf(id: string, elements: ElementReads): string {
        const at = `${id}/${elements === 'all' ? '*' : [...elements].sort((a, b) => a - b).join(',')}`
        const known = layouts.get(at)
        if (known !== undefined) return known
        layouts.set(at, at)
        const sig = inst.shapes.get(id)!
        const handle = handles.get(id)!
        const read = new Set<string>()
        let offset = 0
        for (const [k] of sig.fields) {
            const key = fieldKey(k)
            if (elements === 'all' || (key !== undefined && elements.has(key))) read.add(`${offset}/*`)
            const inner = embeddings.fields.get(id)?.get(k)
            offset += inner !== undefined ? sizeOf(inner) : 8
        }
        const fields = sig.fields.map(([k]) => {
            const addr = heap.getOwnProperty(handle, fieldKey(k)!)
            const readonly = !(heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).flags & heap.PropFlags.writable)
            const inner = embeddings.fields.get(id)?.get(k)
            const constant = types.keyHandles.has(k) ? fixedFields.get(handle)?.get(types.keyHandles.get(k)!) : undefined
            return `${k}${readonly ? '!' : ''}${inner !== undefined ? `{${layoutOf(inner, elements)}}` : ''}${constant !== undefined ? `=${constant}` : ''}`
        })
        const text = `${sig.proto ?? ''}{${fields.join(',')}}${[...facts.get(handle)!].filter(([path]) => read.has(path) || !path.endsWith('/*')).map(([path, f]) => `${path}:${factClass(path, f)}`).join(',')}`
        let layout = layoutIds.get(text)
        if (layout === undefined) layoutIds.set(text, layout = `L${layoutIds.size}`)
        if (flags.has('share-debug')) console.log('SHARE-LAYOUT', id, layout, text)
        layouts.set(at, layout)
        return layout
    }
    function reducedTarget(target: string): boolean {
        return propertyEval.reducedShape(target.startsWith('clo@') ? Number(target.slice('clo@'.length)) as intrinsics.Handle : handles.get(target)!)
    }
    shareUnits(plan, layoutOf, reducedTarget, embeddings.sites, fn => host.graphOf(fn))
    threadConstants(plan, types, inst, state => placedStatics.has(state) || constructed.has(state))
    const constants = new Map<intrinsics.Handle, intrinsics.Handle>()
    for (const [state, id] of inst.constantShapes) constants.set(state, handles.get(id)!)
    if (flags.has('plan')) for (const [P, byKey] of embeddings.fields) console.log('EMBED', P, [...byKey].map(([k, I]) => `${k}=${I}`).join(' '))
    if (flags.has('plan')) for (const [unit, byNode] of embeddings.sites) console.log('EMBED-SITE', unit.fn.name, [...byNode].map(([n, k]) => `%${n}.${k}`).join(' '))
    const embedded = new Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>()
    for (const [P, byKey] of embeddings.fields) embedded.set(handles.get(P)!, new Map([...byKey].map(([k, I]) => [types.keyHandles.get(k)!, handles.get(I)!])))
    const sites = new Map<PlannedUnit, Map<number, intrinsics.Handle>>()
    for (const [unit, byNode] of embeddings.sites) sites.set(unit, new Map([...byNode].map(([node, k]) => [node, types.keyHandles.get(k)!])))
    return { units: plan, inst, shapes: handles, fixedFields, constants, strings: types.strings, embedded: { fields: embedded, sites }, fixedStatic, statics: { placed: placedStatics, readonly: readonlyConstructions } }
}

interface ParamConstant {
    handle?: intrinsics.Handle
    literal?: number
}

function localizeCalls(graph: Graph, image: ProgramImage, units: Map<number, Graph>): void {
    function valueOf(id: number): GraphNode | undefined {
        let n = getNode(graph, id)
        while (n?.op === NodeOp.after) n = getNode(graph, getRef(n, countIds(n) - 1))
        return n
    }
    const signed = new Map<string, number>()
    for (const [id, n] of [...graph.nodes]) {
        if (n.op !== NodeOp.call) continue
        let target = valueOf(getRef(n, 1))
        const signature = target?.op === NodeOp.indirectTarget ? typeRefOf(target) : 0
        if (target?.op === NodeOp.indirectTarget) target = valueOf(getRef(target, 0))
        if (target?.op !== NodeOp.heapHandle || getRef(target, 0)) continue
        const handle = heap.deref(getLiteral(graph, target, 0) as intrinsics.Handle)
        const slot = image.functionHandles.get(handle)
        const symbol = slot === undefined ? undefined : image.functionTargets.get(slot)
        if (symbol === undefined) continue
        if (!signature) {
            const local = newId(graph)
            putNode(graph, local, NodeOp.localTarget, [{ literal: symbol }, { literal: 2 }], resultType(graph, n))
            putCopy(graph, id, n, withOperand(graph, n, 1, local))
            continue
        }
        const callee = units.get(symbol)!
        const locations = callee.blocks[0].params.map(p => paramLocation(getNode(callee, p)!))
        const passed = fnLocations(getNode(graph, signature)!)
        const positional: Operand[] = []
        const located = new Map<number, Operand>()
        for (let i = 3; i < countIds(n); i++) {
            if ((passed[i - 3] ?? -1) < 0) positional.push(getOperand(callee, n, i))
            else located.set(passed[i - 3], getOperand(callee, n, i))
        }
        let next = 0
        const args = locations.map(at => at >= 0 ? located.get(at) ?? { literal: 0 }
            : next < positional.length ? positional[next++] : { literal: 0 })
        const returns = fnReturn(getNode(graph, signature)!)
        const key = `${symbol}:${JSON.stringify(returns)}:${locations}`
        let shared = signed.get(key)
        if (shared === undefined) {
            const fnType = insertNode(graph, createFnType(callee, returns, locations))
            shared = addNode(graph, NodeOp.localTarget, [{ literal: symbol }, { literal: 2 }], { ref: fnType })
            signed.set(key, shared)
        }
        putCopy(graph, id, n, [getOperand(callee, n, 0), shared, getOperand(callee, n, 2), ...args])
    }
}

function trapStub(traced: Graph, name: string, reachableNodes: (graph: Graph) => Set<number>): Graph {
    const graph = withNodes(traced, new Map(traced.nodes))
    const end = addNode(graph, NodeOp.trap, [addNode(graph, NodeOp.nilEffect, []), { literal: 0xdead }])
    setGraphBlocks(graph, graph.blocks.filter(b => b.id === graph.root).map(b => ({ ...b, bodyId: end, bodyConst: 0 })))
    const live = reachableNodes(graph)
    for (const id of [...graph.nodes.keys()]) if (!live.has(id)) graph.nodes.delete(id)
    graph.name = name
    return graph
}

function createAccessHost(linker: Linker, tracer: Tracer): { host: AccessHost, genericOf: (proto: intrinsics.Handle) => Generic | undefined } {
    const { session, functions, unitOf, originOf, codeOf, closureBody } = linker
    const host: AccessHost = {
        session,
        graphOf: fn => tracer.graphsOf(fn).traced!.graph,
        functionOf: handle => {
            const stub = session.stubFunctions.get(handle) as any
            if (stub) return isLocalStub(stub) ? functions[stub.__localTarget] : stub
            return session.templateOf(handle) ? closureBody(handle, 'closure') : undefined
        },
        localFunction: symbol => functions[symbol],
        isConstructor: traceModule.isConstructor,
        traceable: fn => !!codeOf(fn),
        invariantsOf: proto => genericOf(proto)?.invariants,
        constantElements: state => tracer.engineElements.get(state),
        heapValue: tracer.heapValue,
        receiverless: fn => Array.isArray((fn as any).__args),
        paramCount: fn => codeOf(fn)?.source.compiled.paramCount,
        variantOf: (fn, floats) => {
            const variants = unitOf(fn).variants ??= new Map()
            const k = floats.join()
            let variant = variants.get(k)
            if (!variant) {
                variant = Object.defineProperty(function variant() {}, 'name', { value: fn.name })
                const unit = unitOf(variant)
                unit.code = codeOf(fn)!
                unit.origin = originOf(fn)
                unit.kinds = new Map(floats.map(i => [i, Types.f64]))
                variants.set(k, variant)
            }
            return variant
        },
    }
    function genericOf(proto: intrinsics.Handle): Generic | undefined {
        const ctor = heap.getOwnProperty(proto, heap.fromJsString('constructor'))
        const fn = ctor ? host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32) : undefined
        if (!fn || !host.traceable(fn)) return
        if (genericCache.has(fn)) return genericCache.get(fn) ?? undefined
        genericCache.set(fn, null)
        const generic = analyzeGenerics(fn.name, proto, fn, host, genericOf)
        genericCache.set(fn, generic)
        return generic
    }
    return { host, genericOf }
}

type Resolver = ReturnType<typeof createResolver>

interface CompiledUnits {
    compiled: Map<Function, Graph>
    stubs: Set<Function>
}

function compileUnits(linker: Linker, tracer: Tracer, resolver: Resolver, plan: ShapePlan, image: ProgramImage, clock: PhaseClock): CompiledUnits {
    const { roots, order, staticFns, unitOf, link, staticOrder, resolveHandles } = linker
    const { realizeUnit, plannedUnit } = resolver
    const compiled = new Map<Function, Graph>()
    const stubs = new Set<Function>()
    function compileUnit(fn: Function): Graph {
        const unit = unitOf(fn)
        if (flags.has('native-symbols')) console.log('native symbol', unit.symbol!, fn.name || fn.toString().slice(0, 80), plannedUnit(fn) ? 'planned' : 'unplanned')
        const traceDebug = flagged('trace-debug', fn.name)
        if (traceDebug) console.log('trace native', fn.name)
        if (!plannedUnit(fn) && ![...roots.values()].includes(unit.symbol!)) {
            stubs.add(fn)
            return trapStub(tracer.graphsOf(fn).traced!.graph, fn.name, tracer.reachableNodes)
        }
        const graph = realizeUnit(fn)
        if (flags.has(`resolved-debug:${fn.name}`)) console.log(dumpGraph(graph))
        if ([...graph.nodes.values()].some(n => n.op === NodeOp.getProp || n.op === NodeOp.setProp)) throw `native: ${fn.name} reads a property of an opaque value`
        const lifted = liftReturnedHeapValues(graph)
        lifted.graph.name = fn.name
        if (traceDebug) console.log(unit.traced!.text)
        if (lifted.wrapper) unit.wrapper = lifted.wrapper
        return clock.normalize(lifted.graph, { firstPass: true })
    }
    let next = 0
    do {
        while (next < order.length) {
            const fn = order[next++]
            const graph = compileUnit(fn)
            unitOf(fn).probed = true
            compiled.set(fn, graph)
            resolveHandles(graph, plan.statics)
        }
        if (staticFns.length && !roots.has(staticInitName)) {
            const table = Number(nativeMapper(Math.max(staticFns.length * 8, 1 << 12)))
            if (!table || table === -1) throw 'native: failed to map the static table'
            image.staticTable.base = table
            roots.set(staticInitName, link(staticInitializer(staticOrder().map(slot => [staticFns[slot], slot] as [Function, number]), symbolicMemory(table))))
        }
    } while (next < order.length)
    tracer.checkInlinedReads(plan.fixedStatic)
    return { compiled, stubs }
}

function assembleProgram(units: CompiledUnits, linker: Linker, resolver: Resolver, image: ProgramImage, target: Target): ProgramGraph {
    const { roots, functions, unitOf, constructsOutOfLine } = linker
    const { compiled, stubs } = units
    const graphs = new Map([...compiled].map(([fn, graph]) => [unitOf(fn).symbol!, graph]))
    for (const graph of graphs.values()) localizeCalls(graph, image, graphs)
    for (const [fn, graph] of compiled) {
        for (const [id, n] of graph.nodes) {
            const target = n.op === NodeOp.call ? getNode(graph, getRef(n, 1)) : undefined
            if (target?.op !== NodeOp.localTarget || getRef(target, 0)) continue
            const callee = functions[getLiteral(graph, target, 0)]
            if (!resolver.plannedUnit(callee)) continue
            const returns = resolver.abiOf(callee).returns
            intrinsics.assert(resultType(graph, n) === returns, `native: ${fn.name} %${id} binds ${typeName(resultType(graph, n))} from ${callee.name}, which returns ${typeName(returns)}`)
        }
    }
    const program: ProgramGraph = { units: new Map(), roots, noInline: new Set(), alwaysInline: new Set(), constructors: new Set(), unplanned: new Set(), abi: new Map(), image, target }
    for (const [fn, graph] of compiled) {
        const unit = unitOf(fn)
        if (graph.name === undefined) graph.name = fn.name
        program.units.set(unit.symbol!, graph)
        const planned = resolver.plannedUnit(fn)
        const machine = (rep: Rep) => rep.number === 'f64' ? 'f' : rep.kind === 'never' || rep.kind === 'undefined' ? '-' : 'w'
        program.abi.set(unit.symbol!, planned
            ? `${planned.params.map(p => machine(p.rep)).join('')} -> ${machine(planned.returns)} ${resolver.abiOf(fn).mode} | ${[...unit.kinds ?? []].map(([i, T]) => `${i}:${T}`).join(',')}`
            : `? | ${[...unit.kinds ?? []].map(([i, T]) => `${i}:${T}`).join(',')}`)
        if ((fn as any).shouldNotInline || stubs.has(fn)) program.noInline.add(unit.symbol!)
        if (stubs.has(fn)) program.unplanned.add(unit.symbol!)
        if ((fn as any).shouldInline) program.alwaysInline.add(unit.symbol!)
        if (constructsOutOfLine(fn)) program.constructors.add(unit.symbol!)
    }
    return program
}

function printAnalysis(valueTypes: ValueTypes, genericOf: (proto: intrinsics.Handle) => Generic | undefined): void {
    if (flags.has('types')) console.log(dumpTypes(valueTypes))
    if (!flags.has('generics')) return
    const printed = new Set<Generic>()
    for (const object of valueTypes.objects) {
        const generic = object.proto ? genericOf(object.proto) : undefined
        if (generic && !printed.has(generic)) console.log(generic.lines.join('\n'))
        if (generic) printed.add(generic)
    }
    for (const entry of instantiate(valueTypes, genericOf).table.values()) {
        console.log(`INST ${entry.key} [${entry.members.map(id => `#${id}`).join(' ')}]`)
        for (const [k, rep] of entry.fields) console.log(`  ${k}: ${rep}`)
    }
}

interface TyperRun {
    typed: ReturnType<typeof typer.typeRoots>
    ms: number
}

function printCompiled(units: CompiledUnits, facts: Facts, plan: ShapePlan, valueTypes: ValueTypes, linker: Linker, tracer: Tracer, resolver: Resolver, typerRun: TyperRun): void {
    const { roots, unitOf, originOf, codeOf } = linker
    const { abiOf, paramShapesOf, nullishParams } = resolver
    const published = [...units.compiled.keys()].map(unitOf)
    if (flags.has('facts-dump')) {
        const seen = new Set<Map<string, Fact>>()
        for (const [shape, known] of facts) {
            const shared = seen.has(known)
            seen.add(known)
            console.log(`FACTS ${describe(shape)}${shared ? ' (unified)' : ''}`)
            if (!shared) for (const [path, fact] of known) console.log(`  [${path}] ${fact.shape !== undefined ? describe(fact.shape) : ''}${fact.number ? ' number' : ''}${fact.float ? ' float' : ''}${fact.encoded ? ' encoded' : ''}${fact.base ? ` base=${fact.base}` : ''}`)
        }
    }
    if (flags.has('plan')) {
        for (const [id, shape] of plan.inst.shapes) console.log(`SHAPE ${id} ${shape.text} @ ${[...new Set(shape.members.map(m => `${valueTypes.objects[m].site.unit.name}:%${valueTypes.objects[m].site.node}`))].join(' ')}`)
        const nativeUnits = new Map<Function, Unit[]>()
        for (const unit of published) {
            const origin = originOf(unit.fn)
            let list = nativeUnits.get(origin)
            if (!list) nativeUnits.set(origin, list = [])
            list.push(unit)
        }
        for (const fn of new Set([...plan.units.keys(), ...nativeUnits.keys()])) {
            const planned = plan.units.get(fn) ?? []
            const native = nativeUnits.get(fn) ?? []
            console.log(`PLAN ${fn.name || '<anon>'} planned=${planned.length} native=${native.length}${planned.length === native.length ? '' : ' MISMATCH'}`)
            for (const unit of planned) {
                console.log(`  plan ${unit.signature} frames=${unit.frames.length}`)
                for (const [node, callees] of unit.calls) if (callees.size > 1) console.log(`    %${node} -> ${[...callees].map(c => `${c.fn.name}${c.signature}`).join(' | ')}`)
            }
            for (const unit of native) console.log(`  native ${unit.fn.name} ${[...paramShapesOf(unit.fn)].map(([i, shape]) => `p${i}=${describe(shape)}`).join(' ')} ${[...unit.kinds ?? []].map(([i, T]) => `k${i}=${typeName(T)}`).join(' ')}`)
        }
    }
    if (flags.has('types-check')) {
        const checked: NativeUnit[] = published.filter(unit => unit.source).map(unit => {
            const paramCount = unit.source!.compiled.paramCount
            const params: NativeParam[] = []
            const shapes = paramShapesOf(unit.fn)
            const nullish = nullishParams(unit.fn)
            for (let i = 0; i < paramCount; i++) {
                const shape = shapes.get(i)
                params.push({ label: `p${i}`, kind: unit.kinds?.get(i), nullish: nullish.includes(i), keys: shape !== undefined && shape !== propertyEval.numberShape && shape !== propertyEval.stringShape ? propertyEval.dataKeys(shape).map(k => heap.isString(k) ? heap.stringToJs(k) : heap.describeKey(k) ?? `#${k}`) : undefined })
            }
            const receiver = shapes.get(paramCount)
            if (receiver !== undefined) params.push({ label: 'this', nullish: false, keys: propertyEval.dataKeys(receiver).map(k => heap.isString(k) ? heap.stringToJs(k) : heap.describeKey(k) ?? `#${k}`) })
            return { name: unit.fn.name, origin: originOf(unit.fn), sites: [], params, returns: abiOf(unit.fn).returns }
        })
        console.log(checkTypes(valueTypes, checked))
    }
    if (flags.has('typer-stats')) {
        const counts = { numeric: 0, string: 0, unknown: 0 }
        const typedSources = new Set<CompiledSource>()
        for (const unit of typerRun.typed.units) {
            typedSources.add(unit.source)
            for (const site of unit.sites.values()) counts[site.result]++
        }
        let untypedFns = 0
        let untypedSites = 0
        for (const { fn } of tracer.units) {
            const code = codeOf(fn)
            if (!code || typedSources.has(code.source)) continue
            untypedFns++
            untypedSites += typer.countAddSites(code.source.compiled)
        }
        console.log(`typer [${[...roots.keys()].join(',')}] ${typerRun.ms.toFixed(1)}ms units=${typerRun.typed.units.length} numeric=${counts.numeric} string=${counts.string} unknown=${counts.unknown} | traced-untyped fns=${untypedFns} sites=${untypedSites}`)
    }
}

function traceProgram(fns: Record<string, Function>, opts: CreateNativesOptions, clock: PhaseClock, target: Target): ProgramGraph {
    const image = createImage()
    const linker = createLinker(fns, opts, image)
    const { session, functions, roots } = linker
    const facts: Facts = new Map()
    const tracer = createTracer(linker, image, facts, clock)
    session.enterTrace()
    defer finally {
        session.leaveTrace()
    }
    const rootFns = [...roots.values()].map(symbol => functions[symbol])
    const typerStart = performance.now()
    const typed = session.typeRoots(rootFns, true)
    const typerRun: TyperRun = { typed, ms: performance.now() - typerStart }
    const { host, genericOf } = createAccessHost(linker, tracer)
    tracer.traceProgramUnits()
    const valueTypes = clock.timed('analysis', () => analyzeTypes(rootFns, host))
    printAnalysis(valueTypes, genericOf)
    const plan = clock.timed('plan', () => planShapes(valueTypes, linker, tracer, host, genericOf, facts))
    const planned = bindPlannedUnits(plan, linker)
    const reps = chooseRepresentations(plan, planned, linker, tracer)
    const resolver = createResolver(linker, tracer, plan, planned, reps, facts, clock)
    const units = compileUnits(linker, tracer, resolver, plan, image, clock)
    printCompiled(units, facts, plan, valueTypes, linker, tracer, resolver, typerRun)
    const program = assembleProgram(units, linker, resolver, image, target)
    if (flags.has('trace-stats')) console.log('heap records', session.runtime?.objects.stats)
    return program
}

let nativeObserver: ((event: string) => void) | undefined

export function observeNatives(observer: (event: string) => void): void {
    nativeObserver = observer
}

export function createNatives(fns: Record<string, Function>, opts: CreateNativesOptions = {}) {
    nativeObserver?.(`compile ${Object.keys(fns).join(', ')}`)
    getNativeBootstraps()
    const target = hostTarget
    const clock = createClock(target)
    const { enterPhase, timed } = clock
    const program = traceProgram(fns, opts, clock, target)
    timed('statics', () => evaluateStatics(program))
    const tracedUnits = program.units.size
    prune(program)
    timed('inline', () => mergeBeforeInlining(program))
    timed('inline', () => inlineProgram(program, clock))
    prune(program)
    enterPhase('effects')
    refineProgramEffects(program, clock)
    enterPhase('other')
    timed('statics', () => foldStaticLoads(program))
    let reached = reachUnits(program)
    timed('records', () => recordReturns(program, reached, clock))
    timed('records', () => {
        const touched = new Set<number>()
        expandParams(program, touched)
        shareCallerValues(program, touched)
        pruneDeadArgs(program, touched)
        for (const symbol of touched) { program.units.set(symbol, renormalize(program.units.get(symbol)!, clock)) }
    })
    reached = reachUnits(program)
    unswitchHot(program, programLevels(program), clock)
    for (const [symbol, level] of programLevels(program)) program.units.get(symbol)!.level = level
    for (const symbol of reached) {
        const graph = program.units.get(symbol)!
        for (const n of graph.nodes.values()) {
            if (n.op !== NodeOp.call) continue
            const callee = calledSymbol(graph, n)
            if (callee !== undefined && program.unplanned.has(callee)) throw `native: ${graph.name || `symbol ${symbol}`} calls ${program.units.get(callee)!.name || `symbol ${callee}`}, which the plan never entered`
        }
    }
    enterPhase('lower')
    const lowerable = reached.size
    const emitted = lowerProgram(program, reached)
    const merged = lowerable - reached.size
    enterPhase('other')
    printOptimizeStats()
    if (flags.has('trace-stats')) {
        console.log("native phases", { total: performance.now() - clock.start, ...clock.phases })
        const { bySource, ...totals } = traceModule.traceStats
        const repeated = [...bySource.values()].filter(x => x.count > 1).sort((a, b) => b.count - a.count)
        console.log('trace2 stats', totals, 'distinct sources', bySource.size,
            'repeat traces', repeated.reduce((s, x) => s + x.count - 1, 0))
        for (const x of repeated.slice(0, 15)) console.log('  ', x.count, x.name)
        const byName = new Map<string, number[]>()
        for (const [name, size] of normalizeStats) byName.set(name, [...byName.get(name) ?? [], size])
        console.log('normalize calls', normalizeStats.length, 'nodes', normalizeStats.reduce((t, x) => t + x[1], 0))
        for (const [name, sizes] of [...byName].sort((a, b) => b[1].reduce((x, y) => x + y, 0) - a[1].reduce((x, y) => x + y, 0)).slice(0, 12)) console.log('  ', name, sizes.join(' '))
        const bySelf = [...bySource.values()].sort((a, b) => b.self - a.self)
        for (const x of bySelf.slice(0, 20)) {
            console.log('  self', x.self.toFixed(1), 'x', x.count, x.name.replace(/\n\s*/g, ' ').slice(0, 70))
        }
    }
    if (flags.has('emit-debug')) {
        console.log('EMITTED', [...program.units].map(([symbol, graph]) => `${graph.name}:${symbol}${reached.has(symbol) ? '' : '(dropped)'}`).join(' '))
    }
    const floatReturns = new Set(emitted.filter(u => u.returnsFloat).map(u => u.symbol))
    for (const graph of program.units.values()) {
        for (const n of graph.nodes.values()) {
            if (n.op !== NodeOp.localTarget || getRef(n, 0) || !floatReturns.has(getLiteral(graph, n, 0))) continue
            intrinsics.assert(typeOf(n) === Types.f64, `native: ${graph.name || 'anonymous'} calls ${program.units.get(getLiteral(graph, n, 0))?.name || 'anonymous'}, which returns f64, through an untyped target`)
        }
    }
    let unitInst = 0
    let nonMov = 0
    let islandBytes = 0
    for (const u of emitted) {
        unitInst += u.code.words.length
        islandBytes += (u.code.island?.length ?? 0) * 8
        for (const word of u.code.words) if (!u.code.target.isMoveWide(word)) nonMov++
    }
    if (flags.has('unit-sizes')) for (const u of emitted) console.log(`UNIT ${u.name || 'anonymous'}:${u.symbol} ${u.code.words.length} ${u.code.words.filter(w => !u.code.target.isMoveWide(w)).length} ${(u.code.island?.length ?? 0) * 8}`)
    const inlined = (tracedUnits - emitted.length - merged ? ` (${tracedUnits - emitted.length - merged} inlined away)` : '') + (merged ? ` (${merged} merged)` : '')
    console.log(`native unit ${emitted.length} fns ${unitInst}/${nonMov} instructions/non-mov, ${unitInst * 4 + islandBytes} image bytes (${islandBytes} island)${inlined} [${Math.round(performance.now() - clock.start)}ms]`)
    const pooled = new Map<number, number>()
    const image = program.image
    for (const [slot, symbol] of image.functionTargets) if (reached.has(symbol)) pooled.set(slot, symbol)
    const installed = installImage(emitted, image.values, pooled,
        image.byteTargets, new Uint8Array(image.bytes), image.relocations)
    const initSymbol = program.roots.get(staticInitName)
    if (initSymbol !== undefined) {
        sealCode(installed.page)
        const none = new BigInt64Array(1)
        nativeObserver?.(staticInitName)
        nativeInvoker(installed.entries[initSymbol], (ts as any).getArrayBufferPtr(none.buffer), 0)
    }
    const result: Record<string, any> = {}
    for (const [name, symbol] of program.roots) {
        if (name === staticInitName) continue
        const ptr = installed.entries[symbol]
        const float = !!emitted.find(u => u.symbol === symbol)?.returnsFloat
        result[name] = Object.assign((...args: any[]) => {
            nativeObserver?.(`${name}(${args.join(', ')})`)
            sealCode(installed.page)
            const values = new BigInt64Array(Math.max(args.length, 1))
            for (let i = 0; i < args.length; i++) values[i] = BigInt(args[i])
            const argsPtr = (ts as any).getArrayBufferPtr(values.buffer)
            const outer = heldArgs
            heldArgs = values
            const raw = nativeInvoker(ptr, argsPtr, args.length)
            heldArgs = outer
            return float ? floatBits(raw) : raw
        }, { ptr, codePage: installed.page, image: installed, units: emitted })
    }
    return result
}

const staticInitName = '[[Init]]'

function staticInitializer(steps: [Function, number][], table: usize): () => void {
    let init = () => {}
    for (let i = steps.length - 1; i >= 0; i--) init = staticStep(steps[i][0], steps[i][1] * 8, table, init)
    return init
}

function copyInto(elements: any[]): () => any {
    return () => {
        const out = new Array()
        for (let i = 0; i < elements.length; i++) out.push(elements[i])
        return out
    }
}

function staticStep(fn: Function, offset: u32, table: usize, next: () => void): () => void {
    return () => {
        Intrinsics.store(table, offset, fn(), Types.u64)
        next()
    }
}

export function createNative(fn: Function) {
    return createNatives({ fn }).fn
}

export function createProgramStack() {
    const maxProgramStack = 64*1024*1024
    const rawAddr = mapCodePage(maxProgramStack as u32)
    const cell = rawAddr+maxProgramStack-8
    const addr = symbolicMemory(rawAddr)
    const rawWriteCell = createNative((v: usize) => {
        Intrinsics.store(addr, 0, v, Types.u64)
    })
    rawWriteCell(cell)

    function mark(): usize { 
        return Intrinsics.load(addr, 0, Types.u64) as usize
    }
    function reset(marker: usize) {
        Intrinsics.store(addr, 0, marker, Types.u64)
    }
    function alloc(numBytes: usize) {
        const aligned = (numBytes + 7) & ~7
        const ptr = Intrinsics.load(addr, 0, Types.u64)-aligned
        Intrinsics.store(addr, 0, ptr, Types.u64)
        return ptr
    }
    function free(numBytes: usize) {
        // this fn is the easiest one to break stuff with
        const aligned = (numBytes + 7) & ~7
        const ptr = Intrinsics.load(addr, 0, Types.u64)+aligned
        Intrinsics.store(addr, 0, ptr, Types.u64)
    }

    intrinsics.tagInline(mark)
    intrinsics.tagInline(reset)
    intrinsics.tagInline(alloc)
    intrinsics.tagInline(free)

    return {
        mark,
        reset,
        alloc,
        free,
    }
}

// cyclic
const traceModule = await import('./trace2')
const trace2 = traceModule.trace2
const createTraceSession = traceModule.createTraceSession
const symbolicMemory = traceModule.symbolicMemory
const fastTraceModule = await import('./fast-trace')
const normalizeStats: [string, number, boolean][] = []
