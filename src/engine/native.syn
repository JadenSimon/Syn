    interface Loc {
        param: number
        path: string
        base?: number
    }
    type Stored = Loc | intrinsics.Handle
    interface Content {
        value: Stored
        encoded: boolean
        fresh?: boolean
        float?: boolean
    }
    interface Summary {
        effects: { target: Loc, value: Stored, encoded: boolean }[]
        rets: Content[]
        fields: Map<intrinsics.Handle, Content>
    }
    interface Fact {
        shape: intrinsics.Handle | undefined
        encoded: boolean
        number?: boolean
        float?: boolean
        from?: [shape: intrinsics.Handle, path: string][]
        base?: number
    }
    const unknownValue = 0xFFFFFFFD as intrinsics.Handle
    const resultParam = -2
    const replacedFacts = new Set<string>()
    const summaries = new Map<Function, Summary>()
    const summarizing = new Set<Function>()
    const locationFacts = new Map<intrinsics.Handle, Map<string, Fact>>()
    const readLocations = new Map<intrinsics.Handle, Set<string>>()
