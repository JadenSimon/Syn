                if (recordShape !== undefined) {
                    for (const m of graph.nodes.values()) {
                        if (m.op !== NodeOp.store || strip(getRef(m, 1)) !== record || getRef(m, 2)) continue
                        const key = propertyEval.dataKeys(recordShape).find(k => propertyEval.fieldOffset(recordShape, k, refinements) === getLiteral(graph, m, 2))
                        const value = key === undefined ? undefined : storedOf(getRef(m, 3))
                        if (value === undefined || !isLoc(value)) continue
                        const next = { value, encoded: typeOf(m) === intrinsics.Types.vm_value }
                        const prior = fields.get(key!)
