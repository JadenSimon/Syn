                for (let i = 0; i < countIds(n); i++) {
                    const ref = getRef(n, i)
                    if (!ref || !forward.has(ref)) continue
                    operands ??= getOperands(graph, n)
                    operands[i] = chase(ref)
                }
                const current = operands ? copyNode(graph, n, operands) : n
                if (operands) setNode(graph, id, current)
                const folded = current.op === NodeOp.rt ? foldRuntime(graph, current) : undefined
                if (folded) {
                    setNode(graph, id, folded)
                    continue
                }
                if (foldable.has(current.op) && !getRef(current, 0) && !getRef(current, 1)) {
                    const a = getLiteral(graph, current, 0)
                    const b = getLiteral(graph, current, 1)
                    const r = saved[opName(current.op)](a, b)
                    forward.set(id, { literal: typeof r === 'boolean' ? (r ? 1 : 0) : r })
                    continue
                }
                if (current.op !== NodeOp.block && current.op !== NodeOp.param && current.op !== NodeOp.inlined && current.op !== NodeOp.apply && current.op !== NodeOp.ret) {
                    const key = `${current.op}:${current.slots.join(',')}`
                    const prior = consed.get(key)
                    if (prior !== undefined && prior !== id) {
                        forward.set(id, prior)
                        continue
                    }
                    consed.set(key, id)
                }
                if (current.op === NodeOp.select && countIds(current) === 3) {
                    const cond = getRef(current, 0)
                    const known = cond ? getNode(graph, cond) : undefined
                    if (!cond) forward.set(id, getOperand(graph, current, getLiteral(graph, current, 0) ? 1 : 2))
                    else if (known?.op === NodeOp.heapHandle && !getRef(known, 0)) forward.set(id, getOperand(graph, current, getLiteral(graph, known, 0) ? 1 : 2))
                }
            }
        }
        if (!forward.size) return
        for (const [id, n] of [...nodeEntries(graph)]) {
            let operands: Operand[] | undefined
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (!ref || !forward.has(ref)) continue
                operands ??= getOperands(graph, n)
                operands[i] = chase(ref)
            }
            if (operands) putCopy(graph, id, n, operands)
        }
        const blocks = graph.blocks.map(b => {
            if (!b.bodyId || !forward.has(b.bodyId)) return b
            const body = chase(b.bodyId)
            return typeof body === 'number' ? { ...b, bodyId: body } : { ...b, bodyId: 0, bodyConst: body.literal }
        })
        const reached = new Set<number>([blocks[0].id])
        const pending = [blocks[0]]
        const byId = new Map(blocks.map(b => [b.id, b]))
        while (pending.length) {
            const b = pending.pop()!
            const seen = reachableNodes({ ...graph, blocks: [b] } as Graph)
            for (const id of seen) {
                const n = getNode(graph, id)
                if (n?.op !== NodeOp.apply) continue
                const target = byId.get(getRef(n, 0))
                if (target && !reached.has(target.id)) {
                    reached.add(target.id)
                    pending.push(target)
                }
            }
        }
        setGraphBlocks(graph, blocks.filter(b => reached.has(b.id)))
    }
    function spliceCall(graph: Graph, traced: FastTraced, callId: number, callee: Function, prepared: Spliceable, regionSites: Set<number>): Map<number, number> {
        const site = getNode(graph, callId)!
        const callee_ = prepared.graph
        const compiled = codeOf(callee)!.source.compiled
        const rootBlock = callee_.blocks[0]
        const token = getOperand(callee_, site, 0)
        const args = getOperands(callee_, site, 3)
        const map = new Map<number, Operand>()
        let regular = 0
        let nullishNode = 0
        for (const p of rootBlock.params) {
            const pn = getNode(callee_, p)!
            if (isThisParam(pn)) {
                map.set(p, getOperand(callee_, site, 2))
                continue
            }
            if (regular < compiled.paramCount) {
                if (regular < args.length) map.set(p, args[regular])
                else map.set(p, nullishNode ||= addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }], Types.unknown_number))
                regular++
                continue
            }
            map.set(p, { literal: (1 << Math.min(args.length, compiled.paramCount)) - 1 })
        }
        const live = reachableNodes(callee_)
        for (const id of live) {
            const n = getNode(callee_, id)
            if (n?.op === NodeOp.nilEffect && countIds(n) && getRef(n, 0) === callee_.root) map.set(id, token)
        }
        const cells = new Map<number, number>()
        for (const [cell] of prepared.allocations) {
            const copy = runtimeObjects().intern(heap.makeObject(heap.getPrototypeOf(heap.deref(cell as intrinsics.Handle))))
            cells.set(cell, copy)
        }
        const fresh = new Map<number, number>()
        for (const id of live) if (!map.has(id)) fresh.set(id, newId(graph))
        for (const b of callee_.blocks) if (!map.has(b.id) && !fresh.has(b.id)) fresh.set(b.id, newId(graph))
        function remap(op: Operand): Operand {
            if (typeof op !== 'number') return op
            const known = map.get(op)
            if (known !== undefined) return known
            const copy = fresh.get(op)
            intrinsics.assert(copy !== undefined || !op, `native: splicing ${callee.name} names %${op} outside its graph`)
            return copy ?? op
        }
        const created: number[] = []
        for (const [id, copy] of fresh) {
            const n = getNode(callee_, id)
            if (!n) {
                setNode(graph, copy, makeNode(callee_, NodeOp.block, []))
                continue
            }
            const operands = getOperands(callee_, n).map(remap)
            if (n.op === NodeOp.heapHandle && !getRef(n, 0) && cells.has(getLiteral(callee_, n, 0))) {
                const copied = cells.get(getLiteral(callee_, n, 0))!
                operands[0] = { literal: copied }
                if (heapInterior(callee_, n)) operands[1] = { literal: heap.deref(copied as intrinsics.Handle) }
            }
            if (n.op === NodeOp.inlined && getLiteral(callee_, n, 1) === id) operands[1] = { literal: copy }
            const typeRef = typeRefOf(n)
            const node = copyNode(callee_, n, operands)
            if (typeRef) setType(node, { ref: remap(typeRef) as number })
            setNode(graph, copy, node)
            if (n.op === NodeOp.rt && getLiteral(callee_, n, 1) === rt.Op.create) created.push(copy)
        }
        for (const [cell, copy] of cells) {
            const call = prepared.allocations.get(cell as u32)!.call
            traced.allocations.set(copy as u32, { call: call ? remap(call) as number : undefined, token: typeof token === 'number' ? token : undefined })
        }
        for (const id of created) {
            const n = getNode(graph, id)!
            const proto = getNode(graph, getRef(n, 2))
            if (proto?.op !== NodeOp.heapHandle || getRef(proto, 0)) continue
            const cell = runtimeObjects().intern(heap.makeObject(heap.deref(getLiteral(callee_, proto, 0) as intrinsics.Handle)))
            putNode(graph, id, NodeOp.heapHandle, [{ literal: cell }], Types.unknown_number)
            traced.allocations.set(cell as u32, { call: undefined, token: typeof token === 'number' ? token : undefined })
        }
        for (const b of callee_.blocks.slice(1)) {
            graph.blocks.push({ id: fresh.get(b.id)!, params: b.params.map(p => remap(p) as number), bodyId: b.bodyId ? remap(b.bodyId) as number : 0, bodyConst: b.bodyConst })
        }
        setGraphBlocks(graph, graph.blocks)
        const body = rootBlock.bodyId
        if (!body) {
            putNode(graph, callId, NodeOp.after, [token, { literal: rootBlock.bodyConst }])
            return fresh
        }
        const ordered = new Map<number, number>()
        function orderApplies(id: number): number {
            const n = getNode(graph, id)
            if (!n || typeof token !== 'number') return id
            if (n.op === NodeOp.apply) {
                let wrapped = ordered.get(id)
                if (wrapped === undefined) ordered.set(id, wrapped = addNode(graph, NodeOp.after, [token, id]))
                return wrapped
            }
            if (n.op === NodeOp.ret) {
                let wrapped = ordered.get(id)
                if (wrapped === undefined) ordered.set(id, wrapped = addCopy(graph, n, withOperand(callee_, n, 0, addNode(graph, NodeOp.after, [token, getOperand(callee_, n, 0)]))))
                return wrapped
            }
            if (n.op !== NodeOp.select) return id
            let operands: Operand[] | undefined
            for (let i = 1; i < countIds(n); i++) {
                const arm = getRef(n, i)
                const next = arm ? orderApplies(arm) : arm
                if (next === arm) continue
                operands ??= getOperands(callee_, n)
                operands[i] = next
            }
            if (!operands) return id
            putCopy(graph, id, n, operands)
            return id
        }
        const result = orderApplies(remap(body) as number)
        const ret = getNode(graph, result)!
        if (ret.op === NodeOp.ret && simpleTail(graph, getRef(ret, 0), new Set(fresh.values()))) {
            const value = getOperand(callee_, ret, 0)
            const inner = typeof value === 'number' ? getNode(graph, value) : undefined
            if (inner?.op === NodeOp.after) putCopy(graph, callId, inner)
            else putNode(graph, callId, NodeOp.after, [token, value])
            return fresh
        }
        putNode(graph, callId, NodeOp.inlined, [result, { literal: callId }])
        regionSites.add(callId)
        return fresh
    }
    function simpleTail(graph: Graph, id: number, copies: Set<number>): boolean {
        const seen = new Set<number>()
        const stack = [id]
        while (stack.length) {
            const at = stack.pop()!
            if (!at || seen.has(at) || !copies.has(at)) continue
            seen.add(at)
            const n = getNode(graph, at)
            if (!n) continue
            if (n.op === NodeOp.apply || n.op === NodeOp.select || n.op === NodeOp.ret || n.op === NodeOp.join || n.op === NodeOp.trap || n.op === NodeOp.inlined || n.op === NodeOp.panic) return false
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return true
    }
    function uniformReturn(graph: Graph, root: number, allocations: Map<u32, Allocation>): number | undefined {
        const leaves: { ret: number, value: number, cell: number }[] = []
        const conditions: number[] = []
        let nested = false
        const seen = new Set<number>()
        const stack = [root]
        const blocks = new Map(graph.blocks.map(b => [b.id, b]))
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = getNode(graph, id)
            if (!n) continue
            if (n.op === NodeOp.ret) {
                const value = strippedAfter(graph, getRef(n, 0))
                const target = getNode(graph, value)
                if (target?.op !== NodeOp.heapHandle || getRef(target, 0)) return
                leaves.push({ ret: id, value, cell: getLiteral(graph, target, 0) })
                continue
            }
            if (n.op === NodeOp.select) {
                conditions.push(getRef(n, 0))
                for (let i = 1; i < countIds(n); i++) stack.push(getRef(n, i))
            }
            else if (n.op === NodeOp.after) stack.push(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.apply) {
                const block = blocks.get(getRef(n, 0))
                if (block) stack.push(block.bodyId)
                nested = true
            } else if (n.op === NodeOp.panic || n.op === NodeOp.unreachable || n.op === NodeOp.trap) continue
            else return
        }
        const cells = new Set(leaves.map(l => l.cell))
        if (!cells.size) return
        for (const cell of cells) if (!allocations.has(cell as u32)) return
        if (cells.size === 1) return leaves[0].value
        if (nested) return
        const keep = leaves[0].cell
        const proto = heap.getPrototypeOf(heap.deref(keep as intrinsics.Handle))
        for (const cell of cells) if (heap.getPrototypeOf(heap.deref(cell as intrinsics.Handle)) !== proto) return
        function touches(from: number[], own: number | undefined): boolean {
            const reached = new Set<number>()
            const walk = [...from]
            while (walk.length) {
                const id = walk.pop()!
                if (!id || reached.has(id)) continue
                reached.add(id)
                const n = getNode(graph, id)
                if (!n) continue
                if (n.op === NodeOp.heapHandle && !getRef(n, 0) && cells.has(getLiteral(graph, n, 0)) && getLiteral(graph, n, 0) !== own) return true
                nodeRefs(n, walk)
            }
            return false
        }
        if (touches(conditions, undefined)) return
        for (const leaf of leaves) if (touches([leaf.ret], leaf.cell)) return
        for (const [id, n] of [...nodeEntries(graph)]) {
            if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
            const cell = getLiteral(graph, n, 0)
            if (cell !== keep && cells.has(cell)) putNode(graph, id, NodeOp.heapHandle, heapInterior(graph, n) ? [{ literal: keep }, { literal: heap.deref(keep as intrinsics.Handle) }] : [{ literal: keep }], typeOf(n))
        }
        for (const cell of cells) if (cell !== keep) allocations.delete(cell as u32)
        return leaves[0].value
    }
    let frozen = false
    function freeze(): void {
        frozen = true
    }
    function graphsOf(fn: Function): Unit {
        const unit = unitOf(fn)
        if (unit.traced) return unit
        intrinsics.assert(!frozen, `native: ${fn.name} is traced after planning`)
        intrinsics.assert(!unit.tracing, `native: ${fn.name} is already being traced`)
        unit.tracing = true
        defer unit.tracing = false
        for (const dep of unit.deps ?? []) traceDependency(dep)
        const code = codeOf(fn)
        if (!code) throw `native: ${fn.name} has no code to trace`
        const verbose = flagged('trace-debug', fn.name)
        const origin = unitOf(originOf(fn))
        clock.timed('trace', () => {
            let traced = origin.trace
            if (!traced) {
                const traceStart = performance.now()
                traced = fastTraced(fn, verbose)
                if (flags.has('trace-time')) console.log('TRACETIME', fn.name, (performance.now() - traceStart).toFixed(2), countNodes(traced.graph))
                lowerPanics(traced.graph)
                engineHeapArrays(traced.graph)
                companionReads(traced.graph)
                ownProperties(traced)
                ownPresence(traced)
                outlineCold(fn, code, traced)
                if (flags.has(`traced-debug:${fn.name}`)) console.log(dumpGraph(traced.graph))
                origin.trace = traced
            }
            const base = origin !== unit && origin.traced ? origin.traced.graph : traced.graph
            const graph = withNodes(base, copyNodes(base))
            linkStatics(fn, graph)
            unit.source = code.source
            unit.traced = { ...traced, graph }
        }, fn.name)
        units.push(unit)
        return unit
    }
    return { units, graphsOf, freeze, lowerPanics, engineElements, heapValue, companions, traceProgramUnits, checkInlinedReads, foldStatics, fixedSlot, strippedAfter, reachableNodes }
}

type Tracer = ReturnType<typeof createTracer>

interface Planned {
    units: Map<Function, PlannedUnit>
    functions: Map<PlannedUnit, Function>
    frames: Map<u32, intrinsics.Handle>
    contexts: Map<Function, intrinsics.Handle>
    rewrites: Map<PlannedUnit, (graph: Graph) => void>
    shared: Map<PlannedUnit, PlannedUnit[]>
    regions: Map<PlannedUnit, [header: number, stacks: number[]][]>
}

function bindPlannedUnits(plan: ShapePlan, linker: Linker): Planned {
    const { unitOf, originOf, codeOf } = linker
    const planned: Planned = { units: new Map(), functions: new Map(), frames: new Map(), contexts: new Map(), rewrites: new Map(), shared: new Map(), regions: new Map() }
    const indirect = new Set<PlannedUnit>()
    for (const list of plan.units.values()) {
        for (const unit of list) {
            for (const callees of unit.calls.values()) {
                if (callees.size <= 1) continue
                for (const callee of callees) indirect.add(callee)
            }
        }
    }
    for (const list of plan.units.values()) {
        const first = list.findIndex(unit => indirect.has(unit))
        if (first > 0) list.unshift(...list.splice(first, 1))
    }
    for (const [fn, list] of plan.units) list.forEach((unit, i) => {
        const target = i === 0 ? fn : specialize(fn, `${fn.name || 'anon'}#p${i}`)
        planned.units.set(target, unit)
        planned.functions.set(unit, target)
    })
    function specialize(fn: Function, name: string): Function {
        const origin = originOf(fn)
        const specialized = namedStub(name)
        const unit = unitOf(specialized)
        unit.code = codeOf(origin)!
        unit.origin = origin
        return specialized
    }
    return planned
}

function sharePlannedUnits(plan: ShapePlan, planned: Planned, reps: Representations, host: AccessHost): void {
    function abiOf(unit: PlannedUnit): string {
        const abi = reps.abi.get(planned.functions.get(unit)!)!
        return `${abi.mode} ${abi.returns} ${abi.tags.join(',')} ${abi.mode === 'tagged' ? numberName(unit.returns) : ''}`
    }
    const shared = shareUnits(plan.units, plan.layoutOf, plan.reducedTarget, plan.embedded.sites, abiOf, fn => host.graphOf(fn))
    for (const [unit, kept] of shared) {
        const list = planned.shared.get(kept)
        if (list) list.push(unit)
        else planned.shared.set(kept, [unit])
        const fn = planned.functions.get(unit)!
        planned.units.delete(fn)
        planned.functions.delete(unit)
        reps.abi.delete(fn)
    }
}

function planFrames(types: ValueTypes, plan: ShapePlan, planned: Planned, linker: Linker, tracer: Tracer, facts: Facts): Views {
    const { sourceOfLinked } = linker
    const views: Views = new Map()
    for (const [fn, unit] of planned.units) {
        const traced = tracer.graphsOf(fn).traced!
        const proxy = traced.frameProxy
        if (proxy !== undefined && traced.frames.has(proxy) && !planned.frames.has(proxy)) planned.frames.set(proxy, propertyEval.frameShape(frameSize(sourceOfLinked(fn)!.captured), proxy as intrinsics.Handle))
        for (const [id, n] of nodeEntries(traced.graph)) {
            const rep = n.op === NodeOp.callContext ? unit.nodes.get(id) : undefined
            const shape = rep && plannedShape(plan, rep)
            if (shape !== undefined) planned.contexts.set(fn, shape)
        }
    }
    function frameOf(object: ObjectType): intrinsics.Handle | undefined {
        return object.kind === AllocKind.scope && object.native && object.state === undefined && object.handle !== undefined ? planned.frames.get(object.handle as u32) : undefined
    }
    function nativeShape(id: number, state: intrinsics.Handle, rep: Rep): intrinsics.Handle {
        const target = plan.inst.shapeOf(id)
        if (target === undefined || !rep.targets.includes(target)) return state
        const view = plan.shapes.get(target)!
        intrinsics.assert(views.get(state) === undefined || views.get(state) === view, `native: native state @${state} is viewed as two planned shapes`)
        views.set(state, view)
        return view
    }
    function valueShape(id: number, rep: Rep): intrinsics.Handle | undefined {
        const object = types.objects[id]
        const frame = frameOf(object)
        if (frame !== undefined) return frame
        if (object.state !== undefined && object.native) return nativeShape(id, object.state, rep)
        if (object.state !== undefined && object.constant) {
            const allocated = (types.stateAllocations.get(object.state) ?? []).filter(other => !types.objects[other].constant).map(other => plan.inst.shapeOf(other))
            if (allocated.length && allocated.every(shape => shape !== undefined && shape === allocated[0])) return plan.shapes.get(allocated[0]!)
            return plan.constants.get(object.state) ?? object.state
        }
        const shape = plan.inst.shapeOf(id)
        return shape === undefined ? undefined : plan.shapes.get(shape)
    }
    const number: Codec = { kind: 'int', encoded: false }
    function factsOf(type: Type): Codec[] {
        const rep = plan.inst.repOf(type)
        if (numberName(rep) === 'f64') return [{ kind: 'f64', encoded: false }]
        if (rep.kind === 'number') return [number]
        if (rep.kind === 'union') return [repFact(plan.shapes, rep, false)!]
        if (rep.kind !== 'pointer') return []
        const out: Codec[] = []
        if (type.strings.length) out.push({ kind: 'ref', shape: propertyEval.stringShape, encoded: false, union: false })
        for (const id of new Set([...type.objects, ...type.closures])) {
            if (types.objects[id].function !== undefined && rep.targets.includes('fn')) continue
            if (types.objects[id].kind === AllocKind.buffer) {
                out.push(number)
                continue
            }
            const shape = valueShape(id, rep)
            if (shape !== undefined) out.push({ kind: 'ref', shape, encoded: false, union: false })
        }
        if (rep.targets.length < 2 || !pointerOfShapes(rep)) return out
        const members = rep.targets.map(target => plan.shapes.get(target)!)
        return [{ kind: 'ref', shape: members[0], members, encoded: false, union: false }]
    }
    function keyOf(name: string): intrinsics.Handle | undefined {
        const index = /^\[(\d+)\]$/.exec(name)
        return index ? heap.indexKey(Number(index[1]) as u32) : types.keyHandles.get(name)
    }
    const fixed = new Set(plan.shapes.values())
    const held = new Map<intrinsics.Handle, Map<string, Type[]>>()
    for (const object of types.objects) {
        const native = object.state !== undefined && (object.native || object.constant)
        const holder = frameOf(object) ?? (!native ? undefined : object.constant ? plan.constants.get(object.state!) ?? object.state : object.state)
        if (holder === undefined || fixed.has(holder)) continue
        let fieldTypes = held.get(holder)
        if (!fieldTypes) held.set(holder, fieldTypes = new Map())
        for (const [name, field] of object.fields) {
            const list = fieldTypes.get(name)
            if (list) list.push(field.type)
            else fieldTypes.set(name, [field.type])
        }
    }
    for (const [holder, fieldTypes] of held) {
        const fields = propertyEval.recordLayout(holder, plan.embedded.fields, plan.bits)
        for (const [name, list] of fieldTypes) {
            const key = keyOf(name)
            const at = key === undefined ? -1 : fields.keys.indexOf(key)
            if (at < 0) continue
            const each = list.flatMap(factsOf)
            const mixed = each.some(fact => fact.encoded !== each[0].encoded)
            for (const fact of mixed ? factsOf(unionAll(list)) : each) setFact(facts, 'plan', holder, String(fields.offsets[at]), fact)
        }
    }
    return views
}

function soleTarget(rep: Rep): string | undefined {
    return rep.targets.length === 1 ? rep.targets[0] : undefined
}

function targetShape(plan: ShapePlan, target: string | undefined): intrinsics.Handle | undefined {
    if (target === undefined) return
    if (target.startsWith('clo@')) return Number(target.slice('clo@'.length)) as intrinsics.Handle
    return target.startsWith('S') ? plan.shapes.get(target) : undefined
}

function pointerFact(shape: intrinsics.Handle | undefined, encoded: boolean, union: boolean): Codec {
    return shape === undefined ? { kind: 'word', encoded } : { kind: 'ref', shape, encoded, union }
}

function repFact(shapes: Map<string, intrinsics.Handle>, rep: Rep, encoded: boolean): Codec | undefined {
    const target = rep.targets.length === 1 ? rep.targets[0] : undefined
    if (rep.kind === 'never' || rep.kind === 'undefined') return { kind: 'undefined', encoded }
    if (numberName(rep) === 'f64') return { kind: 'f64', encoded }
    if (rep.kind === 'number') return { kind: 'int', encoded, type: rawSlotType(rep, encoded) }
    if (rep.kind === 'pointer' && target === 'str') return pointerFact(propertyEval.stringShape, false, false)
    if (rep.kind === 'pointer' && target === 'fn') return { kind: 'word', encoded }
    if (rep.kind === 'pointer' && target?.startsWith('S') && !(encoded && rep.nullable)) return pointerFact(shapes.get(target), encoded, false)
    if (pointerOfShapes(rep) && !(encoded && rep.nullable)) {
        const members = rep.targets.map(t => shapes.get(t)!)
        return { kind: 'ref', shape: members[0], members, encoded, union: false }
    }
    if (rep.kind === 'pointer' && target?.startsWith('clo@') && !rep.nullable) return pointerFact(Number(target.slice('clo@'.length)) as intrinsics.Handle, encoded, false)
    if (mixedMembers(rep)) {
        const members = objectRep(rep).targets.map(t => shapes.get(t)!)
        return { kind: 'ref', shape: members[0], members: members.length > 1 ? members : undefined, encoded: true, union: true, primitives: primitiveShapes(rep) }
    }
    if (rep.kind === 'union' && target?.startsWith('S')) return shapes.get(target) === undefined ? { kind: 'int', encoded: true } : pointerFact(shapes.get(target), true, true)
    if (rep.kind === 'union' && rep.targets.length > 1 && rep.targets.every(t => t.startsWith('S'))) {
        const members = rep.targets.map(t => shapes.get(t)!)
        return { kind: 'ref', shape: members[0], members, encoded: true, union: true }
    }
    return { kind: 'word', encoded: true }
}

function plannedShape(plan: ShapePlan, rep: Rep): intrinsics.Handle | undefined {
    const target = soleTarget(rep)
    if (rep.kind === 'union') return target?.startsWith('S') ? targetShape(plan, target) : undefined
    if (rep.kind !== 'pointer') return
    if (target === 'str') return rep.nullable ? undefined : propertyEval.stringShape
    return targetShape(plan, target)
}

function plannedMembers(plan: ShapePlan, rep: Rep): intrinsics.Handle[] | undefined {
    if (rep.kind !== 'pointer' && rep.kind !== 'union') return
    if (rep.targets.length < 2 || !rep.targets.every(target => target.startsWith('S'))) return
    return rep.targets.map(target => plan.shapes.get(target)!)
}

function planShapeTags(inst: Instantiations, units: Map<Function, PlannedUnit[]>, graphOf: (fn: Function) => Graph, fieldKey: (name: string) => intrinsics.Handle | undefined, taggable: (sig: ShapeSignature) => boolean): Map<string, number> {
    function shapesOf(rep: Rep | undefined): string[] | undefined {
        if (!rep) return
        const objects = objectRep(rep)
        if (objects.targets.length < 2 || !objects.targets.every(target => target.startsWith('S'))) return
        if (objects.kind !== 'pointer' && (objects.kind !== 'union' || objects.bools)) return
        return objects.targets
    }
    const compared = new Map<string, boolean>()
    function sameSig(a: string, b: string): boolean {
        if (a === b) return true
        const pair = `${a}|${b}`
        const known = compared.get(pair)
        if (known !== undefined) return known
        compared.set(pair, true)
        const same = sameFields(a, b)
        compared.set(pair, same)
        return same
    }
    function sameFields(a: string, b: string): boolean {
        const x = inst.shapes.get(a)
        const y = inst.shapes.get(b)
        if (!x || !y || x.proto !== y.proto || x.fields.length !== y.fields.length) return false
        for (let i = 0; i < x.fields.length; i++) {
            if (x.fields[i][0] !== y.fields[i][0] || !sameRep(x.fields[i][1], y.fields[i][1])) return false
        }
        return true
    }
    function sameRep(a: Rep, b: Rep): boolean {
        if (a.text === b.text) return true
        if (a.kind !== b.kind || a.nullable !== b.nullable || a.targets.length !== b.targets.length) return false
        if (a.kind === 'buffer') return !!a.element && !!b.element && sameRep(a.element, b.element)
        if (a.kind !== 'pointer') return false
        for (let i = 0; i < a.targets.length; i++) {
            if (!a.targets[i].startsWith('S') || !b.targets[i].startsWith('S') || !sameSig(a.targets[i], b.targets[i])) return false
        }
        return true
    }
    function fieldAt(sig: ShapeSignature, key: intrinsics.Handle): number {
        return sig.fields.findIndex(([name]) => fieldKey(name) === key)
    }
    function inherited(sig: ShapeSignature, key: intrinsics.Handle): intrinsics.Handle {
        const addr = sig.proto ? heap.getPropertyDescriptor(sig.proto, key) : 0
        return addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).slot0 as intrinsics.Handle : 0 as intrinsics.Handle
    }
    function chain(target: string): string {
        const protos: intrinsics.Handle[] = []
        let at = inst.shapes.get(target)!.proto ?? 0 as intrinsics.Handle
        while (at) {
            protos.push(at)
            at = heap.getPrototypeOf(at)
        }
        return protos.join(',')
    }
    function agreesOn(targets: string[], key: intrinsics.Handle): boolean {
        const first = inst.shapes.get(targets[0])!
        const at = fieldAt(first, key)
        for (const target of targets) {
            const sig = inst.shapes.get(target)!
            if (fieldAt(sig, key) !== at) return false
            if (at < 0 && inherited(sig, key) !== inherited(first, key)) return false
            for (let i = 0; i <= at; i++) {
                if (sig.fields[i][0] !== first.fields[i][0] || !sameRep(sig.fields[i][1], first.fields[i][1])) return false
            }
        }
        return true
    }
    function callable(target: string): boolean {
        return fieldAt(inst.shapes.get(target)!, heap.closureCallKey) >= 0
    }
    function agrees(graph: Graph, n: GraphNode, targets: string[]): boolean {
        if (n.op === NodeOp.rt && getLiteral(graph, n, 1) === rt.Op.typeof) return targets.every(target => callable(target) === callable(targets[0]))
        if (n.op === NodeOp.rt) return targets.every(target => chain(target) === chain(targets[0]))
        if (getRef(n, 2)) return false
        return agreesOn(targets, getLiteral(graph, n, 2) as intrinsics.Handle)
    }
    function objectOf(n: GraphNode): number {
        return n.op === NodeOp.rt ? getRef(n, 2) : getRef(n, 1)
    }
    const demanded = new Set<string>()
    const linked = new Map<string, Set<string>>()
    function link(targets: string[] | undefined): void {
        if (!targets) return
        for (const target of targets) {
            let set = linked.get(target)
            if (!set) linked.set(target, set = new Set())
            for (const other of targets) set.add(other)
        }
    }
    for (const [fn, list] of units) {
        const graph = graphOf(fn)
        const owners = new Map<number, number>()
        for (const b of graph.blocks) for (const p of b.params) owners.set(p, b.id)
        let applies: Map<number, number[]> | undefined
        function appliesInto(block: number): number[] {
            if (!applies) {
                applies = new Map()
                for (const [id, n] of nodeEntries(graph)) {
                    if (n.op !== NodeOp.apply) continue
                    const known = applies.get(getRef(n, 0))
                    if (known) known.push(id)
                    else applies.set(getRef(n, 0), [id])
                }
            }
            return applies.get(block) ?? []
        }
        for (const unit of list) {
            function repAt(value: number): Rep | undefined {
                const id = tailOf(graph, value)
                const index = graph.blocks[0].params.indexOf(id)
                return index < 0 ? unit.nodes.get(id) : unit.params[index]?.rep
            }
            const seen = new Map<number, boolean>()
            function tagged(value: number): boolean {
                const id = tailOf(graph, value)
                if (!shapesOf(repAt(id))) return true
                const known = seen.get(id)
                if (known !== undefined) return known
                seen.set(id, true)
                const result = taggedNow(id)
                seen.set(id, result)
                return result
            }
            function taggedNow(id: number): boolean {
                const n = getNode(graph, id)
                if (!n) return false
                if (n.op === NodeOp.heapHandle) return true
                if (n.op === NodeOp.param) {
                    const block = owners.get(id)
                    if (block === undefined || block === graph.blocks[0].id) return false
                    const index = getBlock(graph, block)!.params.indexOf(id)
                    for (const apply of appliesInto(block)) {
                        if (!tagged(getRef(getNode(graph, apply)!, index + 1))) return false
                    }
                    return true
                }
                if (n.op === NodeOp.getProp) return dispatched(n)
                if (n.op !== NodeOp.call) return false
                if ([...unit.calls.get(id) ?? []].some(callee => shapesOf(callee.returns))) return false
                const target = getNode(graph, tailOf(graph, getRef(n, 1)))
                return target?.op === NodeOp.getProp && dispatched(target)
            }
            function dispatched(n: GraphNode): boolean {
                const targets = shapesOf(repAt(objectOf(n)))
                if (!targets) return false
                return tagged(objectOf(n)) || !agrees(graph, n, targets)
            }
            for (const n of allNodes(graph)) {
                const access = n.op === NodeOp.getProp || n.op === NodeOp.setProp || (n.op === NodeOp.rt && (getLiteral(graph, n, 1) === rt.Op.hasPrototype || getLiteral(graph, n, 1) === rt.Op.typeof))
                if (!access) continue
                const targets = shapesOf(repAt(objectOf(n)))
                link(targets)
                if (!targets || agrees(graph, n, targets) || tagged(objectOf(n))) continue
                for (const target of targets) demanded.add(target)
            }
        }
    }
    const ids = new Map<string, number>()
    const placed = new Set<string>()
    for (const start of [...demanded].sort()) {
        if (placed.has(start)) continue
        const component = [start]
        placed.add(start)
        for (let i = 0; i < component.length; i++) {
            for (const other of linked.get(component[i]) ?? []) {
                if (placed.has(other)) continue
                placed.add(other)
                component.push(other)
            }
        }
        const untaggable = component.filter(target => !inst.shapes.has(target) || !taggable(inst.shapes.get(target)!))
        if (flags.has('plan') && untaggable.length) console.log('SHAPE-TAG-SKIP', component.join(','), 'untaggable', untaggable.join(','))
        for (const target of component.sort()) if (!untaggable.includes(target)) ids.set(target, ids.size + 1)
    }
    return ids
}

const narrowUndefined = 2 ** 32

const runtimeHeapAccessors = new Set<Function>([heap.getIntProperty, heap.getFloatProperty, heap.getHandleProperty, heap.setIntProperty, heap.setFloatProperty, heap.setHandleProperty, heap.deleteHandleProperty])

interface TagFlow {
    marked: Map<PlannedUnit, Set<number>>
    unknown: Map<PlannedUnit, Set<number>>
    absent: Map<PlannedUnit, Set<number>>
    fields: Map<intrinsics.Handle, Set<intrinsics.Handle>>
    peerOf: Map<PlannedUnit, PlannedUnit>
}

function floatJoins(unit: PlannedUnit, graph: Graph, id: number, n: GraphNode, joined: (ref: number) => void): void {
    const root = graph.blocks[0]
    const repOf = (x: number) => unit.nodes.get(x) ?? unit.params[root.params.indexOf(x)]?.rep
    if (n.op === NodeOp.apply) {
        const params = getBlock(graph, getRef(n, 0))?.params ?? []
        params.forEach((p, i) => {
            if (getRef(n, i + 1) && floatUnion(repOf(p))) joined(getRef(n, i + 1))
        })
    } else if (n.op === NodeOp.select && floatUnion(repOf(id))) {
        for (let i = 1; i < countIds(n); i++) if (getRef(n, i)) joined(getRef(n, i))
    } else if (n.op === NodeOp.ret && getRef(n, 0) && floatUnion(unit.returns)) {
        joined(getRef(n, 0))
    } else if (n.op === NodeOp.call) {
        for (const callee of unit.calls.get(id) ?? []) {
            callee.params.forEach((param, i) => {
                if (3 + i < countIds(n) && getRef(n, 3 + i) && floatUnion(param.rep)) joined(getRef(n, 3 + i))
            })
        }
    }
}

function tagKnown(tags: TagFlow, unit: PlannedUnit, id: number): boolean {
    const peer = tags.peerOf.get(unit) ?? unit
    return !!tags.marked.get(peer)?.has(id) && !tags.unknown.get(peer)?.has(id)
}

function tagged(tags: TagFlow, unit: PlannedUnit, id: number): boolean {
    return tagKnown(tags, unit, id) && !!tags.absent.get(tags.peerOf.get(unit) ?? unit)?.has(id)
}

function trackedTags(tags: TagFlow, unit: PlannedUnit): Map<number, boolean> {
    const peer = tags.peerOf.get(unit) ?? unit
    const unknown = tags.unknown.get(peer)
    const absent = tags.absent.get(peer)
    const out = new Map<number, boolean>()
    for (const id of tags.marked.get(peer) ?? []) {
        if (!unknown?.has(id)) out.set(id, !!absent?.has(id))
    }
    return out
}

function taggedTargets(plan: ShapePlan, unit: PlannedUnit, graph: Graph, object: number, key: intrinsics.Handle): intrinsics.Handle[] | undefined {
    const value = tailOf(graph, object)
    const index = graph.blocks[0].params.indexOf(value)
    const rep = index < 0 ? unit.nodes.get(value) : unit.params[index]?.rep
    if (!rep || (rep.kind !== 'pointer' && rep.kind !== 'union') || !rep.targets.length) return
    const shapes = rep.targets.map(target => targetShape(plan, target)!)
    return shapes.every(shape => !!plan.bits.get(shape)?.tagged.has(key)) ? shapes : undefined
}

function fieldStores(plan: ShapePlan, unit: PlannedUnit, graph: Graph, id: number, n: GraphNode, add: (shapes: intrinsics.Handle[], key: intrinsics.Handle, value: number) => void): void {
    if (n.op === NodeOp.setProp && !getRef(n, 2) && getRef(n, 3)) {
        const key = getLiteral(graph, n, 2) as intrinsics.Handle
        const shapes = taggedTargets(plan, unit, graph, getRef(n, 1), key)
        if (shapes) add(shapes, key, getRef(n, 3))
        return
    }
    if (n.op !== NodeOp.heapHandle || !heapInterior(graph, n)) return
    for (let i = 0; i < heapFieldCount(n); i++) {
        const value = heapFieldOperand(graph, n, i)
        const key = heapFieldKey(graph, n, i) as intrinsics.Handle
        if (typeof value !== 'number' || !value || snapshotField(heapInterior(graph, n) as intrinsics.Handle, key) === undefined) continue
        const shapes = taggedTargets(plan, unit, graph, id, key)
        if (shapes) add(shapes, key, value)
    }
}

function analyzeTags(plan: ShapePlan, planned: Planned, tracedOf: (unit: PlannedUnit) => Graph, returnTaggable: (unit: PlannedUnit) => boolean, linker: Linker, classes: Map<PlannedUnit, number>): TagFlow {
    const { isRoot, sourceOfLinked } = linker
    const marked = new Map<PlannedUnit, Set<number>>()
    const dependents = new Map<PlannedUnit, Map<number, [PlannedUnit, number][]>>()
    const leaves: [PlannedUnit, number][] = []
    const seeds: [PlannedUnit, number][] = []
    const incoming = new Map<PlannedUnit, [PlannedUnit, number][]>()
    const shared = new Set<PlannedUnit>()
    const peerOf = new Map<PlannedUnit, PlannedUnit>()
    const firsts = new Map<number, PlannedUnit>()
    for (const unit of planned.units.values()) {
        const id = classes.get(unit)
        if (id === undefined) continue
        const first = firsts.get(id)
        if (first) peerOf.set(unit, first)
        else firsts.set(id, unit)
    }
    function peer(unit: PlannedUnit): PlannedUnit {
        return peerOf.get(unit) ?? unit
    }
    const rooted = new Set<PlannedUnit>()
    for (const [fn, unit] of planned.units) if (isRoot(fn)) rooted.add(peer(unit))
    for (const caller of planned.units.values()) {
        for (const [call, callees] of caller.calls) {
            const peers = new Set([...callees].map(peer))
            for (const callee of peers) {
                let list = incoming.get(callee)
                if (!list) incoming.set(callee, list = [])
                list.push([caller, call])
                if (peers.size > 1) shared.add(callee)
            }
        }
    }
    const arrivals = new Map<PlannedUnit, Arrivals>()
    function arrivalsOf(unit: PlannedUnit): Arrivals {
        let known = arrivals.get(unit)
        if (!known) arrivals.set(unit, known = paramArrivals(tracedOf(unit)))
        return known
    }
    const work: [PlannedUnit, number][] = []
    function needAt(of: PlannedUnit, n: GraphNode, slot: number, user: PlannedUnit, userId: number): void {
        if (slot >= countIds(n)) seeds.push([user, userId])
        else need(of, getRef(n, slot), user, userId)
    }
    function need(of: PlannedUnit, id: number, user?: PlannedUnit, userId?: number): void {
        if (!id) return
        const unit = peer(of)
        if (user) {
            let byNode = dependents.get(unit)
            if (!byNode) dependents.set(unit, byNode = new Map())
            const list = byNode.get(id)
            if (list) list.push([user, userId!])
            else byNode.set(id, [[user, userId!]])
        }
        let set = marked.get(unit)
        if (!set) marked.set(unit, set = new Set())
        if (set.has(id)) return
        set.add(id)
        work.push([unit, id])
    }
    const stores = new Map<intrinsics.Handle, Map<intrinsics.Handle, [PlannedUnit, number][]>>()
    const fields = new Map<intrinsics.Handle, Set<intrinsics.Handle>>()
    function demand(shapes: intrinsics.Handle[], key: intrinsics.Handle): void {
        for (const shape of shapes) {
            let known = fields.get(shape)
            if (!known) fields.set(shape, known = new Set())
            if (known.has(key)) continue
            known.add(key)
            for (const [unit, value] of stores.get(shape)?.get(key) ?? []) need(unit, value)
        }
    }
    for (const unit of planned.units.values()) {
        const graph = tracedOf(unit)
        for (const [id, n] of nodeEntries(graph)) {
            fieldStores(plan, unit, graph, id, n, (shapes, key, value) => {
                for (const shape of shapes) {
                    let byKey = stores.get(shape)
                    if (!byKey) stores.set(shape, byKey = new Map())
                    const list = byKey.get(key)
                    if (list) list.push([unit, value])
                    else byKey.set(key, [[unit, value]])
                }
            })
        }
    }
    for (const unit of planned.units.values()) {
        const graph = tracedOf(unit)
        for (const [id, n] of nodeEntries(graph)) {
            if (rt.sliceOf(graph, n) === rt.Op.sliceWrite && (taggedSlice(unit.slices, id) || nullableWord(unit.slices.get(id)))) need(unit, getRef(n, 4))
            if (n.op === NodeOp.rt && getLiteral(graph, n, 1) === rt.Op.typeof && getRef(n, 2) && nullableNumber(unit.nodes.get(tailOf(graph, getRef(n, 2))))) need(unit, getRef(n, 2))
            floatJoins(unit, graph, id, n, ref => {
                if (nullableNumber(unit.nodes.get(tailOf(graph, ref)))) need(unit, ref)
            })
            if ((n.op !== NodeOp.eq && n.op !== NodeOp.ne) || countIds(n) !== 2) continue
            for (const side of [0, 1]) {
                const ref = getRef(n, side)
                if (ref && nullableNumber(unit.nodes.get(tailOf(graph, ref))) && !nonzeroLiteral(graph, n, 1 - side)) need(unit, ref)
            }
        }
    }
    while (work.length) {
        const [unit, id] = work.pop()!
        const graph = tracedOf(unit)
        const n = getNode(graph, id)
        if (!n) {
            leaves.push([unit, id])
            continue
        }
        const index = graph.blocks[0].params.indexOf(id)
        const rep = index < 0 ? unit.nodes.get(id) : unit.params[index]?.rep
        if (rep?.kind === 'number' && !rep.nullable) continue
        if (n.op === NodeOp.after) {
            needAt(unit, n, countIds(n) - 1, unit, id)
            continue
        }
        if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) need(unit, getRef(n, i), unit, id)
            continue
        }
        if (n.op === NodeOp.param) {
            if (index < 0) {
                const from = arrivalsOf(unit).get(id)
                if (!from) leaves.push([unit, id])
                else for (const arrival of from) need(unit, arrival, unit, id)
                continue
            }
            const fn = planned.functions.get(unit)!
            if (rooted.has(unit) || shared.has(unit) || index >= (sourceOfLinked(fn)?.compiled.paramCount ?? 0) || !nullableNumber(unit.params[index]?.rep)) {
                leaves.push([unit, id])
                continue
            }
            for (const [caller, call] of incoming.get(unit) ?? []) {
                const site = getNode(tracedOf(caller), call)
                if (!site || (site.op !== NodeOp.call && site.op !== NodeOp.rt)) leaves.push([unit, id])
                else needAt(caller, site, (site.op === NodeOp.rt ? 2 : 3) + index, unit, id)
            }
            continue
        }
        if (rt.sliceOf(graph, n) === rt.Op.sliceRead && unit.slices.has(id)) {
            if (unit.slices.get(id)!.nullable) seeds.push([unit, id])
            continue
        }
        const read = n.op === NodeOp.getProp && !getRef(n, 2) ? taggedTargets(plan, unit, graph, getRef(n, 1), getLiteral(graph, n, 2) as intrinsics.Handle) : undefined
        if (read) {
            demand(read, getLiteral(graph, n, 2) as intrinsics.Handle)
            seeds.push([unit, id])
            continue
        }
        if (n.op === NodeOp.call || (n.op === NodeOp.getProp && unit.calls.has(id))) {
            const callees = unit.calls.get(id)
            if (!callees?.size || ![...callees].every(returnTaggable)) {
                leaves.push([unit, id])
                continue
            }
            for (const callee of callees) for (const ret of ownRets(tracedOf(callee))) needAt(callee, getNode(tracedOf(callee), ret)!, 0, unit, id)
            continue
        }
        if (isNullishValue(graph, id) || n.op === NodeOp.void) {
            seeds.push([unit, id])
            continue
        }
        if (n.op === NodeOp.literal) continue
        leaves.push([unit, id])
    }
    const absent = new Map<PlannedUnit, Set<number>>()
    const reaching = [...seeds, ...leaves]
    while (reaching.length) {
        const [unit, id] = reaching.pop()!
        let set = absent.get(unit)
        if (!set) absent.set(unit, set = new Set())
        if (set.has(id)) continue
        set.add(id)
        for (const dependent of dependents.get(unit)?.get(id) ?? []) reaching.push(dependent)
    }
    const unknown = new Map<PlannedUnit, Set<number>>()
    while (leaves.length) {
        const [unit, id] = leaves.pop()!
        let set = unknown.get(unit)
        if (!set) unknown.set(unit, set = new Set())
        if (set.has(id)) continue
        set.add(id)
        for (const dependent of dependents.get(unit)?.get(id) ?? []) leaves.push(dependent)
    }
    return { marked, unknown, absent, fields, peerOf }
}

function nullableOf(rep: Rep): Rep {
    return rep.kind !== 'number' || rep.nullable ? rep : { ...rep, nullable: true, text: `${rep.text}?` }
}

function joinNullableNumbers(planned: Planned, classes: Map<PlannedUnit, number>): void {
    const members = new Map<number, PlannedUnit[]>()
    for (const unit of planned.units.values()) {
        const id = classes.get(unit)
        if (id === undefined) continue
        const list = members.get(id)
        if (list) list.push(unit)
        else members.set(id, [unit])
    }
    for (const list of members.values()) {
        if (list.length < 2) continue
        const params = new Set<number>()
        const nodes = new Set<number>()
        let returns = false
        for (const unit of list) {
            for (let i = 0; i < unit.params.length; i++) if (nullableNumber(unit.params[i].rep)) params.add(i)
            for (const [id, rep] of unit.nodes) if (nullableNumber(rep)) nodes.add(id)
            if (nullableNumber(unit.returns)) returns = true
        }
        for (const unit of list) {
            unit.params = unit.params.map((param, i) => params.has(i) ? { label: param.label, rep: nullableOf(param.rep) } : param)
            if (returns) unit.returns = nullableOf(unit.returns)
            if (nodes.size) unit.nodes = new Map([...unit.nodes].map(([id, rep]) => [id, nodes.has(id) ? nullableOf(rep) : rep]))
        }
    }
}

export type ReturnMode = 'encoded' | 'raw' | 'keep' | 'tagged' | 'narrow' | 'record'

export interface UnitAbi {
    mode: ReturnMode
    returns: intrinsics.Types
    tags: number[]
}

interface Representations {
    abi: Map<Function, UnitAbi>
    tags: TagFlow
}

function chooseRepresentations(plan: ShapePlan, planned: Planned, linker: Linker, tracer: Tracer, host: AccessHost): Representations {
    const { staticFns, unitOf, originOf, constructsOutOfLine, isRoot } = linker
    function tracedOf(unit: PlannedUnit): Graph {
        return tracer.graphsOf(planned.functions.get(unit)!).traced!.graph
    }
    function returnTaggable(unit: PlannedUnit): boolean {
        return nullableNumber(unit.returns) && !constructsOutOfLine(planned.functions.get(unit)!)
    }
    const classes = shareClasses(plan.units, plan.layoutOf, plan.reducedTarget, plan.embedded.sites, () => '', fn => host.graphOf(fn))
    joinNullableNumbers(planned, classes)
    const tags = analyzeTags(plan, planned, tracedOf, returnTaggable, linker, classes)
    for (const shape of plan.shapes.values()) {
        const kinds = plan.bits.get(shape)
        if (!kinds) continue
        for (const key of [...kinds.tagged]) if (!tags.fields.get(shape)?.has(key)) kinds.tagged.delete(key)
    }
    function returnsTag(unit: PlannedUnit): boolean {
        if (!returnTaggable(unit)) return false
        const graph = tracedOf(unit)
        const values = ownRets(graph).map(ret => getRef(getNode(graph, ret)!, 0)).filter(value => value !== 0)
        return values.some(value => tagged(tags, unit, value)) && values.every(value => tagKnown(tags, unit, value))
    }
    function paramTags(unit: PlannedUnit): number[] {
        const params = tracedOf(unit).blocks[0].params
        const out: number[] = []
        params.forEach((param, i) => {
            if (nullableNumber(unit.params[i]?.rep) && tagged(tags, unit, param)) out.push(i)
        })
        return out
    }
    function agreedPointer(fn: Function): boolean {
        const returned = planned.units.get(fn)!.returns
        if (isRoot(fn) || staticFns.includes(fn) || returned.kind !== 'pointer' || !returned.fresh) return false
        const target = soleTarget(returned)
        return target !== undefined && target.startsWith('S') && plannedShape(plan, returned) !== undefined
    }
    const modes = new Map<Function, ReturnMode>()
    const producing = new Set<Function>()
    function producesRaw(fn: Function): boolean {
        if (producing.has(fn)) return false
        producing.add(fn)
        defer producing.delete(fn)
        const unit = planned.units.get(fn)!
        const graph = tracer.graphsOf(fn).traced!.graph
        const arrivals = paramArrivals(graph)
        const seen = new Set<number>()
        function raw(id: number): boolean {
            if (!id || seen.has(id)) return true
            seen.add(id)
            const n = getNode(graph, id)
            if (!n) return false
            if (n.op === NodeOp.after) return raw(getRef(n, countIds(n) - 1))
            if (n.op === NodeOp.select) return raw(getRef(n, 1)) && raw(getRef(n, 2))
            if (n.op === NodeOp.ret || n.op === NodeOp.inlined) return raw(getRef(n, 0))
            if (n.op === NodeOp.panic || n.op === NodeOp.unreachable || n.op === NodeOp.literal) return true
            if (rt.sliceOf(graph, n) === rt.Op.sliceRead) return rawSlice(unit.slices, id)
            if (n.op === NodeOp.heapHandle && !getRef(n, 0)) return heap.isNullishHandle(getLiteral(graph, n, 0) as intrinsics.Handle) || unit.allocations.has(id)
            if (n.op === NodeOp.param) return graph.blocks[0].params.includes(id) || (arrivals.has(id) && arrivals.get(id)!.every(raw))
            if (n.op === NodeOp.call || n.op === NodeOp.getProp) {
                const callees = unit.calls.get(id)
                return !!callees?.size && [...callees].every(callee => modeOf(planned.functions.get(callee)!) === 'raw')
            }
            return false
        }
        return [...nodeEntries(graph)].every(([id, n]) => n.op !== NodeOp.ret || !getRef(n, 0) || raw(id))
    }
    function modeOf(fn: Function): ReturnMode {
        const known = modes.get(fn)
        if (known !== undefined) return known
        const unit = planned.units.get(fn)!
        const mode: ReturnMode = constructsOutOfLine(fn) ? 'keep' : returnsTag(unit) ? 'tagged' : floatUnion(unit.returns) ? 'record' : unitOf(originOf(fn)).stubbed ? 'keep' : agreedPointer(fn) && (!unit.returns.nullable || producesRaw(fn)) ? 'raw' : 'encoded'
        modes.set(fn, mode)
        return mode
    }
    for (const fn of planned.units.keys()) modeOf(fn)
    const direct = new Set<Function>()
    const returnedBy = new Map<Function, Function[]>()
    const returnedCalls = new Map<Function, Function[]>()
    const unsized = new Set<Function>()
    const slotLoads = new Set<Function>()
    for (const [fn, unit] of planned.units) {
        const graph = tracer.graphsOf(unit.fn).traced!.graph
        const visited = new Set<number>()
        const calls: Function[] = []
        returnedCalls.set(fn, calls)
        function visit(ref: number): void {
            const id = tailOf(graph, ref)
            const n = getNode(graph, id)
            if (!n || visited.has(id)) return
            visited.add(id)
            if (n.op === NodeOp.call || (n.op === NodeOp.getProp && unit.calls.has(id))) {
                if (!unit.calls.get(id)?.size) unsized.add(fn)
                for (const callee of unit.calls.get(id) ?? []) {
                    const target = planned.functions.get(callee)!
                    calls.push(target)
                    const list = returnedBy.get(target)
                    if (list) list.push(fn)
                    else returnedBy.set(target, [fn])
                }
                return
            }
            if (n.op === NodeOp.select) {
                for (let i = 1; i < countIds(n); i++) if (getRef(n, i)) visit(getRef(n, i))
                return
            }
            const read = rt.sliceOf(graph, n) === rt.Op.sliceRead
            const decoded = read && unit.tagged.has(id) && unit.nodes.get(id)?.kind !== 'union'
            const word = !decoded && (read ? rt.elementType(graph, n) === Types.vm_value && !rawSlice(unit.slices, id) : resultType(graph, n) === Types.vm_value)
            const slot = word && (n.op === NodeOp.load || read) && !unit.tagged.has(id) ? rawSlotType(unit.nodes.get(id), true) : undefined
            if (slot === Types.u32) slotLoads.add(fn)
            else if (word && slot === undefined) direct.add(fn)
            else if (word || n.op !== NodeOp.heapHandle || getRef(n, 0) || getLiteral(graph, n, 0)) unsized.add(fn)
        }
        for (const n of allNodes(graph)) if (n.op === NodeOp.ret && getRef(n, 0)) visit(getRef(n, 0))
    }
    const words = new Set<Function>()
    const reaching = [...direct]
    while (reaching.length) {
        const fn = reaching.pop()!
        if (words.has(fn)) continue
        words.add(fn)
        if (modes.get(fn) === 'raw' || (modes.get(fn) === 'tagged' && numberName(planned.units.get(fn)!.returns) === 'f64')) continue
        for (const caller of returnedBy.get(fn) ?? []) reaching.push(caller)
    }
    const slotSized = new Map<Function, boolean>()
    function returnsSlot(fn: Function): boolean {
        const known = slotSized.get(fn)
        if (known !== undefined) return known
        slotSized.set(fn, false)
        const sized = !unsized.has(fn) && !words.has(fn) && modes.get(fn) !== 'raw' && returnedCalls.get(fn)!.every(returnsSlot) && (returnedCalls.get(fn)!.length > 0 || slotLoads.has(fn))
        slotSized.set(fn, sized)
        return sized
    }
    const compared = new Set<Function>()
    for (const unit of planned.units.values()) {
        const graph = tracedOf(unit)
        for (const n of allNodes(graph)) {
            if ((n.op !== NodeOp.eq && n.op !== NodeOp.ne) || countIds(n) !== 2) continue
            for (const side of [0, 1]) {
                const call = getRef(n, side)
                const other = getRef(n, 1 - side)
                if (!unit.calls.has(call) || (other && getNode(graph, other)?.op !== NodeOp.literal)) continue
                for (const callee of unit.calls.get(call)!) compared.add(planned.functions.get(callee)!)
            }
        }
    }
    const abi = new Map<Function, UnitAbi>()
    for (const [fn, unit] of planned.units) {
        const mode = modes.get(fn) === 'tagged' && !words.has(fn) && unit.returns.format?.bits === 32 && compared.has(fn) ? 'narrow' : modes.get(fn)!
        const returns = mode === 'raw' || (mode === 'tagged' && numberName(unit.returns) === 'f64') ? Types.u64 : words.has(fn) ? Types.vm_value : returnsSlot(fn) && mode !== 'narrow' ? Types.u32 : numberName(unit.returns) === 'f64' ? Types.f64 : numberName(unit.returns) === 'i64' ? Types.i64 : Types.u64
        abi.set(fn, { mode, returns, tags: paramTags(unit) })
        if (flags.has('return-modes')) console.log('RETURN-MODE', fn.name, mode, unit.returns.text)
    }
    return { abi, tags }
}

export interface CallCodec {
    params?: Map<number, Arrival>
    raw?: boolean
    returned?: { mode: 'tagged' | 'narrow' | 'record', type: intrinsics.Types, float: boolean, rep?: Rep }
    tags?: { indexes: number[], arity: number }
    floats?: { indexes: number[], arity: number }
}

export interface CodecRequest {
    reps: Map<number, Rep>
    params: Rep[]
    returns?: Rep
    abi: UnitAbi
    tagged: Set<number>
    slices: Map<number, Rep>
    pointers: Set<number>
    encoded: Set<number>
    calls: Map<number, CallCodec>
    tracked: Map<number, boolean>
    fieldTags: Map<number, Operand>
    tagWrites: Map<number, Operand>
    wordWrites: Map<number, number>
    functionObject?: (cell: number) => intrinsics.Handle | undefined
    floatRecords: Map<number, Rep>
    wordBits: Set<number>
}

function coerceSlots(graph: Graph, id: number, slots: number[], to: (x: Operand, i: number) => Operand): void {
    const n = getNode(graph, id)!
    const operands = getOperands(graph, n)
    let changed = false
    for (const i of slots) {
        const next = to(operands[i], i)
        if (next === operands[i]) continue
        operands[i] = next
        changed = true
    }
    if (changed) putCopy(graph, id, n, operands)
}
function numberWord(graph: Graph, token: Operand, f: Operand, canonical: boolean): [number, number] {
    const cell = addNode(graph, NodeOp.pstack, [token, 0, 0, { literal: 8 }])
    const stored = addNode(graph, NodeOp.store, [cell, cell, { literal: 0 }, f], Types.f64)
    const boxed = addNode(graph, NodeOp.or, [addNode(graph, NodeOp.encode, [cell, { literal: pstack0Base() }]), { literal: heap.pstackBoxWordTag ^ heap.pstackWordTag }], Types.vm_value)
    if (!canonical) return [stored, boxed]
    const whole = addNode(graph, NodeOp.convert, [f], Types.i64)
    const integral = addNode(graph, NodeOp.eq, [addNode(graph, NodeOp.convert, [whole], Types.f64), f], Types.bool)
    const low = addNode(graph, NodeOp.ge, [whole, { literal: -0x40000000 }], Types.bool)
    const high = addNode(graph, NodeOp.lt, [whole, { literal: 0x40000000 }], Types.bool)
    const small = addNode(graph, NodeOp.and, [integral, addNode(graph, NodeOp.and, [low, high], Types.bool)], Types.bool)
    return [stored, addNode(graph, NodeOp.select, [small, addNode(graph, NodeOp.box, [whole], Types.vm_value), boxed])]
}

export function realizeFloats(graph: Graph, request: CodecRequest): void {
    const { reps, params, calls } = request
    const returns = request.returns
    const own = new Set(ownRets(graph))
    setGraphBlocks(graph, graph.blocks.map(b => ({ ...b, params: [...b.params] })))
    const root = graph.blocks[0]
    const rootReps = new Map<number, Rep>()
    root.params.forEach((p, i) => {
        if (params[i]) rootReps.set(p, params[i])
    })
    function repOf(x: number): Rep | undefined {
        return rootReps.get(x) ?? reps.get(x)
    }
    function floatOf(x: number): Rep | undefined {
        const n = getNode(graph, x)
        if (n?.op === NodeOp.after) return floatOf(getRef(n, countIds(n) - 1))
        const returned = n?.op === NodeOp.call ? calls.get(x)?.returned : undefined
        if (returned?.mode === 'record') return returned.rep
        const rep = repOf(x)
        return floatUnion(rep) ? rep : undefined
    }
    const owners = new Map<number, GraphBlock>()
    for (const b of graph.blocks) for (const p of b.params) owners.set(p, b)
    const live = new Set<number>()
    for (const b of graph.blocks) {
        const stack = [b.bodyId, ...b.params]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(graph, id) : undefined
            if (!n || live.has(id) || n.op === NodeOp.block) continue
            live.add(id)
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    const converted = new Map<number, Rep>()
    const types = new Map<intrinsics.Types, number>()
    let uninitialized = 0
    function nothing(): number {
        uninitialized ||= addNode(graph, NodeOp.uninitialized, [])
        return uninitialized
    }
    function otherType(rep: Rep): intrinsics.Types {
        return unionWord(rep.other!) ? Types.vm_value : Types.u64
    }
    function recordType(rep: Rep): number {
        const T = otherType(rep)
        const known = types.get(T)
        if (known !== undefined) return known
        const type = insertNode(graph, createRecordType(graph, [{ key: 0, type: Types.f64 }, { key: 1, type: T }, { key: 2, type: Types.u64 }]))
        types.set(T, type)
        return type
    }
    function unsupported(id: number, what: string): CompileError {
        return compileError(`native: ${graph.name} ${what} (float union %${id}: ${converted.get(id)?.text ?? reps.get(id)?.text ?? 'no rep'})`, id)
    }
    const extras: number[] = []
    const original = [...root.params]
    original.forEach((p, i) => {
        const rep = params[i]
        if (!floatUnion(rep)) return
        const n = getNode(graph, p)!
        if (countIds(n) || n.flags) throw unsupported(p, 'receives a float union through a located or receiver param')
        const f = addNode(graph, NodeOp.param, [], Types.f64)
        const o = addNode(graph, NodeOp.param, [], otherType(rep))
        const t = addNode(graph, NodeOp.param, [], Types.u64)
        reps.set(o, rep.other!)
        root.params[i] = f
        extras.push(o, t)
        putNode(graph, p, NodeOp.record, [{ literal: 0 }, f, { literal: 1 }, o, { literal: 2 }, t])
        converted.set(p, rep)
    })
    root.params.push(...extras)
    function offset(at: Operand, by: number): Operand {
        return typeof at === 'number' ? addNode(graph, NodeOp.add, [at, { literal: by }], Types.unknown_number) : { literal: at.literal + by }
    }
    const guarded = new Set<number>()
    const loaded = new Map<number, number>()
    function wordRep(rep: Rep): Rep {
        const other = rep.other!
        if (unionWord(other)) return other
        const word: Rep = { ...other, kind: 'union', text: `word<${other.text}>` }
        if (!unionWord(word)) throw compileError(`native: ${graph.name} keeps ${rep.text} in a word, which cannot hold ${other.text}`, 0)
        return word
    }
    function bits(op: NodeOp, word: Operand, k: number): number {
        const id = addNode(graph, op, [word, { literal: k }], op === NodeOp.and ? Types.u64 : Types.bool)
        request.wordBits.add(id)
        return id
    }
    function tagged(word: Operand): number {
        return addNode(graph, NodeOp.ne, [bits(NodeOp.and, word, 1), { literal: 0 }], Types.bool)
    }
    function wordFloat(word: number, into?: number): number {
        const boxed = addNode(graph, NodeOp.and, [tagged(word), bits(NodeOp.ge, word, heap.pstackBoxWordTag)], Types.bool)
        const box = addNode(graph, NodeOp.decode, [word, { literal: pstack0Base() }])
        const unboxed = addNode(graph, NodeOp.load, [word, box, { literal: 0 }], Types.f64)
        const small = addNode(graph, NodeOp.convert, [addNode(graph, NodeOp.unbox, [word], Types.i64)], Types.f64)
        const operands = [boxed, unboxed, small]
        const f = into ?? newId(graph)
        putNode(graph, f, NodeOp.select, operands)
        guarded.add(f)
        return f
    }
    function wordOther(word: number): number {
        return addNode(graph, NodeOp.and, [tagged(word), bits(NodeOp.lt, word, heap.pstackBoxWordTag)], Types.bool)
    }
    function readWord(id: number, n: GraphNode, rep: Rep): number {
        const word = addCopy(graph, n)
        if (floatUnion(rep)) {
            loaded.set(id, word)
            reps.set(word, wordRep(rep))
            putNode(graph, id, NodeOp.record, [{ literal: 0 }, wordFloat(word), { literal: 1 }, word, { literal: 2 }, wordOther(word)])
            request.floatRecords.set(id, rep.other!)
            converted.set(id, rep)
        } else if (numberName(rep) === 'f64') {
            wordFloat(word, id)
        } else {
            putNode(graph, id, NodeOp.convert, [wordFloat(word)], Types.i64)
        }
        return word
    }
    function boxWord(token: Operand, f: Operand): number {
        return addNode(graph, NodeOp.after, numberWord(graph, token, f, true))
    }
    function writeWord(id: number, n: GraphNode, x: number): void {
        const rep = converted.get(x)!
        const tag = field(x, 2)
        const other = field(x, 1)
        let word: Operand
        if (typeof tag !== 'number') word = tag.literal ? other : boxWord(getOperand(graph, n, 0), field(x, 0))
        else {
            word = addNode(graph, NodeOp.select, [addNode(graph, NodeOp.eq, [tag, { literal: 0 }], Types.bool), boxWord(getOperand(graph, n, 0), field(x, 0)), other])
            reps.set(word, wordRep(rep))
            guarded.add(word)
        }
        coerceSlots(graph, id, [3], () => word)
    }
    const stores = new Map<number, Rep>()
    for (const [id, n] of [...nodeEntries(graph)]) {
        const element = request.slices.get(id)
        const unwrapped = n.op === NodeOp.load && request.abi.returns !== Types.vm_value && element?.encoded && element.kind === 'number' && numberName(element) === 'f64'
        if (!live.has(id) || (!floatUnion(element) && !unwrapped) || (n.op !== NodeOp.load && n.op !== NodeOp.store)) continue
        if (element!.encoded) {
            const read = reps.get(id)
            if (n.op !== NodeOp.load || read?.kind !== 'number' || read.bools) continue
            const word = readWord(id, n, read)
            if (read.nullable) request.fieldTags.set(id, addNode(graph, NodeOp.ne, [word, { literal: heap.undefinedWord }], Types.bool))
            continue
        }
        if (n.op === NodeOp.store) {
            stores.set(id, element!)
            continue
        }
        const [token, data, at] = [getOperand(graph, n, 0), getOperand(graph, n, 1), getOperand(graph, n, 2)]
        const rep = reps.get(id)
        if (floatUnion(rep)) {
            const f = addNode(graph, NodeOp.load, [token, data, at], Types.f64)
            const o = addNode(graph, NodeOp.load, [token, data, offset(at, 8)], otherType(element!))
            const t = addNode(graph, NodeOp.load, [token, data, offset(at, 16)], Types.u64)
            reps.set(o, element!.other!)
            loaded.set(id, t)
            putNode(graph, id, NodeOp.record, [{ literal: 0 }, f, { literal: 1 }, o, { literal: 2 }, t])
            converted.set(id, element!)
        } else if (rep?.kind === 'number' && numberName(rep) === 'f64') {
            putNode(graph, id, NodeOp.load, [token, data, at], Types.f64)
        } else if (rep?.kind === 'number') {
            putNode(graph, id, NodeOp.convert, [addNode(graph, NodeOp.load, [token, data, at], Types.f64)], Types.i64)
        } else if (rep && rep.kind !== 'any') {
            putNode(graph, id, NodeOp.load, [token, data, offset(at, 8)], otherType(element!))
            reps.set(id, element!.other!)
        } else {
            throw unsupported(id, `reads ${rep?.text ?? 'no rep'} from float union storage`)
        }
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (converted.has(id) || !live.has(id)) continue
        const rep = n.op === NodeOp.after ? undefined : floatOf(id)
        if (!rep) continue
        if (n.op === NodeOp.load && typeOf(n) === Types.vm_value && request.slices.has(id) && !request.tagged.has(id)) continue
        if (n.op === NodeOp.load && typeOf(n) === Types.vm_value) {
            readWord(id, n, rep)
            continue
        }
        if (n.op === NodeOp.param) {
            const block = owners.get(id)
            if (!block || block === root) throw unsupported(id, 'has a float union param outside a block')
            retypeNode(graph, id, { ref: recordType(rep) })
        } else if (n.op === NodeOp.call) {
            if (calls.get(id)?.returned?.mode !== 'record') throw unsupported(id, 'receives a float union from a call that does not return a record')
            setCallLocations(graph, id, callLocations(graph, id) ?? [], undefined, { ref: recordType(rep) })
        } else if (n.op !== NodeOp.select) {
            throw unsupported(id, `produces a float union through '${opName(n.op)}'${request.slices.has(id) ? ` from ${request.slices.get(id)!.text} storage` : ''}`)
        }
        converted.set(id, rep)
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op !== NodeOp.after || converted.has(id) || !live.has(id)) continue
        const rep = floatOf(id)
        if (rep) converted.set(id, rep)
    }
    function orderingOf(x: Operand): Operand {
        if (typeof x !== 'number' || !converted.has(x)) return x
        if (loaded.has(x)) return loaded.get(x)!
        const n = getNode(graph, x)
        if (n.op !== NodeOp.after) return x
        const last = countIds(n) - 1
        const inner = orderingOf(getRef(n, last))
        if (typeof inner !== 'number' || !loaded.has(getRef(n, last))) return x
        const token = addNode(graph, NodeOp.after, withOperand(graph, n, last, inner))
        loaded.set(x, token)
        return token
    }
    if (loaded.size) {
        for (const [id, n] of [...nodeEntries(graph)]) {
            if (!live.has(id)) continue
            const ordering = firstNonOrderingSlot(n)
            coerceSlots(graph, id, Array.from({ length: Math.min(ordering, countIds(n)) }, (_, i) => i), orderingOf)
        }
    }
    function floating(x: Operand): boolean {
        return typeof x === 'number' && converted.has(x)
    }
    const produced = new Map<number, number>()
    function recordOf(x: Operand, rep: Rep): Operand {
        if (typeof x !== 'number') return addNode(graph, NodeOp.record, [{ literal: 0 }, x, { literal: 1 }, nothing(), { literal: 2 }, { literal: 0 }])
        const known = converted.get(x)
        if (known && known.other!.text === rep.other!.text) return x
        if (known) {
            const record = addNode(graph, NodeOp.record, [{ literal: 0 }, field(x, 0), { literal: 1 }, field(x, 1), { literal: 2 }, field(x, 2)])
            request.floatRecords.set(record, rep.other!)
            return record
        }
        const done = produced.get(x)
        if (done !== undefined) return done
        const from = reps.get(x) ?? reps.get(tailOf(graph, x))
        let record: number
        if (from?.kind === 'number' && !from.nullable && !from.bools) {
            const value = numberName(from) === 'f64' ? x : addNode(graph, NodeOp.convert, [x], Types.f64)
            record = addNode(graph, NodeOp.record, [{ literal: 0 }, value, { literal: 1 }, nothing(), { literal: 2 }, { literal: 0 }])
        } else if (from?.kind === 'number' && from.nullable && !from.bools) {
            const value = numberName(from) === 'f64' ? x : addNode(graph, NodeOp.convert, [x], Types.f64)
            const missing = addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
            const tag = addNode(graph, NodeOp.eq, [x, missing], Types.bool)
            record = addNode(graph, NodeOp.record, [{ literal: 0 }, value, { literal: 1 }, missing, { literal: 2 }, tag])
            request.floatRecords.set(record, rep.other!)
        } else if (from && ((from.kind !== 'number' && from.kind !== 'any' && !floatUnion(from)) || (from.bools && rep.other!.bools))) {
            record = addNode(graph, NodeOp.record, [{ literal: 0 }, nothing(), { literal: 1 }, x, { literal: 2 }, { literal: 1 }])
            request.floatRecords.set(record, rep.other!)
        } else if (!from && (isNullishValue(graph, x) || request.pointers.has(tailOf(graph, x)))) {
            record = addNode(graph, NodeOp.record, [{ literal: 0 }, nothing(), { literal: 1 }, x, { literal: 2 }, { literal: 1 }])
            request.floatRecords.set(record, rep.other!)
        } else {
            throw unsupported(x, `joins %${x} (${from?.text ?? 'no rep'}) into a float union`)
        }
        produced.set(x, record)
        return record
    }
    function fold(arms: Operand[]): Operand | undefined {
        const live = arms.filter(arm => !uninitialized || arm !== uninitialized)
        if (!live.length) return nothing()
        const first = live[0]
        return live.every(arm => typeof arm === 'number' ? arm === first : typeof first !== 'number' && arm.literal === first.literal) ? first : undefined
    }
    function field(x: number, k: number): Operand {
        const n = getNode(graph, x)!
        const other = (converted.get(x) ?? converted.get(tailOf(graph, x)))?.other ?? request.floatRecords.get(x)
        if (n.op === NodeOp.record && (k !== 1 || !request.floatRecords.has(x))) return getOperand(graph, n, 2 * k + 1)
        if (k !== 1 && n.op === NodeOp.select) {
            const arms = Array.from({ length: countIds(n) - 1 }, (_, i) => field(getRef(n, i + 1), k))
            return fold(arms) ?? addNode(graph, NodeOp.select, [getOperand(graph, n, 0), ...arms])
        }
        if (k !== 1 && n.op === NodeOp.after) {
            const last = countIds(n) - 1
            const inner = field(getRef(n, last), k)
            return addNode(graph, NodeOp.after, withOperand(graph, n, last, typeof inner === 'number' ? inner : addNode(graph, NodeOp.literal, [inner], k ? Types.u64 : Types.f64)))
        }
        const get = addNode(graph, NodeOp.get, [x, { literal: k }])
        if (k === 1 && other) reps.set(get, other)
        return get
    }
    function arrival(x: number, rep: Rep | undefined, into: string): Operand {
        if (!rep || rep.kind === 'any') throw unsupported(x, `passes a float union into ${into} (${rep?.text ?? 'no rep'})`)
        if (floatUnion(rep)) return recordOf(x, rep)
        if (rep.kind === 'number' && numberName(rep) === 'f64') return field(x, 0)
        if (rep.kind === 'number') return addNode(graph, NodeOp.convert, [field(x, 0)], Types.i64)
        return field(x, 1)
    }
    function typeofOther(n: GraphNode, x: number): Operand {
        const rep = converted.get(x)!.other!
        const value = field(x, 1)
        if (unionWord(rep)) return addCopy(graph, n, withOperand(graph, n, 2, value))
        if (rep.kind === 'undefined') return { literal: heap.typeNames.undefined }
        if (rep.kind !== 'pointer' || rep.targets.some(target => target === 'fn' || target.startsWith('clo@') || target === 'heap')) throw unsupported(x, `takes typeof a float union whose other member is ${rep.text}`)
        const name = { literal: rep.targets.includes('str') ? heap.typeNames.string : heap.typeNames.object }
        if (!rep.nullable) return name
        const missing = addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
        return addNode(graph, NodeOp.select, [addNode(graph, NodeOp.eq, [value, missing], Types.bool), { literal: heap.typeNames.undefined }, name])
    }
    function typeofOf(id: number, n: GraphNode, x: number): void {
        const number = addNode(graph, NodeOp.eq, [field(x, 2), { literal: 0 }], Types.bool)
        putNode(graph, id, NodeOp.select, [number, { literal: heap.typeNames.number }, typeofOther(n, x)])
    }
    function missing(): number {
        return addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
    }
    function equal(x: number, y: Operand): Operand {
        const tag = addNode(graph, NodeOp.eq, [field(x, 2), { literal: 0 }], Types.bool)
        if (typeof y === 'number' && converted.has(y)) {
            const same = addNode(graph, NodeOp.eq, [field(x, 2), field(y, 2)], Types.bool)
            const values = addNode(graph, NodeOp.select, [tag, addNode(graph, NodeOp.eq, [field(x, 0), field(y, 0)], Types.bool), addNode(graph, NodeOp.eq, [field(x, 1), field(y, 1)], Types.bool)])
            return addNode(graph, NodeOp.and, [same, values], Types.bool)
        }
        const from = typeof y === 'number' ? reps.get(y) ?? reps.get(tailOf(graph, y)) : undefined
        const nullish = typeof y === 'number' && (isNullishValue(graph, y) || from?.kind === 'undefined')
        if (typeof y === 'number' && !nullish && unionWord(from) && !from!.bools) {
            const small = addNode(graph, NodeOp.eq, [bits(NodeOp.and, y, 1), { literal: 0 }], Types.bool)
            const value = addNode(graph, NodeOp.convert, [addNode(graph, NodeOp.unbox, [y], Types.i64)], Types.f64)
            const numbers = addNode(graph, NodeOp.and, [small, addNode(graph, NodeOp.eq, [field(x, 0), value], Types.bool)], Types.bool)
            return addNode(graph, NodeOp.select, [tag, numbers, addNode(graph, NodeOp.eq, [field(x, 1), y], Types.bool)])
        }
        if (typeof y === 'number' && !nullish && (!from || from.kind === 'any' || from.bools || floatUnion(from) || unionWord(from))) throw unsupported(x, `compares a float union with %${y} (${from?.text ?? 'no rep'})`)
        const number = typeof y !== 'number' || from!.kind === 'number'
        let numbers: Operand = { literal: 0 }
        let others: Operand = { literal: 0 }
        if (number) {
            const value = typeof y !== 'number' || numberName(from) === 'f64' ? y : addNode(graph, NodeOp.convert, [y], Types.f64)
            numbers = addNode(graph, NodeOp.eq, [field(x, 0), value], Types.bool)
            if (from?.nullable) numbers = addNode(graph, NodeOp.and, [addNode(graph, NodeOp.ne, [y, missing()], Types.bool), numbers], Types.bool)
        }
        if (from?.nullable && from.kind === 'number') others = addNode(graph, NodeOp.and, [addNode(graph, NodeOp.eq, [y, missing()], Types.bool), addNode(graph, NodeOp.eq, [field(x, 1), missing()], Types.bool)], Types.bool)
        else if (!number) others = addNode(graph, NodeOp.eq, [field(x, 1), y], Types.bool)
        return addNode(graph, NodeOp.select, [tag, numbers, others])
    }
    function truth(x: number): Operand {
        const rep = converted.get(x)!.other!
        if (rep.targets.includes('str') || rep.bools) throw unsupported(x, `tests the truth of a float union whose other member is ${rep.text}`)
        const f = field(x, 0)
        const number = addNode(graph, NodeOp.and, [addNode(graph, NodeOp.ne, [f, { literal: 0 }], Types.bool), addNode(graph, NodeOp.eq, [f, f], Types.bool)], Types.bool)
        const other = addNode(graph, NodeOp.select, [field(x, 1), { literal: 1 }, { literal: 0 }])
        return addNode(graph, NodeOp.select, [addNode(graph, NodeOp.eq, [field(x, 2), { literal: 0 }], Types.bool), number, other])
    }
    function use(id: number, n: GraphNode, i: number, x: number): void {
        if (n.op === NodeOp.get) return
        if (n.op === NodeOp.store && i === 3 && typeOf(n) === Types.vm_value) {
            writeWord(id, n, x)
            return
        }
        if (n.op === NodeOp.select && i === 0) {
            coerceSlots(graph, id, [0], () => truth(x))
            return
        }
        if ((n.op === NodeOp.eq || n.op === NodeOp.ne) && countIds(n) === 2) {
            const same = equal(x, getOperand(graph, n, 1 - i))
            putNode(graph, id, n.op === NodeOp.eq ? NodeOp.ne : NodeOp.eq, [same, { literal: 0 }], Types.bool)
            return
        }
        if (UnboxingOps.has(n.op) || n.op === NodeOp.typeof) {
            coerceSlots(graph, id, [i], () => field(x, 0))
            return
        }
        if (n.op === NodeOp.rt && i === 2 && getLiteral(graph, n, 1) === rt.Op.typeof) {
            typeofOf(id, n, x)
            return
        }
        if (n.op === NodeOp.rt && i === 2 && rt.handleOps.has(getLiteral(graph, n, 1))) {
            coerceSlots(graph, id, [i], () => field(x, 1))
            return
        }
        throw unsupported(x, `consumes a float union with '${opName(n.op)}' %${id}`)
    }
    for (const [id, element] of stores) {
        const n = getNode(graph, id)!
        const [token, data, at] = [getOperand(graph, n, 0), getOperand(graph, n, 1), getOperand(graph, n, 2)]
        const record = recordOf(getOperand(graph, n, 3), element) as number
        const types = [Types.f64, otherType(element), Types.u64]
        let stored = token
        for (let k = 0; k < 2; k++) {
            const value = field(record, k)
            if (value !== uninitialized || !uninitialized) stored = addNode(graph, NodeOp.store, [stored, data, offset(at, 8 * k), value], types[k])
        }
        putNode(graph, id, NodeOp.store, [stored, data, offset(at, 16), field(record, 2)], Types.u64)
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (!live.has(id) || stores.has(id)) continue
        if (n.op === NodeOp.apply) {
            const block = getBlock(graph, getRef(n, 0))
            if (!block) continue
            coerceSlots(graph, id, block.params.map((_, i) => i + 1), (x, i) => {
                const param = block.params[i - 1]
                const into = converted.get(param)
                if (into) return recordOf(x, into)
                return floating(x) ? arrival(x as number, reps.get(param), `%${param}`) : x
            })
        } else if (n.op === NodeOp.ret) {
            if (own.has(id) && floatUnion(returns)) coerceSlots(graph, id, [0], x => recordOf(x, returns!))
            else if (floating(getOperand(graph, n, 0)) && !own.has(id)) throw unsupported(getRef(n, 0), 'returns a float union from an inlined region')
            else if (floating(getOperand(graph, n, 0))) coerceSlots(graph, id, [0], x => arrival(x as number, returns, 'the return'))
        } else if (n.op === NodeOp.select && converted.has(id)) {
            coerceSlots(graph, id, Array.from({ length: countIds(n) - 1 }, (_, i) => i + 1), x => recordOf(x, converted.get(id)!))
            if (floating(getOperand(graph, n, 0))) coerceSlots(graph, id, [0], x => truth(x as number))
        } else if (n.op === NodeOp.after && converted.has(id)) {
            const last = countIds(n) - 1
            coerceSlots(graph, id, [last], x => recordOf(x, converted.get(id)!))
        } else if (n.op === NodeOp.call) {
            const codec = calls.get(id)
            const floats = codec?.floats
            for (let i = 3; i < countIds(n); i++) {
                const x = getOperand(graph, n, i)
                if (!floating(x) || floats?.indexes.includes(i - 3)) continue
                coerceSlots(graph, id, [i], () => arrival(x as number, codec?.params?.get(i - 3)?.rep, `param ${i - 3} of call %${id}`))
            }
            if (!floats) continue
            const operands = getOperands(graph, getNode(graph, id)!)
            const passed = operands.length
            while (operands.length > 3 + floats.arity) operands.pop()
            while (operands.length < 3 + floats.arity) operands.push({ literal: 0 })
            const appended: Operand[] = []
            for (const index of floats.indexes) {
                const rep = codec!.params!.get(index)!.rep
                const x = 3 + index < passed ? operands[3 + index] : addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
                const record = recordOf(x, rep) as number
                operands[3 + index] = field(record, 0)
                appended.push(field(record, 1), field(record, 2))
            }
            putCopy(graph, id, getNode(graph, id)!, [...operands, ...appended])
        } else {
            for (let i = firstNonOrderingSlot(n); i < countIds(n); i++) {
                const current = getNode(graph, id)!
                const x = i < countIds(current) ? getRef(current, i) : 0
                if (x && converted.has(x)) use(id, current, i, x)
            }
        }
    }
    if (guarded.size) splitGuardedSelects(graph, guarded)
}

export function realizeWords(graph: Graph, request: CodecRequest): void {
    const { reps, slices, pointers, encoded, calls, abi, returns, tagged } = request
    const floats = floatValues(graph)
    const own = new Set(ownRets(graph))
    function encode(value: number): number {
        return addNode(graph, NodeOp.encode, [value, { literal: pstack0Base() }])
    }
    function decode(value: number): number {
        return addNode(graph, NodeOp.decode, [value, { literal: pstack0Base() }])
    }
    function unbox(value: number): number {
        return addNode(graph, NodeOp.unbox, [value], Types.i64)
    }
    function handleOf(value: number): number {
        return addNode(graph, NodeOp.unbox, [value], Types.u32)
    }
    function union(x: Operand): boolean {
        if (typeof x !== 'number' || !x) return false
        if (calls.get(tailOf(graph, x))?.raw) return false
        const rep = reps.get(tailOf(graph, x)) ?? reps.get(x)
        return !!rep && unionWord(rep)
    }
    let users: Map<number, number[]> | undefined
    function numberTested(id: number): boolean {
        users ??= nodeUsers(graph, nodeIds(graph))
        for (const user of users.get(id) ?? []) {
            const u = getNode(graph, user)!
            if (u.op !== NodeOp.eq && u.op !== NodeOp.ne) return false
            const other = getNode(graph, getRef(u, getRef(u, 0) === id ? 1 : 0))
            if (other?.op !== NodeOp.heapHandle || getRef(other, 0) || getLiteral(graph, other, 0) !== heap.typeNames.number) return false
        }
        return true
    }
    function typeofKinds(id: number, x: number): number {
        const rep = reps.get(x) ?? reps.get(tailOf(graph, x))!
        const strings = !rep.targets.includes('str') ? 0 : rep.targets.some(target => target !== 'str') ? typeofStrings | typeofObjects : typeofStrings
        if (numberTested(id)) return strings
        const missing = rep.nullable ? typeofUndefined : 0
        const bools = rep.bools ? typeofBooleans : 0
        const objects = rep.targets.filter(target => target !== 'str')
        const functions = objects.filter(target => target === 'fn' || target.startsWith('clo@'))
        if (functions.length && functions.length < objects.length) throw compileError(`native: %${id} takes typeof a value that holds a function or an object (${rep.text}); a closure carries no discriminator`, id)
        return strings | missing | bools | (functions.length ? typeofFunctions : 0)
    }
    function typeofTarget(id: number, x: number): boolean {
        const rep = x ? reps.get(x) ?? reps.get(tailOf(graph, x)) : undefined
        if (rep?.kind === 'pointer') typeofKinds(id, x)
        return !!rep && union(x) && typeofKinds(id, x) !== 0
    }
    function word(x: Operand): boolean {
        if (typeof x !== 'number' || !x) return false
        const n = getNode(graph, tailOf(graph, x))
        return !!n && (n.op === NodeOp.encode || n.op === NodeOp.box || resultType(graph, n) === Types.vm_value)
    }
    function object(x: Operand): boolean {
        if (typeof x !== 'number') return false
        const value = tailOf(graph, x)
        if (!value || encoded.has(value) || !pointers.has(value)) return false
        if (getNode(graph, value)?.op === NodeOp.alloca) throw `native: ${graph.name} lets stack object %${value} escape as a vm_value`
        return true
    }
    function encodedWord(x: Operand): boolean {
        return typeof x === 'number' && !!x && (encoded.has(x) || encoded.has(tailOf(graph, x)))
    }
    function stringWord(x: Operand): number | undefined {
        if (typeof x !== 'number' || !x || word(x)) return
        const n = getNode(graph, tailOf(graph, x))
        const handle = n?.op === NodeOp.heapHandle && !getRef(n, 0) ? getLiteral(graph, n, 0) as intrinsics.Handle : 0 as intrinsics.Handle
        const rep = reps.get(x) ?? reps.get(tailOf(graph, x))
        if (!(handle && heap.isString(handle)) && !isStringRep(rep)) return
        return handle || !rep?.nullable ? tagVmHandleNode(graph, x) : presentString(x, tagVmHandleNode(graph, x))
    }
    function presentWord(x: number): number {
        const rep = reps.get(x) ?? reps.get(tailOf(graph, x))
        if (!rep!.nullable) return tagVmHandleNode(graph, x)
        return addNode(graph, NodeOp.select, [addNode(graph, NodeOp.ne, [x, { literal: heap.undefinedWord }], Types.bool), tagVmHandleNode(graph, x), { literal: heap.undefinedWord }])
    }
    function presentString(x: number, word: number): number {
        return addNode(graph, NodeOp.select, [addNode(graph, NodeOp.ne, [x, { literal: 0 }], Types.bool), word, { literal: heap.undefinedWord }])
    }
    function voided(x: number): boolean {
        return getNode(graph, tailOf(graph, x))?.op === NodeOp.void
    }
    function nullishWord(x: number): Operand {
        const n = getNode(graph, x)!
        if (n.op !== NodeOp.after) return addNode(graph, NodeOp.literal, [{ literal: heap.undefinedWord }], Types.vm_value)
        const last = countIds(n) - 1
        return addNode(graph, NodeOp.after, withOperand(graph, n, last, nullishWord(getRef(n, last))))
    }
    function boolValued(x: Operand): boolean {
        if (typeof x !== 'number' || !x) return false
        const value = tailOf(graph, x)
        const rep = reps.get(x) ?? reps.get(value)
        if (rep) return rep.kind === 'number' && !!rep.bools
        return boolTyped(graph, value)
    }
    function wordLiteral(word: number): number {
        return addNode(graph, NodeOp.literal, [{ literal: word }], Types.vm_value)
    }
    function boolWord(x: number): Operand {
        return boolWordNode(graph, x)
    }
    function wordBools(x: Operand): boolean {
        const rep = reps.get(x as number) ?? reps.get(tailOf(graph, x as number))
        return !!rep?.bools && unionWord(rep)
    }
    function wordTruth(x: number): number {
        return addNode(graph, NodeOp.unbox, [x], Types.bool)
    }
    function wordNumber(x: number): number {
        if (!wordBools(x)) return unbox(x)
        const no = addNode(graph, NodeOp.eq, [x, wordLiteral(heap.falseWord)], Types.bool)
        return addNode(graph, NodeOp.select, [wordTruth(x), { literal: 1 }, addNode(graph, NodeOp.select, [no, { literal: 0 }, unbox(x)])])
    }
    function encodeObject(x: number): number {
        const rep = reps.get(x) ?? reps.get(tailOf(graph, x))
        if (!rep?.zero) return encode(x)
        return addNode(graph, NodeOp.select, [x, encode(x), { literal: 0 }], Types.vm_value)
    }
    function functionWord(x: Operand): number | undefined {
        if (typeof x !== 'number' || !x) return
        const n = getNode(graph, tailOf(graph, x))
        if (n?.op !== NodeOp.heapHandle || getRef(n, 0) || heapInterior(graph, n)) return
        const object = request.functionObject?.(getLiteral(graph, n, 0))
        return object === undefined ? undefined : encode(addNode(graph, NodeOp.heapHandle, [{ literal: object }]))
    }
    function toWord(x: Operand): Operand {
        if (typeof x !== 'number') return { literal: x.literal * 2 }
        const fn = functionWord(x)
        if (fn !== undefined) return fn
        if (isNullishValue(graph, x) || voided(x)) return nullishWord(x)
        if (boolValued(x)) return boolWord(x)
        if (!union(x) && word(x) && isStringRep(reps.get(x) ?? reps.get(tailOf(graph, x)))) return presentWord(x)
        if (union(x) || word(x)) return x
        return stringWord(x) ?? (object(x) ? encodeObject(x) : addNode(graph, NodeOp.box, [x], Types.vm_value))
    }
    function asWord(x: Operand): Operand {
        if (typeof x === 'number' && isNullishValue(graph, x)) return nullishWord(x)
        const fn = functionWord(x)
        if (fn !== undefined) return fn
        return object(x) ? encodeObject(x as number) : x
    }
    function storedWord(x: Operand): Operand {
        if (typeof x !== 'number' || !x || isNullishValue(graph, x) || union(x) || word(x)) return asWord(x)
        const rep = reps.get(x) ?? reps.get(tailOf(graph, x))
        if (!isStringRep(rep) || !rep!.nullable) return asWord(x)
        return presentString(x, x)
    }
    function comparedWord(x: Operand): Operand {
        return boolValued(x) ? boolWord(x as number) : asWord(x)
    }
    function truthWord(x: Operand): Operand {
        const rep = reps.get(x as number) ?? reps.get(tailOf(graph, x as number))
        let present = addNode(graph, NodeOp.ne, [x, { literal: 0 }], Types.bool)
        if (rep?.bools) present = addNode(graph, NodeOp.and, [present, addNode(graph, NodeOp.ne, [x, wordLiteral(heap.falseWord)], Types.bool)], Types.bool)
        if (!rep?.nullable) return present
        const missing = addNode(graph, NodeOp.literal, [{ literal: heap.undefinedWord }], Types.vm_value)
        return addNode(graph, NodeOp.and, [present, addNode(graph, NodeOp.ne, [x, missing], Types.bool)], Types.bool)
    }
    function truthOf(x: Operand): Operand {
        if (typeof x !== 'number') return { literal: x.literal ? 1 : 0 }
        if (boolValued(x)) return x
        if (isNullishValue(graph, x) || voided(x)) return { literal: 0 }
        if (union(x) || word(x)) return truthWord(x)
        return x
    }
    function integral(x: number): boolean {
        const name = numberName(reps.get(x))
        return name === 'int' || name === 'i64' || resultType(graph, getNode(graph, x)!) === Types.i64
    }
    function arrival(x: Operand, rep: Rep | undefined, shaped: boolean, into: string): Operand {
        if (rep && unionWord(rep)) return toWord(x)
        if (rep?.tested) return truthOf(x)
        const from = typeof x === 'number' && x ? reps.get(x) ?? reps.get(tailOf(graph, x)) : undefined
        if (from?.kind === 'number' && from.nullable && (rep?.kind === 'pointer' || rep?.kind === 'buffer')) return addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
        if (shaped && (encodedWord(x) || (pointerOfShapes(rep) && word(x)))) return decode(x as number)
        if (numberName(rep) === 'f64' && typeof x === 'number' && x && !union(x) && integral(x)) return addNode(graph, NodeOp.convert, [x], Types.f64)
        if (!union(x)) return x
        if (rep?.kind === 'undefined') return addNode(graph, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
        if (numberName(rep) === 'f64') return addNode(graph, NodeOp.convert, [wordNumber(x as number)], Types.f64)
        if (rep?.kind === 'number' && rep.bools) return wordTruth(x as number)
        if (rep?.kind === 'number') return wordNumber(x as number)
        if (isStringRep(rep)) return handleOf(x as number)
        if (rep?.zero) return addNode(graph, NodeOp.select, [x, decode(x as number), { literal: 0 }])
        if (shaped || pointerOfShapes(rep)) return decode(x as number)
        throw `native: ${graph.name} passes union word %${x} into ${into} (${rep?.text ?? 'no rep'})`
    }
    function floatSlot(id: number, value: Operand): boolean {
        const element = slices.get(id)
        if (!element?.encoded || numberName(element) !== 'f64') return false
        return typeof value !== 'number' || reps.get(tailOf(graph, value))?.kind === 'number'
    }
    function storeWord(id: number, n: GraphNode): void {
        const value = getOperand(graph, n, 3)
        const float = typeof value === 'number' && floats.has(tailOf(graph, value))
        const smallWord = floatUnion(slices.get(id)) && typeof value === 'number' && !!value && (reps.get(value) ?? reps.get(tailOf(graph, value)))?.kind === 'number'
        if (!float && !floatSlot(id, value)) {
            coerceSlots(graph, id, [3], tagged.has(id) || smallWord ? toWord : storedWord)
            return
        }
        const converted = float ? value : typeof value === 'number' ? addNode(graph, NodeOp.convert, [value], Types.f64) : addNode(graph, NodeOp.literal, [value], Types.f64)
        const [stored, word] = numberWord(graph, getRef(n, 0), converted, !floatSlot(id, value))
        putCopy(graph, id, n, [stored, ...getOperands(graph, n, 1, 3), word])
    }
    function returnedFloatWord(x: Operand): Operand {
        return addNode(graph, NodeOp.after, numberWord(graph, addNode(graph, NodeOp.nilEffect, []), x, numberName(returns) !== 'f64'))
    }
    function voidValue(x: number, T: intrinsics.Types, word: boolean): Operand {
        const n = getNode(graph, x)!
        if (n.op !== NodeOp.after) return addNode(graph, NodeOp.literal, [{ literal: word ? heap.undefinedWord : 0 }], T)
        const last = countIds(n) - 1
        return addNode(graph, NodeOp.after, withOperand(graph, n, last, voidValue(getRef(n, last), T, word)))
    }
    function returnWord(id: number, n: GraphNode): void {
        if (!own.has(id) || abi.mode === 'record') return
        const value = getRef(n, 0)
        if (returns?.tested) return coerceSlots(graph, id, [0], x => object(x) ? addNode(graph, NodeOp.ne, [x, { literal: 0 }], Types.bool) : truthOf(x))
        const valued = !!returns && returns.kind !== 'never' && returns.kind !== 'undefined' && !unionWord(returns) && abi.mode !== 'tagged' && abi.mode !== 'narrow'
        if (valued && voided(value)) return coerceSlots(graph, id, [0], () => voidValue(value, abi.returns, abi.returns === Types.vm_value || (abi.mode === 'encoded' && returns.kind === 'pointer')))
        const rawNullish = isNullishValue(graph, value) && returns?.kind === 'number'
        if (abi.mode === 'raw' && word(value)) coerceSlots(graph, id, [0], () => decode(value))
        else if (abi.mode === 'keep' && !!returns && unionWord(returns) && calls.get(tailOf(graph, value))?.raw) coerceSlots(graph, id, [0], () => encode(value))
        else if ((abi.mode === 'keep' || abi.mode === 'encoded') && !!returns && unionWord(returns)) coerceSlots(graph, id, [0], toWord)
        else if (abi.mode === 'encoded' && rawNullish) return
        else if (abi.returns === Types.vm_value && floats.has(tailOf(graph, value))) coerceSlots(graph, id, [0], returnedFloatWord)
        else if (abi.mode === 'encoded') coerceSlots(graph, id, [0], asWord)
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op === NodeOp.store && typeOf(n) === Types.vm_value) storeWord(id, n)
        else if (n.op === NodeOp.ret) returnWord(id, n)
        else if (n.op === NodeOp.call && word(getRef(n, 1))) {
            const ptr = decode(getRef(n, 1))
            const code = addNode(graph, NodeOp.load, [getRef(n, 0), ptr, 0], Types.fnptr)
            coerceSlots(graph, id, [1], () => addNode(graph, NodeOp.indirectTarget, [code, ptr]))
        } else if (n.op === NodeOp.bitconvert) coerceSlots(graph, id, [0], asWord)
        else if (n.op === NodeOp.rt && getLiteral(graph, n, 1) === rt.Op.typeof && typeofTarget(id, getRef(n, 2))) putCopy(graph, id, n, [...getOperands(graph, n, 0, 3), { literal: typeofKinds(id, getRef(n, 2)) }])
        else if (n.op === NodeOp.rt) coerceSlots(graph, id, Array.from({ length: countIds(n) - 2 }, (_, i) => i + 2), asWord)
        else if (n.op === NodeOp.eq || n.op === NodeOp.ne) coerceSlots(graph, id, [0, 1].filter(at => word(getRef(n, 1 - at))), comparedWord)
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op === NodeOp.select && union(getRef(n, 0))) coerceSlots(graph, id, [0], truthWord)
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op === NodeOp.apply) {
            const params = getBlock(graph, getRef(n, 0))?.params ?? []
            coerceSlots(graph, id, params.map((_, i) => i + 1), (x, i) => arrival(x, reps.get(params[i - 1]), false, `%${params[i - 1]}`))
        } else if (n.op === NodeOp.call && calls.get(id)?.params) {
            const params = calls.get(id)!.params!
            const slots = [...params.keys()].filter(index => 3 + index < countIds(n)).map(index => 3 + index)
            coerceSlots(graph, id, slots, (x, i) => arrival(x, params.get(i - 3)!.rep, params.get(i - 3)!.shaped, `param ${i - 3} of call %${id}`))
        } else if (n.op === NodeOp.record && request.floatRecords.has(id)) {
            coerceSlots(graph, id, [3], x => arrival(x, request.floatRecords.get(id), false, `the other member of %${id}`))
        } else if (n.op === NodeOp.select && union(id)) {
            coerceSlots(graph, id, Array.from({ length: countIds(n) - 1 }, (_, i) => i + 1), toWord)
        } else if (n.op === NodeOp.eq || n.op === NodeOp.ne) {
            if (union(getRef(n, 0)) !== union(getRef(n, 1))) coerceSlots(graph, id, [0, 1], toWord)
        } else if (n.op === NodeOp.rt && rt.handleOps.has(getLiteral(graph, n, 1)) && union(getRef(n, 2))) {
            coerceSlots(graph, id, [2], x => handleOf(x as number))
        } else if (n.op === NodeOp.ret && returns?.kind === 'number' && !returns.tested && union(getRef(n, 0))) {
            coerceSlots(graph, id, [0], x => returns!.bools ? wordTruth(x as number) : wordNumber(x as number))
        } else if (UnboxingOps.has(n.op) && !request.wordBits.has(id)) {
            coerceSlots(graph, id, Array.from({ length: countIds(n) }, (_, i) => i).filter(i => union(getRef(n, i))), x => wordNumber(x as number))
        } else if (n.op === NodeOp.store && typeOf(n) !== Types.vm_value && union(getRef(n, 3))) {
            coerceSlots(graph, id, [3], x => wordNumber(x as number))
        }
    }
}

export function realizeTags(graph: Graph, request: CodecRequest): void {
    const { reps, params, calls, abi, tracked } = request
    const returns = request.returns!
    const own = new Set(ownRets(graph))
    setGraphBlocks(graph, graph.blocks.map(b => ({ ...b, params: [...b.params] })))
    const owners = new Map<number, GraphBlock>()
    for (const b of graph.blocks) for (const p of b.params) owners.set(p, b)
    const applies = new Map<number, number[]>()
    for (const [id, n] of nodeEntries(graph)) {
        if (n.op !== NodeOp.apply) continue
        const list = applies.get(getRef(n, 0))
        if (list) list.push(id)
        else applies.set(getRef(n, 0), [id])
    }
    const projections = new Map<number, [payload: number, tag: number]>()
    const narrowCalls = new Set<number>()
    const raw = new Set<number>()
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op !== NodeOp.call) continue
        const returned = calls.get(id)?.returned
        if (!returned || returned.mode === 'record') continue
        const T = returned.type
        if (returned.mode === 'narrow') {
            const payload = addNode(graph, NodeOp.convert, [id], T === Types.i64 ? Types.i32 : Types.u32)
            const tag = addNode(graph, NodeOp.ne, [id, { literal: narrowUndefined }], Types.bool)
            raw.add(payload)
            raw.add(tag)
            narrowCalls.add(id)
            projections.set(id, [payload, tag])
            continue
        }
        const payload = addNode(graph, NodeOp.get, [id, { literal: 0 }])
        const float = returned.float ? addNode(graph, NodeOp.bitconvert, [payload], Types.f64) : 0
        const integral = numberName(reps.get(id)) === 'int' || numberName(reps.get(id)) === 'i64'
        const value = !float ? (T === Types.u64 ? payload : addNode(graph, NodeOp.convert, [payload], T)) : integral ? addNode(graph, NodeOp.convert, [float], Types.i64) : float
        projections.set(id, [value, addNode(graph, NodeOp.get, [id, { literal: 1 }])])
    }
    const tags = new Map<number, Operand>(request.fieldTags)
    const root = graph.blocks[0]
    for (const i of abi.tags) {
        const tag = addNode(graph, NodeOp.param, [], Types.bool)
        tags.set(root.params[i], tag)
        root.params.push(tag)
    }
    function tagOf(x: Operand): Operand {
        if (typeof x !== 'number' || !x) return { literal: 1 }
        const known = tags.get(x)
        if (known !== undefined) return known
        if (tracked.get(x) === false) return { literal: 1 }
        const n = getNode(graph, x)!
        const projection = projections.get(x)
        const block = n.op === NodeOp.param ? owners.get(x) : undefined
        if (block && block !== root && applies.has(block.id)) {
            const tag = addNode(graph, NodeOp.param, [], Types.bool)
            tags.set(x, tag)
            const at = block.params.indexOf(x) + 1
            block.params.push(tag)
            const slot = block.params.length
            const into = applies.get(block.id)!
            for (const apply of into) putCopy(graph, apply, getNode(graph, apply)!, [...getOperands(graph, getNode(graph, apply)!), { literal: 1 }])
            for (const apply of into) {
                const arrival = tagOf(getOperand(graph, getNode(graph, apply)!, at))
                const current = getNode(graph, apply)!
                putCopy(graph, apply, current, withOperand(graph, current, slot, arrival))
            }
            return tag
        }
        const index = root.params.indexOf(x)
        const rep = index < 0 ? reps.get(x) : params[index]
        let out: Operand
        if (projection) out = projection[1]
        else if (rep?.kind === 'number' && !rep.nullable) out = { literal: 1 }
        else if (n.op === NodeOp.after || n.op === NodeOp.unbox) out = tagOf(getOperand(graph, n, countIds(n) - 1))
        else if (isNullishValue(graph, x) || n.op === NodeOp.void) out = { literal: 0 }
        else if (n.op === NodeOp.literal) out = { literal: 1 }
        else if (n.op === NodeOp.select) out = addNode(graph, NodeOp.select, [getOperand(graph, n, 0), ...Array.from({ length: countIds(n) - 1 }, (_, i) => tagOf(getOperand(graph, n, i + 1)))])
        else out = addNode(graph, NodeOp.ne, [x, { literal: 0 }], Types.bool)
        tags.set(x, out)
        return out
    }
    function payloadOf(x: Operand): Operand {
        if (typeof x !== 'number' || !x) return x
        const n = getNode(graph, x)!
        if (n.op === NodeOp.after) {
            const last = countIds(n) - 1
            const inner = payloadOf(getOperand(graph, n, last))
            if (inner === getOperand(graph, n, last)) return x
            return addNode(graph, NodeOp.after, withOperand(graph, n, last, typeof inner === 'number' ? inner : addNode(graph, NodeOp.literal, [inner])))
        }
        if (projections.has(x)) return projections.get(x)![0]
        if (isNullishValue(graph, x) || n.op === NodeOp.void) return { literal: 0 }
        return x
    }
    function narrowOf(x: Operand): Operand {
        if (typeof x !== 'number' || !x || narrowCalls.has(x)) return x
        const n = getNode(graph, x)!
        let out: number
        if (n.op === NodeOp.after) out = addNode(graph, NodeOp.after, withOperand(graph, n, countIds(n) - 1, narrowOf(getOperand(graph, n, countIds(n) - 1))))
        else if (isNullishValue(graph, x)) return { literal: narrowUndefined }
        else if (n.op === NodeOp.select) out = addNode(graph, NodeOp.select, [getOperand(graph, n, 0), ...Array.from({ length: countIds(n) - 1 }, (_, i) => narrowOf(getOperand(graph, n, i + 1)))])
        else {
            const payload = payloadOf(x)
            const wide = typeof payload === 'number' && resultType(graph, getNode(graph, payload)!) !== abi.returns ? addNode(graph, NodeOp.convert, [payload], abi.returns) : payload
            out = addNode(graph, NodeOp.select, [tagOf(x), wide, { literal: narrowUndefined }])
        }
        raw.add(out)
        return out
    }
    function exactLiteral(n: GraphNode, at: number): boolean {
        const ref = getRef(n, at)
        const m = ref ? getNode(graph, ref) : undefined
        if (ref && m?.op !== NodeOp.literal) return false
        const value = ref ? getLiteral(graph, m!, 0) : getLiteral(graph, n, at)
        return Number.isInteger(value) && Math.abs(value) < narrowUndefined
    }
    function same(a: Operand, b: Operand): boolean {
        return typeof a === 'number' ? a === b : typeof b !== 'number' && a.literal === b.literal
    }
    for (const [store, value] of request.tagWrites) coerceSlots(graph, store, [3], () => tagOf(value))
    for (const [store, value] of request.wordWrites) coerceSlots(graph, store, [3], word => addNode(graph, NodeOp.select, [tagOf(value), word, { literal: heap.undefinedWord }]))
    for (const [id, n] of [...nodeEntries(graph)]) {
        if ((n.op !== NodeOp.eq && n.op !== NodeOp.ne) || countIds(n) !== 2) continue
        if (isNullishValue(graph, getRef(n, 0)) && isNullishValue(graph, getRef(n, 1))) {
            putNode(graph, id, NodeOp.literal, [{ literal: n.op === NodeOp.eq ? 1 : 0 }])
            continue
        }
        const words = [0, 1].filter(side => !!getRef(n, side) && narrowCalls.has(tailOf(graph, getRef(n, side))))
        const across = words.length === 1 ? 1 - words[0] : -1
        const nullish = across >= 0 && isNullishValue(graph, getRef(n, across))
        if (words.length === 2 || nullish || (across >= 0 && exactLiteral(n, across))) {
            putNode(graph, id, n.op, getOperands(graph, n).map((x, side) => words.includes(side) ? narrowOf(x) : nullish ? { literal: narrowUndefined } : x), Types.bool)
            raw.add(id)
            continue
        }
        const sides = [0, 1].filter(side => !!getRef(n, side) && !isNullishValue(graph, getRef(n, side)) && (tracked.has(getRef(n, side)) || request.fieldTags.has(getRef(n, side))))
        if (!sides.length || (sides.length === 1 && nonzeroLiteral(graph, n, 1 - sides[0]))) continue
        if (sides.length === 1 && isNullishValue(graph, getRef(n, 1 - sides[0]))) {
            putNode(graph, id, n.op, [tagOf(getRef(n, sides[0])), { literal: 0 }], Types.bool)
            continue
        }
        if (sides.length === 1 && getRef(n, 1 - sides[0]) && nullableNumber(reps.get(tailOf(graph, getRef(n, 1 - sides[0]))))) continue
        const [a, b] = [0, 1].map(side => sides.includes(side) ? tagOf(getRef(n, side)) : { literal: 1 })
        if (same(a, { literal: 1 }) && same(b, { literal: 1 })) continue
        const values = addNode(graph, n.op, [payloadOf(getOperand(graph, n, 0)), payloadOf(getOperand(graph, n, 1))], Types.bool)
        const present = same(a, { literal: 1 }) ? b : same(b, { literal: 1 }) ? a : addNode(graph, NodeOp.eq, [a, b], Types.bool)
        if (n.op === NodeOp.eq) putNode(graph, id, NodeOp.and, [present, values], Types.bool)
        else putNode(graph, id, NodeOp.or, [addNode(graph, NodeOp.eq, [present, { literal: 0 }], Types.bool), values], Types.bool)
    }
    const floatPayload = numberName(returns) === 'f64'
    function bitsOf(x: Operand): Operand {
        if (!floatPayload) return x
        if (typeof x !== 'number') return Number.isInteger(x.literal) && x.literal ? addNode(graph, NodeOp.bitconvert, [addNode(graph, NodeOp.literal, [x], Types.f64)], Types.u64) : x
        const from = reps.get(x) ?? reps.get(tailOf(graph, x))
        const value = from?.kind === 'number' && numberName(from) !== 'f64' ? addNode(graph, NodeOp.convert, [x], Types.f64) : x
        return addNode(graph, NodeOp.bitconvert, [value], Types.u64)
    }
    if (abi.mode === 'tagged') for (const ret of own) coerceSlots(graph, ret, [0], value => addNode(graph, NodeOp.record, [{ literal: 0 }, bitsOf(payloadOf(value)), { literal: 1 }, tagOf(value)]))
    if (abi.mode === 'narrow') {
        for (const ret of own) {
            coerceSlots(graph, ret, [0], narrowOf)
            raw.add(ret)
        }
    }
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op !== NodeOp.call) continue
        const passing = calls.get(id)?.tags
        if (!passing) continue
        const operands = getOperands(graph, n)
        const passed = operands.length
        const arity = passing.arity
        while (operands.length > 3 + arity) operands.pop()
        while (operands.length < 3 + arity) operands.push({ literal: 0 })
        for (const i of passing.indexes) operands.push(3 + i < passed ? tagOf(operands[3 + i]) : { literal: 0 })
        putCopy(graph, id, getNode(graph, id)!, operands)
    }
    inlineBoolLiterals(graph)
    for (const [id, truth] of [...nodeEntries(graph)]) {
        if (truth.op === NodeOp.select && countIds(truth) === 3 && getRef(truth, 0) && !getRef(truth, 1) && !getRef(truth, 2)) {
            const a = getLiteral(graph, truth, 1)
            const b = getLiteral(graph, truth, 2)
            if ((a === 0 && b === 1) || (a === 1 && b === 0)) putNode(graph, id, a ? NodeOp.ne : NodeOp.eq, [getOperand(graph, truth, 0), { literal: 0 }], Types.bool)
        }
        const n = getNode(graph, id)!
        if (n.op === NodeOp.get || raw.has(id) || !projections.size) continue
        let operands: Operand[] | undefined
        for (let i = firstNonOrderingSlot(n); i < countIds(n); i++) {
            const projection = projections.get(getRef(n, i))
            if (!projection || (n.op === NodeOp.apply && i === 0)) continue
            operands ??= getOperands(graph, n)
            operands[i] = projection[0]
        }
        if (operands) putCopy(graph, id, n, operands)
    }
}

export interface RuntimeCallRequest {
    bound: Set<number>
    compares: Set<number>
    floats?: Set<number>
    masks: Map<number, number>
    target: (op: rt.Op) => number
}

export interface CallMoves {
    moved: [node: number, from: number][]
    compared: [node: number, from: number][]
    dropped: number[]
}

export function runtimeCalls(graph: Graph, request: RuntimeCallRequest): CallMoves {
    const { bound, compares, masks } = request
    const moves: CallMoves = { moved: [], compared: [], dropped: [] }
    function target(op: rt.Op): number {
        return addNode(graph, NodeOp.heapHandle, [{ literal: request.target(op) }])
    }
    function toNumber(x: Operand, op = rt.Op.toNumber): Operand[] {
        const callee = target(op)
        return [addNode(graph, NodeOp.nilEffect, []), callee, { literal: 0 }, x]
    }
    const sites: number[] = []
    const coercions: number[] = []
    const additions: number[] = []
    for (const [id, n] of nodeEntries(graph)) {
        if ((n.op === NodeOp.eq || n.op === NodeOp.ne || n.op === NodeOp.select) && bound.has(id)) sites.push(id)
        else if (n.op === NodeOp.rt && getLiteral(graph, n, 1) === rt.Op.addOrConcat) additions.push(id)
        else if (rt.coercingOps.has(n.op) || rt.relationalOps.has(n.op) || (n.op === NodeOp.rt && (getLiteral(graph, n, 1) === rt.Op.toNumber || getLiteral(graph, n, 1) === rt.Op.trunc))) coercions.push(id)
    }
    for (const id of additions) {
        const n = getNode(graph, id)!
        const lhs = getOperand(graph, n, 2)
        const rhs = getOperand(graph, n, 3)
        if (!bound.has(id)) {
            putNode(graph, id, NodeOp.add, [lhs, rhs], Types.unknown_number)
            continue
        }
        const callee = target(rt.Op.addOrConcat)
        putNode(graph, id, NodeOp.call, [addNode(graph, NodeOp.nilEffect, []), callee, { literal: 0 }, lhs, rhs])
    }
    const forwarded = new Map<number, Operand>()
    for (const id of coercions) {
        const n = getNode(graph, id)!
        if (n.op === NodeOp.rt && bound.has(id)) {
            putNode(graph, id, NodeOp.call, toNumber(getOperand(graph, n, 2), getLiteral(graph, n, 1)))
            continue
        }
        if (n.op === NodeOp.rt) {
            forwarded.set(id, getOperand(graph, n, 2))
            continue
        }
        if (!bound.has(id)) continue
        const float = request.floats?.has(id)
        if (!float) moves.dropped.push(id)
        if (compares.has(id)) {
            const callee = target(rt.Op.compare)
            const call = addNode(graph, NodeOp.call, [addNode(graph, NodeOp.nilEffect, []), callee, { literal: 0 }, getOperand(graph, n, 0), getOperand(graph, n, 1)])
            moves.compared.push([call, id])
            putCopy(graph, id, n, [call, addNode(graph, NodeOp.literal, [{ literal: 0 }], Types.f64)])
            continue
        }
        const mask = masks.get(id) ?? 0
        const operands = getOperands(graph, n)
        let changed = false
        for (let i = 0; i < countIds(n); i++) {
            const x = getRef(n, i)
            if (!x || !(mask & (1 << i))) continue
            const call = addNode(graph, NodeOp.call, toNumber(x))
            moves.moved.push([call, id])
            operands[i] = call
            changed = true
        }
        if (float && typeRecording() && debugsTypes(graph.name)) noteType(id, `runtimeCalls: ${opName(n.op)} has a float operand in the plan (floatKey part), so it becomes a call to rt.${rt.opName(rt.floatArith.get(n.op)!)}`)
        if (float) putNode(graph, id, NodeOp.call, [addNode(graph, NodeOp.nilEffect, []), target(rt.floatArith.get(n.op)!), { literal: 0 }, ...operands])
        else if (changed) putCopy(graph, id, n, operands)
    }
    if (forwarded.size) {
        function forward(x: Operand): Operand {
            let at = x
            while (typeof at === 'number' && forwarded.has(at)) at = forwarded.get(at)!
            return at
        }
        for (const [id, n] of [...nodeEntries(graph)]) {
            let operands: Operand[] | undefined
            for (let i = 0; i < countIds(n); i++) {
                const x = getRef(n, i)
                if (!x || !forwarded.has(x)) continue
                operands ??= getOperands(graph, n)
                operands[i] = forward(x)
            }
            if (operands) putCopy(graph, id, n, operands)
        }
    }
    for (const id of sites) {
        const n = getNode(graph, id)!
        if (n.op === NodeOp.select) {
            const callee = target(rt.Op.truthy)
            const test = addNode(graph, NodeOp.call, [addNode(graph, NodeOp.nilEffect, []), callee, { literal: 0 }, getOperand(graph, n, 0)])
            moves.moved.push([test, id])
            moves.dropped.push(id)
            putNode(graph, id, NodeOp.select, [test, ...getOperands(graph, n).slice(1)])
            continue
        }
        const callee = target(rt.Op.strictEqual)
        const operands = [addNode(graph, NodeOp.nilEffect, []), callee, { literal: 0 }, getOperand(graph, n, 0), getOperand(graph, n, 1)]
        if (n.op === NodeOp.eq) {
            putNode(graph, id, NodeOp.call, operands)
            continue
        }
        const equal = addNode(graph, NodeOp.call, operands)
        moves.moved.push([equal, id])
        putNode(graph, id, NodeOp.eq, [equal, { literal: 0 }], Types.bool)
    }
    return moves
}

const iterationKeys = {
    next: heap.fromJsString('next'), done: heap.fromJsString('done'), value: heap.fromJsString('value'), length: heap.fromJsString('length'),
    return: heap.fromJsString('return'),
}

export interface IndexedIteration {
    next: number
    values: number[]
    index: number
}

export function indexArrayIterations(graph: Graph, iterations: Map<number, intrinsics.Handle>): IndexedIteration[] {
    const users = nodeUsers(graph, nodeIds(graph), true)
    const ordering = (user: number, slot: number): boolean => slot < firstNonOrderingSlot(getNode(graph, user)!)
    const literalKey = (n: GraphNode | undefined, op: NodeOp, key: intrinsics.Handle) => n?.op === op && !getRef(n, 2) && getLiteral(graph, n, 2) === key
    const blockOf = (id: number): number | undefined => {
        for (let n = getNode(graph, id); n; n = getNode(graph, id)) {
            if (n.op === NodeOp.nilEffect) return countLiterals(n) ? getRef(n, 0) : undefined
            id = getRef(n, 0)
            if (!id) return
        }
    }
    const owners = new Map<number, number>()
    for (const b of graph.blocks) {
        const stack = [b.bodyId]
        while (stack.length) {
            const id = stack.pop()!
            const n = id ? getNode(graph, id) : undefined
            if (!n || owners.has(id) || n.op === NodeOp.block || n.op === NodeOp.param) continue
            if (n.op === NodeOp.apply) owners.set(id, b.id)
            if (n.op !== NodeOp.apply && n.op !== NodeOp.select && n.op !== NodeOp.after) continue
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
    }
    function selfIteration(iterator: number): [prop: number, call: number] | undefined {
        const uses = (users.get(iterator) ?? []).filter(([u, slot]) => !ordering(u, slot))
        if (uses.length !== 2) return
        const prop = uses.find(([u, slot]) => slot === 1 && literalKey(getNode(graph, u), NodeOp.getProp, heap.fromJsSymbol(Symbol.iterator)))?.[0]
        const call = uses.find(([u, slot]) => slot === 2 && getNode(graph, u)!.op === NodeOp.call)?.[0]
        if (prop === undefined || call === undefined) return
        const n = getNode(graph, call)!
        if (countIds(n) !== 3 || getRef(n, 1) !== prop) return
        if ((users.get(prop) ?? []).some(([u, slot]) => !ordering(u, slot) && !(u === call && slot === 1))) return
        return [prop, call]
    }
    const loops = graphLoops(graph)
    const out: IndexedIteration[] = []
    for (const [symbol, field] of iterations) {
        const s = getNode(graph, symbol)
        if (s?.op !== NodeOp.getProp) continue
        const object = getRef(s, 1)
        const makers = (users.get(symbol) ?? []).filter(([u, slot]) => !ordering(u, slot))
        if (makers.length !== 1 || makers[0][1] !== 1) continue
        const made = makers[0][0]
        const make = getNode(graph, made)!
        if (make.op !== NodeOp.call || getRef(make, 2) !== object || countIds(make) !== 3) continue
        const relay = selfIteration(made)
        const iterator = relay ? relay[1] : made
        const nextProps: number[] = []
        const returnProps: number[] = []
        let nextCalls: number[] = []
        let valid = true
        for (const [u, slot] of users.get(iterator) ?? []) {
            if (ordering(u, slot)) continue
            const n = getNode(graph, u)!
            if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.next)) nextProps.push(u)
            else if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.return)) returnProps.push(u)
            else if (slot === 2 && n.op === NodeOp.call && countIds(n) === 3) nextCalls.push(u)
            else valid = false
        }
        const returnCalls = nextCalls.filter(c => returnProps.includes(getRef(getNode(graph, c)!, 1)))
        nextCalls = nextCalls.filter(c => !returnCalls.includes(c))
        if (!valid || nextCalls.length !== 1) continue
        const call = nextCalls[0]
        if (!nextProps.includes(getRef(getNode(graph, call)!, 1))) continue
        for (const prop of nextProps) {
            for (const [u, slot] of users.get(prop) ?? []) if (!ordering(u, slot) && !(u === call && slot === 1)) valid = false
        }
        const done: number[] = []
        const values: number[] = []
        for (const [u, slot] of users.get(call) ?? []) {
            if (ordering(u, slot)) continue
            const n = getNode(graph, u)!
            if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.done)) done.push(u)
            else if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.value)) values.push(u)
            else valid = false
        }
        if (!valid || !done.length) continue
        const header = blockOf(call)
        const members = header === undefined ? undefined : loops.loopMembers.get(header)
        if (header === undefined || !members) continue
        const block = getBlock(graph, header)!
        const token = getRef(getNode(graph, call)!, 0)
        const array = field ? addNode(graph, NodeOp.getProp, [getRef(make, 0), object, { literal: field }]) : object
        const index = addNode(graph, NodeOp.param, [])
        block.params.push(index)
        for (const [app, owner] of owners) {
            const n = getNode(graph, app)!
            if (getRef(n, 0) !== header) continue
            let arg: Operand = { literal: 0 }
            if (members.has(owner)) {
                arg = addNode(graph, NodeOp.add, [index, { literal: 1 }])
            }
            putCopy(graph, app, n, [...getOperands(graph, n), arg])
        }
        const length = addNode(graph, NodeOp.getProp, [token, array, { literal: iterationKeys.length }])
        const finished = addNode(graph, NodeOp.ge, [index, length], Types.bool)
        for (const id of done) putNode(graph, id, NodeOp.after, [length, finished])
        for (const id of values) putNode(graph, id, NodeOp.getProp, [getRef(getNode(graph, id)!, 0), array, index])
        out.push({ next: call, values, index })
        for (const id of returnProps) putNode(graph, id, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
        for (const id of [call, ...nextProps, ...returnCalls, iterator, ...relay ?? [], made, symbol]) {
            if (!getNode(graph, id) || getNode(graph, id)!.op === NodeOp.after) continue
            const tok = getRef(getNode(graph, id)!, 0)
            putNode(graph, id, NodeOp.after, [tok, tok])
        }
    }
    return out
}

export function functionObjectCalls(graph: Graph, code: Map<number, intrinsics.Handle>): void {
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op !== NodeOp.call || !getRef(n, 1)) continue
        const target = getNode(graph, tailOf(graph, getRef(n, 1)))
        if (target?.op !== NodeOp.heapHandle || getRef(target, 0) || heapInterior(graph, target)) continue
        const cell = code.get(getLiteral(graph, target, 0))
        if (cell === undefined) continue
        putCopy(graph, id, n, withOperand(graph, n, 1, addNode(graph, NodeOp.heapHandle, [{ literal: cell }])))
    }
}

function codeCell(graph: Graph, x: Operand): number | undefined {
    if (typeof x !== 'number' || !x) return
    const n = getNode(graph, x)
    if (n?.op !== NodeOp.heapHandle || getRef(n, 0) || heapInterior(graph, n)) return
    return getLiteral(graph, n, 0)
}

export function functionObjectValues(graph: Graph, slots: Map<number, number[]>, objects: Map<number, intrinsics.Handle>): void {
    const made = new Map<number, number>()
    function objectValue(x: Operand): Operand {
        if (typeof x !== 'number' || !x) return x
        const known = made.get(x)
        if (known !== undefined) return known
        const cell = codeCell(graph, x)
        const object = cell === undefined ? undefined : objects.get(cell)
        if (object === undefined) return x
        const id = addNode(graph, NodeOp.heapHandle, [{ literal: object }])
        made.set(x, id)
        return id
    }
    for (const [id, at] of slots) {
        const n = getNode(graph, id)!
        let operands: Operand[] | undefined
        for (const i of at) {
            const x = getOperand(graph, n, i)
            const next = objectValue(x)
            if (next === x) continue
            operands ??= getOperands(graph, n)
            operands[i] = next
        }
        if (operands) putCopy(graph, id, n, operands)
    }
}

export interface ParamConstant {
    handle?: intrinsics.Handle
    literal?: number
}

export function substituteConstantParams(graph: Graph, constants: Map<number, ParamConstant>): void {
    if (!constants.size) return
    const params = new Map<number, number>()
    for (const [i, constant] of constants) params.set(graph.blocks[0].params[i], addNode(graph, constant.handle !== undefined ? NodeOp.heapHandle : NodeOp.literal, [{ literal: constant.handle ?? constant.literal! }]))
    for (const [id, n] of nodeEntries(graph)) {
        let ops: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            const constant = params.get(getRef(n, i))
            if (constant === undefined) continue
            ops ??= getOperands(graph, n)
            ops[i] = constant
        }
        if (ops) putCopy(graph, id, n, ops)
    }
}

function createResolver(linker: Linker, tracer: Tracer, plan: ShapePlan, planned: Planned, reps: Representations, facts: Facts, clock: PhaseClock, wordsSlot: (words: number[]) => number) {
    const { session, functions, unitOf, originOf, constructsOutOfLine, link, isRoot, sourceOfLinked, usesReceiver, thisParamOf, calleeOf, codeOf, boundTarget } = linker
    const { graphsOf, reachableNodes } = tracer
    const layouts: propertyEval.LayoutTable = { codecs: facts, fixedCodecs: new Set([...plan.shapes.values(), ...planned.frames.values()]), refinements: plan.embedded.fields, bits: plan.bits, fixed: plan.fixedFields, erased: plan.erasedFields, views: plan.closureViews, codes: plan.closureCodes, absent: plan.absentKeys }
    function abiOf(fn: Function): UnitAbi {
        return reps.abi.get(fn) ?? { mode: constructsOutOfLine(fn) || unitOf(originOf(fn)).stubbed ? 'keep' : 'encoded', returns: Types.u64, tags: [] }
    }
    function functionState(cell: intrinsics.Handle): intrinsics.Handle {
        return heap.isIndirect(cell) ? heap.indirectTarget(cell) : heap.deref(cell)
    }
    function plannedAnswers(unit: PlannedUnit, nodes: Map<number, Rep>): Map<number, propertyEval.Answer> {
        const out = new Map<number, propertyEval.Answer>()
        for (const [node, rep] of nodes) {
            const answer: propertyEval.Answer = {}
            const target = soleTarget(rep)
            if (rep.kind === 'number') answer.shape = propertyEval.numberShape
            else if (rep.kind === 'undefined') answer.shape = null
            else if (target === 'buf' && (rep.kind === 'pointer' || rep.kind === 'union')) answer.shape = propertyEval.numberShape
            else if (target === 'str' && rep.kind === 'pointer') answer.shape = propertyEval.stringShape
            else if (rep.kind === 'pointer') answer.shape = targetShape(plan, target)
            if (rep.kind === 'pointer' && rep.targets.length >= 2) {
                const members = rep.targets.map(target => targetShape(plan, target))
                if (members.every(m => m !== undefined)) answer.members = members as intrinsics.Handle[]
            }
            if (rep.nullable && (rep.kind === 'pointer' || (rep.kind === 'number' && tagged(reps.tags, unit, node)))) {
                if (rep.zero) answer.zero = true
                else answer.nullable = true
            }
            if (numberName(rep) === 'int' || numberName(rep) === 'i64') answer.signed = numberName(rep) === 'i64'
            if (rep.kind === 'number' && rep.bools && !rep.nullable) answer.bool = true
            answer.primitives = primitiveShapes(rep)
            if (rep.functions) answer.functions = rep.functions.map(f => functionState(session.linkFunction(f) as intrinsics.Handle))
            if (rep.functions?.length === 1) answer.callee = session.linkFunction(rep.functions[0]) as intrinsics.Handle
            if (rep.kind === 'union') {
                const objects = objectRep(rep).targets.map(target => targetShape(plan, target))
                if (objects.length && objects.every(m => m !== undefined)) answer.objects = objects as intrinsics.Handle[]
            }
            out.set(node, answer)
        }
        for (const [node, rep] of unit.receivers) {
            if (!isStringRep(rep) || rep.nullable) continue
            const answer = out.get(node) ?? {}
            answer.receiver = propertyEval.stringShape
            out.set(node, answer)
        }
        return out
    }
    function plannedParams(fn: Function): { index: number, label: string, rep: Rep }[] {
        const paramCount = sourceOfLinked(fn)?.compiled.paramCount ?? 0
        return (planned.units.get(fn)?.params ?? []).map(({ label, rep }, index) => {
            intrinsics.assert(label !== 'this' || index === paramCount, `native: ${fn.name} receiver is not param ${paramCount}`)
            return { index, label, rep }
        })
    }
    function paramShapesOf(fn: Function): Map<number, intrinsics.Handle> {
        const out = new Map<number, intrinsics.Handle>()
        for (const { index, rep } of plannedParams(fn)) {
            const shape = plannedShape(plan, rep)
            if (shape !== undefined) out.set(index, shape)
        }
        return out
    }
    function unionParams(fn: Function): number[] {
        return plannedParams(fn).filter(({ rep }) => unionWord(rep)).map(({ index }) => index)
    }
    function constantParams(fn: Function): Map<number, ParamConstant> {
        const out = new Map<number, ParamConstant>()
        for (const { index, rep } of plannedParams(fn)) {
            const constant = rep.constant
            if (!constant || isRoot(fn)) continue
            if (constant.fn) out.set(index, { handle: session.linkFunction(constant.fn) as intrinsics.Handle })
            else if (constant.handle !== undefined) out.set(index, { handle: constant.handle })
            else out.set(index, { literal: constant.literal! })
        }
        return out
    }
    function calleeParams(resolved: Resolution): Map<number, Map<number, Arrival>> {
        const out = new Map<number, Map<number, Arrival>>()
        for (const [call, unit] of resolved.callees) {
            const callee = planned.functions.get(unit)!
            const shapes = paramShapesOf(callee)
            out.set(call, new Map(plannedParams(callee).map(({ index, rep }) => [index, { rep, shaped: shapes.has(index) }])))
        }
        return out
    }
    function plannedCall(g: NodeSpace, caller: Function, local: UnitPlan | undefined, bound: Map<number, PlannedUnit>, site: propertyEval.CallSite): propertyEval.CallBinding | undefined {
        let callees = local?.calls.get(site.call)
        const originCalls = site.origin !== undefined ? local?.calls.get(site.origin) : undefined
        if (!callees?.size && originCalls?.size) {
            const receiverOf = (unit: PlannedUnit) => {
                const callee = planned.functions.get(unit)!
                return paramShapesOf(callee).get(sourceOfLinked(callee)?.compiled.paramCount ?? 0)
            }
            const sharedReceiver = (unit: PlannedUnit) => (planned.shared.get(unit) ?? []).some(other => {
                const rep = other.params.find(p => p.label === 'this')?.rep
                return rep !== undefined && plannedShape(plan, rep) === site.receiver
            })
            const receiving = [...originCalls].filter(unit => receiverOf(unit) === site.receiver || sharedReceiver(unit))
            callees = new Set(receiving)
        }
        if (!callees?.size && site.context === undefined) {
            const linked = calleeOf(g, site.target)
            const known = linked && isLocalStub(linked) ? functions[(linked as any).__localTarget] : linked
            const fn = known && codeOf(known) ? boundTarget(known, site.args.length, !!site.spread) : known
            const candidates = fn ? plan.units.get(originOf(fn)) ?? [] : []
            const matching = candidates.length > 1 ? candidates.filter(unit => {
                const paramCount = sourceOfLinked(fn!)?.compiled.paramCount ?? 0
                return paramShapesOf(planned.functions.get(unit)!).get(paramCount) === site.receiver
            }) : candidates
            callees = matching.length === 1 ? new Set(matching) : undefined
            const fallback = fn && planned.units.has(fn) ? abiOf(fn).returns : Types.u64
            if (!callees && fallback !== Types.u64) throw compileError(`native: ${caller.name} %${site.call} binds none of the ${candidates.length} planned units of ${fn!.name} (${matching.length} take its receiver), so it links to ${fn!.name} itself, which returns ${typeName(fallback)}`, site.call)
        }
        if (!callees?.size) return
        const signatureOf = (unit: PlannedUnit, width: number) => `${unit.params.slice(0, width).map(p => `${p.label}: ${argumentKey(p.rep)}`).join()}->${unit.returns.text}|${[...unit.tagged].sort((a, b) => a - b).join(',')}`
        if (callees.size > 1 && site.context !== undefined) {
            const widest = [...callees].sort((a, b) => b.params.length - a.params.length)[0]
            const own = [...callees].every(unit => {
                const callee = planned.functions.get(unit)!
                return callee === originOf(callee) && unitOf(callee).restExtras === undefined && unitOf(callee).spreadFixed === undefined
            })
            if (own && [...callees].every(unit => signatureOf(unit, unit.params.length) === signatureOf(widest, unit.params.length))) callees = new Set([widest])
        }
        if (callees.size > 1) throw `native: ${caller.name} %${site.call} reaches ${callees.size} planned units: ${[...callees].map(u => `${u.fn.name}${u.signature}`).join(' | ')}`
        const unit = [...callees][0]
        bound.set(site.call, unit)
        const callee = planned.functions.get(unit)!
        const source = sourceOfLinked(callee)
        if (!source) return
        const paramCount = source.compiled.paramCount
        const receiver = site.context === undefined ? source.blocks.liveIn[0].has(source.compiled.registerCount) : usesReceiver(callee) && site.receiver !== undefined
        const shapes = paramShapesOf(callee)
        const own = local?.nodes.get(site.call)
        const returned = own && own.kind !== 'never' ? { ...own, nullable: own.nullable || unit.returns.nullable } : unit.returns
        const calleeAbi = abiOf(callee)
        const boxedFloat = numberName(returned) === 'f64' && calleeAbi.returns === Types.vm_value
        const numeric = returned.kind === 'number' && !boxedFloat
        const other = recordObject(returned)
        const record = other ? 1 : undefined
        const value = other ?? returned
        const objects = objectRep(value)
        const members = numeric ? undefined : plannedMembers(plan, objects)
        const result = numeric ? propertyEval.numberShape : isStringRep(returned) ? propertyEval.stringShape : members?.[0] ?? plannedShape(plan, objects)
        const origin = originOf(callee)
        const target = callee === origin && unitOf(origin).restExtras === undefined && unitOf(origin).spreadFixed === undefined ? undefined : site.context !== undefined || site.target.op === NodeOp.localTarget ? link(callee) : session.linkFunction(callee)
        const worded = unionWord(unit.returns) && !unionWord(returned)
        return {
            paramCount: site.context !== undefined && !receiver ? Math.max(site.args.length, paramCount) : paramCount, receiver,
            receiverShape: receiver ? shapes.get(paramCount) : undefined,
            argShapes: Array.from({ length: paramCount }, (_, i) => shapes.get(i)),
            result, members, primitives: result !== undefined ? primitiveShapes(value) : undefined, nullish: returned.kind === 'undefined' || undefined, returnsReceiver: (receiver && unit.returnsSelf) || undefined, float: boxedFloat || undefined, union: unionWord(returned) || record !== undefined || undefined, field: record,
            stringWord: (isStringRep(returned) && worded) || undefined,
            boxed: ((numberName(returned) === 'int' || numberName(returned) === 'i64') && worded && !returned.tested) || undefined,
            nullable: returned.nullable || undefined,
            bool: !!returned.bools || undefined,
            decode: record !== undefined ? unionWord(value) ? pstack0Base() : undefined : (result !== undefined && !isStringRep(returned) && !numeric && !heldAsField(facts, members ?? [result]) && calleeAbi.mode !== 'raw' && (calleeAbi.mode === 'encoded' || unionWord(returned) || worded)) || boxedFloat ? pstack0Base() : undefined,
            target,
            returns: calleeAbi.mode === 'raw' ? Types.u64 : calleeAbi.returns === Types.u64 ? undefined : calleeAbi.returns,
        }
    }
    function tupleKeys(tuple: intrinsics.Handle, record: intrinsics.Handle): intrinsics.Handle[] | undefined {
        const keys = tracer.engineElements.get(tuple)
        if (!keys || !plan.fixedStatic(tuple, heap.indexKey(0))) return
        for (const key of keys) {
            if (!heap.isString(key) || !heap.getOwnProperty(record, key) || !plan.fixedStatic(record, key)) return
            const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(record, key)))
            if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return
        }
        return keys
    }
    function resolveUnit(fn: Function): Resolution {
        const unit = graphsOf(fn)
        const source = unit.source!
        const name = fn.name
        const reps = plannedParams(fn)
        const params = paramShapes(fn, source.compiled.paramCount)
        const traced = { ...unit.traced!, graph: withNodes(unit.traced!.graph, copyNodes(unit.traced!.graph)) }
        substituteConstantParams(traced.graph, constantParams(fn))
        verifyTraced(traced, 'resolve:entry')
        const plannedUnit = planned.units.get(fn)
        const local: UnitPlan | undefined = plannedUnit && { unit: plannedUnit, tagged: new Set(plannedUnit.tagged), slices: new Map(plannedUnit.slices), nodes: new Map(plannedUnit.nodes), calls: new Map(plannedUnit.calls) }
        const rewrite = plannedUnit && planned.rewrites.get(plannedUnit)
        if (rewrite) rewrite(traced.graph)
        plannedFunctionObjects(traced.graph, local)
        const bound = new Map<number, PlannedUnit>()
        tracer.foldStatics(traced, plan.fixedStatic)
        if (plannedUnit?.blocks.size) pruneUnentered(traced.graph, plannedUnit, traced.allocations)
        plannedDivisions(traced.graph, local)
        if (local) plannedRuntimeCalls(traced.graph, local)
        if (flags.has(`pe-input:${name}`)) {
            const refined = (s: intrinsics.Handle) => [...plan.embedded.fields.get(s) ?? []].map(([k, v]) => `${heap.isString(k) ? heap.stringToJs(k) : k}:${describe(v)}`).join(',')
            const shapes = [...paramShapesOf(fn)].map(([i, s]) => `${i}=${describe(s)} refined=${refined(s)}`).join(' ')
            const context = planned.contexts.has(fn) ? describe(planned.contexts.get(fn)) : '-'
            console.log('INPUTS', name, shapes, 'reps', reps.map(({ label, rep }) => `${label}=${rep.text}`).join(';'), 'ctx', context, dumpGraph(traced.graph))
        }
        const entryTypes = paramTypes(fn, traced.graph)
        if (typeRecording() && debugsTypes(name)) for (const [param, T] of entryTypes) noteType(param, `resolve ${name}: entry param typed ${typeName(T)} from its planned rep ${reps.find(p => traced.graph.blocks[0].params[p.index] === param)?.rep.text ?? '?'} (paramTypes)`)
        retypeValues(traced.graph, entryTypes)
        const frameShapes = new Map<u32, intrinsics.Handle>()
        for (const [proxy, size] of traced.frames) frameShapes.set(proxy, planned.frames.get(proxy) ?? propertyEval.frameShape(size, proxy as intrinsics.Handle))
        for (const [cell, param] of unit.cold ?? []) {
            const frame = planned.frames.get(cell)
            const index = traced.graph.blocks[0].params.indexOf(param)
            if (frame !== undefined && index >= 0) params.set(index, frame)
        }
        const allocationShapes = plannedUnit ? new Map([...plannedUnit.allocations].flatMap(([node, id]) => plan.shapes.has(id) ? [[node, plan.shapes.get(id)!] as [number, intrinsics.Handle]] : [])) : undefined
        if (traced.allocations?.size) {
            const layouts = new Map<u32, intrinsics.Handle>()
            for (const [id, shape] of allocationShapes ?? []) {
                const n = getNode(traced.graph, id)
                if (n?.op === NodeOp.heapHandle && !getRef(n, 0) && traced.allocations.has(getLiteral(traced.graph, n, 0) as u32)) layouts.set(getLiteral(traced.graph, n, 0) as u32, shape)
            }
            for (const [id, n] of [...nodeEntries(traced.graph)]) {
                if (n.op !== NodeOp.heapHandle || getRef(n, 0) || !heapInterior(traced.graph, n)) continue
                const cell = getLiteral(traced.graph, n, 0) as u32
                const shape = layouts.get(cell)
                if (shape === undefined) continue
                frameShapes.set(cell, shape)
                if (traced.allocations.get(cell)!.call === undefined) putNode(traced.graph, id, NodeOp.heapHandle, [{ literal: cell }, { literal: shape }], typeOf(n))
            }
        }
        if (allocationShapes) {
            for (const [id, n] of [...nodeEntries(traced.graph)]) {
                if (n.op !== NodeOp.heapHandle || getRef(n, 0) || heapInterior(traced.graph, n)) continue
                const cell = getLiteral(traced.graph, n, 0) as intrinsics.Handle
                const state = cell ? heap.deref(cell) : 0 as intrinsics.Handle
                const shape = state ? plan.constants.get(state) : undefined
                if (shape === undefined) continue
                intrinsics.assert(!heapFieldCount(n), `native: constant @${cell} carries graph fields`)
                putNode(traced.graph, id, NodeOp.heapHandle, [{ literal: cell }, { literal: state }])
                allocationShapes.set(id, shape)
            }
        }
        const iterations = local ? plannedIterations(local, traced.graph) : new Map<number, intrinsics.Handle>()
        if (iterations.size) {
            for (const { next, values, index } of indexArrayIterations(traced.graph, iterations)) {
                local!.nodes.set(index, { text: 'i64', kind: 'number', format: { bits: 64, signed: true }, targets: [], nullable: false })
                const reads = new Set([...local!.calls.get(next) ?? []].flatMap(unit => [...unit.calls.values()].flatMap(set => [...set])).filter(unit => originOf(unit.fn) === indexGetter()))
                if (reads.size !== 1) continue
                for (const id of values) {
                    local!.calls.set(id, reads)
                }
            }
        }
        let sliceTags: SliceTags | undefined
        if ([...allNodes(traced.graph)].some(n => rt.sliceOf(traced.graph, n) !== undefined)) {
            sliceTags = realizeSlices(traced.graph, local?.slices, local?.nodes, local?.tagged)
        }
        const dynamic = local ? runtimeHeapSites(local, traced.graph) : undefined
        const regions = plannedUnit && planned.regions.get(plannedUnit)
        if (regions) placePstackMarkers(traced.graph, regions)
        verifyTraced(traced, 'resolve:input')
        const result = propertyEval.placeObjects(traced.graph, {
            session, frames: frameShapes, params, layouts, answers: local ? plannedAnswers(local.unit, local.nodes) : undefined, embedded: embeddedSites(plannedUnit, traced.graph),
            calls: site => plannedCall(traced.graph, fn, local, bound, site), dynamic, allocationShapes, readonly: plan.statics.readonly, statics: plan.statics.placed, allocations: traced.allocations, rawReturns: abiOf(fn).mode !== 'encoded',
            contextShape: planned.contexts.get(fn), unionParams: unionParamBases(fn), bound: unit.cold, forwardedKey, tupleKeys, wordsSlot,
        })
        plannedFunctionCalls(result.graph)
        const fieldTags = new Map([...sliceTags?.reads ?? [], ...result.tags])
        return { graph: result.graph, shapes: result.shapes, encoded: result.encoded, fieldTags, tagWrites: sliceTags?.writes ?? new Map(), wordWrites: sliceTags?.words ?? new Map(), local, callees: bound }
    }
    function plannedDivisions(graph: Graph, local: UnitPlan | undefined): void {
        for (const [id, n] of [...nodeEntries(graph)]) {
            if (n.op !== NodeOp.rt || getLiteral(graph, n, 1) !== rt.Op.div) continue
            const name = numberName(local?.nodes.get(id))
            const integral = name === 'int' || name === 'i64'
            if (typeRecording() && debugsTypes(graph.name)) noteType(id, `plannedDivisions: rt.div is ${integral ? 'integral (planned rep ' + name + '), so it divides integers' : 'not proven integral, so it divides as f64'}`)
            putNode(graph, id, NodeOp.div, [getOperand(graph, n, 2), getOperand(graph, n, 3)], integral ? Types.unknown_number : Types.f64)
        }
    }
    function plannedRuntimeCalls(graph: Graph, local: UnitPlan): void {
        const compareImpl = rt.bindingOf(rt.Op.compare)!.impl!
        const compares = new Map<number, Set<PlannedUnit>>()
        const floats = new Map<number, Set<PlannedUnit>>()
        for (const [id, callees] of local.calls) {
            const n = getNode(graph, id)
            if (!n || (!rt.coercingOps.has(n.op) && !rt.relationalOps.has(n.op))) continue
            const units = new Set([...callees].filter(unit => originOf(unit.fn) === compareImpl))
            if (units.size) compares.set(id, units)
            const op = rt.floatArith.get(n.op)
            if (op === undefined) continue
            const floatImpl = rt.bindingOf(op)!.impl!
            const computed = new Set([...callees].filter(unit => originOf(unit.fn) === floatImpl))
            if (computed.size) floats.set(id, computed)
        }
        const moves = runtimeCalls(graph, { bound: new Set(local.calls.keys()), compares: new Set(compares.keys()), floats: new Set(floats.keys()), masks: local.unit.coercions, target: op => session.linkFunction(rt.bindingOf(op)!.impl!) })
        for (const [node, from] of moves.moved) local.calls.set(node, new Set([...local.calls.get(from)!].filter(unit => !floats.get(from)?.has(unit))))
        for (const [node, from] of moves.compared) local.calls.set(node, compares.get(from)!)
        for (const id of moves.dropped) local.calls.delete(id)
        for (const [id, units] of floats) local.calls.set(id, units)
    }
    function runtimeHeapSites(local: UnitPlan, graph: Graph): Map<number, Function> | undefined {
        const out = new Map<number, Function>()
        for (const [node, shape] of local.unit.allocations) if (shape === 'heap') out.set(node, heap.makePlainObject)
        if (!out.size && ![...local.nodes.values()].some(rep => rep.targets.includes('heap'))) return
        for (const [id, n] of nodeEntries(graph)) {
            if (n.op !== NodeOp.getProp && n.op !== NodeOp.setProp && !rt.isDelete(graph, n)) continue
            const fn = [...local.calls.get(id) ?? []].map(callee => originOf(callee.fn)).find(fn => runtimeHeapAccessors.has(fn))
            if (fn) {
                out.set(id, fn)
                continue
            }
            if (local.nodes.get(getRef(n, 1))?.targets.includes('heap')) throw `native: %${id} in ${graph.name} keeps ${local.nodes.get(n.op === NodeOp.setProp ? getRef(n, 3) : id)?.text ?? 'a literal'} in a runtime-heap object, whose slots hold numbers or runtime-heap handles, not both`
        }
        return out.size ? out : undefined
    }
    function pruneUnentered(graph: Graph, unit: PlannedUnit, allocations: Traced['allocations']): void {
        const dead = graph.blocks.filter(b => b.id !== graph.root && !unit.blocks.has(b.id))
        const arms = [...unit.deadArms].filter(([select, list]) => getNode(graph, select)?.op === NodeOp.select && list.every(i => i < countIds(getNode(graph, select)!)))
        if (!dead.length && !arms.length) return
        if (flags.has('prune-debug')) console.log('PRUNE', graph.name, dead.map(b => `B${b.id}`).join(' '))
        const ids = new Set(dead.map(b => b.id))
        const end = addNode(graph, NodeOp.unreachable, [])
        for (const [select, list] of arms) {
            const n = getNode(graph, select)!
            const operands = getOperands(graph, n)
            for (const i of list) operands[i] = end
            putCopy(graph, select, n, operands)
        }
        setGraphBlocks(graph, graph.blocks.map(b => ids.has(b.id) ? { ...b, bodyId: end, bodyConst: 0 } : b))
        const live = reachableNodes(graph, allocations)
        for (const id of [...nodeIds(graph)]) if (!live.has(id)) deleteNode(graph, id)
    }
    let arrayProto: intrinsics.Handle | undefined
    let arrayIndexGetter: Function | undefined
    function indexGetter(): Function | undefined {
        if (arrayIndexGetter) return arrayIndexGetter
        const proxy = heap.getPropertyProxy(arrayProto!, heap.indexKey(0 as u32))
        const linked = proxy ? session.stubFunctions.get(heap.getProxyGetter(proxy) as intrinsics.Handle) : undefined
        arrayIndexGetter = linked ? originOf(linked) : undefined
        return arrayIndexGetter
    }
    const forwardedKeys = new Map<intrinsics.Handle, intrinsics.Handle | undefined>()
    function forwardedKey(getter: intrinsics.Handle): intrinsics.Handle | undefined {
        if (forwardedKeys.has(getter)) return forwardedKeys.get(getter)
        const linked = session.stubFunctions.get(getter)
        const graph = linked ? unitOf(originOf(linked)).traced?.graph : undefined
        const key = graph ? propertyEval.forwardedField(graph) : undefined
        forwardedKeys.set(getter, key)
        return key
    }
    function plannedIterations(local: UnitPlan, graph: Graph): Map<number, intrinsics.Handle> {
        const iterations = new Map<number, intrinsics.Handle>()
        arrayProto ??= heap.deref(heap.getPrototypeProperty(heap.deref(session.linkFunction(builtinGlobals.Array) as intrinsics.Handle)))
        const key = heap.fromJsSymbol(Symbol.iterator)
        function iteratesArray(calls: Map<number, Set<PlannedUnit>>, g: Graph, call: GraphNode, id: number): boolean {
            const target = getNode(g, getRef(call, 1))
            if (target?.op !== NodeOp.getProp || getRef(target, 2) || getLiteral(g, target, 2) !== key) return false
            const callees = calls.get(id)
            if (!callees?.size) return false
            return [...callees].every(callee => {
                const self = callee.params.find(p => p.label === 'this')
                const shape = self ? plannedShape(plan, self.rep) : undefined
                return shape !== undefined && heap.getPrototypeOf(shape) === arrayProto
            })
        }
        function iteratedField(callee: PlannedUnit): intrinsics.Handle | undefined {
            const g = graphsOf(callee.fn).traced!.graph
            const self = thisParamOf(g)
            if (self === undefined || g.blocks.length !== 1) return
            const ret = getNode(g, tailOf(g, g.blocks[0].bodyId))
            if (ret?.op !== NodeOp.ret) return
            const id = tailOf(g, getRef(ret, 0))
            const call = getNode(g, id)
            if (call?.op !== NodeOp.call || countIds(call) !== 3 || !iteratesArray(callee.calls, g, call, id)) return
            const field = getNode(g, getRef(call, 2))
            if (field?.op !== NodeOp.getProp || getRef(field, 2) || getRef(field, 1) !== self) return
            if (getRef(getNode(g, getRef(call, 1))!, 1) !== getRef(call, 2)) return
            return getLiteral(g, field, 2) as intrinsics.Handle
        }
        for (const [id, n] of nodeEntries(graph)) {
            if (n.op !== NodeOp.call || countIds(n) !== 3) continue
            if (iteratesArray(local.calls, graph, n, id)) {
                iterations.set(getRef(n, 1), 0 as intrinsics.Handle)
                continue
            }
            const target = getNode(graph, getRef(n, 1))
            const callees = local.calls.get(id)
            if (target?.op !== NodeOp.getProp || getRef(target, 2) || !callees?.size) continue
            const fields = new Set([...callees].map(iteratedField))
            const field = fields.size === 1 ? [...fields][0] : undefined
            if (field !== undefined) iterations.set(getRef(n, 1), field)
        }
        return iterations
    }
    function paramShapes(fn: Function, paramCount: number): Map<number, intrinsics.Handle> {
        const shapes = paramShapesOf(fn)
        const reps = new Map(plannedParams(fn).map(({ index, rep }) => [index, rep]))
        for (let i = 0; i < paramCount; i++) {
            if (shapes.has(i)) continue
            const rep = reps.get(i)
            if (isRoot(fn) || rep?.kind === 'number') shapes.set(i, propertyEval.numberShape)
        }
        return shapes
    }
    function functionObjectOf(cell: number): intrinsics.Handle | undefined {
        const known = plan.functionObjects.cells.get(cell)
        if (known !== undefined) return known
        const stub = session.stubFunctions.get(cell as u32) as any
        return stub ? plan.functionObjects.functions.get(isLocalStub(stub) ? functions[stub.__localTarget] : stub) : undefined
    }
    function wantsObject(rep: Rep | undefined): boolean {
        if (!rep || rep.constant) return false
        return rep.kind === 'union' || (rep.kind === 'pointer' && !rep.targets.includes('fn'))
    }
    function fieldWantsObject(local: UnitPlan | undefined, object: number, key: intrinsics.Handle): boolean {
        const label = keyLabel(key)
        for (const target of local?.nodes.get(object)?.targets ?? []) {
            const field = plan.inst.shapes.get(target)?.fields.find(([k]) => k === label)
            if (field && wantsObject(field[1])) return true
        }
        return false
    }
    function plannedFunctionCalls(graph: Graph): void {
        const code = new Map<number, intrinsics.Handle>()
        for (const [cell, object] of plan.functionObjects.cells) code.set(object, cell as intrinsics.Handle)
        functionObjectCalls(graph, code)
    }
    function plannedFunctionObjects(graph: Graph, local: UnitPlan | undefined): void {
        if (!plan.functionObjects.cells.size) return
        const positions = new Map<number, number[]>()
        const objects = new Map<number, intrinsics.Handle>()
        for (const [id, n] of nodeEntries(graph)) {
            const slots: number[] = []
            if (n.op === NodeOp.apply) {
                const params = getBlock(graph, getRef(n, 0))?.params ?? []
                for (let i = 0; i < params.length; i++) if (wantsObject(local?.nodes.get(params[i]))) slots.push(i + 1)
            } else if (n.op === NodeOp.select) {
                if (wantsObject(local?.nodes.get(id))) for (let i = 1; i < countIds(n); i++) slots.push(i)
            } else if (n.op === NodeOp.ret) {
                if (wantsObject(local?.unit.returns)) slots.push(0)
            } else if (n.op === NodeOp.call) {
                const callees = [...local?.calls.get(id) ?? []]
                for (let i = 3; i < countIds(n); i++) if (callees.some(unit => wantsObject(unit.params[i - 3]?.rep))) slots.push(i)
            } else if (n.op === NodeOp.setProp && !getRef(n, 2)) {
                if (fieldWantsObject(local, getRef(n, 1), getLiteral(graph, n, 2) as intrinsics.Handle)) slots.push(3)
            } else if (n.op === NodeOp.rt && !getRef(n, 1) && rt.targetWriteOps.has(getLiteral(graph, n, 1))) {
                if (wantsObject(local?.unit.slices.get(id))) slots.push(4)
            }
            if (!slots.length) continue
            positions.set(id, slots)
            for (const i of slots) {
                const cell = codeCell(graph, getOperand(graph, n, i))
                const object = cell === undefined || objects.has(cell) ? undefined : functionObjectOf(cell)
                if (object !== undefined) objects.set(cell!, object)
            }
        }
        functionObjectValues(graph, positions, objects)
    }
    function embeddedSites(unit: PlannedUnit | undefined, graph: Graph): Map<number, { parent: number, key: intrinsics.Handle }> {
        const embedded = new Map<number, { parent: number, key: intrinsics.Handle }>()
        const self = thisParamOf(graph)
        if (self !== undefined) for (const [node, key] of (unit && plan.embedded.sites.get(unit)) ?? []) embedded.set(node, { parent: self, key })
        return embedded
    }
    function unionParamBases(fn: Function): Map<number, propertyEval.UnionParam> {
        const out = new Map<number, propertyEval.UnionParam>()
        for (const { index, rep } of plannedParams(fn)) {
            const other = recordObject(rep)
            if (!unionWord(rep) && !other) continue
            const value = other ?? rep
            const shape = plannedShape(plan, objectRep(value))
            const members = plannedMembers(plan, objectRep(value)) ?? (shape !== undefined ? [shape] : undefined)
            if (members) out.set(index, { base: unionWord(value) ? pstack0Base() : undefined, members, primitives: primitiveShapes(value), field: other ? 1 : undefined })
        }
        return out
    }
    function verifyTraced(traced: Traced, stage: string): void {
        verifyGraph(traced.graph, stage, false)
        verifyAllocationTokens(traced.graph, stage, traced.allocations)
        verifyKeys(traced.graph, stage)
    }
    function callEdges(resolved: Resolution, params: Map<number, Map<number, Arrival>>): Map<number, CallEdge> {
        const edges = new Map<number, CallEdge>()
        for (const [call, arrivals] of params) {
            const callee = planned.functions.get(resolved.callees.get(call)!)!
            edges.set(call, { raw: abiOf(callee).mode === 'raw', params: new Map([...arrivals].map(([index, { rep, shaped }]) => [index, { word: unionWord(rep), pointer: shaped && pointerOfShapes(rep) }])) })
        }
        return edges
    }
    function unionWords(resolved: Resolution, edges: Map<number, CallEdge>): Set<number> {
        const words = new Set<number>()
        for (const [id, rep] of resolved.local?.nodes ?? []) if (unionWord(rep) && !edges.get(id)?.raw) words.add(id)
        return words
    }
    function stringRep(resolved: Resolution): (x: number) => string {
        const graph = resolved.graph
        const params = graph.blocks[0].params
        return x => {
            const value = tailOf(graph, x)
            const index = params.indexOf(value)
            const rep = resolved.local?.nodes.get(x) ?? resolved.local?.nodes.get(value) ?? (index >= 0 ? resolved.local?.unit.params[index]?.rep : undefined)
            if (!rep || unionWord(rep)) return ''
            return rep.kind === 'any' || rep.targets.includes('str') ? `%${value} is ${rep.text}` : ''
        }
    }
    function returnedForm(fn: Function, resolved: Resolution): 'word' | 'raw' | undefined {
        const mode = abiOf(fn).mode
        if (mode === 'raw') return 'raw'
        if (mode === 'encoded' && isStringRep(resolved.local?.unit.returns)) return 'raw'
        if (mode === 'encoded') return 'word'
        if (mode === 'keep' && !!resolved.local && unionWord(resolved.local.unit.returns)) return 'word'
        return undefined
    }
    function verifyResolved(fn: Function, resolved: Resolution, edges: Map<number, CallEdge>, stage: string, realized: boolean, bits = new Set<number>()): void {
        const unions = unionWords(resolved, edges)
        const words = new Set([...resolved.encoded, ...unions])
        verifyGraph(resolved.graph, stage, false)
        verifyCodecs(resolved.graph, stage, words, edges)
        if (!realized) return
        verifyArrivals(resolved.graph, stage, words, edges)
        verifyNumericUses(resolved.graph, stage, unions, UnboxingOps, resolved.local?.unit.returns.kind === 'number' ? ownRets(resolved.graph) : [], bits)
        verifyReturns(resolved.graph, stage, words, edges, ownRets(resolved.graph), returnedForm(fn, resolved))
        verifyStringOperands(resolved.graph, stage, stringRep(resolved))
        verifyStringCompares(resolved.graph, stage, unions, x => isStringRep(resolved.local?.nodes.get(x)))
    }
    function paramTypes(fn: Function, graph: Graph): Map<number, intrinsics.Types> {
        const unions = new Set(unionParams(fn))
        const out = new Map<number, intrinsics.Types>()
        for (const { index, label, rep } of plannedParams(fn)) {
            if (label === 'this' && rep.kind !== 'number') continue
            const param = graph.blocks[0].params[index]
            const integral = numberName(rep) === 'int' && typeOf(getNode(graph, param)!) === Types.f64
            const shape = plannedShape(plan, rep)
            const reduced = shape !== undefined && heldAsField(facts, [shape]) ? intType(locate(facts, shape, '0')) : undefined
            const T = numberName(rep) === 'i64' ? Types.i64 : unions.has(index) ? Types.vm_value : numberName(rep) === 'f64' ? Types.f64 : integral ? Types.u64 : reduced
            if (T !== undefined) out.set(param, T)
        }
        return out
    }
    function pointerTypes(resolved: Resolution): Map<number, intrinsics.Types> {
        const out = new Map<number, intrinsics.Types>()
        const local = resolved.local
        if (!local) return out
        const graph = resolved.graph
        const root = graph.blocks[0]
        const add = (id: number) => {
            const n = getNode(graph, id)
            if (n && (n.op === NodeOp.load || n.op === NodeOp.param) && !typeRefOf(n) && typeOf(n) === Types.u64) out.set(id, Types.ptr)
        }
        for (let i = 0; i < local.unit.params.length && i < root.params.length; i++) {
            if (dereferenceableRep(local.unit.params[i].rep)) add(root.params[i])
        }
        for (const [id, rep] of local.nodes) if (dereferenceableRep(rep)) add(id)
        return out
    }
    function codecRequest(fn: Function, resolved: Resolution, params: Map<number, Map<number, Arrival>>): CodecRequest {
        const { graph, local } = resolved
        const values = local?.nodes ?? new Map<number, Rep>()
        const slices = local?.slices ?? new Map<number, Rep>()
        const pointers = new Set(resolved.shapes.keys())
        for (const [id, rep] of values) {
            if (!pointerOfShapes(rep) || heldAsField(facts, rep.targets.map(target => plan.shapes.get(target)!))) continue
            const op = getNode(graph, id)?.op
            if (op === NodeOp.load && rawSlice(slices, id)) pointers.add(id)
            else if (op === NodeOp.param) pointers.add(id)
        }
        const calls = new Map<number, CallCodec>()
        function callOf(id: number): CallCodec {
            let known = calls.get(id)
            if (!known) calls.set(id, known = {})
            return known
        }
        for (const [call, arrivals] of params) callOf(call).params = arrivals
        for (const [call, unit] of resolved.callees) {
            if (abiOf(planned.functions.get(unit)!).mode === 'raw') callOf(call).raw = true
        }
        const reached = new Map<number, Set<PlannedUnit>>(local?.calls ?? [])
        for (const [call, unit] of resolved.callees) {
            if (!reached.has(call)) {
                reached.set(call, new Set([unit]))
            }
        }
        for (const [call, callees] of reached) {
            if (!callees.size || getNode(graph, call)?.op !== NodeOp.call) continue
            const units = [...callees]
            const abis = units.map(callee => abiOf(planned.functions.get(callee)!))
            const modes = new Set(abis.map(abi => abi.mode))
            if (modes.has('narrow')) {
                intrinsics.assert(modes.size === 1, `native: ${fn.name} %${call} reaches narrow and other return modes`)
                callOf(call).returned = { mode: 'narrow', type: abis[0].returns, float: false }
            } else if (modes.has('tagged')) {
                intrinsics.assert(modes.size === 1, `native: ${fn.name} %${call} reaches tagged and other return modes`)
                callOf(call).returned = { mode: 'tagged', type: abis[0].returns, float: numberName(units[0].returns) === 'f64' }
            } else if (modes.has('record')) {
                if (modes.size !== 1) throw compileError(`native: ${fn.name} %${call} reaches a float union return and other return modes`, call)
                callOf(call).returned = { mode: 'record', type: Types.u64, float: true, rep: units[0].returns }
            }
            const floats = units.length === 1 ? floatParams(units[0]) : []
            if (units.length > 1 && units.some(unit => floatParams(unit).length)) throw compileError(`native: ${fn.name} %${call} passes float unions to several units`, call)
            const arity = units.length === 1 ? graphsOf(planned.functions.get(units[0])!).traced!.graph.blocks[0].params.length : 0
            if (floats.length) callOf(call).floats = { indexes: floats, arity }
            if (units.length === 1 && abis[0].tags.length) callOf(call).tags = { indexes: abis[0].tags, arity: arity + 2 * floats.length }
        }
        return {
            reps: values, params: local?.unit.params.map(param => param.rep) ?? [], returns: local?.unit.returns, abi: abiOf(fn), tagged: local?.tagged ?? new Set(),
            slices, pointers, encoded: resolved.encoded, calls, functionObject: functionObjectOf,
            tracked: local ? trackedTags(reps.tags, local.unit) : new Map(), fieldTags: resolved.fieldTags, tagWrites: resolved.tagWrites, wordWrites: resolved.wordWrites, floatRecords: new Map(), wordBits: new Set(),
        }
    }
    function floatParams(unit: PlannedUnit): number[] {
        const out: number[] = []
        unit.params.forEach((param, i) => {
            if (floatUnion(param.rep)) out.push(i)
        })
        return out
    }
    function realizeUnit(fn: Function): Graph {
        return clock.timed('resolve', () => {
            const lineageBefore = typeRecording() && debugsTypes(fn.name) ? lineageSnapshot(graphsOf(fn).traced!.graph) : undefined
            const resolved = resolveUnit(fn)
            const params = calleeParams(resolved)
            const edges = callEdges(resolved, params)
            verifyResolved(fn, resolved, edges, 'resolve', false)
            const request = codecRequest(fn, resolved, params)
            realizeFloats(resolved.graph, request)
            realizeWords(resolved.graph, request)
            if (resolved.local) {
                const traced = graphsOf(fn).traced!.graph
                const root = resolved.graph.blocks[0]
                const extras = 2 * floatParams(resolved.local.unit).length
                if (request.abi.tags.length) intrinsics.assert(root.params.length === traced.blocks[0].params.length + extras, `native: ${fn.name} resolved with ${root.params.length} params, traced with ${traced.blocks[0].params.length}`)
                realizeTags(resolved.graph, request)
            }
            inlineBoolLiterals(resolved.graph)
            if (lineageBefore) noteArrivals(fn, resolved, params)
            verifyResolved(fn, resolved, edges, 'realizeCodecs', true, request.wordBits)
            retypeValues(resolved.graph, pointerTypes(resolved))
            if (lineageBefore) traceLineage(resolved.graph, lineageBefore)
            for (const [id, n] of nodeEntries(resolved.graph)) {
                const removal = rt.isDelete(resolved.graph, n)
                if (n.op !== NodeOp.getProp && n.op !== NodeOp.setProp && !removal) continue
                throw removal ? compileError(`native: ${fn.name} deletes a property of an opaque value: ${describeValue(resolved.graph, getRef(n, 2), 2)}`, id) : compileError(`native: ${fn.name} reads a property of an opaque value: ${describeValue(resolved.graph, getRef(n, 1), 2)}; ${describeAccess(fn, resolved.graph, id, n)}`, id)
            }
            return resolved.graph
        }, fn.name)
    }
    function noteArrivals(fn: Function, resolved: Resolution, params: Map<number, Map<number, Arrival>>): void {
        const graph = resolved.graph
        for (const [call, arrivals] of params) {
            const n = getNode(graph, call)
            const callee = resolved.callees.get(call)
            if (!n || n.op !== NodeOp.call) continue
            for (const [index, arrival] of arrivals) {
                if (3 + index >= countIds(n)) continue
                const x = getRef(n, 3 + index)
                const m = x ? getNode(graph, x) : undefined
                const own = x ? resolved.local?.nodes.get(x) ?? resolved.local?.nodes.get(tailOf(graph, x)) : undefined
                const text = x ? `%${x} ${opName(m?.op ?? NodeOp.void)}:${m ? typeName(typeSlots(m.op) ? typeOf(m) : resultType(graph, m)) : '?'} (own rep ${own?.text ?? 'none'})` : `#${getLiteral(graph, n, 3 + index)}`
                noteType(call, `realize ${fn.name}: arg ${index} ${text} -> param rep ${arrival.rep.text} of ${callee ? planned.functions.get(callee)?.name ?? callee.fn.name : '?'}`)
                if (x) noteType(x, `realize ${fn.name}: passed as arg ${index} of call %${call}, whose param rep is ${arrival.rep.text}${m?.op === NodeOp.convert ? ' (arrival converted it)' : ''}`)
            }
        }
    }
    function describeValue(graph: Graph, id: number, depth: number): string {
        const n = id ? getNode(graph, id) : undefined
        if (!n) return 'a literal'
        if (n.op === NodeOp.after) {
            const last = countIds(n) - 1
            return getRef(n, last) ? describeValue(graph, getRef(n, last), depth) : `#${getLiteral(graph, n, last)}`
        }
        const head = `${opName(n.op)} %${id}`
        const local = localSymbol(graph, n)
        if (local !== undefined) return `${head} ${functions[local]?.name || `symbol ${local}`}`
        if (n.op === NodeOp.heapHandle && !getRef(n, 0)) {
            const handle = getLiteral(graph, n, 0)
            if (heap.isNullishHandle(handle as intrinsics.Handle)) return handle === heap.nullHandle ? 'null' : 'undefined'
            const stub = session.stubFunctions.get(handle as u32)
            return stub ? `${head} ${stub.name || 'anonymous'}` : `${head} #${handle}`
        }
        if (depth === 0) return head
        if (n.op === NodeOp.call || n.op === NodeOp.getProp || n.op === NodeOp.load) return `${head} of ${describeValue(graph, getRef(n, 1), depth - 1)}`
        return head
    }
    function describeAccess(fn: Function, graph: Graph, id: number, n: GraphNode): string {
        const key = getRef(n, 2) ? `[%${getRef(n, 2)}]` : heap.describeKey(getLiteral(graph, n, 2) as intrinsics.Handle)
        const unit = graphsOf(fn)
        const pc = unit.traced?.accesses?.get(id)
        const at = pc === undefined || !unit.source ? undefined : sourcePosition(unit.source.compiled, pc)
        return `%${id} ${opName(n.op)} ${key}` + (at ? ` at ${at.line + 1}:${at.col + 1}` : '')
    }
    return { abiOf, realizeUnit, paramShapesOf, plannedUnit: (fn: Function) => planned.units.get(fn) }
}

function planShapes(types: ValueTypes, linker: Linker, tracer: Tracer, host: AccessHost, genericOf: (proto: intrinsics.Handle) => Generic | undefined, facts: Facts): ShapePlan {
    const { session } = linker
    const placedStatics = new Set<number>()
    const readonlyConstructions = new Set<intrinsics.Handle>()
    const plannedHandles = new Set<intrinsics.Handle>()
    function fieldKey(name: string): intrinsics.Handle | undefined {
        const index = /^\[(\d+)\]$/.exec(name)
        return index ? heap.indexKey(Number(index[1]) as u32) : types.keyHandles.get(name)
    }
    const fixedStatic = (state: intrinsics.Handle, key: intrinsics.Handle) => fixedField(types, state, key)
    for (const record of tracer.companions.keys()) {
        if (!fixedState(types, record)) throw `native: @${record} is read with a computed key through its companion array, but compiled code writes it`
    }
    const constructed = new Set([...session.sealed].map(cell => heap.indirectTarget(cell)))
    for (const state of constructed) if (fixedState(types, state)) readonlyConstructions.add(state)
    const owned = new Set(constructed)
    for (const unit of tracer.units) for (const cell of unit.traced!.allocations?.keys() ?? []) owned.add(heap.deref(cell as intrinsics.Handle))
    function folds(site: Site): boolean {
        const traced = tracer.graphsOf(site.unit).traced!
        const n = getNode(traced.graph, site.node)
        return !!n && tracer.fixedSlot(traced, n, fixedStatic) !== undefined
    }
    for (const [state, ids] of types.stateAllocations) {
        if (owned.has(state) || ids.some(id => types.objects[id].native) || !heap.isOrdinaryObject(state) || heap.isArray(state) || heap.isCallable(state)) continue
        if (!fixedState(types, state) || ids.some(id => types.objects[id].readers.some(site => !folds(site)))) placedStatics.add(state)
    }
    const { inst, plan, tagged } = planUnits(types, genericOf, state => placedStatics.has(state) || constructed.has(state), fn => host.graphOf(fn), fn => linker.constructsOutOfLine(fn) || !!linker.unitOf(linker.originOf(fn)).stubbed || linker.isRoot(fn))
    const taggedConstructions = new Map<intrinsics.Handle, Set<string>>()
    const floatWords = (element: Rep) => !!element.encoded && element.kind === 'number' && numberName(element) === 'f64'
    for (const object of types.objects) {
        if (object.state === undefined || !constructed.has(object.state)) continue
        for (const field of object.fields.values()) {
            for (const id of field.type.objects) {
                const keys = types.objects[id].kind !== AllocKind.buffer ? undefined : tagged.get(id) ?? (floatWords(inst.elementOf([id])) ? [numberKey] : undefined)
                if (!keys) continue
                const known = taggedConstructions.get(object.state)
                if (known) for (const key of keys) known.add(key)
                else taggedConstructions.set(object.state, new Set(keys))
            }
        }
    }
    function taggableClosure(m: number): boolean {
        const object = types.objects[m]
        return object.kind === AllocKind.object && object.state !== undefined && object.function === undefined && !!heap.getOwnProperty(object.state, heap.closureCallKey) && !heap.isFrameProxy(object.state)
    }
    const shapeTags = planShapeTags(inst, plan, fn => host.graphOf(fn), fieldKey, sig => sig.members.every(m => !types.objects[m].native || taggableClosure(m)))
    if (flags.has('plan')) for (const [id, tag] of shapeTags) console.log('SHAPE-TAG', id, tag)
    const handles = new Map<string, intrinsics.Handle>()
    const fixedFields = new Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>()
    const erasedFields = new Map<intrinsics.Handle, Set<intrinsics.Handle>>()
    const closureViews = new Map<intrinsics.Handle, intrinsics.Handle[]>()
    const closureCodes = new Map<intrinsics.Handle, intrinsics.Handle>()
    const absentKeys = new Map<intrinsics.Handle, Map<intrinsics.Handle, boolean>>()
    for (const [id, sig] of inst.shapes) {
        const shape = heap.makeObject((sig.proto ?? 0) as intrinsics.Handle)
        const tag = shapeTags.get(id)
        if (tag !== undefined) heap.setReadonlyProperty(shape, heap.shapeTagKey, heap.boxF64(tag) as intrinsics.Handle)
        const absent = new Map<intrinsics.Handle, boolean>()
        for (const k of sig.absent) {
            const key = fieldKey(k)
            if (key !== undefined) absent.set(key, sig.nullish.has(k))
        }
        absentKeys.set(shape, absent)
        const codes = new Set<intrinsics.Handle>()
        for (const m of sig.members) {
            if (!taggableClosure(m)) continue
            const state = types.objects[m].state!
            codes.add(heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(state, heap.closureCallKey))).slot0 as intrinsics.Handle)
            const views = closureViews.get(state)
            if (!views) closureViews.set(state, [shape])
            else if (!views.includes(shape)) views.push(shape)
        }
        if (codes.size === 1 && sig.members.every(taggableClosure)) closureCodes.set(shape, [...codes][0])
        for (const [k] of sig.fields) {
            const key = fieldKey(k)
            if (key === undefined) throw `native: planned shape ${id} has no key for ${k}`
            const readonly = sig.members.every(m => {
                const state = types.objects[m].state
                const addr = state !== undefined ? heap.getOwnProperty(state, key) : 0
                return !!addr && !(heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).flags & heap.PropFlags.writable)
            }) || (sig.fields.length === 1 && numberName(sig.fields[0][1]) !== 'f64' && sig.fields[0][1].kind === 'number' && !sig.fields[0][1].nullable && !inst.addressed.has(id) && sig.members.every(m => types.objects[m].fields.get(k)?.initialized))
            if (readonly) heap.setReadonlyProperty(shape, key, heap.boxF64(0) as intrinsics.Handle)
            else heap.setProperty(shape, key, heap.boxF64(0) as intrinsics.Handle)
        }
        const erased = new Set<intrinsics.Handle>()
        for (const member of sig.members) for (const k of types.erasedFields.get(member) ?? []) {
            if (sig.fields.some(([name]) => name === k)) continue
            const key = fieldKey(k)
            if (key !== undefined) erased.add(key)
        }
        if (erased.size) erasedFields.set(shape, erased)
        handles.set(id, shape)
        plannedHandles.add(shape)
    }
    function fact(rep: Rep, encoded: boolean): Codec | undefined {
        return repFact(handles, rep, encoded)
    }
    const embeddings = planEmbeddings(types, inst, plan)
    const embedded = new Map<intrinsics.Handle, Map<intrinsics.Handle, intrinsics.Handle>>()
    for (const [P, byKey] of embeddings.fields) embedded.set(handles.get(P)!, new Map([...byKey].map(([k, I]) => [types.keyHandles.get(k)!, handles.get(I)!])))
    const bits = new Map<intrinsics.Handle, propertyEval.RecordBits>()
    for (const [id, sig] of inst.shapes) {
        const kinds = { flags: new Set<intrinsics.Handle>(), tagged: new Set<intrinsics.Handle>() }
        for (const [k, rep] of sig.fields) {
            if (rep.bit) kinds.flags.add(fieldKey(k)!)
            if (nullableNumber(rep)) kinds.tagged.add(fieldKey(k)!)
        }
        if (!kinds.flags.size && !kinds.tagged.size) continue
        bits.set(handles.get(id)!, kinds)
        for (const m of sig.members) {
            const state = types.objects[m].state
            if (state === undefined || (!placedStatics.has(state) && !constructed.has(state))) continue
            const prior = bits.get(state)
            intrinsics.assert(!prior || prior === kinds, `native: state @${state} belongs to planned shapes with different bit fields`)
            bits.set(state, kinds)
        }
    }
    for (const [id, tag] of shapeTags) {
        for (const m of inst.shapes.get(id)!.members) {
            const state = types.objects[m].state
            if (state === undefined || (!placedStatics.has(state) && !constructed.has(state) && !taggableClosure(m))) continue
            const prior = bits.get(state)
            intrinsics.assert(prior?.shapeTag === undefined || prior.shapeTag === tag, `native: state @${state} belongs to planned shapes with different shape tags`)
            bits.set(state, { flags: prior?.flags ?? new Set(), tagged: prior?.tagged ?? new Set(), shapeTag: tag })
        }
    }
    for (const [id, sig] of inst.shapes) {
        const known = new Map<string, Codec>()
        const fields = propertyEval.recordLayout(handles.get(id)!, embedded, bits)
        sig.fields.forEach(([k, rep]) => {
            const at = fields.keys.indexOf(fieldKey(k)!)
            intrinsics.assert(at >= 0, `native: planned shape ${id} has no field ${k}`)
            const offset = String(fields.offsets[at])
            if (fields.nested[at] !== undefined || fields.flags[at]) return
            if (rep.kind !== 'buffer') {
                const f = fact(rep, false)
                if (f) known.set(offset, f)
                return
            }
            known.set(offset, { kind: 'int', encoded: false })
            const inner = fact(rep.element!, !!rep.element!.encoded)
            if (inner) known.set(`${offset}/*`, inner)
        })
        facts.set(handles.get(id)!, known)
        const constants = new Map<intrinsics.Handle, intrinsics.Handle>()
        for (const [k] of sig.fields) {
            const key = types.keyHandles.get(k)
            if (key === undefined) continue
            let agreed: intrinsics.Handle | undefined
            for (const member of sig.members) {
                const state = types.objects[member].state
                const addr = state !== undefined ? heap.getOwnProperty(state, key) : 0
                const slot = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).slot0 as intrinsics.Handle : undefined
                if (slot === undefined || !heap.isCallable(slot) || (agreed !== undefined && agreed !== slot) || types.objects[member].fields.get(k)?.forms.some(form => form !== 'init')) {
                    agreed = undefined
                    break
                }
                agreed = slot
            }
            if (agreed !== undefined) constants.set(key, agreed)
        }
        if (constants.size) fixedFields.set(handles.get(id)!, constants)
    }
    function factClass(path: string, f: Codec): string {
        const signed = path.endsWith('/*') && f.kind === 'int' && f.type !== undefined && isSignedType(f.type) ? '-' : ''
        const nullish = f.kind === 'undefined' ? 'u' : ''
        if (f.encoded && path.endsWith('/*')) return `e${signed}${nullish}`
        const shape = f.kind !== 'ref' ? '' : f.shape === propertyEval.stringShape ? 's' : plannedHandles.has(f.shape) ? 'S' : `h${f.shape}`
        return `${f.encoded ? 'e' : ''}${shape}${numeric(f) ? 'n' : ''}${signed}${f.kind === 'f64' ? 'f' : ''}${nullish}`
    }
    const layouts = new Map<string, string>()
    const layoutIds = new Map<string, string>()
    function layoutOf(id: string, elements: ElementReads): string {
        const at = `${id}/${elements === 'all' ? '*' : [...elements].sort((a, b) => a - b).join(',')}`
        const known = layouts.get(at)
        if (known !== undefined) return known
        layouts.set(at, at)
        const sig = inst.shapes.get(id)!
        const handle = handles.get(id)!
        const read = new Set<string>()
        const record = propertyEval.recordLayout(handle, embedded, bits)
        for (const [k] of sig.fields) {
            const key = fieldKey(k)
            if (elements === 'all' || (key !== undefined && elements.has(key))) read.add(`${record.offsets[record.keys.indexOf(key!)]}/*`)
        }
        const fields = sig.fields.map(([k]) => {
            const at = record.keys.indexOf(fieldKey(k)!)
            const addr = heap.getOwnProperty(handle, fieldKey(k)!)
            const readonly = !(heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).flags & heap.PropFlags.writable)
            const inner = embeddings.fields.get(id)?.get(k)
            const constant = types.keyHandles.has(k) ? fixedFields.get(handle)?.get(types.keyHandles.get(k)!) : undefined
            const flag = record.flags[at]
            const tag = record.tags[at]
            return `${k}${readonly ? '!' : ''}${inner !== undefined ? `{${layoutOf(inner, elements)}}` : ''}${constant !== undefined ? `=${constant}` : ''}${flag ? `^${flag.offset}.${flag.bit}` : ''}${tag ? `?${tag.offset}.${tag.bit}` : ''}`
        })
        const text = `${sig.proto ?? ''}${shapeTags.get(id) ?? ''}{${fields.join(',')}}${[...facts.get(handle)!].filter(([path]) => read.has(path) || !path.endsWith('/*')).map(([path, f]) => `${path}:${factClass(path, f)}`).join(',')}`
        let layout = layoutIds.get(text)
        if (layout === undefined) layoutIds.set(text, layout = `L${layoutIds.size}`)
        if (flags.has('share-debug')) console.log('SHARE-LAYOUT', id, layout, text)
        layouts.set(at, layout)
        return layout
    }
    function reducedTarget(target: string): boolean {
        return propertyEval.reducedShape(target.startsWith('clo@') ? Number(target.slice('clo@'.length)) as intrinsics.Handle : handles.get(target)!)
    }
    const constants = new Map<intrinsics.Handle, intrinsics.Handle>()
    for (const [state, id] of inst.constantShapes) constants.set(state, handles.get(id)!)
    if (flags.has('plan')) for (const [P, byKey] of embeddings.fields) console.log('EMBED', P, [...byKey].map(([k, I]) => `${k}=${I}`).join(' '))
    if (flags.has('plan')) for (const [unit, byNode] of embeddings.sites) console.log('EMBED-SITE', unit.fn.name, [...byNode].map(([n, k]) => `%${n}.${k}`).join(' '))
    const sites = new Map<PlannedUnit, Map<number, intrinsics.Handle>>()
    for (const [unit, byNode] of embeddings.sites) sites.set(unit, new Map([...byNode].map(([node, k]) => [node, types.keyHandles.get(k)!])))
    const functionObjects = { cells: new Map<number, intrinsics.Handle>(), functions: new Map<Function, intrinsics.Handle>() }
    for (const object of types.objects) {
        if (object.function === undefined || object.handle === undefined) continue
        functionObjects.functions.set(object.function, object.handle)
        functionObjects.cells.set(heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(object.state!, heap.closureCallKey))).slot0, object.handle)
        placedStatics.add(object.state!)
    }
    return { units: plan, inst, shapes: handles, fixedFields, erasedFields, constants, embedded: { fields: embedded, sites }, bits, layoutOf, reducedTarget, fixedStatic, statics: { placed: placedStatics, readonly: readonlyConstructions, tagged: taggedConstructions }, functionObjects, closureViews, closureCodes, absentKeys }
}

function localizeCalls(graph: Graph, image: ProgramImage, units: Map<number, Graph>): void {
    function valueOf(id: number): GraphNode | undefined {
        let n = getNode(graph, id)
        while (n?.op === NodeOp.after) n = getNode(graph, getRef(n, countIds(n) - 1))
        return n
    }
    const signed = new Map<string, number>()
    for (const [id, n] of [...nodeEntries(graph)]) {
        if (n.op !== NodeOp.call) continue
        let target = valueOf(getRef(n, 1))
        const direct = target?.op === NodeOp.localTarget ? target : undefined
        const signature = target?.op === NodeOp.indirectTarget || direct ? typeRefOf(target!) : 0
        if (direct && (!signature || getNode(graph, signature)?.op !== NodeOp.fnType || !fnLocations(getNode(graph, signature)!).some(at => at >= 0))) continue
        if (target?.op === NodeOp.indirectTarget) target = valueOf(getRef(target, 0))
        if (!direct && (target?.op !== NodeOp.heapHandle || getRef(target, 0))) continue
        const slot = direct ? undefined : image.functionHandles.get(heap.deref(getLiteral(graph, target!, 0) as intrinsics.Handle))
        const symbol = direct ? getLiteral(graph, direct, 0) : slot === undefined ? undefined : image.functionTargets.get(slot)
        if (symbol === undefined || (direct && !units.has(symbol))) continue
        if (!signature) {
            const local = newId(graph)
            putNode(graph, local, NodeOp.localTarget, [{ literal: symbol }], recordTypeAt(graph, id) ? { ref: typeRefOf(target!) } : resultType(graph, n))
            putCopy(graph, id, n, withOperand(graph, n, 1, local))
            continue
        }
        const callee = units.get(symbol)!
        const locations = callee.blocks[0].params.map(p => paramLocation(getNode(callee, p)!))
        const passed = fnLocations(getNode(graph, signature)!)
        const positional: Operand[] = []
        const located = new Map<number, Operand>()
        for (let i = 3; i < countIds(n); i++) {
            if ((passed[i - 3] ?? -1) < 0) positional.push(getOperand(callee, n, i))
            else located.set(passed[i - 3], getOperand(callee, n, i))
        }
        let next = 0
        const args = locations.map(at => at >= 0 ? located.get(at) ?? { literal: 0 }
            : next < positional.length ? positional[next++] : { literal: 0 })
        const returns = fnReturn(getNode(graph, signature)!)
        const key = `${symbol}:${JSON.stringify(returns)}:${locations}`
        let shared = signed.get(key)
        if (shared === undefined) {
            const fnType = insertNode(graph, createFnType(callee, returns, locations))
            shared = addNode(graph, NodeOp.localTarget, [{ literal: symbol }], { ref: fnType })
            signed.set(key, shared)
        }
        putCopy(graph, id, n, [getOperand(callee, n, 0), shared, getOperand(callee, n, 2), ...args])
    }
}

function trapStub(space: NodeSpace, name: string, paramCount: number, receiver: boolean): Graph {
    const root = newId(space)
    const graph = createGraph({ ids: space.ids, literals: space.literals, root, name })
    putNode(graph, root, NodeOp.block, [])
    const params: number[] = []
    for (let i = 0; i < paramCount; i++) params.push(addNode(graph, NodeOp.param, [], Types.u64))
    if (receiver) params.push(insertNode(graph, createThisParam(graph)))
    const end = addNode(graph, NodeOp.trap, [addNode(graph, NodeOp.nilEffect, []), { literal: 0xdead }])
    setGraphBlocks(graph, [{ id: root, params, bodyId: end, bodyConst: 0 }])
    return graph
}

function createAccessHost(linker: Linker, tracer: Tracer): { host: AccessHost, genericOf: (proto: intrinsics.Handle) => Generic | undefined } {
    const { session, functions, unitOf, originOf, codeOf, closureBody } = linker
    const host: AccessHost = {
        session,
        graphOf: fn => tracer.graphsOf(fn).traced!.graph,
        functionOf: handle => {
            const stub = session.stubFunctions.get(handle) as any
            if (stub) return isLocalStub(stub) ? functions[stub.__localTarget] : stub
            return session.templateOf(handle) ? closureBody(handle, 'closure') : undefined
        },
        localFunction: symbol => functions[symbol],
        isConstructor: traceModule.isConstructor,
        traceable: fn => !!codeOf(fn),
        constantElements: state => tracer.engineElements.get(state),
        heapValue: tracer.heapValue,
        receiverless: fn => Array.isArray((fn as any).__args),
        paramCount: fn => codeOf(fn)?.source.compiled.paramCount,
        bindTarget: (fn, count, spread) => linker.boundTarget(fn, count, spread),
        freshCells: fn => {
            const traced = tracer.graphsOf(fn).traced!
            const definite: [number, Handle[]][] = []
            for (const [cell, allocation] of traced.allocations ?? []) if (allocation.keys) definite.push([cell, allocation.keys])
            return { allocations: [...traced.allocations?.keys() ?? []], closures: [...traced.closures ?? []], frames: [...traced.frames.keys()], definite }
        },
    }
    function genericOf(proto: intrinsics.Handle): Generic | undefined {
        const ctor = heap.getOwnProperty(proto, heap.fromJsString('constructor'))
        const fn = ctor ? host.functionOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(ctor)).slot0 as u32) : undefined
        if (!fn || !host.traceable(fn)) return
        if (genericCache.has(fn)) return genericCache.get(fn) ?? undefined
        genericCache.set(fn, null)
        const generic = analyzeGenerics(fn.name, proto, fn, host)
        genericCache.set(fn, generic)
        return generic
    }
    return { host, genericOf }
}

type Resolver = ReturnType<typeof createResolver>

// graph cuts are used for obnoxiously large fns
const cutLimit = Number(intrinsics.argv().find(a => a.startsWith('cut:'))?.slice(4) ?? 5_000)
const cutWidth = 32

interface CutRegion {
    entry: number
    blocks: Set<number>
    inlined: Set<number>
    size: number
    total: number
}

function cutRegion(graph: Graph): CutRegion | undefined {
    const targets = (body: number, out: number[]) => {
        for (const p of tailPositions(graph, body)) {
            const n = getNode(graph, p.at)
            if (n?.op === NodeOp.apply && getBlock(graph, getRef(n, 0))) out.push(getRef(n, 0))
        }
    }
    const succ = new Map<number, number[]>()
    const ownOf = new Map<number, number>()
    const inlinedBlocks = new Set<number>()
    const seen = new Set<number>()
    const scan = [graph.root]
    while (scan.length) {
        const id = scan.pop()!
        if (succ.has(id)) continue
        const b = getBlock(graph, id)!
        const out: number[] = []
        targets(b.bodyId, out)
        let own = 0
        const walk = [b.bodyId, ...b.params]
        while (walk.length) {
            const x = walk.pop()!
            if (!x || seen.has(x)) continue
            seen.add(x)
            const n = getNode(graph, x)
            if (!n || n.op === NodeOp.block) continue
            own++
            if (n.op === NodeOp.inlined) {
                const from = out.length
                targets(getRef(n, 0), out)
                for (let k = from; k < out.length; k++) inlinedBlocks.add(out[k])
            }
            for (let k = 0; k < countIds(n); k++) walk.push(getRef(n, k))
            if (typeRefOf(n)) walk.push(typeRefOf(n))
        }
        if (inlinedBlocks.has(id)) for (const t of out) inlinedBlocks.add(t)
        succ.set(id, out)
        ownOf.set(id, own)
        for (let k = out.length - 1; k >= 0; k--) scan.push(out[k])
    }
    const order: number[] = []
    const index = new Map<number, number>()
    const visited = new Set<number>([graph.root])
    const stack: [block: number, next: number][] = [[graph.root, 0]]
    while (stack.length) {
        const top = stack[stack.length - 1]
        const out = succ.get(top[0])!
        if (top[1] < out.length) {
            const s = out[top[1]++]
            if (visited.has(s)) continue
            visited.add(s)
            stack.push([s, 0])
            continue
        }
        stack.pop()
        order.push(top[0])
    }
    order.reverse()
    order.forEach((b, i) => index.set(b, i))
    const preds: number[][] = order.map(() => [])
    for (const b of order) for (const s of succ.get(b)!) preds[index.get(s)!].push(index.get(b)!)
    const idom: number[] = [0]
    for (let i = 1; i < order.length; i++) {
        let d = -1
        for (const p of preds[i]) {
            if (p >= i) continue
            if (d < 0) {
                d = p
                continue
            }
            let a = d
            let b = p
            while (a !== b) {
                while (a > b) a = idom[a]
                while (b > a) b = idom[b]
            }
            d = a
        }
        idom.push(d)
    }
    const own: number[] = order.map(b => ownOf.get(b)!)
    let total = 0
    for (const n of own) total += n
    const children: number[][] = order.map(() => [])
    for (let i = 1; i < order.length; i++) children[idom[i]].push(i)
    const pre: number[] = order.map(() => 0)
    const last: number[] = order.map(() => 0)
    const preorder: number[] = [0]
    const visit: [node: number, next: number][] = [[0, 0]]
    while (visit.length) {
        const top = visit[visit.length - 1]
        if (top[1] < children[top[0]].length) {
            const c = children[top[0]][top[1]++]
            pre[c] = preorder.length
            preorder.push(c)
            visit.push([c, 0])
            continue
        }
        visit.pop()
        last[top[0]] = preorder.length - 1
    }
    const size: number[] = own.slice()
    const lo: number[] = order.map(() => Infinity)
    const hi: number[] = order.map(() => -Infinity)
    for (let i = 0; i < order.length; i++) {
        for (const s of succ.get(order[i])!) {
            lo[i] = Math.min(lo[i], pre[index.get(s)!])
            hi[i] = Math.max(hi[i], pre[index.get(s)!])
        }
    }
    let best = -1
    for (let k = preorder.length - 1; k > 0; k--) {
        const i = preorder[k]
        const parent = idom[i]
        size[parent] += size[i]
        lo[parent] = Math.min(lo[parent], lo[i])
        hi[parent] = Math.max(hi[parent], hi[i])
        if (lo[i] < k || hi[i] > last[i]) continue
        if (best < 0 || Math.abs(total / 2 - size[i]) < Math.abs(total / 2 - size[best])) best = i
    }
    if (best < 0 || Math.min(size[best], total - size[best]) * 4 < total) return
    const blocks = new Set<number>()
    for (let k = pre[best]; k <= last[best]; k++) blocks.add(order[preorder[k]])
    const entry = order[best]
    for (const b of blocks) {
        if (b === entry) continue
        for (const p of preds[index.get(b)!]) if (!blocks.has(order[p])) return
    }
    const inlined = new Set<number>()
    for (const b of blocks) if (inlinedBlocks.has(b)) inlined.add(b)
    return { entry, blocks, inlined, size: size[best], total }
}

interface CutPlan {
    copied: Set<number>
    liveIns: number[]
    frontier: Set<number>
    why?: string
}

function cutPlan(graph: Graph, region: CutRegion): CutPlan {
    const hot = new Set<number>()
    const reach: number[] = []
    for (const b of graph.blocks) if (!region.blocks.has(b.id)) reach.push(b.bodyId, ...b.params)
    while (reach.length) {
        const id = reach.pop()!
        if (!id || hot.has(id)) continue
        hot.add(id)
        const n = getNode(graph, id)
        if (!n) continue
        for (let i = n.op === NodeOp.apply ? 1 : 0; i < countIds(n); i++) reach.push(getRef(n, i))
        if (typeRefOf(n)) reach.push(typeRefOf(n))
    }
    const constant = new Map<number, boolean>()
    const constantOf = (root: number): boolean => {
        const stack = [root]
        while (stack.length) {
            const id = stack[stack.length - 1]
            if (constant.has(id)) {
                stack.pop()
                continue
            }
            const n = getNode(graph, id)
            if (!n || n.op === NodeOp.param || n.op === NodeOp.nilEffect || n.op === NodeOp.callContext || n.op === NodeOp.block || OrderedValues.has(n.op)) {
                constant.set(id, false)
                stack.pop()
                continue
            }
            let pending = false
            let all = true
            const refs: number[] = []
            for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) refs.push(getRef(n, i))
            if (typeRefOf(n)) refs.push(typeRefOf(n))
            for (const r of refs) {
                const known = constant.get(r)
                if (known === undefined) {
                    stack.push(r)
                    pending = true
                } else if (!known) all = false
            }
            if (pending) continue
            constant.set(id, all)
            stack.pop()
        }
        return constant.get(root)!
    }
    const recomputable = (id: number): boolean => {
        const n = getNode(graph, id)!
        if (!NumericOps.has(n.op)) return false
        let inputs = 0
        for (let i = 0; i < countIds(n); i++) if (getRef(n, i) && !constantOf(getRef(n, i))) inputs++
        return inputs <= 1
    }
    const copied = new Set<number>()
    const liveIns = new Set<number>()
    const frontier = new Set<number>()
    const walk: number[] = []
    for (const b of graph.blocks) if (region.blocks.has(b.id)) walk.push(b.bodyId, ...b.params)
    let why: string | undefined
    while (walk.length) {
        const id = walk.pop()!
        if (copied.has(id)) continue
        copied.add(id)
        const n = getNode(graph, id)
        if (!n) continue
        if (n.op === NodeOp.heapHandle && !getRef(n, 0) && heapInterior(graph, n)) why ??= 'snapshot'
        const ordering = firstNonOrderingSlot(n)
        const refs: [ref: number, token: boolean][] = []
        for (let i = n.op === NodeOp.apply ? 1 : 0; i < countIds(n); i++) refs.push([getRef(n, i), i < ordering])
        if (typeRefOf(n)) refs.push([typeRefOf(n), false])
        for (const [r, token] of refs) {
            if (!r || copied.has(r)) continue
            if (getNode(graph, r)?.op === NodeOp.callContext) liveIns.add(r)
            else if (!hot.has(r) || constantOf(r) || recomputable(r)) walk.push(r)
            else if (token) frontier.add(r)
            else liveIns.add(r)
        }
    }
    for (const id of liveIns) {
        const n = getNode(graph, id)!
        if (n.op === NodeOp.alloca || n.op === NodeOp.frameAddress) why ??= opName(n.op)
        if (typeRefOf(n) || resultType(graph, n) === Types.unknown) why ??= `typed ${opName(n.op)}`
    }
    for (const p of getBlock(graph, region.entry)!.params) if (typeRefOf(getNode(graph, p)!)) why ??= 'record param'
    return { copied, liveIns: [...liveIns], frontier, why }
}

function cutReturnType(graph: Graph, region: CutRegion): TypeOperand | string {
    let T: intrinsics.Types | undefined
    for (const b of region.blocks) {
        if (region.inlined.has(b)) continue
        for (const p of tailPositions(graph, getBlock(graph, b)!.bodyId)) {
            const n = getNode(graph, p.at)
            if (n?.op !== NodeOp.ret || !getRef(n, 0)) continue
            const value = getNode(graph, getRef(n, 0))!
            if (value.op === NodeOp.record || typeRefOf(value)) return 'record return'
            if (value.op === NodeOp.literal) continue
            const U = resultType(graph, value)
            if (T !== undefined && T !== U) return `returns ${typeName(T)} and ${typeName(U)}`
            T = U
        }
    }
    return T ?? Types.u64
}

function outlineRegion(graph: Graph, region: CutRegion, plan: CutPlan, returns: TypeOperand, symbol: number, name: string): Graph {
    const nodes = new Map<number, GraphNode>()
    const rootId = newId(graph)
    nodes.set(rootId, makeNode(graph, NodeOp.block, []))
    const entryToken = newId(graph)
    nodes.set(entryToken, makeNode(graph, NodeOp.nilEffect, []))
    for (const id of plan.copied) {
        const n = getNode(graph, id)
        if (!n) continue
        const copy = copyNode(graph, n)
        for (let i = 0; i < firstNonOrderingSlot(n); i++) if (plan.frontier.has(getRef(n, i))) setRef(copy, i, entryToken)
        nodes.set(id, copy)
    }
    for (const b of graph.blocks) if (region.blocks.has(b.id)) nodes.set(b.id, copyNode(graph, getNode(graph, b.id)!))
    const entry = getBlock(graph, region.entry)!
    const params: number[] = []
    const passed: Operand[] = [region.entry]
    for (const p of entry.params) {
        const q = newId(graph)
        nodes.set(q, makeNode(graph, NodeOp.param, [], typeOf(getNode(graph, p)!)))
        params.push(q)
        passed.push(q)
    }
    for (const id of plan.liveIns) {
        nodes.set(id, makeNode(graph, NodeOp.param, [], resultType(graph, getNode(graph, id)!)))
        params.push(id)
    }
    const body = newId(graph)
    nodes.set(body, makeNode(graph, NodeOp.apply, passed))
    const blocks: GraphBlock[] = [{ id: rootId, params, bodyId: body, bodyConst: 0 }]
    for (const b of graph.blocks) if (region.blocks.has(b.id)) blocks.push({ ...b, params: b.params.slice() })
    const callee = createGraph({ ids: graph.ids, literals: graph.literals, root: rootId, nodes, blocks, name, facts: graph.facts && new Map(graph.facts) })
    const target = addNode(graph, NodeOp.localTarget, [{ literal: symbol }], returns)
    for (const b of graph.blocks) {
        if (region.blocks.has(b.id)) continue
        b.bodyId = mapTailPositions(graph, b.bodyId, p => {
            const n = getNode(graph, p.at)!
            if (n.op !== NodeOp.apply || getRef(n, 0) !== region.entry) return p.at
            const tokens = [...p.tokens, ...plan.frontier]
            const token = tokens.length === 1 ? tokens[0] : tokens.length ? addNode(graph, NodeOp.after, tokens) : addNode(graph, NodeOp.nilEffect, [b.id])
            const args = getOperands(graph, n).slice(1)
            const call = addNode(graph, NodeOp.call, [token, target, { literal: 0 }, ...args, ...plan.liveIns], returns)
            return addNode(graph, NodeOp.ret, [call, b.id])
        })
    }
    setGraphBlocks(graph, graph.blocks.filter(b => !region.blocks.has(b.id)))
    const kept = new Set<number>()
    const walk: number[] = []
    for (const b of graph.blocks) walk.push(b.id, b.bodyId, ...b.params)
    while (walk.length) {
        const id = walk.pop()!
        if (!id || kept.has(id)) continue
        kept.add(id)
        const n = getNode(graph, id)
        if (!n) continue
        for (let i = 0; i < countIds(n); i++) walk.push(getRef(n, i))
        if (typeRefOf(n)) walk.push(typeRefOf(n))
    }
    for (const id of plan.copied) if (!kept.has(id)) deleteNode(graph, id)
    for (const b of region.blocks) deleteNode(graph, b)
    return callee
}

function cutGraph(graph: Graph, limit: number, symbolFor: (name: string) => number, out: [symbol: number, graph: Graph][]): void {
    if (countNodes(graph) <= limit) return
    const region = cutRegion(graph)
    const debug = flags.has('cut-debug')
    if (!region) {
        if (debug) console.log('CUT-NONE', graph.name, countNodes(graph))
        return
    }
    const plan = cutPlan(graph, region)
    const width = plan.liveIns.length + getBlock(graph, region.entry)!.params.length
    const returns = plan.why ?? (width > cutWidth ? `interface ${width}` : cutReturnType(graph, region))
    if (typeof returns === 'string') {
        if (debug) console.log('CUT-REJECT', graph.name, `${region.size}/${region.total}`, returns, plan.liveIns.map(id => opName(getNode(graph, id)!.op)).join(' '))
        return
    }
    const name = `${graph.name}/cut${out.length}`
    const symbol = symbolFor(name)
    const callee = outlineRegion(graph, region, plan, returns, symbol, name)
    if (debug) console.log('CUT', graph.name, `${region.size}/${region.total}`, 'blocks', region.blocks.size, 'liveIns', plan.liveIns.length, 'params', callee.blocks[0].params.length, 'frontier', plan.frontier.size, '->', name, countNodes(callee), 'caller', countNodes(graph))
    out.push([symbol, callee])
    cutGraph(graph, limit, symbolFor, out)
    cutGraph(callee, limit, symbolFor, out)
}

function compileProgram(linker: Linker, tracer: Tracer, resolver: Resolver, plan: ShapePlan, image: ProgramImage, target: Target, clock: PhaseClock): ProgramGraph {
    const { session, roots, order, unitOf, originOf, link, intern, functions, linkRuntimeCalls, resolveHandles, sourceOfLinked, constructsOutOfLine, usesReceiver } = linker
    const outlined: [Function, Graph][] = []
    const { realizeUnit, plannedUnit } = resolver
    const outline = (name: string) => intern(Object.assign(namedStub(name), { shouldNotInline: true }))
    const program: ProgramGraph = { units: new Map(), roots, noInline: new Set(), alwaysInline: new Set(), constructors: new Set(), unplanned: new Set(), tagged: new Set(), abi: new Map(), hostReturns: new Map(), image, target }
    function compileUnit(fn: Function): Graph {
        const unit = unitOf(fn)
        if (flags.has('native-symbols')) console.log('native symbol', unit.symbol!, fn.name || fn.toString().slice(0, 80), plannedUnit(fn) ? 'planned' : 'unplanned')
        const traceDebug = flagged('trace-debug', fn.name)
        if (traceDebug) console.log('trace native', fn.name)
        if (!plannedUnit(fn) && ![...roots.values()].includes(unit.symbol!)) {
            program.unplanned.add(unit.symbol!)
            return trapStub(session.runtime!, fn.name, sourceOfLinked(fn)!.compiled.paramCount, constructsOutOfLine(fn) || usesReceiver(fn))
        }
        const graph = realizeUnit(fn)
        if (flags.has(`resolved-debug:${fn.name}`)) console.log(dumpGraph(graph))
        const lifted = liftReturnedHeapValues(graph)
        lifted.name = fn.name
        if (traceDebug) console.log(dumpGraph(unit.traced!.graph))
        if (cutLimit) {
            const pieces: [number, Graph][] = []
            cutGraph(lifted, cutLimit, outline, pieces)
            for (const [symbol, piece] of pieces) outlined.push([functions[symbol], piece])
        }
        return clock.normalize(lifted, { firstPass: true })
    }
    const init = staticInitializerOf(linker, image, plannedUnit)
    if (init) {
        roots.set(staticInitName, link(init))
        tracer.graphsOf(init)
    }
    tracer.freeze()
    const rooted = new Set(roots.values())
    let next = 0
    while (next < order.length) {
        const wave = order.slice(next)
        next = order.length
        const graphs = new Map<Function, Graph>()
        outlined.length = 0
        for (const fn of flags.has('reverse-units') ? [...wave].reverse() : wave) graphs.set(fn, compileUnit(fn))
        for (const [fn, piece] of outlined) {
            graphs.set(fn, clock.normalize(piece, { firstPass: true }))
            wave.push(fn)
        }
        for (const fn of wave) {
            const graph = graphs.get(fn)!
            linkRuntimeCalls(graph)
            const symbol = unitOf(fn).symbol!
            const planned = plannedUnit(fn)
            const abi = resolver.abiOf(fn)
            program.units.set(symbol, graph)
            const machine = (rep: Rep) => numberName(rep) === 'f64' ? 'f' : rep.kind === 'never' || rep.kind === 'undefined' ? '-' : 'w'
            program.abi.set(symbol, planned ? `${planned.params.map(p => machine(p.rep)).join('')} -> ${machine(planned.returns)} ${abi.mode}` : '?')
            if ((originOf(fn) as any).shouldNotInline || program.unplanned.has(symbol)) program.noInline.add(symbol)
            if ((originOf(fn) as any).shouldInline) program.alwaysInline.add(symbol)
            if (constructsOutOfLine(fn)) program.constructors.add(symbol)
            if (planned && abi.mode === 'tagged') program.tagged.add(symbol)
            if (planned && rooted.has(symbol) && unionWord(planned.returns)) program.hostReturns.set(symbol, 'word')
            else if (planned && rooted.has(symbol) && isStringRep(planned.returns) && !planned.returns.nullable) program.hostReturns.set(symbol, 'string')
            clock.timed('statics', () => resolveHandles(graph, plan.statics), fn.name)
        }
    }
    clock.timed('statics', () => tracer.checkInlinedReads(plan.fixedStatic))
    return program
}

function localizeProgram(program: ProgramGraph, linker: Linker, resolver: Resolver): void {
    const { functions } = linker
    for (const graph of program.units.values()) localizeCalls(graph, program.image, program.units)
    for (const graph of program.units.values()) {
        for (const [id, n] of nodeEntries(graph)) {
            const symbol = calledSymbol(graph, n)
            if (symbol === undefined) continue
            const callee = functions[symbol]
            if (!resolver.plannedUnit(callee)) continue
            const abi = resolver.abiOf(callee)
            const returns = abi.returns
            if (abi.mode === 'record') {
                intrinsics.assert(!!recordTypeAt(graph, id), `native: ${graph.name} %${id} binds a scalar from ${callee.name}, which returns a record`)
                continue
            }
            intrinsics.assert(resultType(graph, n) === returns, `native: ${graph.name} %${id} binds ${typeName(resultType(graph, n))} from ${callee.name}, which returns ${typeName(returns)}`)
        }
    }
}

const allocKindNames = ['object', 'array', 'buffer', 'scope']

function siteText(site: Site): string {
    return `${site.unit.name || '<anon>'}%${site.node}${site.frame === undefined ? '' : `<F${site.frame}>`}${site.operand === undefined ? '' : `#${site.operand}`}`
}

function planTypeDebug(types: ValueTypes, locations: Location[], plan: ShapePlan, planned: Planned, reps: Representations, facts: Facts) {
    const writers = new Map<string, Site[]>()
    for (const location of locations) writers.set(`${location.allocation}|${location.key}`, location.writers)
    function framesText(frames: number[]): string {
        return frames.map(f => `F${f}`).join(',')
    }
    function joinText(unit: PlannedUnit, pick: (frame: FrameSignature) => Type): string {
        return unit.frames.map(f => `F${f}: ${formatType(types, pick(types.frames[f]))}`).join('; ')
    }
    function changed(rep: Rep, base: Rep | undefined): string {
        if (!base || base.text === rep.text) return ''
        if (rep.text === 'truth') return `, then truth-tested by every use (truthDemand), was ${base.text}`
        if (rep.constant && !base.constant) return `, then one constant across all planned units of the function (valueRep), was ${base.text}`
        if (rep.nullable && !base.nullable) return `, then made nullable with its share class (joinNullableNumbers), was ${base.text}`
        return `, then changed by a later plan step, was ${base.text}`
    }
    function nodeReason(unit: PlannedUnit, rep: Rep, type: Type | undefined): string {
        if (!type) return rep.text === 'truth' ? 'truth-tested call result (truthReturns)' : 'set by a later plan step (no flow type)'
        return `repOf(flow ${formatType(types, type)} over ${framesText(unit.frames)})${changed(rep, plan.inst.repOf(type))}`
    }
    function paramText(unit: PlannedUnit, i: number): string {
        const param = unit.params[i]
        const joined = unionAll(unit.frames.map(f => types.frames[f].params[i]?.type ?? emptyType()))
        const lines = [`param ${i} ${param.label}: rep ${param.rep.text} <- repOf(join ${joinText(unit, frame => frame.params[i]?.type ?? emptyType())})${changed(param.rep, plan.inst.repOf(joined))}`]
        for (const f of unit.frames) lines.push(`  F${f} callers: ${types.frames[f].sites.map(siteText).join(', ') || 'root/static'}`)
        return lines.join('\n')
    }
    function fieldKeyOf(k: string): intrinsics.Handle | undefined {
        const index = /^\[(\d+)\]$/.exec(k)
        return index ? heap.indexKey(Number(index[1]) as u32) : types.keyHandles.get(k)
    }
    function shapeText(key: string): string[] {
        const sig = plan.inst.shapes.get(key)
        if (!sig) return [`shape ${key}: no planned record (kept as a heap object or buffer)`]
        const handle = plan.shapes.get(key)
        const layout = handle !== undefined ? propertyEval.recordLayout(handle, plan.embedded.fields, plan.bits) : undefined
        const known = handle !== undefined ? facts.get(handle) : undefined
        const slots = sig.fields.map(([k, rep]) => {
            const fieldKey = fieldKeyOf(k)
            const at = layout && fieldKey !== undefined ? layout.keys.indexOf(fieldKey) : -1
            const offset = at >= 0 ? layout!.offsets[at] : undefined
            const fact = offset !== undefined ? known?.get(String(offset)) : undefined
            return `${k}: ${rep.text}${offset !== undefined ? ` @${offset}` : ''}${fact ? ` (${describeFact(fact)})` : ''}`
        })
        return [`shape ${key}${handle !== undefined ? ` = ${describe(handle)}` : ''} members ${sig.members.map(m => `O${m}`).join(',')}`, `  slots ${slots.join(', ')}`]
    }
    function objectText(id: number, lines: string[], indent: string): void {
        const object = types.objects[id]
        const keys = [...object.fields.keys()].sort()
        const indexed = keys.filter(constantIndex)
        const elements = object.kind === AllocKind.array || object.kind === AllocKind.buffer
        if (elements && keys.includes(numberKey)) lines.push(`${indent}elements: T[]: a [number] field exists (a computed index reaches it), so constant positions ${indexed.join(',') || '(none)'} fold into it`)
        else if (elements && indexed.length) lines.push(`${indent}elements: tuple: only constant positions ${indexed.join(',')} are written, each typed on its own${object.kind === AllocKind.buffer ? ' (the layout still uses the one element rep below)' : ''}`)
        if (object.kind === AllocKind.buffer) lines.push(`${indent}element rep ${plan.inst.elementOf([id]).text} (one rep per buffer group: buffers held by the same shape field share it)`)
        for (const k of keys) {
            const field = object.fields.get(k)!
            lines.push(`${indent}field ${k}: ${formatType(types, field.type)} [${field.forms.join(',')}] <- writers ${(writers.get(`${id}|${k}`) ?? []).map(siteText).join(', ') || 'none (initial state)'}`)
            if (object.kind === AllocKind.buffer) continue
            for (const inner of field.type.objects) {
                if (types.objects[inner].kind !== AllocKind.buffer) continue
                lines.push(`${indent}  buffer O${inner} @${siteText(types.objects[inner].site)}`)
                objectText(inner, lines, `${indent}    `)
            }
        }
    }
    function allocationText(unit: PlannedUnit): string[] {
        const lines: string[] = []
        const frames = new Set(unit.frames)
        types.objects.forEach((object, id) => {
            if (object.site.unit !== unit.fn || object.constant) return
            const live = object.frames ?? (object.frame === undefined ? [] : [object.frame])
            if (live.length && !live.some(f => frames.has(f))) return
            const shape = unit.allocations.get(object.site.node) ?? plan.inst.shapeOf(id)
            const flags = `${object.constant ? ' constant' : ''}${object.native ? ' native' : ''}${object.dynamic ? ' dynamic' : ''}${object.copied ? ' copied' : ''}`
            lines.push(`alloc %${object.site.node} O${id} ${object.name} ${allocKindNames[object.kind]}${flags} frames ${framesText(live)} -> ${shape ?? 'no shape'}`)
            objectText(id, lines, '  ')
            if (shape !== undefined && shape !== 'heap') for (const line of shapeText(shape)) lines.push(`  ${line}`)
        })
        return lines
    }
    function referencedShapes(unit: PlannedUnit): string[] {
        const targets = new Set<string>()
        const add = (rep: Rep | undefined) => {
            if (!rep) return
            for (const target of rep.targets) if (plan.inst.shapes.has(target)) targets.add(target)
            add(rep.element)
            add(rep.other)
        }
        for (const param of unit.params) add(param.rep)
        add(unit.returns)
        for (const rep of unit.nodes.values()) add(rep)
        for (const rep of unit.slices.values()) add(rep)
        const lines: string[] = []
        for (const target of targets) {
            for (const line of shapeText(target)) lines.push(line)
            const members = plan.inst.shapes.get(target)!.members
            for (const id of members.slice(0, 6)) {
                const object = types.objects[id]
                lines.push(`  member O${id} ${object.name} ${allocKindNames[object.kind]} @${siteText(object.site)}`)
                objectText(id, lines, '    ')
            }
            if (members.length > 6) lines.push(`  +${members.length - 6} more members`)
        }
        return lines
    }
    function unitName(unit: PlannedUnit): string {
        return planned.functions.get(unit)?.name ?? `${unit.fn.name || '<anon>'}(shared)`
    }
    function unitText(unit: PlannedUnit): string {
        const fn = planned.functions.get(unit)
        const abi = fn ? reps.abi.get(fn) : undefined
        const resolved = types.resolve(unit.frames).nodes
        const lines = [`TYPES plan ${unitName(unit)} (origin ${unit.fn.name || '<anon>'}) ${unit.signature}`]
        lines.push(`  frames ${framesText(unit.frames)}; abi ${abi ? `${abi.mode} returns ${typeName(abi.returns)}${abi.tags.length ? ` tags ${abi.tags.join(',')}` : ''}` : 'shared/none'}`)
        for (let i = 0; i < unit.params.length; i++) for (const line of paramText(unit, i).split('\n')) lines.push(`  ${line}`)
        lines.push(`  returns: rep ${unit.returns.text} <- join ${joinText(unit, frame => frame.returns)} (and its return-convention peers)`)
        for (const [node, callees] of unit.calls) lines.push(`  call %${node} -> ${[...callees].map(callee => `${unitName(callee)}${callee.signature}`).join(' | ')}`)
        for (const line of allocationText(unit)) lines.push(`  ${line}`)
        for (const line of referencedShapes(unit)) lines.push(`  ${line}`)
        for (const node of [...unit.nodes.keys()].sort((a, b) => a - b)) lines.push(`  %${node} rep ${unit.nodes.get(node)!.text} <- ${nodeReason(unit, unit.nodes.get(node)!, resolved.get(node))}`)
        for (const [node, element] of unit.slices) lines.push(`  %${node} element ${element.text}`)
        return lines.join('\n')
    }
    function noteUnits(): void {
        for (const [origin, units] of plan.units) {
            for (const unit of units) {
                const name = unitName(unit)
                const recorded = debugsTypes(name) || debugsTypes(origin.name)
                if (!recorded) continue
                const resolved = types.resolve(unit.frames).nodes
                for (const [node, rep] of unit.nodes) noteType(node, `plan ${name}: rep ${rep.text} <- ${nodeReason(unit, rep, resolved.get(node))}`)
                for (const [node, callees] of unit.calls) noteType(node, `plan ${name}: bound to ${[...callees].map(callee => `${unitName(callee)}${callee.signature}`).join(' | ')}`)
                console.log(unitText(unit))
            }
        }
    }
    function explainParam(fn: Function, traced: Graph | undefined, param: number): string {
        const unit = planned.units.get(fn)
        if (!unit) return `${fn.name} has no planned unit`
        const index = traced ? traced.blocks[0].params.indexOf(param) : -1
        const head = `planned ${unitName(unit)}${unit.signature} frames ${framesText(unit.frames)}`
        if (index < 0 || index >= unit.params.length) return `${head}; %${param} is not a traced entry param`
        return `${head}\n${paramText(unit, index).split('\n').map(line => `    ${line}`).join('\n')}`
    }
    return { noteUnits, explainParam }
}

function printAnalysis(valueTypes: ValueTypes, genericOf: (proto: intrinsics.Handle) => Generic | undefined): void {
    if (flags.has('types')) console.log(dumpTypes(valueTypes))
    if (!flags.has('generics')) return
    const printed = new Set<Generic>()
    for (const object of valueTypes.objects) {
        const generic = object.proto ? genericOf(object.proto) : undefined
        if (generic && !printed.has(generic)) console.log(generic.lines.join('\n'))
        if (generic) printed.add(generic)
    }
    for (const entry of instantiate(valueTypes, genericOf).table.values()) {
        console.log(`INST ${entry.key} [${entry.members.map(id => `#${id}`).join(' ')}]`)
        for (const [k, rep] of entry.fields) console.log(`  ${k}: ${rep}`)
    }
}

interface TyperRun {
    typed: ReturnType<typeof typer.typeRoots>
    ms: number
}

function printCompiled(program: ProgramGraph, facts: Facts, plan: ShapePlan, valueTypes: ValueTypes, linker: Linker, tracer: Tracer, resolver: Resolver, typerRun: TyperRun): void {
    const { roots, unitOf, originOf, codeOf } = linker
    const { abiOf, paramShapesOf, plannedUnit } = resolver
    const published = [...program.units.keys()].map(symbol => unitOf(linker.functions[symbol]))
    if (flags.has('facts-dump')) {
        const seen = new Set<Map<string, Codec>>()
        for (const [shape, known] of facts) {
            const shared = seen.has(known)
            seen.add(known)
            console.log(`FACTS ${describe(shape)}${shared ? ' (unified)' : ''}`)
            if (!shared) for (const [path, fact] of known) console.log(`  [${path}] ${describeFact(fact)}`)
        }
    }
    if (flags.has('plan')) {
        for (const [id, shape] of plan.inst.shapes) console.log(`SHAPE ${id} ${shape.text.slice(0, shape.text.indexOf('{'))}{${shape.fields.map(([k, r]) => `${k}: ${r.text}`).join(', ')}} @ ${[...new Set(shape.members.map(m => `${valueTypes.objects[m].site.unit.name}:%${valueTypes.objects[m].site.node}`))].join(' ')}`)
        const nativeUnits = new Map<Function, Unit[]>()
        for (const unit of published) {
            const origin = originOf(unit.fn)
            let list = nativeUnits.get(origin)
            if (!list) nativeUnits.set(origin, list = [])
            list.push(unit)
        }
        for (const fn of new Set([...plan.units.keys(), ...nativeUnits.keys()])) {
            const planned = plan.units.get(fn) ?? []
            const native = nativeUnits.get(fn) ?? []
            console.log(`PLAN ${fn.name || '<anon>'} planned=${planned.length} native=${native.length}${planned.length === native.length ? '' : ' MISMATCH'}`)
            for (const unit of planned) {
                console.log(`  plan ${unit.signature} frames=${unit.frames.length}`)
                for (const [node, callees] of unit.calls) if (callees.size > 1) console.log(`    %${node} -> ${[...callees].map(c => `${c.fn.name}${c.signature}`).join(' | ')}`)
            }
            for (const unit of native) console.log(`  native ${unit.fn.name} ${[...paramShapesOf(unit.fn)].map(([i, shape]) => `p${i}=${describe(shape)}`).join(' ')}`)
        }
    }
    if (flags.has('types-check')) {
        const checked: NativeUnit[] = published.filter(unit => unit.source).map(unit => {
            const paramCount = unit.source!.compiled.paramCount
            const params: NativeParam[] = []
            const shapes = paramShapesOf(unit.fn)
            const reps = plannedUnit(unit.fn)?.params ?? []
            for (let i = 0; i < paramCount; i++) {
                const shape = shapes.get(i)
                params.push({ label: `p${i}`, kind: numberName(reps[i]?.rep) === 'f64' ? Types.f64 : undefined, nullish: reps[i]?.rep.kind === 'undefined', keys: shape !== undefined && shape !== propertyEval.numberShape && shape !== propertyEval.stringShape ? propertyEval.dataKeys(shape).map(k => heap.isString(k) ? heap.stringToJs(k) : heap.describeKey(k) ?? `#${k}`) : undefined })
            }
            const receiver = shapes.get(paramCount)
            if (receiver !== undefined) params.push({ label: 'this', nullish: false, keys: propertyEval.dataKeys(receiver).map(k => heap.isString(k) ? heap.stringToJs(k) : heap.describeKey(k) ?? `#${k}`) })
            return { name: unit.fn.name, origin: originOf(unit.fn), sites: [], params, returns: abiOf(unit.fn).returns }
        })
        console.log(checkTypes(valueTypes, checked))
    }
    if (flags.has('typer-stats')) {
        const counts = { numeric: 0, string: 0, unknown: 0 }
        const typedSources = new Set<CompiledSource>()
        for (const unit of typerRun.typed.units) {
            typedSources.add(unit.source)
            for (const site of unit.sites.values()) counts[site.result]++
        }
        let untypedFns = 0
        let untypedSites = 0
        for (const { fn } of tracer.units) {
            const code = codeOf(fn)
            if (!code || typedSources.has(code.source)) continue
            untypedFns++
            untypedSites += typer.countAddSites(code.source.compiled)
        }
        console.log(`typer [${[...roots.keys()].join(',')}] ${typerRun.ms.toFixed(1)}ms units=${typerRun.typed.units.length} numeric=${counts.numeric} string=${counts.string} unknown=${counts.unknown} | traced-untyped fns=${untypedFns} sites=${untypedSites}`)
    }
}

function traceProgram(fns: Record<string, Function>, opts: CreateNativesOptions, clock: PhaseClock, target: Target): ProgramGraph {
    const image = createImage()
    const linker = clock.timed('link', () => createLinker(fns, opts, image, clock))
    const { session, functions, roots } = linker
    if (typeRecording()) resetTypeNotes()
    const facts: Facts = new Map()
    const tracer = createTracer(linker, image, facts, clock)
    session.enterTrace()
    defer finally {
        session.leaveTrace()
    }
    const rootFns = [...roots.values()].map(symbol => functions[symbol])
    const typerStart = performance.now()
    const typed = clock.timed('typer', () => session.typeRoots(rootFns, true))
    const typerRun: TyperRun = { typed, ms: performance.now() - typerStart }
    const { host, genericOf } = createAccessHost(linker, tracer)
    clock.timed('trace', () => tracer.traceProgramUnits())
    const accesses = clock.timed('analysis', () => flowAccesses(rootFns, host))
    const valueTypes = clock.timed('analysis', () => analyzeTypes(accesses, host, rootFns))
    linker.linkHeldStatics(new Set(valueTypes.frames.filter(frame => frame.heldStatic).map(frame => frame.unit)))
    printAnalysis(valueTypes, genericOf)
    const { plan, planned, reps } = clock.timed('plan', () => {
        const plan = planShapes(valueTypes, linker, tracer, host, genericOf, facts)
        for (const [shape, kinds] of plan.bits) image.recordBits.set(shape, kinds)
        for (const [cell, object] of plan.functionObjects.cells) image.functionObjects.set(cell, object)
        const planned = bindPlannedUnits(plan, linker)
        const reps = chooseRepresentations(plan, planned, linker, tracer, host)
        sharePlannedUnits(plan, planned, reps, host)
        const regions = planPstackRegions(valueTypes, [...planned.units.values()], unit => tracer.graphsOf(planned.functions.get(unit)!).traced!.graph, flags.has('pstack-debug'))
        const placed = new Map<PlannedUnit, [number, number[]][]>()
        for (const region of regions) {
            if (region.reason || region.call) continue
            const list = placed.get(region.unit)
            const entry: [number, number[]] = [region.header, region.stacks.map(stack => stack ? programStack : 0)]
            if (list) list.push(entry)
            else placed.set(region.unit, [entry])
        }
        planned.regions = placed
        freezeFacts(facts, planFrames(valueTypes, plan, planned, linker, tracer, facts))
        return { plan, planned, reps }
    })
    const typeDebug = typeDebugging() ? planTypeDebug(valueTypes, accesses.locations, plan, planned, reps, facts) : undefined
    if (typeDebug && typeRecording()) typeDebug.noteUnits()
    const smallSets = clock.timed('plan', () => planSmallSets(valueTypes, host, planned.units.values(), rootFns))
    for (const [unit, uses] of smallSets) {
        for (const id of uses.keys()) {
            unit.calls.delete(id)
        }
        planned.rewrites.set(unit, graph => rewriteSmallSets(graph, uses, image.wordsSlot))
    }
    const resolver = createResolver(linker, tracer, plan, planned, reps, facts, clock, image.wordsSlot)
    const program = compileProgram(linker, tracer, resolver, plan, image, target, clock)
    if (typeDebug) program.explain = (symbol, param) => {
        const fn = functions[symbol]
        if (!fn) return `symbol ${symbol} has no function`
        return typeDebug.explainParam(fn, tracer.graphsOf(fn).traced?.graph, param)
    }
    clock.timed('link', () => localizeProgram(program, linker, resolver))
    printCompiled(program, facts, plan, valueTypes, linker, tracer, resolver, typerRun)
    if (flags.has('trace-stats')) console.log('heap records', session.runtime?.objects.stats)
    return program
}

let nativeObserver: ((event: string) => void) | undefined
const emittedTotals = { units: 0, fns: 0, instructions: 0, nonMov: 0 }
const phaseTotals: Record<string, number> = {}

export function emittedCounts(): { units: number, fns: number, instructions: number, nonMov: number } {
    return { ...emittedTotals }
}

export function phaseTimes(): Record<string, number> {
    return { ...phaseTotals }
}

export function observeNatives(observer: (event: string) => void): void {
    nativeObserver = observer
}

let rootsObserver: ((fns: Record<string, Function>, opts: CreateNativesOptions) => void) | undefined

export function observeRoots(observer: (fns: Record<string, Function>, opts: CreateNativesOptions) => void): void {
    rootsObserver = observer
}

export function createNatives(fns: Record<string, Function>, opts: CreateNativesOptions = {}) {
    rootsObserver?.(fns, opts)
    nativeObserver?.(`compile ${Object.keys(fns).join(', ')}`)
    getNativeBootstraps()
    const target = hostTarget
    const clock = createClock(target)
    const program = traceProgram(fns, opts, clock, target)
    const { timed } = clock
    const tracedUnits = program.units.size
    const lineageBefore = typeRecording() ? new Map([...program.units].filter(([, graph]) => debugsTypes(graph.name)).map(([symbol, graph]) => [symbol, lineageSnapshot(graph)])) : undefined
    const merged = optimizeProgram(program, clock)
    if (lineageBefore) for (const [symbol, graph] of program.units) if (lineageBefore.has(symbol)) traceLineage(graph, lineageBefore.get(symbol)!)
    const emitted = timed('lower', () => lowerProgram(program, clock))
    clock.enterPhase('other')
    for (const [phase, ms] of Object.entries(clock.phases)) phaseTotals[phase] = (phaseTotals[phase] ?? 0) + ms
    printOptimizeStats()
    if (flags.has('trace-stats')) {
        console.log("native phases", { total: performance.now() - clock.start, ...clock.phases })
        const { bySource, ...totals } = traceModule.traceStats
        const repeated = [...bySource.values()].filter(x => x.count > 1).sort((a, b) => b.count - a.count)
        console.log('trace2 stats', totals, 'distinct sources', bySource.size,
            'repeat traces', repeated.reduce((s, x) => s + x.count - 1, 0))
        for (const x of repeated.slice(0, 15)) console.log('  ', x.count, x.name)
        const byName = new Map<string, number[]>()
        for (const [name, size] of normalizeStats) byName.set(name, [...byName.get(name) ?? [], size])
        console.log('normalize calls', normalizeStats.length, 'nodes', normalizeStats.reduce((t, x) => t + x[1], 0))
        for (const [name, sizes] of [...byName].sort((a, b) => b[1].reduce((x, y) => x + y, 0) - a[1].reduce((x, y) => x + y, 0)).slice(0, 12)) console.log('  ', name, sizes.join(' '))
        const bySelf = [...bySource.values()].sort((a, b) => b.self - a.self)
        for (const x of bySelf.slice(0, 20)) {
            console.log('  self', x.self.toFixed(1), 'x', x.count, x.name.replace(/\n\s*/g, ' ').slice(0, 70))
        }
    }
    if (flags.has('emit-debug')) {
        console.log('EMITTED', emitted.map(unit => `${unit.name}:${unit.symbol}`).join(' '))
    }
    const floatReturns = new Set(emitted.filter(u => u.returnsFloat).map(u => u.symbol))
    for (const graph of program.units.values()) {
        for (const n of allNodes(graph)) {
            if (n.op !== NodeOp.call) continue
            const local = localSymbol(graph, getNode(graph, getRef(n, 1)))
            if (local === undefined || !floatReturns.has(local)) continue
            intrinsics.assert(resultType(graph, n) === Types.f64, `native: ${graph.name || 'anonymous'} calls ${program.units.get(local)?.name || 'anonymous'}, which returns f64, through an untyped target`)
        }
    }
    let unitInst = 0
    let nonMov = 0
    let islandBytes = 0
    for (const u of emitted) {
        unitInst += u.code.words.length
        islandBytes += (u.code.island?.length ?? 0) * 8
        for (const word of u.code.words) if (!u.code.target.isMoveWide(word)) nonMov++
    }
    if (flags.has('unit-sizes')) for (const u of emitted) console.log(`UNIT ${u.name || 'anonymous'}:${u.symbol} ${u.code.words.length} ${u.code.words.filter(w => !u.code.target.isMoveWide(w)).length} ${(u.code.island?.length ?? 0) * 8}`)
    const inlined = (tracedUnits - emitted.length - merged ? ` (${tracedUnits - emitted.length - merged} inlined away)` : '') + (merged ? ` (${merged} merged)` : '')
    emittedTotals.units++
    emittedTotals.fns += emitted.length
    emittedTotals.instructions += unitInst
    emittedTotals.nonMov += nonMov
    console.log(`native unit ${emitted.length} fns ${unitInst}/${nonMov} instructions/non-mov, ${unitInst * 4 + islandBytes} image bytes (${islandBytes} island)${inlined} [${Math.round(performance.now() - clock.start)}ms]`)
    const pooled = new Map<number, number>()
    const image = program.image
    for (const [slot, symbol] of image.functionTargets) if (program.units.has(symbol)) pooled.set(slot, symbol)
    const installed = installImage(emitted, image.values, pooled,
        image.byteTargets, new Uint8Array(image.bytes), image.relocations, image.slotRelocations)
    for (const [at, slot] of image.codeFields) {
        const symbol = image.functionTargets.get(slot)
        const linked = symbol !== undefined && pooled.has(slot)
        const address = linked ? installed.entries[symbol] : image.values[slot]
        staticWrite(at, new Uint8Array(new BigUint64Array([BigInt(address)]).buffer), linked ? [{ offset: 0, region: installed.region, scale: 1 }] : [])
    }
    const initSymbol = program.roots.get(staticInitName)
    const capture: ImageCapture = {
        code: installed.image,
        codeRegion: installed.region,
        codeRelocations: installed.relocations,
        roots: [],
        staticFrom: image.startWrites,
        staticTo: staticWrites.length,
        heapTo: heapWrites.length,
        staticTop: Number(pstackMark(0)),
        imports: image.imports,
    }
    const codeBase = nativeRegions[installed.region].base
    if (initSymbol !== undefined) capture.init = Number(installed.entries[initSymbol]) - codeBase
    for (const [name, symbol] of program.roots) {
        if (name === staticInitName) continue
        capture.roots.push({ name, offset: Number(installed.entries[symbol]) - codeBase, float: !!emitted.find(u => u.symbol === symbol)?.returnsFloat, floats: floatParams(program.units.get(symbol)!), returns: program.hostReturns.get(symbol) })
    }
    if (initSymbol !== undefined) {
        sealCode(installed.page)
        const none = new BigInt64Array(1)
        nativeObserver?.(staticInitName)
        nativeInvoker(installed.entries[initSymbol], (ts as any).getArrayBufferPtr(none.buffer), 0)
    }
    const result: Record<string, any> = {}
    for (const [name, symbol] of program.roots) {
        if (name === staticInitName) continue
        const ptr = installed.entries[symbol]
        const float = !!emitted.find(u => u.symbol === symbol)?.returnsFloat
        const decoded = program.hostReturns.get(symbol)
        const floats = floatParams(program.units.get(symbol)!)
        result[name] = Object.assign((...args: any[]) => {
            nativeObserver?.(`${name}(${args.join(', ')})`)
            sealCode(installed.page)
            const raw = invokeRoot(ptr, args, floats)
            if (float) return floatBits(raw)
            return decoded ? hostResult(raw, decoded) : raw
        }, { ptr, codePage: installed.page, image: installed, units: emitted, capture })
    }
    return result
}

const imageMagic = 'SYNIMAGE'
const imageVersion = 1
const ImageSection = { regions: 1, memory: 2, relocations: 3, entries: 4 }
const EntryFlags = { float: 1, init: 2, word: 4, string: 8 }

function verifyImage(regions: ImageRegion[], relocations: ImageRelocation[]): void {
    const ranges: [base: bigint, end: bigint, what: string][] = []
    for (const region of nativeRegions) ranges.push([BigInt(region.base), BigInt(region.base + region.size), `${['code', 'heap', 'pstack', 'table'][region.kind]} region ${region.index}`])
    for (const [base, size] of traceModule.symbolicRanges) ranges.push([BigInt(base), BigInt(base + size), 'symbolic memory'])
    const pstack = nativeRegions.filter(region => region.kind === RegionKind.pstack).map(region => BigInt(region.base))
    const tagged = BigInt(heap.pstackWordTag + 1)
    const inRange = (value: bigint): string | undefined => {
        for (const [base, end, what] of ranges) if (value >= base && value < end) return what
        for (const base of pstack) {
            const scaled = BigInt.asIntN(64, value) - tagged
            if (scaled <= -BigInt(2) * base && scaled > -BigInt(2) * (base + BigInt(pstackRegionBytes))) return 'scaled pstack base'
        }
    }
    const relocated = new Set(relocations.map(relocation => `${relocation.at}:${relocation.offset}`))
    for (let at = 0; at < regions.length; at++) {
        const region = regions[at]
        if (region.kind !== RegionKind.code) continue
        for (const segment of region.segments) {
            const view = new DataView(segment.bytes.buffer, segment.bytes.byteOffset, segment.bytes.byteLength)
            for (let i = (8 - segment.offset % 8) % 8; i + 8 <= segment.bytes.length; i += 8) {
                if (relocated.has(`${at}:${segment.offset + i}`)) continue
                const what = inRange(view.getBigUint64(i, true))
                if (what) throw `native: the image code at 0x${region.base.toString(16)} holds an unrelocated address 0x${view.getBigUint64(i, true).toString(16)} of ${what} at +0x${(segment.offset + i).toString(16)}`
            }
            const moves = new Map<number, bigint>()
            for (let i = 0; i + 4 <= segment.bytes.length; i += 4) {
                const word = view.getUint32(i, true)
                const top = (word & 0xFF800000) >>> 0
                const rd = word & 31
                const shift = BigInt(((word >>> 21) & 3) * 16)
                const imm = BigInt((word >>> 5) & 0xFFFF)
                if (top === 0xD2800000) moves.set(rd, imm << shift)
                else if (top === 0x92800000) moves.set(rd, BigInt.asUintN(64, ~(imm << shift)))
                else if (top === 0xF2800000) moves.set(rd, ((moves.get(rd) ?? BigInt(0)) & ~(BigInt(0xFFFF) << shift)) | (imm << shift))
                else continue
                const what = inRange(moves.get(rd)!)
                if (what) throw `native: the image materializes an address of ${what} in an instruction at code+0x${i.toString(16)}`
            }
        }
    }
}

function paintSegments(writes: { offset: number, bytes: Uint8Array }[]): ImageSegment[] {
    const order = writes.map((write, i) => i).sort((a, b) => writes[a].offset - writes[b].offset || a - b)
    const groups: number[][] = []
    let end = -1
    for (const i of order) {
        const write = writes[i]
        if (!groups.length || write.offset > end) groups.push([])
        groups[groups.length - 1].push(i)
        end = Math.max(end, write.offset + write.bytes.length)
    }
    const segments: ImageSegment[] = []
    for (const group of groups) {
        group.sort((a, b) => a - b)
        let start = Infinity
        let stop = 0
        for (const i of group) {
            start = Math.min(start, writes[i].offset)
            stop = Math.max(stop, writes[i].offset + writes[i].bytes.length)
        }
        const bytes = new Uint8Array(stop - start)
        for (const i of group) bytes.set(writes[i].bytes, writes[i].offset - start)
        segments.push({ offset: start, bytes })
    }
    return segments
}

export function serializeImage(natives: Record<string, any>): Uint8Array {
    const capture: ImageCapture | undefined = Object.values(natives).find(fn => fn?.capture)?.capture
    if (!capture) throw 'native: these natives carry no image'
    if (capture.imports.length) throw `native: the image imports host functions (${[...new Set(capture.imports)].join(', ')}), which cannot be serialized yet`
    const used = new Map<number, number>()
    const regions: ImageRegion[] = []
    const relocations: ImageRelocation[] = []
    const regionIndex = (id: number): number => {
        const known = used.get(id)
        if (known !== undefined) return known
        const { kind, index, base, size } = nativeRegions[id]
        used.set(id, regions.length)
        regions.push({ kind, index, base, size, segments: [] })
        return regions.length - 1
    }
    const code = regionIndex(capture.codeRegion)
    regions[code].segments.push({ offset: 0, bytes: capture.code })
    for (const relocation of capture.codeRelocations) relocations.push({ at: code, offset: relocation.offset, target: regionIndex(relocation.region), scale: relocation.scale })
    const writes = new Map<number, { offset: number, bytes: Uint8Array }[]>()
    const words = new Map<number, Map<number, Relocation>>()
    function replay(write: MemoryWrite): void {
        const id = regionAt(write.at)
        const offset = write.at - nativeRegions[id].base
        const list = writes.get(id)
        if (list) list.push({ offset, bytes: write.bytes })
        else writes.set(id, [{ offset, bytes: write.bytes }])
        let pointers = words.get(id)
        if (!pointers) words.set(id, pointers = new Map())
        for (let word = offset - 7; word < offset + write.bytes.length; word++) pointers.delete(word)
        for (const relocation of write.relocations) pointers.set(offset + relocation.offset, relocation)
    }
    for (let i = 0; i < capture.heapTo; i++) replay(heapWrites[i])
    for (let i = capture.staticFrom; i < capture.staticTo; i++) replay(staticWrites[i])
    for (const [stack, id] of pstackRegions) {
        const base = nativeRegions[id].base
        const top = stack === 0 ? capture.staticTop : base + 8
        replay({ at: base, bytes: new Uint8Array(new BigUint64Array([BigInt(top)]).buffer), relocations: [{ offset: 0, region: id, scale: 1 }] })
    }
    for (const [id, list] of writes) {
        const at = regionIndex(id)
        regions[at].segments.push(...paintSegments(list))
        for (const [offset, relocation] of words.get(id)!) relocations.push({ at, offset, target: regionIndex(relocation.region), scale: relocation.scale })
    }
    verifyImage(regions, relocations)
    const out: number[] = []
    const scratch = new DataView(new ArrayBuffer(8))
    const u32 = (value: number) => {
        scratch.setUint32(0, value >>> 0, true)
        for (let i = 0; i < 4; i++) out.push(scratch.getUint8(i))
    }
    const u64 = (value: number | bigint) => {
        scratch.setBigUint64(0, BigInt.asUintN(64, BigInt(value)), true)
        for (let i = 0; i < 8; i++) out.push(scratch.getUint8(i))
    }
    const pad = () => {
        while (out.length % 8) out.push(0)
    }
    const chunks: Uint8Array[] = []
    const flush = () => {
        chunks.push(new Uint8Array(out))
        out.length = 0
    }
    const section = (kind: number, count: number) => {
        u32(kind)
        u32(count)
    }
    for (const c of imageMagic) out.push(c.charCodeAt(0))
    u32(imageVersion)
    u32(4)
    section(ImageSection.regions, regions.length)
    for (const region of regions) {
        u32(region.kind)
        u32(region.index)
        u64(region.base)
        u64(region.size)
    }
    let segments = 0
    for (const region of regions) segments += region.segments.length
    section(ImageSection.memory, segments)
    for (let at = 0; at < regions.length; at++) {
        for (const segment of regions[at].segments) {
            u32(at)
            u32(0)
            u64(segment.offset)
            u64(segment.bytes.length)
            flush()
            chunks.push(segment.bytes)
            const tail = segment.bytes.length % 8
            if (tail) chunks.push(new Uint8Array(8 - tail))
        }
    }
    section(ImageSection.relocations, relocations.length)
    for (const relocation of relocations) {
        u32(relocation.at)
        u32(relocation.target)
        u64(relocation.offset)
        u64(relocation.scale)
    }
    const entries = [...capture.roots.map(root => ({ ...root, init: false })), ...(capture.init === undefined ? [] : [{ name: staticInitName, offset: capture.init, float: false, floats: 0, returns: undefined, init: true }])]
    section(ImageSection.entries, entries.length)
    for (const entry of entries) {
        const name = new TextEncoder().encode(entry.name)
        u64(entry.offset)
        u32(((entry.float ? EntryFlags.float : 0) | (entry.init ? EntryFlags.init : 0) | (entry.returns === 'word' ? EntryFlags.word : 0) | (entry.returns === 'string' ? EntryFlags.string : 0)) + entry.floats * 65536)
        u32(name.length)
        for (const byte of name) out.push(byte)
        pad()
    }
    flush()
    let length = 0
    for (const chunk of chunks) length += chunk.length
    if (flags.has('image-stats')) console.log(`IMAGE ${capture.roots.map(root => root.name).join(',')} ${length} bytes, code ${capture.code.length}, ${regions.length} regions, ${segments} segments, ${relocations.length} relocations${capture.init === undefined ? '' : ', init'}`)
    const bytes = new Uint8Array(length)
    let at = 0
    for (const chunk of chunks) {
        bytes.set(chunk, at)
        at += chunk.length
    }
    return bytes
}

export function withRegionsProtected<T>(run: () => T): T {
    const data: NativeRegion[] = nativeRegions.filter(region => region.kind !== RegionKind.code)
    for (const region of data) protectNative(region.base, align(region.size, 4096), syscalls.PROT_NONE)
    for (const page of codePages) protectNative(page.ptr, page.length, syscalls.PROT_NONE)
    try {
        return run()
    } finally {
        for (const region of data) protectNative(region.base, align(region.size, 4096), syscalls.PROT_READ | syscalls.PROT_WRITE)
        for (const page of codePages) protectNative(page.ptr, page.length, page.sealed ? syscalls.PROT_READ | syscalls.PROT_EXEC : syscalls.PROT_READ | syscalls.PROT_WRITE)
    }
}

function segmentAt(segments: ImageSegment[], offset: number): ImageSegment | undefined {
    let low = 0
    let high = segments.length - 1
    while (low <= high) {
        const middle = (low + high) >> 1
        const segment = segments[middle]
        if (offset < segment.offset) high = middle - 1
        else if (offset >= segment.offset + segment.bytes.length) low = middle + 1
        else return segment
    }
}

export function loadImage(bytes: Uint8Array): Record<string, any> {
    getNativeBootstraps()
    const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
    let at = 0
    const u32 = (): number => {
        const value = view.getUint32(at, true)
        at += 4
        return value
    }
    const u64 = (): bigint => {
        const value = view.getBigUint64(at, true)
        at += 8
        return value
    }
    const align8 = () => {
        at = (at + 7) & ~7
    }
    let magic = ''
    for (let i = 0; i < imageMagic.length; i++) magic += String.fromCharCode(bytes[at++])
    if (magic !== imageMagic) throw 'native: not a native image'
    const version = u32()
    if (version !== imageVersion) throw `native: image version ${version} is not ${imageVersion}`
    const sections = u32()
    const regions: ImageRegion[] = []
    const relocations: ImageRelocation[] = []
    const entries: { name: string, offset: number, flags: number }[] = []
    for (let s = 0; s < sections; s++) {
        const kind = u32()
        const count = u32()
        for (let i = 0; i < count; i++) {
            if (kind === ImageSection.regions) {
                const regionKind = u32()
                const index = u32()
                const base = Number(u64())
                const size = Number(u64())
                regions.push({ kind: regionKind, index, base, size, segments: [] })
            } else if (kind === ImageSection.memory) {
                const region = u32()
                u32()
                const offset = Number(u64())
                const length = Number(u64())
                regions[region].segments.push({ offset, bytes: bytes.slice(at, at + length) })
                at += length
                align8()
            } else if (kind === ImageSection.relocations) {
                const where = u32()
                const target = u32()
                const offset = Number(u64())
                const scale = Number(BigInt.asIntN(64, u64()))
                relocations.push({ at: where, offset, target, scale })
            } else if (kind === ImageSection.entries) {
                const offset = Number(u64())
                const flags = u32()
                const length = u32()
                const name = new TextDecoder().decode(bytes.subarray(at, at + length))
                at += length
                align8()
                entries.push({ name, offset, flags })
            } else throw `native: unknown image section ${kind}`
        }
    }
    const bases: number[] = []
    for (const region of regions) {
        const slack = region.kind === RegionKind.code ? 4096 : 0
        const guarded = region.kind === RegionKind.pstack || region.kind === RegionKind.heap
        const mapped = guarded ? mapGuarded(region.size) : Number(nativeMapper(align(region.size + slack, 4096)))
        if (!mapped || mapped === -1) throw 'native: failed to map an image region'
        bases.push(region.kind === RegionKind.code ? mapped + (region.base & 4095) : mapped)
    }
    for (const relocation of relocations) {
        const segment = segmentAt(regions[relocation.at].segments, relocation.offset)
        if (!segment || relocation.offset + 8 > segment.offset + segment.bytes.length) throw `native: relocation at ${relocation.offset} is outside the image memory`
        const word = new DataView(segment.bytes.buffer, segment.bytes.byteOffset + relocation.offset - segment.offset, 8)
        const delta = BigInt(bases[relocation.target] - regions[relocation.target].base) * BigInt(relocation.scale)
        word.setBigUint64(0, BigInt.asUintN(64, word.getBigUint64(0, true) + delta), true)
    }
    let code = -1
    for (let i = 0; i < regions.length; i++) {
        if (regions[i].kind === RegionKind.code) code = i
        for (const segment of regions[i].segments) {
            const outer = heldArgs
            heldArgs = segment.bytes
            const copied = nativeCopier(bases[i] + segment.offset, addPtr((ts as any).getArrayBufferPtr(segment.bytes.buffer), segment.bytes.byteOffset), segment.bytes.length)
            heldArgs = outer
            if (!copied) throw 'native: failed to copy an image segment'
        }
    }
    if (code < 0) throw 'native: the image has no code'
    const starts = entries.map(entry => entry.offset).sort((a, b) => a - b)
    codeObserver?.(entries.map(entry => codeLine(bases[code] + entry.offset, (starts.find(start => start > entry.offset) ?? regions[code].size) - entry.offset, undefined, entry.name)).join('\t'))
    const page: CodePage = { ptr: bases[code] - (regions[code].base & 4095), length: align(regions[code].size + 4096, 4096), used: 0, sealed: false }
    sealCode(page)
    let heapBase = 0
    for (let i = 0; i < regions.length; i++) if (regions[i].kind === RegionKind.heap) heapBase = bases[i]
    const result: Record<string, any> = {}
    for (const entry of entries) {
        const ptr = bases[code] + entry.offset
        if (entry.flags & EntryFlags.init) {
            const none = new BigInt64Array(1)
            nativeInvoker(ptr, (ts as any).getArrayBufferPtr(none.buffer), 0)
            continue
        }
        const returns: HostReturn | undefined = entry.flags & EntryFlags.string ? 'string' : entry.flags & EntryFlags.word ? 'word' : undefined
        result[entry.name] = Object.assign((...args: any[]) => {
            const raw = invokeRoot(ptr, args, entry.flags >>> 16)
            if (entry.flags & EntryFlags.float) return floatBits(raw)
            return returns ? hostResult(raw, returns, heapBase) : raw
        }, { ptr, bases, regions: regions.map((region, i) => ({ kind: region.kind, index: region.index, base: bases[i], size: region.size, original: region.base })) })
    }
    return result
}

const staticInitName = '[[Init]]'

function staticInitializerOf(linker: Linker, image: ProgramImage, keep: (fn: Function) => boolean): Function | undefined {
    const { staticFns, staticOrder } = linker
    if (!staticFns.length) return
    const size = Math.max(staticFns.length * 8, 1 << 12)
    const table = Number(nativeMapper(size))
    if (!table || table === -1) throw 'native: failed to map the static table'
    image.staticTable.base = table
    image.staticTable.region = addRegion(RegionKind.table, 0, table, size)
    return staticInitializer(staticOrder().filter(slot => keep(staticFns[slot])).map(slot => [staticFns[slot], slot] as [Function, number]), symbolicMemory(table))
}

function staticInitializer(steps: [Function, number][], table: usize): () => void {
    const captures = [Intrinsics, Types, table, ...steps.map(([fn]) => fn)]
    const stores = steps.map(([, slot], i) =>
        `$0.store($2, ${slot * 8}, $0.bitconvert($${i + 3}(), $1.vm_value, $1.u64), $1.u64);`)
    return inlineComputation(`function initializeStatics() {\n${stores.join('\n')}\n}`, captures, 0) as () => void
}

function copyInto(elements: any[]): () => any {
    return () => {
        const out = new Array()
        if (elements.length) out.reserve(elements.length)
        for (let i = 0; i < elements.length; i++) out[i] = elements[i]
        return out
    }
}

export function createNative(fn: Function) {
    return createNatives({ fn }).fn
}

// cyclic
const traceModule = await import('./trace2')
const trace2 = traceModule.trace2
const createTraceSession = traceModule.createTraceSession
const symbolicMemory = traceModule.symbolicMemory
const fastTraceModule = await import('./fast-trace')
const normalizeStats: [string, number, boolean][] = []

export async function suite() {
    const harness = await import('./harness')
    function graphOf(op: NodeOp, value: number, label?: string): { graph: Graph, value: number, ret: number } {
        const graph = createGraph({})
        const root = addNode(graph, NodeOp.block, [])
        const node = addNode(graph, op, [{ literal: value }])
        const ret = addNode(graph, NodeOp.ret, [node, root])
        graph.root = root
        setGraphBlocks(graph, [{ id: root, params: [], bodyId: ret, bodyConst: 0 }])
        if (label !== undefined) setDebugLabel(graph, node, label)
        return { graph, value: node, ret }
    }
    function returned(graph: Graph): GraphNode {
        return getNode(graph, graph.blocks[0].bodyId)!
    }
    function test(name: string, run: (tag: string) => void): void {
        const tag = `cache-test:${name}`
        harness.test(name, () => {
            try {
                run(tag)
            } finally {
                for (const key of [...optimizedGraphs.keys()]) {
                    if (key.startsWith(`${tag}|`)) optimizedGraphs.delete(key)
                }
                optimizedCacheStats?.delete(tag)
            }
        })
    }
    test('cacheFixedHandles', tag => {
        for (const handle of [heap.undefinedHandle, heap.nullHandle, heap.trueHandle, heap.fromJsString('cached')]) {
            const input = graphOf(NodeOp.heapHandle, handle)
            const expected = isNullishValue(input.graph, input.value) ? 1 : 0
            const out = optimizeOnce(input.graph, tag, () => {
                putNode(input.graph, input.ret, NodeOp.ret, [{ literal: expected }, input.graph.root])
                deleteNode(input.graph, input.value)
                return input.graph
            })
            if (getLiteral(out, returned(out), 0) !== expected) harness.fail('cache reused a different fixed handle')
        }
    })
    test('cacheFixedHandleAsLiteral', tag => {
        const input = graphOf(NodeOp.heapHandle, heap.undefinedHandle)
        const key = canonicalGraph(input.graph, tag).key
        const out = optimizeOnce(input.graph, tag, () => {
            putNode(input.graph, input.ret, NodeOp.ret, [{ literal: 8 }, input.graph.root])
            deleteNode(input.graph, input.value)
            return input.graph
        })
        if (!optimizedGraphs.get(key) || getLiteral(out, returned(out), 0) !== 8) harness.fail('a field offset must not be mistaken for a fixed handle binding')
    })
    test('cacheRebindTargets', tag => {
        const first = graphOf(NodeOp.localTarget, 11, 'first target')
        optimizeOnce(first.graph, tag, () => first.graph)
        const second = graphOf(NodeOp.localTarget, 29, 'second target')
        const out = optimizeOnce(second.graph, tag, () => second.graph)
        const value = getRef(returned(out), 0)
        if (getLiteral(out, getNode(out, value)!, 0) !== 29 || getDebugLabel(out, value) !== 'second target') harness.fail('cached target values and labels must bind to the current compilation')
    })
    test('cacheLiteralChanges', tag => {
        for (const value of [3, 9, 3]) {
            const input = graphOf(NodeOp.literal, value)
            const out = optimizeOnce(input.graph, tag, () => input.graph)
            if (getLiteral(out, getNode(out, getRef(returned(out), 0))!, 0) !== value) harness.fail('cached literals must be part of the key')
        }
    })
    harness.test('cacheGenericCaptures', () => {
        function reader(offset: number) {
            return function read(n: u32): number {
                const map = new Map<number, number>()
                map.set(n, n + offset)
                return map.get(n)!
            }
        }
        for (const offset of [2, 7, 11]) {
            const fn = reader(offset)
            const read = createNatives({ read: fn }).read
            for (const n of [0, 4]) {
                if (Number(read(n)) !== fn(n)) harness.fail('cached generic methods reused a previous capture')
            }
        }
    })
}
