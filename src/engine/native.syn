        let bySite = fieldInstances.get(caller)
        if (!bySite) fieldInstances.set(caller, bySite = new Map())
        const id = `${site}/${key}/${shape}`
        const known = bySite.get(id)
        if (known !== undefined) return known
        const instance = cloneInstance(shape)
        bySite.set(id, instance)
        return instance
    }
    function instanceShape(caller: Function, shape: intrinsics.Handle, site: number): intrinsics.Handle {
        let bySite = instances.get(caller)
        if (!bySite) instances.set(caller, bySite = new Map())
        const known = bySite.get(site)
        if (known !== undefined) return known
        const instance = cloneInstance(shape)
        bySite.set(site, instance)
        return instance
    }
    function cloneInstance(shape: intrinsics.Handle): intrinsics.Handle {
        const instance = heap.shallowClone(shape)
        for (const facts of [refinements, fixed, pointees]) {
            const entry = facts.get(shape)
            if (entry) facts.set(instance, new Map(entry))
        }
        const located = locationFacts.get(shape)
        if (located) locationFacts.set(instance, new Map(located))
