    function owner(shape: intrinsics.Handle, path: string): { shape: intrinsics.Handle, path: string } {
        const segments = path.split('/')
        for (let i = 1; i < segments.length; i++) {
            const inner = locationFacts.get(shape)?.get(segments.slice(0, i).join('/'))
            if (inner?.shape === undefined) continue
            const rest = segments.slice(i).join('/')
            return owner(inner.shape, rebasePath(rest, inner.base ?? 0))
        }
        return { shape, path }
    }
    function factAt(shape: intrinsics.Handle | undefined, path: string, missing?: intrinsics.Handle[]): Fact | undefined {
        if (shape === undefined) return
        if (!path) return { shape, encoded: false }
        return resolveFact(shape, path, missing, new Set())
    }
    function concreteOf(fact: Fact): Fact | undefined {
        if (!fact.from) return fact
        return fact.shape !== undefined || fact.number ? { shape: fact.shape, encoded: fact.encoded, number: fact.number, float: fact.float, base: fact.base } : undefined
    }
    const peers = new Map<intrinsics.Handle, Set<intrinsics.Handle>>()
    const joins = new Map<intrinsics.Handle, Set<intrinsics.Handle>>()
    function unifyShapes(a: intrinsics.Handle, b: intrinsics.Handle): void {
        if (a === b) return
        let joined = joins.get(a)
        if (!joined) joins.set(a, joined = new Set())
        if (!joined.has(b)) {
            joined.add(b)
            let other = joins.get(b)
            if (!other) joins.set(b, other = new Set())
            other.add(a)
            for (const path of new Set([...locationFacts.get(a)?.keys() ?? [], ...locationFacts.get(b)?.keys() ?? []])) sameRepresentation(a, b, path)
        }
        let left = peers.get(a)
        if (!left) peers.set(a, left = new Set())
        let right = peers.get(b)
        if (!right) peers.set(b, right = new Set())
        left.add(b)
        right.add(a)
    }
    function elementSiblings(shape: intrinsics.Handle, path: string): string[] {
        const slash = path.lastIndexOf('/')
        if (slash < 0) return []
        const prefix = path.slice(0, slash + 1)
        const last = path.slice(slash + 1)
        const facts = locationFacts.get(shape)
        if (last === '*') return [...facts?.keys() ?? []].filter(key => key.startsWith(prefix) && /^\d+$/.test(key.slice(prefix.length)))
        return /^\d+$/.test(last) && facts?.has(`${prefix}*`) ? [`${prefix}*`] : []
    }
    function wideFact(shape: intrinsics.Handle, path: string): Fact | undefined {
        const slash = path.lastIndexOf('/')
        const last = path.slice(slash + 1)
        if (slash < 0 || (last !== '*' && !/^\d+$/.test(last))) return
        return resolveFact(shape, `${path.slice(0, slash + 1)}*`, undefined, new Set(), false)
    }
    function boxedNumber(shape: intrinsics.Handle, path: string, fact: Fact | undefined): boolean {
        if (!fact?.number || fact.shape !== undefined || fact.float) return false
        const wide = wideFact(shape, path)
        return !!wide?.number && wide.shape !== undefined
    }
    function representation(fact: Fact | undefined): string {
        if (!fact?.encoded) return 'raw'
        if (fact.float) return 'boxed'
        if (fact.number) return fact.shape === undefined ? 'raw' : 'union'
        return 'word'
    }
    interface RouteSearch {
        routes: Map<intrinsics.Handle, string[]>
        work: intrinsics.Handle[]
        head: number
    }
    function routeSearch(from: intrinsics.Handle): RouteSearch {
