            console.log('native trace cost', current.name || '<anonymous>', traceOps)
        }
        const lifted = entry.returns ? { graph: closed.graph } as ReturnType<typeof liftReturnedHeapValues> : liftReturnedHeapValues(closed.graph)
        let tracedGraph = lifted.graph
        tracedGraph.name = current.name
        if (traceDebug) console.log(traced.text)
        if (traceDebug) console.log('native summary', { wrapper: !!lifted.wrapper })
        if (lifted.wrapper) returnWrappers.set(current, lifted.wrapper)
        if (projected) {
            if (intrinsics.argv().includes('native-decisions')) {
                console.log(`DECIDE ${current.name || '<anon>'} sym=${symbol} nodes=${tracedGraph.nodes.size} projected=true`)
            }
            inlineScores.set(current, false)
            returnCallers.push({ fn: current, symbol, graph: tracedGraph })
            return
        }
        const shouldNotInline = closed.closures || (current as any).shouldNotInline || lifted.wrapper || (tracedGraph.nodes.size <= 150 && !obviousInline(tracedGraph))
        const shape = shouldNotInline && !lifted.wrapper && !entry.returns ? returnedShape(tracedGraph) : undefined
        if (intrinsics.argv().includes('native-decisions')) {
            console.log(`DECIDE ${current.name || '<anon>'} sym=${symbol} nodes=${tracedGraph.nodes.size}`
                + ` projected=false shouldNotInline=${!!shouldNotInline} wrapper=${!!lifted.wrapper}`
                + ` tagged=${!!(current as any).shouldNotInline} shape=${!!shape}`)
        }
        if (shape) {
            if (shouldNotInline || (tracedGraph.nodes.size <= 50 && !obviousInline(tracedGraph))) {
                inlineScores.set(current, false)
                returnRecords.set(symbol, { fn: current, symbol, graph: tracedGraph, ...shape })
                return
            }
        }
        if (opaque) {
            if (intrinsics.argv().includes('native-opaque')) console.log(`opaque ${current.name || '<anon>'} sym=${symbol}\n${dumpGraph(tracedGraph)}`)
            const inspect = intrinsics.argv().includes('native-shapes')
            const shaped = !!(current as any).shouldNotInline
            inlineScores.set(current, inspect || shaped ? false : { cost: 0, pressure: 0 })
            if (inspect) opaqueGraphs.set(symbol, tracedGraph)
            if (shaped) shapedCallees.push({ fn: current, symbol, computation: intrinsics.getComputation(current), mapCapture })
            return
        }
        tracedGraph = normalize(tracedGraph, { firstPass: true })
        const score = closed.closures || (current as any).shouldNotInline || lifted.wrapper
            ? undefined : obviousInline(tracedGraph)
        inlineScores.set(current, score ?? false)
        if (score && intrinsics.argv().includes('native-inline')) {
            console.log('native inline', current.name, score)
        }
        entry.unit = tracedGraph
        resolveHandles(tracedGraph)
        pending.push({ fn: current, symbol, graph: tracedGraph })
    }
    function referenced(unit: DeferredUnit): boolean {
        if (image.hasFunctionSlot(unit.symbol)) return true
        for (const graph of [...pending.map(u => u.graph), ...returnCallers.map(c => c.graph), ...[...returnRecords.values()].map(r => r.graph)]) {
            for (const n of graph.nodes.values()) {
                if (n.op !== 'call') continue
                if (linkedCallee(graph, n) === unit.fn) return true
                const target = graph.nodes.get(getRef(n, 1))
                if (target?.op === 'local-target' && !getRef(target, 0) && getLiteral(target, 0) === unit.symbol) return true
            }
        }
        return false
    }
    const typerStats = intrinsics.argv().includes('typer-stats')
    const typerStart = performance.now()
    const typed = typer.createTyper(session)
    for (const symbol of roots.values()) typed.root(functions[symbol])
    if (typed.run()) {
        const agreed = new Map<CompiledSource, Map<number, string>>()
        for (const unit of typed.units) {
            let sites = agreed.get(unit.source)
            if (!sites) agreed.set(unit.source, sites = new Map())
            for (const site of unit.sites.values()) {
                const prior = sites.get(site.pc)
                sites.set(site.pc, prior === undefined || prior === site.result ? site.result : 'unknown')
            }
        }
        for (const [source, sites] of agreed) {
            const code = source.compiled.code
            for (const [pc, result] of sites) {
                if (result === 'unknown') continue
                const at = code[pc] === Op.Width2 || code[pc] === Op.Width4 || code[pc] === Op.Width8 ? pc + 1 : pc
                intrinsics.assert(code[at] === Op.AddOrConcat, `native: typer site @${pc} is not an AddOrConcat`)
                code[at] = result === 'numeric' ? Op.Add : Op.Concat
            }
        }
    }
    const typerMs = performance.now() - typerStart
    const unreferenced: DeferredUnit[] = []
    do {
        traceUnits()
        while (deferredUnits.length) {
            const unit = deferredUnits.pop()!
            if (!referenced(unit)) {
                unreferenced.push(unit)
                continue
            }
            specializeDeferred(unit)
            traceUnits()
        }
        installReturnSlots()
    } while (tracedUnits < order.length)
    for (const unit of unreferenced) if (referenced(unit)) throw `native: ${unit.fn.name} was deferred as unreferenced but is called`
    if (typerStats) {
        const counts = { numeric: 0, string: 0, unknown: 0 }
        const typedSources = new Set<CompiledSource>()
        for (const unit of typed.units) {
            typedSources.add(unit.source)
            for (const site of unit.sites.values()) counts[site.result]++
        }
        let untypedFns = 0
        let untypedSites = 0
        for (const fn of fnGraphs.keys()) {
            const code = codeOf(fn)
            if (!code || typedSources.has(code.source)) continue
            untypedFns++
            untypedSites += typer.countAddSites(code.source.compiled)
        }
        console.log(`typer [${[...roots.keys()].join(',')}] ${typerMs.toFixed(1)}ms units=${typed.units.length} numeric=${counts.numeric} string=${counts.string} unknown=${counts.unknown} | traced-untyped fns=${untypedFns} sites=${untypedSites}`)
    }
    enterPhase('reconcile')
    for (const shaped of shapedCallees) reconcileShapes(shaped)
    reconcileReturns()
    tagReturns()
    enterPhase('other')

    interface TaggedReturn {
        sentinel: number
        rets: { select: number, tag: number, payload: number }[]
    }
    function tokenSlot(n: GraphNode, i: number): boolean {
        if (n.op === 'after') return i < countIds(n) - 1
        if (n.op === 'get') return i === 0
        return i === 0 && (n.op === 'load' || n.op === 'store' || n.op === 'call' || n.op === 'pstack')
    }
    function reachableRets(graph: Graph): number[] {
        const applied = new Set<number>([graph.blocks[0].id])
        const seen = new Set<number>()
        const work = [graph.blocks[0].bodyId]
        while (work.length) {
            const id = work.pop()!
            const n = id ? graph.nodes.get(id) : undefined
            if (!n || seen.has(id) || n.op === 'block') continue
            seen.add(id)
            if (n.op === 'apply' && !applied.has(getRef(n, 0))) {
                applied.add(getRef(n, 0))
                work.push(getBlock(graph, getRef(n, 0))!.bodyId)
            }
            for (let i = n.op === 'apply' ? 1 : 0; i < countIds(n); i++) work.push(getRef(n, i))
        }
        const rets: number[] = []
        function walk(id: number): void {
            const n = id ? graph.nodes.get(id) : undefined
            if (n?.op === 'ret') rets.push(id)
            if (n?.op === 'after') walk(getRef(n, countIds(n) - 1))
            if (n?.op === 'select') {
                walk(getRef(n, 1))
                walk(getRef(n, 2))
            }
        }
        for (const b of graph.blocks) if (applied.has(b.id)) walk(b.bodyId)
        return rets
    }
    function excludes(graph: Graph, cond: number, value: number, k: number): boolean {
        const c = cond ? graph.nodes.get(cond) : undefined
        if (!c) return false
        if (c.op === 'param') {
            const block = graph.blocks.find(b => b.params.includes(cond))
            const at = block?.params.indexOf(value) ?? -1
            if (!block || at < 0) return false
            const of = block.params.indexOf(cond)
            let arrived = false
            for (const n of graph.nodes.values()) {
                if (n.op !== 'apply' || getRef(n, 0) !== block.id) continue
                if (!excludes(graph, getRef(n, of + 1), getRef(n, at + 1), k)) return false
                arrived = true
            }
            return arrived
        }
        if (c.op === 'and') return excludes(graph, getRef(c, 0), value, k) || excludes(graph, getRef(c, 1), value, k)
        if (k !== -1 || (c.op !== 'lt' && c.op !== 'gt')) return false
        if (isSignedType(operandType(graph, c, 0)) || isSignedType(operandType(graph, c, 1))) return false
        return getRef(c, c.op === 'lt' ? 0 : 1) === value
    }
    function taggedReturn(graph: Graph): TaggedReturn | undefined {
        const rets = reachableRets(graph)
        if (!rets.length) return
        let sentinel: number | undefined
        const out: TaggedReturn['rets'] = []
        for (const ret of rets) {
            let value = getRef(graph.nodes.get(ret)!, 0)
            for (let m = graph.nodes.get(value); m?.op === 'after'; m = graph.nodes.get(value)) value = getRef(m, countIds(m) - 1)
            const n = value ? graph.nodes.get(value) : undefined
            if (n?.op !== 'select' || countIds(n) !== 3 || !getRef(n, 0) || !getRef(n, 1) || getRef(n, 2)) return
            const k = getLiteral(n, 2)
            if (sentinel !== undefined && sentinel !== k) return
            sentinel = k
            if (!excludes(graph, getRef(n, 0), getRef(n, 1), k)) return
            out.push({ select: value, tag: getRef(n, 0), payload: getRef(n, 1) })
        }
        return { sentinel: sentinel!, rets: out }
    }
    function names(graph: Graph, n: GraphNode, fn: Function, symbol: number): boolean {
        if (getRef(n, 0)) return false
        if (n.op === 'local-target') return getLiteral(n, 0) === symbol
        return n.op === 'heap-handle' && session.stubFunctions.get(getLiteral(n, 0) as u32) === fn
    }
    function escapes(graph: Graph, id: number): boolean {
        for (const [uid, u] of graph.nodes) {
            for (let i = 0; i < countIds(u); i++) {
                if (getRef(u, i) !== id) continue
                if (u.op === 'call' && i === 1) continue
                if (u.op === 'after' && i === countIds(u) - 1 && !escapes(graph, uid)) continue
                return true
            }
        }
        return false
    }
    function substitute(graph: Graph, id: number, from: number, to: number, memo: Map<number, number>): number {
        if (id === from) return to
        const known = memo.get(id)
        if (known !== undefined) return known
        const n = id ? graph.nodes.get(id) : undefined
        memo.set(id, id)
        if (!n || n.op === 'block' || n.op === 'param' || n.op === 'call') return id
        let rewritten: GraphNode | undefined
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref || (n.op === 'apply' && i === 0) || tokenSlot(n, i)) continue
            const next = substitute(graph, ref, from, to, memo)
            if (next === ref) continue
            rewritten ??= copyNode(n)
            setRef(rewritten, i, next)
        }
        if (!rewritten) return id
        const copy = freshId(graph)
        graph.nodes.set(copy, rewritten)
        memo.set(id, copy)
        return copy
    }
    function tagCallSite(graph: Graph, call: number, sentinel: number): void {
        const tag = freshId(graph)
        graph.nodes.set(tag, makeNode('get', [call, { literal: 1 }]))
        const payload = freshId(graph)
        graph.nodes.set(payload, makeNode('get', [call, 0]))
        const tests = new Map<number, number>()
        for (const [id, n] of [...graph.nodes]) {
            if ((n.op !== 'eq' && n.op !== 'ne') || countIds(n) !== 2) continue
            const at = getRef(n, 0) === call ? 1 : getRef(n, 1) === call ? 0 : -1
            if (at < 0 || getRef(n, at) || getLiteral(n, at) !== sentinel) continue
            graph.nodes.set(id, makeNode(n.op, [tag, 0], intrinsics.Types.bool))
            tests.set(id, n.op === 'eq' ? 2 : 1)
        }
        for (const [id, n] of [...graph.nodes]) {
            if (n.op !== 'select' || countIds(n) !== 3) continue
            const arm = tests.get(getRef(n, 0))
            if (arm === undefined) continue
            const replaced = substitute(graph, getRef(n, arm), call, payload, new Map())
            if (replaced === getRef(n, arm)) continue
            const copy = copyNode(n)
            setRef(copy, arm, replaced)
            graph.nodes.set(id, copy)
        }
        let rebuilt = 0
        for (const [id, n] of [...graph.nodes]) {
            if (id === tag || id === payload) continue
            let copy: GraphNode | undefined
            for (let i = 0; i < countIds(n); i++) {
                if (getRef(n, i) !== call || tokenSlot(n, i)) continue
                if (!rebuilt) {
                    rebuilt = freshId(graph)
                    graph.nodes.set(rebuilt, makeNode('select', [tag, payload, { literal: sentinel }]))
                }
                copy ??= copyNode(n)
                setRef(copy, i, rebuilt)
            }
            if (copy) graph.nodes.set(id, copy)
        }
    }
    function tagReturns(): void {
        const rootSymbols = new Set<number>(roots.values())
        for (const unit of pending) {
            if (rootSymbols.has(unit.symbol)) continue
            const summary = taggedReturn(unit.graph)
            if (!summary) continue
            const sites: [PendingUnit, number][] = []
            let escaped = false
            for (const other of pending) {
                for (const [id, n] of other.graph.nodes) {
                    if (!names(other.graph, n, unit.fn, unit.symbol)) continue
                    if (escapes(other.graph, id)) escaped = true
                }
                for (const [id, n] of other.graph.nodes) {
                    if (n.op === 'call' && calledFunction(other.graph, n) === unit.fn) sites.push([other, id])
                }
            }
            if (escaped || !sites.length) continue
            const tested = sites.some(([other, call]) => [...other.graph.nodes.values()].some(n =>
                (n.op === 'eq' || n.op === 'ne') && countIds(n) === 2
                && ((getRef(n, 0) === call && !getRef(n, 1) && getLiteral(n, 1) === summary.sentinel)
                    || (getRef(n, 1) === call && !getRef(n, 0) && getLiteral(n, 0) === summary.sentinel))))
            if (!tested) continue
            const replace = new Map<number, number>()
            for (const r of summary.rets) {
                const record = freshId(unit.graph)
                unit.graph.nodes.set(record, makeNode('record', [0, r.payload, { literal: 1 }, r.tag]))
                replace.set(r.select, record)
            }
            for (const [id, n] of [...unit.graph.nodes]) {
                if (n.op !== 'ret' && n.op !== 'after') continue
                const at = n.op === 'ret' ? 0 : countIds(n) - 1
                const to = replace.get(getRef(n, at))
                if (to === undefined) continue
                const copy = copyNode(n)
                setRef(copy, at, to)
                unit.graph.nodes.set(id, copy)
            }
            const touched = new Set<PendingUnit>([unit])
            for (const [other, call] of sites) {
                tagCallSite(other.graph, call, summary.sentinel)
                touched.add(other)
            }
            for (const u of touched) {
                u.graph = normalize({ ...u.graph, name: u.fn.name }, { firstPass: true })
                resolveHandles(u.graph)
            }
            if (intrinsics.argv().includes('native-decisions')) console.log(`TAGGED ${unit.fn.name} sentinel=${summary.sentinel} sites=${sites.length}`)
        }
    }
    function functionSlot(symbol: number): number {
        return image.functionSlot(symbol, functions[symbol]?.name || `${symbol}`)
    }
    function resolveHandles(graph: Graph): void {
        const functionHandleSlots = image.functionHandles
        const dataHandleSlots = image.dataHandles
        for (const n of graph.nodes.values()) {
            if (n.op !== 'heap-handle') continue
            const handle = heap.deref(getLiteral(n, 0) as intrinsics.Handle)
            if (session.constructions.has(getLiteral(n, 0) as u32)) {
                dataHandleSlots.set(handle, image.constructionSlot(getLiteral(n, 0), session.constructions.get(getLiteral(n, 0) as u32)!.graph))
                continue
            }
            const closure = closureSymbols.get(handle as u32) ?? (session.templateOf(handle as u32) ? symbols.get(closureFunction(handle as u32, 'closure')) : undefined)
            if (closure !== undefined) {
                functionHandleSlots.set(handle, functionSlot(closure))
                continue
            }
            if (handle && heap.cellViewOf(heap.typeDescriptorOf(handle as intrinsics.Handle))) {
                mirrorCell(handle)
                continue
            }
            if (!heap.isCallable(handle as intrinsics.Handle)) {
                dataHandleSlots.set(handle, heap.isString(handle as intrinsics.Handle)
                    ? image.stringSlot(heap.stringToJs(handle as intrinsics.Handle))
                    : image.pointerSlot(handle, !handle ? 'nullish' : heap.isOrdinaryObject(handle as intrinsics.Handle) ? describe(handle as intrinsics.Handle) : `@${handle}`))
                continue
            }
            const linked = session.stubFunctions.get(getLiteral(n, 0)) as any
            if (!linked) throw `native: heap handle ${handle} is not a linked function`
            if (isLocalStub(linked)) {
                functionHandleSlots.set(handle, functionSlot(linked.__localTarget))
                continue
            }
            if (Number.isSafeInteger(linked.__native)) {
                functionHandleSlots.set(handle, image.pointerSlot(linked.__native, `native ${linked.name || linked.__native}`))
                continue
            }
            const target = intern(linked)
            if (!visited.has(linked)) {
                discover(linked)
                schedule(linked)
            }
            functionHandleSlots.set(handle, functionSlot(target))
        }
    }

    function reconcileShapes(shaped: ShapedCallee): void {
        const sites: [graph: Graph, id: number, call: GraphNode][] = []
        for (const unit of pending) {
            for (const [id, n] of unit.graph.nodes) {
                if (n.op !== 'call') continue
                const target = unit.graph.nodes.get(getRef(n, 1))
                if (!target || target.op !== 'local-target') continue
                if (getLiteral(target, 0) !== shaped.symbol) continue
                sites.push([unit.graph, id, n])
            }
        }
        if (!sites.length) throw `native: ${shaped.fn.name} has no call sites to reconcile`
        const arity = countIds(sites[0][2]) - 3
        const shapes: (intrinsics.Handle | undefined)[] = []
        for (let i = 0; i < arity; i++) shapes.push(snapshotOf(sites[0][0], getRef(sites[0][2], 3 + i)))
        for (const [graph, , call] of sites) {
            for (let i = 0; i < arity; i++) {
                if (sameSnapshotShape(shapes[i], snapshotOf(graph, getRef(call, 3 + i)))) continue
                throw `native: call sites of ${shaped.fn.name} disagree on the shape of p${i}`
            }
        }
        const outer = enterPhase('trace')
        const traced = trace2(shaped.computation[0], {
            captures: shaped.computation[1], session, mapCapture: shaped.mapCapture, shouldInline, returnTypeOf,
            name: shaped.fn.name, shapes, self: shaped.fn,
        })
        lowerPanics(traced.graph)
        linkRuntimeCalls(traced.graph)
        enterPhase(outer)
        if ([...traced.graph.nodes.values()].some(n => n.op === 'get-prop' || n.op === 'set-prop')) {
            throw `native: ${shaped.fn.name} still reads unshaped properties after reconciliation`
        }
        for (const [graph, id, call] of sites) {
            const operands = getOperands(call, 0, 3)
            for (let i = 0; i < arity; i++) {
                const shape = shapes[i]
                if (!shape) {
                    operands.push(getOperand(call, 3 + i))
                    continue
                }
                const arg = graph.nodes.get(getRef(call, 3 + i))!
                const fields = snapshotFields(shape)
                for (let k = 0; k < fields.length; k++) {
                    if (fields[k].shape === Types.handle) continue
                    operands.push(getOperand(arg, 2 + k))
                }
            }
            graph.nodes.set(id, copyNode(call, operands))
        }
        const lifted = liftReturnedHeapValues(traced.graph)
        const normalized = normalize({ ...lifted.graph, name: shaped.fn.name }, { firstPass: true })
        resolveHandles(normalized)
        pending.push({ fn: shaped.fn, symbol: shaped.symbol, graph: normalized })
    }

    function reconcileReturns(): void {
        const wanted = new Map<number, Set<number>>()
        for (const caller of returnCallers) {
            for (const n of caller.graph.nodes.values()) {
                if (n.op !== 'get-prop') continue
                const symbol = calleeSymbol(caller.graph, getRef(n, 1))!
                let keys = wanted.get(symbol)
                if (!keys) wanted.set(symbol, keys = new Set())
                keys.add(getLiteral(n, 2))
            }
        }
        if (intrinsics.argv().includes('native-decisions')) {
            console.log(`WANTED ${[...wanted].map(([sym, keys]) => `${functions[sym]?.name || sym}:${keys.size}`).join(' ')}`)
            console.log(`RECORDS ${[...returnRecords.keys()].map(k => functions[k]?.name || k).join(' ')}`)
            console.log(`CALLERS ${returnCallers.map(c => c.fn.name || '<anon>').join(' ')}`)
        }
        const layouts = new Map<number, Map<number, number>>()
        for (const [symbol, keys] of wanted) {
            const shape = returnRecords.get(symbol)
            const name = functions[symbol]?.name || `symbol ${symbol}`
            if (!shape) {
                const callers = returnCallers.filter(c => [...c.graph.nodes.values()].some(n =>
                    n.op === 'get-prop' && calleeSymbol(c.graph, getRef(n, 1)) === symbol))
                throw `native: ${name} does not return a record of its own`
                    + ` (wanted [${[...keys].join(', ')}] by ${callers.map(c => c.fn.name || '<anon>').join(', ')};`
                    + ` registered records: ${[...returnRecords.keys()].map(k => functions[k]?.name || k).join(', ')})`
            }
            const layout = shape.keys.filter(k => keys.has(k as number))
            if (layout.length !== keys.size) throw `native: ${name} does not own every projected key`
            if (layout.length > target.retRegs.length) throw `native: ${name} returns ${layout.length} projected fields`
            for (const graph of [...pending.map(u => u.graph), ...returnCallers.map(c => c.graph)]) {
                for (const call of callSitesOf(graph, symbol)) {
                    if (!callResultEscapes(graph, call)) continue
                    throw `native: the result of ${name} escapes in ${graph.name ?? 'anonymous graph'}`
                }
            }
            const at = new Map<number, number>()
            for (let i = 0; i < layout.length; i++) at.set(layout[i] as number, i)
            layouts.set(symbol, at)
            installReturnRecord(shape, layout)
        }
        for (const shape of returnRecords.values()) {
            const graph = normalize(shape.graph, { firstPass: true })
            resolveHandles(graph)
            pending.push({ fn: shape.fn, symbol: shape.symbol, graph })
        }
        for (const caller of returnCallers) {
            let nextId = caller.graph.maxId
            for (const [id, n] of [...caller.graph.nodes]) {
                if (n.op !== 'get-prop') continue
                const base = getRef(n, 1)
                const at = layouts.get(calleeSymbol(caller.graph, base)!)!.get(getLiteral(n, 2))!
                const read = nextId++
                caller.graph.nodes.set(read, makeNode('get', [base, { literal: at }]))
                caller.graph.nodes.set(id, makeNode('after', [getRef(n, 0), read]))
            }
            caller.graph.maxId = nextId
            const graph = normalize(caller.graph, { firstPass: true })
            resolveHandles(graph)
            pending.push({ fn: caller.fn, symbol: caller.symbol, graph })
        }
    }

    if (intrinsics.argv().includes('native-shapes')) {
        dumpCallShapes(pending, functions, opaqueGraphs)
        throw 'native: call shapes dumped'
    }
    function localizeCalls(graph: Graph): void {
        function valueOf(id: number): GraphNode | undefined {
            let n = graph.nodes.get(id)
            while (n?.op === 'after') n = graph.nodes.get(getRef(n, countIds(n) - 1))
            return n
        }
        for (const [id, n] of [...graph.nodes]) {
            if (n.op !== 'call') continue
            let target = valueOf(getRef(n, 1))
            const signature = target?.op === 'indirect-target' ? typeRefOf(target) : 0
            if (target?.op === 'indirect-target') target = valueOf(getRef(target, 0))
            if (target?.op !== 'heap-handle' || getRef(target, 0)) continue
            const handle = heap.deref(getLiteral(target, 0) as intrinsics.Handle)
            const slot = image.functionHandles.get(handle)
            const symbol = slot === undefined ? undefined : image.functionTargets.get(slot)
            if (symbol === undefined) continue
            const local = freshId(graph)
            if (!signature) {
                graph.nodes.set(local, makeNode('local-target', [{ literal: symbol }, { literal: 2 }], resultType(graph, n)))
                const copy = copyNode(n)
                setRef(copy, 1, local)
                graph.nodes.set(id, copy)
                continue
            }
            const callee = units.get(symbol)!
            const locations = callee.blocks[0].params.map(p => paramLocation(callee.nodes.get(p)!))
            const passed = fnLocations(graph.nodes.get(signature)!)
            const positional: Operand[] = []
            const located = new Map<number, Operand>()
            for (let i = 3; i < countIds(n); i++) {
                if ((passed[i - 3] ?? -1) < 0) positional.push(getOperand(n, i))
                else located.set(passed[i - 3], getOperand(n, i))
            }
            let next = 0
            const args = locations.map(at => at >= 0 ? located.get(at) ?? { literal: 0 }
                : next < positional.length ? positional[next++] : { literal: 0 })
            const fnType = freshId(graph)
            graph.nodes.set(fnType, createFnType(fnReturn(graph.nodes.get(signature)!), locations))
            graph.nodes.set(local, makeNode('local-target', [{ literal: symbol }, { literal: 2 }], { ref: fnType }))
            graph.nodes.set(id, copyNode(n, [getOperand(n, 0), local, getOperand(n, 2), ...args]))
        }
    }
    const units = new Map(pending.map(unit => [unit.symbol, unit.graph]))
    for (const unit of pending) localizeCalls(unit.graph)
    const program: ProgramGraph = { units: new Map(), roots, noInline: new Set(), image, target }
    for (const unit of pending) {
        if (unit.graph.name === undefined) unit.graph.name = unit.fn.name
        program.units.set(unit.symbol, unit.graph)
        if ((unit.fn as any).shouldNotInline) program.noInline.add(unit.symbol)
    }
    if (intrinsics.argv().includes('trace-stats')) console.log('heap records', session.runtime?.objects.stats)
    return program
}

export function createNatives(fns: Record<string, Function>, opts: CreateNativesOptions = {}) {
    getNativeBootstraps()
    const target = hostTarget
    const clock = createClock(target)
    const { enterPhase, timed } = clock
    const program = traceProgram(fns, opts, clock, target)
    const tracedUnits = program.units.size
    prune(program)
    timed('inline', () => inlineProgram(program, clock))
    prune(program)
    enterPhase('effects')
    refineProgramEffects(program, clock)
    enterPhase('other')
    let reached = reachUnits(program)
    timed('records', () => recordReturns(program, reached, clock))
    reached = reachUnits(program)
    for (const [symbol, level] of programLevels(program)) program.units.get(symbol)!.level = level
    enterPhase('lower')
    const emitted = lowerProgram(program, reached)
    enterPhase('other')
    printOptimizeStats()
    if (intrinsics.argv().includes('trace-stats')) {
        console.log("native phases", { total: performance.now() - clock.start, ...clock.phases })
        const { bySource, ...totals } = traceModule.traceStats
        const repeated = [...bySource.values()].filter(x => x.count > 1).sort((a, b) => b.count - a.count)
        console.log('trace2 stats', totals, 'distinct sources', bySource.size,
            'repeat traces', repeated.reduce((s, x) => s + x.count - 1, 0))
        for (const x of repeated.slice(0, 15)) console.log('  ', x.count, x.name)
        const bySelf = [...bySource.values()].sort((a, b) => b.self - a.self)
        for (const x of bySelf.slice(0, 20)) {
            console.log('  self', x.self.toFixed(1), 'x', x.count, x.name.replace(/\n\s*/g, ' ').slice(0, 70))
        }
    }
    if (intrinsics.argv().includes('emit-debug')) {
        console.log('EMITTED', [...program.units].map(([symbol, graph]) => `${graph.name}:${symbol}${reached.has(symbol) ? '' : '(dropped)'}`).join(' '))
    }
    const floatReturns = new Set(emitted.filter(u => u.returnsFloat).map(u => u.symbol))
    for (const graph of program.units.values()) {
        for (const n of graph.nodes.values()) {
            if (n.op !== 'local-target' || getRef(n, 0) || !floatReturns.has(getLiteral(n, 0))) continue
            intrinsics.assert(typeOf(n) === Types.f64, `native: ${graph.name || 'anonymous'} calls ${program.units.get(getLiteral(n, 0))?.name || 'anonymous'}, which returns f64, through an untyped target`)
        }
    }
    let unitInst = 0
    let nonMov = 0
    for (const u of emitted) {
        unitInst += u.code.words.length
        for (const word of u.code.words) if (!u.code.target.isMoveWide(word)) nonMov++
    }
    if (intrinsics.argv().includes('unit-sizes')) for (const u of emitted) console.log(`UNIT ${u.name || 'anonymous'}:${u.symbol} ${u.code.words.length} ${u.code.words.filter(w => !u.code.target.isMoveWide(w)).length}`)
    const inlined = tracedUnits === emitted.length ? '' : ` (${tracedUnits - emitted.length} inlined away)`
    console.log(`native unit ${emitted.length} fns ${unitInst}/${nonMov} instructions/non-mov${inlined} [${Math.round(performance.now() - clock.start)}ms]`)
    const pooled = new Map<number, number>()
    const image = program.image
    for (const [slot, symbol] of image.functionTargets) if (reached.has(symbol)) pooled.set(slot, symbol)
    const installed = installImage(emitted, image.values, pooled,
        image.byteTargets, new Uint8Array(image.bytes), image.relocations)
    const result: Record<string, any> = {}
    for (const [name, symbol] of program.roots) {
        const ptr = installed.entries[symbol]
        const float = !!emitted.find(u => u.symbol === symbol)?.returnsFloat
        result[name] = Object.assign((...args: any[]) => {
            sealCode(installed.page)
            const values = new BigInt64Array(Math.max(args.length, 1))
            for (let i = 0; i < args.length; i++) values[i] = BigInt(args[i])
            const argsPtr = (ts as any).getArrayBufferPtr(values.buffer)
            const outer = heldArgs
            heldArgs = values
            const raw = nativeInvoker(ptr, argsPtr, args.length)
            heldArgs = outer
            return float ? floatBits(raw) : raw
        }, { ptr, codePage: installed.page, image: installed, units: emitted })
    }
    return result
}

export function createNative(fn: Function) {
    return createNatives({ fn }).fn
}

export function createProgramStack() {
    const maxProgramStack = 64*1024*1024
    const rawAddr = mapCodePage(maxProgramStack as u32)
    const cell = rawAddr+maxProgramStack-8
    const addr = symbolicMemory(rawAddr)
    const rawWriteCell = createNative((v: usize) => {
        Intrinsics.store(addr, 0, v, Types.u64)
    })
    rawWriteCell(cell)

    function mark(): usize { 
        return Intrinsics.load(addr, 0, Types.u64) as usize
    }
    function reset(marker: usize) {
        Intrinsics.store(addr, 0, marker, Types.u64)
    }
    function alloc(numBytes: usize) {
        const aligned = (numBytes + 7) & ~7
        const ptr = Intrinsics.load(addr, 0, Types.u64)-aligned
        Intrinsics.store(addr, 0, ptr, Types.u64)
        return ptr
    }
    function free(numBytes: usize) {
        // this fn is the easiest one to break stuff with
        const aligned = (numBytes + 7) & ~7
        const ptr = Intrinsics.load(addr, 0, Types.u64)+aligned
        Intrinsics.store(addr, 0, ptr, Types.u64)
    }

    intrinsics.tagInline(mark)
    intrinsics.tagInline(reset)
    intrinsics.tagInline(alloc)
    intrinsics.tagInline(free)

    return {
        mark,
        reset,
        alloc,
        free,
    }
}

// cyclic
const traceModule = await import('./trace2')
const trace2 = traceModule.trace2
const createTraceSession = traceModule.createTraceSession
const symbolicMemory = traceModule.symbolicMemory
