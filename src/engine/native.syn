        setGraphBlocks(traced.graph, traced.graph.blocks.map(b => ids.has(b.id) ? { ...b, bodyId: end, bodyConst: 0 } : b))
        const live = reachableNodes(traced.graph, traced.allocations)
        for (const id of [...traced.graph.nodes.keys()]) if (!live.has(id)) traced.graph.nodes.delete(id)
    }
    let arrayProto: intrinsics.Handle | undefined
    let arrayIndexGetter: Function | undefined
    function indexGetter(): Function | undefined {
        if (arrayIndexGetter) return arrayIndexGetter
        const proxy = heap.getPropertyProxy(arrayProto!, heap.indexKey(0 as u32))
        const linked = proxy ? session.stubFunctions.get(heap.getProxyGetter(proxy) as intrinsics.Handle) : undefined
        arrayIndexGetter = linked ? originOf(linked) : undefined
        return arrayIndexGetter
    }
    function plannedIterations(local: UnitPlan, graph: Graph): Map<number, intrinsics.Handle> {
        const iterations = new Map<number, intrinsics.Handle>()
        arrayProto ??= heap.deref(heap.getPrototypeProperty(heap.deref(session.linkFunction(builtinGlobals.Array) as intrinsics.Handle)))
        const key = heap.fromJsSymbol(Symbol.iterator)
        function iteratesArray(calls: Map<number, Set<PlannedUnit>>, g: Graph, call: GraphNode, id: number): boolean {
            const target = getNode(g, getRef(call, 1))
            if (target?.op !== NodeOp.getProp || getRef(target, 2) || getLiteral(g, target, 2) !== key) return false
            const callees = calls.get(id)
            if (!callees?.size) return false
            return [...callees].every(callee => {
                const self = callee.params.find(p => p.label === 'this')
                const shape = self ? plannedShape(plan, self.rep) : undefined
                return shape !== undefined && heap.getPrototypeOf(shape) === arrayProto
            })
        }
        function iteratedField(callee: PlannedUnit): intrinsics.Handle | undefined {
            const g = graphsOf(callee.fn).traced!.graph
            const self = thisParamOf(g)
            if (self === undefined || g.blocks.length !== 1) return
            const ret = getNode(g, tailOf(g, g.blocks[0].bodyId))
            if (ret?.op !== NodeOp.ret) return
            const id = tailOf(g, getRef(ret, 0))
            const call = getNode(g, id)
            if (call?.op !== NodeOp.call || countIds(call) !== 3 || !iteratesArray(callee.calls, g, call, id)) return
            const field = getNode(g, getRef(call, 2))
            if (field?.op !== NodeOp.getProp || getRef(field, 2) || getRef(field, 1) !== self) return
            if (getRef(getNode(g, getRef(call, 1))!, 1) !== getRef(call, 2)) return
            return getLiteral(g, field, 2) as intrinsics.Handle
        }
        for (const [id, n] of graph.nodes) {
            if (n.op !== NodeOp.call || countIds(n) !== 3) continue
            if (iteratesArray(local.calls, graph, n, id)) {
                iterations.set(getRef(n, 1), 0 as intrinsics.Handle)
                continue
            }
            const target = getNode(graph, getRef(n, 1))
            const callees = local.calls.get(id)
            if (target?.op !== NodeOp.getProp || getRef(target, 2) || !callees?.size) continue
            const fields = new Set([...callees].map(iteratedField))
            const field = fields.size === 1 ? [...fields][0] : undefined
            if (field !== undefined) iterations.set(getRef(n, 1), field)
        }
        return iterations
    }
    function indexArrayIterations(graph: Graph, iterations: Map<number, intrinsics.Handle>, rewrote: (next: number, values: number[], index: number) => void): boolean {
        const users = new Map<number, [user: number, slot: number][]>()
        for (const [id, n] of graph.nodes) {
            for (let i = 0; i < countIds(n); i++) {
                const r = getRef(n, i)
                if (!r) continue
                const list = users.get(r)
                if (list) list.push([id, i])
                else users.set(r, [[id, i]])
            }
        }
        const ordering = (user: number, slot: number): boolean => slot < firstNonOrderingSlot(getNode(graph, user)!)
        const literalKey = (n: GraphNode | undefined, op: NodeOp, key: intrinsics.Handle) => n?.op === op && !getRef(n, 2) && getLiteral(graph, n, 2) === key
        const blockOf = (id: number): number | undefined => {
            for (let n = getNode(graph, id); n; n = getNode(graph, id)) {
                if (n.op === NodeOp.nilEffect) return countLiterals(n) ? getRef(n, 0) : undefined
                id = getRef(n, 0)
                if (!id) return
            }
        }
        const owners = new Map<number, number>()
        for (const b of graph.blocks) {
            const stack = [b.bodyId]
            while (stack.length) {
                const id = stack.pop()!
                const n = id ? getNode(graph, id) : undefined
                if (!n || owners.has(id) || n.op === NodeOp.block || n.op === NodeOp.param) continue
                if (n.op === NodeOp.apply) owners.set(id, b.id)
                if (n.op !== NodeOp.apply && n.op !== NodeOp.select && n.op !== NodeOp.after) continue
                for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
            }
        }
        function selfIteration(iterator: number): [prop: number, call: number] | undefined {
            const uses = (users.get(iterator) ?? []).filter(([u, slot]) => !ordering(u, slot))
            if (uses.length !== 2) return
            const prop = uses.find(([u, slot]) => slot === 1 && literalKey(getNode(graph, u), NodeOp.getProp, heap.fromJsSymbol(Symbol.iterator)))?.[0]
            const call = uses.find(([u, slot]) => slot === 2 && getNode(graph, u)!.op === NodeOp.call)?.[0]
            if (prop === undefined || call === undefined) return
            const n = getNode(graph, call)!
            if (countIds(n) !== 3 || getRef(n, 1) !== prop) return
            if ((users.get(prop) ?? []).some(([u, slot]) => !ordering(u, slot) && !(u === call && slot === 1))) return
            return [prop, call]
        }
        const loops = graphLoops(graph)
        let changed = false
        for (const [symbol, field] of iterations) {
            const s = getNode(graph, symbol)
            if (s?.op !== NodeOp.getProp) continue
            const object = getRef(s, 1)
            const makers = (users.get(symbol) ?? []).filter(([u, slot]) => !ordering(u, slot))
            if (makers.length !== 1 || makers[0][1] !== 1) continue
            const made = makers[0][0]
            const make = getNode(graph, made)!
            if (make.op !== NodeOp.call || getRef(make, 2) !== object || countIds(make) !== 3) continue
            const relay = selfIteration(made)
            const iterator = relay ? relay[1] : made
            const nextProps: number[] = []
            const returnProps: number[] = []
            let nextCalls: number[] = []
            let valid = true
            for (const [u, slot] of users.get(iterator) ?? []) {
                if (ordering(u, slot)) continue
                const n = getNode(graph, u)!
                if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.next)) nextProps.push(u)
                else if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.return)) returnProps.push(u)
                else if (slot === 2 && n.op === NodeOp.call && countIds(n) === 3) nextCalls.push(u)
                else valid = false
            }
            const returnCalls = nextCalls.filter(c => returnProps.includes(getRef(getNode(graph, c)!, 1)))
            nextCalls = nextCalls.filter(c => !returnCalls.includes(c))
            if (!valid || nextCalls.length !== 1) continue
            const call = nextCalls[0]
            if (!nextProps.includes(getRef(getNode(graph, call)!, 1))) continue
            for (const prop of nextProps) {
                for (const [u, slot] of users.get(prop) ?? []) if (!ordering(u, slot) && !(u === call && slot === 1)) valid = false
            }
            const done: number[] = []
            const values: number[] = []
            for (const [u, slot] of users.get(call) ?? []) {
                if (ordering(u, slot)) continue
                const n = getNode(graph, u)!
                if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.done)) done.push(u)
                else if (slot === 1 && literalKey(n, NodeOp.getProp, iterationKeys.value)) values.push(u)
                else valid = false
            }
            if (!valid || !done.length) continue
            const header = blockOf(call)
            const members = header === undefined ? undefined : loops.loopMembers.get(header)
            if (header === undefined || !members) continue
            const block = getBlock(graph, header)!
            const token = getRef(getNode(graph, call)!, 0)
            let array = object
            if (field) {
                array = addNode(graph, NodeOp.getProp, [getRef(make, 0), object, { literal: field }])
            }
            const index = addNode(graph, NodeOp.param, [])
            block.params.push(index)
            for (const [app, owner] of owners) {
                const n = getNode(graph, app)!
                if (getRef(n, 0) !== header) continue
                let arg: Operand = { literal: 0 }
                if (members.has(owner)) {
                    arg = addNode(graph, NodeOp.add, [index, { literal: 1 }])
                }
                putCopy(graph, app, n, [...getOperands(graph, n), arg])
            }
            const length = addNode(graph, NodeOp.getProp, [token, array, { literal: iterationKeys.length }])
            const finished = addNode(graph, NodeOp.ge, [index, length], Types.bool)
            for (const id of done) putNode(graph, id, NodeOp.after, [length, finished])
            for (const id of values) putNode(graph, id, NodeOp.getProp, [getRef(getNode(graph, id)!, 0), array, index])
            rewrote(call, values, index)
