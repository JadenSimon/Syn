                if (regular < args.length) map.set(p, args[regular])
                else map.set(p, nullishNode ||= addNode(graph, NodeOp.heapHandle, [{ literal: 0 }], Types.unknown_number))
                regular++
                continue
            }
            map.set(p, { literal: (1 << Math.min(args.length, compiled.paramCount)) - 1 })
        }
        const live = reachableNodes(callee_)
        for (const id of live) {
            const n = getNode(callee_, id)
            if (n?.op === NodeOp.nilEffect && countIds(n) && getRef(n, 0) === callee_.root) map.set(id, token)
        }
        const cells = new Map<number, number>()
        for (const [cell] of prepared.allocations) {
            const copy = runtimeObjects().intern(heap.makeObject(heap.getPrototypeOf(heap.deref(cell as intrinsics.Handle))))
            cells.set(cell, copy)
        }
        const fresh = new Map<number, number>()
        for (const id of live) if (!map.has(id)) fresh.set(id, newId(graph))
        for (const b of callee_.blocks) if (!map.has(b.id) && !fresh.has(b.id)) fresh.set(b.id, newId(graph))
        function remap(op: Operand): Operand {
            if (typeof op !== 'number') return op
            const known = map.get(op)
            if (known !== undefined) return known
            return fresh.get(op) ?? op
        }
        const created: number[] = []
        for (const [id, copy] of fresh) {
            const n = getNode(callee_, id)
            if (!n) {
                setNode(graph, copy, makeNode(callee_, NodeOp.block, []))
                continue
            }
            const operands = getOperands(callee_, n).map(remap)
            if (n.op === NodeOp.heapHandle && !getRef(n, 0) && cells.has(getLiteral(callee_, n, 0))) {
                const copied = cells.get(getLiteral(callee_, n, 0))!
                operands[0] = { literal: copied }
                if (countIds(n) > 1) operands[1] = { literal: heap.deref(copied as intrinsics.Handle) }
            }
            if (n.op === NodeOp.inlined && getLiteral(callee_, n, 1) === id) operands[1] = { literal: copy }
            const typeRef = typeRefOf(n)
            const node = copyNode(callee_, n, operands)
            if (typeRef) setType(node, { ref: remap(typeRef) as number })
            setNode(graph, copy, node)
            if (n.op === NodeOp.rt && getLiteral(callee_, n, 1) === rt.Op.create) created.push(copy)
        }
        for (const [cell, copy] of cells) {
            const call = prepared.allocations.get(cell as u32)!.call
            traced.allocations.set(copy as u32, { call: call ? remap(call) as number : undefined, token: typeof token === 'number' ? token : undefined })
        }
        for (const id of created) {
            const n = getNode(graph, id)!
            const proto = getNode(graph, getRef(n, 2))
            if (proto?.op !== NodeOp.heapHandle || getRef(proto, 0)) continue
            const cell = runtimeObjects().intern(heap.makeObject(heap.deref(getLiteral(callee_, proto, 0) as intrinsics.Handle)))
            putNode(graph, id, NodeOp.heapHandle, [{ literal: cell }], Types.unknown_number)
            traced.allocations.set(cell as u32, { call: undefined, token: typeof token === 'number' ? token : undefined })
        }
        for (const b of callee_.blocks.slice(1)) {
            graph.blocks.push({ id: fresh.get(b.id)!, params: b.params.map(p => remap(p) as number), bodyId: b.bodyId ? remap(b.bodyId) as number : 0, bodyConst: b.bodyConst })
        }
        setGraphBlocks(graph, graph.blocks)
        const body = rootBlock.bodyId
        if (!body) {
            putNode(graph, callId, NodeOp.after, [token, { literal: rootBlock.bodyConst }])
            return fresh
        }
        const ordered = new Map<number, number>()
        function orderApplies(id: number): number {
            const n = getNode(graph, id)
            if (!n || typeof token !== 'number') return id
            if (n.op === NodeOp.apply) {
                let wrapped = ordered.get(id)
                if (wrapped === undefined) ordered.set(id, wrapped = addNode(graph, NodeOp.after, [token, id]))
                return wrapped
            }
            if (n.op === NodeOp.ret) {
                let wrapped = ordered.get(id)
                if (wrapped === undefined) ordered.set(id, wrapped = addCopy(graph, n, withOperand(callee_, n, 0, addNode(graph, NodeOp.after, [token, getOperand(callee_, n, 0)]))))
                return wrapped
            }
            if (n.op !== NodeOp.select) return id
            let operands: Operand[] | undefined
            for (let i = 1; i < countIds(n); i++) {
                const arm = getRef(n, i)
                const next = arm ? orderApplies(arm) : arm
                if (next === arm) continue
                operands ??= getOperands(callee_, n)
                operands[i] = next
            }
            if (!operands) return id
            putCopy(graph, id, n, operands)
            return id
        }
        const result = orderApplies(remap(body) as number)
        const ret = getNode(graph, result)!
        if (ret.op === NodeOp.ret && simpleTail(graph, getRef(ret, 0), new Set(fresh.values()))) {
            const value = getOperand(callee_, ret, 0)
            const inner = typeof value === 'number' ? getNode(graph, value) : undefined
            if (inner?.op === NodeOp.after) putCopy(graph, callId, inner)
            else putNode(graph, callId, NodeOp.after, [token, value])
            return fresh
        }
        putNode(graph, callId, NodeOp.inlined, [result, { literal: callId }])
        regionSites.add(callId)
        return fresh
    }
    function simpleTail(graph: Graph, id: number, copies: Set<number>): boolean {
        const seen = new Set<number>()
        const stack = [id]
        while (stack.length) {
            const at = stack.pop()!
            if (!at || seen.has(at) || !copies.has(at)) continue
            seen.add(at)
            const n = getNode(graph, at)
            if (!n) continue
            if (n.op === NodeOp.apply || n.op === NodeOp.select || n.op === NodeOp.ret || n.op === NodeOp.join || n.op === NodeOp.trap || n.op === NodeOp.inlined || n.op === NodeOp.panic) return false
            for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
        }
        return true
    }
    function uniformReturn(graph: Graph, root: number, allocations: Map<u32, Allocation>): number | undefined {
        const leaves: { ret: number, value: number, cell: number }[] = []
        const conditions: number[] = []
        let nested = false
        const seen = new Set<number>()
        const stack = [root]
        const blocks = new Map(graph.blocks.map(b => [b.id, b]))
        while (stack.length) {
            const id = stack.pop()!
            if (!id || seen.has(id)) continue
            seen.add(id)
            const n = getNode(graph, id)
            if (!n) continue
            if (n.op === NodeOp.ret) {
                const value = strippedAfter(graph, getRef(n, 0))
                const target = getNode(graph, value)
                if (target?.op !== NodeOp.heapHandle || getRef(target, 0)) return
                leaves.push({ ret: id, value, cell: getLiteral(graph, target, 0) })
                continue
            }
            if (n.op === NodeOp.select) {
                conditions.push(getRef(n, 0))
                for (let i = 1; i < countIds(n); i++) stack.push(getRef(n, i))
            }
            else if (n.op === NodeOp.after) stack.push(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.apply) {
                const block = blocks.get(getRef(n, 0))
                if (block) stack.push(block.bodyId)
                nested = true
            } else if (n.op === NodeOp.panic || n.op === NodeOp.unreachable || n.op === NodeOp.trap) continue
            else return
        }
        const cells = new Set(leaves.map(l => l.cell))
        if (!cells.size) return
        for (const cell of cells) if (!allocations.has(cell as u32)) return
        if (cells.size === 1) return leaves[0].value
        if (nested) return
        const keep = leaves[0].cell
        const proto = heap.getPrototypeOf(heap.deref(keep as intrinsics.Handle))
        for (const cell of cells) if (heap.getPrototypeOf(heap.deref(cell as intrinsics.Handle)) !== proto) return
        function touches(from: number[], own: number | undefined): boolean {
            const reached = new Set<number>()
            const walk = [...from]
            while (walk.length) {
                const id = walk.pop()!
                if (!id || reached.has(id)) continue
                reached.add(id)
                const n = getNode(graph, id)
                if (!n) continue
                if (n.op === NodeOp.heapHandle && !getRef(n, 0) && cells.has(getLiteral(graph, n, 0)) && getLiteral(graph, n, 0) !== own) return true
                nodeRefs(graph, n, walk)
            }
            return false
        }
        if (touches(conditions, undefined)) return
        for (const leaf of leaves) if (touches([leaf.ret], leaf.cell)) return
        for (const [id, n] of [...graph.nodes]) {
            if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
            const cell = getLiteral(graph, n, 0)
            if (cell !== keep && cells.has(cell)) putNode(graph, id, NodeOp.heapHandle, countIds(n) > 1 ? [{ literal: keep }, { literal: heap.deref(keep as intrinsics.Handle) }] : [{ literal: keep }], typeOf(n))
        }
        for (const cell of cells) if (cell !== keep) allocations.delete(cell as u32)
        return leaves[0].value
    }
    let frozen = false
    function freeze(): void {
        frozen = true
    }
    function graphsOf(fn: Function): Unit {
        const unit = unitOf(fn)
        if (unit.traced) return unit
        intrinsics.assert(!frozen, `native: ${fn.name} is traced after planning`)
        intrinsics.assert(!unit.tracing, `native: ${fn.name} is already being traced`)
        unit.tracing = true
        defer unit.tracing = false
        for (const dep of unit.deps ?? []) traceDependency(dep)
        const code = codeOf(fn)
        if (!code) throw `native: ${fn.name} has no code to trace`
        const verbose = flagged('trace-debug', fn.name)
        const origin = unitOf(originOf(fn))
        clock.timed('trace', () => {
            let traced = origin.trace
            if (!traced) {
                const traceStart = performance.now()
                traced = fastTraced(fn, verbose)
                if (flags.has('trace-time')) console.log('TRACETIME', fn.name, (performance.now() - traceStart).toFixed(2), traced.graph.nodes.size)
                lowerPanics(traced.graph)
                engineHeapArrays(traced.graph)
                ownProperties(traced)
                outlineCold(fn, code, traced)
                if (flags.has(`traced-debug:${fn.name}`)) console.log(dumpGraph(traced.graph))
                origin.trace = traced
            }
            const graph = withNodes(traced.graph, new Map(traced.graph.nodes))
            linkStatics(fn, graph)
            unit.source = code.source
            unit.traced = { ...traced, graph }
        }, fn.name)
        units.push(unit)
        return unit
    }
    return { units, graphsOf, freeze, lowerPanics, engineElements, heapValue, traceProgramUnits, checkInlinedReads, foldStatics, fixedSlot, strippedAfter, reachableNodes }
}

type Tracer = ReturnType<typeof createTracer>

interface Planned {
    units: Map<Function, PlannedUnit>
    functions: Map<PlannedUnit, Function>
    frames: Map<u32, intrinsics.Handle>
    contexts: Map<Function, intrinsics.Handle>
}

function bindPlannedUnits(plan: ShapePlan, linker: Linker): Planned {
    const { unitOf, originOf, codeOf } = linker
    const planned: Planned = { units: new Map(), functions: new Map(), frames: new Map(), contexts: new Map() }
    for (const [fn, list] of plan.units) list.forEach((unit, i) => {
        const target = i === 0 ? fn : specialize(fn, `${fn.name || 'anon'}#p${i}`)
        planned.units.set(target, unit)
        planned.functions.set(unit, target)
    })
    function specialize(fn: Function, name: string): Function {
        const origin = originOf(fn)
        const specialized = Object.defineProperty(function specialized() {}, 'name', { value: name })
        const unit = unitOf(specialized)
        unit.code = codeOf(origin)!
        unit.origin = origin
        return specialized
    }
    return planned
}

function sharePlannedUnits(plan: ShapePlan, planned: Planned, reps: Representations, host: AccessHost): void {
    function abiOf(unit: PlannedUnit): string {
        const abi = reps.abi.get(planned.functions.get(unit)!)!
        return `${abi.mode} ${abi.returns} ${abi.tags.join(',')}`
    }
    const shared = shareUnits(plan.units, plan.layoutOf, plan.reducedTarget, plan.embedded.sites, abiOf, fn => host.graphOf(fn))
    for (const unit of shared.keys()) {
        const fn = planned.functions.get(unit)!
        planned.units.delete(fn)
        planned.functions.delete(unit)
        reps.abi.delete(fn)
    }
}

function planFrames(types: ValueTypes, plan: ShapePlan, planned: Planned, linker: Linker, tracer: Tracer, facts: Facts): void {
    const { sourceOfLinked } = linker
    for (const [fn, unit] of planned.units) {
        const traced = tracer.graphsOf(fn).traced!
        const proxy = traced.frameProxy
        if (proxy !== undefined && traced.frames.has(proxy) && !planned.frames.has(proxy)) planned.frames.set(proxy, propertyEval.frameShape(frameSize(sourceOfLinked(fn)!.captured), proxy as intrinsics.Handle))
        for (const [id, n] of traced.graph.nodes) {
            const rep = n.op === NodeOp.callContext ? unit.nodes.get(id) : undefined
            const shape = rep && plannedShape(plan, rep)
            if (shape !== undefined) planned.contexts.set(fn, shape)
        }
    }
    function frameOf(object: ObjectType): intrinsics.Handle | undefined {
        return object.name === 'Scope' && object.native && object.state === undefined && object.handle !== undefined ? planned.frames.get(object.handle as u32) : undefined
    }
    function valueShape(id: number): intrinsics.Handle | undefined {
        const object = types.objects[id]
        const frame = frameOf(object)
        if (frame !== undefined) return frame
        if (object.state !== undefined && object.native) return object.state
        if (object.state !== undefined && object.constant) {
            const allocated = (types.stateAllocations.get(object.state) ?? []).filter(other => !types.objects[other].constant).map(other => plan.inst.shapeOf(other))
            if (allocated.length && allocated.every(shape => shape !== undefined && shape === allocated[0])) return plan.shapes.get(allocated[0]!)
            return plan.constants.get(object.state) ?? object.state
        }
        const shape = plan.inst.shapeOf(id)
        return shape === undefined ? undefined : plan.shapes.get(shape)
    }
    const number: Codec = { kind: 'int', encoded: false }
    function factsOf(type: Type): Codec[] {
        const rep = plan.inst.repOf(type)
        if (rep.kind === 'number') return [number]
        if (rep.kind !== 'pointer') return []
        const out: Codec[] = []
        if (type.strings.length) out.push({ kind: 'ref', shape: propertyEval.stringShape, encoded: false, union: false })
        for (const id of new Set([...type.objects, ...type.closures])) {
            if (types.objects[id].name === 'buffer') {
                out.push(number)
                continue
            }
            const shape = valueShape(id)
            if (shape !== undefined) out.push({ kind: 'ref', shape, encoded: false, union: false })
        }
        return out
    }
    function keyOf(name: string): intrinsics.Handle | undefined {
        const index = /^\[(\d+)\]$/.exec(name)
        return index ? heap.indexKey(Number(index[1]) as u32) : types.keyHandles.get(name)
    }
    const fixed = new Set(plan.shapes.values())
    for (const object of types.objects) {
        const held = object.state !== undefined && (object.native || object.constant)
        const holder = frameOf(object) ?? (!held ? undefined : object.constant ? plan.constants.get(object.state!) ?? object.state : object.state)
        if (holder === undefined || fixed.has(holder)) continue
        const fields = propertyEval.recordLayout(holder, plan.embedded.fields)
        for (const [name, field] of object.fields) {
            const key = keyOf(name)
            const at = key === undefined ? -1 : fields.keys.indexOf(key)
            if (at < 0) continue
            for (const fact of factsOf(field.type)) setFact(facts, 'plan', holder, String(fields.offsets[at]), fact)
        }
    }
}

function soleTarget(rep: Rep): string | undefined {
    return rep.targets.length === 1 ? rep.targets[0] : undefined
}

function targetShape(plan: ShapePlan, target: string | undefined): intrinsics.Handle | undefined {
    if (target === undefined) return
    if (target.startsWith('clo@')) return Number(target.slice('clo@'.length)) as intrinsics.Handle
    return target.startsWith('S') ? plan.shapes.get(target) : undefined
}

function plannedShape(plan: ShapePlan, rep: Rep): intrinsics.Handle | undefined {
    const target = soleTarget(rep)
    if (rep.kind === 'union') return target?.startsWith('S') ? targetShape(plan, target) : undefined
    if (rep.kind !== 'pointer') return
    if (target === 'str' || target?.startsWith('clo@')) return rep.nullable ? undefined : target === 'str' ? propertyEval.stringShape : targetShape(plan, target)
    return targetShape(plan, target)
}

const narrowUndefined = 2 ** 32

const runtimeHeapAccessors = new Set<Function>([heap.getIntProperty, heap.getFloatProperty, heap.getHandleProperty, heap.setIntProperty, heap.setFloatProperty, heap.setHandleProperty])

interface TagFlow {
    marked: Map<PlannedUnit, Set<number>>
    unknown: Map<PlannedUnit, Set<number>>
    fields: Map<intrinsics.Handle, Set<intrinsics.Handle>>
    peerOf: Map<PlannedUnit, PlannedUnit>
}

function tagged(tags: TagFlow, unit: PlannedUnit, id: number): boolean {
    const peer = tags.peerOf.get(unit) ?? unit
    return !!tags.marked.get(peer)?.has(id) && !tags.unknown.get(peer)?.has(id)
}

function taggedTargets(plan: ShapePlan, unit: PlannedUnit, graph: Graph, object: number, key: intrinsics.Handle): intrinsics.Handle[] | undefined {
    const value = tailOf(graph, object)
    const index = graph.blocks[0].params.indexOf(value)
    const rep = index < 0 ? unit.nodes.get(value) : unit.params[index]?.rep
    if (!rep || (rep.kind !== 'pointer' && rep.kind !== 'union') || !rep.targets.length) return
    const shapes = rep.targets.map(target => targetShape(plan, target)!)
    return shapes.every(shape => !!plan.bits.get(shape)?.tagged.has(key)) ? shapes : undefined
}

function fieldStores(plan: ShapePlan, unit: PlannedUnit, graph: Graph, id: number, n: GraphNode, add: (shapes: intrinsics.Handle[], key: intrinsics.Handle, value: number) => void): void {
    if (n.op === NodeOp.setProp && !getRef(n, 2) && getRef(n, 3)) {
        const key = getLiteral(graph, n, 2) as intrinsics.Handle
        const shapes = taggedTargets(plan, unit, graph, getRef(n, 1), key)
        if (shapes) add(shapes, key, getRef(n, 3))
        return
    }
    if (n.op !== NodeOp.heapHandle || countIds(n) !== 2) return
    const state = getLiteral(graph, n, 1) as intrinsics.Handle
    for (const key of snapshotKeys(state)) {
        const value = intrinsics.getNanId(heap.unboxF64(snapshotField(state, key)!))
        if (!value) continue
        const shapes = taggedTargets(plan, unit, graph, id, key)
        if (shapes) add(shapes, key, value)
    }
}

function analyzeTags(plan: ShapePlan, planned: Planned, tracedOf: (unit: PlannedUnit) => Graph, returnTaggable: (unit: PlannedUnit) => boolean, linker: Linker, classes: Map<PlannedUnit, number>): TagFlow {
    const { isRoot, sourceOfLinked } = linker
    const marked = new Map<PlannedUnit, Set<number>>()
    const dependents = new Map<PlannedUnit, Map<number, [PlannedUnit, number][]>>()
    const leaves: [PlannedUnit, number][] = []
    const incoming = new Map<PlannedUnit, [PlannedUnit, number][]>()
    const shared = new Set<PlannedUnit>()
    const peerOf = new Map<PlannedUnit, PlannedUnit>()
    const firsts = new Map<number, PlannedUnit>()
    for (const unit of planned.units.values()) {
        const id = classes.get(unit)
        if (id === undefined) continue
        const first = firsts.get(id)
        if (first) peerOf.set(unit, first)
        else firsts.set(id, unit)
    }
    function peer(unit: PlannedUnit): PlannedUnit {
        return peerOf.get(unit) ?? unit
    }
    const rooted = new Set<PlannedUnit>()
    for (const [fn, unit] of planned.units) if (isRoot(fn)) rooted.add(peer(unit))
    for (const caller of planned.units.values()) {
        for (const [call, callees] of caller.calls) {
            const peers = new Set([...callees].map(peer))
            for (const callee of peers) {
                let list = incoming.get(callee)
                if (!list) incoming.set(callee, list = [])
                list.push([caller, call])
                if (peers.size > 1) shared.add(callee)
            }
        }
    }
    const arrivals = new Map<PlannedUnit, Arrivals>()
    function arrivalsOf(unit: PlannedUnit): Arrivals {
        let known = arrivals.get(unit)
        if (!known) arrivals.set(unit, known = paramArrivals(tracedOf(unit)))
        return known
    }
    const work: [PlannedUnit, number][] = []
    function need(of: PlannedUnit, id: number, user?: PlannedUnit, userId?: number): void {
        if (!id) return
        const unit = peer(of)
        if (user) {
            let byNode = dependents.get(unit)
            if (!byNode) dependents.set(unit, byNode = new Map())
            const list = byNode.get(id)
            if (list) list.push([user, userId!])
            else byNode.set(id, [[user, userId!]])
        }
        let set = marked.get(unit)
        if (!set) marked.set(unit, set = new Set())
        if (set.has(id)) return
        set.add(id)
        work.push([unit, id])
    }
    const stores = new Map<intrinsics.Handle, Map<intrinsics.Handle, [PlannedUnit, number][]>>()
    const fields = new Map<intrinsics.Handle, Set<intrinsics.Handle>>()
    function demand(shapes: intrinsics.Handle[], key: intrinsics.Handle): void {
        for (const shape of shapes) {
            let known = fields.get(shape)
            if (!known) fields.set(shape, known = new Set())
            if (known.has(key)) continue
            known.add(key)
            for (const [unit, value] of stores.get(shape)?.get(key) ?? []) need(unit, value)
        }
    }
    for (const unit of planned.units.values()) {
        const graph = tracedOf(unit)
        for (const [id, n] of graph.nodes) {
            fieldStores(plan, unit, graph, id, n, (shapes, key, value) => {
                for (const shape of shapes) {
                    let byKey = stores.get(shape)
                    if (!byKey) stores.set(shape, byKey = new Map())
                    const list = byKey.get(key)
                    if (list) list.push([unit, value])
                    else byKey.set(key, [[unit, value]])
                }
            })
        }
    }
    for (const unit of planned.units.values()) {
        const graph = tracedOf(unit)
        for (const [id, n] of graph.nodes) {
            if (rt.sliceOf(graph, n) === rt.Op.sliceWrite && taggedSlice(unit.slices, id)) need(unit, getRef(n, 4))
            if ((n.op !== NodeOp.eq && n.op !== NodeOp.ne) || countIds(n) !== 2) continue
            for (const side of [0, 1]) {
                const ref = getRef(n, side)
                if (ref && nullableNumber(unit.nodes.get(tailOf(graph, ref))) && !nonzeroLiteral(graph, n, 1 - side)) need(unit, ref)
            }
        }
    }
    while (work.length) {
        const [unit, id] = work.pop()!
        const graph = tracedOf(unit)
        const n = getNode(graph, id)
        if (!n) {
            leaves.push([unit, id])
            continue
        }
        const index = graph.blocks[0].params.indexOf(id)
        const rep = index < 0 ? unit.nodes.get(id) : unit.params[index]?.rep
        if (rep?.kind === 'number' && !rep.nullable) continue
        if (n.op === NodeOp.after) {
            need(unit, getRef(n, countIds(n) - 1), unit, id)
            continue
        }
        if (n.op === NodeOp.select) {
            for (let i = 1; i < countIds(n); i++) need(unit, getRef(n, i), unit, id)
            continue
        }
        if (n.op === NodeOp.param) {
            if (index < 0) {
                const from = arrivalsOf(unit).get(id)
                if (!from) leaves.push([unit, id])
                else for (const arrival of from) need(unit, arrival, unit, id)
                continue
            }
            const fn = planned.functions.get(unit)!
            if (rooted.has(unit) || shared.has(unit) || index >= (sourceOfLinked(fn)?.compiled.paramCount ?? 0) || !nullableNumber(unit.params[index]?.rep)) {
                leaves.push([unit, id])
                continue
            }
            for (const [caller, call] of incoming.get(unit) ?? []) {
                const site = getNode(tracedOf(caller), call)
                if (!site) leaves.push([unit, id])
                else if (3 + index < countIds(site)) need(caller, getRef(site, 3 + index), unit, id)
            }
            continue
        }
        if (rt.sliceOf(graph, n) === rt.Op.sliceRead && taggedSlice(unit.slices, id)) continue
        const read = n.op === NodeOp.getProp && !getRef(n, 2) ? taggedTargets(plan, unit, graph, getRef(n, 1), getLiteral(graph, n, 2) as intrinsics.Handle) : undefined
        if (read) {
            demand(read, getLiteral(graph, n, 2) as intrinsics.Handle)
            continue
        }
        if (n.op === NodeOp.call || (n.op === NodeOp.getProp && unit.calls.has(id))) {
            const callees = unit.calls.get(id)
            if (!callees?.size || ![...callees].every(returnTaggable)) {
                leaves.push([unit, id])
                continue
            }
            for (const callee of callees) for (const ret of ownRets(tracedOf(callee))) need(callee, getRef(getNode(tracedOf(callee), ret)!, 0), unit, id)
            continue
        }
        if (isNullishValue(graph, id) || n.op === NodeOp.literal) continue
        leaves.push([unit, id])
    }
    const unknown = new Map<PlannedUnit, Set<number>>()
    while (leaves.length) {
        const [unit, id] = leaves.pop()!
        let set = unknown.get(unit)
        if (!set) unknown.set(unit, set = new Set())
        if (set.has(id)) continue
        set.add(id)
        for (const dependent of dependents.get(unit)?.get(id) ?? []) leaves.push(dependent)
    }
    return { marked, unknown, fields, peerOf }
}

function nullableOf(rep: Rep): Rep {
    return rep.kind !== 'number' || rep.nullable ? rep : { ...rep, nullable: true, text: `${rep.text}?` }
}

function joinNullableNumbers(planned: Planned, classes: Map<PlannedUnit, number>): void {
    const members = new Map<number, PlannedUnit[]>()
    for (const unit of planned.units.values()) {
        const id = classes.get(unit)
        if (id === undefined) continue
        const list = members.get(id)
        if (list) list.push(unit)
        else members.set(id, [unit])
    }
    for (const list of members.values()) {
        if (list.length < 2) continue
        const params = new Set<number>()
        const nodes = new Set<number>()
        let returns = false
        for (const unit of list) {
            for (let i = 0; i < unit.params.length; i++) if (nullableNumber(unit.params[i].rep)) params.add(i)
            for (const [id, rep] of unit.nodes) if (nullableNumber(rep)) nodes.add(id)
            if (nullableNumber(unit.returns)) returns = true
        }
        for (const unit of list) {
            unit.params = unit.params.map((param, i) => params.has(i) ? { label: param.label, rep: nullableOf(param.rep) } : param)
            if (returns) unit.returns = nullableOf(unit.returns)
            if (nodes.size) unit.nodes = new Map([...unit.nodes].map(([id, rep]) => [id, nodes.has(id) ? nullableOf(rep) : rep]))
        }
    }
}

type ReturnMode = 'encoded' | 'raw' | 'keep' | 'tagged' | 'narrow'

interface UnitAbi {
    mode: ReturnMode
    returns: intrinsics.Types
    tags: number[]
}

interface Representations {
    abi: Map<Function, UnitAbi>
    tags: TagFlow
}

function chooseRepresentations(plan: ShapePlan, planned: Planned, linker: Linker, tracer: Tracer, host: AccessHost): Representations {
    const { staticFns, unitOf, originOf, constructsOutOfLine, isRoot } = linker
    function tracedOf(unit: PlannedUnit): Graph {
        return tracer.graphsOf(planned.functions.get(unit)!).traced!.graph
    }
    function returnTaggable(unit: PlannedUnit): boolean {
        return nullableNumber(unit.returns) && !constructsOutOfLine(planned.functions.get(unit)!)
    }
    const classes = shareClasses(plan.units, plan.layoutOf, plan.reducedTarget, plan.embedded.sites, () => '', fn => host.graphOf(fn))
    joinNullableNumbers(planned, classes)
    const tags = analyzeTags(plan, planned, tracedOf, returnTaggable, linker, classes)
    for (const shape of plan.shapes.values()) {
        const kinds = plan.bits.get(shape)
        if (!kinds) continue
        for (const key of [...kinds.tagged]) if (!tags.fields.get(shape)?.has(key)) kinds.tagged.delete(key)
    }
    function returnsTag(unit: PlannedUnit): boolean {
        if (!returnTaggable(unit)) return false
        const graph = tracedOf(unit)
        const values = ownRets(graph).map(ret => getRef(getNode(graph, ret)!, 0)).filter(value => value !== 0)
        return values.length > 0 && values.every(value => tagged(tags, unit, value))
    }
    function paramTags(unit: PlannedUnit): number[] {
        const params = tracedOf(unit).blocks[0].params
        const out: number[] = []
        params.forEach((param, i) => {
            if (nullableNumber(unit.params[i]?.rep) && tagged(tags, unit, param)) out.push(i)
        })
        return out
    }
    function agreedPointer(fn: Function): boolean {
        const returned = planned.units.get(fn)!.returns
        if (isRoot(fn) || staticFns.includes(fn) || returned.kind !== 'pointer' || !returned.fresh) return false
        const target = soleTarget(returned)
        return target !== undefined && target.startsWith('S') && plannedShape(plan, returned) !== undefined
    }
    const modes = new Map<Function, ReturnMode>()
    const producing = new Set<Function>()
    function producesRaw(fn: Function): boolean {
        if (producing.has(fn)) return false
        producing.add(fn)
        defer producing.delete(fn)
        const unit = planned.units.get(fn)!
        const graph = tracer.graphsOf(fn).traced!.graph
        const arrivals = paramArrivals(graph)
        const seen = new Set<number>()
        function raw(id: number): boolean {
            if (!id || seen.has(id)) return true
            seen.add(id)
            const n = getNode(graph, id)
            if (!n) return false
            if (n.op === NodeOp.after) return raw(getRef(n, countIds(n) - 1))
            if (n.op === NodeOp.select) return raw(getRef(n, 1)) && raw(getRef(n, 2))
            if (n.op === NodeOp.ret || n.op === NodeOp.inlined) return raw(getRef(n, 0))
            if (n.op === NodeOp.panic || n.op === NodeOp.unreachable || n.op === NodeOp.literal) return true
            if (rt.sliceOf(graph, n) === rt.Op.sliceRead) return rawSlice(unit.slices, id)
            if (n.op === NodeOp.heapHandle && !getRef(n, 0)) return !getLiteral(graph, n, 0) || unit.allocations.has(id)
            if (n.op === NodeOp.param) return graph.blocks[0].params.includes(id) || (arrivals.has(id) && arrivals.get(id)!.every(raw))
            if (n.op === NodeOp.call || n.op === NodeOp.getProp) {
                const callees = unit.calls.get(id)
                return !!callees?.size && [...callees].every(callee => modeOf(planned.functions.get(callee)!) === 'raw')
            }
            return false
        }
        return [...graph.nodes].every(([id, n]) => n.op !== NodeOp.ret || !getRef(n, 0) || raw(id))
    }
    function modeOf(fn: Function): ReturnMode {
        const known = modes.get(fn)
        if (known !== undefined) return known
        const unit = planned.units.get(fn)!
        const mode: ReturnMode = constructsOutOfLine(fn) ? 'keep' : returnsTag(unit) ? 'tagged' : unitOf(originOf(fn)).stubbed ? 'keep' : agreedPointer(fn) && (!unit.returns.nullable || producesRaw(fn)) ? 'raw' : 'encoded'
        modes.set(fn, mode)
        return mode
    }
    for (const fn of planned.units.keys()) modeOf(fn)
    const direct = new Set<Function>()
    const returnedBy = new Map<Function, Function[]>()
    const returnedCalls = new Map<Function, Function[]>()
    const unsized = new Set<Function>()
    const slotLoads = new Set<Function>()
    for (const [fn, unit] of planned.units) {
        const graph = tracer.graphsOf(unit.fn).traced!.graph
        const visited = new Set<number>()
        const calls: Function[] = []
        returnedCalls.set(fn, calls)
        function visit(ref: number): void {
            const id = tailOf(graph, ref)
            const n = getNode(graph, id)
            if (!n || visited.has(id)) return
            visited.add(id)
            if (n.op === NodeOp.call) {
                if (!unit.calls.get(id)?.size) unsized.add(fn)
                for (const callee of unit.calls.get(id) ?? []) {
                    const target = planned.functions.get(callee)!
                    calls.push(target)
                    const list = returnedBy.get(target)
                    if (list) list.push(fn)
                    else returnedBy.set(target, [fn])
                }
                return
            }
            if (n.op === NodeOp.select) {
                for (let i = 1; i < countIds(n); i++) if (getRef(n, i)) visit(getRef(n, i))
                return
            }
            const read = rt.sliceOf(graph, n) === rt.Op.sliceRead
            const word = read ? rt.elementType(graph, n) === Types.vm_value && !rawSlice(unit.slices, id) : resultType(graph, n) === Types.vm_value
            const slot = word && (n.op === NodeOp.load || read) && !unit.boxedReturn ? rawSlotType(unit.nodes.get(id), true) : undefined
            if (slot === Types.u32) slotLoads.add(fn)
            else if (word && slot === undefined) direct.add(fn)
            else if (word || n.op !== NodeOp.heapHandle || getRef(n, 0) || getLiteral(graph, n, 0)) unsized.add(fn)
        }
        for (const n of graph.nodes.values()) if (n.op === NodeOp.ret && getRef(n, 0)) visit(getRef(n, 0))
    }
    const words = new Set<Function>()
    const reaching = [...direct]
    while (reaching.length) {
        const fn = reaching.pop()!
        if (words.has(fn)) continue
        words.add(fn)
        if (modes.get(fn) === 'raw') continue
        for (const caller of returnedBy.get(fn) ?? []) reaching.push(caller)
    }
    const slotSized = new Map<Function, boolean>()
    function returnsSlot(fn: Function): boolean {
        const known = slotSized.get(fn)
        if (known !== undefined) return known
        slotSized.set(fn, false)
        const sized = !unsized.has(fn) && !words.has(fn) && modes.get(fn) !== 'raw' && returnedCalls.get(fn)!.every(returnsSlot) && (returnedCalls.get(fn)!.length > 0 || slotLoads.has(fn))
        slotSized.set(fn, sized)
        return sized
    }
    const compared = new Set<Function>()
    for (const unit of planned.units.values()) {
        const graph = tracedOf(unit)
        for (const n of graph.nodes.values()) {
            if ((n.op !== NodeOp.eq && n.op !== NodeOp.ne) || countIds(n) !== 2) continue
            for (const side of [0, 1]) {
                const call = getRef(n, side)
                const other = getRef(n, 1 - side)
                if (!unit.calls.has(call) || (other && getNode(graph, other)?.op !== NodeOp.literal)) continue
                for (const callee of unit.calls.get(call)!) compared.add(planned.functions.get(callee)!)
            }
        }
    }
    const abi = new Map<Function, UnitAbi>()
    for (const [fn, unit] of planned.units) {
        const mode = modes.get(fn) === 'tagged' && !words.has(fn) && unit.returns.format?.bits === 32 && compared.has(fn) ? 'narrow' : modes.get(fn)!
        const returns = mode === 'raw' || (mode === 'tagged' && numberName(unit.returns) === 'f64') ? Types.u64 : words.has(fn) ? Types.vm_value : returnsSlot(fn) && mode !== 'narrow' ? Types.u32 : numberName(unit.returns) === 'f64' ? Types.f64 : numberName(unit.returns) === 'i64' ? Types.i64 : Types.u64
        abi.set(fn, { mode, returns, tags: paramTags(unit) })
        if (flags.has('return-modes')) console.log('RETURN-MODE', fn.name, mode, unit.returns.text)
    }
    return { abi, tags }
}

function createResolver(linker: Linker, tracer: Tracer, plan: ShapePlan, planned: Planned, reps: Representations, facts: Facts, clock: PhaseClock) {
    const { session, functions, unitOf, originOf, constructsOutOfLine, link, isRoot, sourceOfLinked, usesReceiver, thisParamOf, calleeOf } = linker
    const { graphsOf, reachableNodes } = tracer
    const fixedShapes = new Set(plan.shapes.values())
    function abiOf(fn: Function): UnitAbi {
        return reps.abi.get(fn) ?? { mode: constructsOutOfLine(fn) || unitOf(originOf(fn)).stubbed ? 'keep' : 'encoded', returns: Types.u64, tags: [] }
    }
    function numberSigns(nodes: Map<number, Rep>): Map<number, boolean> {
        const out = new Map<number, boolean>()
        for (const [node, rep] of nodes) if (numberName(rep) === 'int' || numberName(rep) === 'i64') out.set(node, numberName(rep) === 'i64')
        return out
    }
    function plannedNodeShapes(nodes: Map<number, Rep>): Map<number, intrinsics.Handle | null> {
        const out = new Map<number, intrinsics.Handle | null>()
        for (const [node, rep] of nodes) {
            const target = soleTarget(rep)
            if (rep.kind === 'number') out.set(node, propertyEval.numberShape)
            else if (rep.kind === 'undefined') out.set(node, null)
            else if (target === 'buf' && (rep.kind === 'pointer' || rep.kind === 'union')) out.set(node, propertyEval.numberShape)
            else if (target === 'str' && rep.kind === 'pointer') out.set(node, propertyEval.stringShape)
            else if (rep.kind === 'pointer') {
                const shape = targetShape(plan, target)
                if (shape !== undefined) out.set(node, shape)
            }
        }
        return out
    }
    function plannedUnions(nodes: Map<number, Rep>): Map<number, intrinsics.Handle[]> {
        const out = new Map<number, intrinsics.Handle[]>()
        for (const [node, rep] of nodes) {
            if (rep.kind !== 'pointer' || rep.targets.length < 2) continue
            const members = rep.targets.map(target => targetShape(plan, target))
            if (members.every(m => m !== undefined)) out.set(node, members as intrinsics.Handle[])
        }
        return out
    }
    function plannedParams(fn: Function): { index: number, label: string, rep: Rep }[] {
        const paramCount = sourceOfLinked(fn)?.compiled.paramCount ?? 0
        return (planned.units.get(fn)?.params ?? []).map(({ label, rep }, index) => {
            intrinsics.assert(label !== 'this' || index === paramCount, `native: ${fn.name} receiver is not param ${paramCount}`)
            return { index, label, rep }
        })
    }
    function paramShapesOf(fn: Function): Map<number, intrinsics.Handle> {
        const out = new Map<number, intrinsics.Handle>()
        for (const { index, rep } of plannedParams(fn)) {
            const shape = plannedShape(plan, rep)
            if (shape !== undefined) out.set(index, shape)
        }
        return out
    }
    function unionParams(fn: Function): number[] {
        return plannedParams(fn).filter(({ rep }) => unionWord(rep)).map(({ index }) => index)
    }
    function constantParams(fn: Function): Map<number, ParamConstant> {
        const out = new Map<number, ParamConstant>()
        for (const { index, rep } of plannedParams(fn)) {
            const constant = rep.constant
            if (!constant || isRoot(fn)) continue
            if (constant.fn) out.set(index, { handle: session.linkFunction(constant.fn) as intrinsics.Handle })
            else if (constant.handle !== undefined) out.set(index, { handle: constant.handle })
            else out.set(index, { literal: constant.literal! })
        }
        return out
    }
    function calleeParams(resolved: Resolution): Map<number, Map<number, Arrival>> {
        const out = new Map<number, Map<number, Arrival>>()
        for (const [call, unit] of resolved.callees) {
            const callee = planned.functions.get(unit)!
            const shapes = paramShapesOf(callee)
            out.set(call, new Map(plannedParams(callee).map(({ index, rep }) => [index, { rep, shaped: shapes.has(index) }])))
        }
        return out
    }
    function plannedCall(g: NodeSpace, caller: Function, local: UnitPlan | undefined, bound: Map<number, PlannedUnit>, site: propertyEval.CallSite): propertyEval.CallBinding | undefined {
        let callees = local?.calls.get(site.call)
        if (!callees?.size && site.context === undefined) {
            const linked = calleeOf(g, site.target)
            const fn = linked && isLocalStub(linked) ? functions[(linked as any).__localTarget] : linked
            const candidates = fn ? plan.units.get(originOf(fn)) ?? [] : []
            const matching = candidates.length > 1 ? candidates.filter(unit => {
                const paramCount = sourceOfLinked(fn!)?.compiled.paramCount ?? 0
                return paramShapesOf(planned.functions.get(unit)!).get(paramCount) === site.receiver
            }) : candidates
            callees = matching.length === 1 ? new Set(matching) : undefined
        }
        if (!callees?.size) return
        const signatureOf = (unit: PlannedUnit) => `${unit.params.map(p => `${p.label}: ${p.rep.text}`).join()}->${unit.returns.text}|${unit.boxes}|${unit.boxedReturn}`
        if (callees.size > 1 && site.context !== undefined && new Set([...callees].map(signatureOf)).size === 1) callees = new Set([[...callees][0]])
        if (callees.size > 1) throw `native: ${caller.name} %${site.call} reaches ${callees.size} planned units: ${[...callees].map(u => `${u.fn.name}${u.signature}`).join(' | ')}`
        const unit = [...callees][0]
        bound.set(site.call, unit)
        const callee = planned.functions.get(unit)!
        const source = sourceOfLinked(callee)
        if (!source) return
        const paramCount = source.compiled.paramCount
        const receiver = site.context === undefined ? source.blocks.liveIn[0].has(source.compiled.registerCount) : usesReceiver(callee) && site.receiver !== undefined
        const shapes = paramShapesOf(callee)
        const own = local?.nodes.get(site.call)
        const returned = own && own.kind !== 'never' ? { ...own, nullable: own.nullable || unit.returns.nullable } : unit.returns
        const calleeAbi = abiOf(callee)
        const boxedFloat = numberName(returned) === 'f64' && calleeAbi.returns === Types.vm_value
        const numeric = returned.kind === 'number' && !boxedFloat
        const result = numeric ? propertyEval.numberShape : plannedShape(plan, returned)
        const origin = originOf(callee)
        const target = callee === origin ? undefined : site.context !== undefined || site.target.op === NodeOp.localTarget ? link(callee) : session.linkFunction(callee)
        const boxedResult = local?.calls.has(site.call) ? local.boxedCalls.has(site.call) : unit.boxedReturn
        return {
            paramCount: site.context !== undefined && !receiver ? site.args.length : paramCount, receiver,
            receiverShape: receiver ? shapes.get(paramCount) : undefined,
            argShapes: Array.from({ length: paramCount }, (_, i) => shapes.get(i)),
            result, nullish: returned.kind === 'undefined' || undefined, returnsReceiver: (receiver && unit.returnsSelf) || undefined, float: boxedFloat || undefined, union: unionWord(returned) || undefined,
            stringWord: (isStringRep(returned) && boxedResult) || undefined,
            boxed: ((numberName(returned) === 'int' || numberName(returned) === 'i64') && boxedResult) || undefined,
            decode: (result !== undefined && !isStringRep(returned) && !numeric && !propertyEval.reducedShape(result) && calleeAbi.mode !== 'raw' && (calleeAbi.mode === 'encoded' || unionWord(returned))) || boxedFloat ? pstack0Base() : undefined,
            target,
            returns: calleeAbi.mode === 'raw' ? Types.u64 : calleeAbi.returns === Types.u64 ? undefined : calleeAbi.returns,
        }
    }
    function realizeCodecs(fn: Function, resolved: Resolution, calleeParams: Map<number, Map<number, Arrival>>, rawCalls: Set<number>): void {
        const { graph, shapes, encoded, local } = resolved
        const nodes = local?.nodes ?? new Map<number, Rep>()
        const abi = abiOf(fn)
        const floats = floatValues(graph)
        const own = new Set(ownRets(graph))
        function encode(value: number): number {
            return addNode(graph, NodeOp.encode, [value, { literal: pstack0Base() }])
        }
        function decode(value: number): number {
            return addNode(graph, NodeOp.decode, [value, { literal: pstack0Base() }])
        }
        function unbox(value: number): number {
            return addNode(graph, NodeOp.unbox, [value], Types.i64)
        }
        function union(x: Operand): boolean {
            if (typeof x !== 'number' || !x) return false
            if (rawCalls.has(tailOf(graph, x))) return false
            const rep = nodes.get(x) ?? nodes.get(tailOf(graph, x))
            return !!rep && unionWord(rep)
        }
        function stringTarget(x: number): boolean {
            const rep = x ? nodes.get(x) ?? nodes.get(tailOf(graph, x)) : undefined
            return !!rep && union(x) && rep.targets.includes('str')
        }
        function typeofKinds(x: number): number {
            const rep = nodes.get(x) ?? nodes.get(tailOf(graph, x))!
            return rep.targets.some(target => target !== 'str') ? typeofStrings | typeofObjects : typeofStrings
        }
        function word(x: Operand): boolean {
            if (typeof x !== 'number' || !x) return false
            const n = getNode(graph, tailOf(graph, x))
            return !!n && (n.op === NodeOp.encode || n.op === NodeOp.box || resultType(graph, n) === Types.vm_value)
        }
        function rawLoad(id: number): boolean {
            return getNode(graph, id)?.op === NodeOp.load && rawSlice(local?.unit.slices, id)
        }
        function object(x: Operand): boolean {
            if (typeof x !== 'number') return false
            const value = tailOf(graph, x)
            if (!value || encoded.has(value)) return false
            if (!shapes.has(value) && !(pointerOfShapes(nodes.get(value)) && (graph.blocks[0].params.includes(value) || rawLoad(value)))) return false
            if (getNode(graph, value)?.op === NodeOp.alloca) throw `native: ${graph.name} lets stack object %${value} escape as a vm_value`
            return true
        }
        function encodedWord(x: Operand): boolean {
            return typeof x === 'number' && !!x && (encoded.has(x) || encoded.has(tailOf(graph, x)))
        }
        function stringWord(x: Operand): number | undefined {
            if (typeof x !== 'number' || !x || word(x)) return
            const n = getNode(graph, tailOf(graph, x))
            const handle = n?.op === NodeOp.heapHandle && !getRef(n, 0) ? getLiteral(graph, n, 0) as intrinsics.Handle : 0 as intrinsics.Handle
            const rep = nodes.get(x) ?? nodes.get(tailOf(graph, x))
            if (!(handle && heap.isString(handle)) && !isStringRep(rep)) return
            return tagVmHandleNode(graph, x)
        }
        function toWord(x: Operand): Operand {
            if (typeof x !== 'number') return { literal: x.literal * 2 }
            if (union(x) || word(x)) return x
            return stringWord(x) ?? (object(x) ? encode(x) : addNode(graph, NodeOp.box, [x], Types.vm_value))
        }
        function asWord(x: Operand): Operand {
            return object(x) ? encode(x as number) : x
        }
        function arrival(x: Operand, rep: Rep | undefined, shaped: boolean, into: string): Operand {
            if (rep && unionWord(rep)) return toWord(x)
            if (shaped && (encodedWord(x) || (pointerOfShapes(rep) && word(x)))) return decode(x as number)
            if (!union(x)) return x
            if (numberName(rep) === 'f64') return addNode(graph, NodeOp.convert, [unbox(x as number)], Types.f64)
            if (rep?.kind === 'number') return unbox(x as number)
            if (isStringRep(rep)) return vmHandleNode(graph, x as number)
            if (shaped) return decode(x as number)
            throw `native: ${graph.name} passes union word %${x} into ${into} (${rep?.text ?? 'no rep'})`
        }
        function coerce(id: number, slots: number[], to: (x: Operand, i: number) => Operand): void {
            const n = getNode(graph, id)!
            const operands = getOperands(graph, n)
            let changed = false
            for (const i of slots) {
                const next = to(operands[i], i)
                if (next === operands[i]) continue
                operands[i] = next
                changed = true
            }
            if (changed) putCopy(graph, id, n, operands)
        }
        function storeWord(id: number, n: GraphNode): void {
            const value = getOperand(graph, n, 3)
            if (typeof value !== 'number' || !floats.has(tailOf(graph, value))) {
                coerce(id, [3], local?.unit.boxes ? toWord : asWord)
                return
            }
            const cell = addNode(graph, NodeOp.pstack, [getRef(n, 0), 0, 0, { literal: 8 }])
            const stored = addNode(graph, NodeOp.store, [cell, cell, { literal: 0 }, value], Types.f64)
            const handle = addNode(graph, NodeOp.or, [encode(cell), { literal: heap.pstackBoxWordTag ^ heap.pstackWordTag }])
            putCopy(graph, id, n, [stored, ...getOperands(graph, n, 1, 3), handle])
        }
        function returnWord(id: number, n: GraphNode): void {
            if (!own.has(id)) return
            const value = getRef(n, 0)
            if (abi.mode === 'raw' && word(value)) coerce(id, [0], () => decode(value))
            else if (abi.mode === 'keep' && !!local && unionWord(local.unit.returns) && rawCalls.has(tailOf(graph, value))) coerce(id, [0], () => encode(value))
            else if (abi.mode === 'keep' && !!local && unionWord(local.unit.returns)) coerce(id, [0], toWord)
            else if (abi.mode === 'encoded') coerce(id, [0], asWord)
        }
        for (const [id, n] of [...graph.nodes]) {
            if (n.op === NodeOp.store && typeOf(n) === Types.vm_value) storeWord(id, n)
            else if (n.op === NodeOp.ret) returnWord(id, n)
            else if (n.op === NodeOp.call && word(getRef(n, 1))) {
                const ptr = decode(getRef(n, 1))
                const code = addNode(graph, NodeOp.load, [getRef(n, 0), ptr, 0], Types.fnptr)
                coerce(id, [1], () => addNode(graph, NodeOp.indirectTarget, [code, ptr]))
            } else if (n.op === NodeOp.bitconvert) coerce(id, [0], asWord)
