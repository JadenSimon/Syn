/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import type { TraceSession } from './trace2'
import { NumericOps, OrderedValues, dumpGraph, floatValues, type Graph, type GraphNode } from './lowering2'
import {
    cloneRefs, copyNode, countIds, countLiterals, createFnType, getLiteral, getOperands, getRef, makeNode, type Operand, setGraphBlocks, withNodes,
    setFact, setLiteral, setOperand, setRef, setType, type TypeOperand, typeOf, typeSlots,
    NodeOp,
    opName,
    setNode, deleteNode,
    putNode,
    getNode, hasNode,
    type NodeSpace,
    putCopy,
    addNode,
    withOperand,
    addCopy, retypeNode, insertNode,
} from './graph-node'
import { isSignedType } from './lowering'
import { type HeapState, snapshotField, snapshotKeys } from './heap-records'
import { newSymbolId, symbolOf, symbolValue, tagVmHandle, tagVmScalar, vmValue } from './vm'
import * as native from './native'
import { Op as RtOp, bindingOf, callOf, earlyCalls } from './rt'
import { globals as builtinGlobals } from './builtins'

type Handle = intrinsics.Handle
const Types = intrinsics.Types

export const numberShape = 0xFFFFFFFE as Handle
const OrderedOps = new Set([...OrderedValues, NodeOp.alloca])
function valueStart(n: GraphNode): number {
    return n.op === NodeOp.after ? countIds(n) - 1 : OrderedOps.has(n.op) ? 1 : 0
}
const iteratorKey = heap.fromJsSymbol(Symbol.iterator)
export const stringShape = heap.fromJsString('')

export interface PropertyEvalOptions {
    mapCapture?: (capture: any) => any
    shouldInline?: (fn: Function) => boolean
    accessors?: 'inline' | 'call'
    representation?: 'auto' | 'values' | 'memory'
    pointers?: Map<number, Handle>
    bound?: Map<u32, number>
    unionPointers?: Map<number, number>
    partial?: boolean
    constructed?: Constructed
    calls?: (site: CallSite) => CallBinding | undefined
    locate?: (shape: Handle, path: string) => { shape?: Handle, decode?: number, union?: boolean, float?: boolean, boxed?: boolean, number?: boolean } | undefined
    iterationField?: (method: Handle) => Handle | undefined
    stored?: (shape: Handle, path: string, value: Handle) => void
    unify?: (a: Handle, b: Handle) => void
}

export interface CallSite {
    call: number
    target: GraphNode
    receiver: Handle | undefined
    args: (Handle | undefined)[]
    numbers: boolean[]
    floats: boolean[]
    signed: boolean[]
    encoded: boolean[]
    nullish?: boolean[]
    demanded: boolean
    context?: Handle
    throughMemory?: boolean
    locations?: ([Handle, string] | undefined)[]
    embedded?: ([Handle, number] | undefined)[]
    receiverEmbedded?: [Handle, number]
    constants?: (number | undefined)[]
    terminal?: boolean
}

export interface CallBinding {
    paramCount: number
    receiver: boolean
    receiverShape?: Handle
    result?: Handle
    union?: boolean
    float?: boolean
    returnSlot?: { at: number, size: number }
    target?: number
    returns?: intrinsics.Types
    heap?: number[]
    decode?: number
    reads?: Handle[]
    location?: [Handle, string]
    boxed?: boolean
    stores?: [from: number, into: number][]
    defaults?: number
}

export interface Constructed {
    refinements: Map<Handle, Map<Handle, Handle>>
    embedded?: Map<number, { parent: number, key: Handle }>
    fixed?: Map<Handle, Map<Handle, Handle>>
    pointees?: Map<Handle, Map<Handle, Handle>>
}

export interface AccessorCall {
    fn: Function
    keys: Handle[]
    proto: Handle
    pointer: boolean
}

interface Layout {
    keys: Handle[]
    offsets: number[]
    nested: (Handle | undefined)[]
    size: number
}

interface Memory extends Layout {
    ptr: number
    base: number
    shape: Handle
    reduced: boolean
    pointer: boolean
    address?: [ref: number, literal: number]
    decoded?: boolean
    union?: boolean
    owner?: Handle
}

export interface Resolved {
    graph: Graph
    calls: Map<number, AccessorCall>
    addresses: Map<number, number>
    shapes: Map<number, Handle>
    numbers: Set<number>
    strings: Set<number>
    encoded: Set<number>
    unions: Set<number>
    arrayIterations: Map<number, Handle>
    locations: Map<number, [shape: Handle, path: string]>
}

const followedOps = new Set([NodeOp.load, NodeOp.store, NodeOp.call, NodeOp.pstack])

export function resolveProperties(
    graph: Graph,
    session: TraceSession,
    objects: Map<number, Handle>,
    opts: PropertyEvalOptions = {},
): Resolved {
    const runtime = session.runtime
    if (!runtime) throw 'property-eval: the session must stay entered from tracing through resolution'
    const records = runtime.objects
    const tracer = runtime.tracer
    intrinsics.assert(graph.ids === runtime.ids, 'property-eval: the graph must come from the current trace runtime')
    const source: NodeSpace = { nodes: new Map(graph.nodes), ids: graph.ids, literals: graph.literals }
    for (const [id, n] of [...source.nodes]) {
        if (n.op !== NodeOp.rt || getLiteral(runtime, n, 1) !== RtOp.assign) continue
        const from = opts.pointers?.get(getRef(n, 3))
        const target = getNode(source, getRef(n, 2))
        if (from === undefined || from === numberShape || from === stringShape) continue
        if (target?.op !== NodeOp.heapHandle || getRef(target, 0) || getRef(target, 1) || countIds(target) < 2) continue
        const state = getLiteral(runtime, target, 1) as Handle
        const keys = dataKeys(state)
        const copied = dataKeys(from)
        if (copied.some(key => !keys.includes(key))) continue
        const merged = heap.shallowClone(state)
        const snapshot = withOperand(runtime, target, 1, { literal: merged })
        let token = getRef(n, 0)
        for (const key of copied) {
            const read = addNode(source, NodeOp.getProp, [token, getRef(n, 3), { literal: key }])
            token = read
            heap.setProperty(merged, key, heap.boxSymbol(read))
            snapshot[2 + keys.indexOf(key)] = read
        }
        const value = addCopy(source, target, snapshot)
        putNode(source, id, NodeOp.after, [token, value])
        for (const [user, m] of [...source.nodes]) {
            if (user === id) continue
            let ops: Operand[] | undefined
            for (let i = 0; i < countIds(m); i++) {
                if (getRef(m, i) !== id) continue
                const ordering = i < valueStart(m)
                ops ??= getOperands(runtime, m)
                ops[i] = ordering ? token : value
            }
            if (ops) putCopy(source, user, m, ops)
        }
    }
    const out = withNodes(graph, new Map())
    for (const [id, n] of source.nodes) putCopy(out, id, n)
    if (intrinsics.argv().includes(`pe-source:${graph.name}`)) console.log(dumpGraph(graph))
    const runtimeCalls = new Set<number>()
    for (const [id, n] of source.nodes) {
        if (n.op !== NodeOp.rt || !earlyCalls.has(getLiteral(runtime, n, 1))) continue
        const callee = addNode(source, NodeOp.heapHandle, [{ literal: session.linkFunction(bindingOf(getLiteral(runtime, n, 1))!.impl!) }])
        putCopy(out, callee, getNode(source, callee)!)
        setNode(source, id, callOf(runtime, n, callee))
        putCopy(out, id, getNode(source, id)!)
        runtimeCalls.add(id)
    }

    const cells = new Map<number, Handle>()
    const memory = new Map<number, Memory>()
    const addressed = new Map<number, Memory>()
    const forward = new Map<number, number>()
    const written = new Set<number>()
    for (const n of source.nodes.values()) if (n.op === NodeOp.setProp) written.add(getRef(n, 1))
    let unordered = 0
    function readonlyToken(): number {
        if (!unordered) {
            unordered = addNode(out, NodeOp.nilEffect, [])
        }
        return unordered
    }
    let sealedTargets: Set<Handle> | undefined
    function readonly(shape: Handle): boolean {
        if (!sealedTargets) {
            sealedTargets = new Set()
            for (const cell of session.sealed) sealedTargets.add(heap.indirectTarget(cell))
        }
        return session.sealed.has(shape) || sealedTargets.has(shape)
    }
    function layout(shape: Handle): Layout {
        const keys = dataKeys(shape)
        const fields = opts.constructed?.refinements.get(shape)
        const offsets: number[] = []
        const nested: (Handle | undefined)[] = []
        let size = 0
        for (const key of keys) {
            offsets.push(size)
            const inner = fields?.get(key)
            nested.push(inner)
            size += inner !== undefined ? layout(inner).size : 8
        }
        return { keys, offsets, nested, size }
    }
    const numbers = new Set<number>()
    const strings = new Set<number>()
    for (const [id, shape] of opts.pointers ?? []) {
        if (shape === numberShape) {
            numbers.add(id)
            continue
        }
        if (shape === stringShape) {
            strings.add(id)
            continue
        }
        if (opts.unionPointers?.has(id)) continue
        const fields = layout(shape)
        memory.set(id, { ...fields, ptr: id, base: 0, shape, reduced: fields.keys.length === 1 && readonlyKeys(shape, fields.keys), pointer: true, address: [id, 0] })
    }
    const representation = opts.representation ?? 'auto'
    const byHandle = new Map<Handle, Memory>()
    let initToken = 0
    let allocToken: number | undefined
    function heapAllocate(size: number): number {
        let token = allocToken
        if (token === undefined) {
            if (!initToken) {
                initToken = addNode(out, NodeOp.nilEffect, [])
            }
            token = initToken
        }
        const ptr = addNode(out, NodeOp.pstack, [token, 0, 0, { literal: size }])
        if (allocToken !== undefined) allocToken = ptr
        else initToken = ptr
        return ptr
    }
    let entryOrdering: Map<number, number[]> | undefined
    const entryNodes = new Map<number, number>()
    const forwardOrdering = new Map<number, number[]>()
    function forwardPreds(block: number): number[] {
        const known = forwardOrdering.get(block)
        if (known) return known
        const preds = entryPreds(block)
        const entry = entryNodes.get(block) ?? -block
        const forward = preds.filter(token => token !== entry && !before(token, 'all').has(entry))
        forwardOrdering.set(block, forward)
        return forward
    }
    function entryPreds(block: number): number[] {
        if (!entryOrdering) {
            entryOrdering = new Map()
            const wrapped = new Map<number, number[]>()
            for (const n of source.nodes.values()) {
                if (n.op !== NodeOp.after) continue
                const last = getRef(n, countIds(n) - 1)
                if (getNode(source, last)?.op !== NodeOp.apply) continue
                const list = wrapped.get(last) ?? []
                for (let i = 0; i < countIds(n) - 1; i++) if (getRef(n, i)) list.push(getRef(n, i))
                wrapped.set(last, list)
            }
            for (const [id, n] of source.nodes) if (n.op === NodeOp.nilEffect && countLiterals(n)) entryNodes.set(getRef(n, 0), id)
            for (const b of graph.blocks) {
                const stack = [b.bodyId]
                while (stack.length) {
                    const id = stack.pop()!
                    const n = getNode(source, id)
                    if (!n) continue
                    if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) stack.push(getRef(n, i))
                    else if (n.op === NodeOp.after) stack.push(getRef(n, countIds(n) - 1))
                    else if (n.op === NodeOp.apply) {
                        const list = entryOrdering.get(getRef(n, 0)) ?? []
                        const ordering = wrapped.get(id)
                        if (ordering) list.push(...ordering)
                        else list.push(entryNodes.get(b.id) ?? -b.id)
                        entryOrdering.set(getRef(n, 0), list)
                    }
                }
            }
        }
        return entryOrdering.get(block) ?? []
    }
    type Crossing = 'forward' | 'all'
    function crossPreds(block: number, crossing: Crossing): number[] {
        return crossing === 'all' ? entryPreds(block) : forwardPreds(block)
    }
    function pushOrdering(stack: number[], seen: Set<number>, id: number, crossing: Crossing): void {
        if (id < 0) {
            for (const p of crossPreds(-id, crossing)) if (!seen.has(p)) stack.push(p)
            return
        }
        const n = getNode(source, id)
        if (!n) return
        if (n.op === NodeOp.nilEffect) {
            if (countLiterals(n)) for (const p of crossPreds(getRef(n, 0), crossing)) if (!seen.has(p)) stack.push(p)
            return
        }
        if (n.op === NodeOp.after || n.op === NodeOp.select || n.op === NodeOp.inlined) {
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (ref && !seen.has(ref)) stack.push(ref)
            }
            return
        }
        if (OrderedOps.has(n.op) && getRef(n, 0) && !seen.has(getRef(n, 0))) stack.push(getRef(n, 0))
    }
    const orderedBefore = new Map<string, Set<number>>()
    function before(id: number, crossing: Crossing = 'forward'): Set<number> {
        const key = `${crossing}${id}`
        const known = orderedBefore.get(key)
        if (known) return known
        const seen = new Set<number>()
        orderedBefore.set(key, seen)
        const stack: number[] = []
        pushOrdering(stack, seen, id, crossing)
        while (stack.length) {
            const at = stack.pop()!
            if (seen.has(at)) continue
            seen.add(at)
            pushOrdering(stack, seen, at, crossing)
        }
        return seen
    }
    function plainFunction(shape: Handle): boolean {
        return heap.isCallable(shape) && !heap.getPropertyDescriptor(shape, heap.closureCallKey)
    }
    function firstUse(value: number): number | undefined {
        const calls = callUses.get(value) ?? []
        return calls.find(u => calls.every(v => v === u || before(v).has(u)))
    }
    function snapshotNode(id: number): GraphNode | undefined {
        const n = getNode(source, id)
        if (!n || n.op !== NodeOp.heapHandle || getRef(n, 0) || getRef(n, 1) || countIds(n) < 2) return
        return n
    }
    const homes = new Map<Handle, Memory>()
    for (const [cell, param] of opts.bound ?? []) {
        const home = memory.get(param)
        if (!home) throw `property-eval: %${param} holds cell ${cell} but has no known shape`
        homes.set(cell as Handle, home)
    }
    function materialize(id: number, handle: Handle): Memory {
        const known = memory.get(id)
        if (known) return known
        const n = snapshotNode(id)
        const identity = getNode(source, id)
        const cell = identity?.op === NodeOp.heapHandle && !getRef(identity, 0) ? getLiteral(runtime, identity, 0) as Handle : undefined
        const fields = layout(handle)
        const keys = fields.keys
        let mem = cell !== undefined ? homes.get(cell) : undefined
        if (mem && (mem.keys.length !== keys.length || mem.keys.some((k, i) => k !== keys[i]))) {
            throw `property-eval: %${id} changes the shape of an object that lives in memory`
        }
        if (!mem) {
            const reduced = keys.length <= 1 && readonlyKeys(handle, keys)
            let ptr = 0
            if (!reduced) ptr = heapAllocate(Math.max(fields.size, 8))
            mem = { ...fields, ptr, base: 0, shape: handle, reduced, pointer: false }
            if (cell !== undefined) homes.set(cell, mem)
        }
        memory.set(id, mem)
        byHandle.set(handle, mem)
        if (!n) return mem
        for (let i = 0; i < keys.length; i++) {
            const nested = snapshotNode(getRef(n, 2 + i))
            if (nested) materialize(getRef(n, 2 + i), getLiteral(runtime, nested, 1) as Handle)
        }
        return mem
    }
    for (const [id, handle] of objects) {
        if (representation === 'values' || (representation === 'auto' && !written.has(id))) {
            cells.set(id, records.intern(handle))
            continue
        }
        materialize(id, handle)
    }
    for (const [id, { parent, key }] of opts.constructed?.embedded ?? []) {
        const owner = memory.get(parent)
        if (!owner) throw `property-eval: %${id} is embedded in %${parent}, which has no memory`
        const at = owner.keys.indexOf(key)
        const inner = at < 0 ? undefined : owner.nested[at]
        if (inner === undefined) throw `property-eval: %${id} is embedded in a field of %${parent} that holds no object`
        const op = getNode(source, id)?.op
        const pointer = op === NodeOp.call
        memory.set(id, { ...layout(inner), ptr: owner.ptr, base: owner.base + owner.offsets[at], shape: inner, reduced: false, pointer, address: pointer ? [id, 0] : undefined })
    }
    function nestedMemory(id: number, i: number): [number, Memory] | undefined {
        const n = snapshotNode(id)
        const ref = n ? getRef(n, 2 + i) : 0
        const nested = ref ? memory.get(ref) : undefined
        return nested && !nested.pointer ? [ref, nested] : undefined
    }
    const initialized = new Set<Memory>()
    const initStores: [shape: Handle, path: string, value: number][] = []
    function initChain(id: number, mem: Memory, token: number, visited = new Set<Memory>()): number {
        initialized.add(mem)
        visited.add(mem)
        if (mem.reduced) return token
        const state = snapshotNode(id) ? getLiteral(runtime, snapshotNode(id)!, 1) as Handle : mem.shape
        for (let i = 0; i < mem.keys.length; i++) {
            if (mem.nested[i] !== undefined) continue
            const nested = nestedMemory(id, i)
            if (!nested && !heap.getOwnProperty(state, mem.keys[i])) continue
            const slot = slotAt(state, mem.keys[i])
            const [ref, literal] = nested ? addressOf(nested[1]) : operandOf(slot)
            if (!nested && holdsAlready(mem, i, ref)) continue
            const store = newId()
            putNode(out, store, NodeOp.store, [token, mem.ptr, { literal: mem.base + mem.offsets[i] }, ref || { literal }], Types.u64)
            token = store
            const storedShape = nested ? nested[1].shape : homes.get(slot)?.shape ?? (ref ? memory.get(ref)?.shape : heap.isBoxedF64(slot) ? numberShape : undefined)
            if (storedShape !== undefined) opts.stored?.(mem.shape, String(mem.offsets[i]), storedShape)
            else if (ref) initStores.push([mem.shape, String(mem.offsets[i]), ref])
            if (nested && !visited.has(nested[1])) token = initChain(nested[0], nested[1], token, visited)
        }
        return token
    }
    function holdsAlready(mem: Memory, i: number, ref: number): boolean {
        const read = ref ? getNode(source, ref) : undefined
        if (read?.op !== NodeOp.getProp || getRef(read, 2)) return false
        return memory.get(getRef(read, 1)) === mem && getLiteral(runtime, read, 2) === mem.keys[i]
    }
    const consumers = new Map<number, number[]>()
    for (const [id, n] of source.nodes) {
        if (n.op !== NodeOp.call) continue
        for (let i = 1; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!memory.has(ref)) continue
            const list = consumers.get(ref)
            if (!list) consumers.set(ref, [id])
            else if (!list.includes(id)) list.push(id)
        }
    }
    for (const [id, mem] of memory) {
        if (mem.pointer || written.has(id)) continue
        for (const consumer of consumers.get(id) ?? []) {
            const call = getNode(out, consumer)!
            const token = initChain(id, mem, getRef(call, 0))
            putCopy(out, consumer, call, withOperand(runtime, call, 0, token))
        }
    }
    for (const [id, mem] of memory) {
        if (mem.pointer || mem.reduced || initialized.has(mem)) continue
        if (!initToken) {
            initToken = addNode(out, NodeOp.nilEffect, [{ literal: 0 }])
        }
        initToken = initChain(id, mem, initToken)
    }
    if (initToken) {
        for (const [id, n] of source.nodes) if (n.op === NodeOp.nilEffect && (getRef(n, 0) || graph.root) === graph.root) forward.set(id, initToken)
    }
    const roots = [...cells.values()]
    const start = records.capture(roots)

    const paramSlots = new Map<number, { block: number, index: number }>()
    for (const b of graph.blocks) b.params.forEach((p, index) => paramSlots.set(p, { block: b.id, index }))
    const inbound = new Map<number, number[]>()
    const sunk = new Map<number, number>()
    for (const [id, n] of source.nodes) {
        if (n.op === NodeOp.after && countIds(n) === 2 && getNode(source, getRef(n, 1))?.op === NodeOp.apply) sunk.set(getRef(n, 1), getRef(n, 0))
        if (n.op !== NodeOp.apply) continue
        const list = inbound.get(getRef(n, 0))
        if (list) list.push(id)
        else inbound.set(getRef(n, 0), [id])
    }

    const after = new Map<number, HeapState>()
    const entries = new Map<number, { state: HeapState, block: number, arrivalState: (apply: number) => HeapState | undefined }>()
    const pending = new Set<number>()
    const calls = new Map<number, AccessorCall>()

    function newId(): number {
        return newSymbolId(tracer)
    }

    function sameState(a: HeapState, b: HeapState): boolean {
        if (a.size !== b.size) return false
        for (const [cell, value] of a) if (b.get(cell) !== value) return false
        return true
    }

    function stateAt(token: number): HeapState | undefined {
        for (;;) {
            const n = getNode(source, token)
            if (!n) throw `property-eval: token %${token} is not in the graph`
            if (n.op === NodeOp.getProp || n.op === NodeOp.setProp) return evaluate(token)
            if (n.op === NodeOp.nilEffect) return countLiterals(n) ? blockEntry(getRef(n, 0)) : start
            if (n.op === NodeOp.after && countIds(n) === 2) {
                token = getRef(n, 0)
                continue
            }
            if (!followedOps.has(n.op)) throw `property-eval: cannot follow the token through ${n.op} %${token}`
            token = getRef(n, 0)
        }
    }


    function blockEntry(block: number): HeapState | undefined {
        if (block === graph.root) return start
        return joinArrivals(block, block, apply => {
            const token = sunk.get(apply)
            return token ? stateAt(token) : blockEntry(applyingBlock(apply))
        })
    }

    let applyingBlocks: Map<number, number> | undefined
    function applyingBlock(apply: number): number {
        if (!applyingBlocks) {
            applyingBlocks = new Map()
            for (const b of graph.blocks) {
                const seen = new Set<number>()
                const stack = [b.bodyId]
                while (stack.length) {
                    const id = stack.pop()!
                    if (!id || seen.has(id)) continue
                    seen.add(id)
                    const n = getNode(source, id)
                    if (!n || n.op === NodeOp.block || n.op === NodeOp.param) continue
                    if (n.op === NodeOp.apply) applyingBlocks.set(id, b.id)
                    for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
                }
            }
        }
        const block = applyingBlocks.get(apply)
        if (block === undefined) throw `property-eval: %${apply} is not in any block body`
        return block
    }

    function joinArrivals(key: number, block: number, arrivalState: (apply: number) => HeapState | undefined): HeapState | undefined {
        const known = entries.get(key)
        if (known) return known.state
        if (pending.has(key)) return
        pending.add(key)
        const _key = key
        defer pending.delete(_key)
        let state: HeapState | undefined
        for (const apply of inbound.get(block) ?? []) {
            const arrival = arrivalState(apply)
            if (!arrival) continue
            if (state && !sameState(state, arrival)) throw `property-eval: B${block} joins different object states`
            state = arrival
        }
        if (!state && pending.size > 1) return
        if (!state) throw `property-eval: B${block} is only reached through itself`
        entries.set(key, { state, block, arrivalState })
        return state
    }

    function objectOf(id: number): Handle {
        const known = cells.get(id)
        if (known !== undefined) return known
        const n = getNode(source, id)
        if (n?.op === NodeOp.heapHandle && !getRef(n, 0)) return records.intern(getLiteral(runtime, n, 0) as Handle)
        throw `property-eval: no object for %${id} (${n?.op ?? 'missing'})`
    }

    function addressOf(mem: Memory): [ref: number, literal: number] {
        const address = computeAddress(mem)
        if (address[0] && !mem.reduced) addressed.set(address[0], mem)
        return address
    }
    function computeAddress(mem: Memory): [ref: number, literal: number] {
        if (mem.address) return mem.address
        if (!mem.reduced && !mem.base) return mem.address = [mem.ptr, 0]
        if (!mem.reduced) {
            const at = addNode(out, NodeOp.add, [mem.ptr, { literal: mem.base }])
            return mem.address = [at, 0]
        }
        mem.address = [0, 0]
        if (mem.keys.length) mem.address = operandOf(slotAt(mem.shape, mem.keys[0]))
        return mem.address
    }

    function operandOf(slot: Handle): [ref: number, literal: number] {
        if (!slot) return [0, 0]
        const mem = homes.get(slot) ?? byHandle.get(slot)
        if (mem) return addressOf(mem)
        if (heap.isBoxedF64(slot)) {
            const value = heap.unboxF64(slot)
            const id = intrinsics.getNanId(value)
            return id ? [id, 0] : [0, value]
        }
        const id = addNode(out, NodeOp.heapHandle, [{ literal: slot }])
        cells.set(id, records.intern(slot))
        return [id, 0]
    }

    function slotOf(n: GraphNode, i: number): Handle {
        const ref = getRef(n, i)
        if (!ref) return heap.boxF64(getLiteral(runtime, n, i)) as Handle
        const cell = cells.get(ref)
        if (cell !== undefined) return cell
        const target = getNode(source, ref)
        if (target?.op === NodeOp.heapHandle && !getRef(target, 0)) return getLiteral(runtime, target, 0) as Handle
        return heap.boxSymbol(ref)
    }

    function keyArg(key: Handle): u32 {
        const index = heap.keyIndex(key)
        return index === undefined ? tagVmHandle(key) : tagVmScalar(index)
    }

    function inline(id: number, fn: Handle, thisValue: u32, args: u32[], token: number): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const nested = traceModule.trace2(linked, {
            session, mapCapture: opts.mapCapture, shouldInline: opts.shouldInline,
            inputs: { thisArg: thisValue, args, effect: symbolValue(token) },
        })
        const traced = nested.graph
        for (const [nid, n] of traced.nodes) if (!hasNode(out, nid)) setNode(out, nid, n)
        for (const b of traced.blocks) if (b.id !== traced.root && !out.blockIndex.has(b.id)) out.blocks.push(b)
        setGraphBlocks(out, out.blocks)
        const result = symbolOf(nested.result)
        if (result) {
            putNode(out, id, NodeOp.inlined, [result, { literal: id }])
            return
        }
        putNode(out, id, NodeOp.after, [token, { literal: vmValue(nested.result as u32) }])
    }

    function callAccessor(id: number, fn: Handle, cell: Handle, token: number): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const target = heap.indirectTarget(cell)
        const keys = dataKeys(target)
        const callee = addNode(out, NodeOp.heapHandle, [{ literal: fn }])
        const operands: Operand[] = [token, callee, 0]
        for (const key of keys) {
            const [ref, literal] = operandOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key))).slot0 as Handle)
            operands.push(ref || { literal })
        }
        putNode(out, id, NodeOp.call, operands)
        calls.set(id, { fn: linked, keys, proto: heap.getPrototypeOf(target), pointer: false })
        bindCall(id, accessed.has(id), true)
    }

    function callTrap(id: number, fn: Handle, mem: Memory, token: number, key: [ref: number, literal: number], value?: [ref: number, literal: number]): void {
        const callee = addNode(out, NodeOp.heapHandle, [{ literal: fn }])
        const [ptr, ptrLiteral] = addressOf(mem)
        const operands: Operand[] = [token, callee, ptr || { literal: ptrLiteral }, key[0] || { literal: key[1] }]
        if (value) operands.push(value[0] || { literal: value[1] })
        putNode(out, id, NodeOp.call, operands)
        bindCall(id, accessed.has(id), true)
    }

    function callWithPointer(id: number, fn: Handle, mem: Memory, token: number, value?: [ref: number, literal: number]): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const callee = addNode(out, NodeOp.heapHandle, [{ literal: fn }])
        const operands: Operand[] = [token, callee, mem.ptr]
        if (value) operands.push(value[0] || { literal: value[1] })
        if (!mem.base) addressed.set(mem.ptr, mem)
        putNode(out, id, NodeOp.call, operands)
        calls.set(id, { fn: linked, keys: mem.keys, proto: heap.getPrototypeOf(mem.shape), pointer: true })
        bindCall(id, accessed.has(id), true)
    }

    function resolveMemory(id: number, n: GraphNode, mem: Memory): void {
        let token = getRef(n, 0)
        if (mem.pointer && getNode(source, token)?.op === NodeOp.nilEffect && (getRef(getNode(source, token)!, 0) || graph.root) === graph.root) {
            token = addNode(out, NodeOp.nilEffect, [])
        }
        const key = getLiteral(runtime, n, 2) as Handle
        const value: [number, number] = [getRef(n, 3), getRef(n, 3) ? 0 : getLiteral(runtime, n, 3)]
        const keyRef = getRef(n, 2)
        const index = keyRef ? undefined : heap.keyIndex(key)
        if (n.op === NodeOp.setProp && readonly(mem.shape)) throw `property-eval: %${id} writes a constructed object, which is placed in read-only memory`
        if (keyRef || index !== undefined) {
            const proxy = heap.getPropertyProxy(mem.shape, keyRef ? intrinsics.getNanFromId(keyRef) as Handle : key)
            if (proxy) return callTrap(id, n.op === NodeOp.getProp ? heap.getProxyGetter(proxy) : heap.getProxySetter(proxy), mem, token, [keyRef, keyRef ? 0 : index!], n.op === NodeOp.setProp ? value : undefined)
            if (keyRef) throw `property-eval: %${id} uses a computed key on a memory object without an index trap`
        }
        if (mem.reduced && n.op === NodeOp.setProp) throw `property-eval: %${id} writes a reduced object`
        if (mem.reduced && key === mem.keys[0]) {
            const [ref, literal] = addressOf(mem)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        const addr = heap.getPropertyDescriptor(mem.shape, key)
        if (!addr) {
            if (heap.getPropertyProxy(mem.shape, key)) throw `property-eval: %${id} goes through a proxy on a memory object`
            if (n.op === NodeOp.setProp) throw `property-eval: %${id} adds a key to a memory object`
            const used: GraphNode[] = []
            for (const user of valueUses.get(id) ?? []) {
                const u = getNode(source, user)!
                const first = valueStart(u)
                for (let i = first; i < countIds(u); i++) {
                    if (getRef(u, i) !== id) continue
                    used.push(u)
                    break
                }
            }
            if (used.length && used.every(u => u.op === NodeOp.call && getRef(u, 1) === id)) {
                throw `property-eval: ${graph.name ?? '?'}: ${prototypeName(mem.shape)} has no method '${heap.stringToJs(key)}'`
            }
            readUndefined(id, token)
            return
        }
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) {
            if (n.op === NodeOp.getProp && desc.flags & heap.PropFlags.has_getter) return callWithPointer(id, desc.slot0 as Handle, mem, token)
            if (n.op === NodeOp.setProp && desc.flags & heap.PropFlags.has_setter) return callWithPointer(id, desc.slot1 as Handle, mem, token, value)
            throw `property-eval: %${id} uses an accessor without the matching half`
        }
        const at = mem.keys.indexOf(key)
        if (at < 0) {
            if (n.op === NodeOp.setProp) throw `property-eval: %${id} shadows a prototype key on a memory object`
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        const fixed = opts.constructed?.fixed?.get(mem.shape)?.get(key)
        if (fixed !== undefined && n.op === NodeOp.setProp) throw `property-eval: %${id} writes a field that every construction fixes`
        if (fixed !== undefined) {
            const [ref, literal] = operandOf(fixed)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        const offset = mem.base + mem.offsets[at]
        const inner = mem.nested[at]
        if (inner !== undefined) return resolveEmbedded(id, n, mem, token, offset, inner, value)
        const embedded = mem.base && mem.address?.[0] ? mem.address[0] : 0
        const base = embedded || mem.ptr
        const displacement = embedded ? mem.offsets[at] : offset
        if (n.op === NodeOp.getProp) {
            const slot = desc.slot0 as Handle
            const stable = readonly(mem.shape)
            const identified = stable && getNode(source, mem.ptr)?.op === NodeOp.heapHandle
            if (identified && heap.isBoxedF64(slot) && !heap.boxedNanId(slot)) {
                putNode(out, id, NodeOp.after, [token, { literal: heap.unboxF64(slot) }])
                return
            }
            locations.set(id, [mem.shape, String(mem.offsets[at])])
            const located = opts.locate?.(mem.shape, String(mem.offsets[at]))
            const rawFloat = !!located?.float && located.decode === undefined
            const valued = located !== undefined && located.shape === undefined && !located.number && !rawFloat
            const load = newId()
            putNode(out, load, NodeOp.load, [stable ? readonlyToken() : token, base, { literal: displacement }], rawFloat ? Types.f64 : valued ? Types.vm_value : Types.u64)
            putNode(out, id, NodeOp.after, [token, load])
            if (rawFloat) {
                numbers.add(id)
                return
            }
            if (located?.float) unbox(id, load, located.decode!)
            if (located?.boxed) unboxNumber(id, load)
            if (located?.number) {
                numbers.add(id)
                return
            }
            if (valued) return
            if (heap.isString(slot)) {
                commit(id, stringShape)
                return
            }
            if (located !== undefined) {
                const ptr = located.decode !== undefined ? decodeHandle(load, located.decode) : load
                memory.set(id, { ...layout(located.shape!), ptr, base: 0, shape: located.shape!, reduced: false, pointer: true, address: [ptr, 0], decoded: located.decode !== undefined, union: located.union })
                return
            }
            const pointee = opts.constructed?.pointees?.get(mem.shape)?.get(key)
            if (pointee !== undefined) {
                memory.set(id, { ...layout(pointee), ptr: load, base: 0, shape: pointee, reduced: false, pointer: true, address: [load, 0] })
                return
            }
            if (isObjectSlot(slot)) {
                const shape = heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot
                memory.set(id, { ...layout(shape), ptr: load, base: 0, shape, reduced: false, pointer: true, address: [load, 0] })
                return
            }
            if (contents.get(`${mem.shape}/${mem.offsets[at]}`) === numberShape) numbers.add(id)
            return
        }
        putNode(out, id, NodeOp.store, [token, base, { literal: displacement }, value[0] || { literal: value[1] }], Types.u64)
        const storedShape = value[0] ? storedFact(value[0]) : literalStored(mem.shape, key, value[1])
        if (storedShape !== undefined && !dead(id)) opts.stored?.(mem.shape, String(mem.offsets[at]), storedShape)
    }

    function resolveEmbedded(id: number, n: GraphNode, mem: Memory, token: number, offset: number, inner: Handle, value: [number, number]): void {
        if (n.op === NodeOp.setProp) {
            const stored = value[0] ? memory.get(value[0]) : undefined
            if (!stored || stored.ptr !== mem.ptr || stored.base !== offset) throw `property-eval: %${id} reassigns an embedded field`
            forward.set(id, token)
            return
        }
        const address = addNode(out, NodeOp.add, [mem.ptr, { literal: offset }])
        putNode(out, id, NodeOp.after, [token, address])
        memory.set(id, { ...layout(inner), ptr: mem.ptr, base: offset, shape: inner, reduced: false, pointer: true, address: [id, 0], owner: mem.owner ?? mem.shape })
    }

    function write(cell: Handle, key: Handle, slot: Handle): void {
        heap.setProperty(heap.prepareWrite(cell), key, slot)
    }

    function resolveString(id: number, n: GraphNode): void {
        if (n.op !== NodeOp.getProp || getRef(n, 2)) throw `property-eval: %${id} is not a named read of a string`
        const addr = heap.getPropertyDescriptor(stringShape, getLiteral(runtime, n, 2) as Handle)
        const desc = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)) : undefined
        if (!desc || !(desc.flags & heap.PropFlags.has_getter)) throw `property-eval: %${id} reads a string property that has no getter`
        inline(id, desc.slot0 as Handle, symbolValue(getRef(n, 1)), [], getRef(n, 0))
    }

    let arrayIteratorMethod: Handle | undefined
    function iteratesArray(of: Handle): boolean {
        if (arrayIteratorMethod === undefined) {
            const proto = heap.deref(heap.getPrototypeProperty(heap.deref(session.linkFunction(builtinGlobals.Array) as Handle)))
            arrayIteratorMethod = methodOf(proto, iteratorKey)
        }
        return arrayIteratorMethod !== undefined && methodOf(of, iteratorKey) === arrayIteratorMethod
    }
    function prototypeName(shape: Handle): string {
        const proto = heap.getPrototypeOf(shape)
        for (const [name, value] of Object.entries(builtinGlobals)) {
            if (typeof value !== 'function') continue
            if (heap.deref(heap.getPrototypeProperty(heap.deref(session.linkFunction(value) as Handle))) === proto) return name
        }
        return 'object'
    }
    function methodOf(of: Handle, key: Handle): Handle | undefined {
        const addr = heap.getPropertyDescriptor(of, key)
        return addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).slot0 as Handle : undefined
    }
    const arrayIterations = new Map<number, Handle>()
    function fieldIteratesArray(of: Handle, field: Handle): boolean {
        const fields = layout(of)
        const at = fields.keys.indexOf(field)
        if (at < 0) return false
        const located = opts.locate?.(of, String(fields.offsets[at]))?.shape
        if (located !== undefined) return iteratesArray(located)
        const slot = methodOf(of, field)
        return slot !== undefined && isObjectSlot(slot) && iteratesArray(heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot)
    }
    function iterationSource(of: Handle, key: Handle): Handle | undefined {
        const method = methodOf(of, key)
        if (method === undefined) return
        if (key === iteratorKey && iteratesArray(of)) return 0 as Handle
        const field = opts.iterationField?.(method)
        return field !== undefined && fieldIteratesArray(of, field) ? field : undefined
    }
    function resolve(id: number, n: GraphNode): void {
        if (n.op === NodeOp.getProp && !getRef(n, 2)) {
            const of = shape(getRef(n, 1))
            const source = of && of !== pendingShape && of !== numberShape && of !== stringShape ? iterationSource(of, getLiteral(runtime, n, 2) as Handle) : undefined
            if (source !== undefined) arrayIterations.set(id, source)
        }
        const union = unions.get(getRef(n, 1))
        if (union && n.op === NodeOp.getProp) return resolveUnion(id, n, union)
        const mem = memory.get(getRef(n, 1))
        if (mem) return resolveMemory(id, n, mem)
        const token = getRef(n, 0)
        const cell = objectOf(getRef(n, 1))
        const key = getLiteral(runtime, n, 2) as Handle
        const addr = heap.getPropertyDescriptor(heap.indirectTarget(cell), key)
        if (!addr) {
            const proxy = heap.getPropertyProxy(heap.indirectTarget(cell), key)
            if (!proxy) {
                if (n.op === NodeOp.getProp) {
                    readUndefined(id, token)
                    return
                }
                write(cell, key, slotOf(n, 3))
                forward.set(id, token)
                return
            }
            if (n.op === NodeOp.getProp) return inline(id, heap.getProxyGetter(proxy), tagVmHandle(cell), [keyArg(key)], token)
            return inline(id, heap.getProxySetter(proxy), tagVmHandle(cell), [keyArg(key), tagVmHandle(slotOf(n, 3))], token)
        }
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        const accessor = desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)
        if (n.op === NodeOp.getProp) {
            if (desc.flags & heap.PropFlags.has_getter) {
                if (opts.accessors === 'call') return callAccessor(id, desc.slot0 as Handle, cell, token)
                return inline(id, desc.slot0 as Handle, tagVmHandle(cell), [], token)
            }
            if (accessor) throw `property-eval: %${id} reads a property with only a setter`
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        if (desc.flags & heap.PropFlags.has_setter) return inline(id, desc.slot1 as Handle, tagVmHandle(cell), [tagVmHandle(slotOf(n, 3))], token)
        if (accessor) throw `property-eval: %${id} writes a property with only a getter`
        write(cell, key, slotOf(n, 3))
        forward.set(id, token)
    }

    function arrivals(param: number): number[] {
        const at = paramSlots.get(param)
        if (!at) return []
        return (inbound.get(at.block) ?? []).map(apply => getRef(getNode(source, apply)!, at.index + 1))
    }
    const pendingShape = 0xFFFFFFFF as Handle
    function agree(shapes: (Handle | null | undefined)[]): Handle | null | undefined {
        let found: Handle | undefined
        let waiting = false
        let nullish = false
        for (const shape of shapes) {
            if (shape === null) {
                nullish = true
                continue
            }
            if (shape === pendingShape) {
                waiting = true
                continue
            }
            if (shape === undefined) return
            if (found !== undefined && (found === numberShape || shape === numberShape ? found !== shape : !native.sameLayout(found, shape))) return
            if (found !== undefined && found !== shape) opts.unify?.(found, shape)
            found = shape
        }
        if (found === numberShape && nullish) return
        return found ?? (waiting ? pendingShape : null)
    }
    interface Union {
        tag: number
        members: Handle[]
    }
    const unions = new Map<number, Union>()
    const unionTargets = new Map<number, { tag: number, arms: number[] }>()
    let armOverride: { id: number, shape: Handle } | undefined
    function memberIndex(members: Handle[], shape: Handle): number {
        return members.findIndex(m => native.sameSnapshotShape(m, shape))
    }
    function unionOf(param: number, shapes: (Handle | null | undefined)[]): void {
        if (unions.has(param)) return
        if (shapes.some(s => s === undefined || s === pendingShape || s === numberShape)) return
        const members: Handle[] = []
        for (const s of shapes) if (s !== null && memberIndex(members, s!) < 0) members.push(s!)
        if (members.length < 2) return
        const at = paramSlots.get(param)
        if (!at) return
        const tag = addNode(out, NodeOp.param, [])
        const block = out.blocks.find(b => b.id === at.block)!
        const position = block.params.length
        block.params.push(tag)
        unions.set(param, { tag, members })
        const incoming = inbound.get(at.block) ?? []
        for (let k = 0; k < incoming.length; k++) {
            const apply = incoming[k]
            const current = getNode(out, apply)!
            let value = getRef(getNode(source, apply)!, at.index + 1)
            while (getNode(source, value)?.op === NodeOp.after) value = getRef(getNode(source, value)!, countIds(getNode(source, value)!) - 1)
            const operands = getOperands(runtime, current)
            const carried = unions.get(value)
            const index = carried ? -1 : shapes[k] ? memberIndex(members, shapes[k]!) : -1
            if (!carried && index < 0) throw `property-eval: %${apply} brings an unknown shape into the union at %${param}`
            operands.splice(position + 1, 0, carried ? carried.tag : { literal: index })
            putCopy(out, apply, current, operands)
        }
    }
    function tagSelect(tag: number, arms: number[]): number {
        let chosen = arms[arms.length - 1]
        for (let i = arms.length - 2; i >= 0; i--) {
            const test = addNode(out, NodeOp.eq, [tag, { literal: i }], Types.bool)
            const select = newId()
            putNode(out, select, NodeOp.select, [test, arms[i], chosen])
            chosen = select
        }
        return chosen
    }
    function resolveUnion(id: number, n: GraphNode, union: Union): void {
        const arms: number[] = []
        const shapes: (Handle | undefined)[] = []
        let constants = true
        for (const shape of union.members) {
            const fields = layout(shape)
            const member: Memory = { ...fields, ptr: getRef(n, 1), base: 0, shape, reduced: false, pointer: true, address: [getRef(n, 1), 0] }
            const arm = newId()
            resolveMemory(arm, n, member)
            arms.push(arm)
            shapes.push(memory.get(arm)?.shape)
            const resolved = getNode(out, arm)!
            const value = resolved.op === NodeOp.after ? getRef(resolved, countIds(resolved) - 1) : 0
            const valueNode = value ? getNode(out, value) : undefined
            if (!valueNode || valueNode.op !== NodeOp.heapHandle || getRef(valueNode, 0)) constants = false
        }
        const chosen = tagSelect(union.tag, arms)
        putNode(out, id, NodeOp.after, [getRef(n, 0), chosen])
        if (constants) unionTargets.set(id, { tag: union.tag, arms: arms.map(a => getRef(getNode(out, a)!, countIds(getNode(out, a)!) - 1)) })
        if (shapes.every(s => s !== undefined)) joinResult(id, union.tag, shapes as Handle[])
    }
    function joinResult(id: number, tag: number, shapes: Handle[]): void {
        const members: Handle[] = []
        for (const s of shapes) if (memberIndex(members, s) < 0) members.push(s)
        if (members.length === 1) {
            const fields = layout(members[0])
            memory.set(id, { ...fields, ptr: id, base: 0, shape: members[0], reduced: false, pointer: true, address: [id, 0] })
            return
        }
        unions.set(id, { tag, members })
    }
    const frames: { low: number, cyclic: boolean }[] = []
    const active = new Map<string, number>()
    function query<T>(key: string, compute: () => T, bottom: T): T {
        const at = active.get(key)
        if (at !== undefined) {
            frames[at].cyclic = true
            observe(at)
            return bottom
        }
        const frame = { low: frames.length, cyclic: false }
        active.set(key, frames.length)
        frames.push(frame)
        try {
            return compute()
        } finally {
            frames.pop()
            active.delete(key)
            observe(frame.low)
        }
    }
    function observe(index: number): void {
        const top = frames[frames.length - 1]
        if (top) top.low = Math.min(top.low, index)
    }
    function settled(): boolean {
        const top = frames[frames.length - 1]
        return !top || top.low >= frames.length - 1
    }
    function pointerMemory(id: number, shape: Handle): Memory {
        const fields = layout(shape)
        return { ...fields, ptr: id, base: 0, shape, reduced: fields.keys.length === 1 && readonlyKeys(shape, fields.keys), pointer: true, address: [id, 0] }
    }
    const derived = new Map<number, Handle | null | undefined>()
    const locations = new Map<number, [shape: Handle, path: string]>()
    const adoptable = new Set([NodeOp.param, NodeOp.get, NodeOp.select, NodeOp.after])
    const bodies = new Map<number, number>()
    for (const b of graph.blocks) bodies.set(b.id, b.bodyId)
    const returnsOf = new Map<number, number[]>()
    function inlinedReturns(id: number): number[] {
        const known = returnsOf.get(id)
        if (known) return known
        const values: number[] = []
        const seen = new Set<number>()
        const work = [getRef(getNode(source, id)!, 0)]
        while (work.length) {
            const at = work.pop()!
            if (!at || seen.has(at)) continue
            seen.add(at)
            const n = getNode(source, at)
            if (!n || n.op === NodeOp.inlined) continue
            if (n.op === NodeOp.ret) values.push(getRef(n, 0))
            else if (n.op === NodeOp.after) work.push(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) work.push(getRef(n, i))
            else if (n.op === NodeOp.apply) work.push(bodies.get(getRef(n, 0))!)
        }
        returnsOf.set(id, values)
        return values
    }
    function strippedValue(id: number): number {
        while (getNode(source, id)?.op === NodeOp.after) id = getRef(getNode(source, id)!, countIds(getNode(source, id)!) - 1)
        return id
    }
    function returnedState(value: number): Handle | undefined {
        const n = getNode(source, value)
        if (n?.op !== NodeOp.heapHandle || getRef(n, 0)) return
        const cell = getLiteral(runtime, n, 0) as Handle
        let state: Handle | undefined
        if (countIds(n) > 1) state = snapshotNode(value) ? getLiteral(runtime, n, 1) as Handle : undefined
        else if (heap.isIndirect(cell) && !session.sealed.has(cell)) state = heap.indirectTarget(cell)
        return state !== undefined && snapshotKeys(state).length === dataKeys(state).length ? state : undefined
    }
    const valueUses = new Map<number, Set<number>>()
    for (const [id, n] of source.nodes) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) setOf(valueUses, getRef(n, i)).add(id)
    function terminal(id: number): boolean {
        const users = valueUses.get(id)
        if (!users?.size) return false
        for (const user of users) {
