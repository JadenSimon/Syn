            commit(id, result)
            return result
        })
    }
    function plannedAnswer(id: number): Handle | null | undefined {
        if (!opts.plannedShapes) return
        const planned = opts.plannedShapes.get(id)
        if (planned === undefined) return
        const n = getNode(source, id)
        if (!n) return
        if (n.op === NodeOp.getProp) return planned === numberShape || planned === stringShape || planned === null ? planned : undefined
        if (n.op !== NodeOp.param && n.op !== NodeOp.select && n.op !== NodeOp.inlined) return
