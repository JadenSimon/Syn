/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import type { TraceSession } from './trace2'
import type { Allocation } from './fast-trace'
import { NumericOps, OrderedValues, dumpGraph, firstNonOrderingSlot, splitGuardedSelects, type Graph, type GraphNode } from './lowering2'
import {
    cloneRefs, copyNode, countIds, countLiterals, createFnType, getLiteral, getOperands, getRef, type Operand, setGraphBlocks, withNodes,
    type TypeOperand, typeOf,
    NodeOp,
    setNode, deleteNode,
    putNode,
    getNode, hasNode,
    type NodeSpace,
    putCopy,
    addNode,
    withOperand,
    addCopy, retypeNode, insertNode, nodeUsers, getBlock, spreadsLast, allNodes, someNode, copyNodes, nodeEntries, nodeIds, makeNode, isThisParam,
    heapInterior, heapField, heapFieldCount, typeRefOf, getArgIds, setType, pushBlockParams, setBlockBody,
} from './graph-node'
import { snapshotField, snapshotKeys } from './heap-records'
import { symbolOf, symbolValue, tagVmHandle, tagVmHandleNode, tagVmScalar, vmHandleNode, vmValue } from './vm'
import * as native from './native'
import { globals as builtinGlobals } from './builtins'
import { Op as RtOp, assignExcluded, bindingOf, callOf, earlyCalls, isDelete } from './rt'

type Handle = intrinsics.Handle
const Types = intrinsics.Types

export const numberShape = 0xFFFFFFFE as Handle
export const stringShape = heap.fromJsString('')

export interface LayoutTable {
    codecs?: native.Facts
    fixedCodecs?: Set<Handle>
    refinements?: Map<Handle, Map<Handle, Handle>>
    bits?: Map<Handle, RecordBits>
    fixed?: Map<Handle, Map<Handle, Handle>>
    erased?: Map<Handle, Set<Handle>>
    views?: Map<Handle, Handle[]>
    codes?: Map<Handle, Handle>
    absent?: Map<Handle, Map<Handle, boolean>>
}

export interface Answer {
    shape?: Handle | null
    members?: Handle[]
    nullable?: boolean
    zero?: boolean
    signed?: boolean
    bool?: boolean
    primitives?: Handle[]
    objects?: Handle[]
    functions?: Handle[]
    states?: Handle[]
    callee?: Handle
    receiver?: Handle
}

export interface ObjectRequest {
    session: TraceSession
    frames: Map<u32, Handle>
    params?: Map<number, Handle>
    layouts: LayoutTable
    answers?: Map<number, Answer>
    embedded?: Map<number, { parent: number, key: Handle }>
    allocations?: Map<u32, Allocation>
    bound?: Map<u32, number>
    calls?: (site: CallSite) => CallBinding | undefined
    unionParams?: Map<number, UnionParam>
    contextShape?: Handle
    statics?: Set<number>
    allocationShapes?: Map<number, Handle>
    readonly?: Set<Handle>
    rawReturns?: boolean
    dynamic?: Map<number, Function>
    forwardedKey?: (getter: Handle) => Handle | undefined
    tupleKeys?: (tuple: Handle, record: Handle) => Handle[] | undefined
    wordsSlot?: (words: number[]) => number
}

export interface UnionParam {
    base?: number
    members: Handle[]
    primitives?: Handle[]
    field?: number
}

export interface CallSite {
    call: number
    target: GraphNode
    receiver: Handle | undefined
    args: (Handle | undefined)[]
    context?: Handle
    spread?: boolean
    origin?: number
}

export interface CallBinding {
    paramCount: number
    receiver: boolean
    receiverShape?: Handle
    result?: Handle
    members?: Handle[]
    primitives?: Handle[]
    nullish?: boolean
    returnsReceiver?: boolean
    union?: boolean
    field?: number
    float?: boolean
    returnSlot?: { at: number, size: number }
    target?: number
    returns?: intrinsics.Types
    decode?: number
    reads?: Handle[]
    location?: [Handle, string]
    boxed?: boolean
    nullable?: boolean
    bool?: boolean
    stringWord?: boolean
    stores?: [from: number, into: number][]
    argShapes?: (Handle | undefined)[]
}

export interface RecordBits {
    flags: Set<Handle>
    tagged: Set<Handle>
    shapeTag?: number
}

export interface BitSlot {
    offset: number
    bit: number
    shared: boolean
}

export interface Layout {
    keys: Handle[]
    offsets: number[]
    nested: (Handle | undefined)[]
    flags: (BitSlot | undefined)[]
    tags: (BitSlot | undefined)[]
    zeroed: BitSlot[]
    size: number
}

const wordBits = 32

export function bitWord(slot: BitSlot): intrinsics.Types {
    return slot.shared ? Types.u32 : Types.u64
}

export function recordLayout(shape: Handle, refinements?: Map<Handle, Map<Handle, Handle>>, bits?: Map<Handle, RecordBits>): Layout {
    const fields = refinements?.get(shape)
    const kinds = bits?.get(shape)
    const keys = kinds?.shapeTag !== undefined ? [heap.shapeTagKey, ...dataKeys(shape)] : dataKeys(shape)
    const offsets: number[] = []
    const nested: (Handle | undefined)[] = []
    let size = 0
    for (const key of keys) {
        const inner = fields?.get(key)
        offsets.push(size)
        nested.push(inner)
        if (inner === undefined && kinds?.flags.has(key)) continue
        size += inner !== undefined ? recordLayout(inner, refinements, bits).size : 8
    }
    const base = size
    const flags: (BitSlot | undefined)[] = []
    const tags: (BitSlot | undefined)[] = []
    let count = 0
    function place(): BitSlot {
        const at = { offset: base + 8 * Math.floor(count / wordBits), bit: count % wordBits, shared: false }
        count++
        return at
    }
    for (let i = 0; i < keys.length; i++) {
        const plain = nested[i] === undefined
        const flag = plain && kinds?.flags.has(keys[i]) ? place() : undefined
        if (flag) offsets[i] = flag.offset
        flags.push(flag)
        tags.push(plain && kinds?.tagged.has(keys[i]) ? place() : undefined)
    }
    const zeroed: BitSlot[] = []
    function share(slot: BitSlot | undefined, tag: boolean): void {
        if (!slot) return
        const word = (slot.offset - base) / 8
        slot.shared = Math.min(wordBits, count - word * wordBits) > 1
        if ((slot.shared || tag) && !zeroed.some(z => z.offset === slot.offset)) zeroed.push(slot)
    }
    for (let i = 0; i < keys.length; i++) {
        share(flags[i], false)
        share(tags[i], true)
    }
    return { keys, offsets, nested, flags, tags, zeroed, size: base + 8 * Math.ceil(count / wordBits) }
}

interface Memory extends Layout {
    ptr: number
    base: number
    shape: Handle
    reduced: boolean
    pointer: boolean
    address?: [ref: number, literal: number]
    decoded?: boolean
    union?: boolean
    owner?: Handle
    origin?: number
    members?: Handle[]
    primitives?: Handle[]
    kind?: number
}

export interface Resolved {
    graph: Graph
    shapes: Map<number, Handle>
    encoded: Set<number>
    tags: Map<number, number>
    present: Set<number>
    dispatches: Map<number, number>
}

const narrowLoads = new Set<TypeOperand>([intrinsics.Types.u8, intrinsics.Types.u16, intrinsics.Types.i8, intrinsics.Types.i16, intrinsics.Types.bool])

function resolveProperties(
    graph: Graph,
    session: TraceSession,
    objects: Map<number, Handle>,
    pointers: Map<number, Handle>,
    unionPointers: Map<number, UnionParam>,
    opts: ObjectRequest,
): Resolved {
    const runtime = session.runtime
    if (!runtime) throw 'property-eval: the session must stay entered from tracing through resolution'
    const records = runtime.objects
    intrinsics.assert(graph.ids === runtime.ids, 'property-eval: the graph must come from the current trace runtime')
    const source: NodeSpace = { nodes: copyNodes(graph), ids: graph.ids, literals: graph.literals }
    function locate(shape: Handle, path: string): native.Codec | undefined {
        return opts.layouts.codecs && native.locate(opts.layouts.codecs, shape, path)
    }
    function storeFact(shape: Handle, path: string, value: Handle, from: number): void {
        if (!opts.layouts.codecs || opts.layouts.fixedCodecs?.has(shape)) return
        const union = from ? unionMemory(from) : undefined
        const encoded = union !== undefined || wordCodec(locate(shape, path))
        const fact: native.Codec = value === numberShape ? { kind: 'int', encoded } : { kind: 'ref', shape: value, encoded, union: union !== undefined, members: union?.members, primitives: union?.primitives }
        native.setFact(opts.layouts.codecs, graph.name ?? 'property-eval', shape, path, fact)
    }
    function wordCodec(codec: native.Codec | undefined): boolean {
        return (codec?.kind === 'word' || codec?.kind === 'ref') && codec.encoded
    }
    for (const [id, n] of nodeEntries(source)) {
        if (n.op !== NodeOp.rt || getLiteral(runtime, n, 1) !== RtOp.assign) continue
        const from = pointers.get(getRef(n, 3)) ?? opts.answers?.get(getRef(n, 3))?.shape
        if (!from || from === numberShape || from === stringShape) continue
        let token = getRef(n, 0)
        const excluded = assignExcluded(runtime, n)
        for (const key of dataKeys(from)) {
            if (excluded.includes(key)) continue
            if (key === heap.shapeTagKey) continue
            const read = addNode(source, NodeOp.getProp, [token, getRef(n, 3), { literal: key }])
            token = addNode(source, NodeOp.setProp, [read, getRef(n, 2), { literal: key }, read])
        }
        putNode(source, id, NodeOp.after, [token, getRef(n, 2)])
    }
    const deletions = new Set<number>()
    for (const [id, n] of nodeEntries(source)) {
        if (!isDelete(runtime, n)) continue
        const operands = getOperands(runtime, n)
        putNode(source, id, NodeOp.setProp, [operands[0], operands[2], operands[3], addNode(source, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])])
        deletions.add(id)
    }
    const out = withNodes(graph, new Map())
    for (const [id, n] of nodeEntries(source)) putCopy(out, id, n)
    if (intrinsics.argv().includes(`pe-source:${graph.name}`)) console.log(dumpGraph(graph))
    const runtimeCalls = new Set<number>()
    for (const [id, n] of nodeEntries(source)) {
        if (n.op !== NodeOp.rt || !earlyCalls.has(getLiteral(runtime, n, 1))) continue
        const callee = addNode(source, NodeOp.heapHandle, [{ literal: session.linkFunction(bindingOf(getLiteral(runtime, n, 1))!.impl!) }])
        putCopy(out, callee, getNode(source, callee)!)
        setNode(source, id, callOf(runtime, n, callee))
        putCopy(out, id, getNode(source, id)!)
        runtimeCalls.add(id)
    }

    const cells = new Map<number, Handle>()
    const memory = new Map<number, Memory>()
    const addressed = new Map<number, Memory>()
    const forward = new Map<number, number>()
    let unordered = 0
    function readonlyToken(): number {
        if (!unordered) {
            unordered = addNode(out, NodeOp.startOf, [])
        }
        return unordered
    }
    function readonly(shape: Handle): boolean {
        return !!opts.readonly?.has(shape)
    }
    function layout(shape: Handle): Layout {
        return recordLayout(shape, opts.layouts.refinements, opts.layouts.bits)
    }
    const numbers = new Set<number>()
    const strings = new Set<number>()
    for (const [id, shape] of pointers) {
        if (shape === numberShape) {
            numbers.add(id)
            continue
        }
        if (shape === stringShape) {
            strings.add(id)
            continue
        }
        if (unionPointers.has(id)) continue
        memory.set(id, pointerMemory(id, shape))
    }
    const byHandle = new Map<Handle, Memory>()
    let initToken = 0
    let allocToken: number | undefined
    function heapAllocate(size: number, zeroed: BitSlot[]): number {
        let token = allocToken
        if (token === undefined) {
            if (!initToken) {
                initToken = addNode(out, NodeOp.startOf, [])
            }
            token = initToken
        }
        const ptr = addNode(out, NodeOp.pstack, [token, 0, 0, { literal: size }])
        let last = ptr
        for (const slot of zeroed) last = addNode(out, NodeOp.store, [last, ptr, { literal: slot.offset }, { literal: 0 }], bitWord(slot))
        if (allocToken !== undefined) allocToken = last
        else initToken = last
        return ptr
    }
    function handleOf(token: number, operand: Operand): number {
        const value = typeof operand === 'number' ? operand : addNode(source, NodeOp.heapHandle, [operand])
        if (value !== operand) putCopy(out, value, getNode(source, value)!)
        const handle = addNode(source, NodeOp.rt, [token, { literal: RtOp.handleof }, value])
        putCopy(out, handle, getNode(source, handle)!)
        return handle
    }
    for (const [id, fn] of opts.dynamic ?? []) {
        const n = getNode(source, id)!
        const callee = addNode(source, NodeOp.heapHandle, [{ literal: session.linkFunction(fn) }])
        putCopy(out, callee, getNode(source, callee)!)
        if (n.op === NodeOp.heapHandle) {
            const at = opts.allocations?.get(getLiteral(runtime, n, 0) as u32)?.token
            intrinsics.assert(at === undefined || hasNode(source, at), `property-eval: allocation token %${at} of %${id} is not in the graph`)
            if (at !== undefined) putNode(source, id, NodeOp.call, [at, callee, { literal: 0 }])
            else {
                if (!initToken) initToken = addNode(out, NodeOp.startOf, [])
                putNode(source, id, NodeOp.call, [initToken, callee, { literal: 0 }])
                initToken = id
            }
        } else {
            const token = getRef(n, 0)
            const operands: Operand[] = [token, callee, { literal: 0 }, handleOf(token, getRef(n, 1)), handleOf(token, getOperands(runtime, n)[2])]
            if (n.op === NodeOp.setProp && !deletions.has(id)) operands.push(fn === heap.setHandleProperty ? handleOf(token, getOperands(runtime, n)[3]) : getOperands(runtime, n)[3])
            putNode(source, id, NodeOp.call, operands)
        }
        putCopy(out, id, getNode(source, id)!)
        runtimeCalls.add(id)
    }
    let entryOrdering: Map<number, number[]> | undefined
    const entryNodes = new Map<number, number>()
    const forwardOrdering = new Map<number, number[]>()
    function forwardPreds(block: number): number[] {
        const known = forwardOrdering.get(block)
        if (known) return known
        const preds = entryPreds(block)
        const entry = entryNodes.get(block) ?? -block
        const forward = preds.filter(token => token !== entry && !before(token, 'all').has(entry))
        forwardOrdering.set(block, forward)
        return forward
    }
    function entryPreds(block: number): number[] {
        if (!entryOrdering) {
            entryOrdering = new Map()
            const wrapped = new Map<number, number[]>()
            for (const n of allNodes(source)) {
                if (n.op !== NodeOp.after) continue
                const last = getRef(n, countIds(n) - 1)
                if (getNode(source, last)?.op !== NodeOp.apply) continue
                const list = wrapped.get(last) ?? []
                for (let i = 0; i < countIds(n) - 1; i++) if (getRef(n, i)) list.push(getRef(n, i))
                wrapped.set(last, list)
            }
            for (const [id, n] of nodeEntries(source)) if (n.op === NodeOp.startOf && countLiterals(n)) entryNodes.set(getRef(n, 0), id)
            for (const b of graph.blocks) {
                const stack = [b.bodyId]
                while (stack.length) {
                    const id = stack.pop()!
                    const n = getNode(source, id)
                    if (!n) continue
                    if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) stack.push(getRef(n, i))
                    else if (n.op === NodeOp.after) stack.push(getRef(n, countIds(n) - 1))
                    else if (n.op === NodeOp.apply) {
                        const list = entryOrdering.get(getRef(n, 0)) ?? []
                        const ordering = wrapped.get(id)
                        if (ordering) list.push(...ordering)
                        else list.push(entryNodes.get(b.id) ?? -b.id)
                        entryOrdering.set(getRef(n, 0), list)
                    }
                }
            }
        }
        return entryOrdering.get(block) ?? []
    }
    type Crossing = 'forward' | 'all' | 'none'
    function crossPreds(block: number, crossing: Crossing): number[] {
        if (crossing === 'none') return []
        return crossing === 'all' ? entryPreds(block) : forwardPreds(block)
    }
    function pushOrdering(stack: number[], seen: Set<number>, id: number, crossing: Crossing): void {
        if (id < 0) {
            for (const p of crossPreds(-id, crossing)) if (!seen.has(p)) stack.push(p)
            return
        }
        const n = getNode(source, id)
        if (!n) return
        if (n.op === NodeOp.startOf) {
            if (countLiterals(n)) for (const p of crossPreds(getRef(n, 0), crossing)) if (!seen.has(p)) stack.push(p)
            return
        }
        if (n.op === NodeOp.after || n.op === NodeOp.select || n.op === NodeOp.inlined) {
            if (crossing === 'none' && n.op !== NodeOp.after) return
            for (let i = 0; i < countIds(n); i++) {
                const ref = getRef(n, i)
                if (ref && !seen.has(ref)) stack.push(ref)
            }
            return
        }
        if (OrderedValues.has(n.op) && getRef(n, 0) && !seen.has(getRef(n, 0))) stack.push(getRef(n, 0))
    }
    const orderedBefore = new Map<string, Set<number>>()
    function before(id: number, crossing: Crossing = 'forward'): Set<number> {
        const key = `${crossing}${id}`
        const known = orderedBefore.get(key)
        if (known) return known
        const seen = new Set<number>()
        orderedBefore.set(key, seen)
        const stack: number[] = []
        pushOrdering(stack, seen, id, crossing)
        while (stack.length) {
            const at = stack.pop()!
            if (seen.has(at)) continue
            seen.add(at)
            pushOrdering(stack, seen, at, crossing)
        }
        return seen
    }
    function plainFunction(shape: Handle): boolean {
        return heap.isCallable(shape) && !heap.getPropertyDescriptor(shape, heap.closureCallKey)
    }
    function firstUse(value: number): number | undefined {
        const calls = callUsers(value, 2)
        return calls.find(u => calls.every(v => v === u || before(v).has(u)))
    }
    function snapshotNode(id: number): GraphNode | undefined {
        const n = getNode(source, id)
        if (!n || n.op !== NodeOp.heapHandle || !heapInterior(source, n)) return
        return n
    }
    const homes = new Map<Handle, Memory>()
    for (const [cell, param] of opts.bound ?? []) {
        const home = memory.get(param)
        if (!home) throw `property-eval: %${param} holds cell ${cell} but has no known shape`
        homes.set(cell as Handle, home)
    }
    function materialize(id: number, given: Handle): Memory {
        const known = memory.get(id)
        if (known) return known
        const handle = opts.allocationShapes?.get(id) ?? given
        const identity = getNode(source, id)
        const cell = identity?.op === NodeOp.heapHandle && !getRef(identity, 0) ? getLiteral(runtime, identity, 0) as Handle : undefined
        const fields = layout(handle)
        const keys = fields.keys
        let mem = cell !== undefined ? homes.get(cell) : undefined
        if (mem && (mem.keys.length !== keys.length || mem.keys.some((k, i) => k !== keys[i]))) {
            throw `property-eval: %${id} changes the shape of an object that lives in memory`
        }
        if (!mem) {
            const reduced = reducedShape(handle)
            let ptr = 0
            if (!reduced) ptr = heapAllocate(Math.max(fields.size, 8), fields.zeroed)
            mem = { ...fields, ptr, base: 0, shape: handle, reduced, pointer: false, origin: identity?.op === NodeOp.heapHandle && heapFieldCount(identity) ? id : undefined }
            if (cell !== undefined) homes.set(cell, mem)
        }
        memory.set(id, mem)
        byHandle.set(handle, mem)
        return mem
    }
    const placed = new Map<number, number[]>()
    for (const [id, handle] of objects) {
        if (opts.embedded?.has(id)) continue
        const node = getNode(source, id)
        const at = node?.op === NodeOp.heapHandle && !getRef(node, 0) ? opts.allocations?.get(getLiteral(runtime, node, 0) as u32)?.token : undefined
        intrinsics.assert(at === undefined || hasNode(source, at), `property-eval: allocation token %${at} of %${id} is not in the graph`)
        if (at === undefined) {
            materialize(id, handle)
            continue
        }
        const group = placed.get(at)
        if (group) group.push(id, handle)
        else placed.set(at, [id, handle])
    }
    const embeddedMemory = new Set<Memory>()
    for (const [id, { parent, key }] of opts.embedded ?? []) {
        const owner = memory.get(parent)
        if (!owner) throw `property-eval: %${id} is embedded in %${parent}, which has no memory`
        const at = owner.keys.indexOf(key)
        const inner = at < 0 ? undefined : owner.nested[at]
        if (inner === undefined) throw `property-eval: %${id} is embedded in a field of %${parent} that holds no object`
        const op = getNode(source, id)?.op
        const pointer = op === NodeOp.call
        const mem = { ...layout(inner), ptr: owner.ptr, base: owner.base + owner.offsets[at], shape: inner, reduced: false, pointer, address: pointer ? [id, 0] as [number, number] : undefined }
        memory.set(id, mem)
        embeddedMemory.add(mem)
    }
    const fieldTags = new Map<number, number>()
    const presentReads = new Set<number>()
    function readBit(token: number, base: number, displacement: number, slot: BitSlot): number {
        const word = addNode(out, NodeOp.load, [token, base, { literal: displacement }], bitWord(slot))
        if (!slot.shared) return word
        const shifted = slot.bit ? addNode(out, NodeOp.ushr, [word, { literal: slot.bit }], Types.u32) : word
        return addNode(out, NodeOp.and, [shifted, { literal: 1 }], Types.u32)
    }
    function writeBit(id: number, token: number, base: number, displacement: number, slot: BitSlot, value: Operand): void {
        if (!slot.shared) {
            putNode(out, id, NodeOp.store, [token, base, { literal: displacement }, value], Types.u64)
            return
        }
        const word = addNode(out, NodeOp.load, [token, base, { literal: displacement }], Types.u32)
        const mask = 2 ** slot.bit
        const kept = addNode(out, NodeOp.and, [word, { literal: 0xFFFFFFFF - mask }], Types.u32)
        let next: Operand = kept
        if (typeof value !== 'number' && value.literal) next = addNode(out, NodeOp.or, [word, { literal: mask }], Types.u32)
        else if (typeof value === 'number') next = addNode(out, NodeOp.or, [kept, slot.bit ? addNode(out, NodeOp.shl, [value, { literal: slot.bit }], Types.u32) : value], Types.u32)
        putNode(out, id, NodeOp.store, [word, base, { literal: displacement }, next], Types.u32)
    }
    function boolValue(ref: number): boolean {
        return !!opts.answers?.get(ref)?.bool || native.boolTyped(out, ref)
    }
    function tagValue(ref: number, literal: number): Operand {
        if (!ref) return { literal }
        const known = fieldTags.get(ref)
        if (known !== undefined) return known
        const n = getNode(source, ref)
        if (n?.op === NodeOp.heapHandle && countIds(n) === 1 && !getRef(n, 0) && heap.isNullishHandle(getLiteral(runtime, n, 0) as Handle)) return { literal: 0 }
        return addNode(out, NodeOp.ne, [ref, undefinedValue()], Types.bool)
    }
    function storeField(id: number, token: number, base: number, displacement: number, owner: Handle, offset: number, value: Operand): void {
        const located = locate(owner, String(offset))
        const word = wordCodec(located)
        const rawFloat = located?.kind === 'f64' && !located.encoded
        const stored = !word ? value : typeof value !== 'number' ? { literal: value.literal * 2 } : shape(value) === stringShape ? tagVmHandleNode(out, value) : shape(value) !== numberShape ? value : boolValue(value) ? native.boolWordNode(out, value) : addNode(out, NodeOp.box, [value], Types.vm_value)
        putNode(out, id, NodeOp.store, [token, base, { literal: displacement }, stored], word ? Types.vm_value : rawFloat ? Types.f64 : Types.u64)
    }
    const initialized = new Set<Memory>()
    const pendingInits = new Map<Memory, [holder: Memory, i: number, slot: Handle][]>()
    const initStores: [shape: Handle, path: string, value: number][] = []
    function storeKey(mem: Memory, i: number, token: number, value: Operand, tag: Operand): number {
        const store = newId()
        const flag = mem.flags[i]
        if (flag) {
            writeBit(store, token, mem.ptr, mem.base + flag.offset, flag, value)
            return store
        }
        storeField(store, token, mem.ptr, mem.base + mem.offsets[i], mem.shape, mem.offsets[i], value)
        const slot = mem.tags[i]
        if (!slot) return store
        const marked = newId()
        writeBit(marked, store, mem.ptr, mem.base + slot.offset, slot, tag)
        return marked
    }
    function storeAbsent(mem: Memory, i: number, token: number): number {
        if (!wordCodec(locate(mem.shape, String(mem.offsets[i])))) return storeKey(mem, i, token, { literal: 0 }, { literal: 0 })
        const store = newId()
        putNode(out, store, NodeOp.store, [token, mem.ptr, { literal: mem.base + mem.offsets[i] }, { literal: heap.undefinedWord }], Types.vm_value)
        return store
    }
    function initChain(id: number, mem: Memory, token: number): number {
        initialized.add(mem)
        if (mem.reduced) return token
        const state = snapshotNode(id) ? getLiteral(runtime, snapshotNode(id)!, 1) as Handle : mem.shape
        const template = !!opts.layouts.fixedCodecs?.has(state)
        for (let i = 0; i < mem.keys.length; i++) {
            if (mem.nested[i] !== undefined) continue
            if (mem.keys[i] === heap.shapeTagKey) {
                token = storeKey(mem, i, token, { literal: opts.layouts.bits?.get(mem.shape)?.shapeTag ?? heap.unboxF64(slotAt(mem.shape, heap.shapeTagKey)) }, { literal: 1 })
                continue
            }
            if (template || !heap.getOwnProperty(state, mem.keys[i])) {
                if (opts.layouts.fixedCodecs?.has(mem.shape)) token = storeAbsent(mem, i, token)
                continue
            }
            const slot = slotAt(state, mem.keys[i])
            const held = homes.get(slot) ?? byHandle.get(slot)
            if (held && unwritten(held)) {
                const list = pendingInits.get(held)
                if (list) list.push([mem, i, slot])
                else pendingInits.set(held, [[mem, i, slot]])
                continue
            }
            const [ref, literal] = fieldOperand(id, state, mem.keys[i])
            if (holdsAlready(mem, i, ref)) continue
            token = initSlot(mem, i, token, slot, ref, literal)
        }
        return token
    }
    function unwritten(mem: Memory): boolean {
        return mem.reduced && !mem.pointer && !mem.address && mem.keys.length === 1 && !slotAt(mem.shape, mem.keys[0])
    }
    function initSlot(mem: Memory, i: number, token: number, slot: Handle, ref: number, literal: number): number {
        token = storeKey(mem, i, token, ref || { literal }, mem.tags[i] ? tagValue(ref, slot ? 1 : 0) : { literal: 1 })
        if (mem.flags[i]) return token
        const storedShape = homes.get(slot)?.shape ?? (ref ? memory.get(ref)?.shape : heap.isBoxedF64(slot) ? numberShape : undefined)
        if (storedShape !== undefined) storeFact(mem.shape, String(mem.offsets[i]), storedShape, ref)
        else if (ref) initStores.push([mem.shape, String(mem.offsets[i]), ref])
        return token
    }
    function holdsAlready(mem: Memory, i: number, ref: number): boolean {
        const read = ref ? getNode(source, ref) : undefined
        if (read?.op !== NodeOp.getProp || getRef(read, 2)) return false
        return memory.get(getRef(read, 1)) === mem && getLiteral(runtime, read, 2) === mem.keys[i]
    }
    const placedFinals = new Map<number, [final: number, before: number]>()
    for (const [at, group] of placed) {
        allocToken = at
        const before = out.ids.next
        let final = at
        try {
            for (let i = 0; i < group.length; i += 2) materialize(group[i], group[i + 1] as Handle)
            for (let i = 0; i < group.length; i += 2) {
                const mem = memory.get(group[i])!
                if (!mem.pointer && !mem.reduced && !initialized.has(mem)) allocToken = initChain(group[i], mem, allocToken!)
            }
        } finally {
            final = allocToken!
            allocToken = undefined
        }
        if (final === at) continue
        for (let id = before; id < out.ids.next; id++) {
            const n = getNode(out, id)
            if (n && !hasNode(source, id)) setNode(source, id, copyNode(runtime, n))
        }
        placedFinals.set(at, [final, before])
    }
    if (placedFinals.size) {
        for (const space of [source, out]) {
            for (const [id, n] of nodeEntries(space)) {
                const end = firstNonOrderingSlot(n)
                let ops: Operand[] | undefined
                for (let i = 0; i < end; i++) {
                    const placedAt = placedFinals.get(getRef(n, i))
                    if (!placedAt || id >= placedAt[1]) continue
                    ops ??= getOperands(space, n)
                    ops[i] = placedAt[0]
                }
                if (ops) putCopy(space, id, n, ops)
            }
        }
    }
    let users = nodeUsers(source, nodeIds(source))
    function callUsers(value: number, from: number): number[] {
        const found: number[] = []
        for (const [user, slot] of users.get(value) ?? []) {
            if (slot >= from && getNode(source, user)!.op === NodeOp.call && !found.includes(user)) found.push(user)
        }
        return found
    }
    function appliesOf(block: number): number[] {
        const found: number[] = []
        for (const [user, slot] of users.get(block) ?? []) if (!slot && getNode(source, user)!.op === NodeOp.apply) found.push(user)
        return found
    }
    function written(id: number): boolean {
        for (const [user, slot] of users.get(id) ?? []) if (slot === 1 && getNode(source, user)!.op === NodeOp.setProp) return true
        return false
    }
    function storedUsers(id: number): number[] {
        const found: number[] = []
        for (const [user, slot] of users.get(id) ?? []) if (slot === 3 && getNode(source, user)!.op === NodeOp.setProp && !found.includes(user)) found.push(user)
        return found
    }
    function stateOf(id: number): Handle | undefined {
        const n = getNode(source, id)
        if (n?.op !== NodeOp.heapHandle || getRef(n, 0)) return
        return getLiteral(runtime, n, 0) as Handle
    }
    function sharedHome(id: number, mem: Memory): boolean {
        const state = stateOf(id)
        for (const [other, m] of memory) if (other !== id && m === mem && (state === undefined || stateOf(other) !== state)) return true
        return false
    }
    const ownRets = new Map<number, number>()
    if (opts.allocationShapes) {
        const reached = new Set<number>([graph.root])
        const blocks = [graph.root]
        while (blocks.length) {
            const block = blocks.pop()!
            const stack = [graph.blocks.find(b => b.id === block)!.bodyId]
            while (stack.length) {
                const at = stack.pop()!
                const m = getNode(out, at)
                if (m?.op === NodeOp.select) for (let i = 1; i < countIds(m); i++) stack.push(getRef(m, i))
                else if (m?.op === NodeOp.after) stack.push(getRef(m, countIds(m) - 1))
                else if (m?.op === NodeOp.ret) ownRets.set(at, block)
                else if (m?.op === NodeOp.apply && !reached.has(getRef(m, 0))) {
                    reached.add(getRef(m, 0))
                    blocks.push(getRef(m, 0))
                }
            }
        }
    }
    if (opts.allocationShapes) for (const [id, n] of nodeEntries(out)) {
        if (n.op !== NodeOp.ret || !getRef(n, 0) || !ownRets.has(id)) continue
        let wrapper: number | undefined
        let value = getRef(n, 0)
        const chain = new Set<number>([id])
        for (let m = getNode(out, value); m?.op === NodeOp.after; m = getNode(out, value)) {
            wrapper = value
            chain.add(value)
            value = getRef(m, countIds(m) - 1)
        }
        const shape = opts.allocationShapes.get(value)
        if (shape === undefined || memory.has(value) || !snapshotNode(value)) continue
        const cell = getLiteral(runtime, getNode(source, value)!, 0)
        let shared = false
        for (const [other, m] of nodeEntries(source)) {
            if (other !== value && m.op === NodeOp.heapHandle && !getRef(m, 0) && getLiteral(runtime, m, 0) === cell) shared = true
            if (shared) break
            if (chain.has(other)) continue
            for (let i = 0; i < countIds(m) && !shared; i++) if (getRef(m, i) === value) shared = true
            if (shared) break
        }
        if (shared) continue
        if (wrapper === undefined) {
            allocToken = addNode(out, NodeOp.startOf, [ownRets.get(id)!])
            try {
                const mem = materialize(value, shape)
                const token = initChain(value, mem, allocToken)
                putCopy(out, id, n, withOperand(runtime, n, 0, addNode(out, NodeOp.after, [token, value])))
            } finally {
                allocToken = undefined
            }
            continue
        }
        const w = getNode(out, wrapper)!
        allocToken = getRef(w, 0)
        try {
            const mem = materialize(value, shape)
            const token = initChain(value, mem, allocToken)
            putCopy(out, wrapper, w, withOperand(runtime, w, 0, token))
        } finally {
            allocToken = undefined
        }
    }
    const initTokens = new Map<number, number>()
    for (const [id, mem] of memory) {
        if (mem.pointer || written(id) || (opts.allocationShapes && initialized.has(mem))) continue
        const calls = callUsers(id, 1)
        const consumers = calls.length ? [...calls, ...storedUsers(id)] : calls
        const first = sharedHome(id, mem) ? undefined : consumers.find(u => consumers.every(v => v === u || before(v, 'none').has(u)))
        for (const consumer of first !== undefined ? [first] : consumers) {
            const node = getNode(out, consumer)!
            if (node.op === NodeOp.setProp) {
                initTokens.set(consumer, initChain(id, mem, initTokens.get(consumer) ?? getRef(node, 0)))
                continue
            }
            const token = initChain(id, mem, getRef(node, 0))
            putCopy(out, consumer, node, withOperand(runtime, node, 0, token))
        }
    }
    for (const [id, mem] of memory) {
        if (mem.pointer || mem.reduced || initialized.has(mem)) continue
        if (!initToken) {
            initToken = addNode(out, NodeOp.startOf, [{ literal: 0 }])
        }
        initToken = initChain(id, mem, initToken)
    }
    if (initToken) {
        for (const [id, n] of nodeEntries(source)) if (n.op === NodeOp.startOf && (getRef(n, 0) || graph.root) === graph.root) forward.set(id, initToken)
    }

    const paramSlots = new Map<number, { block: number, index: number }>()
    for (const b of graph.blocks) b.params.forEach((p, index) => paramSlots.set(p, { block: b.id, index }))

    const evaluated = new Set<number>()

    function newId(): number {
        return runtime.ids.next++
    }

    function objectOf(id: number): Handle {
        const known = cells.get(id)
        if (known !== undefined) return known
        const n = getNode(source, id)
        if (n?.op === NodeOp.heapHandle && !getRef(n, 0)) return records.intern(getLiteral(runtime, n, 0) as Handle)
        throw `property-eval: no object for %${id} (${n?.op ?? 'missing'})`
    }

    function addressOf(mem: Memory): [ref: number, literal: number] {
        const address = computeAddress(mem)
        if (address[0] && !mem.reduced) addressed.set(address[0], mem)
        return address
    }
    function computeAddress(mem: Memory): [ref: number, literal: number] {
        if (mem.address) return mem.address
        if (!mem.reduced && !mem.base) return mem.address = [mem.ptr, 0]
        if (!mem.reduced) {
            const at = addNode(out, NodeOp.add, [mem.ptr, { literal: mem.base }])
            return mem.address = [at, 0]
        }
        mem.address = [0, 0]
        if (mem.keys.length) mem.address = fieldOperand(mem.origin ?? 0, mem.shape, mem.keys[0])
        return mem.address
    }

    function fieldOperand(id: number, state: Handle, key: Handle): [ref: number, literal: number] {
        const slot = slotAt(state, key)
        const n = id && heap.isBoxedF64(slot) ? getNode(source, id) : undefined
        const field = n?.op === NodeOp.heapHandle ? heapField(source, n, key) : undefined
        if (field === undefined) return operandOf(slot)
        return typeof field === 'number' ? [field, 0] : [0, field.literal]
    }

    function operandOf(slot: Handle): [ref: number, literal: number] {
        if (!slot) return [0, 0]
        const mem = homes.get(slot) ?? byHandle.get(slot)
        if (mem) return addressOf(mem)
        if (heap.isBoxedF64(slot)) {
            const value = heap.unboxF64(slot)
            const id = intrinsics.getNanId(value)
            return id ? [id, 0] : [0, value]
        }
        const id = addNode(out, NodeOp.heapHandle, [{ literal: slot }])
        cells.set(id, records.intern(slot))
        return [id, 0]
    }

    function slotOf(n: GraphNode, i: number): Handle {
        const ref = getRef(n, i)
        if (!ref) return heap.boxF64(getLiteral(runtime, n, i)) as Handle
        const cell = cells.get(ref)
        if (cell !== undefined) return cell
        const target = getNode(source, ref)
        if (target?.op === NodeOp.heapHandle && !getRef(target, 0)) return getLiteral(runtime, target, 0) as Handle
        return heap.boxSymbol(ref)
    }

    function keyArg(key: Handle): u32 {
        const index = heap.keyIndex(key)
        return index === undefined ? tagVmHandle(key) : tagVmScalar(index)
    }

    function inline(id: number, fn: Handle, thisValue: u32, args: u32[], token: number): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const imported = new Map<number, number>()
        function enter(word: u32): u32 {
            const ref = symbolOf(word)
            if (!ref) return word
            const at = runtime.ids.next++
            const n = getNode(out, ref)
            if (n && !typeRefOf(n) && getArgIds(n).every(r => !r)) setNode(runtime, at, copyNode(runtime, n))
            imported.set(at, ref)
            return symbolValue(at)
        }
        const nested = traceModule.trace2(linked, {
            session,
            inputs: { thisArg: enter(thisValue), args: args.map(enter), effect: enter(symbolValue(token)) },
        })
        const traced = nested.graph
        const fresh = new Map<number, number>()
        for (const nid of nodeIds(traced)) if (!imported.has(nid)) fresh.set(nid, newId())
        for (const b of traced.blocks) if (b.id !== traced.root && !fresh.has(b.id)) fresh.set(b.id, newId())
        function moved(ref: number): number {
            if (!ref) return ref
            const to = imported.get(ref) ?? fresh.get(ref)
            intrinsics.assert(to !== undefined, `property-eval: the inlined accessor of %${id} names %${ref} outside its graph`)
            return to!
        }
        for (const [nid, n] of nodeEntries(traced)) {
            if (imported.has(nid)) continue
            const operands = getOperands(traced, n).map(x => typeof x === 'number' ? moved(x) : x)
            if (n.op === NodeOp.inlined && getLiteral(traced, n, 1) === nid) operands[1] = { literal: fresh.get(nid)! }
            const copy = copyNode(traced, n, operands)
            if (typeRefOf(n)) setType(copy, { ref: moved(typeRefOf(n)) })
            setNode(out, fresh.get(nid)!, copy)
        }
        for (const b of traced.blocks) {
            if (b.id === traced.root) continue
            out.blocks.push({ id: moved(b.id), params: b.params.map(moved), bodyId: moved(b.bodyId), bodyConst: b.bodyConst })
        }
        setGraphBlocks(out, out.blocks)
        const result = moved(symbolOf(nested.result))
        if (result) {
            putNode(out, id, NodeOp.inlined, [result, { literal: id }])
            return
        }
        putNode(out, id, NodeOp.after, [token, { literal: vmValue(nested.result as u32) }])
    }


    function callTrap(id: number, fn: Handle, mem: Memory, token: number, key: [ref: number, literal: number], value?: [ref: number, literal: number]): void {
        const callee = addNode(out, NodeOp.heapHandle, [{ literal: fn }])
        const [ptr, ptrLiteral] = addressOf(mem)
        const operands: Operand[] = [token, callee, ptr || { literal: ptrLiteral }, key[0] || { literal: key[1] }]
        if (value) operands.push(value[0] || { literal: value[1] })
        putNode(out, id, NodeOp.call, operands)
        bindCall(id, true)
    }

    function callWithPointer(id: number, fn: Handle, mem: Memory, token: number, value?: [ref: number, literal: number]): void {
        if (!session.stubFunctions.has(fn)) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const callee = addNode(out, NodeOp.heapHandle, [{ literal: fn }])
        const [self, selfLiteral] = mem.reduced || mem.base ? addressOf(mem) : [mem.ptr, 0]
        const operands: Operand[] = [token, callee, self || { literal: selfLiteral }]
        if (value) operands.push(value[0] || { literal: value[1] })
        putNode(out, id, NodeOp.call, operands)
        bindCall(id, true)
        if (opts.calls && self && getRef(getNode(out, id)!, 2) === self) throw `property-eval: %${id} calls accessor ${fn}, which no planned unit takes for this receiver`
    }

    function sameSlot(a: BitSlot | undefined, b: BitSlot | undefined): boolean {
        if (!a || !b) return a === b
        return a.offset === b.offset && a.bit === b.bit && !!a.shared === !!b.shared
    }
    function sameCodec(a: native.Codec | undefined, b: native.Codec | undefined): boolean {
        if (!a || !b) return a === b
        if (a.kind !== b.kind || a.encoded !== b.encoded) return false
        if (a.kind === 'int' && b.kind === 'int') return a.type === b.type
        if (a.kind !== 'ref' || b.kind !== 'ref') return true
        const x = a.members ?? [a.shape]
        const y = b.members ?? [b.shape]
        return a.union === b.union && x.length === y.length && x.every((shape, i) => native.sameLayout(shape, y[i]))
    }
    function placement(shape: Handle, key: Handle): string {
        const addr = heap.getPropertyDescriptor(shape, key)
        if (!addr) return heap.getPropertyProxy(shape, key) ? 'proxy' : 'absent'
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) return `accessor ${desc.slot0} ${desc.slot1}`
        const fields = layout(shape)
        const at = fields.keys.indexOf(key)
        if (at < 0) return fields.keys.includes(heap.protoSlotKey) ? 'linked' : `inherited ${desc.slot0}`
        const fixed = opts.layouts.fixed?.get(shape)?.get(key)
        return `field ${fields.offsets[at]} ${reducedShape(shape)} ${readonly(shape)} ${fixed ?? '-'} ${fields.nested[at] ?? '-'}`
    }
    function agrees(mem: Memory, key: Handle): boolean {
        const members = mem.members!
        const first = members[0]
        const expected = placement(first, key)
        const fields = layout(first)
        const at = fields.keys.indexOf(key)
        for (const member of members) {
            const other = layout(member)
            const index = other.keys.indexOf(key)
            const same = placement(member, key) === expected && (at < 0 || (sameSlot(fields.flags[at], other.flags[index]) && sameSlot(fields.tags[at], other.tags[index]) && sameCodec(locate(first, String(fields.offsets[at])), locate(member, String(other.offsets[index])))))
            if (!same) return false
        }
        return true
    }
    function agreeOn(id: number, mem: Memory, key: Handle): void {
        if (!agrees(mem, key)) throw `property-eval: %${id} accesses ${heap.describeKey(key)} through a pointer to one of ${mem.members!.length} shapes, which lay it out differently`
    }

    let initInputs: Set<number> | undefined
    function feedsRootInit(id: number): boolean {
        if (!initToken) return false
        if (!initInputs) {
            initInputs = new Set()
            const stack = [initToken]
            while (stack.length) {
                const at = stack.pop()!
                if (initInputs.has(at)) continue
                initInputs.add(at)
                const m = getNode(out, at)
                if (!m) continue
                for (let i = 0; i < countIds(m); i++) if (getRef(m, i)) stack.push(getRef(m, i))
            }
        }
        return initInputs.has(id)
    }
    function resolveMemory(id: number, n: GraphNode, mem: Memory): void {
        let token = getRef(n, 0)
        if (mem.pointer && getNode(source, token)?.op === NodeOp.startOf && (getRef(getNode(source, token)!, 0) || graph.root) === graph.root && feedsRootInit(id)) {
            token = addNode(out, NodeOp.startOf, [])
        }
        if (mem.primitives) return resolveMixed(id, n, mem, token)
        const key = getLiteral(runtime, n, 2) as Handle
        const value: [number, number] = [getRef(n, 3), getRef(n, 3) ? 0 : getLiteral(runtime, n, 3)]
        const keyRef = getRef(n, 2)
        if (n.op === NodeOp.setProp && !keyRef && (mem.members ?? [mem.shape]).every(member => opts.layouts.erased?.get(member)?.has(key))) {
            forward.set(id, token)
            return
        }
        if (mem.members && (keyRef || !agrees(mem, key))) {
            const union = dispatchOf(getRef(n, 1), mem, token)
            const planned = union ? undefined : opts.answers?.get(getRef(n, 1))
            if (planned?.shape && !planned.members && memberIndex(mem.members, planned.shape) >= 0) return resolveMemory(id, n, { ...mem, ...pointerMemory(mem.ptr, planned.shape), decoded: mem.decoded, members: undefined })
            if (!union && keyRef) throw `property-eval: %${id} uses a computed key through a pointer to one of ${mem.members.length} shapes`
            if (!union) agreeOn(id, mem, key)
            if (n.op === NodeOp.getProp) return resolveUnion(id, n, union!, mem.ptr)
            return writeUnion(id, n, union!, mem.ptr)
        }
        const index = keyRef ? undefined : heap.keyIndex(key)
        if (keyRef || index !== undefined) {
            const proxy = keyRef ? heap.getComputedKeyProxy(mem.shape) : heap.getPropertyProxy(mem.shape, key)
            if (proxy && deletions.has(id)) throw `property-eval: %${id} deletes a key that an index trap holds`
            if (proxy) return callTrap(id, n.op === NodeOp.getProp ? heap.getProxyGetter(proxy) : heap.getProxySetter(proxy), mem, token, [keyRef, keyRef ? 0 : index!], n.op === NodeOp.setProp ? value : undefined)
            if (keyRef && n.op === NodeOp.getProp && shape(keyRef) === numberShape && !heap.hasIndexKeys(mem.shape)) {
                readUndefined(id, token)
                return
            }
            const tupled = keyRef && n.op === NodeOp.getProp ? tupleKey(keyRef, mem) : undefined
            if (tupled) return readTupled(id, mem, token, tupled[0], tupled[1])
            if (keyRef) throw `property-eval: %${id} uses a computed key on a memory object without an index trap`
        }
        if (n.op === NodeOp.setProp && readonly(mem.shape)) throw `property-eval: %${id} writes a constructed object, which is placed in read-only memory`
        if (mem.reduced && n.op === NodeOp.setProp && key === mem.keys[0]) {
            let at = getRef(n, 1)
            for (let m = getNode(source, at); m?.op === NodeOp.after && memory.get(at)?.pointer; m = getNode(source, at)) at = getRef(m, countIds(m) - 1)
            const fresh = memory.get(at)
            if (fresh?.reduced && !fresh.pointer && !fresh.address) {
                fresh.address = value
                let chained = token
                for (const [holder, i, slot] of pendingInits.get(fresh) ?? []) chained = initSlot(holder, i, chained, slot, value[0], value[1])
                pendingInits.delete(fresh)
                forward.set(id, chained)
                return
            }
        }
        if (mem.reduced && n.op === NodeOp.setProp && key === mem.keys[0]) throw `property-eval: %${id} writes a reduced object`
        if (mem.reduced && key === mem.keys[0]) {
            const [ref, literal] = addressOf(mem)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            const located = locate(mem.shape, String(mem.offsets[0]))
            if (!wordCodec(located) && (located?.kind === 'int' || located?.kind === 'f64' || located?.kind === 'boxed')) presentReads.add(id)
            return
        }
        if (n.op === NodeOp.getProp && mem.keys.includes(heap.protoSlotKey) && !mem.keys.includes(key)) return resolveInherited(id, n, mem)
        const addr = heap.getPropertyDescriptor(mem.shape, key)
        if (!addr) {
            if (heap.getPropertyProxy(mem.shape, key)) throw `property-eval: %${id} goes through a proxy on a memory object`
            if (n.op === NodeOp.setProp) throw `property-eval: %${id} adds a key to a memory object`
            const states = opts.answers?.get(getRef(n, 1))?.states ?? []
            if (states.length) return resolveCodeRead(id, mem, key, states, token)
            const functions = opts.answers?.get(getRef(n, 1))?.functions
            if (functions) return resolveFunctionRead(id, n, functions, token)
            readUndefined(id, token)
            return
        }
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        if (deletions.has(id) && (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter) || heap.getPropertyDescriptor(heap.prototypeOf(mem.shape), key) || mem.keys.includes(heap.protoSlotKey))) {
            throw `property-eval: %${id} deletes ${heap.describeKey(key)}, which a memory object cannot drop: the key is an accessor or the prototype also has it`
        }
        if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) {
            const forwarded = n.op === NodeOp.getProp && desc.flags & heap.PropFlags.has_getter ? opts.forwardedKey?.(desc.slot0 as Handle) : undefined
            if (forwarded !== undefined && forwarded !== key) return resolveMemory(id, makeNode(runtime, n.op, withOperand(runtime, n, 2, { literal: forwarded })), mem)
            if (n.op === NodeOp.getProp && desc.flags & heap.PropFlags.has_getter) return callWithPointer(id, desc.slot0 as Handle, mem, token)
            if (n.op === NodeOp.setProp && desc.flags & heap.PropFlags.has_setter) return callWithPointer(id, desc.slot1 as Handle, mem, token, value)
            throw `property-eval: %${id} uses an accessor without the matching half`
        }
        const at = mem.keys.indexOf(key)
        if (at < 0) {
            if (n.op === NodeOp.setProp) throw `property-eval: %${id} shadows a prototype key on a memory object`
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        const fixed = opts.layouts.fixed?.get(mem.shape)?.get(key)
        if (fixed !== undefined && n.op === NodeOp.setProp) {
            const stored = getRef(n, 3) ? getNode(source, getRef(n, 3)) : undefined
            if (stored?.op !== NodeOp.heapHandle || getRef(stored, 0) || getLiteral(runtime, stored, 0) !== fixed) throw `property-eval: %${id} writes a field that every construction fixes`
            forward.set(id, token)
            return
        }
        if (fixed !== undefined) {
            const [ref, literal] = operandOf(fixed)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        const offset = mem.base + mem.offsets[at]
        const inner = mem.nested[at]
        if (inner !== undefined) return resolveEmbedded(id, n, mem, token, offset, inner, value)
        const embedded = mem.base && mem.address?.[0] ? mem.address[0] : 0
        const base = embedded || mem.ptr
        const displacement = embedded ? mem.offsets[at] : offset
        if (n.op === NodeOp.getProp) {
            const slot = desc.slot0 as Handle
            const stable = readonly(mem.shape) || (mem.pointer && !(desc.flags & heap.PropFlags.writable))
            const identified = readonly(mem.shape) && getNode(source, mem.ptr)?.op === NodeOp.heapHandle
            if (identified && heap.isBoxedF64(slot) && !heap.boxedNanId(slot)) {
                putNode(out, id, NodeOp.after, [token, { literal: heap.unboxF64(slot) }])
                return
            }
            const flag = mem.flags[at]
            if (flag) {
                putNode(out, id, NodeOp.after, [token, readBit(stable ? readonlyToken() : token, base, displacement, flag)])
                numbers.add(id)
                return
            }
            locations.set(id, [mem.shape, String(mem.offsets[at])])
            const located = locate(mem.shape, String(mem.offsets[at]))
            if (located?.kind === 'undefined') {
                readUndefined(id, token)
                return
            }
            const rawFloat = located?.kind === 'f64' && !located.encoded
            const word = wordCodec(located)
            const load = newId()
            const signed = opts.answers?.get(id)?.signed
            putNode(out, load, NodeOp.load, [stable ? readonlyToken() : token, base, { literal: displacement }], rawFloat ? Types.f64 : word ? Types.vm_value : signed !== undefined ? signed ? Types.i64 : Types.u64 : native.intType(located) ?? Types.u64)
            const tag = mem.tags[at]
            const tagRead = tag ? readBit(stable ? readonlyToken() : token, base, embedded ? tag.offset : mem.base + tag.offset, tag) : 0
            if (tagRead) fieldTags.set(id, tagRead)
            else if (!word && (located?.kind === 'int' || located?.kind === 'f64' || located?.kind === 'boxed')) presentReads.add(id)
            const value = rawFloat && signed !== undefined ? addNode(out, NodeOp.convert, [load], Types.i64) : load
            putNode(out, id, NodeOp.after, tagRead && !stable ? [token, tagRead, value] : [token, value])
            if (rawFloat) {
                numbers.add(id)
                return
            }
            if (located?.kind === 'f64') unbox(id, load, native.pstack0Base())
            if (located?.kind === 'boxed') unboxNumber(id, load)
            if (located?.kind === 'int') {
                numbers.add(id)
                return
            }
            const answer = opts.answers?.get(id)
            if (word && answer?.shape === numberShape && !answer.nullable && !answer.zero) {
                if (answer.signed !== undefined) unboxNumber(id, load, answer.signed ? Types.i64 : Types.u64)
                else unbox(id, load, native.pstack0Base())
                numbers.add(id)
                return
            }
            if (located?.kind === 'word' && located.encoded) return
            if (heap.isString(slot) || (located?.kind === 'ref' && located.shape === stringShape)) {
                commit(id, stringShape)
                return
            }
            if (located?.kind === 'ref') {
                bindLocated(id, located, load)
                return
            }
            if (located !== undefined) return
            if (isObjectSlot(slot)) {
                const shape = heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot
                memory.set(id, pointerMemory(load, shape))
                return
            }
            if (contents.get(`${mem.shape}/${mem.offsets[at]}`) === numberShape) numbers.add(id)
            return
        }
        const flag = mem.flags[at]
        if (flag) {
            writeBit(id, token, base, displacement, flag, value[0] || { literal: value[1] })
            return
        }
        const tag = mem.tags[at]
        if (tag) {
            const payload = newId()
            storeField(payload, token, base, displacement, mem.shape, mem.offsets[at], value[0] || { literal: value[1] })
            writeBit(id, payload, base, embedded ? tag.offset : mem.base + tag.offset, tag, tagValue(value[0], 1))
        } else storeField(id, token, base, displacement, mem.shape, mem.offsets[at], value[0] || { literal: value[1] })
        const storedShape = value[0] ? storedFact(value[0]) : literalStored(mem.shape, key, value[1])
        if (storedShape !== undefined && !dead(id)) storeFact(mem.shape, String(mem.offsets[at]), storedShape, value[0])
    }

    function tupleKey(keyRef: number, mem: Memory): [Operand, Handle[]] | undefined {
        if (!opts.tupleKeys || mem.base || mem.reduced) return
        const read = getNode(source, strippedValue(keyRef))
        if (read?.op !== NodeOp.getProp) return
        const tuple = getNode(source, strippedValue(getRef(read, 1)))
        if (tuple?.op !== NodeOp.heapHandle || getRef(tuple, 0)) return
        const keys = opts.tupleKeys(heap.deref(getLiteral(runtime, tuple, 0) as Handle), mem.shape)
        if (!keys) return
        return [getRef(read, 2) || { literal: getLiteral(runtime, read, 2) }, keys]
    }
    function readTupled(id: number, mem: Memory, token: number, index: Operand, keys: Handle[]): void {
        const offsets: number[] = []
        let codec: native.Codec | undefined
        for (let i = 0; i < keys.length; i++) {
            const at = mem.keys.indexOf(keys[i])
            const plain = at >= 0 && !mem.flags[at] && !mem.tags[at] && mem.nested[at] === undefined && !opts.layouts.fixed?.get(mem.shape)?.has(keys[i]) && !opts.layouts.erased?.get(mem.shape)?.has(keys[i])
            if (!plain) throw `property-eval: %${id} reads ${heap.describeKey(keys[i])} through a key tuple, but it is not a plain field`
            const located = locate(mem.shape, String(mem.offsets[at]))
            if (!located || (i && !sameCodec(codec, located))) throw `property-eval: %${id} reads through a key tuple whose fields lay out differently`
            codec = located
            offsets.push(mem.offsets[at])
        }
        const table = addNode(out, NodeOp.poolEntry, [{ literal: opts.wordsSlot!(offsets) }], Types.u64)
        const scaled = typeof index === 'number' ? addNode(out, NodeOp.shl, [index, { literal: 2 }], Types.u64) : { literal: index.literal * 4 }
        const offset = addNode(out, NodeOp.load, [readonlyToken(), table, scaled], Types.u32)
        const address = addNode(out, NodeOp.add, [mem.ptr, offset], Types.u64)
        const rawFloat = codec!.kind === 'f64' && !codec!.encoded
        const signed = opts.answers?.get(id)?.signed
        const load = addNode(out, NodeOp.load, [readonlyToken(), address, { literal: 0 }], rawFloat ? Types.f64 : wordCodec(codec) ? Types.vm_value : signed !== undefined ? signed ? Types.i64 : Types.u64 : native.intType(codec) ?? Types.u64)
        putNode(out, id, NodeOp.after, [token, load])
        if (rawFloat || codec!.kind === 'int') {
            numbers.add(id)
            return
        }
        if (codec!.kind === 'ref' && codec!.shape === stringShape) {
            commit(id, stringShape)
            return
        }
        if (codec!.kind === 'ref') {
            bindLocated(id, codec!, load)
            return
        }
        throw `property-eval: %${id} reads through a key tuple whose fields hold ${codec!.kind} values`
    }
    const guardedSelects = new Set<number>()
    const dispatches = new Map<number, number>()
    function resolveMixed(id: number, n: GraphNode, mem: Memory, token: number): void {
        const objects = { ...mem, primitives: undefined }
        if (n.op === NodeOp.setProp) return resolveMemory(id, n, objects)
        if (getRef(n, 2)) throw `property-eval: %${id} uses a computed key on a value that may be a primitive`
        const object = newId()
        callOrigins.set(object, id)
        resolveMemory(object, n, objects)
        const primitive = newId()
        resolvePrimitive(primitive, n, mem.primitives!, token)
        const arms = [primitive, object]
        const dispatch = tagSelect({ tag: mem.kind! }, arms)
        guardedSelects.add(dispatch)
        dispatches.set(dispatch, id)
        putNode(out, id, NodeOp.after, [token, dispatch])
        joinArms(id, { tag: mem.kind! }, arms, arms.map(arm => memory.get(arm)?.shape ?? (forwardedReads.has(arm) ? shape(forwardedReads.get(arm)!) : undefined)))
    }
    function numberPrototype(): Handle {
        return heap.deref(heap.getPrototypeProperty(heap.deref(session.linkFunction(builtinGlobals.Number) as Handle)))
    }
    function resolvePrimitive(id: number, n: GraphNode, primitives: Handle[], token: number): void {
        const key = getLiteral(runtime, n, 2) as Handle
        let found: Handle | undefined
        for (const primitive of primitives) {
            const addr = heap.getPropertyDescriptor(primitive, key)
            if (!addr) continue
            const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
            if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) throw `property-eval: %${id} reads an accessor of a primitive through a value that may be an object`
            if (found !== undefined && found !== desc.slot0) throw `property-eval: %${id} reads a key that differs between the primitives it may be`
            found = desc.slot0 as Handle
        }
        if (found === undefined) return readUndefined(id, token)
        const [ref, literal] = operandOf(found)
        putNode(out, id, NodeOp.after, [token, ref || { literal }])
    }
    function resolveFunctionRead(id: number, n: GraphNode, functions: Handle[], token: number): void {
        const key = getLiteral(runtime, n, 2) as Handle
        if (functions.some(state => heap.getPropertyDescriptor(state, key)) || opts.answers?.get(id)?.shape !== null) throw `property-eval: %${id} reads a property that a function value may have`
        readUndefined(id, token)
    }
    function resolveCodeRead(id: number, mem: Memory, key: Handle, states: Handle[], token: number): void {
        const answers: Handle[] = []
        for (const state of states) {
            const addr = heap.getPropertyDescriptor(state, key)
            if (!addr) {
                answers.push(heap.undefinedHandle)
                continue
            }
            const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
            if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) throw `property-eval: %${id} reads ${heap.describeKey(key)} of a function value through an accessor`
            answers.push(desc.slot0 as Handle)
        }
        const answerOperand = (i: number): Operand => {
            if (answers[i] === heap.undefinedHandle) return undefinedValue()
            const [ref, literal] = operandOf(answers[i])
            return ref || { literal }
        }
        if (answers.every(answer => answer === heap.undefinedHandle)) return readUndefined(id, token)
        if (answers.every(answer => answer === answers[0])) {
            putNode(out, id, NodeOp.after, [token, answerOperand(0)])
            return
        }
        if (mem.members) agreeOn(id, mem, heap.closureCallKey)
        const fields = mem.members ? layout(mem.members[0]) : mem
        const at = fields.keys.indexOf(heap.closureCallKey)
        if (at < 0) throw `property-eval: %${id} reads ${heap.describeKey(key)} of function values that differ on it and keep no call field`
        const [reducedRef, reducedLiteral] = mem.reduced ? addressOf(mem) : [0, 0]
        const code = mem.reduced ? reducedRef || { literal: reducedLiteral } : addNode(out, NodeOp.load, [token, mem.ptr, { literal: mem.base + fields.offsets[at] }], Types.fnptr)
        let common = 0
        let best = 0
        for (let i = 0; i < answers.length; i++) {
            const count = answers.filter(answer => answer === answers[i]).length
            if (count <= best) continue
            best = count
            common = i
        }
        let chosen = answerOperand(common)
        for (let i = answers.length - 1; i >= 0; i--) {
            if (answers[i] === answers[common]) continue
            const target = addNode(out, NodeOp.heapHandle, [{ literal: slotAt(states[i], heap.closureCallKey) }])
            const test = addNode(out, NodeOp.eq, [code, target], Types.bool)
            chosen = addNode(out, NodeOp.select, [test, answerOperand(i), chosen])
        }
        putNode(out, id, NodeOp.after, [token, chosen])
    }
    function resolveInherited(id: number, n: GraphNode, mem: Memory): void {
        const link = addNode(source, NodeOp.getProp, [getRef(n, 0), getRef(n, 1), { literal: heap.protoSlotKey }])
        putCopy(out, link, getNode(source, link)!)
        resolveMemory(link, getNode(source, link)!, mem)
        const proto = memory.get(link)
        if (!proto) throw `property-eval: %${id} reads through a prototype link whose shape is unknown`
        resolveMemory(id, n, proto)
    }

    function resolveEmbedded(id: number, n: GraphNode, mem: Memory, token: number, offset: number, inner: Handle, value: [number, number]): void {
        if (n.op === NodeOp.setProp) {
            const stored = value[0] ? memory.get(value[0]) : undefined
            if (!stored || stored.ptr !== mem.ptr || stored.base !== offset) throw `property-eval: %${id} reassigns an embedded field`
            forward.set(id, token)
            return
        }
        const address = addNode(out, NodeOp.add, [mem.ptr, { literal: offset }])
        putNode(out, id, NodeOp.after, [token, address])
        memory.set(id, { ...layout(inner), ptr: mem.ptr, base: offset, shape: inner, reduced: false, pointer: true, address: [id, 0], owner: mem.owner ?? mem.shape })
    }

    function write(cell: Handle, key: Handle, slot: Handle): void {
        heap.setProperty(heap.prepareWrite(cell), key, slot)
    }

    function wordGetter(id: number, n: GraphNode): void {
        const addr = heap.getPropertyDescriptor(stringShape, getLiteral(runtime, n, 2) as Handle)
        const desc = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)) : undefined
        if (!desc || !(desc.flags & heap.PropFlags.has_getter) || opts.answers?.get(id)?.receiver !== stringShape) return
        const callee = addNode(out, NodeOp.heapHandle, [{ literal: desc.slot0 }])
        putNode(out, id, NodeOp.call, [getRef(n, 0), callee, getRef(n, 1)])
        bindCall(id, true)
        if (!bindings.has(id)) throw `property-eval: %${id} reads a string getter through a union word, but no planned unit takes the word as a string`
    }
    function resolveString(id: number, n: GraphNode): void {
        if (n.op !== NodeOp.getProp || getRef(n, 2)) throw `property-eval: %${id} is not a named read of a string`
        const addr = heap.getPropertyDescriptor(stringShape, getLiteral(runtime, n, 2) as Handle)
        const desc = addr ? heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)) : undefined
        if (desc && !(desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter))) {
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            putNode(out, id, NodeOp.after, [getRef(n, 0), ref || { literal }])
            return
        }
        if (!desc || !(desc.flags & heap.PropFlags.has_getter)) throw `property-eval: %${id} reads a string property that has no getter`
        inline(id, desc.slot0 as Handle, symbolValue(getRef(n, 1)), [], getRef(n, 0))
    }

    function resolve(id: number, n: GraphNode): void {
        const union = unions.get(getRef(n, 1))
        if (union && n.op === NodeOp.getProp) return resolveUnion(id, n, union, getRef(n, 1))
        if (union) return writeUnion(id, n, union, getRef(n, 1))
        const mem = memory.get(getRef(n, 1))
        if (mem) return resolveMemory(id, n, mem)
        const token = getRef(n, 0)
        const cell = objectOf(getRef(n, 1))
        const key = getLiteral(runtime, n, 2) as Handle
        if (deletions.has(id)) {
            if (!heap.getOwnProperty(heap.indirectTarget(cell), key) && heap.getPropertyProxy(heap.indirectTarget(cell), key)) throw `property-eval: %${id} deletes a key that an index trap holds`
            heap.deleteOwnProperty(heap.prepareWrite(cell), key)
            forward.set(id, token)
            return
        }
        const addr = heap.getPropertyDescriptor(heap.indirectTarget(cell), key)
        if (!addr) {
            const proxy = heap.getPropertyProxy(heap.indirectTarget(cell), key)
            if (!proxy) {
                if (n.op === NodeOp.getProp) {
                    readUndefined(id, token)
                    return
                }
                write(cell, key, slotOf(n, 3))
                forward.set(id, token)
                return
            }
            if (n.op === NodeOp.getProp) return inline(id, heap.getProxyGetter(proxy), tagVmHandle(cell), [keyArg(key)], token)
            return inline(id, heap.getProxySetter(proxy), tagVmHandle(cell), [keyArg(key), tagVmHandle(slotOf(n, 3))], token)
        }
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        const accessor = desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)
        if (n.op === NodeOp.getProp) {
            if (desc.flags & heap.PropFlags.has_getter) {
                return inline(id, desc.slot0 as Handle, tagVmHandle(cell), [], token)
            }
            if (accessor) throw `property-eval: %${id} reads a property with only a setter`
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            putNode(out, id, NodeOp.after, [token, ref || { literal }])
            return
        }
        if (desc.flags & heap.PropFlags.has_setter) return inline(id, desc.slot1 as Handle, tagVmHandle(cell), [tagVmHandle(slotOf(n, 3))], token)
        if (accessor) throw `property-eval: %${id} writes a property with only a getter`
        write(cell, key, slotOf(n, 3))
        forward.set(id, token)
    }

    function arrivals(param: number): number[] {
        const at = paramSlots.get(param)
        if (!at) return []
        return appliesOf(at.block).map(apply => getRef(getNode(source, apply)!, at.index + 1))
    }
    function agree(shapes: (Handle | null | undefined)[]): Handle | null | undefined {
        let found: Handle | undefined
        let nullish = false
        for (const shape of shapes) {
            if (shape === null) {
                nullish = true
                continue
            }
            if (shape === undefined) return
            if (found !== undefined && (found === numberShape || shape === numberShape ? found !== shape : !native.sameLayout(found, shape))) return
            found = shape
        }
        if (found === numberShape && nullish) return
        return found ?? null
    }
    interface Tag {
        tag: number
        ids?: number[]
    }
    interface Union extends Tag {
        members: Handle[]
    }
    const unions = new Map<number, Union>()
    const unionTargets = new Map<number, { union: Tag, arms: number[] }>()
    const dispatchedObjects = new Map<number, Union>()
    let armOverride: { id: number, shape: Handle } | undefined
    function memberIndex(members: Handle[], shape: Handle): number {
        const exact = members.indexOf(shape)
        if (exact >= 0) return exact
        const views = opts.layouts.views?.get(shape) ?? []
        const viewed = members.filter(m => views.includes(m))
        if (viewed.length > 1) throw `property-eval: closure state @${shape} is viewed as ${viewed.length} members of one union`
        if (viewed.length) return members.indexOf(viewed[0])
        return members.findIndex(m => native.sameSnapshotShape(m, shape))
    }
    function unionOf(param: number, members: Handle[]): void {
        if (unions.has(param)) return
        const at = paramSlots.get(param)
        if (!at) return
        if (at.block === graph.root) {
            memory.set(param, { ...pointerMemory(param, members[0]), members })
            return
        }
        const tag = addNode(out, NodeOp.param, [])
        const block = out.blocks.find(b => b.id === at.block)!
        const position = block.params.length
        pushBlockParams(out, block, tag)
        unions.set(param, { tag, members })
        let untagged = false
        for (const apply of appliesOf(at.block)) {
            const current = getNode(out, apply)!
            const arrival = getRef(getNode(source, apply)!, at.index + 1)
            const operands = getOperands(runtime, current)
            let carried = unions.get(strippedValue(arrival))
            let arrived: Handle | null | undefined
            if (!carried) {
                arrived = pointerShape(arrival)
                carried = unions.get(strippedValue(arrival))
            }
            if (!carried && memory.get(strippedValue(arrival))?.members) {
                untagged = true
                operands.splice(position + 1, 0, { literal: 0 })
                putCopy(out, apply, current, operands)
                continue
            }
            if (carried) {
                const indices = carried.members.map(m => memberIndex(members, m))
                if (indices.some(i => i < 0)) throw `property-eval: %${apply} carries an unknown union member into %${param}`
                operands.splice(position + 1, 0, remapTag(carried, indices))
                putCopy(out, apply, current, operands)
                continue
            }
            let index = -1
            if (arrived === null) index = 0
            else if (arrived) index = memberIndex(members, arrived)
            if (index < 0) throw `property-eval: %${apply} brings an unknown shape into the union at %${param}`
            operands.splice(position + 1, 0, { literal: index })
            putCopy(out, apply, current, operands)
        }
        if (!untagged) return
        unions.delete(param)
        memory.set(param, { ...pointerMemory(param, members[0]), members })
    }
    function remapTag(union: Tag, indices: number[]): number {
        if (!union.ids && indices.every((index, i) => index === i)) return union.tag
        return tagSelect(union, indices.map(index => addNode(out, NodeOp.literal, [{ literal: index }])))
    }
    function tagSelect(union: Tag, arms: number[], guarded = false): number {
        let chosen = arms[arms.length - 1]
        for (let i = arms.length - 2; i >= 0; i--) {
            const test = addNode(out, NodeOp.eq, [union.tag, { literal: union.ids ? union.ids[i] : i }], Types.bool)
            const select = newId()
            putNode(out, select, NodeOp.select, [test, arms[i], chosen])
            if (guarded) guardedSelects.add(select)
            chosen = select
        }
        return chosen
    }
    function resolveUnion(id: number, n: GraphNode, union: Union, ptr: number): void {
        const arms: number[] = []
        const shapes: (Handle | null | undefined)[] = []
        let constants = true
        const targets: number[] = []
        for (const memberShape of union.members) {
            const member = pointerMemory(ptr, memberShape)
            const arm = newId()
            callOrigins.set(arm, callOrigins.get(id) ?? id)
            resolveMemory(arm, n, member)
            arms.push(arm)
            const forwarded = forwardedReads.get(arm)
            shapes.push(memory.get(arm)?.shape ?? (forwarded !== undefined ? shape(forwarded) : undefined))
            const resolved = getNode(out, arm)!
            const value = resolved.op === NodeOp.after ? getRef(resolved, countIds(resolved) - 1) : 0
            const valueNode = value ? getNode(out, value) : undefined
            if (valueNode?.op === NodeOp.heapHandle && !getRef(valueNode, 0)) targets.push(value)
            else if (memory.has(arm)) targets.push(arm)
            else constants = false
        }
        const chosen = tagSelect(union, arms, union.members.some(reducedShape))
        putNode(out, id, NodeOp.after, [getRef(n, 0), chosen])
        const armTags = arms.map(arm => fieldTags.get(arm) ?? (presentReads.has(arm) ? 1 : undefinedId && forwardedReads.get(arm) === undefinedId ? 0 : undefined))
        if (armTags.every(tag => tag !== undefined)) fieldTags.set(id, tagSelect(union, arms.map((arm, i) => fieldTags.get(arm) ?? addNode(out, NodeOp.literal, [{ literal: armTags[i]! }], Types.bool))))
        if (constants) unionTargets.set(id, { union, arms: targets })
        joinArms(id, union, arms, shapes)
    }
