        while (short && operands.length < 3 + binding.paramCount) operands.push(addNode(out, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }]))
        if (binding.receiver) {
            while (operands.length < 3 + binding.paramCount) operands.push(0)
            operands.splice(3 + binding.paramCount, 0, receiver)
        }
        if (binding.returnSlot) {
            while (operands.length < 3 + binding.returnSlot.at) operands.push(0)
            const slot = addNode(out, NodeOp.pstack, [token, 0, 0, { literal: Math.max(binding.returnSlot.size, 8) }])
            operands.push(slot)
        }
        putCopy(out, id, current, operands)
    }
    const decodeInputs = new Set<number>()
    function decodeHandle(raw: number, base: number): number {
        const ptr = addNode(out, NodeOp.decode, [raw, { literal: base }])
        decodeInputs.add(ptr)
        return ptr
    }
    const unboxed = new Map<number, number>()
    function unboxNumber(id: number, word: number, T: intrinsics.Types): void {
        if (unboxed.has(id)) return
        const value = addNode(out, NodeOp.unbox, [word], T)
        decodeInputs.add(value)
        unboxed.set(id, value)
        numbers.add(id)
    }
    function unbox(id: number, word: number, base: number): void {
        const low = addNode(out, NodeOp.and, [word, { literal: 1 }], Types.u64)
        const high = addNode(out, NodeOp.ge, [word, { literal: heap.pstackBoxWordTag }], Types.bool)
        const small = addNode(out, NodeOp.unbox, [word], Types.i64)
        decodeInputs.add(low)
        decodeInputs.add(high)
        decodeInputs.add(small)
        const boxed = addNode(out, NodeOp.and, [addNode(out, NodeOp.ne, [low, { literal: 0 }], Types.bool), high], Types.bool)
        const loaded = addNode(out, NodeOp.load, [readonlyToken(), decodeHandle(word, base), { literal: 0 }], Types.f64)
        const value = addNode(out, NodeOp.select, [boxed, loaded, addNode(out, NodeOp.convert, [small], Types.f64)])
        guardedSelects.add(value)
        unboxed.set(id, value)
    }
    function fieldWord(id: number, field: number | undefined): number {
        if (field === undefined) return id
        return addNode(out, NodeOp.get, [id, { literal: field }])
    }
    for (const [id, { base, members, primitives, field }] of unionPointers) bindResult(id, pointers.get(id)!, base, true, members.length > 1 ? members : undefined, primitives, fieldWord(id, field))
    const forwardedReads = new Map<number, number>()
    function boundShape(id: number): Handle | undefined {
        return memory.get(id)?.shape ?? (strings.has(id) ? stringShape : numbers.has(id) ? numberShape : undefined)
    }
    function bindResult(id: number, shape: Handle, decode: number | undefined, union?: boolean, members?: Handle[], primitives?: Handle[], word = id): void {
        if (shape === stringShape) {
            strings.add(id)
            return
        }
        if (shape === numberShape) {
            numbers.add(id)
            return
        }
        const kind = primitives ? objectWord(id) : undefined
        const ptr = decode !== undefined ? decodeHandle(word, decode) : word
        memory.set(id, { ...pointerMemory(ptr, shape), decoded: decode !== undefined, union, members, primitives, kind })
    }
    function bindLocated(id: number, located: native.Codec & { kind: 'ref' }, word: number): Handle | undefined {
        const answer = opts.answers?.get(id)
        const objects = located.union ? answer?.objects : undefined
        if (answer && located.primitives && !objects) return
        const shape = objects?.[0] ?? located.shape
        const members = objects ? objects.length > 1 ? objects : undefined : located.members
        bindResult(id, shape, located.encoded ? native.pstack0Base() : undefined, located.union, members, answer ? answer.primitives : located.primitives, word)
        return shape
    }
    function objectWord(id: number): number {
        const kind = addNode(out, NodeOp.rt, [readonlyToken(), { literal: RtOp.typeof }, id])
        const name = addNode(out, NodeOp.heapHandle, [{ literal: heap.typeNames.object }])
        return addNode(out, NodeOp.eq, [kind, name], Types.bool)
    }
    function evaluate(id: number): void {
        if (!evaluated.has(id)) query(`e${id}`, () => evaluateNow(id))
    }
    let undefinedId = 0
    function undefinedValue(): number {
        if (undefinedId) return undefinedId
        undefinedId = addNode(source, NodeOp.heapHandle, [{ literal: heap.undefinedHandle }])
        setNode(out, undefinedId, getNode(source, undefinedId)!)
        return undefinedId
    }
    function readUndefined(id: number, token: number): void {
        const value = undefinedValue()
        putNode(out, id, NodeOp.after, [token, value])
        forwardedReads.set(id, value)
    }
    function evaluateNow(id: number): void {
        const n = getNode(source, id)!
        const object = getRef(n, 1)
        const inputs = inputsOf(n)
        for (const input of inputs) shape(input)
        if (dead2(object)) {
            putNode(out, id, NodeOp.after, [getRef(n, 0), object])
            evaluated.add(id)
            return
        }
        if (snapshotNode(object) && !memory.has(object)) for (const call of callUsers(object, 2)) bindCall(call)
        const stringObject = shape(object) === stringShape
        if (n.op === NodeOp.getProp) {
            const known = shape(object)
            const objectShape = known === numberShape || stringObject ? null : known
            const reads = cells.has(object) || snapshotNode(object) ? [] : objectShape ? readsState(n, objectShape) ? [objectShape] : [] : (unions.get(object)?.members ?? []).filter(member => readsState(n, member))
            const field = fieldRead(id)
            if (field) content(field)
            if (!field && !embeddedRead(id)) for (const read of reads) demandPreceding(read, id)
        }
        if (stringObject) {
            resolveString(id, n)
            evaluated.add(id)
            return
        }
        const numberObject = n.op === NodeOp.getProp && shape(object) === numberShape && !opts.answers?.get(object)?.bool
        if (numberObject && !getRef(n, 2)) {
            resolvePrimitive(id, n, [numberPrototype()], getRef(n, 0))
            evaluated.add(id)
            return
        }
        if (numberObject && shape(getRef(n, 2)) === numberShape && !heap.hasIndexKeys(numberPrototype())) {
            readUndefined(id, getRef(n, 0))
            evaluated.add(id)
            return
        }
        if (n.op === NodeOp.getProp && shape(object) === null) {
            const thrown = addNode(out, NodeOp.after, [getRef(n, 0), object])
            putNode(out, id, NodeOp.after, [getRef(n, 0), addNode(out, NodeOp.panic, [thrown])])
            evaluated.add(id)
            return
        }
        const snapshot = n.op === NodeOp.getProp && !getRef(n, 2) && !memory.has(object) ? snapshotNode(object) : undefined
        const snapshotKey = snapshot ? heap.getOwnProperty(getLiteral(runtime, snapshot, 1) as Handle, getLiteral(runtime, n, 2) as Handle) : 0
        if (snapshot && snapshotKey && !(heap.FullPropertyDescriptor(heap.resolveHeapCell(snapshotKey)).flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter))) {
            const [ref, literal] = fieldOperand(object, getLiteral(runtime, snapshot, 1) as Handle, getLiteral(runtime, n, 2) as Handle)
            putNode(out, id, NodeOp.after, [getRef(n, 0), ref || { literal }])
            if (ref) forwardedReads.set(id, ref)
            else numbers.add(id)
            evaluated.add(id)
            return
        }
        const functions = n.op === NodeOp.getProp && !getRef(n, 2) && !memory.has(object) ? opts.answers?.get(object)?.functions : undefined
        if (functions) {
            resolveFunctionRead(id, n, functions, getRef(n, 0))
            evaluated.add(id)
            return
        }
        if (!memory.has(object) && !cells.has(object) && !unions.has(object)) {
            if (bindings.get(object)?.union && n.op === NodeOp.getProp && !getRef(n, 2)) wordGetter(id, n)
            evaluated.add(id)
            return
        }
        const initToken = initTokens.get(id)
        resolve(id, initToken === undefined ? n : makeNode(runtime, n.op, withOperand(runtime, n, 0, initToken)))
        evaluated.add(id)
        const result = memory.get(id)
        if (result) hold(rootOf(result.shape), id)
    }

    for (const [id, n] of nodeEntries(source)) {
        if (runtimeCalls.has(id)) {
            bindCall(id)
            continue
        }
        if (n.op !== NodeOp.getProp && n.op !== NodeOp.setProp) continue
        evaluate(id)
    }
    for (const [id, n] of nodeEntries(source)) {
        if (n.op !== NodeOp.call) continue
        bindCall(id)
        resolvePending(id)
        demandArgs()
    }
    for (const id of [...waitingResults.keys()]) resolvePending(id)
    demandArgs()
    for (const [shape, path, value] of initStores) {
        const stored = storedFact(value)
        if (stored !== undefined) storeFact(shape, path, stored, value)
    }
    for (const id of nodeIds(source)) {
        if (membersTypeof(id)) continue
        const name = typeofName(id)
        const operand = name !== undefined ? getRef(getNode(source, id)!, 2) : 0
        const absentName = name !== undefined ? nullMember(operand) : undefined
        if (name !== undefined && absentName !== undefined) {
            const missing = addNode(out, NodeOp.eq, [operand, absentName === heap.typeNames.number ? { literal: 0 } : undefinedValue()], Types.bool)
            const absent = addNode(out, NodeOp.heapHandle, [{ literal: absentName }])
            const present = addNode(out, NodeOp.heapHandle, [{ literal: name }])
            putNode(out, id, NodeOp.select, [missing, absent, present])
        } else if (name !== undefined) putNode(out, id, NodeOp.heapHandle, [{ literal: name }])
        if (propertyTest(id)) continue
        if (linkedPrototypeTest(id)) continue
        if (unionPrototypeTest(id)) continue
        const chain = prototypeChain(id)
        if (chain !== undefined) prototypeTest(id, chain)
    }
    function dispatchCall(id: number, n: GraphNode): void {
        if (n.op !== NodeOp.call) return
        const mem = memory.get(getRef(n, 1))
        const union = mem ? undefined : unions.get(getRef(n, 1))
        if (!mem && !union) return
        const current = getNode(out, id)!
        if (current.op !== NodeOp.call) return
        const dispatch = mem?.members && !agrees(mem, heap.closureCallKey) ? dispatchOf(getRef(n, 1), mem, getRef(current, 0)) : undefined
        if (mem?.members && !dispatch) agreeOn(id, mem, heap.closureCallKey)
        const chosen = dispatch ?? union
        const codes = (dispatch ? dispatch.members : mem ? [mem.shape] : union!.members).map(shape => {
            const addr = heap.getPropertyDescriptor(shape, heap.closureCallKey)
            if (!addr && chosen) return addNode(out, NodeOp.unreachable, []) // XXX
            if (!addr) throw `property-eval: %${id} calls an object without a call slot`
            const slot = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).slot0 as Handle
            const code = chosen ? opts.layouts.codes?.get(shape) : undefined
            if (code !== undefined) return addNode(out, NodeOp.heapHandle, [{ literal: code }])
            if (!mem && heap.isBoxedF64(slot)) {
                const fields = layout(shape)
                return addNode(out, NodeOp.load, [getRef(current, 0), getRef(n, 1), { literal: fields.offsets[fields.keys.indexOf(heap.closureCallKey)] }], Types.fnptr)
            }
            if (mem && (heap.isBoxedF64(slot) || mem.members)) {
                const fields = dispatch ? layout(shape) : mem
                const at = fields.keys.indexOf(heap.closureCallKey)
                return addNode(out, NodeOp.load, [getRef(current, 0), mem.ptr, { literal: mem.base + fields.offsets[at] }], Types.fnptr)
            }
            return addNode(out, NodeOp.heapHandle, [{ literal: slot }])
        })
        const direct = closureTargets.get(id)
        const fnptr = direct !== undefined ? addNode(out, NodeOp.localTarget, [{ literal: direct }]) : chosen ? tagSelect(chosen, codes) : codes[0]
        const [context, contextLiteral] = mem ? addressOf(mem) : [getRef(n, 1), 0]
        const target = newId()
        const returns = callReturns.get(id)
        let targetType: TypeOperand | undefined
        if (returns !== undefined) {
            const fnType = newId()
            setNode(out, fnType, createFnType(runtime, returns))
            targetType = { ref: fnType }
        }
        putNode(out, target, NodeOp.indirectTarget, [fnptr, context || { literal: contextLiteral }], targetType)
        putCopy(out, id, current, withOperand(runtime, current, 1, target))
    }
    const arms = [...armCalls].map(arm => [arm, getNode(out, arm)!] as const)
    for (const [id, n] of nodeEntries(source)) dispatchCall(id, n)
    for (const [id, n] of arms) dispatchCall(id, n)
    for (const [id, n] of nodeEntries(source)) {
        if ((n.op !== NodeOp.load && n.op !== NodeOp.store) || typeOf(n) !== Types.vm_value) continue
        const base = locations.get(getRef(n, 1))
        if (!base) continue
        const located = locate(base[0], `${base[1]}/${getRef(n, 2) ? '*' : getLiteral(runtime, n, 2)}`)
        if (getNode(out, id)?.op !== n.op) continue
        const type = native.intType(located)
        if (type === undefined) continue
        retypeNode(out, id, n.op === NodeOp.store ? Types.u32 : type)
    }
    const replaced = new Map<number, [number, number]>()
    for (const [id, mem] of memory) {
        if (mem.union) continue
        if (!mem.pointer || mem.decoded) replaced.set(id, addressOf(mem))
    }
    for (const [id, value] of unboxed) replaced.set(id, [value, 0])
    for (const [id, n] of nodeEntries(out)) {
        if (n.op !== NodeOp.heapHandle || getRef(n, 0) || heapInterior(out, n) || memory.has(id) || replaced.has(id)) continue
        const home = homes.get(getLiteral(runtime, n, 0) as Handle)
        if (home && home.ptr) replaced.set(id, addressOf(home))
    }
    const returning = new Set<number>()
    for (const [id, n] of nodeEntries(out)) {
        if (n.op !== NodeOp.ret) continue
        returning.add(id)
        for (let m = getNode(out, getRef(n, 0)), at = getRef(n, 0); m?.op === NodeOp.after; at = getRef(m, countIds(m) - 1), m = getNode(out, at)) returning.add(at)
    }

    function target(id: number): number {
        while (forward.has(id)) id = forward.get(id)!
        return id
    }
    for (const [id, n] of nodeEntries(out)) {
        let ops: Operand[] | undefined
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref || (!forward.has(ref) && !replaced.has(ref))) continue
            if (decodeInputs.has(id) && !forward.has(ref)) continue
            const tail = getNode(out, id)!.op === NodeOp.ret ? 0 : countIds(n) - 1
            if (returning.has(id) && i === tail && ((memory.get(ref)?.decoded && !opts.rawReturns) || unboxed.has(ref)) && !forward.has(ref)) continue
            ops ??= getOperands(runtime, n)
            if (forward.has(ref)) {
                ops[i] = target(ref)
                continue
            }
            const [to, literal] = replaced.get(ref)!
            ops[i] = to || { literal }
        }
        if (!ops) continue
        putCopy(out, id, n, ops)
    }
    const substituted = new Map<number, number>()
    for (const [id, [to]] of replaced) if (decodeInputs.has(to)) substituted.set(to, target(id))
    if (substituted.size) {
        for (const [id, n] of nodeEntries(out)) {
            const end = firstNonOrderingSlot(n)
            let ops: Operand[] | undefined
            for (let i = 0; i < end; i++) {
                const original = substituted.get(getRef(n, i))
                if (original === undefined) continue
                ops ??= getOperands(runtime, n)
                ops[i] = original
            }
            if (ops) putCopy(out, id, n, ops)
        }
    }
    for (const id of forward.keys()) deleteNode(out, id)
    for (const b of out.blocks) setBlockBody(out, b, target(b.bodyId))
    const inits: [block: number, token: number][] = []
    if (initToken) inits.push([graph.root, target(initToken)])
    for (const [at, [final]] of placedFinals) {
        const n = getNode(source, at)
        if (n?.op === NodeOp.startOf) inits.push([getRef(n, 0) || graph.root, target(final)])
    }
    for (const [block, initialized] of inits) {
        function sequence(id: number): number {
            const n = getNode(out, id)
            if (n?.op === NodeOp.apply) {
                const sequenced = addNode(out, NodeOp.after, [initialized, id])
                return sequenced
            }
            if (n?.op !== NodeOp.select) return id
            const arms = cloneRefs(n, 1).map(sequence)
            if (arms.every((arm, i) => arm === getRef(n, i + 1))) return id
            const operands = getOperands(runtime, n)
            arms.forEach((arm, i) => { operands[i + 1] = arm })
            return addCopy(out, n, operands)
        }
        const owner = out.blocks.find(b => b.id === block)
        if (owner) setBlockBody(out, owner, sequence(owner.bodyId))
    }
    const shapes = new Map<number, Handle>()
    for (const [id, mem] of memory) {
        if (native.heldAsField(opts.layouts.codecs, mem.members ?? [mem.shape])) continue
        shapes.set(id, mem.shape)
        const [ptr] = addressOf(mem)
        if (ptr) shapes.set(ptr, mem.shape)
    }
    const encoded = new Set<number>()
    for (const [id, mem] of memory) if (mem.decoded) encoded.add(id)
    for (const id of deletions) {
        const n = getNode(out, id)
        if (n?.op !== NodeOp.setProp) continue
        const operands = getOperands(runtime, n)
        putNode(out, id, NodeOp.rt, [operands[0], { literal: RtOp.deleteProperty }, operands[1], operands[2]])
    }
    splitGuardedSelects(out, guardedSelects)
    return { graph: out, shapes, encoded, tags: fieldTags, present: presentReads, dispatches }
}

export function frameShape(size: number, proxy: Handle): Handle {
    const shape = heap.makeObject(0 as Handle)
    for (let r = 0; r < size; r++) {
        const key = heap.indexKey(r as u32)
        const desc = heap.getOwnProperty(proxy, key)
        if (desc && !(heap.FullPropertyDescriptor(heap.resolveHeapCell(desc)).flags & heap.PropFlags.writable)) heap.setReadonlyProperty(shape, key, 0 as Handle)
        else heap.setProperty(shape, key, 0 as Handle)
    }
    return shape
}

export function forwardedField(graph: Graph): Handle | undefined {
    if (graph.blocks.length !== 1) return
    const ret = getNode(graph, graph.blocks[0].bodyId)
    if (ret?.op !== NodeOp.ret || !getRef(ret, 0)) return
    const read = getNode(graph, getRef(ret, 0))
    if (read?.op !== NodeOp.getProp || getRef(read, 2)) return
    const self = getNode(graph, getRef(read, 1))
    if (self?.op !== NodeOp.param || !isThisParam(self)) return
    if (getNode(graph, getRef(read, 0))?.op !== NodeOp.startOf) return
    return getLiteral(graph, read, 2) as Handle
}

export function placeObjects(graph: Graph, opts: ObjectRequest): Resolved {
    const { session, frames, params } = opts
    const objects = new Map<number, Handle>()
    const pointers = new Map<number, Handle>()
    for (const [i, shape] of params ?? []) pointers.set(graph.blocks[0].params[i], shape)
    for (const [id, n] of nodeEntries(graph)) {
        if (n.op === NodeOp.callContext && opts.contextShape !== undefined) pointers.set(id, opts.contextShape)
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(graph, n, 0) as u32
        const frame = frames.get(cell)
        if (frame !== undefined) objects.set(id, frame)
        if (session.sealed.has(cell as Handle) && session.templateOf(cell)) continue
        if (session.sealed.has(cell as Handle)) pointers.set(id, heap.indirectTarget(cell as Handle))
        else if (opts.statics?.has(heap.deref(cell as Handle))) pointers.set(id, heap.deref(cell as Handle))
        if (!heap.isIndirect(cell as Handle) || !session.templateOf(cell)) continue
        const shape = (heapInterior(graph, n) || heap.indirectTarget(cell as Handle)) as Handle
        objects.set(id, shape)
    }
    const unionPointers = new Map<number, UnionParam>()
    for (const [i, union] of opts.unionParams ?? []) {
        const param = graph.blocks[0].params[i]
        unionPointers.set(param, union)
        if (!pointers.has(param)) pointers.set(param, union.members[0])
    }
    const typed = someNode(graph, n => n.op === NodeOp.rt && (getLiteral(graph, n, 1) === RtOp.typeof || earlyCalls.has(getLiteral(graph, n, 1))))
    if (!objects.size && ![...pointers.values()].some(shape => shape !== numberShape) && !opts.calls && !typed) return { graph, shapes: new Map(), encoded: new Set(), tags: new Map(), present: new Set() }
    return resolveProperties(graph, session, objects, pointers, unionPointers, opts)
}

function isObjectSlot(slot: Handle): boolean {
    if (!slot || heap.isBoxedF64(slot) || heap.isString(slot) || heap.isCallable(slot)) return false
    return heap.isOrdinaryObject(heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot)
}

function slotAt(target: Handle, key: Handle): Handle {
    return heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key))).slot0 as Handle
}

function readonlyKeys(target: Handle, keys: Handle[]): boolean {
    for (const key of keys) {
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key)))
        if (d.flags & heap.PropFlags.writable) return false
    }
    return true
}

export function reducedShape(shape: Handle): boolean {
    const keys = dataKeys(shape)
    return keys.length === 1 && keys[0] !== heap.shapeTagKey && readonlyKeys(shape, keys)
}

export function dataKeys(target: Handle): Handle[] {
    const keys: Handle[] = []
    for (let i: u32 = 0; i < heap.ownPropertyCount(target); i++) {
        const key = heap.ownPropertyKeyAt(target, i)
        if (!key) continue
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.ownPropertyAt(target, i)))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
        keys.push(key)
    }
    return keys
}

const traceModule = await import('./trace2')
