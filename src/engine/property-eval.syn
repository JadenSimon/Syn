    function commit(id: number, value: Handle | null | undefined): void {
        if (value && value !== numberShape && value !== stringShape && adoptable.has(getNode(source, id)?.op)) memory.set(id, pointerMemory(id, value))
        else derived.set(id, value)
    }
    function shape(id: number): Handle | null | undefined {
