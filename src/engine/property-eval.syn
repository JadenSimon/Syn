            const operands = getOperands(runtime, n)
            arms.forEach((arm, i) => { operands[i + 1] = arm })
            return addCopy(out, n, operands)
        }
        const root = out.blocks.find(b => b.id === graph.root)!
        root.bodyId = sequence(root.bodyId)
    }
    const shapes = new Map<number, Handle>()
    for (const [id, mem] of memory) {
        shapes.set(id, mem.shape)
        const [ptr] = addressOf(mem)
        if (ptr) shapes.set(ptr, mem.shape)
    }
    const encoded = new Set<number>()
    for (const [id, mem] of memory) if (mem.decoded) encoded.add(id)
    const unionValues = new Set<number>()
    for (const [id, mem] of memory) if (mem.union) unionValues.add(id)
    const numberValues = new Set(numbers)
    const stringValues = new Set(strings)
    for (const [id, derivedShape] of derived) {
        if (derivedShape === numberShape) numberValues.add(id)
        if (derivedShape === stringShape) stringValues.add(id)
    }
    return { graph: out, calls, addresses, shapes, numbers: numberValues, strings: stringValues, encoded, unions: unionValues, arrayIterations, locations }
}

export interface ClosureOptions {
    unionParams?: Map<number, number>
    locate?: PropertyEvalOptions['locate']
    stored?: PropertyEvalOptions['stored']
    iterationField?: PropertyEvalOptions['iterationField']
    unify?: PropertyEvalOptions['unify']
    contextShape?: Handle
    created?: (closure: u32, shape: Handle) => void
    bound?: Map<u32, number>
}

export interface ResolvedClosures {
    graph: Graph
    memoryShapes: Map<number, Handle>
    numbers?: Set<number>
    strings?: Set<number>
    encoded?: Set<number>
    unions?: Set<number>
    locations?: Map<number, [shape: Handle, path: string]>
}

export function frameShape(size: number): Handle {
    const shape = heap.makeObject(0 as Handle)
    for (let r = 0; r < size; r++) heap.setProperty(shape, heap.indexKey(r as u32), 0 as Handle)
    return shape
}

export function resolveClosures(
    graph: Graph,
    session: TraceSession,
    frames: Map<u32, Handle>,
    params?: Map<number, Handle>,
    constructed?: Constructed,
    calls?: PropertyEvalOptions['calls'],
    extra: ClosureOptions = {},
): ResolvedClosures {
    const objects = new Map<number, Handle>()
    const pointers = new Map<number, Handle>()
    for (const [i, shape] of params ?? []) pointers.set(graph.blocks[0].params[i], shape)
    const closures = new Map<u32, Handle>()
    for (const [id, n] of graph.nodes) {
        if (n.op === NodeOp.callContext && extra.contextShape !== undefined) pointers.set(id, extra.contextShape)
        if (n.op !== NodeOp.heapHandle || getRef(n, 0)) continue
        const cell = getLiteral(graph, n, 0) as u32
        const frame = frames.get(cell)
        if (frame !== undefined) objects.set(id, frame)
        if (session.sealed.has(cell as Handle)) pointers.set(id, heap.indirectTarget(cell as Handle))
        if (!heap.isIndirect(cell as Handle) || !session.templateOf(cell)) continue
        const shape = (countIds(n) > 1 ? getLiteral(graph, n, 1) : heap.indirectTarget(cell as Handle)) as Handle
        if (!closures.has(cell)) extra.created?.(cell, shape)
        closures.set(cell, shape)
        objects.set(id, shape)
    }
    const typed = [...graph.nodes.values()].some(n => n.op === NodeOp.rt && (getLiteral(graph, n, 1) === RtOp.typeof || earlyCalls.has(getLiteral(graph, n, 1))))
    if (!objects.size && ![...pointers.values()].some(shape => shape !== numberShape) && !calls && !typed) return { graph, memoryShapes: new Map() }
    const unionPointers = new Map<number, number>()
    for (const [i, base] of extra.unionParams ?? []) unionPointers.set(graph.blocks[0].params[i], base)
    const resolved = resolveProperties(graph, session, objects, { representation: 'memory', pointers, unionPointers, partial: true, constructed, calls, locate: extra.locate, stored: extra.stored, iterationField: extra.iterationField, unify: extra.unify, bound: extra.bound })
    return { graph: resolved.graph, memoryShapes: resolved.shapes, numbers: resolved.numbers, strings: resolved.strings, encoded: resolved.encoded, unions: resolved.unions, arrayIterations: resolved.arrayIterations, locations: resolved.locations }
}

function isObjectSlot(slot: Handle): boolean {
    if (!slot || heap.isBoxedF64(slot) || heap.isString(slot) || heap.isCallable(slot)) return false
    return heap.isOrdinaryObject(heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot)
}

function slotAt(target: Handle, key: Handle): Handle {
    return heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key))).slot0 as Handle
}

function readonlyKeys(target: Handle, keys: Handle[]): boolean {
    for (const key of keys) {
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key)))
        if (d.flags & heap.PropFlags.writable) return false
    }
    return true
}

export function fieldOffset(shape: Handle, key: Handle, refinements?: Map<Handle, Map<Handle, Handle>>): number | undefined {
    function size(of: Handle): number {
        let total = 0
        for (const k of dataKeys(of)) {
            const inner = refinements?.get(of)?.get(k)
            total += inner !== undefined ? size(inner) : 8
        }
        return total
    }
    let offset = 0
    for (const k of dataKeys(shape)) {
        if (k === key) return offset
        const inner = refinements?.get(shape)?.get(k)
        offset += inner !== undefined ? size(inner) : 8
    }
    return undefined
}

export function dataKeys(target: Handle): Handle[] {
    const keys: Handle[] = []
    for (let i: u32 = 0; i < heap.ownPropertyCount(target); i++) {
        const key = heap.ownPropertyKeyAt(target, i)
        if (!key) continue
        const descriptor = heap.getOwnProperty(target, key)
        if (!descriptor) continue
        const d = heap.FullPropertyDescriptor(heap.resolveHeapCell(descriptor))
        if (d.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) continue
        keys.push(key)
    }
    return keys
}

export function resolveAccessor(session: TraceSession, call: AccessorCall, opts: PropertyEvalOptions = {}): Resolved {
    const runtime = session.runtime
    if (!runtime) throw 'property-eval: the session must stay entered while resolving accessors'
    const tracer = runtime.tracer
    const newId = (): number => newSymbolId(tracer)
    const param = (): number => {
        const id = addNode(runtime, NodeOp.param, [])
        return id
    }
    const self = param()
    const args = Array.from({ length: call.fn.length }, param)
    const traced = traceModule.trace2(call.fn, {
        session, mapCapture: opts.mapCapture, shouldInline: opts.shouldInline,
        inputs: { thisArg: symbolValue(self), args: args.map(a => symbolValue(a)), effect: undefined },
    }).graph
    for (const id of [self, ...args]) putNode(traced, id, NodeOp.param, [])
    if (call.pointer) {
        const shape = heap.makeObject(call.proto)
        for (const key of call.keys) heap.setProperty(shape, key, heap.boxF64(0) as Handle)
        traced.blocks[0].params = [self, ...args]
        return resolveProperties(traced, session, new Map(), { ...opts, pointers: new Map([[self, shape]]) })
    }
    for (const n of traced.nodes.values()) {
        if (n.op === NodeOp.setProp && getRef(n, 1) === self) throw `property-eval: accessor ${call.fn.name || '<anonymous>'} writes to this`
    }
    traced.blocks[0].params = [self]
    const standIn = heap.makeObject(call.proto)
    const params = call.keys.map(key => {
        const field = addNode(traced, NodeOp.param, [])
        heap.setProperty(standIn, key, heap.boxSymbol(field))
        return field
    })
    const resolved = resolveProperties(traced, session, new Map([[self, standIn]]), opts)
    for (const n of resolved.graph.nodes.values()) {
        for (let i = 0; i < countIds(n); i++) {
            if (getRef(n, i) === self) throw `property-eval: accessor ${call.fn.name || '<anonymous>'} uses this as a value`
        }
    }
    deleteNode(resolved.graph, self)
    resolved.graph.blocks[0].params = [...params, ...args]
    return resolved
}

const traceModule = await import('./trace2')
