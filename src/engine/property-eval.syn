            return
        }
        bindResult(id, located.shape, located.encoded ? native.pstack0Base() : undefined, located.union)
        return located.shape
    }
    function fieldShape(id: number, key: Handle): Handle | null | undefined {
        const n = getNode(source, id)
        if (n?.op === NodeOp.record) {
            for (let i = 0; i + 1 < countIds(n); i += 2) {
                if (getLiteral(runtime, n, i) === key) return getRef(n, i + 1) ? pointerShape(getRef(n, i + 1)) : undefined
            }
