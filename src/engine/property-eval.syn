    function drain(): void {
        while (holding.length) {
            const [root, id] = holding.pop()!
            for (const [user, slot] of uses.get(id) ?? []) {
                const n = getNode(source, user)!
                if (n.op === NodeOp.after && slot === countIds(n) - 1) hold(root, user)
                else if (n.op === NodeOp.select && slot > 0) hold(root, user)
                else if (n.op === NodeOp.apply && slot > 0) hold(root, paramsOf.get(getRef(n, 0))?.[slot - 1] ?? 0)
                else if (n.op === NodeOp.setProp && slot === 1) candidate(root, user)
                else if (n.op === NodeOp.setProp && slot === 3) storeInto(root, getRef(n, 1))
                else if (n.op === NodeOp.getProp && slot === 1) {
                    for (const inner of storedIn.get(root) ?? []) hold(inner, user)
                    if (embeddedRead(user)) hold(root, user)
                }
                else if (n.op === NodeOp.call && slot > 0) candidate(root, user)
            }
        }
    }
    function storeInto(root: Handle, object: number): void {
        const into = shape(object)
        if (!into || into === numberShape) return
        const owner = rootOf(into)
        seed(owner, [object])
        const inner = setOf(storedIn, owner)
        if (inner.has(root)) return
        inner.add(root)
        for (const id of holderSets.get(owner) ?? []) for (const [user, slot] of uses.get(id) ?? []) if (getNode(source, user)!.op === NodeOp.getProp && slot === 1) hold(root, user)
        for (const id of writerSets.get(owner) ?? []) if (getNode(source, id)!.op === NodeOp.call) setOf(writerSets, root).add(id)
    }
    function producers(id: number, found: Set<number>, seen = new Set<number>()): void {
        if (!id || seen.has(id)) return
        seen.add(id)
        const n = getNode(source, id)
        if (n?.op === NodeOp.after) return producers(getRef(n, countIds(n) - 1), found, seen)
        if (n?.op === NodeOp.select) {
            producers(getRef(n, 1), found, seen)
            producers(getRef(n, 2), found, seen)
            return
        }
        if (n?.op === NodeOp.param && arrivals(id).length) {
            for (const arrival of arrivals(id)) producers(arrival, found, seen)
            return
        }
        if (n?.op === NodeOp.inlined) {
            for (const value of inlinedReturns(id)) producers(value, found, seen)
            return
        }
        found.add(id)
    }
    const seeded = new Set<Handle>()
    function seed(root: Handle, from: number[]): void {
        if (!seeded.has(root)) {
            seeded.add(root)
            for (const [id, mem] of memory) if (rootOf(mem.shape) === root) hold(root, id)
        }
        const found = new Set<number>()
        for (const id of from) producers(id, found)
        for (const id of found) {
            const of = shape(id)
            if (of && of !== numberShape && rootOf(of) === root) hold(root, id)
