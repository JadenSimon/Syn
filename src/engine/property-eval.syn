        const ups = parents.get(of)
        if (!ups?.size || seen.has(of)) return [of]
        seen.add(of)
        const roots: Handle[] = []
        for (const up of ups) for (const root of rootsOf(up, seen)) if (!roots.includes(root)) roots.push(root)
        return roots
    }
    // XXX: a shape refined into several outer records has several roots, but holders and writers are tracked under the first one only
    function rootOf(of: Handle): Handle {
        return rootsOf(of)[0]
    }
    const uses = nodeUsers(source, source.nodes.keys(), true)
    const paramsOf = new Map<number, number[]>()
    for (const b of graph.blocks) paramsOf.set(b.id, b.params)
    const holderSets = new Map<Handle, Set<number>>()
    const writerSets = new Map<Handle, Set<number>>()
    const storedIn = new Map<Handle, Set<Handle>>()
    const holding: [root: Handle, id: number][] = []
    function setOf<K, V>(map: Map<K, Set<V>>, key: K): Set<V> {
        let set = map.get(key)
        if (!set) map.set(key, set = new Set())
        return set
    }
    function hold(root: Handle, id: number): void {
        if (!id || setOf(holderSets, root).has(id)) return
        setOf(holderSets, root).add(id)
        holding.push([root, id])
    }
    function candidate(root: Handle, id: number): void {
        setOf(writerSets, root).add(id)
        if (getNode(source, id)!.op === NodeOp.call) for (const inner of storedIn.get(root) ?? []) setOf(writerSets, inner).add(id)
