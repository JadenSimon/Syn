    }
    const blockBodies = new Set(graph.blocks.map(b => b.bodyId))
    const deadness = new Map<number, boolean>()
    function dead(id: number): boolean {
        const known = deadness.get(id)
        if (known !== undefined) return known
        deadness.set(id, false)
        if (blockBodies.has(id)) return false
        const users = valueUses.get(id)
        if (!users?.size) return false
        for (const user of users) {
            const u = getNode(source, user)!
            if (u.op === NodeOp.select && getRef(u, 0) !== id) {
