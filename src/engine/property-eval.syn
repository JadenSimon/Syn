        const snapshot = snapshotNode(id)
        if (snapshot) {
            const state = getLiteral(runtime, snapshot, 1) as Handle
            if (!heap.getOwnProperty(state, key)) return null
            const slot = slotAt(state, key)
            if (!heap.isBoxedF64(slot)) return isObjectSlot(slot) ? heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot : undefined
            const value = heap.boxedNanId(slot)
            return value ? pointerShape(value) : numberShape
        }
        if (n?.op !== NodeOp.param) return
        return query(`f${id}/${key}`, () => agree(arrivals(id).map(arg => fieldShape(arg, key))))
    }
    const parents = new Map<Handle, Set<Handle>>()
    let refinementCount = -1
    function rootsOf(of: Handle, seen = new Set<Handle>()): Handle[] {
        const refinements = opts.constructed?.refinements
        if (refinements && refinements.size !== refinementCount) {
            refinementCount = refinements.size
            for (const [outer, fields] of refinements) for (const inner of fields.values()) setOf(parents, inner).add(outer)
