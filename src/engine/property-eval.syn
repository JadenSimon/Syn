        }
        if (n.op === NodeOp.static && opts.calls) {
            const target = getNode(out, getRef(n, 0))!
            bindValue(id, opts.calls({ call: id, target, receiver: undefined, args: [] }))
            return boundShape(id)
        }
        if (n.op !== NodeOp.getProp && n.op !== NodeOp.call) return
        resolvePending(id)
        return boundShape(id)
