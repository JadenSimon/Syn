/// @synth

"use wrapped";

import * as intrinsics from './intrinsics'
import * as heap from './heap'
import { trace2, createTraceSession, type TraceSession } from './trace2'
import { NumericOps, dumpGraph, lowerValueGraph, normalizeValueGraph, type Graph, type GraphNode } from './lowering2'
import {
    copyNode, countIds, countLiterals, createGraph, getLiteral, getOperands, getRef, makeNode, type Operand, setGraphBlocks, setLiteral,
    setOperand, setRef,
} from './graph-node'
import type { HeapState } from './heap-records'
import { symbolOf, symbolValue, tagVmHandle, tagVmScalar, vmValue } from './vm'
import * as native from './native'
import ts from 'typescript'

type Handle = intrinsics.Handle
const Types = intrinsics.Types

export const numberShape = 0xFFFFFFFE as Handle

export interface PropertyEvalOptions {
    mapCapture?: (capture: any) => any
    shouldInline?: (fn: Function) => boolean
    accessors?: 'inline' | 'call'
    representation?: 'auto' | 'values' | 'memory'
    pointers?: Map<number, Handle>
    partial?: boolean
    constructed?: Constructed
    calls?: (site: CallSite) => CallBinding | undefined
    locate?: (shape: Handle, path: string) => { shape: Handle, decode?: number } | undefined
    stored?: (shape: Handle, path: string, value: Handle) => void
}

export interface CallSite {
    call: number
    target: GraphNode
    receiver: Handle | undefined
    args: (Handle | undefined)[]
    demanded: boolean
    context?: Handle
}

export interface CallBinding {
    paramCount: number
    receiver: boolean
    receiverShape?: Handle
    result?: Handle
    returnSlot?: { at: number, size: number }
    target?: number
    heap?: number[]
    decode?: number
    reads?: Handle[]
    stores?: [from: number, into: number][]
}

export interface Constructed {
    refinements: Map<Handle, Map<Handle, Handle>>
    embedded?: Map<number, { parent: number, key: Handle }>
    fixed?: Map<Handle, Map<Handle, Handle>>
    pointees?: Map<Handle, Map<Handle, Handle>>
}

export interface AccessorCall {
    fn: Function
    keys: Handle[]
    proto: Handle
    pointer: boolean
}

interface Layout {
    keys: Handle[]
    offsets: number[]
    nested: (Handle | undefined)[]
    size: number
}

interface Memory extends Layout {
    ptr: number
    base: number
    shape: Handle
    reduced: boolean
    pointer: boolean
    address?: [ref: number, literal: number]
    decoded?: boolean
}

export interface Resolved {
    graph: Graph
    calls: Map<number, AccessorCall>
    addresses: Map<number, number>
    shapes: Map<number, Handle>
    encoded: Set<number>
}

const orderedOps = new Set(['load', 'store', 'call', 'pstack'])

export function allocaTail(nodes: Map<number, GraphNode>): number {
    const chained = new Set<number>()
    let tail = 0
    for (const n of nodes.values()) if (n.op === 'alloca') chained.add(getRef(n, 0))
    for (const [id, n] of nodes) if (n.op === 'alloca' && !chained.has(id)) tail = Math.max(tail, id)
    return tail
}

export function resolveProperties(
    graph: Graph,
    session: TraceSession,
    objects: Map<number, Handle>,
    opts: PropertyEvalOptions = {},
): Resolved {
    const runtime = session.runtime
    if (!runtime) throw 'property-eval: the session must stay entered from tracing through resolution'
    const records = runtime.objects
    const tracer = runtime.tracer
    const source = graph.nodes
    const nodes = new Map<number, GraphNode>()
    for (const [id, n] of source) nodes.set(id, copyNode(n))
    const out = createGraph({
        maxId: graph.maxId, nodes, blocks: graph.blocks.map(b => ({ ...b, params: b.params.slice() })),
        debugLabels: graph.debugLabels, name: graph.name,
    })

    const cells = new Map<number, Handle>()
    const memory = new Map<number, Memory>()
    const addressed = new Map<number, Memory>()
    const forward = new Map<number, number>()
    const written = new Set<number>()
    for (const n of source.values()) if (n.op === 'set-prop') written.add(getRef(n, 1))
    function layout(shape: Handle): Layout {
        const keys = dataKeys(shape)
        const fields = opts.constructed?.refinements.get(shape)
        const offsets: number[] = []
        const nested: (Handle | undefined)[] = []
        let size = 0
        for (const key of keys) {
            offsets.push(size)
            const inner = fields?.get(key)
            nested.push(inner)
            size += inner !== undefined ? layout(inner).size : 8
        }
        return { keys, offsets, nested, size }
    }
    const numbers = new Set<number>()
    for (const [id, shape] of opts.pointers ?? []) {
        if (shape === numberShape) {
            numbers.add(id)
            continue
        }
        const fields = layout(shape)
        memory.set(id, { ...fields, ptr: id, base: 0, shape, reduced: fields.keys.length === 1 && readonlyKeys(shape, fields.keys), pointer: true, address: [id, 0] })
    }
    const representation = opts.representation ?? 'auto'
    const byHandle = new Map<Handle, Memory>()
    let initToken = 0
    let allocToken: number | undefined
    function heapAllocate(size: number): number {
        let token = allocToken
        if (token === undefined) {
            if (!initToken) {
                initToken = newId()
                nodes.set(initToken, makeNode('nil-effect', []))
            }
            token = initToken
        }
        const ptr = newId()
        nodes.set(ptr, makeNode('pstack', [token, 0, 0, { literal: size }]))
        if (allocToken !== undefined) allocToken = ptr
        else initToken = ptr
        return ptr
    }
    let lastAlloca = allocaTail(source)
    function snapshotNode(id: number): GraphNode | undefined {
        const n = source.get(id)
        if (!n || n.op !== 'heap-handle' || getRef(n, 0) || getRef(n, 1) || countIds(n) < 2) return
        return n
    }
    const homes = new Map<Handle, Memory>()
    function materialize(id: number, handle: Handle): Memory {
        const known = memory.get(id)
        if (known) return known
        const n = snapshotNode(id)
        const cell = n ? getLiteral(n, 0) as Handle : undefined
        const fields = layout(handle)
        const keys = fields.keys
        let mem = cell !== undefined ? homes.get(cell) : undefined
        if (mem && (mem.keys.length !== keys.length || mem.keys.some((k, i) => k !== keys[i]))) {
            throw `property-eval: %${id} changes the shape of an object that lives in memory`
        }
        if (!mem) {
            const reduced = keys.length <= 1 && readonlyKeys(handle, keys)
            let ptr = 0
            if (!reduced) ptr = heapAllocate(Math.max(fields.size, 8))
            mem = { ...fields, ptr, base: 0, shape: handle, reduced, pointer: false }
            if (cell !== undefined) homes.set(cell, mem)
        }
        memory.set(id, mem)
        byHandle.set(handle, mem)
        if (!n) return mem
        for (let i = 0; i < keys.length; i++) {
            const nested = snapshotNode(getRef(n, 2 + i))
            if (nested) materialize(getRef(n, 2 + i), getLiteral(nested, 1) as Handle)
        }
        return mem
    }
    for (const [id, handle] of objects) {
        if (representation === 'values' || (representation === 'auto' && !written.has(id))) {
            cells.set(id, records.intern(handle))
            continue
        }
        materialize(id, handle)
    }
    for (const [id, { parent, key }] of opts.constructed?.embedded ?? []) {
        const owner = memory.get(parent)
        if (!owner) throw `property-eval: %${id} is embedded in %${parent}, which has no memory`
        const at = owner.keys.indexOf(key)
        const inner = at < 0 ? undefined : owner.nested[at]
        if (inner === undefined) throw `property-eval: %${id} is embedded in a field of %${parent} that holds no object`
        const op = source.get(id)?.op
        const pointer = op === 'call'
        memory.set(id, { ...layout(inner), ptr: owner.ptr, base: owner.base + owner.offsets[at], shape: inner, reduced: false, pointer, address: pointer ? [id, 0] : undefined })
    }
    function nestedMemory(id: number, i: number): [number, Memory] | undefined {
        const n = snapshotNode(id)
        const ref = n ? getRef(n, 2 + i) : 0
        const nested = ref ? memory.get(ref) : undefined
        return nested && !nested.pointer ? [ref, nested] : undefined
    }
    const initialized = new Set<Memory>()
    function initChain(id: number, mem: Memory, token: number, visited = new Set<Memory>()): number {
        initialized.add(mem)
        visited.add(mem)
        if (mem.reduced) return token
        const state = snapshotNode(id) ? getLiteral(snapshotNode(id)!, 1) as Handle : mem.shape
        for (let i = 0; i < mem.keys.length; i++) {
            if (mem.nested[i] !== undefined) continue
            const nested = nestedMemory(id, i)
            if (!nested && !heap.getOwnProperty(state, mem.keys[i])) continue
            const [ref, literal] = nested ? addressOf(nested[1]) : operandOf(slotAt(state, mem.keys[i]))
            if (!nested && holdsAlready(mem, i, ref)) continue
            const store = newId()
            nodes.set(store, makeNode('store', [token, mem.ptr, { literal: mem.base + mem.offsets[i] }, ref || { literal }], Types.u64))
            token = store
            const storedShape = nested ? nested[1].shape : ref ? memory.get(ref)?.shape : undefined
            if (storedShape !== undefined) opts.stored?.(mem.shape, String(mem.offsets[i]), storedShape)
            if (nested && !visited.has(nested[1])) token = initChain(nested[0], nested[1], token, visited)
        }
        return token
    }
    function holdsAlready(mem: Memory, i: number, ref: number): boolean {
        const read = ref ? source.get(ref) : undefined
        if (read?.op !== 'get-prop' || getRef(read, 2)) return false
        return memory.get(getRef(read, 1)) === mem && getLiteral(read, 2) === mem.keys[i]
    }
    const consumers = new Map<number, number[]>()
    for (const [id, n] of source) {
        if (n.op !== 'call') continue
        for (let i = 1; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!memory.has(ref)) continue
            const list = consumers.get(ref)
            if (!list) consumers.set(ref, [id])
            else if (!list.includes(id)) list.push(id)
        }
    }
    for (const [id, mem] of memory) {
        if (mem.pointer) continue
        for (const consumer of consumers.get(id) ?? []) {
            const call = nodes.get(consumer)!
            const token = initChain(id, mem, getRef(call, 0))
            const copy = copyNode(call)
            setRef(copy, 0, token)
            nodes.set(consumer, copy)
        }
    }
    for (const [id, mem] of memory) {
        if (mem.pointer || mem.reduced || initialized.has(mem)) continue
        if (!initToken) {
            initToken = newId()
            nodes.set(initToken, makeNode('nil-effect', []))
        }
        initToken = initChain(id, mem, initToken)
    }
    if (initToken) {
        for (const [id, n] of source) if (n.op === 'nil-effect' && !countLiterals(n)) forward.set(id, initToken)
    }
    const roots = [...cells.values()]
    const start = records.capture(roots)

    const tokenParams = new Map<number, { block: number, index: number }>()
    for (const b of graph.blocks) b.params.forEach((p, index) => tokenParams.set(p, { block: b.id, index }))
    const inbound = new Map<number, number[]>()
    const sunk = new Map<number, number>()
    for (const [id, n] of source) {
        if (n.op === 'after' && countIds(n) === 2 && source.get(getRef(n, 1))?.op === 'apply') sunk.set(getRef(n, 1), getRef(n, 0))
        if (n.op !== 'apply') continue
        const list = inbound.get(getRef(n, 0))
        if (list) list.push(id)
        else inbound.set(getRef(n, 0), [id])
    }

    const after = new Map<number, HeapState>()
    const entries = new Map<number, HeapState>()
    const pending = new Set<number>()
    const calls = new Map<number, AccessorCall>()

    function newId(): number {
        return tracer.getNanId(tracer.createUniqueNan())
    }

    function sameState(a: HeapState, b: HeapState): boolean {
        if (a.size !== b.size) return false
        for (const [cell, value] of a) if (b.get(cell) !== value) return false
        return true
    }

    function stateAt(token: number): HeapState | undefined {
        for (;;) {
            const n = source.get(token)
            if (!n) throw `property-eval: token %${token} is not in the graph`
            if (n.op === 'get-prop' || n.op === 'set-prop') return evaluate(token)
            if (n.op === 'nil-effect') return countLiterals(n) ? blockEntry(getLiteral(n, 0)) : start
            if (n.op === 'param') return entryOf(token)
            if (n.op === 'after' && countIds(n) === 2) {
                token = getRef(n, 0)
                continue
            }
            if (!orderedOps.has(n.op)) throw `property-eval: cannot follow the token through ${n.op} %${token}`
            token = getRef(n, 0)
        }
    }

    function entryOf(param: number): HeapState | undefined {
        const at = tokenParams.get(param)
        if (!at || !at.block) throw `property-eval: token param %${param} has no block`
        return joinArrivals(param, at.block, apply => stateAt(getRef(source.get(apply)!, at.index + 1)))
    }

    function blockEntry(block: number): HeapState | undefined {
        if (block === graph.blocks[0].id) return start
        return joinArrivals(block, block, apply => {
            const token = sunk.get(apply)
            return token ? stateAt(token) : blockEntry(applyingBlock(apply))
        })
    }

    let applyingBlocks: Map<number, number> | undefined
    function applyingBlock(apply: number): number {
        if (!applyingBlocks) {
            applyingBlocks = new Map()
            for (const b of graph.blocks) {
                const seen = new Set<number>()
                const stack = [b.bodyId]
                while (stack.length) {
                    const id = stack.pop()!
                    if (!id || seen.has(id)) continue
                    seen.add(id)
                    const n = source.get(id)
                    if (!n || n.op === 'block' || n.op === 'param') continue
                    if (n.op === 'apply') applyingBlocks.set(id, b.id)
                    for (let i = 0; i < countIds(n); i++) stack.push(getRef(n, i))
                }
            }
        }
        const block = applyingBlocks.get(apply)
        if (block === undefined) throw `property-eval: %${apply} is not in any block body`
        return block
    }

    function joinArrivals(key: number, block: number, arrivalState: (apply: number) => HeapState | undefined): HeapState | undefined {
        const known = entries.get(key)
        if (known) return known
        if (pending.has(key)) return
        pending.add(key)
        const _key = key
        defer pending.delete(_key)
        let state: HeapState | undefined
        for (const apply of inbound.get(block) ?? []) {
            const arrival = arrivalState(apply)
            if (!arrival) continue
            if (state && !sameState(state, arrival)) throw `property-eval: B${block} joins different object states`
            state = arrival
        }
        if (!state && pending.size > 1) return
        if (!state) throw `property-eval: B${block} is only reached through itself`
        entries.set(key, state)
        return state
    }

    function objectOf(id: number): Handle {
        const known = cells.get(id)
        if (known !== undefined) return known
        const n = source.get(id)
        if (n?.op === 'heap-handle' && !getRef(n, 0)) return records.intern(getLiteral(n, 0) as Handle)
        throw `property-eval: no object for %${id} (${n?.op ?? 'missing'})`
    }

    function addressOf(mem: Memory): [ref: number, literal: number] {
        const address = computeAddress(mem)
        if (address[0] && !mem.reduced) addressed.set(address[0], mem)
        return address
    }
    function computeAddress(mem: Memory): [ref: number, literal: number] {
        if (mem.address) return mem.address
        if (!mem.reduced && !mem.base) return mem.address = [mem.ptr, 0]
        if (!mem.reduced) {
            const at = newId()
            nodes.set(at, makeNode('add', [mem.ptr, { literal: mem.base }]))
            return mem.address = [at, 0]
        }
        mem.address = [0, 0]
        if (mem.keys.length) mem.address = operandOf(slotAt(mem.shape, mem.keys[0]))
        return mem.address
    }

    function operandOf(slot: Handle): [ref: number, literal: number] {
        if (!slot) return [0, 0]
        const mem = byHandle.get(slot)
        if (mem) return addressOf(mem)
        if (heap.isBoxedF64(slot)) {
            const value = heap.unboxF64(slot)
            const id = intrinsics.getNanId(value)
            return id ? [id, 0] : [0, value]
        }
        const id = newId()
        nodes.set(id, makeNode('heap-handle', [{ literal: slot }]))
        cells.set(id, records.intern(slot))
        return [id, 0]
    }

    function slotOf(n: GraphNode, i: number): Handle {
        const ref = getRef(n, i)
        if (!ref) return heap.boxF64(getLiteral(n, i)) as Handle
        const cell = cells.get(ref)
        if (cell !== undefined) return cell
        const target = source.get(ref)
        if (target?.op === 'heap-handle' && !getRef(target, 0)) return getLiteral(target, 0) as Handle
        return heap.boxF64(intrinsics.getNanFromId(ref)) as Handle
    }

    function keyArg(key: Handle): u32 {
        const index = heap.keyIndex(key)
        return index === undefined ? tagVmHandle(key) : tagVmScalar(index)
    }

    function inline(id: number, fn: Handle, thisArg: Handle, args: u32[], token: number): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const nested = trace2(linked, {
            session, mapCapture: opts.mapCapture, shouldInline: opts.shouldInline,
            inputs: { thisArg: thisArg ? tagVmHandle(thisArg) : 0, args, effect: symbolValue(token) },
        })
        const traced = nested.graph
        for (const [nid, n] of traced.nodes) if (!nodes.has(nid)) nodes.set(nid, n)
        for (const b of traced.blocks) if (b.id && !out.blockIndex.has(b.id)) out.blocks.push(b)
        setGraphBlocks(out, out.blocks)
        const result = symbolOf(nested.result)
        if (result) {
            nodes.set(id, makeNode('inlined', [result, { literal: id }]))
            return
        }
        nodes.set(id, makeNode('after', [token, { literal: vmValue(nested.result as u32) }]))
    }

    function callAccessor(id: number, fn: Handle, cell: Handle, token: number): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const target = heap.indirectTarget(cell)
        const keys = dataKeys(target)
        const callee = newId()
        nodes.set(callee, makeNode('heap-handle', [{ literal: fn }]))
        const operands: Operand[] = [token, callee, 0]
        for (const key of keys) {
            const [ref, literal] = operandOf(heap.FullPropertyDescriptor(heap.resolveHeapCell(heap.getOwnProperty(target, key))).slot0 as Handle)
            operands.push(ref || { literal })
        }
        nodes.set(id, makeNode('call', operands))
        calls.set(id, { fn: linked, keys, proto: heap.getPrototypeOf(target), pointer: false })
        bindCall(id, accessed.has(id), true)
    }

    function callTrap(id: number, fn: Handle, mem: Memory, token: number, key: [ref: number, literal: number], value?: [ref: number, literal: number]): void {
        const callee = newId()
        nodes.set(callee, makeNode('heap-handle', [{ literal: fn }]))
        const [ptr, ptrLiteral] = addressOf(mem)
        const operands: Operand[] = [token, callee, 0, ptr || { literal: ptrLiteral }, key[0] || { literal: key[1] }]
        if (value) operands.push(value[0] || { literal: value[1] })
        nodes.set(id, makeNode('call', operands))
        bindCall(id, accessed.has(id), true)
    }

    function callWithPointer(id: number, fn: Handle, mem: Memory, token: number, value?: [ref: number, literal: number]): void {
        const linked = session.stubFunctions.get(fn)
        if (!linked) throw `property-eval: accessor ${fn} for %${id} is not a linked function`
        const callee = newId()
        nodes.set(callee, makeNode('heap-handle', [{ literal: fn }]))
        const operands: Operand[] = [token, callee, 0, mem.ptr]
        if (value) operands.push(value[0] || { literal: value[1] })
        if (!mem.base) addressed.set(mem.ptr, mem)
        nodes.set(id, makeNode('call', operands))
        calls.set(id, { fn: linked, keys: mem.keys, proto: heap.getPrototypeOf(mem.shape), pointer: true })
        bindCall(id, accessed.has(id), true)
    }

    function resolveMemory(id: number, n: GraphNode, mem: Memory): void {
        let token = getRef(n, 0)
        if (mem.pointer && source.get(token)?.op === 'nil-effect' && !countLiterals(source.get(token)!)) {
            token = newId()
            nodes.set(token, makeNode('nil-effect', []))
        }
        const key = getLiteral(n, 2) as Handle
        const value: [number, number] = [getRef(n, 3), getRef(n, 3) ? 0 : getLiteral(n, 3)]
        const keyRef = getRef(n, 2)
        const index = keyRef ? undefined : heap.keyIndex(key)
        if (keyRef || index !== undefined) {
            const proxy = heap.getPropertyProxy(mem.shape, keyRef ? intrinsics.getNanFromId(keyRef) as Handle : key)
            if (proxy) return callTrap(id, n.op === 'get-prop' ? heap.getProxyGetter(proxy) : heap.getProxySetter(proxy), mem, token, [keyRef, keyRef ? 0 : index!], n.op === 'set-prop' ? value : undefined)
            if (keyRef) throw `property-eval: %${id} uses a computed key on a memory object without an index trap`
        }
        if (mem.reduced && n.op === 'set-prop') throw `property-eval: %${id} writes a reduced object`
        if (mem.reduced && key === mem.keys[0]) {
            const [ref, literal] = addressOf(mem)
            nodes.set(id, makeNode('after', [token, ref || { literal }]))
            return
        }
        const addr = heap.getPropertyDescriptor(mem.shape, key)
        if (!addr) {
            if (heap.getPropertyProxy(mem.shape, key)) throw `property-eval: %${id} goes through a proxy on a memory object`
            if (n.op === 'set-prop') throw `property-eval: %${id} adds a key to a memory object`
            nodes.set(id, makeNode('after', [token, 0]))
            return
        }
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        if (desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)) {
            if (n.op === 'get-prop' && desc.flags & heap.PropFlags.has_getter) return callWithPointer(id, desc.slot0 as Handle, mem, token)
            if (n.op === 'set-prop' && desc.flags & heap.PropFlags.has_setter) return callWithPointer(id, desc.slot1 as Handle, mem, token, value)
            throw `property-eval: %${id} uses an accessor without the matching half`
        }
        const at = mem.keys.indexOf(key)
        if (at < 0) {
            if (n.op === 'set-prop') throw `property-eval: %${id} shadows a prototype key on a memory object`
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            nodes.set(id, makeNode('after', [token, ref || { literal }]))
            return
        }
        const fixed = opts.constructed?.fixed?.get(mem.shape)?.get(key)
        if (fixed !== undefined && n.op === 'set-prop') throw `property-eval: %${id} writes a field that every construction fixes`
        if (fixed !== undefined) {
            const [ref, literal] = operandOf(fixed)
            nodes.set(id, makeNode('after', [token, ref || { literal }]))
            return
        }
        const offset = mem.base + mem.offsets[at]
        const inner = mem.nested[at]
        if (inner !== undefined) return resolveEmbedded(id, n, mem, token, offset, inner, value)
        if (n.op === 'get-prop') {
            const load = newId()
            nodes.set(load, makeNode('load', [token, mem.ptr, { literal: offset }], Types.u64))
            nodes.set(id, makeNode('after', [token, load]))
            const slot = desc.slot0 as Handle
            const located = opts.locate?.(mem.shape, String(offset))
            if (located !== undefined) {
                const ptr = located.decode !== undefined ? decodeHandle(load, located.decode) : load
                memory.set(id, { ...layout(located.shape), ptr, base: 0, shape: located.shape, reduced: false, pointer: true, address: [ptr, 0], decoded: located.decode !== undefined })
                return
            }
            const pointee = opts.constructed?.pointees?.get(mem.shape)?.get(key)
            if (pointee !== undefined) {
                memory.set(id, { ...layout(pointee), ptr: load, base: 0, shape: pointee, reduced: false, pointer: true, address: [load, 0] })
                return
            }
            if (isObjectSlot(slot)) {
                const shape = heap.isIndirect(slot) ? heap.indirectTarget(slot) : slot
                memory.set(id, { ...layout(shape), ptr: load, base: 0, shape, reduced: false, pointer: true, address: [load, 0] })
            }
            return
        }
        nodes.set(id, makeNode('store', [token, mem.ptr, { literal: offset }, value[0] || { literal: value[1] }], Types.u64))
        const storedShape = value[0] ? shapeOf(value[0]) : undefined
        if (storedShape !== undefined) opts.stored?.(mem.shape, String(mem.offsets[at]), storedShape)
    }

    function resolveEmbedded(id: number, n: GraphNode, mem: Memory, token: number, offset: number, inner: Handle, value: [number, number]): void {
        if (n.op === 'set-prop') {
            const stored = value[0] ? memory.get(value[0]) : undefined
            if (!stored || stored.ptr !== mem.ptr || stored.base !== offset) throw `property-eval: %${id} reassigns an embedded field`
            forward.set(id, token)
            return
        }
        const address = newId()
        nodes.set(address, makeNode('add', [mem.ptr, { literal: offset }]))
        nodes.set(id, makeNode('after', [token, address]))
        memory.set(id, { ...layout(inner), ptr: mem.ptr, base: offset, shape: inner, reduced: false, pointer: true, address: [id, 0] })
    }

    function write(cell: Handle, key: Handle, slot: Handle): void {
        heap.setProperty(heap.prepareWrite(cell), key, slot)
    }

    function resolve(id: number, n: GraphNode): void {
        const union = unions.get(getRef(n, 1))
        if (union && n.op === 'get-prop') return resolveUnion(id, n, union)
        const mem = memory.get(getRef(n, 1))
        if (mem) return resolveMemory(id, n, mem)
        const token = getRef(n, 0)
        const cell = objectOf(getRef(n, 1))
        const key = getLiteral(n, 2) as Handle
        const addr = heap.getPropertyDescriptor(heap.indirectTarget(cell), key)
        if (!addr) {
            const proxy = heap.getPropertyProxy(heap.indirectTarget(cell), key)
            if (!proxy) {
                if (n.op === 'get-prop') {
                    nodes.set(id, makeNode('after', [token, 0]))
                    return
                }
                write(cell, key, slotOf(n, 3))
                forward.set(id, token)
                return
            }
            if (n.op === 'get-prop') return inline(id, heap.getProxyGetter(proxy), 0, [tagVmHandle(cell), keyArg(key)], token)
            return inline(id, heap.getProxySetter(proxy), 0, [tagVmHandle(cell), keyArg(key), tagVmHandle(slotOf(n, 3))], token)
        }
        const desc = heap.FullPropertyDescriptor(heap.resolveHeapCell(addr))
        const accessor = desc.flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter)
        if (n.op === 'get-prop') {
            if (desc.flags & heap.PropFlags.has_getter) {
                if (opts.accessors === 'call') return callAccessor(id, desc.slot0 as Handle, cell, token)
                return inline(id, desc.slot0 as Handle, cell, [], token)
            }
            if (accessor) throw `property-eval: %${id} reads a property with only a setter`
            const [ref, literal] = operandOf(desc.slot0 as Handle)
            nodes.set(id, makeNode('after', [token, ref || { literal }]))
            return
        }
        if (desc.flags & heap.PropFlags.has_setter) return inline(id, desc.slot1 as Handle, cell, [tagVmHandle(slotOf(n, 3))], token)
        if (accessor) throw `property-eval: %${id} writes a property with only a getter`
        write(cell, key, slotOf(n, 3))
        forward.set(id, token)
    }

    function arrivals(param: number): number[] {
        const at = tokenParams.get(param)
        if (!at) return []
        return (inbound.get(at.block) ?? []).map(apply => getRef(source.get(apply)!, at.index + 1))
    }
    const pendingShape = 0xFFFFFFFF as Handle
    function agree(shapes: (Handle | null | undefined)[]): Handle | null | undefined {
        let found: Handle | undefined
        let waiting = false
        let nullish = false
        for (const shape of shapes) {
            if (shape === null) {
                nullish = true
                continue
            }
            if (shape === pendingShape) {
                waiting = true
                continue
            }
            if (shape === undefined) return
            if (found !== undefined && (found === numberShape || shape === numberShape ? found !== shape : !native.sameSnapshotShape(found, shape))) return
            found = shape
        }
        if (found === numberShape && nullish) return
        return found ?? (waiting ? pendingShape : null)
    }
    interface Union {
        tag: number
        members: Handle[]
    }
    const unions = new Map<number, Union>()
    const unionTargets = new Map<number, { tag: number, arms: number[] }>()
    let armOverride: { id: number, shape: Handle } | undefined
    function memberIndex(members: Handle[], shape: Handle): number {
        return members.findIndex(m => native.sameSnapshotShape(m, shape))
    }
    function unionOf(param: number, shapes: (Handle | null | undefined)[]): void {
        if (unions.has(param)) return
        if (shapes.some(s => s === undefined || s === pendingShape || s === numberShape)) return
        const members: Handle[] = []
        for (const s of shapes) if (s !== null && memberIndex(members, s!) < 0) members.push(s!)
        if (members.length < 2) return
        const at = tokenParams.get(param)
        if (!at) return
        const tag = newId()
        nodes.set(tag, makeNode('param', []))
        const block = out.blocks.find(b => b.id === at.block)!
        block.params.push(tag)
        unions.set(param, { tag, members })
        const incoming = inbound.get(at.block) ?? []
        for (let k = 0; k < incoming.length; k++) {
            const apply = incoming[k]
            const current = nodes.get(apply)!
            let value = getRef(source.get(apply)!, at.index + 1)
            while (source.get(value)?.op === 'after') value = getRef(source.get(value)!, countIds(source.get(value)!) - 1)
            const operands = getOperands(current)
            const carried = unions.get(value)
            const index = carried ? -1 : shapes[k] ? memberIndex(members, shapes[k]!) : -1
            if (!carried && index < 0) throw `property-eval: %${apply} brings an unknown shape into the union at %${param}`
            operands.splice(position + 1, 0, carried ? carried.tag : { literal: index })
            nodes.set(apply, copyNode(current, operands))
        }
    }
    function tagSelect(tag: number, arms: number[]): number {
        let chosen = arms[arms.length - 1]
        for (let i = arms.length - 2; i >= 0; i--) {
            const test = newId()
            nodes.set(test, makeNode('eq', [tag, { literal: i }], Types.bool))
            const select = newId()
            nodes.set(select, makeNode('select', [test, arms[i], chosen]))
            chosen = select
        }
        return chosen
    }
    function resolveUnion(id: number, n: GraphNode, union: Union): void {
        const arms: number[] = []
        const shapes: (Handle | undefined)[] = []
        let constants = true
        for (const shape of union.members) {
            const fields = layout(shape)
            const member: Memory = { ...fields, ptr: getRef(n, 1), base: 0, shape, reduced: false, pointer: true, address: [getRef(n, 1), 0] }
            const arm = newId()
            resolveMemory(arm, n, member)
            arms.push(arm)
            shapes.push(memory.get(arm)?.shape)
            const resolved = nodes.get(arm)!
            const value = resolved.op === 'after' ? getRef(resolved, countIds(resolved) - 1) : 0
            const valueNode = value ? nodes.get(value) : undefined
            if (!valueNode || valueNode.op !== 'heap-handle' || getRef(valueNode, 0)) constants = false
        }
        const chosen = tagSelect(union.tag, arms)
        nodes.set(id, makeNode('after', [getRef(n, 0), chosen]))
        if (constants) unionTargets.set(id, { tag: union.tag, arms: arms.map(a => getRef(nodes.get(a)!, countIds(nodes.get(a)!) - 1)) })
        if (shapes.every(s => s !== undefined)) joinResult(id, union.tag, shapes as Handle[])
    }
    function joinResult(id: number, tag: number, shapes: Handle[]): void {
        const members: Handle[] = []
        for (const s of shapes) if (memberIndex(members, s) < 0) members.push(s)
        if (members.length === 1) {
            const fields = layout(members[0])
            memory.set(id, { ...fields, ptr: id, base: 0, shape: members[0], reduced: false, pointer: true, address: [id, 0] })
            return
        }
        unions.set(id, { tag, members })
    }
    const frames: { low: number, cyclic: boolean }[] = []
    const active = new Map<string, number>()
    function query<T>(key: string, compute: () => T, bottom: T): T {
        const at = active.get(key)
        if (at !== undefined) {
            frames[at].cyclic = true
            observe(at)
            return bottom
        }
        const frame = { low: frames.length, cyclic: false }
        active.set(key, frames.length)
        frames.push(frame)
        try {
            return compute()
        } finally {
            frames.pop()
            active.delete(key)
            observe(frame.low)
        }
    }
    function observe(index: number): void {
        const top = frames[frames.length - 1]
        if (top) top.low = Math.min(top.low, index)
    }
    function settled(): boolean {
        const top = frames[frames.length - 1]
        return !top || top.low >= frames.length - 1
    }
    function pointerMemory(id: number, shape: Handle): Memory {
        const fields = layout(shape)
        return { ...fields, ptr: id, base: 0, shape, reduced: fields.keys.length === 1 && readonlyKeys(shape, fields.keys), pointer: true, address: [id, 0] }
    }
    const derived = new Map<number, Handle | null | undefined>()
    const adoptable = new Set(['param', 'get', 'select', 'after'])
    const assumed: number[] = []
    function commit(id: number, value: Handle | null | undefined): void {
        if (value && value !== numberShape && adoptable.has(source.get(id)?.op ?? '')) memory.set(id, pointerMemory(id, value))
        else derived.set(id, value)
    }
    function pin(id: number, value: Handle | null | undefined): void {
        if (!id || armOverride?.id === id || memory.has(id) || addressed.has(id) || derived.has(id)) return
        commit(id, value)
        assumed.push(id)
    }
    function shape(id: number): Handle | null | undefined {
        if (!id) return
        if (armOverride?.id === id) return armOverride.shape
        const mem = memory.get(id) ?? addressed.get(id)
        if (mem) return mem.shape
        if (derived.has(id)) return derived.get(id)
        if (numbers.has(id)) return numberShape
        return query(`s${id}`, () => {
            const result = deriveShape(id)
            if (result === pendingShape || !settled()) return result
            commit(id, result)
            if (frames[frames.length - 1].cyclic) assumed.push(id)
            return result
        }, pendingShape)
    }
    function pointerShape(id: number): Handle | null | undefined {
        return snapshotNode(id) && !memory.has(id) ? undefined : shape(id)
    }
    function deriveShape(id: number): Handle | null | undefined {
        const n = source.get(id)
        if (!n) return
        if (n.op === 'after') return pointerShape(getRef(n, countIds(n) - 1))
        if (n.op === 'literal' || NumericOps.has(n.op)) return numberShape
        if (n.op === 'select') return agree([1, 2].map(i => getRef(n, i) ? pointerShape(getRef(n, i)) : numberShape))
        if (n.op === 'param') {
            const shapes = arrivals(id).map(pointerShape)
            const joined = agree(shapes)
            if (joined === undefined && settled()) unionOf(id, shapes)
            return joined
        }
        if (n.op === 'get' && !getRef(n, 1)) return fieldShape(getRef(n, 0), getLiteral(n, 1) as Handle)
        if (n.op === 'heap-handle' && !getRef(n, 0)) {
            if (!getLiteral(n, 0)) return null
            return snapshotNode(id) ? getLiteral(n, 1) as Handle : undefined
        }
        if (n.op === 'get-prop' && !evaluate(id)) return pendingShape
        if (n.op === 'call' && opts.calls) {
            bindCall(id, true)
            if (!boundCalls.has(id)) return pendingShape
        }
        if (n.op !== 'get-prop' && n.op !== 'call') return
        resolvePending(id)
        return waitingResults.has(id) ? pendingShape : memory.get(id)?.shape
    }
    function fieldShape(id: number, key: Handle): Handle | null | undefined {
        const n = source.get(id)
        if (n?.op === 'record') {
            for (let i = 0; i + 1 < countIds(n); i += 2) {
                if (getLiteral(n, i) === key) return getRef(n, i + 1) ? pointerShape(getRef(n, i + 1)) : undefined
            }
            return
        }
        if (n?.op === 'after') return fieldShape(getRef(n, countIds(n) - 1), key)
        if (n?.op !== 'param') return
        return query(`f${id}/${key}`, () => agree(arrivals(id).map(arg => fieldShape(arg, key))), pendingShape)
    }
    const parents = new Map<Handle, Handle>()
    for (const [outer, fields] of opts.constructed?.refinements ?? []) for (const inner of fields.values()) parents.set(inner, outer)
    function rootOf(of: Handle): Handle {
        for (let up = parents.get(of); up !== undefined; up = parents.get(of)) of = up
        return of
    }
    const uses = new Map<number, [user: number, slot: number][]>()
    for (const [id, n] of source) {
        for (let i = 0; i < countIds(n); i++) {
            const ref = getRef(n, i)
            if (!ref) continue
            const list = uses.get(ref)
            if (list) list.push([id, i])
            else uses.set(ref, [[id, i]])
        }
    }
    const paramsOf = new Map<number, number[]>()
    for (const b of graph.blocks) paramsOf.set(b.id, b.params)
    const holderSets = new Map<Handle, Set<number>>()
    const writerSets = new Map<Handle, Set<number>>()
    const storedIn = new Map<Handle, Set<Handle>>()
    const holding: [root: Handle, id: number][] = []
    function setOf<K, V>(map: Map<K, Set<V>>, key: K): Set<V> {
        let set = map.get(key)
        if (!set) map.set(key, set = new Set())
        return set
    }
    function hold(root: Handle, id: number): void {
        if (!id || setOf(holderSets, root).has(id)) return
        setOf(holderSets, root).add(id)
        holding.push([root, id])
    }
    function candidate(root: Handle, id: number): void {
        setOf(writerSets, root).add(id)
        if (source.get(id)!.op === 'call') for (const inner of storedIn.get(root) ?? []) setOf(writerSets, inner).add(id)
    }
    function drain(): void {
        while (holding.length) {
            const [root, id] = holding.pop()!
            for (const [user, slot] of uses.get(id) ?? []) {
                const n = source.get(user)!
                if (n.op === 'after' && slot === countIds(n) - 1) hold(root, user)
                else if (n.op === 'select' && slot > 0) hold(root, user)
                else if (n.op === 'apply' && slot > 0) hold(root, paramsOf.get(getRef(n, 0))?.[slot - 1] ?? 0)
                else if (n.op === 'set-prop' && slot === 1) candidate(root, user)
                else if (n.op === 'set-prop' && slot === 3) storeInto(root, getRef(n, 1))
                else if (n.op === 'get-prop' && slot === 1) for (const inner of storedIn.get(root) ?? []) hold(inner, user)
                else if (n.op === 'call' && slot > 0) candidate(root, user)
            }
        }
    }
    function storeInto(root: Handle, object: number): void {
        const into = shape(object)
        if (!into || into === pendingShape || into === numberShape) return
        const owner = rootOf(into)
        seed(owner, [object])
        const inner = setOf(storedIn, owner)
        if (inner.has(root)) return
        inner.add(root)
        for (const id of holderSets.get(owner) ?? []) for (const [user, slot] of uses.get(id) ?? []) if (source.get(user)!.op === 'get-prop' && slot === 1) hold(root, user)
        for (const id of writerSets.get(owner) ?? []) if (source.get(id)!.op === 'call') setOf(writerSets, root).add(id)
    }
    function producers(id: number, found: Set<number>, seen = new Set<number>()): void {
        if (!id || seen.has(id)) return
        seen.add(id)
        const n = source.get(id)
        if (n?.op === 'after') return producers(getRef(n, countIds(n) - 1), found, seen)
        if (n?.op === 'select') {
            producers(getRef(n, 1), found, seen)
            producers(getRef(n, 2), found, seen)
            return
        }
        if (n?.op === 'param' && arrivals(id).length) {
            for (const arrival of arrivals(id)) producers(arrival, found, seen)
            return
        }
        found.add(id)
    }
    const seeded = new Set<Handle>()
    function seed(root: Handle, from: number[]): void {
        if (!seeded.has(root)) {
            seeded.add(root)
            for (const [id, mem] of memory) if (rootOf(mem.shape) === root) hold(root, id)
        }
        const found = new Set<number>()
        for (const id of from) producers(id, found)
        for (const id of found) {
            const of = shape(id)
            if (of && of !== pendingShape && of !== numberShape && rootOf(of) === root) hold(root, id)
        }
    }
    function learn(call: number): void {
        const mem = memory.get(call)
        if (mem) hold(rootOf(mem.shape), call)
        const n = source.get(call) ?? nodes.get(call)!
        for (const [from, into] of bindings.get(call)?.stores ?? []) {
            const value = shape(getRef(n, from))
            if (value && value !== pendingShape && value !== numberShape) storeInto(rootOf(value), getRef(n, into))
        }
        for (const read of waitingResults.get(call)?.reads ?? []) for (const inner of storedIn.get(rootOf(read)) ?? []) hold(inner, call)
    }
    const writersKnown = new Set<Handle>()
    function demandWriters(target: Handle, from: number[]): void {
        const root = rootOf(target)
        seed(root, from)
        if (writersKnown.has(root)) return
        query(`w${root}`, () => {
            const tried = new Set<number>()
            for (;;) {
                drain()
                const next = [...writerSets.get(root) ?? []].filter(id => !tried.has(id))
                if (!next.length) break
                for (const id of next) {
                    tried.add(id)
                    if (source.get(id)!.op === 'set-prop') evaluate(id)
                    else bindCall(id, accessed.has(id))
                }
            }
            if (settled()) writersKnown.add(root)
        }, undefined)
    }
    function readsState(n: GraphNode, of: Handle): boolean {
        if (getRef(n, 2)) return true
        const key = getLiteral(n, 2) as Handle
        const addr = heap.getPropertyDescriptor(of, key)
        if (!addr || heap.getOwnProperty(of, key)) return true
        return !!(heap.FullPropertyDescriptor(heap.resolveHeapCell(addr)).flags & (heap.PropFlags.has_getter | heap.PropFlags.has_setter))
    }
    const bindings = new Map<number, CallBinding>()
    const waitingResults = new Map<number, { site: CallSite, reads: Handle[] }>()
    function resolvePending(id: number): void {
        const waiting = waitingResults.get(id)
        if (!waiting) return
        const n = source.get(id) ?? nodes.get(id)!
        const operands: number[] = []
        for (let i = 1; i < countIds(n); i++) operands.push(getRef(n, i))
        for (const read of waiting.reads) demandWriters(read, operands)
        if (!settled() && !waiting.reads.every(read => writersKnown.has(rootOf(read)))) return
        waitingResults.delete(id)
        const binding = opts.calls!(waiting.site)
        if (binding?.result !== undefined && !memory.has(id)) bindResult(id, binding.result, binding.decode)
        learn(id)
    }
    function settleResult(id: number, site: CallSite, binding: CallBinding | undefined): void {
        if (binding) bindings.set(id, binding)
        if (binding?.result !== undefined && !memory.has(id)) bindResult(id, binding.result, binding.decode)
        else if (binding?.result === undefined && binding?.reads?.length) waitingResults.set(id, { site, reads: binding.reads })
        learn(id)
    }
    const accessed = new Set<number>()
    for (const n of source.values()) if (n.op === 'get-prop' || n.op === 'set-prop') accessed.add(getRef(n, 1))
    const boundCalls = new Set<number>()
    const callUses = new Map<number, number[]>()
    for (const [id, n] of source) {
        if (n.op !== 'call') continue
        for (let i = 2; i < countIds(n); i++) {
            const uses = callUses.get(getRef(n, i))
            if (!uses) callUses.set(getRef(n, i), [id])
            else if (!uses.includes(id)) uses.push(id)
        }
    }
    const lazy = new Set<number>()
    function sameConstant(a: number, b: number): boolean {
        const x = nodes.get(a)!
        const y = nodes.get(b)!
        return x.op === y.op && getLiteral(x, 0) === getLiteral(y, 0)
    }
    function constantTarget(id: number, seen = new Set<number>()): number | null | undefined {
        if (!id || seen.has(id)) return id ? null : undefined
        if (source.get(id)?.op === 'get-prop') evaluate(id)
        const n = nodes.get(target(id))
        if (!n) return
        if (n.op === 'after') return constantTarget(getRef(n, countIds(n) - 1), seen)
        if ((n.op === 'heap-handle' || n.op === 'local-target') && !getRef(n, 0)) return target(id)
        if (n.op !== 'param') return
        seen.add(id)
        let found: number | undefined
        for (const arrival of arrivals(id)) {
            const at = constantTarget(arrival, seen)
