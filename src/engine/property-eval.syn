        deadness.set(id, true)
        return true
    }
    const inlinedUses = new Map<number, Set<number>>()
    for (const [id, n] of source.nodes) for (let i = 0; i < countIds(n); i++) if (getNode(source, getRef(n, i))?.op === NodeOp.inlined) setOf(inlinedUses, getRef(n, i)).add(id)
    for (const [inlined, users] of inlinedUses) {
