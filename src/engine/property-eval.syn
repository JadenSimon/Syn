    }
    function deriveFromNode(id: number): Handle | null | undefined {
        const n = getNode(source, id)
        if (!n) return
        if (n.op === NodeOp.after) return joinShapes([getRef(n, countIds(n) - 1)])
        if (n.op === NodeOp.inlined) return joinShapes(inlinedReturns(id))
        if (n.op === NodeOp.literal || NumericOps.has(n.op)) return numberShape
        if (n.op === NodeOp.select) return joinShapes([getRef(n, 1), getRef(n, 2)])
        if (n.op === NodeOp.param) {
