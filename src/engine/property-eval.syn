        })
        if (!reads) continue
        for (const value of returned) {
            const n = getNode(source, value)!
            if (countIds(n) > 1) continue
            const state = returnedState(value)!
            const fields: Operand[] = []
            for (const key of snapshotKeys(state)) {
                const raw = heap.unboxF64(snapshotField(state, key)!)
                fields.push({ literal: key }, intrinsics.getNanId(raw) || { literal: raw })
