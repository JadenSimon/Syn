    function joinResult(id: number, tag: number, shapes: (Handle | null)[]): void {
        const members: Handle[] = []
        for (const s of shapes) if (s !== null && memberIndex(members, s) < 0) members.push(s)
        if (!members.length) {
            derived.set(id, null)
            return
        }
        if (members.length === 1) {
            const fields = layout(members[0])
            memory.set(id, { ...fields, ptr: id, base: 0, shape: members[0], reduced: false, pointer: true, address: [id, 0] })
            return
        }
        const indices = shapes.map(s => s === null ? 0 : memberIndex(members, s))
        unions.set(id, { tag: remapTag(tag, indices), members })
    }
    const active = new Set<string>()
    function query<T>(key: string, compute: () => T): T {
        if (active.has(key)) throw `property-eval: ${graph.name ?? '?'} demands ${key} while computing it: ${[...active].join(' > ')}`
        active.add(key)
        try {
            return compute()
        } finally {
            active.delete(key)
        }
    }
    function pointerMemory(id: number, shape: Handle): Memory {
        const fields = layout(shape)
        return { ...fields, ptr: id, base: 0, shape, reduced: fields.keys.length === 1 && readonlyKeys(shape, fields.keys), pointer: true, address: [id, 0] }
    }
    const derived = new Map<number, Handle | null | undefined>()
    const locations = new Map<number, [shape: Handle, path: string]>()
    const adoptable = new Set([NodeOp.param, NodeOp.get, NodeOp.select, NodeOp.after, NodeOp.inlined])
    const bodies = new Map<number, number>()
    for (const b of graph.blocks) bodies.set(b.id, b.bodyId)
    const returnsOf = new Map<number, number[]>()
    function inlinedReturns(id: number): number[] {
        const known = returnsOf.get(id)
        if (known) return known
        const values: number[] = []
        const seen = new Set<number>()
        const work = [getRef(getNode(source, id)!, 0)]
        while (work.length) {
            const at = work.pop()!
            if (!at || seen.has(at)) continue
            seen.add(at)
            const n = getNode(source, at)
            if (!n || n.op === NodeOp.inlined) continue
            if (n.op === NodeOp.ret) values.push(getRef(n, 0))
            else if (n.op === NodeOp.after) work.push(getRef(n, countIds(n) - 1))
            else if (n.op === NodeOp.select) for (let i = 1; i < countIds(n); i++) work.push(getRef(n, i))
            else if (n.op === NodeOp.apply) work.push(bodies.get(getRef(n, 0))!)
        }
        returnsOf.set(id, values)
        return values
    }
    function strippedValue(id: number): number {
        while (getNode(source, id)?.op === NodeOp.after) id = getRef(getNode(source, id)!, countIds(getNode(source, id)!) - 1)
        return id
    }
    function returnedState(value: number): Handle | undefined {
        const n = getNode(source, value)
        if (n?.op !== NodeOp.heapHandle || getRef(n, 0)) return
        const cell = getLiteral(runtime, n, 0) as Handle
        let state: Handle | undefined
        if (countIds(n) > 1) state = snapshotNode(value) ? getLiteral(runtime, n, 1) as Handle : undefined
        else if (heap.isIndirect(cell) && !session.sealed.has(cell)) state = heap.indirectTarget(cell)
        return state !== undefined && snapshotKeys(state).length === dataKeys(state).length ? state : undefined
    }
    const valueUses = new Map<number, Set<number>>()
    for (const [id, n] of source.nodes) for (let i = 0; i < countIds(n); i++) if (getRef(n, i)) setOf(valueUses, getRef(n, i)).add(id)
    function onlyReturned(id: number): boolean {
        return [...valueUses.get(id) ?? []].every(user => {
            const n = getNode(source, user)!
            if (n.op === NodeOp.ret) return getRef(n, 0) === id
            return n.op === NodeOp.after && getRef(n, countIds(n) - 1) === id && onlyReturned(user)
        })
    }
    function typeofName(id: number): string | undefined {
        const n = getNode(source, id)
        if (n?.op !== NodeOp.rt || getLiteral(runtime, n, 1) !== RtOp.typeof) return
        if (getRef(n, 2) && unionValue(getRef(n, 2))) return
        const known = getRef(n, 2) ? shape(getRef(n, 2)) : numberShape
        if (known === undefined || known === null) return
        return known === numberShape ? 'number' : known === stringShape ? 'string' : heap.isCallable(known) ? 'function' : 'object'
    }
    function prototypeChain(id: number): Handle[] | undefined {
        const n = getNode(source, id)
        if (n?.op !== NodeOp.rt || getLiteral(runtime, n, 1) !== RtOp.hasPrototype || !getRef(n, 2)) return
        if (unionValue(getRef(n, 2))) return
        const known = shape(getRef(n, 2))
        if (known === numberShape || known === stringShape) return []
        if (known === undefined || known === null) return
        const chain: Handle[] = []
        let at = heap.getPrototypeOf(known)
        while (at) {
            chain.push(at)
            at = heap.getPrototypeOf(at)
        }
        return chain
    }
    function linkedPrototypeTest(id: number): boolean {
        const n = getNode(source, id)
        if (n?.op !== NodeOp.rt || getLiteral(runtime, n, 1) !== RtOp.hasPrototype || !getRef(n, 2)) return false
        const object = getRef(n, 2)
        shape(object)
        const union = unions.get(object)
        const mem = memory.get(object)
        const members: Memory[] = []
        if (mem) members.push(mem)
        for (const member of union?.members ?? []) members.push({ ...layout(member), ptr: object, base: 0, shape: member, reduced: false, pointer: true, address: [object, 0] })
        if (!members.some(m => m.keys.includes(heap.protoSlotKey))) return false
        const tests: number[] = []
        for (const member of members) tests.push(memberPrototypeTest(n, member))
        putNode(out, id, NodeOp.after, [getRef(n, 0), union ? tagSelect(union.tag, tests) : tests[0]])
        return true
    }
    function memberPrototypeTest(n: GraphNode, mem: Memory): number {
        if (!mem.keys.includes(heap.protoSlotKey)) {
            const chain: Handle[] = []
            for (let at = heap.getPrototypeOf(mem.shape); at; at = heap.getPrototypeOf(at)) chain.push(at)
            const constant = constantPrototype(n)
            const test = constant !== undefined ? { literal: chain.includes(constant) ? 1 : 0 } : chainSelect(n, chain)
            return typeof test === 'number' ? test : addNode(out, NodeOp.literal, [test])
        }
        const link = addNode(source, NodeOp.getProp, [getRef(n, 0), getRef(n, 2), { literal: heap.protoSlotKey }])
        putCopy(out, link, getNode(source, link)!)
        resolveMemory(link, getNode(source, link)!, mem)
        const linked = memory.get(link)
        if (linked?.keys.includes(heap.protoSlotKey)) throw `property-eval: %${link} tests a prototype chain longer than one link`
        return addNode(out, NodeOp.eq, [getRef(n, 3), link], Types.bool)
    }
    function constantPrototype(n: GraphNode): Handle | undefined {
