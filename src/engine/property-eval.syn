    function loadShape(id: number, n: GraphNode): Handle | null | undefined {
        shape(getRef(n, 1))
        if (narrowLoads.has(typeOf(n))) return numberShape
        const base = locations.get(getRef(n, 1))
        if (!base) return numberShape
        const path = `${base[1]}/${getRef(n, 2) ? '*' : getLiteral(runtime, n, 2)}`
        const located = locate(base[0], path)
        if (located?.kind === 'f64') {
            intrinsics.assert(located.encoded, 'property-eval: a raw f64 element is read through a word load')
            unbox(id, id, native.pstack0Base())
            return numberShape
        }
        if (located?.kind === 'boxed') {
            unboxNumber(id, id)
            return numberShape
        }
        if (located?.kind === 'int') return numberShape
        if (located?.kind !== 'ref') {
