        while (proto?.op === NodeOp.after) proto = getNode(source, getRef(proto, countIds(proto) - 1))
        if (proto?.op === NodeOp.heapHandle && !getRef(proto, 0)) return heap.deref(getLiteral(runtime, proto, 0) as Handle)
    }
    function chainSelect(n: GraphNode, chain: Handle[]): Operand {
        let chosen: Operand = { literal: 0 }
        for (let i = chain.length - 1; i >= 0; i--) {
            const at = addNode(out, NodeOp.heapHandle, [{ literal: chain[i] }])
            const test = addNode(out, NodeOp.eq, [getRef(n, 3), at], Types.bool)
            const select = newId()
            putNode(out, select, NodeOp.select, [test, { literal: 1 }, chosen])
            chosen = select
        }
        return chosen
    }
    function prototypeTest(id: number, chain: Handle[]): void {
        const n = getNode(source, id)!
        const constant = constantPrototype(n)
        if (constant !== undefined) {
