/// @synth

"use wrapped";

import { makeSyscallFn } from './intrinsics'

type usize = u32

interface SyscallTable {
    readonly mmap: number
    readonly munmap: number
    readonly write: number
    readonly gettimeofday: number
    readonly mprotect: number
    readonly PROT_READ: number
    readonly PROT_WRITE: number
    readonly PROT_EXEC: number
    readonly MAP_PRIVATE: number
    readonly MAP_ANON: number
    readonly MAP_JIT: number
}

const darwinArm64: SyscallTable = {
    mmap: 197, munmap: 73, write: 4, gettimeofday: 116, mprotect: 74,
    PROT_READ: 0x01, PROT_WRITE: 0x02, PROT_EXEC: 0x04, MAP_PRIVATE: 0x0002, MAP_ANON: 0x1000, MAP_JIT: 0x0800,
}

const linuxArm64: SyscallTable = {
    mmap: 222, munmap: 215, write: 64, gettimeofday: 169, mprotect: 226,
    PROT_READ: 0x01, PROT_WRITE: 0x02, PROT_EXEC: 0x04, MAP_PRIVATE: 0x02, MAP_ANON: 0x20, MAP_JIT: 0,
}

function hostTable(): SyscallTable {
    if (process.arch === 'arm64' && process.platform === 'darwin') return darwinArm64
    if (process.arch === 'arm64' && process.platform === 'linux') return linuxArm64
    throw `syscalls: no syscall table for ${process.platform}-${process.arch}`
}

const host = hostTable()

export const PROT_READ = host.PROT_READ
export const PROT_WRITE = host.PROT_WRITE
export const PROT_EXEC = host.PROT_EXEC
export const MAP_PRIVATE = host.MAP_PRIVATE
export const MAP_ANON = host.MAP_ANON
export const MAP_JIT = host.MAP_JIT

export const mmap = makeSyscallFn(
    reify (addr: usize, length: usize, prot: u32, flags: u32, fd: u32, offset: usize) => usize,
    host.mmap,
)

export const munmap = makeSyscallFn(reify (addr: usize, length: usize) => u32, host.munmap)
export const write = makeSyscallFn(reify (fd: u32, buf: usize, count: usize) => usize, host.write)
export const gettimeofday = makeSyscallFn(reify (tp: usize, tzp: usize, machTime: usize) => u32, host.gettimeofday)
export const mprotect = makeSyscallFn(
    reify (addr: usize, length: usize, prot: u32) => u32,
    host.mprotect,
)
