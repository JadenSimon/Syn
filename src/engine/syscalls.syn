/// @synth

"use wrapped";

import { makeSyscallFn } from './intrinsics'

type usize = u32

export const PROT_READ = 0x01
export const PROT_WRITE = 0x02
export const PROT_EXEC = 0x04
export const MAP_PRIVATE = 0x0002
export const MAP_ANON = 0x1000
export const MAP_JIT = 0x0800

export const mmap = makeSyscallFn(
    reify (addr: usize, length: usize, prot: u32, flags: u32, fd: u32, offset: usize) => usize,
    197,
)

export const munmap = makeSyscallFn(reify (addr: usize, length: usize) => u32, 73)
export const mprotect = makeSyscallFn(
    reify (addr: usize, length: usize, prot: u32) => u32,
    74,
)
